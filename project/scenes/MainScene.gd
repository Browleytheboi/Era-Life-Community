func _god_mode_panel_runtime_terminated() -> bool:
	if bool(get_meta("god_mode_panel_non_runtime", false)):
		return true

	if bool(get_meta("god_mode_panel_contract_emitted", false)):
		return true

	if bool(get_meta("god_mode_panel_handoff_contract_pending", false)):
		return true

	if bool(get_meta("god_mode_panel_handoff_contract_consuming", false)):
		return true

	if _god_mode_runtime_severed():
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(gs.scenario_state.get("god_mode_panel_non_runtime", false)):
			return true
		if bool(gs.scenario_state.get("god_mode_panel_contract_emitted", false)):
			return true
		if bool(gs.scenario_state.get("god_mode_panel_handoff_contract_emitted", false)):
			return true
		if bool(gs.scenario_state.get("god_mode_runtime_firewall_severed", false)):
			return true

	return false
