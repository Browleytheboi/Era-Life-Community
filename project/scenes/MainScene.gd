	bar.set_meta(
		"player_stat_text_legibility_contract",
		"large_stat_color_with_dark_outline"
	)
func _refresh_player_stat_bar_value_text(bar: ProgressBar, value: int, max_value: int, title: String = "") -> void:
	if bar == null:
		return

	var value_label:= bar.find_child("ValueLabel", true, false) as Label
	if value_label == null:
		return

	var safe_max: int = max(1, max_value)
	var safe_value: int = clamp(value, 0, safe_max)
	var effective_title: String = str(title).strip_edges()
	if effective_title == "":
		effective_title = str(bar.get_meta("stat_surface_title", "")).strip_edges()

	var stored_surface_context_raw: Variant = bar.get_meta("stat_surface_context", {})
	var surface_context: Dictionary = stored_surface_context_raw if typeof(stored_surface_context_raw) == TYPE_DICTIONARY else {}
	if surface_context.is_empty() and gs != null and gs.player != null:
		surface_context = _build_player_stat_surface_context(gs.player)

	if bool(surface_context.get("subject_dead", false)) and effective_title != "Bond":
		value_label.text = "Dead"
		return

	var bar_text: String = str(safe_value)
	if effective_title != "":
		var resolved: Dictionary = {}
		var surface_family: String = str(surface_context.get("surface_family", "")).strip_edges()
		if surface_family == "realm_overview":
			resolved = MainSceneHelpers._resolve_realm_stat_surface(effective_title, safe_value, safe_max, surface_context)
		elif surface_family == "institution_hub":
			resolved = MainSceneHelpers._resolve_institution_hub_stat_surface(effective_title, safe_value, safe_max, surface_context)
		else:
			resolved = MainSceneLogic._resolve_player_stat_surface(effective_title, safe_value, safe_max, surface_context)

		bar_text = str(resolved.get("bar_text", str(safe_value))).strip_edges()
		if bar_text == "":
			bar_text = str(safe_value)

	value_label.text = bar_text
func _player_stats_hunger_value(p: Person) -> int:
	if p == null:
		return 0

	var actor_id: int = int(
		p.id
	)
	var checkpoint_snapshot: Dictionary = {}
	var checkpoint_hydration_pending: bool = false

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		checkpoint_hydration_pending = (
			bool(
				gs.scenario_state.get(
					"checkpoint_payload_hydration_tail_pending",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"background_hydration_active",
					false
				)
			)
		)

		var snapshot_raw: Variant = (
			gs.scenario_state.get(
				"prebuilt_first_frame_ui_snapshot",
				{}
			)
		)

		if typeof(
			snapshot_raw
		) == TYPE_DICTIONARY:
			var candidate: Dictionary = (
				snapshot_raw as Dictionary
			)
			var snapshot_actor_id: int = int(
				candidate.get(
					"actor_id",
					candidate.get(
						"player_id",
						-1
					)
				)
			)

			if snapshot_actor_id == actor_id:
				checkpoint_snapshot = candidate

	var snapshot_hunger: float = -1.0

	if not checkpoint_snapshot.is_empty():
		var snapshot_stats_raw: Variant = (
			checkpoint_snapshot.get(
				"stats",
				{}
			)
		)
		var snapshot_stats: Dictionary = (
			snapshot_stats_raw as Dictionary
			if typeof(
				snapshot_stats_raw
			) == TYPE_DICTIONARY
			else {}
		)
		var snapshot_hunger_raw: Variant = (
			checkpoint_snapshot.get(
				"hunger",
				snapshot_stats.get(
					"hunger",
					-1
				)
			)
		)

		if typeof(
			snapshot_hunger_raw
		) in [
			TYPE_INT,
			TYPE_FLOAT
		]:
			snapshot_hunger = float(
				snapshot_hunger_raw
			)



	if (
		checkpoint_hydration_pending
		and snapshot_hunger >= 0.0
	):
		return clampi(
			int(
				round(
					snapshot_hunger
				)
			),
			0,
			100
		)

	var actor_hunger_raw: Variant = p.get(
		"hunger"
	)

	if typeof(
		actor_hunger_raw
	) in [
		TYPE_INT,
		TYPE_FLOAT
	]:
		var actor_hunger: float = float(
			actor_hunger_raw
		)

		if actor_hunger >= 0.0:
			return clampi(
				int(
					round(
						actor_hunger
					)
				),
				0,
				100
			)

	if snapshot_hunger >= 0.0:
		return clampi(
			int(
				round(
					snapshot_hunger
				)
			),
			0,
			100
		)

	return 0


func _bending_hub_actor() -> Person:
	if (
		gs == null
		or gs.player == null
	):
		return null



	var actor: Person = gs.player
	var actor_id: int = int(
		actor.id
	)
	var resident_actor_id: int = int(
		get_meta(
			"bending_hub_resident_actor_id",
			-1
		)
	)

	if resident_actor_id != actor_id:
		set_meta(
			"bending_hub_resident_actor_id",
			actor_id
		)
		set_meta(
			"bending_hub_resident_actor_changed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state.erase(
			"bending_hub_runtime_surface_cache"
		)
		gs.scenario_state [
			"bending_hub_runtime_surface_cache_invalidated_reason"
		] = "controlled_actor_changed"

		bending_hud_last_rebuild_signature = ""
		bending_hud_last_prewarm_signature = ""
		bending_hud_prewarm_requested_signature = ""


		call_deferred(
			"_request_bending_hub_surface_prewarm",
			true
		)

	return actor
func _player_has_visible_bending() -> bool:
	if (
		gs == null
		or not MainSceneLogic._bending_feature_enabled_by_reality_contract(gs)
	):
		return false

	var actor: Person = _bending_hub_actor()

	if actor == null:
		return false

	var bending_type: String = str(
		actor.bending_type
	).strip_edges().to_lower()

	if (
		bending_type != ""
		and bending_type != "none"
	):
		return true

	if typeof(
		actor.bending_mastery
	) == TYPE_DICTIONARY:
		for element in [
			"air",
			"water",
			"earth",
			"fire"
		]:
			if int(
				actor.bending_mastery.get(
					element,
					0
				)
			) > 0:
				return true

	if typeof(
		actor.bending_latent_potential
	) == TYPE_DICTIONARY:
		for element in [
			"air",
			"water",
			"earth",
			"fire"
		]:
			if int(
				actor.bending_latent_potential.get(
					element,
					0
				)
			) > 0:
				return true

	return false
func _bending_hud_core_color() -> Color:
	var actor: Person = _bending_hub_actor()
	if actor == null:
		return Color(0.72, 0.82, 1.0, 1.0)

	match str(actor.bending_type).strip_edges().to_lower():
		"air":
			return Color(0.72, 0.96, 1.0, 1.0)
		"water":
			return Color(0.48, 0.72, 1.0, 1.0)
		"earth":
			return Color(0.58, 0.9, 0.48, 1.0)
		"fire":
			return Color(1.0, 0.54, 0.28, 1.0)
		"avatar":
			var phase:= (sin(bending_hud_breathe_time * 1.7) + 1.0) * 0.5
			var a:= Color(0.72, 0.96, 1.0, 1.0)
			var b:= Color(1.0, 0.54, 0.28, 1.0)
			return a.lerp(b, phase)

	return Color(0.72, 0.82, 1.0, 1.0)
func _bending_hud_button_icon() -> String:
	var actor: Person = _bending_hub_actor()
	if actor == null:
		return "✦"

	var bending_type: String = str(actor.bending_type).strip_edges().to_lower()
	if bending_type == "avatar":
		return "🌀"

	var icons: Array = []

	if bending_type == "fire" or int(actor.bending_mastery.get("fire", 0)) > 0:
		icons.append("🔥")
	if bending_type == "water" or int(actor.bending_mastery.get("water", 0)) > 0:
		icons.append("💧")
	if bending_type == "earth" or int(actor.bending_mastery.get("earth", 0)) > 0:
		icons.append("⛰️")
	if bending_type == "air" or int(actor.bending_mastery.get("air", 0)) > 0:
		icons.append("💨")

	if icons.is_empty():
		return "✦"

	var icon_text: String = ""
	for icon_value in icons:
		icon_text += str(icon_value)

	return icon_text
func _bending_hud_active_elements() -> Array:
	var out: Array = []
	var actor: Person = _bending_hub_actor()
	if actor == null:
		return out

	var bending_type: String = str(actor.bending_type).strip_edges().to_lower()
	if bending_type == "avatar":
		return ["fire", "water", "earth", "air"]

	if bending_type == "fire" or int(actor.bending_mastery.get("fire", 0)) > 0:
		out.append("fire")
	if bending_type == "water" or int(actor.bending_mastery.get("water", 0)) > 0:
		out.append("water")
	if bending_type == "earth" or int(actor.bending_mastery.get("earth", 0)) > 0:
		out.append("earth")
	if bending_type == "air" or int(actor.bending_mastery.get("air", 0)) > 0:
		out.append("air")

	return out

func _bending_hud_element_color(element: String) -> Color:
	match element:
		"fire":
			return Color(1.0, 0.54, 0.28, 1.0)
		"water":
			return Color(0.48, 0.72, 1.0, 1.0)
		"earth":
			return Color(0.58, 0.9, 0.48, 1.0)
		"air":
			return Color(0.72, 0.96, 1.0, 1.0)
	return _bending_hud_core_color()
func _bending_hud_border_segment_alpha(side_index: int, pulse: float, active_count: int) -> float:
	var base_alpha: float = 0.46 + (pulse * 0.24)
	if active_count <= 1:
		return base_alpha
	var drift_phase: float = (sin((bending_hud_breathe_time * 3.1) + (float(side_index) * 1.27)) + 1.0) * 0.5
	return clamp(0.24 + (pulse * 0.12) + (drift_phase * 0.34), 0.0, 1.0)
func _update_bending_hud_button_border_overlay(pulse: float) -> void:
	if bending_hud_button_border_overlay == null:
		return
	var active_elements: Array = _bending_hud_active_elements()
	var color_pool: Array = []
	for element_value in active_elements:
		color_pool.append(_bending_hud_element_color(str(element_value)))
	if color_pool.is_empty():
		color_pool.append(_bending_hud_core_color())
	var thickness: float = 2.0 + (pulse * 2.0)
	var side_order: Array = ["top", "right", "bottom", "left"]
	var active_count: int = color_pool.size()
	bending_hud_button_border_overlay.visible = true
	for i in range(side_order.size()):
		var side_key: String = str(side_order [i])
		var segment: ColorRect = null
		if bending_hud_button_border_segments.has(side_key):
			segment = bending_hud_button_border_segments [side_key]
		if segment == null:
			continue
		var seg_color: Color = color_pool [i % color_pool.size()]
		seg_color.a = _bending_hud_border_segment_alpha(i, pulse, active_count)
		segment.color = seg_color
		segment.visible = true
		match side_key:
			"top":
				segment.anchor_left = 0.0
				segment.anchor_right = 1.0
				segment.anchor_top = 0.0
				segment.anchor_bottom = 0.0
				segment.offset_left = 0.0
				segment.offset_right = 0.0
				segment.offset_top = 0.0
				segment.offset_bottom = thickness
			"right":
				segment.anchor_left = 1.0
				segment.anchor_right = 1.0
				segment.anchor_top = 0.0
				segment.anchor_bottom = 1.0
				segment.offset_left = - thickness
				segment.offset_right = 0.0
				segment.offset_top = 0.0
				segment.offset_bottom = 0.0
			"bottom":
				segment.anchor_left = 0.0
				segment.anchor_right = 1.0
				segment.anchor_top = 1.0
				segment.anchor_bottom = 1.0
				segment.offset_left = 0.0
				segment.offset_right = 0.0
				segment.offset_top = - thickness
				segment.offset_bottom = 0.0
			"left":
				segment.anchor_left = 0.0
				segment.anchor_right = 0.0
				segment.anchor_top = 0.0
				segment.anchor_bottom = 1.0
				segment.offset_left = 0.0
				segment.offset_right = thickness
				segment.offset_top = 0.0
				segment.offset_bottom = 0.0
func _apply_runtime_hud_button_stack_layout(
	button: Button,
	stack_index: int
) -> void:
	if button == null or not is_instance_valid(button):
		return

	var safe_stack_index: int = maxi(
		0,
		stack_index
	)

	var viewport_size: Vector2 = (
		get_viewport_rect().size
	)

	var button_width: float = 82.0
	var button_height: float = 62.0
	var horizontal_gap: float = 12.0
	var vertical_gap: float = 12.0
	var right_margin: float = 20.0
	var bottom_margin: float = 88.0
	var top_safe_margin: float = 84.0

	var usable_height: float = maxf(
		button_height,
		viewport_size.y
		- bottom_margin
		- top_safe_margin
	)

	var rows_per_column: int = maxi(
		1,
		int(
			floor(
				(usable_height + vertical_gap)
				/ (
					button_height
					+ vertical_gap
				)
			)
		)
	)

	var column_index: int = int(
		floor(
			float(safe_stack_index)
			/ float(rows_per_column)
		)
	)

	var row_index: int = int(
		safe_stack_index
		% rows_per_column
	)

	var right_offset: float = (
		- right_margin
		- (
			float(column_index)
			* (
				button_width
				+ horizontal_gap
			)
		)
	)

	var bottom_offset: float = (
		- bottom_margin
		- (
			float(row_index)
			* (
				button_height
				+ vertical_gap
			)
		)
	)

	button.set_anchors_preset(
		Control.PRESET_BOTTOM_RIGHT
	)
	button.anchor_left = 1.0
	button.anchor_right = 1.0
	button.anchor_top = 1.0
	button.anchor_bottom = 1.0

	button.offset_left = (
		right_offset
		- button_width
	)
	button.offset_right = right_offset
	button.offset_top = (
		bottom_offset
		- button_height
	)
	button.offset_bottom = bottom_offset

	button.custom_minimum_size = Vector2(
		button_width,
		button_height
	)
	button.size = Vector2(
		button_width,
		button_height
	)
	button.scale = Vector2.ONE
	button.rotation = 0.0
	button.pivot_offset = Vector2(
		button_width * 0.5,
		button_height * 0.5
	)
	button.grow_horizontal = (
		Control.GROW_DIRECTION_BEGIN
	)
	button.grow_vertical = (
		Control.GROW_DIRECTION_BEGIN
	)

	button.set_meta(
		"runtime_floating_hud_stack_index",
		safe_stack_index
	)
	button.set_meta(
		"runtime_floating_hud_stack_row",
		row_index
	)
	button.set_meta(
		"runtime_floating_hud_stack_column",
		column_index
	)
	button.set_meta(
		"runtime_floating_hud_rows_per_column",
		rows_per_column
	)
	button.set_meta(
		"runtime_floating_hud_stack_slot_top",
		bottom_offset - button_height
	)
	button.set_meta(
		"runtime_floating_hud_stack_slot_bottom",
		bottom_offset
	)
	button.set_meta(
		"runtime_floating_hud_stack_horizontal_gap",
		horizontal_gap
	)
	button.set_meta(
		"runtime_floating_hud_stack_vertical_gap",
		vertical_gap
	)
	button.set_meta(
		"runtime_floating_hud_stack_geometry_resolved",
		true
	)
	button.set_meta(
		"runtime_floating_hud_stack_geometry_resolved_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	button.set_meta(
		"runtime_floating_hud_never_requires_fullscreen",
		true
	)
func _runtime_floating_hud_button_core_color(button: Button) -> Color:
	if button == boxing_hud_button:
		return Color(0.94, 0.18, 0.16, 1.0)

	if button == belongings_hud_button:
		return Color(0.96, 0.62, 0.18, 1.0)

	if button == food_lifestyle_hud_button:
		return Color(0.22, 0.86, 0.4, 1.0)

	if button == restaurant_lifestyle_hud_button:
		return Color(1.0, 0.42, 0.14, 1.0)

	if button == rick_weapon_shop_hud_button:
		return Color(1.0, 0.34, 0.1, 1.0)

	if button == bending_hud_button:
		return _bending_hud_core_color()

	if button == crown_hud_button:
		return Color(1.0, 0.76, 0.2, 1.0)

	if button == superpower_hud_button:
		return Color(1.0, 0.18, 0.68, 1.0)

	if button == power_hud_button:
		return Color(0.58, 0.28, 1.0, 1.0)

	if button == wizard_hud_button:
		return Color(0.2, 0.54, 1.0, 1.0)

	return Color(0.3, 0.72, 1.0, 1.0)


