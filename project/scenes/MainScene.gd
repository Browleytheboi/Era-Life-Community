		+ "|global_intent_request_count=1"
		+ "|mailbox_observation=true"
		+ "|hidden_prepaint_scheduled=true"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(int(Time.get_ticks_msec()))
	)

	return true

func _continue_world_browser_card_prepaint_when_idle(
	signature: String,
	attempt: int = 0
) -> void:
	var clean_signature: String = str(
		signature
	).strip_edges()

	if (
		clean_signature == ""
		or clean_signature != _other_country_browser_cache_key()
	):
		set_meta(
			"other_countries_browser_card_prepaint_pending",
			false
		)
		return

	if (
		bool(
			get_meta(
				"other_countries_popup_prepainted",
				false
			)
		)
		and str(
			get_meta(
				"other_countries_popup_prepainted_cache_key",
				""
			)
		).strip_edges() == clean_signature
	):
		set_meta(
			"other_countries_browser_card_prepaint_pending",
			false
		)
		return



	if bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		var present_tree:= get_tree()

		if present_tree == null:
			call_deferred(
				"_continue_world_browser_card_prepaint_when_idle",
				clean_signature,
				attempt + 1
			)
			return

		present_tree.process_frame.connect(
			Callable(
				self,
				"_continue_world_browser_card_prepaint_when_idle"
			).bind(
				clean_signature,
				attempt + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	var popup:= get_node_or_null(
		"OtherCountriesPopup"
	)

	if popup == null:
		_ensure_other_countries_popup()
		popup = get_node_or_null(
			"OtherCountriesPopup"
		)

	if popup == null:
		set_meta(
			"other_countries_browser_card_prepaint_pending",
			false
		)
		return

	var list:= popup.find_child(
		"List",
		true,
		false
	) as VBoxContainer
	var status:= popup.find_child(
		"Status",
		true,
		false
	) as Label
	var entries_raw: Variant = get_meta(
		"other_countries_browser_entries_cache",
		[]
	)

	var entries: Array = (
		(entries_raw as Array).duplicate(false)
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)

	if list == null or entries.is_empty():
		set_meta(
			"other_countries_browser_card_prepaint_pending",
			false
		)
		set_meta(
			"other_countries_browser_card_prepaint_failed",
			true
		)
		return
	var live_keys_raw: Variant = get_meta(
		"other_countries_live_entry_keys",
		{}
	)
	var live_keys: Dictionary = (
		live_keys_raw as Dictionary
		if typeof(live_keys_raw) == TYPE_DICTIONARY
		else {}
	)

	if not live_keys.is_empty():
		set_meta(
			"other_countries_browser_card_prepaint_pending",
			false
		)
		set_meta(
			"other_countries_browser_card_prepaint_started",
			true
		)
		set_meta(
			"other_countries_popup_prepainted",
			true
		)
		set_meta(
			"other_countries_popup_prepainted_cache_key",
			clean_signature
		)
		set_meta(
			"other_countries_popup_prepainted_entry_count",
			live_keys.size()
		)
		set_meta(
			"other_countries_browser_final_contract_preserved_live_deck",
			true
		)
		return
	var popup_was_visible: bool = popup.visible



	popup.process_mode = Node.PROCESS_MODE_INHERIT

	if popup_was_visible:
		popup.visible = true
		popup.mouse_filter = Control.MOUSE_FILTER_STOP
	else:
		popup.visible = false
		popup.mouse_filter = Control.MOUSE_FILTER_IGNORE

	list.visible = true


	set_meta(
		"other_countries_browser_selected_entry_key",
		""
	)




	_render_other_country_popup_entries(
		list,
		status,
		entries
	)

	set_meta(
		"other_countries_browser_card_prepaint_pending",
		false
	)
	set_meta(
		"other_countries_browser_card_prepaint_started",
		true
	)
	set_meta(
		"other_countries_browser_card_prepaint_started_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"other_countries_browser_card_prepaint_ready_gate_member",
		false
	)
	set_meta(
		"other_countries_browser_card_prepaint_build_on_click",
		false
	)
	set_meta(
		"other_countries_browser_card_prepaint_yielded_to_input_grace",
		false
	)
	set_meta(
		"other_countries_browser_card_prepaint_surface_was_visible",
		popup_was_visible
	)
	set_meta(
		"other_countries_browser_live_stream_visible",
		popup_was_visible
	)
func _restore_main_navigation_lens_after_modal_close(
	reason: String = ""
) -> void:
	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var navigation_visibility: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_visibility",
			{}
		)
	)

	for key in _get_ui_nav_order():
		var nav_button:= ui_nav_buttons.get(
			key,
			null
		) as Button

		if (
			nav_button == null
			or not is_instance_valid(
				nav_button
			)
		):
			continue

		nav_button.visible = bool(
			navigation_visibility.get(
				key,
				true
			)
		)
		nav_button.disabled = false
		nav_button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if nav_button.visible
			else Control.MOUSE_FILTER_IGNORE
		)
		nav_button.process_mode = (
			Node.PROCESS_MODE_INHERIT
			if nav_button.visible
			else Node.PROCESS_MODE_DISABLED
		)
		nav_button.focus_mode = (
			Control.FOCUS_NONE
		)
		nav_button.z_as_relative = false
		nav_button.z_index = 20

	_apply_ui_nav_button_visuals()

	set_meta(
		"main_navigation_lens_restored_after_modal",
		true
	)
	set_meta(
		"main_navigation_lens_restore_reason",
		reason
	)
	set_meta(
		"main_navigation_lens_restore_engine_calls",
		false
	)
func _set_other_country_browser_card_focus(
		entry_key: String
) -> void:
		var clean_key: String = str(
			entry_key
		).strip_edges()

		var current_key: String = str(
			get_meta(
				"other_countries_browser_selected_entry_key",
				""
			)
		).strip_edges()

		if (
			clean_key != ""
			and clean_key == current_key
		):
			clean_key = ""

		set_meta(
			"other_countries_browser_selected_entry_key",
			clean_key
		)

		var registry_raw: Variant = get_meta(
			"other_countries_browser_card_registry",
			{}
		)
		var registry: Dictionary = (
			registry_raw as Dictionary
			if typeof(registry_raw) == TYPE_DICTIONARY
			else {}
		)

		for raw_key in registry.keys():
			var registry_key: String = str(
				raw_key
			)
			var packet: Dictionary = MainSceneHelpers._safe_dictionary(
				registry.get(
					raw_key,
					{}
				)
			)
			var shell:= packet.get(
				"shell",
				null
			) as Control
			var actions:= packet.get(
				"actions",
				null
			) as Control
			var selected: bool = (
				clean_key != ""
				and registry_key == clean_key
			)

			if (
				shell != null
				and is_instance_valid(shell)
			):
				shell.modulate = (
					Color.WHITE
					if (
						clean_key == ""
						or selected
					)
					else Color(
						0.32,
						0.32,
						0.38,
						0.24
					)
				)
				shell.z_index = (
					40
					if selected
					else 0
				)

			if (
				actions != null
				and is_instance_valid(actions)
			):
				actions.visible = selected
				actions.mouse_filter = (
					Control.MOUSE_FILTER_PASS
					if selected
					else Control.MOUSE_FILTER_IGNORE
				)

		var popup:= get_node_or_null(
			"OtherCountriesPopup"
		)
		var status: Label = null

		if popup != null:
			status = popup.find_child(
				"Status",
				true,
				false
			) as Label

		var selected_entry: Dictionary = {}

		if clean_key != "":
			var selected_packet: Dictionary = (
				MainSceneHelpers._safe_dictionary(
					registry.get(
						clean_key,
						{}
					)
				)
			)
			selected_entry = MainSceneHelpers._safe_dictionary(
				selected_packet.get(
					"entry",
					{}
				)
			)

		if status != null:
			if clean_key == "":
				status.text = (
					"Select a realm card to reveal its actions."
				)
			else:
				status.text = (
					"%s selected."
					% str(
						selected_entry.get(
							"name",
							"Realm"
						)
					)
				)

		if not selected_entry.is_empty():
			var realm: Dictionary = MainSceneHelpers._safe_dictionary(
				selected_entry.get(
					"realm",
					{}
				)
			)
			var realm_id: int = int(
				selected_entry.get(
					"realm_id",
					realm.get(
						"realm_id",
						realm.get(
							"id",
							-1
						)
					)
				)
			)
			var realm_name: String = (
				MainSceneHelpers._other_country_population_realm_name_from_entry(
					selected_entry,
					realm
				)
			)
			var population_hidden: bool = (
				MainSceneHelpers._other_country_population_entry_should_hide(
					selected_entry,
					realm
				)
			)

			if (
				realm_id > 0
				and not population_hidden
			):
				call_deferred(
					"_queue_realm_population_truth_observation",
					realm_id,
					realm_name,
					(
						"other_countries_"
						+ "selected_realm_population_arm"
					)
				)

				set_meta(
					"other_countries_population_arm_realm_id",
					realm_id
				)

		set_meta(
			"other_countries_browser_card_focus_renderer_only",
			true
		)
		set_meta(
			"other_countries_browser_card_focus_engine_calls",
			false
		)
		set_meta(
			"other_countries_browser_card_focus_truth_mutation",
			false
		)
		set_meta(
			"other_countries_browser_population_arm_engine_calls_on_press",
			false
		)
		set_meta(
			"other_countries_browser_population_arm_build_on_press",
			false
		)
		set_meta(
			"other_countries_browser_card_focus_selected_key",
			clean_key
		)
