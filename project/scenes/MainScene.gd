func _on_superpower_hub_entry_card_gui_input(event: InputEvent, section_id: String, entry: Dictionary) -> void:
	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed:
			_on_superpower_hub_entry_pressed(section_id, entry)

func _on_superpower_hub_entry_pressed(section_id: String, entry: Dictionary) -> void:
	var overview_lines: Array = _superpower_hub_safe_array(entry.get("overview_lines", []))
	if overview_lines.is_empty():
		overview_lines.append(str(entry.get("label", entry.get("title", "Entry"))))

	var description_text: String = str(entry.get("description", entry.get("text", ""))).strip_edges()
	if description_text != "":
		overview_lines.append(description_text)

	var detail_actions: Array = _superpower_hub_safe_array(entry.get("detail_actions", []))
	if detail_actions.is_empty():
		detail_actions = _superpower_hub_safe_array(entry.get("actions", []))

	_show_superpower_hub_detail_panel({
		"title": str(entry.get("overview_title", entry.get("label", "Overview"))),
		"lines": overview_lines,
		"section_id": section_id,
		"theme": str(entry.get("theme", "superhero")),
		"actions": detail_actions
	})


func _on_superpower_hub_entry_action_pressed(action: Dictionary) -> void:
	if gs == null or gs.player == null:
		return

	var engine_property: String = str(action.get("engine_property", "superhero_engine")).strip_edges()
	var method_name: String = str(action.get("method", "resolve_hub_action")).strip_edges()
	var payload: Dictionary = _superpower_hub_safe_dictionary(action.get("payload", {}))
	if payload.is_empty():
		payload ["action"] = str(action.get("id", ""))

	var action_id: String = str(payload.get("action", action.get("id", ""))).strip_edges().to_lower()
	if action_id == "start_team":
		_open_superhero_team_creation_panel(action, "superhero_hub")
		return

	if _runtime_boot_maybe_buffer_ui_action(action, payload, "superhero", engine_property, method_name, "superhero_hub"):
		return

	if _superpower_hub_action_requires_detail_panel(action):
		_open_power_use_action_panel(action, "superhero_hub")
		return

	var result: Dictionary = {}
	var engine = gs.get(engine_property)
	if engine != null and engine.has_method(method_name):
		result = _superpower_hub_safe_dictionary(engine.call(method_name, gs.player, payload))
	else:
		result = {
			"success": false,
			"reason": "Engine action unavailable.",
			"engine_property": engine_property,
			"method": method_name
		}

	if bool(action.get("refresh_after", false)) or bool(result.get("success", false)):
		_render_superpower_hub_overlay()
	_maybe_show_action_result_popup(result)
