		"overview_lines": [
			"Power Rating: %d" % power_rating,
			"Power Skill Points: %d" % skill_points,
			"Latent Potential: %d" % int(power_state.get("latent_potential", 0)),
			"Fame Multiplier: %.2fx" % float(power_state.get("fame_multiplier", 1.0)),
			"Hidden Identity Risk: %d%%" % int(round(float(power_state.get("hidden_identity_risk", 0.0)) * 100.0)),
