func _handle_activities_hub_result(
	result: Dictionary
) -> void:
	if result.is_empty():
		return

	var result_type: String = str(
		result.get(
			"type",
			""
		)
	).strip_edges().to_lower()
	var result_text: String = str(
		result.get(
			"text",
			""
		)
	).strip_edges()

	match result_type:
		"open_boxing_entry_popup":
			_show_boxing_entry_popup()
			return

		"open_silk_road_panel":
			_show_silk_road_trade_panel()
			return

		"open_assets_panel":
			_show_assets_panel(
				gs.player,
				result_text
			)
			return

		"open_pet_shop_panel":
			_show_pet_shop_panel()
			return

		"open_meat_market_panel":
			_show_meat_market_panel()
			return

		"open_luxury_exchange_panel":
			_show_luxury_exchange_panel()
			return

		"open_artifact_shop_panel":
			_show_artifact_shop_panel()
			return

		"open_property_market_panel":
			_show_property_market_panel(
				result_text
			)
			return

		"open_vehicle_market_panel":
			_show_vehicle_market_panel(
				result_text
			)
			return

		"open_property_portfolio_panel":
			_show_property_portfolio_popup(
				gs.player,
				result_text
			)
			return

		"open_vehicle_portfolio_panel":
			_show_vehicle_portfolio_popup(
				gs.player,
				result_text
			)
			return

		"open_migration_panel":
			_show_migration_panel(
				result
			)
			return

		"open_famous_career_browser_panel":
			if activities_hub_panel != null:
				activities_hub_panel.set_status(
					(
						"Career actions now live "
						+ "in the Career Hub."
					)
				)
			return

		"scenario_prompt":
			_refresh_scenario_ui_from_result(
				result
			)
			return

		"boxing_hud_unlocked":
			current_panel = ""

			if activities_hub_panel != null:
				activities_hub_panel.close_panel()

			_reveal_existing_life_shell_after_surface_close(
				"boxing_hud_unlocked"
			)

			if (
				result_text != ""
				and bool(
					result.get(
						"log_to_diary",
						true
					)
				)
			):
				_append_text_to_diary(
					result_text,
					false
				)

			_maybe_show_action_result_popup(
				result
			)
			cached_last_result = (
				result.duplicate(true)
			)
			_update_player_stats_overlay()


func _on_activities_hub_closed() -> void:
	activities_action_open = false
	current_panel = "life"

	_reveal_existing_life_shell_after_surface_close(
		"activities_hub_closed"
	)
	_apply_ui_nav_button_visuals()


