			"tail_settle_watchdog_active",
			"tail_settle_force_release"
		]:
			guard.erase(key)

		guard ["last_new_life_handoff_tail_reset"] = reason
		guard ["last_new_life_handoff_tail_reset_ms"] = now_ms
		gs.scenario_state ["runtime_guard"] = guard
