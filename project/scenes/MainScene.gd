	if approval_row != null:
		approval_row.visible = show_approval
		approval_row.mouse_filter = Control.MOUSE_FILTER_PASS if show_approval else Control.MOUSE_FILTER_IGNORE
		approval_row.modulate = Color(1.0, 1.0, 1.0, 1.0 if show_approval else 0.0)

	if approval_label != null:
		approval_label.visible = show_approval

