func _on_entity_relationship_profile_action_pressed(entity_id: String, action_id: String) -> void:
	if gs == null or gs.player == null:
		return

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "entity_relationship_profile_action",
			"surface_id": "entity_relationship_profile",
			"action_id": action_id,
			"target_entity_id": entity_id,
			"legacy_callback": "_on_entity_relationship_profile_action_pressed",
			"legacy_args": [entity_id, action_id],
			"target": { "route_kind": "main_scene_legacy_callback", "callback": "_on_entity_relationship_profile_action_pressed", "target_entity_id": entity_id},
			"source": "mainscene.entity_relationship_profile_action"
		}, {
			"source": "mainscene.entity_relationship_profile_action",
			"surface_id": "entity_relationship_profile",
			"action_id": action_id,
			"target_entity_id": entity_id,
			"legacy_callback": "_on_entity_relationship_profile_action_pressed",
			"legacy_args": [entity_id, action_id]
		})
		return

	var result: Dictionary = {}
	if action_id.begins_with("mythical:") and gs.mythical_pets_contract_engine != null:
		result = gs.mythical_pets_contract_engine.commit_mythical_pet_action(gs.player, entity_id, action_id, { "source": "mainscene.entity_profile_action"})
	elif gs.pets_contract_engine != null:
		result = gs.pets_contract_engine.commit_pet_profile_action(gs.player, entity_id, action_id, { "source": "mainscene.entity_profile_action"})

	var result_text: String = str(result.get("text", "Done."))

	if entity_relationship_profile_popup != null and is_instance_valid(entity_relationship_profile_popup):
		entity_relationship_profile_popup.set_meta("pet_profile_last_commit_state_delta", MainSceneHelpers._safe_dictionary(result.get("state_delta", {})).duplicate(true))
		entity_relationship_profile_popup.set_meta("pet_profile_last_commit_bond_delta", int(result.get("bond_delta", 0)))

	_entity_relationship_profile_log_committed_result_to_diary(result, entity_id, action_id)

	if entity_relationship_profile_status != null:
		entity_relationship_profile_status.text = result_text

	_maybe_show_action_result_popup(result)
	_show_entity_relationship_profile_popup(entity_id, {})

	if institution_hub_open and str(institution_hub_kind).strip_edges().to_lower() == "relationships" and str(institution_hub_current_section).strip_edges().to_lower() == "pets":
		_relationship_hub_render_section_now("pets", "entity_profile_action_committed")
func _entity_relationship_profile_log_committed_result_to_diary(result: Dictionary, entity_id: String, action_id: String) -> void:
	var diary_text: String = str(result.get("diary_text", result.get("text", ""))).strip_edges()
	if diary_text == "":
		return

	if gs != null and gs.life_diary_contract_engine != null and gs.life_diary_contract_engine.has_method("emit_diary_intent"):
		gs.life_diary_contract_engine.emit_diary_intent({
			"schema": "eralife.diary.intent.pet_profile_action",
			"version": 1,
			"type": "pet_profile_action",
			"actor_id": int(gs.player.id) if gs.player != null else 0,
			"actor_name": str(gs.player.full_name() if gs.player != null and gs.player.has_method("full_name") else "I"),
			"target_entity_id": entity_id,
			"action_id": action_id,
			"lines": diary_text.split("\n"),
			"source": "mainscene.entity_relationship_profile_action.committed_result",
			"preserve_lines_exactly": true,
			"meta": {
				"commit_report": result.duplicate(true),
				"ui_is_pure_renderer": true,
			}
		}, {
			"source": "mainscene.entity_relationship_profile_action.committed_result",
			"target_entity_id": entity_id,
			"action_id": action_id
		})
		return

	_append_text_to_diary(diary_text, false)


