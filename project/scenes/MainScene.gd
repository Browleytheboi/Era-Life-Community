		MainSceneHelpers._style_institution_hub_action_button(relationship_profile_popup_edit_button, "relationships")

	_relationship_profile_lock_header_order(header_row)
func _on_relationship_profile_top_switch_pressed() -> void:
	var target: Person = _relationship_profile_active_target()

	if target == null:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"No relationship target is currently selected."
			)
		return

	var target_id: int = int(
		target.id
	)

	if (
		not bool(target.alive)
		or float(target.health) <= 0.0
	):
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"Dead NPCs cannot be switched into."
			)
		return

	if not _resident_main_tab_renderer_deck_is_hot(
		target_id
	):
		var shell: Dictionary = (
			_relationship_profile_prewarmed_playable_life_shell_for_actor(
				target
			)
		)
		var viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(
			shell.get(
				"playable_life_viewer_render_packet",
				shell.get(
					"viewer_render_packet",
					{}
				)
			)
		)
		var surface: Dictionary = MainSceneHelpers._safe_dictionary(
			viewer_packet.get(
				"surface_contract",
				{}
			)
		)
		var deck: Dictionary = MainSceneHelpers._safe_dictionary(
			viewer_packet.get(
				"main_tab_surface_contracts",
				surface.get(
					"main_tab_surface_contracts",
					{}
				)
			)
		)

		_queue_resident_main_tab_renderer_deck_prewarm(
			target_id,
			deck,
			"relationship_profile_switch_press_integrity_rearm"
		)

		set_meta(
			"relationship_profile_switch_rejected_unpainted_actor_deck",
			true
		)
		set_meta(
			"relationship_profile_switch_rejected_unpainted_actor_id",
			target_id
		)
		set_meta(
			"relationship_profile_switch_rejected_build_on_press",
			false
		)
		set_meta(
			"relationship_profile_switch_rejected_pointer_commit",
			false
		)

		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's complete perspective is being painted "
				+ "behind this profile."
			) % (
				MainSceneHelpers._person_display_name_for_identity_switch(
					target
				)
			)

		return

	if not _relationship_profile_try_consume_click(
		"top_switch",
		"switch_to_character",
		target_id,
		90
	):
		return

	set_meta(
		"relationship_profile_switch_button_press_frame_started",
		true
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_target_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_renderer_deck_hot",
		true
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_build_forbidden",
		true
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_wait_forbidden",
		true
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_timed_input_fence_started",
		false
	)
	set_meta(
		"relationship_profile_switch_button_press_frame_legacy_callback_route",
		false
	)

	if (
		relationship_profile_popup_switch_button != null
		and is_instance_valid(
			relationship_profile_popup_switch_button
		)
	):
		relationship_profile_popup_switch_button.disabled = true
		relationship_profile_popup_switch_button.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	var committed: bool = (
		_commit_relationship_profile_zero_frame_switch_now(
			target,
			"relationship_profile_top_switch_button"
		)
	)

	if committed:
		return



	if (
		relationship_profile_popup_switch_button != null
		and is_instance_valid(
			relationship_profile_popup_switch_button
		)
	):
		relationship_profile_popup_switch_button.disabled = false
		relationship_profile_popup_switch_button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)

	if relationship_profile_popup_status != null:
		relationship_profile_popup_status.text = (
			"The prepared perspective could not be committed."
		)

	set_meta(
		"relationship_profile_pointer_only_fallback_forbidden",
		true
	)
	set_meta(
		"relationship_profile_pointer_only_fallback_used",
		false
	)
func _commit_relationship_profile_zero_frame_switch_now(
	target: Person,
	source: String = "relationship_profile_switch"
) -> bool:
	if (
		gs == null
		or target == null
		or gs.player == null
	):
		return false

	if (
		not bool(target.alive)
		or float(target.health) <= 0.0
	):
		return false

	var target_id: int = int(
		target.id
	)

	if target_id <= 0:
		return false

	var previous_controlled_person_id: int = int(
		gs.player.id
	)
	var target_name: String = (
		MainSceneHelpers._person_display_name_for_identity_switch(
			target
		)
	)
	var prewarmed_shell: Dictionary = (
		_relationship_profile_prewarmed_playable_life_shell_for_actor(
			target
		)
	)

	if (
		prewarmed_shell.is_empty()
		or not bool(
			prewarmed_shell.get(
				"playable_life_shell_ready",
				false
			)
		)
	):
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's life shell was not staged before the switch press."
				% target_name
			)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"relationship_profile_switch_press_build_forbidden"
			] = true
			gs.scenario_state [
				"relationship_profile_switch_missing_prewarmed_life_shell"
			] = true
			gs.scenario_state [
				"relationship_profile_switch_missing_prewarmed_life_shell_actor_id"
			] = target_id
			gs.scenario_state [
				"relationship_profile_switch_missing_prewarmed_life_shell_at_ms"
			] = int(Time.get_ticks_msec())

		return false

	var viewer_packet_raw: Variant = prewarmed_shell.get(
		"playable_life_viewer_render_packet",
		prewarmed_shell.get(
			"viewer_render_packet",
			{}
		)
	)

	if typeof(viewer_packet_raw) != TYPE_DICTIONARY:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's PlayableLifeViewer packet was missing."
				% target_name
			)
		return false

	var viewer_packet: Dictionary = (
		viewer_packet_raw as Dictionary
	)

	if viewer_packet.is_empty():
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's PlayableLifeViewer packet was missing."
				% target_name
			)
		return false

	var surface_contract_raw: Variant = viewer_packet.get(
		"surface_contract",
		prewarmed_shell.get(
			"surface_contract",
			{}
		)
	)

	if typeof(surface_contract_raw) != TYPE_DICTIONARY:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's surface shell was missing."
				% target_name
			)
		return false

	var surface_contract: Dictionary = (
		surface_contract_raw as Dictionary
	)

	if surface_contract.is_empty():
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's surface shell was missing."
				% target_name
			)
		return false

	var pointer_revision: String = str(
		viewer_packet.get(
			"pointer_revision",
			surface_contract.get(
				"pointer_revision",
				""
			)
		)
	).strip_edges()

	if pointer_revision == "":
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"%s's prepared pointer revision was missing."
				% target_name
			)
		return false

	_hide_relationship_modal_stack_visual_only_for_zero_frame_switch()

	var intent_report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": previous_controlled_person_id,
			"target_id": target_id,
			"intent_type": "switch_person",
			"surface_id": "full_relationship_profile_popup",
			"action_id": "switch_to_character",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"payload": {
				"actor_id": target_id,
				"target_id": target_id,
				"prepared_actor_id": target_id,
				"prepared_actor_name": target_name,
				"pointer_revision": pointer_revision,
				"press_frame_build_forbidden": true,
				"source": source,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "universal_switch_contract_engine",
				"method": "commit_profile_switch_intent",
				"pass_actor_payload": true,
				"actor_id": target_id
			},
			"source": source
		},
		{
			"actor_id": previous_controlled_person_id,
			"target_id": target_id,
			"source": source,
			"surface_id": "full_relationship_profile_popup",
			"action_id": "switch_to_character",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true
		}
	)
	var route_result: Dictionary = _contract_route_result(
		intent_report
	)

	if not bool(
		route_result.get(
			"success",
			false
		)
	):
		if (
			relationship_profile_popup != null
			and is_instance_valid(
				relationship_profile_popup
			)
		):
			relationship_profile_popup.visible = true
			relationship_profile_popup.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			relationship_profile_popup_open = true
			_bring_modal_to_front(
				relationship_profile_popup
			)

		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = (
				"Could not commit %s as the visible truth anchor."
				% target_name
			)
		return false

	var result_raw: Variant = route_result.get(
		"result",
		{}
	)
	var result: Dictionary = (
		result_raw as Dictionary
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)
	var clean_text: String = str(
		result.get(
			"text",
			""
		)
	).strip_edges()

	current_panel = "life"

	set_meta(
		"relationship_profile_switch_press_visual_anchor_claimed",
		true
	)
	set_meta(
		"relationship_profile_switch_press_visual_anchor_actor_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_press_visual_anchor_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"relationship_profile_switch_press_no_full_contract_commit_before_paint",
		true
	)
	set_meta(
		"relationship_profile_switch_press_no_surface_entry_scan",
		true
	)
	set_meta(
		"relationship_profile_switch_press_no_age_up_diary_duplicate",
		true
	)
	set_meta(
		"relationship_profile_switch_press_no_render_policy_scan",
		true
	)
	set_meta(
		"relationship_profile_switch_press_no_hud_truth_scan",
		true
	)
	set_meta(
		"relationship_profile_switch_modal_hidden_before_intent_route",
		true
	)
	set_meta(
		"relationship_profile_switch_renderer_called_engine_directly",
		false
	)

	if not _apply_relationship_profile_switch_visible_lens_from_packet_now(
		target,
		viewer_packet,
		result,
		source + "_press_frame_lens_only"
	):
		_force_relationship_switch_base_life_shell_lens_visible_now(
			target,
			source + "_committed_packet_invalid"
		)
		return false

	belongings_hud_content_dirty = false

	var now_ms: int = int(
