func _global_prewarm_verify_ready_door_minimum_hot(
	snapshot: Dictionary,
	reason: String = "ready_door_minimum_global_prewarm"
) -> Dictionary:
	if gs == null or gs.player == null:
		return {
			"success": false,
			"required_hot": false,
			"reason": "missing_game_state_or_player",
			"ui_is_renderer_only": true
		}

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		snapshot
	)
	var required_missing: Array = []
	var native_room_missing: Array = []
	var native_room_report: Dictionary = {}
	var shell_report: Dictionary = (
		_global_prewarm_verify_life_shell_snapshot(
			surface.duplicate(true)
		)
	)

	if not bool(
		shell_report.get(
			"success",
			false
		)
	):
		required_missing.append({
			"contract_id": "life_shell_snapshot",
			"report": shell_report.duplicate(true)
		})

	var resident_visual_shell_hot: bool = (
		_resident_playable_life_shell_surface_is_hot()
	)

	if not resident_visual_shell_hot:
		required_missing.append({
			"contract_id": (
				"resident_playable_life_shell_surface"
			),
			"reason": "resident_visual_shell_not_hot"
		})


	var native_panel_ids: Array = [
		"life",
		"world",
		"activities",
		"career",
		"school",
		"relationships",
		"mods"
	]

	for raw_panel_id in native_panel_ids:
		var panel_id: String = str(
			raw_panel_id
		).strip_edges().to_lower()
		var shell_hot: bool = bool(
			get_meta(
				"native_main_tab_shell_hot_%s"
				% panel_id,
				false
			)
		)
		var renderable: bool = (
			_main_tab_surface_is_renderable(
				panel_id
			)
		)

		native_room_report [panel_id] = {
			"shell_hot": shell_hot,
			"renderable": renderable,
			"blocks_ready_door": false,
			"checked_at_ms": int(
				Time.get_ticks_msec()
			)
		}

		if not shell_hot or not renderable:
			native_room_missing.append({
				"contract_id": (
					"native_tab_room.%s"
					% panel_id
				),
				"panel_id": panel_id,
				"shell_hot": shell_hot,
				"renderable": renderable,
				"reason": (
					"native_surface_tail_pending"
				),
				"blocks_ready_door": false
			})

	var native_rooms_hot: bool = (
		native_room_missing.is_empty()
	)


	var required_hot: bool = (
		required_missing.is_empty()
	)

	set_meta(
		"ready_room_native_rooms_hot",
		native_rooms_hot
	)
	set_meta(
		"ready_room_native_room_report",
		native_room_report.duplicate(true)
	)
	set_meta(
		"ready_room_native_room_missing",
		native_room_missing.duplicate(true)
	)
	set_meta(
		"ready_room_native_rooms_are_tail_contracts",
		true
	)
	set_meta(
		"ready_room_native_rooms_may_not_block_ready",
		true
	)

	if typeof(
		gs.scenario_state
	) == TYPE_DICTIONARY:
		gs.scenario_state [
			"ready_room_native_rooms_hot"
		] = native_rooms_hot
		gs.scenario_state [
			"ready_room_native_room_report"
		] = native_room_report.duplicate(true)
		gs.scenario_state [
			"ready_room_native_room_missing"
		] = native_room_missing.duplicate(true)
		gs.scenario_state [
			"ready_room_native_rooms_are_tail_contracts"
		] = true
		gs.scenario_state [
			"ready_room_native_rooms_may_not_block_ready"
		] = true

	return {
		"success": required_hot,
		"schema": (
			"eralife.global_prewarm."
			+ "first_frame_ready_gate"
		),
		"version": 5,
		"reason": reason,
		"required_hot": required_hot,
		"ready_may_appear": required_hot,
		"checked_contract_count": 2,
		"missing": required_missing.duplicate(true),
		"native_room_missing": (
			native_room_missing.duplicate(true)
		),
		"native_room_report": (
			native_room_report.duplicate(true)
		),
		"native_rooms_hot": native_rooms_hot,
		"native_tab_surfaces_primed_before_ready": (
			native_rooms_hot
		),
		"ui_is_renderer_only": true,
		"verified_at_ms": int(
			Time.get_ticks_msec()
		)
	}
func _global_prewarm_execute_reveal_contracts_tail(reason: String = "global_prewarm_reveal_contracts_tail") -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if bool(gs.scenario_state.get("global_prewarm_reveal_contracts_tail_running", false)):
		return

	var realm_ids: Array = _population_card_contract_tail_realm_ids()

	gs.scenario_state ["global_prewarm_reveal_contracts_tail_running"] = true
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_complete"] = false
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_reason"] = reason
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_started_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_does_not_block_ready"] = true
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_total_realms"] = realm_ids.size()
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_cursor"] = 0

	call_deferred(
		"_global_prewarm_execute_reveal_contracts_tail_chunk",
		reason,
		realm_ids,
		0
	)
func _global_prewarm_execute_reveal_contracts_tail_chunk(reason: String, realm_ids: Array, cursor: int = 0) -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if cursor >= realm_ids.size():
		gs.scenario_state ["global_prewarm_reveal_contracts_tail_running"] = false
		gs.scenario_state ["global_prewarm_reveal_contracts_tail_complete"] = true
		gs.scenario_state ["global_prewarm_reveal_contracts_tail_completed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["global_prewarm_reveal_contracts_tail_cursor"] = cursor
		gs.scenario_state ["global_prewarm_reveal_contracts_tail_hot_for_other_countries"] = true
		gs.scenario_state ["other_country_population_surfaces_should_be_hot"] = true
		return

	var realm_id: int = int(realm_ids [cursor])
	if realm_id <= 0:
		call_deferred(
			"_global_prewarm_execute_reveal_contracts_tail_chunk",
			reason,
			realm_ids,
			cursor + 1
		)
		return

	var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
	if realm_name == "":
		call_deferred(
			"_global_prewarm_execute_reveal_contracts_tail_chunk",
			reason,
			realm_ids,
			cursor + 1
		)
		return

	var card_engine:= _ensure_population_card_contract_engine()
	var panel:= _ensure_realm_population_contract_panel()
	if card_engine == null or panel == null:
		call_deferred(
			"_global_prewarm_execute_reveal_contracts_tail_chunk",
			reason,
			realm_ids,
			cursor + 1
		)
		return

	MainSceneLogic._request_population_government_truth_tail_for_realm(gs, 
		realm_id,
		realm_name,
		"%s_truth_stage_realm_%d" % [reason, realm_id]
	)

	var view_contract: Dictionary = card_engine.view_contract_for_realm(
		realm_id,
		realm_name,
		{
			"source": "%s_realm_%d" % [reason, realm_id],
			"tail_registry": true,
			"surface_already_exists": true,
			"truth_may_be_partial": true,
			"population_cards_may_project_partial_truth": true,
			"ui_is_renderer_only": true,
			"click_path_build_forbidden": true,
			"ready_door_may_not_wait": true
		}
	)

	if not view_contract.is_empty():
		if panel.has_method("register_card_graph_packet"):
			var graph_packet: Dictionary = view_contract.get("population_card_graph_packet", {}) if typeof(view_contract.get("population_card_graph_packet", {})) == TYPE_DICTIONARY else {}
			if not graph_packet.is_empty():
				panel.register_card_graph_packet(
					realm_id,
					realm_name,
					graph_packet,
					{
						"source": reason,
						"ui_is_renderer_only": true
					}
				)

		_prewarm_realm_population_contract_panel_for_realm(
			realm_id,
			realm_name,
			view_contract,
			"%s_surface_from_chunked_global_reveal_tail" % reason
		)

		if gs != null and "global_node_contract_engine" in gs and gs.global_node_contract_engine != null:
			var graph_packet_for_node: Dictionary = view_contract.get("population_card_graph_packet", {}) if typeof(view_contract.get("population_card_graph_packet", {})) == TYPE_DICTIONARY else {}
			if not graph_packet_for_node.is_empty() and gs.global_node_contract_engine.has_method("ingest_population_card_graph_packet"):
				gs.global_node_contract_engine.ingest_population_card_graph_packet(
					graph_packet_for_node,
					{
						"source": reason,
						"realm_id": realm_id,
						"realm_name": realm_name,
						"ui_is_renderer_only": true
					}
				)

	gs.scenario_state ["global_prewarm_reveal_contracts_tail_cursor"] = cursor
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_current_realm_id"] = realm_id
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_current_realm_name"] = realm_name
	gs.scenario_state ["global_prewarm_reveal_contracts_tail_last_tick_at_ms"] = int(Time.get_ticks_msec())

	call_deferred(
		"_global_prewarm_execute_reveal_contracts_tail_chunk",
		reason,
		realm_ids,
		cursor + 1
	)
func _global_prewarm_execute_and_verify_ready_gate(snapshot: Dictionary, reason: String = "global_prewarm_ready_gate") -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	var prewarm_engine:= _ensure_global_prewarm_contract_engine()
	if prewarm_engine == null:
		return {
			"success": false,
			"reason": "missing_global_prewarm_contract_engine"
		}

	_register_global_prewarm_shell_contracts(prewarm_engine, snapshot.duplicate(true), reason)

	var shell_surface_report: Dictionary = _global_prewarm_register_minimum_observable_population_shells(
		"%s_surface_shell_seed" % reason
	)

	var report: Dictionary = _global_prewarm_verify_ready_door_minimum_hot(
		snapshot.duplicate(true),
		"%s_minimum_ready_gate" % reason
	)

	report ["observable_population_surface_shell_report"] = shell_surface_report.duplicate(true)
	report ["ready_gate_does_not_execute_heavy_contracts"] = true
	report ["main_tab_surfaces_do_not_block_ready"] = true
	report ["truth_resolution_does_not_block_ready"] = true
	report ["population_cards_do_not_block_ready"] = true
	report ["ui_is_renderer_only"] = true

	var required_hot: bool = bool(report.get("required_hot", report.get("success", false)))
	set_meta("global_prewarm_contract_gate_required_before_ready", true)
	set_meta("global_prewarm_contract_gate_hot", required_hot)
	set_meta("global_prewarm_contract_gate_report", report.duplicate(true))
	set_meta("global_prewarm_contract_gate_checked_at_ms", int(Time.get_ticks_msec()))
	set_meta("global_prewarm_contract_gate_ready_click_may_not_execute_contracts", true)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["global_prewarm_contract_gate_required_before_ready"] = true
	gs.scenario_state ["global_prewarm_contract_gate_hot"] = required_hot
	gs.scenario_state ["global_prewarm_contract_gate_report"] = report.duplicate(true)
	gs.scenario_state ["global_prewarm_contract_gate_checked_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["global_prewarm_contract_gate_ready_click_may_not_execute_contracts"] = true
	gs.scenario_state ["ready_gate_does_not_execute_heavy_contracts"] = true
	gs.scenario_state ["population_surface_shells_seeded_before_ready"] = bool(shell_surface_report.get("success", false))

	call_deferred(
		"_global_prewarm_register_and_start_reveal_contracts_after_ready_latch",
		snapshot.duplicate(true),
		"%s_after_ready_latch" % reason
	)

	return report
func _global_prewarm_register_minimum_observable_population_shells(reason: String = "minimum_observable_population_shells") -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state",
			"ui_is_renderer_only": true
		}

	var panel:= _ensure_realm_population_contract_panel()
	if panel == null:
		return {
			"success": false,
			"reason": "missing_realm_population_contract_panel",
			"ui_is_renderer_only": true
		}

	var ids: Array = MainSceneLogic._global_prewarm_ready_gate_realm_ids(gs)
	var seeded: Array = []
	var failed: Array = []

	for raw_realm_id in ids:
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
		if realm_name == "":
			realm_name = MainSceneLogic._crown_realm_name(gs, realm_id)

		if realm_name == "":
			failed.append({
				"realm_id": realm_id,
				"reason": "missing_realm_name"
			})
			continue

		if panel.has_surface_for(realm_id, realm_name):
			seeded.append(realm_id)
			continue

		if panel.has_method("register_surface_shell"):
			var shell_report: Dictionary = panel.register_surface_shell(
				realm_id,
				realm_name,
				{
					"source": reason,
					"truth_state": "partial",
					"ui_is_renderer_only": true
				}
			)

			if bool(shell_report.get("success", false)):
				seeded.append(realm_id)
			else:
				failed.append(shell_report.duplicate(true))
		else:
			failed.append({
				"realm_id": realm_id,
				"realm_name": realm_name,
				"reason": "panel_missing_register_surface_shell"
			})

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["minimum_observable_population_shells_seeded"] = seeded.duplicate(true)
		gs.scenario_state ["minimum_observable_population_shells_failed"] = failed.duplicate(true)
		gs.scenario_state ["minimum_observable_population_shells_seeded_at_ms"] = int(Time.get_ticks_msec())

	return {
		"success": failed.is_empty(),
		"schema": "eralife.mainscene.minimum_observable_population_shells",
		"reason": reason,
		"seeded": seeded.duplicate(true),
		"failed": failed.duplicate(true),
		"truth_state": "partial",
		"ui_is_renderer_only": true
	}
func _global_prewarm_register_and_start_reveal_contracts_after_ready_latch(snapshot: Dictionary, reason: String = "global_prewarm_after_ready_latch") -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if bool(gs.scenario_state.get("global_prewarm_reveal_contracts_after_ready_latch_started", false)):
		return

	gs.scenario_state ["global_prewarm_reveal_contracts_after_ready_latch_started"] = true
	gs.scenario_state ["global_prewarm_reveal_contracts_after_ready_latch_reason"] = reason
	gs.scenario_state ["global_prewarm_reveal_contracts_after_ready_latch_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["global_prewarm_reveal_contracts_do_not_block_ready"] = true

	var prewarm_engine:= _ensure_global_prewarm_contract_engine()
	if prewarm_engine != null:
		_register_global_prewarm_shell_contracts(
			prewarm_engine,
			snapshot.duplicate(true),
			"%s_register_reveal_contracts" % reason
		)
	if gs.population_shard_engine != null and gs.population_shard_engine.has_method("request_truth_resolution_shard_drain"):
		gs.population_shard_engine.request_truth_resolution_shard_drain(
			"%s_after_ready_latch" % reason
		)
	call_deferred(
		"_global_prewarm_execute_reveal_contracts_tail",
		"%s_chunked_reveal_tail" % reason
	)
func _global_prewarm_verify_life_shell_snapshot(snapshot: Dictionary) -> Dictionary:
