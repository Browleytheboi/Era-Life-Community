func _diary_line_from_world_feed_entry(entry: Dictionary) -> String:
	if gs == null or gs.player == null:
		return ""
	if typeof(entry) != TYPE_DICTIONARY:
		return ""
	if bool(entry.get("suppress_diary", false)):
		return ""

	var event_name: String = str(entry.get("event_name", ""))
	if event_name == "startup_seed":
		return ""
	if event_name == "family_death":
		return ""
	if event_name in ["avatar_player_birth_reincarnation", "avatar_reincarnated"]:
		return ""

	var entry_year:= int(entry.get("year", gs.year))
	if entry_year != gs.year:
		return ""

	var personally_relevant:= bool(entry.get("personally_relevant", false))
	var npc_id:= int(entry.get("npc_id", -1))
	if not personally_relevant and npc_id != gs.player.id:
		return ""

	var text:= MainSceneHelpers._compact_diary_text(gs.get_world_feed_text(entry, "player"))
	if text == "":
		return ""

	text = _force_player_diary_first_person(text)
	if _should_skip_player_diary_line(text):
		return ""

	return text

func toggle_year_lock():
	if gs == null or gs.player == null:
		return

	var actor_id: int = int(gs.player.id)
	var desired_locked: bool = not bool(gs.year_locked)
	var intent_report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": "year_lock",
			"surface_id": "life_shell",
			"action_id": "set_year_lock",
			"payload": {
				"locked": desired_locked,
				"source": "mainscene.year_lock_toggle"
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "life_engine",
				"method": "resolve_year_lock_intent",
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": "mainscene.year_lock_toggle",
			"ui_is_expression_only": true
		},
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"surface_id": "life_shell",
			"action_id": "set_year_lock",
			"source": "mainscene.year_lock_toggle",
			"blocks_ui": false
		}
	)
	var route_result: Dictionary = _contract_route_result(
		intent_report
	)

	if not bool(
		route_result.get(
			"success",
			false
		)
	):
		_ui_block([
			"    Year progression lock could not be changed."
		])
		return

	if bool(
		route_result.get(
			"locked",
			desired_locked
		)
	):
		_ui_block([
			"    Year progression is now LOCKED."
		])
	else:
		_ui_block([
			"    Year progression is now UNLOCKED."
		])
func _force_age_up_life_diary_surface_after_handoff(reason: String = "age_up_handoff") -> void:
	if gs == null or gs.player == null:
		return

	if output_label == null or not is_instance_valid(output_label):
		return

	output_label.visible = true
	output_label.scroll_active = true
	output_label.bbcode_enabled = true

	if age_up_diary_entries.is_empty():
		var cached_lines_raw: Variant = get_meta("life_diary_render_cached_lines", [])
		if typeof(cached_lines_raw) == TYPE_ARRAY and not (cached_lines_raw as Array).is_empty():
			_ui_block((cached_lines_raw as Array).duplicate(true))
		return

	_render_life_diary_panel()
	_request_life_diary_focus_latest_year(reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_life_diary_surface_forced"] = true
		gs.scenario_state ["age_up_life_diary_surface_forced_reason"] = reason
		gs.scenario_state ["age_up_life_diary_surface_forced_at_ms"] = int(Time.get_ticks_msec())
func _show_age_up_output(
	result: Dictionary,
	defer_post_refresh: bool = true,
	refresh_mode: String = "full"
) -> void:
	var loading_safe: bool = (
		refresh_mode == "loading_safe"
	)
	var display_result: Dictionary = result

	if (
		gs != null
		and gs.afterlife_active
		and gs.afterlife_influence_engine != null
	):
		var incoming_type: String = str(
			display_result.get(
				"type",
				""
			)
		)

		if (
			not incoming_type.begins_with(
				"afterlife"
			)
			and gs.afterlife_influence_engine.has_pending_choice()
		):
			display_result = (
				gs.afterlife_influence_engine
				.get_pending_choice_result()
			)

	current_opportunities_cache.clear()

	if display_result.has(
		"opps"
	):
		current_opportunities_cache = (
			display_result.opps.duplicate()
		)

	var rtype: String = str(
		display_result.get(
			"type",
			""
		)
	)

	if _result_crosses_life_boundary(
		display_result
	):
		_hide_other_countries_popup_for_lifecycle(
			"show_age_up_output_%s"
			% rtype
		)







	if rtype == "continue_lineage_complete":
		_consume_continue_lineage_perspective_handoff(
			display_result
		)

		call_deferred(
			"_release_death_transition_audio_after_playable_life_control",
			"continue_lineage_complete",
			0
		)

		return

	if rtype == "player_line_birth_naming_form":
		_hide_afterlife_ui()
		_hide_scenario_ui()
		_show_player_line_birth_naming_popup(
			display_result
		)

		if defer_post_refresh:
			call_deferred(
				"_force_post_age_up_ui_refresh",
				refresh_mode
			)
		else:
			_force_post_age_up_ui_refresh(
				refresh_mode
			)

		return

	var result_text: String = MainSceneHelpers._compact_diary_text(
		str(
			display_result.get(
				"text",
				""
			)
		)
	)
	var defer_result_until_after_feed: bool = (
		rtype == "scenario_commit_complete"
	)
	var prebuilt_raw: Variant = get_meta(
		"age_up_loading_prebuilt_output_bucket",
		{}
	)
	var prebuilt: Dictionary = (
		prebuilt_raw
		if typeof(
			prebuilt_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var use_prebuilt_output: bool = (
		refresh_mode == "post_loading_finalize"
		and not prebuilt.is_empty()
		and str(
			prebuilt.get(
				"result_type",
				""
			)
		) == rtype
	)
	var lines:= []
	var seen_lines: Dictionary = {}
	var display_year_value: int = (
		gs.year
		if gs != null
		else 0
	)
	var display_age_value: int = 0

	if gs.player != null:
		display_age_value = int(
			gs.player.age
		)

	if use_prebuilt_output:
		var prebuilt_lines_raw: Variant = (
			prebuilt.get(
				"lines",
				[]
			)
		)
		var prebuilt_lines: Array = (
			prebuilt_lines_raw
			if typeof(
				prebuilt_lines_raw
			) == TYPE_ARRAY
			else []
		)

		if not prebuilt_lines.is_empty():
			lines = prebuilt_lines.duplicate(
				true
			)
		else:
			use_prebuilt_output = false

		if gs != null:
			diary_world_feed_cursor = int(
				prebuilt.get(
					"world_feed_cursor",
					clamp(
						diary_world_feed_cursor,
						0,
						gs.world_feed.size()
					)
				)
			)
			gs.pending_death_messages.clear()
	else:
		lines.append(
			"Year: %s"
			% _format_year(
				display_year_value
			)
		)

		if gs.player != null:
			lines.append(
				"Age: %d"
				% display_age_value
			)

		if (
			gs.player != null
			and display_age_value == 0
			and age_up_diary_entries.is_empty()
		):
			lines.append(
				"I was born in %s, %s."
				% [
					gs.player.birth_city,
					gs.player.birth_country
				]
			)

		for msg in gs.pending_death_messages:
			var pending_text:= MainSceneHelpers._compact_diary_text(
				str(
					msg
				)
			)

			if pending_text == "":
				continue

			if seen_lines.has(
				pending_text
			):
				continue

			seen_lines [
				pending_text
			] = true
			lines.append(
				pending_text
			)

		gs.pending_death_messages.clear()

		if (
			not defer_result_until_after_feed
			and rtype != "scenario_prompt"
		):
			if (
				result_text != ""
				and not seen_lines.has(
					result_text
				)
			):
				seen_lines [
					result_text
				] = true
				lines.append(
					result_text
				)

	if rtype.begins_with(
		"afterlife"
	):
		_refresh_afterlife_ui_from_result(
			display_result
		)
		_hide_scenario_ui()
	elif rtype == "scenario_prompt":
		_hide_afterlife_ui()
		_hide_action_result_popup()
		pending_action_result_followup = {}
		_refresh_scenario_ui_from_result(
			display_result
		)
	elif rtype == "year_resolution_popup":
		_hide_afterlife_ui()
		_hide_scenario_ui()
	else:
		_hide_afterlife_ui()
		_hide_scenario_ui()

	if (
		gs != null
		and gs.afterlife_active
		and bool(
			gs.afterlife_state.get(
				"ui_lock_tabs",
				false
			)
		)
	):
		_refresh_current_panel()

	if not use_prebuilt_output:
		var world_start: int = clamp(
			diary_world_feed_cursor,
			0,
			gs.world_feed.size()
		)

		for i in range(
			world_start,
			gs.world_feed.size()
		):
			var entry:= (
				gs.normalize_world_feed_entry(
					gs.world_feed [
						i
					]
				)
			)
			var diary_line:= (
				_diary_line_from_world_feed_entry(
					entry
				).strip_edges()
			)

			if diary_line == "":
				continue

			if seen_lines.has(
				diary_line
			):
				continue

			seen_lines [
				diary_line
			] = true
			lines.append(
				diary_line
			)

		diary_world_feed_cursor = (
			gs.world_feed.size()
		)

		if defer_result_until_after_feed:
			if (
				result_text != ""
				and not seen_lines.has(
					result_text
				)
			):
				seen_lines [
					result_text
				] = true
				lines.append(
					result_text
				)

		lines.append(
			"----------------------"
		)

	_append_diary_entry(
		lines
	)
	_mark_life_diary_mutated(
		"age_up_output_%s_%s"
		% [
			rtype,
			refresh_mode
		]
	)

	if not loading_safe:
		_force_age_up_life_diary_surface_after_handoff(
			"age_up_output_%s"
			% refresh_mode
		)

	if player_stats_overlay != null:
		player_stats_overlay.visible = true

	_try_surface_controlled_death_after_age_up(
		"show_age_up_output_%s"
		% refresh_mode
	)

	if rtype == "afterlife_reincarnated":
		_hide_afterlife_ui()
		_refresh_identity_bound_surfaces()

		if defer_post_refresh:
			call_deferred(
				"_force_post_age_up_ui_refresh",
				refresh_mode
			)
		else:
			_force_post_age_up_ui_refresh(
				refresh_mode
			)

		call_deferred(
			"_release_death_transition_audio_after_playable_life_control",
			"afterlife_reincarnated",
			0
		)

		return

	if rtype == "afterlife_exit_random_life":
		age_up_diary_entries.clear()
		current_opportunities_cache.clear()

		_terminate_death_transition_audio_for_world_seed_exit(
			"afterlife_exit_random_life",
			false
		)

		gs.start_random_new_life()

		_hide_afterlife_ui()
		_hide_scenario_ui()
		current_panel = ""
		_print_era_overview()
		_print_new_life_intro()

		if defer_post_refresh:
			call_deferred(
				"_force_post_age_up_ui_refresh",
				refresh_mode
			)
		else:
			_force_post_age_up_ui_refresh(
				refresh_mode
			)

		call_deferred(
			"_sync_era_audio_contract_from_current_world",
			"afterlife_random_life_new_world_ready"
		)

		return

	if rtype == "afterlife_exit_custom_life":
		_terminate_death_transition_audio_for_world_seed_exit(
			"afterlife_exit_custom_life",
			false
		)

		_hide_afterlife_ui()
		_hide_scenario_ui()
		call_deferred(
			"_return_to_god_mode_selection_center",
			false
		)
		return

	if rtype == "year_resolution_popup":
		_queue_post_age_up_pending_action_result_popup(
			display_result
		)

	if defer_post_refresh:
		call_deferred(
			"_force_post_age_up_ui_refresh",
			refresh_mode
		)
	else:
		_force_post_age_up_ui_refresh(
			refresh_mode
		)
func _queue_post_age_up_pending_action_result_popup(result: Dictionary) -> void:
	if typeof(result) != TYPE_DICTIONARY or result.is_empty():
		return

	set_meta("post_age_up_pending_action_result_popup", result.duplicate(true))
	set_meta("post_age_up_pending_action_result_popup_attempts", 0)
	call_deferred("_flush_post_age_up_pending_action_result_popup", "queued")


func _flush_post_age_up_pending_action_result_popup(reason: String = "") -> void:
	var pending_raw: Variant = get_meta("post_age_up_pending_action_result_popup", {})
	if typeof(pending_raw) != TYPE_DICTIONARY or (pending_raw as Dictionary).is_empty():
		return

	var overlay_busy: bool = age_up_loading_runtime_active \
or bool(get_meta("age_up_transition_busy", false)) \
or (age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible)

	if overlay_busy:
		var attempts: int = int(get_meta("post_age_up_pending_action_result_popup_attempts", 0)) + 1
		set_meta("post_age_up_pending_action_result_popup_attempts", attempts)

		if attempts < 90:
			var tree:= get_tree()
			if tree != null:
				tree.create_timer(0.08).timeout.connect(
					Callable(self, "_flush_post_age_up_pending_action_result_popup").bind(reason),
					CONNECT_ONE_SHOT
				)
			else:
				call_deferred("_flush_post_age_up_pending_action_result_popup", reason)
		return

	var pending: Dictionary = (pending_raw as Dictionary).duplicate(true)
	set_meta("post_age_up_pending_action_result_popup", {})
	set_meta("post_age_up_pending_action_result_popup_attempts", 0)
	_maybe_show_action_result_popup(pending)



func _on_button_pressed() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	if _god_mode_ui_locked():
		return

	var age_up_input_frame_id: int = int(
		Engine.get_process_frames()
	)

	if (
		bool(
			get_meta(
				"age_up_temporal_intent_active",
				false
			)
		)
		or int(
			get_meta(
				"age_up_last_temporal_intent_frame",
				-1
			)
		) == age_up_input_frame_id
	):
		set_meta(
			"age_up_duplicate_press_ignored",
			true
		)
		set_meta(
			"age_up_duplicate_press_ignored_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"age_up_duplicate_press_ignored_frame",
			age_up_input_frame_id
		)

		EraLog.truth(
			"ERALIFE_AGE_UP_INTENT_TRUTH"
			+ "|actor_id=" + str(gs.player.id)
			+ "|duplicate_ignored=true"
			+ "|same_input_frame=true"
			+ "|world_advanced_again=false"
			+ "|new_command_expressed=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	_age_up_truth_probe_reset(
		"age_up_button_pressed"
	)
	_age_up_truth_probe_mark(
		"button_enter",
		{
			"awaiting_new_life": gs.awaiting_new_life,
			"afterlife_active": gs.afterlife_active,
		}
	)



	set_meta(
		"age_up_temporal_intent_active",
		true
	)
	set_meta(
		"age_up_last_temporal_intent_frame",
		age_up_input_frame_id
	)
	set_meta(
		"age_up_temporal_intent_source_year",
		int(
			gs.year
		)
	)
	set_meta(
		"age_up_temporal_intent_source_age",
		int(
			gs.player.age
		)
	)
	set_meta(
		"visible_age_up_runtime_from_button",
		false
	)
	set_meta(
		"age_up_loading_runtime_requested",
		false
	)
	set_meta(
		"age_up_committed_by_global_intent",
		true
	)
	set_meta(
		"age_up_ui_did_not_commit_directly",
		true
	)
	set_meta(
		"age_up_main_scene_legacy_callback_used",
		false
	)

	if gs.awaiting_new_life:
		set_meta(
			"age_up_transition_busy",
			true
		)

		if gs.afterlife_active:
			_age_up_truth_probe_mark(
				"afterlife_age_up_path_call_deferred"
			)
			call_deferred(
				"_deferred_run_afterlife_age_up_from_button"
			)
			return

		_age_up_truth_probe_mark(
			"random_new_life_path_call_deferred"
		)
		age_up_diary_entries.clear()
		current_opportunities_cache.clear()
		_hide_afterlife_ui()
		current_panel = ""
		call_deferred(
			"_deferred_begin_random_new_life_from_age_button"
		)
		return




	set_meta(
		"age_up_transition_busy",
		false
	)

	var actor_id: int = int(
		gs.player.id
	)
	var source_year: int = int(
		gs.year
	)
	var source_age: int = int(
		gs.player.age
	)
	var intent_token: String = "%d:%d:%d:%d" % [
		actor_id,
		source_year,
		source_age,
		age_up_input_frame_id
	]



	set_meta(
		"age_up_pending_temporal_intent",
		{
			"actor_id": actor_id,
			"source_year": source_year,
			"source_age": source_age,
			"input_frame_id": age_up_input_frame_id,
			"intent_token": intent_token,
			"queued_at_ms": int(
				Time.get_ticks_msec()
			)
		}
	)

	set_meta(
		"age_up_press_scalar_ticket_only",
		true
	)
	set_meta(
		"age_up_press_engine_calls",
		false
	)
	set_meta(
		"age_up_press_world_iteration",
		false
	)
	set_meta(
		"age_up_press_surface_refresh",
		false
	)
	set_meta(
		"age_up_press_recursive_copy",
		false
	)

	_age_up_truth_probe_mark(
		"zero_frame_age_up_temporal_ticket_queued",
		{
			"actor_id": actor_id,
			"source_year": source_year,
			"source_age": source_age,
			"input_frame_id": age_up_input_frame_id,
			"intent_token": intent_token,
		}
	)

	var tree:= Engine.get_main_loop() as SceneTree

	if tree == null:
		remove_meta(
			"age_up_pending_temporal_intent"
		)
		set_meta(
			"age_up_temporal_intent_active",
			false
		)
		_global_runtime_kill_release_for_player_age_up(
			"age_up_physics_frame_lease_unavailable"
		)
		_age_up_truth_probe_finish(
			"age_up_physics_frame_lease_unavailable"
		)
		return




	_arm_zero_frame_age_up_visible_observation_service()




	var callback:= Callable(
		self,
		"_deferred_run_age_up_from_button"
	)

	if not tree.physics_frame.is_connected(
		callback
	):
		tree.physics_frame.connect(
			callback,
			CONNECT_ONE_SHOT
		)

	set_meta(
		"age_up_temporal_intent_scheduler",
		"scene_tree_physics_frame_one_shot"
	)
	set_meta(
		"age_up_temporal_intent_uses_process_frame",
		false
	)
	set_meta(
		"age_up_temporal_intent_uses_call_deferred",
		false
	)
	set_meta(
		"age_up_temporal_commit_precedes_observer",
		true
	)
func _deferred_begin_random_new_life_from_age_button() -> void:
	if gs == null:
		set_meta("age_up_transition_busy", false)
		return

	var boot_ticket: int = int(get_meta("life_boot_ticket", 0)) + 1
	set_meta("life_boot_ticket", boot_ticket)

	_hide_other_countries_popup_for_lifecycle("random_new_life_from_age_button")
	_terminate_death_transition_audio_for_world_seed_exit("random_new_life_from_age_button", false)

	gs.start_random_new_life()

	set_meta("startup_live_shell_loading", true)
	set_meta("age_up_post_loading_finalize_pending", true)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["post_spawn_ui_finalize_pending"] = true
	gs.scenario_state ["deferred_data_bootstrap_pending"] = true

	current_panel = ""
	_print_era_overview()
	_print_new_life_intro()
	call_deferred("_force_post_age_up_ui_refresh", "loading_safe")

	set_meta("age_up_transition_busy", false)
	call_deferred("_continue_post_spawn_world_prewarm", boot_ticket)


func _deferred_run_afterlife_age_up_from_button() -> void:
	if gs == null:
		set_meta("age_up_transition_busy", false)
		return
	var afterlife_result: Dictionary = gs.life_engine.age_up()
	afterlife_result = MainSceneLogic._resume_nonvisible_age_up_result(gs, afterlife_result)
	cached_last_result = afterlife_result
	_show_age_up_output(afterlife_result)
	set_meta("age_up_transition_busy", false)


func _deferred_run_age_up_from_button() -> void:
	if (
		gs == null
		or gs.player == null
	):
		set_meta(
			"age_up_transition_busy",
			false
		)
		set_meta(
			"age_up_temporal_intent_active",
			false
		)
		return

	var pending_raw: Variant = get_meta(
		"age_up_pending_temporal_intent",
		{}
	)
	var pending: Dictionary = (
		pending_raw as Dictionary
		if typeof(pending_raw) == TYPE_DICTIONARY
		else {}
	)

	remove_meta(
		"age_up_pending_temporal_intent"
	)

	if pending.is_empty():
		set_meta(
			"age_up_temporal_intent_active",
			false
		)
		return

	var actor_id: int = int(
		pending.get(
			"actor_id",
			-1
		)
	)
	var source_year: int = int(
		pending.get(
			"source_year",
			gs.year
		)
	)
	var source_age: int = int(
		pending.get(
			"source_age",
			gs.player.age
		)
	)
	var input_frame_id: int = int(
		pending.get(
			"input_frame_id",
			-1
		)
	)
	var intent_token: String = str(
		pending.get(
			"intent_token",
			""
		)
	)
	_global_runtime_kill_release_for_player_age_up(
		"age_up_temporal_simulation_lease"
	)

	if not _global_runtime_kill_claim_allowed(
		"busy",
		"Mainscene._deferred_run_age_up_from_button",
		"age_up_temporal_simulation_lease",
		{
			"player_initiated_age_up": true,
			"age_up_button_user_initiated": true,
			"source": (
				"mainscene."
				+ "deferred_age_up_temporal_intent"
			),
			"transition_allowed": true,
			"blocks_ui": false,
			"ui_is_pure_renderer": true,
			"commit_required_before_log": true
		}
	):
		set_meta(
			"age_up_transition_busy",
			false
		)
		set_meta(
			"age_up_temporal_intent_active",
			false
		)
		set_meta(
			"age_up_zero_frame_intent_failed",
			true
		)

		_age_up_truth_probe_finish(
			"blocked_global_runtime_kill_contract"
		)

		return
	var intent_started_at_ms: int = int(
		Time.get_ticks_msec()
	)

	_age_up_truth_probe_mark(
		"before_constitutional_age_up_commit",
		{
			"actor_id": actor_id,
			"source_year": source_year,
			"source_age": source_age,
			"renderer_called_engine_directly": false
		}
	)

	var intent_report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": "age_up",
			"surface_id": "life_shell",
			"action_id": "commit_zero_frame_age_up",

			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"immutable_contract_references": true,
			"commit_required_before_log": true,
			"payload": {
				"action_id": "commit_zero_frame_age_up",
				"actor_id": actor_id,
				"source": (
					"mainscene.deferred_age_up_temporal_intent"
				),
				"player_initiated_age_up": true,
				"age_up_button_user_initiated": true,
				"global_intent_routed": true,
				"input_frame_id": input_frame_id,
				"intent_token": intent_token,
				"visible_ui_waits_for_tail": false,
				"ready_gate_member": false,
				"blocks_ui": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "life_engine",
				"method": "resolve_age_up_intent",
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": (
				"mainscene.deferred_age_up_temporal_intent"
			),
			"ui_is_expression_only": true
		},
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"surface_id": "life_shell",
			"action_id": "commit_zero_frame_age_up",
			"source": (
				"mainscene.deferred_age_up_temporal_intent"
			),
			"player_initiated_age_up": true,
			"ready_gate_member": false,
			"blocks_ui": false
		}
	)

	var route_result: Dictionary = (
		_contract_route_result(
			intent_report
		)
	)



	var age_result_raw: Variant = route_result.get(
		"age_up_result",
		route_result.get(
			"result",
			{}
		)
	)
	var age_result: Dictionary = (
		age_result_raw as Dictionary
		if typeof(age_result_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		age_result.is_empty()
		and (
			route_result.has(
				"type"
			)
			or bool(
				route_result.get(
					"zero_frame_age_up",
					false
				)
			)
		)
	):
		age_result = route_result

	var route_failed: bool = (
		not route_result.is_empty()
		and route_result.has(
			"success"
		)
		and not bool(
			route_result.get(
				"success",
				false
			)
		)
	)

	if (
		intent_report.is_empty()
		or route_failed
		or age_result.is_empty()
	):
		set_meta(
			"age_up_transition_busy",
			false
		)
		set_meta(
			"age_up_temporal_intent_active",
			false
		)
		set_meta(
			"age_up_zero_frame_intent_failed",
			true
		)
		set_meta(
			"age_up_zero_frame_intent_failure_report",
			route_result.duplicate(
				false
			)
		)

		_global_runtime_kill_release_for_player_age_up(
			"age_up_zero_frame_intent_failed"
		)
		_age_up_truth_probe_finish(
			str(
				route_result.get(
					"reason",
					"zero_frame_age_up_intent_failed"
				)
			)
		)
		return

	cached_last_result = age_result.duplicate(
		false
	)




	set_meta(
		"age_up_zero_frame_visible_result",
		age_result.duplicate(
			false
		)
	)
	set_meta(
		"age_up_zero_frame_visible_result_pending_observation",
		true
	)
	set_meta(
		"era_surface_refresh_signature",
		""
	)
	set_meta(
		"era_surface_refresh_next_ms",
		0
	)

	_age_up_truth_probe_mark(
		"zero_frame_visible_truth_committed",
		{
			"actor_id": actor_id,
			"source_year": source_year,
			"committed_year": int(
				gs.year
			),
			"source_age": source_age,
			"committed_age": int(
				gs.player.age
			),
			"commit_ms": maxi(
				0,
				int(
					Time.get_ticks_msec()
				) - intent_started_at_ms
			),
			"zero_frame_age_up": bool(
				age_result.get(
					"zero_frame_age_up",
					false
				)
			),
			"tail_pending": bool(
				age_result.get(
					"runtime_tail_pending",
					false
				)
			),
		}
	)

	set_meta(
		"age_up_transition_busy",
		false
	)
	set_meta(
		"age_up_temporal_intent_active",
		false
	)
	set_meta(
		"age_up_zero_frame_intent_failed",
		false
	)
	set_meta(
		"age_up_zero_frame_visible_truth_committed",
		true
	)
	set_meta(
		"age_up_zero_frame_visible_truth_committed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"age_up_loading_overlay_bypassed",
		true
	)
	set_meta(
		"age_up_world_tail_blocks_ui",
		false
	)
	set_meta(
		"age_up_temporal_intent_one_year_only",
		true
	)
	set_meta(
		"age_up_temporal_intent_committed_target_year",
		int(
			gs.year
		)
	)
	set_meta(
		"age_up_temporal_intent_committed_target_age",
		int(
			gs.player.age
		)
	)

	_global_runtime_kill_release_for_player_age_up(
		"zero_frame_age_up_visible_truth_committed"
	)
	_age_up_truth_probe_finish(
		"zero_frame_age_up_visible_truth_committed"
	)

	EraLog.truth(
		"ERALIFE_AGE_UP_INTENT_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|source_year=" + str(source_year)
		+ "|committed_year=" + str(gs.year)
		+ "|source_age=" + str(source_age)
		+ "|committed_age=" + str(gs.player.age)
		+ "|zero_frame="
		+ str(
			bool(
				age_result.get(
					"zero_frame_age_up",
					false
				)
			)
		).to_lower()
		+ "|tail_pending="
		+ str(
			bool(
				age_result.get(
					"runtime_tail_pending",
					false
				)
			)
		).to_lower()
		+ "|click_path_engine_calls=false"
		+ "|full_output_render_on_commit=false"
		+ "|ui_waited_for_tail=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)


