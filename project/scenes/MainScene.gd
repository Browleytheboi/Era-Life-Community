func _toggle_wizard_hud() -> void:
	wizard_hud_open = not wizard_hud_open

	set_meta("wizard_hud_click_visual_only", true)
	set_meta("wizard_hud_click_sync_update_forbidden", true)
	set_meta("wizard_hud_click_at_ms", int(Time.get_ticks_msec()))

	_set_runtime_floating_hud_forced_open("wizard", wizard_hud_open)

	if wizard_hud_panel != null and is_instance_valid(wizard_hud_panel):
		wizard_hud_panel.visible = wizard_hud_open
		wizard_hud_panel.mouse_filter = Control.MOUSE_FILTER_STOP if wizard_hud_open else Control.MOUSE_FILTER_IGNORE

	if wizard_hud_button != null and is_instance_valid(wizard_hud_button):
		wizard_hud_button.visible = MainSceneLogic._player_has_visible_wizard_magic(gs)
		wizard_hud_button.disabled = not MainSceneLogic._player_has_visible_wizard_magic(gs)
		wizard_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP if MainSceneLogic._player_has_visible_wizard_magic(gs) else Control.MOUSE_FILTER_IGNORE

	if wizard_hud_open:
		call_deferred("_update_wizard_hud")
	else:
		call_deferred("_sync_runtime_floating_hud_layering")


func _update_wizard_hud() -> void:
	_ensure_wizard_hud()
	if wizard_hud_button == null or wizard_hud_panel == null:
		return

	var forced_open: bool = _is_runtime_floating_hud_forced_open("wizard") and wizard_hud_open
	var visible_magic: bool = MainSceneLogic._player_has_visible_wizard_magic(gs)

	wizard_hud_button.visible = visible_magic or forced_open

	if not visible_magic and not forced_open:
		wizard_hud_open = false
		wizard_hud_panel.visible = false
		_set_runtime_floating_hud_forced_open("wizard", false)
		return

	wizard_hud_panel.visible = wizard_hud_open and visible_magic
	_apply_runtime_hud_button_stack_layout(wizard_hud_button, 2)

	if wizard_hud_open and visible_magic:
		_rebuild_wizard_hub_content(false)


func _rebuild_wizard_hub_content(force:= false) -> void:
	if wizard_hud_list == null or gs == null or gs.player == null:
		return
	if gs.wizard_engine == null:
		return

	var signature: String = MainSceneLogic._wizard_hub_signature(gs)
	if not force and wizard_hud_last_signature == signature:
		return
	wizard_hud_last_signature = signature

	for child in wizard_hud_list.get_children():
		child.queue_free()

	var profile: Dictionary = gs.wizard_engine.ensure_wizard_profile(gs.player)
	var skill: Dictionary = profile.get("skill", {}) if typeof(profile.get("skill", {})) == TYPE_DICTIONARY else {}
	var wand: Dictionary = profile.get("wand", {}) if typeof(profile.get("wand", {})) == TYPE_DICTIONARY else {}
	var energy: Dictionary = profile.get("energy", {}) if typeof(profile.get("energy", {})) == TYPE_DICTIONARY else {}
	var competition: Dictionary = profile.get("competition", {}) if typeof(profile.get("competition", {})) == TYPE_DICTIONARY else {}
	var known_spells: Array = profile.get("known_spells", []) if typeof(profile.get("known_spells", [])) == TYPE_ARRAY else []

	wizard_hud_title_label.text = "WIZARD HUB • %s" % str(profile.get("archetype", "wizard")).capitalize()
	wizard_hud_subtitle_label.text = "%s wizard • %s • Wand: %s Lv.%d" % [
		str(profile.get("wizard_blood_status", "human")).capitalize(),
		"Full Wizard" if bool(profile.get("full_wizard", false)) else str(profile.get("magic_status", "active")).capitalize(),
		str(wand.get("name", "Training Wand")),
		int(wand.get("level", 1))
	]

	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_label("Family Magic"))
	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_body("Family Rank: %s\nSibling Rivalry: %d\nCompetition: %s" % [
		str(profile.get("family_power_rank", "ordinary")).capitalize(),
		int((profile.get("family", {}) if typeof(profile.get("family", {})) == TYPE_DICTIONARY else {}).get("sibling_rivalry", 0)),
		"Available" if bool(competition.get("available", false)) else str(competition.get("result", "Not ready")).capitalize()
	]))

	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_label("Magic Skill"))
	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_body("Spellcraft: %d\nWand Control: %d\nSpell Theory: %d\nDueling: %d\nDark Magic: %d" % [
		int(skill.get("spellcraft", 0)),
		int(skill.get("wand_control", 0)),
		int(skill.get("spell_theory", 0)),
		int(skill.get("dueling", 0)),
		int(skill.get("dark_magic", 0))
	]))

	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_label("Energy Flow"))
	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_body("Magic: %d\nChi: %d\nFlow Balance: %d\nInstability: %d" % [
		int(energy.get("magic", 0)),
		int(energy.get("chi", 0)),
		int(energy.get("flow_balance", 100)),
		int(energy.get("instability", 0))
	]))

	wizard_hud_list.add_child(MainSceneHelpers._make_wizard_hub_label("Actions"))

	var study_button: Button = MainSceneHelpers._make_wizard_hub_button("Study at Ancient Wizard Library")
	study_button.pressed.connect(_on_wizard_study_pressed)
	wizard_hud_list.add_child(study_button)

	var practice_button: Button = MainSceneHelpers._make_wizard_hub_button("Practice Magic")
	practice_button.pressed.connect(_on_wizard_practice_pressed)
	wizard_hud_list.add_child(practice_button)

	var duel_button: Button = MainSceneHelpers._make_wizard_hub_button("Practice Dueling")
	duel_button.pressed.connect(_on_wizard_duel_practice_pressed)
	wizard_hud_list.add_child(duel_button)

	var food_button: Button = MainSceneHelpers._make_wizard_hub_button("Summon Burger Combo")
	food_button.disabled = "summon_burger_combo" not in known_spells
	food_button.pressed.connect(_on_wizard_summon_burger_pressed)
	wizard_hud_list.add_child(food_button)

	var steal_button: Button = MainSceneHelpers._make_wizard_hub_button("Steal a Better Wand 😈")
	steal_button.pressed.connect(_on_wizard_steal_wand_pressed)
	wizard_hud_list.add_child(steal_button)

	var competition_button: Button = MainSceneHelpers._make_wizard_hub_button("Enter Family Wizard Competition")
	competition_button.disabled = not bool(competition.get("available", false)) or bool(competition.get("resolved", false))
