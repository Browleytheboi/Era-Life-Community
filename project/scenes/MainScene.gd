func _relationship_profile_switch_complete_packet_hot_for_target(
	target_id: int
) -> bool:
	if target_id <= 0:
		return false

	var packet: Dictionary = (
		_resident_profile_switch_packet_for_actor_id(
			target_id
		)
	)

	if not _relationship_profile_switch_packet_core_hot(
		packet,
		target_id
	):
		return false

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"surface_contract",
			{}
		)
	)
	var main_tab_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"main_tab_surface_contracts",
			surface.get(
				"main_tab_surface_contracts",
				{}
			)
		)
	)
	var support_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"control_switch_support_surface_packet",
			surface.get(
				"control_switch_support_surface_packet",
				{}
			)
		)
	)

	return (
		_resident_main_tab_contract_deck_is_complete_for_actor(
			main_tab_deck,
			target_id
		)
		and _control_switch_support_surface_packet_is_renderable(
			support_packet,
			target_id
		)
	)


func _relationship_profile_switch_destination_upgrade_pending_for_target(
	target_id: int = -1
) -> bool:
	if (
		gs == null
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return false

	if not bool(
		gs.scenario_state.get(
			"relationship_profile_switch_destination_upgrade_requested",
			false
		)
	):
		return false

	var pending_target_id: int = int(
		gs.scenario_state.get(
			"relationship_profile_switch_destination_upgrade_target_id",
			-1
		)
	)

	if pending_target_id <= 0:
		return false

	if (
		target_id > 0
		and pending_target_id != target_id
	):
		return false

	if _relationship_profile_switch_complete_packet_hot_for_target(
		pending_target_id
	):
		return false

	return true


func _clear_relationship_profile_switch_destination_upgrade_request(
	target_id: int,
	reason: String = "complete_packet_observed"
) -> void:
	if (
		gs == null
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
		or target_id <= 0
	):
		return

	var pending_target_id: int = int(
		gs.scenario_state.get(
			"relationship_profile_switch_destination_upgrade_target_id",
			-1
		)
	)

	if (
		pending_target_id > 0
		and pending_target_id != target_id
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"relationship_profile_switch_destination_upgrade_requested",
		false
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_completed_target_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_completed_reason",
		reason
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_completed_at_ms",
		now_ms
	)

	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_requested"
	] = false
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_completed_target_id"
	] = target_id
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_completed_reason"
	] = reason
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_completed_at_ms"
	] = now_ms
func _queue_relationship_profile_switch_destination_upgrade_intent(
	target_id: int,
	reason: String = "relationship_profile_observed"
) -> void:
	if (
		gs == null
		or gs.player == null
		or target_id <= 0
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var resident_packet: Dictionary = (
		_resident_profile_switch_packet_for_actor_id(
			target_id
		)
	)




	if _relationship_profile_switch_packet_core_hot(
		resident_packet,
		target_id
	):
		_clear_relationship_profile_switch_destination_upgrade_request(
			target_id,
			"universal_switch_core_already_hot_before_profile_queue"
		)

		call_deferred(
			"_on_relationships_hub_resident_switch_destination_packet_published",
			target_id,
			resident_packet.duplicate(false)
		)

		return

	set_meta(
		"relationship_profile_switch_destination_upgrade_requested",
		true
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_target_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_reason",
		reason
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_at_ms",
		now_ms
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_core_only",
		true
	)
	set_meta(
		"relationship_profile_switch_destination_upgrade_support_deck_required",
		false
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_requested"
	] = true
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_target_id"
	] = target_id
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_reason"
	] = reason
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_at_ms"
	] = now_ms
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_click_build_forbidden"
	] = true
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_ready_gate_member"
	] = false
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_core_only"
	] = true
	gs.scenario_state [
		"relationship_profile_switch_destination_upgrade_support_deck_required"
	] = false



	_express_global_ui_intent(
		{
			"actor_id": int(
				gs.player.id
			),
			"target_id": target_id,
			"intent_type": (
				"relationships_hub_profile_switch_destination_upgrade"
			),
			"surface_id": "relationship_profile_panel",
			"action_id": "queue_switch_shell_stage",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"action_id": "queue_switch_shell_stage",
				"target_id": target_id,
				"source": reason,
				"relationship_profile_visible_packet": false,
				"explicit_relationship_profile_observation": false,
				"profile_switch_packet_required_before_visible": false,
				"complete_destination_deck_required": false,
				"pointer_only_packet_forbidden": false,
				"allow_pointer_core_only_preparation": true,
				"visible_card_may_not_publish_complete_destination_deck": true,
				"relationship_card_surface_only": true,
				"relationship_priority": true,
				"background_only": true,
				"blocks_ui": false,
				"ui_safe_microtask": true,
				"switch_press_must_not_build_surface": true,
				"switch_press_build_forbidden": true,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"relationships_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": int(
					gs.player.id
				)
			},
			"source": reason
		},
		{
			"actor_id": int(
				gs.player.id
			),
			"target_id": target_id,
			"surface_id": "relationship_profile_panel",
			"action_id": "queue_switch_shell_stage",
			"source": reason,
			"relationship_profile_visible_packet": false,
			"explicit_relationship_profile_observation": false,
			"complete_destination_deck_required": false,
			"background_only": true,
			"ready_gate_member": false,
			"ui_is_expression_only": true
		}
	)

	EraLog.truth(
		"RELATIONSHIP_PROFILE_SWITCH_DESTINATION_CORE_QUEUED"
		+ "|target_id=" + str(target_id)
		+ "|source=" + reason
		+ "|authority=UniversalSwitchContractEngine"
		+ "|pointer_core_required=true"
		+ "|complete_destination_deck_required=false"
		+ "|support_deck_blocks_switch=false"
		+ "|blocks_ui=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(now_ms)
	)
func _on_relationship_hub_full_profile_pressed(
	npc_id: int,
	cached_target: Variant = null,
	cached_profile_contract: Dictionary = {},
	return_context: String = "resident_relationship_hub",
	prepare_switch_destination: bool = true
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var target_id: int = int(
		npc_id
	)

	if target_id <= 0:
		return

	if not _relationship_profile_try_consume_click(
		"open_profile",
		"relationship_hub",
		target_id,
		90
	):
		return

	var target: Person = null

	if cached_target is Person:
		var cached_person: Person = (
			cached_target as Person
		)

		if (
			cached_person != null
			and int(
				cached_person.id
			) == target_id
		):
			target = cached_person

	if target == null:
		target = _relationship_profile_cached_target_for_id(
			target_id
		)

	if target == null:
		if (
			relationship_hub_panel != null
			and is_instance_valid(
				relationship_hub_panel
			)
		):
			relationship_hub_panel.set_status(
				"That prepared relationship target is no longer observable."
			)

		set_meta(
			"relationship_profile_open_rejected_missing_prepared_target",
			true
		)
		set_meta(
			"relationship_profile_open_press_build_performed",
			false
		)
		return

	var profile_contract: Dictionary = (
		cached_profile_contract.duplicate(
			false
		)
	)
	var resident_relationship_request: bool = (
		not cached_profile_contract.is_empty()
		or (
			relationship_hub_panel != null
			and is_instance_valid(
				relationship_hub_panel
			)
			and relationship_hub_panel.visible
		)
	)

	if profile_contract.is_empty():
		var contract_cache_raw: Variant = get_meta(
			"relationship_profile_contract_by_target",
			{}
		)
		var contract_cache: Dictionary = (
			contract_cache_raw as Dictionary
			if typeof(
				contract_cache_raw
			) == TYPE_DICTIONARY
			else {}
		)
		var cached_contract_raw: Variant = (
			contract_cache.get(
				str(
					target_id
				),
				{}
			)
		)

		if typeof(
			cached_contract_raw
		) == TYPE_DICTIONARY:
			profile_contract = (
				cached_contract_raw as Dictionary
			).duplicate(
				false
			)

	if (
		profile_contract.is_empty()
		and not resident_relationship_request
	):
		var target_alive: bool = (
			bool(
				target.alive
			)
			and float(
				target.health
			) > 0.0
		)



		profile_contract = {
			"schema": "eralife.relationships_hub.profile_contract",
			"version": 2,
			"actor_id": int(
				gs.player.id
			),
			"target_id": target_id,
			"title": _relationship_display_name(
				target
			),
			"target_name": _relationship_display_name(
				target
			),
			"bank_text": (
				_relationship_profile_bank_balance_text(
					target
				)
			),
			"target_alive": target_alive,
			"can_switch": false,
			"switch_semantically_available": false,
			"can_edit": target_alive,
			"switch_label": (
				MainSceneHelpers._switch_action_label_for_target(
					target
				)
			),
			"edit_label": "EDIT THEM",
			"switch_packet": {},
			"switch_packet_hot": false,
			"switch_packet_core_hot": false,
			"stats": [],
			"profile_text": (
				"===== PROFILE =====\n%s\n"
				+ "This compatibility lens has no switch authority.\n"
				+ "==================="
			) % _relationship_display_name(
				target
			),
			"actions": [],
			"truth_state": "observable_partial",
			"press_frame_build_forbidden": true,
			"ui_is_renderer_only": true
		}

	var profile_target_id: int = int(
		profile_contract.get(
			"target_id",
			-1
		)
	)
	var semantic_can_switch: bool = bool(
		profile_contract.get(
			"switch_semantically_available",
			profile_contract.get(
				"can_switch",
				false
			)
		)
	)
	var switch_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		profile_contract.get(
			"switch_packet",
			{}
		)
	)
	var switch_packet_hot: bool = (
		_relationship_profile_switch_packet_core_hot(
			switch_packet,
			target_id
		)
	)




	var render_contract: Dictionary = (
		profile_contract.duplicate(
			false
		)
	)
	render_contract ["can_switch"] = (
		semantic_can_switch
		and switch_packet_hot
	)
	render_contract [
		"switch_semantically_available"
	] = semantic_can_switch
	render_contract [
		"switch_packet_hot"
	] = switch_packet_hot
	render_contract [
		"switch_packet_core_hot"
	] = switch_packet_hot
	render_contract [
		"profile_observability_independent_from_switch_readiness"
	] = true

	var profile_projection_hot: bool = (
		not profile_contract.is_empty()
		and profile_target_id == target_id
		and (
			not resident_relationship_request
			or (
				str(
					profile_contract.get(
						"truth_state",
						""
					)
				) == "hot"
				and not MainSceneHelpers._safe_array(
					profile_contract.get(
						"stats",
						[]
					)
				).is_empty()
				and str(
					profile_contract.get(
						"profile_text",
						""
					)
				).strip_edges() != ""
			)
		)
	)

	if not profile_projection_hot:
		if (
			relationship_hub_panel != null
			and is_instance_valid(
				relationship_hub_panel
			)
		):
			relationship_hub_panel.set_status(
				"The resident relationship profile projection is not hot."
			)

		set_meta(
			"relationship_profile_open_rejected_unprepared_contract",
			true
		)
		set_meta(
			"relationship_profile_open_rejected_target_id",
			target_id
		)
		set_meta(
			"relationship_profile_open_press_build_performed",
			false
		)
		set_meta(
			"relationship_profile_open_press_engine_calls",
			false
		)
		set_meta(
			"relationship_profile_open_fallback_contract_synthesis_forbidden",
			resident_relationship_request
		)
		set_meta(
			"relationship_profile_open_rejected_because_switch_packet_cold",
			false
		)
		return

	_relationship_profile_cache_target_for_surface(
		target
	)

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		_rebind_persistent_main_tab_renderer_references()

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		set_meta(
			"relationship_profile_open_rejected_missing_persistent_shell",
			true
		)
		set_meta(
			"relationship_profile_open_press_deferred_build_scheduled",
			false
		)
		set_meta(
			"relationship_profile_open_press_build_performed",
			false
		)
		return

	var clean_return_context: String = str(
		return_context
	).strip_edges().to_lower()

	if clean_return_context == "":
		clean_return_context = (
			"resident_relationship_hub"
		)

	relationship_profile_return_context = (
		clean_return_context
	)
	relationships_browser_selected_id = target_id
	relationship_profile_popup_open = true

	relationship_profile_panel.open_contract(
		render_contract
	)

	if prepare_switch_destination:
		_queue_relationship_profile_switch_destination_upgrade_intent(
			target_id,
			"relationship_profile_observed_full_surface"
		)

	_claim_interactive_surface_authority(
		relationship_profile_panel,
		"relationship_profile_panel:%d" % target_id,
		"show_relationship_profile_panel_cached_contract",
		true,
		true
	)
	_suppress_relationship_lower_surfaces_for_profile()

	set_meta(
		"relationship_profile_open_press_did_not_build",
		true
	)
	set_meta(
		"relationship_profile_open_press_did_not_fetch",
		true
	)
	set_meta(
		"relationship_profile_open_press_did_not_call_engine",
		true
	)
	set_meta(
		"relationship_profile_open_press_did_not_prewarm_switch",
		true
	)
	set_meta(
		"relationship_profile_open_press_consumed_hot_contract",
		profile_projection_hot
	)
	set_meta(
		"relationship_profile_open_press_switch_packet_hot",
		switch_packet_hot
	)
	set_meta(
		"relationship_profile_opened_with_switch_destination_pending",
		semantic_can_switch
		and not switch_packet_hot
	)
	set_meta(
		"relationship_profile_destination_revealed_before_source_hidden",
		true
	)
	set_meta(
		"relationship_cards_remained_resident",
		true
	)

	EraLog.truth(
		"ERALIFE_RELATIONSHIP_PROFILE_DOOR_TRUTH"
		+ "|target_id=" + str(target_id)
		+ "|profile_hot="
		+ str(
			profile_projection_hot
		).to_lower()
		+ "|switch_semantically_available="
		+ str(
			semantic_can_switch
		).to_lower()
		+ "|switch_packet_hot="
		+ str(
			switch_packet_hot
		).to_lower()
		+ "|profile_blocked_by_switch=false"
		+ "|shell_preexisting=true"
		+ "|build_on_press=false"
		+ "|engine_calls=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)
func _on_standard_tab_action_pressed(action_id: String) -> void:
	if gs == null:
		return
	if action_id.begins_with("Prison Activity::"):
		var prison_activity_type: String = action_id.trim_prefix("Prison Activity::")
		_commit_prison_activity_intent(prison_activity_type)
		return
	var global_intent_surface_id: String = "life_panel" if action_id.begins_with("Life ") else "standard_tab"

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "standard_tab_action",
			"surface_id": global_intent_surface_id,
			"action_id": action_id,
			"legacy_action_id": action_id,
			"legacy_callback": "_on_standard_tab_action_pressed",
			"legacy_args": [
				action_id
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_standard_tab_action_pressed"
			},
			"source": "mainscene.standard_tab_action"
		}, {
			"source": "mainscene.standard_tab_action",
			"surface_id": global_intent_surface_id,
			"action_id": action_id,
			"legacy_callback": "_on_standard_tab_action_pressed",
			"legacy_args": [
				action_id
			]
		})
		return

	_emit_ui_action_contract({
		"surface_id": global_intent_surface_id,
		"legacy_action_id": action_id,
		"action_id": action_id,
		"source": "mainscene.standard_tab_action"
	})
	if action_id.begins_with("Other Country Action::"):
		var action_parts: PackedStringArray = action_id.split("::")
		if action_parts.size() >= 3:
			var world_action_key: String = str(action_parts [1])
			var world_entry_id: String = str(action_parts [2])
			var world_entry: Dictionary = _resolve_other_country_browser_entry_by_id(world_entry_id)
			_handle_other_country_action(world_action_key, world_entry)
		return
	if action_id == "Life View Assets":
		_show_life_assets_popup(gs.player)
		return

	if action_id == "Life Assets Back":
		var assets_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_life_assets_popup(assets_owner)
		return

	if action_id.begins_with("Life Assets Open Market::"):
		var life_market_kind: String = action_id.trim_prefix("Life Assets Open Market::")
		if life_market_kind == "property":
			_show_property_market_panel()
			return
		if life_market_kind == "vehicle":
			_show_vehicle_market_panel()
			return
		_show_era_asset_market_popup(life_market_kind)
		return
	if action_id.begins_with("Life Asset Open::"):
		var life_asset_parts: PackedStringArray = action_id.split("::")
		if life_asset_parts.size() >= 3:
			var life_asset_kind: String = str(life_asset_parts [1])
			var life_asset_id: int = int(life_asset_parts [2])
			var life_asset_owner: Person = _standard_tab_popup_owner_from_payload()
			if life_asset_kind == "property":
				_show_property_portfolio_asset_popup(life_asset_owner, life_asset_id, "", "life_assets")
				return
			if life_asset_kind == "vehicle":
				_show_vehicle_portfolio_asset_popup(life_asset_owner, life_asset_id, "", "life_assets")
				return
	if action_id.begins_with("Era Market Buy::"):
		var market_action_parts: PackedStringArray = action_id.split("::")
		if market_action_parts.size() >= 3:
			var market_kind: String = str(market_action_parts [1])
			var template_id: String = str(market_action_parts [2])
			if market_kind == "property":
				_show_property_market_panel("", template_id)
				return
			if market_kind == "vehicle":
				_show_vehicle_market_panel("", template_id)
				return

	if action_id == "Property Portfolio Back":
		var holdings_popup_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_property_portfolio_popup(holdings_popup_owner)
		return

	if action_id.begins_with("Property Portfolio Open::"):
		var open_property_asset_id: int = int(action_id.trim_prefix("Property Portfolio Open::"))
		var open_property_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_property_portfolio_asset_popup(open_property_owner, open_property_asset_id)
		return

	if action_id.begins_with("Property Portfolio Inspect::"):
		var inspect_property_asset_id: int = int(action_id.trim_prefix("Property Portfolio Inspect::"))
		var inspect_property_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_property_portfolio_asset_popup(inspect_property_owner, inspect_property_asset_id)
		return

	if action_id.begins_with("Property Portfolio Enter::"):
		var enter_property_id: int = int(action_id.trim_prefix("Property Portfolio Enter::"))
		var enter_property_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_property_viewer_panel(enter_property_owner, enter_property_id)
		return

	if action_id.begins_with("Property Portfolio Makeover::"):
		var makeover_property_id: int = int(action_id.trim_prefix("Property Portfolio Makeover::"))
		var makeover_property_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_property_makeover_panel(makeover_property_owner, makeover_property_id)
		return

	if action_id.begins_with("Property Portfolio Asset Action::"):
		var property_action_parts: PackedStringArray = action_id.split("::")
		if property_action_parts.size() >= 3:
			var property_asset_id: int = int(property_action_parts [1])
			var property_action_key: String = str(property_action_parts [2])
			var property_asset_owner: Person = _standard_tab_popup_owner_from_payload()
			var property_action_result: Dictionary = gs.property_engine.run_asset_action(
				property_asset_owner,
				property_asset_id,
				property_action_key
			)
			var property_return_context: String = str(standard_tab_popup_payload.get("return_context", "property_portfolio"))
			_show_property_portfolio_asset_popup(
				property_asset_owner,
				property_asset_id,
				str(property_action_result.get("text", "")),
				property_return_context
			)
		return

	if action_id == "Vehicle Portfolio Back":
		var fleet_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_vehicle_portfolio_popup(fleet_owner)
		return

	if action_id.begins_with("Vehicle Portfolio Open::"):
		var open_asset_id: int = int(action_id.trim_prefix("Vehicle Portfolio Open::"))
		var open_owner: Person = _standard_tab_popup_owner_from_payload()
		_show_vehicle_portfolio_asset_popup(open_owner, open_asset_id)
		return

	if action_id.begins_with("Vehicle Portfolio Cycle Operator::"):
		var operator_asset_id: int = int(action_id.trim_prefix("Vehicle Portfolio Cycle Operator::"))
		var operator_owner: Person = _standard_tab_popup_owner_from_payload()
		var operator_result: Dictionary = gs.vehicle_engine.cycle_vehicle_portfolio_operator(operator_owner, operator_asset_id)
		var operator_return_context: String = str(standard_tab_popup_payload.get("return_context", "vehicle_portfolio"))
		_show_vehicle_portfolio_asset_popup(
			operator_owner,
			operator_asset_id,
			str(operator_result.get("text", "")),
			operator_return_context
		)
		return

	if action_id.begins_with("Vehicle Portfolio Cycle Route::"):
		var route_asset_id: int = int(action_id.trim_prefix("Vehicle Portfolio Cycle Route::"))
		var route_owner: Person = _standard_tab_popup_owner_from_payload()
		var route_result: Dictionary = gs.vehicle_engine.cycle_vehicle_portfolio_route(route_owner, route_asset_id)
		var route_return_context: String = str(standard_tab_popup_payload.get("return_context", "vehicle_portfolio"))
		_show_vehicle_portfolio_asset_popup(
			route_owner,
			route_asset_id,
			str(route_result.get("text", "")),
			route_return_context
		)
		return

	if action_id.begins_with("Vehicle Portfolio Cycle Trade Role::"):
		var role_asset_id: int = int(action_id.trim_prefix("Vehicle Portfolio Cycle Trade Role::"))
		var role_owner: Person = _standard_tab_popup_owner_from_payload()
		var role_result: Dictionary = gs.vehicle_engine.cycle_vehicle_trade_role(role_owner, role_asset_id)
		var role_return_context: String = str(standard_tab_popup_payload.get("return_context", "vehicle_portfolio"))
		_show_vehicle_portfolio_asset_popup(
			role_owner,
			role_asset_id,
			str(role_result.get("text", "")),
			role_return_context
		)
		return

	if action_id.begins_with("Career Hub Open Job::"):
		var career_open_parts: PackedStringArray = action_id.split("::")
		if career_open_parts.size() >= 4:
			var career_open_kind: String = str(career_open_parts [2])
			var career_open_job_name: String = str(career_open_parts [3])
			_show_career_job_overview(career_open_kind, career_open_job_name)
		return

	if action_id.begins_with("Career Hub Apply Job::"):
		var career_apply_parts: PackedStringArray = action_id.split("::")
		if career_apply_parts.size() >= 4 and gs.career_engine != null and gs.player != null:
			var career_apply_kind: String = str(career_apply_parts [2])
			var career_apply_job_name: String = str(career_apply_parts [3])
			var raw_career_apply_result: Variant = null
			if career_apply_kind == "part_time":
				raw_career_apply_result = gs.career_engine.apply_for_part_time_job(gs.player, career_apply_job_name)
			else:
				raw_career_apply_result = gs.career_engine.apply_for_job(gs.player, career_apply_job_name)

			var career_apply_result: Dictionary = raw_career_apply_result if typeof(raw_career_apply_result) == TYPE_DICTIONARY else {
				"success": false,
				"text": "You applied for %s, but the result could not be resolved." % career_apply_job_name
			}
			career_apply_result = MainSceneHelpers._normalize_career_job_apply_result(career_apply_job_name, career_apply_result)

			_hide_career_job_overview_popup()
			_hide_career_job_browser_popup()

			var career_apply_text: String = str(career_apply_result.get("text", "")).strip_edges()
			if career_apply_text != "":
				_append_text_to_diary(career_apply_text, false)

			_maybe_show_action_result_popup(career_apply_result)
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return

	if action_id == "Career Job Detail Back":
		_hide_career_job_detail_popup()
		return

	if action_id == "Career Coworkers Back":
		_print_career_panel()
		return

	if action_id.begins_with("Career Job Inspect::"):
		var job_name: String = action_id.trim_prefix("Career Job Inspect::")
		_open_career_job_detail_popup(job_name)
		return

	var resolved_action_id: String = action_id

	if action_id.begins_with("Career Job Apply::"):
		var job_name_to_apply: String = action_id.trim_prefix("Career Job Apply::")
		resolved_action_id = "Apply For Job::%s" % job_name_to_apply
		_hide_career_job_detail_popup()

	var raw_result: Variant = null
	if gs.opportunity_engine != null and gs.opportunity_engine.has_method("resolve_action"):
		raw_result = gs.opportunity_engine.resolve_action(resolved_action_id)
	elif gs.player_action_engine != null and gs.player_action_engine.has_method("resolve_action"):
		raw_result = gs.player_action_engine.resolve_action(resolved_action_id)
	else:
		raw_result = { "text": "Unknown action."}

	var result: Dictionary = raw_result if typeof(raw_result) == TYPE_DICTIONARY else { "text": "Done."}
	var result_type:= str(result.get("type", ""))

	if result_type == "open_career_coworkers_panel":
		var coworker_ids: Array = result.get("coworker_ids", [])
		_hide_standard_tab_popup()
		_show_career_coworkers_panel(coworker_ids)
		return

	if result_type == "open_property_portfolio_panel":
		var holdings_owner: Person = gs.player
		var holdings_owner_id: int = int(result.get("owner_id", -1))
		if holdings_owner_id > 0:
			var resolved_holdings_owner: Person = gs.get_or_reactivate_npc_by_id(holdings_owner_id)
			if resolved_holdings_owner != null:
				holdings_owner = resolved_holdings_owner
		_show_property_portfolio_popup(holdings_owner, str(result.get("text", "")))
		return

	if result_type == "open_vehicle_portfolio_panel":
		var mobility_owner: Person = gs.player
		var mobility_owner_id: int = int(result.get("owner_id", -1))
		if mobility_owner_id > 0:
			var resolved_mobility_owner: Person = gs.get_or_reactivate_npc_by_id(mobility_owner_id)
			if resolved_mobility_owner != null:
				mobility_owner = resolved_mobility_owner
		_show_vehicle_portfolio_popup(mobility_owner, str(result.get("text", "")))
		return

	var result_text:= str(result.get("text", "Done."))
	_hide_standard_tab_popup()
	if result_text.strip_edges() != "":
		_append_text_to_diary(result_text, false)
	_maybe_show_action_result_popup(result)
	_render_life_diary_panel()
	_update_player_stats_overlay()
func _commit_prison_activity_intent(activity_type: String) -> void:
	if gs == null or gs.player == null:
		return

	var context: Dictionary = MainSceneHelpers._incarceration_context_for_actor(gs.player)
	if context.is_empty():
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Not Incarcerated",
			"popup_text": "You are not currently incarcerated.",
			"popup_footer": "No prison activity was committed."
		})
		return

	var payload: Dictionary = {
		"intent": "PRISON_ACTIVITY",
		"type": str(activity_type).strip_edges(),
		"actor_id": int(gs.player.id),
		"context": context.duplicate(true),
		"source": "mainscene.incarceration_lens"
	}

	if gs.global_intent_contract_engine != null and gs.global_intent_contract_engine.has_method("commit"):
		var result: Dictionary = gs.global_intent_contract_engine.commit(payload)
		_maybe_show_action_result_popup(result)
		return

	_maybe_show_action_result_popup({
		"success": true,
		"committed": true,
		"popup_title": "Prison Activity",
		"popup_text": "You committed prison activity intent: %s." % str(activity_type).replace("_", " ").capitalize(),
		"popup_footer": "GlobalIntentContractEngine was unavailable, so this rendered as a compatibility commit.",
		"text": "I tried to do a prison activity: %s." % str(activity_type).replace("_", " ").to_lower()
	})
func _emit_ui_action_contract(payload: Dictionary) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "GameState unavailable."
		}

	var clean_payload: Dictionary = payload.duplicate(true)
	var surface_id: String = str(clean_payload.get("surface_id", "standard_tab")).strip_edges()
	var action_id: String = str(clean_payload.get("action_id", clean_payload.get("legacy_action_id", "ui.action"))).strip_edges()

	clean_payload ["surface_id"] = surface_id
	clean_payload ["action_id"] = action_id
	clean_payload ["emitted_at_ms"] = int(Time.get_ticks_msec())

	if _global_intent_commit_scope_active():
		var observe_engine = _ensure_global_intent_contract_engine()
		if observe_engine != null and observe_engine.has_method("observe_committed_ui_signal"):
			return observe_engine.observe_committed_ui_signal(clean_payload, {
				"source": "mainscene.emit_ui_action_contract",
				"surface_id": surface_id,
				"action_id": action_id,
				"intent_id": str(get_meta("global_intent_commit_scope_intent_id", "")),
				"global_intent_id": str(get_meta("global_intent_commit_scope_intent_id", "")),
			})

		return {
			"success": true,
			"mode": "global_intent_commit_scope_signal_observed_without_engine",
			"surface_id": surface_id,
			"action_id": action_id,
		}

	return _express_global_ui_intent({
		"intent_type": "ui_action",
		"surface_id": surface_id,
		"action_id": action_id,
		"legacy_action_id": action_id,
		"payload": clean_payload.duplicate(true),
		"legacy_callback": "_on_standard_tab_action_pressed",
		"legacy_args": [
			action_id
		],
		"target": {
			"route_kind": "main_scene_legacy_callback",
			"callback": "_on_standard_tab_action_pressed"
		},
		"source": str(clean_payload.get("source", "mainscene.emit_ui_action_contract"))
	}, {
		"source": "mainscene.emit_ui_action_contract",
		"surface_id": surface_id,
		"action_id": action_id,
		"legacy_callback": "_on_standard_tab_action_pressed",
		"legacy_args": [
			action_id
		]
	})
func _ensure_global_intent_contract_engine(
	authority_game_state: GameState = null
):
	var resolved_authority: GameState = (
		authority_game_state
	)

	if resolved_authority == null:
		resolved_authority = gs

	if resolved_authority == null:
		return null

	if not (
		"global_intent_contract_engine"
		in resolved_authority
	):
		return null



	# FIX: this function is named _ensure_* but ensured nothing -- it returned null
	# whenever the engine had not already been hydrated elsewhere. Every UI intent
	# routes through here, and _express_global_ui_intent() discards the failure
	# report, so a missing engine turned every button in the game into a silent
	# no-op. GameState already knows how to build it; ask it to.
	if (
		resolved_authority.global_intent_contract_engine
		== null
	):
		if resolved_authority.has_method(
			"_ensure_reality_residency_runtime_dependencies"
		):
			resolved_authority._ensure_reality_residency_runtime_dependencies()

	if (
		resolved_authority.global_intent_contract_engine
		== null
	):
		push_warning(
			"GlobalIntentContractEngine unavailable; UI intents cannot commit."
		)
		return null

	return (
		resolved_authority.global_intent_contract_engine
	)

func _global_intent_commit_scope_active() -> bool:
	return bool(get_meta("global_intent_commit_scope_active", false))


func _express_global_ui_intent(
		intent: Dictionary,
		context: Dictionary = {}
) -> Dictionary:
	var authority_game_state: GameState = gs
	var authority_raw: Variant = context.get(
		"intent_authority_game_state",
		null
	)

	if authority_raw is GameState:
		authority_game_state = (
			authority_raw as GameState
		)

	var engine = _ensure_global_intent_contract_engine(
		authority_game_state
	)

	if engine == null:
		var authority_instance_id: int = -1

		if authority_game_state != null:
			authority_instance_id = int(
				authority_game_state.get_instance_id()
			)

		return {
			"success": false,
			"reason": (
				"global_intent_contract_engine_unavailable"
			),
			"intent_authority_instance_id": (
				authority_instance_id
			),
			"intent_authority_is_current_game_state": (
				authority_game_state == gs
			),
			"intent_authority_is_residency_host": (
				authority_game_state
				== reality_residency_host_game_state
			),
		}




	var clean_intent: Dictionary = intent.duplicate(false)
	var payload_raw: Variant = clean_intent.get(
		"payload",
		{}
	)
	var target_raw: Variant = clean_intent.get(
		"target",
		{}
	)

	if typeof(
		payload_raw
	) == TYPE_DICTIONARY:
		clean_intent ["payload"] = (
			(payload_raw as Dictionary).duplicate(false)
		)

	if typeof(
		target_raw
	) == TYPE_DICTIONARY:
		clean_intent ["target"] = (
			(target_raw as Dictionary).duplicate(false)
		)

	if not clean_intent.has(
		"actor_id"
	):
		clean_intent ["actor_id"] = (
			MainSceneLogic._global_intent_current_actor_id(gs)
		)




	var clean_context: Dictionary = context.duplicate(false)

	clean_context.erase(
		"intent_authority_game_state"
	)
	clean_context.erase(
		"main_scene"
	)

	var clean_target_raw: Variant = clean_intent.get(
		"target",
		{}
	)
	var clean_target: Dictionary = (
		clean_target_raw as Dictionary
		if typeof(
			clean_target_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var route_kind: String = str(
		clean_target.get(
			"route_kind",
			""
		)
	).strip_edges().to_lower()



	if route_kind == "main_scene_legacy_callback":
		clean_context ["main_scene"] = self

	clean_context ["actor_id"] = int(
		clean_intent.get(
			"actor_id",
			MainSceneLogic._global_intent_current_actor_id(gs)
		)
	)
	clean_context ["current_panel"] = current_panel
	clean_context ["ui_is_expression_only"] = true
	clean_context ["ui_must_not_commit"] = true
	clean_context [
		"intent_context_deep_copy_performed"
	] = false
	clean_context [
		"main_scene_reference_supplied"
	] = (
		route_kind == "main_scene_legacy_callback"
	)
	clean_context [
		"intent_authority_instance_id"
	] = int(
		authority_game_state.get_instance_id()
	)
	clean_context [
		"intent_authority_is_current_game_state"
	] = (
		authority_game_state == gs
	)
	clean_context [
		"intent_authority_is_residency_host"
	] = (
		authority_game_state
		== reality_residency_host_game_state
	)

	return engine.receive_ui_intent(
		clean_intent,
		clean_context
	)


func _commit_global_intent_legacy_main_scene_callback(intent: Dictionary, context: Dictionary = {}) -> Dictionary:
	if not bool(context.get("global_intent_authorized_commit", false)):
		return {
			"success": false,
			"reason": "global_intent_commit_not_authorized",
			"mode": "legacy_main_scene_callback_rejected"
		}

	var target: Dictionary = _global_intent_safe_dictionary(intent.get("target", {}))
	var callback_name: String = str(target.get("callback", intent.get("legacy_callback", context.get("legacy_callback", "")))).strip_edges()
	var callback_args: Array = _global_intent_safe_array(intent.get("legacy_args", context.get("legacy_args", target.get("args", []))))

	if callback_name == "":
		return {
			"success": false,
			"reason": "missing_legacy_callback",
			"mode": "legacy_main_scene_callback_rejected"
		}

	if not has_method(callback_name):
		return {
			"success": false,
			"reason": "legacy_callback_missing",
			"mode": "legacy_main_scene_callback_rejected",
			"callback": callback_name
		}

	var previous_scope: bool = bool(get_meta("global_intent_commit_scope_active", false))
	var previous_intent_id: String = str(get_meta("global_intent_commit_scope_intent_id", ""))
	var previous_callback: String = str(get_meta("global_intent_commit_scope_callback", ""))

	set_meta("global_intent_commit_scope_active", true)
	set_meta("global_intent_commit_scope_intent_id", str(intent.get("intent_id", "")))
	set_meta("global_intent_commit_scope_callback", callback_name)
	set_meta("global_intent_commit_scope_started_at_ms", int(Time.get_ticks_msec()))

	var callback_result = callv(callback_name, callback_args)

	set_meta("global_intent_commit_scope_active", previous_scope)
	set_meta("global_intent_commit_scope_intent_id", previous_intent_id)
	set_meta("global_intent_commit_scope_callback", previous_callback)

	var committed: bool = true
	if typeof(callback_result) == TYPE_BOOL:
		committed = bool(callback_result)

	return {
		"success": committed,
		"mode": "legacy_main_scene_callback_committed",
		"callback": callback_name,
		"callback_arg_count": callback_args.size(),
		"intent_id": str(intent.get("intent_id", "")),
		"actor_id": int(intent.get("actor_id", -1)),
		"target_id": int(intent.get("target_id", -1)),
		"action_id": str(intent.get("action_id", "")),
		"committed_by_global_intent": true,
		"result": callback_result
	}


func _global_intent_safe_dictionary(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	return {}


func _global_intent_safe_array(value: Variant) -> Array:
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(true)
	return []
func _property_portfolio_asset_body_lines(payload: Dictionary, status_text: String = "") -> Array:
	var lines: Array = []
	lines.append("Estate: %s" % str(payload.get("display_name", "Property")))
	lines.append("Identity: %s • %s • %s • %s" % [
		str(payload.get("archetype", "residence")).replace("_", " ").capitalize(),
		str(payload.get("subtype", "")).replace("_", " ").capitalize(),
		str(payload.get("social_tier", "common")).replace("_", " ").capitalize(),
		str(payload.get("value_band", "entry")).replace("_", " ").capitalize()
	])
	lines.append("Address: %s" % str(payload.get("address", "Unknown Address")))
	lines.append("Condition: %d%% • %s" % [
		int(payload.get("condition", 100)),
		str(payload.get("condition_label", "Excellent"))
	])

	var estimated_value: int = int(payload.get("estimated_value", 0))
	if estimated_value > 0:
		var value_text: String = "$%d" % estimated_value
		if gs != null and gs.economy_engine != null:
			value_text = gs.economy_engine.format_money(estimated_value)
		lines.append("Estimated Value: %s" % value_text)

	var feature_tag_labels: Array = payload.get("feature_tag_labels", [])
	if not feature_tag_labels.is_empty():
		lines.append("Identity Tags: %s" % ", ".join(feature_tag_labels))

	var requirement_tag_labels: Array = payload.get("requirement_tag_labels", [])
	if not requirement_tag_labels.is_empty():
		lines.append("Requirements: %s" % ", ".join(requirement_tag_labels))

	var missing_requirement_labels: Array = payload.get("missing_requirement_labels", [])
	if not missing_requirement_labels.is_empty():
		lines.append("Missing Support: %s" % ", ".join(missing_requirement_labels))

	var satisfied_requirement_labels: Array = payload.get("satisfied_requirement_labels", [])
	if not satisfied_requirement_labels.is_empty():
		lines.append("Satisfied Support: %s" % ", ".join(satisfied_requirement_labels))

	var portfolio_tag_labels: Array = payload.get("portfolio_tag_labels", [])
	if not portfolio_tag_labels.is_empty():
		lines.append("Portfolio Tags: %s" % ", ".join(portfolio_tag_labels))

	var status_lines: Array = payload.get("status_lines", [])
	if not status_lines.is_empty():
		lines.append("")
		lines.append("Status Signals:")
		for line_text in status_lines:
			lines.append("• %s" % str(line_text))

	var operational_lines: Array = payload.get("operational_lines", [])
	if not operational_lines.is_empty():
		lines.append("")
		lines.append("Operational Profile:")
		for line_text in operational_lines:
			lines.append("• %s" % str(line_text))

	var pressure_lines: Array = payload.get("pressure_lines", [])
	if not pressure_lines.is_empty():
		lines.append("")
		lines.append("Story Pressure:")
		for line_text in pressure_lines:
			lines.append("• %s" % str(line_text))

	var provenance_lines: Array = payload.get("provenance_lines", [])
	if not provenance_lines.is_empty():
		lines.append("")
		lines.append("Provenance:")
		for line_text in provenance_lines:
			lines.append("• %s" % str(line_text))

	lines.append("")
	lines.append("Legal Status: %s" % str(payload.get("legal_status", "owned")))
	if str(payload.get("market_region", "")) != "":
		lines.append("Region: %s" % str(payload.get("market_region", "")))
	if str(payload.get("market_climate", "")) != "":
		lines.append("Market Climate: %s" % str(payload.get("market_climate", "")))

	if status_text.strip_edges() != "":
		lines.append("")
		lines.append(status_text.strip_edges())
	return lines


func _show_property_portfolio_asset_popup(
	portfolio_owner: Person,
	asset_id: int,
	status_text: String = "",
	return_context: String = "property_portfolio",
	prepared_asset_contract: Dictionary = {}
) -> bool:
	if (
		gs == null
		or portfolio_owner == null
		or asset_id <= 0
	):
		return false

	var payload: Dictionary = {}

	if not prepared_asset_contract.is_empty():
		var prepared_id: int = int(
			prepared_asset_contract.get(
				"asset_id",
				prepared_asset_contract.get(
					"property_id",
					prepared_asset_contract.get(
						"id",
						-1
					)
				)
			)
		)

		if prepared_id == asset_id:
			payload = prepared_asset_contract.duplicate(true)
			payload [
				"resolved_from_belongings_contract"
			] = true

	if payload.is_empty():
		payload = (
			_resident_property_asset_payload_for_actor(
				portfolio_owner,
				asset_id
			)
		)

	if payload.is_empty():
		set_meta(
			"property_asset_popup_resident_contract_missing",
			true
		)
		set_meta(
			"property_asset_popup_resident_contract_missing_actor_id",
			int(portfolio_owner.id)
		)
		set_meta(
			"property_asset_popup_resident_contract_missing_asset_id",
			asset_id
		)
		set_meta(
			"property_asset_popup_fell_back_to_life_shell",
			false
		)
		return false

	payload ["id"] = asset_id
	payload ["asset_id"] = asset_id
	payload ["property_id"] = asset_id
	payload ["asset_kind"] = "property"
	payload ["owner_id"] = int(portfolio_owner.id)
	payload ["return_context"] = return_context

	if str(
		payload.get(
			"display_name",
			""
		)
	).strip_edges() == "":
		payload ["display_name"] = str(
			payload.get(
				"name",
				"Estate"
			)
		)

	_show_standard_tab_popup(
		"ESTATE ASSET • %s" % str(
			payload.get(
				"display_name",
				"Property"
			)
		),
		_property_portfolio_asset_body_lines(
			payload,
			status_text
		),
		"property_portfolio_asset",
		payload
	)

	var revealed: bool = (
		standard_tab_popup_open
		and standard_tab_popup_kind == (
			"property_portfolio_asset"
		)
		and standard_tab_popup != null
		and is_instance_valid(
			standard_tab_popup
		)
		and standard_tab_popup.visible
	)

	set_meta(
		"property_asset_popup_renderer_called_property_engine",
		false
	)
	set_meta(
		"property_asset_popup_resident_contract_consumed",
		true
	)
	set_meta(
		"property_asset_popup_destination_revealed",
		revealed
	)
	set_meta(
		"property_asset_popup_fell_back_to_life_shell",
		false
	)

	return revealed
func _build_property_portfolio_asset_standard_tab() -> void:
	var asset_id: int = int(
		standard_tab_popup_payload.get(
			"asset_id",
			-1
		)
	)

	if asset_id <= 0:
		_standard_tab_add_info_label(
			"That estate is no longer available."
		)
		return

	var enter_label: String = (
		MainSceneHelpers._property_asset_enter_button_label(
			standard_tab_popup_payload
		)
	)

	_standard_tab_add_info_card(
		"LIVE PROPERTY SURFACE",
		[
			"You stand outside %s." % str(
				standard_tab_popup_payload.get(
					"display_name",
					"this property"
				)
			),
			"Address: %s" % str(
				standard_tab_popup_payload.get(
					"address",
					"Unknown Address"
				)
			),
			"Condition: %d%% - %s" % [
				int(
					standard_tab_popup_payload.get(
						"condition",
						100
					)
				),
				str(
					standard_tab_popup_payload.get(
						"condition_label",
						"Excellent"
					)
				)
			]
		]
	)

	_standard_tab_add_section_header(
		"Spatial Entry"
	)
	_standard_tab_add_action_button(
		"Enter %s" % enter_label,
		"Property Portfolio Enter::%d" % asset_id
	)
	_standard_tab_add_action_button(
		"Makeover / Upgrade %s" % enter_label,
		"Property Portfolio Makeover::%d" % asset_id
	)

	var action_rows: Array = MainSceneHelpers._safe_array(
		standard_tab_popup_payload.get(
			"action_rows",
			[]
		)
	)

	if not action_rows.is_empty():
		_standard_tab_add_section_header(
			"Estate Actions"
		)

		for raw_action in action_rows:
			if typeof(raw_action) != TYPE_DICTIONARY:
				continue

			var row: Dictionary = raw_action as Dictionary
			var property_action_key: String = str(
				row.get(
					"action_id",
					""
				)
			)

			if property_action_key == "":
				continue

			_standard_tab_add_action_button(
				str(
					row.get(
						"label",
						property_action_key.capitalize()
					)
				),
				"Property Portfolio Asset Action::%d::%s" % [
					asset_id,
					property_action_key
				]
			)

	var return_context: String = str(
		standard_tab_popup_payload.get(
			"return_context",
			"property_portfolio"
		)
	)

	if return_context in [
		"life_assets",
		"assets_panel"
	]:
		_standard_tab_add_action_button(
			"Back To Assets",
			"Life Assets Back"
		)
	else:
		_standard_tab_add_action_button(
			"Back To Holdings",
			"Property Portfolio Back"
		)
func _show_property_viewer_panel(
	property_owner: Person,
	asset_id: int,
	status_text: String = ""
) -> void:
	if (
		gs == null
		or property_owner == null
		or asset_id <= 0
	):
		return

	var surface_actor: Person = (
		gs.player
		if gs.player != null
		else property_owner
	)
	if surface_actor == null:
		return

	var actor_id: int = int(
		surface_actor.id
	)
	var prepared_panel: PropertyViewer = (
		_property_viewer_surface_panel_for(
			actor_id,
			asset_id
		)
	)
	if prepared_panel == null:
		set_meta(
			"property_viewer_click_invariant_failed",
			true
		)
		set_meta(
			"property_viewer_click_invariant_failed_actor_id",
			actor_id
		)
		set_meta(
			"property_viewer_click_invariant_failed_property_id",
			asset_id
		)
		set_meta(
			"property_viewer_click_engine_calls",
			false
		)
		set_meta(
			"property_viewer_click_build_on_click",
			false
		)
		set_meta(
			"property_viewer_click_rejected",
			true
		)
