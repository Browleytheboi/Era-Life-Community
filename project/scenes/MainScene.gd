		return false

	if (
		mod_menu_panel == null
		or not is_instance_valid(
			mod_menu_panel
		)
	):
		set_meta(
			"mod_menu_zero_frame_integrity_failure",
			true
		)
		set_meta(
			"mod_menu_zero_frame_integrity_failure_reason",
			reason
		)
		set_meta(
			"mod_menu_zero_frame_integrity_failure_mode",
			"renderer_shell_missing"
		)
		return false

	var precomposed_surface_hot: bool = (
		mod_menu_panel.has_precomposed_surface(
			int(
				gs.player.id
			)
		)
	)

	current_panel = "mods"
	mod_menu_active_actor_id = int(
		gs.player.id
	)

	_hide_main_tab_surfaces_visual_only(
		"mods",
		reason
	)

	if precomposed_surface_hot:
		mod_menu_panel.reveal_precomposed_surface(
			int(
				gs.player.id
			)
		)
	else:


		mod_menu_panel.visible = true
		mod_menu_panel.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)
		mod_menu_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)

	mod_menu_panel.z_as_relative = false
	mod_menu_panel.z_index = 250

	_bring_modal_to_front(
		mod_menu_panel
	)
	_claim_interactive_surface_authority(
		mod_menu_panel,
		"mod_menu_panel:%d"
		% int(
			gs.player.id
		),
		reason,
		true,
		true
	)

	set_meta(
		"mod_menu_zero_frame_integrity_failure",
		false
	)
	set_meta(
		"mod_menu_zero_frame_reveal_only",
		true
	)
	set_meta(
		"mod_menu_zero_frame_precomposed_surface_hot",
		precomposed_surface_hot
	)
	set_meta(
		"mod_menu_zero_frame_actor_truth_controls_door",
		false
	)
	set_meta(
		"mod_menu_zero_frame_render_contract_called",
		false
	)
	set_meta(
		"mod_menu_zero_frame_build_performed",
		false
	)

	return true

func _print_mod_menu_panel() -> void:
	_open_mod_menu_zero_frame_door(
