	)
func _ensure_mod_nav_button() -> void:
	var root:= get_node_or_null(
		"UIContainer"
	) as Control
	if root == null:
		return

	var existing:= root.find_child(
		"ModsButton",
		true,
		false
	) as Button
	if existing != null:
		existing.set_meta(
			"ui_nav_key",
			"mods"
		)
		existing.text = _ui_nav_button_display_label(
			"mods"
		)
		return

	var career_button: Button = null
	for node in root.find_children(
		"*",
		"Button",
		true,
		false
	):
		var candidate:= node as Button
		if candidate == null:
			continue
		if MainSceneHelpers._normalize_ui_nav_button_text(
			candidate.text
		) == "career":
			career_button = candidate
			break

	if career_button == null:
		return

	var parent:= career_button.get_parent()
	if parent == null:
		return

	var button:= Button.new()
	button.name = "ModsButton"
	button.text = _ui_nav_button_display_label(
		"mods"
	)
	button.set_meta(
		"ui_nav_key",
		"mods"
	)
	parent.add_child(button)
	parent.move_child(
		button,
		min(
			career_button.get_index() + 1,
			parent.get_child_count() - 1
		)
	)
func _populate_contract_surface_panel(surface: Dictionary) -> void:
	if ui_contract_surface_root == null:
		return

	for child in ui_contract_surface_root.get_children():
		child.queue_free()

	var surface_id: String = str(surface.get("surface_id", ui_contract_active_surface_id)).strip_edges()
	if surface_id == "":
		surface_id = ui_contract_active_surface_id

	_apply_contract_surface_panel_visual_theme(surface, surface_id)

	var header:= HBoxContainer.new()
	header.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_theme_constant_override("separation", 10)
	ui_contract_surface_root.add_child(header)

	var title:= Label.new()
	title.text = "%s %s" % [
		str(surface.get("icon", "")).strip_edges(),
		str(surface.get("title", surface.get("label", "Surface"))).strip_edges()
	]
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var surface_visual: Dictionary = MainSceneHelpers._contract_surface_visual_theme(surface, surface_id)

	var surface_title_color: Color = Color(0.92, 1.0, 1.0, 1.0)
	if surface_visual.has("title"):
		surface_title_color = surface_visual.get("title")

	title.add_theme_font_size_override("font_size", 24)
	title.add_theme_color_override("font_color", surface_title_color)
	title.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.7))
	title.add_theme_constant_override("shadow_outline_size", 5)
	header.add_child(title)

	_render_contract_surface_header_badges(header, surface, surface_id, surface_visual)

	var close_btn:= Button.new()
	close_btn.text = "×"
	close_btn.tooltip_text = "Close hub"
	close_btn.focus_mode = Control.FOCUS_NONE
	close_btn.custom_minimum_size = Vector2(34, 34)
	close_btn.size_flags_horizontal = Control.SIZE_SHRINK_END
	close_btn.size_flags_vertical = Control.SIZE_SHRINK_CENTER

	var close_bg: Color = Color(0.07, 0.032, 0.044, 0.92)
	var close_border: Color = Color(1.0, 0.5, 0.43, 0.54)
	var close_font: Color = Color(1.0, 0.9, 0.88, 1.0)

	if surface_visual.has("bg"):
		close_bg = surface_visual.get("bg")
	if surface_visual.has("border"):
		close_border = surface_visual.get("border")
	if surface_visual.has("title"):
		close_font = surface_visual.get("title")

	var close_normal_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(close_bg, close_border, 1, 17)
	var close_hover_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(close_bg.lightened(0.08), close_border.lightened(0.12), 2, 17)
	var close_pressed_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(close_bg.darkened(0.06), close_border, 2, 17)

	close_btn.add_theme_stylebox_override("normal", close_normal_style)
	close_btn.add_theme_stylebox_override("hover", close_hover_style)
	close_btn.add_theme_stylebox_override("pressed", close_pressed_style)
	close_btn.add_theme_stylebox_override("focus", close_hover_style)
	close_btn.add_theme_color_override("font_color", close_font)
	close_btn.add_theme_color_override("font_hover_color", close_font)
	close_btn.add_theme_color_override("font_pressed_color", close_font)
	close_btn.add_theme_font_size_override("font_size", 16)

	close_btn.pressed.connect(func ():
		_close_contract_surface_panel("header_x:%s" % surface_id)
	)
	header.add_child(close_btn)

	var subtitle_text: String = str(surface.get("subtitle", "")).strip_edges()
	if subtitle_text != "":
		var subtitle:= Label.new()
		subtitle.text = subtitle_text
		subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		subtitle.add_theme_font_size_override("font_size", 14)
		subtitle.add_theme_color_override("font_color", Color(0.78, 0.9, 0.94, 0.92))
		ui_contract_surface_root.add_child(subtitle)

	var surface_type: String = str(surface.get("surface_type", "")).strip_edges().to_lower()
	if surface_type == "hub":
		_render_contract_section_tabs(surface)

	var active_section_raw: Variant = surface.get("active_section", {})
	if typeof(active_section_raw) == TYPE_DICTIONARY and not (active_section_raw as Dictionary).is_empty():
		var active_section: Dictionary = (active_section_raw as Dictionary).duplicate(true)
		active_section ["surface_id"] = surface_id
		active_section ["active_section_id"] = str(surface.get("active_section_id", active_section.get("id", ""))).strip_edges()
		_render_contract_section(active_section)
	else:
		var sections: Array = surface.get("sections", []) if typeof(surface.get("sections", [])) == TYPE_ARRAY else []
		for raw_section in sections:
			if typeof(raw_section) != TYPE_DICTIONARY:
				continue
			var section: Dictionary = (raw_section as Dictionary).duplicate(true)
			section ["surface_id"] = surface_id
			section ["active_section_id"] = str(section.get("id", "")).strip_edges()
			_render_contract_section(section)

	var actions: Array = surface.get("actions", []) if typeof(surface.get("actions", [])) == TYPE_ARRAY else []
	for raw_action in actions:
		if typeof(raw_action) != TYPE_DICTIONARY:
			continue
		var action: Dictionary = raw_action
		var btn:= Button.new()
		btn.text = str(action.get("label", "Action"))
		btn.disabled = not bool(action.get("enabled", true))
		btn.focus_mode = Control.FOCUS_NONE
		btn.pressed.connect(func ():
			_handle_contract_action(surface, action)
		)
		ui_contract_surface_root.add_child(btn)

func _render_contract_section_tabs(surface: Dictionary) -> void:
	if ui_contract_surface_root == null:
		return

	var tabs_raw: Variant = surface.get("section_tabs", [])
	if typeof(tabs_raw) != TYPE_ARRAY:
		return

	var tabs: Array = tabs_raw
	if tabs.is_empty():
		return

	var lane:= HBoxContainer.new()
	lane.add_theme_constant_override("separation", 8)
	lane.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ui_contract_surface_root.add_child(lane)

	for raw_tab in tabs:
		if typeof(raw_tab) != TYPE_DICTIONARY:
			continue

		var tab: Dictionary = raw_tab
		var tab_id: String = str(tab.get("id", "")).strip_edges()
		if tab_id == "":
			continue

		var btn:= Button.new()
		btn.focus_mode = Control.FOCUS_NONE
		btn.clip_contents = false
		btn.clip_text = true
		btn.text = "%s%s" % [
			"● " if bool(tab.get("active", false)) else "",
			str(tab.get("label", tab_id))
		]
		btn.tooltip_text = str(tab.get("tooltip", ""))
		btn.disabled = not bool(tab.get("enabled", true))
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.custom_minimum_size = Vector2(0, 44)

		var target_surface_for_tab: String = str(surface.get("surface_id", "")).strip_edges()
		var tab_active: bool = bool(tab.get("active", false))
		var tab_visual: Dictionary = MainSceneLogic._contract_tab_visual_theme(target_surface_for_tab, tab_id, tab_active, surface)

		var tab_bg: Color = Color(0.08, 0.12, 0.16, 0.92)
		var tab_border: Color = Color(0.7, 0.96, 1.0, 0.62)
		var tab_font: Color = Color(0.9, 1.0, 1.0, 1.0)

		if tab_visual.has("bg"):
			tab_bg = tab_visual.get("bg")
		if tab_visual.has("border"):
			tab_border = tab_visual.get("border")
		if tab_visual.has("font"):
			tab_font = tab_visual.get("font")

		var tab_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(tab_bg, tab_border, 2 if tab_active else 1, 14)
		btn.add_theme_stylebox_override("normal", tab_style)
		btn.add_theme_stylebox_override("hover", tab_style)
		btn.add_theme_stylebox_override("pressed", tab_style)
		btn.add_theme_color_override("font_color", tab_font)
		btn.add_theme_color_override("font_hover_color", tab_font)
		btn.add_theme_color_override("font_pressed_color", tab_font)

		_decorate_contract_section_tab_button(
				btn,
				tab
		)

		btn.set_meta(
				"contract_tab_active",
				tab_active
		)
		btn.set_meta(
				"contract_tab_label",
				str(
					tab.get(
						"label",
						tab_id
					)
				)
		)

		if target_surface_for_tab == "food_contract_hub":
				grocery_realtime_section_tab_buttons [
					"%s|%s"
					% [
						target_surface_for_tab,
						tab_id
					]
				] = btn

		btn.pressed.connect(func ():
				if gs != null and gs.ui_contract_engine != null:
					var target_surface: String = str(
						surface.get(
							"surface_id",
							""
						)
					).strip_edges()
					gs.ui_contract_engine.set_active_section(
						target_surface,
						tab_id
					)
					_open_contract_surface(
						target_surface,
						tab_id
					)
		)

		lane.add_child(btn)
func _decorate_contract_section_tab_button(btn: Button, tab: Dictionary) -> void:
	if btn == null or not is_instance_valid(btn):
		return

	var trailing_text: String = str(tab.get("trailing_text", "")).strip_edges()
	if trailing_text != "":
		var base_text: String = str(btn.text).strip_edges()
		if base_text == "":
			base_text = str(tab.get("label", tab.get("id", "Section"))).strip_edges()

		if base_text.find(trailing_text) == -1:
			btn.text = "%s  •  %s" % [
				base_text,
				trailing_text
			]

		btn.add_theme_font_size_override("font_size", 11)

	var pulse_text: String = str(tab.get("pulse_text", "")).strip_edges()
	var pulse_key: String = str(tab.get("pulse_key", "")).strip_edges()

	if pulse_text != "" and pulse_key != "":
		var pulse_scope: String = "%s:%s:%s" % [
			ui_contract_active_surface_id,
			str(tab.get("id", "")).strip_edges(),
			pulse_key
		]

		if ui_contract_consumed_pulse_keys.has(pulse_scope):
			pulse_text = ""
		else:
			ui_contract_consumed_pulse_keys [pulse_scope] = int(Time.get_ticks_msec())

			if ui_contract_consumed_pulse_keys.size() > 96:
				var consumed_keys: Array = ui_contract_consumed_pulse_keys.keys()
				while consumed_keys.size() > 48:
					var old_key: String = str(consumed_keys.pop_front())
					ui_contract_consumed_pulse_keys.erase(old_key)

	if pulse_text != "":
		var pulse:= Label.new()
		pulse.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pulse.text = pulse_text
		pulse.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		pulse.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		pulse.anchor_left = 0.62
		pulse.anchor_right = 0.96
		pulse.anchor_top = 0.0
		pulse.anchor_bottom = 1.0
		pulse.offset_left = 0.0
		pulse.offset_right = 0.0
		pulse.offset_top = -18.0
		pulse.offset_bottom = -18.0
		pulse.add_theme_font_size_override("font_size", 12)

		var pulse_tone: String = str(tab.get("pulse_tone", "positive")).strip_edges().to_lower()
		var pulse_color: Color = Color(0.58, 1.0, 0.58, 1.0)
		if pulse_tone == "negative":
			pulse_color = Color(1.0, 0.18, 0.14, 1.0)

		pulse.add_theme_color_override("font_color", pulse_color)
		pulse.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.8))
		pulse.add_theme_constant_override("shadow_outline_size", 4)
		btn.add_child(pulse)

		var pulse_tween:= create_tween().bind_node(pulse)
		pulse_tween.set_parallel(true)
		pulse_tween.tween_property(pulse, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.55)
		pulse_tween.tween_property(pulse, "position:y", pulse.position.y - 8.0, 0.55)
		pulse_tween.set_parallel(false)
		pulse_tween.tween_callback(func ():
			if pulse != null and is_instance_valid(pulse):
				pulse.queue_free()
		)

	var badge_count: int = int(tab.get("badge_count", 0))
	if badge_count <= 0:
		return

	var badge_panel:= PanelContainer.new()
	badge_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	badge_panel.custom_minimum_size = Vector2(22, 22)
	badge_panel.anchor_left = 1.0
	badge_panel.anchor_right = 1.0
	badge_panel.anchor_top = 0.0
	badge_panel.anchor_bottom = 0.0
	badge_panel.offset_left = -28.0
	badge_panel.offset_right = -6.0
	badge_panel.offset_top = -5.0
	badge_panel.offset_bottom = 17.0

	var badge_style:= StyleBoxFlat.new()
	badge_style.bg_color = Color(1.0, 0.06, 0.08, 0.96)
	badge_style.border_color = Color(1.0, 0.72, 0.72, 0.96)
	badge_style.border_width_left = 1
	badge_style.border_width_top = 1
	badge_style.border_width_right = 1
	badge_style.border_width_bottom = 1
	badge_style.corner_radius_top_left = 12
	badge_style.corner_radius_top_right = 12
	badge_style.corner_radius_bottom_left = 12
	badge_style.corner_radius_bottom_right = 12
	badge_panel.add_theme_stylebox_override("panel", badge_style)

	var badge_label:= Label.new()
	badge_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	badge_label.text = str(badge_count)
	badge_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	badge_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	badge_label.add_theme_font_size_override("font_size", 11)
	badge_label.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	badge_panel.add_child(badge_label)

	btn.add_child(badge_panel)
func _render_contract_section(section: Dictionary) -> void:
	if ui_contract_surface_root == null:
		return

	var surface_id: String = str(section.get("surface_id", ui_contract_active_surface_id)).strip_edges()
	if surface_id == "":
		surface_id = ui_contract_active_surface_id

	var section_id: String = str(section.get("id", section.get("active_section_id", ui_contract_active_section_id))).strip_edges()
	if section_id == "":
		section_id = ui_contract_active_section_id

	var compact_contract_section: bool = (
		surface_id == "restaurant_contract_hub"
		and section_id == "cart"
	)

	var shell:= VBoxContainer.new()
	shell.add_theme_constant_override("separation", 6 if compact_contract_section else 10)
	shell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ui_contract_surface_root.add_child(shell)

	var label:= Label.new()
	label.text = str(section.get("label", section_id if section_id != "" else "Section"))
	label.add_theme_font_size_override("font_size", 15 if compact_contract_section else 19)
	label.add_theme_color_override("font_color", Color(0.96, 1.0, 1.0, 1.0))
	shell.add_child(label)

	var description: String = str(section.get("description", "")).strip_edges()
	if description != "":
		var description_label:= Label.new()
		description_label.text = description
		description_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		description_label.add_theme_color_override("font_color", Color(0.72, 0.86, 0.9, 0.92))
		shell.add_child(description_label)

	var section_actions: Array = section.get("actions", []) if typeof(section.get("actions", [])) == TYPE_ARRAY else []
	var render_section_actions_near_top: bool = (
		surface_id == "restaurant_contract_hub"
		and section_id == "cart"
	)

	if render_section_actions_near_top and not section_actions.is_empty():
		_render_contract_section_action_lane(shell, section_actions, surface_id, section_id, compact_contract_section)

	var rows: Array = section.get("rows", []) if typeof(section.get("rows", [])) == TYPE_ARRAY else []
	if rows.is_empty():
		var empty:= Label.new()
		empty.text = "Nothing available right now."
		empty.add_theme_color_override("font_color", Color(0.72, 0.8, 0.84, 0.86))
		shell.add_child(empty)
	else:
		var row_index: int = 0
		while row_index < rows.size():
			var row: Variant = rows [row_index]
			var layout_group_id: String = MainSceneHelpers._contract_row_layout_group_id(row)

			if layout_group_id != "":
				var grouped_rows: Array = []
				while row_index < rows.size() and MainSceneHelpers._contract_row_layout_group_id(rows [row_index]) == layout_group_id:
					grouped_rows.append(rows [row_index])
					row_index += 1

				_render_contract_row_layout_group(shell, grouped_rows, surface_id, section_id, compact_contract_section)
				continue

			_render_contract_row_panel(shell, row, surface_id, section_id, compact_contract_section)
			row_index += 1

	if not render_section_actions_near_top and not section_actions.is_empty():
		_render_contract_section_action_lane(shell, section_actions, surface_id, section_id, compact_contract_section)
func _render_contract_row_layout_group(
		shell: VBoxContainer,
		rows: Array,
		surface_id: String,
		section_id: String,
		compact_contract_section: bool = false
) -> void:
	if shell == null or not is_instance_valid(shell):
		return
	if rows.is_empty():
		return

	var sorted_rows: Array = rows.duplicate(true)
	sorted_rows.sort_custom(func (a: Variant, b: Variant) -> bool:
		var a_order: int = 0
		var b_order: int = 0

		if typeof(a) == TYPE_DICTIONARY:
			a_order = int(
				(a as Dictionary).get(
					"layout_group_order",
					0
				)
			)
		if typeof(b) == TYPE_DICTIONARY:
			b_order = int(
				(b as Dictionary).get(
					"layout_group_order",
					0
				)
			)

		return a_order < b_order
	)

	var requested_columns: int = 1

	if (
		not sorted_rows.is_empty()
		and typeof(sorted_rows [0]) == TYPE_DICTIONARY
	):
		requested_columns = clampi(
			int(
				(sorted_rows [0] as Dictionary).get(
					"layout_columns",
					1
				)
			),
			1,
			4
		)

	var lane: Container = null

	if requested_columns > 1:
		var grid:= GridContainer.new()
		grid.columns = requested_columns
		grid.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		grid.add_theme_constant_override(
			"h_separation",
			10
		)
		grid.add_theme_constant_override(
			"v_separation",
			10
		)
		lane = grid
	else:
		var horizontal_lane:= HBoxContainer.new()
		horizontal_lane.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		horizontal_lane.add_theme_constant_override(
			"separation",
			10
		)
		lane = horizontal_lane

	shell.add_child(
		lane
	)

	for row in sorted_rows:
		var row_dict: Dictionary = (
			row
			if typeof(row) == TYPE_DICTIONARY
			else {}
		)
		var compact_row: bool = bool(
			row_dict.get(
				"compact_height",
				false
			)
		)

		_render_contract_row_panel(
			lane,
			row,
			surface_id,
			section_id,
			compact_contract_section
			or compact_row
		)


func _render_contract_row_panel(parent: Container, row: Variant, surface_id: String, section_id: String, compact_contract_section: bool = false) -> void:
	if parent == null or not is_instance_valid(parent):
		return

	var row_panel:= PanelContainer.new()
	row_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var row_dict_for_style: Dictionary = {}
	var row_kind_for_label: String = ""
	if typeof(row) == TYPE_DICTIONARY:
		row_dict_for_style = (row as Dictionary).duplicate(true)
		row_kind_for_label = str(row_dict_for_style.get("kind", "")).strip_edges().to_lower()

	var row_visual: Dictionary = MainSceneLogic._contract_row_visual_theme(surface_id, section_id, row_dict_for_style)
	var row_bg: Color = Color(0.04, 0.055, 0.075, 0.88)
	var row_border: Color = Color(0.46, 0.72, 0.78, 0.28)
	var row_border_width: int = 1
	var row_radius: int = 16

	if row_visual.has("bg"):
		row_bg = row_visual.get("bg")
	if row_visual.has("border"):
		row_border = row_visual.get("border")
	if row_visual.has("border_width"):
		row_border_width = int(row_visual.get("border_width", 1))
	if row_visual.has("radius"):
		row_radius = int(row_visual.get("radius", 16))

	var row_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(row_bg, row_border, row_border_width, row_radius)
	row_panel.add_theme_stylebox_override("panel", row_style)
	_apply_contract_row_runtime_visual_fx(row_panel, row_visual, row_dict_for_style)
	parent.add_child(row_panel)

	var row_margin:= MarginContainer.new()
	row_margin.add_theme_constant_override("margin_left", 8 if compact_contract_section else 12)
	row_margin.add_theme_constant_override("margin_top", 6 if compact_contract_section else 10)
	row_margin.add_theme_constant_override("margin_right", 8 if compact_contract_section else 12)
	row_margin.add_theme_constant_override("margin_bottom", 6 if compact_contract_section else 10)
	row_panel.add_child(row_margin)

	var row_shell:= VBoxContainer.new()
	row_shell.add_theme_constant_override("separation", 6 if compact_contract_section else 7)
	row_margin.add_child(row_shell)

	var row_label:= Label.new()
	var row_dict: Dictionary = {}
	if typeof(row) == TYPE_DICTIONARY:
		row_dict = (row as Dictionary).duplicate(true)
		row_label.text = str(row_dict.get("label", row_dict.get("name", JSON.stringify(row_dict))))
	else:
		row_label.text = str(row)

	row_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

	if row_kind_for_label == "":
		row_kind_for_label = str(row_dict.get("kind", "")).strip_edges().to_lower()

	var row_font_color: Color = Color(0.94, 1.0, 1.0, 1.0)
	var row_title_size: int = 14 if compact_contract_section else 16

	if row_visual.has("font"):
		row_font_color = row_visual.get("font")
	if row_visual.has("title_size"):
		row_title_size = int(row_visual.get("title_size", row_title_size))

	if row_kind_for_label == "grocery_aisle_carousel" or row_kind_for_label == "grocery_store_premium":
		row_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		row_label.add_theme_font_size_override("font_size", max(19, row_title_size))
		row_label.add_theme_color_override("font_color", row_font_color)
	else:
		row_label.add_theme_font_size_override("font_size", row_title_size)
		row_label.add_theme_color_override("font_color", row_font_color)

	row_shell.add_child(row_label)
	if (
		surface_id == "food_contract_hub"
		and row_kind_for_label == "grocery_aisle_shopper_count"
):
		var grocery_count_store_id: String = str(
			row_dict.get(
				"store_id",
				""
			)
		).strip_edges()
		var grocery_count_aisle_id: String = str(
			row_dict.get(
				"aisle_id",
				""
			)
		).strip_edges()

		if (
			grocery_count_store_id != ""
			and grocery_count_aisle_id != ""
		):
			grocery_realtime_aisle_count_labels [
				"%s|%s"
				% [
					grocery_count_store_id,
					grocery_count_aisle_id
				]
			] = row_label
	if typeof(row) == TYPE_DICTIONARY:
		var description_text: String = str(row_dict.get("description", "")).strip_edges()
		if description_text != "":
			var row_description_label:= Label.new()
			row_description_label.text = description_text
			row_description_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			var row_description_color: Color = Color(0.7, 0.82, 0.86, 0.9)
			if row_visual.has("description_font"):
				row_description_color = row_visual.get("description_font")

			row_description_label.add_theme_color_override("font_color", row_description_color)
			row_shell.add_child(row_description_label)

		_render_contract_row_stat_bars(row_shell, row_dict)

		var row_actions: Array = row_dict.get("actions", []) if typeof(row_dict.get("actions", [])) == TYPE_ARRAY else []
		if not row_actions.is_empty():
			var action_lane: Container = null
			var requested_action_columns: int = int(row_dict.get("action_columns", 0))

			if requested_action_columns <= 0:
				if compact_contract_section and row_actions.size() > 1:
					requested_action_columns = min(2, row_actions.size())
				else:
					requested_action_columns = 1

			if requested_action_columns > 1:
				var compact_grid:= GridContainer.new()
				compact_grid.columns = requested_action_columns
				compact_grid.add_theme_constant_override("h_separation", 6)
				compact_grid.add_theme_constant_override("v_separation", 6)
				action_lane = compact_grid
			else:
				var normal_lane:= HBoxContainer.new()
				normal_lane.add_theme_constant_override("separation", 8)
				action_lane = normal_lane

			action_lane.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			row_shell.add_child(action_lane)

			for raw_row_action in row_actions:
				if typeof(raw_row_action) != TYPE_DICTIONARY:
					continue

				var row_action: Dictionary = (raw_row_action as Dictionary).duplicate(true)
				var row_btn:= Button.new()
				row_btn.text = str(row_action.get("label", "Action"))
				row_btn.disabled = not bool(row_action.get("enabled", true))
				row_btn.focus_mode = Control.FOCUS_NONE
				row_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL

				if compact_contract_section:
					row_btn.add_theme_font_size_override("font_size", 12)
					row_btn.custom_minimum_size = Vector2(0, 30)

				MainSceneLogic._apply_contract_action_button_visual(row_btn, row_action, surface_id, section_id, row_dict, compact_contract_section)
				var grocery_action_id: String = str(
						row_action.get(
							"id",
							row_action.get(
								"action_id",
								""
							)
						)
				).strip_edges()

				if (
						surface_id == "food_contract_hub"
						and grocery_action_id.begins_with(
							"grocery_"
						)
				):
						grocery_realtime_action_buttons [
							grocery_action_id
						] = row_btn
				row_btn.pressed.connect(func ():
					_play_contract_add_to_cart_feedback(row_btn, row_action, row_dict)

					var inline_payload: Dictionary = row_action.get("payload", {}).duplicate(true) if typeof(row_action.get("payload", {})) == TYPE_DICTIONARY else {}
					inline_payload ["_inline_action_route"] = row_action.duplicate(true)
					var inline_action: Dictionary = row_action.duplicate(true)
					inline_action ["payload"] = inline_payload
					_handle_contract_action({
						"surface_id": surface_id,
						"active_section_id": section_id
					}, inline_action)
				)

				action_lane.add_child(row_btn)
func _render_contract_section_action_lane(shell: VBoxContainer, actions: Array, surface_id: String, section_id: String, compact_contract_section: bool = false) -> void:
	if shell == null or not is_instance_valid(shell):
		return
	if actions.is_empty():
		return

	var action_lane: Container = null
	if compact_contract_section:
		var grid:= GridContainer.new()
		grid.columns = 3
		grid.add_theme_constant_override("h_separation", 6)
		grid.add_theme_constant_override("v_separation", 6)
		action_lane = grid
	else:
		var lane:= HBoxContainer.new()
		lane.add_theme_constant_override("separation", 8)
		action_lane = lane

	action_lane.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	shell.add_child(action_lane)

	for raw_action in actions:
		if typeof(raw_action) != TYPE_DICTIONARY:
			continue

		var action: Dictionary = raw_action
		var btn:= Button.new()
		btn.text = str(action.get("label", "Action"))
		btn.disabled = not bool(action.get("enabled", true))
		btn.focus_mode = Control.FOCUS_NONE
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL

		if compact_contract_section:
			btn.add_theme_font_size_override("font_size", 12)
			btn.custom_minimum_size = Vector2(0, 30)

		MainSceneLogic._apply_contract_action_button_visual(btn, action, surface_id, section_id, {},
		compact_contract_section)

		btn.pressed.connect(func ():
			_handle_contract_action({
				"surface_id": surface_id,
				"active_section_id": section_id
			}, action)
		)

		action_lane.add_child(btn)
func _play_contract_add_to_cart_feedback(anchor_button: Button, action: Dictionary, row_context: Dictionary = {}) -> void:
	if ui_contract_surface_panel == null or not is_instance_valid(ui_contract_surface_panel):
		return

	var action_id: String = str(action.get("id", action.get("action_id", ""))).strip_edges()
	if not action_id.begins_with("grocery_add"):
		return

	var item_name: String = str(row_context.get("label", row_context.get("name", "Item"))).strip_edges()
	if item_name.find(" • ") >= 0:
		item_name = item_name.get_slice(" • ", 0)
	if item_name == "":
		item_name = "Item"

	var item_price: float = -1.0
	if row_context.has("price_after_tax"):
		item_price = float(row_context.get("price_after_tax", -1.0))
	elif row_context.has("price"):
		item_price = float(row_context.get("price", -1.0))

	var feedback_layer:= Control.new()
	feedback_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback_layer.z_index = 999
	feedback_layer.anchor_left = 0.0
	feedback_layer.anchor_right = 1.0
	feedback_layer.anchor_top = 0.0
	feedback_layer.anchor_bottom = 1.0
	feedback_layer.offset_left = 0.0
	feedback_layer.offset_right = 0.0
	feedback_layer.offset_top = 0.0
	feedback_layer.offset_bottom = 0.0
	ui_contract_surface_panel.add_child(feedback_layer)
	ui_contract_surface_panel.move_child(feedback_layer, ui_contract_surface_panel.get_child_count() - 1)

	var panel_rect: Rect2 = ui_contract_surface_panel.get_global_rect()
	var local_anchor: Vector2 = Vector2(22.0, 96.0)
	if anchor_button != null and is_instance_valid(anchor_button):
		var anchor_rect: Rect2 = anchor_button.get_global_rect()
		local_anchor = anchor_rect.position - panel_rect.position
		anchor_button.scale = Vector2(0.985, 0.985)
		var button_tween:= create_tween().bind_node(anchor_button)
		button_tween.set_trans(Tween.TRANS_SINE)
		button_tween.set_ease(Tween.EASE_OUT)
		button_tween.tween_property(anchor_button, "scale", Vector2.ONE, 0.12)

	var toast:= Label.new()
	toast.text = "+ %s • $%.2f" % [item_name, item_price] if item_price >= 0.0 else "+ %s" % item_name
	toast.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	toast.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	toast.custom_minimum_size = Vector2(290, 30)
	toast.position = Vector2(
		clamp(local_anchor.x, 12.0, max(12.0, panel_rect.size.x - 310.0)),
		max(16.0, local_anchor.y - 36.0)
	)
	toast.add_theme_font_size_override("font_size", 15)
	toast.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 0.98))
	toast.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.82))
	toast.add_theme_constant_override("shadow_outline_size", 5)
	toast.modulate = Color(1.0, 1.0, 1.0, 0.0)
	toast.scale = Vector2(0.94, 0.94)
	feedback_layer.add_child(toast)

	var money_toast:= Label.new()
	money_toast.text = "+$%.2f" % item_price if item_price >= 0.0 else ""
	money_toast.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	money_toast.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	money_toast.custom_minimum_size = Vector2(120, 26)
	money_toast.position = toast.position + Vector2(178.0, -24.0)
	money_toast.add_theme_font_size_override("font_size", 13)
	money_toast.add_theme_color_override("font_color", Color(0.58, 1.0, 0.58, 0.98))
	money_toast.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.82))
	money_toast.add_theme_constant_override("shadow_outline_size", 5)
	money_toast.modulate = Color(1.0, 1.0, 1.0, 0.0)
	money_toast.scale = Vector2(0.92, 0.92)
	if item_price >= 0.0:
		feedback_layer.add_child(money_toast)

	var tween:= create_tween().bind_node(feedback_layer)
	tween.set_parallel(true)
	tween.tween_property(toast, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.08)
	tween.tween_property(toast, "scale", Vector2.ONE, 0.08)
	if item_price >= 0.0:
		tween.tween_property(money_toast, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.08)
		tween.tween_property(money_toast, "scale", Vector2.ONE, 0.08)
	tween.set_parallel(false)
	tween.tween_interval(0.48)
	tween.set_parallel(true)
	tween.tween_property(toast, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.24)
	tween.tween_property(toast, "position:y", toast.position.y - 18.0, 0.24)
	tween.tween_property(toast, "scale", Vector2(1.035, 1.035), 0.24)
	if item_price >= 0.0:
		tween.tween_property(money_toast, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.24)
		tween.tween_property(money_toast, "position:y", money_toast.position.y - 24.0, 0.24)
		tween.tween_property(money_toast, "scale", Vector2(1.04, 1.04), 0.24)
	tween.set_parallel(false)
	tween.tween_callback(func ():
		if feedback_layer != null and is_instance_valid(feedback_layer):
			feedback_layer.queue_free()
	)
func _apply_contract_surface_panel_visual_theme(surface: Dictionary, surface_id: String) -> void:
