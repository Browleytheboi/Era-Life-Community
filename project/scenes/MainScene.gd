func _finalize_game_boot() -> void:
	if gs == null:
		set_meta("god_mode_capsule_entry_handoff_active", false)
		return

	var using_prewarmed_spawn: bool = bool(get_meta("god_mode_life_boot_uses_prewarmed_spawn", false)) and gs.player != null
	var using_full_ui_prewarmed_spawn: bool = using_prewarmed_spawn and bool(get_meta("god_mode_life_entry_full_ui_required", false))
	var boot_ticket: int = int(get_meta("life_boot_ticket", 0)) + 1

	set_meta("life_boot_ticket", boot_ticket)
	set_meta("age_up_transition_busy", false)
	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("age_up_loading_deferred_begin_context", {})
	set_meta("age_up_loading_first_visible_runtime_started", false)
	set_meta("age_up_loading_prewarm_ready", using_prewarmed_spawn)
	set_meta("age_up_loading_prewarm_signature", "")
	set_meta("startup_live_shell_loading", not using_prewarmed_spawn)
	set_meta("age_up_post_loading_finalize_pending", not using_prewarmed_spawn)
	set_meta("other_countries_browser_entries_cache_key", "")
	set_meta("other_countries_browser_entries_cache", [])
	set_meta("live_diagnostics_manual_throttle_enabled", not using_prewarmed_spawn)
	set_meta("live_diagnostics_opening_quarantine_frames", 0)
	set_meta("live_diagnostics_opening_quarantine_until_ms", 0)
	set_meta("live_diagnostics_hidden_refresh_next_ms", int(Time.get_ticks_msec()) + 900)
	set_meta("live_diagnostics_fix_preview_expanded", false)

	live_diagnostics_force_frames = 0
	live_diagnostics_refresh_accumulator = 0.0
	set_meta("live_diagnostics_deferred_force_frames", 0)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.visible = false
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_start_panel.set_meta("defer_free_after_spawn_shell", true)

		if bool(get_meta("god_mode_life_boot_uses_prewarmed_spawn", false)):
			call_deferred("_free_hidden_god_mode_panel_after_spawn_shell", "finalize_game_boot_prewarmed_spawn")
		else:
			god_mode_start_panel.queue_free()
			god_mode_start_panel = null

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if era_border_overlay != null:
		era_border_overlay.visible = false

	era_border_reveal_progress = 0.0
	era_border_reveal_target = 0.0

	var birth_shell_using_loading_overlay: bool = bool(get_meta("startup_birth_loading_overlay_active", false))
	if using_prewarmed_spawn:
		birth_shell_using_loading_overlay = false
		set_meta("startup_birth_loading_overlay_active", false)

	if age_up_loading_runtime_active and not birth_shell_using_loading_overlay:
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null and not birth_shell_using_loading_overlay:
		age_up_loading_overlay.visible = false

	if live_diagnostics_panel != null and is_instance_valid(live_diagnostics_panel):
		live_diagnostics_panel.visible = false

	if not using_prewarmed_spawn and gs.has_method("_reset_runtime_state_for_fresh_life_boot"):
		gs._reset_runtime_state_for_fresh_life_boot(false)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["spawn_shell_entry_policy"] = "full_ui_from_prewarmed_capsule" if using_full_ui_prewarmed_spawn else "main_shell_first_user_intent_tabs"
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = using_prewarmed_spawn and not using_full_ui_prewarmed_spawn

	if using_prewarmed_spawn:
		gs.scenario_state ["birth_shell_first_boot"] = false
		gs.scenario_state ["birth_shell_first_boot_active"] = false if using_full_ui_prewarmed_spawn else true
		gs.scenario_state ["birth_shell_player_created"] = true
		gs.scenario_state ["birth_shell_player_id"] = int(gs.player.id)
		gs.scenario_state ["birth_shell_deferred_boot_pending"] = false if using_full_ui_prewarmed_spawn else bool(gs.scenario_state.get("birth_shell_deferred_boot_pending", false))
		gs.scenario_state ["birth_shell_deferred_boot_complete"] = true if using_full_ui_prewarmed_spawn else bool(gs.scenario_state.get("birth_shell_deferred_boot_complete", true))
		gs.scenario_state ["defer_static_world_bootstrap"] = true
		gs.scenario_state ["defer_live_runtime_watchers"] = true
		gs.scenario_state ["deferred_data_bootstrap_pending"] = true
		gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = true
		gs.scenario_state ["static_world_runtime_bootstrapped"] = bool(gs.scenario_state.get("static_world_runtime_bootstrapped", false))
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["god_mode_boot_ticket"] = boot_ticket
		gs.scenario_state ["god_mode_life_boot_source"] = "prewarmed_life_capsule_full_ui_no_sync_bind" if using_full_ui_prewarmed_spawn else "prewarmed_life_capsule_shell_first_no_sync_bind"
		gs.scenario_state ["god_mode_life_initialize_skipped_after_prewarm"] = true
		gs.scenario_state ["live_reality_stream_bound"] = false
		gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = true
		gs.scenario_state ["ui_first_frame_render_policy"] = "full_ui_no_live_stream_bind" if using_full_ui_prewarmed_spawn else "shell_first_no_live_stream_bind"
		gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false if using_full_ui_prewarmed_spawn else bool(gs.scenario_state.get("spawn_ready_runtime_hud_shell_only_active", true))
		set_meta("live_reality_stream_bound", false)
		set_meta("deferred_live_reality_stream_bind_pending", true)
		set_meta("spawn_ready_runtime_hud_shell_only_active", false if using_full_ui_prewarmed_spawn else bool(get_meta("spawn_ready_runtime_hud_shell_only_active", true)))
	else:
		gs.scenario_state ["birth_shell_first_boot"] = true
		gs.scenario_state ["birth_shell_deferred_boot_pending"] = true
		gs.scenario_state ["birth_shell_deferred_boot_complete"] = false
		gs.scenario_state ["defer_static_world_bootstrap"] = true
		gs.scenario_state ["defer_live_runtime_watchers"] = true
		gs.scenario_state ["deferred_data_bootstrap_pending"] = true
		gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = true
		gs.scenario_state ["static_world_runtime_bootstrapped"] = false
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = true
		gs.scenario_state ["god_mode_boot_ticket"] = boot_ticket
		gs.initialize()

		var fresh_snapshot: Dictionary = _build_first_frame_ui_snapshot_from_game_state(gs, "finalize_game_boot_fresh_spawn")
		_lock_first_frame_ui_snapshot(fresh_snapshot, "finalize_game_boot_fresh_spawn")

	call_deferred("_ensure_live_diagnostics_panel")
	call_deferred("_register_live_diagnostics_ui_contract")

	current_panel = ""
	age_up_diary_entries.clear()
	current_opportunities_cache.clear()

	_hide_relationship_profile_popup()
	_hide_relationship_browser()
	_hide_activities_action_panel()
	_hide_world_action_panel()
	_close_saved_life_picker()

	if world_actions_status_label != null:
		world_actions_status_label.text = ""

	if using_full_ui_prewarmed_spawn:
		_restore_prewarmed_full_gameplay_ui("finalize_game_boot_full_ui_prewarmed_spawn")
	else:
		_restore_live_gameplay_ui_shell()

		if output_label != null:
			output_label.visible = true
			output_label.scroll_active = true
			output_label.clear()

		_ensure_player_stats_overlay()
		if player_stats_overlay != null:
			player_stats_overlay.visible = true

		if _is_live_reality_stream_bound() and gs != null and gs.player != null:
			player_stats_bank_display_value = float(max(0, int(gs.player.bank_balance)))
		else:
			var snapshot: Dictionary = _current_first_frame_ui_snapshot()
			var snapshot_stats_raw: Variant = snapshot.get("stats", {})
			var snapshot_stats: Dictionary = snapshot_stats_raw.duplicate(true) if typeof(snapshot_stats_raw) == TYPE_DICTIONARY else {}
			player_stats_bank_display_value = float(snapshot_stats.get("bank", player_stats_bank_display_value))

		belongings_hud_content_dirty = true

		if using_prewarmed_spawn:
			_set_birth_shell_interactive_controls_visible(true)
		else:
			_set_birth_shell_interactive_controls_visible(false)

		var consumed_first_frame_snapshot: bool = _consume_first_frame_ui_snapshot_for_live_shell("finalize_game_boot_before_first_paint")

		if not using_prewarmed_spawn and (_is_live_reality_stream_bound() or not consumed_first_frame_snapshot):
			_update_player_stats_overlay()

		if not using_prewarmed_spawn:
			_print_era_overview()
			_print_new_life_intro()

		current_panel = ""

		if standard_tab_popup_open:
			_hide_standard_tab_popup()

		if not using_prewarmed_spawn:
			call_deferred("_prewarm_life_panel_ui_packet")
			call_deferred("_scroll_life_diary_to_bottom")

		_bind_ui_nav_buttons()
		_apply_ui_nav_button_visuals()
		_force_spawn_ready_live_ui_shell("finalize_game_boot")

	if bool(get_meta("startup_birth_loading_overlay_active", false)):
		set_meta("startup_birth_loading_overlay_active", false)
		_hide_age_up_loading_overlay()
	elif using_prewarmed_spawn and age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false

	call_deferred("_show_era_border_overlay_for_current_era", true)
	call_deferred("_sync_era_audio_contract_from_current_world", "finalize_game_boot")
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["god_mode_boot_life_diary_released"] = false
		gs.scenario_state ["birth_shell_player_control_released"] = true
		gs.scenario_state ["birth_shell_player_control_released_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["body_contract_tail_work_pending"] = true
		gs.scenario_state ["body_contract_tail_work_source"] = "finalize_game_boot_after_player_control"

	if gs != null and gs.player != null and gs.has_method("queue_body_contract_refresh_for_person"):
		gs.queue_body_contract_refresh_for_person(gs.player, {
			"source": "finalize_game_boot_after_player_control",
			"priority": "player",
			"defer_parent_resolution": true,
			"refresh_person_contract": false
		})

	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)

	if using_full_ui_prewarmed_spawn:
		_schedule_prewarmed_spawn_heavy_tail_after_control(boot_ticket, "finalize_game_boot_full_ui")
	elif using_prewarmed_spawn:
		_schedule_prewarmed_spawn_heavy_tail_after_control(boot_ticket, "finalize_game_boot")
	else:
		call_deferred("_schedule_background_soul_seed_streaming_loop", "finalize_game_boot")
		call_deferred("_continue_post_spawn_world_prewarm", boot_ticket)
func _continue_post_spawn_world_prewarm(boot_ticket: int = -1) -> void:
	if gs == null:
		return

	if _playable_life_shell_has_visible_sovereignty() and not _global_runtime_kill_claim_allowed("runtime_boot", "Mainscene._continue_post_spawn_world_prewarm", "post_spawn_world_prewarm", {
		"blocks_ui": true,
		"background_only": false,
		"boot_ticket": boot_ticket
	}):
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state ["post_spawn_world_prewarm_pending"] = false
		gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
		gs.scenario_state ["post_spawn_world_prewarm_blocked_by_global_runtime_kill"] = true
		gs.scenario_state ["post_spawn_world_prewarm_blocked_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["life_runtime_background_tail_deferred"] = true
		gs.scenario_state ["world_tail_work_may_not_block_visible_shell"] = true
		return

	if boot_ticket >= 0 and int(get_meta("life_boot_ticket", -1)) != boot_ticket:
		return
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("live_diagnostics_manual_throttle_enabled", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(Time.get_ticks_msec())
	var entry_policy: String = str(gs.scenario_state.get("spawn_shell_entry_policy", "")).strip_edges()
	var first_frame_policy: String = str(gs.scenario_state.get("ui_first_frame_render_policy", "")).strip_edges()

	var full_ui_prewarmed_spawn: bool = bool(get_meta("god_mode_life_entry_full_ui_required", false)) \
or entry_policy == "full_ui_from_prewarmed_capsule" \
or entry_policy == "full_playable_ui_from_prewarmed_capsule" \
or first_frame_policy == "full_ui_from_prewarmed_capsule" \
or first_frame_policy == "full_playable_ui_visible_no_runtime_work"

	var capsule_shell_first: bool = bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false)) and not full_ui_prewarmed_spawn

	if _is_live_reality_stream_bound() \
and bool(gs.scenario_state.get("live_reality_stream_ready", false)) \
and bool(gs.scenario_state.get("static_world_runtime_bootstrapped", false)) \
and not bool(gs.scenario_state.get("birth_shell_deferred_boot_pending", false)):
		gs.scenario_state ["post_spawn_world_prewarm_pending"] = false
		gs.scenario_state ["post_spawn_world_prewarm_complete"] = true
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["deferred_data_bootstrap_pending"] = false
		gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = false
		gs.scenario_state ["birth_shell_player_control_released"] = true
		gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms

		set_meta("startup_live_shell_loading", false)
		set_meta("age_up_post_loading_finalize_pending", false)
		set_meta("age_up_transition_busy", false)
		set_meta("live_diagnostics_manual_throttle_enabled", false)
		_set_birth_shell_interactive_controls_visible(true)

		if not full_ui_prewarmed_spawn:
			_render_spawn_ready_life_diary_first_frame("live_reality_stream_already_ready")
			_reveal_spawn_ready_runtime_hud_buttons_shell_only("live_reality_stream_already_ready")

		call_deferred("_flush_runtime_boot_buffered_ui_intents")
		return

	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["god_mode_boot_life_diary_released"] = full_ui_prewarmed_spawn
	gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_microtask_ui_safe"
	gs.scenario_state ["post_spawn_world_prewarm_last_ticket"] = boot_ticket
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["post_spawn_world_prewarm_shell_first_grace"] = capsule_shell_first
	gs.scenario_state ["post_spawn_world_prewarm_ui_refresh_policy"] = "no_forced_hud_updates"
	gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false if full_ui_prewarmed_spawn else true
	gs.scenario_state ["post_spawn_world_prewarm_player_control_grace_until_ms"] = max(
		int(gs.scenario_state.get("post_spawn_world_prewarm_player_control_grace_until_ms", 0)),
		now_ms + 3200
	)

	if age_up_loading_runtime_active or (age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible):
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true

	if full_ui_prewarmed_spawn:
		_restore_full_runtime_hud_visibility_from_truth("post_spawn_world_prewarm_full_ui")
		call_deferred("_flush_runtime_boot_buffered_ui_intents")

		var hot_tree:= get_tree()
		if hot_tree == null:
			return

		var hot_timer:= hot_tree.create_timer(3.2)
		hot_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, 0),
			CONNECT_ONE_SHOT
		)
		return

	_set_birth_shell_interactive_controls_visible(true)
	_render_spawn_ready_life_diary_first_frame("post_spawn_world_prewarm_start")
	_reveal_spawn_ready_runtime_hud_buttons_shell_only("post_spawn_world_prewarm_start")
	call_deferred("_flush_runtime_boot_buffered_ui_intents")

	var tree:= get_tree()
	if tree == null:
		return

	var timer:= tree.create_timer(1.45)
	timer.timeout.connect(
		Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, 0),
		CONNECT_ONE_SHOT
	)
func _continue_post_spawn_world_prewarm_idle_tick(boot_ticket: int = -1, pass_index: int = 0) -> void:
	if gs == null:
		return

	if boot_ticket >= 0 and int(get_meta("life_boot_ticket", -1)) != boot_ticket:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var tree:= get_tree()
	if tree == null:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var released_at_ms: int = int(gs.scenario_state.get("spawn_ready_live_ui_shell_released_at_ms", 0))
	var grace_until_ms: int = int(gs.scenario_state.get("post_spawn_world_prewarm_player_control_grace_until_ms", 0))
	var background_allowed_after_ms: int = int(get_meta("age_up_tail_background_allowed_after_ms", 0))

	if released_at_ms > 0 and now_ms - released_at_ms < 2400:
		var release_timer:= tree.create_timer(0.45)
		release_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index),
			CONNECT_ONE_SHOT
		)
		return

	if grace_until_ms > 0 and now_ms < grace_until_ms:
		var grace_timer:= tree.create_timer(0.9)
		grace_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index),
			CONNECT_ONE_SHOT
		)
		return

	if background_allowed_after_ms > 0 and now_ms < background_allowed_after_ms:
		var background_timer:= tree.create_timer(0.9)
		background_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index),
			CONNECT_ONE_SHOT
		)
		return

	if _runtime_interactive_surface_busy(now_ms) or _post_spawn_ui_is_busy_for_prewarm() or _ui_interaction_grace_active(now_ms):
		var busy_timer:= tree.create_timer(1.35)
		busy_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index),
			CONNECT_ONE_SHOT
		)
		return

	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("live_diagnostics_manual_throttle_enabled", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)

	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["post_spawn_world_prewarm_ui_refresh_policy"] = "reconcile_state_without_reforcing_shell"
	gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = true

	var finished_shell: bool = true
	var finished_world: bool = true
	var ran_shell_microtask: bool = false
	var ran_world_microtask: bool = false

	if gs.has_method("_continue_birth_shell_deferred_boot") and bool(gs.scenario_state.get("birth_shell_deferred_boot_pending", false)):
		ran_shell_microtask = true
		finished_shell = bool(gs._continue_birth_shell_deferred_boot(1, "post_spawn_ui_safe_microtask"))

		var boot_state_raw: Variant = gs.scenario_state.get("_birth_shell_deferred_boot_state", {})
		var boot_state: Dictionary = boot_state_raw if typeof(boot_state_raw) == TYPE_DICTIONARY else {}
		var paused_reason: String = str(boot_state.get("paused_reason", "")).strip_edges().to_lower()

		if not finished_shell and paused_reason == "post_spawn_ui_safe_weight_deferred":
			gs.scenario_state ["birth_shell_deferred_boot_soft_deferred"] = true
			gs.scenario_state ["birth_shell_deferred_boot_soft_deferred_at_ms"] = now_ms
			gs.scenario_state ["birth_shell_deferred_boot_pending"] = false
			gs.scenario_state ["birth_shell_deferred_boot_complete"] = false
			gs.scenario_state ["post_spawn_world_prewarm_pending"] = false
			gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
			gs.scenario_state ["post_spawn_world_prewarm_soft_deferred_reason"] = paused_reason
			gs.scenario_state ["post_spawn_world_prewarm_soft_deferred_at_ms"] = now_ms
			gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
			gs.scenario_state ["deferred_data_bootstrap_pending"] = false
			gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = false

			_reveal_spawn_ready_runtime_hud_buttons_shell_only("post_spawn_soft_deferred")
			call_deferred("_flush_runtime_boot_buffered_ui_intents")
			return

	if ran_shell_microtask:
		_reveal_spawn_ready_runtime_hud_buttons_shell_only("post_spawn_shell_microtask")
		call_deferred("_flush_runtime_boot_buffered_ui_intents")

		var shell_timer:= tree.create_timer(2.25)
		shell_timer.timeout.connect(
			Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index + 1),
			CONNECT_ONE_SHOT
		)
		return

	if finished_shell and gs.has_method("_bootstrap_static_world_runtime_state_for_new_life"):
		ran_world_microtask = true
		finished_world = bool(gs._bootstrap_static_world_runtime_state_for_new_life(1, "post_spawn_ui_safe_microtask"))

	call_deferred("_flush_runtime_boot_buffered_ui_intents")
	_reveal_spawn_ready_runtime_hud_buttons_shell_only("post_spawn_world_microtask")

	if finished_shell and finished_world:
		gs.scenario_state ["post_spawn_world_prewarm_pending"] = false
		gs.scenario_state ["post_spawn_world_prewarm_complete"] = true
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["deferred_data_bootstrap_pending"] = false
		gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = false
		gs.scenario_state ["post_spawn_world_prewarm_completed_without_shell_reforce"] = true

		set_meta("startup_live_shell_loading", false)
		set_meta("age_up_post_loading_finalize_pending", false)
		set_meta("age_up_transition_busy", false)

		call_deferred("_flush_runtime_boot_buffered_ui_intents")
		return

	gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	gs.scenario_state ["post_spawn_world_prewarm_pass_index"] = pass_index + 1

	if pass_index >= 16:
		gs.scenario_state ["birth_shell_deferred_boot_soft_deferred"] = true
		gs.scenario_state ["birth_shell_deferred_boot_soft_deferred_at_ms"] = now_ms
		gs.scenario_state ["birth_shell_deferred_boot_pending"] = false
		gs.scenario_state ["birth_shell_deferred_boot_complete"] = false
		gs.scenario_state ["post_spawn_world_prewarm_pending"] = false
		gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
		gs.scenario_state ["post_spawn_world_prewarm_soft_deferred_at_ms"] = now_ms
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["deferred_data_bootstrap_pending"] = false
		gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = false

		_reveal_spawn_ready_runtime_hud_buttons_shell_only("post_spawn_pass_limit_soft_deferred")
		call_deferred("_flush_runtime_boot_buffered_ui_intents")
		return

	var timer_delay: float = 2.75 if ran_world_microtask else 1.75
	var timer:= tree.create_timer(timer_delay)
	timer.timeout.connect(
		Callable(self, "_continue_post_spawn_world_prewarm_idle_tick").bind(boot_ticket, pass_index + 1),
		CONNECT_ONE_SHOT
	)
func _enter_tree() -> void:


	set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)

	size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)

	size_flags_vertical = (
		Control.SIZE_EXPAND_FILL
	)

	var physical_size: Vector2 = (
		_presentation_physical_viewport_size()
	)

	var physical_signature: String = (
		"%d:%d"
		% [
			int(round(physical_size.x)),
			int(round(physical_size.y))
		]
	)

	var density_context: Dictionary = {
		"physical_viewport_width": physical_size.x,
		"physical_viewport_height": physical_size.y,

		"viewport_width": physical_size.x,
		"viewport_height": physical_size.y,

		"safe_inset_left": 0.0,
		"safe_inset_top": 0.0,
		"safe_inset_right": 0.0,
		"safe_inset_bottom": 0.0,

		"platform": OS.get_name(),
		"display_server": DisplayServer.get_name(),

		"source": (
			"mainscene_pre_residency_"
			+ "presentation_bootstrap"
		),

		"desktop_presentation": true,
		"ui_is_expression_only": true
	}

	var density_contract: Dictionary = (
		UIContractEngine
		.resolve_presentation_density_bootstrap_contract(
			density_context
		)
	)

	if (
		str(
			density_contract.get(
				"schema",
				""
			)
		)
		!= "eralife.presentation_density_contract"
	):
		return

	if int(
		density_contract.get(
			"version",
			0
		)
	) != 1:
		return

	var logical_raw: Variant = (
		density_contract.get(
			"logical_viewport",
			{}
		)
	)

	if typeof(logical_raw) != TYPE_DICTIONARY:
		return

	var logical_viewport: Dictionary = (
		logical_raw as Dictionary
	)

	var logical_width: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"width",
				0.0
			)
		)
	)

	var logical_height: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"height",
				0.0
			)
		)
	)

	var aspect_ratio: float = float(
		density_contract.get(
			"aspect_ratio",
			logical_width / logical_height
		)
	)

	var aspect_profile: String = str(
		density_contract.get(
			"aspect_profile",
			"standard"
		)
	).strip_edges().to_lower()

	var composition_context: Dictionary = {
		"logical_viewport_width": logical_width,
		"logical_viewport_height": logical_height,
		"aspect_ratio": aspect_ratio,
		"aspect_profile": aspect_profile,

		"source": (
			"mainscene_pre_residency_"
			+ "presentation_bootstrap"
		),

		"desktop_presentation": true,
		"ui_is_expression_only": true
	}

	var composition_contract: Dictionary = (
		UIContractEngine
		.resolve_presentation_composition_bootstrap_contract(
			composition_context
		)
	)

	ui_presentation_density_contract = (
		density_contract.duplicate(true)
	)

	ui_presentation_density_physical_signature = (
		physical_signature
	)

	if (
		str(
			composition_contract.get(
				"schema",
				""
			)
		)
		== "eralife.presentation_composition_contract"
		and int(
			composition_contract.get(
				"version",
				0
			)
		) == 1
	):
		ui_presentation_composition_contract = (
			composition_contract.duplicate(true)
		)

		ui_presentation_composition_logical_signature = (
			"%d:%d:%s"
			% [
				int(round(logical_width)),
				int(round(logical_height)),
				aspect_profile
			]
		)

	_apply_presentation_density_contract_to_window(
		density_contract,
		"pre_residency_presentation_bootstrap"
	)

	set_meta(
		"presentation_bootstrap_contract_resident_before_ready",
		true
	)

	set_meta(
		"presentation_bootstrap_physical_signature",
		physical_signature
	)

	set_meta(
		"presentation_bootstrap_did_not_touch_simulation",
		true
	)
