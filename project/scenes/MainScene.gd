func _household_creator_set_option_items(picker: Variant, options: Array, selected_text: String = "") -> void:
	if picker == null:
		return
	if not (picker is Object):
		return
	if not is_instance_valid(picker):
		return
	if not (picker is OptionButton):
		return

	var option_button: OptionButton = picker as OptionButton
	var clean_selected: String = selected_text.strip_edges()
	if clean_selected == "" and option_button.item_count > 0 and option_button.selected >= 0 and option_button.selected < option_button.item_count:
		clean_selected = option_button.get_item_text(option_button.selected)

	option_button.clear()

	var seen:= {}
	for raw_option in options:
		var option_text: String = str(raw_option).strip_edges()
		if option_text == "":
			continue

		var key: String = option_text.to_lower()
		if seen.has(key):
			continue

		seen [key] = true
		option_button.add_item(option_text)

	option_button.disabled = option_button.item_count <= 0
	if option_button.item_count <= 0:
		option_button.set_meta("selected_text", "")
		return

	var selected_index: int = 0
	var found_selected: bool = false
	for i in range(option_button.item_count):
		if option_button.get_item_text(i).strip_edges().to_lower() == clean_selected.to_lower():
			selected_index = i
			found_selected = true
			break

	if clean_selected != "" and not found_selected:
		selected_index = 0

	option_button.select(selected_index)

	var selected_value: String = option_button.get_item_text(selected_index).strip_edges()
	option_button.set_meta("selected_text", selected_value)
	option_button.tooltip_text = selected_value
	option_button.queue_redraw()

func _household_creator_selected_option_text(button: Variant, fallback: String = "") -> String:
	if button == null:
		return fallback
	if not (button is Object):
		return fallback
	if not is_instance_valid(button):
		return fallback
	if not (button is OptionButton):
		return fallback

	var option_button: OptionButton = button as OptionButton
	if option_button == null:
		return fallback

	if option_button.item_count <= 0:
		var meta_text: String = str(option_button.get_meta("selected_text", "")).strip_edges()
		return meta_text if meta_text != "" else fallback

	var selected_index: int = int(option_button.selected)
	if selected_index < 0 or selected_index >= option_button.item_count:
		var meta_text: String = str(option_button.get_meta("selected_text", "")).strip_edges()
		return meta_text if meta_text != "" else fallback

	var text: String = str(option_button.get_item_text(selected_index)).strip_edges()
	if text == "":
		var meta_text: String = str(option_button.get_meta("selected_text", "")).strip_edges()
		return meta_text if meta_text != "" else fallback

	option_button.set_meta("selected_text", text)
	return text
func _household_creator_catalog_for_context(context: Dictionary) -> Dictionary:
	MainSceneLogic._ensure_family_creation_contract_engine(gs)

	if gs != null and gs.family_creation_contract_engine != null:
		return gs.family_creation_contract_engine.build_world_catalog(context)

	var era_key: String = str(context.get("era", "Modern")).strip_edges()
	var reality_mode: String = str(context.get("reality_mode", "chaos")).strip_edges().to_lower()
	var default_class: String = str(context.get("default_social_class", "Middle Class")).strip_edges()
	var countries: Array = _household_creator_era_countries(era_key, reality_mode)
	var selected_country: String = str(context.get("country", "")).strip_edges()
	if selected_country == "" or not MainSceneHelpers._household_creator_array_has_text(countries, selected_country):
		selected_country = str(countries [0]).strip_edges() if not countries.is_empty() else ""

	return {
		"schema": "eralife.family_creation_world_catalog_fallback",
		"version": 1,
		"era": era_key,
		"reality_mode": reality_mode,
		"selected_country": selected_country,
		"selected_city": "",
		"era_options": _era_keys_for_picker(),
		"reality_mode_options": ["realistic", "enhanced", "chaos"],
		"class_options": ["Poor", "Working Class", "Middle Class", "Wealthy", "Noble", "Royal"],
		"country_options": countries,
		"city_options": _household_creator_era_cities(era_key, selected_country, reality_mode),
		"house_type_options": MainSceneLogic._household_creator_house_type_options_for(gs, default_class, era_key),
		"job_options": ["Unemployed", "Student", "Teacher"],
		"relationship_options": ["Roommate", "Friend", "Mother", "Father", "Sibling"]
	}


func _household_creator_update_world_selection_labels() -> void:
	var era_text: String = _household_creator_selected_option_text(household_creator_era_picker, "Modern")
	var class_text: String = _household_creator_selected_option_text(household_creator_social_class_picker, "Middle Class")
	var country_text: String = _household_creator_selected_option_text(household_creator_country_picker, "")

	if household_creator_selected_era_label != null and is_instance_valid(household_creator_selected_era_label):
		household_creator_selected_era_label.text = era_text

	if household_creator_selected_class_label != null and is_instance_valid(household_creator_selected_class_label):
		household_creator_selected_class_label.text = class_text

	if household_creator_selected_country_label != null and is_instance_valid(household_creator_selected_country_label):
		household_creator_selected_country_label.text = country_text if country_text != "" else "Select country"

func _household_creator_sync_era_from_year() -> void:
	if household_creator_year_spin == null or not is_instance_valid(household_creator_year_spin):
		return
	if household_creator_era_picker == null or not is_instance_valid(household_creator_era_picker):
		return

	var era_key: String = "Modern"
	var era_engine:= _get_ui_era_engine()
	if era_engine != null and era_engine.has_method("get_era_key_from_year"):
		era_key = str(era_engine.get_era_key_from_year(int(household_creator_year_spin.value)))
	else:
		MainSceneLogic._ensure_family_creation_contract_engine(gs)
		if gs != null and gs.family_creation_contract_engine != null:
			era_key = gs.family_creation_contract_engine.year_to_era(int(household_creator_year_spin.value))

	household_creator_world_picker_sync_guard = true
	for i in range(household_creator_era_picker.item_count):
		if household_creator_era_picker.get_item_text(i).strip_edges().to_lower() == era_key.to_lower():
			household_creator_era_picker.select(i)
			break
	household_creator_world_picker_sync_guard = false
func _household_creator_sync_year_from_era() -> void:
	if household_creator_year_spin == null or not is_instance_valid(household_creator_year_spin):
		return
	if household_creator_era_picker == null or not is_instance_valid(household_creator_era_picker):
		return

	var era_key: String = _household_creator_selected_option_text(household_creator_era_picker, "Modern")
	var target_year: int = _representative_default_year_for_era(era_key)

	var era_engine:= _get_ui_era_engine()
	if era_engine != null and typeof(era_engine.eras) == TYPE_DICTIONARY:
		var era_data: Dictionary = era_engine.eras.get(era_key, {})
		target_year = int(era_data.get("start_year", target_year))

	household_creator_world_picker_sync_guard = true
	household_creator_year_spin.value = target_year
	household_creator_world_picker_sync_guard = false

func _household_creator_refresh_world_dependent_pickers(reset_country_for_era: bool = false) -> void:
	var previous_house_type: String = _household_creator_selected_option_text(household_creator_house_type_picker, "")
	var previous_country: String = _household_creator_selected_option_text(household_creator_country_picker, "")
	var previous_city: String = _household_creator_selected_option_text(household_creator_city_picker, "")

	var era_key: String = _household_creator_selected_option_text(household_creator_era_picker, "Modern")
	var reality_mode: String = _household_creator_current_reality_mode()
	var default_class: String = _household_creator_selected_option_text(household_creator_social_class_picker, "Middle Class")

	var catalog_context:= {
		"era": era_key,
		"year": _household_creator_spin_box_int(household_creator_year_spin, 2000),
		"reality_mode": reality_mode,
		"default_social_class": default_class,
		"country": previous_country,
		"city": previous_city
	}

	var catalog: Dictionary = _household_creator_catalog_for_context(catalog_context)

	var house_options: Array = catalog.get("house_type_options", [])
	if household_creator_house_type_picker != null and is_instance_valid(household_creator_house_type_picker):
		_household_creator_set_option_items(household_creator_house_type_picker, house_options, previous_house_type)

	var country_options: Array = _household_creator_era_countries(era_key, reality_mode)
	if country_options.is_empty():
		country_options = catalog.get("country_options", [])

	var selected_country: String = previous_country
	if reset_country_for_era or not MainSceneHelpers._household_creator_array_has_text(country_options, previous_country):
		selected_country = str(catalog.get("selected_country", "")).strip_edges()
		if selected_country == "" or not MainSceneHelpers._household_creator_array_has_text(country_options, selected_country):
			selected_country = str(country_options [0]).strip_edges() if not country_options.is_empty() else ""

	if household_creator_country_picker != null and is_instance_valid(household_creator_country_picker):
		_household_creator_set_option_items(household_creator_country_picker, country_options, selected_country)

	_household_creator_refresh_city_picker_for_selected_country(previous_city)
	_household_creator_update_world_selection_labels()
func _household_creator_refresh_city_picker_for_selected_country(preferred_city: String = "") -> void:
	if household_creator_city_picker == null or not is_instance_valid(household_creator_city_picker):
		return

	var era_key: String = _household_creator_selected_option_text(household_creator_era_picker, "Modern")
	var reality_mode: String = _household_creator_current_reality_mode()
	var country: String = _household_creator_selected_option_text(household_creator_country_picker, "")

	if country == "":
		var countries: Array = _household_creator_era_countries(era_key, reality_mode)
		if not countries.is_empty():
			country = str(countries [0]).strip_edges()
			if household_creator_country_picker != null and is_instance_valid(household_creator_country_picker):
				_household_creator_set_option_items(household_creator_country_picker, countries, country)

	var cities: Array = _household_creator_era_cities(era_key, country, reality_mode)
	var selected_city: String = preferred_city
	if selected_city == "" or not MainSceneHelpers._household_creator_array_has_text(cities, selected_city):
		selected_city = str(cities [0]).strip_edges() if not cities.is_empty() else ""

	_household_creator_set_option_items(household_creator_city_picker, cities, selected_city)


func _household_creator_era_countries(era_key: String, reality_mode: String) -> Array:
	var era_engine:= _get_ui_era_engine()
	var countries: Array = []

	if era_engine != null and era_engine.has_method("get_countries_for_era"):
		countries = era_engine.get_countries_for_era(era_key)

	if countries.is_empty() and era_engine != null and era_engine.has_method("get_birth_locations_for_era"):
		for raw_location in era_engine.get_birth_locations_for_era(era_key):
			if typeof(raw_location) != TYPE_DICTIONARY:
				continue
			var location: Dictionary = raw_location as Dictionary
			var country: String = str(location.get("country", "")).strip_edges()
			if country != "":
				countries.append(country)

	countries = MainSceneLogic._filter_birth_countries_for_reality_mode(countries, reality_mode)
	countries = MainSceneHelpers._household_creator_dedupe_sorted_strings(countries)

	if countries.is_empty() and gs != null and gs.family_creation_contract_engine != null:
		countries = gs.family_creation_contract_engine.country_options_for(era_key, reality_mode)
		countries = MainSceneHelpers._household_creator_dedupe_sorted_strings(countries)

	if countries.is_empty():
		countries = ["United States"]

	return countries

func _household_creator_era_cities(era_key: String, country: String, reality_mode: String) -> Array:
	var era_engine:= _get_ui_era_engine()
	var cities: Array = []

	if era_engine != null and era_engine.has_method("get_cities_for_era_country"):
		cities = era_engine.get_cities_for_era_country(era_key, country)

	if cities.is_empty() and era_engine != null and era_engine.has_method("get_birth_locations_for_era"):
		for raw_location in era_engine.get_birth_locations_for_era(era_key):
			if typeof(raw_location) != TYPE_DICTIONARY:
				continue
			var location: Dictionary = raw_location as Dictionary
			var entry_country: String = str(location.get("country", "")).strip_edges()
			if country != "" and entry_country != country:
				continue
			var city: String = str(location.get("city", "")).strip_edges()
			if city != "":
				cities.append(city)

	cities = _filter_birth_cities_for_reality_mode(era_key, cities, reality_mode)

	if cities.is_empty() and era_engine != null and era_engine.has_method("get_cities_for_era_country"):
		cities = era_engine.get_cities_for_era_country(era_key, "")
		cities = _filter_birth_cities_for_reality_mode(era_key, cities, reality_mode)

	return MainSceneHelpers._household_creator_dedupe_sorted_strings(cities)

func _household_creator_mark_world_dirty() -> void:
	household_creator_world_prewarmed = false
	household_creator_world_contract.clear()
	household_creator_created_members.clear()
	household_creator_confirm_no_family = false

	if household_creator_prewarm_progress_bar != null and is_instance_valid(household_creator_prewarm_progress_bar):
		household_creator_prewarm_progress_bar.value = 0.0

	if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
		household_creator_status_label.text = "World changed. Prewarm the world seed again before creating members."


func _household_creator_read_world_contract() -> Dictionary:
	var era_key: String = _household_creator_selected_option_text(household_creator_era_picker, "Modern")
	var year_value: int = _household_creator_spin_box_int(household_creator_year_spin, 2000)
	var reality_mode: String = _household_creator_current_reality_mode()
	var default_class: String = _household_creator_selected_option_text(household_creator_social_class_picker, "Middle Class")
	var house_type: String = _household_creator_selected_option_text(household_creator_house_type_picker, "Family home")
	var country: String = _household_creator_selected_option_text(household_creator_country_picker, "")
	var city: String = _household_creator_selected_option_text(household_creator_city_picker, "")

	var family_spawn_policy: String = str(household_creator_family_spawn_policy).strip_edges().to_lower()
	if family_spawn_policy not in ["house_is_family", "spawn_with_family"]:
		family_spawn_policy = "house_is_family"
		household_creator_family_spawn_policy = family_spawn_policy

	if country == "":
		var countries: Array = _household_creator_era_countries(era_key, reality_mode)
		if not countries.is_empty():
			country = str(countries [0])

	if city == "":
		var cities: Array = _household_creator_era_cities(era_key, country, reality_mode)
		if not cities.is_empty():
			city = str(cities [0])

	return {
		"schema": "eralife.household_creator_world_contract",
		"version": 1,
		"era": era_key,
		"year": year_value,
		"reality_mode": reality_mode,
		"default_social_class": default_class,
		"house_type": house_type,
		"country": country,
		"city": city,
		"family_spawn_policy": family_spawn_policy
	}
