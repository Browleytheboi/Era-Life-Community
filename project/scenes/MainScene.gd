func _relationship_hub_live_refresh_visible_cards(force: bool = false) -> void:
	if not _relationship_hub_runtime_surface_active():
		return
	if institution_hub_experience_rows.is_empty():
		return

	var now_ms: int = int(Time.get_ticks_msec())

	if _relationship_hub_first_open_scroll_grace_active() and not force:
		set_meta("relationship_hub_next_live_card_refresh_ms", now_ms + 180)
		set_meta("relationship_hub_live_card_refresh_deferred_for_first_open_scroll", true)
		return

	var next_allowed_ms: int = int(get_meta("relationship_hub_next_live_card_refresh_ms", 0))
	var scroll_recent: bool = _institution_hub_scroll_is_recently_active()
	var navigation_window: bool = _relationship_hub_navigation_perf_window_active()

	if not force and now_ms < next_allowed_ms:
		return

	var refresh_interval_ms: int = 620
	var refresh_budget: int = 12
	var overscan: float = 360.0

	if scroll_recent:
		refresh_interval_ms = 920
		refresh_budget = 6
		overscan = 620.0

	if navigation_window:
		refresh_interval_ms = 780
		refresh_budget = 8
		overscan = 660.0

	if force:
		refresh_interval_ms = 260
		refresh_budget = 18
		overscan = 720.0

	set_meta("relationship_hub_next_live_card_refresh_ms", now_ms + refresh_interval_ms)
	_relationship_hub_refresh_runtime_visibility_cache(force)

	var refreshed_rows: int = 0
	var contract_by_id: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("relationships_hub_card_contract_by_actor", {})) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else {}

	for row_data in institution_hub_experience_rows:
		if refreshed_rows >= refresh_budget:
			break

		var npc_id: int = int(row_data.get("relationship_npc_id", -1))
		if npc_id <= 0:
			continue

		if not _institution_hub_row_data_is_scroll_visible(row_data, overscan):
			continue

		var contract: Dictionary = MainSceneHelpers._safe_dictionary(row_data.get("relationship_card_contract", {}))
		if contract.is_empty() and contract_by_id.has(str(npc_id)):
			contract = MainSceneHelpers._safe_dictionary(contract_by_id.get(str(npc_id), {}))

		if contract.is_empty():
			continue

		if bool(row_data.get("mini_bar", false)):
			var stat_key: String = str(row_data.get("relationship_stat_key", "")).strip_edges().to_lower()
			var surface_context: Dictionary = MainSceneHelpers._safe_dictionary(row_data.get("surface_context", contract.get("surface_context", {})))
			surface_context ["relationship_card_stat_header_mode"] = "centered_label_descriptor_subtext"
			surface_context ["numbers_live_inside_bars_only"] = true

			if stat_key == "bond":
				row_data ["title"] = "BOND"
				row_data ["target"] = float(contract.get("bond", row_data.get("target", 0.0)))
				row_data ["max_value"] = 100
			elif stat_key == "health":
				row_data ["title"] = "HEALTH"
				row_data ["target"] = float(contract.get("health", row_data.get("target", 0.0)))
				row_data ["max_value"] = max(1, int(contract.get("health_max", row_data.get("max_value", 100))))

			row_data ["surface_context"] = surface_context.duplicate(true)

			_relationship_hub_apply_mini_stat_surface_content(
				row_data.get("title_label", null) as Label,
				row_data.get("flavor_label", null) as Label,
				row_data.get("bar", null) as ProgressBar,
				str(row_data.get("title", stat_key)).strip_edges(),
				int(row_data.get("target", 0.0)),
				int(row_data.get("max_value", 100)),
				surface_context.duplicate(true)
			)

			refreshed_rows += 1
			continue

		if bool(row_data.get("relationship_card", false)):
			row_data ["relationship_card_contract"] = contract.duplicate(true)
			row_data ["card_state"] = str(contract.get("state", row_data.get("card_state", "warm"))).strip_edges().to_lower()
			row_data ["card_bond"] = int(contract.get("bond", row_data.get("card_bond", 50)))
			row_data ["card_is_self"] = bool(contract.get("is_self", row_data.get("card_is_self", false)))
			refreshed_rows += 1

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["relationships_hub_live_refresh_contract_only"] = true
		gs.scenario_state ["relationships_hub_live_refresh_no_npc_reactivation"] = true
		gs.scenario_state ["relationships_hub_live_refresh_no_loading"] = true
		gs.scenario_state ["relationships_hub_live_refresh_at_ms"] = now_ms

func _relationship_profile_niece_nephew_relation_fallback(target: Person) -> String:
	if gs == null or gs.player == null or target == null:
		return ""

	var player: Person = gs.player
	var target_id: int = int(target.id)

	for raw_sibling_id in _collect_sibling_ids_for_person(player):
		var sibling_id: int = int(raw_sibling_id)
		if sibling_id <= 0:
			continue

		var sibling: Person = gs.get_or_reactivate_npc_by_id(sibling_id)
		if sibling == null:
			continue

		if not target_id in MainSceneHelpers._relationship_safe_person_id_array(sibling, "children"):
			continue

		var sibling_role: String = MainSceneHelpers._relationship_profile_gendered_sibling_label(sibling)
		var sibling_name: String = str(sibling.first_name).strip_edges()
		if sibling_name == "":
			sibling_name = _relationship_display_name(sibling)

		var child_role: String = MainSceneHelpers._relationship_profile_gendered_child_label(target)
		var age_order: String = _relationship_profile_sibling_child_age_order(sibling, target)

		return "%s (%s %s's %s %s)" % [
			MainSceneHelpers._relationship_profile_gendered_niece_nephew_label(target),
			sibling_role,
			sibling_name,
			age_order,
			child_role
		]

	return ""


func _relationship_profile_sibling_child_age_order(sibling: Person, target: Person) -> String:
	if sibling == null or target == null or gs == null:
		return "only"

	var child_people: Array = []
	for raw_child_id in MainSceneHelpers._relationship_safe_person_id_array(sibling, "children"):
		var child: Person = gs.get_or_reactivate_npc_by_id(int(raw_child_id))
		if child == null:
			continue
		child_people.append(child)

	if child_people.size() <= 1:
		return "only"

	child_people.sort_custom(Callable(self, "_relationship_profile_person_age_ascending_sort"))

	var target_index: int = -1
	for i in range(child_people.size()):
		var child_at_index: Person = child_people [i]
		if child_at_index != null and int(child_at_index.id) == int(target.id):
			target_index = i
			break

	if target_index <= 0:
		return "youngest"
	if target_index >= child_people.size() - 1:
		return "oldest"

	var midpoint: float = float(child_people.size() - 1) / 2.0
	if float(target_index) < midpoint:
		return "younger"

	return "older"


func _relationship_profile_person_age_ascending_sort(a: Person, b: Person) -> bool:
	if a == null and b == null:
		return false
	if a == null:
		return false
	if b == null:
		return true

	if int(a.age) == int(b.age):
		return int(a.id) < int(b.id)

	return int(a.age) < int(b.age)


