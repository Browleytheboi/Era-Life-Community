func _install_zero_frame_touchpad_scroll_contract(scroll: ScrollContainer, reason: String = "zero_frame_scroll") -> void:
	if scroll == null:
		return
	if not is_instance_valid(scroll):
		return

	scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	scroll.focus_mode = Control.FOCUS_NONE
	scroll.follow_focus = false
	scroll.scroll_deadzone = 0
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO

	scroll.set_meta("zero_frame_touchpad_scroll_contract", true)
	scroll.set_meta("zero_frame_touchpad_scroll_reason", reason)
	scroll.set_meta("zero_frame_touchpad_scroll_installed_at_ms", int(Time.get_ticks_msec()))
	scroll.set_meta("scrollbar_click_required", false)
	scroll.set_meta("wheel_scroll_allowed", true)
	scroll.set_meta("trackpad_scroll_allowed", true)
	scroll.set_meta("touch_drag_scroll_allowed", true)
	scroll.set_meta("scroll_input_owned_by_surface_lens", true)

	var scroll_callable: Callable = Callable(self, "_on_zero_frame_scroll_surface_gui_input").bind(scroll)
	if not scroll.gui_input.is_connected(scroll_callable):
		scroll.gui_input.connect(scroll_callable)

	MainSceneHelpers._install_zero_frame_scroll_passthrough(scroll)
	_bind_zero_frame_scroll_input_bridge(scroll, scroll)


func _on_zero_frame_scroll_surface_gui_input(event: InputEvent, scroll: ScrollContainer) -> void:
	_zero_frame_scroll_input_event_consumed(event, scroll)
func _bind_zero_frame_scroll_input_bridge(root: Node, scroll: ScrollContainer) -> void:
	if root == null:
		return
	if scroll == null:
		return
	if not is_instance_valid(root):
		return
	if not is_instance_valid(scroll):
		return

	for raw_child in root.get_children():
		var child:= raw_child as Node
		if child == null:
			continue

		if child is ScrollContainer and child != scroll:
			continue

		if child is Control and child != scroll:
			var control:= child as Control
			control.set_meta("zero_frame_scroll_bridge_owner", scroll.get_instance_id())
			control.set_meta("zero_frame_scroll_bridge_reason", str(scroll.get_meta("zero_frame_touchpad_scroll_reason", "zero_frame_scroll")))

			var child_scroll_callable: Callable = Callable(self, "_on_zero_frame_scroll_child_gui_input").bind(scroll)
			if not control.gui_input.is_connected(child_scroll_callable):
				control.gui_input.connect(child_scroll_callable)

		_bind_zero_frame_scroll_input_bridge(child, scroll)


func _on_zero_frame_scroll_child_gui_input(event: InputEvent, scroll: ScrollContainer) -> void:
	_zero_frame_scroll_input_event_consumed(event, scroll)


func _zero_frame_scroll_input_event_consumed(event: InputEvent, scroll: ScrollContainer) -> bool:
	if scroll == null:
		return false
	if not is_instance_valid(scroll):
		return false

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if not mouse_event.pressed:
			return false

		match mouse_event.button_index:
			MOUSE_BUTTON_WHEEL_UP:
				MainSceneHelpers._zero_frame_scroll_by(scroll, - MainSceneHelpers._zero_frame_scroll_step(scroll))
				get_viewport().set_input_as_handled()
				accept_event()
				return true
			MOUSE_BUTTON_WHEEL_DOWN:
				MainSceneHelpers._zero_frame_scroll_by(scroll, MainSceneHelpers._zero_frame_scroll_step(scroll))
				get_viewport().set_input_as_handled()
				accept_event()
				return true
			_:
				return false

	if event is InputEventPanGesture:
		var pan_event:= event as InputEventPanGesture
		var pan_amount: float = float(pan_event.delta.y) * MainSceneHelpers._zero_frame_trackpad_scroll_multiplier(scroll)

		if abs(pan_amount) < 1.0 and float(pan_event.delta.y) != 0.0:
			pan_amount = MainSceneHelpers._zero_frame_scroll_step(scroll) * sign(float(pan_event.delta.y))

		MainSceneHelpers._zero_frame_scroll_by(scroll, pan_amount)
		get_viewport().set_input_as_handled()
		accept_event()
		return true

	if event is InputEventScreenDrag:
		var drag_event:= event as InputEventScreenDrag
		MainSceneHelpers._zero_frame_scroll_by(scroll, - float(drag_event.relative.y) * 1.35)
		get_viewport().set_input_as_handled()
		accept_event()
		return true

	return false

func _resident_profile_switch_tail_player_surface_is_critical(
	now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	if _ui_interaction_grace_active(
		check_ms
	):
		return true

	if _runtime_interactive_surface_busy(
		check_ms
	):
		return true

	var ready_door_hot: bool = bool(
		get_meta(
			"ready_door_latch_hot",
			false
		)
	)
	var ready_door_finalizing: bool = bool(
		get_meta(
			"ready_door_latch_finalizing",
			false
		)
	)
	var ready_door_revealed: bool = bool(
		get_meta(
			"god_mode_ready_revealed_staged_surface",
			false
		)
	)
	var player_control_released: bool = bool(
		get_meta(
			"playable_life_surface_player_control_released",
			false
		)
	)
	var player_control_released_at_ms: int = int(
		get_meta(
			"playable_life_surface_player_control_released_at_ms",
			get_meta(
				"birth_shell_player_control_released_at_ms",
				0
			)
		)
	)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		ready_door_hot = (
			ready_door_hot
			or bool(
				gs.scenario_state.get(
					"ready_door_latch_hot",
					false
				)
			)
		)
		ready_door_finalizing = (
			ready_door_finalizing
			or bool(
				gs.scenario_state.get(
					"ready_door_latch_finalizing",
					false
				)
			)
		)
		ready_door_revealed = (
			ready_door_revealed
			or bool(
				gs.scenario_state.get(
					"god_mode_ready_revealed_staged_surface",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"spawn_ready_live_ui_shell_released",
					false
				)
			)
		)
		player_control_released = (
			player_control_released
			or bool(
				gs.scenario_state.get(
					"playable_life_surface_player_control_released",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"birth_shell_player_control_released",
					false
				)
			)
		)

		player_control_released_at_ms = maxi(
			player_control_released_at_ms,
			int(
				gs.scenario_state.get(
					"playable_life_surface_player_control_released_at_ms",
					gs.scenario_state.get(
						"birth_shell_player_control_released_at_ms",
						0
					)
				)
			)
		)

	if (
		ready_door_hot
		and not ready_door_revealed
	):
		return true

	if ready_door_finalizing:
		return true

	if (
		player_control_released
		and player_control_released_at_ms > 0
		and check_ms - player_control_released_at_ms < 1400
	):
		return true

	return false

func _resident_profile_switch_tail_background_slice_allowed(
	now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	var explicit_profile_upgrade_pending: bool = (
		_relationship_profile_switch_destination_upgrade_pending_for_target(
			-1
		)
	)

	if (
		not explicit_profile_upgrade_pending
		and _resident_profile_switch_tail_player_surface_is_critical(
			check_ms
		)
	):
		set_meta(
			"resident_profile_switch_tail_paused_for_player_surface",
			true
		)
		set_meta(
			"resident_profile_switch_tail_next_ms",
			check_ms + 1800
		)

		if (
			gs != null
			and typeof(gs.scenario_state) == TYPE_DICTIONARY
		):
			gs.scenario_state [
				"resident_profile_switch_tail_paused_for_player_surface"
			] = true
			gs.scenario_state [
				"resident_profile_switch_tail_next_ms"
			] = check_ms + 1800

		return false

	if (
		explicit_profile_upgrade_pending
		and _ui_interaction_grace_active(
			check_ms
		)
	):
		set_meta(
			"relationship_profile_switch_destination_upgrade_next_flush_ms",
			check_ms + 120
		)
		return false

	if (
		not explicit_profile_upgrade_pending
		and (
			relationship_profile_popup_open
			or relationships_browser_open
			or activities_action_open
			or standard_tab_popup_open
			or world_feed_popup_open
			or action_result_popup_open
			or panel_content_transition_active
		)
	):
		set_meta(
			"resident_profile_switch_tail_next_ms",
			check_ms + 900
		)
		return false

	var next_ms: int = 0

	if explicit_profile_upgrade_pending:
		next_ms = int(
			get_meta(
				"relationship_profile_switch_destination_upgrade_next_flush_ms",
				0
			)
		)
	else:
		next_ms = int(
			get_meta(
				"resident_profile_switch_tail_next_ms",
				0
			)
		)

	if check_ms < next_ms:
		return false

	if explicit_profile_upgrade_pending:
		set_meta(
			"relationship_profile_switch_destination_upgrade_next_flush_ms",
			check_ms + 260
		)
		set_meta(
			"resident_profile_switch_tail_last_allowed_ms",
			check_ms
		)
		set_meta(
			"resident_profile_switch_tail_explicit_profile_upgrade_allowed",
			true
		)

		if (
			gs != null
			and typeof(gs.scenario_state) == TYPE_DICTIONARY
		):
			gs.scenario_state [
				"resident_profile_switch_tail_explicit_profile_upgrade_allowed"
			] = true
			gs.scenario_state [
				"relationship_profile_switch_destination_upgrade_next_flush_ms"
			] = check_ms + 260

		return true

	set_meta(
		"resident_profile_switch_tail_next_ms",
		check_ms + 1800
	)
	set_meta(
		"resident_profile_switch_tail_last_allowed_ms",
		check_ms
	)
	set_meta(
		"resident_profile_switch_tail_global_idle_bus_throttled",
		true
	)

	return true
func _drive_zero_frame_consciousness_switch_tail_if_idle(
	now_ms: int
) -> bool:
	if (
		gs == null
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return false

	var switch_tail_pending: bool = bool(
		gs.scenario_state.get(
			"zero_frame_consciousness_switch_tail_pending",
			false
		)
	)
	var full_refresh_pending: bool = bool(
		gs.scenario_state.get(
			"zero_frame_consciousness_switch_full_refresh_pending",
			false
		)
	)





	if (
		not switch_tail_pending
		and not full_refresh_pending
	):
		if _resident_profile_switch_tail_background_slice_allowed(
			now_ms
		):
			_flush_relationship_hub_contract_engine_tail_work(
				"resident_profile_switch_core_packet_tail_detached"
			)
			return true

		return false

	if _resident_profile_switch_tail_player_surface_is_critical(
		now_ms
	):
		gs.scenario_state [
			"zero_frame_consciousness_switch_tail_next_ms"
		] = now_ms + 420
		gs.scenario_state [
			"zero_frame_consciousness_switch_full_refresh_next_ms"
		] = now_ms + 620
		gs.scenario_state [
			"zero_frame_tail_yielded_to_player_surface"
		] = true
		return false

	if _ui_interaction_grace_active(
		now_ms
	):
		gs.scenario_state [
			"zero_frame_consciousness_switch_tail_next_ms"
		] = now_ms + 420
		gs.scenario_state [
			"zero_frame_consciousness_switch_full_refresh_next_ms"
		] = now_ms + 620
		return false

	if age_up_loading_runtime_active:
		return false

	if bool(
		get_meta(
			"age_up_transition_busy",
			false
		)
	):
		return false

	if bool(
		get_meta(
			"age_up_post_loading_finalize_pending",
			false
		)
	):
		return false

	if (
		relationship_profile_popup_open
		or relationships_browser_open
	):
		return false

	if (
		activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
	):
		return false

	if panel_content_transition_active:
		return false

	var next_ms: int = int(
		gs.scenario_state.get(
			"zero_frame_consciousness_switch_tail_next_ms",
			0
		)
	)

	if next_ms > 0 and now_ms < next_ms:
		return false

	if switch_tail_pending:
		if gs.universal_switch_contract_engine == null:
			gs.scenario_state [
				"zero_frame_consciousness_switch_tail_pending"
			] = false
		elif not gs.universal_switch_contract_engine.has_method(
			"continue_zero_frame_switch_tail"
		):
			gs.scenario_state [
				"zero_frame_consciousness_switch_tail_pending"
			] = false
		else:
			var report: Dictionary = (
				gs.universal_switch_contract_engine
				.continue_zero_frame_switch_tail(
					1
				)
			)
			var complete: bool = bool(
				report.get(
					"is_complete",
					false
				)
			)

			gs.scenario_state [
				"zero_frame_consciousness_switch_tail_last_report"
			] = report.duplicate(false)
			gs.scenario_state [
				"zero_frame_consciousness_switch_tail_last_ms"
			] = now_ms
			gs.scenario_state [
				"zero_frame_consciousness_switch_tail_deep_copy_forbidden"
			] = true

			if complete:
				gs.scenario_state [
					"zero_frame_consciousness_switch_tail_pending"
				] = false
				gs.scenario_state.erase(
					"zero_frame_consciousness_switch_tail_next_ms"
				)
			else:
				gs.scenario_state [
					"zero_frame_consciousness_switch_tail_pending"
				] = true
				gs.scenario_state [
					"zero_frame_consciousness_switch_tail_next_ms"
				] = now_ms + 320

			return true

	return (
		_drive_zero_frame_consciousness_switch_full_refresh_if_idle(
			now_ms
		)
	)
func _drive_zero_frame_consciousness_switch_full_refresh_if_idle(now_ms: int) -> bool:
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	if not bool(gs.scenario_state.get("zero_frame_consciousness_switch_full_refresh_pending", false)):
		return false

	if _zero_frame_switch_surface_lock_active(now_ms):
		_refresh_locked_zero_frame_switch_surface("full_refresh_blocked_by_zero_frame_switch_surface_lock")
		gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_next_ms"] = now_ms + 520
		return false

	var next_ms: int = int(gs.scenario_state.get("zero_frame_consciousness_switch_full_refresh_next_ms", 0))
	if next_ms > 0 and now_ms < next_ms:
		return false

	if _ui_interaction_grace_active(now_ms):
		gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_next_ms"] = now_ms + 520
		return false


	var stage: int = int(gs.scenario_state.get("zero_frame_consciousness_switch_full_refresh_stage", 0))

	match stage:
		0:
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_stage"] = 1
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_next_ms"] = now_ms + 260
			return true

		1:
			call_deferred("_render_life_diary_panel")
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_stage"] = 2
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_next_ms"] = now_ms + 260
			return true

		2:
			call_deferred("_update_player_stats_overlay")
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_pending"] = false
			gs.scenario_state.erase("zero_frame_consciousness_switch_full_refresh_next_ms")
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_stage"] = 0
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_completed_ms"] = now_ms
			return true

		_:
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_pending"] = false
			gs.scenario_state.erase("zero_frame_consciousness_switch_full_refresh_next_ms")
			gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_stage"] = 0
			return false
func _reset_age_up_tail_state_for_new_life_handoff(reason: String = "new_life_handoff") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("age_up_post_loading_finalize_pending", false)
