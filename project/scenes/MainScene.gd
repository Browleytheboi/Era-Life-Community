func _relationship_profile_popup_target_for_render(target_id: int, render_token: int, _allow_reactivate: bool = false) -> Person:
	if not _relationship_profile_popup_render_is_current(target_id, render_token):
		return null

	var target: Person = _relationship_profile_cached_target_for_id(target_id)
