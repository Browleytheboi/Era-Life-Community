				"skip_checks_and_balances": true,
				"authority_prevalidated": true
			}
		)
	)

	var result: Dictionary = (
		_meat_market_route_result(
			report
		)
	)

	if result.is_empty():
		return {}

	var surface_raw: Variant = result.get(
		"surface_contract",
		{}
	)

	if typeof(surface_raw) == TYPE_DICTIONARY:
		var surface_contract: Dictionary = (
			surface_raw as Dictionary
		)

		if not surface_contract.is_empty():
			return surface_contract.duplicate(false)

	var schema: String = str(
		result.get(
			"schema",
			""
		)
	).strip_edges()

	if (
		bool(
			result.get(
				"success",
				false
			)
		)
		and (
			schema
			== "eralife.market.meat_market.surface_contract"
			or result.has("listings")
			or result.has("food_card_contracts")
		)
	):
		return result.duplicate(false)

	return {}


