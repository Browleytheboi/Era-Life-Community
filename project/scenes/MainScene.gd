			return cached.duplicate(true)

	return _build_player_crown_summary()


func _crown_hub_uses_federal_republic_layout() -> bool:
	if bool(get_meta("crown_hub_force_federal_republic_layout", false)):
		return true
	return MainSceneLogic._player_is_federal_republic_office_holder(gs)


func _crown_hub_section_specs() -> Array:
		if _crown_hub_uses_federal_republic_layout():
			return [
				["throne", "Office"],
				["court", "Cabinet"],
				["nation", "Nation"],
				["allocation", "Allocation"],
				["diplomacy", "Diplomacy"],
				["law", "Law"],
				["dynasty", "First Family"],
				["war", "War"]
			]

		return [
			["throne", "Throne"],
			["court", "Court"],
			["nation", "Nation"],
			["allocation", "Allocation"],
			["diplomacy", "Diplomacy"],
			["law", "Law"],
			["dynasty", "Dynasty"],
			["war", "War"]
		]
func _crown_hub_section_label_for_key(section: String) -> String:
	var clean_section: String = str(section).strip_edges().to_lower()
	for raw_pair in _crown_hub_section_specs():
		if typeof(raw_pair) != TYPE_ARRAY:
			continue
		var pair: Array = raw_pair
		if pair.size() < 2:
			continue
		if str(pair [0]).strip_edges().to_lower() == clean_section:
			return str(pair [1])
	return clean_section.capitalize()

func _crown_hub_section_room_name(section: String) -> String:
	if _crown_hub_uses_federal_republic_layout():
		match str(section).strip_edges().to_lower():
			"throne":
				return "OVAL OFFICE"
			"court":
				return "FEDERAL CABINET"
			"nation":
				return "FEDERAL POPULATION"
			"allocation":
				return "FEDERAL BUDGET"
			"diplomacy":
				return "DIPLOMATIC MAP"
			"law":
				return "FEDERAL LAW"
			"dynasty":
				return "FIRST FAMILY"
			_:
				return "FEDERAL OFFICE"

	match str(section).strip_edges().to_lower():
		"throne":
			return "THRONE ROOM"
		"court":
			return "COURT CHAMBER"
		"nation":
			return "NATION TABLE"
		"allocation":
			return "TREASURY WAR ROOM"
		"diplomacy":
			return "DIPLOMATIC MAP"
		"law":
			return "LAW CHAMBER"
		"dynasty":
			return "DYNASTY HALL"
		_:
			return "CROWN ROOM"
func _crown_hub_header_title_for_section(section: String) -> String:
	var clean_section: String = str(section).strip_edges().to_lower()
	var room_name: String = _crown_hub_section_room_name(clean_section)

	if _crown_hub_uses_federal_republic_layout():
		return room_name

	var section_label: String = _crown_hub_section_label_for_key(clean_section).to_upper()
	if section_label == "" or section_label == room_name:
		return room_name

	return "%s • %s" % [room_name, section_label]
func _crown_hub_consequence_preview_for_action(action_id: String, _payload: Dictionary = {}) -> Dictionary:
	var clean_action: String = str(action_id).strip_edges().to_lower()
	var summary: Dictionary = _build_player_crown_summary()
	var approval_value: int = int(summary.get("approval", 50))
	var happiness_value: int = int(summary.get("happiness", 50))
	var _respect_value: int = int(summary.get("respect", 50))

	match clean_action:
		"execute":
			return {
				"severity": "danger",
				"preview": "Consequence Preview: Fear rises. Approval may fracture. Respect may spike among hardliners.",
				"critical": true,
				"approval_hint": -12,
				"happiness_hint": -8,
				"respect_hint": 6
			}
		"public_disservice":
			return {
				"severity": "danger",
				"preview": "Consequence Preview: Short-term gain. Long-term legitimacy damage.",
				"critical": true,
				"approval_hint": -8,
				"happiness_hint": -5,
				"respect_hint": -3
			}
		"public_service":
			return {
				"severity": "positive",
				"preview": "Consequence Preview: Public trust can rise if the realm believes the act is sincere.",
				"critical": approval_value <= 45 or happiness_value <= 45,
				"approval_hint": 5,
				"happiness_hint": 6,
				"respect_hint": 2
			}
		"law_review":
			return {
				"severity": "weight",
				"preview": "Consequence Preview: Law direction can shift legitimacy, public mood, and court pressure.",
				"critical": true,
				"approval_hint": 0,
				"happiness_hint": 0,
				"respect_hint": 0
			}
		"mediate_citizens":
			return {
				"severity": "stability",
				"preview": "Consequence Preview: Wise mediation can lower local pressure and strengthen ruler legitimacy.",
				"critical": happiness_value <= 50,
				"approval_hint": 3,
				"happiness_hint": 3,
				"respect_hint": 1
			}
		"war":
			return {
				"severity": "danger",
				"preview": "Consequence Preview: War risks lives, treasury, diplomacy, and succession stability.",
				"critical": true,
				"approval_hint": -10,
				"happiness_hint": -12,
				"respect_hint": 8
			}
		"expand_land":
			return {
				"severity": "weight",
				"preview": "Consequence Preview: Expansion can grow the realm but strains treasury and administration.",
				"critical": false,
				"approval_hint": 2,
				"happiness_hint": -1,
				"respect_hint": 3
			}
		_:
			return {
				"severity": "neutral",
				"preview": "Consequence Preview: Contract outcome depends on current realm pressure.",
				"critical": false,
				"approval_hint": 0,
				"happiness_hint": 0,
				"respect_hint": 0
			}


func _crown_hub_apply_preview_pulse(label: Label, delta_value: int) -> void:
	if label == null:
		return
	label.add_theme_color_override("font_color", MainSceneHelpers._crown_hub_projection_color(delta_value))
	label.modulate = Color(1.0, 1.0, 1.0, 0.92 + ((sin(crown_hud_breathe_time * 8.0) + 1.0) * 0.04))


func _crown_hub_style_slider(
		slider: HSlider,
		bucket_key: String
) -> void:
		if slider == null:
			return

		slider.mouse_filter = Control.MOUSE_FILTER_STOP
		slider.custom_minimum_size = Vector2(0, 46)
		slider.scrollable = false

		var core: Color = _crown_hud_core_color()
		var track:= StyleBoxFlat.new()
		track.bg_color = Color(
			0.025,
			0.032,
			0.052,
			0.96
		)
		track.border_color = Color(
			core.r,
			core.g,
			core.b,
			0.35
		)
		track.border_width_left = 1
		track.border_width_top = 1
		track.border_width_right = 1
		track.border_width_bottom = 1
		track.corner_radius_top_left = 12
		track.corner_radius_top_right = 12
		track.corner_radius_bottom_left = 12
		track.corner_radius_bottom_right = 12
		track.content_margin_top = 10.0
		track.content_margin_bottom = 10.0

		var fill:= StyleBoxFlat.new()
		fill.bg_color = Color(
			core.r,
			core.g,
			core.b,
			0.82
		)
		fill.border_color = Color(
			1.0,
			0.9,
			0.58,
			0.88
		)
		fill.border_width_left = 1
		fill.border_width_top = 1
		fill.border_width_right = 1
		fill.border_width_bottom = 1
		fill.corner_radius_top_left = 12
		fill.corner_radius_top_right = 12
		fill.corner_radius_bottom_left = 12
		fill.corner_radius_bottom_right = 12
		fill.content_margin_top = 10.0
		fill.content_margin_bottom = 10.0

		var fill_hover:= fill.duplicate() as StyleBoxFlat
		fill_hover.bg_color = Color(
			minf(1.0, core.r * 1.15),
			minf(1.0, core.g * 1.15),
			minf(1.0, core.b * 1.15),
			0.96
		)

		slider.add_theme_stylebox_override(
			"slider",
			track
		)
		slider.add_theme_stylebox_override(
			"grabber_area",
			fill
		)
		slider.add_theme_stylebox_override(
			"grabber_area_highlight",
			fill_hover
		)
		slider.set_meta(
			"crown_allocation_bucket_key",
			bucket_key
		)
		slider.set_meta(
			"crown_allocation_generic_gray_theme_forbidden",
			true
		)
func _on_crown_hud_pressed() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		gs.player.id
	)
	var surface_revision: String = str(
		crown_hub_active_contract.get(
			"surface_revision",
			str(
				hash(
					crown_hub_active_contract
				)
			)
		)
	).strip_edges()
	var shell_hot: bool = (
		crown_hub_overlay != null
		and is_instance_valid(
			crown_hub_overlay
		)
		and crown_action_popup != null
		and is_instance_valid(
			crown_action_popup
		)
	)
	var contract_hot: bool = (
		_crown_hub_contract_is_renderable(
			crown_hub_active_contract,
			actor_id
		)
	)
	var prepaint_hot: bool = (
		int(
			get_meta(
				"crown_hub_prepainted_actor_id",
				-1
			)
		) == actor_id
		and str(
			get_meta(
				"crown_hub_prepainted_surface_revision",
				""
			)
		) == surface_revision
	)

	if (
		not shell_hot
		or not contract_hot
		or not prepaint_hot
	):
		set_meta(
			"crown_hub_zero_frame_integrity_failure",
			true
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_actor_id",
			actor_id
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_shell_hot",
			shell_hot
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_contract_hot",
			contract_hot
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_prepaint_hot",
			prepaint_hot
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_engine_calls",
			false
		)
		set_meta(
			"crown_hub_zero_frame_integrity_failure_built_on_click",
			false
		)

		_update_crown_hud()

		EraLog.truth(
			"ERALIFE_CROWN_HUD_PRESS_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|shell_hot=" + str(shell_hot).to_lower()
			+ "|contract_hot=" + str(contract_hot).to_lower()
			+ "|prepaint_hot=" + str(prepaint_hot).to_lower()
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)

		return

	_clear_runtime_floating_hud_force_latches()

	var opened: bool = _show_crown_hub(
		str(
			get_meta(
				"crown_hub_prepainted_section_id",
				"throne"
			)
		)
	)

	set_meta(
		"crown_hud_press_reveal_succeeded",
		opened
	)
	set_meta(
		"crown_hud_press_actor_id",
		actor_id
	)
	set_meta(
		"crown_hud_press_engine_calls",
		false
	)
	set_meta(
		"crown_hud_press_build_on_click",
		false
	)
