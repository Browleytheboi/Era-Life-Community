func _install_switched_actor_crime_contract_from_packet(
	target: Person,
	contract: Dictionary
) -> bool:
	if target == null:
		return false

	var target_id: int = int(target.id)

	if (
		contract.is_empty()
		or str(
			contract.get(
				"schema",
				""
			)
		) != "eralife.crime_hub_contract"
		or int(
			contract.get(
				"actor_id",
				-1
			)
		) != target_id
	):
		return false

	_ensure_crime_panel()

	if (
		crime_panel == null
		or not is_instance_valid(crime_panel)
	):
		return false

	crime_panel_active_contract = contract.duplicate(false)
	var hidden_contract: Dictionary = contract.duplicate(false)
	hidden_contract ["install_hidden"] = true
	crime_panel.render_contract(
		hidden_contract
	)
	crime_panel.hide_surface()

	return crime_panel.has_resident_section_deck(
		target_id
	)


func _install_switched_actor_pending_contract_from_packet(
	target: Person,
	payload: Dictionary
) -> bool:
	if (
		target == null
		or gs == null
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return false

	var target_id: int = int(
		target.id
	)

	if (
		payload.is_empty()
		or not bool(
			payload.get(
				"success",
				false
			)
		)
		or int(
			payload.get(
				"actor_id",
				-1
			)
		) != target_id
	):
		return false

	var payload_by_actor: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"resident_pending_situations_payload_by_actor",
			{}
		)
	)
	payload_by_actor [
		str(target_id)
	] = payload.duplicate(false)

	gs.scenario_state [
		"resident_pending_situations_payload_by_actor"
	] = payload_by_actor
	gs.scenario_state [
		"pending_situations_zero_frame_actor_id"
	] = target_id
	gs.scenario_state [
		"pending_situations_zero_frame_count"
	] = maxi(
		0,
		int(
			payload.get(
				"count",
				0
			)
		)
	)
	gs.scenario_state [
		"pending_situations_zero_frame_ready"
	] = true

	var popup_prepainted: bool = (
		_prepaint_pending_situations_popup_payload(
			payload,
			target_id
		)
	)

	gs.scenario_state [
		"pending_situations_popup_prepainted_actor_id"
	] = target_id
	gs.scenario_state [
		"pending_situations_popup_prepainted"
	] = popup_prepainted
	gs.scenario_state [
		"pending_situations_popup_build_on_click"
	] = false

	pending_situations_last_actor_id = target_id

	_paint_pending_situations_button_for_actor_lens(
		target,
		maxi(
			0,
			int(
				payload.get(
					"count",
					0
				)
			)
		),
		"switched_actor_pending_packet"
	)

	return popup_prepainted
func _ensure_modification_panel() -> void:
	if (
		modification_panel != null
		and is_instance_valid(
			modification_panel
		)
	):
		return

	modification_panel = (
		ModificationPanel.new()
	)
	modification_panel.name = (
		"ModificationPanel"
	)
	modification_panel.visible = false
	modification_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	modification_panel.z_as_relative = false
	modification_panel.z_index = 1320

	modification_panel.request_close.connect(
		_on_modification_panel_close_requested
	)
	modification_panel.request_save.connect(
		_on_modification_panel_save_requested
	)

	add_child(
		modification_panel
	)
func _on_modification_panel_save_requested(
	actor_id: int,
	values: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var clean_values: Dictionary = {}

	for raw_key in values.keys():
		var key: String = str(
			raw_key
		).strip_edges()

		if key == "":
			continue

		var raw_value: Variant = values.get(
			raw_key
		)

		match typeof(
			raw_value
		):
			TYPE_INT, TYPE_FLOAT, TYPE_STRING, TYPE_STRING_NAME, TYPE_BOOL:
				clean_values [
					key
				] = raw_value

			_:
				continue

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": int(
					gs.player.id
				),
				"target_id": actor_id,
				"intent_type": (
					"modify_person"
				),
				"surface_id": (
					"modification_panel"
				),
				"action_id": (
					"save_person_modifications"
				),
				"payload": {
					"actor_id": actor_id,
					"target_id": actor_id,
					"values": (
						clean_values.duplicate(false)
					),
					"source": (
						"mainscene.modification_panel"
					),
					"ui_is_renderer_only": true
				},
				"target": {
					"route_kind": (
						"engine_method"
					),
					"engine_property": (
						"live_person_editor_engine"
					),
					"method": (
						"commit_modification_intent"
					),
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene.modification_panel"
				)
			},
			{
				"actor_id": int(
					gs.player.id
				),
				"target_id": actor_id,
				"source": (
					"mainscene.modification_panel"
				),
				"surface_id": (
					"modification_panel"
				),
				"action_id": (
					"save_person_modifications"
				),
			}
		)
	)
	var result: Dictionary = (
		_contract_route_result(
			report
		)
	)

	if not bool(
		result.get(
			"success",
			false
		)
	):
		if (
			modification_panel != null
			and is_instance_valid(
				modification_panel
			)
		):
			modification_panel.set_status(
				str(
					result.get(
						"reason",
						"Modification could not be committed."
					)
				)
			)

		return

	if (
		modification_panel != null
		and is_instance_valid(
			modification_panel
		)
	):
		modification_panel.set_status(
			"Changes committed. Relationship and switch lenses will refresh through residency."
		)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"person_modification_commit_actor_id"
	] = actor_id
	gs.scenario_state [
		"person_modification_commit_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	gs.scenario_state [
		"person_modification_relationship_projection_dirty"
	] = true
	gs.scenario_state [
		"person_modification_relationship_projection_dirty_actor_id"
	] = actor_id
	gs.scenario_state [
		"person_modification_actor_lens_residency_dirty"
	] = true
	gs.scenario_state [
		"person_modification_actor_lens_residency_dirty_actor_id"
	] = actor_id
	gs.scenario_state [
		"person_modification_post_commit_relationship_rebuild_forbidden"
	] = true
	gs.scenario_state [
		"person_modification_post_commit_open_contract_rebuild_forbidden"
	] = true

	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
		and int(
			relationship_profile_panel.active_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
	):
		relationship_profile_panel.active_contract [
			"actor_name"
		] = str(
			result.get(
				"actor_name",
				relationship_profile_panel.active_contract.get(
					"actor_name",
					""
				)
			)
		)
		relationship_profile_panel.active_contract [
			"modified_at_ms"
		] = int(
			Time.get_ticks_msec()
		)




	call_deferred(
		"_queue_modified_actor_lens_residency_refresh",
		actor_id,
		"person_modification_commit"
	)
