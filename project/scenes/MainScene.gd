func _apply_playable_life_viewer_nav_packet_zero_frame(_nav_packet: Dictionary, reason: String = "playable_life_viewer_nav_packet") -> void:
	var required_keys: Array [String] = [
		"world",
		"life",
		"school",
		"activities",
		"relationships",
		"career",
		"careers",
		"age_up"
	]

	for key in required_keys:
		var nav_button: Button = ui_nav_buttons.get(key, null) as Button
		if nav_button == null or not is_instance_valid(nav_button):
			continue

		nav_button.visible = true
		nav_button.disabled = false
		nav_button.mouse_filter = Control.MOUSE_FILTER_STOP
		nav_button.focus_mode = Control.FOCUS_ALL

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["playable_life_viewer_nav_packet_applied"] = true
		gs.scenario_state ["playable_life_viewer_nav_packet_reason"] = reason
		gs.scenario_state ["playable_life_viewer_nav_packet_at_ms"] = int(Time.get_ticks_msec())


