func _on_relationship_editor_save_pressed() -> void:
	if gs == null:
		return

	if relationship_editor_popup_target_id <= 0:
		return

	MainSceneLogic._ensure_live_person_editor_engine(gs)

	var actor_id: int = int(relationship_editor_popup_target_id)
	var values: Dictionary = {
		"happiness": int(relationship_editor_happiness_slider.value),
		"health": int(relationship_editor_health_slider.value),
		"smarts": int(relationship_editor_smarts_slider.value),
		"looks": int(relationship_editor_looks_slider.value),
		"mental_health": int(relationship_editor_mental_health_slider.value),
		"fame": int(relationship_editor_fame_slider.value),
		"fertility": float(relationship_editor_fertility_slider.value),
		"bank_balance": int(
			clamp(
				MainSceneHelpers._selected_god_mode_option_value(
					relationship_editor_bank_balance_picker,
					0
				),
				0,
				5000000
			)
		)
	}

	var report: Dictionary = {}
	if gs.live_person_editor_engine != null and gs.live_person_editor_engine.has_method("apply_editor_values"):
		report = gs.live_person_editor_engine.apply_editor_values(actor_id, values, {
			"source": "relationship_editor_save_pressed",
			"surface": "relationship_editor_popup",
		})

	if not bool(report.get("success", false)):
		if relationship_editor_popup_status != null:
			relationship_editor_popup_status.text = "Could not save edits."
		return

	var target: Person = null
	if gs.player != null and int(gs.player.id) == actor_id:
		target = gs.player
	elif gs.has_method("get_or_reactivate_npc_by_id"):
		target = gs.get_or_reactivate_npc_by_id(actor_id)
	elif gs.has_method("get_npc_by_id"):
		target = gs.get_npc_by_id(actor_id)

	if target == null:
		if relationship_editor_popup_status != null:
			relationship_editor_popup_status.text = "Saved, but that person could not be reopened."
		return

	if relationship_editor_popup != null and is_instance_valid(relationship_editor_popup):
		relationship_editor_popup.visible = false
		relationship_editor_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE

	relationship_editor_popup_target_id = -1

	if gs.player != null and int(target.id) == int(gs.player.id):
		_apply_zero_frame_consciousness_switch_surface({
			"surface_contract": _runtime_hud_truth_surface_for_current_player_after_editor(target),
			"zero_frame_consciousness_switch": true,
			"source": "relationship_editor_save_current_player",
			"live_person_editor_report": report.duplicate(true)
		}, "", [])

	if relationship_profile_popup_open:
		_show_relationship_profile_popup(target)

	if relationship_profile_popup_status != null:
		relationship_profile_popup_status.text = "Saved edits for %s %s." % [
			target.first_name,
			target.last_name
		]
func _pending_situations_count_for_actor(
	actor: Person
) -> int:
	if (
		actor == null
		or gs == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return 0

	var actor_id: int = int(
		actor.id
	)

	if actor_id <= 0:
		return 0

	if (
		int(
			gs.scenario_state.get(
				"pending_situations_zero_frame_actor_id",
				-1
			)
		) == actor_id
		and bool(
			gs.scenario_state.get(
				"pending_situations_zero_frame_ready",
				false
			)
		)
	):
		return maxi(
			0,
			int(
				gs.scenario_state.get(
					"pending_situations_zero_frame_count",
					0
				)
			)
		)

	var registry_raw: Variant = (
		gs.scenario_state.get(
			"resident_pending_situations_payload_by_actor",
			{}
		)
	)

	if typeof(registry_raw) != TYPE_DICTIONARY:
		return 0

	var payload_raw: Variant = (
		(registry_raw as Dictionary).get(
			str(actor_id),
			{}
		)
	)

	if typeof(payload_raw) != TYPE_DICTIONARY:
		return 0

	return maxi(
		0,
		int(
			(payload_raw as Dictionary).get(
				"count",
				0
			)
		)
	)
