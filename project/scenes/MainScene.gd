		action_result_popup_body.fit_content = true
		action_result_popup_body.scroll_active = false
		action_result_popup_body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		action_result_popup_body.size_flags_vertical = Control.SIZE_SHRINK_CENTER
