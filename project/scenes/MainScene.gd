func _superpower_hub_target_picker_rows() -> Array:
	var rows: Array = []
	if gs == null or gs.player == null or typeof(gs.npcs) != TYPE_ARRAY:
		return rows

	for raw_npc in gs.npcs:
		if not (raw_npc is Person):
			continue

		var npc: Person = raw_npc
		if int(npc.id) == int(gs.player.id):
			continue
		if not bool(npc.alive) or float(npc.health) <= 0.0:
			continue

		var relation_label: String = "NPC"
		if has_method("_relationship_label_for_target"):
			relation_label = str(call("_relationship_label_for_target", npc))

		var relation_clean: String = relation_label.strip_edges().to_lower()
		var family_first: bool = (
			relation_clean.find("mother") >= 0
			or relation_clean.find("father") >= 0
			or relation_clean.find("parent") >= 0
			or relation_clean.find("sibling") >= 0
			or relation_clean.find("brother") >= 0
			or relation_clean.find("sister") >= 0
			or relation_clean.find("child") >= 0
			or relation_clean.find("son") >= 0
			or relation_clean.find("daughter") >= 0
			or relation_clean.find("spouse") >= 0
			or relation_clean.find("wife") >= 0
			or relation_clean.find("husband") >= 0
		)

		var powered_text: String = ""
		if gs.power_engine != null and gs.power_engine.has_method("has_superpowers") and gs.power_engine.has_superpowers(npc):
			powered_text = " • Powered"

		rows.append({
			"person_id": int(npc.id),
			"name": MainSceneHelpers._superpower_hub_actor_label(npc),
			"family_first": family_first,
			"label": "%s%s" % [MainSceneHelpers._superpower_hub_actor_label(npc), powered_text],
			"description": "%s • Health %d • Happiness %d" % [
				relation_label,
				int(npc.health),
				int(npc.satisfaction)
			]
		})

	rows.sort_custom(func (a, b):
		var af: bool = bool(a.get("family_first", false))
		var bf: bool = bool(b.get("family_first", false))
		if af != bf:
			return af
		return str(a.get("name", "")) < str(b.get("name", ""))
	)

	return rows
func _player_has_power_hub_access() -> bool:
	if gs == null or gs.player == null:
		return false

	if _runtime_controlled_perspective_truth_bool_for_current_actor([
		"power",
		"power_available",
		"superpower",
		"superpower_available"
	]):
		return true

	return _super_runtime_actor_has_power_hub_access(gs.player)
func _boxing_hud_prime_visible_after_unlock(actor_id: int = -1, reason: String = "boxing_hud_unlocked") -> void:
	if gs == null or gs.player == null:
		return

	var controlled_actor_id: int = int(gs.player.id)
	if actor_id > 0 and actor_id != controlled_actor_id:
		return

	var profile: Dictionary = MainSceneHelpers._safe_dictionary(gs.player.boxing_profile)
	var has_boxing_truth: bool = (
		bool(profile.get("boxing_hub_unlocked", false))
		or bool(profile.get("boxing_career_started_by_player", false))
		or bool(profile.get("is_boxer", false))
		or bool(profile.get("turned_pro", false))
		or bool(MainSceneHelpers._safe_dictionary(profile.get("amateur_circuit", {})).get("is_amateur", false))
	)

	if not has_boxing_truth:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var snapshot: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("runtime_hud_visibility_snapshot", {}))
	snapshot ["player_id"] = controlled_actor_id
	snapshot ["controlled_actor_id"] = controlled_actor_id
	snapshot ["controlled_actor_name"] = _relationship_display_name(gs.player)
	snapshot ["current_panel"] = "life"
	snapshot ["boxing_available"] = true
	snapshot ["boxing_button_visible"] = true
	snapshot ["updated_at_ms"] = int(Time.get_ticks_msec())

	gs.scenario_state ["runtime_hud_visibility_snapshot"] = snapshot
	gs.scenario_state ["runtime_hud_visibility_snapshot_reason"] = reason
	gs.scenario_state ["runtime_hud_visibility_snapshot_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["boxing_hud_visibility_dirty_actor_id"] = controlled_actor_id
	gs.scenario_state ["boxing_hud_visibility_dirty_reason"] = reason
	gs.scenario_state ["boxing_hud_visibility_dirty_at_ms"] = int(Time.get_ticks_msec())

	_ensure_boxing_hud()

	if boxing_hud_button == null or not is_instance_valid(boxing_hud_button):
		return

	boxing_hud_button.visible = true
	boxing_hud_button.disabled = false
	boxing_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP
	boxing_hud_button.text = "🥊"
	boxing_hud_button.tooltip_text = "Open Boxing Hub\nRankings, awards, legacy, growth, fight history, and career state."
	boxing_hud_button.z_index = 301

	_apply_runtime_hud_button_stack_layout(boxing_hud_button, 0)

	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(boxing_hud_button, "boxing_hud_button_style", 2, 18)
	if btn_style != null:
		var core:= Color(1.0, 0.56, 0.24, 1.0)
		btn_style.bg_color = Color(core.r, core.g, core.b, 0.24)
		btn_style.border_color = Color(core.r, core.g, core.b, 0.92)
		boxing_hud_button.add_theme_stylebox_override("normal", btn_style)
		boxing_hud_button.add_theme_stylebox_override("hover", btn_style)
		boxing_hud_button.add_theme_stylebox_override("pressed", btn_style)

	boxing_hud_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	_sync_runtime_floating_hud_layering()
func _ensure_boxing_hud() -> void:
	if boxing_hud_button != null and is_instance_valid(boxing_hud_button):
		return

	var ui_root:= self as Control
	if ui_root == null:
		return

	boxing_hud_button = Button.new()
	boxing_hud_button.visible = false
	boxing_hud_button.z_index = 301
	boxing_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP
	boxing_hud_button.text = "🥊"
	boxing_hud_button.tooltip_text = "Open Boxing Hub"
	boxing_hud_button.focus_mode = Control.FOCUS_NONE
	boxing_hud_button.add_theme_font_size_override("font_size", 28)
	_apply_runtime_hud_button_stack_layout(boxing_hud_button, 0)
	boxing_hud_button.pressed.connect(_on_boxing_hud_pressed)
	ui_root.add_child(boxing_hud_button)


func _player_has_boxing_hub_access() -> bool:
	if gs == null or gs.player == null:
		return false
	if gs.era_engine == null or not gs.era_engine.supports_world_title_boxing():
		return false

	if _runtime_controlled_perspective_truth_bool_for_current_actor([
		"boxing",
		"boxing_available",
		"boxing_hub",
		"boxing_hub_available"
	]):
		return true

	var actor: Person = gs.player
	if typeof(actor.boxing_profile) == TYPE_DICTIONARY:
		var profile: Dictionary = actor.boxing_profile

		if bool(profile.get("boxing_hub_unlocked", false)):
			return true
		if bool(profile.get("boxing_career_started_by_player", false)):
			return true
		if bool(profile.get("is_boxer", false)):
			return true
		if bool(profile.get("retired", false)):
			return true
		if bool(profile.get("turned_pro", false)):
			return true

		var amateur_circuit: Dictionary = MainSceneHelpers._safe_dictionary(profile.get("amateur_circuit", {}))
		if bool(amateur_circuit.get("is_amateur", false)):
			return true

	if gs.boxing_contract_engine != null and gs.boxing_contract_engine.has_method("actor_has_boxing_hub_access"):
		return bool(gs.boxing_contract_engine.actor_has_boxing_hub_access(actor))

	return false
func _update_boxing_hud() -> void:
	_ensure_boxing_hud()
	if boxing_hud_button == null or not is_instance_valid(boxing_hud_button):
		return

	var has_access: bool = _player_has_boxing_hub_access()

	if has_access and gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var snapshot: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("runtime_hud_visibility_snapshot", {}))
		snapshot ["boxing_available"] = true
		snapshot ["boxing_button_visible"] = true
		snapshot ["controlled_actor_id"] = int(gs.player.id) if gs.player != null else int(snapshot.get("controlled_actor_id", -1))
		snapshot ["updated_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["runtime_hud_visibility_snapshot"] = snapshot
		gs.scenario_state ["runtime_hud_visibility_snapshot_reason"] = "boxing_hud_live_access"
		gs.scenario_state ["runtime_hud_visibility_snapshot_at_ms"] = int(Time.get_ticks_msec())

	var has_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or world_feed_popup_open
		or boxing_hub_open
		or (profile_panel_popup != null and profile_panel_popup.visible)
		or (belongings_item_popup != null and belongings_item_popup.visible)
		or (belongings_item_target_popup != null and belongings_item_target_popup.visible)
		or crown_hub_open
		or superpower_hub_open
		or power_hub_open
		or (crown_action_popup != null and crown_action_popup.visible)
	)

	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(get_meta("age_up_transition_busy", false))
	)

	var surface_allows_runtime_buttons: bool = _runtime_floating_hud_buttons_should_render_on_current_surface()

	var can_show: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not has_modal_blocker
		and not blocked_by_age_up_loading
		and surface_allows_runtime_buttons
		and has_access
	)

	boxing_hud_button.visible = can_show
	boxing_hud_button.disabled = not can_show
	boxing_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP if can_show else Control.MOUSE_FILTER_IGNORE

	if not can_show:
		_sync_runtime_floating_hud_layering()
		return

	_apply_runtime_hud_button_stack_layout(boxing_hud_button, 0)
	_sync_runtime_floating_hud_layering()

	var pulse:= (sin(boxing_hud_breathe_time * 2.7) + 1.0) * 0.5
	var core:= Color(1.0, 0.56, 0.24, 1.0)
	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(boxing_hud_button, "boxing_hud_button_style", 2, 18)
	if btn_style == null:
		return

	boxing_hud_button.add_theme_stylebox_override("normal", btn_style)
	boxing_hud_button.add_theme_stylebox_override("hover", btn_style)
	boxing_hud_button.add_theme_stylebox_override("pressed", btn_style)

	btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.14))
	btn_style.border_color = Color(core.r, core.g, core.b, 0.84 + (pulse * 0.14))

	boxing_hud_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	boxing_hud_button.text = "🥊"
	boxing_hud_button.tooltip_text = "Open Boxing Hub\nRankings, awards, legacy, growth, fight history, and career state."

func _animate_boxing_hud(delta: float) -> void:
	boxing_hud_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("boxing_hud_next_light_refresh_ms", 0))
	if now_ms >= next_refresh_ms:
		set_meta("boxing_hud_next_light_refresh_ms", now_ms + 900)
		_update_boxing_hud()


func _on_boxing_hud_pressed() -> void:
	if not _player_has_boxing_hub_access():
		return

	var clean_tab: String = str(boxing_hub_selected_tab).strip_edges()
	if clean_tab == "":
		clean_tab = "fight"

	_begin_runtime_interaction_quiet_window("boxing_hud_pressed", 900)
	set_meta("boxing_hud_next_light_refresh_ms", int(Time.get_ticks_msec()) + 1200)

	_show_boxing_hub_panel(clean_tab)
