func _on_power_hub_entry_action_pressed(action: Dictionary) -> void:
	if gs == null or gs.player == null:
		return

	var engine_property: String = str(action.get("engine_property", "power_engine")).strip_edges()
	var method_name: String = str(action.get("method", "resolve_power_action")).strip_edges()
	var payload: Dictionary = _superpower_hub_safe_dictionary(action.get("payload", {}))

	if payload.is_empty():
		payload ["action"] = str(action.get("id", ""))

	if _runtime_boot_maybe_buffer_ui_action(action, payload, "powers", engine_property, method_name, "power_hub"):
		return

	if _superpower_hub_action_requires_detail_panel(action):
		_open_power_use_action_panel(action, "power_hub")
		return

	var result: Dictionary = {}
	var engine = gs.get(engine_property)
	if engine != null and engine.has_method(method_name):
		result = _superpower_hub_safe_dictionary(engine.call(method_name, gs.player, payload))
	else:
		result = {
			"success": false,
			"reason": "Power Hub action unavailable.",
			"engine_property": engine_property,
			"method": method_name
		}

	if bool(action.get("refresh_after", false)) or bool(result.get("success", false)):
		_render_power_hub_overlay()

	_maybe_show_action_result_popup(result)

func _on_superpower_hub_action_pressed(action_id: String) -> void:
	if gs == null or gs.player == null:
		return

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "power_action",
			"surface_id": "superpower_hub",
			"action_id": action_id,
			"legacy_callback": "_on_superpower_hub_action_pressed",
			"legacy_args": [
				action_id
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_superpower_hub_action_pressed"
			},
			"source": "mainscene.superpower_hub_action"
		}, {
			"source": "mainscene.superpower_hub_action",
			"surface_id": "superpower_hub",
			"action_id": action_id,
			"legacy_callback": "_on_superpower_hub_action_pressed",
			"legacy_args": [
				action_id
			]
		})
		return

	var clean_action: String = str(action_id).strip_edges().to_lower()
	var result: Dictionary = {}

	if clean_action == "refresh_mutations":
		var refresh_payload: Dictionary = {
			"action": "sync_mutations",
			"source": "superpower_hub_overlay"
		}
		var refresh_action: Dictionary = {
			"id": clean_action,
			"engine_property": "power_engine",
			"method": "resolve_power_action",
			"payload": refresh_payload.duplicate(true)
		}

		if _runtime_boot_maybe_buffer_ui_action(refresh_action, refresh_payload, "powers", "power_engine", "resolve_power_action", "superpower_hub_overlay"):
			return

		if gs.power_engine != null and gs.power_engine.has_method("resolve_power_action"):
			result = gs.power_engine.resolve_power_action(gs.player, refresh_payload)
		else:
			result = {
				"success": false,
				"reason": "PowerEngine unavailable."
			}
	else:
		var superhero_payload: Dictionary = {
			"action": action_id,
			"source": "superpower_hub_overlay"
		}
		var superhero_action: Dictionary = {
			"id": clean_action,
			"engine_property": "superhero_engine",
			"method": "resolve_hub_action",
			"payload": superhero_payload.duplicate(true)
		}

		if _runtime_boot_maybe_buffer_ui_action(superhero_action, superhero_payload, "superhero", "superhero_engine", "resolve_hub_action", "superpower_hub_overlay"):
			return

		if gs.superhero_engine == null:
			return
		if not gs.superhero_engine.has_method("resolve_hub_action"):
			return

		result = gs.superhero_engine.resolve_hub_action(gs.player, superhero_payload)

	if bool(result.get("success", false)):
		_render_superpower_hub_overlay()

	_maybe_show_action_result_popup(result)
