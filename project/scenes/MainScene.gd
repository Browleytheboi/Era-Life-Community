	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var existing_snapshot: Dictionary = {}

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		existing_snapshot = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		).duplicate(
			true
		)

	var canonical_truth: Dictionary = (
		_runtime_hud_truth_for_current_perspective(
			reason
		)
	)
	var actor_id: int = int(
		canonical_truth.get(
			"actor_id",
			-1
		)
	)
	var snapshot: Dictionary = (
		existing_snapshot
		if (
			actor_id > 0
			and int(
				existing_snapshot.get(
					"controlled_actor_id",
					existing_snapshot.get(
						"player_id",
