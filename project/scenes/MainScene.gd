	)
	resolved_payload ["section_id"] = str(
		resolved_payload.get(
			"section_id",
			career_hub_active_section_id
		)
	)
	resolved_payload ["lane"] = str(
		resolved_payload.get(
			"lane",
			career_hub_active_lane
		)
	)
	resolved_payload ["source"] = str(
		resolved_payload.get(
			"source",
			"mainscene.career_hub"
		)
	)
	resolved_payload [
		"ui_is_expression_only"
	] = true

	var action_id: String = str(
		resolved_payload.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()
	var projection_only_actions: Array = [
		"",
		"refresh",
		"open_hub",
		"set_section",
		"set_career_lane",
		"browse_lane",
		"select_career_path",
		"preview_career_path",
		"set_coworker_shard"
	]




	if action_id in projection_only_actions:
		var projection_sequence: int = int(
