func _relationship_profile_life_diary_lines_for_shell(
		actor: Person,
		switch_text: String = ""
) -> Array:
	if actor == null:
		return []

	var actor_id: int = int(actor.id)
	var contract_lines: Array = []

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		var packet_store_raw: Variant = gs.scenario_state.get(
			"profile_pointer_packet_by_actor",
			{}
		)

		if typeof(packet_store_raw) == TYPE_DICTIONARY:
			var packet_raw: Variant = (
				(packet_store_raw as Dictionary).get(
					str(actor_id),
					{}
				)
			)

			if typeof(packet_raw) == TYPE_DICTIONARY:
				var packet: Dictionary = packet_raw as Dictionary
				var packet_lines_raw: Variant = packet.get(
					"life_diary_lines",
					[]
				)

				if typeof(packet_lines_raw) == TYPE_ARRAY:
					contract_lines = (
						packet_lines_raw as Array
					).duplicate(true)

				if contract_lines.is_empty():
					var diary_packet_raw: Variant = packet.get(
						"life_diary_packet",
						{}
					)

					if typeof(diary_packet_raw) == TYPE_DICTIONARY:
						var lines_raw: Variant = (
							(diary_packet_raw as Dictionary).get(
								"lines",
								[]
							)
						)

						if typeof(lines_raw) == TYPE_ARRAY:
							contract_lines = (
								lines_raw as Array
							).duplicate(true)

	if not contract_lines.is_empty():
		set_meta(
			MainSceneHelpers._life_diary_actor_flat_cache_key(actor_id),
			contract_lines.duplicate(true)
		)
		return contract_lines

	var flat_cached_raw: Variant = get_meta(
		MainSceneHelpers._life_diary_actor_flat_cache_key(actor_id),
		[]
	)

	if (
		typeof(flat_cached_raw) == TYPE_ARRAY
		and not (flat_cached_raw as Array).is_empty()
	):
		return (flat_cached_raw as Array).duplicate(true)

	var actor_name: String = (
		MainSceneHelpers._person_display_name_for_identity_switch(actor)
	)
	var world_year: int = (
		int(gs.year)
		if gs != null
		else 0
	)
	var year_label: String = _format_year(world_year)
	var intro_text: String = str(
		switch_text
	).strip_edges()

	if (
		intro_text == ""
		or intro_text.begins_with(
			"I started living as "
		)
	):
		intro_text = "My name is %s." % actor_name

	return [
		"Year: %s" % year_label,
		"Age: %d" % maxi(
			0,
			int(actor.age)
		),
		intro_text,
		"This life was already in motion before I took control."
	]

func _relationship_profile_press_frame_lens_text_for_lines(
	life_lines: Array,
	switch_text: String = ""
) -> String:
	var out: String = ""
	var max_lines: int = mini(
		life_lines.size(),
		18
	)

	for i in range(max_lines):
		var line: String = str(
			life_lines [i]
		).strip_edges()

		if line == "":
			continue



		if _should_center_life_diary_line(
			line
		):
			out += (
				_format_life_diary_header_line_bbcode(
					line
				)
			)
		else:
			out += line

		if not out.ends_with("\n"):
			out += "\n"



	if out == "":
		var clean_switch_text: String = str(
			switch_text
		).strip_edges()

		if clean_switch_text != "":
			out = clean_switch_text

			if not out.ends_with("\n"):
				out += "\n"

	return out
