			"source": "life_diary",
			"memory_type": "diary_memory",
			"perspective": "first_person",
			"year": gs.year,
			"age": gs.player.age
		})

	_invalidate_life_diary_contract_render_cache("append_text_to_diary")
func _append_player_action_diary_lines(lines: Array, reason: String = "player_action") -> void:
	if gs == null or gs.player == null:
		return

	var clean_lines: Array = []
	var seen_lines: Dictionary = {}

	for raw_line in lines:
		var clean_text: String = _force_player_diary_first_person(str(raw_line))
		if clean_text == "":
			continue
		if _should_skip_player_diary_line(clean_text):
			continue
		if seen_lines.has(clean_text):
			continue
		seen_lines [clean_text] = true
		clean_lines.append(clean_text)

	if clean_lines.is_empty():
		return

	_append_diary_entry(clean_lines)
	_invalidate_life_diary_contract_render_cache(reason)

	if current_panel == "life":
		_render_life_diary_panel()
		if has_method("_request_life_diary_focus_latest_year"):
			_request_life_diary_focus_latest_year(reason)


func _record_player_action_report_in_life_diary(report: Dictionary, fallback_text: String = "", reason: String = "player_action_report") -> void:
	if typeof(report) != TYPE_DICTIONARY or report.is_empty():
		if fallback_text.strip_edges() != "":
			_append_player_action_diary_lines([fallback_text], reason)
		return

	var lines: Array = []
	var journal_lines_raw: Variant = report.get("journal_lines", [])
	if typeof(journal_lines_raw) == TYPE_ARRAY:
		for raw_line in journal_lines_raw:
			var journal_line: String = str(raw_line).strip_edges()
			if journal_line != "":
				lines.append(journal_line)

	var journal_text: String = str(report.get("journal_text", report.get("life_diary_text", report.get("diary_text", "")))).strip_edges()
	if journal_text != "":
		lines.append(journal_text)

	if lines.is_empty():
		var player_text: String = str(report.get("player_text", "")).strip_edges()
		if player_text != "":
			lines.append(player_text)

	if lines.is_empty() and fallback_text.strip_edges() != "":
		lines.append(fallback_text.strip_edges())

	if lines.is_empty():
		var status_text: String = str(report.get("status_text", "")).strip_edges()
		if status_text != "":
			lines.append(status_text)

	_append_player_action_diary_lines(lines, reason)


func _reset_diary_delta_cursors() -> void:
	if gs == null:
		return
	diary_world_feed_cursor = gs.world_feed.size()
	var player_memory_id: int = int(gs.player.id) if gs.player != null else -1
	var global_memories: Array = gs.memory_engine.get_memories(player_memory_id) if gs.memory_engine != null and player_memory_id != -1 else []
	diary_global_memory_cursor = global_memories.size()
	diary_player_memory_cursor = gs.player.memories.size() if gs.player != null and gs.player.memories != null else 0
	_save_active_life_diary_state()


func _capture_player_diary_snapshot() -> Dictionary:
	var snapshot:= {
		"world_feed_cursor": 0,
		"global_memory_cursor": 0,
		"player_memory_cursor": 0
	}
	if gs == null:
		return snapshot
	if gs.player != null:
		_ensure_active_life_diary_loaded(false)
	snapshot ["world_feed_cursor"] = diary_world_feed_cursor if gs.player != null else gs.world_feed.size()
	var player_memory_id: int = int(gs.player.id) if gs.player != null else -1
	var global_memories: Array = gs.memory_engine.get_memories(player_memory_id) if gs.memory_engine != null and player_memory_id != -1 else []
	snapshot ["global_memory_cursor"] = diary_global_memory_cursor if gs.player != null else global_memories.size()
	snapshot ["player_memory_cursor"] = diary_player_memory_cursor if gs.player != null else 0
	return snapshot


func _append_unique_diary_line(lines: Array, seen_lines: Dictionary, text: String) -> void:
	var clean_text: String = _force_player_diary_first_person(text)
	if clean_text == "":
		return
	if _should_skip_player_diary_line(clean_text):
		return
	if seen_lines.has(clean_text):
		return
	seen_lines [clean_text] = true
	lines.append(clean_text)

func _should_skip_player_diary_line(text: String) -> bool:
	var clean_text: String = MainSceneHelpers._compact_diary_text(text)
	if clean_text == "":
		return true
	if gs == null or gs.player == null:
		return false

	var lower_text:= clean_text.to_lower()
	var first_name:= gs.player.first_name.to_lower()
	var full_name:= ("%s %s" % [gs.player.first_name, gs.player.last_name]).strip_edges().to_lower()

	if int(gs.player.age) > 0 and MainSceneHelpers._custom_household_is_birth_leak_diary_line(clean_text):
		return true

	if lower_text.begins_with("i am working as "):
		return true
	if lower_text.begins_with("i am currently unemployed"):
		return true

	if lower_text.begins_with("you made it to age ") or lower_text.begins_with("i made it to age "):
		return true

	if lower_text.find("found a cool rock") != -1:
		return true

	if lower_text == "i practiced my avatar bending.":
		return true
	if lower_text == "you practiced your avatar bending.":
		return true
	if lower_text == "i practiced my bending.":
		return true
	if lower_text == "you practiced your bending.":
		return true

	if lower_text == "a neighboring tribe raided your village.":
		return true
	if lower_text == "a neighboring tribe raided my village.":
		return true

	if lower_text == "a local ruler demanded new taxes.":
		return true
	if lower_text == "a local ruler demanded new taxes from me.":
		return true

	if lower_text.find("discovered impossible cosmic relics") != -1 and lower_text.find(first_name) != -1:
		return true
	if lower_text.find("made a mythic red bonnet wish") != -1 and lower_text.find(first_name) != -1:
		return true

	if (
		clean_text.begins_with("Mind Stone | ")
		or clean_text.begins_with("Reality Stone | ")
		or clean_text.begins_with("Space Stone | ")
		or clean_text.begins_with("Time Stone | ")
		or clean_text.begins_with("Soul Stone | ")
		or clean_text.begins_with("Power Stone | ")
		or clean_text.begins_with("Infinity Gauntlet | ")
		or clean_text.begins_with("Red Bonnet | ")
	):
		return true

	if lower_text.begins_with(full_name + " ") or lower_text.begins_with(first_name + " "):
		if (
			lower_text.find(" invoked ") != -1
			or lower_text.find(" used the ") != -1
			or lower_text.find(" discovered ") != -1
			or lower_text.find(" made a mythic ") != -1
			or lower_text.find(" reshaped reality ") != -1
			or lower_text.find(" rewrote ") != -1
			or lower_text.find(" granted ") != -1
			or lower_text.find(" stripped ") != -1
			or lower_text.find(" cursed ") != -1
			or lower_text.find(" twisted reality ") != -1
		):
			return true

	return false
func _flush_player_diary_delta(snapshot: Dictionary, result_text: String = "", defer_result_until_after_feed: bool = false) -> void:
	if gs == null or gs.player == null:
		return
	_ensure_active_life_diary_loaded(false)

	var lines:= []
	var seen_lines: Dictionary = {}
	var display_year_value: int = gs.year
	var display_age_value: int = gs.player.age
	lines.append("Year: %s" % _format_year(display_year_value))
	lines.append("Age: %d" % display_age_value)

	for msg in gs.pending_death_messages:
		var pending_text:= str(msg)
		if _should_skip_player_diary_line(pending_text):
			continue
		_append_unique_diary_line(lines, seen_lines, pending_text)
	gs.pending_death_messages.clear()

	if not defer_result_until_after_feed and not _should_skip_player_diary_line(result_text):
		_append_unique_diary_line(lines, seen_lines, result_text)

	var player_memory_id: int = int(gs.player.id)
	var global_memories: Array = gs.memory_engine.get_memories(player_memory_id) if gs.memory_engine != null else []
	var global_start: int = int(snapshot.get("global_memory_cursor", diary_global_memory_cursor))
	global_start = int(clamp(global_start, 0, global_memories.size()))
	for i in range(global_start, global_memories.size()):
		var global_text:= str(global_memories [i])
		if _should_skip_player_diary_line(global_text):
			continue
		_append_unique_diary_line(lines, seen_lines, global_text)

	var player_memories: Array = gs.player.memories if gs.player.memories != null else []
	var player_start: int = int(snapshot.get("player_memory_cursor", diary_player_memory_cursor))
	player_start = int(clamp(player_start, 0, player_memories.size()))
	for i in range(player_start, player_memories.size()):
		var player_text:= str(player_memories [i])
		if _should_skip_player_diary_line(player_text):
			continue
		_append_unique_diary_line(lines, seen_lines, player_text)

	var world_start: int = int(snapshot.get("world_feed_cursor", diary_world_feed_cursor))
	world_start = int(clamp(world_start, 0, gs.world_feed.size()))
	for i in range(world_start, gs.world_feed.size()):
		var entry:= gs.normalize_world_feed_entry(gs.world_feed [i])
		var diary_line:= _diary_line_from_world_feed_entry(entry).strip_edges()
		if _should_skip_player_diary_line(diary_line):
			continue
		_append_unique_diary_line(lines, seen_lines, diary_line)

	if defer_result_until_after_feed and not _should_skip_player_diary_line(result_text):
		_append_unique_diary_line(lines, seen_lines, result_text)

	if lines.size() <= 2:
		_append_unique_diary_line(lines, seen_lines, "This year passed quietly, but time still moved forward.")

	_append_diary_entry(lines)
	diary_world_feed_cursor = gs.world_feed.size()
	diary_global_memory_cursor = global_memories.size()
	diary_player_memory_cursor = player_memories.size()
	_save_active_life_diary_state()

func _checkpoint_resume_diary_line_is_birth_intro(
	line_text: String
) -> bool:
	var clean_line: String = str(
		line_text
	).strip_edges()
	var lower_line: String = (
		clean_line.to_lower()
	)

	if lower_line == "":
		return false



	if (
		lower_line.begins_with("year:")
		or lower_line.begins_with("age:")
	):
		return false





	if MainSceneHelpers._custom_household_is_birth_leak_diary_line(
		clean_line
	):
		return true




	return (
		lower_line.begins_with(
			"my name is "
		)
		or lower_line.begins_with(
			"i was born a "
		)
		or lower_line.begins_with(
			"i was born in "
		)
		or lower_line.begins_with(
			"i was born with "
		)
		or lower_line.begins_with(
			"i was reincarnated as "
		)
		or lower_line.begins_with(
			"i was conceived "
		)
		or lower_line.begins_with(
			"i was blessed to be born with "
		)
		or lower_line.begins_with(
			"my soul was chosen to become the next avatar"
		)
		or lower_line.begins_with(
			"my birthday is "
		)
		or lower_line.begins_with(
			"my father is "
		)
		or lower_line.begins_with(
			"my mother is "
		)
		or lower_line.contains(
			"you are being born"
		)
		or lower_line.contains(
			"being born into "
		)
		or lower_line.contains(
			"birth contract"
		)
		or lower_line.contains(
			"birth class"
		)
	)


func _render_life_diary_panel() -> void:
	if gs == null or gs.player == null:
		return

	if output_label == null:
		return

	if _render_checkpoint_resume_life_diary_packet_only():
		return

	var actor_age: int = int(
		gs.player.age
	)
	var checkpoint_resume_active: bool = bool(
		get_meta(
			"checkpoint_resume_life_diary_active",
			false
		)
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		checkpoint_resume_active = (
			checkpoint_resume_active
			or bool(
				gs.scenario_state.get(
					"checkpoint_resume_not_birth",
					false
				)
			)
		)

	if checkpoint_resume_active:
		var checkpoint_actor_id: int = int(
			get_meta(
				"checkpoint_resume_life_diary_actor_id",
				-1
			)
		)

		if (
			checkpoint_actor_id > 0
			and checkpoint_actor_id != int(
				gs.player.id
			)
		):
			checkpoint_resume_active = false

	var birth_intro_allowed: bool = (
		actor_age == 0
		and not checkpoint_resume_active
	)

	if birth_intro_allowed:
		_ensure_spawn_ready_birth_intro_entry(
			"life_diary_tab"
		)
	else:
		set_meta(
			"checkpoint_resume_birth_intro_forbidden",
			checkpoint_resume_active
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"checkpoint_resume_not_birth"
			] = checkpoint_resume_active
			gs.scenario_state [
				"birth_shell_intro_required"
			] = false
			gs.scenario_state [
				"birth_intro_cry_allowed"
			] = false

		if (
			checkpoint_resume_active
			and age_up_diary_entries.is_empty()
		):
			var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
				gs.scenario_state.get(
					"checkpoint_resume_contract",
					{}
				)
			)
			var entries_raw: Variant = resume_contract.get(
				"life_diary_entries",
				[]
			)

			if typeof(entries_raw) == TYPE_ARRAY:
				age_up_diary_entries = (
					entries_raw as Array
				).duplicate(true)

	var diary_signature: String = (
		_life_diary_render_signature()
	)

	if str(
		output_label.get_meta(
			"life_diary_render_signature",
			""
		)
	) == diary_signature:
		output_label.mouse_filter = (
			Control.MOUSE_FILTER_PASS
		)
		output_label.scroll_active = true
		output_label.bbcode_enabled = true
		_install_life_diary_touchpad_scroll_contract(
			"render_life_diary_panel_cached"
		)
		return

	var cached_lines_raw: Variant = get_meta(
		"life_diary_render_cached_lines",
		[]
	)
	var lines: Array = []

	if (
		typeof(cached_lines_raw) == TYPE_ARRAY
		and str(
			get_meta(
				"life_diary_render_cached_signature",
				""
			)
		) == diary_signature
	):
		lines = (
			cached_lines_raw as Array
		).duplicate(true)
	elif checkpoint_resume_active:
		lines = _flatten_life_diary_lines()

		if lines.is_empty():
			var latest_raw: Variant = get_meta(
				"checkpoint_resume_latest_diary_lines",
				[]
			)

			if typeof(latest_raw) == TYPE_ARRAY:
				lines = (
					latest_raw as Array
				).duplicate(true)

		if lines.is_empty():
			var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
				gs.scenario_state.get(
					"checkpoint_resume_contract",
					{}
				)
			)
			var latest_resume_raw: Variant = (
				resume_contract.get(
					"latest_life_diary_lines",
					[]
				)
			)

			if typeof(latest_resume_raw) == TYPE_ARRAY:
				lines = (
					latest_resume_raw as Array
				).duplicate(true)

		var filtered_lines: Array = []

		for raw_line in lines:
			var line_text: String = str(
				raw_line
			)

			if (
				actor_age > 0
				and _checkpoint_resume_diary_line_is_birth_intro(
					line_text
				)
			):
				continue

			filtered_lines.append(raw_line)

		lines = filtered_lines

		if lines.is_empty():
			lines = [
				"Year: %s" % _format_year(gs.year),
				"Age: %d" % actor_age,
				(
					"I stepped back into this life with my story "
					+ "already in motion."
				)
			]

		set_meta(
			"checkpoint_resume_diary_render_used_saved_truth",
			true
		)
		set_meta(
			"checkpoint_resume_diary_birth_entry_generated",
			false
		)
		set_meta(
			"checkpoint_resume_diary_renderer_called_system",
			false
		)
		set_meta(
			"life_diary_render_cached_lines",
			lines.duplicate(true)
		)
		set_meta(
			"life_diary_render_cached_signature",
			diary_signature
		)
	else:
		_ensure_active_life_diary_loaded(false)
		_rebuild_loaded_life_diary_snapshot_if_needed()
		lines = _flatten_life_diary_lines()

		if lines.is_empty() and birth_intro_allowed:
			lines = _ensure_spawn_ready_birth_intro_entry(
				"life_diary_tab_empty_cache"
			)

		if lines.is_empty():
			lines = [
				"Year: %s" % _format_year(gs.year),
				"Age: %d" % actor_age,
				"My life is already in motion."
			]

		set_meta(
			"life_diary_render_cached_lines",
			lines.duplicate(true)
		)
		set_meta(
			"life_diary_render_cached_signature",
			diary_signature
		)

	output_label.set_meta(
		"life_diary_render_signature",
		diary_signature
	)
	output_label.mouse_filter = Control.MOUSE_FILTER_PASS
	output_label.scroll_active = true
	output_label.bbcode_enabled = true

	_install_life_diary_touchpad_scroll_contract(
		"render_life_diary_panel"
	)
	_ui_block(lines)

func _prepare_life_diary_render_cache(expected_signature: String = "") -> void:
	if gs == null or gs.player == null:
		return
	_ensure_active_life_diary_loaded(false)
	_rebuild_loaded_life_diary_snapshot_if_needed()
	var diary_signature: String = _life_diary_render_signature()
	if expected_signature != "" and expected_signature != diary_signature:
		return
	var lines: Array = _flatten_life_diary_lines()
	set_meta("life_diary_render_cached_lines", lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", diary_signature)
	if output_label != null and str(output_label.get_meta("life_diary_render_signature", "")) == diary_signature:
		output_label.scroll_active = true
		output_label.bbcode_enabled = true
		_ui_block(lines)
func _life_diary_render_signature() -> String:
	if gs == null or gs.player == null:
		return "none"

	var entry_count: int = age_up_diary_entries.size()
	var last_entry_size: int = 0
	var last_entry_tail: String = ""

	if entry_count > 0:
		var last_entry_raw: Variant = age_up_diary_entries [entry_count - 1]
		if typeof(last_entry_raw) == TYPE_ARRAY:
			var last_entry: Array = last_entry_raw as Array
			last_entry_size = last_entry.size()
			if last_entry_size > 0:
				last_entry_tail = str(last_entry [last_entry_size - 1])

	return "%d:%d:%d:%d:%d:%d:%d:%s" % [
		int(gs.player.id),
		int(gs.year),
		int(gs.player.age),
		entry_count,
		last_entry_size,
		int(diary_world_feed_cursor),
		int(diary_player_memory_cursor),
		last_entry_tail
	]
func _collect_relationship_browser_targets() -> Array:
	var targets: Array = []
	var seen: Dictionary = {}
	var p:= gs.player
	if p == null:
		return targets

	var my_facts: Dictionary = gs.get_npc_facts_by_id(int(p.id))
	var valid_partner: Person = gs.get_valid_partner(p, true, true)

	for ggid in MainSceneLogic._collect_ancestor_generation_ids(gs, p, 3):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(ggid), "Great-Grandparents")
	for gid in MainSceneLogic._collect_ancestor_generation_ids(gs, p, 2):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(gid), "Grandparents")
	for pid in my_facts.get("parents", []):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(pid), "Parents")

	if valid_partner != null:
		var partner_section:= _relationship_label_for_target(valid_partner)
		if partner_section == "" or partner_section == "Stranger":
			partner_section = "Partner"
		MainSceneHelpers._append_relationship_browser_target(targets, seen, valid_partner, partner_section)

	for cid in my_facts.get("children", []):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(cid), "Children")
	for gcid in MainSceneLogic._collect_descendant_generation_ids(gs, p, 2):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(gcid), "Grandchildren")
	for ggcid in MainSceneLogic._collect_descendant_generation_ids(gs, p, 3):
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(ggcid), "Great-Grandchildren")
	for fid in p.friends:
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(fid), "Friends")
	for xid in p.ex_partners:
		MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, int(xid), "Exes")

	var family_ids: Array = gs.collect_family_ids_anywhere(int(p.id))

	for lineage_id in gs.controlled_lineage_ids:
		var controlled_id: int = int(lineage_id)
		if controlled_id > 0 and controlled_id not in family_ids:
			family_ids.append(controlled_id)

	if gs.family_control_engine != null:
		var last_controlled_id: int = int(gs.family_control_engine.last_player_id)
		if last_controlled_id > 0 and last_controlled_id not in family_ids:
			family_ids.append(last_controlled_id)

	for family_id in family_ids:
		var rid: int = int(family_id)
		if rid <= 0 or rid == int(p.id):
			continue
		var rel_person: Person = gs.get_or_reactivate_npc_by_id(rid)
		if rel_person == null:
			continue
		var descendant_section: String = MainSceneLogic._relationship_descendant_section_from_target_facts(gs, rel_person)
		if descendant_section != "":
			MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, descendant_section)
			continue

		var rel_label: String = _relationship_label_for_target(rel_person)
		match rel_label:
			"Father", "Mother":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Parents")
			"Brother", "Sister", "Brother-in-Law", "Sister-in-Law":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Siblings")
			"Son", "Daughter", "Child":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Children")
			"Maternal Grandfather", "Maternal Grandmother", "Paternal Grandfather", "Paternal Grandmother", "Grandfather-in-Law", "Grandmother-in-Law":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Grandparents")
			"Maternal Great Grandfather", "Maternal Great Grandmother", "Paternal Great Grandfather", "Paternal Great Grandmother", "Great Grandfather-in-Law", "Great Grandmother-in-Law":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Great-Grandparents")
			"Husband", "Wife", "Fiancé", "Fiancée", "Boyfriend", "Girlfriend", "Partner":
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, rel_label)
			_:
				MainSceneLogic._append_relationship_browser_target_split_dead_by_id(gs, targets, seen, rid, "Other")

	if gs.school_engine != null:
		gs.school_engine.sync_person_school_fields(p)

		var classmates: Array = gs.school_engine.get_classmates(p)
		for c in classmates:
			MainSceneHelpers._append_relationship_browser_target(targets, seen, c, "Classmates")

		var teachers: Array = gs.school_engine.get_teachers_for(p)
		for t in teachers:
			MainSceneHelpers._append_relationship_browser_target(targets, seen, t, "Teachers")

		var students: Array = gs.school_engine.get_students_for(p)
		for s in students:
			MainSceneHelpers._append_relationship_browser_target(targets, seen, s, "Students")

	for coworker_id in p.coworkers:
		MainSceneHelpers._append_relationship_browser_target(targets, seen, gs.get_or_reactivate_npc_by_id(int(coworker_id)), "Co-Workers")

	return targets


func _refresh_relationship_browser_list() -> void:
	_ensure_relationship_browser_panel()
	_clear_container_children(relationships_browser_list)

	var targets: Array = _collect_relationship_browser_targets()
	var grouped:= {}
	var section_order: Array = [
		"Great-Grandparents",
		"Grandparents",
		"Parents",
		"Boyfriend",
		"Girlfriend",
		"Fiancé",
		"Fiancée",
		"Husband",
		"Wife",
		"Partner",
		"Children",
		"Grandchildren",
		"Great-Grandchildren",
		"Friends",
		"Exes",
		"Siblings",
		"Classmates",
		"Teachers",
		"Students",
		"Co-Workers",
		"Dead Relationships",
		"Other"
	]

	for entry in targets:
		var section:= str(entry.get("section", "Other"))
		if not grouped.has(section):
			grouped [section] = []
		grouped [section].append(entry)

	for section in grouped.keys():
		if section not in section_order:
			section_order.append(section)

	for section in section_order:
		if not grouped.has(section):
			continue

		var section_label:= Label.new()
		section_label.text = section
		relationships_browser_list.add_child(section_label)

		for entry in grouped [section]:
			var npc: Person = entry.get("npc", null)
			if npc == null:
				continue

			var btn:= _make_relationship_browser_target_button(
				npc,
				int(entry.get("id", -1)),
				section
			)
			relationships_browser_list.add_child(btn)

	if relationships_browser_profile != null:
		relationships_browser_profile.clear()
		relationships_browser_profile.append_text("Click a person to open their profile.")

func _append_royal_court_lines(lines: Array, npc: Person) -> void:
	if npc == null:
		return
	var court_entry: Dictionary = MainSceneLogic._primary_royal_court_entry_for_npc(gs, npc)
	if court_entry.is_empty():
		return

	var faction_name: String = str(court_entry.get("faction_name", "Royal Court")).strip_edges()
	if faction_name == "":
		faction_name = "Royal Court"

	var role_label: String = MainSceneHelpers._royal_court_role_display(str(court_entry.get("role", "courtier")))
	var owner_name: String = ""
	var owner_id: int = int(court_entry.get("owner_id", -1))
	if gs != null and owner_id > 0:
		var court_owner: Person = gs.get_or_reactivate_npc_by_id(owner_id)
		if court_owner != null:
			owner_name = _relationship_display_name(court_owner)

	var joined_year: int = int(court_entry.get("joined_year", 0))

	lines.append("Royal Court: %s" % faction_name)
	lines.append("Court Role: %s" % role_label)
	if owner_name != "":
		lines.append("Court Owner: %s" % owner_name)
	if joined_year != 0:
		lines.append("Court Since: %s" % _format_year(joined_year))
func _relationship_profile_hunger_value(target: Person) -> float:
	if target == null:
		return 0.0

	var hunger_value: float = 0.0

	if target.get("hunger") != null:
		hunger_value = float(
			target.hunger
		)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var packet_cache: Dictionary = (
			_zero_frame_contract_dictionary(
				gs.scenario_state.get(
					"profile_pointer_packet_by_actor",
					{}
				)
			)
		)
		var pointer_packet: Dictionary = (
			_zero_frame_contract_dictionary(
				packet_cache.get(
					str(
						int(target.id)
					),
					{}
				)
			)
		)
		var lens_cache: Dictionary = (
			_zero_frame_contract_dictionary(
				pointer_packet.get(
					"press_frame_lens_cache",
					{}
				)
			)
		)
		var published_hunger_raw: Variant = (
			lens_cache.get(
				"hunger",
				null
			)
		)

		if typeof(published_hunger_raw) in [
			TYPE_INT,
			TYPE_FLOAT
		]:
			hunger_value = float(
				published_hunger_raw
			)

	return clamp(
		hunger_value,
		0.0,
		100.0
	)
func _relationship_profile_hunger_line(target: Person) -> String:
	var hunger_value: float = _relationship_profile_hunger_value(target)
	return "Hunger: %d%% - %s" % [
		int(round(hunger_value)),
		MainSceneHelpers._relationship_profile_hunger_descriptor(hunger_value)
	]
func _relationship_profile_body_truth_for_profile(target: Person) -> Dictionary:
	if target == null:
		return {
			"height_contract": {},
			"weight_contract": {},
			"body_type_contract": {}
		}

	var body_truth: Dictionary = {
		"height_contract": target.height_contract.duplicate(true) if typeof(target.height_contract) == TYPE_DICTIONARY else {},
		"weight_contract": target.weight_contract.duplicate(true) if typeof(target.weight_contract) == TYPE_DICTIONARY else {},
		"body_type_contract": target.body_type_contract.duplicate(true) if typeof(target.body_type_contract) == TYPE_DICTIONARY else {},
		"body_contract": target.body_contract.duplicate(true) if typeof(target.body_contract) == TYPE_DICTIONARY else {}
	}

	var height_contract: Dictionary = MainSceneLogic._relationship_profile_body_contract_from_sources(target, body_truth, "height_contract", "height", "height")
	var weight_contract: Dictionary = MainSceneLogic._relationship_profile_body_contract_from_sources(target, body_truth, "weight_contract", "weight", "weight")
	var body_type_contract: Dictionary = MainSceneLogic._relationship_profile_body_contract_from_sources(target, body_truth, "body_type_contract", "body_type", "body_type")

	var missing_height: bool = MainSceneHelpers._relationship_profile_height_text_from_contract(height_contract) == ""
	var missing_weight: bool = MainSceneHelpers._relationship_profile_weight_text_from_contract(weight_contract) == ""
	var missing_body_type: bool = body_type_contract.is_empty() or str(body_type_contract.get("display_name", "")).strip_edges() == ""

	if missing_height or missing_weight or missing_body_type:
		var display_snapshot: Dictionary = _relationship_profile_local_body_snapshot_for_missing_contracts(
			target,
			height_contract,
			weight_contract,
			body_type_contract
		)

		if missing_height:
			height_contract = MainSceneHelpers._safe_dictionary(display_snapshot.get("height_contract", height_contract))
		if missing_weight:
			weight_contract = MainSceneHelpers._safe_dictionary(display_snapshot.get("weight_contract", weight_contract))
		if missing_body_type:
			body_type_contract = MainSceneHelpers._safe_dictionary(display_snapshot.get("body_type_contract", body_type_contract))

	return {
		"height_contract": height_contract,
		"weight_contract": weight_contract,
		"body_type_contract": body_type_contract
	}
func _relationship_profile_local_body_snapshot_for_missing_contracts(target: Person, current_height: Dictionary = {}, current_weight: Dictionary = {}, current_body_type: Dictionary = {}) -> Dictionary:
	var now_ms: int = int(Time.get_ticks_msec())

	if target == null:
		return {
			"height_contract": current_height.duplicate(true),
			"weight_contract": current_weight.duplicate(true),
			"body_type_contract": current_body_type.duplicate(true)
		}

	var height_contract: Dictionary = current_height.duplicate(true)
	var weight_contract: Dictionary = current_weight.duplicate(true)
	var body_type_contract: Dictionary = current_body_type.duplicate(true)

	var body_type: String = str(body_type_contract.get("type", "")).strip_edges().to_lower()
	if body_type == "":
		body_type = MainSceneHelpers._relationship_profile_local_body_type_for_actor(target)
	if body_type not in ["ectomorph", "mesomorph", "endomorph"]:
		body_type = "mesomorph"

	if body_type_contract.is_empty() or str(body_type_contract.get("display_name", "")).strip_edges() == "":
		body_type_contract = {
			"schema": "eralife.person.body_type_contract.display_only",
			"version": 1,
			"actor_id": int(target.id),
			"type": body_type,
			"display_name": MainSceneHelpers._relationship_profile_local_body_type_display_name(body_type),
			"description": str(MainSceneHelpers._relationship_profile_local_body_type_traits(body_type).get("description", "")),
			"traits": MainSceneHelpers._relationship_profile_local_body_type_traits(body_type),
			"ui_surface": "relationship_profile_popup",
			"source": "relationship_profile_local_read_only_display",
			"created_at_ms": now_ms,
			"updated_at_ms": now_ms
		}

	var direct_height_in: float = MainSceneHelpers._relationship_profile_local_direct_number_from_person(target, [
		"height_in",
		"height_inches",
		"height"
	])

	var height_in: float = float(height_contract.get("height_in", height_contract.get("height_inches", 0.0)))
	if height_in <= 0.0 and direct_height_in > 0.0:
		height_in = direct_height_in
	if height_in <= 0.0:
		height_in = MainSceneLogic._relationship_profile_local_display_height_inches(target)

	var height_cm: float = height_in * 2.54

	if MainSceneHelpers._relationship_profile_height_text_from_contract(height_contract) == "":
		height_contract = {
			"schema": "eralife.person.height_contract.display_only",
			"version": 1,
			"actor_id": int(target.id),
			"height_in": height_in,
			"height_cm": height_cm,
			"display": MainSceneHelpers._relationship_profile_local_format_height_inches(height_in),
			"display_metric": "%.1f cm" % height_cm,
			"ui_surface": "relationship_profile_popup",
			"source": "relationship_profile_local_read_only_display",
			"created_at_ms": now_ms,
			"updated_at_ms": now_ms
		}

	var direct_weight_lbs: float = MainSceneHelpers._relationship_profile_local_direct_number_from_person(target, [
		"weight_lbs",
		"walkaround_weight_lbs",
		"weight"
	])

	var weight_lbs: float = float(weight_contract.get("weight_lbs", weight_contract.get("walkaround_weight_lbs", 0.0)))
	if weight_lbs <= 0.0 and direct_weight_lbs > 0.0:
		weight_lbs = direct_weight_lbs
	if weight_lbs <= 0.0:
		weight_lbs = MainSceneLogic._relationship_profile_local_display_weight_lbs(target, height_in, body_type)

	weight_lbs = clamp(weight_lbs, 5.0, 850.0)

	var weight_kg: float = weight_lbs * 0.45359237
	var bmi: float = (weight_lbs / max(12.0, height_in * height_in)) * 703.0
	var category: String = MainSceneHelpers._relationship_profile_local_weight_category_from_bmi(bmi)

	if MainSceneHelpers._relationship_profile_weight_text_from_contract(weight_contract) == "":
		weight_contract = {
			"schema": "eralife.person.weight_contract.display_only",
			"version": 1,
			"actor_id": int(target.id),
			"weight_lbs": weight_lbs,
			"weight_kg": weight_kg,
			"walkaround_weight_lbs": weight_lbs,
			"bmi": bmi,
			"category": category,
			"display": "%d lb" % int(round(weight_lbs)),
			"display_metric": "%.1f kg" % weight_kg,
			"ui_surface": "relationship_profile_popup",
			"source": "relationship_profile_local_read_only_display",
			"created_at_ms": now_ms,
			"updated_at_ms": now_ms
		}

	return {
		"height_contract": height_contract,
		"weight_contract": weight_contract,
		"body_type_contract": body_type_contract
	}
func _relationship_browser_profile_lines(target: Person) -> Array:
	var lines:= []

	if target == null:
		lines.append("No target selected.")
		return lines

	if gs != null and gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("sanitize_grocery_identity_for_relationship_profile"):
		gs.grocery_store_engine.sanitize_grocery_identity_for_relationship_profile(target, {
			"source": "relationship_browser_profile_lines"
		})

	var raw_property_count: int = MainSceneLogic._count_npc_properties(gs, target.id)
	var raw_vehicle_count: int = MainSceneLogic._count_npc_vehicles(gs, target.id)
	var relation_label:= _relationship_label_for_target(target)

	var _locked_grocery_job: String = MainSceneHelpers._relationship_profile_grocery_locked_job(target)
	var grocery_locked_non_royal: bool = MainSceneLogic._relationship_profile_target_is_grocery_locked_non_royal(target)
	var effective_job: String = MainSceneLogic._relationship_profile_effective_job_for(gs, target, grocery_locked_non_royal)

	var is_federal_civic_actor: bool = _person_uses_federal_republic_civic_title(target, int(target.realm_id))
	var government_title: String = _person_federal_republic_government_title(target, int(target.realm_id), false)
	var federal_social_surface: String = _person_federal_republic_government_title(target, int(target.realm_id), true)

	var effective_social_class: String = str(target.social_class)
	if is_federal_civic_actor and federal_social_surface != "":
		effective_social_class = federal_social_surface
	elif grocery_locked_non_royal:
		effective_social_class = str(target.social_class)
	elif bool(target.is_royal) or bool(target.is_ruler) or str(target.royal_title).strip_edges() != "":
		effective_social_class = "Royal"

	var effective_title: String = "" if grocery_locked_non_royal or is_federal_civic_actor else str(target.royal_title).strip_edges()

	if effective_title == "" and not is_federal_civic_actor and not grocery_locked_non_royal and gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title") and (bool(target.is_ruler) or bool(target.is_royal)):
		effective_title = gs.royalty_engine._resolve_rank_title(target, "ruler" if bool(target.is_ruler) else "lesser_royal")

	var effective_income: int = MainSceneLogic._relationship_profile_effective_income(target, effective_job, effective_social_class)
	var property_count: int = MainSceneHelpers._relationship_profile_effective_property_count(target, raw_property_count, effective_social_class)
	var vehicle_count: int = MainSceneHelpers._relationship_profile_effective_vehicle_count(target, raw_vehicle_count, effective_income, effective_social_class)
	var home: Dictionary = MainSceneLogic._relationship_profile_display_home(gs, target)

	var pregnant_text:= "No"
	if int(target.pregnancy_progress) >= 0 or bool(target.pregnancy_known):
		pregnant_text = "Yes"

	var show_approval: bool = MainSceneLogic._player_has_meaningful_approval(target)

	lines.append("===== PROFILE =====")
	lines.append("Relation To Me: %s" % relation_label)
	lines.append("Name: %s" % _relationship_display_name(target))
	lines.append("Age: %d" % target.age)
	lines.append("Gender: %s" % target.gender)

	var body_profile_truth: Dictionary = _relationship_profile_body_truth_for_profile(target)
	var height_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("height_contract", {}))
	var weight_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("weight_contract", {}))
	var body_type_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("body_type_contract", {}))

	var height_text: String = MainSceneHelpers._relationship_profile_height_text_from_contract(height_contract)
	if height_text == "":
		height_text = "Unknown"
	lines.append("Height: %s" % height_text)

	var weight_text: String = MainSceneHelpers._relationship_profile_weight_text_from_contract(weight_contract)
	if weight_text == "":
		weight_text = "Unknown"

	var weight_category: String = str(weight_contract.get("category", "")).strip_edges().capitalize()
	if weight_category != "":
		lines.append("Weight: %s • %s" % [weight_text, weight_category])
	else:
		lines.append("Weight: %s" % weight_text)

	if not body_type_contract.is_empty():
		lines.append("Body Type: %s" % str(body_type_contract.get("display_name", "Unknown")))

	lines.append("Job: %s" % effective_job)

	if gs != null and gs.economy_engine != null:
		lines.append("Income: %s" % gs.economy_engine.format_money(effective_income))
	else:
		lines.append("Income: $%d" % effective_income)

	lines.append("Assets: %d properties • %d vehicles" % [property_count, vehicle_count])
	lines.append("Social Class: %s" % effective_social_class)
	lines.append("Fame Tier: %s" % str(target.fame_tier))

	var bending_celebrity: Dictionary = {}
	if gs != null and gs.bending_engine != null and gs.bending_engine.has_method("get_bending_world_celebrity_profile"):
		bending_celebrity = gs.bending_engine.get_bending_world_celebrity_profile(target)

	if not bending_celebrity.is_empty() and bool(bending_celebrity.get("is_bending_world_celebrity", false)):
		lines.append("Bending Aura: %s" % str(bending_celebrity.get("aura_label", "World Champion aura")))
		lines.append("Bending Followers: %s" % str(bending_celebrity.get("follower_label", bending_celebrity.get("followers", 0))))
		lines.append("Duel Fear Modifier: %.2fx" % float(bending_celebrity.get("fear_modifier", 1.0)))

	if is_federal_civic_actor and government_title != "":
		lines.append("Government Title: %s" % government_title)
	elif not grocery_locked_non_royal and (target.is_royal or target.is_ruler or effective_title != ""):
		var succession_text:= "Current Ruler" if bool(target.is_ruler) or int(target.succession_rank) == 0 else "#%d" % int(target.succession_rank)
		lines.append("Royal Title: %s" % effective_title)
		lines.append("Succession: %s" % succession_text)
		_append_royal_court_lines(lines, target)

	if show_approval:
		lines.append("Approval: %d%%" % clamp(int(round(float(target.approval))), 0, 100))

	lines.append("Home: %s, %s" % [str(home.get("city", target.home_city)), str(home.get("country", target.home_country))])
	lines.append("School: %s" % (target.school_name if target.school_name != "" else "None"))

	if MainSceneHelpers._relationship_profile_should_show_pregnancy_line(target):
		lines.append("Pregnant: %s" % pregnant_text)

	if str(target.bending_type) != "" and str(target.bending_type) != "none":
		lines.append("Bending Type: %s" % str(target.bending_type).capitalize())
		lines.append("Bending Nation: %s" % str(target.bending_nation))
	else:
		lines.append("Bending Type: None")

	var target_power_lines: Array = _relationship_profile_power_lines(target)
	for power_line in target_power_lines:
		lines.append(str(power_line))

	lines.append("===================")
	return lines
func _relationship_profile_power_lines(target: Person) -> Array:
	var lines: Array = []
	if target == null:
		return lines
	if gs == null or gs.power_engine == null:
		return lines
	if not gs.power_engine.has_method("has_superpowers"):
		return lines
	if not gs.power_engine.has_superpowers(target):
		return lines

	var rating: int = 0
	if gs.power_engine.has_method("get_power_rating"):
		rating = int(gs.power_engine.get_power_rating(target))

	var state: Dictionary = {}
	if gs.power_engine.has_method("get_person_power_state"):
		state = _superpower_hub_safe_dictionary(gs.power_engine.get_person_power_state(target))

	lines.append("Super Power Level: %d" % rating)

	var powers: Dictionary = _superpower_hub_safe_dictionary(state.get("powers", {}))
	if not powers.is_empty():
		var names: Array = []
		for raw_power_id in powers.keys():
			var power_id: String = str(raw_power_id).strip_edges().to_lower()
			var row: Dictionary = _superpower_hub_safe_dictionary(powers.get(raw_power_id, {}))
			names.append(str(row.get("display_name", power_id.replace("_", " ").capitalize())))
		lines.append("Powers: %s" % ", ".join(names))

	var visibility_text: String = str(state.get("public_visibility", "unknown")).replace("_", " ").capitalize()
	lines.append("Power Visibility: %s" % visibility_text)

	return lines
