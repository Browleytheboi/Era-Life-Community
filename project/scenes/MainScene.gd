func _cache_switched_actor_asset_pack_from_packet(
	target: Person,
	viewer_packet: Dictionary
) -> bool:
	if (
		target == null
		or viewer_packet.is_empty()
	):
		return false

	var target_id: int = int(
		target.id
	)
	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"surface_contract",
			{}
		)
	)
	var pack: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"asset_surface_pack",
			surface.get(
				"asset_surface_pack",
				{}
			)
		)
	)

	if (
		pack.is_empty()
		or int(
			pack.get(
				"actor_id",
				-1
			)
		) != target_id
	):
		return false

	asset_surface_pack_by_actor [
		_asset_surface_pack_cache_key(
			target
		)
	] = pack.duplicate(false)

	set_meta(
		"switched_actor_asset_pack_cached_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_asset_pack_cached_without_panel_render",
		true
	)
	set_meta(
		"switched_actor_asset_pack_cached_at_ms",
		int(Time.get_ticks_msec())
	)

