			)
		)

		diary_player_memory_cursor = clampi(
			int(
				cursor_contract.get(
					"player_memory_cursor",
					target_memory_count
				)
			),
			0,
			target_memory_count
		)
	else:


		diary_world_feed_cursor = gs.world_feed.size()
		diary_global_memory_cursor = 0
		diary_player_memory_cursor = target_memory_count

	set_meta(
		"continue_lineage_diary_cursor_actor_id",
