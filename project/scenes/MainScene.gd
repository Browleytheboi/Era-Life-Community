	custom_bank_balance_spin.clear()
	var clamped_value:= int(clamp(selected_value, 0, 5000000))
	var selected_index:= 0
	var option_index:= 0
	for value in range(0, 5000001, 50000):
		custom_bank_balance_spin.add_item(_format_god_mode_bank_balance_value(value))
