func _start_background_hydration_timer(load_report: Dictionary = {}) -> void:
	var timer: Timer = _ensure_background_hydration_timer()
	if timer == null:
		return

	if world_actions_status_label != null:
		world_actions_status_label.text = "You are back in your life. The wider world is still hydrating."

	set_meta("background_hydration_started_ms", int(Time.get_ticks_msec()))
	set_meta("background_hydration_last_status_ms", 0)
	set_meta("background_hydration_last_queue_size", int(load_report.get("background_queue_size", 0)))

	_update_save_load_reality_build_panel({
		"title": "Reality Still Assembling",
		"body": "Your life, family, and UI are live. The world outside your immediate shell is streaming in the background.",
		"status": "Hydrating %d background slice%s..." % [
			int(load_report.get("background_queue_size", 0)),
			"" if int(load_report.get("background_queue_size", 0)) == 1 else "s"
		],
		"progress": 0.66,
		"interaction_state": "live",
		"execution_state": "streaming",
		"nonblocking": true
	})

	timer.start()

func _stop_background_hydration_timer() -> void:
	var timer:= get_node_or_null("BackgroundHydrationTimer") as Timer
	if timer != null:
		timer.stop()

func _ensure_background_hydration_timer() -> Timer:
	var hydration_callable: Callable = Callable(
		self,
		"_on_background_hydration_timer_timeout"
	)
	var existing:= get_node_or_null(
		"BackgroundHydrationTimer"
	) as Timer

	if existing != null:
		existing.one_shot = false
		existing.wait_time = 0.05
		existing.process_callback = Timer.TIMER_PROCESS_IDLE

		if not existing.timeout.is_connected(hydration_callable):
			existing.timeout.connect(hydration_callable)

		existing.set_meta(
			"background_hydration_ui_priority_aware",
			true
		)
		return existing

	var timer:= Timer.new()
	timer.name = "BackgroundHydrationTimer"
	timer.one_shot = false
	timer.wait_time = 0.05
	timer.process_callback = Timer.TIMER_PROCESS_IDLE
	timer.set_meta(
		"background_hydration_ui_priority_aware",
		true
	)
	timer.set_meta(
		"background_hydration_slice_limit",
		1
	)
	add_child(timer)

	if not timer.timeout.is_connected(hydration_callable):
		timer.timeout.connect(hydration_callable)

	return timer
func _on_background_hydration_timer_timeout() -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		gs == null
		or gs.game_state_hydration_runtime == null
	):
		_stop_background_hydration_timer()
		return

	if (
		typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
		and bool(
			gs.scenario_state.get(
				"menu_return_world_seed_terminated",
				false
			)
		)
	):
		_stop_background_hydration_timer()
		return

	if not gs.game_state_hydration_runtime.has_method(
		"run_background_hydration_slice"
	):
		_stop_background_hydration_timer()
		return




	var slice_report: Dictionary = (
		gs.game_state_hydration_runtime
		.run_background_hydration_slice(
			1
		)
	)

	if slice_report.is_empty():
		return

	set_meta(
		"background_hydration_main_scene_poll_only",
		true
	)
	set_meta(
		"background_hydration_renderer_thread_work",
		false
	)
	set_meta(
		"background_hydration_ui_interaction_pauses_simulation",
		false
	)

	var queue_remaining: int = int(
		slice_report.get(
			"queue_remaining",
			0
		)
	)
	var active: bool = bool(
		slice_report.get(
			"active",
			false
		)
	)
	var complete: bool = bool(
		slice_report.get(
			"complete",
			false
		)
	)
	var last_status_ms: int = int(
		get_meta(
			"background_hydration_last_status_ms",
			0
		)
	)
	var last_queue_size: int = max(
		1,
		int(
			get_meta(
				"background_hydration_last_queue_size",
				queue_remaining
			)
		)
	)
	var completed_estimate: int = max(
		0,
		last_queue_size - queue_remaining
	)
	var progress: float = 0.68

	if last_queue_size > 0:
		progress = clamp(
			0.68
			+ (
				float(
					completed_estimate
				)
				/ float(
					last_queue_size
				)
			) * 0.28,
			0.68,
			0.96
		)

	if (
		active
		and now_ms - last_status_ms >= 450
	):
		if world_actions_status_label != null:
			world_actions_status_label.text = (
				"Reality is playable. Hydrating %d background slice%s..."
				% [
					queue_remaining,
					(
						""
						if queue_remaining == 1
						else "s"
					)
				]
			)

		_update_save_load_reality_build_panel({
			"status": (
				"Hydrating %d background slice%s..."
				% [
					queue_remaining,
					(
						""
						if queue_remaining == 1
						else "s"
					)
				]
			),
			"progress": progress,
			"interaction_state": "live",
			"execution_state": "streaming",
			"nonblocking": true
		})

		set_meta(
			"background_hydration_last_status_ms",
			now_ms
		)

	if complete or not active:
		_stop_background_hydration_timer()
		_on_background_hydration_finished(
			slice_report
		)
func _on_background_hydration_finished(
	slice_report: Dictionary = {}
) -> void:
	if world_actions_status_label != null:
		world_actions_status_label.text = (
			"Reality fully hydrated."
		)



	set_meta(
		"background_hydration_completion_observed",
		true
	)
	set_meta(
		"background_hydration_completion_observed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"background_hydration_completion_renderer_thread_work",
		false
	)
	set_meta(
		"background_hydration_completion_simulation_report",
		slice_report.duplicate(false)
	)

	_update_save_load_reality_build_panel({
		"title": "Reality Reconstructed",
		"body": (
			"Your saved life, family shell, and wider world are fully live."
		),
		"status": "All background slices are complete.",
		"progress": 1.0,
		"interaction_state": "live",
		"execution_state": "complete"
	})

	call_deferred(
		"_hide_save_load_reality_build_panel",
		false
	)



	belongings_hud_content_dirty = true

	set_meta(
		"background_hydration_completion_hud_engine_refresh_forbidden",
		true
	)
	set_meta(
		"background_hydration_completion_diary_rebuild_forbidden",
		true
	)
	set_meta(
		"background_hydration_completion_player_stats_engine_refresh_forbidden",
		true
	)
