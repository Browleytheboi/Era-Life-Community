	var show_restaurant: bool = base_visible and _food_lifestyle_restaurant_hub_available()

	food_lifestyle_hud_button.visible = show_food
	food_lifestyle_hud_button.disabled = not show_food
	food_lifestyle_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP if show_food else Control.MOUSE_FILTER_IGNORE

	restaurant_lifestyle_hud_button.visible = show_restaurant
	restaurant_lifestyle_hud_button.disabled = not show_restaurant
	restaurant_lifestyle_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP if show_restaurant else Control.MOUSE_FILTER_IGNORE

	var pulse: float = (sin(food_lifestyle_hud_breathe_time * 2.1) + 1.0) * 0.5

	if show_food:
		_style_food_lifestyle_button(
			food_lifestyle_hud_button,
			"food_contract_hub",
			"🛒",
			"Open Food Hub\nGrocery stores, aisles, carts, cashier interactions, checkout, or shoplifting risk.",
			pulse
		)
	else:
		food_lifestyle_hud_button.text = "🛒"

	if show_restaurant:
		_style_food_lifestyle_button(
			restaurant_lifestyle_hud_button,
			"restaurant_contract_hub",
			"🍔",
			"Open Restaurant Hub\nGo alone, take a partner, find a date, dine in, take out, or drive-thru.",
			pulse
		)
	else:
		restaurant_lifestyle_hud_button.text = "🍔"

	_update_rick_weapon_shop_hud(false)
	_sync_runtime_floating_hud_layering()

func _animate_food_lifestyle_hud(
	delta: float
) -> void:
