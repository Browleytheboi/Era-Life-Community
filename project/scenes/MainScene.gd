func _ui_nav_button_display_label(
		key: String
) -> String:
	var incarceration_lens: Dictionary = (
		_controlled_actor_incarceration_lens_contract()
	)

	if bool(
		incarceration_lens.get(
			"active",
			false
		)
	):
		var incarceration_labels: Dictionary = MainSceneHelpers._safe_dictionary(
			incarceration_lens.get(
				"navigation_labels",
				{}
			)
		)
		var incarceration_label: String = str(
			incarceration_labels.get(
				key,
				""
			)
		).strip_edges()

		if incarceration_label != "":
			return incarceration_label

	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var labels: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_labels",
			{}
		)
	)
	var override_label: String = str(
		labels.get(
			key,
			""
		)
	).strip_edges()

	if override_label != "":
		return override_label

	match key:
		"world":
			return "WORLD "

		"life":
			return "LIFE "

		"school":
			return "SCHOOL "

		"activities":
			return "ACTIVITIES "

		"relationships":
			return "RELATIONSHIPS "

		"career":
			return "CAREER "

		"age_up":
			return "AGE UP"

		"mods":
			return "MODS"

		_:
			return key.to_upper()
func _controlled_actor_incarceration_lens_contract() -> Dictionary:
	if (
		gs == null
		or gs.player == null
	):
		return {}

	var actor_id: int = int(
		gs.player.id
	)
	var raw_lens: Variant = get_meta(
		"controlled_actor_incarceration_lens_contract",
		{}
	)
	var lens: Dictionary = (
		(raw_lens as Dictionary)
		if typeof(
			raw_lens
		) == TYPE_DICTIONARY
		else {}
	)

	if (
		not lens.is_empty()
		and int(
			lens.get(
				"actor_id",
				-1
			)
		) == actor_id
	):
		return lens.duplicate(false)





	var resident_deck_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var resident_deck: Dictionary = (
		(resident_deck_raw as Dictionary)
		if typeof(
			resident_deck_raw
		) == TYPE_DICTIONARY
		else {}
	)

	for surface_id in [
		"relationships",
		"school",
		"activities",
		"career"
	]:
		var surface: Dictionary = MainSceneHelpers._safe_dictionary(
			resident_deck.get(
				surface_id,
				{}
			)
		)
		var resident_lens: Dictionary = MainSceneHelpers._safe_dictionary(
			surface.get(
				"incarceration_lens",
				{}
			)
		)

		if (
			not resident_lens.is_empty()
			and int(
				resident_lens.get(
					"actor_id",
					-1
				)
			) == actor_id
			and bool(
				resident_lens.get(
					"active",
					false
				)
			)
		):
			return resident_lens.duplicate(false)

	return {}
func _ensure_god_mode_background_dim() -> void:
	if god_mode_background_dim != null:
		return
	god_mode_background_dim = ColorRect.new()
	god_mode_background_dim.name = "god_mode_background_dim"
	god_mode_background_dim.visible = false
	god_mode_background_dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var palette:= _current_god_mode_palette()
	var panel_base: Color = Color(palette.get("panel_base", Color(0.17, 0.1, 0.27, 0.95)))
	var darker_dim:= Color(
		clamp(panel_base.r * 0.38, 0.0, 1.0),
		clamp(panel_base.g * 0.38, 0.0, 1.0),
		clamp(panel_base.b * 0.38, 0.0, 1.0),
		clamp(max(panel_base.a, 0.9) + 0.03, 0.88, 0.97)
	)
	god_mode_background_dim.color = darker_dim
	god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_STOP
	god_mode_background_dim.z_index = 40
	add_child(god_mode_background_dim)


func _sync_god_mode_ui_lock_visuals() -> void:
	if _playable_life_surface_authority_lock_active():
		if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
			god_mode_background_dim.visible = false
			god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

		if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
			god_mode_start_panel.visible = false
			god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

		set_meta("god_mode_ui_lock_visual_sync_skipped_for_playable_life_authority", true)
		set_meta("god_mode_ui_lock_visual_sync_skipped_at_ms", int(Time.get_ticks_msec()))

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["god_mode_ui_lock_visual_sync_skipped_for_playable_life_authority"] = true
			gs.scenario_state ["god_mode_panel_may_hide_live_ui"] = false
			gs.scenario_state ["main_menu_surface_may_hide_live_ui"] = false
			gs.scenario_state ["playable_life_surface_has_visual_authority"] = true

		return

	if not _god_mode_runtime_allowed("_sync_god_mode_ui_lock_visuals", "sync_visuals"):
		return

	_ensure_god_mode_background_dim()

	if _main_menu_surface_active():
		if _ui_authority_should_block_hide_attempt(
			"_sync_god_mode_ui_lock_visuals",
			"set_main_menu_surface_isolated_true",
			"sync_god_mode_ui_lock_visuals_main_menu"
		):
			return

		_set_main_menu_surface_isolated(true, "sync_god_mode_ui_lock_visuals_main_menu")

		if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel) or not god_mode_start_panel.visible:
			if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
				god_mode_background_dim.visible = false
				god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return

	var locked:= _god_mode_ui_locked()

	if locked:
		if _ui_authority_should_block_hide_attempt(
			"_sync_god_mode_ui_lock_visuals",
			"set_main_gameplay_ui_visible_false",
			"god_mode_ui_locked"
		):
			return

		_set_main_gameplay_ui_visible(false)
		_apply_fullscreen_god_mode_layout()
	else:
		if god_mode_background_dim != null:
			god_mode_background_dim.visible = false
		_apply_centered_live_layout()

	_apply_ui_nav_button_visuals()
func _ensure_era_border_particles() -> void:
	if era_border_overlay == null:
		return
	if era_border_particle_nodes.size() > 0:
		return

	for i in range(ERA_BORDER_PARTICLE_COUNT):
		var particle:= MainSceneHelpers._make_era_border_rect(Color(0, 0, 0, 0))
		particle.name = "Particle%d" % i
		particle.size = Vector2.ZERO
		era_border_particle_nodes.append(particle)
		era_border_overlay.add_child(particle)


func _update_era_border_particles(
	w: float,
	h: float,
	theme_key: String,
	theme_data: Dictionary,
	material_pulse: float
) -> void:
	if era_border_particle_nodes.is_empty():
		return

	var perimeter: float = max(1.0, (w * 2.0) + (h * 2.0))
	var overlay_speed: float = float(theme_data.get("overlay_speed", 0.35))

	for i in range(era_border_particle_nodes.size()):
		var rect: ColorRect = era_border_particle_nodes [i]
		if rect == null:
			continue

		match theme_key:
			"future":
				var particle_size: float = 1.5 + float(i % 3)
				var distance: float = fposmod(
					(era_border_phase * (110.0 + float(i) * 5.0) * overlay_speed)
					+ (perimeter / float(max(1, era_border_particle_nodes.size()))) * float(i),
					perimeter
				)
				var cyan_bias: float = 0.35 + 0.65 * ((sin(era_border_phase * 2.0 + float(i)) * 0.5) + 0.5)
				rect.color = Color(
					lerp(0.52, 0.82, cyan_bias),
					1.0,
					lerp(0.92, 1.0, cyan_bias),
					0.06 + 0.05 * material_pulse
				)
				MainSceneHelpers._position_particle_along_frame(rect, distance, w, h, 10.0, particle_size)

			"ancient":
				var grain_size: float = 1.0 + float(i % 2)
				var edge_selector: int = i % 4
				var travel: float = float(i * 97) + era_border_phase * 6.0
				var noise_alpha: float = 0.05 + 0.03 * ((sin(era_border_phase * 1.7 + float(i) * 1.37) * 0.5) + 0.5)
				rect.color = Color(0.92, 0.78, 0.54, noise_alpha)

				if edge_selector == 0:
					rect.position = Vector2(fposmod(travel * 3.1, w), 3.0 + fmod(float(i), 3.0))
				elif edge_selector == 1:
					rect.position = Vector2(w - 4.0 - fmod(float(i), 3.0), fposmod(travel * 1.9, h))
				elif edge_selector == 2:
					rect.position = Vector2(fposmod(travel * 2.3, w), h - 4.0 - fmod(float(i), 2.0))
				else:
					rect.position = Vector2(3.0 + fmod(float(i), 2.0), fposmod(travel * 2.7, h))

				rect.size = Vector2.ONE * grain_size

			_:
				rect.color = Color(0, 0, 0, 0)
				rect.size = Vector2.ZERO


func _ensure_era_border_overlay() -> void:
	var desired_parent: Node = self





	var resident_overlay: Control = (
		desired_parent.get_node_or_null(
			"EraBorderOverlay"
		) as Control
	)

	if (
		resident_overlay != null
		and is_instance_valid(
			resident_overlay
		)
	):
		if (
			era_border_overlay != null
			and is_instance_valid(
				era_border_overlay
			)
			and era_border_overlay != resident_overlay
		):
			era_border_overlay.visible = false

			var duplicate_parent: Node = (
				era_border_overlay.get_parent()
			)
			if duplicate_parent != null:
				duplicate_parent.remove_child(
					era_border_overlay
				)

			era_border_overlay.queue_free()

		era_border_overlay = resident_overlay
	elif (
		era_border_overlay != null
		and is_instance_valid(
			era_border_overlay
		)
	):
		if era_border_overlay.get_parent() != desired_parent:
			var old_parent: Node = (
				era_border_overlay.get_parent()
			)
			if old_parent != null:
				old_parent.remove_child(
					era_border_overlay
				)
			desired_parent.add_child(
