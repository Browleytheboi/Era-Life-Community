func _finalize_previewed_god_mode_life_entry_state_only(settings: Dictionary, reason: String = "god_mode_start_button") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("post_visible_finalization", "Mainscene._finalize_previewed_god_mode_life_entry_state_only", reason, {
			"blocks_ui": true,
			"background_only": false
		}):
			set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
			set_meta("god_mode_life_finalization_after_zero_frame_connected", false)
			set_meta("god_mode_life_finalization_state_only_cancelled_by_global_runtime_kill", true)
			set_meta("god_mode_life_finalization_state_only_cancelled_reason", reason)
			set_meta("god_mode_life_finalization_state_only_cancelled_at_ms", now_ms)

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["god_mode_life_finalization_after_zero_frame_pending"] = false
				gs.scenario_state ["god_mode_life_finalization_state_only_cancelled_by_global_runtime_kill"] = true
				gs.scenario_state ["god_mode_life_finalization_state_only_cancelled_reason"] = reason
				gs.scenario_state ["ready_shell_blocks_loading_runtime"] = true
				gs.scenario_state ["ready_shell_visible_loading_forbidden"] = true
				gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
				gs.scenario_state ["life_runtime_background_tail_deferred"] = true

			_global_runtime_kill_apply_visible_shell_law("%s_state_only_finalize_cancelled" % reason)
			return

	if gs == null or gs.player == null:
		set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
		_begin_god_mode_life_with_settings(settings)
		return

	var merged_settings:= _build_default_custom_settings()
	for key in settings.keys():
		merged_settings [key] = settings [key]

	merged_settings = _apply_god_mode_reality_candidate_to_settings(merged_settings, "finalize_previewed_god_mode_life_entry_state_only")

	var consumed_prewarm: Dictionary = _consume_god_mode_life_prewarm(merged_settings)
	if bool(consumed_prewarm.get("success", false)):
		var consumed_gs_raw: Variant = consumed_prewarm.get("game_state", null)
		if consumed_gs_raw is GameState:
			var consumed_gs: GameState = consumed_gs_raw as GameState
			if consumed_gs != null and consumed_gs.player != null:
				gs = consumed_gs

	if gs == null or gs.player == null:
		set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
		_begin_god_mode_life_with_settings(settings)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var candidate_raw: Variant = merged_settings.get("_prebirth_reality_candidate", {})
	var candidate: Dictionary = candidate_raw.duplicate(true) if typeof(candidate_raw) == TYPE_DICTIONARY else {}

	var seed_contract_raw: Variant = merged_settings.get("seed_contract", {})
	var seed_contract: Dictionary = seed_contract_raw.duplicate(true) if typeof(seed_contract_raw) == TYPE_DICTIONARY else {}

	var world_seed: int = int(merged_settings.get("world_seed", candidate.get("world_seed", seed_contract.get("seed", -1))))
	if seed_contract.is_empty() and world_seed > 0:
		seed_contract = {
			"schema": "eralife.seed_contract",
			"version": 1,
			"seed": world_seed,
			"source": "finalize_previewed_god_mode_life_entry_state_only",
			"candidate_id": str(candidate.get("candidate_id", merged_settings.get("_prebirth_reality_candidate_id", ""))),
			"single_target_reality": true
		}

	var birth_boot_context: Dictionary = _birth_shell_boot_context_from_settings(merged_settings)
	var target_year: int = int(birth_boot_context.get("target_year", int(merged_settings.get("year", gs.year))))
	var era_key: String = str(birth_boot_context.get("era_key", str(merged_settings.get("era", "")))).strip_edges()

	gs.custom_mode = true
	gs.awaiting_new_life = false
	gs.afterlife_active = false
	gs.afterlife_state.clear()
	gs.custom_settings = merged_settings.duplicate(true)
	gs.year = target_year

	if gs.era_engine != null and typeof(gs.era_engine.eras) == TYPE_DICTIONARY and gs.era_engine.eras.has(era_key):
		gs.era = gs.era_engine.eras.get(era_key, {}).duplicate(true)
	elif gs.era_engine != null and gs.era_engine.has_method("_era_from_year"):
		gs.era = gs.era_engine._era_from_year(target_year)

	if "reality_mode" in gs:
		gs.reality_mode = str(birth_boot_context.get("reality_mode", merged_settings.get("reality_mode", "realistic")))

	var birth_intro_cry_entry_kind: String = str(merged_settings.get("_god_mode_entry_kind", "custom")).strip_edges().to_lower()
	if birth_intro_cry_entry_kind == "":
		birth_intro_cry_entry_kind = "custom"

	if MainSceneHelpers._birth_intro_cry_should_arm_for_settings(merged_settings):
		_arm_birth_intro_cry_for_first_playable_ui("finalize_previewed_god_mode_life_entry_state_only", birth_intro_cry_entry_kind)
	else:
		_mark_birth_intro_cry_consumed("finalize_previewed_god_mode_life_entry_state_only_non_newborn_start", false)

	gs.scenario_state ["god_mode_life_prewarm_consumed"] = true
	gs.scenario_state ["god_mode_life_prewarm_signature"] = str(consumed_prewarm.get("signature", ""))
	gs.scenario_state ["god_mode_life_finalize_policy"] = "state_only_no_shell_rebuild"
	gs.scenario_state ["god_mode_life_finalize_reason"] = reason
	gs.scenario_state ["god_mode_life_finalize_at_ms"] = now_ms
	gs.scenario_state ["world_seed"] = world_seed
	gs.scenario_state ["seed_contract"] = seed_contract.duplicate(true)
	gs.scenario_state ["god_mode_prebirth_reality_candidate"] = candidate.duplicate(true)
	gs.scenario_state ["single_target_reality"] = true
	gs.scenario_state ["prebirth_reality_locked"] = true
	gs.scenario_state ["hydrate_player_before_surrounding_world"] = true

	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = true
	gs.scenario_state ["prewarmed_capsule_entry_requested_at_ms"] = now_ms
	gs.scenario_state ["spawn_shell_entry_policy"] = "main_shell_first_user_intent_tabs"
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["ui_first_frame_render_policy"] = "prewarmed_capsule_state_only_finalized"
	gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = true
	gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	gs.scenario_state ["post_spawn_world_prewarm_mode"] = "delayed_until_player_idle"
	gs.scenario_state ["post_spawn_world_prewarm_player_control_grace_until_ms"] = now_ms + 12000

	set_meta("god_mode_life_boot_uses_prewarmed_spawn", true)
	set_meta("prewarmed_capsule_entry_shell_first", true)
	set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
	set_meta("god_mode_life_finalization_after_zero_frame_released_at_ms", now_ms)
	set_meta("god_mode_life_finalization_policy", "state_only_no_shell_rebuild")
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("startup_birth_loading_overlay_active", false)
	set_meta("birth_entry_reality_surge_active", false)
	set_meta("birth_entry_reality_surge_first_frame_committed", true)
	set_meta("spawn_ready_runtime_hud_shell_only_active", true)
	set_meta("spawn_ready_era_border_fast_until_ms", now_ms + 2400)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 12000)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 1200)

	current_panel = "life"

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.visible = false
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_start_panel.set_meta("defer_free_after_spawn_shell", true)
		god_mode_start_panel.set_meta("atomic_shell_cover_active", false)

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_background_dim.set_meta("atomic_shell_cover_active", false)

	if age_up_loading_runtime_active or (age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible):
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false

	var root:= get_node_or_null("UIContainer") as Control
	if root != null:
		root.visible = true

	_ensure_player_stats_overlay()
	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true

	if _spawn_ready_life_output_needs_first_paint():
		_paint_spawn_ready_life_diary_shell_first_frame("%s_state_only_missing_life_diary" % reason)

	_set_spawn_ready_shell_controls_visible_without_truth_work(true, "%s_state_only_finalized" % reason)
	_reveal_spawn_ready_runtime_hud_buttons_shell_only("%s_state_only_finalized" % reason)

	era_border_reveal_progress = 1.0
	era_border_reveal_target = 1.0
	if era_border_overlay != null and is_instance_valid(era_border_overlay):
		era_border_overlay.visible = true
		_layout_era_border_overlay()

	call_deferred("_free_hidden_god_mode_panel_after_spawn_shell", "%s_state_only_finalized" % reason)
	call_deferred("_flush_runtime_boot_buffered_ui_intents")
	_schedule_post_first_frame_god_mode_life_boot("%s_state_only_finalized" % reason)
	_schedule_deferred_live_reality_stream_bind_for_spawn("%s_state_only_finalized" % reason)
