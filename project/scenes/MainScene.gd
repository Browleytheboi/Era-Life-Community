				""
			)
		)
	)
	badge.set_meta(
		"ui_is_renderer_only",
		true
	)
func _build_crown_diplomacy_country_entries() -> Array:
	var entries: Array = MainSceneHelpers._safe_array(
		crown_hub_active_contract.get(
			"diplomacy_country_entries",
			[]
		)
	)

	if entries.is_empty():
		var section_surfaces: Dictionary = MainSceneHelpers._safe_dictionary(
			crown_hub_active_contract.get(
				"section_surfaces",
				{}
			)
		)
		var diplomacy_rows: Array = MainSceneHelpers._safe_array(
			section_surfaces.get(
				"diplomacy",
				[]
			)
		)

		for raw_row in diplomacy_rows:
			var row: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_row
			)

			if row.is_empty():
				continue

			var data: Dictionary = MainSceneHelpers._safe_dictionary(
				row.get(
					"data",
					{}
				)
			)
			var row_entries: Array = MainSceneHelpers._safe_array(
				data.get(
					"entries",
					[]
				)
			)

			if row_entries.is_empty():
				continue

			entries = row_entries.duplicate(false)
			break

	if entries.is_empty():
		var live_entries_raw: Variant = get_meta(
			"crown_diplomacy_stream_entries",
			[]
		)

		if typeof(live_entries_raw) == TYPE_ARRAY:
			entries = (
				live_entries_raw as Array
			).duplicate(false)

	set_meta(
		"crown_diplomacy_entries_contract_owned",
		true
	)
	set_meta(
		"crown_diplomacy_entries_ui_called_engines",
		false
	)
	set_meta(
		"crown_diplomacy_entries_build_on_section_click",
		false
	)
	set_meta(
		"crown_diplomacy_entries_count",
		entries.size()
	)
	set_meta(
		"crown_diplomacy_entries_deep_copy_performed",
		false
	)
	set_meta(
		"crown_diplomacy_entries_nested_realm_payloads",
		false
	)
	set_meta(
		"crown_diplomacy_entries_live_cache_fallback",
		not entries.is_empty()
	)

	return entries
