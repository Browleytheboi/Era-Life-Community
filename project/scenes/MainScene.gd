			tokens ["sound_press_id"] = "ui_nav_future_press"
			tokens ["sound_active_id"] = "ui_nav_future_active"
		_:
			tokens ["bg"] = Color(0.05, 0.09, 0.18, 0.84)
			tokens ["border"] = Color(1.0, 1.0, 1.0, 0.14)
			tokens ["glow"] = Color(1.0, 1.0, 1.0, 0.08)
			tokens ["glow_size"] = 8.0
			tokens ["text"] = Color(0.97, 0.995, 1.0, 1.0)
