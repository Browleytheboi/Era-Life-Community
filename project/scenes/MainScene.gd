func _register_crown_population_graph_node(
	card: PanelContainer,
	target: Person,
	realm_id: int,
	section_kind: String,
	accent: Color,
	element: String = "",
	realm_name: String = ""
) -> void:
	if card == null or target == null:
		return

	var entity_id: String = MainSceneHelpers._crown_population_entity_id_for_person(target)
	if entity_id == "":
		return

	var node_contract: Dictionary = {
		"entity_id": entity_id,
		"person_id": int(target.id),
		"card": card,
		"realm_id": realm_id,
		"section_kind": section_kind,
		"accent": accent,
		"element": element,
		"realm_name": realm_name
	}

	card.set_meta("crown_population_graph_entity_id", entity_id)
	card.set_meta("crown_population_graph_node_contract", node_contract.duplicate(true))
	card.set_meta("crown_population_graph_node_prebound", true)

	if crown_action_popup == null:
		return

	var nodes_raw: Variant = crown_action_popup.get_meta("crown_population_graph_nodes", {})
	var nodes: Dictionary = nodes_raw if typeof(nodes_raw) == TYPE_DICTIONARY else {}

	nodes [entity_id] = node_contract
	crown_action_popup.set_meta("crown_population_graph_nodes", nodes)
func _rebind_crown_population_graph_nodes_from_surface(surface: Control) -> void:
	if crown_action_popup == null or surface == null or not is_instance_valid(surface):
		return

	var nodes: Dictionary = {}
	MainSceneHelpers._collect_crown_population_graph_nodes_from_surface(surface, nodes)
	crown_action_popup.set_meta("crown_population_graph_nodes", nodes)

	if bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
		_refresh_crown_population_graph_hover_from_meta()


func _crown_population_graph_layer(create_if_missing: bool = true) -> Control:
	if crown_action_popup == null:
		return null

	var existing:= crown_action_popup.get_node_or_null("CrownPopulationGraphLayer") as Control
	if existing != null:
		_sync_crown_population_graph_layer_to_viewport(existing)
		existing.visible = true
		return existing

	if not create_if_missing:
		return null

	var layer:= Control.new()
	layer.name = "CrownPopulationGraphLayer"
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.clip_contents = true
	layer.z_as_relative = false
	layer.z_index = 1124
	crown_action_popup.add_child(layer)
	crown_action_popup.move_child(layer, crown_action_popup.get_child_count() - 1)

	_sync_crown_population_graph_layer_to_viewport(layer)

	return layer
func _crown_population_graph_scroll_viewport() -> ScrollContainer:
	if crown_action_popup_options == null:
		return null

	return crown_action_popup_options.get_parent() as ScrollContainer


func _sync_crown_population_graph_layer_to_viewport(layer: Control) -> void:
	if layer == null or crown_action_popup == null:
		return

	var scroll: ScrollContainer = _crown_population_graph_scroll_viewport()
	if scroll == null or not is_instance_valid(scroll):
		return

	var current_parent:= layer.get_parent()
	if current_parent != null and current_parent != crown_action_popup:
		current_parent.remove_child(layer)

	if layer.get_parent() == null:
		crown_action_popup.add_child(layer)

	if layer.get_parent() == crown_action_popup:
		crown_action_popup.move_child(layer, crown_action_popup.get_child_count() - 1)

	var scroll_rect: Rect2 = scroll.get_global_rect()
	var popup_rect: Rect2 = crown_action_popup.get_global_rect()

	layer.anchor_left = 0.0
	layer.anchor_right = 0.0
	layer.anchor_top = 0.0
	layer.anchor_bottom = 0.0
	layer.position = scroll_rect.position - popup_rect.position
	layer.size = scroll_rect.size
	layer.custom_minimum_size = scroll_rect.size
	layer.clip_contents = true
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.set_meta("crown_population_graph_layer_space", "scroll_viewport")
	layer.set_meta("crown_population_graph_scroll_viewport_global_rect", scroll_rect)
	layer.set_meta("crown_population_graph_ui_lens_only", true)

func _connect_crown_population_graph_scroll_signals() -> void:
	var scroll: ScrollContainer = _crown_population_graph_scroll_viewport()
	if scroll == null or not is_instance_valid(scroll):
		return

	var vbar:= scroll.get_v_scroll_bar()
	if vbar != null:
		var vcall:= Callable(self, "_on_crown_population_graph_scroll_value_changed")
		if not vbar.value_changed.is_connected(vcall):
			vbar.value_changed.connect(vcall)

	var hbar:= scroll.get_h_scroll_bar()
	if hbar != null:
		var hcall:= Callable(self, "_on_crown_population_graph_scroll_value_changed")
		if not hbar.value_changed.is_connected(hcall):
			hbar.value_changed.connect(hcall)


func _on_crown_population_graph_scroll_value_changed(_value: float) -> void:
	if crown_action_popup == null:
		return

	if not bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
		return

	crown_action_popup.set_meta("crown_population_graph_scroll_reproject_dirty", true)
	crown_action_popup.set_meta("crown_population_graph_scroll_reprojected_at_ms", int(Time.get_ticks_msec()))

	_refresh_crown_population_graph_hover_from_meta(false)

	if not bool(crown_action_popup.get_meta("crown_population_graph_scroll_refresh_queued", false)):
		crown_action_popup.set_meta("crown_population_graph_scroll_refresh_queued", true)
		call_deferred("_deferred_crown_population_graph_scroll_reproject")
func _deferred_crown_population_graph_scroll_reproject() -> void:
	if crown_action_popup != null:
		crown_action_popup.set_meta("crown_population_graph_scroll_refresh_queued", false)

		if not bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
			return

		crown_action_popup.set_meta("crown_population_graph_scroll_reproject_dirty", false)

	_refresh_crown_population_graph_hover_from_meta(false)
func _clear_crown_population_graph_lines_only() -> void:
	var layer: Control = _crown_population_graph_layer(false)
	if layer == null:
		return

	var children: Array = layer.get_children()
	for child in children:
		MainSceneHelpers._kill_crown_population_graph_node_tweens(child)

		if child.get_parent() == layer:
			layer.remove_child(child)

		child.queue_free()
func _hide_crown_population_graph_hover() -> void:
	if crown_action_popup != null:
		crown_action_popup.set_meta("crown_population_graph_active", false)
		crown_action_popup.set_meta("crown_population_graph_active_entity_id", "")
		crown_action_popup.set_meta("crown_population_graph_expanded", false)
		crown_action_popup.set_meta("crown_population_graph_expanded_entity_id", "")

	_clear_crown_population_graph_lines_only()
	_apply_crown_population_graph_node_focus("", [], false)

	var layer: Control = _crown_population_graph_layer(false)
	if layer != null:
		layer.visible = false

	if crown_action_popup_status != null and crown_action_popup_status.text.begins_with("Graph Lens:"):
		crown_action_popup_status.text = ""

func _show_crown_population_graph_hover(card: PanelContainer, target: Person, _section_kind: String, accent: Color, _realm_id: int = -1, _element: String = "", _realm_name: String = "") -> void:
	if crown_action_popup == null or card == null or target == null:
		return

	var source_entity_id: String = MainSceneHelpers._crown_population_entity_id_for_person(target)
	if source_entity_id == "":
		return

	var contracts_raw: Variant = crown_action_popup.get_meta("crown_population_graph_contracts", {})
	var contracts: Dictionary = contracts_raw if typeof(contracts_raw) == TYPE_DICTIONARY else {}
	var contract: Dictionary = contracts.get(source_entity_id, {}) if contracts.has(source_entity_id) else {}

	if contract.is_empty():
		return

	var edges: Array = contract.get("edges", []) if typeof(contract.get("edges", [])) == TYPE_ARRAY else []
	if edges.is_empty():
		return

	var previous_entity_id: String = str(crown_action_popup.get_meta("crown_population_graph_active_entity_id", "")).strip_edges()
	if previous_entity_id != source_entity_id:
		crown_action_popup.set_meta("crown_population_graph_expanded", false)
		crown_action_popup.set_meta("crown_population_graph_expanded_entity_id", "")

	crown_action_popup.set_meta("crown_population_graph_active", true)
	crown_action_popup.set_meta("crown_population_graph_active_entity_id", source_entity_id)
	crown_action_popup.set_meta("crown_population_graph_active_accent", accent)

	_refresh_crown_population_graph_hover_from_meta()
func _on_crown_population_graph_node_gui_input(event: InputEvent, card: PanelContainer, target: Person, _section_kind: String, accent: Color, _realm_id: int = -1, _element: String = "", _realm_name: String = "") -> void:
	if crown_action_popup == null or card == null or target == null:
		return

	var mouse_event:= event as InputEventMouseButton
	if mouse_event == null:
		return

	if mouse_event.button_index != MOUSE_BUTTON_LEFT or not mouse_event.pressed:
		return

	if not bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
		return

	var source_entity_id: String = MainSceneHelpers._crown_population_entity_id_for_person(target)
	if source_entity_id == "":
		return

	var active_entity_id: String = str(crown_action_popup.get_meta("crown_population_graph_active_entity_id", "")).strip_edges()
	if active_entity_id != source_entity_id:
		return

	var expanded: bool = bool(crown_action_popup.get_meta("crown_population_graph_expanded", false))
	var expanded_entity_id: String = str(crown_action_popup.get_meta("crown_population_graph_expanded_entity_id", "")).strip_edges()

	var next_expanded: bool = not expanded or expanded_entity_id != source_entity_id
	crown_action_popup.set_meta("crown_population_graph_expanded", next_expanded)
	crown_action_popup.set_meta("crown_population_graph_expanded_entity_id", source_entity_id if next_expanded else "")
	crown_action_popup.set_meta("crown_population_graph_active_accent", accent)

	_refresh_crown_population_graph_hover_from_meta()
	accept_event()
func _refresh_crown_population_graph_hover_from_meta(animated: bool = true) -> void:
	if crown_action_popup == null:
		return

	if not bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
		return

	var source_entity_id: String = str(crown_action_popup.get_meta("crown_population_graph_active_entity_id", "")).strip_edges()
	if source_entity_id == "":
		return

	var contracts_raw: Variant = crown_action_popup.get_meta("crown_population_graph_contracts", {})
	var contracts: Dictionary = contracts_raw if typeof(contracts_raw) == TYPE_DICTIONARY else {}
	var contract: Dictionary = contracts.get(source_entity_id, {}) if contracts.has(source_entity_id) else {}
	if contract.is_empty():
		return

	var edges: Array = contract.get("edges", []) if typeof(contract.get("edges", [])) == TYPE_ARRAY else []
	if edges.is_empty():
		return

	var nodes_raw: Variant = crown_action_popup.get_meta("crown_population_graph_nodes", {})
	var nodes: Dictionary = nodes_raw if typeof(nodes_raw) == TYPE_DICTIONARY else {}
	if not nodes.has(source_entity_id):
		return

	var source_node_raw: Variant = nodes.get(source_entity_id, {})
	if typeof(source_node_raw) != TYPE_DICTIONARY:
		return

	var source_node: Dictionary = source_node_raw
	var source_card:= source_node.get("card", null) as PanelContainer
	if source_card == null or not is_instance_valid(source_card):
		return

	var accent_raw: Variant = crown_action_popup.get_meta(
		"crown_population_graph_active_accent",
		crown_action_popup.get_meta("crown_population_graph_accent", Color(1.0, 0.84, 0.36, 1.0))
	)
	var accent: Color = accent_raw if typeof(accent_raw) == TYPE_COLOR else Color(1.0, 0.84, 0.36, 1.0)

	var expanded: bool = bool(crown_action_popup.get_meta("crown_population_graph_expanded", false))
	var expanded_entity_id: String = str(crown_action_popup.get_meta("crown_population_graph_expanded_entity_id", "")).strip_edges()
	expanded = expanded and expanded_entity_id == source_entity_id

	var layer: Control = _crown_population_graph_layer(true)
	if layer == null:
		return

	_sync_crown_population_graph_layer_to_viewport(layer)
	layer.visible = true

	_clear_crown_population_graph_lines_only()

	if not MainSceneLogic._crown_population_graph_card_visible_in_layer(source_card, layer):
		_apply_crown_population_graph_node_focus(source_entity_id, [], false)
		if crown_action_popup_status != null and crown_action_popup_status.text.begins_with("Graph Lens:"):
			crown_action_popup_status.text = "Graph Lens: source card left the population viewport."
		return

	var visible_edges: Array = _crown_population_graph_visible_edges_for_lod(
		edges,
		nodes,
		layer,
		expanded
	)

	_apply_crown_population_graph_node_focus(source_entity_id, visible_edges, true)

	var rendered_edges: int = 0
	for raw_edge in visible_edges:
		if typeof(raw_edge) != TYPE_DICTIONARY:
			continue

		var edge: Dictionary = raw_edge
		var target_entity_id: String = str(edge.get("target_entity_id", "")).strip_edges()
		if target_entity_id == "":
			continue

		var target_card: PanelContainer = null

		if nodes.has(target_entity_id):
			var node_raw: Variant = nodes.get(target_entity_id, {})
			if typeof(node_raw) == TYPE_DICTIONARY:
				var node: Dictionary = node_raw
				target_card = node.get("card", null) as PanelContainer

		if target_card == null or not is_instance_valid(target_card):
			continue

		if not MainSceneLogic._crown_population_graph_card_visible_in_layer(target_card, layer):
			continue

		edge ["population_lens_virtual_target"] = false
		edge ["population_lens_target_node_missing"] = false
		edge ["population_lens_target_offscreen"] = false
		edge ["population_lens_draws_to_real_card"] = true

		_append_crown_population_graph_edge_line(
			layer,
			source_card,
			target_card,
			edge,
			accent,
			rendered_edges,
			visible_edges.size(),
			expanded,
			animated
		)

		rendered_edges += 1
	crown_action_popup.set_meta("crown_population_graph_last_rendered_edges", rendered_edges)
	crown_action_popup.set_meta("crown_population_graph_last_projection_ms", int(Time.get_ticks_msec()))
	crown_action_popup.set_meta("crown_population_graph_projection_space", "scroll_viewport")
	crown_action_popup.set_meta("crown_population_graph_projection_renderer_only", true)

	if crown_action_popup_status != null:
		if rendered_edges > 0:
			var total_count: int = edges.size()
			var lod_note: String = ""

			if expanded:
				var hidden_offscreen_count: int = 0
				var hidden_missing_count: int = 0

				if layer != null and is_instance_valid(layer):
					hidden_offscreen_count = int(layer.get_meta("population_lens_hidden_offscreen_edge_count", 0))
					hidden_missing_count = int(layer.get_meta("population_lens_hidden_missing_edge_count", 0))

				lod_note = " Expanded lens: showing %d/%d real visible card ties. %d offscreen ties and %d missing-node ties remain in contract truth but are not drawn as fake scribble lines." % [
					rendered_edges,
					total_count,
					hidden_offscreen_count,
					hidden_missing_count
				]
			elif total_count > rendered_edges:
				lod_note = " Showing strongest %d/%d visible ties. Click the hovered card body to expand all ties." % [
					rendered_edges,
					total_count
				]

			crown_action_popup_status.text = "Graph Lens: %d curved connections reprojected in population viewport space from RelationshipGraphContractEngine.%s" % [
				rendered_edges,
				lod_note
			]
		elif crown_action_popup_status.text.begins_with("Graph Lens:"):
			crown_action_popup_status.text = "Graph Lens: no connected cards are currently visible inside this scroll window."
func _crown_population_graph_visible_edges_for_lod(
	edges: Array,
	nodes: Dictionary,
	layer: Control,
	expanded: bool = false
) -> Array:
	var candidates: Array = []
	var hidden_offscreen_count: int = 0
	var hidden_missing_count: int = 0

	for raw_edge in edges:
		if typeof(raw_edge) != TYPE_DICTIONARY:
			continue

		var edge: Dictionary = (raw_edge as Dictionary).duplicate(true)
		var target_entity_id: String = str(edge.get("target_entity_id", "")).strip_edges()
		if target_entity_id == "":
			hidden_missing_count += 1
			continue

		if not nodes.has(target_entity_id):
			hidden_missing_count += 1
			continue

		var node_raw: Variant = nodes.get(target_entity_id, {})
		if typeof(node_raw) != TYPE_DICTIONARY:
			hidden_missing_count += 1
			continue

		var node: Dictionary = node_raw
		var target_card:= node.get("card", null) as PanelContainer
		if target_card == null or not is_instance_valid(target_card):
			hidden_missing_count += 1
			continue

		if not MainSceneLogic._crown_population_graph_card_visible_in_layer(target_card, layer):
			hidden_offscreen_count += 1
			continue

		edge ["population_lens_virtual_target"] = false
		edge ["population_lens_target_node_missing"] = false
		edge ["population_lens_target_offscreen"] = false
		edge ["population_lens_draws_to_real_card"] = true
		candidates.append(edge)

	candidates.sort_custom(Callable(self, "_crown_population_graph_visual_edge_sort"))

	if layer != null and is_instance_valid(layer):
		layer.set_meta("population_lens_hidden_offscreen_edge_count", hidden_offscreen_count)
		layer.set_meta("population_lens_hidden_missing_edge_count", hidden_missing_count)
		layer.set_meta("population_lens_expanded_draws_only_real_visible_cards", true)
		layer.set_meta("population_lens_virtual_expanded_lines_forbidden", true)

	if expanded:
		var expanded_max_edges: int = 32
		if layer != null and is_instance_valid(layer):
			expanded_max_edges = int(layer.get_meta("population_lens_expanded_lod_max_edges", 32))

		expanded_max_edges = maxi(1, expanded_max_edges)

		if candidates.size() <= expanded_max_edges:
			return candidates

		return candidates.slice(0, expanded_max_edges)

	var max_edges: int = 5
	if layer != null and is_instance_valid(layer):
		max_edges = int(layer.get_meta("population_lens_hover_lod_max_edges", 5))

	max_edges = maxi(1, max_edges)

	if candidates.size() <= max_edges:
		return candidates

	return candidates.slice(0, max_edges)

func _crown_population_graph_visual_edge_sort(a, b) -> bool:
	return MainSceneHelpers._crown_population_graph_edge_lod_score(a) > MainSceneHelpers._crown_population_graph_edge_lod_score(b)


func _apply_crown_population_graph_node_focus(source_entity_id: String, edges: Array, active: bool) -> void:
	if crown_action_popup == null:
		return

	var nodes_raw: Variant = crown_action_popup.get_meta("crown_population_graph_nodes", {})
	var nodes: Dictionary = nodes_raw if typeof(nodes_raw) == TYPE_DICTIONARY else {}
	var connected: Dictionary = {}

	if active:
		for raw_edge in edges:
			if typeof(raw_edge) != TYPE_DICTIONARY:
				continue

			var edge: Dictionary = raw_edge
			var target_entity_id: String = str(edge.get("target_entity_id", "")).strip_edges()
			if target_entity_id != "":
				connected [target_entity_id] = true

	for raw_entity_id in nodes.keys():
		var entity_id: String = str(raw_entity_id)
		var node_raw: Variant = nodes.get(raw_entity_id, {})
		if typeof(node_raw) != TYPE_DICTIONARY:
			continue

		var node: Dictionary = node_raw
		var card:= node.get("card", null) as PanelContainer
		if card == null or not is_instance_valid(card):
			continue

		if not active:
			card.modulate = Color(1.0, 1.0, 1.0, 1.0)
			card.z_index = 0
			continue

		if entity_id == source_entity_id:
			card.modulate = Color(1.08, 1.06, 1.0, 1.0)
			card.z_index = 8
		elif connected.has(entity_id):
			card.modulate = Color(1.03, 1.03, 1.0, 1.0)
			card.z_index = 7
		else:
			card.modulate = Color(1.0, 1.0, 1.0, 0.4)
			card.z_index = 0
func _append_crown_population_graph_edge_line(
	layer: Control,
	source_card: Control,
	target_card: Control,
	edge: Dictionary,
	accent: Color,
	edge_index: int = 0,
	total_edges: int = 1,
	expanded: bool = false,
	animated: bool = true
) -> void:
	if layer == null or source_card == null or target_card == null:
		return

	if not is_instance_valid(source_card):
		return

	if not is_instance_valid(target_card):
		return

	if not MainSceneLogic._crown_population_graph_card_visible_in_layer(source_card, layer):
		return

	if not MainSceneLogic._crown_population_graph_card_visible_in_layer(target_card, layer):
		return

	if not MainSceneLogic._crown_population_graph_card_visible_in_layer(source_card, layer):
		return

	if target_card != null and not expanded and not MainSceneLogic._crown_population_graph_card_visible_in_layer(target_card, layer):
		return

	var line_kind: String = str(edge.get("line_kind", "relationship")).strip_edges().to_lower()
	var dense_expanded: bool = expanded and total_edges >= 10
	var virtual_target: bool = bool(edge.get("population_lens_virtual_target", false)) or target_card == null
	var input_alpha: float = float(edge.get("intensity", 0.86))

	if dense_expanded:
		input_alpha = clampf(input_alpha * 0.78, 0.34, 0.86)

	if virtual_target:
		input_alpha = clampf(input_alpha * 0.7, 0.3, 0.76)

	var line_color: Color = MainSceneHelpers._crown_population_graph_edge_color(
		line_kind,
		accent,
		input_alpha
	)

	var route: Dictionary = _crown_population_graph_bezier_route(
		layer,
		source_card,
		target_card,
		edge,
		edge_index,
		total_edges,
		expanded
	)

	if route.is_empty():
		return

	var points: PackedVector2Array = route.get("points", PackedVector2Array())
	if points.size() < 2:
		return

	var width: float = MainSceneHelpers._crown_population_graph_edge_width(edge)
	if dense_expanded:
		width = clampf(width * 0.72, 1.15, 4.25)

	if virtual_target:
		width = clampf(width * 0.82, 1.0, 3.85)

	var glow_width: float = width + (2.4 if dense_expanded else 5.0)
	if line_kind == "succession_heir":
		glow_width = width + (4.2 if dense_expanded else 9.0)

	var glow_alpha: float = minf(0.3 if dense_expanded else 0.42, line_color.a * (0.32 if dense_expanded else 0.48))

	var glow_line:= Line2D.new()
	glow_line.width = glow_width
	glow_line.default_color = Color(line_color.r, line_color.g, line_color.b, glow_alpha)
	glow_line.antialiased = true
	glow_line.z_index = 1125
	glow_line.points = points
	glow_line.set_meta("crown_population_graph_projection_node", true)
	glow_line.set_meta("crown_population_graph_projection_space", "scroll_viewport")
	glow_line.set_meta("crown_population_graph_lane_offset", float(route.get("parallel_offset", 0.0)))
	glow_line.set_meta("crown_population_graph_virtual_target", virtual_target)
	layer.add_child(glow_line)

	var core_line:= Line2D.new()
	core_line.width = width
	core_line.default_color = line_color
	core_line.antialiased = true
	core_line.z_index = 1126
	core_line.points = points
	core_line.set_meta("crown_population_graph_projection_node", true)
	core_line.set_meta("crown_population_graph_projection_space", "scroll_viewport")
	core_line.set_meta("crown_population_graph_lane_offset", float(route.get("parallel_offset", 0.0)))
	core_line.set_meta("crown_population_graph_virtual_target", virtual_target)

	if line_kind == "succession_heir":
		var gradient:= Gradient.new()
		gradient.offsets = PackedFloat32Array([0.0, 0.48, 1.0])
		gradient.colors = PackedColorArray([
			Color(1.0, 0.82, 0.16, line_color.a),
			Color(1.0, 1.0, 1.0, line_color.a),
			Color(1.0, 0.55, 0.08, line_color.a)
		])
		core_line.gradient = gradient

	layer.add_child(core_line)

	if expanded:
		var lane_dot:= ColorRect.new()
		lane_dot.custom_minimum_size = Vector2(4.0, 4.0)
		lane_dot.color = Color(line_color.r, line_color.g, line_color.b, 0.86)
		lane_dot.z_index = 1128
		var dot_index: int = clampi(int(round(float(points.size() - 1) * 0.5)), 0, points.size() - 1)
		lane_dot.position = points [dot_index] - Vector2(2.0, 2.0)
		lane_dot.set_meta("crown_population_graph_projection_node", true)
		lane_dot.set_meta("crown_population_graph_projection_space", "scroll_viewport")
		layer.add_child(lane_dot)

	if expanded and bool(route.get("target_docked", false)):
		var dock:= ColorRect.new()
		dock.custom_minimum_size = Vector2(7, 7)
		dock.color = Color(line_color.r, line_color.g, line_color.b, 0.92)
		dock.z_index = 1128
		dock.position = Vector2(route.get("target_point", Vector2.ZERO)) - Vector2(3.5, 3.5)
		dock.set_meta("crown_population_graph_projection_node", true)
		dock.set_meta("crown_population_graph_projection_space", "scroll_viewport")
		dock.set_meta("crown_population_graph_virtual_target", virtual_target)
		layer.add_child(dock)

	if line_kind == "succession_heir":
		var crown_line:= Line2D.new()
		crown_line.width = maxf(1.1, width * 0.3)
		crown_line.default_color = Color(1.0, 1.0, 1.0, 0.86 if dense_expanded else 0.92)
		crown_line.antialiased = true
		crown_line.z_index = 1127
		crown_line.points = points
		crown_line.set_meta("crown_population_graph_projection_node", true)
		crown_line.set_meta("crown_population_graph_projection_space", "scroll_viewport")
		layer.add_child(crown_line)

		if animated:
			crown_line.modulate = Color(1.0, 1.0, 1.0, 0.0)
			var crown_tween:= crown_line.create_tween()
			MainSceneHelpers._register_crown_population_graph_node_tween(crown_line, crown_tween)
			crown_tween.tween_property(crown_line, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.1)
		else:
			crown_line.modulate = Color(1.0, 1.0, 1.0, 1.0)

	if animated:
		glow_line.modulate = Color(1.0, 1.0, 1.0, 0.0)
		core_line.modulate = Color(1.0, 1.0, 1.0, 0.0)

		var glow_tween:= glow_line.create_tween()
		MainSceneHelpers._register_crown_population_graph_node_tween(glow_line, glow_tween)
		glow_tween.tween_property(glow_line, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.16)

		var core_tween:= core_line.create_tween()
		MainSceneHelpers._register_crown_population_graph_node_tween(core_line, core_tween)
		core_tween.tween_property(core_line, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.12)

		if not dense_expanded and not virtual_target:
			_append_crown_population_graph_flow_particles(
				layer,
				points,
				line_color,
				width,
				line_kind,
				edge_index
			)
	else:
		glow_line.modulate = Color(1.0, 1.0, 1.0, 1.0)
		core_line.modulate = Color(1.0, 1.0, 1.0, 1.0)
func _crown_population_graph_bezier_route(
	layer: Control,
	source_card: Control,
	target_card: Control,
	edge: Dictionary,
	edge_index: int,
	total_edges: int,
	expanded: bool = false
) -> Dictionary:
	if layer == null or source_card == null:
		return {}

	var source_rect: Rect2 = MainSceneHelpers._crown_population_graph_card_rect_in_layer(source_card, layer)
	if source_rect.size == Vector2.ZERO:
		return {}

	var target_rect: Rect2 = Rect2()
	var target_docked: bool = false
	var virtual_target: bool = bool(edge.get("population_lens_virtual_target", false)) or target_card == null

	if target_card != null and is_instance_valid(target_card):
		target_rect = MainSceneHelpers._crown_population_graph_card_rect_in_layer(target_card, layer)

		if target_rect.size == Vector2.ZERO:
			virtual_target = true

		if expanded and not virtual_target and not MainSceneLogic._crown_population_graph_card_visible_in_layer(target_card, layer):
			target_rect = MainSceneHelpers._crown_population_graph_docked_target_rect_for_layer(
				layer,
				target_rect,
				edge_index,
				total_edges
			)
			target_docked = true
	else:
		virtual_target = true

	if virtual_target:
		target_rect = MainSceneHelpers._crown_population_graph_virtual_target_rect_for_edge(
			layer,
			source_rect,
			edge,
			edge_index,
			total_edges
		)
		target_docked = true

	if target_rect.size == Vector2.ZERO:
		return {}

	var route: Dictionary = MainSceneHelpers._crown_population_graph_anchor_route(source_rect, target_rect)
	if route.is_empty():
		return {}

	var source_point: Vector2 = Vector2(route.get("source", source_rect.get_center()))
	var target_point: Vector2 = Vector2(route.get("target", target_rect.get_center()))
	var axis: String = str(route.get("axis", "horizontal"))
	var direction: Vector2 = target_point - source_point
	var distance: float = maxf(1.0, direction.length())
	var unit: Vector2 = direction.normalized()
	var normal:= Vector2(- unit.y, unit.x)

	var safe_total: int = max(1, total_edges)
	var lane_ratio: float = float(edge_index + 1) / float(safe_total + 1)
	var centered_lane: float = (lane_ratio - 0.5) * 2.0
	var target_entity_id: String = str(edge.get("target_entity_id", "")).strip_edges()
	var line_kind: String = str(edge.get("line_kind", "relationship")).strip_edges().to_lower()
	var stable_hash: int = abs(int(("%s:%s:%d" % [target_entity_id, line_kind, edge_index]).hash()))
	var hash_nudge: float = (float(stable_hash % 1000) / 1000.0 - 0.5) * (18.0 if expanded else 7.0)
	var density_ratio: float = clampf(float(safe_total) / 28.0, 0.0, 1.0)
	var fan_span: float = lerpf(46.0, 168.0, density_ratio) if expanded else 36.0
	var parallel_offset: float = (centered_lane * fan_span) + hash_nudge

	parallel_offset = clampf(parallel_offset, -190.0, 190.0) if expanded else clampf(parallel_offset, -42.0, 42.0)

	if virtual_target:
		parallel_offset = clampf(parallel_offset * 0.72, -128.0, 128.0)

	var source_lane_point: Vector2 = source_point + normal * (parallel_offset * 0.32)
	var target_lane_point: Vector2 = target_point - normal * (parallel_offset * 0.18)
	var pull: float = clampf(distance * 0.38, 58.0, 230.0)

	if expanded:
		pull = clampf(distance * 0.3, 46.0, 176.0)

	if virtual_target:
		pull = clampf(distance * 0.24, 38.0, 138.0)

	var source_control: Vector2 = source_lane_point
	var target_control: Vector2 = target_lane_point

	if axis == "horizontal":
		var sign_x: float = 1.0 if target_point.x >= source_point.x else -1.0
		source_control = source_lane_point + Vector2(pull * sign_x, 0.0) + normal * (parallel_offset * 0.54)
		target_control = target_lane_point - Vector2(pull * sign_x, 0.0) + normal * (parallel_offset * 0.38)
	else:
		var sign_y: float = 1.0 if target_point.y >= source_point.y else -1.0
		source_control = source_lane_point + Vector2(0.0, pull * sign_y) + normal * (parallel_offset * 0.54)
		target_control = target_lane_point - Vector2(0.0, pull * sign_y) + normal * (parallel_offset * 0.38)

	var points: PackedVector2Array = _crown_population_graph_cubic_bezier_points(
		source_lane_point,
		source_control,
		target_control,
		target_lane_point,
		30 if expanded else 22
	)

	if points.size() > 0:
		points.set(0, source_point)
		points.set(points.size() - 1, target_point)

	if line_kind == "conflict":
		points = _crown_population_graph_jagged_curve_points(points, 7.5 if expanded else 6.0)

	return {
		"points": points,
		"source_point": source_point,
		"target_point": target_point,
		"source_lane_point": source_lane_point,
		"target_lane_point": target_lane_point,
		"axis": axis,
		"target_docked": target_docked,
		"virtual_target": virtual_target,
		"lane_ratio": lane_ratio,
		"parallel_offset": parallel_offset,
		"density_ratio": density_ratio
	}
func _crown_population_graph_cubic_bezier_points(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, segments: int = 24) -> PackedVector2Array:
	var points:= PackedVector2Array()
	var safe_segments: int = maxi(4, segments)

	for i in range(safe_segments + 1):
		var t: float = float(i) / float(safe_segments)
		var q0: Vector2 = p0.lerp(p1, t)
		var q1: Vector2 = p1.lerp(p2, t)
		var q2: Vector2 = p2.lerp(p3, t)
		var r0: Vector2 = q0.lerp(q1, t)
		var r1: Vector2 = q1.lerp(q2, t)
		points.append(r0.lerp(r1, t))

	return points


func _crown_population_graph_jagged_curve_points(base_points: PackedVector2Array, amplitude: float = 6.0) -> PackedVector2Array:
	if base_points.size() < 4:
		return base_points

	var out:= PackedVector2Array()

	for i in range(base_points.size()):
		var point: Vector2 = base_points [i]

		if i > 0 and i < base_points.size() - 1:
			var prev: Vector2 = base_points [i - 1]
			var next: Vector2 = base_points [i + 1]
			var direction: Vector2 = next - prev
			if direction.length() > 0.01:
				var unit: Vector2 = direction.normalized()
				var normal:= Vector2(- unit.y, unit.x)
				var polarity: float = 1.0 if i % 2 == 0 else -1.0
				point += normal * amplitude * polarity

		out.append(point)

	return out


func _append_crown_population_graph_flow_particles(layer: Control, points: PackedVector2Array, line_color: Color, width: float, line_kind: String, edge_index: int = 0) -> void:
	if layer == null or points.size() < 2:
		return

	var particle_count: int = 1
	match line_kind:
		"succession_heir":
			particle_count = 4
		"conflict":
			particle_count = 3
		"romance":
			particle_count = 3
		"political":
			particle_count = 2
		"economic":
			particle_count = 2
		"house":
			particle_count = 2
		_:
			particle_count = 1

	var particle_size: float = clampf(width + 2.0, 4.0, 9.0)

	for particle_index in range(particle_count):
		var particle:= PanelContainer.new()
		particle.mouse_filter = Control.MOUSE_FILTER_IGNORE
		particle.custom_minimum_size = Vector2(particle_size, particle_size)
		particle.size = Vector2(particle_size, particle_size)
		particle.z_index = 1128
		particle.set_meta("crown_population_graph_particle", true)

		var style:= StyleBoxFlat.new()
		style.bg_color = Color(line_color.r, line_color.g, line_color.b, 0.94)
		style.border_width_left = 1
		style.border_width_top = 1
		style.border_width_right = 1
		style.border_width_bottom = 1
		style.border_color = Color(1.0, 1.0, 1.0, 0.7)
		style.corner_radius_top_left = int(particle_size)
		style.corner_radius_top_right = int(particle_size)
		style.corner_radius_bottom_left = int(particle_size)
		style.corner_radius_bottom_right = int(particle_size)
		style.shadow_color = Color(line_color.r, line_color.g, line_color.b, 0.62)
		style.shadow_size = 9 if line_kind != "succession_heir" else 14
		style.shadow_offset = Vector2.ZERO
		particle.add_theme_stylebox_override("panel", style)

		layer.add_child(particle)

		var start_position: Vector2 = points [0] - Vector2(particle_size * 0.5, particle_size * 0.5)
		particle.position = start_position
		particle.modulate = Color(1.0, 1.0, 1.0, 0.0)

		var tween:= particle.create_tween()
		if tween == null:
			continue

		MainSceneHelpers._register_crown_population_graph_node_tween(particle, tween)
		tween.set_loops()

		var stagger: float = (float(particle_index) * 0.24) + (float(edge_index) * 0.035)
		if stagger > 0.0:
			tween.tween_interval(stagger)

		tween.tween_property(particle, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.1)

		var step_time: float = clampf(0.58 / float(points.size()), 0.018, 0.055)
		if line_kind == "succession_heir":
			step_time = clampf(0.72 / float(points.size()), 0.02, 0.062)

		for point_index in range(1, points.size()):
			tween.tween_property(
				particle,
				"position",
				points [point_index] - Vector2(particle_size * 0.5, particle_size * 0.5),
				step_time
			).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		tween.tween_property(particle, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.1)
		tween.tween_callback(func ():
			if is_instance_valid(particle):
				particle.position = start_position
		)
		tween.tween_interval(0.22)


func _crown_population_contract_array_size(
	contract: Dictionary,
	key: String
) -> int:
	var raw_value: Variant = contract.get(key, [])
	return (raw_value as Array).size() if typeof(raw_value) == TYPE_ARRAY else 0


func _crown_population_view_contract_is_complete_enough(
	contract: Dictionary
) -> bool:
	if contract.is_empty():
		return false

	var federal: bool = bool(
		contract.get("federal_republic_population_contract", false)
	)

	var executive_count: int = _crown_population_contract_array_size(
		contract,
		"federal_executive"
	)
	var cabinet_count: int = _crown_population_contract_array_size(
		contract,
		"federal_cabinet"
	)
	var senate_count: int = _crown_population_contract_array_size(
		contract,
		"federal_senate"
	)
	var supreme_court_count: int = _crown_population_contract_array_size(
		contract,
		"federal_supreme_court"
	)
	var governor_count: int = _crown_population_contract_array_size(
		contract,
		"federal_governors"
	)
	var royal_count: int = _crown_population_contract_array_size(
		contract,
		"royals"
	)
	var noble_count: int = _crown_population_contract_array_size(
		contract,
		"nobles"
	)
	var master_count: int = _crown_population_contract_array_size(
		contract,
		"masters"
	)
	var citizen_count: int = _crown_population_contract_array_size(
		contract,
		"citizens"
	)

	if federal:
		return (
			executive_count >= 3
			and cabinet_count >= 16
			and senate_count >= 100
			and supreme_court_count >= 9
			and governor_count >= 50
		)

	var visible_count: int = (
		royal_count
		+ noble_count
		+ master_count
		+ citizen_count
	)

	return visible_count >= 12
func _crown_population_view_contract_for_realm(
	realm_id: int,
	realm_name: String = "",
	force_rebuild: bool = false
) -> Dictionary:
	if gs == null or realm_id <= 0:
		return {}

	var resolved_realm_name: String = str(realm_name).strip_edges()
	if resolved_realm_name == "":
		resolved_realm_name = MainSceneLogic._crown_realm_name(gs, realm_id)

	var cache_key: String = MainSceneLogic._crown_population_wall_cache_key(gs, realm_id)
	var cached_contract_rejected: bool = false

	if not force_rebuild and crown_population_wall_view_contract_cache.has(cache_key):
		var cached_raw: Variant = crown_population_wall_view_contract_cache.get(
			cache_key,
			{}
		)

		if typeof(cached_raw) == TYPE_DICTIONARY:
			var cached_contract: Dictionary = (
				cached_raw as Dictionary
			).duplicate(true)

			if _crown_population_view_contract_is_complete_enough(cached_contract):
				return cached_contract

			cached_contract_rejected = true
			crown_population_wall_view_contract_cache.erase(cache_key)

	var element: String = MainSceneLogic._crown_population_realm_element(gs, 
		realm_id,
		resolved_realm_name
	)
	var nation_split_scope: String = (
		"earth_kingdom_city_split"
		if MainSceneLogic._crown_population_should_city_split_realm(gs, 
			realm_id,
			resolved_realm_name,
			element
		)
		else "nation_representative"
	)

	var card_engine:= _ensure_population_card_contract_engine()
	if card_engine == null:
		return {}

	var contract: Dictionary = card_engine.view_contract_for_realm(
		realm_id,
		resolved_realm_name,
		{
			"source": "mainscene_population_card_contract_delegate",
			"force_rebuild": force_rebuild or cached_contract_rejected,
			"element": element,
			"population_scope": nation_split_scope,
			"include_dormant": true,
			"citizen_limit": 150,
			"view_contract_only": true,
			"population_lens_viewer": true,
			"realm_population_contract_panel": true,
			"force_materialize_for_population_lens": true,
			"crr_surface_self_heal": true,
			"browse_population_surface": true,
			"truth_may_be_partial": false,
			"population_cards_may_project_partial_truth": false,
			"does_not_create_people": true,
			"uses_existing_population_shards": true,
			"exclude_observer_unless_realm_member": true,
			"ui_is_renderer_only": true,
			"does_not_call_realm_engine_on_press": true,
			"relationship_graph_is_authority": true,
			"hover_does_not_call_engines": true,
			"hover_only_draws_cached_truth": true,
			"population_cards_are_contract_artifacts": true,
			"click_path_build_forbidden": true,
			"ready_door_may_not_wait": true
		}
	)

	if contract.is_empty():
		return {}

	contract ["element"] = element
	contract ["population_scope"] = nation_split_scope
	contract ["earth_kingdom_city_split"] = nation_split_scope == "earth_kingdom_city_split"
	contract ["nation_representative_population"] = true
	contract ["ui_is_renderer_only"] = true
	contract ["view_contract_only"] = true
	contract ["does_not_create_people"] = true
	contract ["uses_existing_population_shards"] = true
	contract ["exclude_observer_unless_realm_member"] = true
	contract ["does_not_call_realm_engine_on_press"] = true
	contract ["relationship_graph_is_authority"] = true
	contract ["hover_does_not_call_engines"] = true
	contract ["hover_only_draws_cached_truth"] = true
	contract ["population_cards_are_contract_artifacts"] = true
	contract ["click_path_build_forbidden"] = true
	contract ["ready_door_may_not_wait"] = true
	contract ["rejected_partial_year_cache"] = cached_contract_rejected

	var complete_enough: bool = _crown_population_view_contract_is_complete_enough(
		contract
	)
	contract ["complete_enough_for_year_cache"] = complete_enough



	if complete_enough:
		crown_population_wall_view_contract_cache [cache_key] = contract.duplicate(true)
	else:
		crown_population_wall_view_contract_cache.erase(cache_key)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["crown_population_wall_view_contract_hot_%d" % realm_id] = true
		gs.scenario_state ["crown_population_wall_view_contract_hot_at_ms_%d" % realm_id] = int(Time.get_ticks_msec())
		gs.scenario_state ["crown_population_wall_view_contract_source_engine_%d" % realm_id] = "PopulationCardContractEngine"
		gs.scenario_state ["crown_population_wall_view_contract_complete_enough_%d" % realm_id] = complete_enough
		gs.scenario_state ["crown_population_wall_view_contract_partial_cache_rejected_%d" % realm_id] = cached_contract_rejected

	return contract
func _ensure_global_prewarm_contract_engine() -> GlobalPrewarmContractEngine:
	if gs == null:
		return null

	if "global_prewarm_contract_engine" in gs and gs.global_prewarm_contract_engine != null:
		global_prewarm_contract_engine = gs.global_prewarm_contract_engine
	else:
		global_prewarm_contract_engine = GlobalPrewarmContractEngine.new(gs)
		gs.global_prewarm_contract_engine = global_prewarm_contract_engine

	if global_prewarm_contract_engine != null:
		global_prewarm_contract_engine.bind_game_state(gs)

	return global_prewarm_contract_engine
func _ensure_population_card_contract_engine() -> PopulationCardContractEngine:
	if gs == null:
		return null

	if "population_card_contract_engine" in gs and gs.population_card_contract_engine != null:
		population_card_contract_engine = gs.population_card_contract_engine
	else:
		population_card_contract_engine = PopulationCardContractEngine.new(gs)
		gs.population_card_contract_engine = population_card_contract_engine

	if population_card_contract_engine != null:
		population_card_contract_engine.bind_game_state(gs)

	return population_card_contract_engine
func _ensure_population_lens_viewer() -> PopulationLensViewer:
	if population_lens_viewer == null:
		population_lens_viewer = PopulationLensViewer.new()

	population_lens_viewer.bind_host(self)
	return population_lens_viewer
func _reorder_population_lens_incremental_sections_from_contract(
		surface: Control
) -> void:
		if (
			surface == null
			or not is_instance_valid(
				surface
			)
		):
			return

		var sections_root:= surface.get_meta(
			"population_incremental_sections_root",
			null
		) as VBoxContainer

		if (
			sections_root == null
			or not is_instance_valid(
				sections_root
			)
		):
			return

		var view_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			surface.get_meta(
				"realm_population_view_contract",
				{}
			)
		)
		var category_order: Array = MainSceneHelpers._safe_array(
			view_contract.get(
				"category_order",
				[]
			)
		)
		var grids_raw: Variant = surface.get_meta(
			"population_incremental_section_grids",
			{}
		)
		var grids: Dictionary = (
			grids_raw as Dictionary
			if typeof(grids_raw) == TYPE_DICTIONARY
			else {}
		)
		var target_index: int = 0

		for raw_key in category_order:
			var section_key: String = str(
				raw_key
			)
			var grid:= grids.get(
				section_key,
				null
			) as GridContainer

			if (
				grid == null
				or not is_instance_valid(
					grid
				)
			):
				continue

			var section_panel:= grid.get_meta(
				"population_incremental_section_panel",
				null
			) as Control

			if (
				section_panel == null
				or not is_instance_valid(
					section_panel
				)
				or section_panel.get_parent()
				!= sections_root
			):
				continue

			sections_root.move_child(
				section_panel,
				target_index
			)
			target_index += 1

		surface.set_meta(
			"population_incremental_section_order_contract_applied",
			true
		)
func _ensure_realm_population_contract_panel() -> RealmPopulationContractPanel:
	if realm_population_contract_panel == null:
		realm_population_contract_panel = RealmPopulationContractPanel.new(gs)

	var viewer:= _ensure_population_lens_viewer()
	if viewer != null:
		realm_population_contract_panel.bind_population_lens_viewer(viewer)

	if gs != null and realm_population_contract_panel.has_method("bind_game_state"):
		realm_population_contract_panel.bind_game_state(gs)

	return realm_population_contract_panel

func _ensure_realm_population_surface_cache_root() -> Control:
	if realm_population_surface_cache_root != null and is_instance_valid(realm_population_surface_cache_root):
		return realm_population_surface_cache_root

	var ui_root:= self as Control
	if ui_root == null:
		return null

	realm_population_surface_cache_root = Control.new()
	realm_population_surface_cache_root.name = "RealmPopulationSurfaceCacheRoot"
	realm_population_surface_cache_root.visible = false
	realm_population_surface_cache_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	realm_population_surface_cache_root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	realm_population_surface_cache_root.set_meta("realm_population_cache_root", true)
	realm_population_surface_cache_root.set_meta("ui_build_on_press_forbidden", true)
	ui_root.add_child(realm_population_surface_cache_root)

	return realm_population_surface_cache_root


