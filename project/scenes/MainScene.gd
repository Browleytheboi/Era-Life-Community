func _resolve_other_country_browser_entry_by_id(entry_id: String) -> Dictionary:
	var clean_id: String = str(entry_id).strip_edges()
	if clean_id == "":
		return {}

	for raw_entry in _build_other_country_browser_entries():
		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = raw_entry as Dictionary
		if str(entry.get("entry_id", "")).strip_edges() == clean_id:
			return entry.duplicate(true)

	return {}
func _handle_other_country_action(action_id: String, entry: Dictionary) -> void:
	var has_status_label: bool = world_actions_status_label != null and is_instance_valid(world_actions_status_label)

	if entry.is_empty():
		if has_status_label:
			world_actions_status_label.text = "That realm could not be resolved."
		return

	var place_name: String = str(entry.get("name", "that place")).strip_edges()
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var realm: Dictionary = entry.get("realm", {})
	var entry_kind: String = str(entry.get("entry_kind", "realm")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges()
	var _browser_section: String = str(realm.get("realm_browser_section", "")).strip_edges().to_lower()
	var browser_visual_theme: String = str(realm.get("browser_visual_theme", "")).strip_edges().to_lower()
	var is_imaginative_realm: bool = entry_kind == "imaginative_realm" or realm_type == "imagination_bound"
	var is_nidavellir: bool = entry_id == "nidavellir" or browser_visual_theme == "nidavellir"
	var is_vormir: bool = entry_id == "vormir" or browser_visual_theme == "vormir"

	if action_id == "browse_population":
		_open_other_country_population_wall(entry.duplicate(true))
		return

	if not has_status_label:
		return

	if action_id == "visit_nidavellir" or is_nidavellir:
		if gs == null or gs.nidavellir_engine == null or not gs.nidavellir_engine.has_method("begin_nidavellir_visit"):
			world_actions_status_label.text = "Niðavellir is not reachable right now."
			return

		var nidavellir_result: Dictionary = gs.nidavellir_engine.begin_nidavellir_visit()
		world_actions_status_label.text = str(nidavellir_result.get("text", "Niðavellir glows at the edge of space."))

		var nidavellir_scenario_raw: Variant = nidavellir_result.get("scenario_result", {})
		if typeof(nidavellir_scenario_raw) == TYPE_DICTIONARY and not (nidavellir_scenario_raw as Dictionary).is_empty():
			_refresh_scenario_ui_from_result(nidavellir_scenario_raw as Dictionary)

		return

	if action_id == "travel_vormir" or is_vormir:
		if gs == null or gs.vormir_engine == null or not gs.vormir_engine.has_method("begin_vormir_travel"):
			world_actions_status_label.text = "Vormir is not reachable right now."
			return

		var result: Dictionary = gs.vormir_engine.begin_vormir_travel()
		world_actions_status_label.text = str(result.get("text", "Vormir has answered."))

		var scenario_result_raw: Variant = result.get("scenario_result", {})
		if typeof(scenario_result_raw) == TYPE_DICTIONARY and not (scenario_result_raw as Dictionary).is_empty():
			_refresh_scenario_ui_from_result(scenario_result_raw as Dictionary)

		return

	match action_id:
		"migrate":
			if is_imaginative_realm:
				world_actions_status_label.text = "%s is not a migration surface. Route this through scenario-driven access, not settlement relocation." % place_name
			else:
				world_actions_status_label.text = "Migration routing staged for %s. Hook this next into your place-change / settlement selection flow." % place_name

		"vacation":
			if is_imaginative_realm:
				world_actions_status_label.text = "Vacation routing staged for %s. Hook this next into your ticket / travel flow with imaginative power, access-state, and protector-aware entry checks." % place_name
			else:
				world_actions_status_label.text = "Vacation routing staged for %s. Hook this next into your ticket / travel flow." % place_name

		"find_date":
			_show_other_country_romance_preference_popup(entry.duplicate(true))

		_:
			world_actions_status_label.text = "No world action route is registered yet for %s." % place_name
func _open_other_country_population_wall(
		entry: Dictionary
) -> void:
		if entry.is_empty():
			return

		var entry_name: String = str(
			entry.get(
				"name",
				"Country / Realm"
			)
		).strip_edges()
		var realm_raw: Variant = entry.get(
			"realm",
			{}
		)
		var realm: Dictionary = (
			realm_raw as Dictionary
			if typeof(realm_raw) == TYPE_DICTIONARY
			else {}
		)

		if MainSceneHelpers._other_country_population_entry_should_hide(
			entry,
			realm
		):
			var hidden_popup:= get_node_or_null(
				"OtherCountriesPopup"
			)
			var hidden_status: Label = null

			if hidden_popup != null:
				hidden_status = hidden_popup.find_child(
					"Status",
					true,
					false
				) as Label

			if hidden_status != null:
				hidden_status.text = (
					"%s does not expose a normal population wall."
					% entry_name
				)

			return

		var realm_id: int = int(
			entry.get(
				"realm_id",
				realm.get(
					"realm_id",
					realm.get(
						"id",
						-1
					)
				)
			)
		)
		var realm_name: String = (
			MainSceneHelpers._other_country_population_realm_name_from_entry(
				entry,
				realm
			)
		)

		if realm_id <= 0:
			var unresolved_popup:= get_node_or_null(
				"OtherCountriesPopup"
			)
			var unresolved_status: Label = null

			if unresolved_popup != null:
				unresolved_status = unresolved_popup.find_child(
					"Status",
					true,
					false
				) as Label

			if unresolved_status != null:
				unresolved_status.text = (
					"%s has not published a stable realm identity "
					+ "into the resident browser contract yet."
				) % entry_name

			set_meta(
				"other_country_population_click_realm_lookup_performed",
				false
			)
			set_meta(
				"other_country_population_click_materialization_performed",
				false
			)
			return

		if realm_name == "":
			realm_name = entry_name

		crown_population_wall_last_realm_id = (
			realm_id
		)
		crown_population_wall_last_realm_name = (
			realm_name
		)

		if (
			standard_tab_popup_open
			and standard_tab_popup_kind
			== "other_country_overview"
		):
			_hide_standard_tab_popup()

		var other_countries_popup:= get_node_or_null(
			"OtherCountriesPopup"
		)
		var return_to_other_countries: bool = (
			other_countries_popup != null
			and other_countries_popup.visible
		)

		if return_to_other_countries:
			other_countries_popup.visible = false
			other_countries_popup.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		_show_crown_action_popup(
			"population",
			{
				"target_realm_id": realm_id,
				"target_realm_name": realm_name,
				"entry": entry.duplicate(false),
				"realm": realm.duplicate(false),
				"source": "other_countries_population_wall",
				"intent_is_not_action": true,
				"ui_is_renderer_only": true,
				"click_path_build_forbidden": true,
				"click_path_materialization_forbidden": true,
				"return_to_other_countries_popup": (
					return_to_other_countries
				)
			}
		)

		set_meta(
			"other_country_population_click_realm_id",
			realm_id
		)
		set_meta(
			"other_country_population_click_realm_lookup_performed",
			false
		)
		set_meta(
			"other_country_population_click_materialization_performed",
			false
		)
		set_meta(
			"other_country_population_click_engine_calls",
			false
		)
		set_meta(
			"other_country_population_click_contract_pointer_only",
			true
		)

		EraLog.truth(
			"ERALIFE_OTHER_COUNTRY_POPULATION_DOOR_TRUTH"
			+ "|realm_id=" + str(realm_id)
			+ "|realm_name=" + realm_name
			+ "|entry_contract_authoritative=true"
			+ "|realm_lookup_on_click=false"
			+ "|materialization_on_click=false"
			+ "|engine_calls=false"
			+ "|population_observation_armed_by_selection=true"
			+ "|population_observation_owned_by_resident_queue=true"
			+ "|at_ms="
			+ str(Time.get_ticks_msec())
		)
