func _ensure_relationships_hub_contract_engine() -> RelationshipsHubContractEngine:
	if gs != null:
		MainSceneLogic._ensure_universal_switch_contract_engine(gs)

		if gs.relationships_hub_contract_engine != null:
			relationships_hub_contract_engine = (
				gs.relationships_hub_contract_engine
			)

	if relationships_hub_contract_engine == null:


		relationships_hub_contract_engine = (
			RelationshipsHubContractEngine.new()
		)

	if gs != null:
		relationships_hub_contract_engine.bind_game_state(
			gs
		)
		relationships_hub_contract_engine.bind_switch_engine(
			gs.universal_switch_contract_engine
		)
		relationships_hub_contract_engine.bind_playable_life_viewer(
			_ensure_playable_life_viewer()
		)

	var destination_publication_callable: Callable = Callable(
		self,
		"_on_relationships_hub_resident_switch_destination_packet_published"
	)

	if not (
		relationships_hub_contract_engine
		.resident_switch_destination_packet_published
		.is_connected(
			destination_publication_callable
		)
	):
		relationships_hub_contract_engine \
.resident_switch_destination_packet_published \
.connect(
				destination_publication_callable
			)

	return relationships_hub_contract_engine
func _on_relationships_hub_resident_switch_destination_packet_published(
	target_id: int,
	switch_packet: Dictionary
) -> void:
	if (
		target_id <= 0
		or switch_packet.is_empty()
	):
		return

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
		or int(
			relationship_profile_panel.active_target_id
		) != target_id
	):
		return



	var packet_core_hot: bool = (
		_relationship_profile_switch_packet_core_hot(
			switch_packet,
			target_id
		)
	)

	if not packet_core_hot:
		set_meta(
			"relationship_profile_live_destination_publication_rejected",
			true
		)
		set_meta(
			"relationship_profile_live_destination_publication_target_id",
			target_id
		)
		set_meta(
			"relationship_profile_live_destination_publication_reason",
			"universal_switch_core_not_hot"
		)
		return



	var installed: bool = (
		relationship_profile_panel
		.install_resident_switch_packet(
			switch_packet
		)
	)

	if not installed:
		return

	_clear_relationship_profile_switch_destination_upgrade_request(
		target_id,
		"universal_switch_core_packet_published_live"
	)

	if (
		relationship_profile_panel.status_label != null
		and is_instance_valid(
			relationship_profile_panel.status_label
		)
	):
		relationship_profile_panel.status_label.text = (
			"Viewpoint destination ready."
		)

	set_meta(
		"relationship_profile_live_destination_packet_installed",
		true
	)
	set_meta(
		"relationship_profile_live_destination_packet_actor_id",
		target_id
	)
	set_meta(
		"relationship_profile_live_destination_packet_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"relationship_profile_live_destination_packet_engine_calls",
		false
	)
	set_meta(
		"relationship_profile_live_destination_packet_build_on_press",
		false
	)
	set_meta(
		"relationship_profile_live_destination_packet_ready_gate_member",
		false
	)
	set_meta(
		"relationship_profile_live_destination_support_deck_required",
		false
	)
	set_meta(
		"relationship_profile_live_destination_readiness_authority",
		"UniversalSwitchContractEngine"
	)

