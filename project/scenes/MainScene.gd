func _stage_pending_situations_for_god_mode_zero_frame_entry(
	snapshot: Dictionary,
	reason: String = "god_mode_pending_zero_frame"
) -> Dictionary:
	var out: Dictionary = snapshot.duplicate(false)

	if gs == null or gs.player == null:
		out ["pending_situations_count"] = 0
		out ["pending_situations_zero_frame_ready"] = false
		return out

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var actor_id: int = int(gs.player.id)
	var count: int = int(
		out.get(
			"pending_situations_count",
			gs.scenario_state.get(
				"pending_situations_count",
				0
			)
		)
	)
	var summary_raw: Variant = out.get(
		"pending_situations_summary",
		gs.scenario_state.get(
			"pending_situations_zero_frame_summary",
			{}
		)
	)
	var summary_contract: Dictionary = (
		(summary_raw as Dictionary).duplicate(false)
		if typeof(summary_raw) == TYPE_DICTIONARY
		else {}
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	out ["pending_situations_count"] = maxi(0, count)
	out ["pending_situations_summary"] = summary_contract
	out ["pending_situations_zero_frame_ready"] = true
	out ["pending_situations_zero_frame_actor_id"] = actor_id
	out ["pending_situations_zero_frame_reason"] = reason
	out ["pending_situations_zero_frame_at_ms"] = now_ms
	out ["pending_situations_summary_projection_pending"] = (
		summary_contract.is_empty()
	)
	out ["pending_situations_stage_called_engine"] = false
	out ["pending_situations_stage_created_baseline"] = false
	out ["pending_situations_ready_gate_member"] = false

	gs.scenario_state ["pending_situations_zero_frame_ready"] = true
	gs.scenario_state ["pending_situations_zero_frame_actor_id"] = actor_id
	gs.scenario_state ["pending_situations_zero_frame_count"] = maxi(
		0,
		count
	)
	gs.scenario_state ["pending_situations_count"] = maxi(
		0,
		count
	)
	gs.scenario_state ["pending_situations_zero_frame_summary"] = (
		summary_contract
	)
	gs.scenario_state ["pending_situations_zero_frame_reason"] = reason
	gs.scenario_state ["pending_situations_zero_frame_at_ms"] = now_ms
	gs.scenario_state [
		"pending_situations_summary_projection_pending"
	] = summary_contract.is_empty()
	gs.scenario_state ["pending_situations_stage_called_engine"] = false
	gs.scenario_state ["pending_situations_stage_created_baseline"] = false
	gs.scenario_state ["pending_situations_ready_gate_member"] = false

	_paint_pending_situations_button_from_zero_frame_truth(
		out,
		"%s_stage_button" % reason
	)

	return out
func _paint_pending_situations_button_from_zero_frame_truth(snapshot: Dictionary = {}, reason: String = "pending_situations_zero_frame_truth") -> void:
	if pending_situations_button == null or not is_instance_valid(pending_situations_button):
		return

	if gs == null or gs.player == null:
		pending_situations_button.visible = false
		pending_situations_button.disabled = true
		pending_situations_button.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pending_situations_button.text = "Pending Situations (0)"
		pending_situations_button.tooltip_text = "No controlled person is available."
		return

	var clean_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(snapshot)
	var actor: Person = gs.player
	var actor_id: int = int(actor.id)

	var snapshot_actor_id: int = int(clean_snapshot.get("pending_situations_zero_frame_actor_id", actor_id))
	if snapshot_actor_id != actor_id:
		set_meta("pending_situations_zero_frame_snapshot_rejected_wrong_actor", true)
		set_meta("pending_situations_zero_frame_snapshot_actor_id", snapshot_actor_id)
		set_meta("pending_situations_zero_frame_current_actor_id", actor_id)
		return

	var count: int = -1
	if clean_snapshot.has("pending_situations_count"):
		count = int(clean_snapshot.get("pending_situations_count", 0))

	if count < 0 and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var staged_actor_id: int = int(gs.scenario_state.get("pending_situations_zero_frame_actor_id", actor_id))
		if staged_actor_id == actor_id:
			count = int(gs.scenario_state.get("pending_situations_zero_frame_count", 0))

	if count < 0:
		count = _pending_situations_lens_count_for_actor(
			actor,
			clean_snapshot,
			"%s_actor_locked_fallback" % reason
		)

	_paint_pending_situations_button_for_actor_lens(
		actor,
		count,
		reason
	)

	set_meta("pending_situations_button_painted_from_zero_frame_truth", true)
	set_meta("pending_situations_button_zero_frame_count", max(0, count))
	set_meta("pending_situations_button_zero_frame_actor_id", actor_id)
	set_meta("pending_situations_button_zero_frame_reason", reason)
	set_meta("pending_situations_button_zero_frame_at_ms", int(Time.get_ticks_msec()))

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["pending_situations_button_painted_from_zero_frame_truth"] = true
		gs.scenario_state ["pending_situations_button_zero_frame_count"] = max(0, count)
		gs.scenario_state ["pending_situations_button_zero_frame_actor_id"] = actor_id
		gs.scenario_state ["pending_situations_button_zero_frame_reason"] = reason
		gs.scenario_state ["pending_situations_button_zero_frame_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["pending_situations_count"] = max(0, count)
