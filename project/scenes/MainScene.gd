func _set_main_gameplay_ui_visible(
	should_show: bool
) -> void:
	if not should_show and _god_mode_runtime_severed():
		var firewall:= (
			_ensure_god_mode_runtime_firewall_engine()
		)

		if firewall != null:
			firewall.confess(
				"_set_main_gameplay_ui_visible",
				"hide_gameplay_ui_blocked",
				"god_mode_runtime_severed",
				true
			)

		_enforce_playable_life_surface_authority_now(
			"set_main_gameplay_ui_visible_blocked_by_firewall"
		)
		_queue_eralife_network_live_presence_after_visible_shell()
		return

	if not should_show and _ui_authority_should_block_hide_attempt(
		"_set_main_gameplay_ui_visible",
		"main_gameplay_ui_visible_false",
		"presentation_boundary_hide_request"
	):
		return

	if (
		not should_show
		and _god_mode_tracker_visual_handoff_active()
	):
		if (
			gs != null
			and typeof(
				gs.scenario_state
			) == TYPE_DICTIONARY
		):
			gs.scenario_state [
				"main_gameplay_ui_hide_blocked_by_god_mode_tracker"
			] = true
			gs.scenario_state [
				"main_gameplay_ui_hide_blocked_at_ms"
			] = int(
				Time.get_ticks_msec()
			)
		return

	if should_show:
		if gs == null or gs.player == null:
			return

		if _god_mode_tracker_visual_handoff_active():
			_terminate_main_menu_surface_for_playable_entry(
				"set_main_gameplay_ui_visible_god_mode_handoff"
			)

		if (
			_main_menu_surface_active()
			and not bool(
				get_meta(
					"main_menu_surface_terminated_for_playable_entry",
					false
				)
			)
		):
			return

		var snapshot: Dictionary = (
			_current_first_frame_ui_snapshot()
		)

		if snapshot.is_empty():
			snapshot = (
				_truth_first_god_mode_ready_snapshot(
					"set_main_gameplay_ui_visible"
				)
			)


		_seal_upgraded_playable_life_shell_surface(
			snapshot.duplicate(true),
			"set_main_gameplay_ui_visible"
		)
		_queue_eralife_network_live_presence_after_visible_shell()
		return

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root != null and is_instance_valid(root):
		root.visible = false
		root.mouse_filter = Control.MOUSE_FILTER_IGNORE
		root.process_mode = Node.PROCESS_MODE_INHERIT

	if (
		output_label != null
		and is_instance_valid(output_label)
	):
		output_label.visible = false
		output_label.scroll_active = false

	for key in ui_nav_buttons.keys():
		var button:= ui_nav_buttons.get(
			key,
			null
		) as Button

		if (
			button == null
			or not is_instance_valid(button)
		):
			continue

		button.visible = false
		button.disabled = true
		button.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_set_birth_shell_interactive_controls_visible(
		false
	)

	if (
		player_stats_overlay != null
		and is_instance_valid(player_stats_overlay)
	):
		player_stats_overlay.visible = false
		player_stats_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_hide_main_tab_surfaces_visual_only(
		"",
		"set_main_gameplay_ui_visible_false"
	)
	_close_runtime_floating_huds_for_god_mode()

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"main_gameplay_ui_visible"
		] = false
		gs.scenario_state [
			"main_gameplay_ui_visible_reason"
		] = "presentation_boundary_hidden"
		gs.scenario_state [
			"main_nav_buttons_visible"
		] = false
		gs.scenario_state [
			"age_up_button_visible"
		] = false
func _apply_fullscreen_god_mode_layout() -> void:
	if _god_mode_runtime_severed() or _god_mode_panel_runtime_terminated():
		_enforce_playable_life_surface_authority_now("apply_fullscreen_god_mode_layout_blocked_after_contract_emit")
		return

	if gs != null and gs.player != null:
		_enforce_playable_life_surface_authority_now("apply_fullscreen_god_mode_layout_blocked_live_player")
		return

	_set_main_gameplay_ui_visible(false)
	_ensure_god_mode_background_dim()

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		var palette:= _current_god_mode_palette()
		var panel_base: Color = Color(palette.get("panel_base", Color(0.17, 0.1, 0.27, 0.95)))
		var darker_dim:= Color(
			clamp(panel_base.r * 0.38, 0.0, 1.0),
			clamp(panel_base.g * 0.38, 0.0, 1.0),
			clamp(panel_base.b * 0.38, 0.0, 1.0),
			clamp(max(panel_base.a, 0.9) + 0.03, 0.88, 0.97)
		)

		god_mode_background_dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		god_mode_background_dim.offset_left = 0
		god_mode_background_dim.offset_top = 0
		god_mode_background_dim.offset_right = 0
		god_mode_background_dim.offset_bottom = 0
		god_mode_background_dim.visible = true
		god_mode_background_dim.color = darker_dim
		god_mode_background_dim.modulate = Color(1.0, 1.0, 1.0, 1.0)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		_apply_god_mode_start_panel_fullscreen_layout()

func _apply_centered_live_layout() -> void:
	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root == null:
		return

	var viewport_size: Vector2 = (
		get_viewport_rect().size
	)

	var density_contract: Dictionary = (
		ui_presentation_density_contract
	)

	var logical_raw: Variant = (
		density_contract.get(
			"logical_viewport",
			{}
		)
	)

	if typeof(logical_raw) == TYPE_DICTIONARY:
		var logical_viewport: Dictionary = (
			logical_raw as Dictionary
		)

		var logical_width: float = float(
			logical_viewport.get(
				"width",
				0.0
			)
		)

		var logical_height: float = float(
			logical_viewport.get(
				"height",
				0.0
			)
		)

		if (
			logical_width > 0.0
			and logical_height > 0.0
		):
			viewport_size = Vector2(
				logical_width,
				logical_height
			)

	var composition_contract: Dictionary = (
		ui_presentation_composition_contract
	)

	var shell_tokens_raw: Variant = (
		composition_contract.get(
			"root_shell",
			{}
		)
	)

	var shell_tokens: Dictionary = (
		shell_tokens_raw as Dictionary
		if typeof(
			shell_tokens_raw
		) == TYPE_DICTIONARY
		else {}
	)

	var stats_safe_width: float = float(
		shell_tokens.get(
			"stats_safe_width",
			126.0
		)
	)

	var gutter: float = float(
		shell_tokens.get(
			"gutter",
			18.0
		)
	)

	var left_rail_reserve: float = float(
		shell_tokens.get(
			"left_rail_reserve",
			303.0
		)
	)

	var playable_border_pad: float = float(
		shell_tokens.get(
			"playable_border_pad",
			18.0
		)
	)

	var minimum_usable_width: float = float(
		shell_tokens.get(
			"minimum_usable_width",
			360.0
		)
	)

	var minimum_content_width: float = float(
		shell_tokens.get(
			"minimum_content_width",
			860.0
		)
	)

	var default_content_ratio: float = float(
		shell_tokens.get(
			"default_content_ratio",
			0.68
		)
	)

	var wide_content_ratio: float = float(
		shell_tokens.get(
			"wide_content_ratio",
			0.74
		)
	)

	var ultrawide_content_ratio: float = float(
		shell_tokens.get(
			"ultrawide_content_ratio",
			0.78
		)
	)

	var wide_breakpoint: float = float(
		shell_tokens.get(
			"wide_breakpoint",
			1500.0
		)
	)

	var ultrawide_breakpoint: float = float(
		shell_tokens.get(
			"ultrawide_breakpoint",
			1900.0
		)
	)

	var diary_horizontal_padding: float = float(
		shell_tokens.get(
			"diary_horizontal_padding",
			24.0
		)
	)

	var diary_minimum_height: float = float(
		shell_tokens.get(
			"diary_minimum_height",
			360.0
		)
	)

	var nav_button_height: float = float(
		shell_tokens.get(
			"nav_button_height",
			30.0
		)
	)

	var age_up_button_height: float = float(
		shell_tokens.get(
			"age_up_button_height",
			34.0
		)
	)

	var usable_left_edge: float = (
		gutter
		+ left_rail_reserve
	)

	var usable_right_edge: float = (
		viewport_size.x
		- stats_safe_width
		- gutter
	)

	var usable_width: float = maxf(
		minimum_usable_width,
		usable_right_edge
		- usable_left_edge
	)

	var preferred_width: float = (
		viewport_size.x
		* default_content_ratio
	)

	if viewport_size.x >= wide_breakpoint:
		preferred_width = (
			viewport_size.x
			* wide_content_ratio
		)

	if viewport_size.x >= ultrawide_breakpoint:
		preferred_width = (
			viewport_size.x
			* ultrawide_content_ratio
		)

	var content_width: float = clampf(
		preferred_width,
		minimum_content_width,
		usable_width
	)

	var left: float = (
		usable_left_edge
		+ (
			(usable_width - content_width)
			* 0.5
		)
	)

	var right: float = (
		left
		+ content_width
	)

	left = maxf(
		playable_border_pad,
		left
	)

	right = minf(
		viewport_size.x
		- playable_border_pad,
		right
	)

	root.anchor_left = 0.0
	root.anchor_right = 0.0
	root.anchor_top = 0.0
	root.anchor_bottom = 1.0

	root.offset_left = left
	root.offset_right = right
	root.offset_top = gutter
	root.offset_bottom = - gutter

	root.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)

	root.size_flags_vertical = (
		Control.SIZE_EXPAND_FILL
	)

	var main_surface: Control = (
		output_label.get_parent() as Control
		if output_label != null
		else null
	)

	if main_surface != null:
		main_surface.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		main_surface.size_flags_vertical = (
			Control.SIZE_EXPAND_FILL
		)

		main_surface.custom_minimum_size = (
			Vector2.ZERO
		)

	if output_label != null:
		output_label.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		output_label.size_flags_vertical = (
			Control.SIZE_EXPAND_FILL
		)

		output_label.scroll_active = true

		output_label.custom_minimum_size = Vector2(
			maxf(
				0.0,
				content_width
				- diary_horizontal_padding
			),
			diary_minimum_height
		)

	for button_value in ui_nav_buttons.values():
		var nav_btn:= (
			button_value as Button
		)

		if nav_btn == null:
			continue

		var nav_key:= (
			MainSceneHelpers._normalize_ui_nav_button_text(
				nav_btn.text
			)
		)

		nav_btn.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		nav_btn.size_flags_vertical = (
			Control.SIZE_SHRINK_CENTER
		)

		nav_btn.custom_minimum_size = Vector2(
			0.0,
			(
				age_up_button_height
				if nav_key == "age_up"
				else nav_button_height
			)
		)
func _presentation_composition_stage_rect() -> Rect2:
	var viewport_size: Vector2 = (
		get_viewport_rect().size
	)

	var stage_raw: Variant = (
		ui_presentation_composition_contract.get(
			"canonical_stage",
			{}
		)
	)

	if typeof(stage_raw) == TYPE_DICTIONARY:
		var stage: Dictionary = (
			stage_raw as Dictionary
		)

		var stage_left: float = float(
			stage.get(
				"left",
				0.0
			)
		)

		var stage_top: float = float(
			stage.get(
				"top",
				0.0
			)
		)

		var stage_width: float = float(
			stage.get(
				"width",
				0.0
			)
		)

		var stage_height: float = float(
			stage.get(
				"height",
				0.0
			)
		)

		if (
			stage_width > 0.0
			and stage_height > 0.0
		):
			return Rect2(
				stage_left,
				stage_top,
				stage_width,
				stage_height
			)

	return Rect2(
		Vector2.ZERO,
		Vector2(
			maxf(
				1.0,
				viewport_size.x
			),
			maxf(
				1.0,
				viewport_size.y
			)
		)
	)
func _presentation_composition_choose_adventure_shell_size() -> Vector2:
	var menu_raw: Variant = (
		ui_presentation_composition_contract.get(
			"choose_adventure_entry",
			{}
		)
	)

	if typeof(menu_raw) == TYPE_DICTIONARY:
		var menu_contract: Dictionary = (
			menu_raw as Dictionary
		)

		var shell_width: float = float(
			menu_contract.get(
				"shell_width",
				0.0
			)
		)

		var shell_height: float = float(
			menu_contract.get(
				"shell_height",
				0.0
			)
		)

		if (
			shell_width > 0.0
			and shell_height > 0.0
		):
			return Vector2(
				shell_width,
				shell_height
			)

	var viewport_size: Vector2 = (
		get_viewport_rect().size
	)

	var occupancy_ratio: float = 0.85
	var card_count: int = 3
	var card_separation: float = 22.0
	var card_minimum_width: float = 350.0
	var card_minimum_height: float = 570.0

	var safe_viewport_width: float = maxf(
		1.0,
		viewport_size.x
	)

	var safe_viewport_height: float = maxf(
		1.0,
		viewport_size.y
	)

	var minimum_shell_width: float = minf(
		safe_viewport_width,
		(
			card_minimum_width
			* float(card_count)
		)
		+ (
			card_separation
			* float(
				maxi(
					0,
					card_count - 1
				)
			)
		)
	)

	var minimum_shell_height: float = minf(
		safe_viewport_height,
		card_minimum_height
	)

	return Vector2(
		minf(
			safe_viewport_width,
			maxf(
				minimum_shell_width,
				safe_viewport_width
				* occupancy_ratio
			)
		),
		minf(
			safe_viewport_height,
			maxf(
				minimum_shell_height,
				safe_viewport_height
				* occupancy_ratio
			)
		)
	)
func _apply_presentation_composition_to_resident_surfaces(
	reason: String = "viewport_resize"
) -> void:
	var stage_rect: Rect2 = (
		_presentation_composition_stage_rect()
	)

	var stage_left: float = (
		stage_rect.position.x
	)

	var stage_top: float = (
		stage_rect.position.y
	)

	var stage_right: float = (
		stage_rect.position.x
		+ stage_rect.size.x
	)

	var stage_bottom: float = (
		stage_rect.position.y
		+ stage_rect.size.y
	)

	if (
		startup_intro_overlay != null
