func _ensure_relationship_hub_panel() -> RelationshipHubPanel:
	if (
		relationship_hub_panel == null
		or not is_instance_valid(
			relationship_hub_panel
		)
	):
		relationship_hub_panel = get_node_or_null(
			"RelationshipHubPanel"
		) as RelationshipHubPanel

	if (
		relationship_hub_panel == null
		or not is_instance_valid(
			relationship_hub_panel
		)
	):
		relationship_hub_panel = RelationshipHubPanel.new()
		relationship_hub_panel.name = "RelationshipHubPanel"
		relationship_hub_panel.prepare_surface(
			"relationships"
		)
		add_child(
			relationship_hub_panel
		)
		relationship_hub_panel.hide_surface()

	var close_callable: Callable = Callable(
		self,
		"_on_relationship_hub_panel_close_requested"
	)
	var section_callable: Callable = Callable(
		self,
		"_on_relationship_hub_panel_section_requested"
	)
	var person_callable: Callable = Callable(
		self,
		"_on_relationship_hub_panel_person_requested"
	)
	var action_callable: Callable = Callable(
		self,
		"_on_relationship_hub_panel_action_requested"
	)

	if not relationship_hub_panel.close_requested.is_connected(
		close_callable
	):
		relationship_hub_panel.close_requested.connect(
			close_callable
		)

	if not relationship_hub_panel.section_requested.is_connected(
		section_callable
	):
		relationship_hub_panel.section_requested.connect(
			section_callable
		)

	if not relationship_hub_panel.person_requested.is_connected(
		person_callable
	):
		relationship_hub_panel.person_requested.connect(
			person_callable
		)

	if not relationship_hub_panel.action_requested.is_connected(
		action_callable
	):
		relationship_hub_panel.action_requested.connect(
			action_callable
		)

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		relationship_profile_panel = get_node_or_null(
			"RelationshipProfilePanel"
		) as RelationshipProfilePanel




	if (
		(
			relationship_profile_panel == null
			or not is_instance_valid(
				relationship_profile_panel
			)
		)
		and not bool(
			get_meta(
				"relationship_profile_shell_prewarm_scheduled",
				false
			)
		)
	):
		set_meta(
			"relationship_profile_shell_prewarm_scheduled",
			true
		)
		call_deferred(
			"_prewarm_relationship_profile_popup_shell_for_relationship_hub",
			"relationship_hub_panel_shell_ready"
		)
	elif (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		_bind_relationship_profile_panel_press_frame_switch()

	relationship_hub_panel.set_meta(
		"full_profile_shell_prewarm_scheduled",
		true
	)
	relationship_hub_panel.set_meta(
		"full_profile_open_build_forbidden",
		true
	)
	relationship_hub_panel.set_meta(
		"full_profile_shell_ready_gate_member",
		false
	)

	return relationship_hub_panel

