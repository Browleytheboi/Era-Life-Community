func _show_era_border_overlay_for_current_era(reset_reveal: bool = true) -> void:
	_ensure_era_border_overlay()

	var theme_key: String = MainSceneLogic._era_border_theme_key_from_world(gs)
	var theme_data: Dictionary = MainSceneHelpers._era_border_theme_data(theme_key)

	era_border_theme_key = theme_key
	era_border_active_core = theme_data ["core"]
	era_border_target_core = theme_data ["core"]
	era_border_active_glow = theme_data ["glow"]
	era_border_target_glow = theme_data ["glow"]
	era_border_active_thickness = float(theme_data ["thickness"])
	era_border_target_thickness = float(theme_data ["thickness"])
	era_border_active_glow_thickness = float(theme_data ["glow_thickness"])
	era_border_target_glow_thickness = float(theme_data ["glow_thickness"])
	era_border_active_pulse = float(theme_data ["pulse"])
	era_border_target_pulse = float(theme_data ["pulse"])

	if reset_reveal:
		era_border_reveal_progress = 0.0
		era_border_phase = 0.0
	else:
		era_border_reveal_progress = 1.0

	era_border_reveal_target = 1.0

	if era_border_overlay != null and is_instance_valid(era_border_overlay):
		era_border_overlay.visible = true
		era_border_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
		era_border_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
		era_border_overlay.process_mode = Node.PROCESS_MODE_INHERIT
		era_border_overlay.z_as_relative = false
		era_border_overlay.z_index = 75
		era_border_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		era_border_overlay.offset_left = 0.0
		era_border_overlay.offset_top = 0.0
		era_border_overlay.offset_right = 0.0
		era_border_overlay.offset_bottom = 0.0

		era_border_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		era_border_overlay.offset_left = 0.0
		era_border_overlay.offset_top = 0.0
		era_border_overlay.offset_right = 0.0
		era_border_overlay.offset_bottom = 0.0

		set_meta("era_border_claimed_by_playable_life_shell", true)
		set_meta("era_border_claimed_at_ms", int(Time.get_ticks_msec()))

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["era_border_claimed_by_playable_life_shell"] = true
			gs.scenario_state ["era_border_visible_on_playable_shell"] = true
			gs.scenario_state ["era_border_claimed_at_ms"] = int(Time.get_ticks_msec())

	_layout_era_border_overlay()
func _sync_era_border_theme_from_world() -> void:
	if era_border_overlay == null or gs == null or gs.era == null:
		return

	var next_theme_key: String = MainSceneLogic._era_border_theme_key_from_world(gs)
	if next_theme_key == era_border_theme_key:
		return

	era_border_theme_key = next_theme_key
	var theme_data: Dictionary = MainSceneHelpers._era_border_theme_data(next_theme_key)

	era_border_target_core = theme_data ["core"]
	era_border_target_glow = theme_data ["glow"]
	era_border_target_thickness = float(theme_data ["thickness"])
	era_border_target_glow_thickness = float(theme_data ["glow_thickness"])
	era_border_target_pulse = float(theme_data ["pulse"])

func _layout_era_border_overlay() -> void:
	if era_border_overlay == null or not is_instance_valid(era_border_overlay):
		return

	era_border_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	era_border_overlay.offset_left = 0.0
	era_border_overlay.offset_top = 0.0
	era_border_overlay.offset_right = 0.0
	era_border_overlay.offset_bottom = 0.0

	var viewport_size: Vector2 = get_viewport_rect().size
	var w: float = viewport_size.x
	var h: float = viewport_size.y

	if w <= 0.0 or h <= 0.0:
		w = era_border_overlay.size.x
		h = era_border_overlay.size.y

	if w <= 0.0 or h <= 0.0:
		return
	var theme_data: Dictionary = MainSceneHelpers._era_border_theme_data(era_border_theme_key)

	var core_t: float = era_border_active_thickness
	var glow_t: float = era_border_active_glow_thickness
	var inner_inset: float = float(theme_data.get("inner_inset", 4.0))
	var shadow_alpha: float = float(theme_data.get("shadow_alpha", 0.16))
	var corner_alpha: float = float(theme_data.get("corner_alpha", 0.1))
	var pulse_speed: float = float(theme_data.get("pulse_speed", 1.0))
	var corner_scale: float = float(theme_data.get("corner_scale", 1.0))
	var highlight_t: float = float(theme_data.get("highlight_thickness", 1.5))
	var overlay_ratio: float = float(theme_data.get("overlay_width_ratio", 0.18))
	var overlay_speed: float = float(theme_data.get("overlay_speed", 0.35))

	var top_mult: float = float(theme_data.get("top_mult", 1.0))
	var right_mult: float = float(theme_data.get("right_mult", 1.0))
	var bottom_mult: float = float(theme_data.get("bottom_mult", 1.0))
	var left_mult: float = float(theme_data.get("left_mult", 1.0))

	var top_t: float = max(1.0, core_t * top_mult)
	var right_t: float = max(1.0, core_t * right_mult)
	var bottom_t: float = max(1.0, core_t * bottom_mult)
	var left_t: float = max(1.0, core_t * left_mult)

	var perimeter: float = (w * 2.0) + (h * 2.0)
	var travelled: float = perimeter * clamp(era_border_reveal_progress, 0.0, 1.0)

	var top_len: float = clamp(travelled, 0.0, w)
	travelled = max(travelled - w, 0.0)

	var right_len: float = clamp(travelled, 0.0, h)
	travelled = max(travelled - h, 0.0)

	var bottom_len: float = clamp(travelled, 0.0, w)
	travelled = max(travelled - w, 0.0)

	var left_len: float = clamp(travelled, 0.0, h)

	var inner_shadow_top: ColorRect = era_border_overlay.get_node_or_null("InnerShadowTop") as ColorRect
	var inner_shadow_right: ColorRect = era_border_overlay.get_node_or_null("InnerShadowRight") as ColorRect
	var inner_shadow_bottom: ColorRect = era_border_overlay.get_node_or_null("InnerShadowBottom") as ColorRect
	var inner_shadow_left: ColorRect = era_border_overlay.get_node_or_null("InnerShadowLeft") as ColorRect

	var highlight_top: ColorRect = era_border_overlay.get_node_or_null("HighlightTop") as ColorRect
	var highlight_right: ColorRect = era_border_overlay.get_node_or_null("HighlightRight") as ColorRect
	var highlight_bottom: ColorRect = era_border_overlay.get_node_or_null("HighlightBottom") as ColorRect
	var highlight_left: ColorRect = era_border_overlay.get_node_or_null("HighlightLeft") as ColorRect

	var overlay_top: ColorRect = era_border_overlay.get_node_or_null("OverlayTop") as ColorRect
	var overlay_right: ColorRect = era_border_overlay.get_node_or_null("OverlayRight") as ColorRect
	var overlay_bottom: ColorRect = era_border_overlay.get_node_or_null("OverlayBottom") as ColorRect
	var overlay_left: ColorRect = era_border_overlay.get_node_or_null("OverlayLeft") as ColorRect

	var corner_tl: ColorRect = era_border_overlay.get_node_or_null("CornerTL") as ColorRect
	var corner_tr: ColorRect = era_border_overlay.get_node_or_null("CornerTR") as ColorRect
	var corner_br: ColorRect = era_border_overlay.get_node_or_null("CornerBR") as ColorRect
	var corner_bl: ColorRect = era_border_overlay.get_node_or_null("CornerBL") as ColorRect

	var material_pulse: float = (sin(era_border_phase * pulse_speed) + 1.0) * 0.5

	match era_border_theme_key:
		"ancient":
			material_pulse = clamp(
				0.46
				+ (sin(era_border_phase * 1.07) * 0.15)
				+ (sin(era_border_phase * 3.77 + 0.71) * 0.09)
				+ (sin(era_border_phase * 7.13 + 1.94) * 0.04),
				0.0,
				1.0
			)
		"medieval":
			material_pulse = clamp(0.18 + sin(era_border_phase * 0.45) * 0.02, 0.0, 1.0)
		"modern":
			material_pulse = clamp(0.08 + sin(era_border_phase * 0.35) * 0.01, 0.0, 1.0)
		"future":
			material_pulse = clamp(
				0.5
				+ (sin(era_border_phase * 2.2) * 0.2)
				+ (cos(era_border_phase * 5.2) * 0.12),
				0.0,
				1.0
			)

	var glow_color: Color = era_border_active_glow
	glow_color.a = clamp(glow_color.a + era_border_active_pulse * (0.05 + 0.2 * material_pulse), 0.0, 1.0)

	var base_color: Color = era_border_active_core
	var highlight_color: Color = Color(theme_data.get("highlight", Color(1, 1, 1, 0.12)))
	var overlay_color: Color = Color(theme_data.get("overlay", Color(1, 1, 1, 0.08)))
	var hot_corner_color: Color = Color(theme_data.get("hot_corner", glow_color))
	var inner_shadow_color: Color = Color(0.0, 0.0, 0.0, shadow_alpha)

	match era_border_theme_key:
		"ancient":
			base_color = base_color.lerp(Color(0.74, 0.6, 0.4, base_color.a), 0.1 * material_pulse)
			highlight_color = highlight_color.lerp(Color(1.0, 0.88, 0.66, highlight_color.a), 0.18)
			glow_color = glow_color.lerp(Color(1.0, 0.76, 0.42, glow_color.a), 0.18)
			overlay_color.a *= 0.8 + material_pulse * 0.26
			hot_corner_color = hot_corner_color.lerp(Color(1.0, 0.88, 0.64, hot_corner_color.a), 0.18 * material_pulse)
			inner_shadow_color = Color(0.13, 0.08, 0.03, shadow_alpha * (0.9 + 0.18 * material_pulse))

		"medieval":
			base_color = base_color.lerp(Color(0.38, 0.43, 0.5, base_color.a), 0.05 * material_pulse)
			highlight_color.a *= 0.95
			glow_color.a *= 0.32
			overlay_color.a *= 0.35
			hot_corner_color.a *= 0.42
			inner_shadow_color = Color(0.02, 0.03, 0.05, shadow_alpha)

		"modern":
			base_color = base_color.lerp(Color(0.98, 0.99, 1.0, base_color.a), 0.04)
			highlight_color.a *= 0.55
			glow_color.a *= 0.2
			overlay_color.a *= 0.2
			hot_corner_color.a *= 0.18
			inner_shadow_color = Color(0.0, 0.0, 0.0, shadow_alpha * 0.55)

		"future":
			base_color = base_color.lerp(Color(0.74, 0.5, 1.0, base_color.a), 0.18 * material_pulse)
			highlight_color = highlight_color.lerp(Color(0.96, 1.0, 1.0, highlight_color.a), 0.16)
			glow_color = glow_color.lerp(Color(0.34, 1.0, 1.0, glow_color.a), 0.14 * material_pulse)
			overlay_color = overlay_color.lerp(Color(0.58, 1.0, 1.0, overlay_color.a), 0.12 * material_pulse)
			hot_corner_color = hot_corner_color.lerp(Color(0.86, 1.0, 1.0, hot_corner_color.a), 0.18 * material_pulse)
			inner_shadow_color = Color(0.02, 0.03, 0.06, shadow_alpha * 0.7)

	era_border_glow_top.color = glow_color
	era_border_glow_right.color = glow_color
	era_border_glow_bottom.color = glow_color
	era_border_glow_left.color = glow_color

	era_border_top.color = base_color
	era_border_right.color = base_color
	era_border_bottom.color = base_color
	era_border_left.color = base_color

	era_border_glow_top.position = Vector2(0.0, 0.0)
	era_border_glow_top.size = Vector2(top_len, glow_t)

	era_border_glow_right.position = Vector2(w - glow_t, 0.0)
	era_border_glow_right.size = Vector2(glow_t, right_len)

	era_border_glow_bottom.position = Vector2(w - bottom_len, h - glow_t)
	era_border_glow_bottom.size = Vector2(bottom_len, glow_t)

	era_border_glow_left.position = Vector2(0.0, h - left_len)
	era_border_glow_left.size = Vector2(glow_t, left_len)

	era_border_top.position = Vector2(0.0, 0.0)
	era_border_top.size = Vector2(top_len, top_t)

	era_border_right.position = Vector2(w - right_t, 0.0)
	era_border_right.size = Vector2(right_t, right_len)

	era_border_bottom.position = Vector2(w - bottom_len, h - bottom_t)
	era_border_bottom.size = Vector2(bottom_len, bottom_t)

	era_border_left.position = Vector2(0.0, h - left_len)
	era_border_left.size = Vector2(left_t, left_len)

	var inner_shadow_t_top: float = max(1.0, top_t * 0.52)
	var inner_shadow_t_right: float = max(1.0, right_t * 0.52)
	var inner_shadow_t_bottom: float = max(1.0, bottom_t * 0.52)
	var inner_shadow_t_left: float = max(1.0, left_t * 0.52)

	var inner_top_len: float = max(0.0, top_len - inner_inset * 2.0)
	var inner_right_len: float = max(0.0, right_len - inner_inset * 2.0)
	var inner_bottom_len: float = max(0.0, bottom_len - inner_inset * 2.0)
	var inner_left_len: float = max(0.0, left_len - inner_inset * 2.0)

	if inner_shadow_top != null:
		inner_shadow_top.color = inner_shadow_color
		inner_shadow_top.position = Vector2(inner_inset, inner_inset)
		inner_shadow_top.size = Vector2(inner_top_len, inner_shadow_t_top)

	if inner_shadow_right != null:
		inner_shadow_right.color = inner_shadow_color
		inner_shadow_right.position = Vector2(w - inner_inset - inner_shadow_t_right, inner_inset)
		inner_shadow_right.size = Vector2(inner_shadow_t_right, inner_right_len)

	if inner_shadow_bottom != null:
		inner_shadow_bottom.color = inner_shadow_color
		inner_shadow_bottom.position = Vector2(w - inner_inset - inner_bottom_len, h - inner_inset - inner_shadow_t_bottom)
		inner_shadow_bottom.size = Vector2(inner_bottom_len, inner_shadow_t_bottom)

	if inner_shadow_left != null:
		inner_shadow_left.color = inner_shadow_color
		inner_shadow_left.position = Vector2(inner_inset, h - inner_inset - inner_left_len)
		inner_shadow_left.size = Vector2(inner_shadow_t_left, inner_left_len)

	var highlight_len_top: float = max(0.0, top_len - 4.0)
	var highlight_len_right: float = max(0.0, right_len - 4.0)
	var highlight_len_bottom: float = max(0.0, bottom_len - 4.0)
	var highlight_len_left: float = max(0.0, left_len - 4.0)

	if highlight_top != null:
		highlight_top.color = highlight_color
		highlight_top.position = Vector2(2.0, max(1.0, top_t * 0.2))
		highlight_top.size = Vector2(highlight_len_top, max(1.0, highlight_t))

	if highlight_right != null:
		highlight_right.color = highlight_color
		highlight_right.position = Vector2(w - right_t + max(0.0, right_t * 0.18), 2.0)
		highlight_right.size = Vector2(max(1.0, highlight_t), highlight_len_right)

	if highlight_bottom != null:
		highlight_bottom.color = highlight_color
		highlight_bottom.position = Vector2(w - bottom_len + 2.0, h - bottom_t + max(0.0, bottom_t * 0.18))
		highlight_bottom.size = Vector2(highlight_len_bottom, max(1.0, highlight_t))

	if highlight_left != null:
		highlight_left.color = highlight_color
		highlight_left.position = Vector2(max(1.0, left_t * 0.2), h - left_len + 2.0)
		highlight_left.size = Vector2(max(1.0, highlight_t), highlight_len_left)

	var overlay_progress: float = fposmod(era_border_phase * overlay_speed, 1.0)

	var overlay_top_w: float = max(0.0, top_len * overlay_ratio)
	var overlay_right_h: float = max(0.0, right_len * overlay_ratio)
	var overlay_bottom_w: float = max(0.0, bottom_len * overlay_ratio)
	var overlay_left_h: float = max(0.0, left_len * overlay_ratio)

	if overlay_top != null:
		overlay_top.color = overlay_color
		var overlay_top_x: float = lerp(0.0, max(0.0, top_len - overlay_top_w), overlay_progress)
		overlay_top.position = Vector2(overlay_top_x, 0.0)
		overlay_top.size = Vector2(overlay_top_w, top_t)

	if overlay_right != null:
		overlay_right.color = overlay_color
		var overlay_right_y: float = lerp(0.0, max(0.0, right_len - overlay_right_h), fposmod(overlay_progress + 0.25, 1.0))
		overlay_right.position = Vector2(w - right_t, overlay_right_y)
		overlay_right.size = Vector2(right_t, overlay_right_h)

	if overlay_bottom != null:
		overlay_bottom.color = overlay_color
		var overlay_bottom_x: float = lerp(0.0, max(0.0, bottom_len - overlay_bottom_w), 1.0 - fposmod(overlay_progress + 0.5, 1.0))
		overlay_bottom.position = Vector2(w - bottom_len + overlay_bottom_x, h - bottom_t)
		overlay_bottom.size = Vector2(overlay_bottom_w, bottom_t)

	if overlay_left != null:
		overlay_left.color = overlay_color
		var overlay_left_y: float = lerp(0.0, max(0.0, left_len - overlay_left_h), 1.0 - fposmod(overlay_progress + 0.75, 1.0))
		overlay_left.position = Vector2(0.0, h - left_len + overlay_left_y)
		overlay_left.size = Vector2(left_t, overlay_left_h)

	var corner_size: float = max(glow_t * corner_scale, core_t * 1.6)

	var tl_visible: bool = top_len > 0.0
	var tr_visible: bool = right_len > 0.0 or top_len >= w
	var br_visible: bool = bottom_len > 0.0 or right_len >= h
	var bl_visible: bool = left_len > 0.0 or bottom_len >= w

	var corner_color: Color = hot_corner_color
	corner_color.a = clamp(corner_alpha + (material_pulse * corner_color.a), 0.0, 1.0)

	if corner_tl != null:
		corner_tl.color = corner_color if tl_visible else Color(0, 0, 0, 0)
		corner_tl.position = Vector2(0.0, 0.0)
		corner_tl.size = Vector2(corner_size if tl_visible else 0.0, corner_size if tl_visible else 0.0)

	if corner_tr != null:
		corner_tr.color = corner_color if tr_visible else Color(0, 0, 0, 0)
		corner_tr.position = Vector2(w - corner_size, 0.0)
		corner_tr.size = Vector2(corner_size if tr_visible else 0.0, corner_size if tr_visible else 0.0)

	if corner_br != null:
		corner_br.color = corner_color if br_visible else Color(0, 0, 0, 0)
		corner_br.position = Vector2(w - corner_size, h - corner_size)
		corner_br.size = Vector2(corner_size if br_visible else 0.0, corner_size if br_visible else 0.0)

	if corner_bl != null:
		corner_bl.color = corner_color if bl_visible else Color(0, 0, 0, 0)
		corner_bl.position = Vector2(0.0, h - corner_size)
		corner_bl.size = Vector2(corner_size if bl_visible else 0.0, corner_size if bl_visible else 0.0)

	_update_era_border_particles(w, h, era_border_theme_key, theme_data, material_pulse)


func _animate_era_border_overlay(delta: float) -> void:
	if era_border_overlay == null or not is_instance_valid(era_border_overlay):
		return

	var root:= get_node_or_null("UIContainer") as Control
	var playable_shell_visible: bool = (
		_playable_life_shell_has_visible_sovereignty()
		or (
			gs != null
			and gs.player != null
			and root != null
			and is_instance_valid(root)
			and root.visible
		)
	)

	if gs == null or gs.player == null or gs.awaiting_new_life:
		era_border_overlay.visible = false
		return

	if _god_mode_ui_locked() and not playable_shell_visible:
		era_border_overlay.visible = false
		return

	era_border_overlay.visible = true
	era_border_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var now_ms: int = int(Time.get_ticks_msec())
	var fast_until_ms: int = int(get_meta("spawn_ready_era_border_fast_until_ms", 0))

	_sync_era_border_theme_from_world()

	var theme_data: Dictionary = MainSceneHelpers._era_border_theme_data(era_border_theme_key)
	var phase_speed: float = float(theme_data.get("pulse_speed", 1.0))
	var base_pulse: float = float(theme_data.get("pulse", 0.04))

	era_border_reveal_target = 1.0
	era_border_target_thickness = max(era_border_target_thickness, float(theme_data.get("thickness", 4.0)))
	era_border_target_glow_thickness = max(era_border_target_glow_thickness, float(theme_data.get("glow_thickness", 6.0)))
	era_border_target_pulse = max(era_border_target_pulse, base_pulse, 0.18)

	era_border_phase += delta * max(0.35, phase_speed)

	if fast_until_ms > 0 and now_ms <= fast_until_ms:
		era_border_reveal_progress = 1.0
		era_border_reveal_target = 1.0
	else:
		era_border_reveal_progress = move_toward(
			era_border_reveal_progress,
			era_border_reveal_target,
			delta * 6.0
		)

	era_border_active_thickness = move_toward(
		era_border_active_thickness,
		era_border_target_thickness,
		delta * 22.0
	)

	era_border_active_glow_thickness = move_toward(
		era_border_active_glow_thickness,
		era_border_target_glow_thickness,
		delta * 28.0
	)

	var living_pulse: float = 0.5 + (0.5 * sin(era_border_phase * max(0.85, phase_speed)))
	var target_living_pulse: float = max(era_border_target_pulse, base_pulse + (living_pulse * 0.22))
	era_border_active_pulse = move_toward(
		era_border_active_pulse,
		target_living_pulse,
		delta * 5.5
	)

	var color_lerp_t: float = min(1.0, delta * 4.5)
	if era_border_theme_key == "future":
		color_lerp_t = min(1.0, delta * 5.5)
	elif era_border_theme_key == "modern":
		color_lerp_t = min(1.0, delta * 3.2)
	elif era_border_theme_key == "ancient":
		color_lerp_t = min(1.0, delta * 4.0)

	era_border_active_core = era_border_active_core.lerp(era_border_target_core, color_lerp_t)
	era_border_active_glow = era_border_active_glow.lerp(era_border_target_glow, color_lerp_t)

	_layout_era_border_overlay()
func _world_seed_ui_lens_key() -> String:
	var epoch: int = int(get_meta("world_seed_ui_lens_epoch", 0))
	var era_name: String = "unknown_era"
	var year_value: int = -999999

	if gs != null:
		year_value = int(gs.year)
		if gs.era != null:
			era_name = str(gs.era.name).strip_edges()

	return "world_lens:%d|era:%s|year:%d" % [
		epoch,
		era_name,
		year_value
	]
func _main_menu_surface_active() -> bool:
