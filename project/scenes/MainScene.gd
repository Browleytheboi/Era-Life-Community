func _relationship_hub_render_section_now(section: String, reason: String = "relationship_section_change") -> void:
	_relationship_hub_claim_visible_input_surface(reason)

	if not _relationship_hub_runtime_surface_active():
		return

	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)

	institution_hub_kind = "relationships"
	institution_hub_open = true
	current_panel = "relationships"
	institution_hub_current_section = clean_section
	relationships_hub_active_section_id = clean_section
	set_meta("relationship_hub_last_section_refresh_reason", reason)
	set_meta("relationship_hub_last_section_refresh_ms", int(Time.get_ticks_msec()))
	set_meta("relationship_hub_pending_section_render", "")
	set_meta("relationship_hub_pending_section_render_ms", 0)

	_refresh_institution_hub()
	_relationship_hub_apply_scroll_runtime_contract()
	_relationship_hub_refresh_runtime_visibility_cache(true)
	_relationship_hub_schedule_deeper_truth_refresh(clean_section, reason)
func _set_institution_hub_section(section: String) -> void:
	var clean_section: String = str(section).strip_edges()
	if clean_section == "":
		return

	var clean_kind: String = str(institution_hub_kind).strip_edges().to_lower()

	if clean_kind == "relationships":
		clean_section = MainSceneLogic._relationship_hub_resolve_section_id(gs, clean_section)

		_relationship_hub_claim_visible_input_surface("relationship_section_change")
		_relationship_hub_begin_navigation_perf_window("relationship_section_change", 180)

		institution_hub_kind = "relationships"
		institution_hub_open = true
		current_panel = "relationships"
		institution_hub_current_section = clean_section

		var render_ticket: int = int(get_meta("relationship_hub_section_render_ticket", 0)) + 1
		set_meta("relationship_hub_section_render_ticket", render_ticket)
		set_meta("relationship_hub_pending_section_render", clean_section)
		set_meta("relationship_hub_pending_section_render_ms", int(Time.get_ticks_msec()))

		_relationship_hub_render_section_now(clean_section, "relationship_section_change")
		return

	if not _institution_hub_runtime_surface_active():
		_claim_institution_hub_surface_authority(clean_kind, "institution_section_change")

	if not MainSceneLogic._institution_hub_section_is_allowed(gs, institution_hub_kind, clean_section):
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	institution_hub_current_section = clean_section
	_refresh_institution_hub()
func _relationship_hub_deferred_render_section_change(section: String = "family", ticket: int = 0) -> void:
	_relationship_hub_claim_visible_input_surface("relationship_deferred_section_change")

	if int(get_meta("relationship_hub_section_render_ticket", -1)) != int(ticket):
		return

	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)

	institution_hub_kind = "relationships"
	institution_hub_open = true
	current_panel = "relationships"
	institution_hub_current_section = clean_section

	_relationship_hub_render_section_now(clean_section, "relationship_section_change")
func _refresh_institution_hub() -> void:
	if institution_hub_overlay == null or gs == null or gs.player == null:
		return
	if not is_instance_valid(institution_hub_overlay):
		return
	if not institution_hub_open and not institution_hub_overlay.visible:
		return

	institution_hub_open = true

	var kind: String = str(institution_hub_kind).strip_edges().to_lower()
	if kind == "":
		kind = "overview"
		institution_hub_kind = kind

	if kind == "relationships":
		current_panel = "relationships"
	_apply_institution_hub_visual_theme(kind)

	var section_defs: Array = MainSceneLogic._institution_hub_sections_for(gs, kind)
	var blank_school_section_strip: bool = kind == "school" and section_defs.is_empty()

	if section_defs.is_empty() and not blank_school_section_strip:
		return

	if blank_school_section_strip:
		institution_hub_current_section = "overview"
	else:
		var valid_section: bool = false
		for raw_def in section_defs:
			var def: Dictionary = raw_def
			if str(def.get("key", "")) == institution_hub_current_section:
				valid_section = true
				break

		if not valid_section:
			institution_hub_current_section = str((section_defs [0] as Dictionary).get("key", "overview"))

	if blank_school_section_strip:
		institution_hub_title.text = "SCHOOL HUB"
	else:
		institution_hub_title.text = "%s HUB • %s" % [kind.to_upper(), institution_hub_current_section.to_upper()]

	_relationship_hub_update_header_chip(kind)

	_clear_container_children(institution_hub_section_bar)
	institution_hub_section_buttons.clear()
	institution_hub_section_bar.visible = not blank_school_section_strip
	institution_hub_section_bar.custom_minimum_size = Vector2(0, 0)

	if not blank_school_section_strip:
		if institution_hub_section_bar is GridContainer:
			institution_hub_section_bar.columns = clamp(section_defs.size(), 1, 4)

		for raw_def in section_defs:
			var def: Dictionary = raw_def
			var key: String = str(def.get("key", "")).strip_edges()
			var label_text: String = str(def.get("label", key)).strip_edges()
			var selected: bool = key == institution_hub_current_section

			var btn:= Button.new()
			btn.text = label_text
			btn.custom_minimum_size = Vector2(0, 34)
			btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			btn.focus_mode = Control.FOCUS_NONE
			btn.mouse_filter = Control.MOUSE_FILTER_STOP
			btn.disabled = false

			if kind == "relationships":
				var section_key: String = key
				btn.pressed.connect(func ():
					_relationship_hub_claim_visible_input_surface("relationship_tab_button_pressed")
					_relationship_hub_render_section_now(section_key, "relationship_tab_button_pressed")
				)
			else:
				var section_key_generic: String = key
				btn.pressed.connect(func ():
					_claim_institution_hub_surface_authority(kind, "institution_tab_button_pressed")
					_set_institution_hub_section(section_key_generic)
				)

			btn.add_theme_font_size_override("font_size", 13)

			_style_institution_hub_section_button(btn, selected, kind)

			institution_hub_section_bar.add_child(btn)
			institution_hub_section_buttons [key] = btn

	var relationship_fullscreen_lane_sections:= {
		"family": true,
		"ancestors": true,
		"household": true
	}
	var fullscreen_relationship_lane: bool = kind == "relationships" and relationship_fullscreen_lane_sections.has(institution_hub_current_section)

	var show_summary_block: bool = true
	if fullscreen_relationship_lane:
		show_summary_block = false
	elif kind == "relationships":
		show_summary_block = false
	elif kind == "school":
		show_summary_block = false

	institution_hub_summary_label.clear()
	institution_hub_summary_label.visible = show_summary_block
	institution_hub_summary_label.custom_minimum_size = Vector2(0, 132) if show_summary_block else Vector2(0, 0)

	if show_summary_block:
		var summary_lines: Array = _institution_hub_summary_lines(kind)
		var summary_text:= ""
		for i in range(summary_lines.size()):
			if i > 0:
				summary_text += "\n"
			summary_text += str(summary_lines [i])
		institution_hub_summary_label.append_text(summary_text)

	_clear_container_children(institution_hub_list)
	institution_hub_experience_rows.clear()
	institution_hub_experience_breathe_time = 0.0
	institution_hub_scroll_last_vertical = -1
	institution_hub_scroll_fade_hold = 0.0

	match kind:
		"career":
			_build_career_institution_hub_section(institution_hub_current_section)
		"school":
			_build_school_institution_hub_section(institution_hub_current_section)
		"relationships":
			_build_relationships_institution_hub_section(institution_hub_current_section)
		_:
			_institution_hub_add_info_label("No institution renderer is available for %s." % kind)
	_mark_institution_hub_rendered_surface_owner(
		kind,
		str(institution_hub_current_section).strip_edges().to_lower(),
		"refresh_institution_hub"
	)
	institution_hub_status_label.text = ""
func _relationship_hub_collect_climate_relationship_ids(person: Person) -> Array:
	var ids: Array = []
	var seen: Dictionary = {}

	if person == null or gs == null:
		return ids

	var sibling_ids: Array = _collect_sibling_ids_for_person(person)
	var grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, person, 2)
	var great_grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, person, 3)
	var in_law_ids: Array = _collect_player_in_law_ids(person)
	var aunt_uncle_ids: Array = _collect_player_aunt_uncle_ids(person)
	var niece_nephew_ids: Array = _collect_player_niece_nephew_ids(person)
	var fling_ids: Array = MainSceneLogic._collect_player_fling_ids(gs, person)
	var household_ids: Array = _collect_player_household_member_ids(person)
	var grandchild_ids: Array = MainSceneLogic._collect_descendant_generation_ids(gs, person, 2)
	var great_grandchild_ids: Array = MainSceneLogic._collect_descendant_generation_ids(gs, person, 3)

	var grouped_lists: Array = [
		person.parents,
		sibling_ids,
		person.children,
		grandchild_ids,
		great_grandchild_ids,
		grandparent_ids,
		great_grandparent_ids,
		in_law_ids,
		aunt_uncle_ids,
		niece_nephew_ids,
		person.friends,
		person.ex_partners,
		fling_ids,
		household_ids
	]

	for raw_list in grouped_lists:
		if typeof(raw_list) != TYPE_ARRAY:
			continue

		for raw_id in raw_list:
			MainSceneLogic._relationship_hub_add_climate_relationship_id(gs, ids, seen, int(raw_id))

	var valid_partner: Person = gs.get_valid_partner(person, true, true)
	if valid_partner != null:
		MainSceneLogic._relationship_hub_add_climate_relationship_id(gs, ids, seen, int(valid_partner.id))

	return ids


func _relationship_hub_climate_report_for(person: Person) -> Dictionary:
	if person == null or gs == null:
		return {
			"value": 0,
			"count": 0,
			"total_bond": 0,
			"average_bond": 0.0
		}

	var ids: Array = _relationship_hub_collect_climate_relationship_ids(person)
	var total_bond: int = 0
	var counted: int = 0

	for raw_id in ids:
		var npc_id: int = int(raw_id)
		if npc_id <= 0:
			continue

		var npc: Person = gs.get_or_reactivate_npc_by_id(npc_id)
		if npc == null:
			continue

		total_bond += _relationship_hub_bond_score_for_pair(person, npc)
		counted += 1

	if counted <= 0:
		return {
			"value": 0,
			"count": 0,
			"total_bond": 0,
			"average_bond": 0.0
		}

	var average_bond: float = float(total_bond) / float(counted)

	return {
		"value": clamp(int(round(average_bond)), 0, 100),
		"count": counted,
		"total_bond": total_bond,
		"average_bond": average_bond
	}


func _relationship_hub_climate_value_for(person: Person) -> int:
	return int(_relationship_hub_climate_report_for(person).get("value", 0))
func _relationship_hub_update_header_chip(kind: String) -> void:
	if institution_hub_header_chip == null or institution_hub_header_chip_label == null:
		return

	var clean_kind: String = str(kind).strip_edges().to_lower()
	if clean_kind != "relationships" or gs == null or gs.player == null:
		institution_hub_header_chip.modulate.a = 0.0
		institution_hub_header_chip_label.text = ""
		return

	var climate_report: Dictionary = _relationship_hub_climate_report_for(gs.player)
	var climate_value: int = int(climate_report.get("value", 0))
	var relationship_count: int = int(climate_report.get("count", 0))
	var surface_context: Dictionary = MainSceneLogic._build_institution_hub_stat_surface_context(gs, "relationships", gs.player)
	surface_context ["relationship_count"] = relationship_count
	surface_context ["relationship_total_bond"] = int(climate_report.get("total_bond", 0))
	surface_context ["relationship_average_bond"] = float(climate_report.get("average_bond", 0.0))

	var resolved: Dictionary = MainSceneHelpers._resolve_institution_hub_stat_surface("Relationship Climate", climate_value, 100, surface_context)
	var descriptor: String = str(resolved.get("descriptor", "Open")).strip_edges()

	institution_hub_header_chip.modulate.a = 1.0
	institution_hub_header_chip_label.text = "Climate: %s • %d" % [descriptor, climate_value]
	institution_hub_header_chip.tooltip_text = "Average bond across %d relationship%s." % [
		relationship_count,
		"" if relationship_count == 1 else "s"
	]

	institution_hub_header_chip.add_theme_stylebox_override("panel", MainSceneHelpers._relationship_hub_climate_chip_style(climate_value))
func _school_hub_reset_child_enrollment_flow() -> void:
	school_hub_child_enrollment_mode = ""
	school_hub_child_enrollment_targets.clear()


func _school_hub_child_is_selected(child_id: int) -> bool:
	return school_hub_child_enrollment_targets.has(int(child_id))


func _school_hub_validate_selected_child_targets(parent: Person) -> Array:
	var valid_children: Array = MainSceneLogic._school_hub_get_enrollable_children_for_parent(gs, parent)
	var valid_by_id: Dictionary = {}
	for raw_child in valid_children:
		var child: Person = raw_child
		if child == null:
			continue
		valid_by_id [int(child.id)] = child

	var cleaned_ids: Array = []
	var selected_children: Array = []
	for raw_id in school_hub_child_enrollment_targets:
		var child_id: int = int(raw_id)
		if child_id <= 0:
			continue
		if not valid_by_id.has(child_id):
			continue
		if cleaned_ids.has(child_id):
			continue
		cleaned_ids.append(child_id)
		selected_children.append(valid_by_id [child_id])

	school_hub_child_enrollment_targets = cleaned_ids
	return selected_children


func _school_hub_tuition_summary(tuition: float, count: int) -> String:
	var clean_count: int = max(1, int(count))
	if tuition <= 0.0:
		return "Free"
	if clean_count <= 1:
		return "$%s / year" % str(int(round(tuition)))
	return "$%s / year each • $%s / year total" % [
		str(int(round(tuition))),
		str(int(round(tuition * float(clean_count))))
	]


func _school_hub_add_parent_enrollment_entry(parent: Person, children: Array, enrollable_children: Array) -> void:
	if parent == null:
		return

	var all_children: Array = MainSceneHelpers._safe_array(children)
	var ready_children: Array = MainSceneHelpers._safe_array(enrollable_children)
	if all_children.is_empty():
		return

	var child_names: Array = []
	for raw_child in all_children:
		var child: Person = raw_child
		if child == null:
			continue
		child_names.append("%s age %d" % [child.first_name, int(child.age)])

	_institution_hub_add_section_header("Parent Schooling")
	_institution_hub_add_card("Children", [
		"Children: %d" % all_children.size(),
		"Eligible To Enroll: %d" % ready_children.size(),
		"Targets: %s" % MainSceneHelpers._school_hub_join_strings(child_names),
		"Choose the child first, then choose the school contract."
	])
	_institution_hub_add_action_button("Enroll your child", "School Hub Child Enrollment Open")

func _build_school_child_enrollment_flow(parent: Person, enrollable_children: Array) -> void:
	if parent == null:
		return

	if school_hub_child_enrollment_mode == "":
		school_hub_child_enrollment_mode = "select_children"

	var selected_children: Array = _school_hub_validate_selected_child_targets(parent)

	_institution_hub_add_section_header("Enroll Your Child")

	if enrollable_children.is_empty():
		_school_hub_reset_child_enrollment_flow()
		_institution_hub_add_card("No Eligible Children", [
			"No child is currently old enough and unenrolled.",
			"School enrollment stays parent-controlled, but only eligible children appear here."
		])
		return

	if school_hub_child_enrollment_mode == "choose_school":
		if selected_children.is_empty():
			school_hub_child_enrollment_mode = "select_children"
		else:
			var selected_names: Array = []
			for raw_selected_child in selected_children:
				var selected_child: Person = raw_selected_child
				if selected_child == null:
					continue
				selected_names.append("%s age %d" % [selected_child.first_name, int(selected_child.age)])

			_institution_hub_add_card("Selected Children", [
				"Targets: %s" % MainSceneHelpers._school_hub_join_strings(selected_names),
				"Choose one school contract below.",
				"If a school only fits some selected children, only those eligible children will be enrolled."
			])

			var grouped_options: Array = MainSceneLogic._school_hub_group_child_school_options(gs, selected_children)
			if grouped_options.is_empty():
				_institution_hub_add_info_label("No matching school contracts are available for the selected child or children.")
			else:
				for raw_group in grouped_options:
					var group: Dictionary = MainSceneHelpers._safe_dictionary(raw_group)
					var contract: Dictionary = MainSceneHelpers._safe_dictionary(group.get("contract", {}))
					var child_ids: Array = MainSceneHelpers._safe_array(group.get("child_ids", []))
					var child_names: Array = MainSceneHelpers._safe_array(group.get("child_names", []))
					var school_name: String = str(group.get("name", "")).strip_edges()
					var school_type: String = str(group.get("type", "")).strip_edges()
					if school_name == "" or school_type == "" or child_ids.is_empty():
						continue

					var tuition: float = float(contract.get("tuition", 0.0))
					var program_text: String = str(contract.get("program", contract.get("school_stage", "School"))).replace("_", " ").capitalize()
					var lane_text: String = str(contract.get("lane", "school")).replace("_", " ").capitalize()

					_institution_hub_add_card(school_name, [
						"Eligible Targets: %s" % MainSceneHelpers._school_hub_join_strings(child_names),
						"Lane: %s" % lane_text,
						"Program: %s" % program_text,
						"Tuition: %s" % _school_hub_tuition_summary(tuition, child_ids.size())
					])

					_institution_hub_add_action_button("Enroll selected eligible children in %s" % school_name, "School Hub Enroll Selected Children::%s::%s::%s" % [
						school_type,
						school_name,
						MainSceneLogic._school_hub_child_id_csv(child_ids)
					])

			_institution_hub_add_action_button("← Change selected children", "School Hub Child Enrollment Back")
			_institution_hub_add_action_button("Cancel child enrollment", "School Hub Child Enrollment Cancel")
			return

	_institution_hub_add_card("Choose Child Targets", [
		"Selected: %d" % selected_children.size(),
		"You can select one child or multiple eligible children.",
		"After selecting targets, you will choose the school contract."
	])

	_institution_hub_add_action_button("Select all eligible children", "School Hub Child Select All")
	if not selected_children.is_empty():
		_institution_hub_add_action_button("Clear selected children", "School Hub Child Clear Selection")

	for raw_child in enrollable_children:
		var child: Person = raw_child
		if child == null:
			continue

		var selected: bool = _school_hub_child_is_selected(int(child.id))
		var child_options: Array = gs.school_engine.get_school_options_for(child)
		var label_prefix: String = "✓ Selected" if selected else "Select"

		_institution_hub_add_card("%s %s" % [child.first_name, child.last_name], [
			"Age: %d" % int(child.age),
			"Enrollment: Not enrolled",
			"Available Paths: %d" % child_options.size()
		])
		_institution_hub_add_action_button("%s %s" % [label_prefix, child.first_name], "School Hub Child Toggle::%d" % int(child.id))

	if selected_children.is_empty():
		_institution_hub_add_info_label("Select at least one eligible child to continue.")
	else:
		_institution_hub_add_action_button("Continue to school choices", "School Hub Child Enrollment Continue")

	_institution_hub_add_action_button("Cancel child enrollment", "School Hub Child Enrollment Cancel")
func _drive_institution_hub_scrollbar_visibility(delta: float) -> void:
	if not _institution_hub_runtime_surface_active():
		return
	if institution_hub_scroll == null:
		return

	var vbar:= institution_hub_scroll.get_v_scroll_bar()
	if vbar == null:
		return

	if vbar.max_value <= vbar.page:
		vbar.modulate.a = 0.0
		if str(vbar.get_meta("institution_hub_scrollbar_style_key", "")) != "empty":
			_style_institution_hub_scrollbar(vbar, false, 0.0)
			vbar.set_meta("institution_hub_scrollbar_style_key", "empty")
		return

	_drive_institution_hub_smooth_scroll(delta)

	var current_vertical: int = int(institution_hub_scroll.scroll_vertical)
	if institution_hub_scroll_last_vertical < 0:
		institution_hub_scroll_last_vertical = current_vertical

	if current_vertical != institution_hub_scroll_last_vertical:
		institution_hub_scroll_last_vertical = current_vertical
		institution_hub_scroll_fade_hold = 0.32
		institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", int(Time.get_ticks_msec()))

		if _relationship_hub_runtime_surface_active():
			_relationship_hub_begin_navigation_perf_window("relationship_scroll", 180)

	if institution_hub_scroll_fade_hold > 0.0:
		institution_hub_scroll_fade_hold = max(0.0, institution_hub_scroll_fade_hold - delta)
		vbar.modulate.a = move_toward(vbar.modulate.a, 0.98, delta * 18.0)
	else:
		vbar.modulate.a = move_toward(vbar.modulate.a, 0.28, delta * 6.0)

	var pulse_strength: float = (sin(institution_hub_experience_breathe_time * 2.6) + 1.0) * 0.5
	var active: bool = vbar.modulate.a > 0.32
	var pulse_bucket_max: int = 8

	if _relationship_hub_runtime_surface_active() and _institution_hub_scroll_is_recently_active():
		pulse_bucket_max = 2

	var pulse_bucket: int = MainSceneHelpers._relationship_hub_visual_pulse_bucket(pulse_strength, pulse_bucket_max)
	var style_key: String = "%s|%s|%d|%d" % [
		str(institution_hub_kind).strip_edges().to_lower(),
		str(active),
		pulse_bucket,
		pulse_bucket_max
	]

	if str(vbar.get_meta("institution_hub_scrollbar_style_key", "")) == style_key:
		return

	vbar.set_meta("institution_hub_scrollbar_style_key", style_key)
	_style_institution_hub_scrollbar(vbar, active, float(pulse_bucket) / float(max(1, pulse_bucket_max)))
func _institution_hub_summary_lines(kind: String) -> Array:
	var p: Person = gs.player
	if p == null:
		return []
	match kind:
		"career":
			var out:= []
			out.append("Job: %s" % (p.job if p.job != "" else "Unemployed"))
			out.append("Income: %s" % gs.economy_engine.format_money(int(p.income)))
			out.append("Performance: %d" % int(p.job_performance))
			out.append("Experience: %d" % int(p.job_experience))
			out.append("Work Stress: %d" % int(p.work_stress))
			if p.age >= 16 and p.age < 18:
				out.append("Career Stage: Part-Time Eligible")
			elif p.age >= 18:
				out.append("Career Stage: Full-Time Eligible")
			else:
				out.append("Career Stage: Too Young To Work")
			return out
		"school":
			var teachers: Array = gs.school_engine.get_teachers_for(p) if gs.school_engine != null else []
			var classmates: Array = gs.school_engine.get_classmates(p) if gs.school_engine != null else []
			var out:= []
			out.append("Enrollment: %s" % ("Active" if p.school_name != "" else "Inactive"))
			out.append("School Name: %s" % (p.school_name if p.school_name != "" else "None"))
			out.append("Program: %s" % (p.education_level if p.education_level != "" else "None"))
			out.append("Status: %s" % (p.school_status if p.school_status != "" else "None"))
			out.append("Visible Teachers: %d" % teachers.size())
			out.append("Visible Classmates: %d" % classmates.size())
			return out
		"relationships":
			var sibling_ids: Array = _collect_sibling_ids_for_person(p)
			var grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, p, 2)
			var great_grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, p, 3)
			var in_law_ids: Array = _collect_player_in_law_ids(p)
			var aunt_uncle_ids: Array = _collect_player_aunt_uncle_ids(p)
			var niece_nephew_ids: Array = _collect_player_niece_nephew_ids(p)
			var dead_family_ids: Array = _collect_player_dead_family_ids(p)
			var out:= []
			out.append("Parents: %d" % p.parents.size())
			out.append("Siblings: %d" % sibling_ids.size())
			out.append("Grandparents: %d" % grandparent_ids.size())
			out.append("Great-Grandparents: %d" % great_grandparent_ids.size())
			out.append("In-Laws: %d" % in_law_ids.size())
			out.append("Aunts / Uncles: %d" % aunt_uncle_ids.size())
			out.append("Nieces / Nephews: %d" % niece_nephew_ids.size())
			out.append("Children: %d" % p.children.size())
			out.append("Dead Family: %d" % dead_family_ids.size())
			out.append("Friends: %d" % p.friends.size())
			out.append("Exes: %d" % p.ex_partners.size())
			return out
		_:
			return []
func _collect_player_dead_family_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	var category_lists: Array = [
		MainSceneLogic._collect_ancestor_generation_ids(gs, person, 3),
		MainSceneLogic._collect_ancestor_generation_ids(gs, person, 2),
		person.parents,
		_collect_sibling_ids_for_person(person),
		person.children,
		MainSceneLogic._collect_descendant_generation_ids(gs, person, 2),
		MainSceneLogic._collect_descendant_generation_ids(gs, person, 3),
		_collect_player_in_law_ids(person),
		_collect_player_aunt_uncle_ids(person),
		_collect_player_niece_nephew_ids(person)
	]

	for raw_list in category_lists:
		if typeof(raw_list) != TYPE_ARRAY:
			continue
		for raw_id in MainSceneLogic._collect_dead_institution_relationship_ids(gs, raw_list):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(raw_id))

	return out
func _flush_relationship_hub_contract_engine_tail_work(
	reason: String = "relationships_hub_tail_work"
) -> void:
	if (
		gs == null
		or gs.player == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return

	var first_class_relationship_surface_active: bool = (
		relationship_hub_panel != null
		and is_instance_valid(
			relationship_hub_panel
		)
		and relationship_hub_panel.visible
	)
	var legacy_relationship_surface_active: bool = (
		institution_hub_kind.strip_edges().to_lower()
		== "relationships"
		and _relationship_hub_runtime_surface_active()
	)
	var relationship_surface_active: bool = (
		first_class_relationship_surface_active
		or legacy_relationship_surface_active
	)
	var explicit_profile_upgrade_pending: bool = (
		_relationship_profile_switch_destination_upgrade_pending_for_target(
			-1
		)
	)

	if (
		relationship_surface_active
		and _institution_hub_scroll_is_recently_active()
		and not explicit_profile_upgrade_pending
	):
		return

	if (
		relationship_surface_active
		and _relationship_hub_navigation_perf_window_active()
		and not explicit_profile_upgrade_pending
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)




	if (
		_resident_profile_switch_tail_player_surface_is_critical(
			now_ms
		)
		and not explicit_profile_upgrade_pending
	):
		set_meta(
			"relationships_hub_next_switch_shell_tail_flush_ms",
			now_ms + 1800
		)
		set_meta(
			"relationships_hub_switch_shell_tail_flush_yielded_to_player_surface",
			true
		)
		set_meta(
			"relationships_hub_switch_shell_tail_flush_yielded_at_ms",
			now_ms
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"relationships_hub_switch_shell_tail_flush_yielded_to_player_surface"
			] = true
			gs.scenario_state [
				"relationships_hub_next_switch_shell_tail_flush_ms"
			] = now_ms + 1800

		return

	if (
		_ui_interaction_grace_active(
			now_ms
		)
		and not explicit_profile_upgrade_pending
	):
		set_meta(
			"relationships_hub_next_switch_shell_tail_flush_ms",
			now_ms + 900
		)
		return

	if (
		_ui_interaction_grace_active(
			now_ms
		)
		and explicit_profile_upgrade_pending
	):
		set_meta(
			"relationships_hub_next_switch_shell_tail_flush_ms",
			now_ms + 120
		)
		return

	var next_flush_ms: int = int(
		get_meta(
			"relationships_hub_next_switch_shell_tail_flush_ms",
			0
		)
	)

	if (
		now_ms < next_flush_ms
		and not explicit_profile_upgrade_pending
	):
		return

	if explicit_profile_upgrade_pending:
		var explicit_next_ms: int = int(
			get_meta(
				"relationship_profile_switch_destination_upgrade_next_flush_ms",
				0
			)
		)

		if now_ms < explicit_next_ms:
			return

	var actor_id: int = int(
		gs.player.id
	)

	if actor_id <= 0:
		return

	var flush_started_ms: int = now_ms

	set_meta(
		"relationships_hub_next_switch_shell_tail_flush_ms",
		now_ms + 900
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": (
				"relationships_hub_resident_tail_intent"
			),
			"surface_id": (
				"relationship_switch_packet_residency"
			),
			"action_id": "flush_switch_shells",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"action_id": "flush_switch_shells",
				"max_count": 1,
				"source": reason,
				"first_class_relationship_panel": (
					first_class_relationship_surface_active
				),
				"relationship_surface_visible": (
					relationship_surface_active
				),
				"background_only": true,
				"blocks_ui": false,
				"ui_safe_microtask": true,
				"switch_press_must_not_build_surface": true,
				"continuous_destination_preparation": true,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"relationships_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": reason
		},
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"surface_id": (
				"relationship_switch_packet_residency"
			),
			"action_id": "flush_switch_shells",
			"source": reason,
			"background_only": true,
			"ready_gate_member": false,
			"ui_is_expression_only": true
		}
	)

	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"result",
			route_result
		)
	)
	var processed: int = maxi(
		0,
		int(
			result.get(
				"processed",
				0
			)
		)
	)
	var staged: int = maxi(
		0,
		int(
			result.get(
				"staged",
				0
			)
		)
	)
	var remaining: int = maxi(
		0,
		int(
			result.get(
				"remaining",
				0
			)
		)
	)
	var staged_packets_raw: Variant = result.get(
		"staged_packets_by_actor",
		{}
	)
	var staged_packets_by_actor: Dictionary = (
		staged_packets_raw as Dictionary
		if typeof(staged_packets_raw) == TYPE_DICTIONARY
		else {}
	)
	var renderer_decks_queued: int = 0
	var support_packets_cached: int = 0

	for raw_target_id in staged_packets_by_actor.keys():
		var target_id: int = int(
			raw_target_id
		)
		var viewer_packet_raw: Variant = staged_packets_by_actor.get(
			raw_target_id,
			{}
		)
		var viewer_packet: Dictionary = (
			viewer_packet_raw as Dictionary
			if typeof(viewer_packet_raw) == TYPE_DICTIONARY
			else {}
		)
		var surface_raw: Variant = viewer_packet.get(
			"surface_contract",
			{}
		)
		var surface_contract: Dictionary = (
			surface_raw as Dictionary
			if typeof(surface_raw) == TYPE_DICTIONARY
			else {}
		)
		var main_tab_deck_raw: Variant = viewer_packet.get(
			"main_tab_surface_contracts",
			surface_contract.get(
				"main_tab_surface_contracts",
				{}
			)
		)
		var main_tab_deck: Dictionary = (
			main_tab_deck_raw as Dictionary
			if typeof(main_tab_deck_raw) == TYPE_DICTIONARY
			else {}
		)

		if (
			target_id <= 0
			or not _resident_main_tab_contract_deck_is_complete_for_actor(
				main_tab_deck,
				target_id
			)
		):
			continue

		var support_packet_raw: Variant = viewer_packet.get(
			"control_switch_support_surface_packet",
			surface_contract.get(
				"control_switch_support_surface_packet",
				{}
			)
		)
		var support_packet: Dictionary = (
			support_packet_raw as Dictionary
			if typeof(support_packet_raw) == TYPE_DICTIONARY
			else {}
		)

		if _control_switch_support_surface_packet_is_renderable(
			support_packet,
			target_id
		):
			_cache_resident_control_switch_support_surface_packet_reference(
				support_packet,
				target_id,
				"%s_actor_%d_background_residency"
				% [
					reason,
					target_id
				]
			)
			support_packets_cached += 1

			if _relationship_profile_switch_destination_upgrade_pending_for_target(
				target_id
			):
				_clear_relationship_profile_switch_destination_upgrade_request(
					target_id,
					"support_packet_cached_by_relationship_tail"
				)
		_queue_resident_main_tab_renderer_deck_prewarm(
			target_id,
			main_tab_deck,
			"%s_actor_%d_renderer_deck"
			% [
				reason,
				target_id
			]
		)
		renderer_decks_queued += 1

		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
			and relationship_profile_panel.has_method(
				"install_resident_switch_packet"
			)
		):
			var active_target: Person = (
				_relationship_profile_active_target()
			)

			if (
				active_target != null
				and int(active_target.id) == target_id
			):
				relationship_profile_panel.install_resident_switch_packet(
					viewer_packet
				)

	var flush_finished_ms: int = int(
		Time.get_ticks_msec()
	)
	var flush_duration_ms: int = maxi(
		0,
		flush_finished_ms - flush_started_ms
	)
	var next_interval_ms: int = 900

	if flush_duration_ms > 12:
		next_interval_ms = 2400
	elif flush_duration_ms > 6:
		next_interval_ms = 1600
	elif processed <= 0:
		next_interval_ms = 1400
	elif remaining <= 0:
		next_interval_ms = 1200
	else:
		next_interval_ms = 900

	set_meta(
		"relationships_hub_next_switch_shell_tail_flush_ms",
		flush_finished_ms + next_interval_ms
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_duration_ms",
		flush_duration_ms
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_next_interval_ms",
		next_interval_ms
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_never_16ms",
		true
	)

	set_meta(
		"relationships_hub_switch_shell_tail_flush_used_first_class_panel",
		first_class_relationship_surface_active
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_processed",
		processed
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_staged",
		staged
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_remaining",
		remaining
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_renderer_decks_queued",
		renderer_decks_queued
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_support_packets_cached",
		support_packets_cached
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_ready_gate_member",
		false
	)
	set_meta(
		"relationships_hub_switch_shell_tail_flush_at_ms",
		now_ms
	)

	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_report"
	] = result.duplicate(false)
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_at_ms"
	] = now_ms
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_used_first_class_panel"
	] = first_class_relationship_surface_active
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_processed"
	] = processed
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_staged"
	] = staged
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_remaining"
	] = remaining
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_renderer_decks_queued"
	] = renderer_decks_queued
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_support_packets_cached"
	] = support_packets_cached
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_duration_ms"
	] = flush_duration_ms
	gs.scenario_state [
		"relationships_hub_switch_shell_tail_flush_next_interval_ms"
	] = next_interval_ms
