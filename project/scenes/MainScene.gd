func _service_luxury_exchange_centerpiece_hover_observation_quantum(
	request: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)

	if actor_id != int(
		gs.player.id
	):
		return

	var observation_contract: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			request.get(
				"observation_contract",
				{}
			)
		).duplicate(false)
	)

	if observation_contract.is_empty():
		return

	var observed_year: int = int(
		observation_contract.get(
			"market_year",
			-999999
		)
	)

	if int(
		get_meta(
			"luxury_exchange_shiny_authority_consumed_year",
			-999999
		)
	) == observed_year:
		return

	observation_contract [
		"action_id"
	] = "observe_centerpiece_hover"
	observation_contract [
		"source"
	] = (
		"mainscene."
		+ "luxury_exchange.centerpiece_hover"
	)
	observation_contract [
		"simulation_mutation_forbidden"
	] = true
	observation_contract [
		"immutable_contract_references"
	] = true






	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"intent_type": (
					"luxury_exchange_"
					+ "centerpiece_hover_observation"
				),
				"surface_id": (
					"luxury_exchange_panel"
				),
				"action_id": (
					"observe_centerpiece_hover"
				),
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"skip_checks_and_balances": true,
				"authority_prevalidated": true,
				"payload": observation_contract,
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"luxury_shop_engine"
					),
					"method": "resolve_intent",
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene."
					+ "luxury_exchange.centerpiece_hover"
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"surface_id": (
					"luxury_exchange_panel"
				),
				"action_id": (
					"observe_centerpiece_hover"
				),
				"source": (
					"mainscene."
					+ "luxury_exchange.centerpiece_hover"
				),
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"skip_checks_and_balances": true,
				"authority_prevalidated": true
			}
		)
	)

	set_meta(
		"luxury_exchange_shiny_hover_transport",
		"prevalidated_ephemeral_global_intent"
	)
	set_meta(
		"luxury_exchange_shiny_hover_persists_global_intent",
		false
	)

	var result: Dictionary = (
		_luxury_exchange_route_result(
			report
		)
	)

	if bool(
		result.get(
			"audio_authorized",
			false
		)
	):
		set_meta(
			"luxury_exchange_shiny_authority_authorized_year",
			int(
				result.get(
					"market_year",
					observed_year
				)
			)
		)

		_play_luxury_exchange_shiny_audio_from_authority(
			result
		)
		return

	if (
		bool(
			result.get(
				"success",
				false
			)
		)
		and str(
			result.get(
				"reason",
				""
			)
		) == (
			"centerpiece_hover_audio_"
			+ "already_consumed_for_market_year"
		)
	):
		set_meta(
			"luxury_exchange_shiny_authority_consumed_year",
			int(
				result.get(
					"market_year",
					observed_year
				)
			)
		)
func _show_luxury_exchange_panel() -> void:
	if (
		gs == null
		or gs.player == null
		or luxury_exchange_panel == null
		or not is_instance_valid(
			luxury_exchange_panel
		)
	):
		return

	var return_surface_key: String = (
		_market_return_surface_key_before_open()
	)

	set_meta(
		"luxury_exchange_return_surface_key",
		return_surface_key
	)

	_suspend_standard_tab_popup_for_child_surface(
		"luxury_exchange_panel"
	)
	_suspend_activities_hub_for_child_surface(
		"luxury_exchange_panel"
	)

	luxury_exchange_open = true
	luxury_exchange_panel.visible = true
	luxury_exchange_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	luxury_exchange_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	luxury_exchange_panel.z_as_relative = false
	luxury_exchange_panel.z_index = 245

	var parent:= (
		luxury_exchange_panel.get_parent()
	)

	if parent != null:
		parent.move_child(
			luxury_exchange_panel,
			parent.get_child_count() - 1
		)

	_claim_interactive_surface_authority(
		luxury_exchange_panel,
		"luxury_exchange_panel",
		"show_luxury_exchange_resident_reveal",
		true,
		true
	)

	set_meta(
		"luxury_exchange_click_reveal_only",
		true
	)
	set_meta(
		"luxury_exchange_click_engine_calls",
		false
	)
	set_meta(
		"luxury_exchange_click_build_performed",
		false
	)


func _hide_luxury_exchange_panel() -> void:
	luxury_exchange_open = false

	if (
		luxury_exchange_panel != null
		and is_instance_valid(
			luxury_exchange_panel
		)
	):
		luxury_exchange_panel.visible = false
		luxury_exchange_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		luxury_exchange_panel.set_meta(
			"interactive_surface_input_suspended",
			true
		)

	var return_surface_key: String = str(
		get_meta(
			"luxury_exchange_return_surface_key",
			"life"
		)
	)

	remove_meta(
		"luxury_exchange_return_surface_key"
	)

	_restore_market_parent_surface(
		return_surface_key,
		"luxury_exchange_back"
	)
func _on_luxury_exchange_acquisition_requested(
	card_contract: Dictionary
) -> void:
	if (
		card_contract.is_empty()
		or bool(
			card_contract.get(
				"acquisition_disabled",
				false
			)
		)
	):
		return

	var acquisition_intent: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			card_contract.get(
				"acquisition_intent",
				{}
			)
		)
	)

	if acquisition_intent.is_empty():
		return

	luxury_exchange_intent_queue.append({
		"actor_id": (
			int(gs.player.id)
			if (
				gs != null
				and gs.player != null
			)
			else -1
		),
		"acquisition_intent": (
			acquisition_intent.duplicate(false)
		),
		"card_id": str(
			card_contract.get(
				"card_id",
				""
			)
		),
		"queued_at_ms": int(
			Time.get_ticks_msec()
		)
	})

	set_meta(
		"luxury_exchange_acquisition_click_engine_calls",
		false
	)
	set_meta(
		"luxury_exchange_acquisition_click_mutation",
		false
	)
	set_meta(
		"luxury_exchange_acquisition_intent_latched",
		true
	)


func _service_luxury_exchange_intent_quantum() -> void:
	if (
		luxury_exchange_intent_head
		>= luxury_exchange_intent_queue.size()
	):
		if not luxury_exchange_intent_queue.is_empty():
			luxury_exchange_intent_queue.clear()
			luxury_exchange_intent_head = 0
		return

	if gs == null:
		return

	var raw_request: Variant = (
		luxury_exchange_intent_queue [
			luxury_exchange_intent_head
		]
	)
	luxury_exchange_intent_head += 1

	if typeof(raw_request) != TYPE_DICTIONARY:
		return

	var request: Dictionary = (
		raw_request as Dictionary
	)
	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)

	if actor_id <= 0:
		return

	var request_kind: String = str(
		request.get(
			"request_kind",
			"acquisition"
		)
	).strip_edges().to_lower()

	match request_kind:
		"centerpiece_hover_observation":
			_service_luxury_exchange_centerpiece_hover_observation_quantum(
				request
			)
			return

		"centerpiece_hover_release":
			_release_luxury_exchange_shiny_audio_from_hover(
				request
			)
			return

		_:
			pass

	var authority_intent: Dictionary = MainSceneHelpers._safe_dictionary(
		request.get(
			"authority_intent",
			request.get(
				"acquisition_intent",
				{}
			)
		)
	)
	var target: Dictionary = MainSceneHelpers._safe_dictionary(
		authority_intent.get(
			"target",
			{}
		)
	)
	var payload: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			authority_intent.get(
				"payload",
				{}
			)
		).duplicate(false)
	)

	if (
		target.is_empty()
		or payload.is_empty()
	):
		return

	payload [
		"source"
	] = str(
		payload.get(
			"source",
			"mainscene.luxury_exchange"
		)
	)
	payload [
		"immutable_contract_references"
	] = true

	var intent_type: String = str(
		request.get(
			"intent_type",
			"luxury_exchange_acquisition"
		)
	).strip_edges()

	if intent_type == "":
		intent_type = "luxury_exchange_acquisition"




	var presentation_delivery_hot_path: bool = (
		intent_type
		== "luxury_exchange_presentation_delivery"
	)
	var ephemeral_infrastructure_intent: bool = bool(
		request.get(
			"ephemeral_infrastructure_intent",
			presentation_delivery_hot_path
		)
	)
	var skip_global_intent_persistence: bool = bool(
		request.get(
			"skip_global_intent_persistence",
			presentation_delivery_hot_path
		)
	)
	var skip_crr_observation: bool = bool(
		request.get(
			"skip_crr_observation",
			presentation_delivery_hot_path
		)
	)
	var skip_checks_and_balances: bool = bool(
		request.get(
			"skip_checks_and_balances",
			presentation_delivery_hot_path
		)
	)
	var authority_prevalidated: bool = bool(
		request.get(
			"authority_prevalidated",
			presentation_delivery_hot_path
		)
	)

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"intent_type": intent_type,
				"surface_id": (
					"luxury_exchange_panel"
				),
				"action_id": str(
					authority_intent.get(
						"action_id",
						payload.get(
							"action_id",
							""
						)
					)
				),
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": (
					ephemeral_infrastructure_intent
				),
				"skip_global_intent_persistence": (
					skip_global_intent_persistence
				),
				"skip_crr_observation": (
					skip_crr_observation
				),
				"skip_checks_and_balances": (
					skip_checks_and_balances
				),
				"authority_prevalidated": (
					authority_prevalidated
				),
				"payload": payload,
				"target": target,
				"source": (
					"mainscene."
					+ "luxury_exchange"
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"surface_id": (
					"luxury_exchange_panel"
				),
				"source": (
					"mainscene."
					+ "luxury_exchange"
				),
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": (
					ephemeral_infrastructure_intent
				),
				"skip_global_intent_persistence": (
					skip_global_intent_persistence
				),
				"skip_crr_observation": (
					skip_crr_observation
				),
				"skip_checks_and_balances": (
					skip_checks_and_balances
				),
				"authority_prevalidated": (
					authority_prevalidated
				)
			}
		)
	)

	var result: Dictionary = (
		_luxury_exchange_route_result(
			report
		)
	)

	if (
		bool(
			request.get(
				"publish_result_to_panel",
				true
			)
		)
		and luxury_exchange_panel != null
		and is_instance_valid(
			luxury_exchange_panel
		)
	):
		luxury_exchange_panel.apply_action_result(
			result
		)

	var request_affects_market_projection: bool = bool(
		request.get(
			"affects_market_projection",
			true
		)
	)
	var result_affects_market_projection: bool = bool(
		result.get(
			"affects_market_projection",
			true
		)
	)

	if (
		(
			bool(
				result.get(
					"success",
					false
				)
			)
			or bool(
				result.get(
					"committed",
					false
				)
			)
		)
		and request_affects_market_projection
		and result_affects_market_projection
	):
		set_meta(
			"luxury_exchange_local_market_revision",
			int(
				get_meta(
					"luxury_exchange_local_market_revision",
					0
				)
			) + 1
		)



		luxury_exchange_resident_surface_signature = ""
func _ensure_luxury_exchange_shiny_audio_player() -> AudioStreamPlayer:
	var existing:= get_node_or_null(
		"LuxuryExchangeShinyAudio"
	) as AudioStreamPlayer

	if existing != null:
		existing.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		existing.stream_paused = false
		existing.bus = "Master"
		return existing

	var player:= AudioStreamPlayer.new()
	player.name = "LuxuryExchangeShinyAudio"
	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.autoplay = false
	player.bus = "Master"
	player.volume_db = -5.0

	add_child(
		player
	)

	return player
func _drive_luxury_exchange_shiny_audio_prewarm() -> void:



	var player:= get_node_or_null(
		"LuxuryExchangeShinyAudio"
	) as AudioStreamPlayer

	if player == null:
		player = _ensure_luxury_exchange_shiny_audio_player()

		if player != null:
			set_meta(
				"luxury_exchange_shiny_audio_player_resident",
				true
			)
			set_meta(
				"luxury_exchange_shiny_audio_player_created_ahead_of_observation",
				true
			)
			set_meta(
				"luxury_exchange_shiny_audio_player_created_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)

		return

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.autoplay = false
	player.bus = "Master"
	player.volume_db = -5.0

	# FIX: this logged "The object does not have any 'meta' values with the key
	# 'luxury_exchange_shiny_audio_stream_cache'" on every frame -- hundreds of error
	# lines drowning the console. Passing a default to get_meta() does not suppress the
	# error when the object has no metadata at all, so check has_meta() first.
	var cached_raw: Variant = (
		get_meta(
			"luxury_exchange_shiny_audio_stream_cache",
			null
		)
		if has_meta("luxury_exchange_shiny_audio_stream_cache")
		else null
	)

	if cached_raw is AudioStream:
		var cached_stream: AudioStream = (
			cached_raw as AudioStream
		)

		if player.stream != cached_stream:
			if player.playing:
				player.stop()

			player.stream = cached_stream

			set_meta(
				"luxury_exchange_shiny_cached_stream_assigned_to_player",
				true
			)
			set_meta(
				"luxury_exchange_shiny_cached_stream_assigned_ahead_of_observation",
				true
			)

		set_meta(
			"luxury_exchange_shiny_audio_ready",
			true
		)
		set_meta(
			"luxury_exchange_shiny_audio_player_bound",
			player.stream == cached_stream
		)
		set_meta(
			"luxury_exchange_shiny_audio_bound_ahead_of_observation",
			player.stream == cached_stream
		)
		set_meta(
			"luxury_exchange_shiny_audio_endpoint_resident",
			player.stream == cached_stream
		)
		set_meta(
			"luxury_exchange_shiny_audio_endpoint_kind",
			"resident_dedicated_audio_stream_player"
		)
		set_meta(
			"luxury_exchange_shiny_audio_binding_means",
			"cached_stream_bound_before_hover"
		)

		var pending_raw: Variant = get_meta(
			"luxury_exchange_shiny_pending_authority_receipt",
			{}
		)

		if (
			player.stream == cached_stream
			and typeof(pending_raw) == TYPE_DICTIONARY
			and not (pending_raw as Dictionary).is_empty()
		):
			var pending_receipt: Dictionary = (
				(pending_raw as Dictionary).duplicate(false)
			)

			remove_meta(
				"luxury_exchange_shiny_pending_authority_receipt"
			)

			_play_luxury_exchange_shiny_audio_from_authority(
				pending_receipt
			)

		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var next_attempt_ms: int = int(
		get_meta(
			"luxury_exchange_shiny_audio_prewarm_next_ms",
			0
		)
	)

	if now_ms < next_attempt_ms:
		return

	set_meta(
		"luxury_exchange_shiny_audio_prewarm_next_ms",
		now_ms + 300
	)

	var engine = _ensure_era_audio_engine()

	if (
		engine == null
		or not engine.has_method(
			"request_audio_stream"
		)
	):
		return

	var report: Dictionary = (
		engine.request_audio_stream(
			MainSceneHelpers._luxury_exchange_shiny_audio_candidate_paths(),
			{
				"source": (
					"mainscene."
					+ "luxury_exchange_shiny_prewarm"
				),
				"one_shot": true,
				"precache_only": true,
				"ready_gate_member": false,
			}
		)
	)

	set_meta(
		"luxury_exchange_shiny_audio_prewarm_report",
		report.duplicate(true)
	)

	var stream_raw: Variant = report.get(
		"stream",
		null
	)

	if stream_raw is AudioStream:
		set_meta(
			"luxury_exchange_shiny_audio_stream_cache",
			stream_raw
		)
		set_meta(
			"luxury_exchange_shiny_audio_stream_path",
			str(
				report.get(
					"stream_path",
					""
				)
			)
		)
		set_meta(
			"luxury_exchange_shiny_audio_ready",
			true
		)
		set_meta(
			"luxury_exchange_shiny_audio_player_bound",
			false
		)
		set_meta(
			"luxury_exchange_shiny_stream_resolution_blocks_ui",
			false
		)
		set_meta(
			"luxury_exchange_shiny_stream_resolution_requires_input_idle",
			false
		)



		return

	if not bool(
		report.get(
			"pending",
			false
		)
	):
		set_meta(
			"luxury_exchange_shiny_audio_prewarm_next_ms",
			now_ms + 2000
		)
func _drive_luxury_exchange_surface_residency(
	_delta: float
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	_service_luxury_exchange_intent_quantum()

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var actor_id: int = int(
		gs.player.id
	)
	var era_name: String = (
		_food_lifestyle_current_era_name_for_mainscene()
	)
	var local_revision: int = int(
		get_meta(
			"luxury_exchange_local_market_revision",
			0
		)
	)
	var artifact_generation: int = int(
		get_meta(
			"luxury_exchange_artifact_generation",
			0
		)
	)

	var resident_signature: String = (
		"%d|%s|%d|market:%d|artifact:%d"
		% [
			actor_id,
			era_name,
			int(gs.year),
			local_revision,
			artifact_generation
		]
	)

	if (
		resident_signature
		!= luxury_exchange_resident_surface_signature
	):
		luxury_exchange_resident_surface_signature = (
			resident_signature
		)
		luxury_exchange_resident_surface_contract = {}
		luxury_exchange_resident_card_queue = []
		luxury_exchange_resident_card_cursor = 0
		luxury_exchange_resident_publish_active = false

		set_meta(
			"luxury_exchange_resident_attempt_signature",
			""
		)
		set_meta(
			"luxury_exchange_resident_failed_signature",
			""
		)

	if (
		luxury_exchange_resident_surface_contract.is_empty()
		and not luxury_exchange_resident_publish_active
	):
		var attempted_signature: String = str(
			get_meta(
				"luxury_exchange_resident_attempt_signature",
				""
			)
		).strip_edges()

		if attempted_signature == resident_signature:
			return

		set_meta(
			"luxury_exchange_resident_attempt_signature",
			resident_signature
		)

		var contract: Dictionary = (
			_luxury_exchange_request_surface_contract(
				(
					"mainscene."
					+ "luxury_exchange_resident_publication"
				)
			)
		)

		if contract.is_empty():
			set_meta(
				"luxury_exchange_resident_failed_signature",
				resident_signature
			)
			set_meta(
				"luxury_exchange_resident_publication_truth",
				{
					"success": false,
					"actor_id": actor_id,
					"era": era_name,
					"year": int(gs.year),
					"signature": resident_signature,
					"truth_state": (
						"surface_contract_unavailable"
					),
					"retry_policy": (
						"revision_change_only"
					),
					"requires_input_idle": false,
					"uses_call_deferred": false,
				}
			)
			return

		_ensure_luxury_exchange_panel()

		if (
			luxury_exchange_panel == null
			or not is_instance_valid(
				luxury_exchange_panel
			)
		):
			set_meta(
				"luxury_exchange_resident_failed_signature",
				resident_signature
			)
			return

		luxury_exchange_resident_surface_contract = (
			contract.duplicate(false)
		)

		var cards_raw: Variant = (
			contract.get(
				"card_contracts",
				[]
			)
		)
		luxury_exchange_resident_card_queue = (
			(cards_raw as Array).duplicate(false)
			if typeof(cards_raw) == TYPE_ARRAY
			else []
		)
		luxury_exchange_resident_card_cursor = 0
		luxury_exchange_resident_publish_active = true
		luxury_exchange_resident_publish_generation += 1
		luxury_exchange_resident_publish_next_ms = (
			now_ms
		)

		luxury_exchange_panel.begin_resident_surface_stream(
			gs.player,
			contract
		)

		if luxury_exchange_resident_card_queue.is_empty():
			luxury_exchange_resident_publish_active = false

			luxury_exchange_panel.finish_resident_surface_stream()

			set_meta(
				"luxury_exchange_resident_publication_truth",
				{
					"success": true,
					"actor_id": actor_id,
					"era": era_name,
					"year": int(gs.year),
					"signature": resident_signature,
					"generation": (
						luxury_exchange_resident_publish_generation
					),
					"published_cards": 0,
					"requires_input_idle": false,
					"uses_call_deferred": false,
				}
			)
			return

	if not luxury_exchange_resident_publish_active:
		return

	if now_ms < luxury_exchange_resident_publish_next_ms:
		return

	luxury_exchange_resident_publish_next_ms = (
		now_ms + 16
	)

	if (
		luxury_exchange_resident_card_cursor
		< luxury_exchange_resident_card_queue.size()
	):
		var raw_card: Variant = (
			luxury_exchange_resident_card_queue [
				luxury_exchange_resident_card_cursor
			]
		)

		luxury_exchange_resident_card_cursor += 1

		if typeof(raw_card) == TYPE_DICTIONARY:
			luxury_exchange_panel.append_resident_card_contract(
				(
					raw_card as Dictionary
				).duplicate(false)
			)

	if (
		luxury_exchange_resident_card_cursor
		>= luxury_exchange_resident_card_queue.size()
	):
		luxury_exchange_resident_publish_active = false

		luxury_exchange_panel.finish_resident_surface_stream()

		set_meta(
			"luxury_exchange_resident_publication_truth",
			{
				"success": true,
				"actor_id": actor_id,
				"era": era_name,
				"year": int(gs.year),
				"signature": resident_signature,
				"generation": (
					luxury_exchange_resident_publish_generation
				),
				"published_cards": (
					luxury_exchange_resident_card_cursor
				),
				"requires_input_idle": false,
				"uses_call_deferred": false,
				"completed_at_ms": now_ms
			}
		)
