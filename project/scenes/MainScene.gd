func _animate_standard_tab_experience(delta: float) -> void:
	if not standard_tab_popup_open:
		return
	standard_tab_experience_breathe_time += delta
	var pulse_strength: float = (sin(standard_tab_experience_breathe_time * 1.25) + 1.0) * 0.5
	var speed_scale: float = delta * 180.0
	for row_data in standard_tab_experience_rows:
		var label: Label = row_data.get("label", null)
		var bar: ProgressBar = row_data.get("bar", null)
		var title: String = str(row_data.get("title", ""))
		var target: float = float(row_data.get("target", 0.0))
		var danger: bool = bool(row_data.get("danger", false))
		if bar != null:
			bar.value = move_toward(float(bar.value), target, speed_scale)
			_refresh_player_stat_bar_value_text(
				bar,
				int(round(bar.value)),
				int(round(bar.max_value)),
				title
			)
			_refresh_player_stat_surface_title_text(
				label,
				bar,
				int(round(bar.value)),
				int(round(bar.max_value)),
				title
			)
		_apply_player_stat_row_visual_state(
			label,
			bar,
			title,
			player_stats_hovered_row_title == title,
			danger,
			pulse_strength
		)
	for widget in standard_tab_money_widgets:
		var value_label: Label = widget.get("value_label", null)
		var target_money: float = float(widget.get("target", 0.0))
		var current_money: float = float(widget.get("current", 0.0))
		var step: float = max(250.0, abs(target_money - current_money) * delta * 6.0)
		current_money = move_toward(current_money, target_money, step)
		widget ["current"] = current_money
		if value_label != null and gs != null and gs.economy_engine != null:
			value_label.text = gs.economy_engine.format_money(int(round(current_money)))
			value_label.modulate = Color(1.0, 1.0, 1.0, 0.88 + (0.12 * pulse_strength))


func _relationship_popup_add_info_card(title: String, lines: Array) -> void:
	if relationship_profile_popup_actions == null:
		return

	var clean_title: String = str(title).strip_edges().to_upper()
	if clean_title in ["RELATIONSHIP PULSE", "CURRENT PRESENCE"]:
		return

	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.add_theme_stylebox_override("panel", MainSceneHelpers._institution_hub_inner_panel_style("relationships"))
	relationship_profile_popup_actions.add_child(panel)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 10)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 10)
	margin.add_theme_constant_override("margin_bottom", 10)
	panel.add_child(margin)

	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 6)
	margin.add_child(vbox)

	var header:= Label.new()
	header.text = title
	vbox.add_child(header)

	var body:= RichTextLabel.new()
	body.bbcode_enabled = false
	body.fit_content = true
	body.scroll_active = false
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var text:= ""
	for line in lines:
		text += str(line) + "\n"
	body.text = text
	vbox.add_child(body)

func _relationship_popup_add_live_stat_row(title: String, value: int, max_value: int, surface_context: Dictionary = {}) -> void:
	var target_parent: Control = relationship_profile_popup_experience_grid
	if target_parent == null:
		target_parent = relationship_profile_popup_actions
	if target_parent == null:
		return

	var effective_surface_context: Dictionary = surface_context.duplicate(true) if typeof(surface_context) == TYPE_DICTIONARY else {}
	var subject_dead: bool = bool(effective_surface_context.get("subject_dead", false)) and title != "Bond"
	var safe_max: int = max(1, int(max_value))
	var display_value: int = 0 if subject_dead else clamp(int(value), 0, safe_max)

	var built:= _make_player_stat_row(title, safe_max)
	var row: VBoxContainer = built.row
	var label: Label = built.label
	var bar: ProgressBar = built.bar
	var flavor_label:= row.get_node_or_null("FlavorLabel") as Label

	row.custom_minimum_size = Vector2(0, 104)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.size_flags_vertical = Control.SIZE_EXPAND_FILL
	row.add_theme_constant_override("separation", 5)

	label.custom_minimum_size = Vector2(0, 24)
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER

	if flavor_label != null:
		flavor_label.custom_minimum_size = Vector2(0, 34)
		flavor_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		flavor_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		flavor_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		flavor_label.clip_text = true

	bar.custom_minimum_size = Vector2(0, 20)
	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.max_value = safe_max
	bar.value = display_value
	bar.set_meta("relationship_profile_stat_bar_truth_painted", true)
	bar.set_meta("relationship_profile_stat_bar_subject_title", title)
	bar.set_meta("player_stat_row_visual_signature", "")

	_apply_player_stat_surface_content(label, bar, title, display_value, safe_max, effective_surface_context)
	_apply_player_stat_row_visual_state(
		label,
		bar,
		title,
		false,
		title == "Health" and (subject_dead or display_value < 30),
		_safe_player_stat_power_pulse()
	)

	target_parent.add_child(row)

	relationship_popup_experience_rows.append({
		"title": title,
		"label": label,
		"bar": bar,
		"target": float(display_value),
		"danger": title == "Health" and (subject_dead or display_value < 30),
		"surface_ready": true,
		"last_visual_value": display_value,
		"last_visual_max": safe_max
	})
func _inject_relationship_profile_experience(target: Person) -> void:
	if target == null:
		return

	if gs != null and gs.has_method("sync_person_death_state_from_health"):
		gs.sync_person_death_state_from_health(target)

	var bond_score: int = MainSceneLogic._relationship_score_for_target(gs, target)
	var surface_context: Dictionary = _build_player_stat_surface_context(target, "third_person", gs.player)

	relationship_popup_money_widgets.clear()

	if relationship_profile_popup_bank_label != null:
		relationship_profile_popup_bank_label.text = _relationship_profile_bank_balance_text(target)

	_relationship_popup_add_live_stat_row("Bond", bond_score, 100, surface_context)
	_relationship_popup_add_live_stat_row("Hunger", int(round(_relationship_profile_hunger_value(target))), 100, surface_context)
	_relationship_popup_add_live_stat_row("Health", int(target.health), MainSceneHelpers._health_base_display_max(int(target.health)), surface_context)
	_relationship_popup_add_live_stat_row("Mental", int(target.mental_health), 100, surface_context)
	_relationship_popup_add_live_stat_row("Smarts", int(target.smarts), 100, surface_context)
	_relationship_popup_add_live_stat_row("Looks", int(target.looks), 100, surface_context)

func _animate_relationship_popup_experience(delta: float) -> void:
	if not relationship_profile_popup_open:
		return

	var active_target: Person = _relationship_profile_active_target()
	if active_target != null and relationship_profile_popup_bank_label != null:
		relationship_profile_popup_bank_label.text = _relationship_profile_bank_balance_text(active_target)

	relationship_popup_experience_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var next_visual_ms: int = int(get_meta("relationship_popup_next_visual_refresh_ms", 0))
	if now_ms < next_visual_ms:
		return

	set_meta("relationship_popup_next_visual_refresh_ms", now_ms + 84)

	var pulse_strength: float = clampf((sin(relationship_popup_experience_breathe_time * 0.55) + 1.0) * 0.09, 0.0, 0.18)

	for row_data in relationship_popup_experience_rows:
		var label: Label = row_data.get("label", null)
		var bar: ProgressBar = row_data.get("bar", null)
		var title: String = str(row_data.get("title", ""))
		var target: float = float(row_data.get("target", 0.0))
		var danger: bool = bool(row_data.get("danger", false))

		if bar != null:
			var target_value: int = clamp(int(round(target)), 0, int(round(bar.max_value)))
			if int(round(bar.value)) != target_value:
				bar.value = target_value
				_refresh_player_stat_bar_value_text(
					bar,
					target_value,
					int(round(bar.max_value)),
					title
				)

		_apply_player_stat_row_visual_state(
			label,
			bar,
			title,
			player_stats_hovered_row_title == title,
			danger,
			pulse_strength
		)

	for widget in relationship_popup_money_widgets:
		var value_label: Label = widget.get("value_label", null)
		var target_money: float = float(widget.get("target", 0.0))
		widget ["current"] = target_money
		if value_label != null and gs != null and gs.economy_engine != null:
			value_label.text = gs.economy_engine.format_money(int(round(target_money)))
			value_label.modulate = Color(1.0, 1.0, 1.0, 0.88 + (0.12 * pulse_strength))
func _apply_ui_nav_button_visuals() -> void:
	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var visibility: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_visibility",
			{}
		)
	)
	var god_mode_locked: bool = _god_mode_ui_locked()
	var tabs_locked: bool = _standard_tabs_locked()

	for raw_key in ui_nav_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = (
			ui_nav_buttons.get(
				raw_key,
				null
			) as Button
		)

		if (
			button == null
			or not is_instance_valid(button)
		):
			continue

		button.visible = bool(
			visibility.get(
				key,
				true
			)
		)
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if button.visible
			else Control.MOUSE_FILTER_IGNORE
		)

		if not button.visible:
			button.disabled = true
			button.focus_mode = Control.FOCUS_NONE
			button.process_mode = (
				Node.PROCESS_MODE_DISABLED
			)
			button.set_meta(
				"ui_nav_visual_signature",
				"hidden|%s" % key
			)

			var hidden_sheen:= (
				_ensure_ui_nav_button_sheen(
					button,
					key
				)
			)

			if hidden_sheen != null:
				hidden_sheen.visible = false

			continue

		button.disabled = false
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)

		var this_button_locked: bool = (
			god_mode_locked
			or (
				tabs_locked
				and key != "age_up"
			)
		)
		var is_active: bool = (
			key == current_panel
			and key != "age_up"
		)
		var is_hovered: bool = (
			ui_nav_button_hovered_key == key
		)
		var pulse_strength: float = float(
			ui_nav_button_pulse.get(
				key,
				0.0
			)
		)

		if (
			(
				key == current_panel
				or key == ui_nav_button_hovered_key
			)
			and key != "age_up"
		):
			var active_breathe: float = (
				0.5
				+ 0.5
				* sin(
					ui_nav_button_breathe_time
					* 2.45
				)
			)
			var hover_bonus: float = (
				0.08
				if key == ui_nav_button_hovered_key
				else 0.0
			)
			pulse_strength = max(
				pulse_strength,
				0.22
				+ hover_bonus
				+ active_breathe * 0.26
			)

		var press_depth: float = float(
			ui_nav_button_press_depth.get(
				key,
				0.0
			)
		)

		if this_button_locked:
			is_hovered = false
			pulse_strength = 0.0
			press_depth = 0.0

		var state: String = "normal"

		if is_active and not this_button_locked:
			state = "active"
		elif is_hovered and not this_button_locked:
			state = "hover"

		var visual_signature: String = "%s|%s|%s|%d|%d" % [
			key,
			state,
			str(this_button_locked),
			int(
				round(
					pulse_strength * 20.0
				)
			),
			int(
				round(
					press_depth * 20.0
				)
			)
		]

		if str(
			button.get_meta(
				"ui_nav_visual_signature",
				""
			)
		) == visual_signature:
			continue

		button.set_meta(
			"ui_nav_visual_signature",
			visual_signature
		)

		var normal_tokens: Dictionary = (
			_ui_nav_button_theme_tokens(
				key,
				state,
				pulse_strength,
				this_button_locked
			)
		)
		var hover_tokens: Dictionary = (
			_ui_nav_button_theme_tokens(
				key,
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.25
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked
			)
		)
		var pressed_tokens: Dictionary = (
			_ui_nav_button_theme_tokens(
				key,
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.82
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked
			)
		)
		var focus_tokens: Dictionary = (
			_ui_nav_button_theme_tokens(
				key,
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.5
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked
			)
		)

		button.add_theme_stylebox_override(
			"normal",
			_build_ui_nav_button_style(
				state,
				pulse_strength,
				this_button_locked,
				key
			)
		)
		button.add_theme_stylebox_override(
			"hover",
			_build_ui_nav_button_style(
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.25
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked,
				key
			)
		)
		button.add_theme_stylebox_override(
			"pressed",
			_build_ui_nav_button_style(
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.82
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked,
				key
			)
		)
		button.add_theme_stylebox_override(
			"focus",
			_build_ui_nav_button_style(
				(
					"active"
					if (
						is_active
						and not this_button_locked
					)
					else "hover"
				),
				(
					max(
						pulse_strength,
						0.5
					)
					if not this_button_locked
					else 0.0
				),
				this_button_locked,
				key
			)
		)

		var text_color: Color = normal_tokens.get(
			"text",
			Color(
				0.97,
				0.995,
				1.0,
				1.0
			)
		)
		var hover_text_color: Color = (
			hover_tokens.get(
				"text_hover",
				text_color
			)
		)
		var shadow_color: Color = normal_tokens.get(
			"text_shadow",
			Color(
				0.1,
				0.22,
				0.3,
				0.28
			)
		)
		var sheen_progress: float = float(
			ui_nav_button_sheen_progress.get(
				key,
				1.0
			)
		)
		var sheen_intensity: float = float(
			ui_nav_button_sheen_intensity.get(
				key,
				0.0
			)
		)
		var sheen_direction: float = float(
			ui_nav_button_sheen_direction.get(
				key,
				1.0
			)
		)
		var sheen_curve: float = sin(
			clamp(
				sheen_progress,
				0.0,
				1.0
			) * PI
		)
		var sheen_strength: float = (
			0.0
			if this_button_locked
			else clamp(
				sheen_intensity * sheen_curve,
				0.0,
				1.0
			)
		)
		var shadow_offset_x: int = (
			0
			if this_button_locked
			else int(
				round(
					2.0
					* sheen_strength
					* sheen_direction
				)
			)
		)

		button.add_theme_color_override(
			"font_color",
			text_color
		)
		button.add_theme_color_override(
			"font_hover_color",
			hover_text_color
		)
		button.add_theme_color_override(
			"font_pressed_color",
			pressed_tokens.get(
				"text_hover",
				hover_text_color
			)
		)
		button.add_theme_color_override(
			"font_focus_color",
			focus_tokens.get(
				"text_hover",
				hover_text_color
			)
		)
		button.add_theme_color_override(
			"font_shadow_color",
			shadow_color
		)
		button.add_theme_constant_override(
			"shadow_offset_x",
			shadow_offset_x
		)
		button.add_theme_constant_override(
			"shadow_offset_y",
			(
				1
				if not this_button_locked
				else 0
			)
		)
		button.add_theme_constant_override(
			"outline_size",
			int(
				normal_tokens.get(
					"outline_size",
					0
				)
			)
		)
		button.mouse_default_cursor_shape = (
			Control.CURSOR_ARROW
			if this_button_locked
			else Control.CURSOR_POINTING_HAND
		)
		button.pivot_offset = button.size * 0.5

		var compact_min_height: float = (
			28.0
			if key == "age_up"
			else 24.0
		)
		button.custom_minimum_size = Vector2(
			button.custom_minimum_size.x,
			compact_min_height
		)
		button.set_meta(
			"ui_nav_sound_hover",
			str(
				normal_tokens.get(
					"sound_hover_id",
					""
				)
			)
		)
		button.set_meta(
			"ui_nav_sound_press",
			str(
				normal_tokens.get(
					"sound_press_id",
					""
				)
			)
		)
		button.set_meta(
			"ui_nav_sound_active",
			str(
				normal_tokens.get(
					"sound_active_id",
					""
				)
			)
		)

		var target_scale: float = float(
			normal_tokens.get(
				"base_scale",
				1.0
			)
		)
		target_scale -= 0.03 * press_depth
		target_scale = max(
			0.94,
			target_scale
		)

		var target_alpha: float = float(
			normal_tokens.get(
				"target_alpha",
				0.96
			)
		)
		var scale_lerp_weight: float = 0.32
		var alpha_lerp_weight: float = 0.28

		button.scale = button.scale.lerp(
			Vector2.ONE * target_scale,
			scale_lerp_weight
		)
		button.modulate = button.modulate.lerp(
			Color(
				1.0,
				1.0,
				1.0,
				target_alpha
			),
			alpha_lerp_weight
		)

		var sheen:= _ensure_ui_nav_button_sheen(
			button,
			key
		)

		if sheen != null:
			var sheen_material:= (
				sheen.material as ShaderMaterial
			)

			if sheen_material != null:
				var sheen_color: Color = (
					hover_tokens.get(
						"text_hover",
						text_color
					)
				)
				sheen_color.a = (
					0.18
					+ (
						0.04
						if is_active
						else 0.0
					)
					+ (
						0.03
						if key == "age_up"
						else 0.0
					)
				)

				sheen_material.set_shader_parameter(
					"progress",
					clamp(
						sheen_progress,
						0.0,
						1.0
					)
				)
				sheen_material.set_shader_parameter(
					"strength",
					sheen_strength
				)
				sheen_material.set_shader_parameter(
					"direction",
					sheen_direction
				)
				sheen_material.set_shader_parameter(
					"band_width",
					(
						0.22
						if key == "age_up"
						else 0.18
					)
				)
				sheen_material.set_shader_parameter(
					"sheen_color",
					sheen_color
				)

			sheen.visible = (
				sheen_strength > 0.001
				and not this_button_locked
			)


func _on_ui_nav_button_mouse_entered(key: String) -> void:
	ui_nav_button_hovered_key = key
	ui_nav_button_pulse [key] = max(float(ui_nav_button_pulse.get(key, 0.0)), 0.18)
	_apply_ui_nav_button_visuals()

func _on_ui_nav_button_mouse_exited(key: String) -> void:
	if ui_nav_button_hovered_key == key:
		ui_nav_button_hovered_key = ""
	_apply_ui_nav_button_visuals()

func _on_ui_nav_button_pressed(key: String) -> void:
	var clean_key: String = str(key).strip_edges().to_lower()
	if clean_key == "":
		return

	ui_nav_button_pulse [clean_key] = 1.15 if clean_key == "age_up" else 1.0
	ui_nav_button_press_depth [clean_key] = 1.0

	set_meta("ui_nav_button_pressed_key", clean_key)
	set_meta("ui_nav_button_pressed_at_ms", int(Time.get_ticks_msec()))
	set_meta("ui_nav_button_pressed_input_contract_hot", bool(get_meta("main_tab_input_contract_hot", false)))

	if clean_key == "age_up":
		set_meta("age_up_nav_button_pressed_from_unified_nav_contract", true)
		set_meta("age_up_nav_button_pressed_at_ms", int(Time.get_ticks_msec()))
		_apply_ui_nav_button_visuals()
		_on_button_pressed()
		return

	if clean_key in [
		"world",
		"life",
		"school",
		"activities",
		"relationships",
		"career",
		"mods"
	]:
		if _standard_tabs_locked():
			set_meta("ui_nav_button_press_blocked_standard_tabs_locked", true)
			set_meta("ui_nav_button_press_blocked_key", clean_key)
			set_meta("ui_nav_button_press_blocked_at_ms", int(Time.get_ticks_msec()))
			_apply_ui_nav_button_visuals()
			return

		set_meta("ui_nav_button_pressed_used_zero_frame_door", true)
		set_meta("ui_nav_button_pressed_key", clean_key)
		set_meta("ui_nav_button_pressed_at_ms", int(Time.get_ticks_msec()))
		set_meta("ui_nav_button_pressed_generic_panel_forbidden", true)
		set_meta("ui_nav_button_pressed_build_forbidden", true)
		set_meta("ui_nav_button_pressed_reveal_only", true)

		_open_main_tab_zero_frame_door(clean_key, "%s_ui_nav_button_pressed" % clean_key)
		return

	_apply_ui_nav_button_visuals()
func _register_ui_nav_button(button: Button) -> void:
	if button == null or not is_instance_valid(button):
		return

	var key:= MainSceneHelpers._normalize_ui_nav_button_text(button.text)

	if key == "" and button.has_meta("ui_nav_key"):
		key = str(button.get_meta("ui_nav_key", "")).strip_edges().to_lower()

	if key == "":
		return

	button.set_meta("ui_nav_key", key)
	button.set_meta("main_tab_input_contract_button", key != "age_up")
	button.set_meta("main_tab_input_contract_registered_at_ms", int(Time.get_ticks_msec()))

	button.text = _ui_nav_button_display_label(key)

	ui_nav_buttons [key] = button

	if not ui_nav_button_pulse.has(key):
		ui_nav_button_pulse [key] = 0.0
	if not ui_nav_button_press_depth.has(key):
		ui_nav_button_press_depth [key] = 0.0
	if not ui_nav_button_sheen_progress.has(key):
		ui_nav_button_sheen_progress [key] = 1.0
	if not ui_nav_button_sheen_intensity.has(key):
		ui_nav_button_sheen_intensity [key] = 0.0
	if not ui_nav_button_sheen_direction.has(key):
		ui_nav_button_sheen_direction [key] = 1.0
	if not ui_nav_button_sheen_speed.has(key):
		ui_nav_button_sheen_speed [key] = 0.0

	_ensure_ui_nav_button_sheen(button, key)

	var entered_cb:= Callable(self, "_on_ui_nav_button_mouse_entered").bind(key)
	var exited_cb:= Callable(self, "_on_ui_nav_button_mouse_exited").bind(key)
	var pressed_cb:= Callable(self, "_on_ui_nav_button_pressed").bind(key)

	if not button.mouse_entered.is_connected(entered_cb):
		button.mouse_entered.connect(entered_cb)
	if not button.mouse_exited.is_connected(exited_cb):
		button.mouse_exited.connect(exited_cb)
	if not button.pressed.is_connected(pressed_cb):
		button.pressed.connect(pressed_cb)

	button.visible = true
	button.disabled = false
	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.focus_mode = Control.FOCUS_NONE
	button.process_mode = Node.PROCESS_MODE_INHERIT
	button.z_as_relative = false
	button.z_index = 20

	_apply_ui_nav_button_visuals()
func _ensure_ui_nav_button_sheen(button: Button, _key: String) -> ColorRect:
	if button == null:
		return null

	var sheen:= button.get_node_or_null("__ui_nav_sheen") as ColorRect
	if sheen != null:
		return sheen

	sheen = ColorRect.new()
	sheen.name = "__ui_nav_sheen"
	sheen.mouse_filter = Control.MOUSE_FILTER_IGNORE
	sheen.visible = false
	sheen.z_index = 2
	sheen.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	sheen.offset_left = 0.0
	sheen.offset_top = 0.0
	sheen.offset_right = 0.0
	sheen.offset_bottom = 0.0

	var shader:= Shader.new()
	shader.code = "\nshader_type canvas_item;\nrender_mode unshaded, blend_add;\n\nuniform float progress : hint_range(0.0, 1.0) = 0.0;\nuniform float strength : hint_range(0.0, 1.0) = 0.0;\nuniform float direction = 1.0;\nuniform vec4 sheen_color : source_color = vec4(1.0, 1.0, 1.0, 0.22);\nuniform float band_width : hint_range(0.06, 0.45) = 0.18;\n\nvoid fragment() {\n\tfloat uvx = UV.x;\n\tif (direction < 0.0) {\n\t\tuvx = 1.0 - uvx;\n\t}\n\n\tfloat center = mix(-band_width, 1.0 + band_width, progress);\n\tfloat dist = abs(uvx - center);\n\tfloat band = 1.0 - smoothstep(0.0, band_width, dist);\n\tfloat vertical_fade = smoothstep(0.0, 0.16, UV.y) * smoothstep(0.0, 0.16, 1.0 - UV.y);\n\tfloat alpha = band * strength * vertical_fade * sheen_color.a;\n\n\tCOLOR = vec4(sheen_color.rgb, alpha);\n}\n"

























	var sheen_material:= ShaderMaterial.new()
	sheen_material.shader = shader
	sheen.material = sheen_material

	button.add_child(sheen)
	return sheen
func _trigger_ui_nav_button_sheen(
	key: String,
	direction: float,
	duration: float = 0.18,
	intensity: float = 1.0
) -> void:
	if key == "" or not ui_nav_buttons.has(key):
		return

	if absf(direction) < 0.001:
		ui_nav_button_sheen_progress [key] = 1.0
		ui_nav_button_sheen_intensity [key] = 0.0
		ui_nav_button_sheen_speed [key] = 0.0
		_apply_ui_nav_button_visuals()
		return

	ui_nav_button_sheen_progress [key] = 0.0
	ui_nav_button_sheen_intensity [key] = clamp(intensity, 0.0, 1.0)
	ui_nav_button_sheen_direction [key] = 1.0 if direction >= 0.0 else -1.0

	var tuned_duration: float = max(0.08, duration * 0.82)
	ui_nav_button_sheen_speed [key] = 1.0 / tuned_duration

	_apply_ui_nav_button_visuals()

func _get_ui_nav_order() -> Array [String]:
	var base_order: Array [String] = [
		"world",
		"life",
		"school",
		"activities",
		"relationships",
		"career",
		"mods",
		"age_up"
	]
	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var visibility: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_visibility",
			{}
		)
	)
	var order: Array [String] = []

	for key in base_order:
		if (
			visibility.has(key)
			and not bool(
				visibility.get(
					key,
					true
				)
			)
		):
			continue

		order.append(key)

	return order
func _get_ui_nav_index(panel_key: String) -> int:
	if panel_key == "":
		return -1
	var order: Array [String] = _get_ui_nav_order()
	return order.find(panel_key)

func _resolve_panel_transition_direction(from_panel: String, to_panel: String) -> float:
	var from_index: int = _get_ui_nav_index(from_panel)
	var to_index: int = _get_ui_nav_index(to_panel)
	if from_index == -1 or to_index == -1 or from_index == to_index:
		return 0.0
	return 1.0 if to_index > from_index else -1.0

func _bind_ui_nav_buttons() -> void:
	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	_ensure_profile_nav_button()
	_ensure_mod_nav_button()

	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var visibility: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_visibility",
			{}
		)
	)
	var scan_roots: Array = []

	if root != null and is_instance_valid(root):
		scan_roots.append(root)

	scan_roots.append(self)

	ui_nav_buttons.clear()

	for scan_root in scan_roots:
		if (
			scan_root == null
			or not is_instance_valid(scan_root)
		):
			continue

		for node in scan_root.find_children(
			"*",
			"Button",
			true,
			false
		):
			var button:= node as Button

			if (
				button == null
				or not is_instance_valid(button)
			):
				continue

			var key: String = (
				MainSceneHelpers._normalize_ui_nav_button_text(
					button.text
				)
			)

			if (
				key == ""
				and button.has_meta("ui_nav_key")
			):
				key = str(
					button.get_meta(
						"ui_nav_key",
						""
					)
				).strip_edges().to_lower()

			if key == "":
				continue

			if ui_nav_buttons.has(key):
				continue

			_register_ui_nav_button(button)

	ui_nav_buttons.erase("profile")

	for raw_key in ui_nav_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = (
			ui_nav_buttons.get(
				raw_key,
				null
			) as Button
		)

		if (
			button == null
			or not is_instance_valid(button)
		):
			continue

		button.visible = bool(
			visibility.get(
				key,
				true
			)
		)
		button.disabled = not button.visible
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if button.visible
			else Control.MOUSE_FILTER_IGNORE
		)
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = (
			Node.PROCESS_MODE_INHERIT
			if button.visible
			else Node.PROCESS_MODE_DISABLED
		)

	var desired_order: Array [String] = (
		_get_ui_nav_order()
	)
	var nav_parent: Node = null
	var base_index: int = 2147483647

	for key in desired_order:
		var ordered_button:= (
			ui_nav_buttons.get(
				key,
				null
			) as Button
		)

		if (
			ordered_button == null
			or not is_instance_valid(
				ordered_button
			)
			or not ordered_button.visible
		):
			continue

		if nav_parent == null:
			nav_parent = ordered_button.get_parent()

		if ordered_button.get_parent() == nav_parent:
			base_index = min(
				base_index,
				ordered_button.get_index()
			)

	if (
		nav_parent != null
		and base_index != 2147483647
	):
		var insert_index: int = base_index

		for key in desired_order:
			var ordered_button:= (
				ui_nav_buttons.get(
					key,
					null
				) as Button
			)

			if (
				ordered_button == null
				or not is_instance_valid(
					ordered_button
				)
				or not ordered_button.visible
			):
				continue

			if ordered_button.get_parent() != nav_parent:
				continue

			ordered_button.visible = bool(
				visibility.get(
					key,
					true
				)
			)
			ordered_button.disabled = (
				not ordered_button.visible
			)
			ordered_button.mouse_filter = (
				Control.MOUSE_FILTER_STOP
				if ordered_button.visible
				else Control.MOUSE_FILTER_IGNORE
			)
			ordered_button.focus_mode = (
				Control.FOCUS_NONE
			)
			ordered_button.process_mode = (
				Node.PROCESS_MODE_INHERIT
				if ordered_button.visible
				else Node.PROCESS_MODE_DISABLED
			)
			ordered_button.z_as_relative = false
			ordered_button.z_index = 20

			nav_parent.move_child(
				ordered_button,
				insert_index
			)
			insert_index += 1

	var visible_button_count: int = 0

	for raw_key in ui_nav_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = (
			ui_nav_buttons.get(
				raw_key,
				null
			) as Button
		)

		if (
			button == null
			or not is_instance_valid(button)
		):
			continue

		button.visible = bool(
			visibility.get(
				key,
				true
			)
		)
		button.disabled = not button.visible
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if button.visible
			else Control.MOUSE_FILTER_IGNORE
		)
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = (
			Node.PROCESS_MODE_INHERIT
			if button.visible
			else Node.PROCESS_MODE_DISABLED
		)
		button.set_meta(
			"main_tab_input_contract_bound",
			button.visible
		)
		button.set_meta(
			"main_tab_input_contract_bound_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		if button.visible:
			visible_button_count += 1

	set_meta(
		"main_tab_input_contract_bound_button_count",
		visible_button_count
	)
	set_meta(
		"main_tab_input_contract_registered_button_count",
		ui_nav_buttons.size()
	)
	set_meta(
		"main_tab_input_contract_bound_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _arm_main_tab_input_contract_for_playable_shell(reason: String = "main_tab_input_contract") -> void:
	_bind_ui_nav_buttons()

	var desired_order: Array [String] = _get_ui_nav_order()
	var missing: Array [String] = []
	var armed: Array [String] = []

	for key in desired_order:
		var button: Button = ui_nav_buttons.get(key, null) as Button
		if button == null or not is_instance_valid(button):
			missing.append(key)
			continue

		button.visible = true
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = Node.PROCESS_MODE_INHERIT
		button.z_as_relative = false
		button.z_index = 20
		button.set_meta("main_tab_input_contract_hot", true)
		button.set_meta("main_tab_input_contract_reason", reason)
		button.set_meta("main_tab_input_contract_armed_at_ms", int(Time.get_ticks_msec()))

		armed.append(key)

	set_meta("main_tab_input_contract_hot", missing.is_empty())
	set_meta("main_tab_input_contract_reason", reason)
	set_meta("main_tab_input_contract_armed", armed.duplicate())
	set_meta("main_tab_input_contract_missing", missing.duplicate())
	set_meta("main_tab_input_contract_armed_at_ms", int(Time.get_ticks_msec()))
	set_meta("main_tab_input_contract_build_forbidden", true)
	set_meta("main_tab_input_contract_reveal_only", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_tab_input_contract_hot"] = missing.is_empty()
		gs.scenario_state ["main_tab_input_contract_reason"] = reason
		gs.scenario_state ["main_tab_input_contract_armed"] = armed.duplicate()
		gs.scenario_state ["main_tab_input_contract_missing"] = missing.duplicate()
		gs.scenario_state ["main_tab_input_contract_build_forbidden"] = true
		gs.scenario_state ["main_tab_input_contract_reveal_only"] = true

	_apply_ui_nav_button_visuals()
func _animate_ui_nav_buttons(
		delta: float
) -> void:
	if ui_nav_buttons.is_empty():
		return

	var active_key: String = str(
		current_panel
	).strip_edges().to_lower()
	var full_surface_owns_frame: bool = (
		active_key in [
			"world",
			"relationships",
			"school",
			"career",
			"activities",
			"mods"
		]
	)

	if full_surface_owns_frame:
		var visible_global_nav_found: bool = false

		for raw_button in ui_nav_buttons.values():
			var button:= raw_button as Button

			if (
				button != null
				and is_instance_valid(
					button
				)
				and button.visible
			):
				visible_global_nav_found = true
				break

		if visible_global_nav_found:
			_apply_main_tab_press_frame_nav_state(
				active_key,
				"nav_animation_full_surface_guard"
			)

		return

	ui_nav_button_breathe_time += delta

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var next_visual_ms: int = int(
		get_meta(
			"ui_nav_next_visual_apply_ms",
			0
		)
	)
	var dirty: bool = false
	var hovered_key: String = str(
		ui_nav_button_hovered_key
	).strip_edges().to_lower()

	for key in ui_nav_buttons.keys():
		var motion_tokens: Dictionary = (
			_ui_nav_button_theme_tokens(
				key,
				"normal",
				0.0,
				false
			)
		)
		var pulse_decay_speed: float = float(
			motion_tokens.get(
				"pulse_decay_speed",
				2.8
			)
		)
		var press_recover_speed: float = float(
			motion_tokens.get(
				"press_recover_speed",
				9.0
			)
		)

		var current_pulse: float = float(
			ui_nav_button_pulse.get(
				key,
				0.0
			)
		)
		var next_pulse: float = move_toward(
			current_pulse,
			0.0,
			delta * pulse_decay_speed
		)

		if absf(
			next_pulse - current_pulse
		) > 0.0001:
			ui_nav_button_pulse [key] = next_pulse
			dirty = true

		var current_press_depth: float = float(
			ui_nav_button_press_depth.get(
				key,
				0.0
			)
		)
		var next_press_depth: float = move_toward(
			current_press_depth,
			0.0,
			delta * press_recover_speed
		)

		if absf(
			next_press_depth - current_press_depth
		) > 0.0001:
			ui_nav_button_press_depth [key] = (
				next_press_depth
			)
			dirty = true

		var current_sheen_progress: float = float(
			ui_nav_button_sheen_progress.get(
				key,
				1.0
			)
		)
		var current_sheen_intensity: float = float(
			ui_nav_button_sheen_intensity.get(
				key,
				0.0
			)
		)
		var current_sheen_speed: float = float(
			ui_nav_button_sheen_speed.get(
				key,
				0.0
			)
		)

		if (
			current_sheen_intensity > 0.001
			and current_sheen_progress < 1.0
			and current_sheen_speed > 0.0
		):
			var next_sheen_progress: float = min(
				1.0,
				current_sheen_progress
				+ (
					delta
					* current_sheen_speed
				)
			)

			if absf(
				next_sheen_progress
				- current_sheen_progress
			) > 0.0001:
				ui_nav_button_sheen_progress [key] = (
					next_sheen_progress
				)
				dirty = true

			if next_sheen_progress >= 1.0:
				ui_nav_button_sheen_intensity [key] = 0.0
				ui_nav_button_sheen_speed [key] = 0.0
				dirty = true

	var pulse_bucket: int = int(
		round(
			(
				0.5
				+ (
					0.5
					* sin(
						ui_nav_button_breathe_time
						* 2.45
					)
				)
			) * 20.0
		)
	)
	var last_pulse_bucket: int = int(
		get_meta(
			"ui_nav_active_pulse_bucket",
			-1
		)
	)
	var breathing_key_active: bool = (
		active_key != ""
		or hovered_key != ""
	)
	var pulse_dirty: bool = (
		breathing_key_active
		and pulse_bucket != last_pulse_bucket
	)

	if pulse_dirty:
		set_meta(
			"ui_nav_active_pulse_bucket",
			pulse_bucket
		)

	if (
		not dirty
		and not pulse_dirty
	):
		return

	if (
		now_ms < next_visual_ms
		and not pulse_dirty
	):
		return

	set_meta(
		"ui_nav_next_visual_apply_ms",
		now_ms + 16
	)

	_apply_ui_nav_button_visuals()
