func _install_incarceration_nearby_surface(
		cards: Array
) -> void:


	_ensure_nearby_switch_popup()

	if (
		nearby_switch_popup == null
		or nearby_switch_list == null
	):
		return

	if nearby_switch_title_label != null:
		nearby_switch_title_label.text = "NEARBY PRISONERS"

	if nearby_switch_status_label != null:
		nearby_switch_status_label.text = (
			"%d resident prisoner cards."
			% cards.size()
		)

	_clear_container_children(
		nearby_switch_list
	)

	if cards.is_empty():
		var empty:= Label.new()
		empty.text = "No other prisoners are currently resident in this facility."
		empty.horizontal_alignment = (
			HORIZONTAL_ALIGNMENT_CENTER
		)
		nearby_switch_list.add_child(
			empty
		)
	else:
		for raw_card in cards:
			if typeof(raw_card) != TYPE_DICTIONARY:
				continue

			var card: Dictionary = raw_card as Dictionary
			var target_id: int = int(
				card.get(
					"target_id",
					-1
				)
			)

			if target_id <= 0:
				continue

			var button:= Button.new()
			button.alignment = (
				HORIZONTAL_ALIGNMENT_LEFT
			)
			button.size_flags_horizontal = (
				Control.SIZE_EXPAND_FILL
			)
			button.custom_minimum_size = Vector2(
				0,
				58
			)
			button.text = (
				"%s\n%s"
				% [
					str(
						card.get(
							"label",
							"Prisoner"
						)
					),
					str(
						card.get(
							"subtitle",
							"Current prisoner"
						)
					)
				]
			)

			button.add_theme_stylebox_override(
				"normal",
				_build_ui_nav_button_style(
					"normal",
					0.18,
					false
				)
			)
			button.add_theme_stylebox_override(
				"hover",
				_build_ui_nav_button_style(
					"hover",
					0.4,
					false
				)
			)
			button.add_theme_stylebox_override(
				"pressed",
				_build_ui_nav_button_style(
					"pressed",
					0.6,
					false
				)
			)

			button.pressed.connect(
				_on_nearby_switch_target_pressed.bind(
					target_id
				)
			)

			nearby_switch_list.add_child(
				button
			)

	nearby_switch_popup.set_meta(
		"incarceration_resident_deck",
		true
	)
	nearby_switch_popup.set_meta(
		"population_scan_performed",
		false
	)
	nearby_switch_popup.set_meta(
		"contract_card_count",
		cards.size()
	)


func _install_incarceration_other_facilities_surface(
		cards: Array
) -> void:


	_ensure_other_countries_popup()

	var popup:= get_node_or_null(
		"OtherCountriesPopup"
	)

	if popup == null:
		return

	var title:= popup.find_child(
		"Title",
		true,
		false
	) as Label
	var status:= popup.find_child(
		"Status",
		true,
		false
	) as Label
	var list:= popup.find_child(
		"List",
		true,
		false
	) as VBoxContainer

	if list == null:
		return

	if title != null:
		title.text = "OTHER FACILITIES"

	if status != null:
		status.text = (
			"%d known custody facilities are resident."
			% cards.size()
		)

	_clear_container_children(
		list
	)

	if cards.is_empty():
		var empty:= Label.new()
		empty.text = "No other facilities are currently known to this reality."
		empty.horizontal_alignment = (
			HORIZONTAL_ALIGNMENT_CENTER
		)
		empty.autowrap_mode = (
			TextServer.AUTOWRAP_WORD_SMART
		)
		list.add_child(
			empty
		)
	else:
		for raw_card in cards:
			if typeof(raw_card) != TYPE_DICTIONARY:
				continue

			var card: Dictionary = raw_card as Dictionary
			var panel:= PanelContainer.new()
			panel.size_flags_horizontal = (
				Control.SIZE_EXPAND_FILL
			)
			panel.custom_minimum_size = Vector2(
				0,
				72
			)

			var root:= VBoxContainer.new()
			root.add_theme_constant_override(
				"separation",
				4
			)
			panel.add_child(
				root
			)

			var name_label:= Label.new()
			name_label.text = str(
				card.get(
					"label",
					"Facility"
				)
			)
			name_label.add_theme_font_size_override(
				"font_size",
				16
			)
			root.add_child(
				name_label
			)

			var subtitle_label:= Label.new()
			subtitle_label.text = str(
				card.get(
					"subtitle",
					""
				)
			)
			subtitle_label.autowrap_mode = (
				TextServer.AUTOWRAP_WORD_SMART
			)
			root.add_child(
				subtitle_label
			)

			panel.set_meta(
				"facility_id",
				str(
					card.get(
						"facility_id",
						""
					)
				)
			)
			panel.set_meta(
				"incarceration_kind",
				str(
					card.get(
						"incarceration_kind",
						""
					)
				)
			)
			panel.set_meta(
				"immutable_facility_contract",
				true
			)

			list.add_child(
				panel
			)

	popup.set_meta(
		"incarceration_facility_deck_resident",
		true
	)
	popup.set_meta(
		"realm_cards_used",
		false
	)
	popup.set_meta(
		"realm_engine_called",
		false
	)
	popup.set_meta(
		"facility_contract_count",
		cards.size()
	)


func _release_incarceration_resident_surfaces(
		reason: String = "incarceration_released"
) -> void:
	var facility_surface:= find_child(
		"IncarcerationFacilityFeed",
		true,
		false
	) as RichTextLabel

	if facility_surface != null:
		facility_surface.visible = false

	var sentence_surface:= find_child(
		"IncarcerationSentenceSurface",
		true,
		false
	) as RichTextLabel

	if sentence_surface != null:
		sentence_surface.visible = false

	if world_feed_popup_feed != null:
		world_feed_popup_feed.visible = true

	if world_feed_popup_title != null:
		world_feed_popup_title.text = "WORLD"

	if nearby_switch_title_label != null:
		nearby_switch_title_label.text = "NEAR BY"

	if nearby_switch_status_label != null:
		nearby_switch_status_label.text = ""

	if (
		nearby_switch_list != null
		and is_instance_valid(
			nearby_switch_list
		)
	):
		_clear_container_children(
			nearby_switch_list
		)

	if nearby_switch_popup != null:
		nearby_switch_popup.set_meta(
			"incarceration_resident_deck",
			false
		)

	var other_popup:= get_node_or_null(
		"OtherCountriesPopup"
	)

	if other_popup != null:
		var title:= other_popup.find_child(
			"Title",
			true,
			false
		) as Label
		var status:= other_popup.find_child(
			"Status",
			true,
			false
		) as Label
		var list:= other_popup.find_child(
			"List",
			true,
			false
		) as VBoxContainer

		if title != null:
			title.text = "OTHER COUNTRIES / REALMS"

		if status != null:
			status.text = (
				"Realm surfaces are preparing in the resident observation lane."
			)

		if list != null:
			_clear_container_children(
				list
			)

		other_popup.set_meta(
			"incarceration_facility_deck_resident",
			false
		)

	set_meta(
		"resident_incarceration_facility_surface_contract",
		{}
	)
	set_meta(
		"resident_incarceration_sentence_surface_contract",
		{}
	)
	set_meta(
		"incarceration_resident_surfaces_installed",
		false
	)
	set_meta(
		"incarceration_resident_surfaces_release_reason",
		reason
	)
	set_meta(
		"incarceration_release_engine_calls",
		false
	)
	set_meta(
		"incarceration_release_rebuild_performed",
		false
	)

func _render_incarceration_world_tab(context: Dictionary, _reason: String = "incarceration_world") -> void:
	var lines: Array = MainSceneHelpers._incarceration_base_lines(context)
	var world: Dictionary = MainSceneHelpers._safe_dictionary(context.get("world_snapshot", {}))

	lines.append("")
	lines.append("===== PRISON ECOSYSTEM =====")
	lines.append("Total Inmates: %d" % int(world.get("total_inmates", 0)))
	lines.append("Live Counter: %s" % ("Active" if bool(world.get("live_counter", false)) else "Dormant"))

	var factions: Array = MainSceneHelpers._safe_array(world.get("factions", []))
	if not factions.is_empty():
		lines.append("")
		lines.append("Factions / Groups:")
		for raw_faction in factions:
			lines.append("• %s" % str(raw_faction))

	var events: Array = MainSceneHelpers._safe_array(world.get("recent_events", []))
	if not events.is_empty():
		lines.append("")
		lines.append("Recent Facility Events:")
		for raw_event in events:
			lines.append("• %s" % str(raw_event))

	lines.append("Transfers: %d" % int(world.get("transfers", 0)))
	lines.append("Riots: %d" % int(world.get("riots", 0)))

	_show_standard_tab_popup(MainSceneHelpers._incarceration_facility_title(context, "WORLD"), lines, "world")


func _render_incarceration_life_tab(context: Dictionary, _reason: String = "incarceration_life") -> void:
	var lines: Array = MainSceneHelpers._incarceration_base_lines(context)
	lines.append("")
	lines.append("===== DAILY ROUTINE =====")

	match str(context.get("era", "")).strip_edges():
		"Ancient Era":
			lines.append("• Wake in chains")
			lines.append("• Wait for guard inspection")
			lines.append("• Receive scraps or nothing")
			lines.append("• Listen for public punishment outside")
		"Medieval Era":
			lines.append("• Wake in the dungeon")
			lines.append("• Guard inspection")
			lines.append("• Meal through the bars")
			lines.append("• Lights fade behind stone walls")
		"Industrial Era":
			lines.append("• Wake for roll call")
			lines.append("• Labor assignment")
			lines.append("• Meal time")
			lines.append("• Return to barracks")
		"Future Era":
