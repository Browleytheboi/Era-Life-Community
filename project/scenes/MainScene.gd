func _apply_begin_boxing_button_affordance(
	button: Button,
	actor: Person,
	reason: String = "activities_boxing_affordance"
) -> Dictionary:
	if button == null or not is_instance_valid(button):
		return {}

	var controlled_actor: Person = MainSceneLogic._activities_current_controlled_actor(gs, actor)

	if controlled_actor == null:
		button.disabled = true
		button.tooltip_text = "No controlled life is available."
		return {
			"available": false,
			"reason": "missing_actor",
			"actor_id": -1,
			"actor_age": -1
		}

	var controlled_actor_id: int = int(controlled_actor.id)
	var controlled_actor_age: int = maxi(0, int(controlled_actor.age))

	var boxing_report: Dictionary = _activities_boxing_start_affordance_for_actor(
		controlled_actor
	)

	boxing_report ["actor_id"] = controlled_actor_id
	boxing_report ["actor_age"] = controlled_actor_age
	boxing_report ["controlled_actor_id"] = controlled_actor_id
	boxing_report ["controlled_actor_age"] = controlled_actor_age
	boxing_report ["controlled_actor_pointer_verified"] = (
		gs != null
		and gs.player != null
		and int(gs.player.id) == controlled_actor_id
	)

	var boxing_available: bool = bool(
		boxing_report.get("available", false)
	)
	var boxing_reason: String = str(
		boxing_report.get("reason", "")
	).strip_edges()
	var minimum_age: int = int(
		boxing_report.get("minimum_age", 7)
	)

	button.disabled = not boxing_available
	button.set_meta("activities_action_label", "Begin Boxing")
	button.set_meta("activities_boxing_actor_id", controlled_actor_id)
	button.set_meta("activities_boxing_actor_age", controlled_actor_age)
	button.set_meta(
		"activities_boxing_affordance_report",
		boxing_report.duplicate(true)
	)
	button.set_meta("activities_boxing_affordance_reason", reason)
	button.set_meta(
		"activities_boxing_affordance_refreshed_at_ms",
		int(Time.get_ticks_msec())
	)
	button.set_meta("activities_boxing_visible_even_when_locked", true)
	button.set_meta("activities_boxing_controlled_actor_pointer_verified", true)
	button.set_meta(
		"activities_boxing_commit_authority",
		"BoxingEngine.start_boxing_career"
	)

	if boxing_available:
		button.tooltip_text = "Begin a boxing career through the amateur or professional entry path."
	else:
		match boxing_reason:
			"actor_too_young":
				button.tooltip_text = "Boxing unlocks at age %d. Current age: %d." % [
					minimum_age,
					controlled_actor_age
				]
			"era_not_modern_or_future":
				button.tooltip_text = "Organized boxing careers are not available in this era."
			"boxing_already_started":
				button.tooltip_text = "This person already has a boxing career. Use the Boxing Hub."
			"boxing_retired":
				button.tooltip_text = "This person has retired from boxing."
			"actor_not_alive":
				button.tooltip_text = "This life can no longer begin a boxing career."
			_:
				button.tooltip_text = "Boxing is visible, but its current entry requirements have not been met."

	return boxing_report

func _on_begin_boxing_activity_button_pressed(button: Button) -> void:
	if button == null or not is_instance_valid(button):
		return
	if gs == null or gs.player == null:
		return

	var report: Dictionary = _apply_begin_boxing_button_affordance(
		button,
		gs.player,
		"begin_boxing_pressed_revalidate"
	)

	if not bool(report.get("available", false)):
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Begin Boxing",
			"popup_text": button.tooltip_text,
			"popup_footer": "Eligibility was resolved from the currently controlled life.",
			"actor_id": int(gs.player.id),
			"actor_age": int(gs.player.age),
			"ui_is_renderer_only": true
		})
		return

	_on_activity_action_pressed("Begin Boxing")


func _refresh_begin_boxing_affordance_in_subtree(
	node: Node,
	reason: String
) -> void:
	if node == null or not is_instance_valid(node):
		return

	if node is Button:
		var button:= node as Button
		var action_label: String = str(
			button.get_meta(
				"activities_action_label",
				button.text
			)
		).strip_edges()

		var clean_label: String = action_label.trim_prefix("🥊").strip_edges()

		if clean_label == "Begin Boxing":
			_apply_begin_boxing_button_affordance(
				button,
				gs.player if gs != null else null,
				reason
			)

	for child in node.get_children():
		_refresh_begin_boxing_affordance_in_subtree(
			child,
			reason
		)


func _refresh_existing_activities_actor_affordances(
	root: Node = null,
	reason: String = "activities_actor_affordance_refresh"
) -> void:
	if gs == null or gs.player == null:
		return

	var refreshed_button_ids: Dictionary = {}

	if get_tree() != null:
		for raw_node in get_tree().get_nodes_in_group(
			"activities_begin_boxing_affordance"
		):
			if not raw_node is Button:
				continue

			var boxing_button:= raw_node as Button
			if not is_instance_valid(boxing_button):
				continue

			var instance_id: int = int(boxing_button.get_instance_id())
			if refreshed_button_ids.has(instance_id):
				continue

			refreshed_button_ids [instance_id] = true
			_apply_begin_boxing_button_affordance(
				boxing_button,
				gs.player,
				"%s_group_refresh" % reason
			)

	var scan_root: Node = root

	if scan_root == null:
		scan_root = activities_action_panel

	if scan_root != null and is_instance_valid(scan_root):
		_refresh_begin_boxing_affordance_in_subtree(
			scan_root,
			"%s_subtree_refresh" % reason
		)

	set_meta("activities_boxing_affordances_refreshed_for_actor_id", int(gs.player.id))
	set_meta("activities_boxing_affordances_refreshed_for_actor_age", int(gs.player.age))
	set_meta("activities_boxing_affordances_refresh_reason", reason)
	set_meta(
		"activities_boxing_affordances_refreshed_at_ms",
		int(Time.get_ticks_msec())
	)
func _make_activities_action_button(
	action_label: String
) -> Button:
	var btn:= Button.new()
	btn.text = action_label
	btn.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	btn.custom_minimum_size = Vector2(
		0,
		50
	)
	btn.mouse_default_cursor_shape = (
		Control.CURSOR_POINTING_HAND
	)
