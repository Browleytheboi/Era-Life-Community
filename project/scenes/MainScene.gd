func _main_tab_hot_surface_deck() -> Dictionary:
	var raw: Variant = get_meta("main_tab_hot_surface_deck", {})
	if typeof(raw) == TYPE_DICTIONARY:
		return raw as Dictionary
	return {}


func _commit_main_tab_hot_surface_deck(deck: Dictionary) -> void:
	set_meta("main_tab_hot_surface_deck", deck)


func _main_tab_hot_surface_from_deck(panel_id: String) -> Control:
	var clean_panel: String = MainSceneHelpers._main_tab_hot_surface_key(panel_id)
	if clean_panel == "":
		return null

	var deck: Dictionary = _main_tab_hot_surface_deck()
	var raw: Variant = deck.get(clean_panel, null)
	if raw is Control and is_instance_valid(raw):
		return raw as Control

	return null


func _main_tab_hot_surface_deck_has(panel_id: String) -> bool:
	return _main_tab_hot_surface_from_deck(panel_id) != null


func _hide_main_tab_hot_surface_deck_except(panel_id: String = "") -> void:
	var clean_except: String = MainSceneHelpers._main_tab_hot_surface_key(panel_id)
	var deck: Dictionary = _main_tab_hot_surface_deck()
	var cleaned_deck: Dictionary = {}

	for raw_key in deck.keys():
		var node:= deck.get(raw_key, null) as Control
		if node == null or not is_instance_valid(node):
			continue

		if str(node.name).begins_with("Hot") and str(node.name).ends_with("TabSurface"):
			node.queue_free()
			continue

		node.visible = false
		node.mouse_filter = Control.MOUSE_FILTER_IGNORE
		node.process_mode = Node.PROCESS_MODE_INHERIT

	_commit_main_tab_hot_surface_deck(cleaned_deck)

	set_meta("main_tab_hot_surface_deck_purged_clones", true)
	set_meta("main_tab_hot_surface_deck_purged_except", clean_except)
	set_meta("main_tab_hot_surface_deck_purged_at_ms", int(Time.get_ticks_msec()))

func _store_main_tab_hot_surface_in_deck(panel_id: String, source: Control, reason: String = "main_tab_hot_surface_store") -> void:
	var clean_panel: String = MainSceneHelpers._main_tab_hot_surface_key(panel_id)
	if clean_panel == "":
		return

	var deck: Dictionary = _main_tab_hot_surface_deck()
	var existing:= deck.get(clean_panel, null) as Control

	if existing != null and is_instance_valid(existing) and existing != source:
		existing.queue_free()

	deck.erase(clean_panel)
	_commit_main_tab_hot_surface_deck(deck)

	set_meta("main_tab_hot_surface_clone_forbidden", true)
	set_meta("main_tab_hot_surface_clone_forbidden_panel", clean_panel)
	set_meta("main_tab_hot_surface_clone_forbidden_reason", reason)
	set_meta("main_tab_hot_surface_clone_forbidden_at_ms", int(Time.get_ticks_msec()))
	set_meta("main_tab_hot_surface_deck_stored", false)
	set_meta("main_tab_hot_surface_deck_disabled_for_real_native_surfaces", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_tab_hot_surface_clone_forbidden"] = true
		gs.scenario_state ["main_tab_hot_surface_clone_forbidden_panel"] = clean_panel
		gs.scenario_state ["main_tab_hot_surface_deck_disabled_for_real_native_surfaces"] = true
		gs.scenario_state ["main_tabs_reveal_real_native_surfaces_only"] = true


func _reveal_main_tab_hot_surface_from_deck(panel_id: String, reason: String = "main_tab_hot_surface_reveal") -> bool:
	var clean_panel: String = MainSceneHelpers._main_tab_hot_surface_key(panel_id)
	if clean_panel == "":
		return false

	_hide_main_tab_hot_surface_deck_except(clean_panel)

	set_meta("main_tab_hot_surface_deck_reveal_intercepted", true)
	set_meta("main_tab_hot_surface_deck_reveal_intercepted_panel", clean_panel)
	set_meta("main_tab_hot_surface_deck_reveal_intercepted_reason", reason)
	set_meta("main_tab_hot_surface_deck_reveal_intercepted_at_ms", int(Time.get_ticks_msec()))
	set_meta("main_tab_hot_surface_deck_reveal_uses_real_native_surface", true)

	match clean_panel:
		"life":
			return _open_life_diary_native_surface("%s_real_life_surface" % reason)

		"world":
			return _open_world_tab_shell_immediate("%s_real_world_surface" % reason)

		"relationships":
			_open_relationships_tab_hot_path("%s_real_relationships_surface" % reason)
			return true

		"career":
			return _open_career_hub_zero_frame_door(
				"%s_real_career_hub_surface"
				% reason
			)

		"school":
			return _open_institution_tab_zero_frame_door("school", "overview", "%s_real_school_surface" % reason)

		"activities":
			current_panel = "activities"
			_hide_main_tab_surfaces_visual_only("activities", "%s_real_activities_surface" % reason)

			_ensure_activities_action_panel()
			if activities_action_panel == null or not is_instance_valid(activities_action_panel):
				return false

			activities_action_open = true
			activities_action_panel.visible = true
			activities_action_panel.mouse_filter = Control.MOUSE_FILTER_STOP
			activities_action_panel.process_mode = Node.PROCESS_MODE_INHERIT
			_bring_modal_to_front(activities_action_panel)

			if activities_action_list == null or not is_instance_valid(activities_action_list) or activities_action_list.get_child_count() <= 0:
				call_deferred("_prewarm_native_main_tab_surface", "activities", "%s_real_activities_surface_missing_content" % reason)

			_restore_runtime_hud_button_shells_after_surface_change("%s_real_activities_surface" % reason)
			_apply_ui_nav_button_visuals()
			return true

		_:
			return false
func _prewarm_world_tab_truth_snapshot(
		reason: String
) -> bool:
	if gs == null:
		return false

	_ensure_world_feed_popup()

	if (
		world_feed_popup == null
		or not is_instance_valid(
			world_feed_popup
		)
		or world_feed_popup_feed == null
		or not is_instance_valid(
			world_feed_popup_feed
		)
	):
		return false

	var previous_panel: String = current_panel
	var previous_open: bool = world_feed_popup_open
	var previous_visible: bool = world_feed_popup.visible
	var previous_mouse_filter: Control.MouseFilter = (
		world_feed_popup.mouse_filter
	)

	current_panel = "world"
	world_feed_popup_open = true
	world_feed_popup.visible = true
	world_feed_popup.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)

	_resolve_world_feed_shell_truth_snapshot(
		reason
	)

	var parsed_text: String = str(
		world_feed_popup_feed.get_parsed_text()
	).strip_edges()
	var hot: bool = (
		parsed_text != ""
		or world_feed_popup_feed.get_line_count() > 0
	)

	world_feed_popup.visible = previous_visible
	world_feed_popup.mouse_filter = previous_mouse_filter
	world_feed_popup_open = previous_open
	current_panel = previous_panel

	set_meta(
		"world_tab_truth_snapshot_hot",
		hot
	)
	set_meta(
		"world_tab_truth_snapshot_parsed_text_gate",
		true
	)
	set_meta(
		"world_tab_truth_snapshot_text_property_gate",
		false
	)
	set_meta(
		"world_tab_truth_snapshot_reason",
		reason
	)

	return hot
func _prime_ready_room_required_surface(
	task_id: String,
	reason: String
) -> bool:
	if gs == null or gs.player == null:
		return false

	var clean_task: String = str(
		task_id
	).strip_edges().to_lower()

	match clean_task:
		"life":
			if (
				output_label == null
				or not is_instance_valid(
					output_label
				)
			):
				return false

			_ensure_active_life_diary_loaded(
				false
			)
			_rebuild_loaded_life_diary_snapshot_if_needed()
			_render_life_diary_panel()

			output_label.visible = false
			output_label.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			return str(
				output_label.text
			).strip_edges() != ""

		"world":
			return _prewarm_world_tab_truth_snapshot(
				"%s_world_truth" % reason
			)

		"relationships::family", "relationships":
			_prime_native_main_tab_renderable_surface(
				"relationships::family",
				"%s_relationships" % reason
			)

			return _native_main_tab_surface_is_hot(
				"relationships::family"
			)

		"school::overview", "school":
			_prime_native_main_tab_renderable_surface(
				"school::overview",
				"%s_school" % reason
			)

			return _native_main_tab_surface_is_hot(
				"school::overview"
			)

		"career":
			_ensure_career_hub_panel()

			if (
				career_hub_panel == null
				or not is_instance_valid(
					career_hub_panel
				)
			):
				return false

			if not _career_hub_contract_is_hot(
				career_hub_panel.active_contract,
				int(
					gs.player.id
				)
			):
				_request_career_hub_observable_contract(
					gs.player,
					(
						"Professional reality already exists. "
						+ "Its resident projection is being installed."
					),
					"%s_career_observable" % reason
				)

				_request_career_hub_contract(
					gs.player,
					{
						"action_id": "refresh",
						"section_id": (
							career_hub_active_section_id
						),
						"lane": career_hub_active_lane,
						"source": (
							"%s_career_refresh"
							% reason
						)
					},
					false
				)

			career_hub_panel.visible = false
			career_hub_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			return _native_main_tab_surface_is_hot(
				"career"
			)

		"activities":
			_ensure_activities_hub_panel()

			if (
				activities_hub_panel == null
				or not is_instance_valid(
					activities_hub_panel
				)
			):
				return false

			if not activities_hub_panel.has_hot_contract(
				int(
					gs.player.id
				)
			):
				_request_activities_hub_contract(
					gs.player,
					{
						"action_id": "observe_partial",
						"section_id": (
							activities_hub_active_section_id
						),
						"status_text": (
							"Activity reality already exists."
						),
						"source": (
							"%s_activities_observable"
							% reason
						)
					},
					false
				)

				_request_activities_hub_contract(
					gs.player,
					{
						"action_id": "refresh",
						"section_id": (
							activities_hub_active_section_id
						),
						"source": (
							"%s_activities_refresh"
							% reason
						)
					},
					false
				)

			activities_action_open = false
			activities_hub_panel.visible = false
			activities_hub_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			return _native_main_tab_surface_is_hot(
				"activities"
			)

		"mods":
			_ensure_mod_menu_panel()
			_ensure_mod_bundle_menu_panel()

			if (
				mod_menu_panel == null
				or not is_instance_valid(
					mod_menu_panel
				)
			):
				return false

			if not mod_menu_panel.has_hot_contract(
				int(
					gs.player.id
				)
			):
				_request_mod_menu_contract(
					gs.player,
					{
						"action_id": "open_menu",
						"section_id": (
							mod_menu_active_section_id
						),
						"source": (
							"%s_mods_open"
							% reason
						)
					},
					false
				)

				_request_mod_menu_contract(
					gs.player,
					{
						"action_id": "refresh",
						"section_id": (
							mod_menu_active_section_id
						),
						"source": (
							"%s_mods_refresh"
							% reason
						)
					},
					false
				)

			mod_menu_panel.visible = false
			mod_menu_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			return _native_main_tab_surface_is_hot(
				"mods"
			)

		_:
			return false
