func _active_reality_presentation_contract() -> Dictionary:
	var authoritative_surface_exists: bool = (
		not active_reality_surface_contract.is_empty()
	)
	var presentation: Dictionary = MainSceneHelpers._safe_dictionary(
		active_reality_surface_contract.get(
			"presentation",
			{}
		)
	)
	var authoritative_presentation_resolved: bool = false

	if authoritative_surface_exists:
		var explicitly_disabled: bool = (
			active_reality_surface_contract.has(
				"enabled"
			)
			and not bool(
				active_reality_surface_contract.get(
					"enabled",
					false
				)
			)
		)

		authoritative_presentation_resolved = (
			explicitly_disabled
			or not presentation.is_empty()
		)

	if (
		not authoritative_presentation_resolved
		and mod_bundle_menu_panel != null
		and is_instance_valid(
			mod_bundle_menu_panel
		)
		and bool(
			mod_bundle_menu_panel.active_contract.get(
				"bundle_enabled",
				false
			)
		)
	):
		var bundle_presentation: Dictionary = MainSceneHelpers._safe_dictionary(
			mod_bundle_menu_panel.active_contract.get(
				"reality_presentation",
				{}
			)
		)

		if not bundle_presentation.is_empty():
			presentation = bundle_presentation
			authoritative_presentation_resolved = true

	if (
		not authoritative_presentation_resolved
		and mod_menu_panel != null
		and is_instance_valid(
			mod_menu_panel
		)
	):
		var mod_presentation: Dictionary = MainSceneHelpers._safe_dictionary(
			mod_menu_panel.active_contract.get(
				"reality_presentation",
				{}
			)
		)

		if not mod_presentation.is_empty():
			presentation = mod_presentation












	set_meta(
		"reality_presentation_navigation_visibility_authority",
		"authoritative_provider_contract"
	)
	set_meta(
		"reality_presentation_full_surface_may_hide_navigation",
		false
	)
	set_meta(
		"reality_presentation_navigation_shell_persistent",
		true
	)
	set_meta(
		"reality_presentation_navigation_visibility_rewritten",
		false
	)

	return presentation
