func _school_hub_population_rows_from_snapshot(player: Person, snapshot: Dictionary) -> Array:
	var rows: Array = []
	var seen: Dictionary = {}

	if player != null:
		_school_hub_add_population_person_row(rows, seen, player, "You")

	var teachers: Array = MainSceneHelpers._safe_array(snapshot.get("teachers", []))
	for raw_teacher in teachers:
		var teacher: Person = raw_teacher
		_school_hub_add_population_person_row(rows, seen, teacher, "Teacher")

	var classmates: Array = MainSceneHelpers._safe_array(snapshot.get("classmates", []))
	for raw_classmate in classmates:
		var classmate: Person = raw_classmate
		_school_hub_add_population_person_row(rows, seen, classmate, "Student")

	var classes: Array = MainSceneHelpers._safe_array(snapshot.get("classes", []))
	for raw_zone in classes:
		var zone: Dictionary = MainSceneHelpers._safe_dictionary(raw_zone)
		var students: Array = MainSceneHelpers._safe_array(zone.get("students", []))
		for raw_student in students:
			var student_row: Dictionary = MainSceneHelpers._safe_dictionary(raw_student)
			MainSceneHelpers._school_hub_add_population_contract_row(rows, seen, student_row, "Student")

	var meal_zone: Dictionary = MainSceneHelpers._safe_dictionary(snapshot.get("meal_zone", {}))
	var meal_people: Array = MainSceneHelpers._safe_array(meal_zone.get("people", []))
	for raw_meal_person in meal_people:
		var meal_row: Dictionary = MainSceneHelpers._safe_dictionary(raw_meal_person)
		MainSceneHelpers._school_hub_add_population_contract_row(rows, seen, meal_row, "Meal Space")

	return rows


func _school_hub_add_population_person_row(rows: Array, seen: Dictionary, npc: Person, role: String) -> void:
	if npc == null:
		return

	var npc_id: int = int(npc.id)
	if npc_id <= 0 or seen.has(npc_id):
		return

	seen [npc_id] = true
	rows.append({
