func _show_startup_intro_loading_reveal_until(target_text_begin_ms: int, run_id: int, first_beat: Dictionary = {}) -> bool:
	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return false
	if startup_intro_title_label == null or not is_instance_valid(startup_intro_title_label):
		return false
	if startup_intro_year_label == null or not is_instance_valid(startup_intro_year_label):
		return false
	if startup_intro_line_label == null or not is_instance_valid(startup_intro_line_label):
		return false
	if startup_intro_subtitle_label == null or not is_instance_valid(startup_intro_subtitle_label):
		return false
	if startup_intro_prompt_label == null or not is_instance_valid(startup_intro_prompt_label):
		return false

	set_meta("startup_intro_loading_reveal_active", true)

	startup_intro_year_label.visible = true
	startup_intro_line_label.visible = true
	startup_intro_year_label.text = ""
	startup_intro_line_label.text = ""
	startup_intro_subtitle_label.text = ""
	startup_intro_prompt_label.text = ""
	startup_intro_year_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_line_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_subtitle_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_prompt_label.modulate = Color(1.0, 1.0, 1.0, 0.0)

	var frames: Array = [
		{
			"text": "◐",
			"color": Color(0.56, 1.0, 0.94, 0.84),
			"scale": Vector2(1.08, 1.08),
			"pitch": 1.02
		},
		{
			"text": "◓",
			"color": Color(0.74, 0.92, 1.0, 0.92),
			"scale": Vector2(1.14, 1.14),
			"pitch": 1.08
		},
		{
			"text": "◑",
			"color": Color(1.0, 0.78, 0.96, 0.98),
			"scale": Vector2(1.2, 1.2),
			"pitch": 1.14
		},
		{
			"text": "◒",
			"color": Color(1.0, 0.92, 0.62, 1.0),
			"scale": Vector2(1.14, 1.14),
			"pitch": 1.2
		}
	]

	var frame_index: int = 0

	while int(Time.get_ticks_msec()) < target_text_begin_ms:
		if startup_intro_exiting or run_id != startup_intro_sequence_generation:
			set_meta("startup_intro_loading_reveal_active", false)
			return false

		if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
			set_meta("startup_intro_loading_reveal_active", false)
			return false

		var frame: Dictionary = frames [frame_index % frames.size()]
		startup_intro_title_label.text = str(frame.get("text", "◐"))
		startup_intro_title_label.modulate = frame.get("color", Color(1.0, 1.0, 1.0, 0.92))
		startup_intro_title_label.scale = frame.get("scale", Vector2.ONE)
		startup_intro_title_label.add_theme_font_size_override("font_size", 94)

		_play_startup_intro_tick(float(frame.get("pitch", 1.0)))

		var tick_tween:= _track_startup_intro_runtime_tween(create_tween().bind_node(startup_intro_overlay))
		tick_tween.set_trans(Tween.TRANS_SINE)
		tick_tween.set_ease(Tween.EASE_OUT)
		tick_tween.tween_property(
			startup_intro_title_label,
			"scale",
			Vector2(1.3, 1.3),
			0.05
		)
		tick_tween.tween_property(
			startup_intro_title_label,
			"scale",
			frame.get("scale", Vector2.ONE),
			0.064
		)

		frame_index += 1

		var now_ms: int = int(Time.get_ticks_msec())
		var remaining_ms: int = target_text_begin_ms - now_ms
		if remaining_ms <= 0:
			break

		var wait_seconds: float = min(0.122, max(0.016, float(remaining_ms) / 1000.0))
		await get_tree().create_timer(wait_seconds).timeout

	if startup_intro_exiting or run_id != startup_intro_sequence_generation:
		set_meta("startup_intro_loading_reveal_active", false)
		return false

	var handled_first_beat: bool = false
	if not first_beat.is_empty():
		var target_year: String = str(first_beat.get("year", ""))
		var target_line: String = str(first_beat.get("line", ""))
		var year_color: Color = first_beat.get("year_color", Color(1.0, 1.0, 1.0, 1.0))
		var line_color: Color = first_beat.get("line_color", Color(1.0, 1.0, 1.0, 1.0))

		var glitch_frames: Array = [
			{
				"glyph": "◐ //",
				"year_step": 0,
				"line_step": 0,
				"title_color": Color(1.0, 0.62, 0.98, 1.0),
				"duration": 0.034,
				"pitch": 1.4,
				"scale": Vector2(1.34, 1.34),
				"font_size": 104
			},
			{
				"glyph": "◒ ///",
				"year_step": 1,
				"line_step": 1,
				"title_color": Color(0.48, 1.0, 0.94, 1.0),
				"duration": 0.038,
				"pitch": 1.52,
				"scale": Vector2(1.48, 1.48),
				"font_size": 112
			},
			{
				"glyph": "////",
				"year_step": 2,
				"line_step": 2,
				"title_color": Color(1.0, 0.94, 0.48, 1.0),
				"duration": 0.034,
				"pitch": 1.64,
				"scale": Vector2(1.58, 1.58),
				"font_size": 118
			},
			{
				"glyph": "/// TIMELINES",
				"year_step": 2,
				"line_step": 3,
				"title_color": Color(0.88, 0.72, 1.0, 0.84),
				"duration": 0.03,
				"pitch": 1.72,
				"scale": Vector2(1.44, 1.44),
				"font_size": 104
			},
			{
				"glyph": "",
				"year_step": 3,
				"line_step": 3,
				"title_color": Color(1.0, 1.0, 1.0, 0.0),
				"duration": 0.07,
				"pitch": float(first_beat.get("pitch", 1.0)),
				"scale": Vector2(1.24, 1.24),
				"font_size": 96
			}
		]

		for glitch_frame in glitch_frames:
			if startup_intro_exiting or run_id != startup_intro_sequence_generation:
				set_meta("startup_intro_loading_reveal_active", false)
				return false

			startup_intro_title_label.text = str(glitch_frame.get("glyph", ""))
			startup_intro_title_label.modulate = glitch_frame.get("title_color", Color(1.0, 1.0, 1.0, 0.0))
			startup_intro_title_label.scale = glitch_frame.get("scale", Vector2(1.18, 1.18))
			startup_intro_title_label.add_theme_font_size_override("font_size", int(glitch_frame.get("font_size", 94)))

			startup_intro_year_label.text = MainSceneHelpers._startup_intro_loading_glitch_year_fragment(target_year, int(glitch_frame.get("year_step", 0)))
			startup_intro_line_label.text = MainSceneHelpers._startup_intro_loading_glitch_line_fragment(target_line, int(glitch_frame.get("line_step", 0)))
			startup_intro_line_label.visible = startup_intro_line_label.text.strip_edges() != ""
			startup_intro_year_label.modulate = Color(year_color.r, year_color.g, year_color.b, 0.88)
			startup_intro_line_label.modulate = Color(line_color.r, line_color.g, line_color.b, 1.0)

			_play_startup_intro_tick(float(glitch_frame.get("pitch", 1.0)))
			await get_tree().create_timer(float(glitch_frame.get("duration", 0.04))).timeout

		if startup_intro_exiting or run_id != startup_intro_sequence_generation:
			set_meta("startup_intro_loading_reveal_active", false)
			return false

		startup_intro_title_label.text = ""
		startup_intro_title_label.scale = Vector2.ONE
		startup_intro_title_label.add_theme_font_size_override("font_size", 72)
		startup_intro_title_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
		startup_intro_year_label.text = target_year
		startup_intro_line_label.text = target_line
		startup_intro_line_label.visible = target_line.strip_edges() != ""
		startup_intro_year_label.modulate = Color(year_color.r, year_color.g, year_color.b, 0.88)
		startup_intro_line_label.modulate = Color(line_color.r, line_color.g, line_color.b, 1.0)
		handled_first_beat = true
	else:
		if startup_intro_title_label != null and is_instance_valid(startup_intro_title_label):
			var fade_tween:= _track_startup_intro_runtime_tween(create_tween().bind_node(startup_intro_title_label))
			fade_tween.set_trans(Tween.TRANS_SINE)
			fade_tween.set_ease(Tween.EASE_IN)
			fade_tween.tween_property(
				startup_intro_title_label,
				"modulate",
				Color(1.0, 1.0, 1.0, 0.0),
				0.08
			)
			await fade_tween.finished

		if startup_intro_title_label != null and is_instance_valid(startup_intro_title_label):
			startup_intro_title_label.text = ""
			startup_intro_title_label.scale = Vector2.ONE
			startup_intro_title_label.add_theme_font_size_override("font_size", 72)

	set_meta("startup_intro_loading_reveal_active", false)
	return handled_first_beat
func _startup_intro_ensure_procedural_content_seed(reason: String = "startup_intro_content") -> int:
	var current_generation: int = int(startup_intro_sequence_generation)
	var cached_generation: int = int(get_meta("startup_intro_procedural_content_generation", -999999))
	var cached_content_seed: int = int(get_meta("startup_intro_procedural_content_seed", 0))
	if cached_generation == current_generation and cached_content_seed > 0:
		return cached_content_seed

	return _startup_intro_force_new_procedural_content_seed(reason)
func _startup_intro_force_new_procedural_content_seed(reason: String = "startup_intro_content_refresh") -> int:
	var current_generation: int = int(startup_intro_sequence_generation)
	var entropy_rng:= RandomNumberGenerator.new()
	entropy_rng.randomize()

	var seed_material: String = "%s|%s|%s|%s|%s|%s" % [
		str(current_generation),
		str(Time.get_ticks_msec()),
		str(Time.get_ticks_usec()),
		str(Time.get_unix_time_from_system()),
		str(entropy_rng.randi()),
		reason
	]

	var procedural_content_seed: int = MainSceneHelpers._startup_intro_positive_hash(seed_material)
	set_meta("startup_intro_procedural_content_generation", current_generation)
	set_meta("startup_intro_procedural_content_seed", procedural_content_seed)
	set_meta("startup_intro_procedural_content_reason", reason)
	set_meta("startup_intro_procedural_content_created_at_ms", int(Time.get_ticks_msec()))
	set_meta("startup_intro_procedural_content_nonce", str(seed_material))
	return procedural_content_seed


func _startup_intro_clear_current_sequence_cache(reason: String = "fresh_sequence_refresh") -> void:
	set_meta("startup_intro_current_intro_sequence", [])
	set_meta("startup_intro_current_bridge_sequence", [])
	set_meta("startup_intro_current_jumble_years", [])
	set_meta("startup_intro_current_jumble_fragments", [])
	set_meta("startup_intro_current_intro_sequence_generation", -999999)
	set_meta("startup_intro_current_bridge_sequence_generation", -999999)
	set_meta("startup_intro_current_sequence_cache_cleared_reason", reason)
	set_meta("startup_intro_current_sequence_cache_cleared_at_ms", int(Time.get_ticks_msec()))


func _prepare_startup_intro_fresh_sequence_cache_for_current_generation(reason: String = "startup_intro_fresh_run") -> void:
	var current_generation: int = int(startup_intro_sequence_generation)
	var prepared_generation: int = int(get_meta("startup_intro_fresh_sequence_cache_generation", -999999))
	if prepared_generation == current_generation:
		return

	var previous_intro_raw: Variant = get_meta("startup_intro_current_intro_sequence", [])
	var previous_bridge_raw: Variant = get_meta("startup_intro_current_bridge_sequence", [])
	var previous_intro: Array = previous_intro_raw if typeof(previous_intro_raw) == TYPE_ARRAY else []
	var previous_bridge: Array = previous_bridge_raw if typeof(previous_bridge_raw) == TYPE_ARRAY else []
	var previous_signature: String = MainSceneLogic._startup_intro_sequence_bundle_signature(previous_intro, previous_bridge)

	if previous_signature == "||":
		previous_signature = str(get_meta("startup_intro_last_prepared_sequence_signature", "")).strip_edges()

	var accepted_intro: Array = []
	var accepted_bridge: Array = []
	var accepted_signature: String = ""
	var accepted_seed: int = 0
	var max_attempts: int = 4

	for attempt in range(max_attempts):
		accepted_seed = _startup_intro_force_new_procedural_content_seed("%s:%s" % [reason, str(attempt)])
		_startup_intro_clear_current_sequence_cache("%s_attempt_%s" % [reason, str(attempt)])

		var intro_sequence: Array = _startup_intro_build_procedural_intro_sequence()
		_startup_intro_store_sequence_for_generation(
			"startup_intro_current_intro_sequence",
			"startup_intro_current_intro_sequence_generation",
			intro_sequence
		)

		var bridge_sequence: Array = _startup_intro_build_procedural_bridge_sequence()
		_startup_intro_store_sequence_for_generation(
			"startup_intro_current_bridge_sequence",
			"startup_intro_current_bridge_sequence_generation",
			bridge_sequence
		)

		var candidate_signature: String = MainSceneLogic._startup_intro_sequence_bundle_signature(intro_sequence, bridge_sequence)
		accepted_intro = intro_sequence
		accepted_bridge = bridge_sequence
		accepted_signature = candidate_signature

		if previous_signature == "" or previous_signature == "||" or candidate_signature != previous_signature:
			break

	set_meta("startup_intro_current_intro_sequence", accepted_intro.duplicate(true))
	set_meta("startup_intro_current_bridge_sequence", accepted_bridge.duplicate(true))
	set_meta("startup_intro_current_intro_sequence_generation", current_generation)
	set_meta("startup_intro_current_bridge_sequence_generation", current_generation)
	_startup_intro_cache_jumble_material(accepted_bridge)

	set_meta("startup_intro_fresh_sequence_cache_generation", current_generation)
	set_meta("startup_intro_fresh_sequence_cache_reason", reason)
	set_meta("startup_intro_fresh_sequence_cache_seed", accepted_seed)
	set_meta("startup_intro_last_prepared_sequence_signature", accepted_signature)
	set_meta("startup_intro_fresh_sequence_cache_prepared_at_ms", int(Time.get_ticks_msec()))

func _startup_intro_rng_for_phase(phase: String) -> RandomNumberGenerator:
	var procedural_content_seed: int = _startup_intro_ensure_procedural_content_seed(phase)
	var rng:= RandomNumberGenerator.new()
	rng.seed = MainSceneHelpers._startup_intro_positive_hash("%s|%s" % [str(procedural_content_seed), str(phase)])
	return rng


func _startup_intro_expanded_procedural_content_contract() -> Dictionary:
	var cached_contract_raw: Variant = get_meta("startup_intro_expanded_content_contract", {})
	if typeof(cached_contract_raw) == TYPE_DICTIONARY and not (cached_contract_raw as Dictionary).is_empty():
		return cached_contract_raw as Dictionary

	var base_contract: Dictionary = MainSceneHelpers._startup_intro_procedural_content_contract()
	var expanded_contract: Dictionary = MainSceneLogic._startup_intro_apply_massive_pool_expansion(base_contract)

	set_meta("startup_intro_expanded_content_contract_generation", int(startup_intro_sequence_generation))
	set_meta("startup_intro_expanded_content_contract", expanded_contract)
	set_meta("startup_intro_expanded_content_contract_pool_count", int((expanded_contract.get("pool_rotation", []) as Array).size()) if typeof(expanded_contract.get("pool_rotation", [])) == TYPE_ARRAY else 0)
	set_meta("startup_intro_expanded_content_contract_moment_count", int(expanded_contract.get("expanded_moment_count", 0)))
	set_meta("startup_intro_expanded_content_contract_at_ms", int(Time.get_ticks_msec()))

	return expanded_contract


func _startup_intro_recent_moment_keys() -> Array:
	var raw_keys: Variant = get_meta("startup_intro_recent_procedural_moment_keys", [])
	if typeof(raw_keys) == TYPE_ARRAY:
		return (raw_keys as Array).duplicate()
	return []


func _startup_intro_recent_moment_key_lookup() -> Dictionary:
	var lookup: Dictionary = {}
	for raw_key in _startup_intro_recent_moment_keys():
		lookup [str(raw_key)] = true
	return lookup


func _startup_intro_remember_recent_moment_key(moment_key: String) -> void:
	var clean_key: String = str(moment_key).strip_edges()
	if clean_key == "":
		return

	var recent_keys: Array = _startup_intro_recent_moment_keys()
	recent_keys.erase(clean_key)
	recent_keys.append(clean_key)

	var limit: int = 768
	var contract_raw: Variant = get_meta("startup_intro_expanded_content_contract", {})
	if typeof(contract_raw) == TYPE_DICTIONARY:
		limit = max(128, int((contract_raw as Dictionary).get("recent_memory_limit", 768)))

	while recent_keys.size() > limit:
		recent_keys.remove_at(0)

	set_meta("startup_intro_recent_procedural_moment_keys", recent_keys)
	set_meta("startup_intro_recent_procedural_moment_key_count", recent_keys.size())
	set_meta("startup_intro_recent_procedural_moment_updated_at_ms", int(Time.get_ticks_msec()))


func _startup_intro_active_pool_rotation() -> Array:
	var contract: Dictionary = _startup_intro_expanded_procedural_content_contract()
	var pool_ids: Array = contract.get("pool_rotation", []) if typeof(contract.get("pool_rotation", [])) == TYPE_ARRAY else []
	if pool_ids.is_empty():
		return []

	var procedural_content_seed: int = _startup_intro_ensure_procedural_content_seed("pool_rotation")
	var start_index: int = procedural_content_seed % pool_ids.size()
	var out: Array = []

	for i in range(pool_ids.size()):
		out.append(str(pool_ids [(start_index + i) % pool_ids.size()]))

	if not out.is_empty():
		set_meta("startup_intro_procedural_primary_pool_label", str(out [0]))

	return out
func _startup_intro_pick_procedural_moment(rng: RandomNumberGenerator, phase: String, slot_index: int, used_keys: Dictionary) -> Dictionary:
	var contract: Dictionary = _startup_intro_expanded_procedural_content_contract()
	var pools: Dictionary = contract.get("pools", {}) if typeof(contract.get("pools", {})) == TYPE_DICTIONARY else {}
	var generated_recipes: Dictionary = contract.get("generated_recipe_pools", {}) if typeof(contract.get("generated_recipe_pools", {})) == TYPE_DICTIONARY else {}
	var pool_rotation: Array = _startup_intro_active_pool_rotation()
	var integrity_engine = MainSceneLogic._startup_intro_perceptual_integrity_engine(gs)

	if pool_rotation.is_empty():
		return {
			"year": 1,
			"era": "ancient",
			"line": "The world moved before anyone knew your name.",
			"pool_label": "fallback",
			"phase": phase,
			"slot_index": slot_index
		}

	var weighted_pool_ids: Array = []
	for raw_pool_id in pool_rotation:
		var clean_pool_id: String = str(raw_pool_id).strip_edges()
		if clean_pool_id == "":
			continue
		if not MainSceneLogic._startup_intro_pool_allowed_for_current_reality(gs, clean_pool_id):
			continue
		weighted_pool_ids.append(clean_pool_id)

	if weighted_pool_ids.is_empty():
		for raw_fallback_pool_id in pool_rotation:
			var fallback_pool_id: String = str(raw_fallback_pool_id).strip_edges()
			if fallback_pool_id != "":
				weighted_pool_ids.append(fallback_pool_id)

	if weighted_pool_ids.is_empty():
		return {
			"year": 1,
			"era": "ancient",
			"line": "The world moved before anyone knew your name.",
			"pool_label": "fallback",
			"phase": phase,
			"slot_index": slot_index
		}

	var last_valid_moment: Dictionary = {}

	for attempt in range(160):
		var pool_id: String = str(weighted_pool_ids [int(rng.randi_range(0, weighted_pool_ids.size() - 1))]).strip_edges()
		if pool_id == "":
			continue

		var moment: Dictionary = {}

		if generated_recipes.has(pool_id):
			var recipe_raw: Variant = generated_recipes.get(pool_id, {})
			if typeof(recipe_raw) == TYPE_DICTIONARY:
				moment = MainSceneLogic._startup_intro_generate_recipe_pool_moment(pool_id, recipe_raw as Dictionary, rng, phase, slot_index)
		else:
			var raw_pool: Array = pools.get(pool_id, []) if typeof(pools.get(pool_id, [])) == TYPE_ARRAY else []
			if raw_pool.is_empty():
				continue

			var raw_moment = raw_pool [int(rng.randi_range(0, raw_pool.size() - 1))]
			if typeof(raw_moment) != TYPE_DICTIONARY:
				continue

			moment = (raw_moment as Dictionary).duplicate(true)

		if moment.is_empty():
			continue

		moment ["pool_label"] = pool_id
		moment ["phase"] = phase
		moment ["slot_index"] = slot_index

		var evaluation_report: Dictionary = {}
		if integrity_engine != null and integrity_engine.has_method("evaluate_candidate"):
			evaluation_report = integrity_engine.evaluate_candidate(
				moment,
				used_keys,
				MainSceneHelpers._startup_intro_perceptual_integrity_context(phase, slot_index, attempt, pool_id)
			)
		else:
			evaluation_report = {
				"accepted": true,
				"candidate": moment.duplicate(true),
				"rejection_reasons": []
			}

		var evaluated_moment: Dictionary = evaluation_report.get("candidate", moment) if typeof(evaluation_report.get("candidate", {})) == TYPE_DICTIONARY else moment
		if last_valid_moment.is_empty() and typeof(evaluated_moment) == TYPE_DICTIONARY and not evaluated_moment.is_empty():
			last_valid_moment = evaluated_moment.duplicate(true)

		if not bool(evaluation_report.get("accepted", false)):
			continue

		MainSceneLogic._startup_intro_register_used_moment_identity(gs, evaluated_moment, used_keys, phase)
		_startup_intro_remember_recent_moment_key(MainSceneHelpers._startup_intro_moment_key(evaluated_moment))
		return evaluated_moment

	if not last_valid_moment.is_empty():
		MainSceneLogic._startup_intro_register_used_moment_identity(gs, last_valid_moment, used_keys, phase)
		_startup_intro_remember_recent_moment_key(MainSceneHelpers._startup_intro_moment_key(last_valid_moment))
		return last_valid_moment

	var fallback_line: String = "A hidden life signal escaped the archive."
	var fallback_moment: Dictionary = {
		"year": 1,
		"era": "ancient",
		"line": fallback_line,
		"pool_label": "fallback",
		"phase": phase,
		"slot_index": slot_index,
		"event_signature": MainSceneHelpers._startup_intro_event_signature_from_line(fallback_line),
		"line_identity_key": MainSceneLogic._startup_intro_line_identity_key(fallback_line),
		"intro_opening_key": MainSceneLogic._startup_intro_line_opening_key(fallback_line, 3),
		"subject_identity_key": MainSceneLogic._startup_intro_subject_identity_key(fallback_line),
		"year_identity_key": "1"
	}
	MainSceneLogic._startup_intro_register_used_moment_identity(gs, fallback_moment, used_keys, phase)
	return fallback_moment
func _startup_intro_build_procedural_intro_sequence() -> Array:
	var rng:= _startup_intro_rng_for_phase("intro_sequence")
	var timing_slots: Array = MainSceneHelpers._startup_intro_sequence_timing_slots()
	var used_keys: Dictionary = {}
	var out: Array = []

	for i in range(timing_slots.size()):
		var timing: Dictionary = timing_slots [i]
		var moment: Dictionary = _startup_intro_pick_procedural_moment(rng, "intro", i, used_keys)
		out.append(MainSceneLogic._startup_intro_moment_to_beat(moment, timing))

	set_meta("startup_intro_current_intro_sequence", out.duplicate(true))
	set_meta("startup_intro_current_intro_sequence_at_ms", int(Time.get_ticks_msec()))

	return out


func _startup_intro_build_procedural_bridge_sequence() -> Array:
	var rng:= _startup_intro_rng_for_phase("bridge_sequence")
	var contract: Dictionary = _startup_intro_expanded_procedural_content_contract()
	var bridge_count: int = int(contract.get("bridge_count", 34))
	var used_keys: Dictionary = {}

	var intro_sequence_raw: Variant = get_meta("startup_intro_current_intro_sequence", [])
	if typeof(intro_sequence_raw) == TYPE_ARRAY:
		for raw_intro_beat in intro_sequence_raw:
			if typeof(raw_intro_beat) != TYPE_DICTIONARY:
				continue

			MainSceneLogic._startup_intro_register_used_moment_identity(gs, raw_intro_beat as Dictionary, used_keys, "intro")

	var out: Array = []
	for i in range(bridge_count):
		var moment: Dictionary = _startup_intro_pick_procedural_moment(rng, "bridge", i, used_keys)
		var beat: Dictionary = MainSceneLogic._startup_intro_moment_to_beat(moment, {
			"pitch": MainSceneHelpers._startup_intro_bridge_pitch_for_index(i)
		})
		out.append(beat)

	_startup_intro_cache_jumble_material(out)
	set_meta("startup_intro_current_bridge_sequence", out.duplicate(true))
	set_meta("startup_intro_current_bridge_sequence_at_ms", int(Time.get_ticks_msec()))

	return out
func _startup_intro_cache_jumble_material(sequence: Array) -> void:
	var years: Array = []
	var fragments: Array = []

	for raw_beat in sequence:
		if typeof(raw_beat) != TYPE_DICTIONARY:
			continue

		var beat: Dictionary = raw_beat
		var year_text: String = str(beat.get("year", "")).strip_edges()
		var line_text: String = str(beat.get("line", "")).strip_edges()

		if year_text != "" and not years.has(year_text):
			years.append(year_text)

		var fragment: String = MainSceneHelpers._startup_intro_jumble_fragment_from_line(line_text)
		if fragment != "" and not fragments.has(fragment):
			fragments.append(fragment)

	set_meta("startup_intro_current_jumble_years", years)
	set_meta("startup_intro_current_jumble_fragments", fragments)


func _build_startup_intro_bridge_sequence() -> Array:
	var cached_sequence: Array = _startup_intro_cached_sequence_for_generation(
		"startup_intro_current_bridge_sequence",
		"startup_intro_current_bridge_sequence_generation"
	)
	if not cached_sequence.is_empty():
		return cached_sequence

	var sequence: Array = _startup_intro_build_procedural_bridge_sequence()
	_startup_intro_store_sequence_for_generation(
		"startup_intro_current_bridge_sequence",
		"startup_intro_current_bridge_sequence_generation",
		sequence
	)
	return sequence
func _startup_intro_bridge_jumble_payload(bridge_index: int, remaining_ms: int = -1) -> Dictionary:
	var years_raw: Variant = get_meta("startup_intro_current_jumble_years", [])
	var fragments_raw: Variant = get_meta("startup_intro_current_jumble_fragments", [])

	var years: Array = years_raw if typeof(years_raw) == TYPE_ARRAY else []
	var fragments: Array = fragments_raw if typeof(fragments_raw) == TYPE_ARRAY else []

	if years.is_empty():
		years = MainSceneHelpers._startup_intro_default_jumble_years()
	if fragments.is_empty():
		fragments = MainSceneHelpers._startup_intro_default_jumble_fragments()

	var slot_count: int = MainSceneHelpers._startup_intro_jumble_slot_count_for_remaining(remaining_ms)
	var year_slots: Array = []
	var fragment_slots: Array = []

	for i in range(slot_count):
		var year_index: int = (bridge_index + (i * 7)) % years.size()
		var fragment_index: int = (bridge_index + (i * 6)) % fragments.size()

		year_slots.append(str(years [year_index]))
		fragment_slots.append(str(fragments [fragment_index]))

	return {
		"year": " / ".join(year_slots),
		"line": " • ".join(fragment_slots),
		"year_color": Color(1.0, 0.94, 0.62, 1.0),
		"line_color": Color(0.82, 0.98, 1.0, 1.0),
		"pitch": min(2.76, 2.18 + (0.06 * float(slot_count)))
	}


func _startup_intro_bridge_beat_for_index(bridge_index: int, bridge_sequence: Array) -> Dictionary:
	if bridge_sequence.is_empty():
		return {}

	if bridge_index >= 0 and bridge_index < bridge_sequence.size():
		var existing_raw: Variant = bridge_sequence [bridge_index]
		if typeof(existing_raw) == TYPE_DICTIONARY:
			return (existing_raw as Dictionary).duplicate(true)

	var used_keys: Dictionary = {}
	for raw_beat in bridge_sequence:
		if typeof(raw_beat) != TYPE_DICTIONARY:
			continue
		MainSceneLogic._startup_intro_register_used_moment_identity(gs, raw_beat as Dictionary, used_keys, "bridge")

	var safety_count: int = 0
	while bridge_sequence.size() <= bridge_index and safety_count < 48:
		var next_index: int = bridge_sequence.size()
		var rng:= _startup_intro_rng_for_phase("bridge_sequence_overflow_%d" % next_index)
		var moment: Dictionary = _startup_intro_pick_procedural_moment(rng, "bridge_hyper", next_index, used_keys)
		var beat: Dictionary = MainSceneLogic._startup_intro_moment_to_beat(moment, {
			"pitch": MainSceneHelpers._startup_intro_bridge_pitch_for_index(next_index)
		})

		bridge_sequence.append(beat)
		MainSceneLogic._startup_intro_register_used_moment_identity(gs, beat, used_keys, "bridge_hyper")
		safety_count += 1

	if not bridge_sequence.is_empty():
		set_meta("startup_intro_current_bridge_sequence", bridge_sequence.duplicate(true))
		set_meta("startup_intro_current_bridge_sequence_generation", startup_intro_sequence_generation)
		set_meta("startup_intro_current_bridge_sequence_extended_at_ms", int(Time.get_ticks_msec()))
		set_meta("startup_intro_current_bridge_sequence_extended_size", bridge_sequence.size())
		_startup_intro_cache_jumble_material(bridge_sequence)

	if bridge_index >= 0 and bridge_index < bridge_sequence.size():
		var generated_raw: Variant = bridge_sequence [bridge_index]
		if typeof(generated_raw) == TYPE_DICTIONARY:
			return (generated_raw as Dictionary).duplicate(true)

	var fallback_raw: Variant = bridge_sequence [bridge_sequence.size() - 1]
	if typeof(fallback_raw) == TYPE_DICTIONARY:
		return (fallback_raw as Dictionary).duplicate(true)

	return {}
func _run_startup_intro_bridge_sequence_until(target_final_card_ms: int, run_id: int, intro_started_ms: int = -1) -> void:
	var bridge_sequence_raw: Variant = get_meta("startup_intro_current_bridge_sequence", [])
	var bridge_sequence: Array = bridge_sequence_raw if typeof(bridge_sequence_raw) == TYPE_ARRAY else []
	if bridge_sequence.is_empty():
		bridge_sequence = _build_startup_intro_bridge_sequence()
	if bridge_sequence.is_empty():
		return
	if intro_started_ms <= 0:
		intro_started_ms = int(get_meta("startup_intro_audio_started_at_ms", int(Time.get_ticks_msec())))

	var bridge_index: int = 0
	var end_padding_ms: int = MainSceneHelpers._startup_intro_title_bridge_end_padding_ms()
	var jumble_window_ms: int = MainSceneHelpers._startup_intro_bridge_payload_glitch_window_ms()
	var ramp_begin_ms: int = intro_started_ms + int(MainSceneHelpers._startup_intro_drumming_ramp_begin_seconds() * 1000.0)
	var hyper_begin_ms: int = intro_started_ms + int(MainSceneHelpers._startup_intro_tonal_pitch_hyper_begin_seconds() * 1000.0)

	if hyper_begin_ms <= ramp_begin_ms:
		hyper_begin_ms = ramp_begin_ms + 1200

	set_meta("startup_intro_bridge_ramp_begin_ms", ramp_begin_ms)
	set_meta("startup_intro_bridge_hyper_begin_ms", hyper_begin_ms)
	set_meta("startup_intro_bridge_target_final_card_ms", target_final_card_ms)
	set_meta("startup_intro_bridge_repeat_prevention_active", true)

	while int(Time.get_ticks_msec()) < target_final_card_ms - end_padding_ms:
		if startup_intro_exiting or run_id != startup_intro_sequence_generation:
			return

		var now_ms: int = int(Time.get_ticks_msec())
		var remaining_ms: int = target_final_card_ms - end_padding_ms - now_ms
		var remaining_seconds: float = max(0.0, float(remaining_ms) / 1000.0)
		if remaining_seconds <= 0.032:
			return

		var ramp_active: bool = now_ms >= ramp_begin_ms
		var hyper_active: bool = now_ms >= hyper_begin_ms
		var ramp_progress: float = 0.0

		if ramp_active:
			ramp_progress = clamp(
				float(now_ms - ramp_begin_ms) / max(1.0, float(hyper_begin_ms - ramp_begin_ms)),
				0.0,
				1.0
			)

		var beat: Dictionary = {}
		var desired_total_time: float = 0.0

		if hyper_active:
			if remaining_ms <= jumble_window_ms:
				beat = _startup_intro_bridge_jumble_payload(bridge_index, remaining_ms)
			else:
				beat = _startup_intro_bridge_beat_for_index(bridge_index, bridge_sequence)

			if MainSceneLogic._startup_intro_should_glitch_bridge_payload(remaining_ms, hyper_active):
				beat = MainSceneHelpers._startup_intro_glitched_bridge_payload(beat, bridge_index, remaining_ms)

			desired_total_time = MainSceneHelpers._startup_intro_bridge_hyper_duration_for_remaining(remaining_seconds)
		elif ramp_active:
			beat = _startup_intro_bridge_beat_for_index(bridge_index, bridge_sequence)
			desired_total_time = MainSceneHelpers._startup_intro_bridge_ramp_duration_for_progress(ramp_progress)

			var ms_until_hyper: int = hyper_begin_ms - now_ms
			if ms_until_hyper > 0 and int(desired_total_time * 1000.0) > ms_until_hyper:
				desired_total_time = max(0.03, float(ms_until_hyper) / 1000.0)
		else:
			beat = _startup_intro_bridge_beat_for_index(bridge_index, bridge_sequence)
			desired_total_time = MainSceneHelpers._startup_intro_bridge_duration_for_remaining(remaining_seconds)

			var ms_until_ramp: int = ramp_begin_ms - now_ms
			if ms_until_ramp > 0 and int(desired_total_time * 1000.0) > ms_until_ramp:
				desired_total_time = max(0.04, float(ms_until_ramp) / 1000.0)

		if beat.is_empty():
			return

		var total_time: float = min(desired_total_time, max(0.01, remaining_seconds * 0.82))
		var fade_in_time: float = max(0.004, total_time * 0.18)
		var fade_out_time: float = max(0.004, total_time * 0.14)
		var hold_time: float = max(0.002, total_time - fade_in_time - fade_out_time)

		var pitch_scale: float = float(beat.get("pitch", 1.35))
		if ramp_active and not hyper_active:
			pitch_scale = lerp(1.18, max(pitch_scale, 1.74), ramp_progress)
		elif hyper_active:
			pitch_scale = max(pitch_scale, 1.82)

		await _show_startup_intro_moment(
			str(beat.get("year", "")),
			str(beat.get("line", "")),
			beat.get("year_color", Color(1.0, 1.0, 1.0, 1.0)),
			beat.get("line_color", Color(1.0, 1.0, 1.0, 1.0)),
			fade_in_time,
			hold_time,
			fade_out_time,
			pitch_scale
		)

		bridge_index += 1
func _startup_intro_cached_sequence_for_generation(meta_key: String, generation_key: String = "") -> Array:
	var cached_raw: Variant = get_meta(meta_key, [])
	if typeof(cached_raw) != TYPE_ARRAY:
		return []

	if generation_key != "":
		var cached_generation: int = int(get_meta(generation_key, -999999))
		if cached_generation != startup_intro_sequence_generation:
			return []

	var cached_sequence: Array = cached_raw
	if cached_sequence.is_empty():
		return []

	return cached_sequence.duplicate(true)


func _startup_intro_store_sequence_for_generation(meta_key: String, generation_key: String, sequence: Array) -> void:
	set_meta(meta_key, sequence.duplicate(true))
	set_meta(generation_key, startup_intro_sequence_generation)
	set_meta("%s_cached_at_ms" % meta_key, int(Time.get_ticks_msec()))
	set_meta("%s_signature" % meta_key, MainSceneHelpers._startup_intro_sequence_signature(sequence))
func _build_startup_intro_sequence() -> Array:
	var cached_sequence: Array = _startup_intro_cached_sequence_for_generation(
		"startup_intro_current_intro_sequence",
		"startup_intro_current_intro_sequence_generation"
	)
	if not cached_sequence.is_empty():
		return cached_sequence

	var sequence: Array = _startup_intro_build_procedural_intro_sequence()
	_startup_intro_store_sequence_for_generation(
		"startup_intro_current_intro_sequence",
		"startup_intro_current_intro_sequence_generation",
		sequence
	)
	return sequence
func _run_startup_intro_sequence() -> void:
	var run_id: int = startup_intro_sequence_generation

	if (
		bool(
			get_meta(
				"startup_intro_sequence_runner_active",
				false
			)
		)
		and int(
			get_meta(
				"startup_intro_sequence_runner_generation",
				-999999
			)
		) == run_id
	):
		return

	var runner_started_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"startup_intro_sequence_runner_active",
		true
	)
	set_meta(
		"startup_intro_sequence_runner_generation",
		run_id
	)
	set_meta(
		"startup_intro_sequence_runner_started_at_ms",
		runner_started_ms
	)

	var title_impact_duration_ms: int = maxi(
		1,
		int(
			MainSceneHelpers._startup_intro_title_impact_seconds()
			* 1000.0
		)
	)
	var intro_started_ms: int = int(
		get_meta(
			"startup_intro_visual_epoch_ms",
			get_meta(
				"startup_intro_audio_started_at_ms",
				runner_started_ms
			)
		)
	)




	if (
		intro_started_ms <= 0
		or intro_started_ms > runner_started_ms
		or runner_started_ms - intro_started_ms
		>= title_impact_duration_ms
	):
		intro_started_ms = runner_started_ms

		set_meta(
			"startup_intro_visual_epoch_ms",
			intro_started_ms
		)
		set_meta(
			"startup_intro_audio_started_at_ms",
			intro_started_ms
		)
		set_meta(
			"startup_intro_stale_epoch_repaired",
			true
		)
		set_meta(
			"startup_intro_stale_epoch_repaired_at_ms",
			runner_started_ms
		)

	var target_final_card_ms: int = (
		intro_started_ms
		+ title_impact_duration_ms
	)
	var text_begin_ms: int = (
		intro_started_ms
		+ int(
			MainSceneHelpers._startup_intro_initial_loading_seconds()
			* 1000.0
		)
	)
	var ramp_begin_ms: int = (
		intro_started_ms
		+ int(
			MainSceneHelpers._startup_intro_drumming_ramp_begin_seconds()
			* 1000.0
		)
	)
	var sequence: Array = (
		_build_startup_intro_sequence()
	)
	var bridge_sequence: Array = (
		_build_startup_intro_bridge_sequence()
	)

	set_meta(
		"startup_intro_current_bridge_sequence",
		bridge_sequence
	)
	set_meta(
		"startup_intro_visual_epoch_used_ms",
		intro_started_ms
	)
	set_meta(
		"startup_intro_target_final_card_ms",
		target_final_card_ms
	)

	var sequence_start_index: int = 0

	if int(
		Time.get_ticks_msec()
	) < text_begin_ms:
		var first_beat: Dictionary = {}

		if not sequence.is_empty():
			first_beat = sequence [0]

		var loading_handed_first_beat: bool = await (
			_show_startup_intro_loading_reveal_until(
				text_begin_ms,
				run_id,
				first_beat
			)
		)

		if loading_handed_first_beat:
			sequence_start_index = 1

	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		return

	for beat_index in range(
		sequence_start_index,
		sequence.size()
	):
		if (
			startup_intro_exiting
			or run_id
			!= startup_intro_sequence_generation
		):
			return

		var beat_raw: Variant = sequence [beat_index]

		if typeof(
			beat_raw
		) != TYPE_DICTIONARY:
			continue

		var beat: Dictionary = (
			beat_raw as Dictionary
		)
		var now_ms: int = int(
			Time.get_ticks_msec()
		)

		if now_ms >= ramp_begin_ms:
			break

		var remaining_to_ramp_seconds: float = maxf(
			0.0,
			float(
				ramp_begin_ms - now_ms
			) / 1000.0
		)

		if remaining_to_ramp_seconds <= 0.045:
			break

		var year_color: Color = beat.get(
			"year_color",
			Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
		)
		var line_color: Color = beat.get(
			"line_color",
			Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
		)
		var requested_fade_in: float = float(
			beat.get(
				"fade_in",
				0.2
			)
		)
		var requested_hold: float = float(
			beat.get(
				"hold",
				0.2
			)
		)
		var requested_fade_out: float = float(
			beat.get(
				"fade_out",
				0.15
			)
		)
		var requested_total: float = maxf(
			0.001,
			requested_fade_in
			+ requested_hold
			+ requested_fade_out
		)
		var fitted_total: float = minf(
			requested_total,
			maxf(
				0.03,
				remaining_to_ramp_seconds
				* 0.84
			)
		)
		var fade_in_time: float = maxf(
			0.01,
			fitted_total
			* (
				requested_fade_in
				/ requested_total
			)
		)
		var fade_out_time: float = maxf(
			0.008,
			fitted_total
			* (
				requested_fade_out
				/ requested_total
			)
		)
		var hold_time: float = maxf(
			0.006,
			fitted_total
			- fade_in_time
			- fade_out_time
		)

		await _show_startup_intro_moment(
			str(
				beat.get(
					"year",
					""
				)
			),
			str(
				beat.get(
					"line",
					""
				)
			),
			year_color,
			line_color,
			fade_in_time,
			hold_time,
			fade_out_time,
			float(
				beat.get(
					"pitch",
					1.0
				)
			)
		)

		if (
			startup_intro_exiting
			or run_id
			!= startup_intro_sequence_generation
		):
			return

	await _run_startup_intro_bridge_sequence_until(
		target_final_card_ms,
		run_id,
		intro_started_ms
	)

	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		return

	startup_intro_year_label.text = ""
	startup_intro_line_label.text = ""
	startup_intro_year_label.modulate = Color(
		1.0,
		1.0,
		1.0,
		0.0
	)
	startup_intro_line_label.modulate = Color(
		1.0,
		1.0,
		1.0,
		0.0
	)

	var final_wait_now_ms: int = int(
		Time.get_ticks_msec()
	)

	if final_wait_now_ms < target_final_card_ms:
		await get_tree().create_timer(
			float(
				target_final_card_ms
				- final_wait_now_ms
			) / 1000.0
		).timeout

	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		return

	await _show_startup_intro_final_card()

	if int(
		get_meta(
			"startup_intro_sequence_runner_generation",
			-999999
		)
	) == run_id:
		set_meta(
			"startup_intro_sequence_runner_active",
			false
		)
		set_meta(
			"startup_intro_sequence_runner_finished_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
func _show_startup_intro_frame_locked_moment(
	year_text: String,
	line_text: String,
	year_color: Color,
	line_color: Color,
	pitch_scale: float,
	run_id: int
) -> void:
	if startup_intro_year_label == null or startup_intro_line_label == null:
		return

	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return

	if startup_intro_exiting or run_id != startup_intro_sequence_generation:
		return

	var line_visible_now: bool = line_text.strip_edges() != ""

	startup_intro_title_label.text = ""
	startup_intro_subtitle_label.text = ""
	startup_intro_prompt_label.text = ""
	startup_intro_title_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_subtitle_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_prompt_label.modulate = Color(1.0, 1.0, 1.0, 0.0)

	startup_intro_year_label.visible = true
	startup_intro_line_label.visible = line_visible_now
	startup_intro_year_label.text = year_text
	startup_intro_line_label.text = line_text
	startup_intro_year_label.modulate = Color(year_color.r, year_color.g, year_color.b, 0.94)
	startup_intro_line_label.modulate = Color(line_color.r, line_color.g, line_color.b, 1.0) if line_visible_now else Color(line_color.r, line_color.g, line_color.b, 0.0)

	_play_startup_intro_tick(pitch_scale)

	set_meta("startup_intro_frame_locked_hyper_moment_rendered", true)
	set_meta("startup_intro_frame_locked_hyper_moment_rendered_at_ms", int(Time.get_ticks_msec()))
	set_meta("startup_intro_frame_locked_hyper_moment_year", year_text)
	set_meta("startup_intro_frame_locked_hyper_moment_line", line_text)

	if get_tree() != null:
		await get_tree().process_frame
func _show_startup_intro_moment(
	year_text: String,
	line_text: String,
	year_color: Color,
	line_color: Color,
	fade_in_time: float,
	hold_time: float,
	fade_out_time: float,
	pitch_scale: float
) -> void:
	if startup_intro_year_label == null or startup_intro_line_label == null:
		return

	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return

	var run_id:= startup_intro_sequence_generation
	var total_time: float = max(0.0, fade_in_time + hold_time + fade_out_time)
	var frame_locked_moment: bool = total_time <= 0.095 or fade_in_time <= 0.012 or fade_out_time <= 0.012

	if frame_locked_moment:
		await _show_startup_intro_frame_locked_moment(
			year_text,
			line_text,
			year_color,
			line_color,
			pitch_scale,
			run_id
		)
		return

	var line_visible_now: bool = line_text.strip_edges() != ""

	startup_intro_title_label.text = ""
	startup_intro_subtitle_label.text = ""
	startup_intro_prompt_label.text = ""
	startup_intro_title_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_subtitle_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_prompt_label.modulate = Color(1.0, 1.0, 1.0, 0.0)

	startup_intro_year_label.visible = true
	startup_intro_line_label.visible = line_visible_now
	startup_intro_year_label.text = year_text
	startup_intro_line_label.text = line_text

	var year_hidden:= Color(year_color.r, year_color.g, year_color.b, 0.0)
	var year_visible:= Color(year_color.r, year_color.g, year_color.b, 0.88)
	var line_hidden:= Color(line_color.r, line_color.g, line_color.b, 0.0)
	var line_visible:= Color(line_color.r, line_color.g, line_color.b, 1.0)

	startup_intro_year_label.modulate = year_hidden
	startup_intro_line_label.modulate = line_hidden

	_play_startup_intro_tick(pitch_scale)

	var moment_tween:= _track_startup_intro_runtime_tween(create_tween().bind_node(startup_intro_overlay))
	moment_tween.set_trans(Tween.TRANS_SINE)
	moment_tween.set_ease(Tween.EASE_OUT)
	moment_tween.tween_property(startup_intro_year_label, "modulate", year_visible, fade_in_time)

	if line_visible_now:
		moment_tween.parallel().tween_property(startup_intro_line_label, "modulate", line_visible, fade_in_time)

	if hold_time > 0.0:
		moment_tween.tween_interval(hold_time)

	moment_tween.set_ease(Tween.EASE_IN)
	moment_tween.tween_property(startup_intro_year_label, "modulate", year_hidden, fade_out_time)

	if line_visible_now:
		moment_tween.parallel().tween_property(startup_intro_line_label, "modulate", line_hidden, fade_out_time)

	await moment_tween.finished

	if startup_intro_exiting or run_id != startup_intro_sequence_generation:
		return

func _show_startup_intro_final_card() -> void:
	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return
	if startup_intro_title_label == null or not is_instance_valid(startup_intro_title_label):
		return
	if startup_intro_subtitle_label == null or not is_instance_valid(startup_intro_subtitle_label):
		return
	if startup_intro_prompt_label == null or not is_instance_valid(startup_intro_prompt_label):
		return
	if startup_intro_year_label == null or not is_instance_valid(startup_intro_year_label):
		return
	if startup_intro_line_label == null or not is_instance_valid(startup_intro_line_label):
		return

	startup_intro_year_label.text = ""
	startup_intro_line_label.text = ""
	startup_intro_line_label.visible = false
	startup_intro_title_label.text = "ERALIFE"
	startup_intro_subtitle_label.text = "The world does not wait for you."
	startup_intro_prompt_label.text = _title_card_identity_prompt_text()

	if startup_intro_title_tween != null:
		startup_intro_title_tween.kill()
		startup_intro_title_tween = null
	if startup_intro_prompt_tween != null:
		startup_intro_prompt_tween.kill()
		startup_intro_prompt_tween = null
	if startup_intro_skip_tween != null:
		startup_intro_skip_tween.kill()
		startup_intro_skip_tween = null
	if startup_intro_replay_tween != null:
		startup_intro_replay_tween.kill()
		startup_intro_replay_tween = null

	if startup_intro_skip_button != null and is_instance_valid(startup_intro_skip_button):
		startup_intro_skip_button.visible = false

	_set_startup_intro_title_shine_enabled(false)
	startup_intro_accepting_input = false
	set_meta("startup_intro_title_card_visible_surface", true)
	set_meta("startup_intro_title_card_identity_surface_visible", true)

	startup_intro_title_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_subtitle_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_prompt_label.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_title_label.scale = Vector2(1.08, 1.08)
	startup_intro_prompt_label.scale = Vector2.ONE

	_stage_startup_intro_replay_button()

	var tween:= _track_startup_intro_runtime_tween(create_tween().bind_node(startup_intro_overlay))
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(startup_intro_title_label, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.24)
	tween.parallel().tween_property(startup_intro_title_label, "scale", Vector2.ONE, 0.34)
	tween.parallel().tween_property(startup_intro_subtitle_label, "modulate", Color(1.0, 1.0, 1.0, 0.82), 0.58).set_delay(0.32)
	tween.parallel().tween_property(startup_intro_prompt_label, "modulate", Color(1.0, 1.0, 1.0, 0.76), 0.78).set_delay(0.82)

	await tween.finished

	if startup_intro_exiting:
		return
	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return
	if startup_intro_title_label == null or not is_instance_valid(startup_intro_title_label):
		return
	if startup_intro_prompt_label == null or not is_instance_valid(startup_intro_prompt_label):
		return

	_start_startup_intro_title_pulse()
	startup_intro_accepting_input = true
	_enable_startup_intro_replay_button()
	_start_startup_intro_prompt_pulse()

	if bool(get_meta("startup_intro_prelife_candidate_deferred_until_final_card", false)):
		set_meta("startup_intro_prelife_candidate_deferred_until_final_card", false)
		call_deferred("_prepare_startup_prelife_reality_candidate")
func _request_title_card_eralife_account() -> void:
	_open_title_card_account_panel("signup")
func _title_card_identity_prompt_text() -> String:
	var identity_raw: Variant = get_meta(
		"title_card_identity_contract",
		{}
	)
	var identity_contract: Dictionary = (
		(identity_raw as Dictionary)
		.duplicate(true)
		if typeof(
			identity_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var identity_context_raw: Variant = (
		identity_contract.get(
			"identity_context",
			{}
		)
	)
	var identity_context: Dictionary = (
		(identity_context_raw as Dictionary)
		.duplicate(true)
		if typeof(
			identity_context_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var continue_contract: Dictionary = (
		_title_card_continue_contract()
	)
	var is_guest: bool = bool(
		identity_contract.get(
			"is_guest",
			identity_context.get(
				"is_guest",
				true
			)
		)
	)
	var continue_available: bool = bool(
		continue_contract.get(
			"available",
			false
		)
	)
	var player_name: String = str(
		continue_contract.get(
			"player_name",
			"Current Life"
		)
	).strip_edges()
	var player_age: int = int(
		continue_contract.get(
			"player_age",
			-1
		)
	)
	var life_label: String = player_name

	if player_age >= 0:
		life_label += (
			", age %d"
			% player_age
		)

	if is_guest:
		var guest_text: String = (
			"Guest mode. Press A to create an ErAccount. "
			+ "Press L to log in."
		)

		if continue_available:
			guest_text += (
				"\nPress C to continue your current life: %s."
				% life_label
			)
		else:
			guest_text += (
				"\nNo unclaimed guest life is saved on this device."
			)

		guest_text += (
			"\nPress anywhere to enter EraLife."
		)

		return guest_text

	var account_username: String = str(
		identity_context.get(
			"account_username",
			""
		)
	).strip_edges()
	var account_text: String = (
		"ErAccount connected"
	)

	if account_username != "":
		account_text += (
			" as @%s"
			% account_username
		)

	account_text += (
		". Press F to disconnect."
	)

	if continue_available:
		account_text += (
			"\nPress C to continue your current life: %s."
			% life_label
		)
	elif bool(
		continue_contract.get(
			"legacy_attachment_available",
			false
		)
	):
		account_text += (
			"\nNo life is attached to this ErAccount yet. "
			+ "Local legacy lives are available to attach."
		)
	else:
		account_text += (
			"\nNo saved life exists for this ErAccount yet."
		)

	account_text += (
		"\nPress anywhere to enter EraLife."
	)

	return account_text
func _checkpoint_resume_contract_from_attached_projection(
	base_resume_contract: Dictionary,
	attach_report: Dictionary
) -> Dictionary:
	var normalized: Dictionary = (
		base_resume_contract.duplicate(true)
	)
	var projection_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		attach_report.get(
			"projection_contract",
			{}
		)
	)
	var projection_graph: Dictionary = MainSceneHelpers._safe_dictionary(
		projection_contract.get(
			"projection_graph",
			{}
		)
	)
	var surface_graph: Dictionary = MainSceneHelpers._safe_dictionary(
		projection_contract.get(
			"surface_graph",
			{}
		)
	)
	var surface_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		surface_graph.get(
			"surface_contracts",
			projection_graph.get(
				"surface_contracts",
				{}
			)
		)
	)
	var first_frame: Dictionary = MainSceneHelpers._safe_dictionary(
		attach_report.get(
			"checkpoint_first_frame_ui_snapshot",
			base_resume_contract.get(
				"first_frame_ui_snapshot",
				projection_graph.get(
					"first_frame_snapshot",
					{}
				)
			)
		)
	)

	if (
		first_frame.is_empty()
		and gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		first_frame = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"prebuilt_first_frame_ui_snapshot",
				gs.scenario_state.get(
					"zero_frame_consciousness_switch_surface",
					{}
				)
			)
		)

	var hud_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(
		base_resume_contract.get(
			"runtime_hud_visibility_snapshot",
			{}
		)
	)

	if (
		hud_snapshot.is_empty()
		and gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		hud_snapshot = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		)

	var diary_entries: Array = []
	var latest_diary_lines: Array = []

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		var diary_store: Dictionary = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"life_diary_state_by_npc",
				{}
			)
		)
		var diary_row: Dictionary = MainSceneHelpers._safe_dictionary(
			diary_store.get(
				str(gs.player_id),
				{}
			)
		)
		var diary_entries_raw: Variant = diary_row.get(
			"entries",
			[]
		)

		if typeof(diary_entries_raw) == TYPE_ARRAY:
			diary_entries = (
				diary_entries_raw as Array
			).duplicate(true)

		var latest_raw: Variant = gs.scenario_state.get(
			"checkpoint_resume_latest_diary_lines",
			[]
		)

		if typeof(latest_raw) == TYPE_ARRAY:
			latest_diary_lines = (
				latest_raw as Array
			).duplicate(true)

	if diary_entries.is_empty():
		var saved_entries_raw: Variant = (
			base_resume_contract.get(
				"life_diary_entries",
				[]
			)
		)

		if typeof(saved_entries_raw) == TYPE_ARRAY:
			diary_entries = (
				saved_entries_raw as Array
			).duplicate(true)

	if latest_diary_lines.is_empty():
		var saved_latest_raw: Variant = (
			base_resume_contract.get(
				"latest_life_diary_lines",
				first_frame.get(
					"life_diary_lines",
					[]
				)
			)
		)

		if typeof(saved_latest_raw) == TYPE_ARRAY:
			latest_diary_lines = (
				saved_latest_raw as Array
			).duplicate(true)

	var node_graph: Dictionary = MainSceneHelpers._safe_dictionary(
		projection_contract.get(
			"node_graph",
			{}
		)
	)
	var world_seed: int = int(
		node_graph.get(
			"world_seed",
			base_resume_contract.get(
				"world_seed",
				-1
			)
		)
	)

	if (
		world_seed <= 0
		and gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		world_seed = int(
			gs.scenario_state.get(
				"world_seed",
				-1
			)
		)

	var era_name: String = str(
		first_frame.get(
			"era_name",
			base_resume_contract.get(
				"era_name",
				""
			)
		)
	).strip_edges()

	if (
		era_name == ""
		and gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		era_name = str(
			gs.scenario_state.get(
				"effective_era_name",
				gs.scenario_state.get(
					"era_name",
					""
				)
			)
		).strip_edges()

	var era_key: String = (
		era_name.to_lower().strip_edges()
	)

	if era_key == "":
		era_key = "modern"

	var audio_context: Dictionary = MainSceneHelpers._safe_dictionary(
		base_resume_contract.get(
			"era_audio_context",
			{}
		)
	)

	if audio_context.is_empty():
		audio_context = {
			"era_key": era_key,
			"era_name": era_name,
			"year": (
				int(gs.year)
				if gs != null
				else 0
			),
			"player_id": (
				int(gs.player_id)
				if gs != null
				else -1
			),
			"current_panel": "life",
			"source": "attached_checkpoint_projection",
			"checkpoint_resume": true,
			"birth_intro_audio_forbidden": true
		}

	normalized ["version"] = 4
	normalized ["actor_id"] = int(gs.player_id)
	normalized ["player_id"] = int(gs.player_id)
	normalized ["controlled_actor_id"] = int(gs.player_id)
	normalized ["current_panel"] = "life"
	normalized ["entry_kind"] = "checkpoint_resume"
	normalized ["resume_not_birth"] = true
	normalized ["birth_intro_allowed"] = false
	normalized ["world_seed"] = world_seed
	normalized ["first_frame_ui_snapshot"] = first_frame
	normalized [
		"runtime_hud_visibility_snapshot"
	] = hud_snapshot
	normalized [
		"main_tab_surface_contracts"
	] = surface_deck
	normalized ["life_diary_entries"] = diary_entries
	normalized [
		"latest_life_diary_lines"
	] = latest_diary_lines
	normalized ["era_audio_context"] = audio_context
	normalized [
		"relationship_cards_packet_present"
	] = surface_deck.has("relationships")
	normalized [
		"main_tab_surface_packet_count"
	] = surface_deck.size()
	normalized [
		"presentation_contract_complete"
	] = (
		world_seed > 0
		and not first_frame.is_empty()
		and not audio_context.is_empty()
		and surface_deck.has("relationships")
		and surface_deck.has("school")
		and surface_deck.has("activities")
		and surface_deck.has("career")
		and surface_deck.has("mods")
	)
	normalized [
		"binary_payload_required_before_visible_lens"
	] = false
	normalized [
		"normalized_from_resident_projection"
	] = true
	normalized [
		"normalized_at_ms"
	] = int(Time.get_ticks_msec())

	return normalized
func _queue_title_card_checkpoint_resume_lens_prewarm(
	continue_contract: Dictionary
) -> void:
	if (
		continue_contract.is_empty()
		or not bool(
			continue_contract.get(
				"available",
				false
			)
		)
	):
		return

	var checkpoint_path: String = str(
		continue_contract.get(
			"checkpoint_path",
			""
		)
	).strip_edges()
	var resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options({
			"continue_contract": continue_contract
		})
	)
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			resume_contract.get(
				"residency_signature",
				""
			)
		)
	).strip_edges()

	if (
		checkpoint_path == ""
		or not FileAccess.file_exists(
			checkpoint_path
		)
		or signature == ""
	):
		return

	if (
		bool(
			get_meta(
				"title_card_checkpoint_transaction_ready",
				false
			)
		)
		and str(
			get_meta(
				"title_card_checkpoint_transaction_ready_signature",
				""
			)
		) == signature
	):
		return

	if bool(
		get_meta(
			"title_card_checkpoint_transaction_prepare_active",
			false
		)
	):
		var active_signature: String = str(
			get_meta(
				"title_card_checkpoint_transaction_prepare_signature",
				""
			)
		).strip_edges()

		if active_signature == signature:
			return

	set_meta(
		"title_card_checkpoint_transaction_prepare_active",
		true
	)
	set_meta(
		"title_card_checkpoint_transaction_ready",
		false
	)
	set_meta(
		"title_card_checkpoint_transaction_prepare_signature",
		signature
	)
	set_meta(
		"title_card_checkpoint_transaction_prepare_started_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)


	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_active",
		false
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_complete",
		false
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_signature",
		signature
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_contract",
		resume_contract.duplicate(false)
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_continue_contract",
		{}
	)
	set_meta(
		"title_card_checkpoint_background_residency_started",
		true
	)
	set_meta(
		"title_card_checkpoint_background_residency_signature",
		signature
	)
	set_meta(
		"title_card_checkpoint_renderer_chassis_is_ready_gate_member",
		false
	)
	set_meta(
		"title_card_checkpoint_full_engine_graph_is_ready_gate_member",
		false
	)




	call_deferred(
		"_queue_checkpoint_resume_renderer_chassis_prewarm",
		resume_contract.duplicate(false)
	)




	_request_reality_residency_intent(
		"reserve_checkpoint",
		{
			"signature": signature,
			"checkpoint_path": checkpoint_path,
			"path": checkpoint_path,
			"authority": "local",
			"checkpoint_resume_contract": (
				resume_contract.duplicate(false)
			),
			"continue_contract": (
				continue_contract.duplicate(false)
			),
			"load_options": {
				"continue_contract": (
					continue_contract.duplicate(false)
				),
				"checkpoint_resume_contract": (
					resume_contract.duplicate(false)
				),
				"residency_signature": signature,
				"entry_surface": (
					"title_card_detached_reality_prepare"
				),
				"transactional_reality_switch": true,
				"preserve_active_reality_until_commit": true
			},
			"resident_reattach_preferred": true,
			"runtime_rebuild_forbidden": true,
			"transactional_reality_switch": true,
			"source": (
				"title_card_checkpoint_detached_prepare"
			)
		},
		(
			"mainscene."
			+ "title_card_checkpoint_detached_prepare"
		)
	)

	call_deferred(
		"_continue_title_card_checkpoint_transaction_prepare",
		continue_contract.duplicate(false),
		signature
	)
func _checkpoint_resume_world_seed_ui_lens_key(
	resume_contract: Dictionary
) -> String:
	if resume_contract.is_empty():
		return ""

	var first_frame_raw: Variant = resume_contract.get(
		"first_frame_ui_snapshot",
		{}
	)
	var first_frame: Dictionary = (
		first_frame_raw as Dictionary
		if typeof(first_frame_raw) == TYPE_DICTIONARY
		else {}
	)
	var audio_raw: Variant = resume_contract.get(
		"era_audio_context",
		{}
	)
	var audio_context: Dictionary = (
		audio_raw as Dictionary
		if typeof(audio_raw) == TYPE_DICTIONARY
		else {}
	)

	var era_name: String = str(
		resume_contract.get(
			"era_name",
			audio_context.get(
				"era_name",
				first_frame.get(
					"era_name",
					"unknown_era"
				)
			)
		)
	).strip_edges()

	if era_name == "":
		era_name = "unknown_era"

	var year_value: int = int(
		resume_contract.get(
			"year",
			first_frame.get(
				"year",
				-999999
			)
		)
	)
	var epoch: int = int(
		get_meta(
			"world_seed_ui_lens_epoch",
			0
		)
	)

	return "world_lens:%d|era:%s|year:%d" % [
		epoch,
		era_name,
		year_value
	]
func _ensure_checkpoint_era_background_fill_shell() -> void:
	var ui_root:= self as Control

	if ui_root == null:
		return

	var bg:= (
		ui_root.get_node_or_null(
			"__EraBackgroundFill"
		) as ColorRect
	)

	if (
		bg != null
		and is_instance_valid(bg)
	):
		return

	bg = ColorRect.new()
	bg.name = "__EraBackgroundFill"
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bg.z_index = -100
	bg.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	bg.color = Color(
		0.0,
		0.0,
		0.0,
		0.0
	)
	bg.visible = false
	bg.set_meta(
		"checkpoint_resume_renderer_chassis_only",
		true
	)
	bg.set_meta(
		"checkpoint_resume_truth_not_painted_yet",
		true
	)

	ui_root.add_child(bg)
	ui_root.move_child(
		bg,
		0
	)
func _queue_checkpoint_resume_renderer_chassis_prewarm(
	resume_contract: Dictionary
) -> void:
	if resume_contract.is_empty():
		return

	var actor_id: int = int(
		resume_contract.get(
			"controlled_actor_id",
			resume_contract.get(
				"actor_id",
				-1
			)
		)
	)

	if actor_id <= 0:
		return

	var target_lens_key: String = (
		_checkpoint_resume_world_seed_ui_lens_key(
			resume_contract
		)
	)

	if target_lens_key == "":
		return

	if (
		checkpoint_resume_renderer_chassis_hot_actor_id
		== actor_id
		and str(
			get_meta(
				"checkpoint_resume_renderer_chassis_hot_lens_key",
				""
			)
		) == target_lens_key
	):
		return

	if (
		checkpoint_resume_renderer_chassis_service_active
		and checkpoint_resume_renderer_chassis_actor_id
		== actor_id
		and str(
			get_meta(
				"checkpoint_resume_renderer_chassis_prewarm_lens_key",
				""
			)
		) == target_lens_key
	):
		return

	checkpoint_resume_renderer_chassis_generation += 1

	var generation: int = (
		checkpoint_resume_renderer_chassis_generation
	)

	checkpoint_resume_renderer_chassis_actor_id = actor_id
	checkpoint_resume_renderer_chassis_hot_actor_id = -1
	checkpoint_resume_renderer_chassis_queue.clear()
	checkpoint_resume_renderer_chassis_keys.clear()



	for task_id in [
		"shell.player_stats",
		"shell.era_background",
		"shell.era_border",
		"hud.belongings",
		"hud.bending",
		"hud.crown_button",
		"hud.food",
		"hud.rick",
		"hud.boxing",
		"hud.superpower",
		"hud.power",
		"hud.wizard",
		"hud.crime",
		"tab.relationships",
		"tab.school",
		"tab.activities",
		"tab.career",
		"tab.mods"
	]:
		var queue_key: String = (
			"%d::%d::%s::%s"
			% [
				generation,
				actor_id,
				target_lens_key,
				task_id
			]
		)

		checkpoint_resume_renderer_chassis_keys [
			queue_key
		] = true

		checkpoint_resume_renderer_chassis_queue.append({
			"queue_key": queue_key,
			"generation": generation,
			"actor_id": actor_id,
			"task_id": task_id,
			"world_seed_ui_lens_key": target_lens_key
		})

	checkpoint_resume_renderer_chassis_service_active = true

	set_meta(
		"checkpoint_resume_renderer_chassis_prewarm_active",
		true
	)
	set_meta(
		"checkpoint_resume_renderer_chassis_prewarm_actor_id",
		actor_id
	)
	set_meta(
		"checkpoint_resume_renderer_chassis_prewarm_lens_key",
		target_lens_key
	)
	set_meta(
		"checkpoint_resume_renderer_chassis_prewarm_build_on_click",
		false
	)
	set_meta(
		"checkpoint_resume_renderer_chassis_prewarm_ready_gate_member",
		false
	)

	call_deferred(
		"_service_checkpoint_resume_renderer_chassis_prewarm",
		generation
	)


func _service_checkpoint_resume_renderer_chassis_prewarm(
	generation: int
) -> void:
	if (
		generation
		!= checkpoint_resume_renderer_chassis_generation
	):
		return

	if checkpoint_resume_renderer_chassis_queue.is_empty():
		checkpoint_resume_renderer_chassis_service_active = false
		checkpoint_resume_renderer_chassis_hot_actor_id = (
			checkpoint_resume_renderer_chassis_actor_id
		)

		set_meta(
			"checkpoint_resume_renderer_chassis_prewarm_active",
			false
		)
		set_meta(
			"checkpoint_resume_renderer_chassis_hot",
			true
		)
		set_meta(
			"checkpoint_resume_renderer_chassis_hot_actor_id",
			checkpoint_resume_renderer_chassis_hot_actor_id
		)
		set_meta(
			"checkpoint_resume_renderer_chassis_hot_lens_key",
			str(
				get_meta(
					"checkpoint_resume_renderer_chassis_prewarm_lens_key",
					""
				)
			)
		)
		set_meta(
			"checkpoint_resume_renderer_chassis_hot_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return




	await RenderingServer.frame_post_draw

	if (
		generation
		!= checkpoint_resume_renderer_chassis_generation
	):
		return

	if checkpoint_resume_renderer_chassis_queue.is_empty():
		call_deferred(
			"_service_checkpoint_resume_renderer_chassis_prewarm",
			generation
		)
		return

	var request_raw: Variant = (
		checkpoint_resume_renderer_chassis_queue.pop_front()
	)
	var request: Dictionary = (
		(request_raw as Dictionary).duplicate(false)
		if typeof(request_raw) == TYPE_DICTIONARY
		else {}
	)
	var queue_key: String = str(
		request.get(
			"queue_key",
			""
		)
	)

	if queue_key != "":
		checkpoint_resume_renderer_chassis_keys.erase(
			queue_key
		)

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)
	var task_id: String = str(
		request.get(
			"task_id",
			""
		)
	).strip_edges().to_lower()
	var target_lens_key: String = str(
		request.get(
			"world_seed_ui_lens_key",
			""
		)
	).strip_edges()

	match task_id:
		"shell.player_stats":
			_ensure_player_stats_overlay()

		"shell.era_background":
			_ensure_checkpoint_era_background_fill_shell()

		"shell.era_border":
			_ensure_era_border_overlay()

		"hud.belongings":
			_ensure_belongings_hud()

		"hud.bending":
			_ensure_bending_hud()

		"hud.crown_button":
			_ensure_checkpoint_crown_hud_button_shell()

		"hud.food":
			_ensure_food_lifestyle_hud()

		"hud.rick":
			_ensure_rick_weapon_shop_hud()

		"hud.boxing":
			_ensure_boxing_hud()

		"hud.superpower":
			_ensure_superpower_hud()

		"hud.power":
			_ensure_power_hud()

		"hud.wizard":
			_ensure_wizard_hud()

		"hud.crime":
			_ensure_crime_hud()

		"tab.relationships", \
"tab.school", \
"tab.activities", \
"tab.career", \
"tab.mods":
			var surface_id: String = (
				task_id.trim_prefix(
					"tab."
				)
			)
			var actor_key: String = str(
				actor_id
			)
			var deck_raw: Variant = (
				resident_main_tab_renderer_deck_by_actor.get(
					actor_key,
					{}
				)
			)
			var deck: Dictionary = (
				(deck_raw as Dictionary).duplicate(false)
				if typeof(deck_raw) == TYPE_DICTIONARY
				else {}
			)
			var existing_lens_key: String = str(
				deck.get(
					"world_seed_ui_lens_key",
					""
				)
			).strip_edges()
			var deck_usable: bool = (
				deck.is_empty()
				or existing_lens_key == target_lens_key
			)



			if not deck_usable:
				set_meta(
					"checkpoint_resume_renderer_chassis_existing_reality_preserved",
					true
				)
				set_meta(
					"checkpoint_resume_renderer_chassis_existing_lens_key",
					existing_lens_key
				)
				set_meta(
					"checkpoint_resume_renderer_chassis_target_lens_key",
					target_lens_key
				)
			else:
				if deck.is_empty():
					deck = {
						"actor_id": actor_id,
						"world_seed_ui_lens_key": target_lens_key,
						"contracts": {},
						"created_at_ms": int(
							Time.get_ticks_msec()
						)
					}

				var panel:= (
					deck.get(
						surface_id,
						null
					) as Control
				)

				if (
					panel == null
					or not is_instance_valid(
						panel
					)
				):
					panel = (
						_new_resident_main_tab_renderer_panel(
							surface_id,
							actor_id
						)
					)

				if (
					panel != null
					and is_instance_valid(
						panel
					)
				):
					deck [
						surface_id
					] = panel
					deck [
						"world_seed_ui_lens_key"
					] = target_lens_key
					deck [
						"updated_at_ms"
					] = int(
						Time.get_ticks_msec()
					)

					resident_main_tab_renderer_deck_by_actor [
						actor_key
					] = deck

	set_meta(
		"checkpoint_resume_renderer_chassis_last_task",
		task_id
	)
	set_meta(
		"checkpoint_resume_renderer_chassis_last_task_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	call_deferred(
		"_service_checkpoint_resume_renderer_chassis_prewarm",
		generation
	)
func _checkpoint_resume_renderer_chassis_is_hot(
	actor_id: int
) -> bool:
	if actor_id <= 0:
		return false

	if (
		checkpoint_resume_renderer_chassis_hot_actor_id
		!= actor_id
	):
		return false

	if checkpoint_resume_renderer_chassis_service_active:
		return false

	var deck: Dictionary = (
		_resident_main_tab_renderer_deck_for_actor(
			actor_id
		)
	)

	for surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var panel:= deck.get(
			surface_id,
			null
		) as Control

		if (
			panel == null
			or not is_instance_valid(
				panel
			)
		):
			return false

	var checkpoint_hud_chassis_hot: bool = (
		belongings_hud_button != null
		and is_instance_valid(
			belongings_hud_button
		)
		and bending_hud_button != null
		and is_instance_valid(
			bending_hud_button
		)
		and crown_hud_button != null
		and is_instance_valid(
			crown_hud_button
		)
		and food_lifestyle_hud_button != null
		and is_instance_valid(
			food_lifestyle_hud_button
		)
		and restaurant_lifestyle_hud_button != null
		and is_instance_valid(
			restaurant_lifestyle_hud_button
		)
		and rick_weapon_shop_hud_button != null
		and is_instance_valid(
			rick_weapon_shop_hud_button
		)
		and boxing_hud_button != null
		and is_instance_valid(
			boxing_hud_button
		)
		and superpower_hud_button != null
		and is_instance_valid(
			superpower_hud_button
		)
		and power_hud_button != null
		and is_instance_valid(
			power_hud_button
		)
		and wizard_hud_button != null
		and is_instance_valid(
			wizard_hud_button
		)
		and crime_hud_button != null
		and is_instance_valid(
			crime_hud_button
		)
	)

	if not checkpoint_hud_chassis_hot:
		return false



	return _resident_playable_life_shell_surface_is_hot()
func _continue_title_card_checkpoint_transaction_prepare(
	continue_contract: Dictionary,
	signature: String
) -> void:
	if not bool(
		get_meta(
			"title_card_checkpoint_transaction_prepare_active",
			false
		)
	):
		return

	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return

	if str(
		get_meta(
			"title_card_checkpoint_transaction_prepare_signature",
			""
		)
	).strip_edges() != clean_signature:
		return

	var status_report: Dictionary = (
		_request_reality_residency_intent(
			"status",
			{
				"signature": clean_signature,
				"source": (
					"title_card_checkpoint_transaction_prepare_observation"
				),
				"transactional_reality_switch": true,
			},
			(
				"mainscene."
				+ "title_card_checkpoint_transaction_prepare_observation"
			)
		)
	)

	var resident_ready: bool = bool(
		status_report.get(
			"ready",
			false
		)
	)
	var projection_ready: bool = bool(
		status_report.get(
			"projection_ready",
			false
		)
	)




	var critical_contract_set_ready: bool = (
		bool(
			status_report.get(
				"success",
				false
			)
		)
		and resident_ready
	)

	set_meta(
		"title_card_checkpoint_transaction_renderer_chassis_required_for_handoff",
		false
	)
	set_meta(
		"title_card_checkpoint_transaction_renderer_chassis_is_enrichment_only",
		true
	)
	set_meta(
		"title_card_checkpoint_transaction_projection_required_for_handoff",
		false
	)
	set_meta(
		"title_card_checkpoint_transaction_full_engine_graph_required_for_handoff",
		false
	)
	set_meta(
		"title_card_checkpoint_transaction_last_status",
		status_report.duplicate(false)
	)
	set_meta(
		"title_card_checkpoint_transaction_resident_ready",
		resident_ready
	)
	set_meta(
		"title_card_checkpoint_transaction_projection_ready",
		projection_ready
	)
	set_meta(
		"title_card_checkpoint_transaction_progressive_observable_ready",
		critical_contract_set_ready
	)
	set_meta(
		"title_card_checkpoint_transaction_projection_is_enrichment_only",
		true
	)

	if critical_contract_set_ready:
		var ready_at_ms: int = int(
			Time.get_ticks_msec()
		)

		set_meta(
			"title_card_checkpoint_transaction_prepare_active",
			false
		)
		set_meta(
			"title_card_checkpoint_transaction_ready",
			true
		)
		set_meta(
			"title_card_checkpoint_transaction_ready_signature",
			clean_signature
		)
		set_meta(
			"title_card_checkpoint_transaction_ready_at_ms",
			ready_at_ms
		)
		set_meta(
			"title_card_checkpoint_transaction_attached_during_prepare",
			false
		)
		set_meta(
			"title_card_checkpoint_transaction_mainscene_rebound_during_prepare",
			false
		)

		if bool(
			get_meta(
				"title_card_continue_pending_until_hot",
				false
			)
		):
			call_deferred(
				"_continue_title_card_current_life"
			)

		EraLog.truth(
			"ERALIFE_REALITY_TRANSACTION_PREPARE_TRUTH"
			+ "|signature=" + clean_signature
			+ "|resident_ready=true"
			+ "|projection_enrichment_hot="
			+ str(projection_ready).to_lower()
			+ "|projection_required_for_handoff=false"
			+ "|renderer_chassis_required_for_handoff=false"
			+ "|full_engine_graph_required_for_handoff=false"
			+ "|attached=false"
			+ "|mainscene_rebound=false"
			+ "|progressive_observable_ready=true"
			+ "|critical_contract_set_valid=true"
			+ "|at_ms=" + str(ready_at_ms)
		)
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_continue_title_card_checkpoint_transaction_prepare",
			continue_contract,
			clean_signature
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_title_card_checkpoint_transaction_prepare"
		).bind(
			continue_contract,
			clean_signature
		),
		CONNECT_ONE_SHOT
	)

func _apply_checkpoint_resume_hud_snapshot_to_existing_nodes(
	hud_snapshot: Dictionary,
	reason: String
) -> bool:
	if hud_snapshot.is_empty():
		return false

	_apply_zero_frame_hud_button_shell(
		belongings_hud_button,
		bool(
			hud_snapshot.get(
				"belongings_button_visible",
				hud_snapshot.get(
					"belongings_available",
					false
				)
			)
		)
	)
	_apply_zero_frame_hud_button_shell(
		bending_hud_button,
		bool(
			hud_snapshot.get(
