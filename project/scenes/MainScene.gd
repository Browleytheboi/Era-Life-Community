			)

			var loading: Dictionary = (
				(loading_raw as Dictionary).duplicate(false)
				if typeof(
					loading_raw
				) == TYPE_DICTIONARY
				else {}
			)

			loading [
				"presentation_visible"
			] = false

			loading [
				"presentation_released"
			] = true

			loading [
				"tail_runtime_pending"
			] = true

			loading [
				"simulation_complete"
			] = false

			gs.scenario_state [
				"loading_runtime"
			] = loading
		else:
			gs.scenario_state.erase(
				"speculative_next_year_cache"
			)

			gs.scenario_state [
				"loading_runtime"
			] = {}
func _prewarm_age_up_loading_overlay_for_context(loading_context: Dictionary, restore_loading_state: bool = false) -> void:
	_ensure_age_up_loading_overlay()
	if age_up_loading_overlay == null:
		return
	var had_loading_state: bool = false
	var previous_loading_state: Dictionary = {}
	var prewarm_signature: String = MainSceneHelpers._build_age_up_loading_prewarm_signature(loading_context)
	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		if restore_loading_state:
			had_loading_state = gs.scenario_state.has("loading_runtime")
			var previous_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
			previous_loading_state = previous_loading_raw if typeof(previous_loading_raw) == TYPE_DICTIONARY else {}
		var warm_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var warm_loading: Dictionary = warm_loading_raw if typeof(warm_loading_raw) == TYPE_DICTIONARY else {}
		warm_loading ["active"] = false
		warm_loading ["session_stage"] = "boot"
		warm_loading ["completion_state"] = "running"
		warm_loading ["is_complete"] = false
		warm_loading ["started_at_ms"] = int(Time.get_ticks_msec())
		warm_loading ["visible_started_at_ms"] = int(Time.get_ticks_msec())
		warm_loading ["headline"] = str(loading_context.get("headline", "Time is moving..."))
		warm_loading ["subline"] = str(loading_context.get("subline", "Simulating the next year..."))
		warm_loading ["dominant_domain"] = str(loading_context.get("dominant_domain", "general"))
		warm_loading ["overlay_context"] = loading_context.duplicate(true)
		warm_loading ["current_phase"] = str(warm_loading.get("current_phase", "overlay_entry"))
		warm_loading ["stall_score"] = float(warm_loading.get("stall_score", 0.0))
		gs.scenario_state ["loading_runtime"] = warm_loading
	var previous_visible: bool = age_up_loading_overlay.visible
	var previous_modulate: Color = age_up_loading_overlay.modulate
	age_up_loading_overlay.visible = true
	age_up_loading_overlay.modulate = Color(1.0, 1.0, 1.0, 0.0)
	set_meta("age_up_loading_visual_bucket", -1)
	_bring_modal_to_front(age_up_loading_overlay)
	_refresh_age_up_loading_text_from_state(true)
	_animate_age_up_loading_overlay(1.0 / 60.0)
	_animate_age_up_loading_overlay(1.0 / 60.0)
	_refresh_age_up_loading_eralife_logo_render(true)
	age_up_loading_overlay.visible = previous_visible
	age_up_loading_overlay.modulate = previous_modulate
	set_meta("age_up_loading_prewarm_signature", prewarm_signature)
	set_meta("age_up_loading_prewarm_ready", true)
	if restore_loading_state and gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if had_loading_state:
			gs.scenario_state ["loading_runtime"] = previous_loading_state
		else:
			gs.scenario_state.erase("loading_runtime")

func _begin_visible_age_up_runtime_from_button() -> void:
	_global_runtime_kill_release_for_player_age_up("begin_visible_age_up_runtime_from_button")
	_age_up_truth_probe_mark("begin_visible_enter")

	if gs == null:
		_age_up_truth_probe_finish("begin_visible_gs_null")
		set_meta("age_up_transition_busy", false)
		return

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_truth_probe_disable_auto_patcher"] = true
		gs.scenario_state ["age_up_truth_probe_disable_live_patch_guard"] = true
		gs.scenario_state ["runtime_guard"] = {
			"cooperative_age_up_runtime": true,
			"age_up_loading_pure_renderer": true,
			"visible_age_up_overlay_is_render_only": true,
			"preserve_runtime_systems": true,
			"allow_tail_phase_defer": true,
			"ui_tail_work_yield_to_input": true,
			"phase_budget_cap": 1,
			"commit_budget_cap": 3,
			"visible_runtime_commit_budget_cap": 3,
			"visible_runtime_snapshot_items_per_step": 2,
			"visible_runtime_frame_budget_ms": 4,
			"post_age_up_tail_flush_budget": 1,
			"post_age_up_tail_flush_interval_ms": 180,
			"post_age_up_tail_ui_stage_budget": 1,
			"control_release_priority": "ui_first",
			"budget_expansion_forbidden_while_visible": true
		}

	set_meta("age_up_truth_probe_disable_live_diagnostics", true)
	set_meta("age_up_truth_probe_disable_live_diagnostics_until_ms", int(Time.get_ticks_msec()) + 120000)
	set_meta("live_diagnostics_manual_throttle_enabled", true)
	live_diagnostics_force_frames = 0

	var first_visible_runtime_boot: bool = not bool(get_meta("age_up_loading_first_visible_runtime_started", false))
	var opening_quarantine_frames: int = 2
	var opening_quarantine_ms: int = 48
	var runtime_begin_delay_ms: int = 96
	var overlay_settle_frames: int = 2
	var overlay_settle_ms: int = 64
	var startup_soft_slice_frames: int = 2
	var startup_soft_slice_ms: int = 32
	var startup_soft_phase_budget_cap: int = 1
	var startup_soft_commit_budget_cap: int = 3
	var runtime_snapshot_items_per_step: int = 2
	var startup_soft_defer_before_snapshot_frames: int = 2
	var startup_soft_defer_before_snapshot_ms: int = 48

	var visible_source_year: int = int(gs.year)
	var visible_source_age: int = int(gs.player.age) if gs.player != null else -999999
	var visible_target_year: int = visible_source_year + 1
	var visible_target_age: int = visible_source_age + 1 if visible_source_age != -999999 else -999999

	var loading_context: Dictionary = _build_age_up_loading_context()
	loading_context ["visible_age_up_runtime_from_button"] = true
	loading_context ["age_up_button_user_initiated"] = true
	loading_context ["source"] = "age_up_button"
	loading_context ["source_year"] = visible_source_year
	loading_context ["source_age"] = visible_source_age
	loading_context ["target_year"] = visible_target_year
	loading_context ["target_age"] = visible_target_age
	loading_context ["visible_started_at_ms"] = int(Time.get_ticks_msec())
	loading_context ["first_visible_runtime_boot"] = first_visible_runtime_boot
	loading_context ["opening_quarantine_frames"] = opening_quarantine_frames
	loading_context ["opening_quarantine_ms"] = opening_quarantine_ms
	loading_context ["runtime_begin_delay_ms"] = runtime_begin_delay_ms
	loading_context ["overlay_settle_frames"] = overlay_settle_frames
	loading_context ["overlay_settle_ms"] = overlay_settle_ms
	loading_context ["startup_soft_slice_frames"] = startup_soft_slice_frames
	loading_context ["startup_soft_slice_ms"] = startup_soft_slice_ms
	loading_context ["startup_soft_phase_budget_cap"] = startup_soft_phase_budget_cap
	loading_context ["startup_soft_commit_budget_cap"] = startup_soft_commit_budget_cap
	loading_context ["runtime_frame_commit_budget_cap"] = startup_soft_commit_budget_cap
	loading_context ["runtime_snapshot_items_per_step"] = runtime_snapshot_items_per_step
	loading_context ["startup_soft_defer_before_snapshot"] = true
	loading_context ["startup_soft_defer_before_snapshot_frames"] = startup_soft_defer_before_snapshot_frames
	loading_context ["startup_soft_defer_before_snapshot_ms"] = startup_soft_defer_before_snapshot_ms
	loading_context ["cooperative_age_up_runtime"] = true
	loading_context ["ui_first_year_handoff"] = true
	loading_context ["age_up_loading_pure_renderer"] = true
	loading_context ["visible_age_up_overlay_is_render_only"] = true
	loading_context ["zero_frame_overlay_is_cosmetic"] = true
	loading_context ["budget_expansion_forbidden_while_visible"] = true
	loading_context ["runtime_phase_budget_cap"] = 0
	loading_context ["runtime_frame_commit_budget_cap"] = 0
	loading_context ["visible_runtime_commit_budget_cap"] = 0
	loading_context ["runtime_frame_budget_ms"] = 0
	loading_context ["visible_runtime_snapshot_items_per_step"] = 0
	loading_context ["defer_noncritical_tail_work"] = true
	loading_context ["bypass_opening_frame_quarantine"] = false
	loading_context ["bypass_overlay_settle_gate"] = false
	loading_context ["truth_probe_active"] = true
	loading_context ["force_target_theme_key"] = MainSceneLogic._resolve_age_up_loading_theme_key(gs, loading_context, loading_context)

	var zero_frame_result: Dictionary = {}
	if gs.life_engine != null:
		zero_frame_result = gs.life_engine.age_up()

	if not zero_frame_result.is_empty():
		loading_context ["zero_frame_age_up"] = bool(zero_frame_result.get("zero_frame_age_up", false))
		loading_context ["target_year"] = int(zero_frame_result.get("target_year", zero_frame_result.get("year", visible_target_year)))
		loading_context ["target_age"] = int(zero_frame_result.get("target_age", zero_frame_result.get("age", visible_target_age)))
		loading_context ["precompute_ready"] = bool(zero_frame_result.get("precompute_ready", false))
		loading_context ["runtime_tail_pending"] = bool(zero_frame_result.get("runtime_tail_pending", true))
		set_meta("age_up_loading_zero_frame_result", zero_frame_result.duplicate(true))
	else:
		set_meta("age_up_loading_zero_frame_result", {})

	set_meta("age_up_loading_locked_theme_key", str(loading_context.get("force_target_theme_key", "")).strip_edges().to_lower())
	set_meta("age_up_loading_locked_start_year", visible_source_year)
	set_meta("age_up_loading_locked_start_age", visible_source_age)
	set_meta("age_up_loading_locked_target_year", int(loading_context.get("target_year", visible_target_year)))
	set_meta("age_up_loading_ui_first_released", false)
	set_meta("age_up_loading_ui_first_release_reason", "")
	set_meta("age_up_loading_last_runtime_step_ms", 0)
	set_meta("age_up_loading_slow_runtime_frame_count", 0)
	set_meta("age_up_tail_background_allowed_after_ms", int(Time.get_ticks_msec()) + 1400)

	set_meta("live_diagnostics_hidden_refresh_next_ms", int(Time.get_ticks_msec()) + 120000)

	_age_up_truth_probe_mark("before_show_loading_overlay", {
		"first_visible_runtime_boot": first_visible_runtime_boot,
		"cooperative_age_up_runtime": true
	})
	set_meta("age_up_loading_prewarm_ready", false)
	set_meta("age_up_loading_deferred_begin_context", loading_context.duplicate(true))
	_show_age_up_loading_overlay()
	_age_up_truth_probe_mark("after_show_loading_overlay", {
		"visible_started_at_ms": age_up_loading_visible_started_ms
	})

	loading_context ["visible_started_at_ms"] = age_up_loading_visible_started_ms
	set_meta("age_up_loading_deferred_begin_context", loading_context.duplicate(true))
	set_meta("age_up_loading_first_visible_runtime_started", true)

	var stored_zero_frame_result: Dictionary = _zero_frame_age_up_cosmetic_result()
	if not stored_zero_frame_result.is_empty():
		set_meta("age_up_loading_runtime_begin_pending", false)
		set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
		set_meta("age_up_loading_cosmetic_finish_pending", true)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
			var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
			loading ["completion_state"] = "running"
			loading ["is_complete"] = false
			loading ["current_phase"] = "cosmetic_age_up_overlay"
			loading ["session_stage"] = "cinema"
			loading ["subline"] = "Lives are unfolding..."
			loading ["final_result"] = stored_zero_frame_result.duplicate(true)
			loading ["resolved_result"] = stored_zero_frame_result.duplicate(true)
			loading ["zero_frame_age_up"] = true
			loading ["overlay_is_cosmetic"] = true
			gs.scenario_state ["loading_runtime"] = loading

		_age_up_truth_probe_mark("zero_frame_cosmetic_overlay_armed", {
			"target_year": int(stored_zero_frame_result.get("target_year", stored_zero_frame_result.get("year", -1))),
			"target_age": int(stored_zero_frame_result.get("target_age", stored_zero_frame_result.get("age", -1)))
		})
		return

	set_meta("age_up_loading_runtime_begin_pending", true)
	set_meta("age_up_loading_runtime_begin_earliest_ms", age_up_loading_visible_started_ms + runtime_begin_delay_ms)

	_age_up_truth_probe_mark("runtime_begin_pending_set", {
		"earliest_begin_ms": age_up_loading_visible_started_ms + runtime_begin_delay_ms
	})


func _begin_visible_age_up_runtime_after_overlay_paint() -> void:
	_age_up_truth_probe_mark("begin_after_overlay_paint_enter", {
		"pending": bool(get_meta("age_up_loading_runtime_begin_pending", false))
	})

	if not bool(get_meta("age_up_loading_runtime_begin_pending", false)):
		_age_up_truth_probe_mark("begin_after_overlay_paint_return_not_pending")
		return

	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)

	var loading_context_raw: Variant = get_meta("age_up_loading_deferred_begin_context", {})
	var loading_context: Dictionary = loading_context_raw if typeof(loading_context_raw) == TYPE_DICTIONARY else _build_age_up_loading_context()

	var now_ms: int = int(Time.get_ticks_msec())
	var visible_started_at_ms: int = int(loading_context.get("visible_started_at_ms", age_up_loading_visible_started_ms))
	var begin_wait_started_ms: int = int(get_meta("age_up_loading_runtime_begin_wait_started_ms", 0))
	if begin_wait_started_ms <= 0 or (visible_started_at_ms > 0 and begin_wait_started_ms < visible_started_at_ms):
		begin_wait_started_ms = now_ms
	set_meta("age_up_loading_runtime_begin_wait_started_ms", begin_wait_started_ms)

	var begin_retry_count: int = int(get_meta("age_up_loading_runtime_begin_retry_count", 0)) + 1
	set_meta("age_up_loading_runtime_begin_retry_count", begin_retry_count)

	var begin_wait_elapsed_ms: int = max(0, now_ms - begin_wait_started_ms)
	var bypass_opening_frame_quarantine: bool = bool(loading_context.get("bypass_opening_frame_quarantine", false))
	var diagnostics_preview_expanded: bool = bool(get_meta("live_diagnostics_fix_preview_expanded", false))
	var diagnostics_visible: bool = live_diagnostics_panel != null and is_instance_valid(live_diagnostics_panel) and live_diagnostics_panel.visible
	var should_honor_opening_quarantine: bool = diagnostics_preview_expanded or diagnostics_visible

	if should_honor_opening_quarantine and not bypass_opening_frame_quarantine and _live_diagnostics_opening_frame_quarantine_active():
		_age_up_truth_probe_mark("opening_quarantine_blocked_begin", {
			"begin_wait_elapsed_ms": begin_wait_elapsed_ms,
			"begin_retry_count": begin_retry_count,
			"diagnostics_preview_expanded": diagnostics_preview_expanded,
			"diagnostics_visible": diagnostics_visible
		})

		if begin_wait_elapsed_ms >= 48 or begin_retry_count >= 4:
			loading_context ["bypass_opening_frame_quarantine"] = true
			set_meta("age_up_loading_deferred_begin_context", loading_context.duplicate(true))
		else:
			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
				var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
				loading ["completion_state"] = "running"
				loading ["is_complete"] = false
				loading ["current_phase"] = "overlay_entry"
				loading ["session_stage"] = "boot"
				loading ["subline"] = "Preparing the year..."
				gs.scenario_state ["loading_runtime"] = loading
				loading_context ["age_up_live_slice_streaming_enabled"] = true
				loading_context ["headline"] = "Time is moving..."
				loading_context ["subline"] = "Streaming reality slices into next year..."
				loading_context ["dominant_domain"] = "temporal_slice_streaming"
			set_meta("age_up_loading_runtime_begin_pending", true)
			set_meta("age_up_loading_runtime_begin_earliest_ms", now_ms + 4)
			return

	set_meta("age_up_loading_runtime_begin_wait_started_ms", 0)
	set_meta("age_up_loading_runtime_begin_retry_count", 0)
	set_meta("age_up_loading_runtime_overlay_settle_frames_remaining", -1)
	set_meta("age_up_loading_runtime_overlay_settle_until_ms", 0)

	if gs == null or gs.life_engine == null:
		_age_up_truth_probe_mark("begin_visible_session_missing_life_engine")
		set_meta("age_up_loading_deferred_begin_context", {})
		_request_age_up_loading_finish({})
		return

	var zero_frame_result: Dictionary = _zero_frame_age_up_cosmetic_result()
	if not zero_frame_result.is_empty():
		_age_up_truth_probe_mark("begin_visible_session_blocked_by_zero_frame_cosmetic_overlay", {
			"target_year": int(zero_frame_result.get("target_year", zero_frame_result.get("year", -1))),
			"target_age": int(zero_frame_result.get("target_age", zero_frame_result.get("age", -1)))
		})
		set_meta("age_up_loading_deferred_begin_context", {})
		set_meta("age_up_loading_runtime_begin_pending", false)
		set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
		set_meta("age_up_loading_cosmetic_finish_pending", true)
		return

	set_meta("age_up_loading_deferred_begin_context", {})

	_age_up_truth_probe_mark("before_begin_visible_session", {
		"loading_context_keys": loading_context.keys()
	})
	var begin_call_started_ms: int = int(Time.get_ticks_msec())
	var begin_result: Dictionary = gs.life_engine.begin_visible_age_up_runtime_session(loading_context)
	var begin_call_ms: int = int(Time.get_ticks_msec()) - begin_call_started_ms
	_age_up_truth_probe_mark("after_begin_visible_session", {
		"call_ms": begin_call_ms,
		"is_complete": bool(begin_result.get("is_complete", false)),
		"result_empty": typeof(begin_result.get("result", {})) != TYPE_DICTIONARY or (begin_result.get("result", {}) as Dictionary).is_empty()
	})

	set_meta("age_up_loading_begin_refresh_pending", true)

	if bool(begin_result.get("is_complete", false)):
		_age_up_truth_probe_mark("begin_visible_session_completed_immediately")
		_request_age_up_loading_finish(begin_result.get("result", {}))


func _drive_age_up_loading_runtime(delta: float) -> void:
	if not age_up_loading_runtime_active:
		_age_up_truth_probe_mark_throttled("drive_return_not_active", {}, 500)
		return

	_age_up_truth_probe_mark_throttled("drive_enter", {
		"delta": delta
	}, 500)

	_animate_age_up_loading_overlay(delta)
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var watchdog_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var watchdog_loading: Dictionary = watchdog_loading_raw if typeof(watchdog_loading_raw) == TYPE_DICTIONARY else {}
		var watchdog_visible_started_at_ms: int = int(watchdog_loading.get("visible_started_at_ms", watchdog_loading.get("started_at_ms", 0)))
		if watchdog_visible_started_at_ms > 0:
			var watchdog_visible_elapsed_ms: int = max(0, int(Time.get_ticks_msec()) - watchdog_visible_started_at_ms)
			var watchdog_force_complete_ms: int = 8200
			if gs.game_state_contract_engine != null and gs.game_state_contract_engine.has_method("get_runtime_phase_scheduler_context"):
				var watchdog_scheduler: Dictionary = gs.game_state_contract_engine.get_runtime_phase_scheduler_context({
					"runtime_kind": "age_up",
					"force_complete_ms": watchdog_force_complete_ms
				})
				watchdog_force_complete_ms = int(watchdog_scheduler.get("force_complete_ms", watchdog_force_complete_ms))

			if watchdog_visible_elapsed_ms >= watchdog_force_complete_ms and not bool(watchdog_loading.get("is_complete", false)):
				_age_up_truth_probe_mark("AGEUP_WATCHDOG_FORCE_RESOLVE", {
					"visible_elapsed_ms": watchdog_visible_elapsed_ms,
					"force_complete_ms": watchdog_force_complete_ms,
					"current_phase": str(watchdog_loading.get("current_phase", "")),
					"completion_state": str(watchdog_loading.get("completion_state", "")),
					"year_in_progress": bool(gs.scenario_state.get("year_in_progress", false)),
					"bundle_built": bool(gs.scenario_state.get("bundle_built", false))
				})

				if gs.life_engine != null and gs.life_engine.has_method("_resolve_current_year_after_tick"):
					var watchdog_recovered_result: Dictionary = gs.life_engine._resolve_current_year_after_tick()
					_request_age_up_loading_finish(watchdog_recovered_result)
					return

	if age_up_loading_paint_hold_frames > 0:
		_age_up_truth_probe_mark_throttled("paint_hold_wait", {
			"frames": age_up_loading_paint_hold_frames
		}, 250)
		age_up_loading_paint_hold_frames -= 1
		return

	var visible_elapsed_ms: int = int(Time.get_ticks_msec() - age_up_loading_visible_started_ms)
	var zero_frame_result: Dictionary = _zero_frame_age_up_cosmetic_result()
	if not zero_frame_result.is_empty() and not age_up_loading_finish_requested:
		var cosmetic_min_visible_ms: int = max(120, AGE_UP_LOADING_MIN_VISIBLE_MS)
		if visible_elapsed_ms < cosmetic_min_visible_ms:
			_age_up_truth_probe_mark_throttled("zero_frame_cosmetic_overlay_waiting_for_min_visible", {
				"visible_elapsed_ms": visible_elapsed_ms,
				"min_visible_ms": cosmetic_min_visible_ms
			}, 250)
			return

		_age_up_truth_probe_mark("zero_frame_cosmetic_overlay_finish_requested", {
			"visible_elapsed_ms": visible_elapsed_ms,
			"target_year": int(zero_frame_result.get("target_year", zero_frame_result.get("year", -1))),
			"target_age": int(zero_frame_result.get("target_age", zero_frame_result.get("age", -1)))
		})
		_request_zero_frame_age_up_cosmetic_finish(zero_frame_result)
		return

	if bool(get_meta("age_up_loading_runtime_begin_pending", false)):
		var earliest_begin_ms: int = int(get_meta("age_up_loading_runtime_begin_earliest_ms", 0))
		var now_ms_for_begin: int = int(Time.get_ticks_msec())
		if earliest_begin_ms > 0 and now_ms_for_begin < earliest_begin_ms:
			_age_up_truth_probe_mark_throttled("runtime_begin_waiting_for_earliest_ms", {
				"earliest_begin_ms": earliest_begin_ms,
				"now_ms": now_ms_for_begin
			}, 250)
			return

		_age_up_truth_probe_mark("before_begin_after_overlay_paint")
		_begin_visible_age_up_runtime_after_overlay_paint()
		_age_up_truth_probe_mark("after_begin_after_overlay_paint")
		return
	if age_up_loading_finish_requested:
		_age_up_truth_probe_mark_throttled("finish_requested_branch", {
			"safe_handoff_built": bool(get_meta("age_up_loading_safe_handoff_built", false)),
			"safe_handoff_queued": bool(get_meta("age_up_loading_safe_handoff_queued", false))
		}, 500)

		var loading_safe_handoff_built: bool = bool(get_meta("age_up_loading_safe_handoff_built", false))
		var _loading_safe_handoff_queued: bool = bool(get_meta("age_up_loading_safe_handoff_queued", false))
		var _rewind_pending: bool = bool(get_meta("post_age_up_rewind_snapshot_pending", false))
		var rewind_pipeline_active: bool = bool(get_meta("post_age_up_rewind_snapshot_pipeline_active", false))
		if gs != null and gs.has_method("has_pending_rewind_snapshot_pipeline"):
			rewind_pipeline_active = rewind_pipeline_active or bool(gs.has_pending_rewind_snapshot_pipeline())
		set_meta("post_age_up_rewind_snapshot_pipeline_active", rewind_pipeline_active)

		var finish_wait_started_ms: int = int(get_meta("age_up_loading_finish_wait_started_ms", 0))
		if finish_wait_started_ms <= 0 or finish_wait_started_ms < int(age_up_loading_visible_started_ms):
			finish_wait_started_ms = int(Time.get_ticks_msec())
			set_meta("age_up_loading_finish_wait_started_ms", finish_wait_started_ms)
		var finish_wait_elapsed_ms: int = max(0, int(Time.get_ticks_msec()) - finish_wait_started_ms)

		if not loading_safe_handoff_built:
			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				var handoff_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
				var handoff_loading: Dictionary = handoff_loading_raw if typeof(handoff_loading_raw) == TYPE_DICTIONARY else {}
				handoff_loading ["completion_state"] = "running"
				handoff_loading ["is_complete"] = false
				handoff_loading ["current_phase"] = "narrative_and_presentation"
				handoff_loading ["session_stage"] = "settling_current_year"
				handoff_loading ["subline"] = "Finalizing the year-turn handoff..."
				gs.scenario_state ["loading_runtime"] = handoff_loading

			_refresh_age_up_loading_text_from_state(false)

			var output_pipeline_raw: Variant = get_meta("age_up_loading_output_pipeline", {})
			var output_pipeline: Dictionary = output_pipeline_raw if typeof(output_pipeline_raw) == TYPE_DICTIONARY else {}
			var handoff_attempts: int = int(get_meta("age_up_loading_safe_handoff_attempts", 0))

			if output_pipeline.is_empty() and finish_wait_elapsed_ms >= 80 and not bool(get_meta("age_up_loading_safe_handoff_rekick_requested", false)):
				set_meta("age_up_loading_safe_handoff_rekick_requested", true)
				set_meta("age_up_loading_safe_handoff_attempts", handoff_attempts + 1)
				_deferred_show_loading_safe_age_up_output(age_up_loading_result.duplicate(true))

			if finish_wait_elapsed_ms >= 900 or handoff_attempts >= 8:
				_force_age_up_loading_safe_handoff_fallback("safe_handoff_timeout")
				return

			if age_up_loading_exit_tween == null and visible_elapsed_ms >= max(120, AGE_UP_LOADING_MIN_VISIBLE_MS) and finish_wait_elapsed_ms >= 320:
				_begin_age_up_loading_exit_tween()

			return

		set_meta("age_up_loading_finish_wait_started_ms", 0)
		set_meta("age_up_loading_safe_handoff_rekick_requested", false)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var completed_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
			var completed_loading: Dictionary = completed_loading_raw if typeof(completed_loading_raw) == TYPE_DICTIONARY else {}
			completed_loading ["completion_state"] = "complete"
			completed_loading ["is_complete"] = true
			completed_loading ["current_phase"] = "complete"
			completed_loading ["session_stage"] = "complete"
			completed_loading ["final_result"] = age_up_loading_result.duplicate(true)
			gs.scenario_state ["loading_runtime"] = completed_loading
		_refresh_age_up_loading_text_from_state(false)


		age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 2)
		if age_up_loading_exit_tween == null and visible_elapsed_ms >= AGE_UP_LOADING_MIN_VISIBLE_MS:
			_begin_age_up_loading_exit_tween()
		if age_up_loading_overlay == null or not age_up_loading_overlay.visible:
			_on_age_up_loading_exit_finished()
			return
		if age_up_loading_exit_tween != null:
			var exit_elapsed_ms: int = 0
			if age_up_loading_exit_started_ms > 0:
				exit_elapsed_ms = int(Time.get_ticks_msec() - age_up_loading_exit_started_ms)
			if age_up_loading_overlay.modulate.a <= 0.02 or exit_elapsed_ms >= 900:
				_on_age_up_loading_exit_finished()
		return
	if age_up_loading_exit_tween != null:
		var exit_elapsed_ms: int = 0
		if age_up_loading_exit_started_ms > 0:
			exit_elapsed_ms = int(Time.get_ticks_msec() - age_up_loading_exit_started_ms)
		if age_up_loading_overlay.modulate.a <= 0.02 or exit_elapsed_ms >= 900:
			_on_age_up_loading_exit_finished()
		return
	if gs == null:
		_request_age_up_loading_finish({})
		return
	var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
	var current_phase: String = str(loading.get("current_phase", "preflight"))
	var completion_state: String = str(loading.get("completion_state", "running"))
	var loading_is_complete: bool = bool(loading.get("is_complete", false))
	var final_result_raw: Variant = loading.get("final_result", {})
	var final_result: Dictionary = final_result_raw if typeof(final_result_raw) == TYPE_DICTIONARY else {}
	var post_runtime_result_raw: Variant = gs.scenario_state.get("post_runtime_result", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var post_runtime_result: Dictionary = post_runtime_result_raw if typeof(post_runtime_result_raw) == TYPE_DICTIONARY else {}
	var stall_score: float = float(loading.get("stall_score", 0.0))
	var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
	if bool(guard.get("quarantine_popup_lane", false)):
		if activities_action_open:
			_hide_activities_action_panel()
		if standard_tab_popup_open:
			_hide_standard_tab_popup()
		if world_feed_popup_open:
			_hide_world_action_panel()
		if relationship_profile_popup_open:
			_hide_relationship_profile_popup()
	var heavy_runtime_phase: bool = current_phase in [
		"core_state_resolution",
		"internal_identity_drift",
		"year_budget_pipeline_commit",
		"choice_and_opportunity_surfacing",
		"narrative_and_presentation",
		"temporal_slice_streaming",
		"live_slice_stream",
		"year_and_era_mutation"
	]
	if current_phase in ["temporal_slice_streaming", "live_slice_stream", "year_and_era_mutation"] and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var temporal_loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var temporal_loading: Dictionary = temporal_loading_raw if typeof(temporal_loading_raw) == TYPE_DICTIONARY else {}
		if str(temporal_loading.get("subline", "")).strip_edges() == "":
			temporal_loading ["subline"] = "Streaming the next reality..."
			gs.scenario_state ["loading_runtime"] = temporal_loading
	var auto_stability_mode: bool = bool(guard.get("auto_stability_mode", false))
	var should_enter_auto_stability: bool = typeof(gs.scenario_state) == TYPE_DICTIONARY and (
		stall_score >= 60.0
		or (current_phase == "commit_settling" and visible_elapsed_ms >= 320)
		or (heavy_runtime_phase and stall_score >= 45.0 and visible_elapsed_ms >= 750)
	)
	if should_enter_auto_stability and not auto_stability_mode:
		var escalated_guard: Dictionary = guard.duplicate(true)
		escalated_guard ["auto_stability_mode"] = true
		escalated_guard ["cooperative_age_up_runtime"] = true
		escalated_guard ["preserve_runtime_systems"] = true
		escalated_guard ["allow_tail_phase_defer"] = false
		escalated_guard ["phase_budget_floor"] = 3
		escalated_guard ["commit_budget_floor"] = 40
		escalated_guard ["stall_recovery_threshold"] = 24.0
		escalated_guard ["applies_to_year"] = int(gs.year)
		escalated_guard ["last_auto_stability_ms"] = int(Time.get_ticks_msec())
		escalated_guard.erase("compressed_execution_current_year")
		escalated_guard.erase("reduce_scenario_density")
		escalated_guard.erase("defer_noncritical_systems")
		escalated_guard.erase("fallback_cached_ui")
		escalated_guard.erase("phase_budget_cap")
		escalated_guard.erase("commit_budget_cap")
		gs.scenario_state ["runtime_guard"] = escalated_guard
		guard = escalated_guard
		auto_stability_mode = true

	var should_throttle_live_diagnostics: bool = true
	if not heavy_runtime_phase and not auto_stability_mode and not bool(guard.get("compressed_execution_current_year", false)) and stall_score < 45.0:
		should_throttle_live_diagnostics = false
	set_meta("live_diagnostics_manual_throttle_enabled", should_throttle_live_diagnostics)

	if loading_is_complete or completion_state == "complete" or current_phase == "complete":
		var completion_result: Dictionary = final_result.duplicate(true)
		if completion_result.is_empty() and not post_runtime_result.is_empty():
			completion_result = post_runtime_result.duplicate(true)
		if completion_result.is_empty():
			var recovery_commit_budget: int = max(1, int(guard.get("commit_budget_cap", 4)))
			var recovery_step: Dictionary = gs.life_engine.step_visible_age_up_runtime_session(1, recovery_commit_budget)
			_refresh_age_up_loading_text_from_state(false)
			if bool(recovery_step.get("is_complete", false)):
				var recovery_step_raw: Variant = recovery_step.get("result", {})
				var recovery_result: Dictionary = recovery_step_raw if typeof(recovery_step_raw) == TYPE_DICTIONARY else {}
				if recovery_result.is_empty() and not post_runtime_result.is_empty():
					recovery_result = post_runtime_result.duplicate(true)
				completion_result = recovery_result
		if completion_result.is_empty() and (bool(gs.scenario_state.get("year_in_progress", false)) or bool(gs.scenario_state.get("bundle_built", false))):
			_age_up_truth_probe_mark_throttled("completion_empty_waiting_on_flags", {
				"year_in_progress": bool(gs.scenario_state.get("year_in_progress", false)),
				"bundle_built": bool(gs.scenario_state.get("bundle_built", false)),
				"current_phase": current_phase,
				"completion_state": completion_state
			}, 500)
			return
		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			if auto_stability_mode or bool(guard.get("compressed_execution_current_year", false)):
				var post_loading_guard: Dictionary = guard.duplicate(true)
				post_loading_guard ["post_loading_auto_stability"] = true
				post_loading_guard ["defer_refresh_once"] = true
				post_loading_guard ["fallback_cached_ui"] = true
				post_loading_guard ["control_release_priority"] = "ui_first"
				post_loading_guard ["last_action"] = "compress_execution_current_year"
				post_loading_guard ["last_action_ms"] = int(Time.get_ticks_msec())
				gs.scenario_state ["runtime_guard"] = post_loading_guard
			else:
				gs.scenario_state ["runtime_guard"] = {}
		_request_age_up_loading_finish(completion_result)
		return

	if (bool(guard.get("compressed_execution_current_year", false)) or auto_stability_mode) \
and not heavy_runtime_phase \
and stall_score < float(guard.get("stall_recovery_threshold", 48.0)) \
and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var softened_guard: Dictionary = guard.duplicate(true)
		softened_guard.erase("compressed_execution_current_year")
		softened_guard.erase("auto_stability_mode")
		softened_guard.erase("reduce_scenario_density")
		softened_guard.erase("defer_noncritical_systems")
		softened_guard.erase("phase_budget_cap")
		softened_guard.erase("commit_budget_cap")
		softened_guard.erase("control_release_priority")
		softened_guard.erase("stall_recovery_threshold")
		softened_guard.erase("applies_to_year")
		softened_guard.erase("last_auto_stability_ms")
		if softened_guard.is_empty():
			gs.scenario_state ["runtime_guard"] = {}
			guard = {}
		else:
			gs.scenario_state ["runtime_guard"] = softened_guard
			guard = softened_guard
			auto_stability_mode = bool(guard.get("auto_stability_mode", false))

	var phase_budget: int = 1
	var commit_budget: int = 6
	var loading_session_stage: String = str(loading.get("session_stage", "boot"))

	if current_phase == "commit_settling":
		phase_budget = 1
		commit_budget = 8
	elif loading_session_stage in ["settling_previous_year", "settling_current_year"]:
		phase_budget = 1
		commit_budget = 8
	elif current_phase in [
		"core_state_resolution",
		"internal_identity_drift",
		"year_budget_pipeline_commit"
	]:
		phase_budget = 1
		commit_budget = 7
	elif current_phase in [
		"player_phase_contract",
		"choice_and_opportunity_surfacing",
		"narrative_and_presentation"
	]:
		phase_budget = 1
		commit_budget = 6

	if current_phase != "commit_settling":
		if stall_score >= 90.0:
			phase_budget = max(phase_budget, 3)
			commit_budget = max(commit_budget, 48)
		elif stall_score >= 60.0:
			phase_budget = max(phase_budget, 3)
			commit_budget = max(commit_budget, 40)
		elif stall_score >= 45.0 and heavy_runtime_phase:
			phase_budget = max(phase_budget, 2)
			commit_budget = max(commit_budget, 32)

	if bool(guard.get("cooperative_age_up_runtime", false)) or auto_stability_mode:
		phase_budget = min(
			max(phase_budget, max(1, int(guard.get("phase_budget_floor", 1)))),
			max(1, int(guard.get("phase_budget_cap", 2)))
		)
		commit_budget = min(
			max(commit_budget, max(8, int(guard.get("commit_budget_floor", 8)))),
			max(8, int(guard.get("commit_budget_cap", 14)))
		)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY and bool(guard.get("defer_noncritical_systems", false)):
		var no_defer_guard: Dictionary = guard.duplicate(true)
		no_defer_guard.erase("defer_noncritical_systems")
		no_defer_guard.erase("reduce_scenario_density")
		no_defer_guard.erase("fallback_cached_ui")
		no_defer_guard ["preserve_runtime_systems"] = true
		no_defer_guard ["allow_tail_phase_defer"] = false
		gs.scenario_state ["runtime_guard"] = no_defer_guard
		guard = no_defer_guard

	if _should_release_age_up_loading_ui_first(current_phase, loading_session_stage, visible_elapsed_ms):
		_force_age_up_loading_ui_first_release("visible_year_landed_before_heavy_phase", current_phase)
		return
	if not _age_up_loading_runtime_step_due(current_phase, loading_session_stage, visible_elapsed_ms):
		_refresh_age_up_loading_text_from_state(false)
		return

	var ui_budget_contract: Dictionary = _age_up_loading_ui_runtime_budget_contract(
		current_phase,
		loading_session_stage,
		visible_elapsed_ms,
		phase_budget,
		commit_budget
	)
	phase_budget = int(ui_budget_contract.get("phase_budget", phase_budget))
	commit_budget = int(ui_budget_contract.get("commit_budget", commit_budget))
	_age_up_truth_probe_mark("before_runtime_step", {
		"current_phase": current_phase,
		"loading_session_stage": loading_session_stage,
		"phase_budget": phase_budget,
		"commit_budget": commit_budget,
		"stall_score": stall_score,
		"auto_stability_mode": auto_stability_mode,
		"compressed_execution": bool(guard.get("compressed_execution_current_year", false))
	})

	var previous_runtime_step_ms: int = int(get_meta("age_up_loading_last_runtime_step_ms", 0))
	if previous_runtime_step_ms >= 18:
		phase_budget = min(phase_budget, 1)
		commit_budget = min(commit_budget, 8)
	elif previous_runtime_step_ms >= 10:
		phase_budget = min(phase_budget, 2)
		commit_budget = min(commit_budget, 12)

	var runtime_step_started_ms: int = int(Time.get_ticks_msec())
	var step_result: Dictionary = gs.life_engine.step_visible_age_up_runtime_session(phase_budget, commit_budget)
	var runtime_step_ms: int = int(Time.get_ticks_msec()) - runtime_step_started_ms
	set_meta("age_up_loading_last_runtime_step_ms", runtime_step_ms)

	if runtime_step_ms >= 18:
		set_meta("age_up_loading_slow_runtime_frame_count", int(get_meta("age_up_loading_slow_runtime_frame_count", 0)) + 1)
		set_meta("age_up_loading_runtime_begin_earliest_ms", int(Time.get_ticks_msec()) + 16)
	else:
		set_meta("age_up_loading_slow_runtime_frame_count", 0)

	_age_up_truth_probe_mark("after_runtime_step", {
		"call_ms": runtime_step_ms,
		"is_complete": bool(step_result.get("is_complete", false)),
		"state": str(step_result.get("state", "")),
		"current_phase": current_phase,
		"phase_budget": phase_budget,
		"commit_budget": commit_budget
	})
	var force_ui_commit_release: bool = false
	if current_phase == "commit_settling" and loading_session_stage == "settling_current_year":
		if visible_elapsed_ms >= 2200 and not bool(gs.scenario_state.get("year_in_progress", false)) and not bool(gs.scenario_state.get("bundle_built", false)):
			force_ui_commit_release = true

	if force_ui_commit_release and not bool(step_result.get("is_complete", false)):
		_age_up_truth_probe_mark("ui_force_commit_settle_release", {
			"visible_elapsed_ms": visible_elapsed_ms,
			"pending_deferred": gs.event_bus.get_pending_deferred_delivery_count() if gs.event_bus != null and gs.event_bus.has_method("get_pending_deferred_delivery_count") else -1,
			"runtime_guard_keys": guard.keys()
		})

		var forced_result_raw: Variant = gs.scenario_state.get("post_runtime_result", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
		var forced_result: Dictionary = forced_result_raw if typeof(forced_result_raw) == TYPE_DICTIONARY else {}
		if forced_result.is_empty():
			forced_result = {
				"type": "year_passed",
				"text": "Another year passed.",
				"opps": []
			}

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["runtime_guard"] = {}
			var loading_force_raw: Variant = gs.scenario_state.get("loading_runtime", {})
			var loading_force: Dictionary = loading_force_raw if typeof(loading_force_raw) == TYPE_DICTIONARY else {}
			loading_force ["completion_state"] = "complete"
			loading_force ["is_complete"] = true
			loading_force ["current_phase"] = "complete"
			loading_force ["session_stage"] = "complete"
			loading_force ["final_result"] = forced_result.duplicate(true)
			loading_force ["resolved_result"] = forced_result.duplicate(true)
			gs.scenario_state ["loading_runtime"] = loading_force
			gs.scenario_state ["age_up_deferred_flush_pending"] = true
			gs.scenario_state ["age_up_deferred_flush_next_ms"] = 0

		_request_age_up_loading_finish(forced_result)
		return
	_refresh_age_up_loading_text_from_state(false)

	if bool(step_result.get("is_complete", false)):
		_age_up_truth_probe_mark("runtime_step_complete", {
			"call_ms": runtime_step_ms
		})
		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			if auto_stability_mode or bool(guard.get("compressed_execution_current_year", false)):
				var final_guard: Dictionary = guard.duplicate(true)
				final_guard ["post_loading_auto_stability"] = true
				final_guard ["defer_refresh_once"] = true
				final_guard ["fallback_cached_ui"] = true
				final_guard ["control_release_priority"] = "ui_first"
				final_guard ["last_action"] = "compress_execution_current_year"
				final_guard ["last_action_ms"] = int(Time.get_ticks_msec())
				gs.scenario_state ["runtime_guard"] = final_guard
			else:
				gs.scenario_state ["runtime_guard"] = {}

		var step_result_raw: Variant = step_result.get("result", {})
		var resolved_result: Dictionary = step_result_raw if typeof(step_result_raw) == TYPE_DICTIONARY else final_result
		if resolved_result.is_empty() and not post_runtime_result.is_empty():
			resolved_result = post_runtime_result.duplicate(true)
		if resolved_result.is_empty() and (bool(gs.scenario_state.get("year_in_progress", false)) or bool(gs.scenario_state.get("bundle_built", false))):
			_age_up_truth_probe_mark_throttled("resolved_result_empty_waiting_on_flags", {
				"year_in_progress": bool(gs.scenario_state.get("year_in_progress", false)),
				"bundle_built": bool(gs.scenario_state.get("bundle_built", false))
			}, 500)
			return

		_age_up_truth_probe_mark("before_request_finish_from_step_complete")
		_request_age_up_loading_finish(resolved_result)
func _drive_age_up_deferred_flush_if_idle(
	now_ms: int
) -> bool:
	if (
		gs == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return false

	if not bool(
		gs.scenario_state.get(
			"age_up_deferred_flush_pending",
			false
		)
	):
		return false







	gs.scenario_state [
		"age_up_deferred_flush_pending"
	] = false

	gs.scenario_state.erase(
		"age_up_deferred_flush_next_ms"
	)

	gs.scenario_state.erase(
		"age_up_deferred_flush_started_ms"
	)

	gs.scenario_state.erase(
		"age_up_deferred_flush_last_pending_count"
	)

	set_meta(
		"age_up_legacy_idle_flush_retired_at_ms",
		now_ms
	)

	set_meta(
		"age_up_event_bus_autonomous_service_required",
		true
	)

	return false
func _ensure_live_diagnostics_panel() -> void:
	if live_diagnostics_panel != null and is_instance_valid(live_diagnostics_panel):
		if live_diagnostics_panel.has_signal("view_fix_requested") and not live_diagnostics_panel.view_fix_requested.is_connected(Callable(self, "_on_live_diagnostics_view_fix_requested")):
			live_diagnostics_panel.view_fix_requested.connect(Callable(self, "_on_live_diagnostics_view_fix_requested"))
		if live_diagnostics_panel.has_signal("apply_patch_requested") and not live_diagnostics_panel.apply_patch_requested.is_connected(Callable(self, "_on_live_diagnostics_apply_patch_requested")):
			live_diagnostics_panel.apply_patch_requested.connect(Callable(self, "_on_live_diagnostics_apply_patch_requested"))
		live_diagnostics_panel.visible = false
		return
	live_diagnostics_panel = LiveDiagnosticsPanel.new()
	add_child(live_diagnostics_panel)
	live_diagnostics_panel.visible = false
	if live_diagnostics_panel.has_signal("view_fix_requested") and not live_diagnostics_panel.view_fix_requested.is_connected(Callable(self, "_on_live_diagnostics_view_fix_requested")):
		live_diagnostics_panel.view_fix_requested.connect(Callable(self, "_on_live_diagnostics_view_fix_requested"))
	if live_diagnostics_panel.has_signal("apply_patch_requested") and not live_diagnostics_panel.apply_patch_requested.is_connected(Callable(self, "_on_live_diagnostics_apply_patch_requested")): live_diagnostics_panel.apply_patch_requested.connect(Callable(self, "_on_live_diagnostics_apply_patch_requested"))
	if live_diagnostics_panel.has_method("set_snapshot"):
		live_diagnostics_panel.set_snapshot(
		{
		"state_label": "BOOT",
		"current_panel": current_panel,
		"current_phase": "startup_intro",
		"session_stage": "boot",
		"popup_stack": [],
		"popup_count": 0,
		"loading_active": false,
		"transition_active": false
		},
		[]
		)

func _register_live_diagnostics_ui_contract() -> void:
	if gs == null or gs.runtime_health_registry == null:
		return
	gs.runtime_health_registry.register_contract(
		"ui.main_scene.surface_runtime",
		{
			"engine_id": "ui.main_scene.surface_runtime",
			"phase_affinity": "presentation_shell",
			"lane_affinity": "ui",
			"method_name": "_refresh_live_diagnostics_panel",
			"fault_source_function": "_process",
			"fault_source_engine": "MainScene.gd",
			"observer_only": true,
			"phase_owner_hints": {
				"core_state_resolution": "AgeUpRuntimeEngine.gd::_execute_registered_phase_bridge",
				"internal_identity_drift": "AgeUpRuntimeEngine.gd::_execute_registered_phase_bridge",
				"data_defined_simulation_laws": "AgeUpRuntimeEngine.gd::_run_data_defined_simulation_laws",
				"year_budget_pipeline_commit": "AgeUpRuntimeEngine.gd::_drive_age_up_loading_runtime",
				"player_phase_contract": "AgeUpRuntimeEngine.gd::_run_player_phase_contract",
				"choice_and_opportunity_surfacing": "AgeUpRuntimeEngine.gd::_execute_registered_phase_bridge",
				"narrative_and_presentation": "AgeUpRuntimeEngine.gd::_execute_registered_phase_bridge"
			},
			"auto_patch_family": "ui_frame_budget",
			"required_inputs": ["current_panel", "popup_stack", "loading_runtime"],
			"forbidden_states": ["stale_transition_flag", "duplicate_popup_loop"],
			"mailboxes_read": ["scenario", "popups", "delta_packets"],
			"mailboxes_write": [],
			"ui_surfaces_touched": [
				"life_diary",
				"player_stats_overlay",
				"relationships_browser",
				"standard_tab_popup",
				"world_feed_popup",
				"age_up_loading_overlay",
				"live_diagnostics_panel"
			],
			"can_defer": true,
			"can_compress": false,
			"can_quarantine": true,
			"health_checks": [
				"frame_spike",
				"stuck_transition",
				"duplicate_popup_loop",
				"loading_safe_refresh_leak"
			]
		}
	)

func _collect_live_popup_stack() -> Array:
	var out: Array = []
	if career_coworkers_popup_open:
		out.append("career_coworkers")
	if action_result_popup_open:
		out.append("action_result")
	if activities_action_open:
		out.append("activities_action")
	if institution_hub_overlay != null and is_instance_valid(institution_hub_overlay) and institution_hub_overlay.visible:
		out.append("institution_hub")
	if relationships_browser_open:
		out.append("relationships_browser")
	if relationship_profile_popup_open:
		out.append("relationship_profile")
	if standard_tab_popup_open:
		out.append("standard_tab_popup")
	if world_feed_popup_open:
		out.append("world_feed_popup")
	if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
		out.append("profile_panel_popup")
	if player_line_birth_naming_popup != null and is_instance_valid(player_line_birth_naming_popup) and player_line_birth_naming_popup.visible:
		out.append("player_line_birth")
	if crown_hub_overlay != null and is_instance_valid(crown_hub_overlay) and crown_hub_overlay.visible:
		out.append("crown_hub")
	if crown_action_popup != null and is_instance_valid(crown_action_popup) and crown_action_popup.visible:
		out.append("crown_action_popup")
	if age_up_loading_runtime_active:
		out.append("age_up_loading")
	return out

func _collect_live_diagnostics_snapshot() -> Dictionary:
	var popup_stack: Array = _collect_live_popup_stack()

	var loading_raw: Variant = {}
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		loading_raw = gs.scenario_state.get("loading_runtime", {})
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

	var guard_raw: Variant = {}
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		guard_raw = gs.scenario_state.get("runtime_guard", {})
	var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}

	var phase_order_raw: Variant = loading.get("phase_order", [])
	var phase_order: Array = phase_order_raw if typeof(phase_order_raw) == TYPE_ARRAY else []

	var deferred_raw: Variant = loading.get("deferred_jobs", [])
	var deferred_jobs: Array = deferred_raw if typeof(deferred_raw) == TYPE_ARRAY else []

	var budget_raw: Variant = loading.get("budget_consumption", {})
	var budget: Dictionary = budget_raw if typeof(budget_raw) == TYPE_DICTIONARY else {}

	var transition_surface_valid: bool = false
	if panel_content_transition_surface != null and is_instance_valid(panel_content_transition_surface):
		transition_surface_valid = true

	var state_label: String = "IDLE"
	if age_up_loading_runtime_active:
		state_label = "RUNTIME"
	elif not popup_stack.is_empty():
		state_label = "INTERACTIVE"
	elif gs == null or gs.runtime_health_registry == null:
		state_label = "BOOT"

	return {
		"state_label": state_label,
		"current_panel": current_panel,
		"popup_stack": popup_stack,
		"popup_count": popup_stack.size(),
		"transition_active": panel_content_transition_active,
		"transition_surface_valid": transition_surface_valid,
		"transition_key": panel_content_transition_key,
		"transition_last_panel": panel_content_transition_last_panel,
		"loading_active": age_up_loading_runtime_active,
		"loading_overlay_visible": age_up_loading_overlay != null and age_up_loading_overlay.visible,
		"loading_safe_handoff": bool(get_meta("age_up_post_loading_finalize_pending", false)),
		"current_phase": str(loading.get("current_phase", "preflight")),
		"session_stage": str(loading.get("session_stage", "boot")),
		"current_lane": str(loading.get("current_lane", "boot")),
		"stall_score": float(loading.get("stall_score", 0.0)),
		"runtime_weight": float(loading.get("runtime_weight", 0.0)),
		"phase_index": int(loading.get("phase_index", 0)),
		"phase_order": phase_order.duplicate(true),
		"deferred_jobs": deferred_jobs.duplicate(true),
		"budget_consumption": budget.duplicate(true),
		"year_pipeline_pending": bool(loading.get("year_pipeline_pending", false)),
		"year_pipeline_stage": int(loading.get("year_pipeline_stage", 0)),
		"guard_state": guard.duplicate(true),
		"output_visible": output_label != null and output_label.visible,
		"player_stats_visible": player_stats_overlay != null and player_stats_overlay.visible
	}

func _apply_live_diagnostics_guard_actions(snapshot: Dictionary) -> void:
	if gs == null or gs.live_patch_guard == null:
		return

	var actions: Array = gs.live_patch_guard.review_ui_snapshot(snapshot)
	for raw_action in actions:
		if typeof(raw_action) != TYPE_DICTIONARY:
			continue
		var action: Dictionary = raw_action
		var action_key: String = str(action.get("action", ""))

		match action_key:
			"clear_stale_transition_flag":
				_cancel_panel_content_transition()
				set_meta("age_up_transition_busy", false)
				if gs.live_diagnostics_engine != null:
					gs.live_diagnostics_engine.record_recovery(
						"stale_transition_cleared",
						{ "source": "main_scene", "action": action_key}
					)
			"quarantine_popup_lane":
				if activities_action_open:
					_hide_activities_action_panel()
				if standard_tab_popup_open:
					_hide_standard_tab_popup()
				if world_feed_popup_open:
					_hide_world_action_panel()
				if relationship_profile_popup_open:
					_hide_relationship_profile_popup()
			"fallback_cached_ui":
				if not age_up_diary_entries.is_empty():
					_render_life_diary_panel()
			"defer_refresh":
				if not bool(get_meta("age_up_post_loading_finalize_pending", false)):
					set_meta("age_up_post_loading_finalize_pending", true)

		if gs.runtime_health_registry != null:
			gs.runtime_health_registry.record_mitigation(action)
func _live_diagnostics_overlay_observer_suppressed() -> bool:
	if not age_up_loading_runtime_active:
		return false
	if bool(get_meta("live_diagnostics_fix_preview_expanded", false)):
		return false
	if live_diagnostics_force_frames > 0:
		return false
	var visible_started_ms: int = int(age_up_loading_visible_started_ms)
	if visible_started_ms <= 0:
		return true
	return int(Time.get_ticks_msec()) - visible_started_ms < 1500


func _get_cached_age_up_loading_stall_score(force: bool = false) -> float:
	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("age_up_loading_cached_stall_score_next_ms", 0))
	if not force and now_ms < next_refresh_ms:
		return float(get_meta("age_up_loading_cached_stall_score_value", 0.0))

	var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {}) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
	var stall_score: float = float(loading.get("stall_score", 0.0))

	set_meta("age_up_loading_cached_stall_score_value", stall_score)
	set_meta("age_up_loading_cached_stall_score_next_ms", now_ms + (34 if age_up_loading_runtime_active else 80))
	return stall_score

func _get_cached_age_up_loading_border_theme(force: bool = false) -> Dictionary:
	var loading_context_raw: Variant = get_meta("age_up_loading_deferred_begin_context", {})
	var loading_context: Dictionary = loading_context_raw if typeof(loading_context_raw) == TYPE_DICTIONARY else {}
	var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {}) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
	var overlay_context_raw: Variant = loading.get("overlay_context", {})
	var overlay_context: Dictionary = overlay_context_raw if typeof(overlay_context_raw) == TYPE_DICTIONARY else {}

	var locked_theme_key: String = str(get_meta("age_up_loading_locked_theme_key", "")).strip_edges().to_lower()
	var theme_key: String = locked_theme_key if age_up_loading_runtime_active and locked_theme_key != "" else MainSceneLogic._resolve_age_up_loading_theme_key(gs, loading_context, overlay_context)

	var cached_key: String = str(get_meta("age_up_loading_cached_border_theme_key", ""))
	var cached_raw: Variant = get_meta("age_up_loading_cached_border_theme", {})
	var cached: Dictionary = cached_raw if typeof(cached_raw) == TYPE_DICTIONARY else {}
	if not force and theme_key == cached_key and not cached.is_empty():
		return cached

	var resolved: Dictionary = MainSceneHelpers._era_border_theme_data(theme_key)
	set_meta("age_up_loading_cached_border_theme_key", theme_key)
	set_meta("age_up_loading_cached_border_theme", resolved.duplicate(true))
	return resolved
func _refresh_live_diagnostics_panel(delta: float = 0.0) -> void:
	if bool(get_meta("age_up_truth_probe_disable_live_diagnostics", false)) and age_up_loading_runtime_active:
		_age_up_truth_probe_mark_throttled("live_diagnostics_suppressed", {
			"delta": delta,
			"force_frames": live_diagnostics_force_frames,
			"visible": live_diagnostics_panel != null and is_instance_valid(live_diagnostics_panel) and live_diagnostics_panel.visible
		}, 1000)
		live_diagnostics_force_frames = 0
		return

	_ensure_live_diagnostics_panel()
	if live_diagnostics_panel == null:
		return

	var diagnostics_preview_expanded: bool = bool(get_meta("live_diagnostics_fix_preview_expanded", false))
	var runtime_observer_suppressed: bool = _live_diagnostics_overlay_observer_suppressed()
	var hot_age_up_path: bool = age_up_loading_runtime_active and not diagnostics_preview_expanded
	var hidden_panel: bool = not live_diagnostics_panel.visible and \
live_diagnostics_force_frames <= 0 and not diagnostics_preview_expanded
	var hidden_now_ms: int = int(Time.get_ticks_msec())
	var hidden_refresh_next_ms: int = int(get_meta("live_diagnostics_hidden_refresh_next_ms", 0))

	if hot_age_up_path and hidden_panel:
		var hidden_runtime_interval_ms: int = 3200 if runtime_observer_suppressed else 2600
		if hidden_now_ms < hidden_refresh_next_ms:
			return
		set_meta(
			"live_diagnostics_hidden_refresh_next_ms",
			hidden_now_ms + hidden_runtime_interval_ms
		)
		return

	var post_spawn_prewarm_pending: bool = false
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		post_spawn_prewarm_pending = bool(gs.scenario_state.get("post_spawn_ui_finalize_pending", false))

	if hidden_panel and post_spawn_prewarm_pending:
		if hidden_now_ms < hidden_refresh_next_ms:
			return
		set_meta(
			"live_diagnostics_hidden_refresh_next_ms",
			hidden_now_ms + 1200
		)
		return

	if hidden_panel:
		if hidden_now_ms < hidden_refresh_next_ms:
			return
		set_meta(
			"live_diagnostics_hidden_refresh_next_ms",
			hidden_now_ms + 450
		)

	var ui_snapshot: Dictionary = _collect_live_diagnostics_snapshot()
	_apply_live_diagnostics_guard_actions(ui_snapshot)

	var refresh_interval: float = 0.16
	if bool(ui_snapshot.get("loading_active", false)):
		refresh_interval = 0.05
	elif float(ui_snapshot.get("stall_score", 0.0)) >= 90.0:
		refresh_interval = 0.06
	elif float(ui_snapshot.get("stall_score", 0.0)) >= 60.0:
		refresh_interval = 0.08
	elif int(ui_snapshot.get("popup_count", 0)) > 0:
		refresh_interval = 0.1

	if bool(get_meta("live_diagnostics_manual_throttle_enabled", false)):
		refresh_interval = max(refresh_interval, 0.22)
	if bool(ui_snapshot.get("loading_active", false)) or float(ui_snapshot.get("stall_score", 0.0)) >= 60.0:
		refresh_interval = max(refresh_interval, 0.3)
	if hot_age_up_path:
		refresh_interval = max(refresh_interval, 0.8)
	if hidden_panel:
		refresh_interval = max(refresh_interval, 0.45)
	if runtime_observer_suppressed:
		refresh_interval = max(refresh_interval, 0.65)

	var deferred_raw: Variant = ui_snapshot.get("deferred_jobs", [])
	var deferred_jobs: Array = deferred_raw if typeof(deferred_raw) == TYPE_ARRAY else []
	var signature: String = "%s|%s|%s|%s|%s|%s|%s|%s" % [
		str(ui_snapshot.get("current_panel", "")),
		str(ui_snapshot.get("current_phase", "")),
		str(ui_snapshot.get("current_lane", "")),
		str(ui_snapshot.get("session_stage", "")),
		str(ui_snapshot.get("transition_active", false)),
		str(ui_snapshot.get("loading_active", false)),
		str(ui_snapshot.get("year_pipeline_stage", 0)),
		str(deferred_jobs.size())
	]

	live_diagnostics_refresh_accumulator += max(delta, 0.0)
	var signature_changed: bool = signature != live_diagnostics_last_signature
	var should_push: bool = signature_changed or \
live_diagnostics_force_frames > 0 or \
live_diagnostics_refresh_accumulator >= refresh_interval
	if not should_push:
		return

	live_diagnostics_last_signature = signature
	live_diagnostics_refresh_accumulator = 0.0
	live_diagnostics_last_push_ms = int(Time.get_ticks_msec())
	if live_diagnostics_force_frames > 0:
		live_diagnostics_force_frames -= 1

	var patch_cards: Array = []
	var auto_patches: Array = []
	var can_observe_runtime: bool = (
		live_diagnostics_panel.visible or
		live_diagnostics_force_frames > 0 or
		diagnostics_preview_expanded
	) and not runtime_observer_suppressed

	if gs != null and gs.runtime_health_registry != null:
		patch_cards = gs.runtime_health_registry.get_recent_patch_cards(3)
		auto_patches = gs.runtime_health_registry.get_recent_auto_patches(1)

	if gs != null and gs.live_diagnostics_engine != null and can_observe_runtime and not hot_age_up_path:
		gs.live_diagnostics_engine.observe_ui_snapshot(ui_snapshot, delta)

	if not can_observe_runtime:
		if live_diagnostics_panel.visible:
			var render_snapshot: Dictionary = ui_snapshot.duplicate(true)
			if not auto_patches.is_empty():
				render_snapshot ["latest_auto_patch"] = auto_patches [auto_patches.size() - 1]
			live_diagnostics_panel.set_snapshot(render_snapshot, patch_cards)
		return

	var debug_snapshot: Dictionary = (
		gs.live_diagnostics_engine.get_debug_snapshot()
		if gs != null and gs.live_diagnostics_engine != null
		else ui_snapshot.duplicate(true)
	)
	if not auto_patches.is_empty():
		debug_snapshot ["latest_auto_patch"] = auto_patches [auto_patches.size() - 1]
	live_diagnostics_panel.set_snapshot(debug_snapshot, patch_cards)
func _build_live_auto_patch_preview(latest_auto_patch_raw: Variant, patch_cards: Array = []) -> Dictionary:
	if typeof(latest_auto_patch_raw) != TYPE_DICTIONARY:
		return {}
	var latest_auto_patch: Dictionary = latest_auto_patch_raw
	if latest_auto_patch.is_empty():
		return {}
	if not bool(latest_auto_patch.get("exact_before_after_available", false)):
		return {}
	var patch_key: String = str(latest_auto_patch.get("patch_key", "")).strip_edges()
	if patch_key == "":
		return {}
	var before_after: Dictionary = _get_live_auto_patch_before_after_blocks(patch_key)
	if before_after.is_empty():
		return {}
	var manual_state: Dictionary = {}
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var manual_state_raw: Variant = gs.scenario_state.get("manual_live_auto_patches", {})
		manual_state = manual_state_raw if typeof(manual_state_raw) == TYPE_DICTIONARY else {}
	var patch_state_raw: Variant = manual_state.get(patch_key, {})
	var patch_state: Dictionary = patch_state_raw if typeof(patch_state_raw) == TYPE_DICTIONARY else {}
	var patch_card: Dictionary = {}
	if not patch_cards.is_empty() and typeof(patch_cards [patch_cards.size() - 1]) == TYPE_DICTIONARY:
		patch_card = patch_cards [patch_cards.size() - 1]
	return {
		"patch_key": patch_key,
		"title": "Proposed Fix",
		"summary": str(latest_auto_patch.get("reason", patch_card.get("recommended_permanent_patch", ""))),
		"target_engine": str(latest_auto_patch.get("target_engine", "unknown")),
		"target_function": str(latest_auto_patch.get("target_function", "unknown")),
		"view_button_text": "Hide Fix" if bool(get_meta("live_diagnostics_fix_preview_expanded", false)) else "View Fix",
		"apply_button_text": "Patch Applied" if bool(patch_state.get("applied", false)) else "Apply Patch",
		"expanded": bool(get_meta("live_diagnostics_fix_preview_expanded", false)),
		"applied": bool(patch_state.get("applied", false)),
		"before_code": str(before_after.get("before_code", "")),
		"after_code": str(before_after.get("after_code", ""))
	}

