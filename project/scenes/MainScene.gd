func _on_crown_popup_confirm_pressed() -> void:
	var action_id: String = str(
		crown_action_popup_context.get(
			"action_id",
			""
		)
	).strip_edges()

	match action_id:
		"create_realm":
			var raw_name: String = (
				crown_action_popup_input.text
				.strip_edges()
			)
			if raw_name == "":
				crown_action_popup_status.text = (
					"Give the realm a name first."
				)
				return

			_execute_crown_action(
				"create_realm_confirm",
				{
					"realm_name": raw_name
				}
			)

		"war_preview_pending":
			var pending_preview: Dictionary = (
				MainSceneHelpers._safe_dictionary(
					crown_action_popup_context.get(
						"war_preview_contract",
						{}
					)
				)
			)
			if not bool(
				pending_preview.get(
					"declaration_allowed",
					false
				)
			):
				crown_action_popup_status.text = (
					"War declaration authority is unavailable."
				)
				return

			var pending_war_payload: Dictionary = {
				"attacker_realm_id": int(
					crown_action_popup_context.get(
						"attacker_realm_id",
						-1
					)
				),
				"defender_realm_id": int(
					crown_action_popup_context.get(
						"defender_realm_id",
						-1
					)
				),
				"source": (
					"mainscene."
					+ "war_declaration_from_authority_live_preview"
				),
			}

			crown_action_popup.visible = false
			crown_action_popup.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			_maybe_show_action_result_popup({
				"success": true,
				"popup_title": "DECLARATION SUBMITTED",
				"popup_text": (
					"Your sovereign declaration has entered the "
					+ "WarContractEngine authority lane. You retain "
					+ "full control while the immutable result publishes."
				),
				"popup_footer": (
					"The WAR tab will stream the committed conflict live."
				)
			})

			_queue_crown_war_intent_from_renderer(
				"declare_war",
				pending_war_payload
			)

		"war_confirm_contract":
			var war_payload: Dictionary = {
				"attacker_realm_id": int(
					crown_action_popup_context.get(
						"attacker_realm_id",
						-1
					)
				),
				"defender_realm_id": int(
					crown_action_popup_context.get(
						"defender_realm_id",
						-1
					)
				),
				"war_preview_contract": (
					MainSceneHelpers._safe_dictionary(
						crown_action_popup_context.get(
							"war_preview_contract",
							{}
						)
					).duplicate(false)
				)
			}

			crown_action_popup.visible = false
			crown_action_popup.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

			_maybe_show_action_result_popup({
				"success": true,
				"popup_title": "DECLARATION SUBMITTED",
				"popup_text": (
					"The resident matchup contract has been submitted "
					+ "to WarContractEngine. Reality will commit outside "
					+ "the pointer event."
				),
				"popup_footer": (
					"The WAR tab will publish the active conflict progressively."
				)
			})

			_queue_crown_war_intent_from_renderer(
				"declare_war",
				war_payload
			)

		"era_kingdom_bribe_confirm":
			var bribe_payload: Dictionary = {
				"target_realm_key": "era_kingdom",
				"country": "Era Kingdom",
				"amount": int(
					crown_action_popup_context.get(
						"amount",
						150000
					)
				),
				"source": (
					"mainscene.era_kingdom_bribe_confirmation"
				)
			}

			crown_action_popup.visible = false
			crown_action_popup.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
			call_deferred(
				"_commit_crown_era_kingdom_bribe_deferred",
				bribe_payload
			)

		_:
			crown_action_popup_status.text = (
				"No confirm action is wired for this popup."
			)
func _commit_crown_era_kingdom_bribe_deferred(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		gs.player.id
	)
	var outgoing: Dictionary = (
		payload.duplicate(false)
	)

	outgoing [
		"action_id"
	] = "bribe_era_kingdom"
	outgoing [
		"section_id"
	] = "diplomacy"
	outgoing [
		"actor_id"
	] = actor_id
	outgoing [
		"actor_realm_id"
	] = int(
		gs.player.realm_id
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"intent_type": (
				"crown_diplomacy_intent"
			),
			"surface_id": "crown_hub",
			"action_id": (
				"bribe_era_kingdom"
			),
			"payload": outgoing,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"crown_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": (
				"mainscene.era_kingdom_bribe"
			)
		},
		{
			"actor_id": actor_id,
			"surface_id": "crown_hub",
			"action_id": (
				"bribe_era_kingdom"
			),
			"source": (
				"mainscene.era_kingdom_bribe"
			)
		}
	)
	var routed: Dictionary = _contract_route_result(
		report
	)
	var crown_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		routed.get(
			"crown_hub_contract",
			{}
		)
	)

	if not crown_contract.is_empty():
		crown_hub_active_contract = (
			crown_contract.duplicate(false)
		)
		crown_hub_active_actor_id = actor_id

		if crown_hub_open:
			_refresh_crown_hub_chrome()

	var result: Dictionary = MainSceneHelpers._safe_dictionary(
		routed.get(
			"result",
			routed
		)
	)

	if not result.is_empty():
		_maybe_show_action_result_popup(
			result
		)

	if (
		bool(
			result.get(
				"dynamic_war_tab_required",
				false
			)
		)
		and crown_hub_open
	):
		crown_hub_current_section = "war"
		_refresh_crown_hub_chrome()
		_render_crown_war_section_from_contract()

	set_meta(
		"era_kingdom_bribe_engine_work_on_confirm_press",
		false
	)
