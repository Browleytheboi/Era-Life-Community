func _claim_prewarmed_god_mode_life_front_buffer_now(
	settings: Dictionary,
	signature: String,
	handoff_contract: Dictionary,
	reason: String = "god_mode_entry"
) -> bool:
	if settings.is_empty():
		return false

	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return false

	if not _is_god_mode_life_prewarm_ready_for_settings(
		settings
	):
		return false

	var prewarmed_raw: Variant = get_meta(
		"god_mode_life_prewarmed_gs",
		null
	)

	if not (
		prewarmed_raw is GameState
	):
		return false

	var prewarmed_gs: GameState = (
		prewarmed_raw as GameState
	)

	if (
		prewarmed_gs == null
		or prewarmed_gs.player == null
	):
		return false

	var merged_settings:= _build_default_custom_settings()

	for key in settings.keys():
		merged_settings [
			key
		] = settings [
			key
		]










	if not _adopt_attached_resident_game_state(
		prewarmed_gs,
		clean_signature
	):
		return false

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var birth_boot_context: Dictionary = (
		_birth_shell_boot_context_from_settings(
			merged_settings
		)
	)
	var target_year: int = int(
		birth_boot_context.get(
			"target_year",
			int(
				merged_settings.get(
					"year",
					gs.year
				)
			)
		)
	)
	var era_key: String = str(
		birth_boot_context.get(
			"era_key",
			str(
				merged_settings.get(
					"era",
					""
				)
			)
		)
	).strip_edges()

	gs.custom_mode = true
	gs.awaiting_new_life = false
	gs.afterlife_active = false
	gs.afterlife_state.clear()
	gs.custom_settings = merged_settings.duplicate(
		true
	)
	gs.year = target_year

	if (
		gs.era_engine != null
		and typeof(
			gs.era_engine.eras
		) == TYPE_DICTIONARY
		and gs.era_engine.eras.has(
			era_key
		)
	):
		gs.era = gs.era_engine.eras.get(
			era_key,
			{}
		).duplicate(
			true
		)
	elif (
		gs.era_engine != null
		and gs.era_engine.has_method(
			"_era_from_year"
		)
	):
		gs.era = gs.era_engine._era_from_year(
			target_year
		)

	if "reality_mode" in gs:
		gs.reality_mode = str(
			birth_boot_context.get(
				"reality_mode",
				merged_settings.get(
					"reality_mode",
					"realistic"
				)
			)
		)

	gs.scenario_state [
		"god_mode_life_front_buffer_claimed"
	] = true
	gs.scenario_state [
		"god_mode_life_front_buffer_claimed_reason"
	] = reason
	gs.scenario_state [
		"god_mode_life_front_buffer_claimed_at_ms"
	] = now_ms
	gs.scenario_state [
		"god_mode_life_front_buffer_signature"
	] = clean_signature
	gs.scenario_state [
		"god_mode_life_front_buffer_handoff_contract"
	] = handoff_contract.duplicate(
		true
	)
	gs.scenario_state [
		"god_mode_life_prewarm_consumed"
	] = false
	gs.scenario_state [
		"god_mode_life_prewarm_signature"
	] = clean_signature
	gs.scenario_state [
		"spawn_shell_entry_policy"
	] = "full_playable_ui_from_prewarmed_capsule"
	gs.scenario_state [
		"ui_first_frame_render_policy"
	] = "full_playable_ui_visible_no_runtime_work"
	gs.scenario_state [
		"prewarmed_capsule_entry_shell_first"
	] = false
	gs.scenario_state [
		"birth_shell_first_boot"
	] = false
	gs.scenario_state [
		"birth_shell_first_boot_active"
	] = false
	gs.scenario_state [
		"birth_shell_player_created"
	] = true
	gs.scenario_state [
		"birth_shell_player_id"
	] = int(
		gs.player.id
	)
	gs.scenario_state [
		"birth_shell_player_control_released"
	] = true
	gs.scenario_state [
		"birth_shell_player_control_released_at_ms"
	] = now_ms
	gs.scenario_state [
		"spawn_ready_runtime_hud_shell_only_active"
	] = false
	gs.scenario_state [
		"post_spawn_ui_finalize_pending"
	] = false
	gs.scenario_state [
