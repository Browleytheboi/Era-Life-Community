				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true,
				"target": {
					"route_kind": "engine_method",
					"engine_property": "crime_hub_contract_engine",
					"method": "observe_resident_projection",
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": source,
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"source": source,
				"surface_id": "crime_hub_panel",
				"action_id": "attach_resident_crime_observation_cursor",
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true,
				"ready_gate_member": false,
				"build_on_click": false
			}
		)

		deck_hot = (
			crime_panel.has_observable_section_deck(
				actor_id
			)
		)

	set_meta(
		"crime_hub_resident_deck_hot_actor_id",
		actor_id
		if deck_hot
		else -1
	)

	set_meta(
		"crime_hub_resident_deck_hot",
