	if player_stats_overlay != null:
		player_stats_overlay.visible = true

	_update_player_stats_overlay()

func _on_profile_panel_back_pressed() -> void:
	current_panel = ""
	_hide_profile_panel_popup()

	if output_label != null:
		output_label.visible = true
		_render_life_diary_panel()
		call_deferred("_scroll_life_diary_to_bottom")

	_update_belongings_hud()
	_update_bending_hud()
	_apply_ui_nav_button_visuals()


func _sync_profile_panel_content() -> void:
	if gs == null or gs.player == null:
		return

	_ensure_profile_panel_popup()

	if profile_panel_popup == null:
		return

	var p:= gs.player
	var lines:= []

	lines.append(
		"Reality Mode: %s"
		% gs.get_reality_mode().capitalize()
	)
	lines.append(
		"Current Year: %s"
		% _format_year(gs.year)
	)
	lines.append("")
	lines.append(
		"%s %s"
		% [
			p.first_name,
			p.last_name
		]
	)
	lines.append(
		"Age %d • %s"
		% [
			int(p.age),
			str(p.gender)
		]
	)
	lines.append("")
	lines.append(
		"Born in: %s, %s"
		% [
			p.birth_city,
			p.birth_country
		]
	)
	lines.append(
		"Lives in: %s, %s"
		% [
			p.home_city,
			p.home_country
		]
	)
	lines.append(
		"Job: %s"
		% (
			p.job
			if p.job != ""
			else "None"
		)
	)
	lines.append(
		"Social Class: %s"
		% str(p.social_class)
	)
	lines.append(
		"Imagination: %d/100"
		% int(p.imagination)
	)

	if (
		typeof(p.terabithia_state) == TYPE_DICTIONARY
		and bool(
			p.terabithia_state.get(
				"discovered",
				false
			)
		)
	):
		lines.append(
			"Imaginative Realm: Terabithia"
		)

	if p.is_royal:
		var succession_text:= (
			"Current Ruler"
			if int(p.succession_rank) == 0
			else "#%d" % int(p.succession_rank)
		)
		lines.append(
			"Royal Title: %s"
			% str(p.royal_title)
		)
		lines.append(
			"Succession: %s"
			% succession_text
		)
		lines.append(
			"Approval: %d/100"
			% int(p.approval)
		)

	lines.append(
		"Bank Balance: %s"
		% _format_standard_tab_money(
			int(
				p.bank_balance
			)
		)
	)

	if int(p.fame) > 0:
		lines.append(
			"Fame Tier: %s"
			% str(p.fame_tier)
		)

	var my_properties:= _property_lines_for_npc(
		p.id
	)

	if not my_properties.is_empty():
		lines.append(
			"Properties Owned: %d"
			% my_properties.size()
		)

	var use_royal_bender_tint:= (
		MainSceneLogic._player_is_royal_bender(gs)
	)
	var royal_tint:= (
		MainSceneLogic._royal_bender_ui_tint_for_player(gs)
	)
	var royal_tint_hex:= royal_tint.to_html(
		false
	)

	profile_panel_identity_text.clear()
	profile_panel_identity_text.bbcode_enabled = (
		use_royal_bender_tint
	)

	for line in lines:
		var line_text:= str(line)

		if use_royal_bender_tint and (
			line_text.begins_with(
				"Royal Title:"
			)
			or line_text.begins_with(
				"Succession:"
			)
			or line_text.begins_with(
				"Approval:"
			)
		):
			if (
				line_text.begins_with(
					"Royal Title:"
				)
				and str(
					p.bending_nation
				).strip_edges() != ""
				and line_text.find(
					" • "
				) == -1
			):
				line_text += (
					" • %s"
					% str(
						p.bending_nation
					)
				)

			line_text = (
				"[color=#%s]%s[/color]"
				% [
					royal_tint_hex,
					line_text
				]
			)

		profile_panel_identity_text.append_text(
			line_text + "\n"
		)

	var health_value: int = clamp(
		int(p.health),
		0,
		200
	)
	var mental_value: int = clamp(
		int(p.mental_health),
		0,
		100
	)
	var happiness_value: int = clamp(
		int(p.satisfaction),
		0,
		100
	)
	var smarts_value: int = clamp(
		int(p.smarts),
		0,
		100
	)
	var looks_value: int = clamp(
		int(p.looks),
		0,
		100
	)
	var fame_value: int = clamp(
		int(p.fame),
		0,
		100
	)
	var surface_context: Dictionary = (
		_build_player_stat_surface_context(
			p
		)
	)

	profile_panel_health_target = float(
		health_value
	)
	profile_panel_mental_target = float(
		mental_value
	)
	profile_panel_happiness_target = float(
		happiness_value
	)
	profile_panel_smarts_target = float(
		smarts_value
	)
	profile_panel_looks_target = float(
		looks_value
	)
	profile_panel_fame_target = float(
		fame_value
	)

	if (
		profile_panel_health_label != null
		and profile_panel_health_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_health_label,
			profile_panel_health_bar,
			"Health",
			health_value,
			200,
			surface_context
		)

	if (
		profile_panel_mental_label != null
		and profile_panel_mental_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_mental_label,
			profile_panel_mental_bar,
			"Mental",
			mental_value,
			100,
			surface_context
		)

	if (
		profile_panel_happiness_label != null
		and profile_panel_happiness_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_happiness_label,
			profile_panel_happiness_bar,
			"Happiness",
			happiness_value,
			100,
			surface_context
		)

	if (
		profile_panel_smarts_label != null
		and profile_panel_smarts_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_smarts_label,
			profile_panel_smarts_bar,
			"Smarts",
			smarts_value,
			100,
			surface_context
		)

	if (
		profile_panel_looks_label != null
		and profile_panel_looks_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_looks_label,
			profile_panel_looks_bar,
			"Looks",
			looks_value,
			100,
			surface_context
		)

	if profile_panel_fame_row != null:
		profile_panel_fame_row.visible = (
			fame_value > 0
		)

	if (
		fame_value > 0
		and profile_panel_fame_label != null
		and profile_panel_fame_bar != null
	):
		_apply_player_stat_surface_content(
			profile_panel_fame_label,
			profile_panel_fame_bar,
			"Fame",
			fame_value,
			100,
			surface_context
		)

func _animate_profile_panel(delta: float) -> void:
	if profile_panel_popup == null or not profile_panel_popup.visible:
		return

	profile_panel_breathe_time += delta
	var speed_scale: float = delta * 180.0

	if profile_panel_health_bar != null:
		profile_panel_health_bar.value = move_toward(float(profile_panel_health_bar.value), profile_panel_health_target, speed_scale)

	if profile_panel_mental_bar != null:
		profile_panel_mental_bar.value = move_toward(float(profile_panel_mental_bar.value), profile_panel_mental_target, speed_scale)

	if profile_panel_happiness_bar != null:
		profile_panel_happiness_bar.value = move_toward(float(profile_panel_happiness_bar.value), profile_panel_happiness_target, speed_scale)

	if profile_panel_smarts_bar != null:
		profile_panel_smarts_bar.value = move_toward(float(profile_panel_smarts_bar.value), profile_panel_smarts_target, speed_scale)

	if profile_panel_looks_bar != null:
		profile_panel_looks_bar.value = move_toward(float(profile_panel_looks_bar.value), profile_panel_looks_target, speed_scale)

	if profile_panel_fame_bar != null:
		profile_panel_fame_bar.value = move_toward(float(profile_panel_fame_bar.value), profile_panel_fame_target, speed_scale)

	var pulse_strength: float = (sin(profile_panel_breathe_time * 1.25) + 1.0) * 0.5
	var health_danger: bool = profile_panel_health_target > 0.0 and profile_panel_health_target < 30.0

	_apply_player_stat_row_visual_state(profile_panel_health_label, profile_panel_health_bar, "Health", player_stats_hovered_row_title == "Health", health_danger, pulse_strength)
	_apply_player_stat_row_visual_state(profile_panel_mental_label, profile_panel_mental_bar, "Mental", player_stats_hovered_row_title == "Mental", false, pulse_strength)
	_apply_player_stat_row_visual_state(profile_panel_happiness_label, profile_panel_happiness_bar, "Happiness", player_stats_hovered_row_title == "Happiness", false, pulse_strength)
	_apply_player_stat_row_visual_state(profile_panel_smarts_label, profile_panel_smarts_bar, "Smarts", player_stats_hovered_row_title == "Smarts", false, pulse_strength)
	_apply_player_stat_row_visual_state(profile_panel_looks_label, profile_panel_looks_bar, "Looks", player_stats_hovered_row_title == "Looks", false, pulse_strength)

	if profile_panel_fame_row != null and profile_panel_fame_row.visible:
		_apply_player_stat_row_visual_state(profile_panel_fame_label, profile_panel_fame_bar, "Fame", player_stats_hovered_row_title == "Fame", false, pulse_strength)
func _build_ui_nav_button_style(
	state: String,
	pulse_strength: float = 0.0,
	disabled: bool = false,
	key: String = ""
) -> StyleBoxFlat:
	var style:= StyleBoxFlat.new()
	var tokens: Dictionary = _ui_nav_button_theme_tokens(
		key,
		state,
		pulse_strength,
		disabled
	)

	style.bg_color = tokens.get("bg", Color(0.05, 0.09, 0.18, 0.84))
	var corner_radius: int = int(tokens.get("corner_radius", 14))
	style.corner_radius_top_left = corner_radius
	style.corner_radius_top_right = corner_radius
	style.corner_radius_bottom_right = corner_radius
	style.corner_radius_bottom_left = corner_radius
	var border_width: int = int(tokens.get("border_width", 1))
	style.border_width_left = border_width
	style.border_width_top = border_width
	style.border_width_right = border_width
	style.border_width_bottom = border_width
	style.border_color = tokens.get("border", Color(1.0, 1.0, 1.0, 0.14))
	style.shadow_color = tokens.get("glow", Color(1.0, 1.0, 1.0, 0.08))
	style.shadow_size = int(round(float(tokens.get("glow_size", 8.0))))
	style.shadow_offset = Vector2(0, 0)

	var margin_x: int = int(tokens.get("margin_x", 10))
	var margin_y: int = int(tokens.get("margin_y", 3))

	margin_y = maxi(
		margin_y,
		11
		if key == "age_up"
		else 10
	)

	style.content_margin_left = margin_x
	style.content_margin_top = margin_y
	style.content_margin_right = margin_x
	style.content_margin_bottom = margin_y

	return style
func _standard_tab_is_vormir_overview() -> bool:
	if standard_tab_popup_kind != "other_country_overview":
		return false

	var overview_entry_raw: Variant = standard_tab_popup_payload.get("entry", {})
	var overview_entry: Dictionary = overview_entry_raw if typeof(overview_entry_raw) == TYPE_DICTIONARY else {}

	var overview_realm_raw: Variant = standard_tab_popup_payload.get("realm", {})
	var overview_realm: Dictionary = overview_realm_raw if typeof(overview_realm_raw) == TYPE_DICTIONARY else {}

	var entry_id: String = str(overview_entry.get("entry_id", "")).strip_edges().to_lower()
	var browser_theme: String = str(overview_realm.get("browser_visual_theme", "")).strip_edges().to_lower()
	var overview_theme: String = str(overview_realm.get("overview_visual_theme", "")).strip_edges().to_lower()

	return entry_id == "vormir" or browser_theme == "vormir" or overview_theme == "vormir"


func _standard_tab_add_info_card(title: String, lines: Array) -> void:
	if standard_tab_popup_right == null:
		return
	var overview_entry: Dictionary = standard_tab_popup_payload.get("entry", {})
	var sovereign_overview: bool = standard_tab_popup_kind == "other_country_overview"
	var overview_realm: Dictionary = standard_tab_popup_payload.get("realm", {})
	var entry_kind: String = str(overview_entry.get("entry_kind", standard_tab_popup_payload.get("entry_kind", "realm"))).strip_edges()
	var realm_type: String = str(overview_realm.get("realm_type", overview_realm.get("dimension_type", ""))).strip_edges()
	var entry_id: String = str(overview_entry.get("entry_id", "")).strip_edges()
	var selected_browser_visual_theme: String = str(standard_tab_popup_payload.get("selected_browser_visual_theme", overview_realm.get("browser_visual_theme", ""))).strip_edges().to_lower()
	var selected_overview_visual_theme: String = str(standard_tab_popup_payload.get("selected_overview_visual_theme", overview_realm.get("overview_visual_theme", selected_browser_visual_theme))).strip_edges().to_lower()
	var era_kingdom_overview: bool = sovereign_overview and entry_id == "era_kingdom"
	var vormir_overview: bool = sovereign_overview and (
		entry_id == "vormir"
		or selected_browser_visual_theme == "vormir"
		or selected_overview_visual_theme == "vormir"
	)
	var terabithia_overview: bool = sovereign_overview and not vormir_overview and (
		entry_id == "terabithia"
		or selected_browser_visual_theme == "terabithia"
		or selected_overview_visual_theme == "terabithia"
	)
	var native_element: String = _other_country_resolve_native_element(overview_entry, overview_realm)
	if native_element == "" and selected_overview_visual_theme.begins_with("elemental_"):
		native_element = selected_overview_visual_theme.trim_prefix("elemental_")
	var elemental_overview: bool = sovereign_overview and native_element in ["air", "water", "earth", "fire"]
	var elemental_palette: Dictionary = MainSceneHelpers._build_other_country_elemental_palette(native_element) if elemental_overview else {}
	var terabithia_imagination_ratio: float = 0.0
	var terabithia_overview_bg_alpha: float = 0.98
	var terabithia_overview_border_alpha: float = 0.88
	var terabithia_overview_shadow_alpha: float = 0.34
	var terabithia_overview_shadow_size: int = 24
	if terabithia_overview:
		var raw_ratio: Variant = overview_realm.get("imagination_ratio", -1.0)
		if float(raw_ratio) >= 0.0:
			terabithia_imagination_ratio = clampf(float(raw_ratio), 0.0, 1.0)
		elif gs != null and gs.player != null:
			terabithia_imagination_ratio = clampf(
				float(gs.player.imagination) / 100.0,
				0.0,
				1.0
			)
		terabithia_overview_bg_alpha = clampf(
			float(overview_realm.get(
				"overview_aura_bg_alpha",
				lerpf(0.9, 0.985, terabithia_imagination_ratio)
			)),
			0.9,
			0.99
		)
		terabithia_overview_border_alpha = clampf(
			float(overview_realm.get(
				"overview_border_alpha",
				lerpf(0.72, 0.96, terabithia_imagination_ratio)
			)),
			0.6,
			0.98
		)
		terabithia_overview_shadow_alpha = clampf(
			float(overview_realm.get(
				"overview_aura_shadow_alpha",
				lerpf(0.22, 0.46, terabithia_imagination_ratio)
			)),
			0.18,
			0.52
		)
		terabithia_overview_shadow_size = max(
			16,
			int(round(float(overview_realm.get(
				"overview_aura_shadow_size",
				18.0 + (terabithia_imagination_ratio * 16.0)
			))))
		)
	var imaginative_overview: bool = sovereign_overview and not terabithia_overview and (entry_kind == "imaginative_realm" or realm_type == "imagination_bound")
	var panel_min_height: int = 156 if era_kingdom_overview else (148 if vormir_overview else (128 if terabithia_overview else (144 if imaginative_overview or elemental_overview else 0)))
	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.custom_minimum_size = Vector2(0, panel_min_height)
	standard_tab_popup_right.add_child(panel)
	if sovereign_overview:
		var panel_style:= StyleBoxFlat.new()
		if vormir_overview:
			panel_style = MainSceneHelpers._standard_tab_make_vormir_panel_style("info")
		elif era_kingdom_overview:
			panel_style.bg_color = Color(0.2, 0.11, 0.29, 0.97)
			panel_style.border_color = Color(0.98, 0.8, 0.26, 0.98)
			panel_style.shadow_color = Color(0.98, 0.74, 0.2, 0.22)
			panel_style.shadow_size = 20
		elif terabithia_overview:
			panel_style.bg_color = Color(
				0.18 + (terabithia_imagination_ratio * 0.05),
				0.12 + (terabithia_imagination_ratio * 0.04),
				0.3 + (terabithia_imagination_ratio * 0.08),
				terabithia_overview_bg_alpha
			)
			panel_style.border_color = Color(
				0.92 + (terabithia_imagination_ratio * 0.08),
				0.89 + (terabithia_imagination_ratio * 0.09),
				1.0,
				terabithia_overview_border_alpha
			)
			panel_style.shadow_color = Color(
				0.74 + (terabithia_imagination_ratio * 0.14),
				0.64 + (terabithia_imagination_ratio * 0.14),
				1.0,
				terabithia_overview_shadow_alpha
			)
			panel_style.shadow_size = terabithia_overview_shadow_size
		elif elemental_overview:
			panel_style.bg_color = elemental_palette.get("card_bg", Color(0.14, 0.16, 0.22, 0.98))
			panel_style.border_color = elemental_palette.get("card_border", Color(0.84, 0.9, 0.98, 0.86))
			panel_style.shadow_color = elemental_palette.get("card_shadow", Color(0.2, 0.24, 0.34, 0.24))
			panel_style.shadow_size = 18
		elif imaginative_overview:
			panel_style.bg_color = Color(0.16, 0.11, 0.24, 0.96)
			panel_style.border_color = Color(0.6, 0.86, 1.0, 0.38)
			panel_style.shadow_color = Color(0.34, 0.22, 0.72, 0.2)
			panel_style.shadow_size = 16
		else:
			panel_style.bg_color = Color(0.12, 0.15, 0.21, 0.92)
			panel_style.border_color = Color(0.52, 0.6, 0.74, 0.22)
			panel_style.shadow_color = Color(0.02, 0.03, 0.06, 0.08)
			panel_style.shadow_size = 6
		panel_style.border_width_left = 3 if era_kingdom_overview or vormir_overview or terabithia_overview or imaginative_overview or elemental_overview else 1
		panel_style.border_width_top = 3 if era_kingdom_overview or vormir_overview or terabithia_overview or imaginative_overview or elemental_overview else 1
		panel_style.border_width_right = 3 if era_kingdom_overview or vormir_overview or terabithia_overview or imaginative_overview or elemental_overview else 1
		panel_style.border_width_bottom = 3 if era_kingdom_overview or vormir_overview or terabithia_overview or imaginative_overview or elemental_overview else 1
		panel_style.corner_radius_top_left = 18
		panel_style.corner_radius_top_right = 18
		panel_style.corner_radius_bottom_left = 18
		panel_style.corner_radius_bottom_right = 18
		panel_style.shadow_offset = Vector2.ZERO
		panel.add_theme_stylebox_override("panel", panel_style)
	var margin_x: int = 14 if vormir_overview else (12 if era_kingdom_overview else (8 if terabithia_overview else 12))
	var margin_y: int = 14 if vormir_overview else (12 if era_kingdom_overview else (8 if terabithia_overview else 12))
	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", margin_x)
	margin.add_theme_constant_override("margin_top", margin_y)
	margin.add_theme_constant_override("margin_right", margin_x)
	margin.add_theme_constant_override("margin_bottom", margin_y)
	panel.add_child(margin)
	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 9 if vormir_overview else (8 if era_kingdom_overview else (6 if terabithia_overview else 8)))
	margin.add_child(vbox)
	var header:= Label.new()
	header.text = "%s" % title if era_kingdom_overview else ("%s" % title if vormir_overview or terabithia_overview or imaginative_overview or elemental_overview else title)
	header.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	header.add_theme_font_size_override("font_size", 19 if vormir_overview else (20 if era_kingdom_overview else (17 if terabithia_overview else (18 if imaginative_overview or elemental_overview else 16))))
	if sovereign_overview:
		header.add_theme_color_override(
			"font_color",
			Color(1.0, 0.88, 0.68, 0.99) if vormir_overview else (
				Color(1.0, 0.95, 0.86, 0.99) if era_kingdom_overview else (
					Color(1.0, 0.98, 1.0, 0.99) if terabithia_overview else (
						elemental_palette.get("header_font", Color(0.94, 0.97, 1.0, 0.98)) if elemental_overview else (
							Color(0.92, 0.96, 1.0, 0.98) if imaginative_overview else Color(0.88, 0.91, 0.97, 0.92)
						)
					)
				)
			)
		)
		header.add_theme_color_override(
			"font_shadow_color",
			Color(1.0, 0.34, 0.08, 0.38) if vormir_overview else (
				Color(0.98, 0.72, 0.18, 0.18) if era_kingdom_overview else (
					Color(0.48, 0.3, 0.92, 0.24) if terabithia_overview else (
						elemental_palette.get("button_shadow", Color(0.2, 0.24, 0.32, 0.2)) if elemental_overview else (
							Color(0.36, 0.24, 0.74, 0.16) if imaginative_overview else Color(0.0, 0.0, 0.0, 0.0)
						)
					)
				)
			)
		)
		header.add_theme_constant_override("shadow_outline_size", 4 if vormir_overview else (2 if era_kingdom_overview or terabithia_overview or imaginative_overview or elemental_overview else 0))
	vbox.add_child(header)

	var body:= RichTextLabel.new()
	var use_royal_bender_tint:= MainSceneLogic._player_is_royal_bender(gs)
	var royal_tint:= MainSceneLogic._royal_bender_ui_tint_for_player(gs)
	var royal_tint_hex:= royal_tint.to_html(false)
	var has_royal_title_line:= false
	for raw_line in lines:
		var line_text:= str(raw_line)
		if line_text.begins_with("Royal Title:"):
			has_royal_title_line = true
			break

	body.bbcode_enabled = has_royal_title_line and use_royal_bender_tint
	body.fit_content = true
	body.scroll_active = false
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	if sovereign_overview:
		body.add_theme_color_override(
			"default_color",
			Color(0.93, 0.86, 1.0, 0.96) if vormir_overview else (
				Color(0.98, 0.95, 0.9, 0.96) if era_kingdom_overview else (
					Color(0.99, 0.97, 1.0, 0.96) if terabithia_overview else (
						elemental_palette.get("summary_font", Color(0.88, 0.93, 1.0, 0.94)) if elemental_overview else (
							Color(0.88, 0.93, 1.0, 0.94) if imaginative_overview else Color(0.86, 0.89, 0.95, 0.9)
						)
					)
				)
			)
		)

	if has_royal_title_line and use_royal_bender_tint:
		header.add_theme_color_override("font_color", Color(
			lerp(1.0, royal_tint.r, 0.35),
			lerp(1.0, royal_tint.g, 0.35),
			lerp(1.0, royal_tint.b, 0.35),
			0.98
		))
		header.add_theme_color_override("font_shadow_color", Color(
			royal_tint.r,
			royal_tint.g,
			royal_tint.b,
			0.16
		))
		header.add_theme_constant_override("shadow_outline_size", 2)

	var text:= ""
	for raw_line in lines:
		var line_text:= str(raw_line)
		if has_royal_title_line and use_royal_bender_tint and line_text.begins_with("Royal Title:"):
			if str(gs.player.bending_nation).strip_edges() != "" and line_text.find(" • ") == -1:
				line_text += " • %s" % str(gs.player.bending_nation)
			line_text = "[color=#%s]%s[/color]" % [royal_tint_hex, line_text]
		text += line_text + "\n"
	body.text = text
	vbox.add_child(body)
func _standard_tab_add_rich_info_card(title: String, lines: Array) -> void:
	if standard_tab_popup_right == null:
		return

	var vormir_overview: bool = _standard_tab_is_vormir_overview()

	_standard_tab_add_info_card(title, [])

	var panel:= standard_tab_popup_right.get_child(standard_tab_popup_right.get_child_count() - 1) as PanelContainer
	if panel == null:
		return

	if vormir_overview:
		panel.add_theme_stylebox_override("panel", MainSceneHelpers._standard_tab_make_vormir_panel_style("info"))

	var margin: MarginContainer = panel.get_child(0) as MarginContainer if panel.get_child_count() > 0 else null
	if margin == null:
		return

	var vbox: VBoxContainer = margin.get_child(0) as VBoxContainer if margin.get_child_count() > 0 else null
	if vbox == null:
		return

	for child in vbox.get_children():
		if child is RichTextLabel:
			child.queue_free()

	var body:= RichTextLabel.new()
	body.bbcode_enabled = true
	body.fit_content = true
	body.scroll_active = false
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.add_theme_color_override("default_color", Color(0.95, 0.88, 1.0, 0.97) if vormir_overview else Color(0.92, 0.86, 1.0, 0.96))

	var text:= ""
	for raw_line in lines:
		text += str(raw_line) + "\n"

	body.text = text
	vbox.add_child(body)
func _standard_tab_add_elemental_notable_figure_card(title: String, figure: Dictionary, element: String, _index: int = 0) -> void:
	if standard_tab_popup_right == null:
		return
	if figure.is_empty():
		return

	var clean_element: String = str(element).strip_edges().to_lower()
	var palette: Dictionary = MainSceneHelpers._build_other_country_elemental_palette(clean_element)
	var core_color: Color = _bending_hud_element_color(clean_element)
	var level_value: int = int(figure.get("level", 0))
	var aura_ratio: float = clampf(float(level_value) / 100.0, 0.0, 1.0)

	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.custom_minimum_size = Vector2(0, 118)
	standard_tab_popup_right.add_child(panel)

	var style:= StyleBoxFlat.new()
	style.bg_color = palette.get("card_bg", Color(0.12, 0.14, 0.18, 0.98)).lerp(Color(core_color.r, core_color.g, core_color.b, 0.98), 0.1 + aura_ratio * 0.12)
	style.border_color = palette.get("card_border", Color(0.84, 0.9, 0.98, 0.82)).lerp(Color(1.0, 1.0, 1.0, 0.95), aura_ratio * 0.18)
	style.shadow_color = Color(core_color.r, core_color.g, core_color.b, 0.18 + aura_ratio * 0.3)
	style.shadow_size = int(round(12.0 + aura_ratio * 22.0))
	style.shadow_offset = Vector2.ZERO
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.corner_radius_top_left = 18
	style.corner_radius_top_right = 18
	style.corner_radius_bottom_left = 18
	style.corner_radius_bottom_right = 18
	panel.add_theme_stylebox_override("panel", style)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 10)
	panel.add_child(margin)

	var root:= VBoxContainer.new()
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_theme_constant_override("separation", 5)
	margin.add_child(root)

	var header:= Label.new()
	header.text = "%s • %s" % [title, str(figure.get("name", "Unknown"))]
	header.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	header.add_theme_font_size_override("font_size", 17)
	header.add_theme_color_override("font_color", palette.get("header_font", Color(0.96, 0.98, 1.0, 0.99)))
	header.add_theme_color_override("font_shadow_color", Color(core_color.r, core_color.g, core_color.b, 0.24 + aura_ratio * 0.24))
	header.add_theme_constant_override("shadow_outline_size", 2)
	root.add_child(header)

	var details:= Label.new()
	details.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	details.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	details.add_theme_color_override("font_color", palette.get("summary_font", Color(0.9, 0.94, 1.0, 0.94)))

	var succession_text: String = ""
	var succession_rank: int = int(figure.get("succession_rank", 0))
	if succession_rank > 0:
		succession_text = " • Succession #%d" % succession_rank

	details.text = "%s • %s Aura • Level %d %sBending\n%s • Fame %d • Age %d%s" % [
		str(figure.get("title", "Bender")),
		str(figure.get("aura_tier", "Awakened")),
		level_value,
		str(figure.get("element", clean_element)).capitalize(),
		str(figure.get("bending_type", clean_element.capitalize())),
		int(figure.get("fame", 0)),
		int(figure.get("age", 0)),
		succession_text
	]
	root.add_child(details)


func _standard_tab_add_elemental_notable_figures_section(entry: Dictionary, realm: Dictionary, element: String) -> void:
	if standard_tab_popup_right == null:
		return

	var clean_element: String = str(element).strip_edges().to_lower()
	if clean_element not in ["air", "water", "earth", "fire"]:
		return

	var figures_payload: Dictionary = {}
	if gs != null and gs.bending_engine != null and gs.bending_engine.has_method("get_elemental_realm_notable_figures"):
		figures_payload = gs.bending_engine.get_elemental_realm_notable_figures(entry, realm, clean_element, 5, 4)

	if figures_payload.is_empty():
		_standard_tab_add_info_card("NOTABLE FIGURES", [
			"No major %s benders are visible from this realm surface yet." % clean_element.capitalize(),
			"As the realm population deepens, this section will surface rulers, heirs, masters, and rising elemental legends."
		])
		return

	var ruler: Dictionary = figures_payload.get("ruler", {})
	var possible_heirs: Array = figures_payload.get("possible_heirs", [])
	var top_benders: Array = figures_payload.get("top_benders", [])

	var descriptor: Dictionary = MainSceneHelpers._build_other_country_elemental_descriptor(clean_element)
	_standard_tab_add_info_card("NOTABLE FIGURES", [
		"%s’s public power is now surfaced through visible people, not just abstract state numbers." % str(realm.get("name", entry.get("name", "This realm"))),
		"Top benders, the ruler, and possible heirs are pulled from the living simulation and rendered through the realm’s %s aura." % str(descriptor.get("display_name", clean_element.capitalize()))
	])

	if not ruler.is_empty():
		_standard_tab_add_elemental_notable_figure_card("RULER", ruler, clean_element, 0)

	if not possible_heirs.is_empty():
		_standard_tab_add_section_header("Royal Heirs")
		var heir_index: int = 0
		for raw_heir in possible_heirs:
			if typeof(raw_heir) != TYPE_DICTIONARY:
				continue
			heir_index += 1
			_standard_tab_add_elemental_notable_figure_card("HEIR %d" % heir_index, raw_heir, clean_element, heir_index)

	if not top_benders.is_empty():
		_standard_tab_add_section_header("Top Benders")
		var bender_index: int = 0
		for raw_bender in top_benders:
			if typeof(raw_bender) != TYPE_DICTIONARY:
				continue
			var bender: Dictionary = raw_bender
			if not ruler.is_empty() and int(bender.get("id", -1)) == int(ruler.get("id", -2)):
				continue
			bender_index += 1
			_standard_tab_add_elemental_notable_figure_card("BENDER %d" % bender_index, bender, clean_element, bender_index)
func _standard_tab_add_live_stat_row(title: String, value: int, max_value: int) -> void:
	if standard_tab_popup_right == null:
		return

	var overview_entry: Dictionary = standard_tab_popup_payload.get("entry", {})
	var sovereign_overview: bool = standard_tab_popup_kind == "other_country_overview"
	var era_kingdom_overview: bool = sovereign_overview and str(overview_entry.get("entry_id", "")).strip_edges() == "era_kingdom"
	var vormir_overview: bool = _standard_tab_is_vormir_overview()

	var built:= _make_player_stat_row(title, max_value)
	var row: VBoxContainer = built.row
	var label: Label = built.label
	var bar: ProgressBar = built.bar

	var surface_context: Dictionary = {}
	if sovereign_overview:
		var payload_realm: Dictionary = standard_tab_popup_payload.get("realm", {})
		surface_context = _build_realm_stat_surface_context(title, value, max_value, overview_entry, payload_realm)
	elif gs != null and gs.player != null:
		surface_context = _build_player_stat_surface_context(gs.player, "first_person", gs.player)

	bar.custom_minimum_size = Vector2(0, 20)
	bar.value = 0
	_apply_player_stat_surface_content(label, bar, title, value, max_value, surface_context)

	if sovereign_overview:
		if vormir_overview:
			MainSceneHelpers._standard_tab_apply_vormir_label_style(label, true)
			MainSceneHelpers._standard_tab_apply_vormir_bar_style(bar)
		else:
			label.add_theme_color_override("font_color", Color(1.0, 0.95, 0.86, 0.99) if era_kingdom_overview else Color(0.88, 0.91, 0.97, 0.92))
			label.add_theme_color_override("font_shadow_color", Color(0.98, 0.72, 0.18, 0.18) if era_kingdom_overview else Color(0.0, 0.0, 0.0, 0.0))
			label.add_theme_constant_override("shadow_outline_size", 2 if era_kingdom_overview else 0)

	if title == "Approval" and MainSceneLogic._player_is_royal_bender(gs):
		var royal_tint:= MainSceneLogic._royal_bender_ui_tint_for_player(gs)
		label.add_theme_color_override("font_color", Color(
			lerp(1.0, royal_tint.r, 0.42),
			lerp(1.0, royal_tint.g, 0.42),
			lerp(1.0, royal_tint.b, 0.42),
			0.98
		))
		label.add_theme_color_override("font_shadow_color", Color(
			royal_tint.r,
			royal_tint.g,
			royal_tint.b,
			0.2
		))
		label.add_theme_constant_override("shadow_outline_size", 2)

	if vormir_overview:
		var panel:= PanelContainer.new()
		panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		panel.custom_minimum_size = Vector2(0, 72)
		panel.add_theme_stylebox_override("panel", MainSceneHelpers._standard_tab_make_vormir_panel_style("stat"))
		standard_tab_popup_right.add_child(panel)

		var margin:= MarginContainer.new()
		margin.add_theme_constant_override("margin_left", 12)
		margin.add_theme_constant_override("margin_top", 10)
		margin.add_theme_constant_override("margin_right", 12)
		margin.add_theme_constant_override("margin_bottom", 10)
		panel.add_child(margin)

		margin.add_child(row)
	else:
		standard_tab_popup_right.add_child(row)

	standard_tab_experience_rows.append({
		"title": title,
		"label": label,
		"bar": bar,
		"target": float(clamp(value, 0, max_value)),
		"danger": title == "Health" and value < 30
	})


func _build_standard_tab_experience(kind: String) -> void:
	if gs == null or gs.player == null or standard_tab_popup_right == null:
		return
	var p:= gs.player
	standard_tab_money_widgets.clear()
	match kind:
		"life":
			var life_lines:= [
				"Born in: %s, %s" % [p.birth_city, p.birth_country],
				"Lives in: %s, %s" % [p.home_city, p.home_country],
				"Social Class: %s" % str(p.social_class),
				"Fame Tier: %s" % str(p.fame_tier)
			]
			if p.is_royal:
				var succession_text:= "Current Ruler" if int(p.succession_rank) == 0 else "#%d" % int(p.succession_rank)
				life_lines.append("Royal Title: %s" % str(p.royal_title))
				life_lines.append("Succession: %s" % succession_text)
			_append_royal_court_lines(life_lines, p)
			_standard_tab_add_info_card("LIFE PULSE", life_lines)
			_standard_tab_add_money_card("BANK BALANCE", int(p.bank_balance))
			_standard_tab_add_live_stat_row("Health", int(p.health), 200)
			_standard_tab_add_live_stat_row("Mental", int(p.mental_health), 100)
			_standard_tab_add_live_stat_row("Happiness", int(p.satisfaction), 100)
			if p.is_royal:
				_standard_tab_add_live_stat_row("Approval", int(p.approval), 100)
		"career":
			_standard_tab_add_info_card("CAREER ENERGY", [
				"Current Role: %s" % (p.job if str(p.job) != "" else "Unemployed"),
				"Income: %s" % (gs.economy_engine.format_money(int(p.income)) if gs.economy_engine != null else "0"),
				"Performance: %d" % int(p.job_performance),
				"Experience: %d" % int(p.job_experience)
			])
			_standard_tab_add_money_card("BANK BALANCE", int(p.bank_balance))
			_standard_tab_add_live_stat_row("Mental", int(p.mental_health), 100)
			_standard_tab_add_live_stat_row("Happiness", int(p.satisfaction), 100)
		"school":
			var teachers: Array = []
			var classmates: Array = []
			if gs.school_engine != null:
				teachers = gs.school_engine.get_teachers_for(p)
				classmates = gs.school_engine.get_classmates(p)
			_standard_tab_add_info_card("SCHOOL ATMOSPHERE", [
				"Enrollment: %s" % ("Active" if p.school_name != "" else "Not Enrolled"),
				"Visible Teachers: %d" % teachers.size(),
				"Visible Classmates: %d" % classmates.size(),
				"Program: %s" % (p.education_level if str(p.education_level) != "" else "None")
			])
			_standard_tab_add_live_stat_row("Smarts", int(p.smarts), 100)
			_standard_tab_add_live_stat_row("Happiness", int(p.satisfaction), 100)
			_standard_tab_add_live_stat_row("Mental", int(p.mental_health), 100)
		"world":
			var world_lines:= [
				"Era: %s" % (gs.era.name if gs.era != null else "Unknown"),
				"Home: %s, %s" % [p.home_city, p.home_country],
				"Social Class: %s" % str(p.social_class),
				"Reality Mode: %s" % gs.get_reality_mode().capitalize()
			]
			if p.is_royal:
				world_lines.append("Royal Title: %s" % str(p.royal_title))
			_standard_tab_add_info_card("WORLD PRESENCE", world_lines)
			_standard_tab_add_live_stat_row("Fame", int(p.fame), 100)
			_standard_tab_add_live_stat_row("Looks", int(p.looks), 100)
		"life_assets":
			_build_life_assets_standard_tab()
		"property_portfolio":
			_build_property_portfolio_standard_tab()
		"property_portfolio_asset":
			_build_property_portfolio_asset_standard_tab()
		"vehicle_portfolio":
			_build_vehicle_portfolio_standard_tab()
		"vehicle_portfolio_asset":
			_build_vehicle_portfolio_asset_standard_tab()
		"other_country_overview":
			_build_other_country_overview_standard_tab()
		"era_property_market":
			_build_era_asset_market_standard_tab()
		"era_vehicle_market":
			_build_era_asset_market_standard_tab()
		_:
			_standard_tab_add_info_card("CURRENT STATE", [
				"Year: %s" % _format_year(gs.year),
				"Age: %d" % int(p.age),
				"Name: %s %s" % [p.first_name, p.last_name]
			])

func _build_other_country_overview_standard_tab() -> void:
	var payload: Dictionary = standard_tab_popup_payload
	var entry: Dictionary = payload.get("entry", {})
	var realm: Dictionary = payload.get("realm", {})
	var entry_name: String = str(payload.get("entry_name", "Country / Realm"))
	var entry_kind: String = str(payload.get("entry_kind", "realm"))
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges()
	var selected_browser_visual_theme: String = str(payload.get("selected_browser_visual_theme", realm.get("browser_visual_theme", ""))).strip_edges().to_lower()
	var selected_overview_visual_theme: String = str(payload.get("selected_overview_visual_theme", realm.get("overview_visual_theme", selected_browser_visual_theme))).strip_edges().to_lower()
	var is_era_kingdom: bool = entry_id == "era_kingdom"
	var is_terabithia: bool = entry_id == "terabithia" or selected_browser_visual_theme == "terabithia" or selected_overview_visual_theme == "terabithia"
	var is_vormir: bool = entry_id == "vormir" or selected_browser_visual_theme == "vormir" or selected_overview_visual_theme == "vormir"
	var is_nidavellir: bool = entry_id == "nidavellir" or selected_browser_visual_theme == "nidavellir" or selected_overview_visual_theme == "nidavellir"
	var is_imaginative_realm: bool = (entry_kind == "imaginative_realm" or realm_type == "imagination_bound")
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	if native_element == "" and selected_overview_visual_theme.begins_with("elemental_"):
		native_element = selected_overview_visual_theme.trim_prefix("elemental_")
	var is_elemental_realm: bool = native_element in ["air", "water", "earth", "fire"]
	var player_presence: Dictionary = MainSceneLogic._other_country_player_presence(gs, entry, realm)
	var is_player_current_place: bool = bool(player_presence.get("is_current_place", false))
	var terabithia_imagination_ratio: float = 0.0
	var terabithia_overview_bg_alpha: float = 0.985
	var terabithia_overview_border_alpha: float = 0.88
	var terabithia_overview_shadow_alpha: float = 0.34
	var terabithia_overview_shadow_size: int = 24
	var terabithia_clip_bg_alpha: float = 0.72
	var terabithia_clip_border_alpha: float = 0.22
	var terabithia_title_shadow_alpha: float = 0.24
	var terabithia_text_alpha: float = 0.96
	if is_terabithia:
		var raw_ratio: Variant = realm.get("imagination_ratio", -1.0)
		if float(raw_ratio) >= 0.0:
			terabithia_imagination_ratio = clampf(float(raw_ratio), 0.0, 1.0)
		elif gs != null and gs.player != null:
			terabithia_imagination_ratio = clampf(
				float(gs.player.imagination) / 100.0,
				0.0,
				1.0
			)
		terabithia_overview_bg_alpha = clampf(
			float(realm.get(
				"overview_aura_bg_alpha",
				lerpf(0.9, 0.985, terabithia_imagination_ratio)
			)),
			0.9,
			0.99
		)
		terabithia_overview_border_alpha = clampf(
			float(realm.get(
				"overview_border_alpha",
				lerpf(0.72, 0.96, terabithia_imagination_ratio)
			)),
			0.6,
			0.98
		)
		terabithia_overview_shadow_alpha = clampf(
			float(realm.get(
				"overview_aura_shadow_alpha",
				lerpf(0.22, 0.46, terabithia_imagination_ratio)
			)),
			0.18,
			0.52
		)
		terabithia_overview_shadow_size = max(
			16,
			int(round(float(realm.get(
				"overview_aura_shadow_size",
				18.0 + (terabithia_imagination_ratio * 16.0)
			))))
		)
		terabithia_clip_bg_alpha = clampf(
			float(realm.get(
				"overview_clip_bg_alpha",
				lerpf(0.56, 0.82, terabithia_imagination_ratio)
			)),
			0.48,
			0.86
		)
		terabithia_clip_border_alpha = clampf(
			float(realm.get(
				"overview_clip_border_alpha",
				lerpf(0.14, 0.34, terabithia_imagination_ratio)
			)),
			0.1,
			0.4
		)
		terabithia_title_shadow_alpha = clampf(
			float(realm.get(
				"overview_title_shadow_alpha",
				lerpf(0.14, 0.34, terabithia_imagination_ratio)
			)),
			0.1,
			0.4
		)
		terabithia_text_alpha = clampf(
			float(realm.get(
				"overview_text_alpha",
				lerpf(0.88, 0.99, terabithia_imagination_ratio)
			)),
			0.84,
			1.0
		)
	var subzones: Array = realm.get("subzones", [])
