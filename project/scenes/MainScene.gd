func _on_live_diagnostics_view_fix_requested() -> void:
	set_meta(
		"live_diagnostics_fix_preview_expanded",
		not bool(get_meta("live_diagnostics_fix_preview_expanded", false))
	)
	_request_live_diagnostics_force_frames(2, true)

func _on_live_diagnostics_apply_patch_requested() -> void:
	if gs == null:
		return
	var latest_auto_patch: Dictionary = {}
	if gs.runtime_health_registry != null:
		var auto_patches: Array = gs.runtime_health_registry.get_recent_auto_patches(1)
		if not auto_patches.is_empty() and typeof(auto_patches [auto_patches.size() - 1]) == TYPE_DICTIONARY:
			latest_auto_patch = auto_patches [auto_patches.size() - 1].duplicate(true)
	if latest_auto_patch.is_empty():
		return
	var patch_key: String = str(latest_auto_patch.get("patch_key", "")).strip_edges()
	if patch_key == "":
		return
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}
	var manual_state_raw: Variant = gs.scenario_state.get("manual_live_auto_patches", {})
	var manual_state: Dictionary = manual_state_raw if typeof(manual_state_raw) == TYPE_DICTIONARY else {}
	manual_state [patch_key] = {
		"applied": true,
		"time_ms": int(Time.get_ticks_msec()),
		"target_engine": str(latest_auto_patch.get("target_engine", "")),
		"target_function": str(latest_auto_patch.get("target_function", ""))
	}
	gs.scenario_state ["manual_live_auto_patches"] = manual_state
	match patch_key:
		"ui_frame_spike_live_diagnostics_throttle":
			set_meta("live_diagnostics_manual_throttle_enabled", true)
			live_diagnostics_refresh_accumulator = 0.0
			_request_live_diagnostics_force_frames(3, true)
	if gs.runtime_health_registry != null:
		gs.runtime_health_registry.record_mitigation({
			"action": "manual_live_patch_apply",
			"source": "live_diagnostics_panel",
			"patch_key": patch_key,
			"safe": true
		})
	_refresh_live_diagnostics_panel(0.0)



func _animate_age_up_loading_overlay(delta: float) -> void:
	if age_up_loading_overlay == null or not age_up_loading_overlay.visible:
		return
	var anim_delta: float = min(delta, 0.025)
	age_up_loading_message_elapsed += anim_delta
	age_up_loading_ring_elapsed += anim_delta
	age_up_loading_heartbeat_elapsed += anim_delta
	age_up_loading_shimmer_elapsed += anim_delta
	age_up_loading_eralife_type_elapsed += anim_delta
	var stall_score: float = _get_cached_age_up_loading_stall_score()
	var pulse_strength: float = clamp(
		0.14 + ((sin(age_up_loading_heartbeat_elapsed * 1.75) +
		1.0) * 0.18) + (stall_score * 0.0012),
		0.0,
		1.0
	)
	var card_breathe: float = 0.5 + (0.5 *
	sin(age_up_loading_shimmer_elapsed * 0.46))
	var bg_phase: float = age_up_loading_shimmer_elapsed * 0.028
	var visual_bucket: int = int(floor(age_up_loading_shimmer_elapsed * AGE_UP_LOADING_VISUAL_BUCKET_HZ))
	var last_visual_bucket: int = int(get_meta("age_up_loading_visual_bucket", -1))
	var bucket_changed: bool = visual_bucket != last_visual_bucket
	if bucket_changed:
		set_meta("age_up_loading_visual_bucket", visual_bucket)
	var material_bucket: int = int(floor(age_up_loading_shimmer_elapsed * 4.0))
	var last_material_bucket: int = int(get_meta("age_up_loading_material_bucket", -1))
	var material_bucket_changed: bool = material_bucket != last_material_bucket
	if material_bucket_changed:
		set_meta("age_up_loading_material_bucket",
		material_bucket)

	var border_theme: Dictionary = _get_cached_age_up_loading_border_theme()
	var core: Color = border_theme.get("core", Color(1.0, 1.0, 1.0,
	1.0))
	var bg_color_a: Color = core.lerp(Color(0.09, 0.1, 0.16, 1.0),
	0.6)
	var bg_color_b: Color = core.lerp(Color(0.15, 0.09, 0.14, 1.0),
	0.64)
	var bg_mix: float = 0.5 + (0.5 * sin(bg_phase))
	var bg_final: Color = bg_color_a.lerp(bg_color_b, bg_mix)
	var bright: Color = core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.28 +
	pulse_strength * 0.2)
	var radiant: Color = bright.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.16 +
	pulse_strength * 0.14)
	var subtitle_color: Color = Color(1.0, 1.0, 1.0, 0.92)
	var phase_color: Color = core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.54)
	var footer_color: Color = Color(1.0, 1.0, 1.0, 0.78)
	var particle_color: Color = Color(bright.r, bright.g, bright.b,
	0.52)
	var did_you_know_body_color: Color = Color(
		min(1.0, 0.92 + core.r * 0.06),
		min(1.0, 0.93 + core.g * 0.06),
		1.0,
		0.96
	)
	var title_scale: Vector2 = Vector2.ONE * (1.0 + pulse_strength *
	0.022)
	var ring_scale: Vector2 = Vector2.ONE * (1.02 + pulse_strength *
	0.1)
	var did_you_know_heading_scale: Vector2 = Vector2.ONE * (1.0
	+ pulse_strength * 0.02)

	if material_bucket_changed and age_up_loading_card != null:
		_apply_cached_era_surface_panel_style(
			age_up_loading_card,
			"panel",
			"age_up_loading_card",
			"main",
			false,
			clamp(0.26 + pulse_strength * 0.92, 0.0, 1.0),
			false
		)

	if material_bucket_changed and age_up_loading_title != null:
		_apply_cached_theme_color_override(
			age_up_loading_title,
			"font_color",
			"age_up_loading_title",
			radiant
		)

	if age_up_loading_title != null:
		_apply_cached_control_scale(
			age_up_loading_title,
			"age_up_loading_title",
			title_scale
		)

	if material_bucket_changed and age_up_loading_subtitle != null:
		_apply_cached_theme_color_override(
			age_up_loading_subtitle,
			"font_color",
			"age_up_loading_subtitle",
			subtitle_color
		)

	if material_bucket_changed and age_up_loading_phase_label != null:
		_apply_cached_theme_color_override(
			age_up_loading_phase_label,
			"font_color",
			"age_up_loading_phase_label",
			phase_color
		)

	if material_bucket_changed and age_up_loading_footer != null:
		_apply_cached_theme_color_override(
			age_up_loading_footer,
			"font_color",
			"age_up_loading_footer",
			footer_color
		)

	if material_bucket_changed and age_up_loading_particles != null:
		_apply_cached_theme_color_override(
			age_up_loading_particles,
			"font_color",
			"age_up_loading_particles",
			particle_color
		)

	var ring_frames: Array = ["◴", "◷", "◶", "◵"]
	if age_up_loading_ring != null:
		var ring_index: int = int(floor(age_up_loading_ring_elapsed *
		5.0)) % ring_frames.size()
		age_up_loading_ring.text = str(ring_frames [ring_index])
		_apply_cached_control_scale(
			age_up_loading_ring,
			"age_up_loading_ring",
			ring_scale
		)
		if material_bucket_changed:
			_apply_cached_theme_color_override(
				age_up_loading_ring,
				"font_color",
				"age_up_loading_ring",
				radiant
			)

	if age_up_loading_particles != null:
		var particle_position: Vector2 = Vector2(sin(age_up_loading_ring_elapsed * 0.72) * 10.0, 0.0)
		_apply_cached_control_position(
			age_up_loading_particles,
			"age_up_loading_particles",
			particle_position,
			4
		)

	if age_up_loading_shimmer != null and age_up_loading_card != null:
		var width: float = max(age_up_loading_card.size.x,
		age_up_loading_card.custom_minimum_size.x)
		var shimmer_width: float = max(width * 0.22, 180.0)
		var shimmer_target_size: Vector2 = Vector2(shimmer_width, 4.0)
		if age_up_loading_shimmer.size != shimmer_target_size:
			age_up_loading_shimmer.size = shimmer_target_size
		var shimmer_position: Vector2 = Vector2(
			fmod(age_up_loading_shimmer_elapsed * 115.0, width +
			shimmer_width) - shimmer_width,
			0.0
		)
		_apply_cached_control_position(
			age_up_loading_shimmer,
			"age_up_loading_shimmer",
			shimmer_position,
			1
		)
		_apply_cached_color_rect_color(
			age_up_loading_shimmer,
			"age_up_loading_shimmer",
			Color(bright.r, bright.g, bright.b, 0.05 + pulse_strength * 0.06),
			96
		)

	if age_up_loading_dim != null:
		_apply_cached_color_rect_color(
			age_up_loading_dim,
			"age_up_loading_dim",
			Color(
				clamp(bg_final.r * 0.46, 0.0, 0.28),
				clamp(bg_final.g * 0.46, 0.0, 0.28),
				clamp(bg_final.b * 0.5, 0.0, 0.32),
				0.965
			),
			64
		)

	if age_up_loading_flash != null:
		var flash_mix: float = 0.5 + (0.5 * sin(bg_phase * 0.42 +
		0.25))
		var flash_color: Color = bg_final.lerp(core, 0.1 + flash_mix
		* 0.05)
		_apply_cached_color_rect_color(
			age_up_loading_flash,
			"age_up_loading_flash",
			Color(
				flash_color.r,
				flash_color.g,
				flash_color.b,
