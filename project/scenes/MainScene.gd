func _update_rick_weapon_shop_hud(
	sync_layering: bool = true
) -> void:
	_ensure_rick_weapon_shop_hud()

	if (
		rick_weapon_shop_hud_button == null
		or not is_instance_valid(
			rick_weapon_shop_hud_button
		)
	):
		return

	if _spawn_ready_runtime_hud_shell_layering_active():
		var spawn_ready_snapshot: Dictionary = (
			_spawn_ready_runtime_hud_visibility_snapshot()
		)
		var shell_show_shop: bool = bool(
			spawn_ready_snapshot.get(
				"rick_weapon_shop_button_visible",
				spawn_ready_snapshot.get(
					"rick_weapon_shop_available",
					MainSceneLogic._rick_weapon_shop_hub_available_shell_safe(gs)
				)
			)
		)

		_apply_zero_frame_hud_button_shell(
			rick_weapon_shop_hud_button,
			shell_show_shop
		)

		if shell_show_shop:
			var shell_pulse: float = (
				(
					sin(
						rick_weapon_shop_hud_breathe_time * 2.1
					)
					+ 1.0
				)
				* 0.5
			)
			MainSceneLogic._style_rick_weapon_shop_button(
				rick_weapon_shop_hud_button,
				shell_pulse
			)

		if sync_layering:
			_sync_runtime_floating_hud_layering_for_spawn_shell(
				"rick_weapon_shop_hud_spawn_shell_grace"
			)

		return

	var hard_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or (
			belongings_item_popup != null
			and is_instance_valid(
				belongings_item_popup
			)
			and belongings_item_popup.visible
		)
		or (
			belongings_item_target_popup != null
			and is_instance_valid(
				belongings_item_target_popup
			)
			and belongings_item_target_popup.visible
		)
		or (
			ui_contract_surface_panel != null
			and is_instance_valid(
				ui_contract_surface_panel
			)
			and ui_contract_surface_panel.visible
		)
		or (
			rick_weapon_shop_popup != null
			and is_instance_valid(
				rick_weapon_shop_popup
			)
			and rick_weapon_shop_popup.visible
		)
		or (
			boxing_hub_popup != null
			and is_instance_valid(
				boxing_hub_popup
			)
			and boxing_hub_popup.visible
		)
		or (
			crown_hub_overlay != null
			and is_instance_valid(
				crown_hub_overlay
			)
			and crown_hub_overlay.visible
		)
		or (
			crown_action_popup != null
			and is_instance_valid(
				crown_action_popup
			)
			and crown_action_popup.visible
		)
	)
	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
	)
	var runtime_hud_snapshot: Dictionary = {}
	var snapshot_matches_actor: bool = false
	var contract_show_shop: bool = false

	if (
		gs != null
		and gs.player != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		runtime_hud_snapshot = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		)
		var snapshot_actor_id: int = int(
			runtime_hud_snapshot.get(
				"controlled_actor_id",
				runtime_hud_snapshot.get(
					"player_id",
					runtime_hud_snapshot.get(
						"actor_id",
						-1
					)
				)
			)
		)
		snapshot_matches_actor = (
			snapshot_actor_id <= 0
			or snapshot_actor_id == int(
				gs.player.id
			)
		)

		if snapshot_matches_actor:
			contract_show_shop = bool(
				runtime_hud_snapshot.get(
					"rick_weapon_shop_button_visible",
					runtime_hud_snapshot.get(
						"rick_weapon_shop_available",
						(
							bool(
								gs.player.alive
							)
							and float(
								gs.player.health
							) > 0.0
							and int(
								gs.player.age
							) >= 16
						)
					)
				)
			)

	if (
		gs != null
		and gs.player != null
		and not snapshot_matches_actor
	):
		contract_show_shop = (
			bool(
				gs.player.alive
			)
			and float(
				gs.player.health
			) > 0.0
			and int(
				gs.player.age
			) >= 16
		)

	var show_shop: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not hard_modal_blocker
		and not blocked_by_age_up_loading
		and _runtime_floating_hud_buttons_should_render_on_current_surface()
		and contract_show_shop
	)

	_apply_zero_frame_hud_button_shell(
		rick_weapon_shop_hud_button,
		show_shop
	)

	if show_shop:
		var pulse: float = (
			(
				sin(
					rick_weapon_shop_hud_breathe_time * 2.1
				)
				+ 1.0
			)
			* 0.5
		)
		MainSceneLogic._style_rick_weapon_shop_button(
			rick_weapon_shop_hud_button,
			pulse
		)

	if sync_layering:
		_sync_runtime_floating_hud_layering()
func _animate_rick_weapon_shop_hud(delta: float) -> void:
	rick_weapon_shop_hud_breathe_time += delta
	_tick_rick_weapon_shop_live(delta)

	if rick_weapon_shop_popup_open:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var next_update_ms: int = int(get_meta("rick_weapon_shop_hud_next_update_ms", 0))

	if now_ms >= next_update_ms:
		set_meta("rick_weapon_shop_hud_next_update_ms", now_ms + 220)
		_update_rick_weapon_shop_hud(false)
		return

	if rick_weapon_shop_hud_button != null and rick_weapon_shop_hud_button.visible:
		var pulse: float = (sin(rick_weapon_shop_hud_breathe_time * 2.1) + 1.0) * 0.5
		MainSceneLogic._style_rick_weapon_shop_button(rick_weapon_shop_hud_button, pulse)
func _style_food_lifestyle_button(button: Button, surface_id: String, icon: String, tooltip: String, pulse: float) -> void:
	if button == null or not is_instance_valid(button):
		return

	var core: Color = _food_lifestyle_core_color(surface_id)
	var style_key: String = "%s_lifestyle_button_style" % surface_id
	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(button, style_key, 2, 16)
	if btn_style == null:
		return

	button.text = icon
	button.tooltip_text = tooltip
	button.add_theme_font_size_override("font_size", 28)
	button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))

	btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.12))
	btn_style.border_color = Color(core.r, core.g, core.b, 0.56 + (pulse * 0.28))
	button.add_theme_stylebox_override("normal", btn_style)
	button.add_theme_stylebox_override("hover", btn_style)
	button.add_theme_stylebox_override("pressed", btn_style)

func _request_runtime_engine_method_intent(
	engine_property: String,
	method_name: String,
	args: Array,
	action_id: String,
	source: String,
	runtime_authority_prevalidated: bool = false
) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}




	if (
		action_id
		== "service_zero_frame_age_up_tail_quantum"
		and engine_property == "life_engine"
		and method_name
		== "continue_zero_frame_age_up_tail_runtime"
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
		and bool(
			gs.scenario_state.get(
				"age_up_tail_runtime_autonomous_service_owned",
				false
			)
		)
	):
		var tail_pending: bool = bool(
			gs.scenario_state.get(
				"age_up_tail_runtime_pending",
				false
			)
		)

		return {
			"success": true,
			"mode": "autonomous_runtime_observation",
			"result": {
				"success": true,
				"mode": "life_engine_autonomous_tail_owned",
				"is_complete": not tail_pending,
				"step_report": {
					"current_phase": str(
						gs.scenario_state.get(
							"age_up_tail_last_phase",
							"running"
						)
					)
				},
				"service_owner": "life_engine_autonomous",
				"idle_required": false,
				"ui_activity_is_scheduler_input": false
			},
			"renderer_called_engine_directly": false,
			"global_intent_routed": false,
			"runtime_authority_prevalidated": true,
		}

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": MainSceneLogic._global_intent_current_actor_id(gs),
			"target_id": MainSceneLogic._global_intent_current_actor_id(gs),
			"intent_type": "runtime_engine_method_intent",
			"surface_id": current_panel,
			"action_id": action_id,
			"payload": {
				"source": source,
				"ui_is_expression_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": engine_property,
				"method": method_name,
				"args": args,
				"pass_actor_payload": false
			},
			"source": source,
			"immutable_contract_references": true,
			"skip_crr_observation": true,
			"skip_global_intent_persistence": true,
			"ephemeral_infrastructure_intent": true,
			"global_intent_duplicate_suppression_allowed": false,
			"authority_prevalidated": runtime_authority_prevalidated,
			"skip_checks_and_balances": runtime_authority_prevalidated,
			"ui_is_expression_only": true
		},
		{
			"surface_id": current_panel,
			"action_id": action_id,
			"source": source,
			"skip_crr_observation": true,
			"skip_global_intent_persistence": true,
			"ephemeral_infrastructure_intent": true,
			"authority_prevalidated": runtime_authority_prevalidated,
			"skip_checks_and_balances": runtime_authority_prevalidated,
			"ui_is_expression_only": true
		}
	)

	var routed_report: Dictionary = (
		MainSceneHelpers._reality_residency_route_result(
			report
		)
	)

	routed_report [
		"renderer_called_engine_directly"
	] = false

	routed_report [
		"global_intent_routed"
	] = true

	routed_report [
		"runtime_authority_prevalidated"
	] = runtime_authority_prevalidated

	return routed_report
func _update_food_lifestyle_hud() -> void:
	_ensure_food_lifestyle_hud()

	if not MainSceneLogic._food_lifestyle_era_supports_modern_future_hubs(_food_lifestyle_current_era_name_for_mainscene()):
		_enforce_food_lifestyle_hud_era_gate_zero_frame("update_food_lifestyle_hud")
		_update_rick_weapon_shop_hud(false)
		_sync_runtime_floating_hud_layering()
		return
	if food_lifestyle_hud_button == null or restaurant_lifestyle_hud_button == null:
		return

	var has_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or (profile_panel_popup != null and profile_panel_popup.visible)
		or (belongings_item_popup != null and belongings_item_popup.visible)
		or (belongings_item_target_popup != null and belongings_item_target_popup.visible)
		or (crown_hub_overlay != null and crown_hub_overlay.visible)
		or (crown_action_popup != null and crown_action_popup.visible)
		or (ui_contract_surface_panel != null and ui_contract_surface_panel.visible)
		or (rick_weapon_shop_popup != null and rick_weapon_shop_popup.visible)
	)

	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(get_meta("age_up_transition_busy", false))
	)

	var allow_embedded_life_view: bool = current_panel == "" or current_panel == "life"
	var surface_allows_runtime_buttons: bool = _runtime_floating_hud_buttons_should_render_on_current_surface()

	var base_visible: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not has_modal_blocker
		and not blocked_by_age_up_loading
		and allow_embedded_life_view
		and surface_allows_runtime_buttons
	)

