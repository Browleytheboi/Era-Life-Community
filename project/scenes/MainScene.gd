			now_ms + 240
		)
	else:
		set_meta(
			"live_diagnostics_manual_throttle_enabled",
			false
		)
		set_meta(
			"live_diagnostics_post_overlay_restore_frames",
			maxi(
				int(
					get_meta(
						"live_diagnostics_post_overlay_restore_frames",
						0
					)
				),
				2
			)
		)
		set_meta(
			"live_diagnostics_post_overlay_restore_until_ms",
			now_ms + 60
		)

	if post_loading_finalize or birth_shell_safe_release:
		current_panel = ""

	if output_label != null and is_instance_valid(output_label):
