func _death_transition_audio_path() -> String:
	for raw_path in MainSceneHelpers._death_transition_audio_candidate_paths():
		var path: String = str(raw_path).strip_edges()
		if path == "":
			continue
		if ResourceLoader.exists(path):
			set_meta("death_transition_audio_resolved_path", path)
			return path

	set_meta("death_transition_audio_missing_candidate_paths", MainSceneHelpers._death_transition_audio_candidate_paths().duplicate(true))
	return "res://audio/music/Death.ogg"


func _ensure_death_transition_audio_track_registered() -> void:
	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var tracks_raw: Variant = era_audio_contract.get("tracks", {})
	var tracks: Dictionary = tracks_raw if typeof(tracks_raw) == TYPE_DICTIONARY else {}

	var context_routes_raw: Variant = era_audio_contract.get("context_routes", {})
	var context_routes: Dictionary = context_routes_raw if typeof(context_routes_raw) == TYPE_DICTIONARY else {}

	var presentation_routes_raw: Variant = era_audio_contract.get("presentation_routes", {})
	var presentation_routes: Dictionary = presentation_routes_raw if typeof(presentation_routes_raw) == TYPE_DICTIONARY else {}

	tracks ["death_transition"] = {
		"id": "death_transition",
		"display_name": "Death",
		"path": _death_transition_audio_path(),
		"context_keys": ["death_transition", "afterlife_death_prompt", "you_died_panel", "death_panel"],
		"loop": true,
		"volume_db": -8.0,
		"fade_ms": 0,
		"bus": "Master"
	}

	for route_key in ["death_transition", "afterlife_death_prompt", "you_died_panel", "death_panel"]:
		context_routes [route_key] = "death_transition"
		presentation_routes [route_key] = "death_transition"

	era_audio_contract ["tracks"] = tracks
	era_audio_contract ["context_routes"] = context_routes
	era_audio_contract ["presentation_routes"] = presentation_routes


func _death_transition_audio_context(result: Dictionary, reason: String, force_restart: bool) -> Dictionary:
	var player_id_value: int = 0
	var year_value: int = 0
	var era_key: String = ""
	var era_name: String = ""
	var death_cause: String = ""

	if gs != null:
		year_value = int(gs.year)

		if gs.player != null:
			player_id_value = int(gs.player.id)
			death_cause = str(gs.player.cause_of_death).strip_edges()

		if typeof(gs.afterlife_state) == TYPE_DICTIONARY and not gs.afterlife_state.is_empty():
			player_id_value = int(gs.afterlife_state.get("ghost_player_id", player_id_value))
			death_cause = str(gs.afterlife_state.get("death_cause", death_cause)).strip_edges()

		if gs.era != null:
			era_key = _current_era_ui_theme_key()
			var era_raw: Variant = gs.era
			if typeof(era_raw) == TYPE_DICTIONARY:
				era_name = str((era_raw as Dictionary).get("name", ""))
			else:
				era_name = str(gs.era.name)

	return {
		"context_key": "death_transition",
		"context_name": "YOU DIED",
		"surface_id": "you_died_panel",
		"panel_id": "afterlife_death_prompt",
		"era_key": era_key,
		"era_name": era_name,
		"year": year_value,
		"player_id": player_id_value,
		"current_panel": current_panel,
		"source": "death_transition_audio",
		"reason": reason,
		"death_result_type": str(result.get("type", "")),
		"death_cause": death_cause,
		"audio_fade_ms": 0,
		"audio_volume_db": -8.0,
		"audio_restart_policy": "force_from_beginning" if force_restart else "preserve_current",
		"force_restart_audio": force_restart,
		"audio_force_restart": force_restart
	}


func _death_transition_audio_owns_contract() -> bool:
	if bool(get_meta("death_transition_audio_active", false)):
		return true

	if era_audio_engine == null or not is_instance_valid(era_audio_engine):
		return false

	if str(era_audio_engine.current_track_id).strip_edges() != "death_transition":
		return false

	if era_audio_engine.current_player == null or not is_instance_valid(era_audio_engine.current_player):
		return false

	return era_audio_engine.current_player.playing


func _claim_death_transition_audio_contract(result: Dictionary, reason: String = "afterlife_death_prompt", force_restart: bool = false) -> void:
	if not era_audio_enabled:
		return

	_ensure_death_transition_audio_track_registered()

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	var current_is_death: bool = str(engine.current_track_id).strip_edges() == "death_transition" \
and engine.current_player != null \
and is_instance_valid(engine.current_player) \
and engine.current_player.playing

	var should_restart: bool = force_restart or not current_is_death

	if should_restart:
		if engine.has_method("hard_stop_all"):
			engine.call("hard_stop_all", "death_transition_claim_%s" % reason, {
				"source": "death_transition_audio",
				"reason": reason
			})
		else:
			engine.release_audio_contract("death_transition_claim_%s" % reason, 0, {
				"source": "death_transition_audio",
				"reason": reason
			})

	var context: Dictionary = _death_transition_audio_context(result, reason, should_restart)
	var report: Dictionary = engine.apply_audio_contract(era_audio_contract, context)

	set_meta("death_transition_audio_active", bool(report.get("success", false)))
	set_meta("death_transition_audio_owner", "you_died_panel")
	set_meta("death_transition_audio_reason", reason)
	set_meta("death_transition_audio_claimed_at_ms", int(Time.get_ticks_msec()))
	set_meta("death_transition_audio_last_report", report.duplicate(true))
	set_meta("death_transition_audio_blocks_era_music", true)
	set_meta("era_audio_retry_after_ms", 0)

	era_audio_last_signature = ""
	era_audio_next_sync_ms = 0

	set_meta("grocery_store_music_active", false)
	set_meta("grocery_store_music_active_store_id", "")

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["death_transition_audio_active"] = bool(report.get("success", false))
		gs.scenario_state ["death_transition_audio_owner"] = "you_died_panel"
		gs.scenario_state ["death_transition_audio_reason"] = reason
		gs.scenario_state ["death_transition_audio_claimed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["death_transition_audio_last_report"] = report.duplicate(true)
		gs.scenario_state ["death_transition_audio_blocks_era_music"] = true


func _terminate_death_transition_audio_for_world_seed_exit(reason: String = "world_seed_exit", restart_era_audio_after_release: bool = false) -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("death_transition_audio_active", false)
	set_meta("death_transition_audio_blocks_era_music", false)
	set_meta("death_transition_audio_terminated_reason", reason)
	set_meta("death_transition_audio_terminated_at_ms", now_ms)
	set_meta("death_transition_audio_owner", "")

	if era_audio_engine != null and is_instance_valid(era_audio_engine):
		if era_audio_engine.has_method("hard_stop_all"):
			era_audio_engine.call("hard_stop_all", "death_transition_terminated_%s" % reason, {
				"source": "death_transition_audio",
				"reason": reason
			})
		else:
			era_audio_engine.release_audio_contract("death_transition_terminated_%s" % reason, 0, {
				"source": "death_transition_audio",
				"reason": reason
			})

	era_audio_last_signature = ""
	era_audio_next_sync_ms = 0

	set_meta("era_audio_retry_after_ms", 0)
	set_meta("grocery_store_music_active", false)
	set_meta("grocery_store_music_active_store_id", "")
	set_meta("god_mode_audio_handoff_armed", false)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["death_transition_audio_active"] = false
		gs.scenario_state ["death_transition_audio_blocks_era_music"] = false
		gs.scenario_state ["death_transition_audio_terminated_reason"] = reason
		gs.scenario_state ["death_transition_audio_terminated_at_ms"] = now_ms

	if restart_era_audio_after_release:
		call_deferred("_sync_era_audio_contract_from_current_world", "%s_death_audio_released" % reason)


func _death_transition_audio_playable_life_ui_ready() -> bool:
	if gs == null or gs.player == null:
		return false

	if not bool(gs.player.alive):
		return false

	if bool(gs.awaiting_new_life):
		return false

	if bool(gs.afterlife_active):
		return false

	if _god_mode_or_menu_presentation_active():
		return false

	if bool(get_meta("startup_live_shell_loading", false)):
		return false

	if bool(get_meta("age_up_post_loading_finalize_pending", false)):
		return false

	if bool(get_meta("age_up_loading_runtime_begin_pending", false)):
		return false

	if age_up_loading_runtime_active:
		return false

	if age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible:
		return false

	if death_transition_popup != null and is_instance_valid(death_transition_popup) and death_transition_popup.visible:
		return false

	if afterlife_overlay != null and is_instance_valid(afterlife_overlay) and afterlife_overlay.visible:
		return false

	var root:= get_node_or_null("UIContainer") as Control
	if root == null or not is_instance_valid(root) or not root.visible:
		return false

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay) or not player_stats_overlay.visible:
		return false

	return true


func _release_death_transition_audio_after_playable_life_control(
	reason: String = "playable_life_control",
	attempt: int = 0
) -> void:
	if not _death_transition_audio_owns_contract():
		return

	var continuation_lens_ready: bool = false

	if (
		reason == "continue_lineage_complete"
		and gs != null
		and gs.player != null
		and bool(gs.player.alive)
		and not bool(gs.afterlife_active)
		and not bool(gs.awaiting_new_life)
	):
		var controlled_actor_id: int = int(
			gs.player.id
		)
		var handoff_actor_id: int = int(
			get_meta(
				"continue_lineage_visible_handoff_actor_id",
				-1
			)
		)
		var native_switch_lens_finalized: bool = bool(
			get_meta(
				"continue_lineage_visible_handoff_native_switch_lens_finalized",
				false
			)
		)

		continuation_lens_ready = (
			controlled_actor_id > 0
			and handoff_actor_id == controlled_actor_id
			and bool(
				get_meta(
					"continue_lineage_visible_handoff_complete",
					false
				)
			)
			and native_switch_lens_finalized
		)

	if (
		continuation_lens_ready
		or _death_transition_audio_playable_life_ui_ready()
	):
		_terminate_death_transition_audio_for_world_seed_exit(
			"%s_playable_life_control" % reason,
			false
		)
		call_deferred(
			"_sync_era_audio_contract_from_current_world",
			"%s_live_era_music_resume" % reason
		)
		return

	if attempt >= 90:
		set_meta(
			"death_transition_audio_waiting_for_playable_ui_release",
			true
		)
		set_meta(
			"death_transition_audio_waiting_for_playable_ui_reason",
			reason
		)
		set_meta(
			"death_transition_audio_waiting_for_playable_ui_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	var tree:= get_tree()
	if tree == null:
		return

	var timer:= tree.create_timer(0.05)
	timer.timeout.connect(
		Callable(
			self,
			"_release_death_transition_audio_after_playable_life_control"
		).bind(
			reason,
			attempt + 1
		),
		CONNECT_ONE_SHOT
	)
func _ensure_self_checkout_prompt_audio_player() -> AudioStreamPlayer:
