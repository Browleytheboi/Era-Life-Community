func _format_belonging_money_value(amount: int) -> String:
	if gs != null and gs.economy_engine != null:
		return gs.economy_engine.format_money(amount)

	var value: int = int(amount)
	var sign_text: String = ""
	if value < 0:
		sign_text = "-"
		value = abs(value)

	var raw_text: String = str(value)
	var out: String = ""
	var counter: int = 0

	for i in range(raw_text.length() - 1, -1, -1):
		if counter > 0 and counter % 3 == 0:
			out = "," + out
		out = raw_text.substr(i, 1) + out
		counter += 1

	return "%s$%s" % [sign_text, out]


func _build_belongings_hud_meta_text(item: Dictionary) -> String:
	var meta_parts: Array = []

	var item_type: String = str(item.get("type", item.get("subtype", ""))).strip_edges()
	if item_type != "":
		meta_parts.append(item_type)

	var market_profile: Dictionary = MainSceneLogic._resolve_belonging_market_profile(gs, item)
	if not market_profile.is_empty():
		var current_value: int = int(market_profile.get("current_value", 0))
		if current_value > 0:
			meta_parts.append(_format_belonging_money_value(current_value))

		var annual_appreciation_rate: float = float(market_profile.get("annual_appreciation_rate", 0.0))
		if annual_appreciation_rate > 0.0:
			meta_parts.append("▲ %.1f%%/yr" % (annual_appreciation_rate * 100.0))
	else:
		var resolved_item_value: int = int(item.get("value", -1))
		if resolved_item_value <= 0 and item.has("worth"):
			resolved_item_value = int(item.get("worth", 0))
		if resolved_item_value <= 0 and item.has("price"):
			resolved_item_value = int(item.get("price", 0))
		if resolved_item_value <= 0 and item.has("estimated_value"):
			resolved_item_value = int(item.get("estimated_value", 0))
		if resolved_item_value > 0:
			meta_parts.append(_format_belonging_money_value(resolved_item_value))

	var origin_era: String = str(item.get("origin_era", item.get("era_name", ""))).strip_edges()
	if origin_era != "":
		meta_parts.append(origin_era)

	var acquired_year: int = int(item.get("acquired_year", 0))
	if acquired_year == 0 and typeof(item.get("provenance", {})) == TYPE_DICTIONARY:
		var provenance: Dictionary = item.get("provenance", {})
		acquired_year = int(provenance.get("acquired_year", 0))
	if acquired_year != 0:
		meta_parts.append("Year %d" % acquired_year)

	var meta_text:= ""
	for i in range(meta_parts.size()):
		if i > 0:
			meta_text += " • "
		meta_text += str(meta_parts [i])

	return meta_text
func _build_belongings_category_header_text(category: String, items: Array) -> String:
	var total_worth: int = 0

	for raw_item in items:
		if typeof(raw_item) != TYPE_DICTIONARY:
			continue

		var item: Dictionary = raw_item
		var market_profile: Dictionary = MainSceneLogic._resolve_belonging_market_profile(gs, item)

		if not market_profile.is_empty():
			total_worth += int(market_profile.get("current_value", 0))
			continue

		var resolved_item_value: int = int(item.get("value", -1))
		if resolved_item_value <= 0 and item.has("worth"):
			resolved_item_value = int(item.get("worth", 0))
		if resolved_item_value <= 0 and item.has("price"):
			resolved_item_value = int(item.get("price", 0))
		if resolved_item_value <= 0 and item.has("estimated_value"):
			resolved_item_value = int(item.get("estimated_value", 0))

		if resolved_item_value > 0:
			total_worth += resolved_item_value

	if total_worth > 0:
		return "%s • %s" % [category, _format_belonging_money_value(total_worth)]

	return category
