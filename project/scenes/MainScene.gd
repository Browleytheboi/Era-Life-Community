func _power_hub_mutation_rows(actor: Person) -> Array:
	if gs == null or gs.power_engine == null or not gs.power_engine.has_method("get_mutated_ability_rows"):
		return []

	var mutation_rows: Array = gs.power_engine.get_mutated_ability_rows(actor, {
		"source": "power_hub"
	})
	var out: Array = []

	for raw_mutation in mutation_rows:
		if typeof(raw_mutation) != TYPE_DICTIONARY:
			continue

		var mutation: Dictionary = _superpower_hub_safe_dictionary(raw_mutation)
		var mutation_id: String = str(mutation.get("id", "mutation"))
		var display_name: String = str(mutation.get("display_name", mutation.get("label", "Mutation")))
		var unlocked_bending_count: int = int(mutation.get("unlocked_bending_ability_count", 0))
		var intentional_locked: bool = bool(mutation.get("intentional_use_locked", unlocked_bending_count <= 0))

		out.append({
			"id": mutation_id,
			"label": "%s • Power %d • Guard %d" % [
				display_name,
				int(mutation.get("power", 0)),
				int(mutation.get("guard", 0))
			],
			"description": "%s mutation from %s%s" % [
				str(mutation.get("element", "elemental")).capitalize(),
				str(mutation.get("power_display_name", mutation.get("power_id", "power"))),
				" • intentional use locked" if intentional_locked else ""
			],
			"overview_title": display_name,
			"overview_lines": [
				"Mutation: %s" % display_name,
				"Element: %s" % str(mutation.get("element", "elemental")).capitalize(),
				"Power Source: %s" % str(mutation.get("power_display_name", mutation.get("power_id", "power"))),
				"Power: %d" % int(mutation.get("power", 0)),
				"Guard: %d" % int(mutation.get("guard", 0)),
				"Unlocked bending moves: %d" % unlocked_bending_count,
				"Intentional Use: %s" % ("Locked until at least one bending move is unlocked." if intentional_locked else "Unlocked."),
				"Uncontrolled Mutation Risk: Still eligible for age-up surge logic if the contract marks it unstable."
			],
			"actions": [
				{
					"id": "activate_%s" % mutation_id,
					"label": "Use Mutation",
					"engine_property": "power_engine",
					"method": "resolve_power_action",
					"requires_power_action_panel": true,
					"disabled": intentional_locked,
					"disabled_reason": "Unlock at least one bending move before intentionally using this mutation.",
					"payload": {
						"action": "activate_mutation",
						"mutation_id": mutation_id,
						"source": "power_hub",
						"requires_power_action_panel": true
					},
					"refresh_after": true
				}
			]
		})

	return out


