func _get_panel_transition_surface_for_key(panel_key: String) -> Control:
	match panel_key:
		"profile":
			if profile_panel_card != null:
				return profile_panel_card
			return profile_panel_popup
		"life":
			if standard_tab_popup_card != null:
				return standard_tab_popup_card
			return standard_tab_popup
		"career", "school", "relationships":
			if institution_hub_card != null:
				return institution_hub_card
			return institution_hub_overlay
		"activities":
			if activities_action_panel != null and activities_action_panel.get_child_count() > 0:
				return activities_action_panel.get_child(0) as Control
			return activities_action_panel
		"world":
			if world_feed_popup_card != null:
				return world_feed_popup_card
			return world_feed_popup
		"mods":
			return mod_menu_panel
		_:
			return null

func _restore_panel_transition_surface(surface: Control) -> void:
	if surface == null:
		return
	MainSceneHelpers._prime_panel_transition_surface(surface)
	var base_position = surface.get_meta("ui_panel_transition_base_position", surface.position)
	var base_scale = surface.get_meta("ui_panel_transition_base_scale", Vector2.ONE)
	surface.position = base_position
	surface.scale = base_scale
	surface.modulate = Color(1.0, 1.0, 1.0, 1.0)

func _apply_panel_content_transition_visuals(progress: float) -> void:
	if panel_content_transition_surface == null:
		return
	var surface:= panel_content_transition_surface
	MainSceneHelpers._prime_panel_transition_surface(surface)
	var base_position = surface.get_meta("ui_panel_transition_base_position", surface.position)
	var base_scale = surface.get_meta("ui_panel_transition_base_scale", Vector2.ONE)
	var t: float = clamp(progress, 0.0, 1.0)
	var eased: float = 1.0 - pow(1.0 - t, 3.0)
	var x_offset: float = lerpf(panel_content_transition_slide_distance * panel_content_transition_direction, 0.0, eased)
	var y_offset: float = lerpf(panel_content_transition_y_distance, 0.0, eased)
	var alpha: float = lerpf(0.0, 1.0, eased)
	var scale_factor: float = lerpf(panel_content_transition_start_scale, 1.0, eased)
	surface.position = base_position + Vector2(x_offset, y_offset)
	surface.scale = base_scale * scale_factor
	surface.modulate = Color(1.0, 1.0, 1.0, alpha)

func _begin_panel_content_transition(panel_key: String) -> void:
	var style: Dictionary = MainSceneLogic._get_era_panel_transition_style(gs)

	panel_content_transition_direction = _resolve_panel_transition_direction(
		panel_content_transition_last_panel,
		panel_key
	)
	panel_content_transition_duration = float(style.get("duration", 0.18))
	panel_content_transition_slide_distance = float(style.get("x_distance", 10.0))
	panel_content_transition_y_distance = float(style.get("y_distance", 0.0))
	panel_content_transition_start_scale = float(style.get("start_scale", 0.985))

	_trigger_ui_nav_button_sheen(
		panel_key,
		panel_content_transition_direction,
		panel_content_transition_duration,
		1.0
	)

	var surface: Control = _get_panel_transition_surface_for_key(panel_key)
	if surface == null:
		panel_content_transition_surface = null
		panel_content_transition_key = panel_key
		panel_content_transition_last_panel = panel_key
		panel_content_transition_active = false
		panel_content_transition_elapsed = 0.0
		panel_content_transition_direction = 0.0
		panel_content_transition_y_distance = 0.0
		return

	_restore_panel_transition_surface(surface)
	panel_content_transition_surface = surface
	panel_content_transition_key = panel_key
	panel_content_transition_active = true
	panel_content_transition_elapsed = 0.0
	_apply_panel_content_transition_visuals(0.0)

func _cancel_panel_content_transition() -> void:
	if panel_content_transition_surface != null:
		_restore_panel_transition_surface(panel_content_transition_surface)
	panel_content_transition_active = false
	panel_content_transition_elapsed = 0.0
	panel_content_transition_key = current_panel
	panel_content_transition_last_panel = current_panel
	panel_content_transition_direction = 0.0
	panel_content_transition_y_distance = 0.0

func _animate_panel_content_transition(delta: float) -> void:
	if not panel_content_transition_active:
		return
	if panel_content_transition_surface == null or not is_instance_valid(panel_content_transition_surface):
		panel_content_transition_active = false
		panel_content_transition_surface = null
		panel_content_transition_elapsed = 0.0
		return
	if panel_content_transition_duration <= 0.0:
		_apply_panel_content_transition_visuals(1.0)
		panel_content_transition_active = false
		panel_content_transition_last_panel = panel_content_transition_key
		return

	panel_content_transition_elapsed = min(
		panel_content_transition_duration,
		panel_content_transition_elapsed + delta
	)

	var progress: float = panel_content_transition_elapsed / panel_content_transition_duration
	_apply_panel_content_transition_visuals(progress)

	if progress >= 1.0:
		_restore_panel_transition_surface(panel_content_transition_surface)
		panel_content_transition_active = false
		panel_content_transition_last_panel = panel_content_transition_key
