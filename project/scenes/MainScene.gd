func _bending_dojo_element_panel_style(element: String) -> StyleBoxFlat:
	var clean_element: String = str(element).strip_edges().to_lower()
	var element_color: Color = _bending_hud_element_color(clean_element)
	var soft_color: Color = element_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.34)

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(
		clampf(element_color.r * 0.18, 0.03, 0.3),
		clampf(element_color.g * 0.18, 0.03, 0.3),
		clampf(element_color.b * 0.2, 0.04, 0.34),
		0.98
	)
	style.border_color = Color(soft_color.r, soft_color.g, soft_color.b, 0.92)
	style.shadow_color = Color(element_color.r, element_color.g, element_color.b, 0.34)
	style.shadow_size = 22
	style.shadow_offset = Vector2.ZERO
	style.border_width_left = 3
	style.border_width_top = 3
	style.border_width_right = 3
	style.border_width_bottom = 3
	style.corner_radius_top_left = 22
	style.corner_radius_top_right = 22
	style.corner_radius_bottom_left = 22
	style.corner_radius_bottom_right = 22

	return style
