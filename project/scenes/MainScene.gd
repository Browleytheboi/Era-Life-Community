func _god_mode_elemental_country_icon(country_text: String) -> Texture2D:
	var clean_country: String = str(country_text).strip_edges()
	if clean_country == "":
		return null

	var profile: Dictionary = MainSceneHelpers._god_mode_elemental_country_visual_profile(clean_country)
	if profile.is_empty():
		return null

	var cache_key: String = str(profile.get("nation", clean_country))
	if god_mode_elemental_country_icon_cache.has(cache_key):
		var cached_icon: Texture2D = god_mode_elemental_country_icon_cache.get(cache_key, null)
		if cached_icon != null:
			return cached_icon

	var core: Color = Color(profile.get("core", Color(1.0, 1.0, 1.0, 1.0)))
	var glow: Color = Color(profile.get("glow", core))
	var soft: Color = Color(profile.get("soft", core.darkened(0.45)))

	var icon_size:= Vector2i(34, 20)
	var image:= Image.create(icon_size.x, icon_size.y, false, Image.FORMAT_RGBA8)
	image.fill(Color(0.0, 0.0, 0.0, 0.0))

	var center:= Vector2(float(icon_size.x) * 0.5, float(icon_size.y) * 0.5)
	for y in range(icon_size.y):
		for x in range(icon_size.x):
			var point:= Vector2(float(x), float(y))
			var normalized_distance: float = point.distance_to(center) / max(1.0, float(icon_size.y) * 0.52)
			var pixel_color:= Color(0.0, 0.0, 0.0, 0.0)

			if normalized_distance <= 0.62:
				pixel_color = core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.16)
				pixel_color.a = 0.96
			elif normalized_distance <= 1.05:
				var glow_alpha: float = clamp(1.05 - normalized_distance, 0.0, 1.0)
				pixel_color = glow
				pixel_color.a = glow_alpha * 0.72
			elif normalized_distance <= 1.42:
				var outer_alpha: float = clamp(1.42 - normalized_distance, 0.0, 1.0)
				pixel_color = soft
				pixel_color.a = outer_alpha * 0.32

			image.set_pixel(x, y, pixel_color)

	var texture:= ImageTexture.create_from_image(image)
	god_mode_elemental_country_icon_cache [cache_key] = texture
	return texture


func _decorate_country_picker_elemental_nation_items(button: OptionButton) -> void:
	if button == null or not is_instance_valid(button):
		return

	for i in range(button.item_count):
		var country_text: String = button.get_item_text(i)
		var profile: Dictionary = MainSceneHelpers._god_mode_elemental_country_visual_profile(country_text)
		if profile.is_empty():
			continue

		button.set_item_icon(i, _god_mode_elemental_country_icon(country_text))
		button.set_item_metadata(i, {
			"kind": "elemental_nation_country",
			"nation": str(profile.get("nation", country_text)),
			"core": profile.get("core", Color.WHITE),
			"glow": profile.get("glow", Color.WHITE)
		})


func _style_god_mode_popup_menu(popup: PopupMenu) -> void:
	if popup == null or not is_instance_valid(popup):
		return
	var palette:= _current_god_mode_palette()
	var field_palette:= _god_mode_field_palette()

	var body: Color = Color(palette.get("body", Color(0.98, 0.95, 1.0, 0.86)))
	var accent: Color = Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
