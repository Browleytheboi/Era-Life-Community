	intro.add_theme_color_override("font_color", Color(1.0, 0.76, 0.66, 0.94))
	body.add_child(intro)

	var existing_stats: Dictionary = {}
	if household_creator_active_member_index >= 0 and household_creator_active_member_index < household_creator_created_members.size():
		var existing: Dictionary = household_creator_created_members [household_creator_active_member_index]
		var stats_raw: Variant = existing.get("stats", {})
		existing_stats = stats_raw if typeof(stats_raw) == TYPE_DICTIONARY else {}

