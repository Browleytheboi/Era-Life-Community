	if not main_tab_deck_hot:
		_detach_actor_scoped_renderer_bindings_for_control_switch(
			target_id,
			"%s_native_switch_renderer_page_partial" % source
		)



	var pending_lens_bound: bool = (
		_bind_pending_situations_lens_to_actor_now(
