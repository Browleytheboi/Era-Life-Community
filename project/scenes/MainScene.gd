func _show_power_hub_overlay() -> void:
	if not _player_has_power_hub_access():
		return

	_ensure_power_hub_overlay()
	if power_hub_overlay == null:
		return

	set_meta("power_hub_click_visual_only", true)
	set_meta("power_hub_click_deeper_truth_deferred", true)
	set_meta("power_hub_click_sync_render_forbidden", true)
	set_meta("power_hub_click_sync_hud_update_forbidden", true)
	set_meta("power_hub_click_at_ms", int(Time.get_ticks_msec()))

	power_hub_open = true
	power_hub_overlay.visible = true
	power_hub_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	_bring_modal_to_front(power_hub_overlay)
	power_hub_overlay.grab_focus()

	call_deferred("_render_power_hub_overlay_after_visual_open")
func _render_power_hub_overlay_after_visual_open() -> void:
	if not power_hub_open:
		return

	var cache: Dictionary = _precompute_super_runtime_surface_cache_for_state(gs, "power_hub_open")
	if cache.is_empty():
		_super_runtime_queue_deeper_truth_refresh("power_hub_open_cache_empty")

	_render_power_hub_overlay()
	call_deferred("_update_superpower_hud")
	call_deferred("_update_power_hud")
func _hide_power_hub_overlay() -> void:
	power_hub_open = false
	_hide_superpower_hub_detail_panel()
	if power_hub_overlay != null:
		power_hub_overlay.visible = false
	_update_power_hud()
func _power_hub_payload() -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	var cached_payload: Variant = _super_runtime_cached_payload("power", {})
	if typeof(cached_payload) == TYPE_DICTIONARY and not (cached_payload as Dictionary).is_empty():
		return (cached_payload as Dictionary).duplicate(true)

	var payload: Dictionary = _power_hub_payload_from_state(gs, gs.player, "live_fallback_build_contract_packet_now")
	if not payload.is_empty():
		return payload

	_super_runtime_queue_deeper_truth_refresh("power_payload_synthesized_deeper_truth_refresh")
	return _power_hub_payload_from_state(gs, gs.player, "empty_fallback_synthesized_safe_packet")

func _render_power_hub_overlay() -> void:
	if power_hub_content_box == null:
		return

	_clear_container_children(power_hub_content_box)

	var payload: Dictionary = _power_hub_payload()
	power_hub_active_payload = payload.duplicate(true)

	if power_hub_title != null:
		power_hub_title.text = "INNER POWER • %s" % str(payload.get("actor_name", "POWERED LIFE")).to_upper()

	var sections: Array = _superpower_hub_safe_array(payload.get("sections", []))
	_rebuild_power_hub_section_bar(sections)
	var boot_lines: Array = _runtime_boot_domain_status_lines("powers")
	if not bool(payload.get("runtime_cache_ready", false)) and not boot_lines.is_empty():
		_add_power_hub_info_card("INNER POWER STILL SYNCING", boot_lines)
	var selected_section: Dictionary = _power_hub_selected_section(payload)
	if selected_section.is_empty():
		_add_power_hub_info_card("INNER POWER", [
			"No power sections are available yet."
		])
		return

	_add_power_hub_section(selected_section)
	_sync_power_hub_section_buttons()


func _rebuild_power_hub_section_bar(sections: Array) -> void:
	if power_hub_section_bar == null:
		return

	_clear_container_children(power_hub_section_bar)
	power_hub_section_buttons.clear()

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue

		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		var section_id: String = str(section.get("id", "")).strip_edges().to_lower()
		if section_id == "":
			continue

		var button:= Button.new()
		button.text = str(section.get("title", section_id.replace("_", " ").capitalize()))
		button.custom_minimum_size = Vector2(164, 44)
		button.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		button.focus_mode = Control.FOCUS_NONE
		button.pressed.connect(_set_power_hub_section.bind(section_id))
		_style_god_mode_button(button, false)
		power_hub_section_bar.add_child(button)
		power_hub_section_buttons [section_id] = button


func _power_hub_selected_section(payload: Dictionary) -> Dictionary:
	var sections: Array = _superpower_hub_safe_array(payload.get("sections", []))
	var valid_ids: Array = []

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue
		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		var section_id: String = str(section.get("id", "")).strip_edges().to_lower()
		if section_id != "":
			valid_ids.append(section_id)

	var clean_section: String = str(power_hub_current_section).strip_edges().to_lower()
	if clean_section == "" or clean_section not in valid_ids:
		clean_section = str(payload.get("default_section_id", "overview")).strip_edges().to_lower()
	if clean_section == "" or clean_section not in valid_ids:
		if not valid_ids.is_empty():
			clean_section = str(valid_ids [0])

	power_hub_current_section = clean_section

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue
		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		if str(section.get("id", "")).strip_edges().to_lower() == clean_section:
			return section

	return {}


func _set_power_hub_section(section_id: String) -> void:
	var clean_section: String = str(section_id).strip_edges().to_lower()
	if clean_section == "":
		return

	power_hub_current_section = clean_section
	_precompute_super_runtime_surface_cache_for_state(gs, "power_hub_section_click")
	_render_power_hub_overlay()


func _sync_power_hub_section_buttons() -> void:
	var selected_id: String = str(power_hub_current_section).strip_edges().to_lower()
	var core:= Color(0.38, 0.72, 1.0, 1.0)

	for raw_key in power_hub_section_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = power_hub_section_buttons.get(key, null)
		if button == null:
			continue

		var selected: bool = key == selected_id
		var style: StyleBoxFlat = null
		if button.has_meta("power_hub_section_style"):
			style = button.get_meta("power_hub_section_style") as StyleBoxFlat

		if style == null:
			style = StyleBoxFlat.new()
			style.border_width_left = 2
			style.border_width_top = 2
			style.border_width_right = 2
			style.border_width_bottom = 2
			style.corner_radius_top_left = 14
			style.corner_radius_top_right = 14
			style.corner_radius_bottom_left = 14
			style.corner_radius_bottom_right = 14
			button.set_meta("power_hub_section_style", style)
			button.add_theme_stylebox_override("normal", style)
			button.add_theme_stylebox_override("hover", style)
			button.add_theme_stylebox_override("pressed", style)

		style.bg_color = Color(core.r, core.g, core.b, 0.24 if selected else 0.1)
		style.border_color = Color(core.r, core.g, core.b, 0.88 if selected else 0.34)
		button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))

func _power_hub_power_rows(_actor: Person, power_state: Dictionary) -> Array:
	var powers: Dictionary = _superpower_hub_safe_dictionary(power_state.get("powers", {}))
	var rows: Array = []

	if powers.is_empty():
		rows.append({
			"id": "no_powers",
			"label": "No powers readable yet.",
			"description": "This hub unlocks once PowerEngine can read at least one active power.",
			"overview_title": "No Powers",
			"overview_lines": [
				"No powers are readable yet.",
				"Chaos/Fantasy lives can gain powers from birth configuration, lineage, serum, surgery, mutation, experiments, or origin events."
			]
		})
		return rows

	for raw_power_id in powers.keys():
		var power_id: String = str(raw_power_id).strip_edges().to_lower()
		var row: Dictionary = _superpower_hub_safe_dictionary(powers.get(raw_power_id, {}))
		var contract: Dictionary = {}
		if gs.power_engine != null and gs.power_engine.has_method("get_power_contract"):
			contract = _superpower_hub_safe_dictionary(gs.power_engine.get_power_contract(power_id))

		var display_name: String = str(row.get("display_name", contract.get("display_name", power_id.replace("_", " ").capitalize())))
		var rarity_text: String = str(row.get("rarity", contract.get("rarity", "common"))).replace("_", " ").capitalize()
		var unlocked_subskills: Array = _superpower_hub_safe_array(row.get("unlocked_subskills", []))
		var all_subskills: Array = _superpower_hub_safe_array(row.get("subskills", contract.get("subskills", [])))

		rows.append({
			"id": power_id,
			"label": "%s • Level %d • %s" % [
				display_name,
				int(row.get("level", 1)),
				rarity_text
			],
			"description": "Control %d%% • Chaos %d%% • Subskills %d/%d" % [
				int(round(float(row.get("control", 0.0)) * 100.0)),
				int(round(float(row.get("chaos", 0.0)) * 100.0)),
				unlocked_subskills.size(),
				all_subskills.size()
			],
			"overview_title": display_name,
			"overview_lines": [
				"Ability: %s" % display_name,
				"Rarity: %s" % rarity_text,
				"Level: %d" % int(row.get("level", 1)),
				"Base Power: %d" % int(row.get("base_power_level", 0)),
				"Latent Potential: %d" % int(row.get("latent_potential", 0)),
				"Control: %d%%" % int(round(float(row.get("control", 0.0)) * 100.0)),
				"Chaos: %d%%" % int(round(float(row.get("chaos", 0.0)) * 100.0)),
				"Unlocked Subskills: %s" % (", ".join(unlocked_subskills) if not unlocked_subskills.is_empty() else "None yet"),
				"All Subskills: %s" % (", ".join(all_subskills) if not all_subskills.is_empty() else "No subskill contract list yet")
			],
			"actions": [
				{
					"id": "train_%s" % power_id,
					"label": "Train",
					"engine_property": "power_engine",
					"method": "resolve_power_action",
					"payload": {
						"action": "train",
						"power_id": power_id,
						"source": "power_hub"
					},
					"refresh_after": true
				},
				{
					"id": "activate_%s" % power_id,
					"label": "Use",
					"engine_property": "power_engine",
					"method": "resolve_power_action",
					"requires_power_action_panel": true,
					"payload": {
						"action": "activate",
						"power_id": power_id,
						"source": "power_hub",
						"requires_power_action_panel": true
					},
					"refresh_after": true
				}
			]
		})

	return rows


func _power_hub_supe_stat_rows(_actor: Person, power_state: Dictionary, power_rating: int) -> Array:
	var rows: Array = []
	var power_stats: Dictionary = _superpower_hub_safe_dictionary(power_state.get("power_stats", {}))
