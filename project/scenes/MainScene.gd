			life_lines.size()
		)
		+ "|entries=" + str(
			life_entries.size()
		)
		+ "|signature=" + diary_signature
		+ "|published_packet_used=true"
		+ "|renderer_cache_bound=true"
		+ "|visible_diary_rebound="
		+ str(
			visible_diary_rebound
		).to_lower()
		+ "|precomposed_text=true"
		+ "|cursor_contract_used="
		+ str(
			cursor_contract_used
		).to_lower()
		+ "|full_render_rebuild=false"
		+ "|engine_calls="
		+ str(
			not cursor_contract_used
		).to_lower()
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|at_ms=" + str(
			Time.get_ticks_msec()
		)
	)

	return true
func _consume_continue_lineage_perspective_handoff(
	result: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
		or result.is_empty()
	):
		return

	var target_id: int = int(
		result.get(
			"controlled_actor_id",
			gs.player.id
		)
	)
	var previous_actor_id: int = int(
		result.get(
			"previous_actor_id",
			-1
		)
	)

	if (
		target_id <= 0
		or int(
			gs.player.id
		) != target_id
	):
		set_meta(
			"continue_lineage_visible_handoff_rejected",
			true
		)
		set_meta(
			"continue_lineage_visible_handoff_rejected_target_id",
			target_id
		)
		set_meta(
			"continue_lineage_visible_handoff_rejected_controlled_actor_id",
			int(
				gs.player.id
			)
		)
		return



	current_panel = "life"

	_hide_afterlife_ui()
	_hide_scenario_ui()

	var source: String = (
		"continue_lineage_perspective_handoff"
	)
	var handoff: Dictionary = (
		_zero_frame_contract_dictionary(
			result.get(
				"perspective_handoff_contract",
				{}
			)
		)
	)
	var cursor_contract: Dictionary = (
		_zero_frame_contract_dictionary(
			result.get(
				"life_diary_cursor_contract",
				handoff.get(
					"life_diary_cursor_contract",
					{}
				)
			)
		)
	)
	var diary_delta: Dictionary = (
		_zero_frame_contract_dictionary(
			result.get(
				"life_boundary_diary_delta_contract",
				{}
			)
		)
	)
	var spirit_text: String = str(
		handoff.get(
			"diary_text",
			result.get(
				"text",
				""
			)
		)
	).strip_edges()
	var committed_pointer_revision: String = str(
		result.get(
			"pointer_revision",
			handoff.get(
				"committed_pointer_revision",
				handoff.get(
					"pointer_revision",
					""
				)
			)
		)
	).strip_edges()

	var handoff_lens_cache: Dictionary = (
		_zero_frame_contract_dictionary(
			handoff.get(
				"press_frame_lens_cache",
				{}
			)
		)
	)







	age_up_diary_entries.clear()

	set_meta(
		"life_diary_loaded_owner_id",
		-1
	)
	set_meta(
		"life_diary_render_cached_lines",
		[]
	)
	set_meta(
		"life_diary_render_cached_signature",
		""
	)

	if (
		output_label != null
		and is_instance_valid(
			output_label
		)
	):
		output_label.text = ""

		output_label.set_meta(
			"life_diary_render_signature",
			""
		)
		output_label.set_meta(
			"life_diary_render_cached_signature",
			""
		)
		output_label.set_meta(
			"life_diary_render_cached_lines",
			[]
		)
		output_label.set_meta(
			"visible_truth_anchor_signature",
			""
		)
		output_label.set_meta(
			"visible_truth_anchor_actor_id",
			-1
		)
		output_label.set_meta(
			"continue_lineage_previous_actor_text_revoked",
			true
		)



	var target_memory_count: int = (
		gs.player.memories.size()
		if gs.player.memories != null
		else 0
	)

	var cursor_contract_hot: bool = (
		not cursor_contract.is_empty()
		and int(
			cursor_contract.get(
				"actor_id",
				target_id
			)
		) == target_id
	)

	if cursor_contract_hot:
		diary_world_feed_cursor = clampi(
			int(
				cursor_contract.get(
					"world_feed_cursor",
					gs.world_feed.size()
				)
			),
			0,
			gs.world_feed.size()
		)

		diary_global_memory_cursor = maxi(
			0,
			int(
				cursor_contract.get(
					"global_memory_cursor",
