func _active_interactive_surface_quarantines_runtime_huds() -> bool:
	var active_surface_key: String = str(
		get_meta(
			"last_interactive_surface_claimed",
			""
		)
	).strip_edges().to_lower()

	if active_surface_key == "":
		return false

	var active_surface: Control = (
		_interactive_surface_authority_candidate_by_key(
			active_surface_key
		)
	)

	if (
		active_surface == null
		or not is_instance_valid(
			active_surface
		)
	):
		return false

	if not active_surface.visible:
		return false

	if bool(
		active_surface.get_meta(
			"interactive_surface_input_suspended",
			false
		)
	):
		return false

	return (
		_interactive_surface_should_quarantine_runtime_huds(
			active_surface_key
		)
	)
