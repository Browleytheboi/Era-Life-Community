func _show_crown_hub(
	section: String = "throne"
) -> bool:
	if (
		crown_hub_overlay == null
		or not is_instance_valid(
			crown_hub_overlay
		)
		or gs == null
		or gs.player == null
	):
		return false

	var actor_id: int = int(
		gs.player.id
	)

	if not _crown_hub_contract_is_renderable(
		crown_hub_active_contract,
		actor_id
	):
		set_meta(
			"crown_hub_open_rejected_missing_contract",
			true
		)
		set_meta(
			"crown_hub_open_rejected_actor_id",
			actor_id
		)
		set_meta(
			"crown_hub_open_rejected_reason",
			"actor_scoped_contract_not_renderable"
		)

		EraLog.truth(
			"ERALIFE_CROWN_HUB_DOOR_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|reason=actor_scoped_contract_not_renderable"
			+ "|source_surface_retirement_allowed=false"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return false

	var surface_revision: String = str(
		crown_hub_active_contract.get(
			"surface_revision",
			""
		)
	).strip_edges()
	var prepainted_actor_id: int = int(
		get_meta(
			"crown_hub_prepainted_actor_id",
			-1
		)
	)
	var prepainted_revision: String = str(
		get_meta(
			"crown_hub_prepainted_surface_revision",
			""
		)
	)

	if (
		prepainted_actor_id != actor_id
		or prepainted_revision != surface_revision
	):
		set_meta(
			"crown_hub_open_rejected_unpainted_contract",
			true
		)
		set_meta(
			"crown_hub_open_rejected_actor_id",
			actor_id
		)
		set_meta(
			"crown_hub_open_rejected_reason",
			"actor_scoped_renderer_not_prepainted"
		)

		EraLog.truth(
			"ERALIFE_CROWN_HUB_DOOR_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|reason=actor_scoped_renderer_not_prepainted"
			+ "|contract_revision=" + surface_revision
			+ "|prepainted_revision=" + prepainted_revision
			+ "|source_surface_retirement_allowed=false"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return false

	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = str(
			get_meta(
				"crown_hub_prepainted_section_id",
				"throne"
			)
		).strip_edges().to_lower()

	if clean_section == "":
		clean_section = "throne"

	var return_panel: String = str(
		current_panel
	).strip_edges()

	if return_panel == "":
		return_panel = str(
			get_meta(
				"crown_hub_return_panel",
				"life"
			)
		).strip_edges()

	if return_panel == "":
		return_panel = "life"

	set_meta(
		"crown_hub_return_panel",
		return_panel
	)
	set_meta(
		"crown_hub_modal_lens_mode",
		true
	)
	set_meta(
		"crown_hub_main_panel_refresh_may_not_close",
		true
	)



	current_panel = ""

	crown_hub_current_section = clean_section
	crown_hub_open = true
	crown_hub_overlay.visible = true
	crown_hub_overlay.modulate = Color.WHITE
	crown_hub_overlay.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)

	set_meta(
		"crown_hub_open_rejected_missing_contract",
		false
	)
	set_meta(
		"crown_hub_open_rejected_unpainted_contract",
		false
	)
	set_meta(
		"crown_hub_room_entered_section",
		crown_hub_current_section
	)
	set_meta(
		"crown_hub_room_entered_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"crown_hub_room_transition_pulse",
		true
	)
	set_meta(
		"crown_hub_reveal_only",
		true
	)
	set_meta(
		"crown_hub_open_refresh_performed",
		false
	)
	set_meta(
		"crown_hub_open_shell_build_performed",
		false
	)

	_claim_interactive_surface_authority(
		crown_hub_overlay,
		"crown_hub:%d" % actor_id,
		"crown_hub_zero_frame_reveal",
		true,
		true
	)

	EraLog.truth(
		"ERALIFE_CROWN_HUB_DOOR_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|contract_hot=true"
		+ "|prepaint_hot=true"
		+ "|semantic_revision=true"
		+ "|modal_lens_mode=true"
		+ "|main_panel_refresh_may_not_close=true"
		+ "|source_surface_may_retire=true"
		+ "|build_on_press=false"
		+ "|refresh_on_press=false"
		+ "|engine_calls=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	return true

func _set_crown_hub_section(
		section: String
) -> void:
		var clean_section: String = str(
			section
		).strip_edges().to_lower()

		if clean_section == "":
			return

		if (
			crown_hub_current_section == clean_section
			and not bool(
				get_meta(
					"crown_hub_refresh_force_next",
					false
				)
			)
		):
			return

		var previous_section: String = str(
			crown_hub_current_section
		).strip_edges().to_lower()

		set_meta(
			"crown_hub_previous_section",
			previous_section
		)
		set_meta(
			"crown_hub_room_entered_section",
			clean_section
		)
		set_meta(
			"crown_hub_room_entered_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"crown_hub_room_transition_pulse",
			true
		)
		set_meta(
			"crown_hub_tab_switch_input_frame_must_not_block",
			true
		)




		if (
			previous_section == "diplomacy"
			and clean_section != "diplomacy"
		):
			_park_crown_diplomacy_surface_resident()

		crown_hub_current_section = clean_section

		if clean_section == "diplomacy":
			if _restore_crown_diplomacy_surface_resident():
				_refresh_crown_hub_chrome()

				set_meta(
					"crown_diplomacy_reentry_stream_restarted",
					false
				)
				set_meta(
					"crown_diplomacy_reentry_existing_cards_reused",
					true
				)

				return

		if clean_section == "war":
			_render_crown_war_section_from_contract()
			_refresh_crown_hub_chrome()
			return

		_paint_crown_hub_room_doorway_only(
			clean_section
		)
		_refresh_crown_hub_chrome()
		_queue_crown_hub_refresh(
			true,
			true
		)
func _show_crown_war_history_report_from_contract(
	war_report: Dictionary
) -> void:
	if war_report.is_empty():
		return

	var casualties: Dictionary = MainSceneHelpers._safe_dictionary(
		war_report.get(
			"casualty_totals",
			{}
		)
	)
	var military_total: int = (
		int(
			casualties.get(
				"attacker_military",
				0
			)
		)
		+ int(
			casualties.get(
				"defender_military",
				0
			)
		)
	)
	var civilian_total: int = (
		int(
			casualties.get(
				"attacker_civilian",
				0
			)
		)
		+ int(
			casualties.get(
				"defender_civilian",
				0
			)
		)
	)

	_maybe_show_action_result_popup({
		"success": true,
		"popup_title": "WAR REPORT",
		"popup_text": (
			"%s vs %s\n\n"
			+ "Started: %d\n"
			+ "Ended: %d\n"
			+ "Duration: %d years\n"
			+ "Winner: %s\n"
			+ "Conclusion: %s\n\n"
			+ "Military casualties: %s\n"
			+ "Civilian casualties: %s\n"
			+ "Displaced: %s"
		) % [
			str(
				war_report.get(
					"attacker_name",
					"Realm"
				)
			),
			str(
				war_report.get(
					"defender_name",
					"Realm"
				)
			),
			int(
				war_report.get(
					"start_year",
					0
				)
			),
			int(
				war_report.get(
					"end_year",
					0
				)
			),
			int(
				war_report.get(
					"duration_years",
					0
				)
			),
			str(
				war_report.get(
					"winner_name",
					"No Decisive Winner"
				)
			),
			str(
				war_report.get(
					"outcome_resolution",
					war_report.get(
						"conclusion_reason",
						"Unknown"
					)
				)
			).replace(
				"_",
				" "
			).capitalize(),
			MainSceneHelpers._crown_exact_number(
				military_total
			),
			MainSceneHelpers._crown_exact_number(
				civilian_total
			),
			MainSceneHelpers._crown_exact_number(
				int(
					casualties.get(
						"displaced",
						0
					)
				)
			)
		],
		"popup_footer": (
			"This is immutable concluded-war history."
		)
	})
