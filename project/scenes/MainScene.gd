func _prepare_action_result_relationship_profile_return(result: Dictionary) -> Dictionary:
	if typeof(result) != TYPE_DICTIONARY:
		return result

	if bool(result.get("identity_switch", false)):
		return result

	if _result_crosses_life_boundary(result):
		return result

	if not _relationship_profile_surface_visible_for_action_result():
		return result

	var active_target_id: int = relationships_browser_selected_id

	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
		active_target_id = int(relationship_profile_popup.get_meta("relationship_profile_target_id", active_target_id))

	if active_target_id <= 0 and relationship_editor_popup_target_id > 0:
		active_target_id = relationship_editor_popup_target_id

	if active_target_id <= 0:
		return result

	action_result_relationship_profile_return_pending = true
	action_result_relationship_profile_target_id = active_target_id
	action_result_relationship_profile_return_context = relationship_profile_return_context
	action_result_relationship_profile_return_coworker_ids = relationship_profile_return_coworker_ids.duplicate(true)

	var patched_result: Dictionary = result.duplicate(true)
	patched_result ["return_to_relationship_profile"] = true
	patched_result ["relationship_profile_target_id"] = active_target_id
	patched_result ["relationship_profile_return_context"] = relationship_profile_return_context
	patched_result ["relationship_profile_return_coworker_ids"] = relationship_profile_return_coworker_ids.duplicate(true)

	_suspend_relationship_profile_popup_for_action_result()
	return patched_result

func _restore_relationship_profile_after_action_result_if_needed() -> void:
	if not action_result_relationship_profile_return_pending:
		return
	if gs == null:
		_clear_action_result_relationship_profile_return()
		return

	var target_id: int = action_result_relationship_profile_target_id
	var restore_context: String = action_result_relationship_profile_return_context
	var restore_coworkers: Array = action_result_relationship_profile_return_coworker_ids.duplicate(true)

	_clear_action_result_relationship_profile_return()

	if target_id <= 0:
		return

	var target: Person = null
	if gs.has_method("get_or_reactivate_npc_by_id"):
		target = gs.get_or_reactivate_npc_by_id(target_id)
	if target == null and gs.has_method("get_npc_by_id"):
		target = gs.get_npc_by_id(target_id)
	if target == null:
		return

	relationship_profile_return_context = restore_context
	relationship_profile_return_coworker_ids = restore_coworkers.duplicate(true)
	relationships_browser_selected_id = target_id
	_show_relationship_profile_popup(target)
func _interactive_surface_authority_candidate_by_key(
	surface_key: String
) -> Control:
	var clean_key: String = str(
		surface_key
	).strip_edges().to_lower()

	if clean_key == "":
		return null

	var registry_raw: Variant = get_meta(
		"interactive_surface_authority_registry",
		{}
	)

	if typeof(registry_raw) != TYPE_DICTIONARY:
		return null

	var registry: Dictionary = registry_raw as Dictionary
	var reference_raw: Variant = registry.get(
		clean_key,
		null
	)
	var candidate: Control = null

	if reference_raw is WeakRef:
		var referenced: Variant = (
			reference_raw as WeakRef
		).get_ref()

		if referenced is Control:
			candidate = referenced as Control
	elif reference_raw is Control:
		candidate = reference_raw as Control

	if candidate == null or not is_instance_valid(candidate):
		registry.erase(
			clean_key
		)
		set_meta(
			"interactive_surface_authority_registry",
			registry
		)
		return null

	return candidate

func _capture_action_result_return_surface_authority() -> void:
	var existing_ref: Variant = (
		get_meta(
			"action_result_return_surface_ref"
		)
		if has_meta(
			"action_result_return_surface_ref"
		)
		else null
	)
	var existing_surface: Control = null

	if existing_ref is WeakRef:
		var existing_referenced: Variant = (
			existing_ref as WeakRef
		).get_ref()

		if existing_referenced is Control:
			existing_surface = (
				existing_referenced as Control
			)
	elif existing_ref is Control:
		existing_surface = existing_ref as Control

	if (
		existing_surface != null
		and is_instance_valid(
			existing_surface
		)
		and action_result_popup_open
	):
		return

	var preferred_key: String = str(
		get_meta(
			"last_interactive_surface_claimed"
		)
		if has_meta(
			"last_interactive_surface_claimed"
		)
		else ""
	).strip_edges().to_lower()

	var return_surface: Control = (
		_interactive_surface_authority_candidate_by_key(
			preferred_key
		)
	)

	if (
		return_surface == null
		or not is_instance_valid(
			return_surface
		)
		or return_surface == action_result_popup
		or not return_surface.visible
	):
		return_surface = null

	var known_surfaces: Array = [
		rick_weapon_shop_popup,
		belongings_item_popup,
		belongings_hud_panel,
		relationship_profile_panel,
		crown_action_popup,
		crown_hub_overlay,
		assets_panel,
		property_market_panel,
		vehicle_market_panel,
		pet_shop_panel,
		meat_market_panel,
		activities_hub_panel,
		relationship_hub_panel,
		school_hub_panel,
		career_hub_panel,
		mod_menu_panel,
		crime_panel,
		mini_game_panel,
		bending_hud_panel
	]

	if return_surface == null:
		for raw_surface in known_surfaces:
			var candidate: Control = (
				raw_surface as Control
			)

			if (
				candidate == null
				or not is_instance_valid(
					candidate
				)
				or candidate == action_result_popup
				or not candidate.visible
				or candidate.mouse_filter == (
					Control.MOUSE_FILTER_IGNORE
				)
			):
				continue

			return_surface = candidate
			preferred_key = str(
				candidate.get_meta(
					"interactive_surface_key"
				)
				if candidate.has_meta(
					"interactive_surface_key"
				)
				else ""
			).strip_edges().to_lower()
			break

	if (
		return_surface != null
		and is_instance_valid(
			return_surface
		)
	):
		set_meta(
			"action_result_return_surface_ref",
			weakref(
				return_surface
			)
		)
	else:
		if has_meta(
			"action_result_return_surface_ref"
		):
			remove_meta(
				"action_result_return_surface_ref"
			)

	set_meta(
		"action_result_return_surface_key",
		preferred_key
	)
	set_meta(
		"action_result_return_surface_was_visible",
		return_surface != null
	)
	set_meta(
		"action_result_return_surface_panel_id",
		current_panel
	)
	set_meta(
		"action_result_return_surface_captured_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"action_result_return_surface_capture_is_generic",
		true
	)
	set_meta(
		"action_result_return_surface_scene_tree_scan_performed",
		false
	)
	set_meta(
		"action_result_return_surface_missing_meta_read_performed",
		false
	)
func _restore_action_result_return_surface_authority() -> bool:
	var return_ref: Variant = (
		get_meta(
			"action_result_return_surface_ref"
		)
		if has_meta(
			"action_result_return_surface_ref"
		)
		else null
	)
	var return_key: String = str(
		get_meta(
			"action_result_return_surface_key"
		)
		if has_meta(
			"action_result_return_surface_key"
		)
		else ""
	).strip_edges().to_lower()
	var restored: bool = false
	var return_surface: Control = null

	if return_ref is WeakRef:
		var referenced: Variant = (
			return_ref as WeakRef
		).get_ref()

		if referenced is Control:
			return_surface = referenced as Control
	elif (
		return_ref is Control
		and is_instance_valid(
			return_ref as Control
		)
	):
		return_surface = return_ref as Control
	elif return_key != "":
		return_surface = (
			_interactive_surface_authority_candidate_by_key(
				return_key
			)
		)

	if (
		return_surface != null
		and is_instance_valid(return_surface)
	):
		return_surface.visible = true
		return_surface.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		restored = _claim_interactive_surface_authority(
			return_surface,
			(
				return_key
				if return_key != ""
				else "restored_surface"
			),
			"action_result_popup_return_authority",
			true,
			true
		)

	if not restored:
		var restored_panel_id: String = str(
			get_meta(
				"action_result_return_surface_panel_id"
			)
			if has_meta(
				"action_result_return_surface_panel_id"
			)
			else current_panel
		).strip_edges().to_lower()

		match restored_panel_id:
			"activities":
				if (
					activities_hub_panel != null
					and is_instance_valid(
						activities_hub_panel
					)
					and gs != null
					and gs.player != null
					and activities_hub_panel.has_renderable_contract(
						int(gs.player.id)
					)
				):
					activities_hub_panel.visible = true
					restored = _claim_interactive_surface_authority(
						activities_hub_panel,
						(
							"activities_hub_panel:%d"
							% int(gs.player.id)
						),
						"action_result_popup_activities_fallback",
						true,
						true
					)

			"life":
				if (
					output_label != null
					and is_instance_valid(output_label)
				):
					output_label.visible = true
					output_label.mouse_filter = (
						Control.MOUSE_FILTER_PASS
					)
					restored = true

			_:
				restored = false

	if not restored:
		_restore_market_surface_after_action_result()

	for meta_key in [
		"action_result_return_surface_ref",
		"action_result_return_surface_key",
		"action_result_return_surface_was_visible",
		"action_result_return_surface_panel_id",
		"action_result_return_surface_captured_at_ms"
	]:
		if has_meta(
			str(meta_key)
		):
			remove_meta(
				str(meta_key)
			)

	set_meta(
		"action_result_return_surface_restored",
		restored
	)
	set_meta(
		"action_result_return_surface_restored_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"action_result_return_surface_missing_meta_read_performed",
		false
	)

	return restored
func _maybe_show_action_result_popup(
	result: Dictionary
) -> void:
	if typeof(result) != TYPE_DICTIONARY:
		return

	var result_type: String = str(
		result.get(
			"type",
			""
		)
	).strip_edges().to_lower()

	if result_type == "scenario_prompt":
		_hide_action_result_popup()
		pending_action_result_followup = {}
		_refresh_scenario_ui_from_result(
			result
		)
		return

	if _action_result_should_become_pending_popup_contract(
		result
	):
		_emit_pending_popup_contract_from_action_result(
			result,
			{
				"source": "maybe_show_action_result_popup",
				"target_id": (
					int(gs.player.id)
					if (
						gs != null
						and gs.player != null
					)
					else -1
				)
			}
		)
		_update_pending_situations_button()
		return

	result = (
		_prepare_action_result_relationship_profile_return(
			result
		)
	)

	var scatter_animation_raw: Variant = result.get(
		"dragonball_scatter_animation",
		{}
	)

	if typeof(scatter_animation_raw) == TYPE_DICTIONARY:
		var scatter_animation: Dictionary = (
			(scatter_animation_raw as Dictionary).duplicate(false)
		)

		if bool(
			scatter_animation.get(
				"active",
				false
			)
		):
			scatter_animation ["popup_title"] = str(
				scatter_animation.get(
					"popup_title",
					result.get(
						"popup_title",
						"Dragon Balls Scattered"
					)
				)
			)
			scatter_animation ["popup_text"] = str(
				scatter_animation.get(
					"popup_text",
					result.get(
						"popup_text",
						(
							"The Dragon Balls scattered "
							+ "back across the world."
						)
					)
				)
			)
			scatter_animation ["popup_footer"] = str(
				scatter_animation.get(
					"popup_footer",
					result.get(
						"popup_footer",
						"They can be found again."
					)
				)
			)

			var deferred_runtime_raw: Variant = result.get(
				"deferred_dragonball_scatter_runtime",
				{}
			)

			if (
				typeof(deferred_runtime_raw) == TYPE_DICTIONARY
				and not (
					deferred_runtime_raw as Dictionary
				).is_empty()
			):
				scatter_animation [
					"deferred_runtime_payload"
				] = (
					(deferred_runtime_raw as Dictionary)
					.duplicate(false)
				)

			call_deferred(
				"_play_dragonball_scatter_animation",
				scatter_animation
			)

			if bool(
				scatter_animation.get(
					"consume_result_popup",
					true
				)
			):
				return

	var followup_raw: Variant = result.get(
		"followup_result",
		{}
	)

	if typeof(followup_raw) == TYPE_DICTIONARY:
		pending_action_result_followup = (
			(followup_raw as Dictionary).duplicate(false)
		)
	else:
		pending_action_result_followup = {}

	if _result_crosses_life_boundary(
		result
	):
		_hide_other_countries_popup_for_lifecycle(
			"action_result_life_boundary"
		)



	var supplied_popup_text: String = str(
		result.get(
			"popup_text",
			""
		)
	).strip_edges()
	var raw_result_text: String = str(
		result.get(
			"text",
			""
		)
	).strip_edges()
	var popup_text: String = (
		supplied_popup_text
		if supplied_popup_text != ""
		else raw_result_text
	)
	var popup_text_needs_conversion: bool = (
		supplied_popup_text == ""
		and raw_result_text != ""
	)

	if popup_text == "":
		_restore_relationship_profile_after_action_result_if_needed()
		return

	if (
		action_result_popup == null
		or not is_instance_valid(
			action_result_popup
		)
		or action_result_popup_title == null
		or action_result_popup_body == null
		or action_result_popup_footer == null
		or action_result_popup_choices == null
	):
		set_meta(
			"action_result_popup_prebuilt_shell_integrity_failure",
			true
		)
		set_meta(
			"action_result_popup_prebuilt_shell_integrity_failure_at_ms",
			int(Time.get_ticks_msec())
		)
		set_meta(
			"action_result_popup_click_path_build_forbidden",
			true
		)
		_restore_relationship_profile_after_action_result_if_needed()
		return

	set_meta(
		"action_result_popup_prebuilt_shell_integrity_failure",
		false
	)

	_capture_action_result_return_surface_authority()

	# FIX: the bending/avatar hub is one of the few surfaces that never calls
	# _claim_interactive_surface_authority(), so the capture above has nothing to go
	# on and falls through to whatever stale claim is left over -- usually the career
	# hub. Finishing a training session therefore dismissed the player into Career.
	#
	# This only corrects WHERE dismissal returns to. It deliberately does not claim
	# authority: claiming sets mouse_filter and quarantines other surfaces, and the
	# hub is a HUD panel rather than a modal, so claiming it stopped the hub opening
	# at all. Overwriting the captured ref touches no input handling.
	if (
		bending_hud_panel != null
		and is_instance_valid(bending_hud_panel)
		and bending_hud_panel.visible
	):
		set_meta(
			"action_result_return_surface_ref",
			weakref(bending_hud_panel)
		)
		set_meta(
			"action_result_return_surface_key",
			"bending_hub_panel"
		)

	var generation: int = int(
		action_result_popup.get_meta(
			"action_result_popup_generation",
			0
		)
	) + 1

	action_result_popup.set_meta(
		"action_result_popup_generation",
		generation
	)
	action_result_popup.set_meta(
		"reality_surge_input_unlock_ms",
		0
	)
	action_result_popup.set_meta(
		"action_result_popup_has_modal_authority",
		true
	)
	action_result_popup.set_meta(
		"action_result_popup_blocks_relationship_profile_clickthrough",
		true
	)
	action_result_popup.set_meta(
		"action_result_popup_built_on_open",
		false
	)
	action_result_popup.set_meta(
		"action_result_popup_scene_tree_scan_performed",
		false
