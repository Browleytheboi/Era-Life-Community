	else:
		boot_spawn_animation_pending = false
		set_meta(
			"startup_live_shell_loading",
			false
		)
		set_meta(
			"player_stats_spawn_cinematic_pending",
			false
		)
		if bool(get_meta("player_stats_spawn_fill_consumed", false)):
			set_meta("player_stats_spawn_fill_consumed", false)

		if player_stats_health_bar != null:
			player_stats_health_bar.value = player_stats_health_target
		if player_stats_hunger_bar != null:
			player_stats_hunger_bar.value = player_stats_hunger_target
		if player_stats_mental_bar != null:
			player_stats_mental_bar.value = player_stats_mental_target
		if player_stats_willpower_bar != null:
			player_stats_willpower_bar.value = player_stats_willpower_target
		if player_stats_happiness_bar != null:
			player_stats_happiness_bar.value = player_stats_happiness_target
		if player_stats_smarts_bar != null:
			player_stats_smarts_bar.value = player_stats_smarts_target
		if player_stats_looks_bar != null:
			player_stats_looks_bar.value = player_stats_looks_target
		if player_stats_imagination_bar != null:
