func _execute_power_action_from_detail_panel(base_action: Dictionary, extra_payload: Dictionary, source_hub: String) -> void:
	if gs == null or gs.player == null:
		return

	var engine_property: String = str(base_action.get("engine_property", "power_engine")).strip_edges()
	var method_name: String = str(base_action.get("method", "resolve_power_action")).strip_edges()
	var payload: Dictionary = _superpower_hub_safe_dictionary(base_action.get("payload", {}))

	if payload.is_empty():
		payload ["action"] = str(base_action.get("id", ""))

	for raw_key in extra_payload.keys():
		payload [raw_key] = extra_payload.get(raw_key)

	var result: Dictionary = {}
	var engine = gs.get(engine_property)
	if engine != null and engine.has_method(method_name):
		result = _superpower_hub_safe_dictionary(engine.call(method_name, gs.player, payload))
	else:
		result = {
			"success": false,
			"reason": "Power action unavailable.",
			"engine_property": engine_property,
			"method": method_name
		}

	if bool(base_action.get("refresh_after", false)) or bool(result.get("success", false)):
		if source_hub == "superhero_hub":
			_render_superpower_hub_overlay()
		else:
			_render_power_hub_overlay()

	_hide_superpower_hub_detail_panel()
	_maybe_show_action_result_popup(result)

