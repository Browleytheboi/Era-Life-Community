	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_mental_health_slider, relationship_editor_mental_health_value_label)
	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_fame_slider, relationship_editor_fame_value_label)
	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_fertility_slider, relationship_editor_fertility_value_label)

	_populate_relationship_editor_bank_balance_picker(int(target.bank_balance))
func _queue_relationship_bending_duel_scenario(target: Person) -> void:
	if gs == null or gs.player == null:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "No active life is loaded.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "No active life is loaded."
		})
		return

	if target == null:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "No target was selected.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "No target was selected for a bending duel."
		})
		return

	if gs.bending_engine == null:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "The bending engine is not available right now.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "The bending engine is not available right now."
		})
		return

	if not gs.is_feature_enabled("bending"):
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "Bending is disabled in this reality mode.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "Bending is disabled in this reality mode."
		})
		return

	if str(gs.player.bending_type).strip_edges().to_lower() == "none":
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "You cannot bend.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "I cannot bend."
		})
		return

	if int(gs.player.age) < 10:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel Locked",
			"popup_text": "You are too young to seek a bending duel.\n\nDueling unlocks at age 10.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "Bending duels unlock at age 10."
		})
		return

	if str(target.bending_type).strip_edges().to_lower() == "none":
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "%s cannot bend." % target.first_name,
			"popup_footer": "Tap anywhere to continue.",
			"text": "%s cannot bend." % target.first_name
		})
		return

	if gs.scenario_engine == null:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Duel",
			"popup_text": "ScenarioEngine is unavailable for bending duels.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "ScenarioEngine is unavailable for bending duels."
		})
		return

	var relation_label: String = _relationship_label_for_target(target)
	var target_name: String = ("%s %s" % [target.first_name, target.last_name]).strip_edges()
	var scenario: Dictionary = {
		"id": "relationship_bending_duel_%d_%d_%d" % [int(gs.year), int(target.id), int(Time.get_ticks_msec())],
		"source": "scenario_engine",
		"category": "bending",
		"cooldown_key": "relationship_bending_duel",
		"resolver_method": "_resolve_bending_duel_choice",
		"panel_title": "BENDING DUEL",
		"footer_text": "This is no longer a popup roll. Your actual bending skills, their skill, and tactical reads matter.",
		"prompt": "You challenge your %s %s to a bending duel.\n\nThey square up and start reading your stance.\n\nDo you begin the duel?" % [
			relation_label,
			target_name
		],
		"bending_duel_target_id": int(target.id),
		"bending_duel_target_name": target_name,
		"bending_duel_contract": {
			"schema": "eralife.bending_duel_contract",
			"version": 1,
			"source": "relationship_profile",
			"uses_scenario_panel": true,
			"damage_reflects_on_stats": true,
		},
		"combat_ui": {
			"visible": true,
			"theme": "bending_duel",
			"status_text": "Challenge issued"
		},
		"choices": [
			{
				"id": "bending_duel_accept",
				"label": "Begin the duel",
				"journal_text": "I began a bending duel with %s." % target_name,
				"button_theme": "bending_ability",
				"power_source": "bending",
				"bending_duel_target_id": int(target.id)
			},
			{
				"id": "bending_duel_decline",
				"label": "Back out",
				"journal_text": "I decided not to begin the bending duel with %s." % target_name,
				"button_theme": "defensive_escape",
				"power_source": "survival",
				"bending_duel_target_id": int(target.id)
			}
		]
	}

	if relationship_profile_popup != null:
		relationship_profile_popup.visible = false
	relationship_profile_popup_open = false

	var result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
	_refresh_scenario_ui_from_result(result)
func _close_relationship_editor_popup() -> void:
	var target_id: int = relationship_editor_popup_target_id
	relationship_editor_popup_target_id = -1
	if relationship_editor_popup != null:
		relationship_editor_popup.visible = false
	if relationship_profile_popup_open and target_id > 0:
		var target: Person = gs.get_or_reactivate_npc_by_id(target_id) if gs != null else null
		if target != null:
			_show_relationship_profile_popup(target)
func _rebuild_bending_hub_tournament_content() -> void:
	if bending_hud_tournaments_box == null:
		return

	_clear_container_children(bending_hud_tournaments_box)

	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return

	bending_hud_tournaments_box.add_child(MainSceneHelpers._make_bending_hub_section_label("World Stage"))

	var history_btn:= _make_bending_hub_button("Tournament History", false)
	history_btn.tooltip_text = "View recent tournament winners, Tournament of Champions bids, all-time bending records, archived matches, mythic fights, and style echoes."
	history_btn.pressed.connect(_on_bending_hub_tournament_history_pressed)
	bending_hud_tournaments_box.add_child(history_btn)

	var archive_btn:= _make_bending_hub_button("Match Archive / Rewatch Old Fights", false)
	archive_btn.tooltip_text = "Rewatch your old matches, historic matches from before you were born, mythic duels, and fights that shaped generational styles."
	archive_btn.pressed.connect(_on_bending_hub_match_archive_pressed)
	bending_hud_tournaments_box.add_child(archive_btn)

	if not gs.bending_engine.has_method("get_bending_world_championship_hub_payload"):
		var unavailable:= Label.new()
		unavailable.text = "Bending World Championship contracts are not available yet."
		unavailable.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		bending_hud_tournaments_box.add_child(unavailable)
		return

	var payload: Dictionary = {}
	var cached_payload: Variant = _bending_hub_cached_payload("world_championship", {})
	if typeof(cached_payload) == TYPE_DICTIONARY:
		payload = cached_payload
	if payload.is_empty():
		payload = _bending_hub_synthetic_tournament_payload("world_championship", {})
		_request_bending_hub_surface_prewarm(true)

	var division: String = str(payload.get("division", "ineligible")).strip_edges().to_lower()
	var records: Dictionary = payload.get("records", {})
	var overall: Dictionary = records.get("overall", {})
	var tournament_record: Dictionary = records.get("tournament", {})
	var non_tournament_record: Dictionary = records.get("non_tournament", {})
	var tournament: Dictionary = payload.get("tournament", {})
	var tournament_status: String = str(tournament.get("status", "")).strip_edges().to_lower()
	var tournament_label: String = str(tournament.get("label", "Bending World Championship")).strip_edges()
	var bracket: Array = payload.get("bracket", [])
	var has_active_bracket: bool = tournament_status == "active" and not bracket.is_empty()
	var title_counts: Dictionary = records.get("championship_title_counts", {}) if typeof(records.get("championship_title_counts", {})) == TYPE_DICTIONARY else {}
	var title_count: int = max(int(records.get("championships", 0)), MainSceneHelpers._bending_sum_int_dictionary_values(title_counts))
	var title_summary: String = ""

	if gs.bending_engine.has_method("_bending_championship_title_summary_for_records"):
		title_summary = str(gs.bending_engine.call("_bending_championship_title_summary_for_records", records)).strip_edges()
	else:
		title_summary = str(records.get("championship_title_summary", "")).strip_edges()

	if title_summary == "" and title_count > 0:
		title_summary = "Bending WC X%d" % title_count

	var title_line: String = "Titles: %d" % title_count
	if title_summary != "":
		title_line += " | %s" % title_summary

	var summary:= Label.new()
	summary.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	summary.text = "%s %s\nDivision: %s\n%s\nOverall: %d-%d | KO: %d | Deaths Caused: %d\nTournament: %d-%d | Non-Tournament: %d-%d" % [
		str(actor.first_name),
		str(actor.last_name),
		division.capitalize(),
		title_line,
		int(overall.get("wins", 0)),
		int(overall.get("losses", 0)),
		int(overall.get("kos", 0)),
		int(overall.get("deaths", 0)),
		int(tournament_record.get("wins", 0)),
		int(tournament_record.get("losses", 0)),
		int(non_tournament_record.get("wins", 0)),
		int(non_tournament_record.get("losses", 0))
	]
	bending_hud_tournaments_box.add_child(summary)

	var style_identity: Dictionary = payload.get("style_identity", {})
	if not style_identity.is_empty():
		bending_hud_tournaments_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Style Identity"))
		var style_label:= Label.new()
		style_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		style_label.text = "%s\n%s\nReputation Heat: %d" % [
			str(style_identity.get("title", "Unformed Style")),
			str(style_identity.get("description", "This fighter's competitive identity is still forming.")),
			int(style_identity.get("heat", 0))
		]
		bending_hud_tournaments_box.add_child(style_label)

	var dynasty_titles: Array = payload.get("dynasty_titles", [])
	if not dynasty_titles.is_empty():
