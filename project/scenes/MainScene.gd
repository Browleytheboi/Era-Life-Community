func _activities_boxing_start_affordance_for_actor(actor: Person) -> Dictionary:
	var report: Dictionary = {
		"available": false,
		"reason": "",
		"minimum_age": 7,
		"actor_age": -1,
		"era_allows": false,
		"actor_alive": false,
		"already_started": false,
		"era_name": ""
	}

	if gs == null:
		report ["reason"] = "no_game_state"
		return report

	if actor == null:
		report ["reason"] = "no_actor"
		return report

	report ["actor_age"] = int(actor.age)
	report ["actor_alive"] = bool(actor.alive)

	if not bool(actor.alive):
		report ["reason"] = "actor_not_alive"
		return report

	var era_names: Array = []

	if gs.era != null:
		for key in ["name", "id", "era_name", "display_name"]:
			var raw_era_name: String = str(_boxing_named_value(gs.era, key, "")).strip_edges()
			if raw_era_name != "":
				era_names.append(raw_era_name)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		for key in ["era_name", "current_era", "selected_era", "birth_era", "player_era", "runtime_era_name", "era"]:
			var raw_era_value: String = str(gs.scenario_state.get(key, "")).strip_edges()
			if raw_era_value != "":
				era_names.append(raw_era_value)

	if gs.era_engine != null:
		for key in ["current_era_name", "active_era_name", "era_name", "current_era", "selected_era"]:
			var raw_engine_era: String = str(_boxing_named_value(gs.era_engine, key, "")).strip_edges()
			if raw_engine_era != "":
				era_names.append(raw_engine_era)

	var era_name: String = ""
	var era_allows: bool = false

	for raw_name in era_names:
		var candidate: String = str(raw_name).strip_edges()
		if candidate == "":
			continue

		if era_name == "":
			era_name = candidate

		var era_key: String = candidate.to_lower()
		if era_key.find("modern") != -1 or era_key.find("future") != -1:
			era_allows = true
			break

	if not era_allows and gs.era_engine != null and gs.era_engine.has_method("supports_world_title_boxing"):
		era_allows = bool(gs.era_engine.supports_world_title_boxing())

	report ["era_allows"] = era_allows
	report ["era_name"] = era_name

	if not era_allows:
		report ["reason"] = "era_not_modern_or_future"
		return report

	var minimum_age: int = 7
	if gs.boxing_contract_engine != null and gs.boxing_contract_engine.has_method("get_boxing_policy"):
		minimum_age = int(gs.boxing_contract_engine.get_boxing_policy("minimum_boxing_start_age", 7))

	report ["minimum_age"] = minimum_age

	if int(actor.age) < minimum_age:
		report ["reason"] = "actor_too_young"
		return report

	var profile: Dictionary = {}
	if typeof(actor.boxing_profile) == TYPE_DICTIONARY:
		profile = actor.boxing_profile

	var already_started: bool = (
		bool(profile.get("is_boxer", false))
		or bool(profile.get("boxing_hub_unlocked", false))
		or bool(profile.get("boxing_career_started_by_player", false))
	)

	report ["already_started"] = already_started

	if already_started:
		report ["reason"] = "boxing_already_started"
		return report

	if bool(profile.get("retired", false)):
		report ["reason"] = "boxing_retired"
		return report

	report ["available"] = true
	report ["reason"] = "available"
	return report
func _boxing_named_value(source: Variant, key: String, fallback: Variant = "") -> Variant:
	if typeof(source) == TYPE_DICTIONARY:
		return (source as Dictionary).get(key, fallback)

	if typeof(source) == TYPE_OBJECT:
		var object_source: Object = source as Object
		if object_source != null:
			var value: Variant = object_source.get(key)
			if value != null:
				return value

	return fallback
func _activities_begin_boxing_available() -> bool:
	if gs == null or gs.player == null:
		return false

	var report: Dictionary = _activities_boxing_start_affordance_for_actor(gs.player)

	set_meta("activities_begin_boxing_affordance_available", bool(report.get("available", false)))
	set_meta("activities_begin_boxing_affordance_reason", str(report.get("reason", "")))
	set_meta("activities_begin_boxing_affordance_actor_age", int(report.get("actor_age", -1)))
	set_meta("activities_begin_boxing_affordance_minimum_age", int(report.get("minimum_age", 7)))
	set_meta("activities_begin_boxing_affordance_era_allows", bool(report.get("era_allows", false)))
	set_meta("activities_begin_boxing_renderer_does_not_commit_boxing", true)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["activities_begin_boxing_affordance_available"] = bool(report.get("available", false))
		gs.scenario_state ["activities_begin_boxing_affordance_reason"] = str(report.get("reason", ""))
		gs.scenario_state ["activities_begin_boxing_renderer_does_not_commit_boxing"] = true
		gs.scenario_state ["boxing_commit_authority"] = "BoxingEngine.start_boxing_career"

	return bool(report.get("available", false))

