		player_stats_looks_bar.max_value = looks_max
		player_stats_looks_bar.value = float(looks_value)
	if player_stats_imagination_bar != null:
		player_stats_imagination_bar.max_value = imagination_max
		player_stats_imagination_bar.value = float(imagination_value)
	if player_stats_fame_bar != null:
		player_stats_fame_bar.max_value = fame_max
		player_stats_fame_bar.value = float(fame_value)

	var show_approval: bool = bool(visibility.get("approval", approval_value > 0))
	var approval_target_value: float = float(approval_value) if show_approval else 0.0

	player_stats_overlay.set_meta("player_stats_surface_context", surface_context.duplicate(true))
	player_stats_overlay.set_meta("player_stats_approval_visible", show_approval)
	player_stats_overlay.set_meta("player_stats_bank_currency_symbol", str(snapshot.get("currency_symbol", "")))

	_apply_player_stat_surface_content(player_stats_health_label, player_stats_health_bar, "Health", health_value, health_max, surface_context)
	_apply_player_stat_surface_content(player_stats_hunger_label, player_stats_hunger_bar, "Hunger", hunger_value, hunger_max, surface_context)
	_apply_player_stat_surface_content(player_stats_mental_label, player_stats_mental_bar, "Mental", mental_value, mental_max, surface_context)
	_apply_player_stat_surface_content(player_stats_willpower_label, player_stats_willpower_bar, "Willpower", willpower_value, willpower_max, surface_context)
	_apply_player_stat_surface_content(player_stats_happiness_label, player_stats_happiness_bar, "Happiness", happiness_value, happiness_max, surface_context)
	_apply_player_stat_surface_content(player_stats_smarts_label, player_stats_smarts_bar, "Smarts", smarts_value, smarts_max, surface_context)
	_apply_player_stat_surface_content(player_stats_looks_label, player_stats_looks_bar, "Looks", looks_value, looks_max, surface_context)

	if player_stats_imagination_label != null and player_stats_imagination_bar != null:
		_apply_player_stat_surface_content(player_stats_imagination_label, player_stats_imagination_bar, "Imagination", imagination_value, imagination_max, surface_context)

	if player_stats_bank_label != null:
		player_stats_bank_label.text = _format_player_stats_bank_amount(bank_value)

	if player_stats_fame_row != null:
		player_stats_fame_row.visible = fame_value > 0
	if fame_value > 0 and player_stats_fame_label != null and player_stats_fame_bar != null:
		_apply_player_stat_surface_content(player_stats_fame_label, player_stats_fame_bar, "Fame", fame_value, fame_max, surface_context)

	var approval_widgets: Dictionary = _get_player_stats_approval_widgets()
	var approval_row: Control = approval_widgets.get("row", null) as Control
	var approval_label: Label = approval_widgets.get("label", null) as Label
	var approval_bar: ProgressBar = approval_widgets.get("bar", null) as ProgressBar

	if approval_row != null:
		approval_row.visible = show_approval
	if approval_label != null:
		approval_label.visible = show_approval
	if approval_bar != null:
		approval_bar.visible = show_approval
		approval_bar.max_value = 100
		approval_bar.value = approval_target_value
		approval_bar.set_meta("player_stats_approval_target", approval_target_value)

	if show_approval and approval_label != null and approval_bar != null:
		_apply_player_stat_surface_content(approval_label, approval_bar, "Approval", approval_value, 100, surface_context)

	player_stats_overlay.visible = true
	_apply_player_stats_overlay_visual_state(player_stats_overlay_hovered)
	set_meta("first_frame_ui_snapshot_consumed", true)
	set_meta("player_stats_spawn_fill_consumed", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["first_frame_ui_snapshot_consumed"] = true
		gs.scenario_state ["first_frame_ui_snapshot_consumed_reason"] = reason
		gs.scenario_state ["first_frame_ui_snapshot_consumed_at_ms"] = int(Time.get_ticks_msec())

	return true
func _deferred_begin_god_mode_life_boot() -> void:
	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("second_boot", "Mainscene._deferred_begin_god_mode_life_boot", "deferred_begin_god_mode_life_boot", {
			"blocks_ui": true,
			"background_only": false
