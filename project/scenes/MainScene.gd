func _schedule_choose_adventure_preboot_engines_after_menu_settled(reason: String = "menu_settled") -> void:
	if bool(get_meta("choose_adventure_preboot_after_menu_settled_pending", false)):
		return

	set_meta("choose_adventure_preboot_after_menu_settled_pending", true)
	set_meta("choose_adventure_preboot_after_menu_settled_reason", reason)
	set_meta("choose_adventure_preboot_after_menu_settled_scheduled_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_choose_adventure_preboot_engines_after_menu_settled", reason)
		return

	var timer:= tree.create_timer(1.1)
	timer.timeout.connect(
		Callable(self, "_run_choose_adventure_preboot_engines_after_menu_settled").bind(reason),
		CONNECT_ONE_SHOT
	)


func _run_choose_adventure_preboot_engines_after_menu_settled(reason: String = "menu_settled") -> void:
	var tree:= get_tree()
	if tree != null:
		await tree.process_frame
		await tree.process_frame

	if choose_adventure_entry_overlay == null or not is_instance_valid(choose_adventure_entry_overlay) or not choose_adventure_entry_overlay.visible:
		set_meta("choose_adventure_preboot_after_menu_settled_pending", false)
		set_meta("choose_adventure_entry_menu_settling", false)
		return

	if bool(get_meta("god_mode_entry_transition_active", false)):
		set_meta("choose_adventure_preboot_after_menu_settled_pending", false)
		_schedule_choose_adventure_preboot_engines_after_menu_settled(reason)
		return

	if _surface_guard_active("choose_adventure_entry") or _surface_guard_active("god_mode_entry") or _surface_guard_active("household_creator"):
		set_meta("choose_adventure_preboot_after_menu_settled_pending", false)
		_schedule_choose_adventure_preboot_engines_after_menu_settled(reason)
		return

	set_meta("choose_adventure_preboot_after_menu_settled_pending", false)
	set_meta("choose_adventure_entry_menu_settling", false)
	set_meta("choose_adventure_preboot_after_menu_settled_started_at_ms", int(Time.get_ticks_msec()))
	set_meta("choose_adventure_preboot_after_menu_settled_reason", reason)

	_ensure_choose_adventure_preboot_engines()

func _play_startup_intro_tick(pitch_scale: float = 1.0) -> void:
	if bool(get_meta("startup_intro_contract_audio_active", false)):
		return

	if startup_intro_tick_player == null:
		var tick_node:= find_child("StartupIntroTickPlayer", true, false)
		if tick_node is AudioStreamPlayer:
			startup_intro_tick_player = tick_node

	if startup_intro_tick_player == null:
		return

	if startup_intro_tick_player.stream == null:
		return

	startup_intro_tick_player.pitch_scale = clamp(pitch_scale, 0.75, 1.35)
	startup_intro_tick_player.play()
func _ensure_choose_adventure_preboot_engines() -> void:
	if gs == null:
		return

	if _surface_guard_active("choose_adventure_entry") or _surface_guard_active("god_mode_entry") or _surface_guard_active("household_creator"):
		if not bool(get_meta("choose_adventure_preboot_engines_deferred_for_surface", false)):
			set_meta("choose_adventure_preboot_engines_deferred_for_surface", true)
			call_deferred("_ensure_choose_adventure_preboot_engines_after_surface_assertion")
		return

	if gs.narrative_governor == null:
		gs.narrative_governor = NarrativeGovernor.new(gs)
	if gs.lineage_engine == null:
		gs.lineage_engine = LineageEngine.new(gs)
	if gs.choose_adventure_ai_node_generator == null:
		gs.choose_adventure_ai_node_generator = ChooseAdventureAINodeGenerator.new(gs)
	if gs.choose_adventure_scenario_engine == null:
		gs.choose_adventure_scenario_engine = ChooseAdventureScenarioEngine.new(gs)
	if gs.choose_adventure_engine == null:
		gs.choose_adventure_engine = ChooseAdventureEngine.new(gs)


func _ensure_choose_adventure_preboot_engines_after_surface_assertion() -> void:
	var tree:= get_tree()
	if tree != null:
		await tree.process_frame
		await tree.process_frame

	set_meta("choose_adventure_preboot_engines_deferred_for_surface", false)

	if _surface_guard_active("choose_adventure_entry") or _surface_guard_active("god_mode_entry") or _surface_guard_active("household_creator"):
		call_deferred("_ensure_choose_adventure_preboot_engines_after_surface_assertion")
		return

	_ensure_choose_adventure_preboot_engines()

func _show_choose_adventure_entry_panel() -> void:
	var returning_to_main_menu_without_live_player: bool = (
		_global_runtime_kill_current_runtime_domain() == "main_menu"
		and (
			gs == null
			or gs.player == null
		)
	)

	if returning_to_main_menu_without_live_player:
		set_meta(
			"main_menu_surface_terminated_for_playable_entry",
			false
		)
		set_meta(
			"main_menu_surface_terminated_reason",
			""
		)
		set_meta(
			"choose_adventure_surface_hard_killed_for_playable_entry",
			false
		)
		set_meta(
			"choose_adventure_surface_hard_killed_reason",
			""
		)
		set_meta(
			"main_menu_surface_active",
			true
		)

	if (
		gs != null
		and gs.player != null
	):
		if (
			_playable_life_shell_has_visible_sovereignty()
			or bool(
				get_meta(
					"main_menu_surface_terminated_for_playable_entry",
					false
				)
			)
			or _global_runtime_kill_current_runtime_domain() == "simulation"
		):
			_hard_kill_choose_adventure_surface_for_playable_entry(
				"show_choose_adventure_blocked_live_player"
			)
			return

	_global_runtime_kill_enter_main_menu_runtime(
		"show_choose_adventure_entry_panel",
		{
			"choose_adventure_entry": true,
			"simulation_work_forbidden": true
		}
	)

	_set_main_menu_surface_isolated(
		true,
		"show_choose_adventure_entry_panel"
	)

	if (
		choose_adventure_entry_overlay != null
		and is_instance_valid(
			choose_adventure_entry_overlay
		)
	):
		choose_adventure_entry_overlay.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		choose_adventure_entry_overlay.z_index = 4096

	if (
		choose_adventure_scenario_panel != null
		and is_instance_valid(
			choose_adventure_scenario_panel
		)
	):
		choose_adventure_scenario_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		choose_adventure_scenario_panel.z_index = 900






	var visual_contract_id: String = (
		"eralife.choose_adventure_entry.demo_almost_done_v1"
	)

	if (
		choose_adventure_entry_overlay != null
		and is_instance_valid(
			choose_adventure_entry_overlay
		)
	):
		var existing_contract_id: String = str(
			choose_adventure_entry_overlay.get_meta(
				"choose_adventure_entry_visual_contract",
				""
			)
		).strip_edges()

		if existing_contract_id != visual_contract_id:
			_clear_choose_adventure_entry_tweens()
			choose_adventure_entry_overlay.queue_free()
			choose_adventure_entry_overlay = null
			choose_adventure_entry_dim = null
			choose_adventure_entry_shell = null
			choose_adventure_entry_left_card = null
			choose_adventure_entry_middle_card = null
			choose_adventure_entry_right_card = null
		else:
			choose_adventure_entry_overlay.visible = true
			choose_adventure_entry_overlay.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)

			if (
				choose_adventure_entry_dim != null
				and is_instance_valid(
					choose_adventure_entry_dim
				)
			):
				choose_adventure_entry_dim.visible = true

			var doorway_cover:= (
				choose_adventure_entry_overlay.get_node_or_null(
					"__ChooseErealityDoorwayCover"
				) as Control
			)

			if (
				doorway_cover != null
				and is_instance_valid(
					doorway_cover
				)
			):
				doorway_cover.visible = false
				doorway_cover.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			_bring_modal_to_front(
				choose_adventure_entry_overlay
			)
			_restart_choose_adventure_entry_panel_motion()

			call_deferred(
				"_prebuild_god_mode_viewer_surface_for_choose_ereality",
				"choose_adventure_entry_reopened"
			)
			return

	choose_adventure_entry_overlay = Control.new()
	choose_adventure_entry_overlay.name = (
		"ChooseAdventureEntryOverlay"
	)
	choose_adventure_entry_overlay.set_anchors_preset(
		Control.PRESET_FULL_RECT
	)
	choose_adventure_entry_overlay.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	choose_adventure_entry_overlay.set_meta(
		"choose_adventure_entry_visual_contract",
		visual_contract_id
	)
	add_child(
		choose_adventure_entry_overlay
	)
	_bring_modal_to_front(
		choose_adventure_entry_overlay
	)

	choose_adventure_entry_dim = ColorRect.new()
	choose_adventure_entry_dim.name = (
		"ChooseAdventureEntryDim"
	)
	choose_adventure_entry_dim.set_anchors_preset(
		Control.PRESET_FULL_RECT
	)
	choose_adventure_entry_dim.color = Color(
		0.015,
		0.012,
		0.03,
		1.0
	)
	choose_adventure_entry_overlay.add_child(
		choose_adventure_entry_dim
	)

	var center:= CenterContainer.new()
	center.name = "ChooseAdventureEntryCenter"
	center.set_anchors_preset(
		Control.PRESET_FULL_RECT
	)
	center.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	choose_adventure_entry_overlay.add_child(
		center
	)

	choose_adventure_entry_shell = HBoxContainer.new()
	choose_adventure_entry_shell.name = (
		"ChooseAdventureEntryTripleShell"
	)
	choose_adventure_entry_shell.custom_minimum_size = Vector2(
		1120,
		620
	)
	choose_adventure_entry_shell.add_theme_constant_override(
		"separation",
		22
	)
	center.add_child(
		choose_adventure_entry_shell
	)

	var panels: Array = [
		{
			"id": "choose_adventure",
			"eyebrow": "NARRATIVE MODE",
			"title": "Choose your own Adventure",
			"subtitle": (
				"Choose a story and make choices before birth. "
				+ "Every choice forces pressure into the simulation "
				+ "until the story becomes a life."
			),
			"footer": (
				"Choice → pressure → world reaction → dynamic outcome."
			),
			"button_text": "Almost Done!",
			"accent": Color(
				0.6,
				0.42,
				0.72
			),
			"button_role": "narrative_alive",
			"demo_temporarily_unavailable": true,
			"min_width": 350.0,
			"min_height": 570.0
		},
		{
			"id": "choose_household",
			"eyebrow": "HOUSEHOLD MODE",
			"title": " Choose your own Household",
			"subtitle": (
				"Build a text-based dollhouse: select the world, "
				+ "prewarm the seed, create household members progressively, "
				+ "then choose whose life you enter."
			),
			"footer": "Full Family control",
			"button_text": "Almost Done!",
			"accent": Color(
				0.76,
				0.28,
				0.19
			),
			"button_role": "household_alive",
			"demo_temporarily_unavailable": true,
			"min_width": 350.0,
			"min_height": 570.0
		},
		{
			"id": "choose_ereality",
			"eyebrow": "GOD MODE",
			"title": "Choose Your Ereality",
			"subtitle": (
				"Skip the narrative threshold and open the existing "
				+ "God Mode panel to shape the life manually."
			),
			"footer": (
				"Direct creation. Same Ereality. Different doorway."
			),
			"button_text": "Open God mode",
			"accent": Color(
				0.25,
				0.92,
				1.0
			),
			"button_role": "god_mode_alive",
			"min_width": 350.0,
			"min_height": 570.0
		}
	]

	var built_cards: Array = []

	for raw_panel in panels:
		if typeof(raw_panel) != TYPE_DICTIONARY:
			continue

		var card_contract: Dictionary = (
			(raw_panel as Dictionary).duplicate(true)
		)
		var card: PanelContainer = (
			_build_choose_adventure_entry_card(
				card_contract
			)
		)

		choose_adventure_entry_shell.add_child(
			card
		)
		built_cards.append(
			card
		)

		var button: Button = card.get_meta(
			"entry_button",
			null
		)

		if (
			button == null
			or not is_instance_valid(
				button
			)
		):
			continue

		var role: String = str(
			button.get_meta(
				"entry_role",
				card_contract.get(
					"button_role",
					card_contract.get(
						"id",
						""
					)
				)
			)
		).strip_edges().to_lower()







		if bool(
			card_contract.get(
				"demo_temporarily_unavailable",
				false
			)
		):
			button.set_meta(
				"demo_temporarily_unavailable",
				true
			)
			button.set_meta(
				"demo_doorway_intent_bound",
				false
			)
			button.tooltip_text = "Almost Done!"
			continue

		match role:
			"narrative_alive", "choose_adventure", "adventure":
				button.pressed.connect(
					_on_choose_adventure_entry_pressed
				)

			"household_alive", "choose_household", "household":
				button.pressed.connect(
					_on_choose_household_entry_pressed
				)

			"god_mode_alive", "choose_ereality", "ereality", "god_mode":
				button.pressed.connect(
					_on_choose_ereality_entry_pressed
				)

			_:
				button.pressed.connect(
					_on_choose_ereality_entry_pressed
				)

	if built_cards.size() >= 1:
		choose_adventure_entry_left_card = (
			built_cards [
				0
			]
		)

	if built_cards.size() >= 2:
		choose_adventure_entry_middle_card = (
			built_cards [
				1
			]
		)

	if built_cards.size() >= 3:
		choose_adventure_entry_right_card = (
			built_cards [
				2
			]
		)

	for i in range(
		built_cards.size()
	):
		var card_for_motion: PanelContainer = (
			built_cards [
				i
			]
		)

		_start_choose_adventure_entry_card_motion(
			card_for_motion,
			float(i) * 0.24
		)

	call_deferred(
		"_prebuild_god_mode_viewer_surface_for_choose_ereality",
		"choose_adventure_entry_visible"
	)
func _choose_ereality_entry_button() -> Button:
	if choose_adventure_entry_overlay == null or not is_instance_valid(choose_adventure_entry_overlay):
		return null

	return MainSceneHelpers._find_choose_ereality_entry_button_in_tree(choose_adventure_entry_overlay)


func _set_choose_ereality_entry_button_hot_state(is_hot: bool, reason: String = "god_mode_viewer_hot_state") -> void:
	var button: Button = _choose_ereality_entry_button()
	if button == null or not is_instance_valid(button):
		return

	button.disabled = not is_hot
	button.mouse_filter = Control.MOUSE_FILTER_STOP if is_hot else Control.MOUSE_FILTER_IGNORE
	button.focus_mode = Control.FOCUS_ALL if is_hot else Control.FOCUS_NONE
	button.text = "Open God mode" if is_hot else "Preparing God mode..."
	button.tooltip_text = "" if is_hot else "God Mode is being staged behind the door. The button unlocks when it can open instantly."

	set_meta("choose_ereality_entry_button_hot", is_hot)
	set_meta("choose_ereality_entry_button_hot_reason", reason)
	set_meta("choose_ereality_entry_button_hot_at_ms", int(Time.get_ticks_msec()))
func _prebuild_god_mode_viewer_surface_for_choose_ereality(
	reason: String = "choose_ereality_prebuild"
) -> void:
	var engine:= (
		_ensure_god_mode_contract_engine()
	)

	if engine == null:
		return

	_set_choose_ereality_entry_button_hot_state(
		false,
		"%s_prebuild_start" % reason
	)

	if (
		god_mode_viewer == null
		or not is_instance_valid(
			god_mode_viewer
		)
	):
		god_mode_viewer = GodModeViewer.new()
		god_mode_viewer.name = "GodModeViewer"

		add_child(
			god_mode_viewer
		)

	if (
		god_mode_viewer == null
		or not is_instance_valid(
			god_mode_viewer
		)
	):
		_set_choose_ereality_entry_button_hot_state(
			false,
			"%s_viewer_creation_failed" % reason
		)
		return

	var close_callable:= Callable(
		self,
		"_on_god_mode_viewer_close_requested"
	)

	if not god_mode_viewer.close_requested.is_connected(
		close_callable
	):
		god_mode_viewer.close_requested.connect(
			close_callable
		)

	var prewarm_callable:= Callable(
		self,
		"_on_god_mode_viewer_prewarm_requested"
	)

	if (
		god_mode_viewer.has_signal(
			"prewarm_requested"
		)
		and not god_mode_viewer.prewarm_requested.is_connected(
			prewarm_callable
		)
	):
		god_mode_viewer.prewarm_requested.connect(
			prewarm_callable
		)

	var handoff_callable:= Callable(
		self,
		"_on_god_mode_viewer_handoff_requested"
	)

	if (
		god_mode_viewer.has_signal(
			"handoff_requested"
		)
		and not god_mode_viewer.handoff_requested.is_connected(
			handoff_callable
		)
	):
		god_mode_viewer.handoff_requested.connect(
			handoff_callable
		)

	var residency_candidate_callable:= Callable(
		self,
		"_on_god_mode_viewer_residency_candidate_changed"
	)

	if (
		god_mode_viewer.has_signal(
			"residency_candidate_changed"
		)
		and not god_mode_viewer.residency_candidate_changed.is_connected(
			residency_candidate_callable
		)
	):
		god_mode_viewer.residency_candidate_changed.connect(
			residency_candidate_callable
		)

	god_mode_viewer.bind_contract_engine(
		engine
	)

	var settings: Dictionary = {}

	if (
		gs != null
		and typeof(
			gs.custom_settings
		) == TYPE_DICTIONARY
	):
		settings = (
			gs.custom_settings.duplicate(true)
		)

	if god_mode_viewer.has_method(
		"prebuild_hidden"
	):
		god_mode_viewer.call(
			"prebuild_hidden",
			settings.duplicate(true),
			reason
		)
	else:
		god_mode_viewer.open_with_settings(
			settings.duplicate(true)
		)
		god_mode_viewer.close()

	_apply_presentation_composition_to_resident_surfaces(
		"%s_prebuilt" % reason
	)

	if (
		choose_adventure_entry_overlay != null
		and is_instance_valid(
			choose_adventure_entry_overlay
		)
	):
		_bring_modal_to_front(
			choose_adventure_entry_overlay
		)

	set_meta(
		"god_mode_viewer_surface_prebuilt",
		true
	)
	set_meta(
		"god_mode_viewer_surface_prebuilt_reason",
		reason
	)
	set_meta(
		"god_mode_viewer_surface_prebuilt_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"god_mode_viewer_door_hot",
		true
	)
	set_meta(
		"god_mode_viewer_press_frame_build_forbidden",
		true
	)

	_set_choose_ereality_entry_button_hot_state(
		true,
		"%s_prebuild_complete" % reason
	)

	if gs != null:
		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"god_mode_viewer_surface_prebuilt"
		] = true

		gs.scenario_state [
			"god_mode_viewer_surface_prebuilt_reason"
		] = reason

		gs.scenario_state [
			"god_mode_viewer_door_hot"
		] = true

		gs.scenario_state [
			"god_mode_viewer_press_frame_build_forbidden"
		] = true

		gs.scenario_state [
			"god_mode_ui_is_viewer_only"
		] = true

		gs.scenario_state [
			"god_mode_main_scene_authority_removed"
		] = true
func _schedule_idle_god_mode_panel_ui_prewarm(
	reason: String = "idle"
) -> void:
	if (
		god_mode_viewer != null
		and is_instance_valid(
			god_mode_viewer
		)
		and bool(
			god_mode_viewer.get_meta(
				"god_mode_viewer_prebuilt_hidden",
				false
			)
		)
	):
		return

	if bool(
		get_meta(
			"god_mode_viewer_surface_prebuild_pending",
			false
		)
	):
		return



	set_meta(
		"god_mode_viewer_surface_prebuild_pending",
		true
	)
	set_meta(
		"god_mode_viewer_surface_prebuild_reason",
		reason
	)
	set_meta(
		"god_mode_viewer_surface_prebuild_runs_behind_title_card",
		true
	)
	set_meta(
		"god_mode_start_panel_idle_prewarm_pending",
		false
	)
	set_meta(
		"god_mode_panel_ui_prewarm_allowed",
		false
	)

	call_deferred(
		"_run_idle_god_mode_viewer_surface_prebuild",
		reason
	)

func _run_idle_god_mode_viewer_surface_prebuild(reason: String = "idle") -> void:
	set_meta("god_mode_viewer_surface_prebuild_pending", false)
	_prebuild_god_mode_viewer_surface_for_choose_ereality(reason)
func _prepare_god_mode_ui_shell_only_contract_for_entry(reason: String = "entry_panel_prewarm") -> void:
	set_meta("god_mode_panel_ui_prewarm_allowed", true)
	set_meta("god_mode_panel_ui_prewarm_reason", reason)
	set_meta("god_mode_manual_world_seed_prewarm_authorized", false)
	set_meta("god_mode_start_panel_idle_prewarm_blocked", false)
	set_meta("god_mode_start_panel_idle_prewarm_contract_at_ms", int(Time.get_ticks_msec()))

	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["startup_intro_shell_only"] = true
	gs.scenario_state ["materialize_world_seed_on_initialize"] = false
	gs.scenario_state ["god_mode_ui_shell_only"] = true
	gs.scenario_state ["god_mode_manual_world_seed_prewarm_authorized"] = false
	gs.scenario_state ["soul_seed_distribution_authorized"] = false
	gs.scenario_state ["soul_seed_distribution_reason"] = "god_mode_ui_shell_only"
	gs.scenario_state ["soul_seed_background_distribution_pending"] = false
	gs.scenario_state ["soul_seed_background_stream_active"] = false
	gs.scenario_state ["runtime_hud_node_prewarm_authorized"] = true
func _run_idle_god_mode_panel_ui_prewarm(reason: String = "idle") -> void:
	set_meta("god_mode_start_panel_idle_prewarm_pending", false)

	if _god_mode_full_panel_hot_cached():
		if bool(get_meta("god_mode_open_after_hot_cache_requested", false)):
			call_deferred("_reveal_hot_god_mode_panel_now", "idle_prewarm_already_hot")
		return

	if choose_adventure_entry_overlay == null or not is_instance_valid(choose_adventure_entry_overlay):
		return
	if not choose_adventure_entry_overlay.visible:
		return
	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay) and startup_intro_overlay.visible:
		return

	set_meta("god_mode_idle_prewarm_blocked_to_protect_main_menu", false)
	set_meta("god_mode_idle_prewarm_blocked_reason", "")
	set_meta("god_mode_panel_ui_prewarm_allowed", true)
	set_meta("god_mode_panel_ui_prewarm_reason", "full_panel_hot_cache_%s" % reason)
	set_meta("god_mode_full_panel_hot_cache_building", true)
	set_meta("god_mode_full_panel_hot_cache_build_started_at_ms", int(Time.get_ticks_msec()))

	_prepare_god_mode_ui_shell_only_contract_for_entry("full_god_mode_panel_hot_cache_%s" % reason)
	_prewarm_god_mode_start_panel_for_entry()

	set_meta("god_mode_panel_ui_prewarm_allowed", false)
	set_meta("god_mode_full_panel_hot_cache_building", false)
	set_meta("god_mode_full_panel_hot_cached", _god_mode_full_panel_hot_cached())
	set_meta("god_mode_full_panel_hot_cached_at_ms", int(Time.get_ticks_msec()))

	if bool(get_meta("god_mode_open_after_hot_cache_requested", false)) and _god_mode_full_panel_hot_cached():
		call_deferred("_reveal_hot_god_mode_panel_now", "idle_prewarm_completed_requested_open")

func _schedule_background_soul_seed_streaming_loop(reason: String = "runtime") -> void:
	if get_tree() == null:
		return
	if bool(get_meta("background_soul_seed_stream_loop_active", false)):
		return

	set_meta("background_soul_seed_stream_loop_active", true)
	set_meta("background_soul_seed_stream_loop_reason", reason)
	set_meta("background_soul_seed_stream_loop_started_at_ms", int(Time.get_ticks_msec()))

	var timer:= get_tree().create_timer(0.85)
	timer.timeout.connect(
		Callable(self, "_run_background_soul_seed_streaming_tick").bind(reason, 0),
		CONNECT_ONE_SHOT
	)


func _run_background_soul_seed_streaming_tick(reason: String = "runtime", pass_index: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		set_meta("background_soul_seed_stream_loop_active", false)
		return

	if gs == null:
		set_meta("background_soul_seed_stream_loop_active", false)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var has_pending_stream: bool = bool(gs.scenario_state.get("soul_seed_background_distribution_pending", false)) or bool(gs.scenario_state.get("soul_seed_background_stream_active", false))
	if not has_pending_stream:
		set_meta("background_soul_seed_stream_loop_active", false)
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var shell_released: bool = bool(gs.scenario_state.get("birth_shell_player_control_released", false)) or bool(gs.scenario_state.get("spawn_ready_live_ui_shell_released", false))

	if not shell_released or not _background_tail_work_allowed(now_ms) or _post_spawn_ui_is_busy_for_prewarm() or _ui_interaction_grace_active(now_ms):
		var wait_timer:= tree.create_timer(0.85)
		wait_timer.timeout.connect(
			Callable(self, "_run_background_soul_seed_streaming_tick").bind(reason, pass_index),
			CONNECT_ONE_SHOT
		)
		return
	var report: Dictionary = {}
	if gs.has_method("tick_background_soul_seed_stream"):
		report = gs.tick_background_soul_seed_stream(1, {
			"source": "main_scene.background_soul_seed_stream",
			"reason": reason,
			"pass_index": pass_index,
			"frame_budget_ms": 2,
			"max_per_tick": 1,
			"hard_cap_reason": "ui_shell_first_no_spikes"
		})
	elif gs.has_method("start_background_soul_seed_streaming"):
		report = gs.start_background_soul_seed_streaming({
			"source": "main_scene.background_soul_seed_stream",
			"reason": reason
		})
	else:
		set_meta("background_soul_seed_stream_loop_active", false)
		return

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["soul_seed_background_stream_last_report"] = report.duplicate(true)

	if bool(report.get("complete", false)):
		set_meta("background_soul_seed_stream_loop_active", false)
		set_meta("background_soul_seed_stream_loop_completed_at_ms", int(Time.get_ticks_msec()))
		return

	var delay: float = 1.35
	if bool(report.get("budget_exhausted", false)):
		delay = 1.65
	elif int(report.get("assigned_this_tick", 0)) <= 0:
		delay = 1.75
	elif str(report.get("mode", "")) == "idle_waiting_for_world_population":
		delay = 1.85

	var next_timer:= tree.create_timer(delay)
	next_timer.timeout.connect(
		Callable(self, "_run_background_soul_seed_streaming_tick").bind(reason, pass_index + 1),
		CONNECT_ONE_SHOT
	)
