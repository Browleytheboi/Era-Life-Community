func _populate_rick_weapon_shop_people_tracker_popup() -> void:
	var dim:= get_node_or_null("RickWeaponShopPeopleTrackerDim")
	if dim == null or not dim.visible:
		return

	_rick_weapon_shop_raise_people_tracker_popup()

	var title:= dim.get_node_or_null("Panel/Margin/Root/Title")
	var grid:= dim.get_node_or_null("Panel/Margin/Root/Scroll/Grid")
	if grid == null:
		return

	for child in grid.get_children():
		child.queue_free()

	var tracker_key: String = str(get_meta("rick_weapon_shop_people_tracker_key", "inside_all"))
	var people: Array = _rick_weapon_shop_people_for_tracker_key(tracker_key)

	if title != null:
		title.text = "%s • %s LIVE" % [
			MainSceneHelpers._rick_weapon_shop_tracker_title(tracker_key),
			MainSceneHelpers._rick_weapon_shop_population_count_text(people.size())
		]

	if people.is_empty():
		var empty:= Label.new()
		empty.text = "Nobody is visible in this lane right now. Blink and Rick's whole neighborhood changes."
		empty.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty.add_theme_color_override("font_color", Color(1.0, 0.82, 0.58, 0.92))
		grid.add_child(empty)
		return

	for raw_person in people:
		if typeof(raw_person) != TYPE_DICTIONARY:
			continue
		var person: Dictionary = raw_person as Dictionary
		grid.add_child(_rick_weapon_shop_person_tracker_card(person, tracker_key))


func _rick_weapon_shop_people_for_tracker_key(tracker_key: String) -> Array:
	var state: Dictionary = MainSceneHelpers._safe_dictionary(rick_weapon_shop_active_contract.get("shop_runtime_state", {}))
	var outside_people: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside_people", {}))
	var inside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("inside", {}))
	var people: Array = []

	match tracker_key:
		"walking_by":
			return MainSceneHelpers._safe_array(outside_people.get("walking_by", []))
		"walking_in":
			return MainSceneHelpers._safe_array(outside_people.get("walking_in", []))
		"walking_out":
			return MainSceneHelpers._safe_array(outside_people.get("walking_out", []))
		"browsing":
			return MainSceneHelpers._safe_array(inside.get("browsers", []))
		"checking_out":
			var checkout_person: Dictionary = MainSceneHelpers._safe_dictionary(inside.get("checking_out_person", {}))
			if not checkout_person.is_empty():
				people.append(checkout_person)
			return people
		"inside_all":
			people.append_array(MainSceneHelpers._safe_array(inside.get("browsers", [])))
			var person: Dictionary = MainSceneHelpers._safe_dictionary(inside.get("checking_out_person", {}))
			if not person.is_empty():
				people.append(person)
			return people
		_:
			return []


func _rick_weapon_shop_person_tracker_card(person: Dictionary, tracker_key: String) -> PanelContainer:
	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.mouse_filter = Control.MOUSE_FILTER_STOP
	card.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	card.gui_input.connect(Callable(self, "_on_rick_weapon_shop_person_tracker_card_gui_input").bind(str(person.get("person_id", "")), tracker_key))

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.105, 0.078, 0.06, 0.96)
	style.border_color = Color(1.0, 0.62, 0.24, 0.38)
	style.set_border_width_all(1)
	style.set_corner_radius_all(16)
	card.add_theme_stylebox_override("panel", style)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	card.add_child(margin)

	var body:= VBoxContainer.new()
	body.add_theme_constant_override("separation", 4)
	margin.add_child(body)

	var name_label:= Label.new()
	name_label.text = "%s %s • Age %d" % [
		str(person.get("first_name", "Unknown")),
		str(person.get("last_name", "")),
		int(person.get("age", 0))
	]
	name_label.add_theme_font_size_override("font_size", 17)
	name_label.add_theme_color_override("font_color", Color(1.0, 0.9, 0.62, 1.0))
	body.add_child(name_label)

	var activity_text: String = str(person.get("activity", "moving through the shop"))
	var eyeballing: String = str(person.get("eyeballing", "")).strip_edges()
	if eyeballing != "":
		activity_text = "%s • eyeballing %s" % [activity_text, eyeballing]

	var detail:= Label.new()
	detail.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	detail.text = "%s\nClick before they leave." % activity_text
	detail.add_theme_font_size_override("font_size", 13)
	detail.add_theme_color_override("font_color", Color(0.92, 0.84, 0.72, 0.92))
	body.add_child(detail)

	return card


func _on_rick_weapon_shop_person_tracker_card_gui_input(event: InputEvent, person_id: String, tracker_key: String) -> void:
	if event is InputEventMouseButton:
		var mb:= event as InputEventMouseButton
		if mb.pressed and mb.button_index == MOUSE_BUTTON_LEFT:
			_on_rick_weapon_shop_person_tracker_card_pressed(person_id, tracker_key)


func _on_rick_weapon_shop_person_tracker_card_pressed(person_id: String, _tracker_key: String) -> void:
	var person: Dictionary = _rick_weapon_shop_visible_person_by_id(person_id)
	if person.is_empty():
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Too Late",
			"popup_text": "They slipped out of view before you could lock onto them.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	_maybe_show_action_result_popup({
		"success": true,
		"popup_title": str(person.get("full_name", "Someone")),
		"popup_text": "%s is age %d and is currently %s." % [
			str(person.get("full_name", "Someone")),
			int(person.get("age", 0)),
			str(person.get("activity", "moving through Rick's shop"))
		],
		"popup_footer": "Tap anywhere to continue."
	})


func _rick_weapon_shop_visible_person_by_id(person_id: String) -> Dictionary:
	var clean_id: String = str(person_id).strip_edges()
	if clean_id == "":
		return {}

	for key in ["walking_by", "walking_in", "walking_out", "browsing", "checking_out", "inside_all"]:
		for raw_person in _rick_weapon_shop_people_for_tracker_key(key):
			if typeof(raw_person) != TYPE_DICTIONARY:
				continue
			var person: Dictionary = raw_person as Dictionary
			if str(person.get("person_id", "")) == clean_id:
				return person.duplicate(true)

	return {}
func _on_rick_weapon_shop_enter_pressed() -> void:
	if rick_weapon_shop_active_contract.is_empty():
		return

	set_meta("rick_weapon_shop_enter_click_visual_only", true)
	set_meta("rick_weapon_shop_enter_click_sync_rebuild_forbidden", true)
	set_meta("rick_weapon_shop_enter_click_at_ms", int(Time.get_ticks_msec()))

	var state: Dictionary = MainSceneHelpers._safe_dictionary(rick_weapon_shop_active_contract.get("shop_runtime_state", {}))
	if state.is_empty():
		state = _rick_weapon_shop_default_live_state()

	state ["mode"] = "inside"
	set_meta("rick_weapon_shop_mode", "inside")
	set_meta("rick_weapon_shop_selected_weapon_name", "")

	var inside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("inside", {}))
	if inside.is_empty():
		inside = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("inside", {}))

	inside ["rick_live_text"] = MainSceneLogic._rick_weapon_shop_rick_greeting(rick_weapon_shop_active_contract)

	state ["inside"] = inside
	rick_weapon_shop_active_contract ["shop_runtime_state"] = state

	_rick_weapon_shop_request_popup_repaint("rick_weapon_shop_enter_pressed_visual_tail")
