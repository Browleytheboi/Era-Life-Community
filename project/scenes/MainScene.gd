			household_creator_status_label.text = str(validation.get("reason", "Finish member basics first."))
		return

	household_creator_pending_member_basic_contract = member.duplicate(true)

	_household_creator_clear_body()
	_household_creator_clear_member_stat_controls()

	var card:= MainSceneHelpers._household_creator_section_card("Player Stats")
