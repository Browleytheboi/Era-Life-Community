func _show_player_line_birth_naming_popup(result: Dictionary) -> void:
	_ensure_player_line_birth_naming_popup()
	if player_line_birth_naming_popup == null:
		return

	player_line_birth_naming_popup.visible = true
	player_line_birth_naming_status.text = str(result.get("text", "Choose your baby's name."))

	var pending_raw = gs.pending_player_line_birth if gs != null else {}
	var default_last_name:= ""
	if typeof(pending_raw) == TYPE_DICTIONARY:
		default_last_name = str(pending_raw.get("default_last_name", "")).strip_edges()

	player_line_birth_first_name_input.text = ""
	player_line_birth_last_name_input.text = default_last_name
	_bring_modal_to_front(player_line_birth_naming_popup)
	player_line_birth_first_name_input.grab_focus()

func _close_player_line_birth_naming_popup() -> void:
	if player_line_birth_naming_popup != null:
		player_line_birth_naming_popup.visible = false

func _on_player_line_birth_naming_confirm_pressed() -> void:
	if gs == null or gs.player == null:
		return

	var first_name:= player_line_birth_first_name_input.text.strip_edges()
	var last_name:= player_line_birth_last_name_input.text.strip_edges()

	if first_name == "":
		player_line_birth_naming_status.text = "Give the baby a first name."
		return

	var actor_id: int = int(gs.player.id)
	var intent_report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": "player_line_birth_identity",
			"surface_id": "player_line_birth_naming_popup",
			"action_id": "commit_player_line_birth_identity",
			"payload": {
				"first_name": first_name,
				"last_name": last_name,
				"source": "mainscene.player_line_birth_naming_popup"
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "life_engine",
				"method": "resolve_player_line_birth_identity_intent",
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": "mainscene.player_line_birth_naming_popup",
			"ui_is_expression_only": true
		},
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"surface_id": "player_line_birth_naming_popup",
			"action_id": "commit_player_line_birth_identity",
			"source": "mainscene.player_line_birth_naming_popup",
			"blocks_ui": false
		}
	)
	var birth_result: Dictionary = _contract_route_result(
		intent_report
	)

	if not bool(
		birth_result.get(
			"success",
			false
		)
	):
		player_line_birth_naming_status.text = str(
			birth_result.get(
				"text",
				"The birth could not be completed."
			)
		)
		return

	_close_player_line_birth_naming_popup()

	var birth_text:= str(
		birth_result.get(
			"text",
			""
		)
	).strip_edges()
	if birth_text != "":
		_append_text_to_diary(
			birth_text,
			false
		)



	_maybe_show_action_result_popup(
		birth_result
	)
	_render_life_diary_panel()
	_update_player_stats_overlay()
func _main_tab_surface_id_for_panel(panel_id: String) -> String:
	match str(panel_id).strip_edges().to_lower():
		"life":
			return "life_panel"
		"relationships":
			return "desktop_relationships_panel"
		"career":
			return "desktop_career_panel"
		"school":
			return "desktop_school_panel"
		"activities":
			return "desktop_activities_panel"
		"world":
			return "world_feed_panel"
		"mods":
			return "mod_menu_panel"
		_:
			return ""


func _build_main_tab_ui_packet_context(panel_id: String) -> Dictionary:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)
	var active_section_id: String = MainSceneHelpers._main_tab_default_section_for_panel(clean_panel)
	var shell_first_cache_lock: bool = false
	var player_control_released: bool = false

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		player_control_released = bool(gs.scenario_state.get("birth_shell_player_control_released", false)) \
or bool(gs.scenario_state.get("spawn_ready_live_ui_shell_released", false)) \
or bool(gs.scenario_state.get("spawn_ready_live_ui_shell_reconciled", false))

		var raw_shell_first_lock: bool = bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false)) \
and not bool(gs.scenario_state.get("spawn_shell_open_tab_on_boot", false))

		shell_first_cache_lock = raw_shell_first_lock and not player_control_released

	var actor_id: int = -1
	var year_value: int = 0
	var age_value: int = 0

	if gs != null:
		year_value = int(gs.year)
		if gs.player != null:
			actor_id = int(gs.player.id)
			age_value = int(gs.player.age)

	var stable_revision: String = "%s:%s:%d:%d:%d" % [
		clean_panel,
		surface_id,
		actor_id,
		year_value,
		age_value
	]

	var context: Dictionary = {
		"source": "mainscene.main_tab_packet_context",
		"panel_id": clean_panel,
		"surface_id": surface_id,
		"active_section_id": active_section_id,
		"device_profile": "auto" if shell_first_cache_lock else "desktop",
		"packet_contract_required": true,
		"perceived_truth_required": true,
		"main_tab_packet": true,
		"revision": "" if shell_first_cache_lock else stable_revision,
		"stable_revision": stable_revision,
		"ui_is_pure_renderer": true,
		"click_path_must_not_build": true,
		"allow_deferred_truth_refresh": true
	}

	if shell_first_cache_lock:
		context ["playable_birth_shell_only"] = true
		context ["first_visible_runtime_boot"] = true
		context ["ui_packet_shell_first_cache_lock"] = true

	if gs != null and gs.player != null:
		context ["actor_id"] = int(gs.player.id)
		context ["year"] = int(gs.year)
		context ["age"] = int(gs.player.age)
		context ["live_reality_stream"] = _is_live_reality_stream_bound() and shell_first_cache_lock
		context ["first_frame_is_live_runtime"] = _is_live_reality_stream_bound() and shell_first_cache_lock

		if clean_panel == "life":
			var life_context: Dictionary = _build_life_panel_ui_packet_context()
			for key in life_context.keys():
				context [key] = life_context [key]

			context ["source"] = "mainscene.main_tab_packet_context.life_adapter"
			context ["panel_id"] = clean_panel
			context ["surface_id"] = surface_id
			context ["active_section_id"] = active_section_id
			context ["packet_contract_required"] = true
			context ["perceived_truth_required"] = true
			context ["main_tab_packet"] = true
			context ["device_profile"] = "desktop"
			context ["revision"] = "" if shell_first_cache_lock else stable_revision
			context ["stable_revision"] = stable_revision

	return context
func _try_render_main_tab_ui_packet(panel_id: String) -> bool:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)

	if surface_id == "":
		return false
	if gs == null:
		return false

	if MainSceneHelpers._main_tab_panel_uses_native_zero_frame_door(clean_panel):
		set_meta("main_tab_click_used_native_zero_frame_door", true)
		set_meta("main_tab_click_native_zero_frame_panel", clean_panel)
		set_meta("main_tab_click_native_zero_frame_surface_id", surface_id)
		set_meta("main_tab_click_native_zero_frame_at_ms", int(Time.get_ticks_msec()))
		set_meta("main_tab_click_packet_build_forbidden", true)
		set_meta("main_tab_click_synth_packet_forbidden", true)
		set_meta("main_tab_click_generic_gray_panel_forbidden", true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["main_tab_click_used_native_zero_frame_door"] = true
			gs.scenario_state ["main_tab_click_native_zero_frame_panel"] = clean_panel
			gs.scenario_state ["main_tab_click_native_zero_frame_surface_id"] = surface_id
			gs.scenario_state ["main_tab_click_packet_build_forbidden"] = true
			gs.scenario_state ["main_tab_click_synth_packet_forbidden"] = true
			gs.scenario_state ["main_tab_click_generic_gray_panel_forbidden"] = true
			gs.scenario_state ["main_tab_click_native_panel_is_actual_design"] = true

		var opened_native: bool = _open_main_tab_zero_frame_door(clean_panel, "try_render_main_tab_ui_packet_native_door")
		if opened_native:
			_schedule_main_tab_background_packet_reconcile(clean_panel, "native_zero_frame_tab_door_reconcile", 0.85)
		return opened_native

	var packet: Dictionary = _build_main_tab_packet_now(clean_panel, "try_render_main_tab_ui_packet")
	if not MainSceneLogic._main_tab_packet_is_renderable(packet):
		return false

	return _render_main_tab_ui_packet(clean_panel, packet)
func _try_render_world_tab_hot_or_safe_packet() -> bool:
	set_meta("world_tab_safe_shell_bypassed_for_native_feed", true)
	set_meta("world_tab_safe_shell_bypassed_at_ms", int(Time.get_ticks_msec()))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["world_tab_safe_shell_bypassed_for_native_feed"] = true
		gs.scenario_state ["world_tab_opens_actual_world_feed"] = true
		gs.scenario_state ["world_tab_click_packet_build_forbidden"] = true

	return _render_desktop_native_main_tab("world")
func _render_world_feed_safe_shell_packet(packet: Dictionary) -> bool:
	if typeof(packet) != TYPE_DICTIONARY:
		return false
	if packet.is_empty():
		return false
	if not bool(packet.get("success", false)):
		return false

	set_meta("world_feed_safe_shell_packet_redirected_to_native_design", true)
	set_meta("world_feed_safe_shell_packet_generic_render_forbidden", true)
	set_meta("world_feed_safe_shell_packet_redirected_at_ms", int(Time.get_ticks_msec()))

	var rendered: bool = _open_world_tab_shell_immediate("world_feed_safe_shell_packet_native_design")
	if rendered:
		call_deferred("_reconcile_world_tab_deeper_truth_after_open", _build_main_tab_ui_packet_context("world"))

	return rendered
func _reconcile_world_tab_deeper_truth_after_open(context: Dictionary) -> void:
	if current_panel != "world":
		return
	if gs == null:
		return
	if world_feed_popup == null or not world_feed_popup.visible:
		return

	var clean_panel: String = "world"
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)
	if surface_id == "":
		call_deferred("_begin_world_feed_progressive_full_render", "world_tab_deeper_truth_no_surface")
		return

	var packet: Dictionary = {}

	packet = _main_tab_hot_packet_for_context(clean_panel, context)

	if not MainSceneLogic._main_tab_packet_is_renderable(packet):
		packet = _consume_world_tab_prewarmed_packet(context)

	if MainSceneLogic._main_tab_packet_is_renderable(packet):
		_store_main_tab_hot_packet(clean_panel, packet, context)
		_render_world_feed_ui_packet(packet)

	call_deferred("_begin_world_feed_progressive_full_render", "world_tab_deeper_truth_reconciled")
func _consume_world_tab_prewarmed_packet(context: Dictionary) -> Dictionary:
	var clean_panel: String = "world"
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)
	if surface_id == "" or gs == null:
		return {}

	if "reality_orchestrator" in gs and gs.reality_orchestrator != null:
		if gs.reality_orchestrator.has_method("consume_prewarmed_ui_surface_packet"):
			var orchestrated_packet: Dictionary = gs.reality_orchestrator.consume_prewarmed_ui_surface_packet(surface_id, context)
			if MainSceneLogic._main_tab_packet_is_renderable(orchestrated_packet):
				_store_main_tab_hot_packet(clean_panel, orchestrated_packet, context)
				return orchestrated_packet

	if "ui_contract_engine" in gs and gs.ui_contract_engine != null:
		if gs.ui_contract_engine.has_method("consume_prewarmed_surface_packet"):
			var engine_packet: Dictionary = gs.ui_contract_engine.consume_prewarmed_surface_packet(surface_id, context)
			if MainSceneLogic._main_tab_packet_is_renderable(engine_packet):
				_store_main_tab_hot_packet(clean_panel, engine_packet, context)
				return engine_packet

	return {}
func _render_main_tab_ui_packet(panel_id: String, packet: Dictionary) -> bool:
	if typeof(packet) != TYPE_DICTIONARY:
		return false
	if packet.is_empty():
		return false
	if not bool(packet.get("success", false)):
		return false
	if not bool(packet.get("ui_safe", false)):
		return false
	if str(packet.get("contract_status", "")) != "satisfied":
		return false

	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var packet_surface_id: String = str(packet.get("surface_id", "")).strip_edges()

	match clean_panel:
		"life":
			return _render_life_panel_ui_packet(packet)

		"world", "relationships", "career", "school", "activities":
			set_meta("main_tab_packet_used_as_native_tab_door", true)
			set_meta("main_tab_packet_native_tab_panel", clean_panel)
			set_meta("main_tab_packet_native_tab_surface_id", packet_surface_id)
			set_meta("main_tab_packet_native_tab_at_ms", int(Time.get_ticks_msec()))
			set_meta("main_tab_packet_native_tab_no_standard_shell", true)
			set_meta("main_tab_packet_native_tab_generic_panel_forbidden", true)
			set_meta("main_tab_packet_native_tab_reveal_only", true)

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["main_tab_packet_used_as_native_tab_door"] = true
				gs.scenario_state ["main_tab_packet_native_tab_panel"] = clean_panel
				gs.scenario_state ["main_tab_packet_native_tab_surface_id"] = packet_surface_id
				gs.scenario_state ["main_tab_packet_native_tab_at_ms"] = int(Time.get_ticks_msec())
				gs.scenario_state ["main_tab_packet_native_tab_no_standard_shell"] = true
				gs.scenario_state ["main_tab_packet_native_tab_generic_panel_forbidden"] = true
				gs.scenario_state ["main_tab_packet_preserved_existing_tab_design"] = true
				gs.scenario_state ["main_tab_packet_did_not_open_generic_desktop_panel"] = true

			return _open_main_tab_zero_frame_door(clean_panel, "main_tab_ui_packet_native_redirect")

		_:
			return false
func _render_world_feed_ui_packet(packet: Dictionary) -> bool:
	if typeof(packet) != TYPE_DICTIONARY:
		return false

	set_meta("world_feed_ui_packet_redirected_to_native_world_tab", true)
	set_meta("world_feed_ui_packet_generic_shell_forbidden", true)
	set_meta("world_feed_ui_packet_redirected_at_ms", int(Time.get_ticks_msec()))

	return _open_world_tab_shell_immediate("world_feed_ui_packet_native_design")

func _render_hub_ui_packet_as_standard_tab(packet: Dictionary) -> bool:
	var data_raw: Variant = packet.get("data", {})
	if typeof(data_raw) != TYPE_DICTIONARY:
		return false

	var data: Dictionary = data_raw as Dictionary
	var title: String = str(packet.get("title", "EraLife")).strip_edges()
	var theme_id: String = str(packet.get("theme_id", "default")).strip_edges()
	var lines: Array = []

	var subtitle: String = str(packet.get("subtitle", "")).strip_edges()
	if subtitle != "":
		lines.append(subtitle)

	var raw_lines: Variant = data.get("lines", [])
	if typeof(raw_lines) == TYPE_ARRAY:
		for raw_line in raw_lines:
			var clean_line: String = str(raw_line).strip_edges()
			if clean_line != "":
				lines.append(clean_line)

	if lines.is_empty():
		lines.append("This tab is ready. Simulation details may continue stabilizing behind the UI.")

	_show_standard_tab_popup(title, lines, theme_id)

	var sections_raw: Variant = data.get("sections", [])
	if typeof(sections_raw) == TYPE_ARRAY:
		for raw_section in sections_raw:
			if typeof(raw_section) != TYPE_DICTIONARY:
				continue

			var section: Dictionary = raw_section as Dictionary
			if not bool(section.get("visible", true)):
				continue

			var section_label: String = str(section.get("label", section.get("title", section.get("id", "")))).strip_edges()
			if section_label != "":
				_standard_tab_add_section_header(section_label)

			var rows_raw: Variant = section.get("rows", [])
			if typeof(rows_raw) == TYPE_ARRAY:
				for raw_row in rows_raw:
					var row_line: String = MainSceneHelpers._ui_packet_row_to_display_line(raw_row)
					if row_line != "":
						_standard_tab_add_section_header(row_line)

			var section_actions_raw: Variant = section.get("actions", [])
			if typeof(section_actions_raw) == TYPE_ARRAY:
				for raw_section_action in section_actions_raw:
					if typeof(raw_section_action) != TYPE_DICTIONARY:
						continue
					var section_action: Dictionary = raw_section_action as Dictionary
					if not bool(section_action.get("enabled", true)):
						continue
					var section_action_label: String = str(section_action.get("label", section_action.get("title", section_action.get("id", "Action")))).strip_edges()
					var section_legacy_action_id: String = str(section_action.get("legacy_action_id", section_action.get("id", ""))).strip_edges()
					if section_action_label != "" and section_legacy_action_id != "":
						_standard_tab_add_action_button(section_action_label, section_legacy_action_id)

	var surface_actions_raw: Variant = data.get("actions", [])
	if typeof(surface_actions_raw) == TYPE_ARRAY:
		for raw_surface_action in surface_actions_raw:
			if typeof(raw_surface_action) != TYPE_DICTIONARY:
				continue
			var surface_action: Dictionary = raw_surface_action as Dictionary
			if not bool(surface_action.get("enabled", true)):
				continue
			var surface_action_label: String = str(surface_action.get("label", surface_action.get("title", surface_action.get("id", "Action")))).strip_edges()
			var surface_legacy_action_id: String = str(surface_action.get("legacy_action_id", surface_action.get("id", ""))).strip_edges()
			if surface_action_label != "" and surface_legacy_action_id != "":
				_standard_tab_add_action_button(surface_action_label, surface_legacy_action_id)

	return true
func _main_tab_hot_packet_cache() -> Dictionary:
	var raw_cache: Variant = get_meta("main_tab_hot_packet_cache", {})
	if typeof(raw_cache) == TYPE_DICTIONARY:
		return (raw_cache as Dictionary).duplicate(true)
	return {}


func _commit_main_tab_hot_packet_cache(cache: Dictionary) -> void:
	set_meta("main_tab_hot_packet_cache", cache.duplicate(true))


func _main_tab_hot_packet_cache_key(panel_id: String, context: Dictionary) -> String:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var surface_id: String = str(context.get("surface_id", _main_tab_surface_id_for_panel(clean_panel))).strip_edges().to_lower()
	var actor_id: int = int(context.get("actor_id", -1))
	var year_value: int = int(context.get("year", 0))
	var age_value: int = int(context.get("age", -1))
	var active_section_id: String = str(context.get("active_section_id", "")).strip_edges().to_lower()
	var revision: String = str(context.get("stable_revision", context.get("revision", ""))).strip_edges()

	if actor_id <= 0 and gs != null and gs.player != null:
		actor_id = int(gs.player.id)
	if year_value <= 0 and gs != null:
		year_value = int(gs.year)
	if age_value < 0 and gs != null and gs.player != null:
		age_value = int(gs.player.age)

	return "%s::%s::actor:%d::year:%d::age:%d::section:%s::rev:%s" % [
		clean_panel,
		surface_id,
		actor_id,
		year_value,
		age_value,
		active_section_id,
		revision
	]


func _store_main_tab_hot_packet(panel_id: String, packet: Dictionary, context: Dictionary) -> void:
	if not MainSceneLogic._main_tab_packet_is_renderable(packet):
		return

	var cache: Dictionary = _main_tab_hot_packet_cache()
	var cache_key: String = _main_tab_hot_packet_cache_key(panel_id, context)

	var stored_packet: Dictionary = packet.duplicate(true)
	stored_packet ["main_tab_hot_cached"] = true
	stored_packet ["main_tab_hot_cache_key"] = cache_key
	stored_packet ["main_tab_hot_cached_at_ms"] = int(Time.get_ticks_msec())

	cache [cache_key] = {
		"panel_id": str(panel_id).strip_edges().to_lower(),
		"surface_id": str(context.get("surface_id", "")),
		"packet": stored_packet,
		"context": context.duplicate(true),
		"created_at_ms": int(Time.get_ticks_msec())
	}

	while cache.size() > 24:
		var keys: Array = cache.keys()
		if keys.is_empty():
			break
		cache.erase(str(keys [0]))

	_commit_main_tab_hot_packet_cache(cache)


func _main_tab_hot_packet_for_context(panel_id: String, context: Dictionary) -> Dictionary:
	var cache: Dictionary = _main_tab_hot_packet_cache()
	var cache_key: String = _main_tab_hot_packet_cache_key(panel_id, context)

	if not cache.has(cache_key):
		return {}

	var cached_raw: Variant = cache.get(cache_key, {})
	if typeof(cached_raw) != TYPE_DICTIONARY:
		return {}

	var cached: Dictionary = cached_raw as Dictionary
	var packet_raw: Variant = cached.get("packet", {})
	if typeof(packet_raw) != TYPE_DICTIONARY:
		return {}

	var packet: Dictionary = (packet_raw as Dictionary).duplicate(true)
	if not MainSceneLogic._main_tab_packet_is_renderable(packet):
		return {}

	packet ["consumed_from_main_tab_hot_cache"] = true
	packet ["consumed_at_ms"] = int(Time.get_ticks_msec())
	return packet


