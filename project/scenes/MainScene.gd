func _meat_market_route_result(report: Dictionary) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report
	]
	var cursor: int = 0
	var inspected: int = 0
	var max_route_result_nodes: int = 24

	while (
		cursor < queue.size()
		and inspected < max_route_result_nodes
	):
		var current_raw: Variant = queue [cursor]
		cursor += 1
		inspected += 1

		if typeof(current_raw) != TYPE_DICTIONARY:
			continue

		var current: Dictionary = current_raw as Dictionary
		if current.is_empty():
			continue

		var schema: String = str(
			current.get(
				"schema",
				""
			)
		).strip_edges()

		var is_meat_market_surface_contract: bool = (
			schema
			== "eralife.market.meat_market.surface_contract"
		)
		var is_meat_market_domain_result: bool = (
			is_meat_market_surface_contract
			or current.has("surface_contract")
			or current.has("food_card_contracts")
			or current.has("listings")
			or current.has("basket")
			or current.has("popup_text")
			or current.has("text")
		)
		var is_meat_market_route_failure: bool = (
			str(
				current.get(
					"engine_property",
					""
				)
			).strip_edges()
			== "meat_market_contract_engine"
			and current.has("reason")
		)

		if (
			is_meat_market_domain_result
			or is_meat_market_route_failure
		):
			return current.duplicate(false)

		for key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = current.get(
				key,
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			queue.append(
				nested
			)

		var handled_raw: Variant = current.get(
			"handled",
			[]
		)

		if typeof(handled_raw) != TYPE_ARRAY:
			continue

		for raw_handled in handled_raw as Array:
			if typeof(raw_handled) != TYPE_DICTIONARY:
				continue

			var handled: Dictionary = (
				raw_handled as Dictionary
			)

			if handled.is_empty():
				continue

			queue.append(
				handled
			)

	return {}
