func _build_life_assets_standard_tab() -> void:
	var property_payload_raw: Variant = standard_tab_popup_payload.get("property_payload", {})
	var vehicle_payload_raw: Variant = standard_tab_popup_payload.get("vehicle_payload", {})

	var property_payload: Dictionary = property_payload_raw if typeof(property_payload_raw) == TYPE_DICTIONARY else {}
	var vehicle_payload: Dictionary = vehicle_payload_raw if typeof(vehicle_payload_raw) == TYPE_DICTIONARY else {}

	var property_rows_raw: Variant = property_payload.get("asset_rows", [])
	var vehicle_rows_raw: Variant = vehicle_payload.get("asset_rows", [])

	var property_rows: Array = property_rows_raw if typeof(property_rows_raw) == TYPE_ARRAY else []
	var vehicle_rows: Array = vehicle_rows_raw if typeof(vehicle_rows_raw) == TYPE_ARRAY else []
	var total_assets: int = property_rows.size() + vehicle_rows.size()

	_standard_tab_add_info_card("ASSET COMMAND", [
		"Browse vehicles and holdings from one non-embedded wealth surface.",
		"The left side now carries the live wealth rollup while the right side stays focused on direct asset control."
	])

	_standard_tab_add_section_header("Wealth Actions")
	if gs != null and gs.player != null and int(gs.player.age) >= 18:
		_standard_tab_add_action_button("Browse Property Market", "Life Assets Open Market::property")
		_standard_tab_add_action_button("Browse Vehicle Market", "Life Assets Open Market::vehicle")
	else:
		_standard_tab_add_info_label("Markets unlock at age 18.")

	var faction_rows: Array = []
	if gs != null and gs.player != null and gs.universal_faction_engine != null:
		var faction_state: Dictionary = gs.universal_faction_engine.export_state()
		var membership_index_raw: Variant = faction_state.get("membership_index", {})
		var membership_index: Dictionary = membership_index_raw if typeof(membership_index_raw) == TYPE_DICTIONARY else {}
		var pressure_model_raw: Variant = faction_state.get("pressure_model", {})
		var pressure_model: Dictionary = pressure_model_raw if typeof(pressure_model_raw) == TYPE_DICTIONARY else {}
		var relationship_graph_raw: Variant = faction_state.get("relationship_graph", {})
		var relationship_graph: Dictionary = relationship_graph_raw if typeof(relationship_graph_raw) == TYPE_DICTIONARY else {}
		var faction_registry_raw: Variant = faction_state.get("faction_registry", {})
		var faction_registry: Dictionary = faction_registry_raw if typeof(faction_registry_raw) == TYPE_DICTIONARY else {}
		var player_memberships_raw: Variant = membership_index.get(str(int(gs.player.id)), {})
		var player_memberships: Dictionary = player_memberships_raw if typeof(player_memberships_raw) == TYPE_DICTIONARY else {}

		for raw_faction_id in player_memberships.keys():
			var faction_id: String = str(raw_faction_id)
			var faction_raw: Variant = faction_registry.get(faction_id, {})
			var faction: Dictionary = faction_raw if typeof(faction_raw) == TYPE_DICTIONARY else {}
			var profile_raw: Variant = pressure_model.get(faction_id, {})
			var profile: Dictionary = profile_raw if typeof(profile_raw) == TYPE_DICTIONARY else {}
			var edges_raw: Variant = relationship_graph.get(faction_id, {})
			var edges: Dictionary = edges_raw if typeof(edges_raw) == TYPE_DICTIONARY else {}

			var contested_claims: int = 0
			var claim_pressure: float = 0.0
			var hidden_instability: float = 0.0
			for raw_other_id in edges.keys():
				var edge_raw: Variant = edges.get(raw_other_id, {})
				var edge: Dictionary = edge_raw if typeof(edge_raw) == TYPE_DICTIONARY else {}
				contested_claims += int(edge.get("contested_claims", 0))
				claim_pressure += float(edge.get("claim_pressure", 0.0))
				if bool(edge.get("contested_hidden_realm", false)):
					hidden_instability += 1.0 + (float(edge.get("hostility", 0.0)) * 0.05)

			var pressure_value: float = float(profile.get("pressure", 0.0))
			var hostility_value: float = float(profile.get("hostility", 0.0))
			var legitimacy_value: float = float(profile.get("legitimacy", 0.0))
			var row_sort: float = pressure_value + claim_pressure + (hostility_value * 0.15) + (hidden_instability * 6.0)

			faction_rows.append({
				"name": str(faction.get("name", "Faction")),
				"kind": str(faction.get("kind", "faction")),
				"pressure": pressure_value,
				"legitimacy": legitimacy_value,
				"hostility": hostility_value,
				"claim_pressure": claim_pressure,
				"contested_claims": contested_claims,
				"hidden_instability": hidden_instability,
				"_sort": row_sort
			})

	faction_rows.sort_custom(func (a, b): return float(a.get("_sort", 0.0)) > float(b.get("_sort", 0.0)))

	_standard_tab_add_section_header("Faction Orbit / Pressure")
	if faction_rows.is_empty():
		_standard_tab_add_info_card("POWER MAP", [
			"No active faction pressure is orbiting this life right now.",
			"When factions start contesting claims, building turf, fighting over succession, pulling on diaspora identity, or destabilizing hidden realms, this surface will show it."
		])
	else:
		_standard_tab_add_info_card("POWER MAP", [
			"See which factions are touching this life right now and where the pressure is actually coming from.",
			"Coups, turf pressure, succession tension, diaspora pull, and hidden-realm instability now surface here instead of staying buried in the graph."
		])

		for faction_index in range(min(5, faction_rows.size())):
			var faction_row: Dictionary = faction_rows [faction_index]
			var parts: Array = []
			parts.append("P %.1f" % float(faction_row.get("pressure", 0.0)))
			parts.append("Leg %.1f" % float(faction_row.get("legitimacy", 0.0)))
			parts.append("Host %.1f" % float(faction_row.get("hostility", 0.0)))
			if float(faction_row.get("claim_pressure", 0.0)) > 0.0:
				parts.append("Claims %.1f" % float(faction_row.get("claim_pressure", 0.0)))
			if int(faction_row.get("contested_claims", 0)) > 0:
				parts.append("Contested %d" % int(faction_row.get("contested_claims", 0)))
			if float(faction_row.get("hidden_instability", 0.0)) > 0.0:
				parts.append("Hidden %.1f" % float(faction_row.get("hidden_instability", 0.0)))

			_standard_tab_add_info_label("%s • %s • %s" % [
				str(faction_row.get("name", "Faction")),
				str(faction_row.get("kind", "faction")).replace("_", " ").capitalize(),
				" • ".join(parts)
			])

	if total_assets == 0:
		_standard_tab_add_section_header("Owned Assets")
		_standard_tab_add_info_label("No controlled assets are currently owned. This surface stays active so markets and future wealth systems always have a home.")
	else:
		if not vehicle_rows.is_empty():
			_standard_tab_add_section_header("Mobility Assets")
			for raw_vehicle_row in vehicle_rows:
				if typeof(raw_vehicle_row) != TYPE_DICTIONARY:
					continue
				var vehicle_row: Dictionary = raw_vehicle_row
				_standard_tab_add_action_button(
					"%s • %s • %s • %s%%" % [
						str(vehicle_row.get("display_name", "Vehicle")),
						str(vehicle_row.get("operator_label", "Owner / Self")),
						str(vehicle_row.get("route_label", "Local Use")),
						int(vehicle_row.get("condition", 100))
					],
					"Life Asset Open::vehicle::%d" % int(vehicle_row.get("asset_id", -1))
				)

		if not property_rows.is_empty():
			_standard_tab_add_section_header(
				"Real Estate"
			)

			for raw_property_row in property_rows:
				if typeof(raw_property_row) != TYPE_DICTIONARY:
					continue

				var property_row: Dictionary = (
					raw_property_row as Dictionary
				)
				var property_asset_id: int = int(
					property_row.get(
						"asset_id",
						-1
					)
				)

				if property_asset_id <= 0:
					continue

				_standard_tab_add_action_button(
					"%s • %s • %s%%"
					% [
						str(
							property_row.get(
								"display_name",
								"Property"
							)
						),
						str(
							property_row.get(
								"address",
								"Unknown Address"
							)
						),
						int(
							property_row.get(
								"condition",
								100
							)
						)
					],
					(
						"Life Asset Open::property::%d"
						% property_asset_id
					)
				)

	_standard_tab_add_section_header("Markets / Securities")
	_standard_tab_add_info_label("Stocks, funds, commodities, crypto, businesses, and later wealth systems can plug into this same surface without changing asset routing.")

