				"death_transition_audio_primed_before_death",
				true
			)
			set_meta(
				"death_transition_startup_prewarm_ready_gate_member",
				false
			)

		21:
			set_meta(
				"startup_modal_renderer_chassis_incremental_complete",
				true
			)
			set_meta(
				"startup_modal_renderer_chassis_incremental_complete_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)
			set_meta(
				"startup_modal_renderer_chassis_ready_gate_member",
				false
			)
			set_meta(
				"action_result_popup_build_on_click_forbidden",
				true
			)
			set_meta(
				"crown_hub_build_on_click_forbidden",
				true
			)
			set_meta(
				"asset_surface_shell_build_on_click_forbidden",
				true
			)
			set_meta(
				"artifact_shop_surface_shell_build_on_click_forbidden",
				true
			)
			set_meta(
				"silk_road_surface_shell_build_on_click_forbidden",
				true
			)
			set_meta(
				"pet_shop_surface_shell_build_on_click_forbidden",
				true
			)
			set_meta(
				"death_transition_build_on_death_forbidden",
				true
			)
			set_meta(
				"startup_child_surface_shells_one_per_frame",
				true
			)
			set_meta(
				"startup_child_surface_shells_ready_gate_member",
				false
			)

			if _try_load_reality_capsule_from_browser_url():
				return

			return

		_:
			return

	_schedule_startup_renderer_chassis_step(
		reason,
		cursor + 1
	)
func _request_silk_road_contract(
	action_id: String,
	payload: Dictionary = {}
) -> Dictionary:
	if (
		gs == null
		or gs.player == null
	):
		return {}

	var actor_id: int = int(
		gs.player.id
	)
	var clean_action: String = str(
		action_id
	).strip_edges().to_lower()
	var clean_payload: Dictionary = (
		payload.duplicate(false)
	)

	if clean_action == "":
		clean_action = "refresh"

	clean_payload [
		"action_id"
	] = clean_action
	clean_payload [
		"actor_id"
	] = actor_id
	clean_payload [
		"source"
	] = str(
		clean_payload.get(
			"source",
			"mainscene.silk_road_intent"
		)
	)

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"intent_type": "silk_road",
				"surface_id": "silk_road",
				"action_id": clean_action,
				"payload": clean_payload.duplicate(false),
				"target": {
					"route_kind": "engine_method",
					"engine_property": "economy_engine",
					"method": "resolve_silk_road_intent",
					"actor_id": actor_id,
					"pass_actor_payload": true
				},
				"source": clean_payload [
					"source"
				]
			},
			{
				"actor_id": actor_id,
				"surface_id": "silk_road",
				"action_id": clean_action,
				"source": clean_payload [
					"source"
				],
				"ui_is_expression_only": true
			}
		)
	)

	return MainSceneHelpers._silk_road_contract_route_result(
		report
	)


func _silk_road_surface_is_hot() -> bool:
	if (
		silk_road_trade_panel == null
		or not is_instance_valid(
			silk_road_trade_panel
		)
		or silk_road_trade_list == null
		or gs == null
		or gs.player == null
	):
		return false

	var contract_raw: Variant = get_meta(
		"silk_road_resident_market_contract",
		{}
	)

	if typeof(
		contract_raw
	) != TYPE_DICTIONARY:
		return false

	var contract: Dictionary = (
		contract_raw as Dictionary
	)

	return (
		not contract.is_empty()
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) == int(
			gs.player.id
		)
		and int(
			contract.get(
				"market_year",
				-999999
			)
		) == int(
			gs.year
		)
		and bool(
			contract.get(
				"projection_composed",
				false
			)
		)
		and bool(
			contract.get(
				"hydrated",
				false
			)
		)
	)


