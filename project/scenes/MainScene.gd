	gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_only_after_player_control_grace"

	var tree:= get_tree()
	if tree == null:
		return

	var world_timer:= tree.create_timer(12.75)
	world_timer.timeout.connect(
		Callable(self, "_continue_post_spawn_world_prewarm").bind(boot_ticket),
		CONNECT_ONE_SHOT
	)

	var soul_timer:= tree.create_timer(18.5)
	soul_timer.timeout.connect(
		Callable(self, "_schedule_background_soul_seed_streaming_loop").bind("post_first_frame_state_only"),
		CONNECT_ONE_SHOT
