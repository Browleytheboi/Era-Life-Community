func _on_afterlife_overlay_gui_input(event) -> void:
	if afterlife_overlay == null or not afterlife_overlay.visible:
		return

	var result_type: String = str(cached_last_result.get("type", ""))
	if not MainSceneHelpers._is_transient_afterlife_overlay_result_type(result_type):
		return

	var should_dismiss:= false
	if event is InputEventMouseButton:
		should_dismiss = event.pressed and event.button_index == MOUSE_BUTTON_LEFT
	elif event is InputEventScreenTouch:
		should_dismiss = event.pressed
	elif event is InputEventKey:
		should_dismiss = event.pressed and not event.echo
	elif event is InputEventJoypadButton:
		should_dismiss = event.pressed

	if not should_dismiss:
		return

	get_viewport().set_input_as_handled()
	_dismiss_transient_afterlife_overlay()
func _on_afterlife_reincarnation_confirm_pressed() -> void:
	if gs == null or gs.afterlife_influence_engine == null:
		return

	var first_name: String = ""
	var last_name: String = ""
	var gender_text: String = "Male"

	if afterlife_reincarnation_first_name_input != null:
		first_name = afterlife_reincarnation_first_name_input.text
	if afterlife_reincarnation_last_name_input != null:
		last_name = afterlife_reincarnation_last_name_input.text
	if afterlife_reincarnation_gender_picker != null and afterlife_reincarnation_gender_picker.item_count > 0:
		gender_text = afterlife_reincarnation_gender_picker.get_item_text(afterlife_reincarnation_gender_picker.selected)

	var result: Dictionary = gs.afterlife_influence_engine.submit_reincarnation_identity(first_name, last_name, gender_text)
	cached_last_result = result
	_show_age_up_output(result)

func _refresh_afterlife_ui_from_result(result: Dictionary) -> void:
	if gs == null:
		return

	var rtype: String = str(result.get("type", ""))
	if not rtype.begins_with("afterlife"):
		_hide_afterlife_ui()
		return

	if rtype == "afterlife_death_prompt":
		_show_afterlife_death_prompt(result)
		return

	_show_afterlife_overlay(result)

func _try_surface_controlled_death_after_age_up(reason: String = "age_up") -> bool:
	if gs == null or gs.player == null:
		return false

	var controlled_actor: Person = gs.player
	var is_dead: bool = not bool(controlled_actor.alive) or float(controlled_actor.health) <= 0.0
	if not is_dead:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var death_key: String = "%d:%d:%s" % [
		int(controlled_actor.id),
		int(gs.year),
		str(controlled_actor.cause_of_death)
	]

	if str(gs.scenario_state.get("controlled_death_prompt_surface_key", "")) == death_key:
		return true

	gs.scenario_state ["controlled_death_prompt_surface_key"] = death_key
	gs.scenario_state ["controlled_death_prompt_surface_reason"] = reason
	gs.scenario_state ["controlled_death_prompt_surface_at_ms"] = int(Time.get_ticks_msec())

	var death_result: Dictionary = {}
	if gs.life_engine != null and gs.life_engine.has_method("_handle_player_death"):
		death_result = gs.life_engine.call("_handle_player_death")

	if death_result.is_empty():
		death_result = {
			"type": "afterlife_death_prompt",
			"text": "I died.",
			"opps": [
				"Continue as a descendant",
				"Start a random life",
				"Rewind one year"
			]
		}

	if str(death_result.get("type", "")) == "afterlife_death_prompt":
		_refresh_afterlife_ui_from_result(death_result)
	else:
		_show_age_up_output(death_result, false, "controlled_death_after_age_up")

	return true
func _on_afterlife_action_pressed(
	action_label: String
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var clean_action_label: String = str(
		action_label
	).strip_edges()

	if clean_action_label == "":
		return

	afterlife_action_sequence += 1





	afterlife_action_queue.append({
		"sequence": afterlife_action_sequence,
		"actor_id": int(
			gs.player.id
		),
		"action_label": clean_action_label,
		"queued_at_ms": int(
			Time.get_ticks_msec()
		),
		"immutable": true,
		"blocks_ui": false,
		"ui_is_renderer_only": true
	})

	set_meta(
		"afterlife_press_engine_call_performed",
		false
	)
	set_meta(
		"afterlife_press_contract_build_performed",
		false
	)
	set_meta(
		"afterlife_press_intent_queued",
		true
	)

	_arm_afterlife_action_service()
func _arm_afterlife_action_service() -> void:
	if (
		afterlife_action_service_active
		or afterlife_action_queue.is_empty()
	):
		return

	var tree:= get_tree()

	if tree == null:
		return

	afterlife_action_service_active = true

	var timer:= tree.create_timer(
		0.002,
		true,
		false,
		true
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_afterlife_action_queue"
		),
		CONNECT_ONE_SHOT
	)


func _service_afterlife_action_queue() -> void:
	afterlife_action_service_active = false

	if afterlife_action_queue.is_empty():
		return

	var request: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			afterlife_action_queue.pop_front()
		)
	)

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)

	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
	):
		_arm_afterlife_action_service()
		return

	_bind_continue_lineage_commit_publication()

	var result: Dictionary = (
		_resolve_activity_action(
			str(
				request.get(
					"action_label",
					""
				)
			)
		)
	)

	cached_last_result = (
		result.duplicate(
			false
		)
	)

	var result_type: String = str(
		result.get(
			"type",
			""
		)
	).strip_edges().to_lower()

	if result_type in [
		"afterlife_exit_custom_life",
		"afterlife_exit_random_life"
	]:
		_route_afterlife_new_life_exit(
			result
		)
	elif result_type.begins_with(
		"afterlife"
	):
		_refresh_afterlife_ui_from_result(
			result
		)
		_hide_scenario_ui()
	else:
		_show_age_up_output(
			result
		)

	_arm_afterlife_action_service()

func _bind_continue_lineage_commit_publication() -> void:
	if (
		gs == null
		or gs.afterlife_influence_engine == null
		or not gs.afterlife_influence_engine.has_signal(
			"continue_lineage_commit_published"
		)
	):
		return

	var callback:= Callable(
		self,
		"_on_continue_lineage_commit_published"
	)

	if not gs.afterlife_influence_engine.is_connected(
		"continue_lineage_commit_published",
		callback
	):
		gs.afterlife_influence_engine.connect(
			"continue_lineage_commit_published",
			callback
		)


func _on_continue_lineage_commit_published(
	result: Dictionary
) -> void:
	if result.is_empty():
		return

	cached_last_result = (
		result.duplicate(
			false
		)
	)



	_show_age_up_output(
		result
	)
func _route_afterlife_new_life_exit(
	result: Dictionary
) -> void:
	var result_type: String = str(
		result.get(
			"type",
			""
		)
	).strip_edges().to_lower()

	if result_type not in [
		"afterlife_exit_custom_life",
		"afterlife_exit_random_life"
	]:
		return

	_terminate_death_transition_audio_for_world_seed_exit(
		result_type,
		false
	)

	_hide_afterlife_ui()
	_hide_scenario_ui()

	if result_type == "afterlife_exit_random_life":
		age_up_diary_entries.clear()
		current_opportunities_cache.clear()

	var tree:= get_tree()

	if tree == null:
		return


	await tree.process_frame

	_return_to_god_mode_selection_center(
		false
	)



	await tree.process_frame

	if result_type == "afterlife_exit_custom_life":

		_on_choose_ereality_entry_pressed()
		return



	_on_god_mode_start_random_life_pressed()

