	_show_bending_match_archive_popup(payload)
func _resolve_bending_hub_enter_tournament_deferred(actor_id: int, _attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	var actor: Person = _bending_hub_actor_for_async_payload(actor_id)
	if gs == null or actor == null:
		set_meta("bending_hub_async_tournament_payload_pending", false)
		set_meta("bending_hub_async_tournament_payload_kind", "")
		bending_hud_last_rebuild_signature = ""
		_invalidate_bending_hub_runtime_surface_cache("enter_bending_world_championship_actor_missing")
		_update_bending_hud()
		return

	var tournament_runtime: Object = null
	if gs.bending_engine != null and (
		gs.bending_engine.has_method("enter_bending_world_championship")
		or gs.bending_engine.has_method("enter_world_championship")
	):
		tournament_runtime = gs.bending_engine
	elif "bending_tournament_engine" in gs and gs.bending_tournament_engine != null and (
		gs.bending_tournament_engine.has_method("enter_bending_world_championship")
		or gs.bending_tournament_engine.has_method("enter_world_championship")
	):
		tournament_runtime = gs.bending_tournament_engine

	if tournament_runtime == null:
		set_meta("bending_hub_async_tournament_payload_pending", false)
		set_meta("bending_hub_async_tournament_payload_kind", "")
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Tournament Runtime Missing",
			"popup_text": "The Bending World Championship entry contract is not wired on the active tournament runtime.",
			"popup_footer": "Tap anywhere to continue."
		})
		bending_hud_last_rebuild_signature = ""
		_invalidate_bending_hub_runtime_surface_cache("enter_bending_world_championship_runtime_missing")
		_update_bending_hud()
		_request_bending_hub_surface_prewarm(true)
		return

	var result: Dictionary = {}
	var raw_result: Variant = {}
	if tournament_runtime.has_method("enter_bending_world_championship"):
		raw_result = tournament_runtime.call("enter_bending_world_championship", actor, {
			"source": "bending_hub_enter_tournament_deferred",
			"allow_press_conference": true,
			"actor_id": int(actor.id),
			"force_include_actor": true,
			"repair_missing_match": true,
			"faction_fillers_enabled": true,
			"surface_already_asserted": true,
			"ui_must_not_wait_for_runtime": true
		})
	elif tournament_runtime.has_method("enter_world_championship"):
		raw_result = tournament_runtime.call("enter_world_championship", actor, {
			"source": "bending_hub_enter_tournament_deferred",
			"allow_press_conference": true,
			"actor_id": int(actor.id),
			"force_include_actor": true,
			"repair_missing_match": true,
			"faction_fillers_enabled": true,
			"surface_already_asserted": true,
			"ui_must_not_wait_for_runtime": true
		})

	if typeof(raw_result) == TYPE_DICTIONARY:
		result = (raw_result as Dictionary).duplicate(true)
	else:
		result = {
			"success": false,
			"popup_title": "Tournament Entry Failed",
			"popup_text": "The tournament runtime returned an invalid entry packet.",
			"popup_footer": "Tap anywhere to continue."
		}

	set_meta("bending_hub_async_tournament_payload_pending", false)
	set_meta("bending_hub_async_tournament_payload_kind", "")

	if result.is_empty():
		result = {
			"success": false,
			"popup_title": "Tournament Entry Failed",
			"popup_text": "The tournament runtime returned an empty entry packet.",
			"popup_footer": "Tap anywhere to continue."
		}

	var scenario: Dictionary = {}
	var scenario_raw: Variant = result.get("scenario", {})
	if typeof(scenario_raw) == TYPE_DICTIONARY:
		scenario = (scenario_raw as Dictionary).duplicate(true)

	var match_payload: Dictionary = {}
	var match_payload_raw: Variant = result.get("match_payload", {})
	if typeof(match_payload_raw) == TYPE_DICTIONARY:
		match_payload = (match_payload_raw as Dictionary).duplicate(true)

	if scenario.is_empty() and not match_payload.is_empty():
		var payload_scenario_raw: Variant = match_payload.get("scenario", {})
		if typeof(payload_scenario_raw) == TYPE_DICTIONARY:
			scenario = (payload_scenario_raw as Dictionary).duplicate(true)

	if not scenario.is_empty():
		var panel_result: Dictionary = scenario.duplicate(true)
		if gs.scenario_engine != null and gs.scenario_engine.has_method("queue_external_scenario"):
			var queue_result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
			if not queue_result.is_empty():
				panel_result = queue_result.duplicate(true)

		if not panel_result.has("uses_scenario_panel"):
			panel_result ["uses_scenario_panel"] = true
		if not panel_result.has("panel_title"):
			panel_result ["panel_title"] = str(result.get("popup_title", "BENDING WORLD CHAMPIONSHIP"))
		if not panel_result.has("footer_text"):
			panel_result ["footer_text"] = str(result.get("popup_footer", "Choose your move."))
		if not panel_result.has("opps"):
			panel_result ["opps"] = []

		_refresh_scenario_ui_from_result(panel_result)

		if scenario_panel != null:
			scenario_panel.visible = true
			scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
			scenario_panel.z_as_relative = false
			scenario_panel.z_index = 1000
			_bring_modal_to_front(scenario_panel)

		bending_hud_last_rebuild_signature = ""
		_invalidate_bending_hub_runtime_surface_cache("entered_bending_world_championship")
		_update_bending_hud()
		return

	var frames_raw: Variant = result.get("spectator_frames", [])
	var frames: Array = frames_raw if typeof(frames_raw) == TYPE_ARRAY else []
	if frames.is_empty() and not match_payload.is_empty():
		var payload_frames_raw: Variant = match_payload.get("spectator_frames", [])
		if typeof(payload_frames_raw) == TYPE_ARRAY:
			frames = payload_frames_raw

	if not frames.is_empty():
		result ["spectator_frames"] = frames.duplicate(true)

	var combat_ui_raw: Variant = result.get("combat_ui", {})
	var combat_ui: Dictionary = combat_ui_raw if typeof(combat_ui_raw) == TYPE_DICTIONARY else {}
	if combat_ui.is_empty() and not frames.is_empty() and typeof(frames [0]) == TYPE_DICTIONARY:
		var first_frame: Dictionary = frames [0]
		var frame_combat_raw: Variant = first_frame.get("combat_ui", {})
		if typeof(frame_combat_raw) == TYPE_DICTIONARY:
			combat_ui = (frame_combat_raw as Dictionary).duplicate(true)

	var should_use_scenario_panel: bool = (
		bool(result.get("uses_scenario_panel", false))
		or not frames.is_empty()
		or bool(combat_ui.get("visible", false))
	)

	if should_use_scenario_panel:
		result ["uses_scenario_panel"] = true
		if not result.has("panel_title"):
			result ["panel_title"] = str(result.get("popup_title", "BENDING WORLD CHAMPIONSHIP"))
		if not result.has("text"):
			result ["text"] = str(result.get("popup_text", result.get("prompt", "")))
		if not result.has("footer_text"):
			result ["footer_text"] = str(result.get("popup_footer", "Tournament reality resolved."))
		if not result.has("opps"):
			result ["opps"] = []

		_refresh_scenario_ui_from_result(result)

		if scenario_panel != null:
			scenario_panel.visible = true
			scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
			scenario_panel.z_as_relative = false
			scenario_panel.z_index = 1000
			_bring_modal_to_front(scenario_panel)

		bending_hud_last_rebuild_signature = ""
		_invalidate_bending_hub_runtime_surface_cache("entered_bending_world_championship_panel_packet")
		_update_bending_hud()
		return

	_maybe_show_action_result_popup(result)
	bending_hud_last_rebuild_signature = ""
	_invalidate_bending_hub_runtime_surface_cache("entered_bending_world_championship_no_scenario")
	_update_bending_hud()
func _add_bending_archive_replay_rows_to_box(box: VBoxContainer, title: String, rows: Array, max_rows: int = 5) -> void:
	var title_label:= Label.new()
	title_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	title_label.text = "\n%s" % title
	box.add_child(title_label)

	if rows.is_empty():
		var empty_label:= Label.new()
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.text = "No archived matches yet."
		box.add_child(empty_label)
		return

	for i in range(min(max_rows, rows.size())):
		if typeof(rows [i]) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = rows [i]
		var match_id: String = str(row.get("match_id", "")).strip_edges()

		var row_box:= HBoxContainer.new()
		row_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL

		var label:= Label.new()
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		label.text = "%s • %s\n%s\nLegend Score: %d%s" % [
			str(row.get("year_label", str(row.get("year", "")))),
			str(row.get("title", "Archived Match")),
			str(row.get("myth_line", row.get("summary", ""))),
			int(row.get("legendary_score", 0)),
			" • MYTHIC" if bool(row.get("mythic", false)) else ""
		]
		row_box.add_child(label)

		var replay_btn:= Button.new()
		replay_btn.text = "Rewatch"
		replay_btn.disabled = match_id == ""
		replay_btn.tooltip_text = "Replay this archived match through the Scenario panel."
		if match_id != "":
			replay_btn.pressed.connect(_on_bending_hub_rewatch_archived_match_pressed.bind(match_id))
		row_box.add_child(replay_btn)

		box.add_child(row_box)


func _on_bending_hub_rewatch_archived_match_pressed(match_id: String) -> void:
	if gs == null or gs.bending_engine == null:
		return

	if not gs.bending_engine.has_method("get_bending_match_replay_payload"):
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Match Archive",
			"popup_text": "Archived match replay is not available yet.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	_hide_bending_archive_popups_for_replay()

	var result: Dictionary = gs.bending_engine.get_bending_match_replay_payload(match_id, {
		"source": "bending_hub_rewatch_archived_match",
	})

	if bool(result.get("uses_scenario_panel", false)):
		_refresh_scenario_ui_from_result(result)
		if scenario_panel != null:
			scenario_panel.visible = true
			scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
			scenario_panel.z_as_relative = false
			scenario_panel.z_index = 1000
			_bring_modal_to_front(scenario_panel)
	else:
		_maybe_show_action_result_popup(result)
func _hide_bending_archive_popups_for_replay() -> void:
	for raw_child in get_children():
		if raw_child == null:
			continue
		if raw_child is AcceptDialog:
			var popup: AcceptDialog = raw_child
			var popup_title: String = str(popup.title).strip_edges().to_lower()
			if popup_title in ["bending tournament history", "bending match archive"]:
				popup.hide()

