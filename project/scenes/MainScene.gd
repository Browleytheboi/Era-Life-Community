func _on_superpower_hub_detail_action_pressed(action: Dictionary) -> void:
	var detail_action: String = str(action.get("detail_action", "")).strip_edges().to_lower()
	match detail_action:
		"execute_power_action":
			_execute_power_action_from_detail_panel(
				_superpower_hub_safe_dictionary(action.get("base_action", {})),
				_superpower_hub_safe_dictionary(action.get("extra_payload", {})),
				str(action.get("source_hub", "power_hub"))
			)
		"execute_superhero_hub_action":
			_execute_superhero_hub_action_from_detail_panel(
				_superpower_hub_safe_dictionary(action.get("base_action", {})),
				_superpower_hub_safe_dictionary(action.get("extra_payload", {})),
				str(action.get("source_hub", "superhero_hub"))
			)
		"pick_power_target":
			_open_power_target_picker_panel(
				_superpower_hub_safe_dictionary(action.get("base_action", {})),
				str(action.get("source_hub", "power_hub"))
			)
		"pick_power_target_use_mode":
			_open_power_target_use_mode_panel(
				_superpower_hub_safe_dictionary(action.get("base_action", {})),
				int(action.get("target_person_id", -1)),
				str(action.get("target_name", "Target")),
				str(action.get("source_hub", "power_hub"))
			)
		_:
			_hide_superpower_hub_detail_panel()


