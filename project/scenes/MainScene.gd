				"text",
				"Done."
			)
		)
func _ensure_persistent_main_tab_renderer_chassis(
		reason: String = "persistent_main_tab_renderer_chassis"
) -> Dictionary:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)



	_ensure_world_feed_popup()
	_ensure_activities_hub_panel()
	_ensure_career_hub_panel()

	var relationship_panel: RelationshipHubPanel = (
		_ensure_relationship_hub_panel()
	)
	var school_panel: SchoolHubPanel = (
		_ensure_school_hub_panel()
	)

	_ensure_mod_menu_panel()
	_ensure_mod_bundle_menu_panel()
	_ensure_crime_panel()

	if (
		world_feed_popup != null
		and is_instance_valid(
			world_feed_popup
		)
	):
		world_feed_popup.name = "WorldFeedPopup"
		world_feed_popup.visible = false
		world_feed_popup.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		world_feed_popup.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		world_feed_popup_open = false

	if (
		world_feed_popup_feed != null
		and is_instance_valid(
			world_feed_popup_feed
		)
	):
		world_feed_popup_feed.name = "WorldFeedPopupFeed"

		if str(
			world_feed_popup_feed.get_parsed_text()
		).strip_edges() == "":
			world_feed_popup_feed.clear()
			world_feed_popup_feed.append_text(
				"WORLD\n\n"
			)
