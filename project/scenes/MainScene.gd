	report: Dictionary,
	signature: String,
	reason: String = "god_mode_stage_zero_frame_entry"
) -> void:
	var raw_gs: Variant = report.get(
		"game_state",
		null
	)

	if not (
		raw_gs is GameState
	):
		return

	var staged_gs: GameState = raw_gs as GameState

	if staged_gs == null or staged_gs.player == null:
		return










	if gs != staged_gs:
		set_meta(
			"god_mode_zero_frame_entry_refused_unadopted_game_state",
