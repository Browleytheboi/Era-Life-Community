func _finish_action_result_popup_after_first_paint(
	result: Dictionary,
	generation: int
) -> void:
	await RenderingServer.frame_post_draw

	if (
		not action_result_popup_open
		or action_result_popup == null
		or not is_instance_valid(action_result_popup)
		or int(
			action_result_popup.get_meta(
				"action_result_popup_generation",
				-1
			)
		) != generation
	):
		return

	var supplied_popup_text: String = str(
		result.get(
			"popup_text",
			""
		)
	).strip_edges()

	if supplied_popup_text == "":
		var normalized_popup_text: String = (
			_player_diary_text_to_popup_text(
				str(
					result.get(
						"text",
						""
					)
				).strip_edges()
			)
		)

		if (
			normalized_popup_text != ""
			and action_result_popup_body != null
			and is_instance_valid(
				action_result_popup_body
			)
		):
			action_result_popup_body.text = (
				normalized_popup_text
			)
			action_result_popup_body.scroll_to_line(
				0
			)

	action_result_popup.set_meta(
		"action_result_popup_text_conversion_pending",
		false
	)


	_apply_action_result_popup_layout_for_result(
		result
	)

	var tree:= get_tree()

	if tree != null:
		await tree.process_frame

	if (
		not action_result_popup_open
		or action_result_popup == null
		or not is_instance_valid(action_result_popup)
		or int(
			action_result_popup.get_meta(
				"action_result_popup_generation",
				-1
			)
		) != generation
	):
		return

	_render_action_result_popup_choices(
		result
	)

	if tree != null:
		await tree.process_frame

	if (
		not action_result_popup_open
		or action_result_popup == null
		or not is_instance_valid(action_result_popup)
		or int(
			action_result_popup.get_meta(
				"action_result_popup_generation",
				-1
			)
		) != generation
	):
		return

	var applied_elemental_popup_theme: bool = (
		_apply_action_result_elemental_popup_theme(
			result
		)
	)

	if (
		action_result_popup_card != null
		and gs != null
		and gs.player != null
		and not applied_elemental_popup_theme
	):
		action_result_popup_card.add_theme_stylebox_override(
			"panel",
			_build_era_surface_panel_style(
				"main",
				false,
				0.0,
				false
			)
		)

	_play_reality_surge_from_result(
		result
	)

	set_meta(
		"action_result_popup_optional_visual_tail_pending",
		false
	)
	set_meta(
		"action_result_popup_first_paint_completed_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"action_result_popup_layout_completed_after_visibility",
		true
	)
	set_meta(
		"action_result_popup_choices_completed_after_visibility",
		true
	)
func _action_result_should_become_pending_popup_contract(result: Dictionary) -> bool:
	if typeof(result) != TYPE_DICTIONARY:
		return false

	if bool(result.get("force_immediate_popup", false)):
		return false

	if bool(result.get("queue_as_pending_situation", false)) or bool(result.get("popup_choices_are_contracts", false)):
		return true

	var response_options_raw: Variant = result.get("response_options", result.get("opps", []))
	if typeof(response_options_raw) == TYPE_ARRAY and not (response_options_raw as Array).is_empty():
		var result_type: String = str(result.get("type", "")).strip_edges().to_lower()
		if result_type in ["scenario_prompt", "enter_universe_after_popup"]:
			return false
		return true

	return false


func _emit_pending_popup_contract_from_action_result(result: Dictionary, context: Dictionary = {}) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	if gs.scenario_popup_contract_engine == null:
		gs.scenario_popup_contract_engine = ScenarioPopupContractEngine.new(gs)

	if gs.scenario_runtime_contract_engine == null:
		gs.scenario_runtime_contract_engine = ScenarioRuntimeContractEngine.new(gs)

	if gs.pending_situations_engine == null:
		gs.pending_situations_engine = PendingSituationsEngine.new(gs)

	var report: Dictionary = gs.scenario_popup_contract_engine.emit_from_action_result(result, context)
	if bool(report.get("success", false)):
		set_meta("pending_situations_dirty", true)
		set_meta("pending_situations_last_emit_ms", int(Time.get_ticks_msec()))

	return report


