func _relationship_profile_popup_fill_text_deferred(target_id: int, render_token: int) -> void:
	await get_tree().process_frame

	var target: Person = _relationship_profile_popup_safe_target_for_render(target_id, render_token)
	if target == null:
		return

	var profile_lines: Array = _relationship_profile_popup_fast_profile_lines(target)

	if not _relationship_profile_popup_render_is_current(target_id, render_token):
		return

	relationship_profile_popup_profile.clear()

	var appended: int = 0
	for line in profile_lines:
		if not _relationship_profile_popup_render_is_current(target_id, render_token):
			return

		relationship_profile_popup_profile.append_text(str(line) + "\n")
		appended += 1

		if appended % 4 == 0:
			_prioritize_relationship_profile_popup_layer()
			await get_tree().process_frame

	_prioritize_relationship_profile_popup_layer()

	call_deferred("_relationship_profile_popup_fill_memory_deferred", target_id, render_token)
func _relationship_profile_popup_fill_memory_deferred(target_id: int, render_token: int) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().process_frame

	var target: Person = _relationship_profile_popup_safe_target_for_render(target_id, render_token)
	if target == null:
		return

	if gs == null or gs.narrative_engine == null:
		return

	var memory_lines: Array = MainSceneLogic._relationship_profile_narrative_memory_lines(gs, target)
	if memory_lines.is_empty():
		return

	for line in memory_lines:
		if not _relationship_profile_popup_render_is_current(target_id, render_token):
			return

		relationship_profile_popup_profile.append_text(str(line) + "\n")
		await get_tree().process_frame

	_prioritize_relationship_profile_popup_layer()



