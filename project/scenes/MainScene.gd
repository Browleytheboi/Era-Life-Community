func _schedule_runtime_huds_after_boxing_reveal(reason: String = "boxing_hud_reveal_after_action_result_popup") -> void:
	if bool(get_meta("boxing_hud_reveal_runtime_hud_tail_pending", false)):
		return

	set_meta("boxing_hud_reveal_runtime_hud_tail_pending", true)
	set_meta("boxing_hud_reveal_runtime_hud_tail_reason", reason)
	set_meta("boxing_hud_reveal_runtime_hud_tail_started_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_runtime_huds_after_boxing_reveal_tick", reason, 0)
		return

	await tree.process_frame

	var timer:= tree.create_timer(0.2)
	await timer.timeout

	call_deferred("_run_runtime_huds_after_boxing_reveal_tick", reason, 0)

func _run_runtime_huds_after_boxing_reveal_tick(reason: String = "boxing_hud_reveal_after_action_result_popup", pass_index: int = 0) -> void:
	if gs == null or gs.player == null:
		set_meta("boxing_hud_reveal_runtime_hud_tail_pending", false)
		return

	var methods: Array = [
		"_update_belongings_hud",
		"_update_bending_hud",
		"_update_crown_hud",
		"_update_food_lifestyle_hud",
		"_update_rick_weapon_shop_hud",
		"_update_wizard_hud",
		"_update_superpower_hud",
		"_update_power_hud",
		"_sync_runtime_floating_hud_layering"
	]

	if pass_index >= methods.size():
		set_meta("boxing_hud_reveal_runtime_hud_tail_pending", false)
		set_meta("boxing_hud_reveal_runtime_hud_tail_finished_at_ms", int(Time.get_ticks_msec()))
		return

	var method_name: String = str(methods [pass_index])

	match method_name:
		"_update_rick_weapon_shop_hud":
			_update_rick_weapon_shop_hud(false)
		"_sync_runtime_floating_hud_layering":
			_sync_runtime_floating_hud_layering()
		_:
			if has_method(method_name):
				call(method_name)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_runtime_huds_after_boxing_reveal_tick", reason, pass_index + 1)
		return

	await tree.process_frame

	call_deferred("_run_runtime_huds_after_boxing_reveal_tick", reason, pass_index + 1)
