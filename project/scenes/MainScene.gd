	)

	if current_panel != "life":
		_invalidate_life_diary_contract_render_cache(
			"spawn_ready_main_shell_first_frame"
		)
		return

	if output_label == null:
		return

	var lines: Array = _ensure_spawn_ready_birth_intro_entry(
		reason
	)

	if lines.is_empty():
		lines = _flatten_life_diary_lines()

	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(gs.player.age),
			"My life has begun."
		]

	output_label.set_meta(
		"life_diary_render_signature",
		_life_diary_render_signature()
	)
	output_label.scroll_active = true
	output_label.bbcode_enabled = true
	_ui_block(lines)
func _ensure_spawn_ready_birth_intro_entry(reason: String = "spawn_ready") -> Array:
	if gs == null or gs.player == null:
		return []

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var player_id: int = int(gs.player.id)

	if _custom_household_existing_life_start_active():
		var custom_intro_key: String = "custom_household_existing_life:%d|year:%d|age:%d" % [
			player_id,
			int(gs.year),
			int(gs.player.age)
		]

		if not bool(gs.scenario_state.get("custom_household_existing_life_diary_committed", false)) \
or str(gs.scenario_state.get("custom_household_existing_life_diary_key", "")) != custom_intro_key:
			age_up_diary_entries.clear()
			_emit_birth_intro_diary_contract_for_current_actor(_custom_household_existing_life_intro_lines(), reason)
			_reset_diary_delta_cursors()

			gs.scenario_state ["custom_household_existing_life_diary_committed"] = true
			gs.scenario_state ["custom_household_existing_life_diary_key"] = custom_intro_key
			gs.scenario_state ["custom_household_existing_life_diary_reason"] = reason
			gs.scenario_state ["custom_household_existing_life_diary_committed_at_ms"] = int(Time.get_ticks_msec())
			gs.scenario_state ["spawn_ready_birth_intro_committed"] = true
			gs.scenario_state ["spawn_ready_birth_intro_committed_key"] = custom_intro_key
			gs.scenario_state ["spawn_ready_birth_intro_committed_reason"] = reason

		var custom_lines: Array = _flatten_life_diary_lines()
		set_meta("life_diary_render_cached_lines", custom_lines.duplicate(true))
		set_meta("life_diary_render_cached_signature", _life_diary_render_signature())
		return custom_lines

	var primary_birth_actor_id: int = MainSceneLogic._spawn_ready_primary_birth_actor_id(gs)

	if player_id != primary_birth_actor_id:
		var switched_lines: Array = _flatten_life_diary_lines()
		set_meta("life_diary_render_cached_lines", switched_lines.duplicate(true))
		set_meta("life_diary_render_cached_signature", _life_diary_render_signature())
		return switched_lines

	var intro_key: String = "player:%d|year:%d|age:%d" % [
		player_id,
		int(gs.year),
		int(gs.player.age)
	]

	var newborn_intro_required: bool = int(gs.player.age) == 0
	var committed_key_matches: bool = (
		bool(gs.scenario_state.get("spawn_ready_birth_intro_committed", false))
		and str(gs.scenario_state.get("spawn_ready_birth_intro_committed_key", "")) == intro_key
	)

	if committed_key_matches and not newborn_intro_required:
		var already_lines: Array = _flatten_life_diary_lines()
		set_meta("life_diary_render_cached_lines", already_lines.duplicate(true))
		set_meta("life_diary_render_cached_signature", _life_diary_render_signature())
		return already_lines

	var existing_intro_ready: bool = false
	if newborn_intro_required:
		existing_intro_ready = false
	else:
		for raw_entry in age_up_diary_entries:
			if typeof(raw_entry) != TYPE_ARRAY:
				continue

			var entry: Array = raw_entry as Array
			for raw_line in entry:
				var line_text: String = str(raw_line).strip_edges()
				var lower_text: String = line_text.to_lower()

				if lower_text.begins_with("my soul was chosen to become the next avatar") \
or lower_text.begins_with("i was conceived ") \
or lower_text.begins_with("i was blessed to be born with ") \
or lower_text.begins_with("i was born in ") \
or lower_text.begins_with("i was reincarnated as ") \
or lower_text.begins_with("i was born a ") \
or lower_text.begins_with("my birthday is ") \
or lower_text.begins_with("my name is ") \
or lower_text.begins_with("my father is ") \
or lower_text.begins_with("my mother is "):
					existing_intro_ready = true
					break

			if existing_intro_ready:
				break

	if not existing_intro_ready:
		var cleaned_entries: Array = []
		for raw_entry in age_up_diary_entries:
			if typeof(raw_entry) != TYPE_ARRAY:
				continue

			var entry: Array = raw_entry as Array
			var keep_entry: bool = false

			for raw_line in entry:
				var line_text: String = str(raw_line).strip_edges()
				var lower_text: String = line_text.to_lower()

				if line_text == "":
					continue
				if lower_text == "no diary entries yet. do something bro.":
					continue
				if lower_text == "my life has begun.":
					continue
				if lower_text.find("the wider world is still stabilizing behind my first playable frame") != -1:
					continue

				keep_entry = true
				break

			if keep_entry:
				cleaned_entries.append(entry.duplicate(true))

		age_up_diary_entries = cleaned_entries

		if not bool(gs.scenario_state.get("spawn_ready_new_life_world_feed_pushed", false)):
			MainSceneLogic._push_new_life_world_feed_entries(gs)
			gs.scenario_state ["spawn_ready_new_life_world_feed_pushed"] = true
			gs.scenario_state ["spawn_ready_new_life_world_feed_actor_id"] = player_id

		var cached_intro_raw: Variant = gs.scenario_state.get("spawn_ready_birth_intro_first_frame_lines", [])
		var intro_lines: Array = cached_intro_raw.duplicate(true) if typeof(cached_intro_raw) == TYPE_ARRAY else []
		if intro_lines.is_empty():
			intro_lines = _build_new_life_intro_lines()

		_emit_birth_intro_diary_contract_for_current_actor(intro_lines, reason)
		_reset_diary_delta_cursors()

		gs.scenario_state ["spawn_ready_birth_intro_committed"] = true
		gs.scenario_state ["spawn_ready_birth_intro_committed_key"] = intro_key
		gs.scenario_state ["spawn_ready_birth_intro_committed_reason"] = reason
		gs.scenario_state ["spawn_ready_birth_intro_committed_at_ms"] = int(Time.get_ticks_msec())
		set_meta("spawn_ready_birth_intro_committed_key", intro_key)
		set_meta("spawn_ready_birth_intro_committed_reason", reason)

	var lines: Array = _flatten_life_diary_lines()
	set_meta("life_diary_render_cached_lines", lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", _life_diary_render_signature())

	return lines
func _set_runtime_button_shell_state(button: Button, should_show: bool, reason: String = "runtime_button_shell_state") -> void:
	if button == null or not is_instance_valid(button):
		return

	button.visible = should_show
	button.disabled = not should_show
	button.mouse_filter = Control.MOUSE_FILTER_STOP if should_show else Control.MOUSE_FILTER_IGNORE

	if should_show:
		button.z_as_relative = false
		button.z_index = max(int(button.z_index), 306)

		if _god_mode_visual_authority_may_be_active():
			set_meta("runtime_hud_button_visible_during_god_mode_handoff", true)
			set_meta("runtime_hud_button_visible_during_god_mode_handoff_at_ms", int(Time.get_ticks_msec()))
			set_meta("runtime_hud_button_visible_during_god_mode_handoff_reason", reason)

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["runtime_hud_button_visible_during_god_mode_handoff"] = true
				gs.scenario_state ["runtime_hud_button_visible_during_god_mode_handoff_at_ms"] = int(Time.get_ticks_msec())
				gs.scenario_state ["runtime_hud_button_visible_during_god_mode_handoff_reason"] = reason

			call_deferred(
				"_force_release_god_mode_handoff_to_visible_life_surface",
				"runtime_hud_button_visible_%s" % reason
			)
func _spawn_ready_runtime_hud_shell_layering_active() -> bool:
	var now_ms: int = int(Time.get_ticks_msec())

	var shell_started_ms: int = int(get_meta("spawn_ready_runtime_hud_shell_only_started_at_ms", 0))
	if shell_started_ms > 0 and now_ms - shell_started_ms <= 4800:
		return true

	var hot_entry_started_ms: int = int(get_meta("god_mode_life_entry_hot_capsule_started_at_ms", 0))
	if hot_entry_started_ms > 0 and now_ms - hot_entry_started_ms <= 5200:
		return true

	if bool(get_meta("god_mode_handoff_cover_release_pending", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var scenario_shell_started_ms: int = int(gs.scenario_state.get("spawn_ready_runtime_hud_shell_only_started_at_ms", 0))
		if scenario_shell_started_ms > 0 and now_ms - scenario_shell_started_ms <= 4800:
			return true

		var scenario_hot_entry_ms: int = int(gs.scenario_state.get("prewarmed_capsule_entry_requested_at_ms", 0))
		if scenario_hot_entry_ms > 0 and now_ms - scenario_hot_entry_ms <= 5200:
			return true

	return false


func _spawn_ready_runtime_hud_visibility_snapshot() -> Dictionary:
	if (
		gs == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return {}

	var snapshot_raw: Variant = (
		gs.scenario_state.get(
			"runtime_hud_visibility_snapshot",
			{}
		)
	)

	if typeof(
		snapshot_raw
	) != TYPE_DICTIONARY:
		return {}

	var snapshot: Dictionary = (
		(snapshot_raw as Dictionary)
		.duplicate(false)
	)

	if (
		gs.player != null
		and int(
			snapshot.get(
				"controlled_actor_id",
				snapshot.get(
					"actor_id",
					snapshot.get(
						"player_id",
						-1
					)
				)
			)
		) != int(
			gs.player.id
		)
	):
		return {}

	snapshot [
		"snapshot_engine_calls"
	] = false
	snapshot [
		"snapshot_person_reactivation_performed"
	] = false
	snapshot [
		"renderer_generated_truth"
	] = false
	snapshot [
		"renderer_mutated_game_state"
	] = false

	return snapshot
func _spawn_ready_shell_entry_should_stream_runtime_hud_hydration() -> bool:
	if bool(get_meta("prewarmed_capsule_entry_shell_first", false)):
		return true

	if bool(get_meta("spawn_ready_runtime_hud_shell_only_active", false)):
		return true

	if bool(get_meta("god_mode_life_boot_uses_prewarmed_spawn", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false)):
			return true
		if bool(gs.scenario_state.get("god_mode_life_prewarm_consumed", false)):
			return true
		if bool(gs.scenario_state.get("spawn_ready_runtime_hud_shell_only_active", false)):
			return true

	return false


func _apply_spawn_ready_runtime_hud_shell_visibility_from_snapshot(snapshot: Dictionary, reason: String = "spawn_ready") -> void:
	var show_belongings: bool = bool(snapshot.get("belongings_available", snapshot.get("belongings_button_visible", false)))
	var show_bending: bool = bool(snapshot.get("bending_available", snapshot.get("bending_button_visible", false)))
	var show_crown: bool = bool(snapshot.get("crown_available", snapshot.get("crown_button_visible", false)))
	if _player_has_crown_presence():
		show_crown = true
		snapshot ["crown_available"] = true
		snapshot ["crown_button_visible"] = true
	var show_food: bool = bool(snapshot.get("food_lifestyle_available", snapshot.get("food_lifestyle_button_visible", false)))
	var show_restaurant: bool = bool(snapshot.get("restaurant_lifestyle_available", snapshot.get("restaurant_lifestyle_button_visible", false)))
	var show_rick: bool = bool(snapshot.get("rick_weapon_shop_available", snapshot.get("rick_weapon_shop_button_visible", false)))
	var show_boxing: bool = bool(snapshot.get("boxing_available", snapshot.get("boxing_button_visible", false)))
	var show_superpower: bool = bool(snapshot.get("superpower_available", snapshot.get("superpower_button_visible", false)))
	var show_power: bool = bool(snapshot.get("power_available", snapshot.get("power_button_visible", false)))
	var show_wizard: bool = bool(snapshot.get("wizard_available", snapshot.get("wizard_button_visible", false)))

	if not show_boxing and not _spawn_ready_runtime_hud_shell_layering_active():
		show_boxing = _player_has_boxing_hub_access()

	if show_belongings:
		_ensure_belongings_hud()
	if show_bending:
		_ensure_bending_hud_button_shell()
	if show_crown:
		_ensure_crown_hud()
	if show_food or show_restaurant:
		_ensure_food_lifestyle_hud()
	if show_rick:
		_ensure_rick_weapon_shop_hud()
	if show_boxing:
		_ensure_boxing_hud()
	if show_superpower:
		_ensure_superpower_hud()
	if show_power:
		_ensure_power_hud()
	if show_wizard:
		_ensure_wizard_hud()

	_set_runtime_button_shell_state(belongings_hud_button, show_belongings)
	_set_runtime_button_shell_state(bending_hud_button, show_bending)
	_set_runtime_button_shell_state(crown_hud_button, show_crown)
	_set_runtime_button_shell_state(food_lifestyle_hud_button, show_food)
	_set_runtime_button_shell_state(restaurant_lifestyle_hud_button, show_restaurant)
	_set_runtime_button_shell_state(rick_weapon_shop_hud_button, show_rick)
	_set_runtime_button_shell_state(boxing_hud_button, show_boxing)
	_set_runtime_button_shell_state(superpower_hud_button, show_superpower)
	_set_runtime_button_shell_state(power_hud_button, show_power)
	_set_runtime_button_shell_state(wizard_hud_button, show_wizard)

	if bending_hud_button != null and is_instance_valid(bending_hud_button) and show_bending:
		bending_hud_button.text = _bending_hud_button_icon()

	if rick_weapon_shop_hud_button != null and is_instance_valid(rick_weapon_shop_hud_button) and show_rick:
		MainSceneLogic._style_rick_weapon_shop_button(rick_weapon_shop_hud_button, 0.5)

	if show_boxing:
		set_meta("boxing_hud_next_light_refresh_ms", int(Time.get_ticks_msec()) + 1600)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var runtime_snapshot: Dictionary = snapshot.duplicate(true)
		runtime_snapshot ["belongings_available"] = show_belongings
		runtime_snapshot ["belongings_button_visible"] = show_belongings
		runtime_snapshot ["bending_button_visible"] = show_bending
		runtime_snapshot ["crown_available"] = show_crown
		runtime_snapshot ["crown_button_visible"] = show_crown
		runtime_snapshot ["food_lifestyle_button_visible"] = show_food
		runtime_snapshot ["restaurant_lifestyle_button_visible"] = show_restaurant
		runtime_snapshot ["rick_weapon_shop_available"] = show_rick
		runtime_snapshot ["rick_weapon_shop_button_visible"] = show_rick
		runtime_snapshot ["boxing_button_visible"] = show_boxing
		runtime_snapshot ["superpower_button_visible"] = show_superpower
		runtime_snapshot ["power_button_visible"] = show_power
		runtime_snapshot ["wizard_button_visible"] = show_wizard
		runtime_snapshot ["updated_at_ms"] = int(Time.get_ticks_msec())

		gs.scenario_state ["runtime_hud_visibility_snapshot"] = runtime_snapshot
		gs.scenario_state ["runtime_hud_visibility_snapshot_reason"] = "%s_shell_visibility_only" % reason
		gs.scenario_state ["runtime_hud_visibility_snapshot_at_ms"] = int(Time.get_ticks_msec())
func _preseal_spawn_ready_runtime_hud_shell_from_snapshot(reason: String = "spawn_ready") -> void:
	var snapshot: Dictionary = _spawn_ready_runtime_hud_visibility_snapshot()

	var show_belongings: bool = bool(snapshot.get("belongings_available", snapshot.get("belongings_button_visible", false)))
	var show_bending: bool = bool(snapshot.get("bending_available", snapshot.get("bending_button_visible", false)))
	var show_crown: bool = bool(snapshot.get("crown_available", snapshot.get("crown_button_visible", false)))
	if _player_has_crown_presence():
		show_crown = true
		snapshot ["crown_available"] = true
		snapshot ["crown_button_visible"] = true
	var show_food: bool = bool(snapshot.get("food_lifestyle_available", false))
	var show_restaurant: bool = bool(snapshot.get("restaurant_lifestyle_available", false))
	var show_rick: bool = bool(snapshot.get("rick_weapon_shop_available", false))
	var show_boxing: bool = bool(snapshot.get("boxing_available", snapshot.get("boxing_button_visible", false))) or _player_has_boxing_hub_access()
	var show_superpower: bool = bool(snapshot.get("superpower_available", false))
	var show_power: bool = bool(snapshot.get("power_available", false))
	var show_wizard: bool = bool(snapshot.get("wizard_available", false))

	if show_belongings:
		_ensure_belongings_hud()
	if show_bending:
		_ensure_bending_hud_button_shell()
	if show_crown:
		_ensure_crown_hud()
	if show_food or show_restaurant:
		_ensure_food_lifestyle_hud()
	if show_rick:
		_ensure_rick_weapon_shop_hud()
	if show_boxing:
		_ensure_boxing_hud()
	if show_superpower:
		_ensure_superpower_hud()
	if show_power:
		_ensure_power_hud()
	if show_wizard:
		_ensure_wizard_hud()

	_apply_spawn_ready_runtime_hud_shell_visibility_from_snapshot(snapshot, "%s_presealed" % reason)
	_sync_runtime_floating_hud_layering()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["runtime_hud_shell_presealed"] = true
		gs.scenario_state ["runtime_hud_shell_presealed_reason"] = reason
		gs.scenario_state ["runtime_hud_shell_presealed_at_ms"] = int(Time.get_ticks_msec())
func _schedule_spawn_ready_runtime_hud_shell_hydration(reason: String = "spawn_ready") -> void:
	if bool(get_meta("spawn_ready_runtime_hud_hydration_pending", false)):
		return

	set_meta("spawn_ready_runtime_hud_hydration_pending", true)
	set_meta("spawn_ready_runtime_hud_hydration_reason", reason)
	set_meta("spawn_ready_runtime_hud_hydration_index", 0)
	set_meta("spawn_ready_runtime_hud_hydration_scheduled_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_spawn_ready_runtime_hud_shell_hydration_tick", reason, 0)
		return

	var timer:= tree.create_timer(0.18)
	timer.timeout.connect(
		Callable(self, "_run_spawn_ready_runtime_hud_shell_hydration_tick").bind(reason, 0),
		CONNECT_ONE_SHOT
	)


func _run_spawn_ready_runtime_hud_shell_hydration_tick(
	reason: String = "spawn_ready",
	pass_index: int = 0
) -> void:
	if not bool(
		get_meta(
			"spawn_ready_runtime_hud_hydration_pending",
			false
		)
	):
		return

	if (
		gs == null
		or gs.player == null
	):
		set_meta(
			"spawn_ready_runtime_hud_hydration_pending",
			false
		)
		return

	var tree:= get_tree()

	if tree == null:
		set_meta(
			"spawn_ready_runtime_hud_hydration_pending",
			false
		)
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		bool(
			get_meta(
				"god_mode_handoff_cover_release_pending",
				false
			)
		)
		and pass_index < 12
	):
		var cover_wait_timer:= tree.create_timer(
			0.18
		)
		cover_wait_timer.timeout.connect(
			Callable(
				self,
				"_run_spawn_ready_runtime_hud_shell_hydration_tick"
			).bind(
				reason,
				pass_index + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	if (
		_post_spawn_ui_is_busy_for_prewarm()
		or _ui_interaction_grace_active(
			now_ms
		)
	):
		var wait_timer:= tree.create_timer(
			0.35
		)
		wait_timer.timeout.connect(
			Callable(
				self,
				"_run_spawn_ready_runtime_hud_shell_hydration_tick"
			).bind(
				reason,
				pass_index + 1
			),
			CONNECT_ONE_SHOT
		)
		return


	await RenderingServer.frame_post_draw

	if not bool(
		get_meta(
			"spawn_ready_runtime_hud_hydration_pending",
			false
		)
	):
		return

	var methods: Array = (
		MainSceneHelpers._spawn_ready_runtime_hud_hydration_methods()
	)
	var index: int = int(
		get_meta(
			"spawn_ready_runtime_hud_hydration_index",
			0
		)
	)
	var processed: int = 0


	while (
		index < methods.size()
		and processed < 1
	):
		var method_name: String = str(
			methods [
				index
			]
		).strip_edges()

		index += 1

		if (
			method_name == ""
			or not has_method(
				method_name
			)
		):
			continue

		call(
			method_name
		)
		processed += 1

	set_meta(
		"spawn_ready_runtime_hud_hydration_index",
		index
	)
	set_meta(
		"spawn_ready_runtime_hud_hydration_last_pass_index",
		pass_index
	)
	set_meta(
		"spawn_ready_runtime_hud_hydration_last_processed",
		processed
	)
	set_meta(
		"spawn_ready_runtime_hud_hydration_last_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"spawn_ready_runtime_hud_hydration_full_panel_build_performed",
		false
	)



	_sync_runtime_floating_hud_layering()

	if index < methods.size():
		var next_timer:= tree.create_timer(
			0.08
		)
		next_timer.timeout.connect(
			Callable(
				self,
				"_run_spawn_ready_runtime_hud_shell_hydration_tick"
			).bind(
				reason,
				pass_index + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	set_meta(
		"spawn_ready_runtime_hud_hydration_pending",
		false
	)
	set_meta(
		"spawn_ready_runtime_hud_hydration_completed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if typeof(
		gs.scenario_state
	) == TYPE_DICTIONARY:
		gs.scenario_state [
			"runtime_hud_shell_hydration_complete"
		] = true
		gs.scenario_state [
			"runtime_hud_shell_hydration_completed_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
		gs.scenario_state [
			"runtime_hud_shell_hydration_completed_reason"
		] = reason
		gs.scenario_state [
			"runtime_hud_shell_hydration_full_panel_build_performed"
		] = false
func _set_spawn_ready_shell_controls_visible_without_truth_work(should_show_controls: bool, reason: String = "spawn_ready") -> void:
	var root:= get_node_or_null("UIContainer") as Control
	if root != null:
		root.visible = true

	if output_label != null and is_instance_valid(output_label):
		output_label.visible = should_show_controls
		output_label.scroll_active = should_show_controls
		output_label.bbcode_enabled = true

	_bind_ui_nav_buttons()

	for key in ui_nav_buttons.keys():
		var button: Button = ui_nav_buttons.get(key, null)
		if button == null or not is_instance_valid(button):
			continue

		button.visible = should_show_controls
		button.disabled = not should_show_controls
		button.mouse_filter = Control.MOUSE_FILTER_STOP if should_show_controls else Control.MOUSE_FILTER_IGNORE

	_apply_ui_nav_button_visuals()

	if not should_show_controls:
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["birth_shell_interactive_controls_visible"] = false
			gs.scenario_state ["birth_shell_controls_visibility_policy"] = "hidden_shell_only"
			gs.scenario_state ["birth_shell_controls_visibility_reason"] = reason
			gs.scenario_state ["birth_shell_controls_visibility_at_ms"] = int(Time.get_ticks_msec())
		return

	_ensure_player_stats_overlay()
	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = gs != null and gs.player != null

	var snapshot: Dictionary = _spawn_ready_runtime_hud_visibility_snapshot()
	var stream_runtime_hud_hydration: bool = _spawn_ready_shell_entry_should_stream_runtime_hud_hydration()

	if stream_runtime_hud_hydration:
		_apply_spawn_ready_runtime_hud_shell_visibility_from_snapshot(snapshot, reason)
		_schedule_spawn_ready_runtime_hud_shell_hydration(reason)
	else:
		_ensure_belongings_hud()
