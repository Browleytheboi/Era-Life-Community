func _ensure_mini_game_panel() -> void:
	if (
		mini_game_panel != null
		and is_instance_valid(mini_game_panel)
	):
		_ensure_mini_game_session_observation_bridge()
		return

	mini_game_panel = MiniGamePanel.new()
	mini_game_panel.name = "MiniGamePanel"
	mini_game_panel.visible = false
	mini_game_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	mini_game_panel.z_as_relative = false



	mini_game_panel.z_index = 1040
	mini_game_panel.set_meta(
		"modal_z_floor",
		1040
	)

	add_child(
		mini_game_panel
	)

	mini_game_panel.prepare_surface()

	mini_game_panel.close_requested.connect(
		_hide_mini_game_panel
	)
	mini_game_panel.intent_requested.connect(
		_on_mini_game_intent_requested
	)

	_ensure_mini_game_session_observation_bridge()

	set_meta(
		"minigame_surface_declared_modal_band",
		1040
	)
	set_meta(
		"minigame_surface_property_viewer_may_not_cover",
		true
	)
	set_meta(
		"minigame_surface_ready_gate_member",
		false
	)
func _ensure_mini_game_session_observation_bridge() -> void:
	var observation_host: GameState = (
		reality_residency_host_game_state
		if reality_residency_host_game_state != null
		else gs
	)

	if (
		observation_host == null
		or observation_host.reality_projection_contract_engine == null
	):
		return

	var projection_authority = (
		observation_host.reality_projection_contract_engine
	)

	if not projection_authority.has_signal(
		"resident_continuous_observation_ready"
	):
		return

	var callback:= Callable(
		self,
		"_on_mini_game_session_observation_ready"
	)

	var observation_signal: Signal = (
		projection_authority
		.resident_continuous_observation_ready
	)

	if observation_signal.is_connected(
		callback
	):
		return

	observation_signal.connect(
		callback
	)

	set_meta(
		"minigame_session_observation_bridge_connected",
		true
	)
	set_meta(
		"minigame_session_observation_bridge_authority",
		"reality_projection_contract_engine"
	)
	set_meta(
		"minigame_session_observation_bridge_resident_attach_stable",
		true
	)
	set_meta(
		"minigame_session_observation_bridge_mutates_truth",
		false
	)
	set_meta(
		"minigame_session_observation_bridge_calls_provider",
		false
	)
	set_meta(
		"minigame_session_observation_bridge_calls_runtime",
		false
	)
func _suspend_property_viewer_for_mini_game_surface(
	reason: String = ""
) -> bool:
	if (
		mini_game_suspended_property_viewer != null
		and is_instance_valid(
			mini_game_suspended_property_viewer
		)
	):
		return true

	if (
		property_viewer_panel == null
		or not is_instance_valid(
			property_viewer_panel
		)
		or not property_viewer_panel.visible
	):
		return false

	var surface: Control = property_viewer_panel

	mini_game_suspended_property_viewer = surface
	mini_game_suspended_property_surface_key = str(
		surface.get_meta(
			"interactive_surface_key",
			"property_viewer_panel"
		)
	).strip_edges()

	mini_game_suspended_property_process_mode = (
		surface.process_mode
	)
	mini_game_suspended_property_mouse_filter = (
		surface.mouse_filter
	)

	surface.visible = false
	surface.mouse_filter = Control.MOUSE_FILTER_IGNORE
	surface.process_mode = Node.PROCESS_MODE_DISABLED

	surface.set_meta(
		"interactive_surface_input_suspended",
		true
	)
	surface.set_meta(
		"interactive_surface_suspended_by",
		"mini_game_panel"
	)
	surface.set_meta(
		"interactive_surface_suspended_reason",
		reason
	)
	surface.set_meta(
		"interactive_surface_suspended_at_ms",
		int(Time.get_ticks_msec())
	)
	surface.set_meta(
		"minigame_fixture_suspend_rebuild_performed",
		false
	)
	surface.set_meta(
		"minigame_fixture_suspend_engine_calls",
		false
	)

	return true

func _restore_property_viewer_after_mini_game_surface(
	reason: String = ""
) -> void:
	var surface: Control = (
		mini_game_suspended_property_viewer
	)

	if (
		surface == null
		or not is_instance_valid(surface)
	):
		mini_game_suspended_property_viewer = null
		mini_game_suspended_property_surface_key = ""
		return

	var surface_key: String = (
		mini_game_suspended_property_surface_key
	)

	if surface_key == "":
		surface_key = "property_viewer_panel"

	surface.process_mode = (
		mini_game_suspended_property_process_mode
	)
	surface.mouse_filter = (
		mini_game_suspended_property_mouse_filter
	)
	surface.visible = true

	surface.set_meta(
		"interactive_surface_input_suspended",
		false
	)
	surface.set_meta(
		"interactive_surface_suspended_by",
		""
	)
	surface.set_meta(
		"interactive_surface_restored_from_minigame_at_ms",
		int(Time.get_ticks_msec())
	)
	surface.set_meta(
		"minigame_fixture_restore_rebuild_performed",
		false
	)
	surface.set_meta(
		"minigame_fixture_restore_engine_calls",
		false
	)

	_claim_interactive_surface_authority(
		surface,
		surface_key,
		reason,
		true,
		true
	)

	mini_game_suspended_property_viewer = null
	mini_game_suspended_property_surface_key = ""
	mini_game_suspended_property_process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	mini_game_suspended_property_mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)

func _show_mini_game_panel(
	contract: Dictionary
) -> void:



	if (
		mini_game_panel == null
		or not is_instance_valid(
			mini_game_panel
		)
	):
		set_meta(
			"minigame_surface_missing_resident_shell",
			true
		)
		return

	if (
		property_viewer_open
		and property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
		and property_viewer_panel.visible
	):
		_suspend_property_viewer_for_mini_game_surface(
			"minigame_fixture_surface_visible"
		)



	mini_game_panel_active_contract = (
		contract.duplicate(false)
	)

	mini_game_panel.render_contract(
		mini_game_panel_active_contract
	)

	_claim_interactive_surface_authority(
		mini_game_panel,
		"mini_game_panel",
		"minigame_contract_observed",
		true,
		true
	)

	mini_game_panel_open = true

	set_meta(
		"minigame_surface_deep_copy_on_observation",
		false
	)
	set_meta(
		"minigame_surface_property_truth_closed",
		false
	)
	set_meta(
		"minigame_surface_build_on_observation",
		false
	)

func _hide_mini_game_panel() -> void:
	if (
		mini_game_panel == null
		or not is_instance_valid(mini_game_panel)
	):
		return

	mini_game_panel.hide_surface()
	mini_game_panel_open = false
	mini_game_pending_session_observation = {}
	mini_game_session_observation_install_armed = false

	_restore_property_viewer_after_mini_game_surface(
		"minigame_fixture_surface_closed"
	)
func _on_mini_game_session_observation_ready(
	session_id: String,
	packet: Dictionary
) -> void:
	if str(
		packet.get(
			"schema",
			""
		)
	).strip_edges().to_lower() != (
		"eralife.minigame_session_observation_packet"
	):
		return

	if str(
		packet.get(
			"observation_channel",
			"minigame_session"
		)
	).strip_edges().to_lower() != "minigame_session":
		return

	if (
		not mini_game_panel_open
		or mini_game_panel == null
		or not is_instance_valid(
			mini_game_panel
		)
	):
		return

	var active_session_raw: Variant = (
		mini_game_panel_active_contract.get(
			"session_contract",
			{}
		)
	)

	if typeof(
		active_session_raw
	) != TYPE_DICTIONARY:
		return

	var active_session: Dictionary = (
		active_session_raw as Dictionary
	)

	if str(
		active_session.get(
			"session_id",
			""
		)
	) != str(session_id):
		return

	mini_game_pending_session_observation = (
		packet.duplicate(false)
	)

	if mini_game_session_observation_install_armed:
		return

	mini_game_session_observation_install_armed = true

	call_deferred(
		"_install_latest_mini_game_session_observation"
	)

func _install_latest_mini_game_session_observation() -> void:
	mini_game_session_observation_install_armed = false

	if mini_game_pending_session_observation.is_empty():
		return

	if (
		not mini_game_panel_open
		or mini_game_panel == null
		or not is_instance_valid(
			mini_game_panel
		)
	):
		mini_game_pending_session_observation = {}
		return

	var packet: Dictionary = (
		mini_game_pending_session_observation
	)

	mini_game_pending_session_observation = {}

	mini_game_panel.render_session_observation_packet(
		packet
	)

	set_meta(
		"minigame_live_observation_last_revision",
		int(
			packet.get(
				"revision",
				-1
			)
		)
	)
	set_meta(
		"minigame_live_observation_hub_rebuild_performed",
		false
	)
	set_meta(
		"minigame_live_observation_engine_calls",
		false
	)

	if not mini_game_pending_session_observation.is_empty():
		mini_game_session_observation_install_armed = true
		call_deferred(
			"_install_latest_mini_game_session_observation"
		)

func _on_mini_game_intent_requested(
