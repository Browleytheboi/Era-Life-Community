func _current_god_mode_era_key_for_presentation() -> String:
	if _god_mode_entry_default_palette_active():
		return "entry_default"

	var era_key:= _selected_era_key()
	if era_key != "":
		return era_key.to_lower()
	if gs != null and gs.custom_settings != null:
		return str(gs.custom_settings.get("era", "Ancient")).to_lower()
	return "ancient"

