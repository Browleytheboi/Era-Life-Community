func _ui_interaction_grace_active(
		now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	var grace_until_ms: int = int(
		get_meta(
			"ui_interaction_grace_until_ms",
			0
		)
	)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		var guard_raw: Variant = gs.scenario_state.get(
			"runtime_guard",
			{}
		)
		var guard: Dictionary = (
			guard_raw
			if typeof(guard_raw) == TYPE_DICTIONARY
			else {}
		)
		grace_until_ms = maxi(
			grace_until_ms,
			int(
				guard.get(
					"ui_interaction_grace_until_ms",
					0
				)
			)
		)

	var grace_active: bool = check_ms < grace_until_ms
	set_meta(
		"playable_life_shell_ui_grace_controls_background_work",
		grace_active
	)
	return grace_active

func _post_age_up_tail_settle_active(now_ms: int = -1) -> bool:
	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	var meta_settle_until_ms: int = int(get_meta("age_up_post_live_tail_settle_until_ms", 0))
	var settle_until_ms: int = meta_settle_until_ms
	var guard_requested_active: bool = false

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}

		guard_requested_active = bool(guard.get("post_age_up_tail_settle_active", false))
		settle_until_ms = max(settle_until_ms, int(guard.get("post_age_up_tail_settle_until_ms", 0)))

		if settle_until_ms <= 0 or check_ms >= settle_until_ms:
			if guard_requested_active or guard.has("post_age_up_tail_settle_until_ms"):
				guard.erase("post_age_up_tail_settle_active")
				guard.erase("post_age_up_tail_settle_until_ms")
				guard.erase("post_age_up_tail_ui_stage_budget")
				guard.erase("post_age_up_tail_rewind_delay_ms")
				guard.erase("post_age_up_tail_speculative_delay_ms")
				gs.scenario_state ["runtime_guard"] = guard

			if meta_settle_until_ms > 0 and check_ms >= meta_settle_until_ms:
				set_meta("age_up_post_live_tail_settle_until_ms", 0)

			return false

	if settle_until_ms <= 0:
		return false

	return check_ms < settle_until_ms
func _background_tail_work_allowed(
		now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	if not _global_runtime_kill_runtime_domain_allows_background_tail(
		check_ms
	):
		return false




	if _playable_life_shell_has_visible_sovereignty():
		set_meta(
			"background_tail_paused_for_interactive_life_shell",
			true
		)
		set_meta(
			"background_tail_paused_for_interactive_life_shell_at_ms",
			check_ms
		)
		set_meta(
			"background_tail_claim_requested_while_interactive",
			false
		)
		set_meta(
			"ui_idle_bus_flush_next_ms",
			check_ms + 1000
		)
		set_meta(
			"age_up_tail_background_allowed_after_ms",
			check_ms + 1000
		)
		set_meta(
			"speculative_year_precompute_next_ms",
			check_ms + 1000
		)

		return false

	if not _global_runtime_kill_claim_allowed(
		"background_tail",
		"Mainscene._background_tail_work_allowed",
		"background_tail_gate",
		{
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": true,
			"microtask_budget": 1
		}
	):
		set_meta(
			"background_tail_blocked_by_global_runtime_kill",
			true
		)
		set_meta(
			"background_tail_blocked_at_ms",
			check_ms
		)
		set_meta(
			"ui_idle_bus_flush_next_ms",
			check_ms + 1200
		)
		return false

	if _zero_frame_switch_surface_lock_active(
		check_ms
	):
		return false

	if _prelife_surface_blocks_runtime_tail():
		return false

	if _life_spawn_runtime_quarantine_active(
		check_ms
	):
		return false

	if bool(
		get_meta(
			"god_mode_handoff_cover_release_pending",
			false
		)
	):
		return false

	if bool(
		get_meta(
			"spawn_ready_ui_first_frame_boundary_active",
			false
		)
	):
		return false

	if _ui_interaction_grace_active(
		check_ms
	):
		return false

	if _runtime_interactive_surface_busy(
		check_ms
	):
		return false

	if action_result_popup_open:
		return false

	if (
		scenario_panel != null
		and is_instance_valid(
			scenario_panel
		)
		and scenario_panel.visible
	):
		return false

	if (
		choose_adventure_scenario_panel != null
		and is_instance_valid(
			choose_adventure_scenario_panel
		)
		and choose_adventure_scenario_panel.visible
	):
		return false

	if panel_content_transition_active:
		return false

	if (
		activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
	):
		return false

	if (
		relationship_profile_popup_open
		or relationships_browser_open
	):
		return false

	if (
		profile_panel_popup != null
		and is_instance_valid(
			profile_panel_popup
		)
		and profile_panel_popup.visible
	):
		return false

	return true
func _schedule_post_loading_idle_refresh_stage(delay_ms: int = 24) -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var safe_delay_ms: int = max(16, delay_ms)

	if _ui_interaction_grace_active(now_ms):
		safe_delay_ms = max(safe_delay_ms, 72)

	set_meta("age_up_post_live_tail_refresh_stage_pending", true)
	set_meta("age_up_post_live_tail_refresh_next_ms", now_ms + safe_delay_ms)
func _drive_pending_post_loading_idle_refresh_stage(now_ms: int) -> void:
	if not bool(get_meta("age_up_post_live_tail_refresh_stage_pending", false)):
		return

	var next_stage_ms: int = int(get_meta("age_up_post_live_tail_refresh_next_ms", 0))
	if next_stage_ms > 0 and now_ms < next_stage_ms:
		return

	if _ui_interaction_grace_active(now_ms):
		_schedule_post_loading_idle_refresh_stage(80)
		return

	set_meta("age_up_post_live_tail_refresh_stage_pending", false)
	_run_post_loading_idle_refresh_stage()
func _run_post_loading_idle_refresh_stage() -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _ui_interaction_grace_active(now_ms):
		_schedule_post_loading_idle_refresh_stage(120)
		return

	var blocking_surface_open: bool = _post_age_up_surface_blocking_live_tail()
	var stage: int = int(
		get_meta(
			"age_up_post_live_tail_refresh_stage",
			0
		)
	)



	match stage:
		0:
			if not blocking_surface_open:
				_request_life_diary_focus_latest_year(
					"post_loading_stage_0"
				)
			set_meta(
				"age_up_post_live_tail_refresh_stage",
				1
			)
			_schedule_post_loading_idle_refresh_stage(96)
			return

		1:
			_apply_ui_nav_button_visuals()
			set_meta(
				"age_up_post_live_tail_refresh_stage",
				2
			)
			_schedule_post_loading_idle_refresh_stage(96)
			return

		2:
			if not blocking_surface_open:
				_reveal_spawn_ready_runtime_hud_buttons_if_existing(
					"post_age_up_resident_snapshot_observation"
				)
			set_meta(
				"age_up_post_live_tail_refresh_stage",
				3
			)
			_schedule_post_loading_idle_refresh_stage(96)
			return

		3:


			belongings_hud_content_dirty = true
			bending_hud_last_rebuild_signature = ""
			wizard_hud_last_signature = ""
			set_meta(
				"post_age_up_contract_projection_observation_pending",
				true
			)
			set_meta(
				"post_age_up_contract_projection_observation_at_ms",
				now_ms
			)
			set_meta(
				"age_up_post_live_tail_refresh_stage",
				4
			)
			_schedule_post_loading_idle_refresh_stage(96)
			return

		_:
			if (
				output_label != null
				and is_instance_valid(output_label)
				and current_panel in ["", "life"]
				and not blocking_surface_open
			):
				output_label.visible = true

			if not blocking_surface_open:
				_request_life_diary_focus_latest_year(
					"post_loading_stage_complete"
				)

			set_meta(
				"age_up_post_live_tail_refresh_stage",
				0
			)
			set_meta(
				"age_up_post_live_tail_refresh_next_ms",
				0
			)
			set_meta(
				"age_up_post_live_tail_refresh_stage_pending",
				false
			)

			_age_up_truth_probe_mark(
				"post_loading_idle_refresh_stage_complete",
				{
					"blocking_surface_open": blocking_surface_open,
				}
			)
			return

