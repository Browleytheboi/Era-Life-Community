func _toggle_belongings_hud() -> void:
	_ensure_belongings_hud()

	if (
		gs == null
		or gs.player == null
		or gs.belongings_engine == null
	):
		return

	var actor_id: int = int(
		gs.player.id
	)
	var previous_actor_id: int = int(
		get_meta(
			"__belongings_hud_actor_id",
			-1
		)
	)

	if previous_actor_id != actor_id:
		belongings_hud_open = false
		belongings_hud_content_dirty = true
		remove_meta(
			"__belongings_hud_force_keep_open"
		)
		remove_meta(
			"__belongings_item_popup_sticky_until_closed"
		)
		remove_meta(
			"__belongings_hud_player_toggled_open"
		)

		if (
			belongings_hud_panel != null
			and is_instance_valid(
				belongings_hud_panel
			)
		):
			belongings_hud_panel.visible = false
			belongings_hud_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		_hide_belonging_item_popup()
		_hide_artifact_target_popup()

	set_meta(
		"__belongings_hud_actor_id",
		actor_id
	)

	var opening: bool = not belongings_hud_open

	_begin_runtime_interaction_quiet_window(
		"toggle_belongings_hud_visual_only",
		120
	)

	belongings_hud_open = opening
	set_meta(
		"__belongings_hud_player_toggled_open",
		belongings_hud_open
	)
	set_meta(
		"__belongings_hud_player_toggle_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"__belongings_hud_click_visual_only",
		true
	)
	set_meta(
		"__belongings_hud_click_sync_inventory_forbidden",
		true
	)
	set_meta(
		"__belongings_hud_click_sync_update_forbidden",
		true
	)
	set_meta(
		"__belongings_hud_click_sync_diary_render_forbidden",
		true
	)
	set_meta(
		"__belongings_hud_click_runtime_hud_snapshot_forbidden",
		true
	)
	set_meta(
		"__belongings_hud_click_pending_situations_refresh_forbidden",
		true
	)

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if belongings_hud_open:
		var return_panel: String = str(
			current_panel
		).strip_edges()

		if return_panel == "":
			return_panel = "life"

		gs.scenario_state [
			"belongings_hud_return_panel"
		] = return_panel
		gs.scenario_state [
			"spawn_shell_last_main_panel"
		] = return_panel
		gs.scenario_state [
			"belongings_hud_actor_id"
		] = actor_id
		gs.scenario_state [
			"belongings_hud_actor_name"
		] = MainSceneHelpers._superpower_hub_actor_label(
			gs.player
		)
		gs.scenario_state [
			"belongings_hud_click_visual_only"
		] = true
		gs.scenario_state [
			"belongings_hud_click_sync_inventory_forbidden"
		] = true
		gs.scenario_state [
			"belongings_hud_click_sync_update_forbidden"
		] = true
		gs.scenario_state [
			"belongings_hud_click_runtime_hud_snapshot_forbidden"
		] = true
		gs.scenario_state [
			"belongings_hud_click_pending_situations_refresh_forbidden"
		] = true

		set_meta(
			"__belongings_hud_force_keep_open",
			true
		)

		if (
			belongings_hud_button != null
			and is_instance_valid(
				belongings_hud_button
			)
		):
			belongings_hud_button.visible = true
			belongings_hud_button.disabled = false
			belongings_hud_button.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)

		if (
			belongings_hud_panel != null
			and is_instance_valid(
				belongings_hud_panel
			)
		):
			belongings_hud_panel.visible = true
			belongings_hud_panel.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			belongings_hud_panel.z_as_relative = false
			belongings_hud_panel.z_index = 304

		if (
			belongings_hud_list != null
			and is_instance_valid(
				belongings_hud_list
			)
			and belongings_hud_list.get_child_count() <= 0
		):
			_paint_belongings_hud_open_placeholder()

		call_deferred(
			"_defer_belongings_hud_content_refresh_after_open",
			0
		)

		EraLog.truth(
			"ERALIFE_BELONGINGS_HUD_TRUTH"
			+ "|actor_id=" + str(actor_id)
			+ "|open=true"
			+ "|runtime_hud_snapshot=false"
			+ "|pending_refresh=false"
			+ "|other_huds_mutated=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	remove_meta(
		"__belongings_hud_force_keep_open"
	)
	remove_meta(
		"__belongings_item_popup_sticky_until_closed"
	)

	_hide_belonging_item_popup()
	_hide_artifact_target_popup()

	if (
		belongings_hud_panel != null
		and is_instance_valid(
			belongings_hud_panel
		)
	):
		belongings_hud_panel.visible = false
		belongings_hud_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	var restore_panel: String = str(
		gs.scenario_state.get(
			"belongings_hud_return_panel",
			"life"
		)
	).strip_edges()

	if restore_panel == "":
		restore_panel = "life"

	current_panel = restore_panel

	if (
		current_panel == "life"
		and output_label != null
		and is_instance_valid(
			output_label
		)
	):
		output_label.visible = true
		output_label.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

	EraLog.truth(
		"ERALIFE_BELONGINGS_HUD_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|open=false"
		+ "|runtime_hud_snapshot=false"
		+ "|pending_refresh=false"
		+ "|other_huds_mutated=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)
func _paint_belongings_hud_open_placeholder() -> void:
	if belongings_hud_title_label != null:
		belongings_hud_title_label.text = "BELONGINGS"
	if belongings_hud_subtitle_label != null:
		belongings_hud_subtitle_label.text = "Inventory surface is opening..."
	if belongings_hud_list == null:
		return

	_clear_container_children(belongings_hud_list)

	var loading_label:= Label.new()
	loading_label.text = "Your belongings are syncing without blocking the UI."
	loading_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	belongings_hud_list.add_child(loading_label)

func _defer_belongings_hud_content_refresh_after_open(attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.player == null or gs.belongings_engine == null:
		return
	if not belongings_hud_open:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var quiet_until_ms: int = int(get_meta("runtime_interaction_quiet_until_ms", 0))
	var animation_pause_until_ms: int = int(get_meta("__belongings_hud_animation_pause_until_ms", 0))
	var wait_until_ms: int = max(quiet_until_ms, animation_pause_until_ms)

	if wait_until_ms > now_ms and attempt < 14:
		var delay_seconds: float = clamp(float(wait_until_ms - now_ms) / 1000.0, 0.05, 0.22)
		var timer:= tree.create_timer(delay_seconds)
		timer.timeout.connect(
			Callable(self, "_defer_belongings_hud_content_refresh_after_open").bind(attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	var placeholder_only: bool = (
		belongings_hud_list != null
		and is_instance_valid(belongings_hud_list)
		and belongings_hud_list.get_child_count() <= 1
	)

	if belongings_hud_content_dirty or placeholder_only:
		_refresh_belongings_hud_contents()
		belongings_hud_content_dirty = false

	_update_belongings_hud()

	if belongings_hud_panel != null and is_instance_valid(belongings_hud_panel) and belongings_hud_open:
		belongings_hud_panel.visible = true
		_bring_modal_to_front(belongings_hud_panel)

func _refresh_belongings_hud_contents() -> void:
	if belongings_hud_list == null:
		return

	_clear_container_children(belongings_hud_list)

	if gs == null or gs.player == null or gs.belongings_engine == null:
		return

	var actor: Person = gs.player
	var actor_id: int = int(actor.id)

	set_meta("__belongings_hud_actor_id", actor_id)
	_sync_controlled_actor_assets_into_belongings(actor, "refresh_belongings_hud_contents")

	var categories: Array = gs.belongings_engine.get_inventory_categories(actor)
	if categories.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "Nothing is stored here yet."
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		belongings_hud_list.add_child(empty_label)
		return

	for category_value in categories:
		var category: String = str(category_value)
		var items: Array = gs.belongings_engine.get_category_items(actor, category)

		var section:= VBoxContainer.new()
		section.add_theme_constant_override("separation", 6)
		belongings_hud_list.add_child(section)

		var header:= Label.new()
		header.text = _build_belongings_category_header_text(category, items)
		header.add_theme_font_size_override("font_size", 18)
		header.add_theme_color_override("font_color", Color(1.0, 0.95, 0.74, 1.0))
		section.add_child(header)

		for raw_item in items:
			if typeof(raw_item) != TYPE_DICTIONARY:
				continue

			var item: Dictionary = raw_item.duplicate(true)
			item ["owner_id"] = actor_id
			item ["controlled_actor_id"] = actor_id

			var card:= PanelContainer.new()
			card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			card.custom_minimum_size = Vector2(0, 86)
			section.add_child(card)

			var card_margin:= MarginContainer.new()
			card_margin.add_theme_constant_override("margin_left", 10)
			card_margin.add_theme_constant_override("margin_top", 10)
			card_margin.add_theme_constant_override("margin_right", 10)
			card_margin.add_theme_constant_override("margin_bottom", 10)
			card.add_child(card_margin)

			var card_box:= VBoxContainer.new()
			card_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			card_box.add_theme_constant_override("separation", 5)
			card_margin.add_child(card_box)

			var resolved_item_name: String = str(item.get("name", "")).strip_edges()
			if resolved_item_name == "":
				resolved_item_name = str(item.get("display_name", item.get("nickname", item.get("type", "Unnamed Item")))).strip_edges()
			if resolved_item_name == "":
				resolved_item_name = "Unnamed Item"

			var open_button:= Button.new()
			open_button.text = resolved_item_name
			open_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			open_button.custom_minimum_size = Vector2(0, 38)
			open_button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
			open_button.pressed.connect(_open_belongings_item_from_hud.bind(item.duplicate(true), category))
			card_box.add_child(open_button)

			var meta_text:= _build_belongings_hud_meta_text(item)
			var meta_label:= Label.new()
			meta_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			if meta_text == "":
				meta_label.text = "Tap the item name for a full overview."
			else:
				meta_label.text = meta_text
			card_box.add_child(meta_label)

			card.set_meta("__artifact_item", item)
			card.set_meta("__artifact_button", open_button)
			card.set_meta("__artifact_meta_label", meta_label)
			card.set_meta("__controlled_actor_id", actor_id)
			_apply_belongings_item_card_visual_state(card, open_button, meta_label, item, 0.0)
func _open_belongings_item_from_hud(
	item: Dictionary,
	category: String
) -> void:
	set_meta(
		"__belongings_hud_animation_pause_until_ms",
		int(Time.get_ticks_msec()) + 360
	)
	set_meta(
		"__belongings_item_popup_opening_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"__belongings_item_popup_sticky_until_closed",
		true
	)
	set_meta(
		"__belongings_hud_force_keep_open",
		true
	)

	belongings_hud_open = true

	_set_runtime_floating_hud_forced_open(
		"belongings",
		true
	)

	var popup_item: Dictionary = (
		item.duplicate(true)
	)
	var normalized_category: String = str(
		category
	).strip_edges()
	var normalized_category_key: String = (
		normalized_category.to_lower()
	)
	var asset_kind: String = str(
		popup_item.get(
			"asset_kind",
			""
		)
	).strip_edges().to_lower()
	var asset_id: int = int(
		popup_item.get(
			"id",
			popup_item.get(
				"asset_id",
				popup_item.get(
					"property_id",
					-1
				)
			)
		)
	)
	var property_item: bool = (
		asset_kind == "property"
		or normalized_category_key in [
			"real estate",
			"property",
			"properties"
		]
	)

	if (
		property_item
		and asset_id > 0
	):
		popup_item ["id"] = asset_id
		popup_item ["asset_id"] = asset_id
		popup_item ["property_id"] = asset_id
		popup_item ["asset_kind"] = "property"
		popup_item ["category"] = "Real Estate"




		set_meta(
			"belongings_property_estate_panel_auto_synthesis_retired",
			true
		)

	_show_belonging_item_popup(
		popup_item,
		category
	)
	if (
		belongings_item_popup != null
		and is_instance_valid(
			belongings_item_popup
		)
	):
		_claim_interactive_surface_authority(
			belongings_item_popup,
			"belongings_item_popup",
			"belongings_item_selected",
			true,
			true
		)
	if (
		property_item
		and asset_id > 0
	):
		_append_belongings_property_resident_actions(
			asset_id,
			popup_item
		)
	if (
		property_item
		and asset_id > 0
		and gs != null
		and gs.player != null
	):
		var property_owner_id: int = int(
			popup_item.get(
				"owner_id",
				int(
					gs.player.id
				)
			)
		)

		_queue_auxiliary_surface_observation_task(
			"property_destination_target",
			int(
				gs.player.id
			),
			"belongings_property_selected",
			{
				"property_id": asset_id,
				"property_owner_id": property_owner_id,
				"source": "belongings_property_selection"
			}
		)

		set_meta(
			"belongings_property_target_observation_armed",
			true
		)
		set_meta(
			"belongings_property_target_observation_property_id",
			asset_id
		)
	belongings_hud_open = true

	_set_runtime_floating_hud_forced_open(
		"belongings",
		true
	)

	if belongings_hud_panel != null:
		belongings_hud_panel.visible = true

	if belongings_hud_button != null:
		belongings_hud_button.visible = true

	set_meta(
		"belongings_property_item_card_opened",
		property_item
	)
	set_meta(
		"belongings_property_item_card_asset_id",
		asset_id
	)
	set_meta(
		"belongings_property_item_bypassed_card",
		false
	)
func _disarm_targeted_property_destination_observation(
	actor_id: int,
	property_id: int
) -> void:
	var queue_raw: Variant = get_meta(
		"first_life_auxiliary_surface_residency_queue",
		[]
	)
	var existing_queue: Array = (
		(queue_raw as Array).duplicate(false)
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)
	var next_queue: Array = []

	for raw_row in existing_queue:
		if typeof(raw_row) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = (
			raw_row as Dictionary
		)
		var task_id: String = str(
			row.get(
				"task_id",
				""
			)
		)
		var row_actor_id: int = int(
			row.get(
				"actor_id",
				-1
			)
		)
		var task_context_raw: Variant = row.get(
			"task_context",
			{}
		)
		var task_context: Dictionary = (
			task_context_raw as Dictionary
			if typeof(task_context_raw) == TYPE_DICTIONARY
			else {}
		)
		var row_property_id: int = int(
			task_context.get(
				"property_id",
				-1
			)
		)

		if (
			task_id == "property_destination_target"
			and row_actor_id == actor_id
			and row_property_id == property_id
		):
			continue

		next_queue.append(
			row
		)

	set_meta(
		"first_life_auxiliary_surface_residency_queue",
		next_queue
	)
	set_meta(
		"belongings_property_target_observation_armed",
		false
	)
	set_meta(
		"belongings_property_target_observation_disarmed_property_id",
		property_id
	)
func _append_belongings_property_resident_actions(
	property_id: int,
	item: Dictionary
) -> void:
	if (
		property_id <= 0
		or belongings_item_popup_actions_box == null
		or not is_instance_valid(
			belongings_item_popup_actions_box
		)
	):
		return

	var explicit_actions: Array = MainSceneHelpers._safe_array(
		item.get(
			"actions",
			[]
		)
	)
	var explicit_party_action: bool = false

	for raw_action in explicit_actions:
		var action: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_action
		)
		var action_id: String = str(
			action.get(
				"action_id",
				action.get(
					"id",
					""
				)
			)
		).strip_edges().to_lower()
		var label: String = str(
			action.get(
				"label",
				""
			)
		).strip_edges().to_lower()

		if (
			action_id.contains(
				"party"
			)
			or label.contains(
				"party"
			)
		):
			explicit_party_action = true
			break

	var section:= Label.new()
	section.text = "PROPERTY"
	section.add_theme_font_size_override(
		"font_size",
		15
	)
	belongings_item_popup_actions_box.add_child(
		section
	)

	for action_row in [
		{
			"action_id": "walk_inside",
			"label": "Walk Inside"
		},
		{
			"action_id": "makeover_property",
			"label": "Makeover / Upgrade"
		}
	]:
		var button:= Button.new()
		button.text = str(
			action_row.get(
				"label",
				"Property Action"
			)
		)
		button.custom_minimum_size = Vector2(
			0,
			42
		)
		button.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		button.pressed.connect(
			Callable(
				self,
				"_on_belongings_property_resident_action_pressed"
			).bind(
				str(
					action_row.get(
						"action_id",
						""
					)
				),
				property_id
			)
		)

		belongings_item_popup_actions_box.add_child(
			button
		)

	if not explicit_party_action:
		var party_button:= Button.new()
		party_button.text = "Throw Party"
		party_button.custom_minimum_size = Vector2(
			0,
			42
		)
		party_button.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		party_button.pressed.connect(
			Callable(
				self,
				"_on_belongings_property_resident_action_pressed"
			).bind(
				"throw_party",
				property_id
			)
		)

		belongings_item_popup_actions_box.add_child(
			party_button
		)

	set_meta(
		"belongings_property_resident_actions_visible",
		true
	)
	set_meta(
		"belongings_property_resident_actions_property_id",
		property_id
	)
func _on_belongings_property_resident_action_pressed(
	action_id: String,
	property_id: int
) -> void:
	if (
		gs == null
		or gs.player == null
		or property_id <= 0
	):
		return

	var clean_action_id: String = str(
		action_id
	).strip_edges().to_lower()
	var actor_id: int = int(
		gs.player.id
	)

	match clean_action_id:
		"walk_inside":
			var prepared_viewer: PropertyViewer = (
				_property_viewer_surface_panel_for(
					actor_id,
					property_id
				)
			)

			if prepared_viewer != null:
				_hide_belonging_item_popup()

				_show_property_viewer_panel(
					gs.player,
					property_id
				)

				if property_viewer_open:
					set_meta(
						"property_viewer_return_surface_key",
						"belongings_hud_panel"
					)
					set_meta(
						"property_viewer_return_surface_actor_id",
						actor_id
					)
				return

			if belongings_item_popup_subtitle != null:
				belongings_item_popup_subtitle.text = (
					"Spatial truth is publishing. You still have full control."
				)

			call_deferred(
				"_service_pending_belongings_property_destination",
				actor_id,
				property_id,
				"interior",
				0
			)
			return

		"makeover_property":
			var prepared_makeover: PropertyMakeoverPanel = (
				_property_makeover_surface_panel_for(
					actor_id,
					property_id
				)
			)

			if prepared_makeover != null:
				_hide_belonging_item_popup()

				_show_property_makeover_panel(
					gs.player,
					property_id
				)

				if property_makeover_open:
					set_meta(
						"property_makeover_return_surface_key",
						"belongings_hud_panel"
					)
					set_meta(
						"property_makeover_return_surface_actor_id",
						actor_id
					)
				return

			if belongings_item_popup_subtitle != null:
				belongings_item_popup_subtitle.text = (
					"Makeover truth is publishing. You still have full control."
				)

			call_deferred(
				"_service_pending_belongings_property_destination",
				actor_id,
				property_id,
				"makeover",
				0
			)
			return

		"throw_party":
			if belongings_item_popup_subtitle != null:
				belongings_item_popup_subtitle.text = (
					"Party intent published."
				)

			call_deferred(
				"_commit_belongings_property_party_intent",
				actor_id,
				property_id
			)
func _service_pending_belongings_property_destination(
	actor_id: int,
	property_id: int,
	mode: String,
	attempt: int = 0
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
		or property_id <= 0
	):
		return

	var clean_mode: String = str(
		mode
	).strip_edges().to_lower()
	var destination_hot: bool = false

	if clean_mode == "makeover":
		destination_hot = (
			_property_makeover_surface_panel_for(
				actor_id,
				property_id
			) != null
		)
	else:
		destination_hot = (
			_property_viewer_surface_panel_for(
				actor_id,
				property_id
			) != null
		)

	if destination_hot:
		_hide_belonging_item_popup()

		if clean_mode == "makeover":
			_show_property_makeover_panel(
				gs.player,
				property_id
			)

			if property_makeover_open:
				set_meta(
					"property_makeover_return_surface_key",
					"belongings_hud_panel"
				)
				set_meta(
					"property_makeover_return_surface_actor_id",
					actor_id
				)
		else:
			_show_property_viewer_panel(
				gs.player,
				property_id
			)

			if property_viewer_open:
				set_meta(
					"property_viewer_return_surface_key",
					"belongings_hud_panel"
				)
				set_meta(
					"property_viewer_return_surface_actor_id",
					actor_id
				)

		return

	if attempt == 0:
		_queue_auxiliary_surface_observation_task(
			"property_destination_target",
			actor_id,
			"belongings_property_spatial_observation",
			{
				"property_id": property_id,
				"property_owner_id": actor_id,
				"source": (
					"belongings_property_spatial_observation"
				)
			}
		)

	if attempt >= 120:
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_pending_belongings_property_destination",
			actor_id,
			property_id,
			clean_mode,
			attempt + 1
		)
		return

	var timer:= tree.create_timer(
		0.04
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_pending_belongings_property_destination"
		).bind(
			actor_id,
			property_id,
			clean_mode,
			attempt + 1
		),
		CONNECT_ONE_SHOT
	)
func _commit_belongings_property_party_intent(
	actor_id: int,
	property_id: int
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
		or property_id <= 0
	):
		return

	var property_contract: Dictionary = {}

	var current_property_id: int = int(
		belongings_item_popup_current_item.get(
			"property_id",
			belongings_item_popup_current_item.get(
				"asset_id",
				belongings_item_popup_current_item.get(
					"id",
					-1
				)
			)
		)
	)

	if current_property_id == property_id:
		property_contract = (
			belongings_item_popup_current_item
			.duplicate(false)
		)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"intent_type": (
				"property_contract_action"
			),
			"surface_id": (
				"belongings_item_popup"
			),
			"action_id": "throw_party",
			"payload": {
				"property_id": property_id,
				"asset_id": property_id,
				"action_id": "throw_party",
				"property_contract": property_contract,
				"source": (
					"belongings_property_card"
				)
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "property_engine",
				"method": (
					"commit_property_contract_action"
				),
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": (
				"mainscene.belongings_property_card"
			)
		},
		{
			"actor_id": actor_id,
			"surface_id": (
				"belongings_item_popup"
			),
			"action_id": "throw_party",
			"source": (
				"mainscene.belongings_property_card"
			),
			"ui_is_expression_only": true
		}
	)

	var result: Dictionary = _hub_panel_route_result(
		report
	)

	if not result.is_empty():
		_maybe_show_action_result_popup(
			result
		)

	belongings_hud_content_dirty = bool(
		result.get(
			"committed",
			false
		)
	)

	set_meta(
		"belongings_property_party_engine_work_on_click",
		false
	)
func _belonging_popup_action_routes_to_estate_panel(
	action_spec: Dictionary,
	fallback_item: Dictionary = {}
) -> bool:
	var payload: Dictionary = MainSceneHelpers._safe_dictionary(
		action_spec.get(
			"payload",
			{}
		)
	)
	var action_id: String = str(
		payload.get(
			"action",
			action_spec.get(
				"action_id",
				action_spec.get(
					"id",
					""
				)
			)
		)
	).strip_edges().to_lower()
	var asset_kind: String = str(
		fallback_item.get(
			"asset_kind",
			""
		)
	).strip_edges().to_lower()

	return (
		action_id == "open_estate_panel"
		and asset_kind == "property"
	)

func _update_belongings_hud() -> void:
	_ensure_belongings_hud()

	if (
		belongings_hud_button == null
		or belongings_hud_panel == null
	):
		return

	var switch_surface_lock_active: bool = (
		_zero_frame_switch_surface_lock_active()
	)
	var runtime_snapshot: Dictionary = {}
	var snapshot_matches_actor: bool = false
	var has_belongings_surface: bool = false

	if (
		gs != null
		and gs.player != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		runtime_snapshot = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		)
		var snapshot_actor_id: int = int(
			runtime_snapshot.get(
				"controlled_actor_id",
				runtime_snapshot.get(
					"player_id",
					runtime_snapshot.get(
						"actor_id",
						-1
					)
				)
			)
		)
		snapshot_matches_actor = (
			snapshot_actor_id <= 0
			or snapshot_actor_id == int(
				gs.player.id
			)
		)

		if snapshot_matches_actor:
			has_belongings_surface = bool(
				runtime_snapshot.get(
					"belongings_button_visible",
					runtime_snapshot.get(
						"belongings_available",
						(
							bool(
								gs.player.alive
							)
							and float(
								gs.player.health
							) > 0.0
						)
					)
				)
			)

	if (
		gs != null
		and gs.player != null
		and not snapshot_matches_actor
	):
		has_belongings_surface = (
			bool(
				gs.player.alive
			)
			and float(
				gs.player.health
			) > 0.0
		)




	if (
		gs != null
		and gs.player != null
		and gs.belongings_engine != null
		and not switch_surface_lock_active
	):
		_sync_controlled_actor_assets_into_belongings(
			gs.player,
			"update_belongings_hud"
		)

	if (
		gs != null
		and gs.player != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var dirty_actor_id: int = int(
			gs.scenario_state.get(
				"belongings_inventory_dirty_actor_id",
				-1
			)
		)

		if dirty_actor_id == int(
			gs.player.id
		):
			belongings_hud_content_dirty = true
			gs.scenario_state.erase(
				"belongings_inventory_dirty_actor_id"
			)
			gs.scenario_state.erase(
				"belongings_inventory_dirty_reason"
			)
			gs.scenario_state.erase(
				"belongings_inventory_dirty_at_ms"
			)

	var showing_belongings_modal: bool = (
		(
			belongings_item_popup != null
			and belongings_item_popup.visible
		)
		or (
			belongings_item_target_popup != null
			and belongings_item_target_popup.visible
		)
	)
	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
	)
	var food_contract_surface_active: bool = (
		ui_contract_surface_panel != null
		and is_instance_valid(
			ui_contract_surface_panel
		)
		and ui_contract_surface_panel.visible
		and str(
			ui_contract_active_surface_id
		).strip_edges() == "food_contract_hub"
	)
	var allow_embedded_life_view: bool = (
		current_panel == ""
		or current_panel == "life"
		or current_panel == "food"
		or food_contract_surface_active
	)
	var player_forced_open: bool = (
		(
			bool(
				get_meta(
					"__belongings_hud_player_toggled_open",
					false
				)
			)
			and belongings_hud_open
		)
		or bool(
			get_meta(
				"__belongings_hud_force_keep_open",
				false
			)
		)
		or (
			_is_runtime_floating_hud_forced_open(
				"belongings"
			)
			and belongings_hud_open
		)
	)
	var hard_runtime_blocker: bool = (
		gs == null
		or gs.player == null
		or gs.awaiting_new_life
		or _god_mode_ui_locked()
		or blocked_by_age_up_loading
		or (
			not has_belongings_surface
			and not player_forced_open
		)
	)
	var has_external_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or (
			profile_panel_popup != null
			and profile_panel_popup.visible
		)
		or (
			crown_hub_overlay != null
			and crown_hub_overlay.visible
		)
		or (
			crown_action_popup != null
			and crown_action_popup.visible
		)
	)

	if hard_runtime_blocker:
		belongings_hud_button.visible = false
		belongings_hud_panel.visible = false

		if not showing_belongings_modal:
			belongings_hud_open = false

		remove_meta(
			"__belongings_hud_force_keep_open"
		)
		remove_meta(
			"__belongings_item_popup_sticky_until_closed"
		)
		_set_runtime_floating_hud_forced_open(
			"belongings",
			false
		)
		_hide_belonging_item_popup()
		_hide_artifact_target_popup()
		_sync_runtime_floating_hud_layering()
		return

	var can_show_button: bool = (
		not showing_belongings_modal
		and has_belongings_surface
		and (
			allow_embedded_life_view
			or player_forced_open
		)
	)
	var can_show_panel: bool = (
		belongings_hud_open
		and not showing_belongings_modal
		and (
			allow_embedded_life_view
			or player_forced_open
		)
		and (
			not has_external_modal_blocker
			or player_forced_open
		)
	)
	var button_should_show: bool = (
		can_show_button
		or player_forced_open
	)

	belongings_hud_button.visible = button_should_show
	belongings_hud_button.disabled = not button_should_show
	belongings_hud_button.mouse_filter = (
		Control.MOUSE_FILTER_STOP
		if button_should_show
		else Control.MOUSE_FILTER_IGNORE
	)
	belongings_hud_button.focus_mode = Control.FOCUS_NONE
	belongings_hud_button.modulate.a = (
		1.0
		if button_should_show
		else 0.001
	)
	belongings_hud_button.set_meta(
		"runtime_hud_button_clickable",
		button_should_show
	)
	belongings_hud_button.set_meta(
		"runtime_hud_button_clickable_reason",
		"runtime_hud_visibility_snapshot"
	)
	belongings_hud_button.set_meta(
		"runtime_hud_button_clickable_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	belongings_hud_panel.visible = can_show_panel
	_sync_runtime_floating_hud_layering()

	var total_items: int = 0
	var categories: Array = []

	if (
		gs != null
		and gs.player != null
		and gs.belongings_engine != null
	):
		total_items = gs.belongings_engine.get_total_item_count(
			gs.player
		)
		categories = gs.belongings_engine.get_inventory_categories(
			gs.player
		)

	if belongings_hud_subtitle_label != null:
		belongings_hud_subtitle_label.text = (
			"%d item%s across %d categor%s"
			% [
				total_items,
				"" if total_items == 1 else "s",
				categories.size(),
				"y" if categories.size() == 1 else "ies"
			]
		)

	if (
		belongings_hud_open
		and belongings_hud_content_dirty
		and gs != null
		and gs.belongings_engine != null
	):
		_refresh_belongings_hud_contents()
		belongings_hud_content_dirty = false
func _animate_belongings_hud(delta: float) -> void:
	if belongings_hud_button == null:
		return

	belongings_hud_breathe_time += delta

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var ui_grace_active: bool = (
		_ui_interaction_grace_active(
			now_ms
		)
	)
	var pause_until_ms: int = int(
		get_meta(
			"__belongings_hud_animation_pause_until_ms",
			0
		)
	)
	var animation_paused: bool = (
		pause_until_ms > now_ms
	)



	if (
		gs != null
		and gs.player != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
		and int(
			gs.scenario_state.get(
				"belongings_inventory_dirty_actor_id",
				-1
			)
		) == int(gs.player.id)
	):
		belongings_hud_content_dirty = true

	var belongings_surface_observed: bool = (
		belongings_hud_open
		or (
			belongings_item_popup != null
			and belongings_item_popup.visible
		)
		or (
			belongings_item_target_popup != null
			and belongings_item_target_popup.visible
		)
	)
	var next_update_ms: int = int(
		get_meta(
			"__belongings_hud_next_update_ms",
			0
		)
	)
	var should_refresh_observed_surface: bool = (
		belongings_surface_observed
		and (
			belongings_hud_content_dirty
			or now_ms >= next_update_ms
		)
	)

	if should_refresh_observed_surface:
		if ui_grace_active:
			set_meta(
				"__belongings_hud_next_update_ms",
				now_ms + 96
			)
			set_meta(
				"belongings_hud_refresh_yielded_to_input",
				true
			)
		else:
			set_meta(
				"belongings_hud_refresh_yielded_to_input",
				false
			)
			_update_belongings_hud()
			set_meta(
				"__belongings_hud_next_update_ms",
				now_ms + 240
			)



	if not ui_grace_active:
		_animate_superpower_hud(delta)
		_animate_power_hud(delta)
		_animate_crown_hud(delta)

	if (
		animation_paused
		or ui_grace_active
	):
		return

	var next_glow_ms: int = int(
		get_meta(
			"__belongings_hud_next_glow_ms",
			0
		)
	)
	if now_ms < next_glow_ms:
		return

	set_meta(
		"__belongings_hud_next_glow_ms",
		now_ms + 96
	)

	if belongings_hud_open and belongings_hud_list != null:
		var pulse_strength: float = (
			sin(
				belongings_hud_breathe_time * 2.35
			) + 1.0
		) * 0.5

		for section_node in belongings_hud_list.get_children():
			var section:= section_node as VBoxContainer
			if section == null:
				continue

			for child_node in section.get_children():
				var card:= child_node as PanelContainer
				if (
					card == null
					or not card.has_meta(
						"__artifact_item"
					)
				):
					continue

				var item: Dictionary = card.get_meta(
					"__artifact_item",
					{}
				)
				var open_button:= card.get_meta(
					"__artifact_button",
					null
				) as Button
				var meta_label:= card.get_meta(
					"__artifact_meta_label",
					null
				) as Label

				if item == {} or open_button == null:
					continue

				_apply_belongings_item_card_visual_state(
					card,
					open_button,
					meta_label,
					item,
					pulse_strength
				)

	if (
		belongings_item_popup != null
		and belongings_item_popup.visible
		and not belongings_item_popup_current_item.is_empty()
	):
		var popup_pulse: float = (
			sin(
				belongings_hud_breathe_time * 2.9
			) + 1.0
		) * 0.5

		_apply_belonging_item_popup_visual_state(
			belongings_item_popup_current_item,
			popup_pulse
		)
func _resolve_crown_population_realm_id(
		payload: Dictionary = {}
) -> int:
		var source: String = str(
			payload.get(
				"source",
				""
			)
		).strip_edges()
		var explicit_external_population_view: bool = (
			source in [
				"other_countries_population_wall",
				"other_country_population_wall",
				"realm_overview_population_wall",
				"crown_diplomacy_population_wall"
			]
		)
		var direct_realm_id: int = int(
			payload.get(
				"target_realm_id",
				-1
			)
		)
		var entry_raw: Variant = payload.get(
			"entry",
			{}
		)
		var entry: Dictionary = (
			entry_raw as Dictionary
			if typeof(entry_raw) == TYPE_DICTIONARY
			else {}
		)
		var entry_realm_raw: Variant = entry.get(
			"realm",
			{}
		)
		var entry_realm: Dictionary = (
			entry_realm_raw as Dictionary
			if typeof(entry_realm_raw) == TYPE_DICTIONARY
			else {}
		)
		var entry_realm_id: int = int(
			entry.get(
				"realm_id",
				entry_realm.get(
					"realm_id",
					entry_realm.get(
						"id",
						-1
					)
				)
			)
		)
		var payload_realm_raw: Variant = payload.get(
			"realm",
			{}
		)
		var payload_realm: Dictionary = (
			payload_realm_raw as Dictionary
			if typeof(payload_realm_raw) == TYPE_DICTIONARY
			else {}
		)
		var payload_realm_id: int = int(
			payload_realm.get(
				"realm_id",
				payload_realm.get(
					"id",
					-1
				)
			)
		)



		if explicit_external_population_view:
			if direct_realm_id > 0:
				return direct_realm_id

			if entry_realm_id > 0:
				return entry_realm_id

			if payload_realm_id > 0:
				return payload_realm_id

			return -1

		if (
			gs == null
			or gs.realm_engine == null
			or typeof(
				gs.realm_engine.realms
			) != TYPE_DICTIONARY
		):
			return -1

		if (
			direct_realm_id > 0
			and gs.realm_engine.realms.has(
				direct_realm_id
			)
		):
			return direct_realm_id

		if (
			entry_realm_id > 0
			and gs.realm_engine.realms.has(
				entry_realm_id
			)
		):
			return entry_realm_id

		if (
			payload_realm_id > 0
			and gs.realm_engine.realms.has(
				payload_realm_id
			)
		):
			return payload_realm_id

		var hidden_realm_id: String = str(
			payload.get(
				"hidden_realm_id",
				""
			)
		).strip_edges()

		if (
			hidden_realm_id != ""
			and gs.many_realms_engine != null
		):
			var hidden_raw: Variant = (
				gs.many_realms_engine.hidden_realms.get(
					hidden_realm_id,
					{}
				)
			)
			var hidden_realm: Dictionary = (
				hidden_raw as Dictionary
				if typeof(hidden_raw) == TYPE_DICTIONARY
				else {}
			)
			var hidden_surface_realm_id: int = int(
				hidden_realm.get(
					"realm_id",
					hidden_realm.get(
						"surface_realm_id",
						hidden_realm.get(
							"id",
							-1
						)
					)
				)
			)

			if (
				hidden_surface_realm_id > 0
				and gs.realm_engine.realms.has(
					hidden_surface_realm_id
				)
			):
				return hidden_surface_realm_id

		if gs.player == null:
			return -1

		var player_realm_id: int = int(
			gs.player.realm_id
		)

		if (
			player_realm_id > 0
			and gs.realm_engine.realms.has(
				player_realm_id
			)
		):
			return player_realm_id

		var player_realm: Dictionary = (
			MainSceneLogic._resolve_player_realm_dict(gs)
		)
		player_realm_id = int(
			player_realm.get(
				"id",
				int(gs.player.realm_id)
			)
		)

		if (
			player_realm_id > 0
			and gs.realm_engine.realms.has(
				player_realm_id
			)
		):
			return player_realm_id

		return -1
func _player_has_crown_presence() -> bool:
	if (
		gs == null
		or gs.player == null
	):
		return false

	var actor: Person = gs.player
	var actor_id: int = int(
		actor.id
	)

	if typeof(
		gs.scenario_state
	) == TYPE_DICTIONARY:
		var snapshot_raw: Variant = gs.scenario_state.get(
			"runtime_hud_visibility_snapshot",
			{}
		)

		if typeof(
			snapshot_raw
		) == TYPE_DICTIONARY:
			var snapshot: Dictionary = (
				snapshot_raw as Dictionary
			)
			var snapshot_actor_id: int = int(
				snapshot.get(
					"controlled_actor_id",
					snapshot.get(
						"player_id",
						-1
					)
				)
			)
			var snapshot_has_crown_truth: bool = (
				snapshot.has(
					"crown_available"
				)
				or snapshot.has(
					"crown_button_visible"
				)
			)



			if (
				snapshot_actor_id == actor_id
				and snapshot_has_crown_truth
			):
				return bool(
					snapshot.get(
						"crown_available",
						snapshot.get(
							"crown_button_visible",
							false
						)
					)
				)



	var civic_office_raw: Variant = actor.get(
		"civic_office_contract"
	)

	if typeof(
		civic_office_raw
	) == TYPE_DICTIONARY:
		var civic_office: Dictionary = (
			civic_office_raw as Dictionary
		)

		if (
			bool(
				civic_office.get(
					"ruling_power_by_office",
					false
				)
			)
			or bool(
				civic_office.get(
					"crown_hub_access",
					false
				)
			)
			or bool(
				civic_office.get(
					"government_command_surface_access",
					false
				)
			)
		):
			return true

	if (
		bool(
			actor.is_ruler
		)
		or bool(
			actor.is_royal
		)
		or bool(
			actor.exiled
		)
		or bool(
			actor.deposed
		)
	):
		return true

	var succession_rank: int = int(
		actor.succession_rank
	)

	if (
		succession_rank > 0
		and succession_rank <= 12
	):
		return true

	if str(
		actor.royal_title
	).strip_edges() != "":
		return true

	var social_class: String = str(
		actor.social_class
	).strip_edges().to_lower()

	return social_class in [
		"royal",
		"noble"
	]
func _build_player_crown_permissions() -> Dictionary:
	var out: Dictionary = {
		"open": false,
		"throne": false,
		"court": false,
		"nation": false,
		"allocation": false,
		"diplomacy": false,
		"law": false,
		"dynasty": false,
		"symbolic_only": false,
		"authority_tier": "none",
		"is_claimant": false,
		"is_high_in_line": false,
		"can_abdicate": false,
		"can_support_heir": false,
		"can_found_breakaway_realm": false,
		"can_execute": false,
		"can_celebrity": false,
		"can_honorific": false,
		"can_law_review": false,
		"can_public_service": false,
		"can_public_disservice": false,
		"can_create_realm": false,
		"can_set_government_style": false,
		"can_expand_land": false,
		"can_trade": false,
		"can_gift": false,
		"can_bribe": false,
		"can_declare_war": false,
		"can_realm_overview": false,
		"can_appoint_heir": false,
		"can_manage_population": false,
		"can_manage_allocation": false,
		"can_manage_wonders": false,
		"can_issue_decrees": false,
		"can_manage_justice_posture": false,
		"can_use_emergency_powers": false,
		"government_style": MainSceneLogic._resolve_player_government_style(gs)
	}
	if gs == null or gs.player == null:
		return out
	if not _player_has_crown_presence():
		return out
	var p:= gs.player

	var pressure: Dictionary = MainSceneLogic._resolve_player_crown_pressure(gs)
	var government_style: String = str(out.get("government_style", "Monarchy")).strip_edges().to_lower()
	var realm: Dictionary = MainSceneLogic._resolve_player_realm_dict(gs)
	var realm_ruler_id: int = int(realm.get("ruler_id", -1))
	var is_government_office_holder: bool = MainSceneLogic._person_has_government_command_surface_access(gs, p)
	var is_federal_republic: bool = MainSceneLogic._player_is_federal_republic_office_holder(gs)
	var is_ruler: bool = bool(p.is_ruler) or is_government_office_holder or (realm_ruler_id > 0 and realm_ruler_id == int(p.id))
	var succession_rank: int = 0 if is_ruler else int(p.succession_rank)
	var is_high_noble: bool = _is_crown_population_noble_court_member(p, int(p.realm_id))
	var is_royal: bool = (not is_federal_republic) and (bool(p.is_royal) or str(p.social_class).strip_edges() == "Royal" or (str(p.royal_title).strip_edges() != "" and not is_high_noble))
	var is_high_in_line: bool = succession_rank > 0 and succession_rank <= 5
	var is_claimant: bool = bool(p.exiled) or bool(p.deposed) or (succession_rank > 0 and succession_rank <= 12)
	var symbolic_only: bool = is_royal and not is_ruler and not is_claimant and not is_high_in_line
	var claim_pressure: float = float(pressure.get("claim_pressure_total", 0.0))
	var coup_pressure: float = float(pressure.get("coup_pressure", 0.0))
	var succession_tension: float = float(pressure.get("royal_succession_tension", 0.0))
	out ["open"] = true
	out ["throne"] = true
	out ["court"] = is_royal or is_ruler or is_claimant or is_high_noble
	out ["nation"] = is_ruler or is_claimant
	out ["allocation"] = is_ruler
	out ["diplomacy"] = is_ruler or is_high_in_line or is_claimant
	out ["law"] = is_ruler or is_high_in_line or (is_claimant and claim_pressure >= 8.0)
	out ["dynasty"] = is_royal or is_ruler or is_claimant or is_high_noble
	out ["symbolic_only"] = symbolic_only
	out ["is_claimant"] = is_claimant
	out ["is_high_in_line"] = is_high_in_line
	if is_ruler:
		out ["authority_tier"] = "state"
	elif is_claimant:
		out ["authority_tier"] = "claimant"
	elif is_high_in_line:
		out ["authority_tier"] = "succession"
	elif is_royal:
		out ["authority_tier"] = "ceremonial"
	elif is_high_noble:
		out ["authority_tier"] = "noble"
	out ["can_abdicate"] = is_ruler
	out ["can_support_heir"] = is_ruler
	out ["can_found_breakaway_realm"] = is_ruler or is_claimant
	out ["can_execute"] = is_ruler and government_style not in ["democracy", "republic", "federal republic", "federal_presidential_republic"]
	out ["can_celebrity"] = is_royal or is_ruler
	out ["can_honorific"] = is_royal or is_ruler or is_high_in_line
	out ["can_law_review"] = is_ruler or is_high_in_line or (is_claimant and succession_tension >= 8.0)
	out ["can_public_service"] = is_royal or is_ruler or is_high_in_line
	out ["can_public_disservice"] = is_ruler or is_claimant
	out ["can_create_realm"] = is_ruler or is_claimant
	out ["can_set_government_style"] = is_ruler
	out ["can_expand_land"] = is_ruler
	out ["can_trade"] = is_ruler
	out ["can_gift"] = is_ruler or is_high_in_line or is_claimant
	out ["can_bribe"] = is_ruler or is_claimant
	out ["can_declare_war"] = is_ruler
	out ["can_realm_overview"] = is_ruler or is_royal or is_claimant or is_high_noble or is_government_office_holder
	out ["can_appoint_heir"] = is_ruler
	out ["can_manage_population"] = is_ruler or is_royal or is_high_in_line or is_claimant or is_government_office_holder
	out ["can_manage_allocation"] = is_ruler
	out ["can_manage_wonders"] = is_ruler
	out ["can_issue_decrees"] = is_ruler and government_style not in ["democracy", "republic", "federal republic", "federal_presidential_republic"]
	out ["can_manage_justice_posture"] = is_ruler
	out ["can_use_emergency_powers"] = is_ruler or (is_claimant and coup_pressure >= 14.0)
	out ["claim_pressure"] = claim_pressure
	out ["coup_pressure"] = coup_pressure
	out ["royal_succession_tension"] = succession_tension
	return out

func _build_player_crown_summary() -> Dictionary:
	if gs == null or gs.player == null:
		return {}
	var p:= gs.player
	var realm: Dictionary = MainSceneLogic._resolve_player_realm_dict(gs)
	realm = MainSceneLogic._apply_crown_pending_tax_effects(gs, realm)
	var pressure: Dictionary = MainSceneLogic._resolve_player_crown_pressure(gs)
	var realm_name: String = str(realm.get("name", "Unbound Realm")).strip_edges()
	var house_name: String = "%s House" % str(p.last_name).strip_edges() if str(p.last_name).strip_edges() != "" else "Royal House"
	var government_style: String = MainSceneLogic._resolve_player_government_style(gs)
	var seeded_population: int = int(realm.get("population", 0))
	var live_population: int = 0
	if gs.realm_engine != null and gs.realm_engine.has_method("get_total_population_for_realm") and int(p.realm_id) > 0:
		live_population = int(gs.realm_engine.get_total_population_for_realm(int(p.realm_id)))
	var population: int = max(seeded_population, live_population)
	var land: int = int(realm.get("land", realm.get("land_size", 0)))
	var treasury: int = int(realm.get("treasury", 0))
	if treasury <= 0 and realm.is_empty():
		treasury = int(p.bank_balance)
	var currency_name: String = str(realm.get("currency_name", MainSceneLogic._crown_default_currency_name_for_realm(gs, realm_name))).strip_edges()
	var treasury_label: String = _format_crown_treasury_label(treasury, currency_name)
	var respect_bias: int = int(realm.get("respect_bias", 0))
	var tax_rate: float = clamp(float(realm.get("tax_rate", 10.0)), 0.0, 40.0)
	var happiness: int = clamp(int(realm.get("happiness", 50)), 0, 100)
	var allocation_reserve: int = int(realm.get("allocation_reserve", 0))
	var total_tax_revenue: int = MainSceneHelpers._calculate_crown_tax_revenue(population, tax_rate, realm)
	var allocation_pool: int = allocation_reserve + total_tax_revenue
	var military_unit_cost: int = 4500
	var goods_unit_cost: int = 200000
	var legitimacy: int = clamp(int(round((float(p.approval) * 0.65) + (float(p.fame) * 0.2) + (15.0 if bool(p.is_ruler) else 0.0) - (float(p.scandal) * 0.18))), 0, 100)
	var respect: int = clamp(int(round((float(p.fame) * 0.55) + (float(max(0, 100 - int(p.scandal))) * 0.2) + (12.0 if bool(p.is_ruler) else 0.0) + float(respect_bias))), 0, 100)
	var standing: String = "Stable"
	if bool(p.exiled):
		standing = "Exiled"
	elif bool(p.deposed):
		standing = "Deposed"
	elif float(pressure.get("coup_pressure", 0.0)) >= 18.0:
		standing = "Coup-prone"
	elif float(pressure.get("royal_succession_tension", 0.0)) >= 12.0:
		standing = "Succession-fragile"
	elif legitimacy >= 72:
		standing = "Dominant"
	elif legitimacy <= 35:
		standing = "Unstable"
	var alerts: Array = []
	if bool(p.exiled):
		alerts.append("You are operating from exile.")
	if bool(p.deposed):
		alerts.append("Your authority is contested after deposition.")
	if float(pressure.get("royal_succession_tension", 0.0)) >= 10.0:
		alerts.append("Succession pressure is heating up.")
	if float(pressure.get("coup_pressure", 0.0)) >= 12.0:
		alerts.append("Court and bloc pressure suggest coup risk.")
	if int(p.approval) <= 35:
		alerts.append("Public legitimacy is low.")
	if land <= 0:
		alerts.append("Territorial control is collapsing.")
	if treasury <= 0:
		alerts.append("Treasury-facing reserves are exhausted.")
	if alerts.is_empty():
		alerts.append("No urgent crown alerts right now.")
	var land_metrics: Dictionary = _resolve_crown_land_metrics(realm)
	var land_km2: int = int(round(float(land_metrics.get("km2", 0.0))))
	var land_mi2: int = int(round(float(land_metrics.get("mi2", 0.0))))
	var land_label: String = str(land_metrics.get("label", "0 km²"))
	var land_mass_label: String = str(land_metrics.get("mass_label", "Local"))
	var military_stockpile: int = int(realm.get("military_stockpile", 0))
	var goods_stockpile: int = int(realm.get("goods_stockpile", 0))
	var federal_republic: bool = MainSceneLogic._player_is_federal_republic_office_holder(gs)
	var summary_title: String = str(p.royal_title).strip_edges() if str(p.royal_title).strip_edges() != "" else ("Ruler" if bool(p.is_ruler) else "Claimant")
	var summary_house_name: String = house_name

	if federal_republic:
		var civic_title: String = str(p.get("civic_title")).strip_edges()
		if civic_title == "":
			civic_title = "President" if bool(p.is_ruler) else "Federal Officer"

		summary_title = civic_title
		summary_house_name = "First Family"
		government_style = "Federal Republic"
	return {
		"title": summary_title,
		"house_name": summary_house_name,
		"federal_republic": federal_republic,
		"civic_office_contract": p.get("civic_office_contract") if typeof(p.get("civic_office_contract")) == TYPE_DICTIONARY else {},
		"realm_name": realm_name,
		"government_style": government_style,
		"approval": int(p.approval),
		"legitimacy": legitimacy,
		"respect": respect,
		"succession_rank": int(p.succession_rank),
		"claimant_pressure": float(pressure.get("claim_pressure_total", 0.0)),
		"coup_pressure": float(pressure.get("coup_pressure", 0.0)),
		"royal_succession_tension": float(pressure.get("royal_succession_tension", 0.0)),

		"population": population,
		"population_label": "%s people" % _crown_compact_number(float(population)),

		"land": land_km2,
		"land_km2": land_km2,
		"land_mi2": land_mi2,
		"land_label": land_label,
		"land_mass_label": land_mass_label,
		"land_display_unit": str(land_metrics.get("display_unit", "km²")),

		"treasury": treasury,
		"currency_name": currency_name,
		"treasury_label": treasury_label,

		"military_stockpile": military_stockpile,
		"military_stockpile_label": "%s units" % _crown_compact_number(float(military_stockpile)),
		"goods_stockpile": goods_stockpile,
		"goods_stockpile_label": "%s units" % _crown_compact_number(float(goods_stockpile)),

		"tax_rate": tax_rate,
		"happiness": happiness,
		"total_tax_revenue": total_tax_revenue,
		"allocation_reserve": allocation_reserve,
		"allocation_pool": allocation_pool,
		"military_unit_cost": military_unit_cost,
		"goods_unit_cost": goods_unit_cost,
		"standing": standing,
		"alerts": alerts
	}

func _crown_hud_core_color() -> Color:
	var stable_crown_color: Color = Color(
		1.0,
		0.76,
		0.2,
		1.0
	)

	if (
		crown_hud_button != null
		and is_instance_valid(
			crown_hud_button
		)
	):
		var raw_core_color: Variant = (
			crown_hud_button.get_meta(
				"runtime_floating_hud_visual_core_color",
				stable_crown_color
			)
		)

		if typeof(raw_core_color) == TYPE_COLOR:
			return raw_core_color as Color

	return stable_crown_color
func _player_can_become_superhero_from_activities() -> bool:
	if gs == null or gs.player == null:
		return false

	if int(gs.player.age) < 13:
		return false

	if _player_has_superpower_hub_access():
		return false

	if not _superhero_activity_runtime_enabled():
		return false

	if MainSceneLogic._player_has_bending_power_source(gs):
		return true

	if gs.power_engine != null and gs.power_engine.has_method("has_superpowers"):
		if gs.power_engine.has_superpowers(gs.player):
			return true

	return false


func _superhero_activity_runtime_enabled() -> bool:
	if gs == null:
		return false

	var mode_text: String = ""
	if gs.has_method("get_reality_mode"):
		mode_text = str(gs.get_reality_mode()).strip_edges().to_lower()

	if mode_text in ["chaos", "fantasy"]:
		return true

	if typeof(gs.custom_settings) == TYPE_DICTIONARY:
		var settings_mode: String = str(gs.custom_settings.get("reality_mode", "")).strip_edges().to_lower()
		if settings_mode in ["chaos", "fantasy"]:
			return true

		var feature_overrides: Dictionary = _superpower_hub_safe_dictionary(gs.custom_settings.get("feature_overrides", {}))
		if bool(feature_overrides.get("superpowers", false)):
			return true

	if gs.has_method("is_feature_enabled") and gs.is_feature_enabled("superpowers"):
		return true

	return false


func _super_runtime_dictionary_has_power_markers(profile: Dictionary) -> bool:
	if profile.is_empty():
		return false

	for dictionary_key in [
		"powers",
		"active_powers",
		"manifested_powers",
		"mutated_abilities",
		"mutation_contract_packets",
		"lineage_power_seed",
		"family_legacy",
		"power_contract",
		"superpower_contract",
		"birth_power_contract"
	]:
		if not _superpower_hub_safe_dictionary(profile.get(dictionary_key, {})).is_empty():
			return true

	for array_key in [
		"forms",
		"alien_forms",
		"saved_identity_forms",
		"abilities",
		"hero_abilities",
		"spells",
		"subskills",
		"unlocked_subskills",
		"active_power_ids",
		"power_ids",
		"known_powers"
	]:
		if not _superpower_hub_safe_array(profile.get(array_key, [])).is_empty():
			return true

	for flag_key in [
		"unlocked",
		"active",
		"has_power",
		"has_superpower",
		"has_superpowers",
		"birth_awakened",
		"configured_at_birth",
		"birth_power_configured",
		"public_power_known",
		"visible_in_hub",
		"hub_readable_while_latent",
		"red_bonnet_maxed"
	]:
		if bool(profile.get(flag_key, false)):
			return true

	for text_key in [
		"origin",
		"power_id",
		"primary_power",
		"configured_birth_power_id",
		"current_form",
		"device_id",
		"bloodline",
		"hero_identity",
		"villain_identity",
		"public_visibility"
	]:
		var text_value: String = str(profile.get(text_key, "")).strip_edges()
		var lower_value: String = text_value.to_lower()
		if text_value != "" and lower_value not in ["none", "unknown", "null", "unregistered", "civilian"]:
			return true

	for number_key in [
		"ki",
		"battle_power",
		"power_level",
		"base_power_level",
		"latent_potential",
		"power_skill_points"
	]:
		if float(profile.get(number_key, 0.0)) > 0.0:
			return true

	return false

func _super_runtime_power_profiles_have_visible_power(profiles: Dictionary) -> bool:
	if profiles.is_empty():
		return false

	for raw_key in profiles.keys():
		var clean_key: String = str(raw_key).strip_edges().to_lower()
		if clean_key in ["", "bending", "boxing"]:
			continue

		var profile: Dictionary = _superpower_hub_safe_dictionary(profiles.get(raw_key, {}))
		if profile.is_empty():
			continue

		if _super_runtime_dictionary_has_power_markers(profile):
			return true

	return false


func _super_runtime_actor_has_power_hub_access(actor: Person) -> bool:
	if actor == null:
		return false

	if gs != null and gs.player != null and int(actor.id) == int(gs.player.id):
		if _runtime_controlled_perspective_truth_bool_for_current_actor([
			"power",
			"power_available",
			"superpower",
			"superpower_available",
			"superhero",
			"superhero_available"
		]):
			return true

	if gs != null and gs.power_engine != null:
		if gs.power_engine.has_method("ensure_person_power_state"):
			var ensured_state: Dictionary = _superpower_hub_safe_dictionary(gs.power_engine.ensure_person_power_state(actor))
			if _super_runtime_dictionary_has_power_markers(ensured_state):
				return true

		if gs.power_engine.has_method("has_superpowers"):
			if bool(gs.power_engine.has_superpowers(actor)):
				return true

		if gs.power_engine.has_method("get_person_power_state"):
			var power_state: Dictionary = _superpower_hub_safe_dictionary(gs.power_engine.get_person_power_state(actor))
			if _super_runtime_dictionary_has_power_markers(power_state):
				return true

	var direct_power_profile: Dictionary = _super_runtime_actor_optional_dictionary(actor, "power_profile")
	if _super_runtime_dictionary_has_power_markers(direct_power_profile):
		return true

	var power_profiles: Dictionary = _super_runtime_actor_optional_dictionary(actor, "power_profiles")
	if _super_runtime_power_profiles_have_visible_power(power_profiles):
		return true

	var person_contract: Dictionary = _super_runtime_actor_optional_dictionary(actor, "person_contract")
	var contract_power_profiles: Dictionary = _superpower_hub_safe_dictionary(person_contract.get("power_profiles", {}))
	if _super_runtime_power_profiles_have_visible_power(contract_power_profiles):
		return true

	if "traits" in actor and typeof(actor.traits) == TYPE_ARRAY:
		for raw_trait in actor.traits:
			var clean_trait: String = str(raw_trait).strip_edges().to_lower()
			if clean_trait in ["superpowered", "superhuman", "mutant", "metahuman", "hero", "villain"]:
				return true
			if clean_trait.find("superpower") >= 0 or clean_trait.find("mutation") >= 0:
				return true

	return false


func _super_runtime_actor_has_superhero_hub_access(actor: Person) -> bool:
	if actor == null:
		return false

	if _super_runtime_actor_has_power_hub_access(actor):
		return true

	if gs != null and gs.superhero_engine != null and gs.superhero_engine.has_method("has_superhero_hub_access"):
		if bool(gs.superhero_engine.has_superhero_hub_access(actor)):
			return true

	var direct_superhero_profile: Dictionary = _super_runtime_actor_optional_dictionary(actor, "superhero_profile")
	if MainSceneHelpers._super_runtime_superhero_profile_has_access(direct_superhero_profile):
		return true

	var person_contract: Dictionary = _super_runtime_actor_optional_dictionary(actor, "person_contract")
	var contract_superhero_profile: Dictionary = _superpower_hub_safe_dictionary(person_contract.get("superhero_profile", {}))
	if MainSceneHelpers._super_runtime_superhero_profile_has_access(contract_superhero_profile):
		return true

	return false
func _player_has_superpower_hub_access() -> bool:
	if gs == null or gs.player == null:
		return false

	if _runtime_controlled_perspective_truth_bool_for_current_actor([
		"superhero",
		"superhero_available",
		"superpower",
		"superpower_available",
		"power",
		"power_available"
	]):
		return true

	return _super_runtime_actor_has_superhero_hub_access(gs.player)
func _ensure_superpower_hud() -> void:
	if superpower_hud_button != null and is_instance_valid(superpower_hud_button):
		return

	var ui_root:= self as Control
	if ui_root == null:
		return

	superpower_hud_button = Button.new()
	superpower_hud_button.visible = false
	superpower_hud_button.z_index = 301
	superpower_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP
	_apply_runtime_hud_button_stack_layout(superpower_hud_button, 2)
	superpower_hud_button.text = "🦸‍♀️"
	superpower_hud_button.tooltip_text = "Open Super Hero Hub"
	superpower_hud_button.focus_mode = Control.FOCUS_NONE
	superpower_hud_button.add_theme_font_size_override("font_size", 28)
	superpower_hud_button.pressed.connect(_on_superpower_hud_pressed)
	ui_root.add_child(superpower_hud_button)

func _on_superpower_hud_pressed() -> void:
	_set_runtime_floating_hud_forced_open("superpower", true)
	_show_superpower_hub_overlay()

func _update_superpower_hud() -> void:
	_ensure_superpower_hud()
	if superpower_hud_button == null:
		return

	var has_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or superpower_hub_open
		or (profile_panel_popup != null and profile_panel_popup.visible)
		or (belongings_item_popup != null and belongings_item_popup.visible)
		or (belongings_item_target_popup != null and belongings_item_target_popup.visible)
		or crown_hub_open
		or (crown_action_popup != null and crown_action_popup.visible)
	)

	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(get_meta("age_up_transition_busy", false))
	)

	var allow_embedded_life_view: bool = (current_panel == "" or current_panel == "life")
	var can_show: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not has_modal_blocker
		and not blocked_by_age_up_loading
		and allow_embedded_life_view
		and _player_has_superpower_hub_access()
	)

	superpower_hud_button.visible = can_show
	if not can_show:
		_sync_runtime_floating_hud_layering()
		return

	_apply_runtime_hud_button_stack_layout(superpower_hud_button, 2)
	_sync_runtime_floating_hud_layering()

	var pulse:= (sin(superpower_hud_breathe_time * 2.4) + 1.0) * 0.5
	var core:= Color(0.82, 0.42, 1.0, 1.0)

	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(superpower_hud_button, "superpower_hud_button_style", 2, 18)
	if btn_style == null:
		return

	superpower_hud_button.add_theme_stylebox_override("normal", btn_style)
	superpower_hud_button.add_theme_stylebox_override("hover", btn_style)
	superpower_hud_button.add_theme_stylebox_override("pressed", btn_style)

	btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.12))
	btn_style.border_color = Color(core.r, core.g, core.b, 0.82 + (pulse * 0.12))
	superpower_hud_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	superpower_hud_button.text = "🦸‍♀️"
	superpower_hud_button.tooltip_text = "Open Super Hero Hub\nSecret identity does not block access."

func _animate_superpower_hud(delta: float) -> void:
	superpower_hud_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("superpower_hud_next_light_refresh_ms", 0))
	if now_ms >= next_refresh_ms:
		set_meta("superpower_hud_next_light_refresh_ms", now_ms + 220)
		_update_superpower_hud()
	elif superpower_hud_button != null and superpower_hud_button.visible:
		var pulse:= (sin(superpower_hud_breathe_time * 2.4) + 1.0) * 0.5
		var core:= Color(0.82, 0.42, 1.0, 1.0)
		var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(superpower_hud_button, "superpower_hud_button_style", 2, 18)
		if btn_style != null:
			btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.12))
			btn_style.border_color = Color(core.r, core.g, core.b, 0.82 + (pulse * 0.12))
