	var bar:= ProgressBar.new()
	bar.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bar.min_value = 0
	bar.max_value = 100
	bar.value = clampi(value, 0, 100)
	bar.show_percentage = false
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.add_child(bar)

	var back_style:= StyleBoxFlat.new()
	back_style.bg_color = Color(soft.r * 0.38, soft.g * 0.38, soft.b * 0.38, 0.92)
	back_style.border_width_left = 1
	back_style.border_width_top = 1
	back_style.border_width_right = 1
	back_style.border_width_bottom = 1
	back_style.border_color = Color(core.r, core.g, core.b, 0.28)
	back_style.corner_radius_top_left = 8
	back_style.corner_radius_top_right = 8
	back_style.corner_radius_bottom_left = 8
	back_style.corner_radius_bottom_right = 8
	back_style.shadow_color = Color(glow.r, glow.g, glow.b, glow.a)
	back_style.shadow_size = 3
	back_style.shadow_offset = Vector2.ZERO

	var fill_style:= StyleBoxFlat.new()
	fill_style.bg_color = Color(core.r, core.g, core.b, 0.82)
	fill_style.corner_radius_top_left = 8
	fill_style.corner_radius_top_right = 8
	fill_style.corner_radius_bottom_left = 8
	fill_style.corner_radius_bottom_right = 8

	bar.add_theme_stylebox_override("background", back_style)
	bar.add_theme_stylebox_override("fill", fill_style)

	var overlay:= Label.new()
	overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	overlay.text = "%s %d" % [label_text, clampi(value, 0, 100)]
	overlay.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	overlay.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_theme_font_size_override("font_size", 9)
	overlay.add_theme_color_override("font_color", label_color)
	overlay.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.44))
	overlay.add_theme_constant_override("shadow_outline_size", 1)
	holder.add_child(overlay)

func _crown_population_relation_rows(target: Person) -> Array:
	var out: Array = []
	if target == null:
		return out

	var _push_relation = func (label_text: String, person: Person) -> void:
		if person == null or not person.alive:
			return
		out.append({
			"label": label_text,
			"name": _relationship_display_name(person),
			"id": int(person.id)
		})

	for raw_parent_id in target.parents:
		var parent: Person = raw_parent_id if raw_parent_id is Person else MainSceneLogic._find_active_crown_person_by_id(gs, int(raw_parent_id))
		_push_relation.call("Parent", parent)

	if target.partner != null:
		_push_relation.call("Partner", target.partner)

	for raw_child_id in target.children:
		var child: Person = raw_child_id if raw_child_id is Person else MainSceneLogic._find_active_crown_person_by_id(gs, int(raw_child_id))
		_push_relation.call("Child", child)

	for raw_friend_id in target.friends:
		if out.size() >= 8:
			break
		var friend: Person = raw_friend_id if raw_friend_id is Person else MainSceneLogic._find_active_crown_person_by_id(gs, int(raw_friend_id))
		_push_relation.call("Friend", friend)

	return out


func _append_crown_population_relationship_cards(parent: Control, target: Person, accent: Color) -> void:
	var relations: Array = _crown_population_relation_rows(target)

	var title:= Label.new()
	title.text = "RELATION THREADS"
	title.add_theme_font_size_override("font_size", 10)
	title.add_theme_color_override("font_color", Color(accent.r, accent.g, accent.b, 0.92))
	parent.add_child(title)

	if relations.is_empty():
		var empty:= Label.new()
		empty.text = "No active family/friend cards are visible in this lens."
		empty.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty.add_theme_font_size_override("font_size", 10)
		empty.add_theme_color_override("font_color", Color(0.72, 0.76, 0.84, 0.72))
		parent.add_child(empty)
		return

	var grid:= GridContainer.new()
	grid.columns = 2
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	parent.add_child(grid)

	for raw_relation in relations:
		if typeof(raw_relation) != TYPE_DICTIONARY:
			continue

		var relation: Dictionary = raw_relation
		var chip:= PanelContainer.new()
		chip.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		grid.add_child(chip)

		var style:= StyleBoxFlat.new()
		style.bg_color = Color(accent.r * 0.09, accent.g * 0.08, accent.b * 0.1, 0.92)
		style.border_width_left = 1
		style.border_width_top = 1
		style.border_width_right = 1
		style.border_width_bottom = 1
		style.border_color = Color(accent.r, accent.g, accent.b, 0.4)
		style.corner_radius_top_left = 10
		style.corner_radius_top_right = 10
		style.corner_radius_bottom_left = 10
		style.corner_radius_bottom_right = 10
		chip.add_theme_stylebox_override("panel", style)

		var label:= Label.new()
		label.text = "%s\n%s" % [str(relation.get("label", "Relation")), str(relation.get("name", "Unknown"))]
		label.add_theme_font_size_override("font_size", 9)
		label.add_theme_color_override("font_color", Color(0.92, 0.95, 1.0, 0.88))
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		chip.add_child(label)


func _toggle_crown_population_capsule_details(details: Control, card: PanelContainer, target: Person, section_kind: String, accent: Color, glow_strength: float) -> void:
	if details == null or card == null:
		return

	if not card.has_meta("crown_population_collapsed_min_height"):
		card.set_meta("crown_population_collapsed_min_height", card.custom_minimum_size.y)

	details.visible = not details.visible

	var collapsed_height: float = float(card.get_meta("crown_population_collapsed_min_height", card.custom_minimum_size.y))
	var expanded_height: float = maxf(304.0, collapsed_height)
	var target_height: float = collapsed_height

	if details.visible:
		target_height = expanded_height

	card.custom_minimum_size = Vector2(card.custom_minimum_size.x, target_height)
	card.add_theme_stylebox_override("panel", _crown_population_card_style(target, section_kind, accent, glow_strength, details.visible))


func _append_crown_population_capsule(grid: GridContainer, target: Person, realm_id: int, section_kind: String, accent: Color, glow_strength: float, element: String = "") -> void:
	if grid == null or target == null or not target.alive:
		return

	var is_you: bool = gs != null and gs.player != null and int(target.id) == int(gs.player.id)
	var _is_throne_holder: bool = MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id)
