		player_stats_overlay.set_meta("player_stats_current_actor_id", current_actor_id)
		player_stats_overlay.set_meta("player_stats_bank_actor_id", current_actor_id)
		player_stats_overlay.set_meta("player_stats_actor_changed_truth_fill_required", true)

		for bar in [
			player_stats_health_bar,
			player_stats_hunger_bar,
			player_stats_mental_bar,
			player_stats_willpower_bar,
			player_stats_happiness_bar,
			player_stats_smarts_bar,
			player_stats_looks_bar,
			player_stats_imagination_bar,
			player_stats_fame_bar
		]:
			if bar != null and is_instance_valid(bar):
				bar.set_meta("player_stat_row_visual_signature", "")
				bar.set_meta("stat_bar_current_fill_ratio", -1.0)

	if gs.has_method("sync_person_death_state_from_health"):
		gs.sync_person_death_state_from_health(p)

	var safe_first_name: String = str(p.first_name).strip_edges()
	var safe_last_name: String = str(p.last_name).strip_edges()
	var safe_full_name: String = ("%s %s" % [safe_first_name, safe_last_name]).strip_edges()
	if safe_full_name == "" or safe_full_name.to_lower() == "i":
		if safe_first_name != "" and safe_first_name.to_lower() != "i":
			safe_full_name = safe_first_name
		elif safe_last_name != "":
			safe_full_name = safe_last_name
		else:
			safe_full_name = "Unknown"

	var overlay_title:= player_stats_root.get_node_or_null("TitleLabel") as Label
	if overlay_title != null:
		overlay_title.text = safe_full_name
	_sync_player_stats_incarceration_lens(p)
	var surface_context: Dictionary = _build_player_stat_surface_context(p)
	var subject_dead: bool = bool(surface_context.get("subject_dead", false))
	player_stats_overlay.visible = true
	var health_value: int = max(0, int(round(float(p.health))))
	var hunger_value: int = _player_stats_hunger_value(p)
	var mental_value: int = max(0, int(round(float(p.mental_health))))
	var willpower_value: int = _bending_hub_willpower_value(p)
	var happiness_value: int = max(0, int(round(float(p.satisfaction))))
	var smarts_value: int = max(0, int(round(float(p.smarts))))
	var looks_value: int = max(0, int(round(float(p.looks))))
	var imagination_value: int = max(0, int(round(float(p.imagination))))
	var fame_value: int = max(0, int(round(float(p.fame))))
	var approval_value: int = clamp(int(round(float(p.approval))), 0, 100)


	if subject_dead:
		health_value = 0
		hunger_value = 0
		mental_value = 0
		willpower_value = 0
		happiness_value = 0
		smarts_value = 0
		looks_value = 0
		imagination_value = 0
		fame_value = 0
		approval_value = 0

	var show_approval: bool = MainSceneLogic._player_has_meaningful_approval(p)
	var approval_widgets: Dictionary = _get_player_stats_approval_widgets()
