	action_line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	action_line.add_theme_font_size_override("font_size", 10)
	action_line.add_theme_color_override("font_color", Color(0.82, 0.88, 1.0, 0.84))
	details_root.add_child(action_line)

	var deep_status:= GridContainer.new()
	deep_status.columns = 2
	deep_status.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	deep_status.add_theme_constant_override("h_separation", 5)
	deep_status.add_theme_constant_override("v_separation", 4)
