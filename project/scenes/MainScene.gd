func _next_era_birth_preview_template(era_key: String) -> String:
	var mode_text:= _selected_reality_mode_text()
	var pool: Array = _era_birth_preview_text_pool(era_key)
	if pool.is_empty():
		return "will be born in %s, %s • %s • %s"
	var cycle_key:= "%s|%s" % [era_key, mode_text]
	var next_index:= int(god_mode_preview_tone_cycle_indices.get(cycle_key, -1)) + 1
	if next_index >= pool.size():
		next_index = 0
	god_mode_preview_tone_cycle_indices [cycle_key] = next_index
	return str(pool [next_index])

func _build_era_toned_birth_preview_line(full_name: String, city: String, country: String, era_name: String, birth_date_text: String) -> String:
	var era_key:= _selected_era_key()
	var tone_text:= _next_era_birth_preview_template(era_key)
	return "%s\n" % full_name + (tone_text % [
		city,
		country,
		era_name,
		birth_date_text
	])
func _refresh_god_mode_preview_label() -> void:
	if god_mode_viewer != null and is_instance_valid(god_mode_viewer):
		god_mode_viewer._refresh_preview()
func _refresh_god_mode_start_button_state() -> void:
	if _god_mode_runtime_severed():
		return

	if not _god_mode_runtime_allowed(
		"_refresh_god_mode_start_button_state",
		"refresh_start_button"
	):
		return

	if god_mode_start_button == null:
		return

	var valid_year: bool = (
		_has_valid_birth_year_input()
	)
	var valid_last_name: bool = (
		_has_valid_last_name_input()
	)
	var can_start: bool = (
		valid_year
		and valid_last_name
	)
	var prewarm_ready: bool = false
	var staged_room_ready: bool = false
	var prewarm_pending: bool = bool(
		get_meta(
			"god_mode_life_prewarm_pending",
			false
		)
	)
	var prewarm_running: bool = bool(
		get_meta(
			"god_mode_life_prewarm_running",
			false
		)
	)

	if can_start:
		prewarm_ready = (
			_is_god_mode_life_prewarm_ready_for_current_ui()
		)
		staged_room_ready = (
			prewarm_ready
			and _ready_door_latch_is_hot()
		)

	if staged_room_ready:
		_set_god_mode_prewarm_progress(
			1.0,
			(
				"Reality prewarmed. The room exists. "
				+ "Ready opens the door."
			),
			true
		)

	god_mode_start_button.disabled = (
		not can_start
		or not staged_room_ready
	)
	_style_god_mode_button(
		god_mode_start_button,
		true
	)

	if can_start:
		if staged_room_ready:
			god_mode_start_button.text = (
				"I'm ready to play EraLife"
			)
			god_mode_start_button.self_modulate = Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
			god_mode_start_button.tooltip_text = (
				"Open the already-existing "
				+ "playable life shell."
			)
		elif prewarm_ready:
			god_mode_start_button.text = (
				"Staging playable shell..."
			)
			god_mode_start_button.self_modulate = Color(
				1.0,
				0.96,
				0.82,
				0.86
			)
			god_mode_start_button.tooltip_text = (
				"The world seed is ready. EraLife is "
				+ "finishing the door latch before "
				+ "Ready can open."
			)
		elif (
			prewarm_pending
			or prewarm_running
		):
			god_mode_start_button.text = (
				"Prewarming your reality..."
			)
			god_mode_start_button.self_modulate = Color(
				1.0,
				0.96,
				0.82,
				0.86
			)
			god_mode_start_button.tooltip_text = (
				"EraLife is building the playable "
				+ "birth capsule from the committed seed."
			)
		else:
			god_mode_start_button.text = (
				"Pre warm world seed first"
			)
			god_mode_start_button.self_modulate = Color(
				1.0,
				0.96,
				0.82,
				0.72
			)
			god_mode_start_button.tooltip_text = (
				"Press Pre warm world seed under "
				+ "Customize Your Features first."
			)
	else:
		if not valid_last_name:
			god_mode_start_button.text = (
				"Enter a last name (2+ letters)"
			)
		else:
			god_mode_start_button.text = (
				"Enter a valid birth year"
			)

		god_mode_start_button.self_modulate = Color(
			1.0,
			1.0,
			1.0,
			0.72
		)
		god_mode_start_button.tooltip_text = (
			"Required identity fields must be "
			+ "valid before prewarming."
		)

	_refresh_god_mode_prewarm_controls(
		can_start,
		prewarm_ready,
		prewarm_pending,
		prewarm_running,
		valid_last_name,
		valid_year
	)

	if god_mode_load_button != null:
		god_mode_load_button.text = "Load Lineage"
		god_mode_load_button.tooltip_text = (
			"Hydrate into a saved parallel universe."
		)
		god_mode_load_button.disabled = false
		_style_god_mode_button(
			god_mode_load_button,
			false
		)

	if god_mode_randomizer_button != null:
		_style_god_mode_button(
			god_mode_randomizer_button,
			false
		)

	if god_mode_start_random_life_button != null:
		_style_god_mode_button(
			god_mode_start_random_life_button,
			false
		)
