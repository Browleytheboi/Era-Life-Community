func _prewarm_checkpoint_resume_era_audio_packet(
	resume_contract: Dictionary
) -> bool:
	if resume_contract.is_empty():
		return false

	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var engine = _ensure_era_audio_engine()

	if engine == null:
		return false

	var context_raw: Variant = resume_contract.get(
		"era_audio_context",
		{}
	)
	var context: Dictionary = (
		(context_raw as Dictionary).duplicate(false)
		if typeof(context_raw) == TYPE_DICTIONARY
		else {}
	)

	if context.is_empty():
		context = _era_audio_context_from_current_world()

	context ["reason"] = "checkpoint_resume_title_card_prewarm"
	context ["source"] = "checkpoint_resume_contract"
	context ["checkpoint_resume"] = true
	context ["checkpoint_resume_prewarm_only"] = true
	context ["birth_intro_audio_forbidden"] = true
	context ["audio_volume_db"] = -80.0
	context ["audio_fade_ms"] = 0
	context ["context_key"] = "checkpoint_resume_prewarm"



	var report: Dictionary = engine.apply_audio_contract(
		era_audio_contract,
		context
	)
	var hot: bool = (
		bool(
			report.get(
				"success",
				false
			)
		)
		or bool(
			report.get(
				"pending",
				false
			)
		)
	)

	set_meta(
		"checkpoint_resume_era_audio_prewarm_requested",
		hot
	)
	set_meta(
		"checkpoint_resume_era_audio_prewarm_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)
	set_meta(
		"checkpoint_resume_era_audio_prewarm_synchronous_load",
		false
	)

	return hot


func _install_checkpoint_resume_main_tab_surface_contract(
	signature: String,
	surface_id: String,
	surface_contract: Dictionary
) -> bool:
	var clean_signature: String = str(
		signature
	).strip_edges()
	var clean_surface_id: String = str(
		surface_id
	).strip_edges().to_lower()

	if (
		clean_signature == ""
		or clean_surface_id not in [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]
		or surface_contract.is_empty()
	):
		return false

	var contract: Dictionary = surface_contract.duplicate(false)
	var actor_id: int = int(
		contract.get(
			"actor_id",
			-1
		)
	)
	var surface_hot: bool = false

	match clean_surface_id:
		"relationships":
			_ensure_relationship_hub_panel()

			if (
				relationship_hub_panel != null
				and is_instance_valid(relationship_hub_panel)
			):
				relationship_hub_panel.render_contract(contract)
				relationship_hub_panel_active_actor_id = actor_id
				relationships_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						contract.get(
							"active_section",
							"family"
						)
					)
				).strip_edges().to_lower()
				relationship_hub_panel.hide_surface()
				relationship_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				surface_hot = (
					relationship_hub_panel.has_renderable_contract(
						actor_id
					)
				)
		"school":
			_ensure_school_hub_panel()

			if (
				school_hub_panel != null
				and is_instance_valid(school_hub_panel)
			):
				school_hub_panel.render_contract(contract)
				school_hub_active_actor_id = actor_id
				school_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						contract.get(
							"active_section",
							"overview"
						)
					)
				).strip_edges().to_lower()
				school_hub_panel.hide_surface()
				school_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				surface_hot = (
					school_hub_panel.has_renderable_contract(
						actor_id
					)
				)
		"activities":
			_ensure_activities_hub_panel()

			if (
				activities_hub_panel != null
				and is_instance_valid(activities_hub_panel)
			):
				activities_hub_panel.render_contract(contract)
				activities_hub_active_actor_id = actor_id
				activities_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"all"
						)
					)
				).strip_edges().to_lower()
				activities_hub_panel.visible = false
				activities_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				activities_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				surface_hot = (
					activities_hub_panel.has_renderable_contract(
						actor_id
					)
				)
		"career":
			_ensure_career_hub_panel()

			if (
				career_hub_panel != null
				and is_instance_valid(career_hub_panel)
			):
				career_hub_panel.render_contract(contract)
				career_hub_active_actor_id = actor_id
				career_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"overview"
						)
					)
				).strip_edges().to_lower()
				career_hub_active_lane = str(
					contract.get(
						"career_lane",
						"full_time"
					)
				).strip_edges().to_lower()
				career_hub_panel.visible = false
				career_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				career_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				surface_hot = (
					_career_hub_contract_is_renderable(
						career_hub_panel.active_contract,
						actor_id
					)
				)
		"mods":
			_ensure_mod_menu_panel()

			if (
				mod_menu_panel != null
				and is_instance_valid(mod_menu_panel)
			):
				mod_menu_panel.render_contract(contract)
				mod_menu_active_actor_id = actor_id
				mod_menu_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"bundles"
						)
					)
				).strip_edges().to_lower()
				mod_menu_panel.visible = false
				mod_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				mod_menu_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				surface_hot = (
					mod_menu_panel.has_precomposed_surface(
						actor_id
					)
				)

	var cached_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var cached_contracts: Dictionary = (
		(cached_contracts_raw as Dictionary).duplicate(false)
		if typeof(cached_contracts_raw) == TYPE_DICTIONARY
		else {}
	)
	cached_contracts [clean_surface_id] = contract

	set_meta(
		"resident_main_tab_surface_contracts",
		cached_contracts
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s"
		% clean_surface_id,
		surface_hot
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s_at_ms"
		% clean_surface_id,
		int(Time.get_ticks_msec())
	)
	set_meta(
		"checkpoint_resume_surface_packet_signature",
		clean_signature
	)
	set_meta(
		"checkpoint_resume_surface_packet_actor_id",
		actor_id
	)
	set_meta(
		"checkpoint_resume_surface_packet_engine_calls",
		false
	)
	set_meta(
		"checkpoint_resume_surface_packet_build_on_click",
		false
	)

	return surface_hot


func _checkpoint_resume_panel_queues_are_settled() -> bool:
	for raw_panel in [
		relationship_hub_panel,
		school_hub_panel
	]:
		var panel:= raw_panel as InstitutionHubPanelBase

		if panel == null or not is_instance_valid(panel):
			continue

		if panel.pending_section_surface_service_active:
			return false

		if not panel.pending_section_surface_order.is_empty():
			return false

		if not panel.pending_card_surface_install_queue.is_empty():
			return false

	return true


func _continue_title_card_checkpoint_resume_lens_prewarm(
	continue_contract: Dictionary,
	stage_index: int
) -> void:
	if not bool(
		get_meta(
			"title_card_checkpoint_resume_lens_prewarm_active",
			false
		)
	):
		return

	var checkpoint_path: String = str(
		continue_contract.get(
			"checkpoint_path",
			""
		)
	).strip_edges()
	var base_resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options({
			"continue_contract": continue_contract
		})
	)
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			base_resume_contract.get(
				"residency_signature",
				""
			)
		)
	).strip_edges()

	if (
		checkpoint_path == ""
		or signature == ""
		or not FileAccess.file_exists(checkpoint_path)
	):
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_active",
			false
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_failed",
			true
		)
		return

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root == null or not is_instance_valid(root):
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_active",
			false
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_failed",
			true
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_failure_reason",
			"ui_container_missing"
		)
		return

	var progressive_surface_visible: bool = bool(
		get_meta(
			"title_card_continue_progressive_surface_visible",
			false
		)
	)



	if progressive_surface_visible:
		root.visible = true
		root.mouse_filter = (
			Control.MOUSE_FILTER_PASS
		)

		if bool(
			get_meta(
				"checkpoint_reality_surface_publication_active",
				false
			)
		):
			set_meta(
				"title_card_checkpoint_resume_lens_prewarm_active",
				false
			)
			set_meta(
				"title_card_checkpoint_resume_lens_prewarm_superseded_by_generic_tail",
				true
			)
			return

	else:
		root.visible = false
		root.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
	root.process_mode = Node.PROCESS_MODE_INHERIT

	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_stage",
		stage_index
	)




	if (
		stage_index >= 3
		and not progressive_surface_visible
	):
		set_meta(
			"title_card_checkpoint_resume_core_reveal_ready",
			_title_card_checkpoint_resume_observable_truth_is_hot(
				signature
			)
		)
		set_meta(
			"title_card_checkpoint_resume_hidden_tail_paused",
			true
		)
		set_meta(
			"title_card_checkpoint_resume_hidden_tail_pause_stage",
			stage_index
		)
		set_meta(
			"title_card_checkpoint_resume_hidden_full_prewarm_forbidden",
			true
		)
		set_meta(
			"title_card_checkpoint_resume_asset_deck_before_reveal_forbidden",
			true
		)
		return

	if stage_index == 0:
		var service_report: Dictionary = (
			_request_reality_residency_intent(
				"service",
				{
					"signature": signature,
					"max_steps": 1,
					"frame_budget_ms": 2,
					"source": (
						"title_card_checkpoint_background_service"
					)
				},
				(
					"mainscene."
					+ "title_card_checkpoint_background_service"
				)
			)
		)
		var background_ready: bool = (
			bool(
				service_report.get(
					"ready",
					false
				)
			)
			and bool(
				service_report.get(
					"projection_ready",
					false
				)
			)
		)

		set_meta(
			"title_card_checkpoint_background_status",
			service_report.duplicate(false)
		)
		set_meta(
			"title_card_checkpoint_background_ready",
			background_ready
		)

		if not background_ready:
			var service_tree:= get_tree()

			if service_tree == null:
				call_deferred(
					"_continue_title_card_checkpoint_resume_lens_prewarm",
					continue_contract,
					stage_index
				)
				return

			service_tree.process_frame.connect(
				Callable(
					self,
					"_continue_title_card_checkpoint_resume_lens_prewarm"
				).bind(
					continue_contract,
					stage_index
				),
				CONNECT_ONE_SHOT
			)
			return

		var attach_report: Dictionary = (
			_request_reality_residency_intent(
				"attach",
				{
					"signature": signature,
					"checkpoint_path": checkpoint_path,
					"checkpoint_attach": true,
					"pause_checkpoint_tail_while_lens_attached": true,
					"runtime_rebuild_forbidden": true,
					"attach_on_input_frame": false,
					"source": (
						"title_card_checkpoint_hidden_attach"
					)
				},
				(
					"mainscene."
					+ "title_card_checkpoint_hidden_attach"
				)
			)
		)
		var resident_raw: Variant = attach_report.get(
			"game_state",
			attach_report.get(
				"runtime_ref",
				null
			)
		)

		if (
			not bool(
				attach_report.get(
					"success",
					false
				)
			)
			or not (resident_raw is GameState)
		):
			var attach_tree:= get_tree()

			if attach_tree == null:
				call_deferred(
					"_continue_title_card_checkpoint_resume_lens_prewarm",
					continue_contract,
					stage_index
				)
				return

			attach_tree.process_frame.connect(
				Callable(
					self,
					"_continue_title_card_checkpoint_resume_lens_prewarm"
				).bind(
					continue_contract,
					stage_index
				),
				CONNECT_ONE_SHOT
			)
			return

		if not _adopt_attached_resident_game_state(
			resident_raw as GameState,
			signature
		):
			set_meta(
				"title_card_checkpoint_resume_lens_prewarm_active",
				false
			)
			set_meta(
				"title_card_checkpoint_resume_lens_prewarm_failed",
				true
			)
			return

		var normalized_resume: Dictionary = (
			_checkpoint_resume_contract_from_attached_projection(
				base_resume_contract,
				attach_report
			)
		)

		set_meta(
			"title_card_checkpoint_resume_hidden_attach_report",
			attach_report.duplicate(false)
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_contract",
			normalized_resume.duplicate(false)
		)

	elif stage_index == 1:
		_prime_resident_playable_life_shell_surface(
			"title_card_checkpoint_resume_idle_prewarm"
		)

		if not _resident_playable_life_shell_surface_is_hot():
			var shell_tree:= get_tree()

			if shell_tree == null:
				call_deferred(
					"_continue_title_card_checkpoint_resume_lens_prewarm",
					continue_contract,
					stage_index
				)
				return

			shell_tree.process_frame.connect(
				Callable(
					self,
					"_continue_title_card_checkpoint_resume_lens_prewarm"
				).bind(
					continue_contract,
					stage_index
				),
				CONNECT_ONE_SHOT
			)
			return

	elif stage_index == 2:
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)
		var first_frame: Dictionary = MainSceneHelpers._safe_dictionary(
			resume_contract.get(
				"first_frame_ui_snapshot",
				{}
			)
		)

		_project_prebuilt_first_frame_snapshot_into_existing_shell(
			first_frame,
			"title_card_checkpoint_resume_idle_prewarm"
		)

		set_meta(
			"title_card_checkpoint_resume_core_packet_projected",
			true
		)
		set_meta(
			"title_card_checkpoint_resume_core_packet_projected_at_ms",
			int(Time.get_ticks_msec())
		)

	elif stage_index == 3:
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)
		var hud_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(
			resume_contract.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		)

		if hud_snapshot.is_empty():
			hud_snapshot = (
				_persist_runtime_hud_visibility_snapshot(
					"title_card_checkpoint_resume_progressive_capture"
				)
			)
			resume_contract [
				"runtime_hud_visibility_snapshot"
			] = hud_snapshot

			set_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				resume_contract
			)

		_apply_checkpoint_resume_hud_snapshot_to_existing_nodes(
			hud_snapshot,
			"title_card_checkpoint_resume_progressive_publication"
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"checkpoint_resume_hud_restored"
			] = true

		set_meta(
			"title_card_checkpoint_resume_hud_published",
			true
		)

	elif stage_index == 4:
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)

		set_meta(
			"checkpoint_resume_life_diary_active",
			true
		)
		set_meta(
			"checkpoint_resume_life_diary_actor_id",
			int(gs.player_id)
		)
		set_meta(
			"checkpoint_resume_birth_intro_forbidden",
			true
		)

		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"checkpoint_resume_contract"
		] = resume_contract.duplicate(false)
		gs.scenario_state [
			"checkpoint_resume_not_birth"
		] = true
		gs.scenario_state [
			"birth_intro_cry_allowed"
		] = false

		_render_life_diary_panel()

		gs.scenario_state [
			"checkpoint_resume_life_diary_restored"
		] = true

	elif stage_index == 5:
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)

		_prewarm_checkpoint_resume_era_audio_packet(
			resume_contract
		)

		if progressive_surface_visible:
			_start_checkpoint_resume_era_audio_packet(
				resume_contract
			)

			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state [
					"checkpoint_resume_era_audio_started"
				] = true

	elif (
		stage_index >= 6
		and stage_index < 11
	):
		var surface_order: Array = [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)
		var deck: Dictionary = MainSceneHelpers._safe_dictionary(
			resume_contract.get(
				"main_tab_surface_contracts",
				{}
			)
		)
		var surface_id: String = str(
			surface_order [
				stage_index - 6
			]
		)
		var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			deck.get(
				surface_id,
				{}
			)
		)

		_install_checkpoint_resume_main_tab_surface_contract(
			signature,
			surface_id,
			surface_contract
		)

		set_meta(
			"checkpoint_resume_progressive_surface_last_published",
			surface_id
		)
		set_meta(
			"checkpoint_resume_progressive_surface_last_published_at_ms",
			int(Time.get_ticks_msec())
		)

	elif stage_index == 11:
		if not _checkpoint_resume_panel_queues_are_settled():
			var queue_tree:= get_tree()

			if queue_tree == null:
				call_deferred(
					"_continue_title_card_checkpoint_resume_lens_prewarm",
					continue_contract,
					stage_index
				)
				return

			queue_tree.process_frame.connect(
				Callable(
					self,
					"_continue_title_card_checkpoint_resume_lens_prewarm"
				).bind(
					continue_contract,
					stage_index
				),
				CONNECT_ONE_SHOT
			)
			return

	elif stage_index == 12:



		var asset_observation_report: Dictionary = (
			_queue_auxiliary_surface_observation_task(
				"compact_assets_surface",
				int(gs.player_id),
				"title_card_checkpoint_resume_progressive_assets"
			)
		)

		set_meta(
			"title_card_checkpoint_resume_asset_portfolio_observation",
			asset_observation_report
		)
		set_meta(
			"title_card_checkpoint_resume_full_asset_deck_prewarm_performed",
			false
		)
		set_meta(
			"title_card_checkpoint_resume_full_asset_deck_demand_driven",
			true
		)

	else:
		var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)
		var deck: Dictionary = MainSceneHelpers._safe_dictionary(
			resume_contract.get(
				"main_tab_surface_contracts",
				{}
			)
		)
		var installed_count: int = 0

		for surface_id in [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]:
			if bool(
				get_meta(
					"native_main_tab_surface_projection_installed_%s"
					% surface_id,
					false
				)
			):
				installed_count += 1

		var complete: bool = (
			_resident_playable_life_shell_surface_is_hot()
			and installed_count == 5
			and _checkpoint_resume_panel_queues_are_settled()
		)
		var completed_at_ms: int = int(
			Time.get_ticks_msec()
		)

		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_active",
			false
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_complete",
			complete
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_completed_at_ms",
			completed_at_ms
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_surface_count",
			installed_count
		)
		set_meta(
			"title_card_checkpoint_resume_lens_prewarm_signature",
			signature
		)
		set_meta(
			"title_card_continue_progressive_publication_active",
			false
		)
		set_meta(
			"title_card_continue_progressive_publication_complete",
			complete
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"checkpoint_resume_main_tabs_restored"
			] = installed_count == 5
			gs.scenario_state [
				"checkpoint_progressive_publication_active"
			] = false
			gs.scenario_state [
				"checkpoint_progressive_publication_complete"
			] = complete


		if progressive_surface_visible:
			root.visible = true
			root.mouse_filter = Control.MOUSE_FILTER_PASS
		else:
			root.visible = false
			root.mouse_filter = Control.MOUSE_FILTER_IGNORE

		EraLog.truth(
			"ERALIFE_CHECKPOINT_BACKGROUND_RESIDENCY_TRUTH"
			+ "|signature=" + signature
			+ "|resident_ready=true"
			+ "|projection_ready=true"
			+ "|shell_hot="
			+ str(
				_resident_playable_life_shell_surface_is_hot()
			).to_lower()
			+ "|core_revealed_before_tail="
			+ str(
				progressive_surface_visible
			).to_lower()
			+ "|progressive_tail_complete="
			+ str(complete).to_lower()
			+ "|surface_packets="
			+ str(installed_count)
			+ "/5"
			+ "|relationship_cards_hot="
			+ str(
				deck.has(
					"relationships"
				)
			).to_lower()
			+ "|full_asset_deck_required=false"
			+ "|compact_asset_observation=true"
			+ "|c_input_work_required=false"
			+ "|at_ms=" + str(completed_at_ms)
		)
		return

	var advance_tree:= get_tree()

	if advance_tree == null:
		call_deferred(
			"_continue_title_card_checkpoint_resume_lens_prewarm",
			continue_contract,
			stage_index + 1
		)
		return

	advance_tree.process_frame.connect(
		Callable(
			self,
			"_continue_title_card_checkpoint_resume_lens_prewarm"
		).bind(
			continue_contract,
			stage_index + 1
		),
		CONNECT_ONE_SHOT
	)
func _refresh_title_card_identity_surface() -> void:
	if (
		gs != null
