		tab_btn.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "selected_hover" if tab_selected else "hover"))
		tab_btn.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "pressed"))
		tab_btn.add_theme_stylebox_override("focus", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "selected_hover" if tab_selected else "hover"))
