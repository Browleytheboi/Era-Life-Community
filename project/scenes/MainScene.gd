func _render_artifact_shop_observation_packet(
	packet: Dictionary
) -> void:
	if (
		artifact_shop_list == null
		or not is_instance_valid(
			artifact_shop_list
		)
		or gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		packet.get(
			"actor_id",
			-1
		)
	)

	if actor_id != int(
		gs.player.id
	):
		return

	var generation: int = int(
		packet.get(
			"generation",
			-1
		)
	)

	if generation < 0:
		return

	var phase: String = str(
		packet.get(
			"phase",
			""
		)
	).strip_edges().to_lower()

	if phase == "header":
		_apply_artifact_shop_theme()

		_clear_container_children(
			artifact_shop_list
		)

		artifact_shop_list.set_meta(
			"artifact_shop_resident_generation",
			generation
		)

		artifact_shop_list.set_meta(
			"artifact_shop_projection_complete",
			false
		)

		var palette: Dictionary = (
			_artifact_shop_palette()
		)

		var intro:= PanelContainer.new()

		intro.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		intro.add_theme_stylebox_override(
			"panel",
			_build_era_surface_panel_style(
				"main",
				true,
				0.55,
				false
			)
		)

		artifact_shop_list.add_child(
			intro
		)

		var margin:= MarginContainer.new()

		margin.add_theme_constant_override(
			"margin_left",
			14
		)

		margin.add_theme_constant_override(
			"margin_top",
			14
		)

		margin.add_theme_constant_override(
			"margin_right",
			14
		)

		margin.add_theme_constant_override(
			"margin_bottom",
			14
		)

		intro.add_child(
			margin
		)

		var intro_body:= VBoxContainer.new()

		intro_body.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		intro_body.add_theme_constant_override(
			"separation",
			6
		)

		margin.add_child(
			intro_body
		)

		var title:= Label.new()

		title.text = (
			"MYSTIC INVENTORY • LIVE CATALOG"
		)

		title.add_theme_font_size_override(
			"font_size",
			17
		)

		title.add_theme_color_override(
			"font_color",
			palette [
				"title"
			]
		)

		intro_body.add_child(
			title
		)

		var description:= Label.new()

		description.text = (
			"Artifacts publish from canonical catalog truth "
			+ "as independent resident cards. Rarity and "
			+ "artifact aura remain distinct visual signals."
		)

		description.autowrap_mode = (
			TextServer.AUTOWRAP_WORD_SMART
		)

		description.add_theme_color_override(
			"font_color",
			palette [
				"body"
			]
		)

		intro_body.add_child(
			description
		)

		var funds:= Label.new()

		funds.text = "Available Funds: %s" % str(
			packet.get(
				"funds_display",
				"0"
			)
		)

		funds.add_theme_color_override(
			"font_color",
			palette [
				"accent"
			]
		)

		intro_body.add_child(
			funds
		)

		var catalog_meta:= Label.new()

		catalog_meta.text = (
			"%d canonical artifact slots • publishing live"
			% int(
				packet.get(
					"catalog_slot_count",
					0
				)
			)
		)

		catalog_meta.add_theme_font_size_override(
			"font_size",
			10
		)

		catalog_meta.add_theme_color_override(
			"font_color",
			palette [
				"meta"
			]
		)

		intro_body.add_child(
			catalog_meta
		)

		var grid:= GridContainer.new()

		grid.name = "ArtifactShopCardGrid"

		grid.columns = 3

		grid.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)

		grid.add_theme_constant_override(
			"h_separation",
			12
		)

		grid.add_theme_constant_override(
			"v_separation",
			12
		)

		artifact_shop_list.add_child(
			grid
		)

		if artifact_shop_status_label != null:
			artifact_shop_status_label.text = (
				"Publishing resident artifact catalog…"
			)

		set_meta(
			"artifact_shop_last_observed_generation",
			generation
		)

		set_meta(
			"artifact_shop_last_observed_phase",
			"header"
		)

		return

	var installed_generation: int = int(
		artifact_shop_list.get_meta(
			"artifact_shop_resident_generation",
			-1
		)
	)



	if generation != installed_generation:
		return

	if phase == "row":
		var row: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"row",
				{}
			)
		)

		if row.is_empty():
			return

		var grid:= (
			artifact_shop_list.get_node_or_null(
				"ArtifactShopCardGrid"
			) as GridContainer
		)

		if grid == null:
			return

		grid.add_child(
			_build_artifact_shop_grid_card(
				row
			)
		)

		if artifact_shop_status_label != null:
			artifact_shop_status_label.text = (
				"%d artifact contracts resident…"
				% grid.get_child_count()
			)

		set_meta(
			"artifact_shop_last_observed_generation",
			generation
		)

		set_meta(
			"artifact_shop_last_observed_phase",
			"row"
		)

		set_meta(
			"artifact_shop_last_observed_row_index",
			int(
				packet.get(
					"row_index",
					-1
				)
			)
		)

		return

	if phase == "complete":
		var contract: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"shop_contract",
				{}
			)
		)

		if not contract.is_empty():
			artifact_shop_active_contract = (
				contract.duplicate(false)
			)

			artifact_observability_contract = {
				"actor_id": actor_id,
				"owned_stone_count": int(
					contract.get(
						"owned_stone_count",
						0
					)
				),
				"owns_all_stones": bool(
					contract.get(
						"owns_all_stones",
						false
					)
				),
				"artifact_signature": str(
					contract.get(
						"artifact_signature",
						"artifacts_none"
					)
				),
				"truth_state": str(
					contract.get(
						"truth_state",
						"hot"
					)
				),
				"projection_composed": bool(
					contract.get(
						"projection_composed",
						true
					)
				),
				"hydrated": bool(
					contract.get(
						"hydrated",
						true
					)
				),
				"ui_is_renderer_only": true
			}

		artifact_shop_list.set_meta(
			"artifact_shop_projection_complete",
			true
		)

		if artifact_shop_status_label != null:
			artifact_shop_status_label.text = (
				"%d artifact contracts resident."
				% int(
					packet.get(
						"stock_count",
						0
					)
				)
			)

		set_meta(
			"artifact_shop_last_observed_generation",
			generation
		)

		set_meta(
			"artifact_shop_last_observed_phase",
			"complete"
		)

		set_meta(
			"artifact_shop_last_observation_blocks_ui",
			false
		)

		set_meta(
			"artifact_shop_last_observation_required_idle",
			false
		)

		set_meta(
			"artifact_shop_last_observation_built_catalog",
			false
		)

		return
