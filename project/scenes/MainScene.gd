func _prewarm_property_market_surface_quantum_for_actor(
	target_actor: Person,
	reason: String
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
		or property_market_panel == null
		or not is_instance_valid(
			property_market_panel
		)
	):
		return {}

	var actor_id: int = int(
		target_actor.id
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": (
				"observe_property_market_surface_quantum"
			),
			"surface_id": (
				"property_market_contract_panel"
			),
			"action_id": (
				"service_market_surface_observation_quantum"
			),
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"actor_id": actor_id,
				"source": reason,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"property_market_contract_engine"
				),
				"method": (
					"service_market_surface_observation_quantum"
				),
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": reason
		},
		{
			"actor_id": actor_id,
			"surface_id": (
				"property_market_contract_panel"
			),
			"action_id": (
				"service_market_surface_observation_quantum"
			),
			"source": reason,
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true
		}
	)

	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)
	var quantum: Dictionary = (
		(result_raw as Dictionary).duplicate(false)
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)

	if quantum.is_empty():
		return {}

	var patch_raw: Variant = quantum.get(
		"surface_patch",
		{}
	)

	if (
		typeof(patch_raw) == TYPE_DICTIONARY
		and not (patch_raw as Dictionary).is_empty()
	):
		property_market_panel.apply_progressive_listing_patch(
			patch_raw as Dictionary
		)

	return quantum
func _ensure_property_market_panel() -> void:
	if property_market_panel != null and is_instance_valid(property_market_panel):
		property_market_panel.bind_host(self, gs)
		return

	property_market_panel = PropertyMarketPanel.new()
	property_market_panel.name = "PropertyMarketPanel"
	property_market_panel.visible = false
	property_market_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	property_market_panel.z_index = 172
	property_market_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	property_market_panel.bind_host(self, gs)
	property_market_panel.close_requested.connect(_hide_property_market_panel)
	property_market_panel.listing_action_requested.connect(_on_property_market_listing_action_requested)
	add_child(property_market_panel)


func _hide_property_market_panel() -> void:
	property_market_open = false

	if (
		property_market_panel != null
		and is_instance_valid(
			property_market_panel
		)
	):
		property_market_panel.visible = false
		property_market_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		property_market_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
