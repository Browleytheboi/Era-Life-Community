	set_meta(
		"pending_situations_button_updated_at_ms",
		int(Time.get_ticks_msec())
	)
	var resident_payload_by_actor: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"resident_pending_situations_payload_by_actor",
			{}
		)
	)
	var resident_payload: Dictionary = MainSceneHelpers._safe_dictionary(
		resident_payload_by_actor.get(
			str(actor_id),
			{}
		)
	)

	if (
		not resident_payload.is_empty()
		and bool(
			resident_payload.get(
				"success",
				false
			)
		)
		and int(
			resident_payload.get(
				"actor_id",
				-1
			)
		) == actor_id
	):
		_prepaint_pending_situations_popup_payload(
			resident_payload,
			actor_id
		)
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"pending_situations_count"
