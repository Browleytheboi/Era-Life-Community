func _reality_surface_contract_from_mod_route(
	route_result: Dictionary
) -> Dictionary:
	if route_result.is_empty():
		return {}

	var queue: Array = [
		route_result.duplicate(true)
	]
	var inspected: int = 0
	var preferred_keys: Array = [
		"reality_surface_contract",
		"transition",
		"runtime_report",
		"bundle_report",
		"mod_menu_contract",
		"bundle_menu_contract",
		"route_report",
		"result",
		"engine_report",
		"target_report",
		"commit_report",
		"command_report",
		"payload",
		"crr_report"
	]

	while (
		not queue.is_empty()
		and inspected < 96
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		if str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges() == "eralife.reality_surface_contract":
			return cursor.duplicate(true)

		var direct: Dictionary = MainSceneHelpers._safe_dictionary(
			cursor.get(
				"reality_surface_contract",
				{}
			)
		)

		if not direct.is_empty():
			return direct

		for raw_key in preferred_keys:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			).duplicate(true)

			if not nested.is_empty():
				queue.append(nested)

		for raw_key in cursor.keys():
			if str(raw_key) in preferred_keys:
				continue

			var dynamic_raw: Variant = cursor.get(
				raw_key,
				{}
			)

			if typeof(dynamic_raw) != TYPE_DICTIONARY:
				continue

			var dynamic_nested: Dictionary = (
				dynamic_raw as Dictionary
			).duplicate(true)

			if not dynamic_nested.is_empty():
				queue.append(dynamic_nested)

	return {}

