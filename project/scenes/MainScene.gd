func _player_secret_superpower_birth_identity_line() -> String:
	var scope_id: String = "only_me"

	if gs != null and typeof(gs.custom_settings) == TYPE_DICTIONARY:
		var config_raw: Variant = gs.custom_settings.get("superpower_configurator", {})
		if typeof(config_raw) == TYPE_DICTIONARY:
			var config: Dictionary = (config_raw as Dictionary).duplicate(true)
			scope_id = str(config.get("scope", scope_id)).strip_edges().to_lower()

	if gs != null and gs.superhero_engine != null and gs.player != null:
		if gs.superhero_engine.has_method("ensure_hero_profile"):
			var profile: Dictionary = gs.superhero_engine.ensure_hero_profile(gs.player)
			var profile_scope: String = str(profile.get("family_power_scope", "")).strip_edges().to_lower()
			if profile_scope != "":
				scope_id = profile_scope

	var family_scope: bool = scope_id in ["whole_family", "my_bloodline"]
	var scope_text: String = "our lives" if family_scope else "my life"
	return "🎶What you see is not what you get, living %s with a…secret (queue Thundermans theme)." % scope_text
func _custom_household_existing_life_start_active() -> bool:
	if gs == null or gs.player == null:
		return false
	if int(gs.player.age) <= 0:
		return false

	var contract: Dictionary = _active_custom_household_spawn_contract_for_diary()
	if contract.is_empty():
		return false

	var prewarm_policy_raw: Variant = contract.get("prewarm_policy", {})
	var prewarm_policy: Dictionary = prewarm_policy_raw if typeof(prewarm_policy_raw) == TYPE_DICTIONARY else {}
	return bool(prewarm_policy.get("do_not_play_birth_intro_unless_newborn", true))


func _active_custom_household_spawn_contract_for_diary() -> Dictionary:
	if gs == null:
		return {}

	if typeof(gs.custom_settings) == TYPE_DICTIONARY:
		var settings_raw: Variant = gs.custom_settings.get("household_spawn_contract", {})
		if typeof(settings_raw) == TYPE_DICTIONARY and not (settings_raw as Dictionary).is_empty():
			return (settings_raw as Dictionary).duplicate(true)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var state_raw: Variant = gs.scenario_state.get("custom_household_spawn_contract", {})
		if typeof(state_raw) == TYPE_DICTIONARY and not (state_raw as Dictionary).is_empty():
			return (state_raw as Dictionary).duplicate(true)

	return {}


func _custom_household_existing_life_intro_lines() -> Array:
	if gs == null or gs.player == null:
		return []

	var p: Person = gs.player
	var contract: Dictionary = _active_custom_household_spawn_contract_for_diary()
	var lines: Array = []
	var seen: Dictionary = {}

	lines.append("Year: %s" % _format_year(gs.year))
	lines.append("Age: %d" % int(p.age))

	var full_name: String = ("%s %s" % [str(p.first_name), str(p.last_name)]).strip_edges()
	if full_name == "":
		full_name = MainSceneHelpers._person_display_name_for_identity_switch(p)

	lines.append("My name is %s." % full_name)

	var job_line: String = MainSceneHelpers._custom_household_job_diary_line(p)
	if job_line != "":
		lines.append(job_line)

	var home_raw: Variant = contract.get("home", {})
	var home: Dictionary = home_raw if typeof(home_raw) == TYPE_DICTIONARY else {}
	var location_raw: Variant = contract.get("location", {})
	var location: Dictionary = location_raw if typeof(location_raw) == TYPE_DICTIONARY else {}

	var house_type: String = str(home.get("house_type", "")).strip_edges()
	if house_type == "":
		house_type = str(gs.custom_settings.get("house_type", "home")).strip_edges() if typeof(gs.custom_settings) == TYPE_DICTIONARY else "home"

	var city: String = str(location.get("city", p.home_city)).strip_edges()
	var country: String = str(location.get("country", p.home_country)).strip_edges()

	if city != "" and country != "":
		lines.append("I live in a %s in %s, %s." % [house_type, city, country])
	elif city != "":
		lines.append("I live in a %s in %s." % [house_type, city])
	else:
		lines.append("I live in a %s." % house_type)

	var member_index_raw: Variant = gs.scenario_state.get("custom_household_member_index", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var member_index: Dictionary = member_index_raw if typeof(member_index_raw) == TYPE_DICTIONARY else {}
	var actor_key: String = ""
	for raw_key in member_index.keys():
		if int(member_index.get(raw_key, -1)) == int(p.id):
			actor_key = str(raw_key)
			break

	var members_raw: Variant = contract.get("members", [])
	var members: Array = members_raw if typeof(members_raw) == TYPE_ARRAY else []
	var members_by_key: Dictionary = {}
	for raw_member in members:
		if typeof(raw_member) != TYPE_DICTIONARY:
			continue
		var member_contract: Dictionary = raw_member as Dictionary
		var local_key: String = str(member_contract.get("local_key", "")).strip_edges()
		if local_key != "":
			members_by_key [local_key] = member_contract.duplicate(true)

	for raw_key in member_index.keys():
		var local_key: String = str(raw_key).strip_edges()
		if local_key == "" or int(member_index.get(local_key, -1)) == int(p.id):
			continue

		var other: Person = gs.get_npc_by_id(int(member_index.get(local_key, -1))) if gs.has_method("get_npc_by_id") else null
		if other == null:
			continue

		var relation_text: String = MainSceneHelpers._custom_household_relation_label_from_actor(actor_key, local_key, members_by_key)
		var other_name: String = str(other.first_name).strip_edges()
		if other_name == "":
			other_name = MainSceneHelpers._person_display_name_for_identity_switch(other)

		lines.append("I live with my %s %s, %s, aged %d." % [
			relation_text,
			other_name,
			MainSceneLogic._custom_household_member_display_job(other),
			int(other.age)
		])

	for raw_memory in p.memories:
		var memory_text: String = MainSceneHelpers._compact_diary_text(str(raw_memory))
		if memory_text == "":
			continue
		if MainSceneHelpers._custom_household_is_birth_leak_diary_line(memory_text):
			continue
		if seen.has(memory_text):
			continue
		seen [memory_text] = true
		lines.append(memory_text)

	return lines


func _build_new_life_intro_lines() -> Array:
	if _custom_household_existing_life_start_active():
		return _custom_household_existing_life_intro_lines()

	var p:= gs.player
	var lines:= []

	var seen_intro_lines: Dictionary = {}
	var has_avatar_birth_line:= false
	var has_avatar_legend_line:= false
	var has_secret_power_identity_line:= false
	var early_memory_lines: Array = []
	var late_mythic_memory_lines: Array = []

	lines.append("Year: %s" % _format_year(gs.year))
	lines.append("Age: %d" % p.age)
	lines.append("I was born in %s." % _format_year(gs.year))

	var avatar_birth_intro: bool = MainSceneLogic._player_is_avatar_birth(gs)
	var birth_city: String = str(p.birth_city).strip_edges()
	var birth_state: String = str(p.get("birth_state")).strip_edges()
	var birth_country: String = str(p.birth_country).strip_edges()

	if birth_city == "":
		birth_city = str(p.home_city).strip_edges()
	if birth_state == "":
		birth_state = str(p.get("home_state")).strip_edges()
	if birth_country == "":
		birth_country = str(p.home_country).strip_edges()
	if birth_city == "":
		birth_city = "an unknown city"
	if birth_country == "":
		birth_country = "an unknown nation"

	var birth_place_text: String = MainSceneHelpers._format_birth_place_text(birth_city, birth_state, birth_country)

	if avatar_birth_intro:
		lines.append("    I was reincarnated as a %s in %s." % [
			p.gender.to_lower(),
			birth_place_text
		])
	else:
		lines.append("I was born a %s in %s." % [
			p.gender.to_lower(),
			birth_place_text
		])
	if gs.memory_engine != null:
		for mem_value in gs.memory_engine.get_memories(int(p.id)):
			var mem_text: String = MainSceneHelpers._compact_diary_text(str(mem_value))
			if MainSceneLogic._is_secret_superpower_birth_identity_line(mem_text):
				mem_text = _player_secret_superpower_birth_identity_line()
				has_secret_power_identity_line = true

			if mem_text == "" or seen_intro_lines.has(mem_text):
				continue

			var mem_lower:= mem_text.to_lower()
			if mem_lower.find("the avatar has been reincarnated") != -1:
				continue
			if mem_lower.find(" the avatar has been reincarnated") != -1:
				continue

			var is_raw_birth_stone_line:= (
				(
					mem_lower.begins_with("i was born with ")
					or mem_lower.find(" was born with ") != -1
				)
				and mem_lower.find(" stone") != -1
				and mem_lower.find("blessed to be born with") == -1
			)
			var is_birth_stone_fame_line:= (
				mem_lower.find("infinity stone discovery has made me famous worldwide") != -1
			)
			if is_raw_birth_stone_line or is_birth_stone_fame_line:
				continue

			var is_legacy_avatar_birth_line:= (
				mem_lower.find("i was born as the avatar") != -1
				or mem_lower.find("i was born the avatar") != -1
				or mem_lower.find("master of all elements") != -1
				or mem_lower.find("master of the 4 elements") != -1
			)
			if is_legacy_avatar_birth_line:
				continue

			var is_late_mythic_line:= (
				mem_lower.find("avatar") != -1
				or mem_lower.find("red bonnet") != -1
				or mem_lower.find("living legend") != -1
				or mem_lower.find("legendary across the world") != -1
				or mem_lower.find("became legendary across the world") != -1
				or mem_lower.find("people everywhere know my name") != -1
				or mem_lower.find("legendary figure") != -1
				or mem_lower.find("blessed to be born with") != -1
				or mem_lower.find("great power, comes great responsibility") != -1
			)

			if mem_lower.find("my soul was chosen to become the next avatar") != -1:
				has_avatar_birth_line = true
			if (
				mem_lower.find("living legend") != -1
				or mem_lower.find("legendary across the world") != -1
				or mem_lower.find("became legendary across the world") != -1
				or mem_lower.find("people everywhere know my name") != -1
			):
				has_avatar_legend_line = true

			seen_intro_lines [mem_text] = true
			if is_late_mythic_line:
				late_mythic_memory_lines.append(mem_text)
			else:
				early_memory_lines.append(mem_text)

	if p.memories.size() > 0:
		for mem_value in p.memories:
			var mem_text: String = MainSceneHelpers._compact_diary_text(str(mem_value))
			if MainSceneLogic._is_secret_superpower_birth_identity_line(mem_text):
				mem_text = _player_secret_superpower_birth_identity_line()
				has_secret_power_identity_line = true

			if mem_text == "" or seen_intro_lines.has(mem_text):
				continue

			var mem_lower:= mem_text.to_lower()
			if mem_lower.find("the avatar has been reincarnated") != -1:
				continue
			if mem_lower.find(" the avatar has been reincarnated") != -1:
				continue

			var is_raw_birth_stone_line:= (
				(
					mem_lower.begins_with("i was born with ")
					or mem_lower.find(" was born with ") != -1
				)
				and mem_lower.find(" stone") != -1
				and mem_lower.find("blessed to be born with") == -1
			)
			var is_birth_stone_fame_line:= (
				mem_lower.find("infinity stone discovery has made me famous worldwide") != -1
			)
			if is_raw_birth_stone_line or is_birth_stone_fame_line:
				continue

			var is_late_mythic_line:= (
				mem_lower.find("avatar") != -1
				or mem_lower.find("red bonnet") != -1
				or mem_lower.find("living legend") != -1
				or mem_lower.find("legendary across the world") != -1
				or mem_lower.find("became legendary across the world") != -1
				or mem_lower.find("people everywhere know my name") != -1
				or mem_lower.find("legendary figure") != -1
				or mem_lower.find("blessed to be born with") != -1
				or mem_lower.find("great power, comes great responsibility") != -1
			)

			if mem_lower.find("avatar") != -1:
				has_avatar_birth_line = true
			if (
				mem_lower.find("living legend") != -1
				or mem_lower.find("legendary across the world") != -1
				or mem_lower.find("became legendary across the world") != -1
				or mem_lower.find("people everywhere know my name") != -1
			):
				has_avatar_legend_line = true

			seen_intro_lines [mem_text] = true
			if is_late_mythic_line:
				late_mythic_memory_lines.append(mem_text)
			else:
				early_memory_lines.append(mem_text)

	if MainSceneLogic._player_has_secret_superpower_birth_identity(gs) and not has_secret_power_identity_line:
		var secret_identity_line: String = _player_secret_superpower_birth_identity_line()
		if secret_identity_line != "" and not seen_intro_lines.has(secret_identity_line):
			seen_intro_lines [secret_identity_line] = true
			early_memory_lines.append(secret_identity_line)
			has_secret_power_identity_line = true

	var safe_first_name: String = str(p.first_name).strip_edges()
	var safe_last_name: String = str(p.last_name).strip_edges()
	var safe_full_name: String = ("%s %s" % [safe_first_name, safe_last_name]).strip_edges()
	if safe_full_name == "" or safe_full_name.to_lower() == "i":
		if safe_first_name != "" and safe_first_name.to_lower() != "i":
			safe_full_name = safe_first_name
		elif safe_last_name != "":
			safe_full_name = safe_last_name
		else:
			safe_full_name = "Unknown"

	for mem_text in early_memory_lines:
		lines.append(mem_text)

	lines.append("My birthday is %s %d. I am a %s." % [
		MainSceneHelpers._get_month_name(p.birthday.month),
		p.birthday.day,
		p.zodiac
	])
	lines.append("My name is %s." % safe_full_name)
	_append_birth_family_intro_lines(lines, seen_intro_lines, p)

	for mem_text in late_mythic_memory_lines:
		lines.append(mem_text)

	if p.bending_type != "none":
		if p.bending_type == "avatar":
			if not has_avatar_birth_line:
				lines.append("My soul was chosen to become the next Avatar, Master of 4 Elements.")
			if not has_avatar_legend_line:
				lines.append("My name is legendary across the world.")
				lines.append("People everywhere know my name.")
		else:
			lines.append("I was born with %s bending." % p.bending_type)

	return lines
