func _show_superpower_hub_overlay() -> void:
	if not _player_has_superpower_hub_access():
		return

	_ensure_superpower_hub_overlay()
	if superpower_hub_overlay == null:
		return

	set_meta("superpower_hub_click_visual_only", true)
	set_meta("superpower_hub_click_deeper_truth_deferred", true)
	set_meta("superpower_hub_click_sync_render_forbidden", true)
	set_meta("superpower_hub_click_sync_hud_update_forbidden", true)
	set_meta("superpower_hub_click_at_ms", int(Time.get_ticks_msec()))

	power_hub_open = false
	if power_hub_overlay != null and is_instance_valid(power_hub_overlay):
		power_hub_overlay.visible = false
		power_hub_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	superpower_hub_open = true
	superpower_hub_overlay.visible = true
	superpower_hub_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	_bring_modal_to_front(superpower_hub_overlay)
	superpower_hub_overlay.grab_focus()

	call_deferred("_render_superpower_hub_overlay_after_visual_open")
func _render_superpower_hub_overlay_after_visual_open() -> void:
	if not superpower_hub_open:
		return

	var cache: Dictionary = _precompute_super_runtime_surface_cache_for_state(gs, "superpower_hub_open")
	if cache.is_empty():
		_super_runtime_queue_deeper_truth_refresh("superpower_hub_open_cache_empty")

	_render_superpower_hub_overlay()
	call_deferred("_update_superpower_hud")
	call_deferred("_update_power_hud")

func _hide_superpower_hub_overlay() -> void:
	superpower_hub_open = false
	_hide_superpower_hub_detail_panel()
	if superpower_hub_overlay != null:
		superpower_hub_overlay.visible = false
	_update_superpower_hud()
	_update_power_hud()
func _super_runtime_actor_optional_dictionary(actor: Person, property_name: String) -> Dictionary:
	if actor == null:
		return {}

	var clean_property: String = str(property_name).strip_edges()
	if clean_property == "":
		return {}

	var value: Variant = actor.get(clean_property)
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)

	return {}


func _super_runtime_synthesized_superhero_payload(source_gs: GameState, actor: Person, reason: String = "synthesized_safe_packet") -> Dictionary:
	if source_gs == null or actor == null:
		return {}

	var actor_name: String = MainSceneHelpers._superpower_hub_actor_label(actor)
	var power_state: Dictionary = {}
	var has_powers: bool = false
	var has_superhero_access: bool = false

	if source_gs.power_engine != null and source_gs.power_engine.has_method("get_person_power_state"):
		power_state = _superpower_hub_safe_dictionary(source_gs.power_engine.get_person_power_state(actor))

	if source_gs.power_engine != null and source_gs.power_engine.has_method("has_superpowers"):
		has_powers = bool(source_gs.power_engine.has_superpowers(actor))

	if source_gs.superhero_engine != null and source_gs.superhero_engine.has_method("has_superhero_hub_access"):
		has_superhero_access = bool(source_gs.superhero_engine.has_superhero_hub_access(actor))

	return {
		"success": true,
		"schema": "eralife.superhero_hub_overlay_payload",
		"version": 1,
		"actor_id": int(actor.id),
		"actor_name": actor_name,
		"profile": _super_runtime_actor_optional_dictionary(actor, "superhero_profile"),
		"power_state": power_state.duplicate(true),
		"power_line": "PowerEngine available." if source_gs.power_engine != null else "PowerEngine unavailable.",
		"power_level_label": "Syncing",
		"hero_tier": "Syncing",
		"fighting_record": "0-0-0",
		"default_section_id": "overview",
		"sections": [
			{
				"id": "overview",
				"title": "SUPER HERO OVERVIEW",
				"rows": [
					{ "label": "Actor", "value": actor_name},
					{ "label": "Powers", "value": "Detected" if has_powers else "No active powers detected"},
					{ "label": "Hero Access", "value": "Available" if has_superhero_access else "Syncing"},
					{ "label": "Packet", "value": "Safe packet rendered immediately"}
				]
			},
			{
				"id": "status",
				"title": "RUNTIME STATUS",
				"rows": [
					{ "label": "Contract", "value": "Hot packet missing or incomplete"},
					{ "label": "Recovery", "value": "Rendering safe packet while deeper superhero truth refreshes behind it"}
				]
			}
		],
		"runtime_cache_ready": false,
		"runtime_cache_reason": reason,
	}


func _super_runtime_queue_deeper_truth_refresh(reason: String = "deeper_truth_refresh") -> void:
	if gs == null or gs.player == null:
		return

	MainSceneLogic._invalidate_super_runtime_surface_cache(gs, reason)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_precompute_super_runtime_surface_cache_for_state", gs, reason)
		return

	var timer:= tree.create_timer(0.12)
	timer.timeout.connect(
		func () -> void:
			if gs != null and gs.player != null:
				_precompute_super_runtime_surface_cache_for_state(gs, reason)
				if superpower_hub_open and superpower_hub_overlay != null and superpower_hub_overlay.visible:
					_render_superpower_hub_overlay()
				if power_hub_open and power_hub_overlay != null and power_hub_overlay.visible:
					_render_power_hub_overlay()
				_update_superpower_hud()
				_update_power_hud(),
		CONNECT_ONE_SHOT
	)


func _controlled_perspective_truth_packet() -> Dictionary:
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return {}

	var raw_packet: Variant = gs.scenario_state.get("controlled_perspective_truth", {})
	if typeof(raw_packet) != TYPE_DICTIONARY:
		return {}

	return (raw_packet as Dictionary).duplicate(true)


func _runtime_controlled_perspective_truth_bool_for_current_actor(keys: Array) -> bool:
	if gs == null or gs.player == null:
		return false
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	var actor_id: int = int(gs.player.id)

	var packet: Dictionary = _superpower_hub_safe_dictionary(gs.scenario_state.get("controlled_perspective_truth", {}))
	if not packet.is_empty() and int(packet.get("actor_id", -1)) == actor_id:
		var hud_truth: Dictionary = _superpower_hub_safe_dictionary(packet.get("hud_truth", {}))
		for raw_key in keys:
			var key: String = str(raw_key).strip_edges()
			if key != "" and bool(hud_truth.get(key, false)):
				return true

	var snapshot: Dictionary = _superpower_hub_safe_dictionary(gs.scenario_state.get("runtime_hud_visibility_snapshot", {}))
	if not snapshot.is_empty():
		var snapshot_actor_id: int = int(snapshot.get("controlled_actor_id", snapshot.get("player_id", -1)))
		if snapshot_actor_id == actor_id:
			for raw_snapshot_key in keys:
				var snapshot_key: String = str(raw_snapshot_key).strip_edges()
				if snapshot_key != "" and bool(snapshot.get(snapshot_key, false)):
					return true

	return false


func _runtime_player_has_wizard_hub_access() -> bool:
	return _runtime_controlled_perspective_truth_bool_for_current_actor([
		"wizard",
		"wizard_available"
	])


func _runtime_hud_truth_for_current_perspective(
	reason: String = "controlled_perspective"
) -> Dictionary:
	var truth: Dictionary = {
		"schema": "eralife.runtime_hud_truth",
		"version": 2,
		"reason": reason,
		"actor_id": -1,
		"actor_name": "",
		"current_panel": "life",
		"belongings_available": false,
		"bending_available": false,
		"crown_available": false,
		"food_lifestyle_available": false,
		"restaurant_lifestyle_available": false,
		"rick_weapon_shop_available": false,
		"boxing_available": false,
		"superhero_available": false,
		"superpower_available": false,
		"power_available": false,
		"wizard_available": false,
		"updated_at_ms": int(
			Time.get_ticks_msec()
		)
	}

	if (
		gs == null
		or gs.player == null
	):
		return truth

	var actor: Person = gs.player
	var actor_id: int = int(
		actor.id
	)
	var actor_alive: bool = (
		bool(actor.alive)
		and float(actor.health) > 0.0
	)

	truth ["actor_id"] = actor_id
	truth ["actor_name"] = MainSceneHelpers._superpower_hub_actor_label(
		actor
	)

	if not actor_alive:
		return truth

	truth ["belongings_available"] = (
		_player_has_visible_belongings()
	)
	truth ["bending_available"] = (
		_player_has_visible_bending()
	)
	truth ["crown_available"] = (
		_player_has_crown_presence()
	)
	truth ["food_lifestyle_available"] = (
		_food_lifestyle_food_hub_available()
	)
	truth ["restaurant_lifestyle_available"] = (
		_food_lifestyle_restaurant_hub_available()
	)
	truth ["rick_weapon_shop_available"] = (
		MainSceneLogic._rick_weapon_shop_hub_available(gs)
		or (
			rick_weapon_shop_hud_button != null
			and is_instance_valid(
				rick_weapon_shop_hud_button
			)
			and bool(
				rick_weapon_shop_hud_button.visible
			)
		)
	)
	truth ["boxing_available"] = (
		_player_has_boxing_hub_access()
	)
	truth ["superpower_available"] = (
		_player_has_superpower_hub_access()
	)
	truth ["power_available"] = (
		_player_has_power_hub_access()
	)
	truth ["superhero_available"] = (
		bool(
			truth.get(
				"superpower_available",
				false
			)
		)
		or bool(
			truth.get(
				"power_available",
				false
			)
		)
	)
	truth ["wizard_available"] = (
		_runtime_player_has_wizard_hub_access()
	)

	var packet: Dictionary = (
		_controlled_perspective_truth_packet()
	)

	if (
		not packet.is_empty()
		and int(
			packet.get(
				"actor_id",
				-1
			)
		) == actor_id
	):
		var hud_truth: Dictionary = (
			_superpower_hub_safe_dictionary(
				packet.get(
					"hud_truth",
					{}
				)
			)
		)

		truth ["belongings_available"] = (
			bool(
				truth.get(
					"belongings_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"belongings",
					hud_truth.get(
						"belongings_available",
						false
					)
				)
			)
		)
		truth ["bending_available"] = (
			bool(
				truth.get(
					"bending_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"bending",
					hud_truth.get(
						"bending_available",
						false
					)
				)
			)
		)
		truth ["crown_available"] = (
			bool(
				truth.get(
					"crown_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"crown",
					hud_truth.get(
						"crown_available",
						false
					)
				)
			)
		)
		truth ["food_lifestyle_available"] = (
			bool(
				truth.get(
					"food_lifestyle_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"food_lifestyle_available",
					hud_truth.get(
						"grocery_store_available",
						false
					)
				)
			)
		)
		truth ["restaurant_lifestyle_available"] = (
			bool(
				truth.get(
					"restaurant_lifestyle_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"restaurant_lifestyle_available",
					hud_truth.get(
						"restaurant_available",
						false
					)
				)
			)
		)
		truth ["rick_weapon_shop_available"] = (
			bool(
				truth.get(
					"rick_weapon_shop_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"rick_weapon_shop_available",
					false
				)
			)
		)
		truth ["boxing_available"] = (
			bool(
				truth.get(
					"boxing_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"boxing",
					hud_truth.get(
						"boxing_available",
						false
					)
				)
			)
		)
		truth ["superhero_available"] = (
			bool(
				truth.get(
					"superhero_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"superhero",
					hud_truth.get(
						"superhero_available",
						false
					)
				)
			)
		)
		truth ["superpower_available"] = (
			bool(
				truth.get(
					"superpower_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"superpower",
					hud_truth.get(
						"superpower_available",
						hud_truth.get(
							"superhero_available",
							false
						)
					)
				)
			)
		)
		truth ["power_available"] = (
			bool(
				truth.get(
					"power_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"power",
					hud_truth.get(
						"power_available",
						false
					)
				)
			)
		)
		truth ["wizard_available"] = (
			bool(
				truth.get(
					"wizard_available",
					false
				)
			)
			or bool(
				hud_truth.get(
					"wizard",
					hud_truth.get(
						"wizard_available",
						false
					)
				)
			)
		)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var previous_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_hud_visibility_snapshot",
				{}
			)
		)
		var previous_actor_id: int = int(
			previous_snapshot.get(
				"controlled_actor_id",
				previous_snapshot.get(
					"player_id",
					-1
				)
			)
		)

		if previous_actor_id == actor_id:
			for raw_key in [
				"belongings_available",
				"bending_available",
				"crown_available",
				"food_lifestyle_available",
				"restaurant_lifestyle_available",
				"rick_weapon_shop_available",
				"boxing_available",
				"superhero_available",
				"superpower_available",
				"power_available",
				"wizard_available"
			]:
				var key: String = str(
					raw_key
				)
				truth [key] = (
					bool(
						truth.get(
							key,
							false
						)
					)
					or bool(
						previous_snapshot.get(
							key,
							false
						)
					)
				)

	truth ["superhero_available"] = (
		bool(
			truth.get(
				"superhero_available",
				false
			)
		)
		or bool(
			truth.get(
				"superpower_available",
				false
			)
		)
		or bool(
			truth.get(
				"power_available",
				false
			)
		)
	)

	return truth

func _commit_runtime_hud_truth_snapshot(truth: Dictionary, reason: String = "controlled_perspective") -> void:
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	var snapshot: Dictionary = {
		"player_id": int(truth.get("actor_id", -1)),
		"controlled_actor_id": int(truth.get("actor_id", -1)),
		"controlled_actor_name": str(truth.get("actor_name", "")),
		"current_panel": "life",
		"belongings_available": bool(truth.get("belongings_available", false)),
		"bending_available": bool(truth.get("bending_available", false)),
		"crown_available": bool(truth.get("crown_available", false)),
		"food_lifestyle_available": bool(truth.get("food_lifestyle_available", false)),
		"restaurant_lifestyle_available": bool(truth.get("restaurant_lifestyle_available", false)),
		"rick_weapon_shop_available": bool(truth.get("rick_weapon_shop_available", false)),
		"boxing_available": bool(truth.get("boxing_available", false)),
		"superhero_available": bool(truth.get("superhero_available", truth.get("superpower_available", false))),
		"superpower_available": bool(truth.get("superpower_available", truth.get("superhero_available", false))),
		"power_available": bool(truth.get("power_available", false)),
		"wizard_available": bool(truth.get("wizard_available", false)),
		"reason": reason,
		"updated_at_ms": int(Time.get_ticks_msec())
	}

	gs.scenario_state ["runtime_hud_visibility_snapshot"] = snapshot.duplicate(true)
	gs.scenario_state ["runtime_hud_visibility_snapshot_reason"] = reason
	gs.scenario_state ["runtime_hud_visibility_snapshot_at_ms"] = int(Time.get_ticks_msec())

func _apply_runtime_hud_truth_button_state(button: Button, available: bool) -> void:
	if button == null or not is_instance_valid(button):
		return

	var can_surface_show: bool = _runtime_floating_hud_buttons_should_render_on_current_surface()
	var should_show: bool = available and can_surface_show

	var zero_frame_shell_locked: bool = false
	if has_method("_zero_frame_switch_surface_lock_active"):
		zero_frame_shell_locked = bool(call("_zero_frame_switch_surface_lock_active"))

	var spawn_shell_locked: bool = bool(get_meta("spawn_ready_runtime_hud_shell_only_active", false))
	var hot_switch_press_active: bool = bool(get_meta("zero_frame_consciousness_switch_press_frame_active", false))

	if zero_frame_shell_locked or spawn_shell_locked or hot_switch_press_active:
		_apply_zero_frame_hud_button_shell(button, should_show)
		return

	button.visible = should_show
	button.disabled = not should_show
	button.mouse_filter = Control.MOUSE_FILTER_STOP if should_show else Control.MOUSE_FILTER_IGNORE
	button.focus_mode = Control.FOCUS_NONE
	button.modulate.a = 1.0

func _refresh_controlled_perspective_runtime_huds(reason: String = "controlled_perspective") -> void:
	if _zero_frame_switch_surface_lock_active():
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["controlled_perspective_switch_pending_ui_refresh"] = false
			gs.scenario_state ["controlled_perspective_last_ui_refresh_reason"] = "%s_blocked_by_zero_frame_switch_surface_lock" % reason
			gs.scenario_state ["controlled_perspective_last_ui_refresh_at_ms"] = int(Time.get_ticks_msec())

		_refresh_locked_zero_frame_switch_surface("%s_blocked_by_zero_frame_switch_surface_lock" % reason)
		return
	if gs == null or gs.player == null:
		set_meta("boxing_hud_next_light_refresh_ms", 0)
		set_meta("superpower_hud_next_light_refresh_ms", 0)
		set_meta("power_hud_next_light_refresh_ms", 0)
		_update_boxing_hud()
		_update_superpower_hud()
		_update_power_hud()
		_sync_runtime_floating_hud_layering()
		return

	current_panel = "life"

	var actor_id: int = int(gs.player.id)
	var is_identity_refresh: bool = (
		reason.find("controlled_perspective") >= 0
		or reason.find("control_switch") >= 0
		or reason.find("relationship_control_switch") >= 0
	)

	if relationship_profile_popup_open or relationships_browser_open:
		_close_relationship_modal_stack_for_control_switch()

	_ensure_belongings_hud()
	_ensure_bending_hud_button_shell()
	_ensure_crown_hud()
	_ensure_food_lifestyle_hud()
	_ensure_rick_weapon_shop_hud()
	_ensure_boxing_hud()
	_ensure_superpower_hud()
	_ensure_power_hud()
	_ensure_wizard_hud()

	if is_identity_refresh:
		belongings_hud_open = false
		remove_meta("__belongings_hud_force_keep_open")
		remove_meta("__belongings_item_popup_sticky_until_closed")
		remove_meta("__belongings_hud_player_toggled_open")
		_set_runtime_floating_hud_forced_open("belongings", false)

		if belongings_hud_panel != null and is_instance_valid(belongings_hud_panel):
			belongings_hud_panel.visible = false

		_hide_belonging_item_popup()
		_hide_artifact_target_popup()

	set_meta("__belongings_hud_actor_id", actor_id)
	_sync_controlled_actor_assets_into_belongings(gs.player, reason)

	if food_lifestyle_hud_button != null and is_instance_valid(food_lifestyle_hud_button):
		food_lifestyle_hud_button.text = " "
	if restaurant_lifestyle_hud_button != null and is_instance_valid(restaurant_lifestyle_hud_button):
		restaurant_lifestyle_hud_button.text = " "
	if boxing_hud_button != null and is_instance_valid(boxing_hud_button):
		boxing_hud_button.text = " "

	var truth: Dictionary = _runtime_hud_truth_for_current_perspective(reason)
	_commit_runtime_hud_truth_snapshot(truth, reason)

	set_meta("spawn_ready_runtime_hud_shell_only_active", false)
	set_meta("runtime_hud_shell_reveal_reason", reason)
	set_meta("bending_hud_next_light_refresh_ms", 0)
	set_meta("__belongings_hud_next_update_ms", 0)
	set_meta("food_lifestyle_hud_next_update_ms", 0)
	set_meta("boxing_hud_next_light_refresh_ms", 0)
	set_meta("superpower_hud_next_light_refresh_ms", 0)
	set_meta("power_hud_next_light_refresh_ms", 0)
	set_meta("crown_hud_summary_cache_dirty", true)

	belongings_hud_content_dirty = true

	_apply_runtime_hud_truth_button_state(belongings_hud_button, bool(truth.get("belongings_available", false)))
	_apply_runtime_hud_truth_button_state(bending_hud_button, bool(truth.get("bending_available", false)))
	_apply_runtime_hud_truth_button_state(crown_hud_button, bool(truth.get("crown_available", false)))
	_apply_runtime_hud_truth_button_state(food_lifestyle_hud_button, bool(truth.get("food_lifestyle_available", false)))
	_apply_runtime_hud_truth_button_state(restaurant_lifestyle_hud_button, bool(truth.get("restaurant_lifestyle_available", false)))
	_apply_runtime_hud_truth_button_state(rick_weapon_shop_hud_button, bool(truth.get("rick_weapon_shop_available", false)))
	_apply_runtime_hud_truth_button_state(boxing_hud_button, bool(truth.get("boxing_available", false)))
	_apply_runtime_hud_truth_button_state(superpower_hud_button, bool(truth.get("superpower_available", false)))
	_apply_runtime_hud_truth_button_state(power_hud_button, bool(truth.get("power_available", false)))
	_apply_runtime_hud_truth_button_state(wizard_hud_button, bool(truth.get("wizard_available", false)))

	_reveal_spawn_ready_runtime_hud_buttons_if_existing(reason)

	_update_belongings_hud()
	_update_bending_hud()
	_update_crown_hud()
	_update_food_lifestyle_hud()
	_update_rick_weapon_shop_hud(false)
	_update_boxing_hud()
	_update_wizard_hud()
	_update_superpower_hud()
	_update_power_hud()

	if superpower_hub_open and superpower_hub_overlay != null and superpower_hub_overlay.visible:
		_precompute_super_runtime_surface_cache_for_state(gs, reason)
		_render_superpower_hub_overlay()

	if power_hub_open and power_hub_overlay != null and power_hub_overlay.visible:
		_precompute_super_runtime_surface_cache_for_state(gs, reason)
		_render_power_hub_overlay()

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["controlled_perspective_switch_pending_ui_refresh"] = false
		gs.scenario_state ["controlled_perspective_last_ui_refresh_reason"] = reason
		gs.scenario_state ["controlled_perspective_last_ui_refresh_at_ms"] = int(Time.get_ticks_msec())

	_sync_runtime_floating_hud_layering()
func _maybe_consume_controlled_perspective_truth_refresh() -> void:
	if gs == null or gs.player == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	var sequence: int = int(gs.scenario_state.get("controlled_perspective_truth_sequence", 0))
	var seen_sequence: int = int(get_meta("controlled_perspective_truth_sequence_seen", 0))
	var seen_actor_id: int = int(get_meta("controlled_perspective_actor_id_seen", -1))
	var current_actor_id: int = int(gs.player.id)
	var pending: bool = bool(gs.scenario_state.get("controlled_perspective_switch_pending_ui_refresh", false))

	if not pending and sequence == seen_sequence and seen_actor_id == current_actor_id:
		return

	set_meta("controlled_perspective_truth_sequence_seen", sequence)
	set_meta("controlled_perspective_actor_id_seen", current_actor_id)

	if _zero_frame_switch_surface_lock_active():
		gs.scenario_state ["controlled_perspective_switch_pending_ui_refresh"] = false
		gs.scenario_state ["controlled_perspective_last_ui_refresh_reason"] = "blocked_by_zero_frame_switch_surface_lock"
		gs.scenario_state ["controlled_perspective_last_ui_refresh_at_ms"] = int(Time.get_ticks_msec())
		_refresh_locked_zero_frame_switch_surface("controlled_perspective_truth_consume_blocked_by_zero_frame_surface_lock")
		return

	_refresh_controlled_perspective_runtime_huds("controlled_perspective_truth_consume")


func _refresh_super_runtime_hud_after_control_switch() -> void:
	if _zero_frame_switch_surface_lock_active():
		_refresh_locked_zero_frame_switch_surface("super_runtime_refresh_blocked_by_zero_frame_switch_surface_lock")
		return

	MainSceneLogic._invalidate_super_runtime_surface_cache(gs, "relationship_control_switch_actor_changed")
	_refresh_controlled_perspective_runtime_huds("relationship_control_switch_actor_changed")
func _super_runtime_surface_cache_signature_for_state(source_gs: GameState) -> String:
	if source_gs == null or source_gs.player == null:
		return ""

	var actor: Person = source_gs.player
	var parts: Array = [
		"schema:eralife.super_runtime_surface_cache",
		"actor:%d" % int(actor.id),
		"year:%d" % int(source_gs.year),
		"age:%d" % int(actor.age),
		"fame:%s" % str(actor.fame),
		"health:%s" % str(actor.health)
	]

	var power_profile: Dictionary = _super_runtime_actor_optional_dictionary(actor, "power_profile")
	if not power_profile.is_empty():
		parts.append("power_profile:%s" % str(power_profile))

	var superhero_profile: Dictionary = _super_runtime_actor_optional_dictionary(actor, "superhero_profile")
	if not superhero_profile.is_empty():
		parts.append("superhero_profile:%s" % str(superhero_profile))

	if source_gs.power_engine != null and source_gs.power_engine.has_method("get_person_power_state"):
		var power_state: Dictionary = _superpower_hub_safe_dictionary(source_gs.power_engine.get_person_power_state(actor))
		parts.append("power_state:%s" % str(power_state))

	if source_gs.superhero_engine != null and source_gs.superhero_engine.has_method("has_superhero_hub_access"):
		parts.append("superhero_access:%s" % str(source_gs.superhero_engine.has_superhero_hub_access(actor)))

	return "|".join(parts)

func _power_hub_payload_from_state(source_gs: GameState, actor: Person, reason: String = "cache") -> Dictionary:
	if source_gs == null or actor == null:
		return {}

	var previous_gs: GameState = gs
	gs = source_gs

	var actor_name: String = MainSceneHelpers._superpower_hub_actor_label(actor)
	var power_state: Dictionary = {}
	var power_rating: int = 0

	if source_gs.power_engine != null and source_gs.power_engine.has_method("get_person_power_state"):
		power_state = _superpower_hub_safe_dictionary(source_gs.power_engine.get_person_power_state(actor))
	if source_gs.power_engine != null and source_gs.power_engine.has_method("get_power_rating"):
		power_rating = int(source_gs.power_engine.get_power_rating(actor))

	var sections: Array = [
		{
			"id": "overview",
			"title": "POWER OVERVIEW",
			"rows": _power_hub_power_rows(actor, power_state)
		},
		{
			"id": "supe_stats",
			"title": "SUPE STATS",
			"rows": _power_hub_supe_stat_rows(actor, power_state, power_rating)
		},
		{
			"id": "subskills",
			"title": "SUBSKILLS",
			"rows": _power_hub_subskill_rows(actor, power_state)
		}
	]

	var mutation_rows: Array = _power_hub_mutation_rows(actor)
	if not mutation_rows.is_empty():
		sections.append({
			"id": "mutations",
			"title": "MUTATIONS",
			"rows": mutation_rows
		})

	sections.append({
		"id": "training",
		"title": "TRAINING",
		"rows": _power_hub_training_rows(actor)
	})

	sections.append({
		"id": "origins",
		"title": "ORIGIN EVENTS",
		"rows": _power_hub_origin_rows(actor)
	})

	var payload: Dictionary = {
		"success": true,
		"schema": "eralife.power_hub_overlay_payload",
		"version": 1,
		"actor_id": int(actor.id),
		"actor_name": actor_name,
		"power_state": power_state.duplicate(true),
		"power_rating": power_rating,
		"default_section_id": "overview",
		"sections": sections,
		"runtime_cache_ready": true,
		"runtime_cache_reason": reason
	}

	gs = previous_gs
	return payload


func _precompute_super_runtime_surface_cache_for_state(source_gs: GameState, reason: String = "prewarm") -> Dictionary:
	if source_gs == null or source_gs.player == null:
		return {}

	if typeof(source_gs.scenario_state) != TYPE_DICTIONARY:
		source_gs.scenario_state = {}

	var actor: Person = source_gs.player
	var signature: String = _super_runtime_surface_cache_signature_for_state(source_gs)
	if signature == "":
		signature = "schema:eralife.super_runtime_surface_cache|actor:%d|year:%d|safe_signature:%s" % [
			int(actor.id),
			int(source_gs.year),
			str(reason)
		]

	var existing_raw: Variant = source_gs.scenario_state.get("super_runtime_surface_cache", {})
	if typeof(existing_raw) == TYPE_DICTIONARY:
		var existing: Dictionary = existing_raw
		if str(existing.get("signature", "")) == signature:
			return existing.duplicate(true)

	var actor_name: String = MainSceneHelpers._superpower_hub_actor_label(actor)
	var payloads: Dictionary = {}

	if source_gs.superhero_engine != null and source_gs.superhero_engine.has_method("build_superhero_hub_payload"):
		var superhero_payload: Dictionary = _superpower_hub_safe_dictionary(source_gs.superhero_engine.build_superhero_hub_payload(actor, {
			"source": "super_runtime_surface_cache",
			"reason": reason,
			"active_actor_id": int(actor.id),
			"active_actor_name": actor_name,
			"packet_contract_required": true,
		}))
		if not superhero_payload.is_empty():
			superhero_payload ["runtime_cache_ready"] = true
			superhero_payload ["runtime_cache_reason"] = reason
			payloads ["superhero"] = superhero_payload.duplicate(true)

	if not payloads.has("superhero"):
		payloads ["superhero"] = _super_runtime_synthesized_superhero_payload(source_gs, actor, "%s_superhero_synthesized" % reason)

	if source_gs.power_engine != null:
		var power_payload: Dictionary = _power_hub_payload_from_state(source_gs, actor, reason)
		if not power_payload.is_empty():
			payloads ["power"] = power_payload.duplicate(true)

	if not payloads.has("power"):
		payloads ["power"] = _power_hub_payload_from_state(source_gs, actor, "%s_power_synthesized" % reason)

	var cache: Dictionary = {
		"schema": "eralife.super_runtime_surface_cache",
		"version": 1,
		"signature": signature,
		"reason": reason,
		"actor_id": int(actor.id),
		"year": int(source_gs.year),
		"created_at_ms": int(Time.get_ticks_msec()),
		"payloads": payloads
	}

	source_gs.scenario_state ["super_runtime_surface_cache"] = cache.duplicate(true)
	return cache

func _super_runtime_surface_cache() -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var signature: String = _super_runtime_surface_cache_signature_for_state(gs)
	var cache_raw: Variant = gs.scenario_state.get("super_runtime_surface_cache", {})
	if typeof(cache_raw) == TYPE_DICTIONARY:
		var cache: Dictionary = cache_raw
		if str(cache.get("signature", "")) == signature:
			return cache.duplicate(true)

	return _precompute_super_runtime_surface_cache_for_state(gs, "live_cache_miss")


func _super_runtime_cached_payload(payload_key: String, fallback: Variant = null) -> Variant:
	var cache: Dictionary = _super_runtime_surface_cache()
	var payloads_raw: Variant = cache.get("payloads", {})
	if typeof(payloads_raw) != TYPE_DICTIONARY:
		return fallback

	var payloads: Dictionary = payloads_raw
	if not payloads.has(payload_key):
		return fallback

	var value: Variant = payloads.get(payload_key)
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(true)
	return value


func _superpower_hub_payload() -> Dictionary:
	if gs == null:
		return {}

	var actor: Person = gs.player
	if actor == null:
		return {}

	var cached_payload: Variant = _super_runtime_cached_payload("superhero", {})
	if typeof(cached_payload) == TYPE_DICTIONARY and not (cached_payload as Dictionary).is_empty():
		return (cached_payload as Dictionary).duplicate(true)

	var actor_name: String = MainSceneHelpers._superpower_hub_actor_label(actor)

	if gs.superhero_engine != null and gs.superhero_engine.has_method("build_superhero_hub_payload"):
		var engine_payload: Dictionary = _superpower_hub_safe_dictionary(gs.superhero_engine.build_superhero_hub_payload(actor, {
			"source": "superpower_hub_overlay_live_fallback",
			"active_actor_id": int(actor.id),
			"active_actor_name": actor_name,
			"packet_contract_required": true,
		}))
		if not engine_payload.is_empty():
			engine_payload ["runtime_cache_ready"] = false
			engine_payload ["runtime_cache_reason"] = "live_fallback"
			return engine_payload

	_super_runtime_queue_deeper_truth_refresh("superhero_payload_synthesized_deeper_truth_refresh")
	return _super_runtime_synthesized_superhero_payload(gs, actor, "empty_fallback_synthesized_safe_packet")
func _superpower_hub_safe_dictionary(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	return {}


func _superpower_hub_safe_array(value: Variant) -> Array:
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(true)
	return []
func _begin_runtime_interaction_quiet_window(reason: String = "ui_interaction", duration_ms: int = 1800) -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var safe_duration: int = max(0, int(duration_ms))
	var until_ms: int = now_ms + safe_duration

	set_meta("runtime_interaction_quiet_until_ms", until_ms)
	set_meta("runtime_interaction_quiet_reason", reason)
	set_meta("runtime_interaction_quiet_started_at_ms", now_ms)
	set_meta("runtime_interaction_quiet_is_input_grace_only", true)
	set_meta("runtime_interaction_quiet_may_block_surface_render", false)

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["runtime_interaction_quiet_until_ms"] = until_ms
		gs.scenario_state ["runtime_interaction_quiet_reason"] = reason
		gs.scenario_state ["runtime_interaction_quiet_started_at_ms"] = now_ms
		gs.scenario_state ["runtime_interaction_quiet_is_input_grace_only"] = true
		gs.scenario_state ["runtime_interaction_quiet_may_block_surface_render"] = false


func _surface_guard_assert_render(surface_id: String, reason: String = "surface_click", lane: String = "ui", ttl_ms: int = 900) -> void:
	var clean_surface: String = str(surface_id).strip_edges().to_lower()
	if clean_surface == "":
		clean_surface = "unknown_surface"

	var clean_reason: String = str(reason).strip_edges()
	if clean_reason == "":
		clean_reason = "surface_click"

	var clean_lane: String = str(lane).strip_edges().to_lower()
	if clean_lane == "":
		clean_lane = "ui"

	var now_ms: int = int(Time.get_ticks_msec())
	var safe_ttl: int = max(80, int(ttl_ms))
	var until_ms: int = now_ms + safe_ttl

	set_meta("contextual_surface_guard_active", true)
	set_meta("contextual_surface_guard_surface_id", clean_surface)
	set_meta("contextual_surface_guard_reason", clean_reason)
	set_meta("contextual_surface_guard_lane", clean_lane)
	set_meta("contextual_surface_guard_started_at_ms", now_ms)
	set_meta("contextual_surface_guard_until_ms", until_ms)

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["contextual_surface_guard_active"] = true
		gs.scenario_state ["contextual_surface_guard_surface_id"] = clean_surface
		gs.scenario_state ["contextual_surface_guard_reason"] = clean_reason
		gs.scenario_state ["contextual_surface_guard_lane"] = clean_lane
		gs.scenario_state ["contextual_surface_guard_started_at_ms"] = now_ms
		gs.scenario_state ["contextual_surface_guard_until_ms"] = until_ms


func _surface_guard_active(surface_id: String = "", now_ms: int = -1) -> bool:
	if now_ms < 0:
		now_ms = int(Time.get_ticks_msec())

	if not bool(get_meta("contextual_surface_guard_active", false)):
		return false

	var until_ms: int = int(get_meta("contextual_surface_guard_until_ms", 0))
	if until_ms > 0 and now_ms > until_ms:
		_surface_guard_release(str(get_meta("contextual_surface_guard_surface_id", "")))
		return false

	var clean_surface: String = str(surface_id).strip_edges().to_lower()
	if clean_surface == "":
		return true

	var active_surface: String = str(get_meta("contextual_surface_guard_surface_id", "")).strip_edges().to_lower()
	return active_surface == clean_surface


func _surface_guard_release(surface_id: String = "") -> void:
	var clean_surface: String = str(surface_id).strip_edges().to_lower()
	var active_surface: String = str(get_meta("contextual_surface_guard_surface_id", "")).strip_edges().to_lower()

	if clean_surface != "" and active_surface != "" and clean_surface != active_surface:
		return

	set_meta("contextual_surface_guard_active", false)
	set_meta("contextual_surface_guard_surface_id", "")
	set_meta("contextual_surface_guard_reason", "")
	set_meta("contextual_surface_guard_lane", "")
	set_meta("contextual_surface_guard_started_at_ms", 0)
	set_meta("contextual_surface_guard_until_ms", 0)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["contextual_surface_guard_active"] = false
		gs.scenario_state ["contextual_surface_guard_surface_id"] = ""
		gs.scenario_state ["contextual_surface_guard_reason"] = ""
		gs.scenario_state ["contextual_surface_guard_lane"] = ""
		gs.scenario_state ["contextual_surface_guard_started_at_ms"] = 0
		gs.scenario_state ["contextual_surface_guard_until_ms"] = 0


func _surface_guard_release_deferred(surface_id: String = "", delay_seconds: float = 0.2) -> void:
	var tree:= get_tree()
	if tree == null:
		call_deferred("_surface_guard_release", surface_id)
		return

	var timer:= tree.create_timer(max(0.01, float(delay_seconds)))
	timer.timeout.connect(
		Callable(self, "_surface_guard_release").bind(surface_id),
		CONNECT_ONE_SHOT
	)

func _runtime_interactive_surface_busy(now_ms: int = -1, context: Dictionary = {}) -> bool:
	if now_ms < 0:
		now_ms = int(Time.get_ticks_msec())

	if MainSceneHelpers._surface_guard_context_allows_render(context):
		return false

	if _surface_guard_active("", now_ms):
		return false

	if _zero_frame_ui_render_enforcement_active(now_ms):
		return true
	if bool(get_meta("god_mode_capsule_entry_handoff_active", false)):
		return true
	if age_up_loading_runtime_active or bool(get_meta("age_up_transition_busy", false)):
		return true

	if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
		return true
	if belongings_item_popup != null and is_instance_valid(belongings_item_popup) and belongings_item_popup.visible:
		return true
	if belongings_item_target_popup != null and is_instance_valid(belongings_item_target_popup) and belongings_item_target_popup.visible:
		return true
	if crown_action_popup != null and is_instance_valid(crown_action_popup) and crown_action_popup.visible:
		return true

	return false
