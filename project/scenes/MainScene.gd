		global_reality_intake_button.anchor_right = 0.0
		global_reality_intake_button.anchor_top = 0.0
		global_reality_intake_button.anchor_bottom = 0.0

		global_reality_intake_button.offset_left = (
			stage_right - 188.0
		)
		global_reality_intake_button.offset_right = (
			stage_right - 24.0
		)
		global_reality_intake_button.offset_top = (
			stage_top + 24.0
		)
		global_reality_intake_button.offset_bottom = (
			stage_top + 68.0
		)

	if (
		global_reality_intake_hide_button != null
		and is_instance_valid(
			global_reality_intake_hide_button
		)
	):
		global_reality_intake_hide_button.anchor_left = 0.0
		global_reality_intake_hide_button.anchor_right = 0.0
		global_reality_intake_hide_button.anchor_top = 0.0
		global_reality_intake_hide_button.anchor_bottom = 0.0

		global_reality_intake_hide_button.offset_left = (
			stage_right - 202.0
		)
		global_reality_intake_hide_button.offset_right = (
			stage_right - 176.0
		)
		global_reality_intake_hide_button.offset_top = (
			stage_top + 16.0
		)
		global_reality_intake_hide_button.offset_bottom = (
			stage_top + 42.0
		)

	if (
		global_reality_intake_tab_button != null
		and is_instance_valid(
			global_reality_intake_tab_button
		)
	):
		global_reality_intake_tab_button.anchor_left = 0.0
		global_reality_intake_tab_button.anchor_right = 0.0
		global_reality_intake_tab_button.anchor_top = 0.0
		global_reality_intake_tab_button.anchor_bottom = 0.0

		global_reality_intake_tab_button.offset_left = (
			stage_right - 48.0
		)
		global_reality_intake_tab_button.offset_right = (
			stage_right - 8.0
		)
		global_reality_intake_tab_button.offset_top = (
			stage_top + 24.0
		)
		global_reality_intake_tab_button.offset_bottom = (
			stage_top + 68.0
		)

	if (
		god_mode_viewer != null
		and is_instance_valid(
			god_mode_viewer
		)
		and god_mode_viewer.has_method(
			"apply_presentation_surface_contract"
		)
	):
		var god_mode_contract_raw: Variant = (
			ui_presentation_composition_contract.get(
				"god_mode_viewer",
				{}
			)
		)

		var god_mode_contract: Dictionary = (
			(god_mode_contract_raw as Dictionary).duplicate(true)
			if typeof(
				god_mode_contract_raw
			) == TYPE_DICTIONARY
			else {}
		)

		if god_mode_contract.is_empty():
			var viewport_size: Vector2 = (
				get_viewport_rect().size
			)

			var panel_width: float = minf(
				1368.0,
				maxf(
					1.0,
					viewport_size.x * 0.95
				)
			)

			var panel_height: float = minf(
				855.0,
				maxf(
					1.0,
					viewport_size.y * 0.95
				)
			)

			var panel_left: float = (
				(viewport_size.x - panel_width)
				* 0.5
			)

			var panel_top: float = (
				(viewport_size.y - panel_height)
				* 0.5
			)

			god_mode_contract = {
				"panel_left": panel_left,
				"panel_top": panel_top,
				"panel_right": panel_left + panel_width,
				"panel_bottom": panel_top + panel_height,
				"panel_width": panel_width,
				"panel_height": panel_height,
				"fallback": true
			}

		god_mode_contract ["source"] = reason

		god_mode_viewer.call(
			"apply_presentation_surface_contract",
			god_mode_contract
		)
