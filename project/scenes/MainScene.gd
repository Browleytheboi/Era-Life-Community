func _queue_bending_hub_resident_ability_card_stream(
	abilities: Array,
	actor_id: int,
	source_signature: String
) -> void:



	var generation: int = int(
		get_meta(
			"bending_hub_resident_ability_stream_generation",
			0
		)
	) + 1

	set_meta(
		"bending_hub_resident_ability_stream_generation",
		generation
	)
	set_meta(
		"bending_hub_resident_ability_stream_scheduled_generation",
		-1
	)



	var previous_deck_raw: Variant = get_meta(
		"bending_hub_resident_ability_deck",
		0
	)
	var previous_deck: Control = null

	if typeof(
		previous_deck_raw
	) == TYPE_INT:
		var previous_object: Object = instance_from_id(
			int(
				previous_deck_raw
			)
		)

		if (
			previous_object != null
			and previous_object is Control
			and is_instance_valid(
				previous_object
			)
		):
			previous_deck = previous_object as Control

	elif (
		previous_deck_raw is Control
		and is_instance_valid(
			previous_deck_raw as Control
		)
	):
		previous_deck = previous_deck_raw as Control

	if (
		previous_deck != null
		and not previous_deck.is_queued_for_deletion()
	):
		previous_deck.visible = false
		previous_deck.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		previous_deck.queue_free()

	if (
		bending_hud_abilities_box == null
		or not is_instance_valid(
			bending_hud_abilities_box
		)
		or bending_hud_abilities_box.is_queued_for_deletion()
	):


		set_meta(
			"bending_hub_resident_ability_rows_pending",
			abilities
		)
		set_meta(
			"bending_hub_resident_ability_rows_pending_actor_id",
			actor_id
		)
		set_meta(
			"bending_hub_resident_ability_rows_pending_signature",
			source_signature
		)
		set_meta(
			"bending_hub_resident_ability_stream_job",
			{}
		)
		set_meta(
			"bending_hub_resident_ability_deck",
			0
		)
		set_meta(
			"bending_hub_resident_ability_stream_host_pending",
			true
		)
		return

	var deck:= VBoxContainer.new()

	deck.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	deck.add_theme_constant_override(
		"separation",
		12
	)
	deck.set_meta(
		"bending_hub_resident_ability_deck_generation",
		generation
	)
	deck.set_meta(
		"bending_hub_resident_ability_deck_actor_id",
		actor_id
	)

	bending_hud_abilities_box.add_child(
		deck
	)

	var header:= MainSceneHelpers._make_bending_hub_section_label(
		"Abilities"
	)

	deck.add_child(
		header
	)

	bending_hud_ability_visual_controls.clear()

	var deck_instance_id: int = int(
		deck.get_instance_id()
	)


	set_meta(
		"bending_hub_resident_ability_deck",
		deck_instance_id
	)

	set_meta(
		"bending_hub_resident_ability_stream_job",
		{
			"generation": generation,
			"actor_id": actor_id,
			"signature": source_signature,
			"rows": abilities,
			"cursor": 0,
			"deck_instance_id": deck_instance_id,
			"last_element": "",
			"started_at_ms": int(
				Time.get_ticks_msec()
			),
			"idle_required": false,
			"observation_required": false,
			"ready_gate_member": false,
		}
	)

	set_meta(
		"bending_hub_resident_ability_stream_host_pending",
		false
	)

	_schedule_bending_hub_resident_ability_card_quantum(
		generation,
		0.01
	)

func _schedule_bending_hub_resident_ability_card_quantum(
	generation: int,
	delay_seconds: float = 0.018
) -> void:
	if generation != int(
		get_meta(
			"bending_hub_resident_ability_stream_generation",
			0
		)
	):
		return

	var scheduled_generation: int = int(
		get_meta(
			"bending_hub_resident_ability_stream_scheduled_generation",
			-1
		)
	)

	if scheduled_generation == generation:
		return

	set_meta(
		"bending_hub_resident_ability_stream_scheduled_generation",
		generation
	)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_bending_hub_resident_ability_card_quantum",
			generation
		)
		return

	var timer:= tree.create_timer(
		maxf(
			0.01,
			delay_seconds
		)
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_bending_hub_resident_ability_card_quantum"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)


func _service_bending_hub_resident_ability_card_quantum(
	generation: int
) -> void:
	if generation != int(
		get_meta(
			"bending_hub_resident_ability_stream_generation",
			0
		)
	):
		return

	set_meta(
		"bending_hub_resident_ability_stream_scheduled_generation",
		-1
	)

	var job_raw: Variant = get_meta(
		"bending_hub_resident_ability_stream_job",
		{}
	)
	var job: Dictionary = (
		job_raw as Dictionary
		if typeof(job_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		job.is_empty()
		or int(
			job.get(
				"generation",
				-1
			)
		) != generation
	):
		return

	var actor: Person = _bending_hub_actor()
	var expected_actor_id: int = int(
		job.get(
			"actor_id",
			-1
		)
	)

	if (
		actor == null
		or int(
			actor.id
		) != expected_actor_id
	):
		var stale_deck_id: int = int(
			job.get(
				"deck_instance_id",
				0
			)
		)
		var stale_object: Object = (
			instance_from_id(
				stale_deck_id
			)
			if stale_deck_id > 0
			else null
		)

		if (
			stale_object != null
			and stale_object is Control
			and is_instance_valid(
				stale_object
			)
		):
			var stale_control: Control = (
				stale_object as Control
			)

			if not stale_control.is_queued_for_deletion():
				stale_control.queue_free()

		set_meta(
			"bending_hub_resident_ability_stream_job",
			{}
		)
		set_meta(
			"bending_hub_resident_ability_stream_aborted_actor_change",
			true
		)
		return

	var rows_raw: Variant = job.get(
		"rows",
		[]
	)
	var rows: Array = (
		rows_raw as Array
		if typeof(rows_raw) == TYPE_ARRAY
		else []
	)
	var cursor: int = int(
		job.get(
			"cursor",
			0
		)
	)

	var deck_instance_id: int = int(
		job.get(
			"deck_instance_id",
			0
		)
	)
	var deck_object: Object = (
		instance_from_id(
			deck_instance_id
		)
		if deck_instance_id > 0
		else null
	)
	var deck: Control = (
		deck_object as Control
		if (
			deck_object != null
			and deck_object is Control
			and is_instance_valid(
				deck_object
			)
		)
		else null
	)

	var host_hot: bool = (
		bending_hud_abilities_box != null
		and is_instance_valid(
			bending_hud_abilities_box
		)
		and not bending_hud_abilities_box.is_queued_for_deletion()
	)

	var deck_hot: bool = (
		deck != null
		and not deck.is_queued_for_deletion()
		and host_hot
		and deck.get_parent()
		== bending_hud_abilities_box
	)

	if not deck_hot:



		set_meta(
			"bending_hub_resident_ability_rows_pending",
			rows
		)
		set_meta(
			"bending_hub_resident_ability_rows_pending_actor_id",
			expected_actor_id
		)
		set_meta(
			"bending_hub_resident_ability_rows_pending_signature",
			str(
				job.get(
					"signature",
					""
				)
			)
		)
		set_meta(
			"bending_hub_resident_ability_rows_pending_cursor",
			cursor
		)
		set_meta(
			"bending_hub_resident_ability_stream_job",
			{}
		)
		set_meta(
			"bending_hub_resident_ability_stream_host_pending",
			true
		)
		return

	if cursor >= rows.size():
		set_meta(
			"bending_hub_resident_ability_stream_job",
			{}
		)
		set_meta(
			"bending_hub_resident_ability_deck_hot_actor_id",
			int(
				actor.id
			)
		)
		set_meta(
			"bending_hub_resident_ability_deck_hot_signature",
			str(
				job.get(
					"signature",
					""
				)
			)
		)
		set_meta(
			"bending_hub_resident_ability_deck_hot_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"bending_hub_resident_ability_stream_host_pending",
			false
		)
		return

	var raw_ability: Variant = rows [
		cursor
	]

	job ["cursor"] = cursor + 1

	if typeof(raw_ability) == TYPE_DICTIONARY:
		var ability: Dictionary = (
			raw_ability as Dictionary
		)

		var actor_is_avatar: bool = (
			str(
				actor.bending_type
			).strip_edges().to_lower()
			== "avatar"
		)
		var element: String = str(
			ability.get(
				"element",
				""
			)
		).strip_edges().to_lower()
		var last_element: String = str(
			job.get(
				"last_element",
				""
			)
		)

		if (
			actor_is_avatar
			and element != ""
			and element != last_element
		):
			var element_header:= (
				MainSceneHelpers._make_bending_hub_section_label(
					"%s Skills"
					% element.capitalize()
				)
			)

			element_header.add_theme_color_override(
				"font_color",
				_bending_hud_element_color(
					element
				)
			)

			deck.add_child(
				element_header
			)

			job ["last_element"] = element


		_add_bending_hub_ability_button(
			ability,
			int(
				actor.age
			),
			deck
		)

	set_meta(
		"bending_hub_resident_ability_stream_job",
		job
	)

	_schedule_bending_hub_resident_ability_card_quantum(
		generation,
		0.018
	)
func _reveal_resident_relationship_hub_section_now(
	section_id: String,
	source: String
) -> bool:
	if (
		gs == null
		or gs.player == null
		or relationship_hub_panel == null
		or not is_instance_valid(
			relationship_hub_panel
		)
		or not relationship_hub_panel.has_surface_shell()
		or not relationship_hub_panel.has_renderable_contract(
			int(
				gs.player.id
			)
		)
	):
		return false

	var clean_section: String = str(
		section_id
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = "partner"

	_hide_relationship_profile_popup()

	current_panel = "relationships"

	relationship_hub_panel.show_surface()
	relationship_hub_panel.visible = true
	relationship_hub_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	relationship_hub_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	relationship_hub_panel.z_as_relative = false
	relationship_hub_panel.z_index = 1200

	var revealed: bool = (
		relationship_hub_panel.reveal_resident_section(
			clean_section
		)
	)

	_bring_modal_to_front(
		relationship_hub_panel
	)

	_claim_interactive_surface_authority(
		relationship_hub_panel,
		"relationship_hub_panel",
		source,
		true,
		true
	)

	_apply_main_tab_press_frame_nav_state(
		"relationships",
		source
	)

	set_meta(
		"relationship_hub_resident_section_revealed",
		revealed
	)
	set_meta(
		"relationship_hub_resident_section_revealed_id",
		clean_section
	)
	set_meta(
		"relationship_hub_resident_section_reveal_builds",
		0
	)
	set_meta(
		"relationship_hub_resident_section_reveal_engine_calls",
		0
	)

	return revealed
func _rebuild_bending_hub_content(force:= false) -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return
	if bending_hud_actions_box == null or bending_hud_skill_points_box == null or bending_hud_abilities_box == null or bending_hud_tournaments_box == null:
		return

	_bending_hub_validate_pending_skill_allocation_actor(actor)

	var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"
	bending_hud_current_section = clean_section

	var section_signatures_raw: Variant = get_meta("bending_hud_section_signatures", {})
	var section_signatures: Dictionary = section_signatures_raw if typeof(section_signatures_raw) == TYPE_DICTIONARY else {}
	if force or bending_hud_last_rebuild_signature == "":
		section_signatures = {}

	var signature: String = _bending_hub_player_signature()
	if not force and str(section_signatures.get(clean_section, "")) == signature:
		bending_hud_last_rebuild_signature = signature
		_sync_bending_hub_section_visibility()
		return

	section_signatures [clean_section] = signature
	set_meta("bending_hud_section_signatures", section_signatures)
	bending_hud_last_rebuild_signature = signature

	var previous_scroll: int = 0
	if bending_hud_scroll != null:
		previous_scroll = int(bending_hud_scroll.scroll_vertical)

	var player_age: int = int(actor.age)
	var best_level: int = int(gs.bending_engine.get_primary_bending_level(actor))

	match clean_section:
		"profile":
			_rebuild_bending_hub_profile_avatar_history(actor)

		"training":
			_clear_container_children(bending_hud_actions_box)

			bending_hud_actions_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Training"))
			var train_locked: bool = player_age < 3
			var training_elements: Array = []
			if gs.bending_engine.has_method("get_bending_training_elements"):
				training_elements = gs.bending_engine.get_bending_training_elements(actor)
			else:
				var fallback_element: String = MainSceneLogic._bending_hub_default_player_element(gs)
				if fallback_element != "":
					training_elements.append(fallback_element)

			for raw_train_element in training_elements:
				var train_element: String = str(raw_train_element).strip_edges().to_lower()
				if train_element == "":
					continue
				var train_btn:= _make_bending_hub_button(
					"Train %s Bending" % train_element.capitalize() if not train_locked else "Train %s Bending — Age 3+" % train_element.capitalize(),
					train_locked
				)
				train_btn.tooltip_text = "Train %s's %s bending directly." % [
					("%s %s" % [actor.first_name, actor.last_name]).strip_edges(),
					train_element.capitalize()
				]
				train_btn.pressed.connect(_on_bending_hub_train_element_pressed.bind(train_element))
				bending_hud_actions_box.add_child(train_btn)

			if gs != null and "bending_dojo_engine" in gs and gs.bending_dojo_engine != null and gs.bending_dojo_engine.has_method("get_dojo_hub_payload"):
				bending_hud_actions_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Dojos"))
				var dojo_payload: Dictionary = gs.bending_dojo_engine.get_dojo_hub_payload(actor, {
					"source": "bending_hub_training_section"
				})
				var dojos: Array = dojo_payload.get("dojos", [])
				var membership: Dictionary = dojo_payload.get("actor_membership", {})
				var accepted_dojo: Dictionary = dojo_payload.get("accepted_dojo", {})
				if not membership.is_empty() and not accepted_dojo.is_empty():
					var open_dojo_btn:= _make_bending_hub_button("Open Dojo Hub • %s" % str(accepted_dojo.get("name", "Bending Dojo")), false)
					open_dojo_btn.tooltip_text = "Open your dojo hub, view your sensei, classmates, rankings, and training options."
					open_dojo_btn.pressed.connect(_on_bending_hub_open_dojo_hub_pressed.bind(str(accepted_dojo.get("id", ""))))
					bending_hud_actions_box.add_child(open_dojo_btn)
				else:
					var dojo_intro:= Label.new()
					dojo_intro.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
					dojo_intro.text = "Apply to a dojo. If you qualify, they accept you into the room instead of handing you a generic training button."
					bending_hud_actions_box.add_child(dojo_intro)
					if dojos.is_empty():
						var no_dojo_label:= Label.new()
						no_dojo_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
						no_dojo_label.text = "No compatible dojos are available for your age, element, or region yet."
						bending_hud_actions_box.add_child(no_dojo_label)
					else:
						for raw_dojo in dojos:
							if typeof(raw_dojo) != TYPE_DICTIONARY:
								continue
							var dojo: Dictionary = raw_dojo
							var gate: Dictionary = dojo.get("entry_gate", {}) if typeof(dojo.get("entry_gate", {})) == TYPE_DICTIONARY else {}
							var _allowed: bool = bool(gate.get("allowed", false))
							var already_member: bool = bool(dojo.get("accepted", false))
							var label_text: String = "Current Dojo • %s" % str(dojo.get("name", "Bending Dojo")) if already_member else "Apply to %s" % str(dojo.get("name", "Bending Dojo"))
							var dojo_btn:= _make_bending_hub_button(label_text, already_member)
							dojo_btn.tooltip_text = "%s dojo • %s tier • %s" % [
								str(dojo.get("element", "bending")).capitalize(),
								str(dojo.get("tier", "local")).capitalize(),
								str(gate.get("reason_text", "Application available."))
							]
							if not already_member:
								dojo_btn.disabled = false
								dojo_btn.pressed.connect(_on_bending_hub_apply_dojo_pressed.bind(str(dojo.get("id", ""))))
							bending_hud_actions_box.add_child(dojo_btn)

			var spirit_actor_is_avatar: bool = str(actor.bending_type).strip_edges().to_lower() == "avatar"
			var spirit_locked: bool = not spirit_actor_is_avatar or player_age < 6
			var spirit_btn:= _make_bending_hub_button(
				"Go to the Spirit World" if not spirit_locked else "Go to the Spirit World — Avatar / Age 6+",
				spirit_locked
			)
			spirit_btn.tooltip_text = "Enter the Spirit World, meet a previous Avatar, duel them spiritually, and gain Avatar knowledge."
			spirit_btn.pressed.connect(_on_bending_hub_go_to_spirit_world_pressed)
			bending_hud_actions_box.add_child(spirit_btn)

			var awakening_elements: Array = []
			if gs.bending_engine.has_method("get_bending_awakening_options"):
				awakening_elements = gs.bending_engine.get_bending_awakening_options(actor)
			for raw_awaken_element in awakening_elements:
				var awaken_element: String = str(raw_awaken_element).strip_edges().to_lower()
				if awaken_element == "":
					continue
				var awaken_btn:= _make_bending_hub_button(
					"Try To Awaken %s On Your Own" % awaken_element.capitalize() if not train_locked else "Try To Awaken %s — Age 3+" % awaken_element.capitalize(),
					train_locked
				)
				awaken_btn.tooltip_text = "Attempt to awaken %s bending through solo effort." % awaken_element.capitalize()
				awaken_btn.pressed.connect(_on_bending_hub_awaken_element_pressed.bind(awaken_element))
				bending_hud_actions_box.add_child(awaken_btn)

			var master_locked: bool = player_age < 16 or best_level < 18
			var master_btn:= _make_bending_hub_button(
				"Find A Master" if not master_locked else "Find A Master — Age 16+ / Level 18+",
				master_locked
			)
			master_btn.tooltip_text = "You need to be at least 16 and have enough foundation for a master to teach you."
			master_btn.pressed.connect(_on_bending_hub_find_master_pressed)
			bending_hud_actions_box.add_child(master_btn)

			var duel_locked: bool = player_age < 10
			var duel_btn:= _make_bending_hub_button(
				"Seek A Bending Duel" if not duel_locked else "Seek A Bending Duel — Age 10+",
				duel_locked
			)
			duel_btn.tooltip_text = "You can seek bending duels at age 10."
			duel_btn.pressed.connect(_on_bending_hub_seek_duel_pressed)
			bending_hud_actions_box.add_child(duel_btn)

			bending_hud_avatar_state_button = Button.new()
			bending_hud_avatar_state_button.text = "Activate Avatar State"
			bending_hud_avatar_state_button.visible = false
			bending_hud_avatar_state_button.custom_minimum_size = Vector2(0, 48)
			bending_hud_avatar_state_button.pressed.connect(_on_bending_hud_avatar_state_pressed)
			bending_hud_actions_box.add_child(bending_hud_avatar_state_button)

		"skill_points":
			_clear_container_children(bending_hud_skill_points_box)
			bending_hud_skill_points_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Skill Point Allocation"))
			_add_bending_hub_pending_skill_allocation_controls(actor)
			if gs.bending_engine.has_method("get_bending_skill_allocation_rows"):
				var allocation_rows: Array = gs.bending_engine.get_bending_skill_allocation_rows(actor)
				for raw_row in allocation_rows:
					if typeof(raw_row) != TYPE_DICTIONARY:
						continue
					_add_bending_hub_skill_point_row(raw_row)
			else:
				bending_hud_skill_points_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Skill point runtime unavailable."))

		"abilities":
			_clear_container_children(bending_hud_abilities_box)
			bending_hud_ability_visual_controls.clear()
			bending_hud_abilities_box.add_child(MainSceneHelpers._make_bending_hub_section_label("Abilities"))
			var abilities: Array = gs.bending_engine.get_available_bending_abilities(actor)
			if abilities.is_empty():
				var empty_label:= MainSceneHelpers._make_bending_hub_section_label("No bending abilities are available yet.")
				empty_label.tooltip_text = "Train your bending, awaken an element, or complete a bending goal to reveal techniques."
				bending_hud_abilities_box.add_child(empty_label)
			else:
				var is_avatar: bool = str(actor.bending_type).strip_edges().to_lower() == "avatar"
				if is_avatar:
					for element in ["air", "water", "earth", "fire"]:
						var element_abilities: Array = []
						for raw_ability in abilities:
							if typeof(raw_ability) != TYPE_DICTIONARY:
								continue
							var ability: Dictionary = raw_ability
							if str(ability.get("element", "")).strip_edges().to_lower() == element:
								element_abilities.append(ability)
						if element_abilities.is_empty():
							continue
						var element_header:= MainSceneHelpers._make_bending_hub_section_label("%s Abilities" % element.capitalize())
						element_header.add_theme_color_override("font_color", _bending_hud_element_color(element))
						bending_hud_abilities_box.add_child(element_header)
						for ability in element_abilities:
							_add_bending_hub_ability_button(ability, player_age)
				else:
					for raw_ability in abilities:
						if typeof(raw_ability) != TYPE_DICTIONARY:
							continue
						_add_bending_hub_ability_button(raw_ability, player_age)

		"tournaments":
			_rebuild_bending_hub_tournament_content()

	_sync_bending_hub_section_visibility()
	if bending_hud_scroll != null:
		bending_hud_scroll.set_deferred("scroll_vertical", previous_scroll)
func _on_bending_hub_go_to_spirit_world_pressed() -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null:
		return

	# DIAGNOSTIC: this action freezes the game and none of the three steps below
	# contains a loop, so the cost is inside one of them. Each step reports before
	# and after with elapsed time -- whichever "begin" line has no matching "end" is
	# the one that hangs.
	var step_started_ms: int = int(Time.get_ticks_msec())
	EraLog.truth("ERALIFE_SPIRIT_WORLD|step=queue_begin")

	var result: Dictionary = _queue_bending_hub_spirit_world_scenario(actor)

	EraLog.truth(
		"ERALIFE_SPIRIT_WORLD|step=queue_end|elapsed_ms=%d|result_keys=%d"
		% [
			int(Time.get_ticks_msec()) - step_started_ms,
			result.size()
		]
	)

	step_started_ms = int(Time.get_ticks_msec())
	EraLog.truth("ERALIFE_SPIRIT_WORLD|step=scenario_ui_begin")

	# FIX: this action returns two completely different shapes. On success it returns a
	# SCENARIO (type/text/panel_title/opps) which scenario_panel.present() renders
	# properly. On rejection -- most commonly "Only the Avatar can enter this path" for
	# a non-Avatar bender -- it returns a POPUP shape (popup_title/popup_text/
	# popup_footer) with no scenario content and no choices. Feeding that to
	# present() put a full-screen MOUSE_FILTER_STOP dim over the game with nothing
	# clickable behind it, which is the "frozen game": every step completes in 20ms
	# and then input is dead. Rejections go to the popup path, which has a working
	# dismiss.
	if not bool(result.get("success", true)):
		EraLog.truth(
			"ERALIFE_SPIRIT_WORLD|step=rejected|reason=%s"
			% str(result.get("popup_title", "unknown"))
		)
		_maybe_show_action_result_popup(result)
		return

	_refresh_scenario_ui_from_result(result)

	EraLog.truth(
		"ERALIFE_SPIRIT_WORLD|step=scenario_ui_end|elapsed_ms=%d"
		% [int(Time.get_ticks_msec()) - step_started_ms]
	)

	step_started_ms = int(Time.get_ticks_msec())
	EraLog.truth("ERALIFE_SPIRIT_WORLD|step=hud_rebuild_begin")

	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()

	# FIX: the remote scene tree identified the input blocker as bending_hud_panel --
	# 1368x856 at (22,22) with MOUSE_FILTER_STOP, covering the whole screen. When the
	# Spirit World scenario presents, that panel stays up and swallows every click,
	# which is the "frozen game": all three steps finish in 20ms and then nothing
	# responds.
	#
	# The hide must happen HERE, after _update_bending_hud(), not before the scenario
	# is presented: the rebuild sets bending_hud_panel.visible = true again, so hiding
	# it earlier was silently undone. That is why an earlier attempt appeared to do
	# nothing at all.
	if (
		scenario_panel != null
		and is_instance_valid(scenario_panel)
		and scenario_panel.visible
	):
		# Two separate nodes conspired here, which is why every single-node fix only
		# half-worked:
		#
		#   bending_hud_panel            1368x856, MOUSE_FILTER_STOP -> ate the clicks
		#   bending_hud_legendary_vignette  full-rect tint at 0.56 alpha -> hid the
		#                                   scenario panel visually
		#
		# The vignette is MOUSE_FILTER_IGNORE so it never blocked input; it simply
		# painted over the Spirit World while the panel underneath swallowed every
		# click. _update_bending_hud() re-shows BOTH whenever bending_hud_open is
		# true, so both hides must happen after the rebuild, not before.
		if bending_hud_panel != null and is_instance_valid(bending_hud_panel):
			bending_hud_panel.visible = false

		if (
			bending_hud_legendary_vignette != null
			and is_instance_valid(bending_hud_legendary_vignette)
		):
			bending_hud_legendary_vignette.visible = false

		EraLog.truth("ERALIFE_SPIRIT_WORLD|step=bending_hub_and_vignette_hidden_for_scenario")

	EraLog.truth(
		"ERALIFE_SPIRIT_WORLD|step=hud_rebuild_end|elapsed_ms=%d"
		% [int(Time.get_ticks_msec()) - step_started_ms]
	)
func _queue_bending_hub_spirit_world_scenario(actor: Person) -> Dictionary:
	if gs == null or actor == null:
		return {}

	if str(actor.bending_type).strip_edges().to_lower() != "avatar":
		return {
			"success": false,
			"popup_title": "Spirit World Locked",
			"popup_text": "Only the Avatar can enter this path.",
			"popup_footer": "Tap anywhere to continue."
		}

	if gs.scenario_engine == null or not gs.scenario_engine.has_method("queue_external_scenario"):
		return {
			"success": false,
			"popup_title": "Scenario Runtime Missing",
			"popup_text": "ScenarioEngine.queue_external_scenario() is unavailable.",
			"popup_footer": "Tap anywhere to continue."
		}

	if not gs.scenario_engine.has_method("_resolve_spirit_world_choice"):
		return {
			"success": false,
			"popup_title": "Scenario Runtime Missing",
			"popup_text": "ScenarioEngine._resolve_spirit_world_choice() is unavailable.",
			"popup_footer": "Tap anywhere to continue."
		}

	var spirit_world_scenario: Dictionary = {
		"id": "spirit_world_%d_%d_%d" % [int(actor.id), int(gs.year), int(Time.get_ticks_msec())],
		"source": "scenario_engine",
		"resolver_owner": "scenario_engine",
		"category": "bending",
		"cooldown_key": "spirit_world_visit",
		"resolver_method": "_resolve_spirit_world_choice",
		"panel_title": "THE SPIRIT WORLD",
		"footer_text": "The Avatar Cycle breathes through the veil.",
		"prompt": "The world falls away one sound at a time.\n\nAir circles your shoulders like a living memory.\nWater reflects faces you have never met.\nEarth hums beneath your feet with the weight of every lifetime before yours.\nFire burns in the distance without smoke, without hunger, without end.\n\nThe path ahead is not a hallway. It is a current.\n\nBeyond it, the previous Avatars wait — not as statues, but as choices.\n\nWhat do you seek?",
		"actor_id": int(actor.id),
		"spirit_world": true,
		"combat_ui": MainSceneLogic._spirit_world_avatar_path_combat_ui(gs, actor, {
			"status_text": "Spirit World • The veil opens",
			"phase": "threshold",
			"active_element": "avatar"
		}),
		"choices": [
			{
				"id": "spirit_world_ask_knowledge",
				"label": "Ask for knowledge",
				"journal_text": "I entered the Spirit World and asked the previous Avatars for knowledge.",
				"choice_family": "knowledge",
				"button_theme": "artifact_action",
				"power_source": "spirit_world"
			},
			{
				"id": "spirit_world_meditate",
				"label": "Meditate",
				"journal_text": "I meditated in the Spirit World.",
				"choice_family": "meditation",
				"button_theme": "defensive_escape",
				"power_source": "spirit_world"
			},
			{
				"id": "spirit_world_duel",
				"label": "Choose a previous Avatar to duel",
				"journal_text": "I asked the previous Avatars to test me in a spiritual duel.",
				"choice_family": "duel",
				"button_theme": "bending_ability",
				"power_source": "spirit_world"
			},
			{
				"id": "spirit_world_leave",
				"label": "Leave the Spirit World",
				"journal_text": "I left the Spirit World before asking for anything.",
				"choice_family": "leave",
				"button_theme": "defensive_escape",
				"power_source": "survival"
			}
		]
	}

	var queued_result: Variant = gs.scenario_engine.call("queue_external_scenario", spirit_world_scenario)
	if typeof(queued_result) == TYPE_DICTIONARY:
		return queued_result

	return {
		"success": false,
		"popup_title": "Scenario Runtime Missing",
		"popup_text": "ScenarioEngine.queue_external_scenario() did not return a Dictionary.",
		"popup_footer": "Tap anywhere to continue."
	}
func _resolve_spirit_world_choice(actor: Person, _scenario: Dictionary, choice: Dictionary, _committed: Dictionary) -> Dictionary:
	if gs == null or actor == null:
		return {}

	var choice_family: String = str(choice.get("choice_family", "")).strip_edges().to_lower()

	match choice_family:
		"leave":
			return {
				"type": "scenario_commit_complete",
				"text": "I left the Spirit World before asking for anything.",
				"popup_title": "Spirit World",
				"popup_text": "You let the vision close.\n\nThe four elements fade back into the ordinary world.",
				"popup_footer": "Tap anywhere to continue.",
				"opps": []
			}

		"knowledge":
			if gs.avatar_influence_engine != null and gs.avatar_influence_engine.has_method("go_to_spirit_world"):
				var knowledge_result: Dictionary = gs.avatar_influence_engine.go_to_spirit_world(actor, {
					"source": "spirit_world_scenario",
					"mode": "knowledge"
				})
				return {
					"type": "scenario_commit_complete",
					"text": str(knowledge_result.get("diary_text", "I asked the Spirit World for knowledge.")),
					"popup_title": str(knowledge_result.get("popup_title", "Spirit World Knowledge")),
					"popup_text": str(knowledge_result.get("popup_text", "The previous Avatars answered in fragments.")),
					"popup_footer": "Tap anywhere to continue.",
					"opps": []
				}

			return {
				"type": "scenario_commit_complete",
				"text": "I asked the Spirit World for knowledge, but no Avatar Influence Engine answered.",
				"popup_title": "Spirit World Knowledge",
				"popup_text": "The veil shimmered, but the previous Avatars could not speak clearly yet.",
				"popup_footer": "Tap anywhere to continue.",
				"opps": []
			}

		"meditation":
			actor.mental_health = clamp(int(actor.mental_health) + 6, 0, 100)
			actor.satisfaction = clamp(int(actor.satisfaction) + 4, 0, 100)

			if gs != null and "willpower_engine" in gs and gs.willpower_engine != null and gs.willpower_engine.has_method("ensure_willpower"):
				gs.willpower_engine.ensure_willpower(actor, {
					"source": "spirit_world_meditation",
					"duel_scope": "bending"
				})

			var meditation_text: String = "I meditated in the Spirit World. The silence sharpened me, and the four elements felt closer than before."
			if gs.narrative_engine != null:
				gs.narrative_engine.log_event(actor, {
					"type": "text",
					"text": meditation_text,
					"life_diary_text": meditation_text,
					"source": "scenario_engine",
					"category": "bending",
					"event_name": "spirit_world_meditation",
					"memory_type": "spiritual",
					"emotion_tags": ["clarity", "discipline", "spirituality"]
				})

			return {
				"type": "scenario_commit_complete",
				"text": meditation_text,
				"popup_title": "Spirit World Meditation",
				"popup_text": "You sat between air, water, earth, and fire.\n\nYour mind steadied.\n\nMental Health increased.\nHappiness increased.\nWillpower settled deeper into your body.",
				"popup_footer": "Tap anywhere to continue.",
				"opps": []
			}

		"duel":
			return _queue_spirit_world_avatar_duel_selection(actor)

		"duel_avatar":
			var payload: Dictionary = _spirit_world_safe_dictionary(choice.get("payload", {}))
			var avatar_record: Dictionary = _spirit_world_safe_dictionary(payload.get("avatar_record", {}))
			return MainSceneLogic._begin_spirit_world_avatar_duel(gs, actor, avatar_record)

	return {
		"type": "scenario_commit_complete",
		"text": "The Spirit World choice dissolved before it could resolve.",
		"popup_title": "Spirit World",
		"popup_text": "The vision closed unexpectedly.",
		"popup_footer": "Tap anywhere to continue.",
		"opps": []
	}
func _queue_spirit_world_avatar_duel_selection(actor: Person) -> Dictionary:
	var previous_avatars: Array = MainSceneLogic._spirit_world_previous_avatar_records(gs, actor)
	if previous_avatars.is_empty():
		return {
			"type": "scenario_commit_complete",
			"text": "I asked the previous Avatars for a duel, but no echo answered.",
			"popup_title": "Spirit World Duel",
			"popup_text": "The veil opened, but no previous Avatar stepped forward.",
			"popup_footer": "Tap anywhere to continue.",
			"opps": []
		}

	var choices: Array = []
	var max_choices: int = min(previous_avatars.size(), 8)

	for i in range(max_choices):
		if typeof(previous_avatars [i]) != TYPE_DICTIONARY:
			continue

		var avatar_record: Dictionary = previous_avatars [i]
		var avatar_name: String = str(avatar_record.get("name", "Previous Avatar"))
		var avatar_element: String = str(avatar_record.get("native_element", "avatar")).strip_edges().to_lower()
		var spirit_score: int = int(avatar_record.get("spirit_score", 70))

		choices.append({
			"id": "spirit_world_duel_avatar_%d" % i,
			"label": "Duel %s • %s Echo" % [
				avatar_name,
				avatar_element.capitalize()
			],
			"journal_text": "I chose to duel %s in the Spirit World." % avatar_name,
			"choice_family": "duel_avatar",
			"button_theme": "bending_ability",
			"power_source": "spirit_world",
			"ability_element": avatar_element,
			"payload": {
				"avatar_index": i,
				"avatar_record": avatar_record.duplicate(true),
				"spirit_score": spirit_score
			}
		})

	choices.append({
		"id": "spirit_world_duel_back",
		"label": "Step back from the duel",
		"journal_text": "I stepped back before choosing a previous Avatar to duel.",
		"choice_family": "leave",
		"button_theme": "defensive_escape",
		"power_source": "survival"
	})

	var selection_scenario: Dictionary = {
		"id": "spirit_world_duel_selection_%d_%d" % [int(actor.id), int(Time.get_ticks_msec())],
		"source": "scenario_engine",
		"resolver_owner": "scenario_engine",
		"category": "bending",
		"resolver_method": "_resolve_spirit_world_choice",
		"panel_title": "CHOOSE A PREVIOUS AVATAR",
		"footer_text": "The Avatar Cycle waits for your choice.",
		"prompt": "The Spirit World opens wider.\n\nThe mist does not reveal one opponent.\nIt reveals a lineage.\n\nSome Avatars feel calm as moonlit water.\nSome feel like mountains holding back centuries.\nSome burn at the edge of your vision.\nSome move like air through a locked door.\n\nWho do you ask to test you?",
		"actor_id": int(actor.id),
		"spirit_world": true,
		"combat_ui": MainSceneLogic._spirit_world_avatar_path_combat_ui(gs, actor, {
			"status_text": "Spirit World • Choose your echo",
			"phase": "avatar_duel_selection",
			"active_element": "avatar"
		}),
		"choices": choices
	}

	return MainSceneLogic._spirit_world_queue_external_scenario(gs, selection_scenario)
func _spirit_world_safe_dictionary(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	return {}
