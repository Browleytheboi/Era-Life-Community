func _build_god_mode_panel_style(is_hovered: bool, breath_strength: float = 0.0) -> StyleBoxFlat:
	var palette:= _current_god_mode_palette()
	var profile:= god_mode_presentation_profile
	if profile.is_empty():
		profile = _build_god_mode_presentation_profile()

	var breathing: Dictionary = _build_god_mode_breathing_profile()
	var style:= StyleBoxFlat.new()

	var bg_color: Color = Color(
		palette.get(
			"panel_hover",
			Color(0.2, 0.12, 0.3, 0.97)
		) if is_hovered else palette.get(
			"panel_base",
			Color(0.17, 0.1, 0.27, 0.95)
		)
	)
	var border_color: Color = Color(
		palette.get(
			"border_hover",
			Color(0.92, 0.86, 1.0, 0.55)
		) if is_hovered else palette.get(
			"border",
			Color(0.82, 0.75, 0.98, 0.34)
		)
	)
	var shadow_color: Color = Color(
		palette.get(
			"shadow_hover",
			Color(0.42, 0.22, 0.7, 0.3)
		) if is_hovered else palette.get(
			"shadow",
			Color(0.26, 0.12, 0.48, 0.22)
		)
	)

	if breath_strength > 0.0:
		var accent: Color = Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
		bg_color = bg_color.lerp(
			Color(1.0, 1.0, 1.0, bg_color.a),
			clamp(float(breathing.get("panel_breath_highlight_mix", 0.06)) * breath_strength, 0.0, 1.0)
		)
		border_color = border_color.lerp(
			accent.lightened(0.12),
			clamp(float(breathing.get("panel_breath_border_mix", 0.18)) * breath_strength, 0.0, 1.0)
		)
		shadow_color = shadow_color.lerp(
			accent,
			clamp(0.14 + (0.12 * breath_strength), 0.0, 1.0)
		)
		shadow_color = Color(
			shadow_color.r,
			shadow_color.g,
			shadow_color.b,
			clamp(shadow_color.a + (0.12 * breath_strength), 0.0, 1.0)
		)

	style.bg_color = bg_color
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.border_color = border_color

	var corner_radius:= int(profile.get("panel_corner_radius", 22))
	style.corner_radius_top_left = corner_radius
	style.corner_radius_top_right = corner_radius
	style.corner_radius_bottom_right = corner_radius
	style.corner_radius_bottom_left = corner_radius

	var panel_margin:= int(profile.get("panel_margin", 18))
	style.content_margin_left = panel_margin
	style.content_margin_top = panel_margin
	style.content_margin_right = panel_margin
	style.content_margin_bottom = panel_margin

	var base_shadow_size: float = float(
		profile.get(
			"panel_shadow_size_hover",
			36.0 if is_hovered else 24.0
		)
	) if is_hovered else float(profile.get("panel_shadow_size_idle", 24.0))
	var base_shadow_y: float = float(
		profile.get(
			"panel_shadow_y_hover",
			8.0
		)
	) if is_hovered else float(profile.get("panel_shadow_y_idle", 4.0))

	style.shadow_color = shadow_color
	style.shadow_size = int(round(
		base_shadow_size + (float(breathing.get("panel_breath_shadow_boost", 8.0)) * breath_strength)
	))
	style.shadow_offset = Vector2(
		0.0,
		base_shadow_y + (0.8 * breath_strength)
	)
	return style
func _build_god_mode_panel_glow_style(is_hovered: bool, breath_strength: float = 0.0) -> StyleBoxFlat:
	var palette:= _current_god_mode_palette()
	var profile:= god_mode_presentation_profile
	if profile.is_empty():
		profile = _build_god_mode_presentation_profile()

	var accent: Color = Color(palette.get("accent", Color(0.24, 0.86, 1.0, 1.0)))
	var border_source: Color = Color(palette.get("border_hover", accent) if is_hovered else palette.get("border", accent))
	var shadow_source: Color = Color(palette.get("shadow_hover", accent) if is_hovered else palette.get("shadow", accent))

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.0, 0.0, 0.0, 0.0)
	style.border_width_left = 4 if is_hovered else 3
	style.border_width_top = 4 if is_hovered else 3
	style.border_width_right = 4 if is_hovered else 3
	style.border_width_bottom = 4 if is_hovered else 3
	style.border_color = Color(
		border_source.r,
		border_source.g,
		border_source.b,
		clamp((0.82 if is_hovered else 0.66) + (0.1 * breath_strength), 0.0, 1.0)
	)

	var corner_radius:= int(profile.get("panel_corner_radius", 22)) + 6
	style.corner_radius_top_left = corner_radius
	style.corner_radius_top_right = corner_radius
	style.corner_radius_bottom_right = corner_radius
	style.corner_radius_bottom_left = corner_radius

	style.shadow_color = Color(
		shadow_source.r,
		shadow_source.g,
		shadow_source.b,
		clamp((0.58 if is_hovered else 0.42) + (0.18 * breath_strength), 0.0, 1.0)
	)
	style.shadow_size = int(round((54.0 if is_hovered else 42.0) + (16.0 * breath_strength)))
	style.shadow_offset = Vector2.ZERO
	return style


func _apply_god_mode_panel_visual_state(is_hovered: bool) -> void:
	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return

	god_mode_start_panel.set_meta("god_mode_panel_hovered", is_hovered)
	god_mode_panel_normal_style = _build_god_mode_panel_style(false)
	god_mode_panel_hover_style = _build_god_mode_panel_style(true)
	god_mode_start_panel.add_theme_stylebox_override(
		"panel",
		god_mode_panel_hover_style if is_hovered else god_mode_panel_normal_style
	)

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = god_mode_start_panel.visible
		god_mode_panel_glow_shell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_panel_glow_shell.z_as_relative = false
		god_mode_panel_glow_shell.z_index = max(0, int(god_mode_start_panel.z_index) - 1)
		god_mode_panel_glow_shell.add_theme_stylebox_override(
			"panel",
			_build_god_mode_panel_glow_style(is_hovered, 0.0)
		)

	var tween: Tween = null
	if god_mode_start_panel.has_meta("god_mode_hover_tween"):
		var existing_tween = god_mode_start_panel.get_meta("god_mode_hover_tween")
		if existing_tween is Tween:
			tween = existing_tween
	if tween != null:
		tween.kill()

	var palette:= _current_god_mode_palette()
	var target_scale: Vector2 = Vector2(1.01, 1.01) if is_hovered else Vector2.ONE
	var target_modulate: Color = palette.get("panel_modulate_hover", Color(1.0, 1.0, 1.0, 1.0)) if is_hovered else palette.get("panel_modulate_idle", Color(0.98, 0.98, 1.0, 1.0))

	tween = create_tween()
	god_mode_start_panel.set_meta("god_mode_hover_tween", tween)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(god_mode_start_panel, "scale", target_scale, 0.16)
	tween.parallel().tween_property(god_mode_start_panel, "self_modulate", target_modulate, 0.16)

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		tween.parallel().tween_property(god_mode_panel_glow_shell, "scale", target_scale, 0.16)
		tween.parallel().tween_property(god_mode_panel_glow_shell, "self_modulate", target_modulate, 0.16)

func _apply_god_mode_panel_breathing_visual() -> void:
	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return

	var hovered: bool = bool(god_mode_start_panel.get_meta("god_mode_panel_hovered", false))
	var breath_strength: float = 0.5 + (0.5 * sin(god_mode_presentation_panel_breath_phase))

	god_mode_start_panel.add_theme_stylebox_override(
		"panel",
		_build_god_mode_panel_style(hovered, breath_strength)
	)

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = god_mode_start_panel.visible
		god_mode_panel_glow_shell.add_theme_stylebox_override(
			"panel",
			_build_god_mode_panel_glow_style(hovered, breath_strength)
		)
func _on_god_mode_panel_mouse_entered() -> void:
	_apply_god_mode_panel_visual_state(true)


func _on_god_mode_panel_mouse_exited() -> void:
	_apply_god_mode_panel_visual_state(false)
