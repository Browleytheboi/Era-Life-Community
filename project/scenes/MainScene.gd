func _start_choose_adventure_entry_button_motion(button: Button, _accent: Color, role: String) -> void:
	if button == null or not is_instance_valid(button):
		return
	var tween:= create_tween().bind_node(button)
	tween.set_loops()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_IN_OUT)
	if role == "narrative_alive" or role == "choose_adventure":
		tween.tween_property(button, "scale", Vector2(1.045, 1.045), 0.72)
		tween.parallel().tween_property(button, "modulate", Color(1.0, 0.92, 1.0, 1.0), 0.72)
		tween.tween_property(button, "scale", Vector2.ONE, 0.72)
		tween.parallel().tween_property(button, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.72)
	else:
		tween.tween_property(button, "scale", Vector2(1.025, 1.025), 1.25)
		tween.parallel().tween_property(button, "modulate", Color(0.88, 1.0, 1.0, 1.0), 1.25)
		tween.tween_property(button, "scale", Vector2.ONE, 1.25)
		tween.parallel().tween_property(button, "modulate", Color(1.0, 1.0, 1.0, 1.0), 1.25)
	choose_adventure_entry_tweens.append(tween)

func _start_choose_adventure_entry_card_motion(card: PanelContainer, delay: float = 0.0) -> void:
	if card == null or not is_instance_valid(card):
		return

	var tween:= create_tween().bind_node(card)
	tween.set_loops()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_IN_OUT)

	if delay > 0.0:
		tween.tween_interval(delay)

	tween.tween_property(card, "position:y", card.position.y - 8.0, 1.4)
	tween.tween_property(card, "position:y", card.position.y + 8.0, 1.4)

	choose_adventure_entry_tweens.append(tween)


func _clear_choose_adventure_entry_tweens() -> void:
	for raw_tween in choose_adventure_entry_tweens:
		if raw_tween != null and raw_tween is Tween:
			var tween: Tween = raw_tween
			if tween.is_valid():
				tween.kill()
	choose_adventure_entry_tweens.clear()


func _restart_choose_adventure_entry_panel_motion() -> void:
	_clear_choose_adventure_entry_tweens()

	var cards: Array = [
		choose_adventure_entry_left_card,
		choose_adventure_entry_middle_card,
		choose_adventure_entry_right_card
	]

	for i in range(cards.size()):
		var card:= cards [i] as PanelContainer
		if card == null or not is_instance_valid(card):
			continue

		card.position.y = 0.0
		card.scale = Vector2.ONE
		card.modulate = Color(1.0, 1.0, 1.0, 1.0)
		_start_choose_adventure_entry_card_motion(card, float(i) * 0.24)

		var button:= card.get_meta("entry_button", null) as Button
		if button != null and is_instance_valid(button):
			button.scale = Vector2.ONE
			button.modulate = Color(1.0, 1.0, 1.0, 1.0)
			var role: String = str(button.get_meta("entry_role", "")).strip_edges().to_lower()
			var accent: Color = Color(button.get_meta("entry_accent", Color(0.24, 0.86, 1.0)))
			_start_choose_adventure_entry_button_motion(button, accent, role)

func _choose_adventure_surface_is_visibly_blocking_playable_entry() -> bool:
	if current_panel == "choose_adventure_entry":
		return true

	if choose_adventure_entry_overlay != null \
and is_instance_valid(choose_adventure_entry_overlay) \
and choose_adventure_entry_overlay.visible:
		return true

	if choose_adventure_scenario_panel != null \
and is_instance_valid(choose_adventure_scenario_panel) \
and choose_adventure_scenario_panel.visible:
		return true

	if output_label != null and is_instance_valid(output_label):
		var output_text: String = str(output_label.text).strip_edges().to_lower()
		if output_text.find("choose sandbox mode") != -1:
			return true
		if output_text.find("choose sandbox mode options to start") != -1:
			return true
		if output_text.find("choose sandbox") != -1:
			return true

	return false


func _hard_kill_choose_adventure_surface_for_playable_entry(reason: String = "playable_entry") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("choose_adventure_surface_hard_killed_for_playable_entry", true)
	set_meta("choose_adventure_surface_hard_killed_reason", reason)
	set_meta("choose_adventure_surface_hard_killed_at_ms", now_ms)
	set_meta("main_menu_surface_active", false)
	set_meta("main_menu_surface_terminated_for_playable_entry", true)
	set_meta("main_menu_surface_terminated_reason", reason)
	set_meta("main_menu_surface_terminated_at_ms", now_ms)

	_clear_choose_adventure_entry_tweens()

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		var doorway_cover:= choose_adventure_entry_overlay.get_node_or_null("__ChooseErealityDoorwayCover") as Control
		if doorway_cover != null and is_instance_valid(doorway_cover):
			doorway_cover.visible = false
			doorway_cover.mouse_filter = Control.MOUSE_FILTER_IGNORE
			doorway_cover.process_mode = Node.PROCESS_MODE_DISABLED

		choose_adventure_entry_overlay.visible = false
		choose_adventure_entry_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
		choose_adventure_entry_overlay.process_mode = Node.PROCESS_MODE_DISABLED
		choose_adventure_entry_overlay.z_index = -4096

	if choose_adventure_entry_dim != null and is_instance_valid(choose_adventure_entry_dim):
		choose_adventure_entry_dim.visible = false
		choose_adventure_entry_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if choose_adventure_scenario_panel != null and is_instance_valid(choose_adventure_scenario_panel):
		if choose_adventure_scenario_panel.has_method("hide_panel"):
			choose_adventure_scenario_panel.hide_panel()
		choose_adventure_scenario_panel.visible = false
		choose_adventure_scenario_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		choose_adventure_scenario_panel.process_mode = Node.PROCESS_MODE_DISABLED
		choose_adventure_scenario_panel.z_index = -4096

	var root:= get_node_or_null("UIContainer") as Control
	if root != null and is_instance_valid(root):
		root.visible = true
		root.mouse_filter = Control.MOUSE_FILTER_PASS
		root.process_mode = Node.PROCESS_MODE_INHERIT

	if output_label != null and is_instance_valid(output_label):
		var output_text: String = str(output_label.text).strip_edges().to_lower()
		if output_text.find("choose sandbox mode") != -1 \
or output_text.find("choose sandbox mode options to start") != -1 \
or output_text.find("choose sandbox") != -1 \
or output_text.find("choose adventure") != -1:
			output_label.clear()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_menu_surface_active"] = false
		gs.scenario_state ["choose_adventure_surface_hard_killed_for_playable_entry"] = true
		gs.scenario_state ["choose_adventure_surface_hard_killed_reason"] = reason
		gs.scenario_state ["choose_adventure_surface_hard_killed_at_ms"] = now_ms
		gs.scenario_state ["choose_sandbox_panel_must_not_render_over_playable_shell"] = true
		gs.scenario_state ["menu_killer_may_not_build_gameplay_ui"] = true
func _hide_choose_adventure_entry_panel(destroy: bool = false) -> void:
	_clear_choose_adventure_entry_tweens()

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		var doorway_cover:= choose_adventure_entry_overlay.get_node_or_null("__ChooseErealityDoorwayCover") as Control
		if doorway_cover != null and is_instance_valid(doorway_cover):
			doorway_cover.visible = false
			doorway_cover.mouse_filter = Control.MOUSE_FILTER_IGNORE

		if destroy:
			choose_adventure_entry_overlay.queue_free()
			choose_adventure_entry_overlay = null
			choose_adventure_entry_dim = null
			choose_adventure_entry_shell = null
			choose_adventure_entry_left_card = null
			choose_adventure_entry_middle_card = null
			choose_adventure_entry_right_card = null
		else:
			choose_adventure_entry_overlay.visible = false
			choose_adventure_entry_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	set_meta("main_menu_surface_active", false)
	set_meta("main_menu_surface_hidden_reason", "hide_choose_adventure_entry_panel")
	set_meta("main_menu_surface_hidden_at_ms", int(Time.get_ticks_msec()))

func _prepare_startup_prelife_reality_candidate() -> void:
	if gs == null:
		return

	if _surface_guard_active("choose_adventure_entry") or _surface_guard_active("god_mode_entry") or _surface_guard_active("household_creator"):
		call_deferred("_prepare_startup_prelife_reality_candidate")
		return

	if get_tree() != null:
		await get_tree().process_frame
		await get_tree().process_frame

	if gs == null:
		return

	if _surface_guard_active("choose_adventure_entry") or _surface_guard_active("god_mode_entry") or _surface_guard_active("household_creator"):
		call_deferred("_prepare_startup_prelife_reality_candidate")
		return

	set_meta("god_mode_reality_candidate", {})
	set_meta("god_mode_reality_shape_touched", false)
	set_meta("god_mode_panel_ui_prewarm_allowed", false)

	var settings: Dictionary = _build_default_custom_settings()
	if typeof(gs.custom_settings) == TYPE_DICTIONARY:
		for raw_key in gs.custom_settings.keys():
			var key: String = str(raw_key)
			if key in ["_prebirth_reality_candidate", "_prebirth_reality_candidate_id", "world_seed", "seed_contract", "soul_seed_contract", "soul_seed_distribution_report"]:
				continue
			settings [key] = gs.custom_settings.get(raw_key)

	settings.erase("_prebirth_reality_candidate")
	settings.erase("_prebirth_reality_candidate_id")
	settings.erase("world_seed")
	settings.erase("seed_contract")
	settings.erase("soul_seed_contract")
	settings.erase("soul_seed_distribution_report")
	settings ["_god_mode_entry_kind"] = str(settings.get("_god_mode_entry_kind", "custom"))

	gs.custom_mode = true
	gs.custom_settings = settings.duplicate(true)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}
	gs.scenario_state ["startup_intro_shell_only"] = true
	gs.scenario_state ["materialize_world_seed_on_initialize"] = false
	gs.scenario_state ["soul_seed_distribution_authorized"] = false
	gs.scenario_state ["soul_seed_distribution_reason"] = "blocked_until_manual_god_mode_prewarm"

func _ensure_god_mode_reality_candidate(
	settings: Dictionary,
	reason: String = "god_mode"
) -> Dictionary:
	var entry_kind: String = (
		MainSceneHelpers._god_mode_reality_candidate_entry_kind(
			settings
		)
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_reason: String = str(
		reason
	).strip_edges().to_lower()
	var fresh_seed_commit_requested: bool = clean_reason in [
		"prewarming_button_pressed",
		"god_mode_viewer_prewarm_button_pressed",
		"viewer_prewarming_requested",
		"residency_button_pressed",
		"prewarm_button_pressed",
		"legacy_main_scene_prewarm_button_shim",
		"manual_prewarm"
	]

	var seed_transaction_sequence: int = int(
		get_meta(
			"god_mode_world_seed_transaction_sequence",
			0
		)
	)
	var seed_transaction_id: String = str(
		settings.get(
			"_prewarm_transaction_id",
			""
		)
	).strip_edges()

	if fresh_seed_commit_requested:
		seed_transaction_sequence += 1
		seed_transaction_id = "prewarm_%d_%d_%d" % [
			int(
				Time.get_unix_time_from_system()
			),
			int(
				Time.get_ticks_usec()
			),
			seed_transaction_sequence
		]

		set_meta(
			"god_mode_world_seed_transaction_sequence",
			seed_transaction_sequence
		)
		set_meta(
			"god_mode_world_seed_transaction_id",
			seed_transaction_id
		)
		set_meta(
			"god_mode_world_seed_transaction_started_at_ms",
			now_ms
		)




		settings.erase(
			"_prebirth_reality_candidate"
		)
		settings.erase(
			"_prebirth_reality_candidate_id"
		)
		settings.erase(
			"world_seed"
		)
		settings.erase(
			"seed_contract"
		)
		settings ["_prewarm_transaction_id"] = (
			seed_transaction_id
		)

	var existing: Dictionary = {}

	if not fresh_seed_commit_requested:
		var embedded_raw: Variant = settings.get(
			"_prebirth_reality_candidate",
			{}
		)

		if typeof(embedded_raw) == TYPE_DICTIONARY:
			existing = (
				embedded_raw as Dictionary
			).duplicate(true)

		if existing.is_empty():
			var existing_raw: Variant = get_meta(
				"god_mode_reality_candidate",
				{}
			)

			if typeof(existing_raw) == TYPE_DICTIONARY:
				existing = (
					existing_raw as Dictionary
				).duplicate(true)

	var seed_contract_raw: Variant = settings.get(
		"seed_contract",
		{}
	)
	var seed_contract: Dictionary = (
		(seed_contract_raw as Dictionary).duplicate(true)
		if typeof(seed_contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var requested_seed: int = int(
		settings.get(
			"world_seed",
			seed_contract.get(
				"seed",
				-1
			)
		)
	)

	if fresh_seed_commit_requested:
		requested_seed = -1

	if not existing.is_empty():
		var existing_seed: int = int(
			existing.get(
				"world_seed",
				existing.get(
					"seed",
					-1
				)
			)
		)

		if existing_seed <= 0 and requested_seed > 0:
			existing_seed = requested_seed

		if existing_seed > 0:
			var existing_candidate_id: String = str(
				existing.get(
					"candidate_id",
					""
				)
			).strip_edges()

			if existing_candidate_id == "":
				existing_candidate_id = "prebirth_%s_%d" % [
					entry_kind,
					existing_seed
				]

			var non_mutating_reason: bool = clean_reason in [
				"ready_check",
				"preview_refresh",
				"start_button_state",
				"entry_panel_prewarm",
				"begin_god_mode_life_missing_final_prewarm"
			]

			existing ["schema"] = str(
				existing.get(
					"schema",
					"eralife.god_mode_prebirth_reality_candidate"
				)
			)
			existing ["version"] = maxi(
				1,
				int(
					existing.get(
						"version",
						1
					)
				)
			)
			existing ["candidate_id"] = existing_candidate_id
			existing ["entry_kind"] = entry_kind
			existing ["world_seed"] = existing_seed
			existing ["revision"] = (
				int(
					existing.get(
						"revision",
						1
					)
				)
				if non_mutating_reason
				else int(
					existing.get(
						"revision",
						0
					)
				) + 1
			)
			existing ["last_reason"] = reason
			existing ["last_updated_at_ms"] = now_ms
			existing ["live_reshaping"] = true
			existing ["single_target_reality"] = true
			existing [
				"hydrate_player_before_surrounding_world"
			] = true
			existing ["canonical_seed_lock"] = true

			if int(
				existing.get(
					"created_at_ms",
					0
				)
			) <= 0:
				existing ["created_at_ms"] = now_ms

			if str(
				existing.get(
					"created_reason",
					""
				)
			).strip_edges() == "":
				existing ["created_reason"] = reason

			set_meta(
				"god_mode_reality_candidate",
				existing.duplicate(true)
			)
			settings [
				"_prebirth_reality_candidate"
			] = existing.duplicate(true)
			settings [
				"_prebirth_reality_candidate_id"
			] = existing_candidate_id
			settings ["world_seed"] = existing_seed

			var existing_transaction_id: String = str(
				existing.get(
					"transaction_id",
					seed_transaction_id
				)
			).strip_edges()

			if existing_transaction_id != "":
				settings ["_prewarm_transaction_id"] = (
					existing_transaction_id
				)

			return existing

	var first_name: String = str(
		settings.get(
			"first_name",
			"Acrello"
		)
	).strip_edges()
	var last_name: String = str(
		settings.get(
			"last_name",
			"IsBack"
		)
	).strip_edges()
	var gender: String = str(
		settings.get(
			"gender",
			""
		)
	).strip_edges()
	var era_key: String = str(
		settings.get(
			"era",
			""
		)
	).strip_edges()
	var country: String = str(
		settings.get(
			"country",
			""
		)
	).strip_edges()
	var city: String = str(
		settings.get(
			"city",
			""
		)
	).strip_edges()
	var reality_mode: String = str(
		settings.get(
			"reality_mode",
			"realistic"
		)
	).strip_edges().to_lower()
	var bending_type: String = str(
		settings.get(
			"bending_type",
			"none"
		)
	).strip_edges().to_lower()
	var world_seed: int = requested_seed

	if world_seed <= 0:
		var seed_source: String = ""

		if fresh_seed_commit_requested:
			seed_source = (
				"%s|%s|%s|%s|%d|%d|%d|%s|%s|%s|%s|%s|%s|%d"
				% [
					entry_kind,
					first_name,
					last_name,
					gender,
					int(
						settings.get(
							"year",
							2000
						)
					),
					int(
						settings.get(
							"month",
							1
						)
					),
					int(
						settings.get(
							"day",
							1
						)
					),
					era_key,
					country,
					city,
					reality_mode,
					bending_type,
					seed_transaction_id,
					seed_transaction_sequence
				]
			)
		else:
			seed_source = (
				"%s|%s|%s|%s|%d|%d|%d|%s|%s|%s|%s|%s"
				% [
					entry_kind,
					first_name,
					last_name,
					gender,
					int(
						settings.get(
							"year",
							2000
						)
					),
					int(
						settings.get(
							"month",
							1
						)
					),
					int(
						settings.get(
							"day",
							1
						)
					),
					era_key,
					country,
					city,
					reality_mode,
					bending_type
				]
			)

		world_seed = abs(
			int(
				hash(
					seed_source
				)
			)
		)
		world_seed = int(
			world_seed % 2147483646
		) + 1

	if world_seed <= 0:
		world_seed = 1

	var candidate_id: String = "prebirth_%s_%d" % [
		entry_kind,
		world_seed
	]

	if seed_transaction_id != "":
		candidate_id = "prebirth_%s_%d_%d" % [
			entry_kind,
			seed_transaction_sequence,
			world_seed
		]

	var candidate: Dictionary = {
		"schema": (
			"eralife.god_mode_prebirth_reality_candidate"
		),
		"version": 2,
		"candidate_id": candidate_id,
		"entry_kind": entry_kind,
		"world_seed": world_seed,
		"revision": 1,
		"created_reason": reason,
		"last_reason": reason,
		"created_at_ms": now_ms,
		"last_updated_at_ms": now_ms,
		"live_reshaping": true,
		"single_target_reality": true,
		"hydrate_player_before_surrounding_world": true,
		"canonical_seed_lock": true,
		"fresh_seed_commit": fresh_seed_commit_requested,
		"transaction_id": seed_transaction_id,
		"transaction_sequence": seed_transaction_sequence
	}

	set_meta(
		"god_mode_reality_candidate",
		candidate.duplicate(true)
	)
	settings [
		"_prebirth_reality_candidate"
	] = candidate.duplicate(true)
	settings [
		"_prebirth_reality_candidate_id"
	] = candidate_id
	settings ["world_seed"] = world_seed

	if seed_transaction_id != "":
		settings ["_prewarm_transaction_id"] = (
			seed_transaction_id
		)

	return candidate
func _mark_god_mode_reality_shape_changed(reason: String = "god_mode_change") -> void:
	set_meta("god_mode_reality_shape_touched", true)
	set_meta("god_mode_reality_shape_touch_reason", reason)
	set_meta("god_mode_reality_shape_touched_at_ms", int(Time.get_ticks_msec()))

	var clean_reason: String = str(reason).strip_edges().to_lower()
	if _god_mode_entry_default_palette_should_clear_for_reason(clean_reason):
		set_meta("god_mode_entry_default_palette_active", false)
		set_meta("god_mode_entry_default_palette_pending_confirmation", false)
		set_meta("god_mode_entry_default_palette_clear_reason", reason)
		set_meta("god_mode_entry_default_palette_cleared_at_ms", int(Time.get_ticks_msec()))

		if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
			god_mode_start_panel.set_meta("god_mode_entry_default_palette_active", false)
			god_mode_start_panel.set_meta("god_mode_entry_default_palette_pending_confirmation", false)
			god_mode_start_panel.set_meta("god_mode_entry_default_palette_clear_reason", reason)
			god_mode_start_panel.set_meta("god_mode_entry_default_palette_cleared_at_ms", int(Time.get_ticks_msec()))

	if clean_reason in ["start_pressed", "prewarm_button_pressed", "begin_god_mode_life"]:
		return

	remove_meta("god_mode_reality_candidate")
	remove_meta("god_mode_life_prewarmed_gs")
	remove_meta("god_mode_life_prewarm_contract")
	remove_meta("god_mode_life_prewarm_queued_settings")
	remove_meta("god_mode_life_prewarm_queued_signature")
	remove_meta("god_mode_life_prewarm_running_signature")
	set_meta("god_mode_life_prewarm_pending", false)
	set_meta("god_mode_life_prewarm_running", false)
	set_meta("god_mode_life_prewarm_ready", false)
	set_meta("god_mode_life_prewarm_signature", "")
	set_meta("god_mode_life_prewarm_reset_reason", reason)

	_set_god_mode_prewarm_progress(
		0.0,
		"Reality shape changed. Pre warm the world seed when this loadout is final.",
		false
	)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		call_deferred("_refresh_god_mode_start_button_state")

func _begin_god_mode_seed_crafting_session(reason: String = "god_mode_opened") -> void:
	_global_runtime_kill_enter_main_menu_runtime(reason, {
		"simulation_work_forbidden": true
	})

	set_meta("god_mode_seed_crafting_started", true)
	set_meta("god_mode_reality_shape_touched", true)
	set_meta("god_mode_reality_shape_touch_reason", reason)
	set_meta("god_mode_reality_shape_touched_at_ms", int(Time.get_ticks_msec()))

	if gs == null:
		_bootstrap_gs_for_save_load_if_needed()

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state ["god_mode_seed_crafting_started"] = true
		gs.scenario_state ["god_mode_seed_crafting_reason"] = reason
		gs.scenario_state ["god_mode_seed_crafting_started_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["materialize_world_seed_on_initialize"] = false
		gs.scenario_state ["god_mode_candidate_seed_only"] = true
		gs.scenario_state ["god_mode_candidate_single_target_reality"] = true
		gs.scenario_state ["god_mode_candidate_hydrate_player_before_world"] = true
		gs.custom_mode = true
func _god_mode_reality_candidate_authorized(
	reason: String = "god_mode_change"
) -> bool:
	var clean_reason: String = str(
		reason
	).strip_edges().to_lower()

	if clean_reason in [
		"prewarming_button_pressed",
		"god_mode_viewer_prewarm_button_pressed",
		"viewer_prewarming_requested",
		"residency_button_pressed",
		"prewarm_button_pressed",
		"legacy_main_scene_prewarm_button_shim",
		"manual_prewarm",
		"manual_start",
		"start_pressed",
		"random_life_pressed",
		"load_pressed",
		"begin_god_mode_life"
	]:
		return true

	var manual_prewarm_authorized: bool = bool(
		get_meta(
			"god_mode_manual_world_seed_prewarm_authorized",
			false
		)
	)
	var prewarm_ready: bool = bool(
		get_meta(
			"god_mode_life_prewarm_ready",
			false
		)
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		manual_prewarm_authorized = (
			manual_prewarm_authorized
			or bool(
				gs.scenario_state.get(
					"god_mode_manual_world_seed_prewarm_authorized",
					false
				)
			)
		)
		prewarm_ready = (
			prewarm_ready
			or bool(
				gs.scenario_state.get(
					"god_mode_life_prewarm_ready",
					false
				)
			)
		)

	if clean_reason in [
		"ready_check",
		"begin_god_mode_life_missing_final_prewarm"
	]:
		return (
			manual_prewarm_authorized
			or prewarm_ready
		)

	return false
func _apply_god_mode_reality_candidate_to_settings(settings: Dictionary, reason: String = "god_mode") -> Dictionary:
	var out: Dictionary = settings.duplicate(true)

	if not _god_mode_reality_candidate_authorized(reason):
		out.erase("_prebirth_reality_candidate")
		out.erase("_prebirth_reality_candidate_id")
		out.erase("world_seed")
		out.erase("seed_contract")
		return out

	var clean_reason: String = str(
		reason
	).strip_edges().to_lower()



	var read_only_candidate_lookup: bool = clean_reason in [
		"ready_check",
		"preview_refresh",
		"start_button_state",
		"entry_panel_prewarm",
		"begin_god_mode_life_missing_final_prewarm"
	]
	var may_materialize_candidate: bool = (
		not read_only_candidate_lookup
	)

	var embedded_raw: Variant = out.get(
		"_prebirth_reality_candidate",
		{}
	)
	var has_embedded_candidate: bool = (
		typeof(embedded_raw) == TYPE_DICTIONARY
		and not (
			embedded_raw as Dictionary
		).is_empty()
	)

	var existing_raw: Variant = get_meta(
		"god_mode_reality_candidate",
		{}
	)
	var has_existing_candidate: bool = (
		typeof(existing_raw) == TYPE_DICTIONARY
		and not (
			existing_raw as Dictionary
		).is_empty()
	)

	var seed_contract_raw: Variant = out.get(
		"seed_contract",
		{}
	)
	var seed_contract_from_settings: Dictionary = (
		seed_contract_raw.duplicate(true)
		if typeof(seed_contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var requested_seed: int = int(
		out.get(
			"world_seed",
			seed_contract_from_settings.get(
				"seed",
				-1
			)
		)
	)

	if (
		not may_materialize_candidate
		and not has_embedded_candidate
		and not has_existing_candidate
		and requested_seed <= 0
	):
		out.erase("_prebirth_reality_candidate")
		out.erase("_prebirth_reality_candidate_id")
		out.erase("world_seed")
		out.erase("seed_contract")
		return out

	var candidate: Dictionary = (
		_ensure_god_mode_reality_candidate(
			out,
			reason
		)
	)
	var candidate_seed: int = int(
		candidate.get(
			"world_seed",
			candidate.get(
				"seed",
				-1
			)
		)
	)



	if candidate.is_empty() or candidate_seed <= 0:
		out.erase("_prebirth_reality_candidate")
		out.erase("_prebirth_reality_candidate_id")
		out.erase("world_seed")
		out.erase("seed_contract")
		return out

	candidate ["world_seed"] = candidate_seed

	var seed_contract: Dictionary = (
		MainSceneHelpers._god_mode_seed_contract_from_candidate(
			candidate
		)
	)

	seed_contract ["seed"] = candidate_seed
	seed_contract ["candidate_id"] = str(
		candidate.get(
			"candidate_id",
			""
		)
	)
	seed_contract ["single_target_reality"] = true

	out ["_prebirth_reality_candidate"] = candidate.duplicate(true)
	out ["_prebirth_reality_candidate_id"] = str(
		candidate.get(
			"candidate_id",
			""
		)
	)
	out ["world_seed"] = candidate_seed
	out ["seed_contract"] = seed_contract.duplicate(true)

	return out
func _set_god_mode_prewarm_progress(
	progress: float,
	status_text: String = "",
	is_ready: bool = false
) -> void:
	var clamped_progress: float = clamp(
		progress,
		0.0,
		1.0
	)
	var progress_percent: int = int(
		round(
			clamped_progress * 100.0
		)
	)
	var clean_status_text: String = str(
		status_text
	).replace(
		"\n",
		" "
	).replace(
		"|",
		"/"
	).strip_edges()
	var render_signature: String = (
		"%d|%s|%s"
		% [
			progress_percent,
			str(is_ready),
			clean_status_text
		]
	)
	var previous_render_signature: String = str(
		get_meta(
			"god_mode_prewarm_progress_truth_signature",
			""
		)
	)

	if render_signature != previous_render_signature:
		EraLog.truth(
			(
				"ERALIFE_PREWARM_BAR"
				+ "|percent=%d"
				+ "|ready=%s"
				+ "|status=%s"
				+ "|frame=%d"
				+ "|at_ms=%d"
			)
			% [
				progress_percent,
				str(is_ready),
				clean_status_text,
				int(
					Engine.get_process_frames()
				),
				int(
					Time.get_ticks_msec()
				)
			]
		)

		set_meta(
			"god_mode_prewarm_progress_truth_signature",
			render_signature
		)

	if (
		god_mode_prewarm_progress_tween != null
		and god_mode_prewarm_progress_tween.is_valid()
	):
		god_mode_prewarm_progress_tween.kill()

	god_mode_prewarm_progress_tween = null

	if (
		god_mode_prewarm_progress_bar != null
		and is_instance_valid(
			god_mode_prewarm_progress_bar
		)
	):
		god_mode_prewarm_progress_bar.value = (
			clamped_progress
		)

	if (
		god_mode_prewarm_status_label != null
		and is_instance_valid(
			god_mode_prewarm_status_label
		)
	):
		if clean_status_text != "":
			god_mode_prewarm_status_label.text = (
				clean_status_text
			)

	if (
		god_mode_prewarm_button != null
		and is_instance_valid(
			god_mode_prewarm_button
		)
	):
		if is_ready:
			god_mode_prewarm_button.text = (
				"World seed prewarmed"
			)
			god_mode_prewarm_button.tooltip_text = (
				"The canonical world seed is ready. "
				+ "Use the main \"I'm ready to play "
				+ "EraLife\" button below to enter."
			)
		elif clamped_progress > 0.0:
			god_mode_prewarm_button.text = (
				"Prewarming your reality..."
			)
			god_mode_prewarm_button.tooltip_text = (
				"Your curated God Mode loadout is "
				+ "being converted into one playable "
				+ "reality capsule."
			)
		else:
			god_mode_prewarm_button.text = (
				"Pre warm world seed"
			)
			god_mode_prewarm_button.tooltip_text = (
				"Commit the current God Mode loadout, "
				+ "create one canonical world seed, and "
				+ "prewarm the playable birth capsule."
			)

	if (
		household_creator_prewarm_progress_bar != null
		and is_instance_valid(
			household_creator_prewarm_progress_bar
		)
	):
		household_creator_prewarm_progress_bar.value = (
			clamped_progress
		)

	if (
		household_creator_status_label != null
		and is_instance_valid(
			household_creator_status_label
		)
	):
		if clean_status_text != "":
			household_creator_status_label.text = (
				clean_status_text
			)

	set_meta(
		"god_mode_prewarm_progress_render_only",
		true
	)
	set_meta(
		"god_mode_prewarm_progress_no_tween_churn",
		true
	)
	set_meta(
		"god_mode_prewarm_progress_percent",
		progress_percent
	)
	set_meta(
