func _install_life_diary_touchpad_scroll_contract(reason: String = "life_diary_scroll") -> void:
	if output_label == null:
		return
	if not is_instance_valid(output_label):
		return

	output_label.mouse_filter = Control.MOUSE_FILTER_PASS
	output_label.scroll_active = true
	output_label.bbcode_enabled = true
	output_label.set_meta("life_diary_touchpad_scroll_contract", true)
	output_label.set_meta("life_diary_touchpad_scroll_reason", reason)
	output_label.set_meta("life_diary_scrollbar_click_required", false)
	output_label.set_meta("life_diary_touchpad_scroll_installed_at_ms", int(Time.get_ticks_msec()))

	var scroll_callable: Callable = Callable(self, "_on_life_diary_rich_text_gui_input")
	if not output_label.gui_input.is_connected(scroll_callable):
		output_label.gui_input.connect(scroll_callable)


func _on_life_diary_rich_text_gui_input(event: InputEvent) -> void:
	if output_label == null:
		return
	if not is_instance_valid(output_label):
		return

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if not mouse_event.pressed:
			return

		match mouse_event.button_index:
			MOUSE_BUTTON_WHEEL_UP:
				_life_diary_scroll_by(- _life_diary_scroll_step())
				get_viewport().set_input_as_handled()
			MOUSE_BUTTON_WHEEL_DOWN:
				_life_diary_scroll_by(_life_diary_scroll_step())
				get_viewport().set_input_as_handled()
			_:
				return

	if event is InputEventPanGesture:
		var pan_event:= event as InputEventPanGesture
		_life_diary_scroll_by(pan_event.delta.y * 42.0)
		get_viewport().set_input_as_handled()

	if event is InputEventScreenDrag:
		var drag_event:= event as InputEventScreenDrag
		_life_diary_scroll_by(- drag_event.relative.y)
		get_viewport().set_input_as_handled()


func _life_diary_scroll_step() -> float:
	if output_label == null:
		return 42.0
	if not is_instance_valid(output_label):
		return 42.0

	var vbar:= output_label.get_v_scroll_bar()
	if vbar == null:
		return 42.0

	return max(42.0, float(vbar.page) * 0.18)


func _life_diary_scroll_by(
	amount: float
) -> void:
	if output_label == null:
		return

	if not is_instance_valid(
		output_label
	):
		return

	var vbar:= output_label.get_v_scroll_bar()

	if vbar == null:
		return



	set_meta(
		"life_diary_focus_latest_year_pending",
		false
	)
	set_meta(
		"life_diary_focus_latest_year_attempts",
		0
	)
	set_meta(
		"life_diary_latest_visible_focus_line_valid",
		false
	)
	set_meta(
		"life_diary_focus_cancelled_by_manual_scroll",
		true
	)
	set_meta(
		"life_diary_focus_cancelled_by_manual_scroll_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	vbar.value = clamp(
		float(vbar.value) + amount,
		float(vbar.min_value),
		float(vbar.max_value)
	)

	output_label.set_meta(
		"life_diary_touchpad_scroll_used",
		true
	)
	output_label.set_meta(
		"life_diary_touchpad_scroll_last_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _relationship_profile_commit_switch_tail_contract(target_id: int, viewer_packet: Dictionary, source: String = "relationship_profile_switch_tail") -> void:
	if gs == null:
		return

	if target_id <= 0:
		return

	if typeof(viewer_packet) != TYPE_DICTIONARY or viewer_packet.is_empty():
		return

	MainSceneLogic._ensure_universal_switch_contract_engine(gs)
	if gs.universal_switch_contract_engine == null:
		return

	if not gs.universal_switch_contract_engine.has_method("commit_zero_frame_viewer_pointer_only"):
		return

	var target: Person = _relationship_profile_resolve_target_for_ui(target_id, true)
	if target == null:
		return

	var report: Dictionary = gs.universal_switch_contract_engine.commit_zero_frame_viewer_pointer_only(target, viewer_packet.duplicate(true), {
		"source": "%s_tail_contract" % source,
		"surface": "full_relationship_profile_popup",
		"relationship_profile_target_id": target_id,
		"relationship_profile_return_context": relationship_profile_return_context,
		"zero_frame": true,
		"press_frame_commit": false,
		"blank_frame_forbidden": true,
		"stat_reset_flicker_forbidden": true,
		"hud_mismatch_forbidden": true,
		"layout_rebuild_forbidden": true,
		"loading_forbidden": true,
		"playable_life_viewer_packet_required": true
	})

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["relationship_profile_switch_tail_contract_committed"] = bool(report.get("success", false))
		gs.scenario_state ["relationship_profile_switch_tail_contract_target_id"] = target_id
		gs.scenario_state ["relationship_profile_switch_tail_contract_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["relationship_profile_switch_tail_contract_report"] = report.duplicate(true)

func _relationship_profile_commit_switch_tail_contract_from_store(target_id: int, source: String = "relationship_profile_switch_tail") -> void:
	if gs == null:
		return

	if target_id <= 0:
		return

	var target: Person = _relationship_profile_resolve_target_for_ui(target_id, true)
	if target == null:
		return

	var shell: Dictionary = _relationship_profile_prewarmed_playable_life_shell_for_actor(target)
	if shell.is_empty():
		return

	var viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(shell.get("playable_life_viewer_render_packet", shell.get("viewer_render_packet", {})))
	if viewer_packet.is_empty():
		return

	_relationship_profile_commit_switch_tail_contract(target_id, viewer_packet.duplicate(true), source)
func _schedule_relationship_profile_switch_tail_after_visible_lens(
	target_id: int,
	previous_controlled_person_id: int,
	result: Dictionary,
	source: String = "relationship_profile_switch_tail"
) -> void:
	var main_tab_pointer_swapped: bool = false

	if _resident_main_tab_renderer_deck_is_hot(
		target_id
	):
		main_tab_pointer_swapped = (
			_activate_resident_main_tab_renderer_deck_for_actor(
				target_id,
				"%s_zero_frame_renderer_pointer_swap"
				% source
			)
		)

	var background_receipt: Dictionary = {
		"success": bool(
			result.get(
				"success",
				true
			)
		),
		"type": str(
			result.get(
				"type",
				"zero_frame_consciousness_switch"
			)
		),
		"text": str(
			result.get(
				"text",
				""
			)
		),
		"previous_controlled_person_id": (
			previous_controlled_person_id
		),
		"controlled_person_id": target_id,
		"source": source,
		"actor_renderer_deck_pointer_swapped": main_tab_pointer_swapped,
		"main_tab_mount_already_complete": main_tab_pointer_swapped,
