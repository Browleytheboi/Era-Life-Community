		return false
	relationship_profile_popup_actions.add_child(
		_make_relationship_browser_action_button(label, action_id)
	)
	return true

func _relationship_profile_player_has_visible_bending_actions(p: Person, target: Person) -> bool:
	if p == null or target == null or gs == null:
		return false
	if not gs.is_feature_enabled("bending"):
		return false
	if str(p.bending_type) == "none":
		return false
	if _relationship_profile_action_allowed_for_player_age("Challenge To Bending Duel", target):
		return true
	if str(target.bending_type) != "none" and _relationship_profile_action_allowed_for_player_age("Train Bending", target):
		return true
	if gs.bending_engine != null and int(gs.bending_engine.get_primary_bending_level(p)) >= 85 and _relationship_profile_action_allowed_for_player_age("Teach Bending", target):
		return true
	if gs.bending_engine != null and gs.bending_engine.has_method("get_contextual_bending_popup_actions"):
		for raw_bending_action in gs.bending_engine.get_contextual_bending_popup_actions(p, target):
			if typeof(raw_bending_action) != TYPE_DICTIONARY:
				continue
			var bending_action: Dictionary = raw_bending_action
			if _relationship_profile_action_allowed_for_player_age(str(bending_action.get("id", "")), target):
				return true
	if str(p.bending_type) == "avatar" and (_relationship_profile_action_allowed_for_player_age("Grant Bending", target) or _relationship_profile_action_allowed_for_player_age("Remove Bending", target)):
		return true
	return false
func _populate_relationship_popup_actions(target: Person) -> void:
	if target == null:
		return
	if not target.alive:
		var dead_info:= Label.new()
		dead_info.text = "This person is dead. Relationship activities are unavailable."
		relationship_profile_popup_actions.add_child(dead_info)
		return

	if relationship_profile_popup_grant_picker_open:
		var grantable:= MainSceneHelpers._grantable_avatar_elements_for_target(target)
		if grantable.is_empty():
			var info:= Label.new()
			info.text = "%s already has every base element." % target.first_name
			relationship_profile_popup_actions.add_child(info)
		else:
			for element in grantable:
				if not _relationship_profile_action_allowed_for_player_age("Grant Element:%s" % str(element), target):
					continue
				relationship_profile_popup_actions.add_child(
					_make_relationship_browser_action_button(
						MainSceneHelpers._grant_picker_button_label(str(element)),
