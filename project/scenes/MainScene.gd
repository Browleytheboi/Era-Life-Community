func _institution_hub_add_person_or_relation_by_id(npc_id: int, custom_label: String = "", parent: Control = null) -> void:
	var target_parent: Control = parent if parent != null else institution_hub_list
	if gs == null or npc_id <= 0 or target_parent == null:
		return
	var npc:= gs.get_or_reactivate_npc_by_id(npc_id)
	if npc != null:
		if custom_label.strip_edges() != "":
			_institution_hub_add_person_button(npc, custom_label + ": ", "", target_parent)
		else:
			_institution_hub_add_person_button(npc, "", "", target_parent)
		return
	var fallback:= _format_relationship_by_id(npc_id, custom_label)
	if fallback.strip_edges() != "":
		var label:= Label.new()
		label.text = fallback
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		target_parent.add_child(label)
func _institution_hub_add_career_job_preview_actions(job_kind: String, jobs: Array, max_count: int = 6) -> void:
	var clean_job_kind: String = str(job_kind).strip_edges()
	var limit: int = max(0, int(max_count))
	var added: int = 0

	for raw_job in jobs:
		if added >= limit:
			break
		var job_name: String = str(raw_job).strip_edges()
		if job_name == "":
			continue
		_institution_hub_add_action_button(job_name, "Career Hub Open Job::%s::%s" % [clean_job_kind, job_name])
		added += 1

	var remaining: int = max(0, int(jobs.size()) - added)
	if added <= 0:
		_institution_hub_add_info_label("No career listings are available right now.")
	elif remaining > 0:
		_institution_hub_add_info_label("+ %d more listings are available in the dedicated browser." % remaining)
func _build_career_institution_hub_section(section: String) -> void:
	var p: Person = gs.player
	if p == null:
		return

	var opps: Array = []
	if gs.opportunity_engine != null:
		opps = gs.opportunity_engine.generate_opportunities(p)

	var sections: Dictionary = {
		"part_time": [],
		"full_time": [],
		"famous": []
	}
	if gs.career_engine != null:
		sections = gs.career_engine.get_career_browser_sections_for(p)

	var career_surface_context: Dictionary = MainSceneLogic._build_institution_hub_stat_surface_context(gs, "career", p)
	var has_job: bool = str(p.job).strip_edges() != ""
	var career_standing_value: int = 0
	var career_pressure_value: int = 0

	if has_job:
		career_standing_value = clamp(int(round(
			(float(p.job_performance) * 0.55)
			+ (float(p.job_experience) * 0.25)
			+ (float(p.satisfaction) * 0.2)
			+ 15.0
			- (10.0 if float(p.work_stress) >= 85.0 else 0.0)
		)), 0, 100)
		career_pressure_value = clamp(int(round(
			(float(p.work_stress) * 0.7)
			+ (max(0.0, 55.0 - float(p.job_performance)) * 0.35)
		)), 0, 100)

	match section:
		"overview":
			_institution_hub_add_live_stat_card("Career Surface", [
				{
					"title": "Career Standing",
					"value": career_standing_value,
					"max_value": 100
				},
				{
					"title": "Career Pressure",
					"value": career_pressure_value,
					"max_value": 100
				}
			], career_surface_context)
			_institution_hub_add_card("Career Snapshot", [
				"Job: %s" % (p.job if has_job else "Unemployed"),
				"Income: %s" % gs.economy_engine.format_money(int(p.income)),
				"Satisfaction: %d" % int(p.satisfaction),
				"Performance: %d" % int(p.job_performance),
				"Experience: %d" % int(p.job_experience),
				"Work Stress: %d" % int(p.work_stress)
			])

		"actions":
			_institution_hub_add_section_header("Career Actions")
			_institution_hub_add_action_button("Browse Part Time Careers", "Career Hub Browse Part Time Careers")
			_institution_hub_add_action_button("Browse Full Time Careers", "Career Hub Browse Full Time Careers")
			if has_job:
				if "Work Normally" in opps:
					_institution_hub_add_action_button("Work Normally", "Work Normally")
				if "Work Hard" in opps:
					_institution_hub_add_action_button("Work Hard", "Work Hard")
				if "Slack Off" in opps:
					_institution_hub_add_action_button("Slack Off", "Slack Off")
				if "Ask for Raise" in opps:
					_institution_hub_add_action_button("Ask for Raise", "Ask for Raise")
				if "View Coworkers" in opps:
					_institution_hub_add_action_button("View Coworkers", "View Coworkers")
				if "Quit Job" in opps:
					_institution_hub_add_action_button("Quit Job", "Quit Job")

		"jobs":
			_institution_hub_add_section_header(
				"Career Browser"
			)
			_institution_hub_add_info_label(
				(
					"Career browsing is available at every age. "
					+ "Age, education, credentials, vacancies, and "
					+ "organization approval only control applications."
				)
			)

			_institution_hub_add_section_header(
				"Part-Time Career Worlds"
			)
			_institution_hub_add_career_job_preview_actions(
				"part_time",
				sections.get(
					"part_time",
					[]
				),
				6
			)

			_institution_hub_add_section_header(
				"Full-Time Career Worlds"
			)
			_institution_hub_add_career_job_preview_actions(
				"full_time",
				sections.get(
					"full_time",
					[]
				),
				6
			)

			if sections.get(
				"famous",
				[]
			).size() > 0:
				_institution_hub_add_section_header(
					"Special Career Tracks"
				)

				for track_name in sections.get(
					"famous",
					[]
				):
					_institution_hub_add_info_label(
						"🌟 %s"
						% str(
							track_name
						)
					)

			_institution_hub_add_action_button(
				"Enter First-Class Career Hub",
				"Career Hub Browse Full Time Careers"
			)

		"workplace":
			_institution_hub_add_card("Workplace State", MainSceneHelpers._career_hub_workplace_snapshot_lines(p))
			if "View Coworkers" in opps and has_job:
				_institution_hub_add_action_button("View Coworkers", "View Coworkers")

		_:
			_institution_hub_add_info_label("No career section selected.")
func _on_institution_hub_action_pressed(action_id: String) -> void:
	if gs == null:
		return

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "institution_hub_action",
			"surface_id": "institution_hub:%s" % str(institution_hub_kind).strip_edges().to_lower(),
			"action_id": action_id,
			"legacy_callback": "_on_institution_hub_action_pressed",
			"legacy_args": [
				action_id
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_institution_hub_action_pressed"
			},
			"source": "mainscene.institution_hub_action"
		}, {
			"source": "mainscene.institution_hub_action",
			"surface_id": "institution_hub:%s" % str(institution_hub_kind).strip_edges().to_lower(),
			"action_id": action_id,
			"legacy_callback": "_on_institution_hub_action_pressed",
			"legacy_args": [
				action_id
			]
		})
		return
	var p: Person = gs.player
	if p == null:
		return
	if action_id.begins_with("School Hub Open Class Roster::") or action_id.begins_with("School Hub Toggle Class Roster::"):
		var class_parts: PackedStringArray = action_id.split("::")
		if class_parts.size() >= 2:
			var class_key: String = str(class_parts [1]).strip_edges()
			if class_key != "":
				institution_hub_current_section = "classes"
				_show_school_class_roster_popup(class_key)
		return
	if action_id == "School Hub Child Enrollment Open":
		school_hub_child_enrollment_mode = "select_children"
		school_hub_child_enrollment_targets.clear()
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id == "School Hub Child Enrollment Cancel":
		_school_hub_reset_child_enrollment_flow()
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id == "School Hub Child Enrollment Back":
		if school_hub_child_enrollment_mode == "choose_school":
			school_hub_child_enrollment_mode = "select_children"
		else:
			_school_hub_reset_child_enrollment_flow()
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id == "School Hub Child Select All":
		school_hub_child_enrollment_targets.clear()
		var selectable_children: Array = MainSceneLogic._school_hub_get_enrollable_children_for_parent(gs, p)
		for raw_child in selectable_children:
			var child: Person = raw_child
			if child == null:
				continue
			school_hub_child_enrollment_targets.append(int(child.id))
		school_hub_child_enrollment_mode = "select_children"
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id == "School Hub Child Clear Selection":
		school_hub_child_enrollment_targets.clear()
		school_hub_child_enrollment_mode = "select_children"
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id.begins_with("School Hub Child Toggle::"):
		var toggle_parts: PackedStringArray = action_id.split("::")
		if toggle_parts.size() >= 2:
			var child_id: int = int(toggle_parts [1])
			if child_id > 0:
				if school_hub_child_enrollment_targets.has(child_id):
					school_hub_child_enrollment_targets.erase(child_id)
				else:
					school_hub_child_enrollment_targets.append(child_id)
		school_hub_child_enrollment_mode = "select_children"
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id == "School Hub Child Enrollment Continue":
		var selected_children: Array = _school_hub_validate_selected_child_targets(p)
		if selected_children.is_empty():
			_maybe_show_action_result_popup({
				"popup_title": "Choose A Child",
				"popup_text": "Select at least one eligible child before choosing a school.",
				"popup_footer": "Tap anywhere to continue."
			})
			_refresh_institution_hub()
			return
		school_hub_child_enrollment_mode = "choose_school"
		institution_hub_current_section = "overview"
		_refresh_institution_hub()
		return

	if action_id.begins_with("School Hub Enroll Selected Children::"):
		var selected_parts: PackedStringArray = action_id.split("::")
		if selected_parts.size() >= 4 and gs.school_engine != null:
			var selected_mode: String = str(selected_parts [1]).strip_edges()
			var selected_school_name: String = str(selected_parts [2]).strip_edges()
			var selected_child_ids: Array = MainSceneHelpers._school_hub_parse_child_id_csv(str(selected_parts [3]).strip_edges())
			var selected_result: Dictionary = gs.school_engine.enroll_children_from_parent_school_hub(p, selected_child_ids, selected_school_name, selected_mode)
			_maybe_show_action_result_popup(selected_result)
			if bool(selected_result.get("success", false)):
				_school_hub_reset_child_enrollment_flow()
			else:
				school_hub_child_enrollment_mode = "choose_school"
			institution_hub_current_section = "overview"
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return
	if action_id.begins_with("School Hub Enroll Child::"):
		var child_parts: PackedStringArray = action_id.split("::")
		if child_parts.size() >= 4 and gs.school_engine != null:
			var child_id: int = int(child_parts [1])
			var child_mode: String = str(child_parts [2]).strip_edges()
			var child_school_name: String = str(child_parts [3]).strip_edges()
			var child_result: Dictionary = gs.school_engine.enroll_child_from_parent_school_hub(p, child_id, child_school_name, child_mode)
			_maybe_show_action_result_popup(child_result)
			institution_hub_current_section = "overview"
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return

	if action_id.begins_with("School Hub Enroll::"):
		var school_parts: PackedStringArray = action_id.split("::")
		if school_parts.size() >= 3 and gs.school_engine != null:
			var school_mode: String = str(school_parts [1]).strip_edges()
			var school_name: String = str(school_parts [2]).strip_edges()
			var school_result: Dictionary = gs.school_engine.enroll_by_contract_choice(p, school_name, school_mode)
			_maybe_show_action_result_popup(school_result)
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return

	if action_id == "School Hub Attend Year":
		if gs.school_engine != null:
			var attend_result: Dictionary = gs.school_engine.attend_school_year(p)
			_maybe_show_action_result_popup(attend_result)
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return

	if action_id == "School Hub Drop Out":
		if gs.school_engine != null:
			var drop_result: Dictionary = gs.school_engine.drop_out(p)
			_maybe_show_action_result_popup(drop_result)
			_refresh_institution_hub()
			_render_life_diary_panel()
			_update_player_stats_overlay()
		return
	if action_id == "Relationship Household Leave":
		var result: Dictionary = _resolve_player_household_departure()
		_maybe_show_action_result_popup(result)
		_refresh_institution_hub()
		return

	if action_id == "Relationship Household Run Away":
		_show_household_runaway_confirm_popup()
		return

	if action_id == "Relationship Household Confirm Run Away":
		_hide_household_runaway_confirm_popup()
		var result: Dictionary = _resolve_player_household_departure()
		_maybe_show_action_result_popup(result)
		_refresh_institution_hub()
		_render_life_diary_panel()
		_update_player_stats_overlay()
		return

	if action_id == "Relationship Household Cancel Run Away":
		_hide_household_runaway_confirm_popup()
		return

	if action_id == "Career Hub Browse Part Time Careers":
		_request_career_hub_contract(
			p,
			{
				"action_id": "browse_lane",
				"lane": "part_time",
				"section_id": "opportunities",
				"source": (
					"legacy_institution_hub_part_time_redirect"
				)
			},
			true
		)
		return

	if action_id == "Career Hub Browse Full Time Careers":
		_request_career_hub_contract(
			p,
			{
				"action_id": "browse_lane",
				"lane": "full_time",
				"section_id": "opportunities",
				"source": (
					"legacy_institution_hub_full_time_redirect"
				)
			},
			true
		)
		return

	if action_id.begins_with("Career Hub Open Job::"):
		var parts: PackedStringArray = action_id.split("::")
		if parts.size() >= 4:
			var job_kind: String = str(parts [2]).strip_edges()
			var job_name: String = str(parts [3]).strip_edges()
			if job_name != "":
				_show_career_job_overview(job_kind, job_name)
		return

	if action_id.begins_with("Career Hub Apply Job::"):
		var career_hub_apply_parts: PackedStringArray = (
			action_id.split(
				"::"
			)
		)

		if career_hub_apply_parts.size() < 4:
			_maybe_show_action_result_popup({
				"success": false,
				"popup_title": "Career Application",
				"popup_text": (
					"The Career Hub received an incomplete "
					+ "application request."
				),
				"popup_footer": (
					"No professional application was committed."
				)
			})
			return

		var career_hub_apply_lane: String = str(
			career_hub_apply_parts [2]
		).strip_edges()
		var career_hub_apply_job_name: String = str(
			career_hub_apply_parts [3]
		).strip_edges()

		if career_hub_apply_job_name == "":
			_maybe_show_action_result_popup({
				"success": false,
				"popup_title": "Career Application",
				"popup_text": (
					"You tried to apply for a career, but the "
					+ "job could not be resolved."
				),
				"popup_footer": (
					"No professional application was committed."
				)
			})
			return

		_request_career_hub_contract(
			p,
			{
				"action_id": "apply_legacy_job",
				"lane": career_hub_apply_lane,
				"job_name": career_hub_apply_job_name,
				"section_id": "opportunities",
				"source": (
					"legacy_institution_hub_application_redirect"
				)
			},
			true
		)
		return

	_on_standard_tab_action_pressed(action_id)
func _collect_player_household_member_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	var anchor: Person = MainSceneLogic._resolve_player_household_anchor(gs, person)
	if anchor == null:
		return out

	if gs.family_control_engine != null and gs.family_control_engine.has_method("_collect_household_cluster"):
		var cluster: Array = gs.family_control_engine._collect_household_cluster(anchor)
		for member in cluster:
			if member == null:
				continue
			if not member.alive:
				continue
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(member.id))

		if person.alive:
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(person.id))

		if int(person.age) < 18:
			for raw_parent_id in person.parents:
				var parent: Person = gs.get_or_reactivate_npc_by_id(int(raw_parent_id))
				if parent != null and parent.alive:
					MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(parent.id))
			for sibling_id in _collect_sibling_ids_for_person(person):
				var sibling: Person = gs.get_or_reactivate_npc_by_id(int(sibling_id))
				if sibling == null:
					continue
				if not sibling.alive:
					continue
				if int(sibling.age) >= 18:
					continue
				MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(sibling.id))
		return out

	MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(anchor.id))
	MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(person.id))

	for raw_parent_id in person.parents:
		var parent: Person = gs.get_or_reactivate_npc_by_id(int(raw_parent_id))
		if parent != null and parent.alive:
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(parent.id))

	for sibling_id in _collect_sibling_ids_for_person(person):
		var sibling: Person = gs.get_or_reactivate_npc_by_id(int(sibling_id))
		if sibling == null:
			continue
		if not sibling.alive:
			continue
		if int(sibling.age) >= 18 and int(person.age) < 18:
			continue
		MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(sibling.id))

	return out
func _build_household_status_lines(person: Person) -> Array:
	var lines: Array = []
	lines.append("===== MY HOUSEHOLD =====")
	if person == null:
		lines.append("Household State: Unresolved")
		lines.append("No person is available for household inspection.")
		lines.append("========================")
		return lines

	var anchor: Person = MainSceneLogic._resolve_player_household_anchor(gs, person)
	var custodial_parent: Person = MainSceneLogic._resolve_player_custodial_parent(gs, person)
	var member_ids: Array = _collect_player_household_member_ids(person)
	var household_property: Dictionary = MainSceneLogic._resolve_player_household_property_record(gs, person)

	lines.append("Your Age: %d" % int(person.age))
	lines.append("Household Members: %d" % int(member_ids.size()))

	if anchor != null and int(anchor.id) == int(person.id):
		lines.append("Household Anchor: You")
	elif anchor != null:
		lines.append("Household Anchor: %s" % _relationship_display_name(anchor))
	else:
		lines.append("Household Anchor: Unresolved")

	if int(person.age) < 18:
		if custodial_parent != null:
			lines.append("Custodial Parent: %s" % _relationship_display_name(custodial_parent))
		else:
			lines.append("Custodial Parent: Unresolved")
	else:
		lines.append("Custodial Status: Adult")

	if household_property.is_empty():
		lines.append("Residence Link: No owned household property is currently linked.")
		if str(person.home_city).strip_edges() != "" and str(person.home_country).strip_edges() != "":
			lines.append("Home Base: %s, %s" % [person.home_city, person.home_country])
		elif str(person.home_city).strip_edges() != "":
			lines.append("Home Base: %s" % person.home_city)
		elif str(person.home_country).strip_edges() != "":
			lines.append("Home Base: %s" % person.home_country)
	else:
		lines.append("Residence Link: %s" % MainSceneLogic._household_property_display_name(gs, household_property))

	var household_state_label: String = "Shared Household"
	if member_ids.size() <= 1 and anchor != null and int(anchor.id) == int(person.id):
		household_state_label = "Independent Household"
	elif member_ids.is_empty():
		household_state_label = "Unresolved Household"
	elif int(person.age) < 18:
		household_state_label = "Custodial Household"

	lines.append("Household State: %s" % household_state_label)
	lines.append("========================")
	return lines
