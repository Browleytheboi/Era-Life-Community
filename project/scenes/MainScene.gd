		relationship_editor_popup.focus_mode = Control.FOCUS_NONE
		relationship_editor_popup.z_as_relative = false
		relationship_editor_popup.z_index = -500

	if relationships_browser_panel != null and is_instance_valid(relationships_browser_panel):
