func _apply_player_stat_surface_flavor_label(
		label: Label,
		bar: ProgressBar,
		flavor: String,
		surface_context: Dictionary = {}
) -> void:
	if (
		label == null
		or bar == null
	):
		return

	var row:= label.get_parent()

	if row == null:
		return

	var flavor_label:= row.find_child(
		"FlavorLabel",
		true,
		false
	) as Label

	if flavor_label == null:
		return

	var clean_flavor: String = str(
		flavor
	).strip_edges()
	var effective_context: Dictionary = (
		surface_context.duplicate(false)
		if typeof(
			surface_context
		) == TYPE_DICTIONARY
		else {}
	)
	var hide_flavor: bool = bool(
		effective_context.get(
			"hide_stat_flavor",
			false
		)
	)
	var should_show: bool = (
		clean_flavor != ""
		and not hide_flavor
	)
	var previous_visible: bool = bool(
		flavor_label.visible
	)
	var previous_text: String = str(
		flavor_label.text
	)
	var stat_title: String = str(
		bar.get_meta(
			"stat_surface_title",
			label.get_meta(
				"player_stat_label_stat_title",
				""
			)
		)
	).strip_edges()
	var palette: Dictionary = (
		_resolve_player_stat_palette(
			stat_title
		)
	)
	var stat_color: Color = Color(
		palette.get(
			"core",
			Color(
				0.97,
				0.99,
				1.0,
				1.0
			)
		)
	)

	if bool(
		bar.get_meta(
			"bending_hub_surface",
			false
		)
	):
		stat_color = (
			_bending_hud_element_color(
				str(
					bar.get_meta(
						"bending_element",
						""
					)
				)
			)
		)

	var outline_color: Color = Color(
		maxf(
			0.01,
			stat_color.r * 0.16
		),
		maxf(
			0.01,
			stat_color.g * 0.16
		),
		maxf(
			0.01,
			stat_color.b * 0.16
		),
		1.0 if should_show else 0.0
	)

	stat_color.a = (
		0.96
		if should_show
		else 0.0
	)

	flavor_label.text = clean_flavor
	flavor_label.visible = should_show
	flavor_label.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	flavor_label.autowrap_mode = (
		TextServer.AUTOWRAP_WORD_SMART
	)
	flavor_label.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	flavor_label.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_LEFT
	)

	if label.has_theme_font_override(
		"font"
	):
		flavor_label.add_theme_font_override(
			"font",
			label.get_theme_font(
				"font"
			)
		)

	flavor_label.add_theme_font_size_override(
		"font_size",
		15
	)
	flavor_label.add_theme_color_override(
		"font_color",
		stat_color
	)
	flavor_label.add_theme_color_override(
		"font_outline_color",
		outline_color
	)
	flavor_label.add_theme_constant_override(
		"outline_size",
		2
	)
	flavor_label.add_theme_color_override(
		"font_shadow_color",
		Color(
			0.0,
			0.0,
			0.0,
			0.78 if should_show else 0.0
		)
	)
	flavor_label.add_theme_constant_override(
		"shadow_offset_x",
		0
	)
	flavor_label.add_theme_constant_override(
		"shadow_offset_y",
		2
	)
	flavor_label.modulate = Color(
		1.0,
		1.0,
		1.0,
		1.0 if should_show else 0.0
	)
	flavor_label.set_meta(
		"player_stat_flavor_uses_stat_color",
		true
	)
	flavor_label.set_meta(
		"player_stat_flavor_white_flash_forbidden",
		true
	)
	flavor_label.set_meta(
		"player_stat_flavor_dark_outline",
		true
	)
	flavor_label.set_meta(
		"player_stat_flavor_font_size",
		15
	)

	if (
		previous_visible != should_show
		or previous_text != clean_flavor
	):
		bar.set_meta(
			"player_stat_row_visual_signature",
			""
		)
func _apply_player_stat_surface_content(
		label: Label,
		bar: ProgressBar,
		title: String,
		value: int,
		max_value: int,
		surface_context: Dictionary
) -> void:
	if (
		label == null
		or bar == null
	):
		return

	var effective_surface_context: Dictionary = (
		surface_context.duplicate(false)
		if typeof(
			surface_context
		) == TYPE_DICTIONARY
		else {}
	)
	var clean_title: String = str(
		title
	).strip_edges()
	var upper_title: String = (
		clean_title.to_upper()
	)
	var subject_dead: bool = (
		bool(
			effective_surface_context.get(
				"subject_dead",
				false
			)
		)
		and clean_title != "Bond"
	)
	var display_value: int = (
		0
		if subject_dead
		else value
	)
	var safe_max: int = max(
		1,
		int(
			max_value
		)
	)

	display_value = clamp(
		display_value,
		0,
		safe_max
	)

	bar.set_meta(
		"stat_surface_context",
		effective_surface_context
	)
	bar.set_meta(
		"stat_surface_title",
		clean_title
	)

	bar.max_value = float(
		safe_max
	)
	bar.value = float(
		display_value
	)

	var resolved: Dictionary = {}
	var surface_family: String = str(
		effective_surface_context.get(
			"surface_family",
			""
		)
	).strip_edges()

	if (
		subject_dead
		and clean_title == "Health"
	):
		resolved = (
			MainSceneLogic._resolve_player_stat_surface(
				clean_title,
				0,
				safe_max,
				effective_surface_context
			)
		)
	elif subject_dead:
		resolved = {
			"descriptor": "Dead",
			"flavor": "This life has ended.",
			"bar_text": "Dead",
			"title_text": (
				"%s: Dead"
				% clean_title
			)
		}
	elif surface_family == "realm_overview":
		resolved = (
			MainSceneHelpers._resolve_realm_stat_surface(
				clean_title,
				display_value,
				safe_max,
				effective_surface_context
			)
		)
	elif surface_family == "institution_hub":
		resolved = (
			MainSceneHelpers._resolve_institution_hub_stat_surface(
				clean_title,
				display_value,
				safe_max,
				effective_surface_context
			)
		)
	else:
		resolved = (
			MainSceneLogic._resolve_player_stat_surface(
				clean_title,
				display_value,
				safe_max,
				effective_surface_context
			)
		)

	var descriptor: String = str(
		resolved.get(
			"descriptor",
			""
		)
	).strip_edges()
	var flavor: String = str(
		resolved.get(
			"flavor",
			""
		)
	).strip_edges()
	var title_text: String = str(
		resolved.get(
			"title_text",
			""
		)
	).strip_edges()

	if title_text == "":
		title_text = (
			MainSceneHelpers._resolve_player_stat_surface_title(
				clean_title,
				descriptor,
				effective_surface_context
			)
		)

	if title_text.begins_with(
		"%s:" % clean_title
	):
		title_text = "%s%s" % [
			upper_title,
			title_text.substr(
				clean_title.length()
			)
		]
	elif title_text == clean_title:
		title_text = upper_title
	elif not title_text.begins_with(
		upper_title
	):
		title_text = "%s: %s" % [
			upper_title,
			(
				descriptor
				if descriptor != ""
				else title_text
			)
		]

	var palette: Dictionary = (
		_resolve_player_stat_palette(
			clean_title
		)
	)
	var stat_label_color: Color = Color(
		palette.get(
			"core",
			palette.get(
				"label",
				Color(
					0.97,
					0.99,
					1.0,
					0.96
				)
			)
		)
	)
	var stat_outline_color: Color = Color(
		maxf(
			0.01,
			stat_label_color.r * 0.16
		),
		maxf(
			0.01,
			stat_label_color.g * 0.16
		),
		maxf(
			0.01,
			stat_label_color.b * 0.16
		),
		1.0
	)

	label.text = title_text
	label.horizontal_alignment = (
		HORIZONTAL_ALIGNMENT_CENTER
	)
	label.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	label.add_theme_font_size_override(
		"font_size",
		19
	)
	label.add_theme_color_override(
		"font_color",
		stat_label_color
	)
	label.add_theme_color_override(
		"font_outline_color",
		stat_outline_color
	)
	label.add_theme_constant_override(
		"outline_size",
		3
	)
	label.add_theme_color_override(
		"font_shadow_color",
		Color(
			0.0,
			0.0,
			0.0,
			0.74
		)
	)
	label.add_theme_constant_override(
		"shadow_offset_x",
		0
	)
	label.add_theme_constant_override(
		"shadow_offset_y",
		2
	)
	label.set_meta(
		"player_stat_label_uppercase",
		true
	)
	label.set_meta(
		"player_stat_label_color_coded",
		true
	)
	label.set_meta(
		"player_stat_label_stat_title",
		clean_title
	)
	label.set_meta(
		"player_stat_label_dark_outline",
		true
	)
	label.set_meta(
		"player_stat_label_font_size",
		19
	)

	_refresh_player_stat_bar_value_text(
		bar,
		display_value,
		safe_max,
		clean_title
	)
	_apply_player_stat_surface_flavor_label(
		label,
		bar,
		flavor,
		effective_surface_context
	)

	var pulse_strength: float = (
		(
			sin(
				player_stats_breathe_time
				* 1.25
			) + 1.0
		) * 0.5
	)
	var row_hovered: bool = (
		player_stats_hovered_row_title
		== clean_title
	)
	var danger_state: bool = (
		clean_title == "Health"
		and display_value > 0
		and display_value < 30
	)

	_apply_player_stat_row_visual_state(
		label,
		bar,
		clean_title,
		row_hovered,
		danger_state,
		pulse_strength
	)



	label.add_theme_font_size_override(
		"font_size",
