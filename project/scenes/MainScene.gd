func _on_career_hub_intent_requested(
		payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var outgoing: Dictionary = payload.duplicate(true)
	var actor_id: int = int(
		gs.player.id
	)
	var action_id: String = str(
		outgoing.get(
			"action_id",
			""
		)
	).strip_edges().to_lower()
	var section_id: String = str(
		outgoing.get(
			"section_id",
			career_hub_active_section_id
		)
	).strip_edges().to_lower()
	var lane: String = str(
		outgoing.get(
			"lane",
			career_hub_active_lane
		)
	).strip_edges().to_lower()

	if section_id != "":
		career_hub_active_section_id = section_id

	if lane in [
		"full_time",
		"part_time"
	]:
		career_hub_active_lane = lane

	if action_id == "set_section":
		outgoing ["section_id"] = career_hub_active_section_id
		outgoing ["lane"] = career_hub_active_lane

		var incarceration_lens: Dictionary = (
			_controlled_actor_incarceration_lens_contract()
		)

		if bool(
			incarceration_lens.get(
				"active",
				false
			)
		):


			set_meta(
				"incarceration_career_section_press_reveal_only",
				true
			)
			set_meta(
				"incarceration_career_section_press_engine_calls",
				false
			)
			set_meta(
				"incarceration_career_section_press_deferred_work",
				false
			)
			set_meta(
				"incarceration_career_section_press_free_world_persist",
				false
			)
			return

		outgoing ["source"] = "career_hub_panel.lens_persistence"

		call_deferred(
			"_persist_career_hub_section_lens",
			outgoing.duplicate(true)
		)
		return

	outgoing ["career_action_press_frame_work_forbidden"] = true
	outgoing ["blocks_ui"] = false
	outgoing ["ready_gate_member"] = false

	set_meta(
		"career_hub_action_engine_work_on_press",
		false
	)
	set_meta(
		"career_hub_action_build_on_press",
		false
	)

	call_deferred(
		"_commit_career_hub_action_deferred",
