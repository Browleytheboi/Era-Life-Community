func _restore_grocery_contract_aisle_after_shoppers_popup_close(store_id: String = "", aisle_id: String = "") -> void:
	if relationship_profile_popup_open:
		return

	if gs == null or gs.ui_contract_engine == null:
		return

	var clean_store_id: String = str(store_id).strip_edges()
	var clean_aisle_id: String = str(aisle_id).strip_edges()

	var surface_state: Dictionary = gs.ui_contract_engine.surface_runtime_state.get("food_contract_hub", {}) if typeof(gs.ui_contract_engine.surface_runtime_state.get("food_contract_hub", {})) == TYPE_DICTIONARY else {}

	if clean_store_id == "":
		clean_store_id = str(surface_state.get("store_id", "")).strip_edges()

	if clean_aisle_id == "":
		clean_aisle_id = str(surface_state.get("aisle_id", "")).strip_edges()

	if clean_store_id == "":
		return

	if clean_aisle_id == "" and gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("first_aisle_id_for_store"):
		clean_aisle_id = str(gs.grocery_store_engine.first_aisle_id_for_store(clean_store_id)).strip_edges()

	if clean_aisle_id == "":
		return

	surface_state ["store_id"] = clean_store_id
	surface_state ["aisle_id"] = clean_aisle_id
	surface_state ["grocery_inside_store"] = true
	surface_state ["grocery_ready_for_cashier"] = false
	surface_state ["grocery_shoppers_popup_closed_at_ms"] = int(Time.get_ticks_msec())

	gs.ui_contract_engine.sync_surface_state("food_contract_hub", surface_state)
	gs.ui_contract_engine.set_active_section("food_contract_hub", "aisles")

	if str(ui_contract_active_surface_id).strip_edges() != "food_contract_hub":
		return

	_open_contract_surface("food_contract_hub", "aisles")


func _refresh_grocery_aisle_shoppers_popup(
		store_id: String = "",
		aisle_id: String = ""
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var close_guard_until_ms: int = int(
		get_meta(
			"grocery_aisle_shoppers_popup_close_guard_until_ms",
			0
		)
	)

	if now_ms < close_guard_until_ms:
		return

	var clean_store_id: String = str(
		store_id
	).strip_edges()
	var clean_aisle_id: String = str(
		aisle_id
	).strip_edges()

	if clean_store_id == "":
		clean_store_id = str(
			get_meta(
				"grocery_aisle_shoppers_popup_store_id",
				get_meta(
					"grocery_store_realtime_mode_store_id",
					""
				)
			)
		).strip_edges()

	if clean_aisle_id == "":
		clean_aisle_id = str(
			get_meta(
				"grocery_aisle_shoppers_popup_aisle_id",
				get_meta(
					"grocery_store_realtime_mode_aisle_id",
					""
				)
			)
		).strip_edges()

	if (
		clean_store_id == ""
		or clean_aisle_id == ""
	):
		return

	var action_id: String = (
		"grocery_shoppers_popup:%s:%s"
		% [
			clean_store_id,
			clean_aisle_id
		]
	)
	var report: Dictionary = (
		_request_runtime_engine_method_intent(
			"ui_contract_engine",
			"route_interaction",
			[
				"food_contract_hub",
				action_id,
				{},
				{
					"source": (
						"mainscene_grocery_aisle_shoppers_popup_refresh"
					),
					"surface_id": (
						"food_contract_hub"
					),
					"active_section_id": "aisles",
					"player_id": (
						int(gs.player.id)
						if (
							gs != null
							and gs.player != null
						)
						else -1
					),
					"store_id": clean_store_id,
					"aisle_id": clean_aisle_id,
					"projection_only": true,
					"ui_is_expression_only": true
				}
			],
			action_id,
			(
				"mainscene."
				+ "grocery_aisle_shoppers_popup_refresh"
			)
		)
	)

	if not bool(
		report.get(
			"success",
			false
		)
	):
		return

	report ["mode"] = (
		"dynamic_grocery_shoppers_popup_refresh"
	)
	report ["refreshed_at_ms"] = now_ms

	_show_grocery_aisle_shoppers_popup(
		report
	)

func _on_grocery_shopper_profile_pressed(shopper_ref: Variant, store_id: String = "", aisle_id: String = "") -> void:
	_close_grocery_aisle_shoppers_popup(false)

	var shopper: Dictionary = {}
	var resolved_person_id: int = -1
	var shard_id: String = ""

	if typeof(shopper_ref) == TYPE_DICTIONARY:
		shopper = (shopper_ref as Dictionary).duplicate(true)
		resolved_person_id = int(shopper.get("person_id", -1))
		shard_id = str(shopper.get("shard_id", "")).strip_edges()
	else:
		resolved_person_id = int(shopper_ref)

	var clean_store_id: String = str(store_id).strip_edges()
	var clean_aisle_id: String = str(aisle_id).strip_edges()

	if resolved_person_id <= 0 and gs != null and gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("materialize_grocery_shopper_for_ui"):
		var materialize_report: Dictionary = gs.grocery_store_engine.materialize_grocery_shopper_for_ui(resolved_person_id, {
			"source": "mainscene_grocery_shopper_profile_intent",
			"store_id": clean_store_id,
			"aisle_id": clean_aisle_id,
			"surface_id": "food_contract_hub",
			"shard_id": shard_id,
			"shopper": shopper.duplicate(true)
		})
		resolved_person_id = int(materialize_report.get("person_id", -1))

	if resolved_person_id <= 0:
		return

	_remember_grocery_relationship_profile_context(clean_store_id, clean_aisle_id, resolved_person_id, "opened_grocery_shopper_profile")

	if clean_store_id != "" and not _grocery_store_music_is_active(clean_store_id):
		_start_grocery_store_music(clean_store_id, "grocery_shopper_relationship_profile")

	_open_relationship_profile_for_person_id(resolved_person_id, "food_contract_hub")


func _grocery_shopper_card_text(shopper: Dictionary) -> String:
	var name_text: String = str(shopper.get("name", "Unknown shopper")).strip_edges()
	var profession_text: String = str(shopper.get("profession", "Between jobs")).strip_edges()
	var state_text: String = str(shopper.get("shopping_state", "shopping")).replace("_", " ").capitalize()
	var age: int = int(shopper.get("age", shopper.get("preview_age", 0)))
	var count: int = int(shopper.get("cart_item_count", 0))
	var total: float = float(shopper.get("cart_total", 0.0))
	var last_added_text: String = str(shopper.get("last_cart_addition_text", "")).strip_edges()

	if name_text == "":
		name_text = "Unknown shopper"
	if profession_text == "":
		profession_text = "Between jobs"

	var identity_line: String = profession_text
	if age > 0:
		identity_line = "%s • Age %d" % [profession_text, age]

	var cart_line: String = "%d item/s • $%.2f" % [count, total]
	if last_added_text != "":
		cart_line = "%s\n%s" % [cart_line, last_added_text]

	return "%s\n%s • %s\n%s" % [
		name_text,
		identity_line,
		state_text,
		cart_line
	]


