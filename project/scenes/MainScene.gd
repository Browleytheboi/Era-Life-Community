func _resident_main_tab_renderer_deck_for_actor(
	actor_id: int
) -> Dictionary:
	if actor_id <= 0:
		return {}

	var actor_key: String = str(actor_id)
	var raw_deck: Variant = (
		resident_main_tab_renderer_deck_by_actor.get(
			actor_key,
			{}
		)
	)
	var deck: Dictionary = (
		raw_deck as Dictionary
		if typeof(raw_deck) == TYPE_DICTIONARY
		else {}
	)

	if deck.is_empty():
		return {}

	var deck_lens_key: String = str(
		deck.get(
			"world_seed_ui_lens_key",
			""
		)
	).strip_edges()
	var current_lens_key: String = (
		_world_seed_ui_lens_key()
	)

	if (
		deck_lens_key == ""
		or deck_lens_key != current_lens_key
	):
		for surface_id in [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]:
			var stale_panel: Control = (
				deck.get(
					surface_id,
					null
				) as Control
			)

			if (
				stale_panel != null
				and is_instance_valid(stale_panel)
			):
				stale_panel.queue_free()

		resident_main_tab_renderer_deck_by_actor.erase(
			actor_key
		)

		set_meta(
			"resident_actor_renderer_deck_stale_lens_rejected",
			true
		)
		set_meta(
			"resident_actor_renderer_deck_stale_lens_actor_id",
			actor_id
		)
		set_meta(
			"resident_actor_renderer_deck_stale_lens_key",
			deck_lens_key
		)
		set_meta(
			"resident_actor_renderer_deck_current_lens_key",
			current_lens_key
		)
		return {}

	var relationships_panel:= (
		deck.get(
			"relationships",
			null
		) as RelationshipHubPanel
	)

	if (
		relationships_panel != null
		and is_instance_valid(
			relationships_panel
		)
	):
		relationships_panel.set_meta(
			"resident_required_actor_id",
			actor_id
		)
		relationships_panel.set_meta(
			"resident_required_world_year",
			(
				int(gs.year)
				if gs != null
				else -999999
			)
		)
		relationships_panel.set_meta(
			"resident_temporal_admission_is_presentation_only",
			true
		)
		relationships_panel.set_meta(
			"resident_temporal_admission_mutates_contracts",
			false
		)
		relationships_panel.set_meta(
			"resident_old_relationship_packet_remains_historical",
			true
		)

	return deck

func _resident_main_tab_renderer_deck_is_hot(
	actor_id: int
) -> bool:
	var deck: Dictionary = (
		_resident_main_tab_renderer_deck_for_actor(
			actor_id
		)
	)

	if deck.is_empty():
		return false

	var relationships_panel:= (
		deck.get(
			"relationships",
			null
		) as RelationshipHubPanel
	)
	var school_panel:= (
		deck.get(
			"school",
			null
		) as SchoolHubPanel
	)
	var activities_panel:= (
		deck.get(
			"activities",
			null
		) as ActivitiesHubPanel
	)
	var career_panel_for_actor:= (
		deck.get(
			"career",
			null
		) as CareerHubPanel
	)
	var mods_panel:= (
		deck.get(
			"mods",
			null
		) as ModMenuPanel
	)

	return (
		relationships_panel != null
		and is_instance_valid(
			relationships_panel
		)
		and relationships_panel.has_renderable_contract(
			actor_id
		)
		and school_panel != null
		and is_instance_valid(
			school_panel
		)
		and school_panel.has_renderable_contract(
			actor_id
		)
		and activities_panel != null
		and is_instance_valid(
			activities_panel
		)
		and activities_panel.has_renderable_contract(
			actor_id
		)
		and career_panel_for_actor != null
		and is_instance_valid(
			career_panel_for_actor
		)
		and _career_hub_contract_is_renderable(
			career_panel_for_actor.active_contract,
			actor_id
		)
		and mods_panel != null
		and is_instance_valid(
			mods_panel
		)
		and mods_panel.has_precomposed_surface(
			actor_id
		)
	)


