func _on_entity_relationship_profile_pressed(entity_id: String, cached_card: Dictionary = {}) -> void:
	var clean_id: String = str(entity_id).strip_edges()
	if clean_id == "":
		return
	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "open_entity_relationship_profile",
			"surface_id": "relationship_hub",
			"action_id": "open_entity_relationship_profile",
			"target_entity_id": clean_id,
			"legacy_callback": "_on_entity_relationship_profile_pressed",
			"legacy_args": [clean_id, cached_card],
			"target": { "route_kind": "main_scene_legacy_callback", "callback": "_on_entity_relationship_profile_pressed", "target_entity_id": clean_id},
			"source": "mainscene.entity_relationship_profile"
		}, {
			"source": "mainscene.entity_relationship_profile",
			"surface_id": "relationship_hub",
			"action_id": "open_entity_relationship_profile",
			"target_entity_id": clean_id,
			"legacy_callback": "_on_entity_relationship_profile_pressed",
			"legacy_args": [clean_id, cached_card]
		})
		return
	_show_entity_relationship_profile_popup(clean_id, cached_card)

