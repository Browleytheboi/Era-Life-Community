func _mark_ui_interaction_from_event(event: InputEvent) -> void:
	if event == null:
		return

	if event is InputEventMouseMotion:
		var motion_event:= event as InputEventMouseMotion

		if motion_event.relative.length_squared() <= 0.0:
			return

		var now_ms: int = int(
			Time.get_ticks_msec()
		)
		var next_motion_mark_ms: int = int(
			get_meta(
				"ui_pointer_event_next_priority_mark_ms",
				0
			)
		)

		if now_ms < next_motion_mark_ms:
			return




		set_meta(
			"ui_pointer_event_next_priority_mark_ms",
			now_ms + 24
		)
		_mark_ui_interaction_activity(
			"mouse_motion_probe",
			96
		)
		return

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if mouse_event.pressed:
			_mark_ui_interaction_activity("mouse_button", 280)
		else:
			_mark_ui_interaction_activity("mouse_button_release", 180)
		return

	if event is InputEventScreenTouch:
		var touch:= event as InputEventScreenTouch
		if touch.pressed:
			_mark_ui_interaction_activity("screen_touch", 300)
		else:
			_mark_ui_interaction_activity("screen_touch_release", 180)
		return

	if event is InputEventScreenDrag:
		_mark_ui_interaction_activity("screen_drag", 220)
		return

	if event is InputEventKey:
		var key_event:= event as InputEventKey
		if key_event.pressed and not key_event.echo:
			_mark_ui_interaction_activity("key", 240)
		return

	if event is InputEventJoypadButton:
		var joy_button:= event as InputEventJoypadButton
		if joy_button.pressed:
			_mark_ui_interaction_activity("joypad_button", 240)
		return

	if event is InputEventJoypadMotion:
		_mark_ui_interaction_activity("joypad_motion", 160)
		return
func _drive_ui_pointer_activity_probe(now_ms: int) -> void:
	var viewport:= get_viewport()

	if viewport == null:
		return

	var current_pos: Vector2 = viewport.get_mouse_position()
	var previous_pos_raw: Variant = get_meta(
		"ui_pointer_last_position",
		current_pos
	)
	var previous_pos: Vector2 = (
		previous_pos_raw
		if typeof(previous_pos_raw) == TYPE_VECTOR2
		else current_pos
	)

	set_meta(
		"ui_pointer_last_position",
		current_pos
	)

	var moved_distance_sq: float = (
		current_pos.distance_squared_to(
			previous_pos
		)
	)

	if moved_distance_sq <= 4.0:
		return

	var next_probe_mark_ms: int = int(
		get_meta(
			"ui_pointer_activity_next_mark_ms",
			0
		)
	)

	if now_ms < next_probe_mark_ms:
		return



	set_meta(
		"ui_pointer_activity_next_mark_ms",
		now_ms + 48
	)

	_mark_ui_interaction_activity(
		"pointer_motion_probe",
		96
	)

	set_meta(
		"ui_pointer_last_motion_ms",
		now_ms
	)
	set_meta(
		"ui_pointer_last_motion_distance_sq",
		moved_distance_sq
	)
	set_meta(
		"ui_pointer_motion_visual_only",
		_playable_life_shell_pointer_motion_is_visual_only()
	)
	set_meta(
		"ui_pointer_motion_lifecycle_cleanup_called",
		false
	)
	set_meta(
		"ui_pointer_motion_simulation_priority_lease_emitted",
		false
	)
	set_meta(
		"ui_pointer_motion_ui_priority_lease_emitted",
		true
	)
	set_meta(
		"ui_pointer_motion_runtime_guard_mutated",
		false
	)
	set_meta(
		"ui_pointer_motion_background_work_vetoed",
		true
	)
	set_meta(
		"ui_pointer_motion_at_ms",
		now_ms
	)
func _unhandled_input(event: InputEvent) -> void:
	if event == null:
		return

	_mark_ui_interaction_from_event(event)

	if _institution_hub_try_route_scroll_input(event, "mainscene_unhandled_input"):
		get_viewport().set_input_as_handled()
		return

	if _handle_runtime_focus_navigation_input(event):
		get_viewport().set_input_as_handled()
		return

	if event is InputEventKey:
		var key_event:= event as InputEventKey
		if key_event.pressed and not key_event.echo:
			if key_event.keycode == KEY_F8:
				_toggle_realm_contract_debug_panel()
				get_viewport().set_input_as_handled()
func _handle_runtime_focus_navigation_input(event: InputEvent) -> bool:
	if not MainSceneLogic._runtime_focus_navigation_enabled(gs):
		return false

	if event.is_action_pressed("ui_cancel"):
		return _runtime_focus_back()

	if event.is_action_pressed("ui_accept"):
		return _runtime_focus_accept()

	if event.is_action_pressed("ui_down") or event.is_action_pressed("ui_right"):
		return _runtime_focus_step(1)

	if event.is_action_pressed("ui_up") or event.is_action_pressed("ui_left"):
		return _runtime_focus_step(-1)

	return false


func _runtime_focus_step(direction: int) -> bool:
	var focus_owner: Control = get_viewport().gui_get_focus_owner()
	if focus_owner == null or not focus_owner.is_visible_in_tree():
		return _runtime_focus_first()

	if direction >= 0:
		var next_focus: Control = focus_owner.find_next_valid_focus()
		if next_focus != null and next_focus != focus_owner:
			next_focus.grab_focus()
			_runtime_focus_mark(next_focus)
			return true
	else:
		var previous_focus: Control = focus_owner.find_prev_valid_focus()
		if previous_focus != null and previous_focus != focus_owner:
			previous_focus.grab_focus()
			_runtime_focus_mark(previous_focus)
			return true

	return _runtime_focus_first()


func _runtime_focus_first() -> bool:
	var focusables: Array = []
	MainSceneHelpers._collect_runtime_focusable_controls(self, focusables)

	if focusables.is_empty():
		return false

	var first: Control = focusables [0]
	if first == null:
		return false

	first.grab_focus()
	_runtime_focus_mark(first)
	return true


func _runtime_focus_accept() -> bool:
	var focus_owner: Control = get_viewport().gui_get_focus_owner()
	if focus_owner == null:
		return _runtime_focus_first()

	if focus_owner is BaseButton:
		(focus_owner as BaseButton).emit_signal("pressed")
		_runtime_focus_mark(focus_owner)
		return true

	if focus_owner.has_method("pressed"):
		focus_owner.call("pressed")
		_runtime_focus_mark(focus_owner)
		return true

	return false


func _runtime_focus_back() -> bool:
	var close_methods:= [
		"_close_active_popup",
		"_close_topmost_popup",
		"_close_standard_tab_popup",
		"_close_bending_hub",
		"_close_crown_hub",
		"_close_other_countries_overview",
		"_close_overlay_stack"
	]

	for method_name in close_methods:
		if has_method(method_name):
			call(method_name)
			return true

	var focus_owner: Control = get_viewport().gui_get_focus_owner()
	if focus_owner != null:
		focus_owner.release_focus()
		return true

	return false


func _runtime_focus_mark(control: Control) -> void:
	if control == null:
		return

	_mark_ui_interaction_activity("focus_remote_navigation", 240)

	if control.has_method("ensure_control_visible"):
		control.call("ensure_control_visible")
