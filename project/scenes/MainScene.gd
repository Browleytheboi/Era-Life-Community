func _precompute_bending_hub_runtime_surface_cache_for_state(source_gs: GameState, reason: String = "prewarm") -> Dictionary:
	if source_gs == null or source_gs.player == null or source_gs.bending_engine == null:
		return {}

	if typeof(source_gs.scenario_state) != TYPE_DICTIONARY:
		source_gs.scenario_state = {}

	var actor: Person = source_gs.player
	var signature: String = MainSceneHelpers._bending_hub_surface_cache_signature_for_state(source_gs)
	if signature == "":
		return {}

	var clean_reason: String = str(reason).strip_edges().to_lower()
	var force_truth_refresh: bool = clean_reason in [
		"god_mode_life_prewarm",
		"bending_hub_surface_prewarm",
		"bending_hub_deferred_truth_rebuild"
	]

	var existing_raw: Variant = source_gs.scenario_state.get("bending_hub_runtime_surface_cache", {})
	if typeof(existing_raw) == TYPE_DICTIONARY:
		var existing: Dictionary = existing_raw
		if str(existing.get("signature", "")) == signature and not force_truth_refresh:
			return existing.duplicate(true)

	var interactive_request: bool = clean_reason in [
		"cache_miss",
		"bending_hub_open",
		"bending_hub_section_click"
	]

	var runtime_busy: bool = false
	if source_gs == gs:
		runtime_busy = _runtime_interactive_surface_busy()

	if interactive_request or runtime_busy:
		var shell_payloads: Dictionary = {}
		if typeof(existing_raw) == TYPE_DICTIONARY:
			var existing_shell: Dictionary = existing_raw
			var existing_payloads_raw: Variant = existing_shell.get("payloads", {})
			if typeof(existing_payloads_raw) == TYPE_DICTIONARY:
				shell_payloads = (existing_payloads_raw as Dictionary).duplicate(true)

		var shell_cache: Dictionary = {
			"schema": "eralife.bending_hub_runtime_surface_cache",
			"version": 1,
			"signature": signature,
			"reason": reason,
			"actor_id": int(actor.id),
			"year": int(source_gs.year),
			"created_at_ms": int(Time.get_ticks_msec()),
			"payloads": shell_payloads,
			"runtime_truth_deferred_reason": clean_reason,
		}

		source_gs.scenario_state ["bending_hub_runtime_surface_cache"] = shell_cache.duplicate(true)
		source_gs.scenario_state ["bending_hub_runtime_surface_cache_truth_deferred"] = true
		source_gs.scenario_state ["bending_hub_runtime_surface_cache_truth_deferred_reason"] = clean_reason
		source_gs.scenario_state ["bending_hub_runtime_surface_cache_truth_deferred_at_ms"] = int(Time.get_ticks_msec())

		if source_gs == gs:
			call_deferred("_request_bending_hub_surface_prewarm", true)

		return shell_cache

	var payloads: Dictionary = {}

	if source_gs.bending_engine.has_method("get_bending_training_elements"):
		payloads ["training_elements"] = source_gs.bending_engine.get_bending_training_elements(actor)
	if source_gs.bending_engine.has_method("get_bending_awakening_options"):
		payloads ["awakening_elements"] = source_gs.bending_engine.get_bending_awakening_options(actor)
	if source_gs.bending_engine.has_method("get_bending_skill_allocation_rows"):
		payloads ["skill_allocation_rows"] = source_gs.bending_engine.get_bending_skill_allocation_rows(actor)
	if source_gs.bending_engine.has_method("get_available_bending_abilities"):
		payloads ["abilities"] = source_gs.bending_engine.get_available_bending_abilities(actor)
	if source_gs.bending_engine.has_method("get_bending_world_championship_hub_payload"):
		payloads ["world_championship"] = source_gs.bending_engine.get_bending_world_championship_hub_payload(actor)
	if source_gs.bending_engine.has_method("get_agni_kai_championship_payload"):
		payloads ["agni_kai"] = source_gs.bending_engine.get_agni_kai_championship_payload(actor)

	if source_gs.bending_dojo_engine != null and source_gs.bending_dojo_engine.has_method("get_dojo_hub_payload"):
		payloads ["dojo"] = source_gs.bending_dojo_engine.get_dojo_hub_payload(actor, {
			"source": "bending_hub_runtime_surface_cache",
			"reason": reason
		})

	var cache: Dictionary = {
		"schema": "eralife.bending_hub_runtime_surface_cache",
		"version": 1,
		"signature": signature,
		"reason": reason,
		"actor_id": int(actor.id),
		"year": int(source_gs.year),
		"created_at_ms": int(Time.get_ticks_msec()),
		"payloads": payloads,
	}

	source_gs.scenario_state ["bending_hub_runtime_surface_cache"] = cache.duplicate(true)
	source_gs.scenario_state ["bending_hub_runtime_surface_cache_truth_deferred"] = false
	source_gs.scenario_state ["bending_hub_runtime_surface_cache_truth_ready_at_ms"] = int(Time.get_ticks_msec())
	return cache


func _bending_hub_runtime_surface_cache() -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var signature: String = MainSceneHelpers._bending_hub_surface_cache_signature_for_state(gs)
	var cache_raw: Variant = gs.scenario_state.get("bending_hub_runtime_surface_cache", {})
	if typeof(cache_raw) == TYPE_DICTIONARY:
		var cache: Dictionary = cache_raw
		if str(cache.get("signature", "")) == signature:
			return cache.duplicate(true)

	return _precompute_bending_hub_runtime_surface_cache_for_state(gs, "cache_miss")


func _bending_hub_cached_payload(payload_key: String, fallback: Variant = null) -> Variant:
	var clean_key: String = str(payload_key).strip_edges().to_lower()
	var actor: Person = _bending_hub_actor()
	var actor_id: int = int(actor.id) if actor != null else -1

	if clean_key == "world_championship" or clean_key == "agni_kai":
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var direct_cache_raw: Variant = gs.scenario_state.get("bending_hub_runtime_surface_cache", {})
			if typeof(direct_cache_raw) == TYPE_DICTIONARY:
				var direct_cache: Dictionary = direct_cache_raw
				var cached_actor_id: int = int(direct_cache.get("actor_id", -1))
				var actor_cache_matches: bool = actor_id <= 0 or cached_actor_id <= 0 or cached_actor_id == actor_id

				var direct_payloads_raw: Variant = direct_cache.get("payloads", {})
				if actor_cache_matches and typeof(direct_payloads_raw) == TYPE_DICTIONARY:
					var direct_payloads: Dictionary = direct_payloads_raw
					if direct_payloads.has(clean_key):
						var tournament_value: Variant = direct_payloads.get(clean_key)
						if typeof(tournament_value) == TYPE_DICTIONARY:
							var payload_copy: Dictionary = (tournament_value as Dictionary).duplicate(true)
							var payload_actor_id: int = int(payload_copy.get("actor_id", actor_id))
							if actor_id <= 0 or payload_actor_id <= 0 or payload_actor_id == actor_id:
								return payload_copy
						elif typeof(tournament_value) == TYPE_ARRAY:
							return (tournament_value as Array).duplicate(true)
						else:
							return tournament_value

		_request_bending_hub_surface_prewarm(true)
		return _bending_hub_synthetic_tournament_payload(clean_key, fallback)

	var cache: Dictionary = _bending_hub_runtime_surface_cache()
	var payloads_raw: Variant = cache.get("payloads", {})
	if typeof(payloads_raw) != TYPE_DICTIONARY:
		return fallback

	var payloads: Dictionary = payloads_raw
	if not payloads.has(clean_key):
		return fallback

	var value: Variant = payloads.get(clean_key)
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(true)
	return value
func _bending_hub_synthetic_tournament_payload(payload_key: String, fallback: Variant = null) -> Variant:
	if gs == null or gs.player == null:
		return fallback

	var actor: Person = _bending_hub_actor()
	if actor == null:
		actor = gs.player

	var clean_key: String = str(payload_key).strip_edges().to_lower()
	var state: Dictionary = {}
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var state_raw: Variant = gs.scenario_state.get("bending_world_championship", {})
		if typeof(state_raw) == TYPE_DICTIONARY:
			state = (state_raw as Dictionary).duplicate(true)

	var tournaments: Dictionary = {}
	var tournaments_raw: Variant = state.get("tournaments", {})
	if typeof(tournaments_raw) == TYPE_DICTIONARY:
		tournaments = tournaments_raw

	var year_value: int = int(gs.year)
	var actor_age: int = int(actor.age)
	var actor_id: int = int(actor.id)
	var actor_name: String = ("%s %s" % [str(actor.first_name), str(actor.last_name)]).strip_edges()
	var actor_type: String = str(actor.bending_type).strip_edges().to_lower()
	var actor_nation: String = str(actor.bending_nation).strip_edges().to_lower()

	var division: String = "ineligible"
	if actor_age >= 10 and actor_age < 18:
		division = "youth"
	elif actor_age >= 18 and actor_age <= 50:
		division = "adult"
	elif actor_age > 50:
		var gender_text: String = str(actor.gender).strip_edges().to_lower()
		division = "elder_female" if gender_text.begins_with("f") else "elder_male"

	if clean_key == "agni_kai":
		division = "agni_kai"

	var selected_tournament: Dictionary = {}
	var selected_tournament_id: String = ""
	for raw_key in tournaments.keys():
		var key_text: String = str(raw_key)
		var raw_row: Variant = tournaments.get(raw_key, {})
		if typeof(raw_row) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = raw_row
		var row_division: String = str(row.get("division", "")).strip_edges().to_lower()
		var row_status: String = str(row.get("status", "")).strip_edges().to_lower()
		var row_year: int = int(row.get("year", year_value))

		var division_matches: bool = row_division == division or key_text.find(division) >= 0
		var year_matches: bool = row_year == year_value or row_status == "active"
		if division_matches and year_matches:
			selected_tournament = row.duplicate(true)
			selected_tournament_id = key_text
			break

	var bracket: Array = []
	var bracket_raw: Variant = selected_tournament.get("bracket", [])
	if typeof(bracket_raw) == TYPE_ARRAY:
		bracket = bracket_raw.duplicate(true)

	var tournament_status: String = str(selected_tournament.get("status", "")).strip_edges().to_lower()
	var current_round: int = 1
	var found_pending_round: bool = false
	for raw_match in bracket:
		if typeof(raw_match) != TYPE_DICTIONARY:
			continue
		var match_row: Dictionary = raw_match
		if str(match_row.get("status", "pending")).strip_edges().to_lower() != "pending":
			continue
		var match_round: int = int(match_row.get("round", 1))
		if not found_pending_round or match_round < current_round:
			current_round = match_round
			found_pending_round = true

	var actor_status: Dictionary = {
		"status": "none",
		"entry_button_label": "",
		"entry_button_disabled": division == "ineligible",
		"entry_button_tooltip": "Enter or continue this tournament without blocking the UI."
	}

	var can_advance_round: bool = false
	var can_spectate_match: bool = false
	var can_spectate_championship: bool = false

	if tournament_status == "active":
		for raw_match in bracket:
			if typeof(raw_match) != TYPE_DICTIONARY:
				continue

			var match_row: Dictionary = raw_match
			var match_status: String = str(match_row.get("status", "pending")).strip_edges().to_lower()
			if match_status != "pending":
				continue

			var fighter_a_id: int = int(match_row.get("fighter_a_id", -1))
			var fighter_b_id: int = int(match_row.get("fighter_b_id", -1))

			if fighter_a_id == actor_id or fighter_b_id == actor_id:
				actor_status ["status"] = "match_ready"
				actor_status ["entry_button_disabled"] = false
				actor_status ["entry_button_label"] = "Continue Agni Kai" if clean_key == "agni_kai" else "Continue Bending World Championship"
				continue

			if int(match_row.get("round", 1)) == current_round:
				can_advance_round = true
				can_spectate_match = true
				break

	var entry_disabled: bool = bool(actor_status.get("entry_button_disabled", division == "ineligible"))
	var entry_label: String = str(actor_status.get("entry_button_label", "")).strip_edges()
	if entry_label == "":
		if clean_key == "agni_kai":
			entry_label = "Enter the Agni Kai" if not entry_disabled else "Agni Kai Locked — Fire Nation fire benders only"
		else:
			entry_label = "Enter Bending World Championship as %s" % str(actor.first_name) if not entry_disabled else "Enter Bending World Championship — Age 10+"

	if clean_key == "agni_kai":
		var agni_eligible: bool = bool(actor.alive) and actor_nation == "fire nation" and (actor_type == "fire" or actor_type == "avatar")
		var agni_hub_visible: bool = agni_eligible or not selected_tournament.is_empty()
		return {
			"schema": "eralife.agni_kai_championship_hub_payload",
			"version": 3,
			"eligible": agni_eligible,
			"hub_visible": agni_hub_visible,
			"hidden_reason": "" if agni_hub_visible else "Agni Kai is only shown to fire benders living in the Fire Nation.",
			"division": "agni_kai",
			"tournament_id": selected_tournament_id,
			"label": "Agni Kai Championship of Unbreakable Fire",
			"tournament": selected_tournament.duplicate(true),
			"bracket": bracket.duplicate(true),
			"current_round": current_round,
			"actor_tournament_status": actor_status.duplicate(true),
			"entry_button_disabled": not agni_eligible if selected_tournament.is_empty() else entry_disabled,
			"entry_button_label": entry_label,
			"entry_button_tooltip": "A yearly Fire Nation championship where elite fire benders fight for supremacy.",
			"can_advance_round": can_advance_round,
			"can_spectate_match": can_spectate_match,
			"has_active_bracket": tournament_status == "active" and not bracket.is_empty(),
			"bracket_visible": agni_hub_visible and not bracket.is_empty(),
			"advance_button_label": "Advance Agni Kai tournament round",
			"bracket_label": "Agni Kai Bracket"
		}

	var records: Dictionary = {}
	if gs != null and gs.bending_engine != null and gs.bending_engine.has_method("_ensure_bending_duel_records"):
		records = gs.bending_engine.call("_ensure_bending_duel_records", actor)
	elif gs != null and gs.bending_engine != null and gs.bending_engine.has_method("ensure_bending_duel_records"):
		records = gs.bending_engine.call("ensure_bending_duel_records", actor)
	else:
		var records_raw: Variant = actor.get("bending_duel_records")
		if typeof(records_raw) == TYPE_DICTIONARY:
			records = (records_raw as Dictionary).duplicate(true)

	if not records.has("overall"):
		records ["overall"] = { "wins": 0, "losses": 0, "kos": 0, "deaths": 0}
	if not records.has("tournament"):
		records ["tournament"] = { "wins": 0, "losses": 0, "kos": 0, "deaths": 0}
	if not records.has("non_tournament"):
		records ["non_tournament"] = { "wins": 0, "losses": 0, "kos": 0, "deaths": 0}
	if not records.has("championship_title_counts"):
		records ["championship_title_counts"] = {}

	var actor_status_key: String = str(actor_status.get("status", "none")).strip_edges().to_lower()
	var actor_eliminated: bool = actor_status_key == "eliminated"

	return {
		"schema": "eralife.bending_world_championship_hub_payload",
		"version": 11,
		"actor_id": actor_id,
		"actor_name": actor_name,
		"is_avatar": actor_type == "avatar",
		"division": division,
		"records": records.duplicate(true),
		"tournament": selected_tournament.duplicate(true),
		"bracket": bracket.duplicate(true),
		"current_round": current_round,
		"current_round_label": "Round %d" % current_round,
		"current_stage_label": str(selected_tournament.get("label", "Bending World Tournament")),
		"actor_tournament_status": actor_status.duplicate(true),
		"actor_eliminated": actor_eliminated,
		"entry_button_label": entry_label,
		"entry_button_disabled": entry_disabled,
		"entry_button_tooltip": "Tournament controls are rendered from the current state snapshot first; deep records stream later.",
		"can_advance_round": can_advance_round,
		"can_spectate_match": can_spectate_match,
		"can_spectate_championship": can_spectate_championship,
		"championship_spectate_button_label": "Skip to Championship Match",
		"rankings": [],
		"top_benders": { "schema": "eralife.bending_top_benders_shell", "rankings": []},
		"dynasties": state.get("dynasty_records", {}).duplicate(true) if typeof(state.get("dynasty_records", {})) == TYPE_DICTIONARY else {},
		"dynasty_titles": [],
		"bloodline_rivalries": [],
		"previous_avatars": [],
		"previous_avatar_reputation_imprint": {},
		"style_identity": {
			"title": "Competitive Style Forming",
			"description": "The tournament surface is live. Deep style echoes and rankings are deferred so the UI never blocks.",
			"heat": 0
		},
		"media_reactions": state.get("media_reactions", []).duplicate(true) if typeof(state.get("media_reactions", [])) == TYPE_ARRAY else [],
		"tournament_history": {}
	}

func _invalidate_bending_hub_runtime_surface_cache(reason: String = "changed") -> void:
	remove_meta("bending_hub_tournament_payload_signature")
	remove_meta("bending_hub_tournament_payload_cache")
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state.erase("bending_hub_runtime_surface_cache")
		gs.scenario_state ["bending_hub_runtime_surface_cache_invalidated_reason"] = reason
		gs.scenario_state ["bending_hub_runtime_surface_cache_invalidated_at_ms"] = int(Time.get_ticks_msec())
func _food_lifestyle_current_era_name_for_mainscene() -> String:
	if gs != null:
		var year_era_name: String = (
			MainSceneLogic._food_lifestyle_era_name_from_year_for_mainscene(
				int(
					gs.year
				)
			)
		)

		if year_era_name != "":


			return year_era_name

	if (
		gs != null
		and gs.era != null
	):
		var era_raw: Variant = gs.era

		if typeof(
			era_raw
		) == TYPE_DICTIONARY:
			return str(
				(
					era_raw as Dictionary
				).get(
					"name",
					""
				)
			).strip_edges()

		return str(
			gs.era.name
		).strip_edges()

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var scenario_era: String = str(
			gs.scenario_state.get(
				"era_name",
				gs.scenario_state.get(
					"era",
					""
				)
			)
		).strip_edges()

		if scenario_era != "":
			return scenario_era

	if (
		gs != null
		and typeof(
			gs.custom_settings
		) == TYPE_DICTIONARY
	):
		var settings_era: String = str(
			gs.custom_settings.get(
				"era",
				""
			)
		).strip_edges()

		if settings_era != "":
			return settings_era

	return ""


func _food_lifestyle_food_hub_available() -> bool:
	var actor: Person = MainSceneLogic._food_lifestyle_active_actor(gs)
	if not MainSceneHelpers._food_lifestyle_actor_is_old_enough(actor):
		return false

	var era_name: String = _food_lifestyle_current_era_name_for_mainscene()
	return MainSceneLogic._food_lifestyle_era_supports_modern_future_hubs(era_name)

func _food_lifestyle_restaurant_hub_available() -> bool:
	var actor: Person = MainSceneLogic._food_lifestyle_active_actor(gs)
	if not MainSceneHelpers._food_lifestyle_actor_is_old_enough(actor):
		return false

	var era_name: String = _food_lifestyle_current_era_name_for_mainscene()
	return MainSceneLogic._food_lifestyle_era_supports_modern_future_hubs(era_name)
func _enforce_food_lifestyle_hud_era_gate_zero_frame(reason: String = "food_lifestyle_era_gate") -> void:
	var era_name: String = _food_lifestyle_current_era_name_for_mainscene()
	var modern_future_allowed: bool = MainSceneLogic._food_lifestyle_era_supports_modern_future_hubs(era_name)

	if not modern_future_allowed:
		if food_lifestyle_hud_button != null and is_instance_valid(food_lifestyle_hud_button):
			food_lifestyle_hud_button.visible = false
			food_lifestyle_hud_button.disabled = true
			food_lifestyle_hud_button.mouse_filter = Control.MOUSE_FILTER_IGNORE
			food_lifestyle_hud_button.text = "🛒"

		if restaurant_lifestyle_hud_button != null and is_instance_valid(restaurant_lifestyle_hud_button):
			restaurant_lifestyle_hud_button.visible = false
			restaurant_lifestyle_hud_button.disabled = true
			restaurant_lifestyle_hud_button.mouse_filter = Control.MOUSE_FILTER_IGNORE
			restaurant_lifestyle_hud_button.text = "🍔"

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["food_lifestyle_hud_blocked_by_era"] = true
			gs.scenario_state ["food_lifestyle_hud_blocked_era_name"] = era_name
			gs.scenario_state ["food_lifestyle_hud_blocked_reason"] = reason

		return

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["food_lifestyle_hud_blocked_by_era"] = false
		gs.scenario_state ["food_lifestyle_hud_allowed"] = true
		gs.scenario_state ["food_lifestyle_hud_allowed_reason"] = reason
func _food_lifestyle_core_color(surface_id: String = "") -> Color:
	var era_name: String = _food_lifestyle_current_era_name_for_mainscene()
	var clean_surface: String = str(surface_id).strip_edges().to_lower()

	if clean_surface == "food_contract_hub":
		match era_name:
			"Future Era":
				return Color(0.32, 1.0, 0.84, 1.0)
			_:
				return Color(0.44, 0.92, 0.54, 1.0)

	match era_name:
		"Industrial Era":
			return Color(1.0, 0.62, 0.3, 1.0)
		"Future Era":
			return Color(0.42, 0.92, 1.0, 1.0)
		_:
			return Color(1.0, 0.7, 0.3, 1.0)


