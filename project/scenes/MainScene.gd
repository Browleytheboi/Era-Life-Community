func _sync_god_mode_audio_contract(reason: String = "god_mode_panel") -> void:
	if not era_audio_enabled:
		return
	if bool(get_meta("god_mode_audio_fadeout_requested", false)):
		return
	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	_ensure_god_mode_menu_music_tracks_registered()

	var current_track: String = str(engine.current_track_id).strip_edges()
	var track_ids: Array = _god_mode_menu_music_track_ids()
	var report: Dictionary = {}

	if current_track == "" or not track_ids.has(current_track):
		report = _god_mode_menu_music_start_or_rotate(reason, 700, false)
	else:
		_god_mode_menu_music_apply_active_route(current_track)

		var context: Dictionary = _god_mode_audio_context(reason)
		context ["audio_fade_ms"] = 700
		context ["audio_restart_policy"] = "preserve_current"
		context ["god_mode_menu_music_preserve_existing"] = true
		context ["god_mode_menu_music_track_id"] = current_track
		report = engine.apply_audio_contract(era_audio_contract, context)

	set_meta("god_mode_audio_active", bool(report.get("success", false)))
	set_meta("god_mode_audio_last_reason", reason)
	set_meta("god_mode_audio_last_sync_at_ms", int(Time.get_ticks_msec()))
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_audio_contract_last_report"] = report.duplicate(true)
		gs.scenario_state ["god_mode_audio_contract_last_reason"] = reason
		gs.scenario_state ["god_mode_audio_contract_last_sync_at_ms"] = int(Time.get_ticks_msec())

func _fade_out_god_mode_audio_contract(reason: String = "god_mode_exit", fade_ms: int = 520) -> void:
	set_meta("god_mode_audio_fadeout_requested", true)
	set_meta("god_mode_audio_active", false)
	set_meta("god_mode_audio_fadeout_reason", reason)
	set_meta("god_mode_audio_fadeout_at_ms", int(Time.get_ticks_msec()))

	if era_audio_engine == null or not is_instance_valid(era_audio_engine):
		era_audio_last_signature = ""
		era_audio_next_sync_ms = 0
		return

	var context: Dictionary = _god_mode_audio_context(reason)
	var report: Dictionary = era_audio_engine.release_audio_contract(
		"god_mode_music_fade_out_%s" % reason,
		fade_ms,
		context
	)

	era_audio_last_signature = ""
	era_audio_next_sync_ms = 0

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_audio_contract_fadeout_report"] = report.duplicate(true)
		gs.scenario_state ["god_mode_audio_contract_fadeout_reason"] = reason
		gs.scenario_state ["god_mode_audio_contract_fadeout_at_ms"] = int(Time.get_ticks_msec())
func _era_audio_signature_for_context(context: Dictionary) -> String:
	return "%s|%s|%s|%s|%s" % [
		str(context.get("context_key", "")),
		str(context.get("era_key", "")),
