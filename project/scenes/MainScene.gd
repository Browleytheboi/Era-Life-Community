func _schedule_startup_renderer_chassis_step(
	reason: String,
	cursor: int
) -> void:
	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_startup_renderer_chassis_step",
			reason,
			cursor
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_service_startup_renderer_chassis_step"
		).bind(
			reason,
			cursor
		),
		CONNECT_ONE_SHOT
	)


