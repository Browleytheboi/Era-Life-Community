func _on_food_lifestyle_hud_pressed() -> void:
	if not _food_lifestyle_food_hub_available():
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Food Hub",
			"popup_text": "This character needs to be at least 15 and living in the Modern or Future era to open grocery stores.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	_open_contract_surface("food_contract_hub", "stores")

func _on_restaurant_lifestyle_hud_pressed() -> void:
	if not _food_lifestyle_restaurant_hub_available():
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Restaurant Hub",
			"popup_text": "This character needs to be at least 15 and living in the Industrial, Modern, or Future era to open restaurants.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	if gs != null and gs.player != null and gs.food_restaurant_engine != null:
		var has_live_order: bool = false
		var has_active_date: bool = false

		if gs.food_restaurant_engine.has_method("actor_order_has_items"):
			has_live_order = bool(gs.food_restaurant_engine.actor_order_has_items(gs.player))

		if gs.food_restaurant_engine.has_method("actor_has_active_date_turn"):
			has_active_date = bool(gs.food_restaurant_engine.actor_has_active_date_turn(gs.player))

		if not has_live_order and not has_active_date:
			if gs.food_restaurant_engine.has_method("clear_restaurant_session"):
				gs.food_restaurant_engine.clear_restaurant_session(gs.player)

			if gs.ui_contract_engine != null and gs.ui_contract_engine.has_method("sync_surface_state"):
				gs.ui_contract_engine.sync_surface_state("restaurant_contract_hub", MainSceneHelpers._restaurant_lifestyle_empty_surface_state())

	_open_contract_surface("restaurant_contract_hub", "plan")
