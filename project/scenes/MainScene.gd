func _on_household_world_prewarm_pressed() -> void:
	var world_contract: Dictionary = _household_creator_read_world_contract()
	var validation: Dictionary = MainSceneLogic._household_creator_validate_world_contract(gs, world_contract)

	if not bool(validation.get("success", false)):
		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = str(validation.get("reason", "World contract invalid."))
		return

	_household_creator_begin_prewarm_feedback()
	await get_tree().process_frame

	var settings: Dictionary = _household_creator_world_settings(world_contract)
	settings = _apply_god_mode_reality_candidate_to_settings(settings, "prewarm_button_pressed")

	_household_creator_set_prewarm_feedback(0.34, "Anchoring identities...")
	await get_tree().process_frame

	var world_seed: int = MainSceneHelpers._household_creator_resolve_world_seed_from_settings(settings)
	if world_seed <= 0:
		var failure_report:= {
			"schema": "eralife.household_world_seed_prewarm_debug",
			"version": 1,
			"success": false,
			"reason": "world_seed_not_created",
			"settings_world_seed": int(settings.get("world_seed", -1)),
			"world_contract": world_contract.duplicate(true),
			"created_at_ms": int(Time.get_ticks_msec())
		}
		push_error(JSON.stringify(failure_report))
		EraLog.truth(JSON.stringify(failure_report))

		if household_creator_prewarm_button != null and is_instance_valid(household_creator_prewarm_button):
			household_creator_prewarm_button.disabled = false

		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = "World seed was not created. Check Godot output."
		return

	_household_creator_set_prewarm_feedback(0.72, "Stabilizing reality...")
	await get_tree().process_frame

	world_contract ["world_seed"] = world_seed
	world_contract ["seed_contract"] = settings.get("seed_contract", {}).duplicate(true) if typeof(settings.get("seed_contract", {})) == TYPE_DICTIONARY else {}
	world_contract ["_prebirth_reality_candidate"] = settings.get("_prebirth_reality_candidate", {}).duplicate(true) if typeof(settings.get("_prebirth_reality_candidate", {})) == TYPE_DICTIONARY else {}
	world_contract ["_prebirth_reality_candidate_id"] = str(settings.get("_prebirth_reality_candidate_id", ""))

	household_creator_world_contract = world_contract.duplicate(true)
	household_creator_world_prewarmed = true

	var prewarm_report:= {
		"schema": "eralife.household_world_seed_prewarm_debug",
		"version": 1,
		"success": true,
		"world_seed": world_seed,
		"seed_contract": world_contract.get("seed_contract", {}).duplicate(true) if typeof(world_contract.get("seed_contract", {})) == TYPE_DICTIONARY else {},
		"candidate_id": str(world_contract.get("_prebirth_reality_candidate_id", "")),
		"era": str(world_contract.get("era", "")),
		"year": int(world_contract.get("year", 2000)),
		"country": str(world_contract.get("country", "")),
		"city": str(world_contract.get("city", "")),
		"created_at_ms": int(Time.get_ticks_msec())
	}
	EraLog.truth(JSON.stringify(prewarm_report))

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["household_creator_last_world_seed_prewarm_report"] = prewarm_report.duplicate(true)

	_household_creator_set_prewarm_feedback(1.0, "World seed prewarmed. Now add your first adult household member.")
	await get_tree().process_frame

	if household_creator_prewarm_button != null and is_instance_valid(household_creator_prewarm_button):
		household_creator_prewarm_button.disabled = false

	_household_creator_render_member_roster()
func _household_creator_update_family_spawn_policy_buttons() -> void:
	var clean_policy: String = str(household_creator_family_spawn_policy).strip_edges().to_lower()
	if clean_policy not in ["house_is_family", "spawn_with_family"]:
		clean_policy = "house_is_family"
		household_creator_family_spawn_policy = clean_policy

	if household_creator_house_is_family_button != null and is_instance_valid(household_creator_house_is_family_button):
		var selected_house: bool = clean_policy == "house_is_family"
		household_creator_house_is_family_button.text = "✓ House is family" if selected_house else "House is family"
		household_creator_house_is_family_button.disabled = false
		MainSceneHelpers._household_creator_style_choice_button(household_creator_house_is_family_button, selected_house, Color(1.0, 0.72, 0.42, 1.0))

	if household_creator_spawn_with_family_button != null and is_instance_valid(household_creator_spawn_with_family_button):
		var selected_spawn: bool = clean_policy == "spawn_with_family"
		household_creator_spawn_with_family_button.text = "✓ Spawn with family" if selected_spawn else "Spawn with family"
		household_creator_spawn_with_family_button.disabled = false
		MainSceneHelpers._household_creator_style_choice_button(household_creator_spawn_with_family_button, selected_spawn, Color(1.0, 0.72, 0.42, 1.0))
func _household_creator_render_member_roster() -> void:
