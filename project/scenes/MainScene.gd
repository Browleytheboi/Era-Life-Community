func _schedule_spawn_ready_deferred_ui_work(
	reason: String = "spawn_ready",
	_open_tab_on_boot: bool = false
) -> void:
	var queue: Array = []



	if _playable_life_shell_has_visible_sovereignty():
		set_meta(
			"spawn_ready_ui_deferred_work_queue",
			queue
		)
		set_meta(
			"spawn_ready_ui_deferred_work_reason",
			reason
		)
		set_meta(
			"spawn_ready_ui_deferred_work_active",
			false
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_to_contract_authority",
			true
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_reason",
			"visible_shell_residency_owns_observation"
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	if not bool(
		get_meta(
			"spawn_ready_life_packet_background_prewarm_complete",
			false
		)
	):
		queue.append({
			"method": "_prewarm_life_panel_ui_packet",
			"args": [],
			"kind": "packet_cache_only"
		})

	set_meta(
		"spawn_ready_ui_deferred_work_queue",
		queue
	)
	set_meta(
		"spawn_ready_ui_deferred_work_reason",
		reason
	)
	set_meta(
		"spawn_ready_ui_deferred_work_active",
		not queue.is_empty()
	)
	set_meta(
		"spawn_ready_ui_deferred_work_frame_budget_ms",
		1
	)
	set_meta(
		"spawn_ready_ui_deferred_work_shell_safe_only",
		true
	)
	set_meta(
		"spawn_ready_ui_deferred_work_visible_mutation_allowed",
		false
	)

	if queue.is_empty():
		set_meta(
			"spawn_ready_ui_deferred_work_completed_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	var tree:= get_tree()
	if tree == null:
		return

	var timer:= tree.create_timer(2.25)
	timer.timeout.connect(
		Callable(
			self,
			"_run_spawn_ready_deferred_ui_work_tick"
		).bind(
			reason,
			0
		),
		CONNECT_ONE_SHOT
	)
func _run_spawn_ready_deferred_ui_work_tick(
	reason: String = "spawn_ready",
	pass_index: int = 0
) -> void:
	var tree:= get_tree()
	if tree == null:
		set_meta(
			"spawn_ready_ui_deferred_work_active",
			false
		)
		return

	var now_ms: int = int(Time.get_ticks_msec())




	if _playable_life_shell_has_visible_sovereignty():
		set_meta(
			"spawn_ready_ui_deferred_work_active",
			false
		)
		set_meta(
			"spawn_ready_ui_deferred_work_paused_for_visible_shell",
			true
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_to_contract_authority",
			true
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_reason",
			"visible_shell_residency_owns_observation"
		)
		set_meta(
			"spawn_ready_ui_deferred_work_deferred_at_ms",
			now_ms
		)
		return

	if (
		_post_spawn_ui_is_busy_for_prewarm()
		or _ui_interaction_grace_active(now_ms)
	):
		var wait_timer:= tree.create_timer(0.65)
		wait_timer.timeout.connect(
			Callable(
				self,
				"_run_spawn_ready_deferred_ui_work_tick"
			).bind(
				reason,
				pass_index
			),
			CONNECT_ONE_SHOT
		)
		return

	var queue_raw: Variant = get_meta(
		"spawn_ready_ui_deferred_work_queue",
		[]
	)
	var queue: Array = (
		queue_raw
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)

	if queue.is_empty():
		set_meta(
			"spawn_ready_ui_deferred_work_active",
			false
		)
		set_meta(
			"spawn_ready_ui_deferred_work_completed_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	var started_ms: int = int(Time.get_ticks_msec())
	var budget_ms: int = max(
		1,
		int(
			get_meta(
				"spawn_ready_ui_deferred_work_frame_budget_ms",
				1
			)
		)
	)
	var processed: int = 0
	var allowed_shell_safe_methods: Array = [
		"_prewarm_life_panel_ui_packet"
	]

	while not queue.is_empty():
		if (
			processed > 0
			and int(Time.get_ticks_msec()) - started_ms >= budget_ms
		):
			break

		var task_raw: Variant = queue.pop_front()
		if typeof(task_raw) != TYPE_DICTIONARY:
			continue

		var task: Dictionary = task_raw as Dictionary
		var method_name: String = str(
			task.get(
				"method",
				""
			)
		).strip_edges()
		var args_raw: Variant = task.get(
			"args",
			[]
		)
		var args: Array = (
			args_raw
			if typeof(args_raw) == TYPE_ARRAY
			else []
		)

		if method_name == "" or not has_method(method_name):
			continue

		if (
			bool(
				get_meta(
					"spawn_ready_ui_deferred_work_shell_safe_only",
					false
				)
			)
			and method_name not in allowed_shell_safe_methods
		):
			continue

		callv(
			method_name,
			args
		)

		if method_name == "_prewarm_life_panel_ui_packet":
			set_meta(
				"spawn_ready_life_packet_background_prewarm_complete",
				true
			)

		processed += 1

	set_meta(
		"spawn_ready_ui_deferred_work_queue",
		queue
	)
	set_meta(
		"spawn_ready_ui_deferred_work_last_processed",
		processed
	)
	set_meta(
		"spawn_ready_ui_deferred_work_last_elapsed_ms",
		int(Time.get_ticks_msec()) - started_ms
	)
	set_meta(
		"spawn_ready_ui_deferred_work_pass_index",
		pass_index
	)

	if queue.is_empty():
		set_meta(
			"spawn_ready_ui_deferred_work_active",
			false
		)
		set_meta(
			"spawn_ready_ui_deferred_work_completed_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	var next_timer:= tree.create_timer(0.85)
	next_timer.timeout.connect(
		Callable(
			self,
			"_run_spawn_ready_deferred_ui_work_tick"
		).bind(
			reason,
			pass_index + 1
		),
		CONNECT_ONE_SHOT
	)
func _schedule_post_first_frame_god_mode_life_boot(reason: String = "spawn_ready") -> void:
