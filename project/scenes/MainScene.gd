func _god_mode_atomic_shell_cover_should_stay_visible() -> bool:
	if not bool(get_meta("god_mode_atomic_shell_handoff_active", false)):
		return false

	var now_ms: int = int(Time.get_ticks_msec())
	var started_ms: int = int(get_meta("god_mode_atomic_shell_handoff_started_at_ms", 0))
	if started_ms <= 0:
		started_ms = int(get_meta("god_mode_shell_first_handoff_requested_at_ms", now_ms))

	var shell_released: bool = false
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		shell_released = bool(gs.scenario_state.get("spawn_ready_live_ui_shell_released", false)) \
or bool(gs.scenario_state.get("spawn_ready_live_ui_shell_reconciled", false)) \
or bool(gs.scenario_state.get("birth_shell_player_control_released", false)) \
or bool(gs.scenario_state.get("spawn_ready_life_diary_visible", false))

	if shell_released:
		return false

	if now_ms - started_ms > 900:
		return false

	return true


func _god_mode_playable_shell_ready_for_cover_release(reason: String = "spawn_shell") -> bool:
	if gs == null or gs.player == null:
		return false

	var root:= get_node_or_null("UIContainer") as Control
	if root == null or not is_instance_valid(root):
		return false

	root.visible = true

	if output_label == null or not is_instance_valid(output_label):
		return false

	output_label.visible = true
	output_label.scroll_active = true
	output_label.bbcode_enabled = true

	if str(output_label.text).strip_edges() == "":
		if _spawn_ready_life_output_needs_first_paint():
			_paint_spawn_ready_life_diary_shell_first_frame("cover_release_ready_%s" % reason)

	if str(output_label.text).strip_edges() == "":
		return false

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		_ensure_player_stats_overlay()

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		return false

	player_stats_overlay.visible = true

	var nav_report: Dictionary = _repair_god_mode_cover_release_nav_shell(reason)

	if era_border_overlay == null or not is_instance_valid(era_border_overlay) or not era_border_overlay.visible:
		_show_era_border_overlay_for_current_era(true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_playable_shell_ready_for_cover_release"] = true
		gs.scenario_state ["god_mode_playable_shell_ready_for_cover_release_reason"] = reason
		gs.scenario_state ["god_mode_playable_shell_ready_for_cover_release_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["god_mode_cover_release_nav_shell_report"] = nav_report.duplicate(true)
		gs.scenario_state ["god_mode_cover_release_used_core_shell_ready_gate"] = true

	return true


