func _player_stats_overlay_title_label_existing() -> Label:
	if player_stats_root != null and is_instance_valid(player_stats_root):
		var root_title:= player_stats_root.get_node_or_null("TitleLabel") as Label
		if root_title != null and is_instance_valid(root_title):
			return root_title

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		var found_title:= player_stats_overlay.find_child("TitleLabel", true, false) as Label
		if found_title != null and is_instance_valid(found_title):
			return found_title

	return null

