func _refresh_crown_population_ecosystem_surface_from_cached_contract(
	realm_id: int,
	realm_name: String,
	reason: String = "realm_population_cached_surface_refresh"
) -> bool:
	if crown_action_popup_options == null:
		return false

	var current_surface: Control = null

	for raw_child in crown_action_popup_options.get_children():
		var child:= raw_child as Control
		if child == null:
			continue

		if child.has_meta("realm_population_contract_surface") or child.has_meta("realm_population_view_contract"):
			current_surface = child
			break

	var view_contract: Dictionary = {}

	if current_surface != null and current_surface.has_meta("realm_population_view_contract"):
		var contract_raw: Variant = current_surface.get_meta("realm_population_view_contract", {})
		if typeof(contract_raw) == TYPE_DICTIONARY:
			view_contract = (contract_raw as Dictionary).duplicate(true)

	if view_contract.is_empty() and crown_action_popup != null and crown_action_popup.has_meta("realm_population_view_contract"):
		var popup_contract_raw: Variant = crown_action_popup.get_meta("realm_population_view_contract", {})
		if typeof(popup_contract_raw) == TYPE_DICTIONARY:
			view_contract = (popup_contract_raw as Dictionary).duplicate(true)

	if view_contract.is_empty():
		return false

	var resolved_realm_id: int = realm_id
	if resolved_realm_id <= 0:
		resolved_realm_id = int(view_contract.get("realm_id", -1))

	if resolved_realm_id <= 0:
		return false

	var resolved_realm_name: String = str(realm_name).strip_edges()
	if resolved_realm_name == "":
		resolved_realm_name = str(view_contract.get("realm_name", "")).strip_edges()

	if resolved_realm_name == "":
		resolved_realm_name = MainSceneLogic._crown_realm_name(gs, resolved_realm_id)

	if resolved_realm_name == "":
		return false

	_clear_container_children(crown_action_popup_options)

	var surface:= _build_crown_population_ecosystem_surface_node(
		resolved_realm_id,
		resolved_realm_name,
		view_contract,
		reason
	)

	if surface == null:
		return false

	surface.visible = true
	surface.show()
	surface.mouse_filter = Control.MOUSE_FILTER_PASS
	surface.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	surface.size_flags_vertical = Control.SIZE_EXPAND_FILL
	surface.custom_minimum_size = Vector2(0, 0)
	surface.clip_contents = true

	crown_action_popup_options.add_child(surface)

	if crown_action_popup != null:
		crown_action_popup.set_meta("realm_population_view_contract", view_contract.duplicate(true))
		crown_action_popup.set_meta("realm_population_realm_id", resolved_realm_id)
		crown_action_popup.set_meta("realm_population_realm_name", resolved_realm_name)
		crown_action_popup.set_meta("realm_population_cached_surface_refresh_reason", reason)
		crown_action_popup.set_meta("realm_population_cached_surface_refresh_at_ms", int(Time.get_ticks_msec()))
		crown_action_popup.set_meta("realm_population_cached_surface_refresh_is_renderer_only", true)

	if crown_action_popup_title != null:
		crown_action_popup_title.text = "REALM POPULATION • %s" % resolved_realm_name.to_upper()

	if crown_action_popup_status != null:
		crown_action_popup_status.text = "Population Lens: cached surface refreshed from existing view contract. No simulation truth was created."

	return true
func _crown_population_build_graph_contracts_for_group(out: Dictionary, people: Array, visible_entity_ids: Dictionary, realm_id: int, realm_name: String, section_kind: String, element: String = "") -> void:
	if gs == null or gs.relationship_graph_contract_engine == null:
		return

	if not gs.relationship_graph_contract_engine.has_method("population_hover_contract_for_person"):
		return

	for raw_person in people:
		var person: Person = raw_person
		if person == null or not person.alive:
			continue

		var entity_id: String = MainSceneHelpers._crown_population_entity_id_for_person(person)
		if entity_id == "":
			continue

		var contract: Dictionary = gs.relationship_graph_contract_engine.population_hover_contract_for_person(
			person,
			visible_entity_ids,
			{
				"source": "crown_population_wall",
				"realm_id": realm_id,
				"realm_name": realm_name,
				"section_kind": section_kind,
				"element": element,
				"role_label": _crown_population_role_label(person, realm_id, section_kind, element),
				"ui_is_renderer_only": true,
				"hover_zero_engine_calls": true
			}
		)

		if contract.is_empty():
			continue

		out [entity_id] = contract.duplicate(true)


func _prime_crown_population_graph_render_pass(view_contract: Dictionary, accent: Color) -> void:
	if crown_action_popup == null:
		return

	_clear_crown_population_graph_lines_only()

	crown_action_popup.set_meta("crown_population_graph_nodes", {})
