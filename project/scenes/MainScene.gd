			"target_person_id": int(row.get("person_id", -1)),
			"target_name": str(row.get("name", "Target"))
		})

	if actions.is_empty():
		actions.append({
			"label": "No valid targets.",
			"disabled": true,
			"disabled_reason": "No living NPCs are available."
