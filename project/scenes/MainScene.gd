func _apply_god_mode_slider_visual_state(slider: HSlider, value_label: Label, state: String) -> void:
	if slider == null:
		return
	var ratio:= 0.0
	var slider_range:= slider.max_value - slider.min_value
	if slider_range > 0.0:
		ratio = clamp((slider.value - slider.min_value) / slider_range, 0.0, 1.0)
	var profile:= god_mode_presentation_profile
	if profile.is_empty():
		profile = _build_god_mode_presentation_profile()
	var slider_energy:= float(profile.get("slider_energy", 1.0))
	var accent: Color = Color(profile.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
	var accent_soft: Color = Color(profile.get("accent_soft", Color(0.32, 0.16, 0.5, 0.98)))
	var stat_palette:= MainSceneHelpers._get_god_mode_slider_palette(slider)
	var stat_core: Color = Color(stat_palette.get("core", accent))
	var stat_soft: Color = Color(stat_palette.get("soft", accent_soft))
	var stat_glow: Color = Color(stat_palette.get("glow", Color(0.62, 0.28, 0.9, 0.24)))
	var stat_label_base: Color = Color(stat_palette.get("label", Color(1.0, 0.96, 0.8, 1.0)))
	var track_shadow_color: Color = Color(profile.get("slider_track_shadow", Color(0.2, 0.1, 0.36, 0.16))).lerp(stat_glow, 0.45)

	var emotion_profile: Dictionary = {}
	if slider.has_meta("god_mode_emotion_profile"):
		var emotion_raw: Variant = slider.get_meta("god_mode_emotion_profile")
		if typeof(emotion_raw) == TYPE_DICTIONARY:
			emotion_profile = emotion_raw

	var visual_duration:= 0.1
	var base_fill:= stat_soft.lerp(stat_core, 0.52 + (ratio * 0.22))
	base_fill = base_fill.lerp(accent, 0.18)
	var idle_fill:= base_fill
	var hover_fill:= base_fill.lerp(stat_core.lightened(0.16), 0.2)
	var active_fill:= base_fill.lerp(stat_core.lightened(0.24), 0.34)
	var intro_fill:= base_fill.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.3)
	var track_color:= Color(0.11, 0.06, 0.17, 0.92).lerp(stat_soft.darkened(0.28), 0.52).lerp(accent_soft, 0.16)
	var border_color:= stat_core.lerp(accent, 0.2)
	var fill_color:= idle_fill
	var slider_scale:= Vector2.ONE
	var label_scale:= Vector2.ONE
	var slider_modulate:= Color(1.0, 1.0, 1.0, 1.0)
	var label_color:= stat_label_base

	match state:
		"intro":
			fill_color = intro_fill
			track_color = Color(0.16, 0.09, 0.24, 0.98).lerp(stat_soft.darkened(0.18), 0.44)
			border_color = stat_core.lightened(0.26).lerp(accent, 0.18)
			slider_scale = Vector2(1.0, 1.1)
			label_scale = Vector2(1.1, 1.1)
			slider_modulate = Color(1.0, 1.0, 1.0, 1.0)
			label_color = stat_label_base.lightened(0.12)
		"hover":
			fill_color = hover_fill
			track_color = Color(0.13, 0.07, 0.2, 0.94).lerp(stat_soft.darkened(0.2), 0.4)
			border_color = stat_core.lightened(0.1).lerp(accent, 0.14)
			slider_scale = Vector2(1.0, 1.04)
			label_scale = Vector2(1.03, 1.03)
			slider_modulate = Color(1.0, 1.0, 1.0, 1.0)
			label_color = stat_label_base.lightened(0.04)
		"active":
			fill_color = active_fill
			track_color = Color(0.16, 0.09, 0.24, 0.98).lerp(stat_soft.darkened(0.14), 0.46)
			border_color = stat_core.lightened(0.18).lerp(accent, 0.16)
			slider_scale = Vector2(1.0, 1.08)
			label_scale = Vector2(1.08, 1.08)
			slider_modulate = Color(1.0, 1.0, 1.0, 1.0)
			label_color = stat_label_base.lightened(0.1)
		_:
			fill_color = idle_fill
			track_color = Color(0.11, 0.06, 0.17, 0.92).lerp(stat_soft.darkened(0.28), 0.52).lerp(accent_soft, 0.16)
			border_color = stat_core.lerp(accent, 0.2)
			slider_scale = Vector2.ONE
			label_scale = Vector2.ONE
			slider_modulate = Color(0.98, 0.98, 1.0, 1.0)
			label_color = stat_label_base

	if state == "active" and not emotion_profile.is_empty():
		var emotion_strength: float = clamp(float(emotion_profile.get("strength", 0.0)), 0.0, 1.0)
		var emotion_fill: Color = Color(emotion_profile.get("fill_target", fill_color))
		var emotion_track: Color = Color(emotion_profile.get("track_target", track_color))
		var emotion_border: Color = Color(emotion_profile.get("border_target", border_color))
		var emotion_glow: Color = Color(emotion_profile.get("glow_target", track_shadow_color))
		var emotion_label: Color = Color(emotion_profile.get("label_target", label_color))
		var emotion_modulate: Color = Color(emotion_profile.get("modulate_target", slider_modulate))

		fill_color = fill_color.lerp(
			emotion_fill,
			clamp(float(emotion_profile.get("fill_mix", 0.2)) * emotion_strength, 0.0, 1.0)
		)
		track_color = track_color.lerp(
			emotion_track,
			clamp(float(emotion_profile.get("track_mix", 0.16)) * emotion_strength, 0.0, 1.0)
		)
		border_color = border_color.lerp(
			emotion_border,
			clamp(float(emotion_profile.get("border_mix", 0.2)) * emotion_strength, 0.0, 1.0)
		)
		track_shadow_color = track_shadow_color.lerp(
			emotion_glow,
			clamp(float(emotion_profile.get("glow_mix", 0.28)) * emotion_strength, 0.0, 1.0)
		)
		label_color = label_color.lerp(
			emotion_label,
			clamp(float(emotion_profile.get("label_mix", 0.18)) * emotion_strength, 0.0, 1.0)
		)
		slider_modulate = slider_modulate.lerp(
			emotion_modulate,
			clamp(float(emotion_profile.get("modulate_mix", 0.05)) * emotion_strength, 0.0, 1.0)
		)

		slider_scale.x += float(emotion_profile.get("scale_x_boost", 0.0)) * emotion_strength
		slider_scale.y += float(emotion_profile.get("scale_y_boost", 0.0)) * emotion_strength
		label_scale += Vector2.ONE * (float(emotion_profile.get("label_scale_boost", 0.0)) * emotion_strength)
		visual_duration = max(0.08, float(emotion_profile.get("duration", 0.1)))

	slider_scale.y = lerp(1.0, slider_scale.y, slider_energy)
	label_scale = Vector2.ONE.lerp(label_scale, slider_energy)

	slider.add_theme_stylebox_override(
		"slider",
		MainSceneHelpers._build_god_mode_slider_track_style(
			track_color,
			border_color,
			track_shadow_color
		)
	)
	slider.add_theme_stylebox_override(
		"grabber_area",
		MainSceneHelpers._build_god_mode_slider_track_style(
			fill_color,
			stat_core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.12),
			stat_glow
		)
	)
	slider.add_theme_stylebox_override(
		"grabber_area_highlight",
		MainSceneHelpers._build_god_mode_slider_track_style(
			fill_color.lightened(0.08),
			stat_core.lightened(0.18),
			stat_glow.lightened(0.06)
		)
	)

	var slider_tween: Tween = null
	if slider.has_meta("god_mode_slider_visual_tween"):
		var existing_slider_tween = slider.get_meta("god_mode_slider_visual_tween")
		if existing_slider_tween is Tween:
			slider_tween = existing_slider_tween

	if slider_tween != null:
		slider_tween.kill()
	slider_tween = create_tween()
	slider.set_meta("god_mode_slider_visual_tween", slider_tween)
	slider_tween.set_trans(Tween.TRANS_SINE)
	slider_tween.set_ease(Tween.EASE_OUT)
	slider_tween.tween_property(slider, "scale", slider_scale, visual_duration)
	slider_tween.parallel().tween_property(slider, "self_modulate", slider_modulate, visual_duration)

	if value_label != null:
		value_label.add_theme_color_override("font_color", label_color)
		var label_tween: Tween = null
		if value_label.has_meta("god_mode_slider_label_tween"):
			var existing_label_tween = value_label.get_meta("god_mode_slider_label_tween")
			if existing_label_tween is Tween:
				label_tween = existing_label_tween
		if label_tween != null:
			label_tween.kill()
		label_tween = create_tween()
		value_label.set_meta("god_mode_slider_label_tween", label_tween)
		label_tween.set_trans(Tween.TRANS_SINE)
		label_tween.set_ease(Tween.EASE_OUT)
		label_tween.tween_property(value_label, "scale", label_scale, visual_duration)
		label_tween.parallel().tween_property(
			value_label,
			"self_modulate",
			Color(1.0, 1.0, 1.0, 1.0),
			visual_duration
		)

func _populate_option_button(button: OptionButton, items: Array, preferred_text:= "") -> void:
	if button == null:
		return

	button.clear()

	var selected_idx:= 0
	var preferred:= str(preferred_text)

	for i in range(items.size()):
		var text:= str(items [i])
		button.add_item(text)
		if preferred != "" and text.to_lower() == preferred.to_lower():
			selected_idx = i

	if button.item_count > 0:
		button.select(selected_idx)

	if button == custom_country_picker:
		_decorate_country_picker_elemental_nation_items(button)
		_style_god_mode_option_button(button)
func _populate_era_picker(preferred_text:= "", include_blank:= false) -> void:
	if custom_era_picker == null:
		return

	var items: Array = _era_keys_for_picker()
	custom_era_picker.clear()

	if include_blank:
		custom_era_picker.add_item("")

	for item in items:
		custom_era_picker.add_item(str(item))

	if include_blank and preferred_text == "":
		custom_era_picker.select(0)
		return

	var selected_idx:= 0
	var offset:= 1 if include_blank else 0
	var preferred:= str(preferred_text)

	for i in range(items.size()):
		if str(items [i]).to_lower() == preferred.to_lower():
			selected_idx = i + offset
			break

	if custom_era_picker.item_count > 0:
		custom_era_picker.select(selected_idx)



func _has_valid_birth_year_input() -> bool:
	if custom_year_line_edit != null:
		var parsed:= MainSceneHelpers._parse_birth_year_text(custom_year_line_edit.text)
		return bool(parsed.get("valid", false))
	if custom_year_spin != null:
		return true
	return false


func _has_valid_last_name_input() -> bool:
	if custom_last_name_input == null:
		return false

	return custom_last_name_input.text.strip_edges().length() >= 2


func _current_preview_first_name() -> String:
	var fallback:= str(gs.custom_settings.get("first_name", "Acrello"))

	if custom_first_name_input != null:
		var typed:= custom_first_name_input.text.strip_edges()
		if typed != "":
			return typed

	return fallback


func _current_preview_last_name() -> String:
	var fallback:= str(gs.custom_settings.get("last_name", "IsBack"))

	if custom_last_name_input != null:
		var typed:= custom_last_name_input.text.strip_edges()
		if typed != "":
			return typed

	return fallback


func _current_preview_era_name() -> String:
	var era_key:= _selected_era_key()
	if era_key == "":
		return ""

	var era_engine:= _get_ui_era_engine()
	if era_engine != null and era_engine.eras.has(era_key):
		return str(era_engine.eras [era_key].get("name", era_key))

	return era_key
