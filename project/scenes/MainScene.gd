func _boxing_hub_growth_level_strip_width(level_count: int = 20) -> float:
	var clean_count: int = max(1, int(level_count))
	var box_size: Vector2 = _boxing_hub_growth_level_box_size()
	var gap_width: float = MainSceneHelpers._boxing_hub_growth_box_gap()
	return (float(clean_count) * box_size.x) + (float(max(0, clean_count - 1)) * gap_width)


func _boxing_hub_growth_level_box_size() -> Vector2:
	var viewport_width: float = get_viewport_rect().size.x
	var reserved_width: float = MainSceneHelpers._boxing_hub_growth_skill_label_width() + MainSceneHelpers._boxing_hub_growth_cost_column_width() + 150.0
	var usable_width: float = max(460.0, viewport_width - reserved_width)
	var dynamic_width: float = floor((usable_width - (19.0 * MainSceneHelpers._boxing_hub_growth_box_gap())) / 20.0)
	return Vector2(clamp(dynamic_width, 24.0, 36.0), 22.0)


func _boxing_hub_growth_row_track_width(level_count: int = 20) -> float:
	return MainSceneHelpers._boxing_hub_growth_skill_label_width() + 8.0 + _boxing_hub_growth_level_strip_width(level_count) + 14.0


func _boxing_hub_growth_board_width(board: Dictionary = {}) -> float:
	var level_count: int = 20
	if typeof(board) == TYPE_DICTIONARY and not board.is_empty():
		level_count = max(1, int(board.get("max_skill_level", 20)))

	var raw_width: float = _boxing_hub_growth_row_track_width(level_count) + 8.0 + MainSceneHelpers._boxing_hub_growth_cost_column_width()
	var viewport_width: float = get_viewport_rect().size.x
	var max_safe_width: float = max(760.0, viewport_width - 112.0)

	return min(raw_width, max_safe_width)


func _boxing_hub_growth_board_scroll_height() -> float:
	var viewport_size: Vector2 = get_viewport_rect().size
	return clamp(viewport_size.y - 310.0, 300.0, 520.0)

func _boxing_hub_make_growth_level_box(skill_row: Dictionary, box_data: Dictionary, visual_contract: Dictionary) -> Button:
	var box_state: String = str(box_data.get("state", "available")).strip_edges().to_lower()
	var target_level: int = int(box_data.get("level", 1))
	var skill_key: String = str(skill_row.get("key", "")).strip_edges()
	var skill_label: String = str(skill_row.get("label", skill_key)).strip_edges()
	var cost_to_reach: int = int(box_data.get("cost_to_reach", 0))
	var can_select: bool = bool(box_data.get("can_select", false))
	var box_size: Vector2 = _boxing_hub_growth_level_box_size()

	var cell:= Button.new()
	cell.text = "★" if bool(box_data.get("is_milestone", false)) else ""
	cell.custom_minimum_size = box_size
	cell.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	cell.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cell.focus_mode = Control.FOCUS_NONE
	cell.clip_text = true
	cell.add_theme_font_size_override("font_size", 9)
	cell.add_theme_color_override("font_color", Color(1.0, 0.92, 0.35, 1.0))
	cell.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.95))
	cell.add_theme_constant_override("shadow_offset_x", 1)
	cell.add_theme_constant_override("shadow_offset_y", 1)

	var visual_state: String = box_state
	if box_state == "unaffordable" or box_state == "capped":
		visual_state = "locked"

	cell.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, visual_state))
	cell.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "%s_hover" % visual_state))
	cell.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "%s_pressed" % visual_state))
	cell.add_theme_stylebox_override("focus", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "%s_hover" % visual_state))

	if box_state == "filled":
		cell.mouse_default_cursor_shape = Control.CURSOR_ARROW
		cell.tooltip_text = "%s level %d already owned." % [skill_label, target_level]
		return cell

	cell.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	if can_select:
		cell.tooltip_text = "Spend %d XP to upgrade %s to level %d." % [cost_to_reach, skill_label, target_level]

		var action_data: Dictionary = {
			"label": "Upgrade %s to Lv. %d" % [skill_label, target_level],
			"command": "boxing.growth.upgrade",
			"args": {
				"skill": skill_key,
				"target_level": target_level
			},
			"refresh_tab": "growth",
			"suppress_popup": true,
			"suppress_diary": true,
			"preserve_hub_surface": true
		}

		cell.pressed.connect(_on_boxing_hub_action_pressed.bind(action_data, "growth"))
		_boxing_hub_bind_hover_motion(cell, 1.065)
		return cell

	var locked_reason: String = str(box_data.get("locked_reason", "")).strip_edges()
	if locked_reason == "":
		locked_reason = "Not enough XP or build space."

	cell.tooltip_text = locked_reason
	cell.pressed.connect(func ():
		_boxing_hub_flash_growth_level_box_blocked(cell, visual_contract)
	)

	return cell
func _boxing_hub_flash_growth_level_box_blocked(cell: Button, visual_contract: Dictionary) -> void:
	if cell == null or not is_instance_valid(cell):
		return

	cell.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "blocked_flash"))
	cell.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "blocked_flash"))
	cell.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "blocked_flash"))
	cell.add_theme_stylebox_override("focus", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "blocked_flash"))

	var tween:= create_tween()
	tween.bind_node(cell)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(cell, "modulate", Color(1.0, 0.42, 0.34, 1.0), 0.055)
	tween.tween_property(cell, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.12)
	tween.tween_callback(func ():
		if cell == null or not is_instance_valid(cell):
			return
		cell.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "locked"))
		cell.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "locked_hover"))
		cell.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "locked_pressed"))
		cell.add_theme_stylebox_override("focus", MainSceneHelpers._boxing_hub_growth_level_box_style(visual_contract, "locked_hover"))
	)

func _on_boxing_hub_action_pressed(action_data: Dictionary, fallback_tab: String = "fight") -> void:
	if gs == null or gs.player == null:
		return

	var label: String = str(action_data.get("label", "")).strip_edges()
	var command_id: String = str(action_data.get("command", "")).strip_edges()
	var refresh_tab: String = str(action_data.get("refresh_tab", fallback_tab)).strip_edges()
	var args: Dictionary = action_data.get("args", {}) if typeof(action_data.get("args", {})) == TYPE_DICTIONARY else {}
	var suppress_popup: bool = bool(action_data.get("suppress_popup", false))
	var suppress_diary: bool = bool(action_data.get("suppress_diary", false))
	var preserve_hub_surface: bool = bool(action_data.get("preserve_hub_surface", false)) or boxing_hub_open

	var result: Dictionary = {}

	if gs.boxing_contract_engine != null:
		if command_id != "" and gs.boxing_contract_engine.has_method("run_command"):
			result = gs.boxing_contract_engine.run_command(command_id, gs.player, args)
		elif gs.boxing_contract_engine.has_method("run_action_label"):
			result = gs.boxing_contract_engine.run_action_label(label, gs.player, args)

	if result.is_empty():
		result = {
			"success": false,
			"text": "That boxing action is not available right now."
		}

	if str(result.get("type", "")).strip_edges() == "open_boxing_gym_hub":
		var gym_tab: String = str(result.get("gym_tab", "common")).strip_edges()
		if gym_tab == "":
			gym_tab = "common"
		_show_boxing_gym_hub_panel(gym_tab)
		suppress_popup = true
		suppress_diary = true

	var result_text: String = str(result.get("text", "")).strip_edges()
	if result_text != "":
		if not suppress_diary and not bool(result.get("suppress_diary", false)):
			_append_text_to_diary(result_text, false)
		if not suppress_popup and not bool(result.get("suppress_popup", false)):
			_maybe_show_action_result_popup(result)

	if not preserve_hub_surface:
		_render_life_diary_panel()
		_update_player_stats_overlay()
		_update_boxing_hud()

	if bool(result.get("close_hub", false)):
		boxing_hub_open = false
		if boxing_hub_popup != null and is_instance_valid(boxing_hub_popup):
			boxing_hub_popup.hide()
		_update_boxing_hud()
		_sync_runtime_floating_hud_layering()
		return

	if refresh_tab == "":
		refresh_tab = fallback_tab

	_show_boxing_hub_panel(refresh_tab)

	if preserve_hub_surface:
		_boxing_hub_apply_desktop_fullscreen_bounds()
		_bring_modal_to_front(boxing_hub_popup)
		_sync_runtime_floating_hud_layering()
func _force_era_border_overlay_to_viewport(reason: String = "viewport_layout") -> void:
	if era_border_overlay == null or not is_instance_valid(era_border_overlay):
		return

	var viewport_size: Vector2 = get_viewport_rect().size
	if viewport_size.x <= 0.0 or viewport_size.y <= 0.0:
		return

	era_border_overlay.top_level = true
	era_border_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	era_border_overlay.global_position = Vector2.ZERO
	era_border_overlay.position = Vector2.ZERO
	era_border_overlay.size = viewport_size
	era_border_overlay.custom_minimum_size = viewport_size
	era_border_overlay.offset_left = 0.0
	era_border_overlay.offset_top = 0.0
	era_border_overlay.offset_right = 0.0
	era_border_overlay.offset_bottom = 0.0
	era_border_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	era_border_overlay.process_mode = Node.PROCESS_MODE_INHERIT
	era_border_overlay.z_as_relative = false
	era_border_overlay.z_index = 900
	era_border_overlay.set_meta("era_border_viewport_owned", true)
	era_border_overlay.set_meta("era_border_viewport_owned_reason", reason)
	era_border_overlay.set_meta("era_border_viewport_owned_size", viewport_size)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["era_border_viewport_owned"] = true
		gs.scenario_state ["era_border_viewport_owned_reason"] = reason
		gs.scenario_state ["era_border_viewport_owned_width"] = viewport_size.x
		gs.scenario_state ["era_border_viewport_owned_height"] = viewport_size.y
func _presentation_physical_viewport_size() -> Vector2:
	var root_window: Window = get_window()

	if root_window != null:
		var window_size: Vector2 = Vector2(
			float(root_window.size.x),
			float(root_window.size.y)
		)

		if (
			window_size.x > 0.0
			and window_size.y > 0.0
		):
			return window_size

	var fallback_size: Vector2 = (
		get_viewport_rect().size
	)

	return Vector2(
		maxf(
			1.0,
			fallback_size.x
		),
		maxf(
			1.0,
			fallback_size.y
		)
	)


func _presentation_density_context(
	reason: String = "viewport_resize"
) -> Dictionary:
	var physical_size: Vector2 = (
		_presentation_physical_viewport_size()
	)

	return {
		"physical_viewport_width": physical_size.x,
		"physical_viewport_height": physical_size.y,

		"viewport_width": physical_size.x,
		"viewport_height": physical_size.y,

		"safe_inset_left": 0.0,
		"safe_inset_top": 0.0,
		"safe_inset_right": 0.0,
		"safe_inset_bottom": 0.0,

		"platform": OS.get_name(),
		"display_server": DisplayServer.get_name(),

		"source": reason,
		"desktop_presentation": true,
		"ui_is_expression_only": true
	}


func _resolve_presentation_density_contract(
	reason: String = "viewport_resize"
) -> Dictionary:
	var physical_size: Vector2 = (
		_presentation_physical_viewport_size()
	)

	var physical_signature: String = (
		"%d:%d"
		% [
			int(round(physical_size.x)),
			int(round(physical_size.y))
		]
	)

	if (
		physical_signature
		== ui_presentation_density_physical_signature
		and not ui_presentation_density_contract.is_empty()
	):
		return (
			ui_presentation_density_contract
			.duplicate(true)
		)

	if gs == null:
		return (
			ui_presentation_density_contract
			.duplicate(true)
		)

	var context: Dictionary = (
		_presentation_density_context(
			reason
		)
	)

	var contract: Dictionary = (
		_request_runtime_engine_method_intent(
			"ui_contract_engine",
			"resolve_presentation_density_contract",
			[
				context
			],
			"resolve_presentation_density:%s"
			% physical_signature,
			"mainscene.presentation_density",
			true
		)
	)

	if (
		str(
			contract.get(
				"schema",
				""
			)
		)
		!= "eralife.presentation_density_contract"
	):
		return (
			ui_presentation_density_contract
			.duplicate(true)
		)

	if int(
		contract.get(
			"version",
			0
		)
	) != 1:
		return (
			ui_presentation_density_contract
			.duplicate(true)
		)

	ui_presentation_density_contract = (
		contract.duplicate(true)
	)

	ui_presentation_density_physical_signature = (
		physical_signature
	)

	return (
		ui_presentation_density_contract
		.duplicate(true)
	)
func _resolve_presentation_composition_contract(
	density_contract: Dictionary,
	reason: String = "viewport_resize"
) -> Dictionary:
	if density_contract.is_empty():
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	var logical_raw: Variant = (
		density_contract.get(
			"logical_viewport",
			{}
		)
	)

	if typeof(logical_raw) != TYPE_DICTIONARY:
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	var logical_viewport: Dictionary = (
		logical_raw as Dictionary
	)

	var logical_width: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"width",
				0.0
			)
		)
	)

	var logical_height: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"height",
				0.0
			)
		)
	)

	var aspect_ratio: float = float(
		density_contract.get(
			"aspect_ratio",
			logical_width / logical_height
		)
	)

	var aspect_profile: String = str(
		density_contract.get(
			"aspect_profile",
			"standard"
		)
	).strip_edges().to_lower()

	var logical_signature: String = (
		"%d:%d:%s"
		% [
			int(round(logical_width)),
			int(round(logical_height)),
			aspect_profile
		]
	)

	if (
		logical_signature
		== ui_presentation_composition_logical_signature
		and not ui_presentation_composition_contract.is_empty()
	):
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	if gs == null:
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	var context: Dictionary = {
		"logical_viewport_width": logical_width,
		"logical_viewport_height": logical_height,
		"aspect_ratio": aspect_ratio,
		"aspect_profile": aspect_profile,
		"source": reason,
		"desktop_presentation": true,
		"ui_is_expression_only": true
	}

	var contract: Dictionary = (
		_request_runtime_engine_method_intent(
			"ui_contract_engine",
			"resolve_presentation_composition_contract",
			[
				context
			],
			"resolve_presentation_composition:%s"
			% logical_signature,
			"mainscene.presentation_composition",
			true
		)
	)

	if (
		str(
			contract.get(
				"schema",
				""
			)
		)
		!= "eralife.presentation_composition_contract"
	):
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	if int(
		contract.get(
			"version",
			0
		)
	) != 1:
		return (
			ui_presentation_composition_contract
			.duplicate(true)
		)

	ui_presentation_composition_contract = (
		contract.duplicate(true)
	)

	ui_presentation_composition_logical_signature = (
		logical_signature
	)

	return (
		ui_presentation_composition_contract
		.duplicate(true)
	)

func _apply_presentation_density_contract_to_window(
	contract: Dictionary,
	reason: String = "viewport_resize"
) -> void:
	if contract.is_empty():
		return

	var logical_raw: Variant = (
		contract.get(
			"logical_viewport",
			{}
		)
	)

	if typeof(logical_raw) != TYPE_DICTIONARY:
		return

	var logical_viewport: Dictionary = (
		logical_raw as Dictionary
	)

	var logical_width: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"width",
				0.0
			)
		)
	)

	var logical_height: float = maxf(
		1.0,
		float(
			logical_viewport.get(
				"height",
				0.0
			)
		)
	)

	var target_size:= Vector2i(
		maxi(
			1,
			int(round(logical_width))
		),
		maxi(
			1,
			int(round(logical_height))
		)
	)

	var ui_scale: float = float(
		contract.get(
			"ui_scale",
			1.0
		)
	)

	var applied_signature: String = (
		"%d:%d:%.2f"
		% [
			target_size.x,
			target_size.y,
			ui_scale
		]
	)

	if (
		applied_signature
		== ui_presentation_density_applied_signature
	):
		return

	var root_window: Window = get_window()

	if root_window == null:
		return

	ui_presentation_density_applied_signature = (
		applied_signature
	)

	var previous_resize_guard: bool = (
		ui_presentation_density_resize_guard
	)

	ui_presentation_density_resize_guard = true

	root_window.content_scale_mode = (
		Window.CONTENT_SCALE_MODE_CANVAS_ITEMS
	)

	root_window.content_scale_aspect = (
		Window.CONTENT_SCALE_ASPECT_EXPAND
	)

	root_window.content_scale_stretch = (
		Window.CONTENT_SCALE_STRETCH_FRACTIONAL
	)

	root_window.content_scale_factor = 1.0
	root_window.content_scale_size = target_size

	ui_presentation_density_resize_guard = (
		previous_resize_guard
	)

	set_meta(
		"presentation_density_last_reason",
		reason
	)

	set_meta(
		"presentation_density_ui_scale",
		ui_scale
	)

	set_meta(
		"presentation_density_logical_viewport",
		target_size
	)
func _refresh_presentation_density_contract(
	reason: String = "viewport_resize"
) -> Dictionary:
	var contract: Dictionary = (
		_resolve_presentation_density_contract(
			reason
		)
	)

	if contract.is_empty():
		return {}

	_apply_presentation_density_contract_to_window(
		contract,
		reason
	)

	_resolve_presentation_composition_contract(
		contract,
		reason
	)

	return contract
func _repair_playable_life_shell_after_viewport_resize(
	reason: String = "viewport_resize"
) -> void:
	_refresh_presentation_density_contract(
		reason
	)

	_apply_presentation_composition_to_resident_surfaces(
		reason
	)

	if gs == null or gs.player == null:
		return

	var playable_shell_visible: bool = bool(
		get_meta(
			"upgraded_playable_life_shell_surface_sealed",
			false
		)
	)

	playable_shell_visible = (
		playable_shell_visible
		or bool(
			get_meta(
				"prewarmed_capsule_entry_shell_first",
				false
			)
		)
	)

	playable_shell_visible = (
		playable_shell_visible
		or bool(
			get_meta(
				"playable_life_shell_owns_fullscreen_era_border",
				false
			)
		)
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		playable_shell_visible = (
			playable_shell_visible
			or bool(
				gs.scenario_state.get(
					"main_gameplay_ui_visible",
					false
				)
			)
		)

		playable_shell_visible = (
			playable_shell_visible
			or bool(
				gs.scenario_state.get(
					"playable_life_surface_has_visual_authority",
					false
				)
			)
		)

		playable_shell_visible = (
			playable_shell_visible
			or bool(
				gs.scenario_state.get(
					"playable_life_shell_owns_fullscreen_era_border",
					false
				)
			)
		)

	if not playable_shell_visible:
		return

	_bind_ui_nav_buttons()
	_apply_centered_live_layout()
	_apply_ui_nav_button_visuals()

	_ensure_era_border_overlay()
	_force_era_border_overlay_to_viewport(
		reason
	)
	_show_era_border_overlay_for_current_era(
		false
	)
	_layout_era_border_overlay()

	if (
		era_border_overlay != null
		and is_instance_valid(
			era_border_overlay
		)
	):
		era_border_overlay.visible = true

		era_border_overlay.modulate = Color(
			1.0,
			1.0,
			1.0,
			1.0
		)

		era_border_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

		era_border_overlay.z_as_relative = false
		era_border_overlay.z_index = 900

	if (
		player_stats_overlay != null
		and is_instance_valid(
			player_stats_overlay
		)
	):
		player_stats_overlay.z_as_relative = false
		player_stats_overlay.z_index = 30

	_sync_runtime_floating_hud_layering()

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"playable_life_shell_last_viewport_resize_repair_reason"
		] = reason

		gs.scenario_state [
			"playable_life_shell_last_viewport_resize_repair_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_IN:
		call_deferred("_boxing_hub_restore_after_focus_return")

	if what == NOTIFICATION_RESIZED:
		call_deferred("_repair_playable_life_shell_after_viewport_resize", "notification_resized")


func _boxing_hub_restore_after_focus_return() -> void:
	if not boxing_hub_open:
		return

	if boxing_hub_popup == null or not is_instance_valid(boxing_hub_popup):
		_show_boxing_hub_panel(boxing_hub_selected_tab)
		return

	if not boxing_hub_popup.visible:
		_show_boxing_hub_panel(boxing_hub_selected_tab)
		return

	_boxing_hub_apply_desktop_fullscreen_bounds()
	_bring_modal_to_front(boxing_hub_popup)
	_sync_runtime_floating_hud_layering()
func _boxing_hub_make_legacy_ladder_card(visual_contract: Dictionary) -> PanelContainer:
	var card:= PanelContainer.new()
	card.custom_minimum_size = Vector2(292, 0)
	card.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	card.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_legacy_ladder_card_style(visual_contract))

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 10)
	card.add_child(margin)

	var stack:= VBoxContainer.new()
	stack.add_theme_constant_override("separation", 2)
	margin.add_child(stack)

	var title:= Label.new()
	title.text = "LEGACY RATING"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 19)
	title.add_theme_color_override("font_color", Color(0.96, 0.98, 1.0, 1.0))
	title.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.95))
	title.add_theme_constant_override("shadow_offset_x", 2)
	title.add_theme_constant_override("shadow_offset_y", 2)
	stack.add_child(title)

	var ladder:= VBoxContainer.new()
	ladder.add_theme_constant_override("separation", 0)
	stack.add_child(ladder)

	var rating: Dictionary = _boxing_hub_legacy_ladder_rating_for_player()
	var current_tier: String = str(rating.get("tier", "Amateur"))
	var tiers: Array = [
		"Greatest Of All Time",
		"Ring Legend",
		"Hall of Famer",
		"Superstar",
		"Champion",
		"Contender",
		"Club Fighter",
		"Prospect",
		"Amateur"
	]

	var segments: Array = []

	for i in range(tiers.size()):
		var tier_name: String = str(tiers [i])
		var shape_kind: String = "middle"
		if i == 0:
			shape_kind = "top"
		elif i == tiers.size() - 1:
			shape_kind = "bottom"

		var segment:= _boxing_hub_make_legacy_ladder_segment(tier_name, false, shape_kind, visual_contract)
		ladder.add_child(segment)
		segments.append(segment)

	var footer:= Label.new()
	footer.text = "Score: %d • %s" % [
		int(rating.get("score", 0)),
		str(rating.get("summary", "Career legacy forming."))
	]
	footer.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	footer.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	footer.add_theme_font_size_override("font_size", 10)
	footer.add_theme_color_override("font_color", visual_contract.get("muted_text", Color(0.86, 0.9, 0.98, 0.8)))
	stack.add_child(footer)

	call_deferred("_boxing_hub_play_legacy_ladder_intro", segments, current_tier, visual_contract)

	return card

func _boxing_hub_make_legacy_ladder_segment(tier_name: String, active: bool, shape_kind: String, visual_contract: Dictionary) -> Control:
	var width: float = 252.0
	var height: float = 34.0
	if shape_kind == "top" or shape_kind == "bottom":
		height = 42.0

	var segment:= Control.new()
	segment.custom_minimum_size = Vector2(width, height)
	segment.mouse_filter = Control.MOUSE_FILTER_IGNORE
	segment.clip_contents = false
	segment.set_meta("legacy_tier_name", tier_name)

	var fill:= Polygon2D.new()
	fill.name = "LegacyFill"
	fill.z_index = 0
	segment.add_child(fill)

	var border:= Line2D.new()
	border.name = "LegacyBorder"
	border.width = 2.0
	border.z_index = 1
	segment.add_child(border)

	var glow:= Line2D.new()
	glow.name = "LegacyGlow"
	glow.width = 0.0
	glow.z_index = 0
	segment.add_child(glow)

	var label:= Label.new()
	label.name = "LegacyLabel"
	label.text = tier_name
	label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	label.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.96))
	label.add_theme_constant_override("shadow_offset_x", 2)
	label.add_theme_constant_override("shadow_offset_y", 2)
	label.z_index = 2
	segment.add_child(label)

	segment.resized.connect(func ():
		_boxing_hub_update_ladder_segment_shape(segment, fill, border, glow, shape_kind)
	)

	_boxing_hub_update_ladder_segment_shape(segment, fill, border, glow, shape_kind)
	_boxing_hub_set_legacy_ladder_segment_active(segment, active, visual_contract, active)

	return segment
func _boxing_hub_play_legacy_ladder_intro(segments: Array, current_tier: String, visual_contract: Dictionary) -> void:
	if segments.is_empty():
		return

	var target_index: int = -1
	for i in range(segments.size()):
		var segment: Control = segments [i]
		if segment == null or not is_instance_valid(segment):
			continue
		if str(segment.get_meta("legacy_tier_name", "")) == current_tier:
			target_index = i
			break

	if target_index < 0:
		target_index = segments.size() - 1

	var tween:= create_tween()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)

	for i in range(segments.size()):
		var segment_ref: Control = segments [i]
		if segment_ref == null or not is_instance_valid(segment_ref):
			continue

		tween.tween_callback(Callable(self, "_boxing_hub_set_legacy_ladder_segment_active").bind(segment_ref, true, visual_contract, false))
		tween.tween_interval(0.052)

		if i != target_index:
			tween.tween_callback(Callable(self, "_boxing_hub_set_legacy_ladder_segment_active").bind(segment_ref, false, visual_contract, false))

		if i >= target_index:
			break

	var target_segment: Control = segments [target_index]
	tween.tween_callback(Callable(self, "_boxing_hub_set_legacy_ladder_segment_active").bind(target_segment, true, visual_contract, true))


func _boxing_hub_set_legacy_ladder_segment_active(segment: Control, active: bool, visual_contract: Dictionary, final_active: bool = false) -> void:
	if segment == null or not is_instance_valid(segment):
		return

	var fill: Polygon2D = segment.get_node_or_null("LegacyFill") as Polygon2D
	var border: Line2D = segment.get_node_or_null("LegacyBorder") as Line2D
	var glow: Line2D = segment.get_node_or_null("LegacyGlow") as Line2D
	var label: Label = segment.get_node_or_null("LegacyLabel") as Label

	if fill == null or border == null or glow == null or label == null:
		return

	var hot: Color = visual_contract.get("hot", Color(1.0, 0.82, 0.38, 1.0))

	if active:
		fill.color = Color(1.0, 0.67, 0.08, 0.98)
		border.default_color = Color(1.0, 1.0, 0.94, 1.0)
		glow.default_color = Color(hot.r, hot.g, hot.b, 0.38)
		glow.width = 5.0
		label.text = str(segment.get_meta("legacy_tier_name", "")).to_upper()
		label.add_theme_font_size_override("font_size", 22)
		label.add_theme_color_override("font_color", Color(0.92, 0.96, 1.0, 1.0))
		segment.modulate = Color(1.0, 1.0, 1.0, 1.0)

		if final_active:
			_boxing_hub_start_soft_pulse(segment, 0.9, 1.0, 0.68)
	else:
		fill.color = Color(0.015, 0.016, 0.018, 0.82)
		border.default_color = Color(0.92, 0.96, 1.0, 0.92)
		glow.default_color = Color(0.0, 0.0, 0.0, 0.0)
		glow.width = 0.0
		label.text = str(segment.get_meta("legacy_tier_name", ""))
		label.add_theme_font_size_override("font_size", 18)
		label.add_theme_color_override("font_color", Color(0.9, 0.94, 1.0, 1.0))
		segment.modulate = Color(0.92, 0.92, 0.92, 1.0)


func _boxing_hub_update_ladder_segment_shape(segment: Control, fill: Polygon2D, border: Line2D, glow: Line2D, shape_kind: String) -> void:
	if segment == null or fill == null or border == null or glow == null:
		return
	if not is_instance_valid(segment) or not is_instance_valid(fill) or not is_instance_valid(border) or not is_instance_valid(glow):
		return

	var w: float = max(1.0, segment.size.x)
	var h: float = max(1.0, segment.size.y)
	if w <= 1.0:
		w = max(1.0, segment.custom_minimum_size.x)
	if h <= 1.0:
		h = max(1.0, segment.custom_minimum_size.y)

	var points:= PackedVector2Array()

	match str(shape_kind).strip_edges().to_lower():
		"top":
			points = PackedVector2Array([
				Vector2(w * 0.5, 0.0),
				Vector2(w, h * 0.38),
				Vector2(w, h),
				Vector2(0.0, h),
				Vector2(0.0, h * 0.38)
			])
		"bottom":
			points = PackedVector2Array([
				Vector2(0.0, 0.0),
				Vector2(w, 0.0),
				Vector2(w, h * 0.62),
				Vector2(w * 0.5, h),
				Vector2(0.0, h * 0.62)
			])
		_:
			points = PackedVector2Array([
				Vector2(0.0, 0.0),
				Vector2(w, 0.0),
				Vector2(w, h),
				Vector2(0.0, h)
			])

	fill.polygon = points

	var closed_points:= points.duplicate()
	closed_points.append(points [0])
	border.points = closed_points
	glow.points = closed_points


func _boxing_hub_legacy_ladder_rating_for_player() -> Dictionary:
	if gs == null or gs.player == null:
		return {
			"tier": "Amateur",
			"score": 0,
			"summary": "No active fighter."
		}

	if not ("boxing_profile" in gs.player):
		return {
			"tier": "Amateur",
			"score": 0,
			"summary": "No boxing profile."
		}

	if typeof(gs.player.boxing_profile) != TYPE_DICTIONARY:
		return {
			"tier": "Amateur",
			"score": 0,
			"summary": "No boxing profile."
		}

	var profile: Dictionary = gs.player.boxing_profile
	var record: Dictionary = profile.get("record", {}) if typeof(profile.get("record", {})) == TYPE_DICTIONARY else {}
	var amateur_record: Dictionary = profile.get("amateur_record", {}) if typeof(profile.get("amateur_record", {})) == TYPE_DICTIONARY else {}
	var amateur_circuit: Dictionary = profile.get("amateur_circuit", {}) if typeof(profile.get("amateur_circuit", {})) == TYPE_DICTIONARY else {}
	var growth: Dictionary = profile.get("growth", {}) if typeof(profile.get("growth", {})) == TYPE_DICTIONARY else {}
	var belts: Array = profile.get("belts", []) if typeof(profile.get("belts", [])) == TYPE_ARRAY else []

	var is_boxer: bool = bool(profile.get("is_boxer", false))
	var is_pro: bool = bool(profile.get("turned_pro", false))
	var is_amateur: bool = bool(amateur_circuit.get("is_amateur", false))
	var undisputed: bool = bool(profile.get("undisputed", false))
	var division_rank: int = int(profile.get("division_rank", -1))
	var world_tier: String = str(profile.get("boxing_world_tier", "local")).strip_edges().to_lower()

	var wins: int = int(record.get("wins", 0))
	var losses: int = int(record.get("losses", 0))
	var draws: int = int(record.get("draws", 0))
	var kos: int = int(record.get("kos", 0))

	var amateur_wins: int = int(amateur_record.get("wins", 0))
	var amateur_losses: int = int(amateur_record.get("losses", 0))
	var amateur_draws: int = int(amateur_record.get("draws", 0))
	var amateur_kos: int = int(amateur_record.get("kos", 0))

	var growth_total_levels: int = max(0, int(growth.get("total_levels", 0)))

	var score: int = 0
	score += wins * 3
	score += kos
	score += amateur_wins
	score += int(round(float(amateur_kos) * 0.5))
	score += belts.size() * 28
	score += int(floor(float(growth_total_levels) * 0.5))

	if division_rank > 0:
		score += max(0, 38 - (division_rank * 3))

	if undisputed:
		score += 48

	match world_tier:
		"regional":
			score += 8
		"national":
			score += 16
		"continental":
			score += 24
		"world":
			score += 36
		"legendary":
			score += 52

	var tier: String = "Amateur"

	if not is_boxer:
		tier = "Amateur"
	elif not is_pro:
		if is_amateur or amateur_wins + amateur_losses + amateur_draws > 0:
			tier = "Amateur"
		else:
			tier = "Prospect"
	else:
		tier = "Prospect"

		if score >= 18 or wins >= 5:
			tier = "Club Fighter"
		if score >= 38 or (division_rank > 0 and division_rank <= 10) or wins >= 10:
			tier = "Contender"
		if belts.size() > 0 or score >= 68:
			tier = "Champion"
		if belts.size() >= 2 or score >= 105 or wins >= 25:
			tier = "Superstar"
		if score >= 148 or (wins >= 34 and belts.size() >= 2):
			tier = "Hall of Famer"
		if score >= 195 or undisputed:
			tier = "Ring Legend"
		if score >= 245 or (undisputed and wins >= 45 and losses <= 3):
			tier = "Greatest Of All Time"

	var summary: String = "%s-%s-%s, %d belts" % [wins, losses, draws, belts.size()]
	if not is_pro:
		summary = "Amateur %s-%s-%s" % [amateur_wins, amateur_losses, amateur_draws]

	return {
		"tier": tier,
		"score": score,
		"summary": summary
	}


func _boxing_hub_has_pending_fight() -> bool:
	if gs == null or gs.player == null:
		return false
	if not ("boxing_profile" in gs.player):
		return false
	if typeof(gs.player.boxing_profile) != TYPE_DICTIONARY:
		return false

	var pending_raw: Variant = gs.player.boxing_profile.get("pending_fight_contract", {})
	if typeof(pending_raw) != TYPE_DICTIONARY:
		return false

	var pending: Dictionary = pending_raw
	return not pending.is_empty()


func _boxing_hub_bind_hover_motion(control: Control, hover_scale: float = 1.018) -> void:
	if control == null:
		return

	control.scale = Vector2.ONE
	control.mouse_entered.connect(func ():
		if control == null or not is_instance_valid(control):
			return
		control.pivot_offset = control.size * 0.5
		var tween:= control.create_tween()
		tween.set_trans(Tween.TRANS_CUBIC)
		tween.set_ease(Tween.EASE_OUT)
		tween.tween_property(control, "scale", Vector2(hover_scale, hover_scale), 0.08)
	)

	control.mouse_exited.connect(func ():
		if control == null or not is_instance_valid(control):
			return
		var tween:= control.create_tween()
		tween.set_trans(Tween.TRANS_CUBIC)
		tween.set_ease(Tween.EASE_OUT)
		tween.tween_property(control, "scale", Vector2.ONE, 0.1)
	)


func _boxing_hub_start_soft_pulse(node: CanvasItem, low_alpha: float = 0.55, high_alpha: float = 1.0, duration: float = 0.75) -> void:
	if node == null or not is_instance_valid(node):
		return

	var tween:= create_tween()
	tween.bind_node(node)
	tween.set_loops()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(node, "modulate:a", low_alpha, duration)
	tween.tween_property(node, "modulate:a", high_alpha, duration)


func _boxing_hub_apply_invisible_fast_scroll(scroll: ScrollContainer, visual_contract: Dictionary = {}) -> void:
	if scroll == null or not is_instance_valid(scroll):
		return

	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll.follow_focus = false
	scroll.mouse_filter = Control.MOUSE_FILTER_STOP

	var vbar:= scroll.get_v_scroll_bar()
	if vbar == null:
		return

	vbar.step = 18.0
	vbar.page = max(1.0, get_viewport_rect().size.y * 0.72)
	vbar.custom_minimum_size = Vector2(10, 0)
	vbar.modulate = Color(1.0, 1.0, 1.0, 0.0)
	vbar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	MainSceneHelpers._boxing_hub_style_scrollbar(vbar, visual_contract)

	var fade_timer:= Timer.new()
	fade_timer.one_shot = true
	fade_timer.wait_time = 0.34
	scroll.add_child(fade_timer)

	var reveal_scrollbar:= func (_value: float = 0.0):
		if scroll == null or not is_instance_valid(scroll):
			return

		var live_vbar:= scroll.get_v_scroll_bar()
		if live_vbar == null or not is_instance_valid(live_vbar):
			return

		live_vbar.visible = true
		live_vbar.mouse_filter = Control.MOUSE_FILTER_STOP
		_boxing_hub_fade_scrollbar(live_vbar, 0.86, 0.055)

		if fade_timer != null and is_instance_valid(fade_timer):
			fade_timer.start()

	vbar.value_changed.connect(reveal_scrollbar)

	scroll.gui_input.connect(func (event: InputEvent):
		if event is InputEventMouseButton:
			var mouse_event:= event as InputEventMouseButton
			if mouse_event.button_index == MOUSE_BUTTON_WHEEL_UP or mouse_event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				reveal_scrollbar.call(0.0)
		elif event is InputEventPanGesture:
			reveal_scrollbar.call(0.0)
		elif event is InputEventScreenDrag:
			reveal_scrollbar.call(0.0)
	)

	fade_timer.timeout.connect(func ():
		if scroll == null or not is_instance_valid(scroll):
			return

		var live_vbar:= scroll.get_v_scroll_bar()
		if live_vbar == null or not is_instance_valid(live_vbar):
			return

		_boxing_hub_fade_scrollbar(live_vbar, 0.0, 0.13)
		live_vbar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	)
func _boxing_hub_fade_scrollbar(scrollbar: Control, target_alpha: float, duration: float) -> void:
	if scrollbar == null or not is_instance_valid(scrollbar):
		return

	var tween:= create_tween()
	tween.bind_node(scrollbar)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(scrollbar, "modulate:a", clamp(target_alpha, 0.0, 1.0), max(0.01, duration))


func _show_artifact_shop_panel() -> void:
	if (
		artifact_shop_panel == null
		or not is_instance_valid(
			artifact_shop_panel
		)
		or gs == null
		or gs.player == null
	):
		return

	var return_surface_key: String = (
		_market_return_surface_key_before_open()
	)

	set_meta(
		"artifact_shop_return_surface_key",
		return_surface_key
	)

	_suspend_standard_tab_popup_for_child_surface(
		"artifact_shop_panel"
	)
	_suspend_activities_hub_for_child_surface(
		"artifact_shop_panel"
	)

	artifact_shop_panel.visible = true
	artifact_shop_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	artifact_shop_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	artifact_shop_panel.z_as_relative = false
	artifact_shop_panel.z_index = 245

	var shop_parent:= artifact_shop_panel.get_parent()

	if shop_parent != null:
		shop_parent.move_child(
			artifact_shop_panel,
			shop_parent.get_child_count() - 1
		)

	var surface_hot: bool = (
		_artifact_shop_surface_is_hot()
	)

	if (
		not surface_hot
		and artifact_shop_status_label != null
	):
		artifact_shop_status_label.text = (
			"Artifact reality is reconciling "
			+ "behind this resident surface."
		)

	_claim_interactive_surface_authority(
		artifact_shop_panel,
		"artifact_shop_panel",
		"show_artifact_shop_panel_prepainted_reveal",
		true,
		true
	)

	set_meta(
		"artifact_shop_click_reveal_only",
		true
	)
	set_meta(
		"artifact_shop_click_surface_hot",
		surface_hot
	)
	set_meta(
		"artifact_shop_click_engine_calls",
		false
	)
	set_meta(
		"artifact_shop_click_build_performed",
		false
	)

func _hide_artifact_shop_panel() -> void:
	if (
		artifact_shop_panel != null
		and is_instance_valid(
			artifact_shop_panel
		)
	):
		artifact_shop_panel.visible = false
		artifact_shop_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		artifact_shop_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		artifact_shop_panel.set_meta(
			"interactive_surface_input_suspended",
			true
		)

	var return_surface_key: String = str(
		get_meta(
			"artifact_shop_return_surface_key",
			"life"
		)
	)

	remove_meta(
		"artifact_shop_return_surface_key"
	)

	_restore_market_parent_surface(
		return_surface_key,
		"artifact_shop_back"
	)

func _on_artifact_shop_back_pressed() -> void:
	_hide_artifact_shop_panel()


