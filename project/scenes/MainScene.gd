func _drive_meat_market_surface_residency(
	_delta: float
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var actor_id: int = int(
		gs.player.id
	)
	var era_name: String = (
		_food_lifestyle_current_era_name_for_mainscene()
	)
	var resident_signature: String = (
		"%d|%s|%d"
		% [
			actor_id,
			era_name,
			int(gs.year)
		]
	)



	var pending_basket_raw: Variant = get_meta(
		"meat_market_pending_basket_projection",
		{}
	)

	if typeof(pending_basket_raw) == TYPE_DICTIONARY:
		var pending_basket: Dictionary = (
			pending_basket_raw as Dictionary
		)

		if not pending_basket.is_empty():
			_ensure_meat_market_panel()

			if (
				meat_market_panel != null
				and is_instance_valid(
					meat_market_panel
				)
				and meat_market_panel.has_method(
					"apply_basket_projection"
				)
			):
				meat_market_panel.apply_basket_projection(
					pending_basket
				)

			set_meta(
				"meat_market_pending_basket_projection",
				{}
			)

	if (
		resident_signature
		!= meat_market_resident_surface_signature
	):
		meat_market_resident_surface_signature = (
			resident_signature
		)
		meat_market_resident_surface_contract = {}
		meat_market_resident_card_queue = []
		meat_market_resident_card_cursor = 0
		meat_market_resident_publish_active = false

		set_meta(
			"meat_market_resident_surface_attempt_signature",
			""
		)
		set_meta(
			"meat_market_resident_surface_failed_signature",
			""
		)

	if (
		meat_market_resident_surface_contract.is_empty()
		and not meat_market_resident_publish_active
	):
		var attempted_signature: String = str(
			get_meta(
				"meat_market_resident_surface_attempt_signature",
				""
			)
		).strip_edges()



		if attempted_signature == resident_signature:
			return

		set_meta(
			"meat_market_resident_surface_attempt_signature",
			resident_signature
		)
		set_meta(
			"meat_market_resident_surface_attempt_at_ms",
			now_ms
		)

		var contract: Dictionary = (
			_meat_market_request_surface_contract(
				"mainscene.meat_market_resident_publication"
			)
		)

		if contract.is_empty():
			set_meta(
				"meat_market_resident_surface_failed_signature",
				resident_signature
			)
			set_meta(
				"meat_market_resident_publication_truth",
				{
					"success": false,
					"actor_id": actor_id,
					"era": era_name,
					"year": int(gs.year),
					"signature": resident_signature,
					"truth_state": (
						"surface_contract_unavailable"
					),
					"retry_policy": (
						"revision_change_only"
					),
					"idle_required": false,
					"observed_at_ms": now_ms
				}
			)
			return

		_ensure_meat_market_panel()

		if (
			meat_market_panel == null
			or not is_instance_valid(
				meat_market_panel
			)
		):
			set_meta(
				"meat_market_resident_surface_failed_signature",
				resident_signature
			)
			set_meta(
				"meat_market_resident_publication_truth",
				{
					"success": false,
					"actor_id": actor_id,
					"era": era_name,
					"year": int(gs.year),
					"signature": resident_signature,
					"truth_state": (
						"resident_renderer_unavailable"
					),
					"retry_policy": (
						"revision_change_only"
					),
					"idle_required": false,
					"observed_at_ms": now_ms
				}
			)
			return

		meat_market_resident_surface_contract = (
			contract.duplicate(false)
		)

		var card_rows_raw: Variant = contract.get(
			"food_card_contracts",
			[]
		)
		meat_market_resident_card_queue = (
			(card_rows_raw as Array).duplicate(false)
			if typeof(card_rows_raw) == TYPE_ARRAY
			else []
		)
		meat_market_resident_card_cursor = 0
		meat_market_resident_publish_active = true
		meat_market_resident_publish_generation += 1
		meat_market_resident_publish_next_ms = now_ms

		set_meta(
			"meat_market_resident_surface_failed_signature",
			""
		)

		meat_market_panel.begin_resident_surface_stream(
			gs.player,
			contract
		)



		if meat_market_resident_card_queue.is_empty():
			meat_market_resident_publish_active = false

			meat_market_panel.finish_resident_surface_stream()

			set_meta(
				"meat_market_resident_publication_truth",
				{
					"success": true,
					"actor_id": actor_id,
					"era": era_name,
					"year": int(gs.year),
					"signature": resident_signature,
					"generation": (
						meat_market_resident_publish_generation
					),
					"published_cards": 0,
					"idle_required": false,
					"completed_at_ms": now_ms
				}
			)
			return

	if not meat_market_resident_publish_active:
		return

	if now_ms < meat_market_resident_publish_next_ms:
		return



	meat_market_resident_publish_next_ms = (
		now_ms + 16
	)

	if (
		meat_market_resident_card_cursor
		< meat_market_resident_card_queue.size()
	):
		var raw_card: Variant = (
			meat_market_resident_card_queue [
				meat_market_resident_card_cursor
			]
		)
		meat_market_resident_card_cursor += 1

		if typeof(raw_card) == TYPE_DICTIONARY:
			meat_market_panel.append_resident_food_card_contract(
				(raw_card as Dictionary).duplicate(false)
			)

	if (
		meat_market_resident_card_cursor
		>= meat_market_resident_card_queue.size()
	):
		meat_market_resident_publish_active = false

		meat_market_panel.finish_resident_surface_stream()

		set_meta(
			"meat_market_resident_publication_truth",
			{
				"success": true,
				"actor_id": actor_id,
				"era": era_name,
				"year": int(gs.year),
				"signature": resident_signature,
				"generation": (
					meat_market_resident_publish_generation
				),
				"published_cards": (
					meat_market_resident_card_cursor
				),
				"idle_required": false,
				"completed_at_ms": now_ms
			}
		)
func _copy_self_host_life_link() -> void:
	if gs == null:
		if world_actions_status_label != null:
			world_actions_status_label.text = "No active runtime is available yet."
		return

	if gs.game_state_contract_engine == null:
		if world_actions_status_label != null:
			world_actions_status_label.text = "Self-host contracts are not ready yet."
		return

	var world_id:= "eralife-default-world"
	if gs.player != null:
		world_id = "%s-%s-age-%d" % [
			str(gs.player.first_name).strip_edges().to_lower(),
			str(gs.player.last_name).strip_edges().to_lower(),
			int(gs.player.age)
		]
		world_id = world_id.replace(" ", "-")

	var links: Dictionary = gs.game_state_contract_engine.build_default_self_host_tap_to_play_links(world_id, {
		"include_life_identity": true
	})

	var link:= str(links.get("self_host", links.get("live", links.get("web", "")))).strip_edges()
	if link == "":
		if world_actions_status_label != null:
			world_actions_status_label.text = "Could not build self-host link."
		return

	DisplayServer.clipboard_set(link)

	if world_actions_status_label != null:
		world_actions_status_label.text = "Copied live self-host link."

func _on_copy_reality_capsule_link_pressed() -> void:
	if gs == null or gs.player == null:
		if world_feed_popup_capsule_label != null:
			world_feed_popup_capsule_label.text = "Reality Link: No active life to copy."
		return

	if gs.game_state_contract_engine == null:
		gs.game_state_contract_engine = GameStateContractEngine.new(gs)

	var origin: String = MainSceneHelpers._read_browser_origin()
	var base_path: String = MainSceneHelpers._read_browser_base_path()

	var life_identity: Dictionary = gs.game_state_contract_engine.ensure_life_identity({
		"world_id": "eralife-default-world",
		"source": "copy_reality_link"
	})

	var capsule_id: String = _build_current_reality_capsule_id()

	var capsule_options:= {
		"capsule_id": capsule_id,
		"life_identity": life_identity.duplicate(true),
		"include_life_identity": true,
		"origin": origin,
		"host": "eralife.duckdns.org",
		"base_path": base_path,
		"max_inline_chars": 6800,
		"allow_local_capsule_fallback": false,
		"skip_memory_compaction": true,
		"skip_prune": true,
		"skip_archive": true,

		"self_host_enabled": true,
		"self_host_domain": "eralife.duckdns.org",
		"self_host_protocol": "http",
		"self_host_public_port": 80,
		"self_host_local_port": 7817,
		"duckdns_token_configured": true,
		"self_host_webrtc_relay_enabled": true,
		"multiplayer_authority_mode": "host_authoritative"
	}

	var report: Dictionary = gs.game_state_contract_engine.build_url_capsule("", capsule_options)

	var share_url: String = str(report.get("share_url", "")).strip_edges()
	if share_url == "":
		if world_feed_popup_capsule_label != null:
			world_feed_popup_capsule_label.text = "Reality Link failed to build."
		return

	world_feed_popup_capsule_last_url = share_url
	DisplayServer.clipboard_set(share_url)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["latest_reality_share_url"] = share_url
		gs.scenario_state ["latest_reality_share_report"] = report.duplicate(true)

	var mode: String = str(report.get("mode", "inline"))
	var exact_cross_device: bool = bool(report.get("cross_device_exact", false))
	var self_host_mode: Dictionary = report.get("self_host_mode", {}) if typeof(report.get("self_host_mode", {})) == TYPE_DICTIONARY else {}
	var self_host_enabled: bool = bool(self_host_mode.get("enabled", false))

	if world_feed_popup_capsule_label != null:
		if self_host_enabled:
			world_feed_popup_capsule_label.text = "Copied Self-Host Reality URL. Anyone with the link can request this exact life from your live EraLife node."
		elif exact_cross_device:
			if mode == "inline_large":
				world_feed_popup_capsule_label.text = "Copied full Reality URL. It is large, but it contains the exact life, identity, timeline, and snapshot."
			else:
				world_feed_popup_capsule_label.text = "Copied full Reality URL. Anyone with the link can load this exact life."
		elif mode == "local_capsule_id":
			world_feed_popup_capsule_label.text = "Copied local Reality Link. This capsule exists only on this device."
		else:
			world_feed_popup_capsule_label.text = "Copied Reality Link."


func _build_current_reality_capsule_id() -> String:
	if gs == null or gs.player == null:
		return "life.%d" % int(Time.get_ticks_msec())

	if gs.game_state_contract_engine == null:
		gs.game_state_contract_engine = GameStateContractEngine.new(gs)

	var identity: Dictionary = gs.game_state_contract_engine.ensure_life_identity({
		"world_id": "eralife-default-world",
		"source": "build_current_reality_capsule_id"
	})

	var life_id: String = str(identity.get("life_id", "")).strip_edges()
	if life_id == "":
		var player_name: String = MainSceneHelpers._sanitize_save_slot_component("%s_%s" % [
			gs.player.first_name,
			gs.player.last_name
		])
		life_id = player_name

	var timeline_raw: Variant = identity.get("timeline", {})
	var timeline: Dictionary = timeline_raw if typeof(timeline_raw) == TYPE_DICTIONARY else {}
	var next_index: int = int(timeline.get("capsule_count", 0)) + 1

	var year_part: String = MainSceneHelpers._sanitize_save_slot_component(_format_year(gs.year))

	return "%s.c%04d.age_%d.%s" % [
		MainSceneHelpers._sanitize_save_slot_component(life_id),
		next_index,
		int(gs.player.age),
		year_part
	]


func _try_load_reality_capsule_from_browser_url() -> bool:
	var browser_url: String = MainSceneHelpers._read_browser_url()
	if browser_url == "":
		return false

	var encoded_capsule: String = MainSceneHelpers._query_value_from_url(browser_url, "capsule")
	var capsule_id: String = MainSceneHelpers._query_value_from_url(browser_url, "capsule_id")

	if encoded_capsule == "" and capsule_id == "":
		return false

	if gs == null:
		gs = GameState.new()
		gs.custom_mode = true
		gs.custom_settings = _build_default_custom_settings()

	if gs.era_engine == null:
		gs.initialize()

	if gs.game_state_contract_engine == null:
		gs.game_state_contract_engine = GameStateContractEngine.new(gs)

	var report: Dictionary = {}
	if encoded_capsule != "":
		report = gs.game_state_contract_engine.import_url_capsule(encoded_capsule, {
			"source": "browser_url",
			"defer_hydration": false
		})
	else:
		report = gs.game_state_contract_engine.import_local_url_capsule(capsule_id, {
			"source": "browser_url",
			"defer_hydration": false
		})

	if not bool(report.get("success", false)):
		if output_label != null:
			output_label.clear()
			output_label.append_text("Reality capsule could not be loaded.\n")
		return false

	_apply_loaded_game_to_ui()

	if output_label != null:
		output_label.visible = true

	current_panel = ""
	_apply_ui_nav_button_visuals()
	call_deferred("_force_post_age_up_ui_refresh", "url_capsule_loaded")

	return true

func _world_feed_entry_accent_color(entry: Dictionary) -> Color:
	var normalized: Dictionary = entry
	if gs != null:
		normalized = gs.normalize_world_feed_entry(entry)
	var event_name: String = str(normalized.get("event_name", "")).strip_edges()
	var category: String = str(normalized.get("category", "")).strip_edges().to_lower()
	var text_raw: String = str(normalized.get("text", ""))
	var text: String = text_raw.to_lower()
	var accent:= Color(1.0, 1.0, 1.0, 1.0)

	if text.findn("red bonnet") != -1 or event_name == "red_bonnet_acquired" or event_name == "red_bonnet_rumor":
		accent = MainSceneHelpers._artifact_item_color({ "color": "red"})
	elif text.findn("infinity gauntlet") != -1 or event_name == str(ActionEventTypes.GAUNTLET_FORGED):
		accent = MainSceneHelpers._artifact_item_color({ "color": "gold"})
	elif text.findn("mind infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "yellow"})
	elif text.findn("reality infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "red"})
	elif text.findn("space infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "blue"})
	elif text.findn("time infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "green"})
	elif text.findn("soul infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "orange"})
	elif text.findn("power infinity stone") != -1:
		accent = MainSceneHelpers._artifact_item_color({ "color": "purple"})
	elif event_name == "artifact_world_pressure":
		var phase: float = _current_ui_material_phase()
		var blend: float = clamp(
			0.5
			+ (sin(phase * 2.1) * 0.22)
			+ (sin(phase * 4.6 + 0.72) * 0.08),
			0.0,
			1.0
		)
		accent = Color(0.72, 0.48, 1.0, 1.0).lerp(Color(0.28, 0.86, 1.0, 1.0), blend)
	elif category == "cosmic" or event_name == str(ActionEventTypes.COSMIC_ENFORCER_SPAWNED):
		accent = Color(0.74, 0.9, 1.0, 1.0)
	elif category == "artifact":
		accent = Color(1.0, 0.86, 0.42, 1.0)
	elif category in ["politics", "realm"]:
		accent = Color(1.0, 0.88, 0.62, 1.0)
	elif category == "dynasty":
		accent = Color(1.0, 0.78, 0.88, 1.0)
	elif category == "faction":
		accent = Color(0.84, 0.92, 1.0, 1.0)
	elif category in ["war", "military"]:
		accent = Color(1.0, 0.72, 0.72, 1.0)
	elif category == "bending":
		accent = Color(0.72, 1.0, 0.84, 1.0)
	elif category == "world":
		accent = Color(0.9, 0.9, 1.0, 1.0)

	if bool(normalized.get("personally_relevant", false)):
		accent = accent.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.16)
	return accent
func _append_world_feed_colored_line(
	text: String,
	color: Color,
	use_bold: bool = false,
	font_size: int = 0
) -> void:
	if world_feed_popup_feed == null:
		return
	var display_text:= str(text)
	if gs != null and gs.has_method("_normalize_world_feed_text"):
		display_text = gs._normalize_world_feed_text(display_text)
	else:
		display_text = display_text.strip_edges()
	var trimmed_lines: Array = []
	for raw_line in display_text.split("\n", false):
		var clean_line:= str(raw_line).strip_edges()
		if clean_line == "":
			continue
		trimmed_lines.append(clean_line)
	if trimmed_lines.is_empty():
		world_feed_popup_feed.append_text("\n")
		return
	var leading_feed_emojis:= {
		"👑": true,
		"🌌": true,
		"🧠": true,
		"🔺": true,
		"🔵": true,
		"🟢": true,
		"🟠": true,
		"🟣": true,
		"🔴": true,
		"🟡": true,
		"⭐": true,
		"💀": true,
		"👶": true,
		"💍": true,
		"🏆": true,
		"⚔": true,
		"⚔️": true,
		"⚡": true
	}
	if trimmed_lines.size() >= 2 and leading_feed_emojis.has(str(trimmed_lines [0])):
		trimmed_lines [0] = "%s %s" % [str(trimmed_lines [0]), str(trimmed_lines [1])]
		trimmed_lines.remove_at(1)
	display_text = "\n".join(trimmed_lines)
	if display_text == "":
		world_feed_popup_feed.append_text("\n")
		return
	if font_size > 0:
		world_feed_popup_feed.push_font_size(font_size)
	if use_bold:
		world_feed_popup_feed.push_bold()
	world_feed_popup_feed.push_color(color)
	world_feed_popup_feed.append_text(display_text + "\n")
	world_feed_popup_feed.pop()
	if use_bold:
		world_feed_popup_feed.pop()
	if font_size > 0:
		world_feed_popup_feed.pop()

func _append_world_feed_entry_line(entry: Dictionary) -> void:
	if world_feed_popup_feed == null:
		return
	var text:= ""
	if gs != null:
		text = gs.get_world_feed_text(entry)
	else:
		text = str(entry.get("text", ""))
	var accent: Color = _world_feed_entry_accent_color(entry)
	var event_name: String = str(entry.get("event_name", "")).strip_edges()
	if MainSceneLogic._is_personally_relevant_relic_feed_entry(gs, entry):
		var phase: float = _current_ui_material_phase()
		var shimmer: float = clamp(
			0.54
			+ (sin(phase * 2.35) * 0.18)
			+ (sin(phase * 5.1 + 0.6) * 0.08),
			0.0,
			1.0
		)
		var emphasized: Color = accent.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.2 + shimmer * 0.18)
		if event_name == "artifact_birth_loadout":
			_append_world_feed_line_with_stone_colors(text, emphasized, true, 20)
			_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
			return
		_append_world_feed_colored_line(text, emphasized, true, 20)
		_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
		return
	if event_name == "artifact_birth_loadout":
		_append_world_feed_line_with_stone_colors(text, accent)
		_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
		return
	if MainSceneLogic._should_render_world_feed_entry_as_compact_block(gs, entry):
		_append_world_feed_compact_entry_block(entry, text, accent)
		_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
		return
	_append_world_feed_colored_line(text, accent)
	_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
func _append_world_feed_line_with_stone_colors(
	text: String,
	base_color: Color,
	use_bold: bool = false,
	font_size: int = 0
) -> void:
	if world_feed_popup_feed == null:
		return

	var display_text:= str(text)
	if gs != null and gs.has_method("_normalize_world_feed_text"):
		display_text = gs._normalize_world_feed_text(display_text)
	else:
		display_text = display_text.strip_edges()

	var trimmed_lines: Array = []
	for raw_line in display_text.split("\n", false):
		var clean_line:= str(raw_line).strip_edges()
		if clean_line == "":
			continue
		trimmed_lines.append(clean_line)

	if trimmed_lines.is_empty():
		world_feed_popup_feed.append_text("\n")
		return

	var leading_feed_emojis:= {
		"👑": true,
		"🌌": true,
		"🧠": true,
		"🔺": true,
		"🔵": true,
		"🟢": true,
		"🟠": true,
		"🟣": true,
		"🔴": true,
		"🟡": true,
		"⭐": true,
		"💀": true,
		"👶": true,
		"💍": true,
		"🏆": true,
		"⚔": true,
		"⚡": true
	}

	if trimmed_lines.size() >= 2 and leading_feed_emojis.has(str(trimmed_lines [0])):
		trimmed_lines [0] = "%s %s" % [str(trimmed_lines [0]), str(trimmed_lines [1])]
		trimmed_lines.remove_at(1)

	display_text = "\n".join(trimmed_lines)
	if display_text == "":
		world_feed_popup_feed.append_text("\n")
		return

	var ordered_names: Array = [
		"Reality Stone",
		"Space Stone",
		"Mind Stone",
		"Power Stone",
		"Time Stone",
		"Soul Stone"
	]

	if font_size > 0:
		world_feed_popup_feed.push_font_size(font_size)
	if use_bold:
		world_feed_popup_feed.push_bold()

	var cursor: int = 0
	while cursor < display_text.length():
		var nearest_name: String = ""
		var nearest_index: int = -1

		for stone_name_value in ordered_names:
			var stone_name: String = str(stone_name_value)
			var idx: int = display_text.find(stone_name, cursor)
			if idx == -1:
				continue
			if nearest_index == -1 or idx < nearest_index:
				nearest_index = idx
				nearest_name = stone_name

		if nearest_index == -1:
			world_feed_popup_feed.push_color(base_color)
			world_feed_popup_feed.append_text(display_text.substr(cursor))
			world_feed_popup_feed.pop()
			break

		if nearest_index > cursor:
			world_feed_popup_feed.push_color(base_color)
			world_feed_popup_feed.append_text(display_text.substr(cursor, nearest_index - cursor))
			world_feed_popup_feed.pop()

		world_feed_popup_feed.push_color(MainSceneHelpers._world_feed_stone_inline_color(nearest_name))
		world_feed_popup_feed.append_text(nearest_name)
		world_feed_popup_feed.pop()

		cursor = nearest_index + nearest_name.length()

	world_feed_popup_feed.append_text("\n")

	if use_bold:
		world_feed_popup_feed.pop()
	if font_size > 0:
		world_feed_popup_feed.pop()

func _artifact_item_aura_strength(item: Dictionary, pulse_strength: float = 0.0) -> float:
	var phase: float = _current_ui_material_phase() + pulse_strength * 0.25
	var item_name: String = str(item.get("name", "")).strip_edges().to_lower()
	var color_key: String = str(item.get("color", "")).strip_edges().to_lower()
	var dragon_star: int = int(item.get("star", 0))

	if dragon_star <= 0 and item_name.findn("-star dragon ball") != -1:
		var star_chunks: PackedStringArray = item_name.split("-star dragon ball")
		if star_chunks.size() > 0:
			dragon_star = int(star_chunks [0])

	if item_name.findn("red bonnet") != -1 or color_key == "red":
		return clamp(
			0.54
			+ (sin(phase * 2.35) * 0.22)
			+ (sin(phase * 5.1 + 0.55) * 0.08),
			0.0,
			1.0
		)

	if item_name.findn("gauntlet") != -1 or color_key == "gold":
		return clamp(
			0.56
			+ (sin(phase * 3.05) * 0.24)
			+ (sin(phase * 7.2 + 0.75) * 0.1),
			0.0,
			1.0
		)

	if item_name.findn("dragon ball") != -1 or dragon_star > 0:
		var star_heat: float = clamp(float(max(dragon_star, 1) - 1) / 6.0, 0.0, 1.0)
		return clamp(
			0.52
			+ star_heat * 0.2
			+ (sin(phase * (2.7 + star_heat * 0.35)) * (0.2 + star_heat * 0.05))
			+ (sin(phase * (5.2 + star_heat * 0.8) + 0.92) * (0.07 + star_heat * 0.03)),
			0.0,
			1.0
		)

	return clamp(
		0.5
		+ (sin(phase * 2.6) * 0.18)
		+ (sin(phase * 4.8 + 1.1) * 0.06),
		0.0,
		1.0
	)

func _build_red_bonnet_panel_style(pulse_strength: float = 0.0) -> StyleBoxFlat:
	var accent:= MainSceneHelpers._artifact_item_color({
		"name": "Red Bonnet",
		"color": "red"
	})
	var gold:= Color(1.0, 0.84, 0.36, 1.0)
	var phase: float = _current_ui_material_phase() + pulse_strength * 0.2
	var ember: float = clamp(
		0.58
		+ (sin(phase * 2.4) * 0.22)
		+ (sin(phase * 6.2 + 0.55) * 0.08),
		0.0,
		1.0
	)

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.11, 0.03, 0.05, 0.97).lerp(
		Color(0.34, 0.08, 0.1, 0.98),
		0.24 + ember * 0.16
	)
	style.border_width_left = 3
	style.border_width_top = 3
	style.border_width_right = 3
	style.border_width_bottom = 3
	style.border_color = Color(gold.r, gold.g, gold.b, 0.58 + ember * 0.22).lerp(
		Color(accent.r, accent.g, accent.b, 0.72 + ember * 0.16),
		0.52
	)
	style.shadow_color = Color(accent.r, accent.g, accent.b, 0.3 + ember * 0.26)
	style.shadow_size = 22 + int(round(ember * 10.0))
	style.shadow_offset = Vector2(0, 0)
	style.corner_radius_top_left = 24
	style.corner_radius_top_right = 24
	style.corner_radius_bottom_left = 24
	style.corner_radius_bottom_right = 24
	return style


