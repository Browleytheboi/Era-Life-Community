			"%s_pending_situations"
			% source
		)
	)








	_lock_player_stats_overlay_identity_lens_only(
		gs.player,
		"%s_successor_identity"
		% source
	)

	_apply_runtime_hud_visibility_snapshot_existing_nodes_only(
