func _recover_assets_panel_chassis_and_reveal(
	actor_id: int,
	status_text: String
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
	):
		return

	_ensure_assets_panel()

	if (
		assets_panel == null
		or not is_instance_valid(
			assets_panel
		)
	):
		return

	_show_assets_panel(
		gs.player,
		status_text
	)
func _recover_assets_panel_actor_lens_and_reveal(
	actor_id: int,
	status_text: String
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
		or assets_panel == null
		or not is_instance_valid(
