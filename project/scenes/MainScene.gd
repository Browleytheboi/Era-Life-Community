func _hide_bending_hub_ability_overview_popup() -> void:
	bending_hub_ability_overview_open = false
	if bending_hub_ability_overview_dim != null:
		bending_hub_ability_overview_dim.visible = false


func _on_bending_hub_ability_overview_gui_input(event: InputEvent) -> void:
	if not bending_hub_ability_overview_open:
		return

	var should_dismiss:= false

	if event is InputEventMouseButton:
		should_dismiss = event.pressed and event.button_index == MOUSE_BUTTON_LEFT
	elif event is InputEventScreenTouch:
		should_dismiss = event.pressed
	elif event is InputEventKey:
		should_dismiss = event.pressed and not event.echo
	elif event is InputEventJoypadButton:
		should_dismiss = event.pressed

	if not should_dismiss:
		return

	get_viewport().set_input_as_handled()
	_hide_bending_hub_ability_overview_popup()


func _show_bending_hub_ability_overview_popup(ability: Dictionary, player_age: int) -> void:
	if ability.is_empty():
		return

	_ensure_bending_hud()
	_ensure_bending_hub_ability_overview_popup()

	if bending_hub_ability_overview_dim == null or bending_hub_ability_overview_popup == null:
		return

	bending_hud_open = true
	_update_bending_hud()

	var ability_name: String = str(ability.get("name", "Bending Skill"))
	var ability_element: String = str(ability.get("element", "")).strip_edges().to_lower()
	var visual_profile: Dictionary = MainSceneHelpers._bending_hub_ability_visual_profile_from_ability(ability)
	var visual_tier: String = str(visual_profile.get("visual_tier", "low")).strip_edges().to_lower()
	var corrupted: bool = bool(visual_profile.get("corrupted_bending", false))
	var legendary: bool = visual_tier == "legendary" or bool(visual_profile.get("legendary_mastery", false))
	var element_color: Color = _bending_hub_visual_element_color(ability_element, corrupted, legendary)
	var element_soft: Color = element_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.36)
	var aura_radius: int = max(18, int(visual_profile.get("aura_radius", 24)))
	var aura_alpha: float = clamp(float(visual_profile.get("aura_alpha", 0.32)), 0.12, 0.82)

	var bg_color:= Color(
		clampf(element_color.r * (0.16 if corrupted else 0.18), 0.02, 0.28),
		clampf(element_color.g * (0.16 if corrupted else 0.18), 0.02, 0.28),
		clampf(element_color.b * (0.18 if corrupted else 0.2), 0.03, 0.34),
		0.98
	)

	if bending_hub_ability_overview_dim != null:
		var dim_alpha: float = 0.34
		if visual_tier == "high":
			dim_alpha = 0.42
		elif visual_tier == "legendary":
			dim_alpha = 0.58
		if corrupted:
			dim_alpha += 0.08
		bending_hub_ability_overview_dim.color = Color(
			clampf(element_color.r * 0.1, 0.0, 0.16),
			clampf(element_color.g * 0.1, 0.0, 0.16),
			clampf(element_color.b * 0.12, 0.0, 0.2),
			clamp(dim_alpha, 0.3, 0.72)
		)

	var panel_style:= StyleBoxFlat.new()
	panel_style.bg_color = bg_color
	panel_style.border_color = Color(element_soft.r, element_soft.g, element_soft.b, 0.92)
	panel_style.shadow_color = Color(element_color.r, element_color.g, element_color.b, aura_alpha)
	panel_style.shadow_size = aura_radius
	panel_style.shadow_offset = Vector2.ZERO
	panel_style.border_width_left = 3
	panel_style.border_width_top = 3
	panel_style.border_width_right = 3
	panel_style.border_width_bottom = 3
	panel_style.corner_radius_top_left = 22
	panel_style.corner_radius_top_right = 22
	panel_style.corner_radius_bottom_left = 22
	panel_style.corner_radius_bottom_right = 22
	bending_hub_ability_overview_popup.add_theme_stylebox_override("panel", panel_style)

	if bending_hub_ability_overview_title != null:
		bending_hub_ability_overview_title.text = "%s Overview" % ability_name
		bending_hub_ability_overview_title.add_theme_color_override("font_color", element_soft)
		bending_hub_ability_overview_title.add_theme_color_override("font_shadow_color", Color(element_color.r, element_color.g, element_color.b, 0.46))
		bending_hub_ability_overview_title.add_theme_constant_override("shadow_outline_size", 3 if visual_tier != "legendary" else 5)

	if bending_hub_ability_overview_body != null:
		bending_hub_ability_overview_body.clear()
		bending_hub_ability_overview_body.add_theme_color_override("default_color", Color(0.95, 0.97, 1.0, 0.95))
		bending_hub_ability_overview_body.append_text(_bending_hub_ability_overview_text(ability, player_age))

	if bending_hub_ability_overview_footer != null:
		var footer_text: String = "Tap anywhere to continue."
		if visual_tier == "legendary":
			footer_text = "Legendary technique detected. Tap anywhere to continue."
		elif corrupted:
			footer_text = "Corrupted bending signature detected. Tap anywhere to continue."
		bending_hub_ability_overview_footer.text = footer_text
		bending_hub_ability_overview_footer.add_theme_color_override("font_color", element_soft.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.22))

	bending_hub_ability_overview_open = true
	bending_hub_ability_overview_dim.visible = true
	_bring_modal_to_front(bending_hub_ability_overview_dim)
	bending_hub_ability_overview_dim.grab_focus()
func _bending_hub_ability_overview_text(ability: Dictionary, _player_age: int) -> String:
	var ability_name: String = str(ability.get("name", "Unknown Skill"))
	var element: String = str(ability.get("element", "")).strip_edges().capitalize()
	var required_level: int = int(ability.get("required_level", ability.get("level", 0)))
	var current_level: int = int(ability.get("current_level", 0))
	var min_age: int = int(ability.get("min_age", ability.get("age_requirement", 0)))
	var max_age: int = int(ability.get("max_age", -1))
	var uses_age_gate: bool = bool(ability.get("uses_age_gate", min_age > 0))
	var uses_level_gate: bool = bool(ability.get("uses_level_gate", required_level > 0))
	var ability_type: String = MainSceneHelpers._bending_hub_ability_type_label(str(ability.get("type", "technique")))
	var cooldown_years: int = int(ability.get("cooldown_years", 0))
	var impact: String = str(ability.get("impact", "normal")).strip_edges().capitalize()
	var description: String = str(ability.get("description", "")).strip_edges()
	var usage_text: String = str(ability.get("usage_text", "")).strip_edges()
	var lock_text: String = str(ability.get("lock_text", "")).strip_edges()
	var unlock_path: String = str(ability.get("unlock_path", lock_text)).strip_edges()
	var visual_label: String = str(ability.get("visual_label", "Subtle Glow")).strip_edges()
	var visual_tier: String = str(ability.get("visual_tier", "low")).strip_edges().capitalize()
	var upgrade_level: int = int(ability.get("upgrade_level", 0))
	var max_upgrade_level: int = int(ability.get("max_upgrade_level", 0))
	var next_upgrade_level: int = int(ability.get("next_upgrade_level", upgrade_level + 1))
	var upgrade_cost: int = int(ability.get("upgrade_cost", 0))
	var upgrade_requirements: Dictionary = ability.get("upgrade_requirements", {}) if typeof(ability.get("upgrade_requirements", {})) == TYPE_DICTIONARY else {}
	var category_bundle: Dictionary = ability.get("category_bundle", {}) if typeof(ability.get("category_bundle", {})) == TYPE_DICTIONARY else {}
	if category_bundle.is_empty():
		category_bundle = upgrade_requirements.duplicate(true)

	var category_bundle_text: String = str(ability.get("upgrade_requirement_text", "")).strip_edges()
	if category_bundle_text == "":
		category_bundle_text = MainSceneHelpers._bending_hub_category_bundle_text(category_bundle)
	var upgrade_text: String = str(ability.get("upgrade_text", "")).strip_edges()
	var neutralize_rating: int = int(ability.get("neutralize_rating", 0))
	var upgrade_multiplier: float = float(ability.get("upgrade_effectiveness_multiplier", 1.0))

	if usage_text == "":
		usage_text = "Use this when the situation fits the technique type, target scope, and story pressure."

	var age_gate_text: String = "None"
	if uses_age_gate:
		age_gate_text = "Age %d+" % min_age
		if max_age > 0:
			age_gate_text += " / Before age %d" % max_age

	var level_gate_text: String = "None"
	if uses_level_gate:
		level_gate_text = "%s Level %d" % [element, required_level]

	var status_text:= "Ready"
	if bool(ability.get("on_cooldown", false)):
		status_text = "Recovering"
	elif not bool(ability.get("unlocked", false)):
		status_text = "Locked - %s" % (lock_text if lock_text != "" else "Unlock path incomplete")

	var visual_note: String = "Visual Evolution: %s • %s" % [visual_tier, visual_label]
	if bool(ability.get("avatar_pulse", false)):
		visual_note += "\nAvatar Resonance: all four elemental colors pulse through this path."
	if bool(ability.get("corrupted_bending", false)):
		visual_note += "\nCorruption: this technique renders with a darker elemental aura."
	if bool(ability.get("legendary_mastery", false)):
		visual_note += "\nLegendary Mastery: your aura radius burns brighter because your mastery is near mythic."

	var requirement_lines: Array = []
	for raw_stat in upgrade_requirements.keys():
		requirement_lines.append("%s %d+" % [
			str(raw_stat).capitalize(),
			int(upgrade_requirements.get(raw_stat, 0))
		])

	var upgrade_path_text: String = "Maxed"
	if upgrade_level < max_upgrade_level:
		upgrade_path_text = "Next Tier: %d\nCost: %d Skill Point(s)\nBundle: %s\nStatus: %s" % [
			next_upgrade_level,
			upgrade_cost,
			category_bundle_text,
			upgrade_text if upgrade_text != "" else "Ready"
		]

	return "%s\n\nElement: %s\nType: %s\nLevel Gate: %s\nCurrent Level: %d/100\nAge Gate: %s\nCooldown: %d year(s)\nImpact: %s\nStatus: %s\n%s\n\nUpgrade Tier: %d/%d\nEffectiveness: %.2fx\nNeutralize Rating: %d\n%s\n\nOverview:\n%s\n\nHow it can be used:\n%s\n\nUnlock Path:\n%s" % [
		ability_name,
		element,
		ability_type,
		level_gate_text,
		current_level,
		age_gate_text,
		cooldown_years,
		impact,
		status_text,
		visual_note,
		upgrade_level,
		max_upgrade_level,
		upgrade_multiplier,
		neutralize_rating,
		upgrade_path_text,
		description,
		usage_text,
		unlock_path if unlock_path != "" else "Ready"
	]


func _on_bending_hub_ability_overview_pressed(ability: Dictionary, player_age: int) -> void:
	if ability.is_empty():
		return

	_show_bending_hub_ability_overview_popup(ability, player_age)
