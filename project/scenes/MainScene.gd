	_append_crown_population_status_bar(deep_status, "Health", clampi(int(round(float(target.health))), 0, 100), role_accent)
	_append_crown_population_status_bar(deep_status, "Hunger", clampi(int(round(float(target.hunger))), 0, 100), role_accent)
	_append_crown_population_status_bar(deep_status, "Mental", clampi(int(round(float(target.mental_health))), 0, 100), role_accent)
	_append_crown_population_status_bar(deep_status, "Smarts", clampi(int(round(float(target.smarts))), 0, 100), role_accent)
	_append_crown_population_status_bar(deep_status, "Looks", clampi(int(round(float(target.looks))), 0, 100), role_accent)
	_append_crown_population_status_bar(deep_status, "Influence", int(power_contract.get("influence", 0)), role_accent)
	_append_crown_population_status_bar(deep_status, "Succession", int(power_contract.get("succession_pressure", 0)), role_accent)

	if loyalty_value >= 0:
		_append_crown_population_status_bar(deep_status, "Loyalty", loyalty_value, role_accent)

	_append_crown_population_relationship_cards(details_root, target, bloodline_color)

	if not is_you:
		var full_button:= Button.new()
		full_button.text = "Open Full Target"
		full_button.custom_minimum_size = Vector2(0, 38)
		MainSceneLogic._apply_crown_population_name_button_style(full_button, target, section_kind, accent, role_accent)
		full_button.pressed.connect(_on_crown_popup_option_pressed.bind(
			"route:population_profile",
			{
				"target_id": int(target.id),
				"target_realm_id": realm_id
			}
		))
		details_root.add_child(full_button)
	else:
		var locked:= Label.new()
		locked.text = "You are already looking through this life lens."
		locked.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		locked.add_theme_color_override("font_color", Color(1.0, 0.9, 0.48, 0.78))
		details_root.add_child(locked)

	if not is_you:
		open_button.pressed.connect(_toggle_crown_population_capsule_details.bind(details, card, target, section_kind, accent, glow_strength))
func _crown_population_card_minimum_size_for_target(
	target: Person,
	realm_id: int,
	section_kind: String,
	_element: String = "",
	realm_name: String = ""
) -> Vector2:
	var clean_section: String = str(section_kind).strip_edges().to_lower()

	match clean_section:
		"federal_executive":
			if MainSceneLogic._crown_population_is_ruler_partner_card(gs, target, realm_id):
				return Vector2(166, 122)
			return Vector2(154, 112)

		"federal_cabinet":
			return Vector2(138, 100)

		"federal_senate":
			return Vector2(126, 92)

		"federal_supreme_court":
			return Vector2(138, 96)

		"federal_governor":
			return Vector2(126, 92)

		"official":
			if MainSceneLogic._crown_population_is_ruler_partner_card(gs, target, realm_id):
				return Vector2(186, 138)
			return Vector2(168, 124)

		"noble":
			return Vector2(156, 116)

		"master":
			return Vector2(150, 112)

		_:
			var strata_key: String = _crown_population_citizen_strata_key(target, realm_id, realm_name)
			if strata_key == "peasant" or strata_key == "low_class":
				return Vector2(116, 88)

			return Vector2(124, 92)
func _append_crown_population_section(root: Control, title_text: String, subtitle_text: String, people: Array, realm_id: int, section_kind: String, accent: Color, glow_strength: float, element: String = "") -> void:
	if root == null:
		return

	var clean_section: String = str(section_kind).strip_edges().to_lower()
	var dense_federal: bool = clean_section in [
		"federal_executive",
		"federal_cabinet",
		"federal_senate",
		"federal_supreme_court",
		"federal_governor",
		"citizen"
	]

	var section:= PanelContainer.new()
	section.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	section.custom_minimum_size = Vector2(0, 0)
	section.clip_contents = true
	root.add_child(section)

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(accent.r * 0.035, accent.g * 0.035, accent.b * 0.045, 0.92)
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.border_color = Color(accent.r, accent.g, accent.b, 0.3 + glow_strength)
	style.corner_radius_top_left = 12 if dense_federal else 18
	style.corner_radius_top_right = 12 if dense_federal else 18
	style.corner_radius_bottom_left = 12 if dense_federal else 18
	style.corner_radius_bottom_right = 12 if dense_federal else 18
	section.add_theme_stylebox_override("panel", style)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 5 if dense_federal else 10)
	margin.add_theme_constant_override("margin_top", 5 if dense_federal else 10)
	margin.add_theme_constant_override("margin_right", 5 if dense_federal else 10)
	margin.add_theme_constant_override("margin_bottom", 5 if dense_federal else 10)
	section.add_child(margin)

	var box:= VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.custom_minimum_size = Vector2(0, 0)
	box.add_theme_constant_override("separation", 4 if dense_federal else 8)
	margin.add_child(box)

	var title:= Label.new()
	title.text = "%s • %d" % [title_text, people.size()] if dense_federal else title_text
	title.add_theme_font_size_override("font_size", 14 if dense_federal else 17)
	title.add_theme_color_override("font_color", Color(accent.r, accent.g, accent.b, 1.0))
	title.clip_text = true
	title.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	box.add_child(title)

	var subtitle:= Label.new()
	subtitle.text = subtitle_text
	subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	subtitle.add_theme_font_size_override("font_size", 9 if dense_federal else 11)
	subtitle.add_theme_color_override("font_color", Color(0.82, 0.86, 0.94, 0.6 if dense_federal else 0.72))
	box.add_child(subtitle)

	if people.is_empty():
		var empty:= Label.new()
		empty.text = "No active entities in this category right now."
		empty.add_theme_color_override("font_color", Color(0.72, 0.74, 0.82, 0.6))
		box.add_child(empty)
		return

	var viewport_width: float = get_viewport_rect().size.x
	var grid_columns: int = 4

	match clean_section:
		"federal_executive":
			grid_columns = 2
		"federal_cabinet":
			grid_columns = 4 if viewport_width < 1320.0 else 5
		"federal_senate":
			grid_columns = 5 if viewport_width < 1320.0 else 7
		"federal_supreme_court":
			grid_columns = 3 if viewport_width < 1320.0 else 4
		"federal_governor":
			grid_columns = 5 if viewport_width < 1320.0 else 7
		"citizen":
			grid_columns = 5 if viewport_width < 1320.0 else 7
		"official":
			grid_columns = 3 if viewport_width < 1320.0 else 4
		"noble":
			grid_columns = 3 if viewport_width < 1320.0 else 4
		"master":
			grid_columns = 4 if viewport_width < 1500.0 else 5
		_:
			grid_columns = 4 if viewport_width < 1320.0 else 5

	var grid:= GridContainer.new()
	grid.columns = grid_columns
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	grid.custom_minimum_size = Vector2(0, 0)
	grid.clip_contents = true
	grid.add_theme_constant_override("h_separation", 4 if dense_federal else 8)
	grid.add_theme_constant_override("v_separation", 4 if dense_federal else 8)
	box.add_child(grid)

	for raw_person in people:
		if raw_person == null:
			continue

		if raw_person is Person:
			var person: Person = raw_person as Person
			_append_crown_population_capsule(grid, person, realm_id, section_kind, accent, glow_strength, element)
			continue

		if typeof(raw_person) == TYPE_DICTIONARY:
			_append_crown_population_observable_node_capsule(
				grid,
				raw_person as Dictionary,
				realm_id,
				section_kind,
				accent,
				glow_strength,
				element
			)
			continue
