func _boxing_hub_make_athleticism_stat_row(stat: Dictionary, visual_contract: Dictionary) -> Control:
	var row:= HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_theme_constant_override("separation", 6)

	var label:= Label.new()
	label.text = str(stat.get("label", "Stat"))
	label.custom_minimum_size = Vector2(92, 18)
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.clip_text = true
	label.tooltip_text = str(stat.get("description", ""))
	label.add_theme_font_size_override("font_size", 10)
	label.add_theme_color_override("font_color", visual_contract.get("body_text", Color(0.96, 0.97, 1.0, 0.94)))
	label.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.88))
	label.add_theme_constant_override("shadow_offset_x", 1)
	label.add_theme_constant_override("shadow_offset_y", 1)
	row.add_child(label)

	var value: int = clamp(int(stat.get("value", 0)), 0, 100)

	var bar:= ProgressBar.new()
	bar.min_value = 0.0
	bar.max_value = 100.0
	bar.value = 0.0
	bar.show_percentage = false
	bar.custom_minimum_size = Vector2(150, 12)
	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.add_theme_stylebox_override("background", MainSceneHelpers._boxing_hub_athleticism_bar_background_style(visual_contract))
	bar.add_theme_stylebox_override("fill", MainSceneHelpers._boxing_hub_athleticism_bar_fill_style(visual_contract, value))
	row.add_child(bar)

	var value_label:= Label.new()
	value_label.text = "%d" % value
	value_label.custom_minimum_size = Vector2(32, 18)
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	value_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	value_label.add_theme_font_size_override("font_size", 10)
	value_label.add_theme_color_override("font_color", MainSceneHelpers._boxing_hub_athleticism_value_color(value, visual_contract))
	value_label.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.88))
	value_label.add_theme_constant_override("shadow_offset_x", 1)
	value_label.add_theme_constant_override("shadow_offset_y", 1)
	row.add_child(value_label)

	call_deferred("_boxing_hub_animate_athleticism_bar", bar, value)

	return row


func _boxing_hub_animate_athleticism_bar(bar: ProgressBar, target_value: int) -> void:
	if bar == null or not is_instance_valid(bar):
		return

	var tween:= create_tween()
	tween.bind_node(bar)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(bar, "value", float(clamp(target_value, 0, 100)), 0.42)


