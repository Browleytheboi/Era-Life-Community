func _ready_prebuilt_life_shell_snapshot() -> Dictionary:
	var snapshot_raw: Variant = get_meta("god_mode_zero_frame_entry_staged_snapshot", {})
	if typeof(snapshot_raw) == TYPE_DICTIONARY and not (snapshot_raw as Dictionary).is_empty():
		return (snapshot_raw as Dictionary).duplicate(true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var staged_raw: Variant = gs.scenario_state.get("god_mode_zero_frame_entry_staged_snapshot", {})
		if typeof(staged_raw) == TYPE_DICTIONARY and not (staged_raw as Dictionary).is_empty():
			return (staged_raw as Dictionary).duplicate(true)

		var prebuilt_raw: Variant = gs.scenario_state.get("prebuilt_first_frame_ui_snapshot", {})
		if typeof(prebuilt_raw) == TYPE_DICTIONARY and not (prebuilt_raw as Dictionary).is_empty():
			return (prebuilt_raw as Dictionary).duplicate(true)

		var first_frame_raw: Variant = gs.scenario_state.get("first_frame_ui_snapshot", {})
		if typeof(first_frame_raw) == TYPE_DICTIONARY and not (first_frame_raw as Dictionary).is_empty():
			return (first_frame_raw as Dictionary).duplicate(true)

		var consciousness_raw: Variant = gs.scenario_state.get("zero_frame_consciousness_switch_surface", {})
		if typeof(consciousness_raw) == TYPE_DICTIONARY and not (consciousness_raw as Dictionary).is_empty():
			return (consciousness_raw as Dictionary).duplicate(true)

	return {}

