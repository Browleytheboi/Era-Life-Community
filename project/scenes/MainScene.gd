func _hydrate_crime_hub_after_presented_idle(
	actor_id: int,
	section_id: String,
	reason: String = "crime_hub_after_presented_idle"
) -> void:
	var tree:= get_tree()

	if tree != null:
		var release_after_ms: int = int(
			get_meta(
				"renderer_present_fence_release_after_ms",
				0
			)
		)
		var remaining_ms: int = maxi(
			0,
			release_after_ms
			- int(
				Time.get_ticks_msec()
			)
		)

		if remaining_ms > 0:
			await tree.create_timer(
				float(remaining_ms) / 1000.0
			).timeout

		await tree.process_frame
		await tree.process_frame

	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
		or crime_panel == null
		or not is_instance_valid(
			crime_panel
		)
		or not crime_panel_open
		or current_panel != "crime"
	):
		return

	var clean_section: String = str(
		section_id
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = "overview"

	if (
		crime_panel.has_renderable_contract(
			actor_id
		)
		and str(
			crime_panel.active_contract.get(
				"active_section",
				""
			)
		).strip_edges().to_lower() == clean_section
	):
		set_meta(
			"crime_hub_post_paint_hydration_skipped_hot",
			true
		)
		return

	var hydration_started_ms: int = int(
		Time.get_ticks_msec()
	)
	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "open_crime_hub",
		"surface_id": "crime_panel",
		"action_id": "open_hub",
		"payload": {
			"actor_id": actor_id,
			"action_id": "open_hub",
			"section_id": clean_section,
			"source": (
				"mainscene.crime_hub_after_presented_idle"
			),
			"ui_is_renderer_only": true,
			"active_section_only": true,
			"refresh_all_sections": false,
			"refresh_sections": [
				clean_section
			],
			"remaining_sections_are_resident_shells": true,
			"ready_gate_member": false
		},
		"target": {
			"route_kind": "engine_method",
			"engine_property": "crime_hub_contract_engine",
			"method": "resolve_intent",
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": (
			"mainscene.crime_hub_after_presented_idle"
		)
	}, {
		"actor_id": actor_id,
		"surface_id": "crime_panel",
		"action_id": "open_hub",
		"source": (
			"mainscene.crime_hub_after_presented_idle"
		),
		"active_section_only": true
	})

	if (
		crime_panel_open
		and current_panel == "crime"
	):
		_render_crime_hub_route_result(
			report
		)

	EraLog.truth(
		(
			"ERALIFE_CRIME_POST_PAINT_HYDRATION"
			+ "|actor_id=%d"
			+ "|section=%s"
			+ "|door_was_already_open=true"
			+ "|first_paint_engine_work=false"
			+ "|active_section_only=true"
			+ "|reason=%s"
			+ "|elapsed_ms=%d"
		)
		% [
			actor_id,
			clean_section,
			reason,
			maxi(
				0,
				int(
					Time.get_ticks_msec()
				) - hydration_started_ms
			)
		]
	)
func _render_crime_hub_route_result(
	result: Dictionary
) -> void:
	if (
		crime_panel == null
		or not is_instance_valid(
			crime_panel
		)
	):
		set_meta(
			"crime_route_result_missing_renderer_chassis",
			true
		)
		return

	var routed: Dictionary = _hub_panel_route_result(
		result
	)

	var section_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		routed.get(
			"section_contract",
			{}
		)
	)

	if section_contract.is_empty():
		var action_report: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"action_report",
				{}
			)
		)

		section_contract = MainSceneHelpers._safe_dictionary(
			action_report.get(
				"section_contract",
				{}
			)
		)

	if not section_contract.is_empty():
		var section_id: String = str(
			section_contract.get(
				"section_id",
				routed.get(
					"crime_hub_section",
					crime_hub_active_section_id
				)
			)
		).strip_edges().to_lower()

		if section_id == "":
			section_id = "overview"

		crime_hub_active_section_id = section_id
		crime_panel_open = true

		crime_panel.apply_section_contract(
			section_id,
			section_contract,
			true
		)

		set_meta(
			"crime_route_result_section_delta_installed",
			true
		)
		set_meta(
			"crime_route_result_complete_hub_rebuild_performed",
			false
		)
		return

	var hub_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		routed.get(
			"hub_contract",
			{}
		)
	)

	if hub_contract.is_empty():
		var action_report: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"action_report",
				{}
			)
		)

		if not action_report.is_empty():
			hub_contract = MainSceneHelpers._safe_dictionary(
				action_report.get(
					"hub_contract",
					{}
				)
			)

	if hub_contract.is_empty():


		return

	crime_panel_active_contract = (
		hub_contract.duplicate(false)
	)
	crime_hub_active_section_id = str(
		hub_contract.get(
			"active_section",
			crime_hub_active_section_id
		)
	).strip_edges().to_lower()
	crime_panel_open = true

	crime_panel.render_contract(
		crime_panel_active_contract
	)

	set_meta(
		"crime_route_result_renderer_chassis_reused",
		true
	)
	set_meta(
		"crime_route_result_deep_copy_performed",
		false
	)
	set_meta(
		"crime_route_result_panel_constructed",
		false
	)
	set_meta(
		"crime_route_result_projection_hydrated_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
