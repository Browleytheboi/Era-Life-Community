		"property_viewer_owner_id",
		int(property_owner.id)
	)
	property_viewer_panel.set_meta(
		"property_viewer_actor_id",
		actor_id
	)
	property_viewer_panel.set_meta(
		"property_viewer_asset_id",
		asset_id
	)
	property_viewer_panel.set_meta(
		"property_viewer_contract_consumed_from_resident_asset_pack",
		true
	)
	property_viewer_panel.set_meta(
		"property_viewer_contract_requested_on_click",
		false
	)
	property_viewer_panel.set_meta(
		"property_viewer_rendered_on_click",
		false
	)
	property_viewer_panel.set_meta(
		"property_viewer_back_to_assets_ready",
		true
	)

	_suspend_standard_tab_popup_for_child_surface(
		"property_viewer_panel"
	)

	property_viewer_open = true
	property_viewer_panel.z_as_relative = false
