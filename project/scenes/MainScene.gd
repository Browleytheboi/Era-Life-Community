func _render_silk_road_observation_packet(
	packet: Dictionary
) -> void:
	if (
		silk_road_trade_list == null
		or gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		packet.get(
			"actor_id",
			-1
		)
	)

	if actor_id != int(
		gs.player.id
	):
		return

	var generation: int = int(
		packet.get(
			"generation",
			-1
		)
	)
	var phase: String = str(
		packet.get(
			"phase",
			""
		)
	).strip_edges().to_lower()

	if phase == "header":
		_clear_container_children(
			silk_road_trade_list
		)

		silk_road_trade_list.set_meta(
			"silk_road_resident_generation",
			generation
		)

		var intro:= PanelContainer.new()

		intro.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		intro.add_theme_stylebox_override(
			"panel",
			_build_era_surface_panel_style(
				"main",
				true,
				0.58,
				false
			)
		)

		silk_road_trade_list.add_child(
			intro
		)

		var margin:= MarginContainer.new()

		for margin_key in [
			"margin_left",
			"margin_top",
			"margin_right",
			"margin_bottom"
		]:
			margin.add_theme_constant_override(
				margin_key,
				14
			)

		intro.add_child(
			margin
		)

		var body:= VBoxContainer.new()

		body.add_theme_constant_override(
			"separation",
			7
		)
		margin.add_child(
			body
		)

		var title:= Label.new()

		title.text = (
			"CARAVAN EXCHANGE • LIVE SILK ROAD"
		)
		title.add_theme_font_size_override(
			"font_size",
			17
		)
		title.add_theme_color_override(
			"font_color",
			Color(
				1.0,
				0.92,
				0.68,
				1.0
			)
		)

		body.add_child(
			title
		)

		var explanation:= Label.new()

		explanation.text = (
			"Core routes persist. Rotating caravans may vanish, "
			+ "return, or introduce different goods as yearly "
			+ "supply and trade conditions move."
		)
		explanation.autowrap_mode = (
			TextServer.AUTOWRAP_WORD_SMART
		)

		body.add_child(
			explanation
		)

		var meta:= Label.new()

		meta.text = "Year %s  •  Funds %s" % [
			_format_year(
				int(
					packet.get(
						"market_year",
						gs.year
					)
				)
			),
			str(
				packet.get(
					"funds_display",
					"0"
				)
			)
		]

		body.add_child(
			meta
		)

		if not bool(
			packet.get(
				"market_open",
				false
			)
		):
			var unavailable:= Label.new()

			unavailable.text = (
				"No Silk Road caravan market operates in this year."
			)
			unavailable.autowrap_mode = (
				TextServer.AUTOWRAP_WORD_SMART
			)

			silk_road_trade_list.add_child(
				unavailable
			)

		var market_heading:= Label.new()

		market_heading.text = "LIVE CARAVAN BOARD"
		market_heading.add_theme_font_size_override(
			"font_size",
			14
		)

		silk_road_trade_list.add_child(
			market_heading
		)

		var market_grid:= GridContainer.new()

		market_grid.name = "SilkRoadMarketGrid"
		market_grid.columns = 3
		market_grid.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		market_grid.add_theme_constant_override(
			"h_separation",
			12
		)
		market_grid.add_theme_constant_override(
			"v_separation",
			12
		)

		silk_road_trade_list.add_child(
			market_grid
		)

		var barter_heading:= Label.new()

		barter_heading.text = (
			"YOUR BARTER GOODS • FULL VALUE EXCHANGE"
		)
		barter_heading.add_theme_font_size_override(
			"font_size",
			14
		)

		silk_road_trade_list.add_child(
			barter_heading
		)

		var barter_grid:= GridContainer.new()

		barter_grid.name = "SilkRoadBarterGrid"
		barter_grid.columns = 2
		barter_grid.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		barter_grid.add_theme_constant_override(
			"h_separation",
			12
		)
		barter_grid.add_theme_constant_override(
			"v_separation",
			10
		)

		silk_road_trade_list.add_child(
			barter_grid
		)

		if silk_road_trade_status_label != null:
			silk_road_trade_status_label.text = (
				"Caravans are publishing live…"
			)

		return

	var installed_generation: int = int(
		silk_road_trade_list.get_meta(
			"silk_road_resident_generation",
			-1
		)
	)

	if generation != installed_generation:
		return

	if phase == "listing":
		var listing: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"listing",
				{}
			)
		)
		var market_grid:= silk_road_trade_list.get_node_or_null(
			"SilkRoadMarketGrid"
		) as GridContainer

		if (
			listing.is_empty()
			or market_grid == null
		):
			return

		market_grid.add_child(
			_build_silk_road_listing_card(
				listing
			)
		)

		return

	if phase == "barter":
		var barter: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"barter",
				{}
			)
		)
		var barter_grid:= silk_road_trade_list.get_node_or_null(
			"SilkRoadBarterGrid"
		) as GridContainer

		if (
			barter.is_empty()
			or barter_grid == null
		):
			return

		barter_grid.add_child(
			_build_silk_road_barter_card(
				barter
			)
		)

		return

	if phase == "complete":
		var contract: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"market_contract",
				{}
			)
		)

		if not contract.is_empty():
			set_meta(
				"silk_road_resident_market_contract",
				contract.duplicate(false)
			)

		if silk_road_trade_status_label != null:
			silk_road_trade_status_label.text = (
				"%d live caravan listings • %d barter offers"
				% [
					int(
						packet.get(
							"listing_count",
							0
						)
					),
					int(
						packet.get(
							"barter_count",
							0
						)
					)
				]
			)


