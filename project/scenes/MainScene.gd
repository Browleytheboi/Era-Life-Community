func _queue_god_mode_life_prewarm_from_settings(
	settings: Dictionary,
	reason: String = "explicit_settings",
	reveal_household_start_selection: bool = false
) -> Dictionary:
	var candidate_settings: Dictionary = (
		MainSceneLogic._canonicalize_god_mode_reality_settings(
			settings,
			"%s_queue_prewarm" % reason
		)
	)

	var embedded_candidate_raw: Variant = candidate_settings.get(
		"_prebirth_reality_candidate",
		{}
	)
	var has_embedded_candidate: bool = (
		typeof(embedded_candidate_raw) == TYPE_DICTIONARY
		and not (
			embedded_candidate_raw as Dictionary
		).is_empty()
	)

	var seed_contract_raw: Variant = candidate_settings.get(
		"seed_contract",
		{}
	)
	var seed_contract_from_settings: Dictionary = (
		seed_contract_raw.duplicate(true)
		if typeof(seed_contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var has_seed: bool = int(
		candidate_settings.get(
			"world_seed",
			seed_contract_from_settings.get(
				"seed",
				-1
			)
		)
	) > 0

	if not has_embedded_candidate and not has_seed:
		candidate_settings = (
			_apply_god_mode_reality_candidate_to_settings(
				candidate_settings,
				reason
			)
		)

	var signature: String = _god_mode_life_prewarm_signature(
		candidate_settings
	)

	if signature == "":
		return {
			"success": false,
			"reason": "Prewarm signature could not be built."
		}

	if _is_god_mode_life_prewarm_ready_for_settings(
		candidate_settings
	):
		if reveal_household_start_selection:
			_show_household_start_selection_panel()

		return {
			"success": true,
			"mode": "already_prewarmed",
			"signature": signature
		}

	remove_meta(
		"god_mode_life_prewarmed_gs"
	)
	set_meta(
		"god_mode_life_prewarm_pending",
		true
	)
	set_meta(
		"god_mode_life_prewarm_ready",
		false
	)
	set_meta(
		"god_mode_life_prewarm_running",
		false
	)
	set_meta(
		"god_mode_life_prewarm_queued_signature",
		signature
	)
	set_meta(
		"god_mode_life_prewarm_queued_settings",
		candidate_settings.duplicate(true)
	)
	set_meta(
		"god_mode_life_prewarm_reason",
		reason
	)
	set_meta(
		"god_mode_life_prewarm_signature",
		signature
	)
	set_meta(
		"god_mode_life_prewarm_zero_frame_enforced",
		true
	)
	set_meta(
		"god_mode_life_prewarm_worker_report_pending",
		false
	)
	set_meta(
		"god_mode_life_prewarm_ui_thread_runtime_blocked",
		false
	)

	_mark_god_mode_tracker_prewarm_queued(
		candidate_settings,
		signature,
		reason
	)

	set_meta(
		"household_creator_prewarm_active",
		reveal_household_start_selection
	)
	set_meta(
		"household_creator_waiting_for_start_selection",
		reveal_household_start_selection
	)

	if gs != null:
		if typeof(gs.custom_settings) != TYPE_DICTIONARY:
			gs.custom_settings = {}

		for raw_key in candidate_settings.keys():
			gs.custom_settings [raw_key] = candidate_settings.get(
				raw_key
			)

		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"household_creator_prewarm_active"
		] = reveal_household_start_selection

		gs.scenario_state [
			"household_creator_waiting_for_start_selection"
		] = reveal_household_start_selection

		gs.scenario_state [
			"prewarm_fixed_delay_forbidden"
		] = true

	_suppress_prelife_loading_surfaces_for_god_mode(
		"%s_queue_prewarm" % reason
	)

	_set_god_mode_prewarm_progress(
		0.16,
		"Committing the resident world, identity, and family contract.",
		false
	)



	call_deferred(
		"_run_queued_god_mode_life_prewarm_deferred",
		signature,
		reason
	)

	return {
		"success": true,
		"mode": "queued_next_idle_transaction",
		"signature": signature,
		"fixed_delay_seconds": 0.0
	}
func _queue_god_mode_life_prewarm_from_current_ui(reason: String = "god_mode_change") -> void:
	if gs == null:
		return

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return

	var clean_reason: String = str(reason).strip_edges().to_lower()
	if clean_reason == "start_button_state":
		return

	if not _god_mode_reality_candidate_authorized(reason):
		set_meta("god_mode_life_prewarm_pending", false)
		set_meta("god_mode_life_prewarm_ready", false)
		set_meta("god_mode_life_prewarm_running", false)
		remove_meta("god_mode_life_prewarm_queued_signature")
		remove_meta("god_mode_life_prewarm_queued_settings")
		remove_meta("god_mode_life_prewarmed_gs")
		return

	if not _has_valid_birth_year_input() or not _has_valid_last_name_input():
		set_meta("god_mode_life_prewarm_pending", false)
		set_meta("god_mode_life_prewarm_ready", false)
		set_meta("god_mode_life_prewarm_running", false)
		_refresh_god_mode_start_button_state()
		return

	var prewarm_contract: Dictionary = _emit_god_mode_panel_prewarm_contract_from_current_ui(reason)
	if prewarm_contract.is_empty() or not bool(prewarm_contract.get("success", false)):
		set_meta("god_mode_life_prewarm_pending", false)
		set_meta("god_mode_life_prewarm_ready", false)
		set_meta("god_mode_life_prewarm_running", false)
		_set_god_mode_prewarm_progress(
			0.0,
			str(prewarm_contract.get("reason", "God Mode panel could not emit a prewarm contract.")),
			false
		)
		_refresh_god_mode_start_button_state()
		return

	var settings_raw: Variant = prewarm_contract.get("settings", {})
	var settings: Dictionary = settings_raw.duplicate(true) if typeof(settings_raw) == TYPE_DICTIONARY else {}
	if settings.is_empty():
		set_meta("god_mode_life_prewarm_pending", false)
		set_meta("god_mode_life_prewarm_ready", false)
		set_meta("god_mode_life_prewarm_running", false)
		_set_god_mode_prewarm_progress(
			0.0,
			"God Mode panel emitted a prewarm contract, but the settings payload was empty.",
			false
		)
		_refresh_god_mode_start_button_state()
		return

	var queue_report: Dictionary = _queue_god_mode_life_prewarm_from_settings(
		settings.duplicate(true),
		reason,
		false
	)

	if queue_report.is_empty() or not bool(queue_report.get("success", false)):
		_set_god_mode_prewarm_progress(
			0.0,
			str(queue_report.get("reason", "God Mode prewarm contract could not be queued.")),
			false
		)
		_refresh_god_mode_start_button_state()
		return

	if god_mode_start_button != null and is_instance_valid(god_mode_start_button):
		god_mode_start_button.text = "Prewarming your reality..."
		god_mode_start_button.disabled = true
		god_mode_start_button.self_modulate = Color(1.0, 0.96, 0.82, 0.86)
func _run_queued_god_mode_life_prewarm(signature: String, reason: String = "god_mode_change") -> void:
	call_deferred("_run_queued_god_mode_life_prewarm_deferred", signature, reason)


func _run_queued_god_mode_life_prewarm_deferred(
		signature: String,
		reason: String = "god_mode_change"
) -> void:
	if gs == null:
		return

	if str(
		get_meta(
			"god_mode_life_prewarm_queued_signature",
			""
		)
	) != signature:
		return

	var settings_raw: Variant = get_meta(
		"god_mode_life_prewarm_queued_settings",
		{}
	)
	var candidate_settings: Dictionary = (
		(settings_raw as Dictionary).duplicate(false)
		if typeof(
			settings_raw
		) == TYPE_DICTIONARY
		else _collect_custom_settings_from_ui()
	)

	if _god_mode_life_prewarm_signature(
		candidate_settings
	) != signature:
		return

	var seed_contract_raw: Variant = (
		candidate_settings.get(
			"seed_contract",
			{}
		)
	)
	var seed_contract: Dictionary = (
		(seed_contract_raw as Dictionary).duplicate(false)
		if typeof(
			seed_contract_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var world_seed: int = int(
		candidate_settings.get(
			"world_seed",
			seed_contract.get(
				"seed",
				-1
			)
		)
	)

	if world_seed <= 0:
		set_meta(
			"god_mode_life_prewarm_running",
			false
		)
		set_meta(
			"god_mode_life_prewarm_pending",
			false
		)
		set_meta(
			"god_mode_life_prewarm_ready",
			false
		)
		_set_god_mode_prewarm_progress(
			0.0,
			(
				"Prewarming stopped before residency "
				+ "because the world seed was invalid."
			),
			false
		)
		_refresh_god_mode_start_button_state()
		return

	var contract: Dictionary = (
		_build_god_mode_life_prewarm_contract(
			candidate_settings,
			reason
		)
	)

	set_meta(
		"god_mode_life_prewarm_running",
		true
	)
	set_meta(
		"god_mode_life_prewarm_running_signature",
		signature
	)
	set_meta(
		"god_mode_life_prewarm_thread_started",
		false
	)
	set_meta(
		"god_mode_life_prewarm_worker_report_pending",
		false
	)
	set_meta(
		"god_mode_life_prewarm_worker_mode",
		"persistent_runtime_residency"
	)
	set_meta(
		"god_mode_life_prewarm_thread_disabled_for_safety",
		true
	)
	set_meta(
		"god_mode_life_prewarm_immediate_service_loop_used",
		false
	)
	set_meta(
		"god_mode_life_prewarm_manager_owns_service_schedule",
		true
	)

	remove_meta(
		"god_mode_life_prewarm_thread"
	)
	remove_meta(
		"god_mode_life_prewarm_main_thread_payload"
	)

	var residency_report: Dictionary = (
		_request_reality_residency_intent(
			"reserve",
			{
				"signature": signature,
				"settings": (
					candidate_settings.duplicate(false)
				),
				"prewarm_contract": (
					contract.duplicate(false)
				),
				"candidate_slot": "god_mode_preview",
				"replace_uncommitted_slot": true,
				"commit_residency": false,
				"world_seed": world_seed,
			},
			"%s_stage_resident_reality" % reason
		)
	)

	if not bool(
		residency_report.get(
			"success",
			false
		)
	):
		set_meta(
			"god_mode_life_prewarm_running",
			false
		)
		set_meta(
			"god_mode_life_prewarm_pending",
			false
		)
		set_meta(
			"god_mode_life_prewarm_ready",
			false
		)
		_set_god_mode_prewarm_progress(
			0.0,
			str(
				residency_report.get(
					"reason",
					"Resident reality reservation failed."
				)
			),
			false
		)
		_refresh_god_mode_start_button_state()
		return




	var initial_progress: float = clampf(
		float(
			residency_report.get(
				"progress",
				0.16
			)
		),
		0.02,
		0.99
	)

	_set_god_mode_prewarm_progress(
		initial_progress,
		_residency_stage_label(
			str(
				residency_report.get(
					"stage_id",
					"resident_runtime"
				)
			)
		),
		false
	)

	_schedule_reality_residency_observation(
		signature,
		reason
	)
func _schedule_reality_residency_observation(
	signature: String,
	reason: String
) -> void:
	if str(
		get_meta(
			"god_mode_life_prewarm_running_signature",
			""
		)
	).strip_edges() != signature:
		return

	var scheduled_signature: String = str(
		get_meta(
			"reality_residency_observation_scheduled_signature",
			""
		)
	).strip_edges()
	var scheduled_generation: int = int(
		get_meta(
			"reality_residency_observation_scheduled_generation",
			0
		)
	)

	if (
		scheduled_signature == signature
		and scheduled_generation > 0
	):
		return

	var generation: int = int(
		get_meta(
			"reality_residency_observation_generation",
			0
		)
	) + 1

	set_meta(
		"reality_residency_observation_generation",
		generation
	)
	set_meta(
		"reality_residency_observation_scheduled_signature",
		signature
	)
	set_meta(
		"reality_residency_observation_scheduled_reason",
		reason
	)
	set_meta(
		"reality_residency_observation_scheduled_generation",
		generation
	)
	set_meta(
		"reality_residency_observation_scheduled_frame",
		int(
			Engine.get_process_frames()
		)
	)
	set_meta(
		"reality_residency_observation_scheduled_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"reality_residency_observation_arm_pending",
		true
	)




	call_deferred(
		"_arm_reality_residency_observation",
		signature,
		reason,
		generation
	)
func _arm_reality_residency_observation(
	signature: String,
	reason: String,
	generation: int
) -> void:
	if str(
		get_meta(
			"god_mode_life_prewarm_running_signature",
			""
		)
	).strip_edges() != signature:
		return

	if str(
		get_meta(
			"reality_residency_observation_scheduled_signature",
			""
		)
	).strip_edges() != signature:
		return

	if int(
		get_meta(
			"reality_residency_observation_scheduled_generation",
			0
		)
	) != generation:
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_deliver_reality_residency_observation",
			signature,
			reason,
			generation
		)
		return

	var delivery_callable: Callable = Callable(
		self,
		"_deliver_reality_residency_observation"
	).bind(
		signature,
		reason,
		generation
	)

	if tree.process_frame.is_connected(
		delivery_callable
	):
		set_meta(
			"reality_residency_observation_arm_pending",
			false
		)
		set_meta(
			"reality_residency_observation_armed_generation",
			generation
		)
		return

	var connection_error: int = tree.process_frame.connect(
		delivery_callable,
		CONNECT_ONE_SHOT
	)

	set_meta(
		"reality_residency_observation_connection_error",
		connection_error
	)
	set_meta(
		"reality_residency_observation_connection_attempt_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if connection_error != OK:


		call_deferred(
			"_deliver_reality_residency_observation",
			signature,
			reason,
			generation
		)
		return

	set_meta(
		"reality_residency_observation_arm_pending",
		false
	)
	set_meta(
		"reality_residency_observation_armed_generation",
		generation
	)
	set_meta(
		"reality_residency_observation_armed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _deliver_reality_residency_observation(
	signature: String,
	reason: String,
	generation: int
) -> void:
	var scheduled_signature: String = str(
		get_meta(
			"reality_residency_observation_scheduled_signature",
			""
		)
	).strip_edges()
	var scheduled_generation: int = int(
		get_meta(
			"reality_residency_observation_scheduled_generation",
			0
		)
	)

	if (
		scheduled_signature != signature
		or scheduled_generation != generation
	):
		return




	remove_meta(
		"reality_residency_observation_scheduled_signature"
	)
	remove_meta(
		"reality_residency_observation_scheduled_reason"
	)
	remove_meta(
		"reality_residency_observation_scheduled_generation"
	)
	remove_meta(
		"reality_residency_observation_scheduled_frame"
	)
	remove_meta(
		"reality_residency_observation_scheduled_at_ms"
	)
	remove_meta(
		"reality_residency_observation_armed_generation"
	)
	remove_meta(
		"reality_residency_observation_arm_pending"
	)

	set_meta(
		"reality_residency_observation_delivered_signature",
		signature
	)
	set_meta(
		"reality_residency_observation_delivered_reason",
		reason
	)
	set_meta(
		"reality_residency_observation_delivered_generation",
		generation
	)
	set_meta(
		"reality_residency_observation_delivered_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if str(
		get_meta(
			"god_mode_life_prewarm_running_signature",
			""
		)
	).strip_edges() != signature:
		return

	_observe_reality_residency_frame(
		signature,
		reason
	)
func _observe_reality_residency_frame(
		signature: String,
		reason: String
) -> void:
	if gs == null:
		return

	if str(
		get_meta(
			"god_mode_life_prewarm_running_signature",
			""
		)
	).strip_edges() != signature:
		return



	var status_report: Dictionary = (
		_request_reality_residency_intent(
			"observe",
			{
				"signature": signature,
				"source": (
					"%s_resident_status_observation"
					% reason
				),
				"ui_is_expression_only": true
			},
			"%s_observe_residency" % reason
		)
	)
	var reported_ready: bool = bool(
		status_report.get(
			"ready",
			false
		)
	)
	var constitutional_ready: bool = bool(
		status_report.get(
			"constitutional_ready",
			false
		)
	)
	var residency_is_ready: bool = (
		reported_ready
		or constitutional_ready
	)
	var progress: float = float(
		status_report.get(
			"progress",
			0.0
		)
	)
	var stage_id: String = str(
		status_report.get(
			"stage_id",
			"resident_runtime"
		)
	)
	var state: String = str(
		status_report.get(
			"state",
			"unknown"
		)
	)
	var first_false_gate: String = str(
		status_report.get(
			"first_false_gate",
			""
		)
	).strip_edges()
	var readiness_raw: Variant = status_report.get(
		"readiness_gates",
		{}
	)
	var readiness_gates: Dictionary = (
		(readiness_raw as Dictionary).duplicate(false)
		if typeof(
			readiness_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var service_attempt_count: int = int(
		status_report.get(
			"service_attempt_count",
			0
		)
	)
	var last_service_entered_at_ms: int = int(
		status_report.get(
			"last_service_entered_at_ms",
			0
		)
	)
	var last_service_completed_at_ms: int = int(
		status_report.get(
			"last_service_completed_at_ms",
			0
		)
	)
	var observer_truth_signature: String = (
		"%s|%s|%s|%s|%s|%d|%d|%d"
		% [
			signature,
			state,
			stage_id,
			str(residency_is_ready),
			first_false_gate,
			int(
				round(
					progress * 1000.0
				)
			),
			service_attempt_count,
			last_service_completed_at_ms
		]
	)
	var previous_observer_truth_signature: String = str(
		get_meta(
			"reality_residency_observer_truth_signature",
			""
		)
	)

	if (
		observer_truth_signature
		!= previous_observer_truth_signature
	):
		EraLog.truth(
			(
				"ERALIFE_RESIDENCY_OBSERVER"
				+ "|signature=%s"
				+ "|state=%s"
				+ "|reported_ready=%s"
				+ "|constitutional_ready=%s"
				+ "|effective_ready=%s"
				+ "|stage=%s"
				+ "|progress=%s"
				+ "|first_false_gate=%s"
				+ "|service_attempts=%d"
				+ "|last_service_entered_at_ms=%d"
				+ "|last_service_completed_at_ms=%d"
				+ "|service_key_present=%s"
				+ "|service_pump_armed=%s"
				+ "|status_elapsed_ms=%d"
				+ "|renderer_serviced_runtime=false"
				+ "|gates=%s"
			)
			% [
				signature,
				state,
				str(reported_ready),
				str(constitutional_ready),
				str(residency_is_ready),
				stage_id,
				str(progress),
				first_false_gate,
				service_attempt_count,
				last_service_entered_at_ms,
				last_service_completed_at_ms,
				str(
					status_report.get(
						"service_key_present",
						false
					)
				),
				str(
					status_report.get(
						"service_pump_armed",
						false
					)
				),
				int(
					status_report.get(
						"status_elapsed_ms",
						0
					)
				),
				JSON.stringify(
					readiness_gates
				)
			]
		)

		set_meta(
			"reality_residency_observer_truth_signature",
			observer_truth_signature
		)

	var compact_observation: Dictionary = {
		"signature": signature,
		"state": state,
		"stage_id": stage_id,
		"progress": progress,
		"ready": reported_ready,
		"constitutional_ready": constitutional_ready,
		"effective_ready": residency_is_ready,
		"first_false_gate": first_false_gate,
		"readiness_gates": readiness_gates,
		"service_attempt_count": service_attempt_count,
		"last_service_entered_at_ms": (
			last_service_entered_at_ms
		),
		"last_service_completed_at_ms": (
			last_service_completed_at_ms
		),
		"service_key_present": bool(
			status_report.get(
				"service_key_present",
				false
			)
		),
		"service_pump_armed": bool(
			status_report.get(
				"service_pump_armed",
				false
			)
		),
		"status_elapsed_ms": int(
			status_report.get(
				"status_elapsed_ms",
				0
			)
		),
		"observed_at_ms": int(
			Time.get_ticks_msec()
		)
	}

	set_meta(
		"reality_residency_last_observed_signature",
		signature
	)
	set_meta(
		"reality_residency_last_observed_stage_id",
		stage_id
	)
	set_meta(
		"reality_residency_last_observed_progress",
		progress
	)
	set_meta(
		"reality_residency_last_observed_state",
		state
	)
	set_meta(
		"reality_residency_last_observed_first_false_gate",
		first_false_gate
	)
	set_meta(
		"reality_residency_last_observed_readiness_gates",
		readiness_gates
	)
	set_meta(
		"reality_residency_last_observed_report",
		compact_observation
	)
	set_meta(
		"reality_residency_last_observed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"reality_residency_renderer_service_intent_used",
		false
	)

	var status_text: String = _residency_stage_label(
		stage_id
	)

	if (
		not residency_is_ready
		and first_false_gate != ""
	):
		status_text = "%s — waiting on %s" % [
			status_text,
			first_false_gate
		]

	_set_god_mode_prewarm_progress(
		clampf(
			progress,
			0.0,
			0.99
		),
		status_text,
		false
	)

	if residency_is_ready:
		var attach_report: Dictionary = (
			_request_reality_residency_intent(
				"attach",
				{
					"signature": signature,
				},
				"%s_attach_resident" % reason
			)
		)
		var attach_success: bool = bool(
			attach_report.get(
				"success",
				false
			)
		)

		EraLog.truth(
			(
				"ERALIFE_RESIDENCY_ATTACH"
				+ "|signature=%s"
				+ "|success=%s"
				+ "|mode=%s"
				+ "|reason=%s"
				+ "|has_game_state=%s"
				+ "|player_created=%s"
				+ "|renderer_build_performed=false"
			)
			% [
				signature,
				str(attach_success),
				str(
					attach_report.get(
						"mode",
						""
					)
				),
				str(
					attach_report.get(
						"reason",
						""
					)
				),
				str(
					attach_report.get(
						"game_state",
						null
					) is GameState
				),
				str(
					attach_report.get(
						"player_created",
						false
					)
				)
			]
		)

		if attach_success:
			_apply_god_mode_life_prewarm_thread_report(
				attach_report,
				signature,
				"%s_resident_attach" % reason
			)
			return

		_set_god_mode_prewarm_progress(
			0.0,
			str(
				attach_report.get(
					"reason",
					"Resident runtime could not attach."
				)
			),
			false
		)
		_refresh_god_mode_start_button_state()
		return

	if not bool(
		status_report.get(
			"success",
			true
		)
	):
		EraLog.truth(
			(
				"ERALIFE_RESIDENCY_FAILURE"
				+ "|signature=%s"
				+ "|state=%s"
				+ "|stage=%s"
				+ "|reason=%s"
				+ "|first_false_gate=%s"
			)
			% [
				signature,
				state,
				stage_id,
				str(
					status_report.get(
						"reason",
						"resident_runtime_construction_failed"
					)
				),
				first_false_gate
			]
		)

		_set_god_mode_prewarm_progress(
			0.0,
			str(
				status_report.get(
					"reason",
					"Resident runtime construction failed."
				)
			),
			false
		)
		_refresh_god_mode_start_button_state()
		return

	_schedule_reality_residency_observation(
		signature,
		reason
	)
func _on_god_mode_viewer_residency_candidate_changed(
	panel_state: Dictionary,
	reason: String
) -> void:
	if gs == null:
		return

	var candidate_settings: Dictionary = (
		MainSceneLogic._canonicalize_god_mode_reality_settings(
			panel_state,
			"%s_residency_candidate" % reason
		)
	)
	var candidate_raw: Variant = candidate_settings.get(
		"_prebirth_reality_candidate",
		{}
	)
	var seed_raw: Variant = candidate_settings.get(
		"seed_contract",
		{}
	)
	var has_candidate: bool = (
		typeof(candidate_raw) == TYPE_DICTIONARY
		and not (
			candidate_raw as Dictionary
		).is_empty()
	)
	var has_seed: bool = int(
		candidate_settings.get(
			"world_seed",
			(
				(seed_raw as Dictionary).get(
					"seed",
					-1
				)
				if typeof(seed_raw) == TYPE_DICTIONARY
				else -1
			)
		)
	) > 0

	if not has_candidate and not has_seed:
		candidate_settings = (
			_apply_god_mode_reality_candidate_to_settings(
				candidate_settings,
				"%s_residency_candidate" % reason
			)
		)

	var signature: String = (
		_god_mode_life_prewarm_signature(
			candidate_settings
		)
	)

	if signature == "":
		return

	var previous_signature: String = str(
		get_meta(
			"god_mode_residency_preview_signature",
			""
		)
	).strip_edges()

	set_meta(
		"god_mode_residency_preview_signature",
		signature
	)
	set_meta(
		"god_mode_residency_preview_settings",
		candidate_settings.duplicate(true)
	)
	set_meta(
		"god_mode_residency_candidate_observed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"god_mode_residency_candidate_observation_is_pure",
		true
	)
	set_meta(
		"god_mode_residency_candidate_observation_started_runtime",
		false
	)



	if (
		previous_signature != ""
		and previous_signature != signature
	):
		set_meta(
			"god_mode_residency_preview_signature_changed",
			true
		)
		set_meta(
			"god_mode_residency_preview_previous_signature",
			previous_signature
		)

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"god_mode_residency_preview_signature"
	] = signature
	gs.scenario_state [
		"god_mode_residency_preview_settings"
	] = candidate_settings.duplicate(true)
	gs.scenario_state [
		"god_mode_residency_candidate_observation_is_pure"
	] = true
	gs.scenario_state [
		"god_mode_residency_candidate_observation_started_runtime"
	] = false
func _residency_stage_label(
	stage_id: String
) -> String:
	var clean_stage: String = str(
		stage_id
	).strip_edges().to_lower()

	if clean_stage.begins_with(
		"engine:"
	):
		return (
			"Keeping runtime authority %s resident."
			% clean_stage.trim_prefix(
				"engine:"
			).replace(
				"_",
				" "
			).capitalize()
		)

	if clean_stage.begins_with(
		"projection:"
	):
		return (
			"Precomposing the %s contract graph."
			% clean_stage.trim_prefix(
				"projection:"
			).replace(
				"_",
				" "
			).capitalize()
		)

	return str(
		{
			"apply_reality_settings": (
				"Binding the selected world contract."
			),
			"spawn_shell_population": (
				"Attaching the observable population shell."
			),
			"create_player_identity": (
				"Attaching the playable identity anchor."
			),
			"apply_birth_contracts": (
				"Committing birth and household contracts."
			),
			"place_resident_population": (
				"Connecting resident lives to world-space truth."
			),
			"seed_first_frame_truth": (
				"Sealing the first observable reality frame."
			),
			"seal_resident_reality": (
				"Verifying the resident snapshot."
			),
			"complete": (
				"Resident reality is ready to attach."
			)
		}.get(
			clean_stage,
			"Advancing persistent runtime residency."
		)
	)
func _run_queued_god_mode_life_prewarm_main_thread_capsule(
	signature: String,
	reason: String = "god_mode_change"
) -> void:


	_run_queued_god_mode_life_prewarm_deferred(
		signature,
		"%s_residency_redirect" % reason
	)
func _schedule_god_mode_life_prewarm_thread_poll(signature: String, reason: String = "god_mode_change", delay_seconds: float = 0.08) -> void:
	var tree:= get_tree()
	if tree == null:
		call_deferred("_poll_god_mode_life_prewarm_thread", signature, reason)
		return

	var timer:= tree.create_timer(max(0.03, delay_seconds))
	timer.timeout.connect(
		Callable(self, "_poll_god_mode_life_prewarm_thread").bind(signature, reason),
		CONNECT_ONE_SHOT
	)


func _poll_god_mode_life_prewarm_thread(
	signature: String,
	reason: String = "god_mode_change"
) -> void:

	if str(
		get_meta(
			"god_mode_life_prewarm_running_signature",
			""
		)
	) != signature:
		return

	_observe_reality_residency_frame(
		signature,
		"%s_legacy_poll_redirect" % reason
	)
func _apply_god_mode_life_prewarm_thread_report(
	report: Dictionary,
	signature: String,
	reason: String = "god_mode_life_prewarm"
) -> void:
	var engine:= _ensure_god_mode_contract_engine()

	if engine == null:
		return

	var bridge_started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var engine_state: Dictionary = engine.current_state()
	var canonical_signature: String = str(
		engine_state.get(
			"tracked_signature",
			signature
		)
	).strip_edges()

	if canonical_signature == "":
		canonical_signature = str(
			signature
		).strip_edges()




	var normalized_report: Dictionary = (
		report.duplicate(false)
	)

	normalized_report [
		"signature"
	] = canonical_signature

	var contract_raw: Variant = normalized_report.get(
		"contract",
		{}
	)

	if typeof(
		contract_raw
	) == TYPE_DICTIONARY:
		var normalized_contract: Dictionary = (
			(contract_raw as Dictionary).duplicate(false)
		)

		normalized_contract [
			"signature"
		] = canonical_signature
		normalized_report [
			"contract"
		] = normalized_contract

	var accept_report: Dictionary = (
		engine.accept_prewarm_report(
			normalized_report,
			canonical_signature,
			{
				"source": reason,
				"canonical_signature": canonical_signature,
				"worker_signature": signature,
				"signature_normalized_for_viewer_contract": (
					canonical_signature
					!= str(
						signature
					).strip_edges()
				),
			}
		)
	)

	if (
		god_mode_viewer != null
		and is_instance_valid(
			god_mode_viewer
		)
	):
		god_mode_viewer.bind_contract_engine(
			engine
		)

	if not bool(
		accept_report.get(
			"success",
			false
		)
	):
		EraLog.truth(
			(
				"GOD_MODE_CONTRACT_ENGINE_PREWARM_REPORT_FAILED"
				+ "|reason=%s"
				+ "|expected=%s"
				+ "|received=%s"
			)
			% [
				str(
					accept_report.get(
						"reason",
						"unknown"
					)
				),
				canonical_signature,
				str(
					signature
				)
			]
		)
		return

	set_meta(
		"god_mode_life_prewarm_signature",
		canonical_signature
	)
	set_meta(
		"god_mode_prewarm_attachment_report_deep_copy_performed",
		false
	)
	set_meta(
		"god_mode_prewarm_attachment_report_bridge_started_at_ms",
		bridge_started_at_ms
	)

	var prewarmed_raw: Variant = normalized_report.get(
		"game_state",
		null
	)

	if prewarmed_raw is GameState:
		var prewarmed_gs: GameState = (
			prewarmed_raw as GameState
		)

		set_meta(
			"god_mode_life_prewarmed_gs",
			prewarmed_gs
		)













		var resident_identity_adopted: bool = (
			_adopt_attached_resident_game_state(
				prewarmed_gs,
				canonical_signature
			)
		)

		set_meta(
			"god_mode_prewarm_resident_identity_adopted",
			resident_identity_adopted
		)
		set_meta(
			"god_mode_prewarm_resident_identity_adopted_actor_id",
			(
				int(
					prewarmed_gs.player.id
				)
				if prewarmed_gs.player != null
				else -1
			)
		)
		set_meta(
			"god_mode_prewarm_resident_identity_adopted_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		_crime_panel_observer_bind_truth(
			(
				"pre_ready_resident_game_state_adopted"
				if resident_identity_adopted
				else "pre_ready_resident_game_state_adoption_failed"
			),
			{
				"actor_id": (
					int(
						prewarmed_gs.player.id
					)
					if prewarmed_gs.player != null
					else -1
				),
				"game_state_instance_id": (
					prewarmed_gs.get_instance_id()
				),
				"signature": canonical_signature,
				"ready_gate_member": false,
			}
		)

	_set_god_mode_prewarm_progress(
		0.92,
		(
			"Resident player and family are bound. "
			+ "Sealing the first visible Life room."
		),
		false
	)

	_stage_god_mode_playable_surface_for_zero_frame_entry(
		normalized_report,
		canonical_signature,
		"%s_stage_zero_frame_room" % reason
	)

	var door_hot: bool = _ready_door_latch_is_hot()
	var bridge_completed_at_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"god_mode_life_prewarm_pending",
		false
	)
	set_meta(
		"god_mode_life_prewarm_running",
		false
	)
	set_meta(
		"god_mode_life_prewarm_ready",
		door_hot
	)
	set_meta(
		"god_mode_life_prewarm_running_signature",
		""
	)
	set_meta(
		"god_mode_life_prewarm_worker_report_pending",
		false
	)
	set_meta(
		"god_mode_life_prewarm_native_tabs_are_detached_tail",
		true
	)
	set_meta(
		"god_mode_prewarm_attachment_report_bridge_completed_at_ms",
		bridge_completed_at_ms
	)
	set_meta(
		"god_mode_prewarm_attachment_report_bridge_elapsed_ms",
		maxi(
			0,
			bridge_completed_at_ms
			- bridge_started_at_ms
		)
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"god_mode_life_prewarm_ready"
		] = door_hot
		gs.scenario_state [
			"ready_door_latch_hot"
		] = door_hot
		gs.scenario_state [
			"god_mode_life_prewarm_native_tabs_are_detached_tail"
		] = true

	if not door_hot:
		var gate_raw: Variant = get_meta(
			"global_prewarm_contract_gate_report",
			{}
		)
		var gate_report: Dictionary = (
			(gate_raw as Dictionary).duplicate(false)
			if typeof(
				gate_raw
			) == TYPE_DICTIONARY
			else {}
		)
		var missing_raw: Variant = gate_report.get(
			"missing",
			[]
		)
		var missing_contracts: Array = (
			(missing_raw as Array).duplicate(false)
			if typeof(
				missing_raw
			) == TYPE_ARRAY
			else []
		)
		var main_tab_input_hot: bool = bool(
			get_meta(
				"main_tab_input_contract_hot",
				false
			)
		)

		_set_god_mode_prewarm_progress(
			0.94,
			(
				(
					"The resident player and family are ready, "
					+ "but the first-visible Life shell gate "
					+ "did not seal. Missing contracts: %s. "
					+ "Main-tab input hot: %s."
				)
				% [
					str(
						missing_contracts
					),
					str(
						main_tab_input_hot
					)
				]
			),
			false
		)

		_refresh_god_mode_start_button_state()
		return

	_set_god_mode_prewarm_progress(
		1.0,
		(
			"Resident reality, player, family, and first "
			+ "visible Life shell are ready. Optional "
			+ "projections remain detached from the door."
		),
		true
	)
	_refresh_god_mode_start_button_state()
func _show_household_start_selection_panel() -> void:
	var prewarmed_raw: Variant = get_meta("god_mode_life_prewarmed_gs", null)
	if not (prewarmed_raw is GameState):
		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = "Household prewarm finished, but no valid GameState capsule was returned."
		return

	var prewarmed_gs: GameState = prewarmed_raw as GameState
	if prewarmed_gs == null:
		return

	var settings: Dictionary = household_creator_pending_settings.duplicate(true)
	if settings.is_empty() and typeof(gs.custom_settings) == TYPE_DICTIONARY:
		settings = gs.custom_settings.duplicate(true)

	var contract: Dictionary = _household_spawn_contract_from_settings(settings)
	if contract.is_empty():
		return

	var members_raw: Variant = contract.get("members", [])
	var members: Array = members_raw if typeof(members_raw) == TYPE_ARRAY else []
	if members.is_empty():
		return

	if household_creator_start_selection_overlay != null and is_instance_valid(household_creator_start_selection_overlay):
		household_creator_start_selection_overlay.queue_free()

	household_creator_start_selection_overlay = Control.new()
	household_creator_start_selection_overlay.name = "HouseholdStartSelectionOverlay"
	household_creator_start_selection_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	household_creator_start_selection_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(household_creator_start_selection_overlay)
	_bring_modal_to_front(household_creator_start_selection_overlay)

	var dim:= ColorRect.new()
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.color = Color(0.03, 0.006, 0.002, 0.94)
	household_creator_start_selection_overlay.add_child(dim)

	var center:= CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	household_creator_start_selection_overlay.add_child(center)

	var card:= PanelContainer.new()
	card.custom_minimum_size = Vector2(760, 620)
	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.105, 0.018, 0.012, 0.985)
	style.border_color = Color(1.0, 0.22, 0.05, 0.86)
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.corner_radius_top_left = 28
	style.corner_radius_top_right = 28
	style.corner_radius_bottom_left = 28
	style.corner_radius_bottom_right = 28
	style.shadow_color = Color(1.0, 0.1, 0.02, 0.32)
	style.shadow_size = 30
	card.add_theme_stylebox_override("panel", style)
	center.add_child(card)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 28)
	margin.add_theme_constant_override("margin_right", 28)
	margin.add_theme_constant_override("margin_top", 26)
	margin.add_theme_constant_override("margin_bottom", 26)
	card.add_child(margin)

	var root:= VBoxContainer.new()
	root.add_theme_constant_override("separation", 14)
	margin.add_child(root)

	var title:= Label.new()
	title.text = "Choose who you start as"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 34)
	title.add_theme_color_override("font_color", Color(1.0, 0.84, 0.7, 1.0))
	root.add_child(title)

	var subtitle:= Label.new()
	subtitle.text = "The world seed is prewarmed. Pick the household member whose life you want to enter."
	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	subtitle.add_theme_font_size_override("font_size", 15)
	subtitle.add_theme_color_override("font_color", Color(1.0, 0.72, 0.62, 0.92))
	root.add_child(subtitle)

	var scroll:= ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(0, 450)
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	root.add_child(scroll)

	household_creator_start_selection_list = VBoxContainer.new()
	household_creator_start_selection_list.name = "household_creator_start_selection_list"
	household_creator_start_selection_list.add_theme_constant_override("separation", 10)
	scroll.add_child(household_creator_start_selection_list)

