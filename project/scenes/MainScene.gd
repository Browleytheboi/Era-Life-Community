func _on_bending_hub_find_master_pressed() -> void:
	if gs == null or gs.player == null or gs.bending_engine == null:
		return

	if int(gs.player.age) < 16:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Master Training Locked",
			"popup_text": "You are too young to search for a bending master.\n\nFinding a master unlocks at age 16.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	var element: String = MainSceneLogic._bending_hub_default_player_element(gs)
	if element == "":
		_maybe_show_action_result_popup({ "success": false, "text": "You do not have a bending element to train."})
		return

	var player_level: int = int(gs.bending_engine.get_bending_level(gs.player, element))
	if player_level < 18:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Not Ready For A Master",
			"popup_text": "Your %s bending foundation is still too raw.\n\nReach level 18 before searching for a master." % element,
			"popup_footer": "Tap anywhere to continue."
		})
		return

	var best_master: Person = null
	var best_level: int = -1

	for npc in gs.npcs:
		if npc == null:
			continue
		if int(npc.id) == int(gs.player.id):
			continue
		if not npc.alive:
			continue
		if str(npc.bending_nation) != "" and str(gs.player.bending_nation) != "" and str(npc.bending_nation) != str(gs.player.bending_nation):
			continue
		var level: int = int(gs.bending_engine.get_bending_level(npc, element))
		if level > best_level:
			best_level = level
			best_master = npc

	if best_master == null or best_level < player_level + 8:
		_maybe_show_action_result_popup({
			"success": false,
			"text": "You searched for a %s bending master, but nobody nearby could push you further." % element
		})
		return

	var result: Dictionary = gs.bending_engine.train_with_teacher(best_master, gs.player, element)
	result ["popup_title"] = "Bending Master"
	result ["popup_text"] = "%s %s trained you in %s bending.\n\n%s" % [
		best_master.first_name,
		best_master.last_name,
		element,
		str(result.get("text", ""))
	]
	result ["popup_footer"] = "Tap anywhere to continue."
	_maybe_show_action_result_popup(result)
	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
func _rebuild_bending_hub_profile_avatar_history(actor: Person) -> void:
	if bending_hud_profile_box == null:
		return

	for i in range(bending_hud_profile_box.get_child_count() - 1, -1, -1):
		var child: Node = bending_hud_profile_box.get_child(i)
		if child != null and bool(child.get_meta("bending_avatar_history_row", false)):
			bending_hud_profile_box.remove_child(child)
			child.queue_free()

	if gs == null or actor == null or gs.bending_engine == null:
		return

	_refresh_bending_hub_lightweight_snapshot("profile")

	var actor_type: String = str(actor.bending_type).strip_edges().to_lower()

	var potential_header:= MainSceneHelpers._make_bending_hub_section_label("Latent Potential")
	potential_header.set_meta("bending_avatar_history_row", true)
	bending_hud_profile_box.add_child(potential_header)

	var potential_label:= Label.new()
	potential_label.set_meta("bending_avatar_history_row", true)
	potential_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	potential_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	potential_label.text = str(bending_hud_potential_label.text if bending_hud_potential_label != null else "Latent Potential: None")
	bending_hud_profile_box.add_child(potential_label)

	var element_lines: Array = []
	for element in ["air", "water", "earth", "fire"]:
		var mastery_value: int = clamp(int(actor.bending_mastery.get(element, 0)), 0, 100)
		var potential_value: int = 0
		if gs.bending_engine.has_method("get_bending_latent_potential"):
			potential_value = int(gs.bending_engine.get_bending_latent_potential(actor, element))
		else:
			potential_value = clamp(int(actor.bending_latent_potential.get(element, 0)), 0, 100)

		if actor_type == "avatar" or actor_type == element or mastery_value > 0 or potential_value > 0:
			element_lines.append("%s • Mastery %d • Potential %d" % [
				element.capitalize(),
				mastery_value,
				potential_value
			])

	if not element_lines.is_empty():
		var element_label:= Label.new()
		element_label.set_meta("bending_avatar_history_row", true)
		element_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		element_label.text = "\n".join(element_lines)
		bending_hud_profile_box.add_child(element_label)

	if actor_type != "avatar":
		return

	var previous_avatars: Array = []

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var world_raw: Variant = gs.scenario_state.get("bending_world_championship", {})
		if typeof(world_raw) == TYPE_DICTIONARY:
			var world_state: Dictionary = world_raw as Dictionary
			var previous_raw: Variant = world_state.get("previous_avatars", [])
			if typeof(previous_raw) == TYPE_ARRAY:
				previous_avatars = (previous_raw as Array).duplicate(true)

	if previous_avatars.is_empty() and not _runtime_interactive_surface_busy() and gs.bending_engine.has_method("get_bending_world_championship_hub_payload"):
		var payload: Dictionary = gs.bending_engine.get_bending_world_championship_hub_payload(actor)
		var payload_avatars_raw: Variant = payload.get("previous_avatars", [])
		if typeof(payload_avatars_raw) == TYPE_ARRAY:
			previous_avatars = (payload_avatars_raw as Array).duplicate(true)

	var header:= MainSceneHelpers._make_bending_hub_section_label("Last 4 Avatars")
	header.set_meta("bending_avatar_history_row", true)
	bending_hud_profile_box.add_child(header)

	if previous_avatars.is_empty():
		var empty_label:= Label.new()
		empty_label.set_meta("bending_avatar_history_row", true)
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.text = "No past Avatar echoes have been indexed yet."
		bending_hud_profile_box.add_child(empty_label)
		return

	var start_index: int = max(0, previous_avatars.size() - 4)
	for i in range(start_index, previous_avatars.size()):
		var raw_avatar = previous_avatars [i]
		if typeof(raw_avatar) != TYPE_DICTIONARY:
			continue

		var avatar_row: Dictionary = raw_avatar
		var avatar_label:= Label.new()
		avatar_label.set_meta("bending_avatar_history_row", true)
		avatar_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		avatar_label.text = "%s • %s • lived %d years • born %s • died %s" % [
			str(avatar_row.get("name", "Unknown Avatar")),
			str(avatar_row.get("nation", "Unknown Nation")),
			int(avatar_row.get("lifespan", 0)),
			str(avatar_row.get("birth_year_label", avatar_row.get("birth_year", "Unknown"))),
			str(avatar_row.get("death_year_label", avatar_row.get("death_year", "Unknown")))
		]
		bending_hud_profile_box.add_child(avatar_label)
func _on_bending_hub_seek_duel_pressed() -> void:
	if gs == null or gs.player == null or gs.bending_engine == null:
		return

	if int(gs.player.age) < 10:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Dueling Locked",
			"popup_text": "You are too young to seek bending duels.\n\nDueling unlocks at age 10.",
			"popup_footer": "Tap anywhere to continue.",
			"text": "Bending duels unlock at age 10."
		})
		return

	if gs.has_method("resolve_runtime_boot_domain_gate"):
		var gate: Dictionary = _superpower_hub_safe_dictionary(gs.resolve_runtime_boot_domain_gate("bending", "seek_bending_duel", {
			"source": "bending_hub",
			"payload": {
				"action": "seek_bending_duel"
			}
		}))

		if bool(gate.get("buffer_intent", false)) and gs.has_method("queue_runtime_boot_intent"):
			gs.queue_runtime_boot_intent({
				"domain": "bending",
				"cie_domain": "bending_duels",
				"action_id": "seek_bending_duel",
				"actor_id": int(gs.player.id),
				"engine_property": "bending_engine",
				"method": "seek_bending_duel",
				"payload": {
					"action": "seek_bending_duel",
					"source": "bending_hub"
				},
				"source": "bending_hub",
				"resolution_strategy": "generate_if_missing",
				"causality_inversion_allowed": true,
				"truth_layer_required": true,
				"local_shell_text": "Reading duel pressure..."
			})

			_maybe_show_action_result_popup({
				"success": true,
				"popup_title": "Reading duel pressure...",
				"popup_text": "The local shell accepted your duel intent while reality finishes assembling compatible opponents.",
				"popup_footer": "IPS → CRBS → CIE → CJE → RIAS → ScenarioEngine.",
				"text": "Reading duel pressure..."
			})
			return

	bending_hub_pending_ability_id = "__duel__"
	_open_bending_hub_target_picker("__duel__")

func _on_bending_hub_ability_pressed(ability_id: String) -> void:
	if gs == null or gs.player == null or gs.bending_engine == null:
		return

	var ability: Dictionary = gs.bending_engine.get_bending_ability_by_id(gs.player, ability_id)
	if ability.is_empty():
		_maybe_show_action_result_popup({ "success": false, "text": "That bending ability is not available."})
		return

	var ability_name: String = str(ability.get("name", "That skill"))
	var lock_text: String = str(ability.get("lock_text", "")).strip_edges()

	if not bool(ability.get("unlocked", false)):
		if lock_text == "":
			lock_text = "Unlock path incomplete."
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Bending Skill Locked",
			"popup_text": "%s is locked.\n\nUnlock Path: %s" % [
				ability_name,
				lock_text
			],
			"popup_footer": "Tap anywhere to continue."
		})
		return

	if bool(ability.get("on_cooldown", false)):
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Skill Recovering",
			"popup_text": "%s is still recovering." % ability_name,
			"popup_footer": "Tap anywhere to continue."
		})
		return

	var scope: String = str(ability.get("target_scope", "nation"))
	if scope == "self":
		var result: Dictionary = gs.bending_engine.use_bending_ability(gs.player, gs.player, ability_id)
		_maybe_show_action_result_popup(result)
		bending_hud_last_rebuild_signature = ""
		_update_bending_hud()
		return

	_open_bending_hub_target_picker(ability_id)
