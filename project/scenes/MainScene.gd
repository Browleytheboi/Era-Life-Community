		return (superpower_sandbox_config as Dictionary).duplicate(true)
	return {}


func _normalize_superpower_sandbox_config_for_ui(raw_config: Variant) -> Dictionary:
	var out:= _build_default_superpower_sandbox_config()
	if typeof(raw_config) != TYPE_DICTIONARY:
		return out

	var raw: Dictionary = (raw_config as Dictionary).duplicate(true)
	if raw.has("scope"):
		out ["scope"] = str(raw.get("scope", out ["scope"])).strip_edges().to_lower()
	if raw.has("target_group"):
		out ["target_group"] = str(raw.get("target_group", "")).strip_edges()
	if raw.has("origin"):
		out ["origin"] = str(raw.get("origin", out ["origin"])).strip_edges().to_lower()
	if raw.has("primary_power"):
		out ["primary_power"] = str(raw.get("primary_power", out ["primary_power"])).strip_edges().to_lower()
	if raw.has("rarity"):
		out ["rarity"] = str(raw.get("rarity", out ["rarity"])).strip_edges().to_lower()
	if raw.has("public_identity"):
		out ["public_identity"] = str(raw.get("public_identity", out ["public_identity"])).strip_edges().to_lower()

	var awakening_raw: Variant = raw.get("awakening", {})
	if typeof(awakening_raw) == TYPE_DICTIONARY:
		var awakening: Dictionary = (awakening_raw as Dictionary).duplicate(true)
		var out_awakening: Dictionary = out ["awakening"]
		out_awakening ["mode"] = str(awakening.get("mode", out_awakening.get("mode", "latent"))).strip_edges().to_lower()
		out_awakening ["minimum_age"] = max(0, int(awakening.get("minimum_age", out_awakening.get("minimum_age", 0))))
		out_awakening ["public_visibility"] = str(awakening.get("public_visibility", out_awakening.get("public_visibility", "secret"))).strip_edges().to_lower()
		out ["awakening"] = out_awakening

	var inheritance_raw: Variant = raw.get("inheritance", {})
	if typeof(inheritance_raw) == TYPE_DICTIONARY:
		var inheritance: Dictionary = (inheritance_raw as Dictionary).duplicate(true)
		var out_inheritance: Dictionary = out ["inheritance"]
		out_inheritance ["mode"] = str(inheritance.get("mode", out_inheritance.get("mode", "dominant"))).strip_edges().to_lower()
		out_inheritance ["skips_generations"] = bool(inheritance.get("skips_generations", out_inheritance.get("skips_generations", false)))
		out_inheritance ["awakens_under_trauma"] = bool(inheritance.get("awakens_under_trauma", out_inheritance.get("awakens_under_trauma", false)))
		out_inheritance ["awakens_at_age_13"] = bool(inheritance.get("awakens_at_age_13", out_inheritance.get("awakens_at_age_13", false)))
		out_inheritance ["only_firstborn"] = bool(inheritance.get("only_firstborn", out_inheritance.get("only_firstborn", false)))
		out_inheritance ["only_avatars_benders"] = bool(inheritance.get("only_avatars_benders", out_inheritance.get("only_avatars_benders", false)))
		out_inheritance ["corrupts_bloodline_over_time"] = bool(inheritance.get("corrupts_bloodline_over_time", out_inheritance.get("corrupts_bloodline_over_time", false)))
		out_inheritance ["generation_strength_loss"] = clamp(float(inheritance.get("generation_strength_loss", out_inheritance.get("generation_strength_loss", 0.18))), 0.0, 1.0)
		out_inheritance ["mutation_chance"] = clamp(float(inheritance.get("mutation_chance", out_inheritance.get("mutation_chance", 0.07))), 0.0, 1.0)
		out ["inheritance"] = out_inheritance

	return out


func _god_mode_superpower_sandbox_enabled() -> bool:
	var mode_text:= _selected_reality_mode_text()
	if mode_text in ["chaos", "fantasy"]:
