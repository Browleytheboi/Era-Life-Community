				"source": (
					"mainscene.crown_war_contract"
				),
				"blocks_ui": false,
				"ready_gate_member": false
			}
		)




		var crown_routed: Dictionary = (
			_crown_hub_contract_route_result(
				report
			)
		)
		var routed: Dictionary = (
			crown_routed
			if not crown_routed.is_empty()
			else _contract_route_result(
				report
			)
		)
		var crown_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"crown_hub_contract",
				{}
			)
		)
		var result: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"result",
				routed
			)
		)

		if not crown_contract.is_empty():
			crown_hub_active_contract = (
				crown_contract.duplicate(false)
			)
			crown_hub_active_actor_id = actor_id
			crown_hub_contract_surface_revision = str(
				crown_contract.get(
					"surface_revision",
					crown_hub_contract_surface_revision
				)
			)

			var should_enter_war_room: bool = (
				action_id in [
					"declare_war",
					"set_war_strategy",
					"request_join_war",
					"resolve_war_outcome"
				]
			)

			if should_enter_war_room:
				if crown_hub_current_section == "diplomacy":
					_park_crown_diplomacy_surface_resident()

				crown_hub_current_section = "war"

			if crown_hub_open:


				_refresh_crown_hub_chrome()

				if crown_hub_current_section == "war":
					_render_crown_war_stream_shell()

		if result.is_empty():
			return result

		var committed_war_truth: bool = (
			bool(
				result.get(
					"success",
					false
				)
			)
			and bool(
				result.get(
					"committed",
					false
				)
			)
			and bool(
				result.get(
					"dynamic_war_tab_required",
					false
				)
			)
		)

		if committed_war_truth:



			_queue_crown_war_projection_background(
				actor_id,
				"war_action_committed"
			)

		var popup_text: String = str(
			result.get(
				"popup_text",
				result.get(
					"text",
					""
				)
			)
		).strip_edges()

		if popup_text != "":
			_maybe_show_action_result_popup({
				"success": bool(
					result.get(
						"success",
						routed.get(
							"success",
							true
						)
					)
				),
				"popup_title": str(
					result.get(
						"popup_title",
						(
							"WAR DECLARED"
							if action_id == "declare_war"
							else "WAR UPDATE"
						)
					)
				),
				"popup_text": popup_text,
				"popup_footer": (
					"The WAR tab is an observer of persistent world truth."
				)
			})

		set_meta(
			"crown_war_action_result_published",
			true
		)
		set_meta(
			"crown_war_action_result_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"crown_war_action_used_crown_route_authority",
			not crown_routed.is_empty()
		)
		set_meta(
			"crown_war_action_committed_truth",
			committed_war_truth
		)

		return result
func _render_crown_war_stream_shell() -> void:
