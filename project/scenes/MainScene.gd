	context ["active_section_id"] = resolved_section
	context ["click_path_must_not_block"] = true
	context ["render_shell_first"] = false
	context ["render_full_surface_immediately"] = true
	context ["ui_is_pure_renderer"] = true
	context ["packet_contract_required"] = true
	context ["perceived_truth_required"] = true
	context ["allow_deferred_truth_refresh"] = true
