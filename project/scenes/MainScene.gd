		or world_feed_popup_open
		or superpower_hub_open
		or power_hub_open
		or (profile_panel_popup != null and profile_panel_popup.visible)
		or (belongings_item_popup != null and belongings_item_popup.visible)
		or (belongings_item_target_popup != null and belongings_item_target_popup.visible)
		or crown_hub_open
		or (crown_action_popup != null and crown_action_popup.visible)
	)

	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(get_meta("age_up_transition_busy", false))
	)

	var allow_embedded_life_view: bool = (current_panel == "" or current_panel == "life")
	var can_show: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not has_modal_blocker
		and not blocked_by_age_up_loading
		and allow_embedded_life_view
		and _player_has_power_hub_access()
	)

	power_hud_button.visible = can_show
	if not can_show:
		_sync_runtime_floating_hud_layering()
		return

	_apply_runtime_hud_button_stack_layout(power_hud_button, 3)
	_sync_runtime_floating_hud_layering()

	var pulse:= (sin(power_hud_breathe_time * 2.8) + 1.0) * 0.5
	var core:= Color(0.38, 0.72, 1.0, 1.0)

	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(power_hud_button, "power_hud_button_style", 2, 18)
	if btn_style == null:
		return

	power_hud_button.add_theme_stylebox_override("normal", btn_style)
	power_hud_button.add_theme_stylebox_override("hover", btn_style)
	power_hud_button.add_theme_stylebox_override("pressed", btn_style)

	btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.12))
	btn_style.border_color = Color(core.r, core.g, core.b, 0.82 + (pulse * 0.12))
	power_hud_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	power_hud_button.text = "⚡️"
	power_hud_button.tooltip_text = "Open Super Power Hub\nPersonal powers, subskills, mutations, training, and supe-only stats."


func _animate_power_hud(delta: float) -> void:
	power_hud_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("power_hud_next_light_refresh_ms", 0))
	if now_ms >= next_refresh_ms:
		set_meta("power_hud_next_light_refresh_ms", now_ms + 220)
		_update_power_hud()
	elif power_hud_button != null and power_hud_button.visible:
		var pulse:= (sin(power_hud_breathe_time * 2.8) + 1.0) * 0.5
		var core:= Color(0.38, 0.72, 1.0, 1.0)
		var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(power_hud_button, "power_hud_button_style", 2, 18)
		if btn_style != null:
			btn_style.bg_color = Color(core.r, core.g, core.b, 0.18 + (pulse * 0.12))
			btn_style.border_color = Color(core.r, core.g, core.b, 0.82 + (pulse * 0.12))
