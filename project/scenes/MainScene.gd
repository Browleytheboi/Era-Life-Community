	var scroll:= ScrollContainer.new()
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll.follow_focus = false
	content_margin.add_child(scroll)
	_boxing_hub_apply_invisible_fast_scroll(scroll, visual_contract)

	var content:= VBoxContainer.new()
	content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	content.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	content.add_theme_constant_override("separation", 8)
	scroll.add_child(content)

	var selected: Dictionary = {}
	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue
		var section: Dictionary = raw_section
		var section_id: String = str(section.get("id", "")).strip_edges()
		if section_id == boxing_hub_selected_tab:
			selected = section
			break

	if selected.is_empty():
		var selected_root: String = boxing_hub_selected_tab.split(":") [0]
		for raw_section in sections:
			if typeof(raw_section) != TYPE_DICTIONARY:
				continue
			var section: Dictionary = raw_section
			if str(section.get("id", "")).split(":") [0] == selected_root:
				selected = section
				break

	if selected.is_empty() and not sections.is_empty() and typeof(sections [0]) == TYPE_DICTIONARY:
		selected = sections [0]

	_render_boxing_hub_section(content, selected)
	_boxing_hub_append_universal_scroll_runway(content, selected)
	call_deferred("_boxing_hub_force_universal_scroll_range", scroll, content, selected)

	boxing_hub_open = true
	_boxing_hub_apply_desktop_fullscreen_bounds()
	_bring_modal_to_front(boxing_hub_popup)
	_sync_runtime_floating_hud_layering()
func _boxing_hub_append_universal_scroll_runway(content: VBoxContainer, section: Dictionary = {}) -> void:
	if content == null or not is_instance_valid(content):
		return

	var existing:= content.get_node_or_null("BoxingHubUniversalScrollRunway")
	if existing != null and is_instance_valid(existing):
		existing.queue_free()

	var runway:= Control.new()
	runway.name = "BoxingHubUniversalScrollRunway"
	runway.mouse_filter = Control.MOUSE_FILTER_IGNORE
	runway.custom_minimum_size = Vector2(0, _boxing_hub_universal_scroll_runway_height(section))
	content.add_child(runway)


func _boxing_hub_universal_scroll_runway_height(section: Dictionary = {}) -> float:
	var viewport_height: float = max(420.0, get_viewport_rect().size.y)
	var section_id: String = str(section.get("id", "")).strip_edges().to_lower()
	var section_root: String = section_id.split(":") [0] if section_id != "" else ""

	match section_root:
		"growth":
			return clamp(viewport_height * 0.58, 320.0, 560.0)
		"rankings", "awards", "legacy", "history":
			return clamp(viewport_height * 0.34, 180.0, 360.0)
		_:
			return clamp(viewport_height * 0.26, 140.0, 300.0)


func _boxing_hub_force_universal_scroll_range(scroll: ScrollContainer, content: VBoxContainer, section: Dictionary = {}) -> void:
	if scroll == null or not is_instance_valid(scroll):
		return

	if content == null or not is_instance_valid(content):
		return

	var viewport_height: float = max(1.0, scroll.size.y)
	if viewport_height <= 1.0:
		viewport_height = max(360.0, get_viewport_rect().size.y - 180.0)

	var wanted_runway: float = _boxing_hub_universal_scroll_runway_height(section)
	var current_minimum: Vector2 = content.get_combined_minimum_size()
	var forced_height: float = max(current_minimum.y, viewport_height + wanted_runway)

	content.custom_minimum_size = Vector2(0, forced_height)

	if content.has_method("update_minimum_size"):
		content.call("update_minimum_size")

	var vbar:= scroll.get_v_scroll_bar()
	if vbar != null and is_instance_valid(vbar):
		vbar.step = 18.0
		vbar.page = max(1.0, viewport_height * 0.88)
		vbar.value = clamp(vbar.value, vbar.min_value, vbar.max_value)
func _boxing_hub_ensure_viewport_resize_contract() -> void:
	var viewport:= get_viewport()
	if viewport == null:
		return

	var resize_callable:= Callable(self, "_on_boxing_hub_viewport_size_changed")
	if not viewport.size_changed.is_connected(resize_callable):
		viewport.size_changed.connect(resize_callable)


func _on_boxing_hub_viewport_size_changed() -> void:
	if not boxing_hub_open:
		return

	if boxing_hub_popup == null or not is_instance_valid(boxing_hub_popup):
		return

	if not boxing_hub_popup.visible:
		return

	_boxing_hub_apply_desktop_fullscreen_bounds()

	if bool(get_meta("_boxing_hub_resize_refresh_pending", false)):
		return

	set_meta("_boxing_hub_resize_refresh_pending", true)
	call_deferred("_boxing_hub_refresh_open_panel_after_viewport_change")


func _boxing_hub_refresh_open_panel_after_viewport_change() -> void:
	set_meta("_boxing_hub_resize_refresh_pending", false)

	if not boxing_hub_open:
		return

	if boxing_hub_popup == null or not is_instance_valid(boxing_hub_popup):
		return

	if not boxing_hub_popup.visible:
		return

	_show_boxing_hub_panel(boxing_hub_selected_tab)


func _boxing_hub_desktop_fullscreen_size() -> Vector2i:
	var viewport_size: Vector2 = get_viewport_rect().size

	return Vector2i(
		int(max(360.0, ceil(viewport_size.x))),
		int(max(420.0, ceil(viewport_size.y)))
	)


func _boxing_hub_desktop_fullscreen_rect() -> Rect2i:
	return Rect2i(Vector2i.ZERO, _boxing_hub_desktop_fullscreen_size())


func _boxing_hub_apply_desktop_fullscreen_bounds() -> void:
	if boxing_hub_popup == null or not is_instance_valid(boxing_hub_popup):
		return

	var fullscreen_rect: Rect2i = _boxing_hub_desktop_fullscreen_rect()

	boxing_hub_popup.position = fullscreen_rect.position
	boxing_hub_popup.size = fullscreen_rect.size

	if boxing_hub_popup.visible:
		boxing_hub_popup.popup(fullscreen_rect)
		boxing_hub_popup.position = fullscreen_rect.position
		boxing_hub_popup.size = fullscreen_rect.size
	else:
		boxing_hub_popup.popup(fullscreen_rect)
		boxing_hub_popup.position = fullscreen_rect.position
		boxing_hub_popup.size = fullscreen_rect.size
func _render_boxing_hub_rankings_division_carousel(parent: VBoxContainer, section: Dictionary, visual_contract: Dictionary) -> void:
	if parent == null:
		return

	var controls: Array = section.get("division_controls", []) if typeof(section.get("division_controls", [])) == TYPE_ARRAY else []
	if controls.is_empty():
		return

	var carousel:= PanelContainer.new()
	carousel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	carousel.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_rankings_division_carousel_style(visual_contract))
	parent.add_child(carousel)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 10)
	margin.add_theme_constant_override("margin_top", 8)
	margin.add_theme_constant_override("margin_right", 10)
	margin.add_theme_constant_override("margin_bottom", 8)
	carousel.add_child(margin)

	var row:= HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_theme_constant_override("separation", 8)
	margin.add_child(row)

	for raw_control in controls:
		if typeof(raw_control) != TYPE_DICTIONARY:
			continue

		var control_data: Dictionary = raw_control
		var role: String = str(control_data.get("role", "button")).strip_edges().to_lower()
		var label_text: String = str(control_data.get("label", "")).strip_edges()
		if label_text == "":
			continue

		if role == "label":
			var label_card:= PanelContainer.new()
			label_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			label_card.custom_minimum_size = Vector2(0, 44)
			label_card.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_micro_card_style(visual_contract))
			row.add_child(label_card)

			var label_margin:= MarginContainer.new()
			label_margin.add_theme_constant_override("margin_left", 12)
			label_margin.add_theme_constant_override("margin_top", 8)
			label_margin.add_theme_constant_override("margin_right", 12)
			label_margin.add_theme_constant_override("margin_bottom", 8)
			label_card.add_child(label_margin)

			var label:= Label.new()
			label.text = label_text
			label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			label.add_theme_font_size_override("font_size", 15)
			label.add_theme_color_override("font_color", Color(1.0, 0.88, 0.54, 1.0))
			label_margin.add_child(label)
			continue

		var btn:= Button.new()
		btn.text = label_text
		btn.custom_minimum_size = Vector2(64, 44)
		btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER if role == "arrow" else Control.SIZE_EXPAND_FILL
		btn.focus_mode = Control.FOCUS_NONE
		btn.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		btn.add_theme_font_size_override("font_size", 13)
		btn.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_action_button_style(visual_contract, "normal"))
		btn.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_action_button_style(visual_contract, "hover"))
		btn.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_action_button_style(visual_contract, "pressed"))
		btn.add_theme_stylebox_override("focus", MainSceneHelpers._boxing_hub_action_button_style(visual_contract, "hover"))
		btn.add_theme_color_override("font_color", Color(1.0, 0.96, 0.86, 1.0))

		btn.pressed.connect(func ():
			_on_boxing_hub_action_pressed(control_data, str(section.get("id", "rankings")))
		)

		row.add_child(btn)
		_boxing_hub_bind_hover_motion(btn, 1.018)
func _render_boxing_hub_section(parent: VBoxContainer, section: Dictionary) -> void:
	if parent == null:
		return

	var visual_contract: Dictionary = MainSceneLogic._boxing_hub_visual_contract(gs)
	if section.is_empty():
		var empty:= Label.new()
		empty.text = "No boxing section data available."
		empty.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty.add_theme_color_override("font_color", visual_contract.get("muted_text", Color(0.88, 0.92, 1.0, 0.82)))
		parent.add_child(empty)
		return

	var section_id: String = str(section.get("id", "")).strip_edges()
	var section_root: String = section_id.split(":") [0]
	var is_fight_tab: bool = section_root == "fight"
	var header_parent: VBoxContainer = parent

	if is_fight_tab:
		var fight_surface:= HBoxContainer.new()
		fight_surface.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fight_surface.add_theme_constant_override("separation", 16)
		parent.add_child(fight_surface)

		var fight_left:= VBoxContainer.new()
		fight_left.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fight_left.add_theme_constant_override("separation", 7)
		fight_surface.add_child(fight_left)
		header_parent = fight_left

		var ladder:= _boxing_hub_make_legacy_ladder_card(visual_contract)
		ladder.size_flags_horizontal = Control.SIZE_SHRINK_END
		fight_surface.add_child(ladder)

	var section_title:= Label.new()
	section_title.text = "%s %s" % [
		str(section.get("emoji", "🥊")),
		str(section.get("title", "Boxing"))
	]
	section_title.add_theme_font_size_override("font_size", 23)
	section_title.add_theme_color_override("font_color", visual_contract.get("title", Color(1.0, 0.9, 0.66, 1.0)))
	section_title.add_theme_color_override("font_shadow_color", visual_contract.get("shadow_accent", Color(1.0, 0.3, 0.08, 0.45)))
	section_title.add_theme_constant_override("shadow_offset_x", 0)
	section_title.add_theme_constant_override("shadow_offset_y", 2)
	header_parent.add_child(section_title)

	if section_root == "growth":
		_render_boxing_hub_growth_intro(header_parent, section, visual_contract)
		_render_boxing_hub_growth_board(parent, section, visual_contract)
		return

	var summary:= Label.new()
	summary.text = str(section.get("summary", ""))
	summary.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	summary.add_theme_font_size_override("font_size", 13)
	summary.add_theme_color_override("font_color", visual_contract.get("muted_text", Color(0.84, 0.9, 1.0, 0.82)))
	header_parent.add_child(summary)

	var pfp_rows: Array = section.get("pfp_rows", []) if typeof(section.get("pfp_rows", [])) == TYPE_ARRAY else []
	if not pfp_rows.is_empty():
		var pfp_grid:= GridContainer.new()
		pfp_grid.columns = max(1, int(section.get("pfp_columns", 2)))
		pfp_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		pfp_grid.add_theme_constant_override("h_separation", 10)
		pfp_grid.add_theme_constant_override("v_separation", 8)
		parent.add_child(pfp_grid)

		for raw_pfp in pfp_rows:
			if typeof(raw_pfp) != TYPE_DICTIONARY:
				continue

			var pfp: Dictionary = raw_pfp
			var board:= PanelContainer.new()
			board.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			board.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_micro_card_style(visual_contract))
			pfp_grid.add_child(board)

			var board_margin:= MarginContainer.new()
			board_margin.add_theme_constant_override("margin_left", 12)
			board_margin.add_theme_constant_override("margin_top", 10)
			board_margin.add_theme_constant_override("margin_right", 12)
			board_margin.add_theme_constant_override("margin_bottom", 10)
			board.add_child(board_margin)

			var board_box:= VBoxContainer.new()
			board_box.add_theme_constant_override("separation", 4)
			board_margin.add_child(board_box)

			var board_title_row:= HBoxContainer.new()
			board_title_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			board_title_row.add_theme_constant_override("separation", 8)
			board_box.add_child(board_title_row)

			var board_title:= Label.new()
			board_title.text = str(pfp.get("title", "P4P"))
			board_title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			board_title.add_theme_font_size_override("font_size", 16)
			board_title.add_theme_color_override("font_color", Color(1.0, 0.86, 0.56, 1.0))
			board_title_row.add_child(board_title)

			var board_action: Dictionary = pfp.get("action", {}) if typeof(pfp.get("action", {})) == TYPE_DICTIONARY else {}
			if not board_action.is_empty():
				var board_button:= Button.new()
				board_button.text = str(board_action.get("label", "Switch Rankings"))
