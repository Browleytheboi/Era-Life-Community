func _contract_surface_runtime_state(surface_id: String) -> Dictionary:
	if gs == null or gs.ui_contract_engine == null:
		return {}

	var clean_surface: String = str(surface_id).strip_edges()
	if clean_surface == "":
		return {}

	var raw_state: Variant = gs.ui_contract_engine.surface_runtime_state.get(clean_surface, {})
	if typeof(raw_state) == TYPE_DICTIONARY:
		return (raw_state as Dictionary).duplicate(true)

	return {}


func _grocery_relationship_context_should_restore_surface(context: Dictionary) -> bool:
	if typeof(context) != TYPE_DICTIONARY or context.is_empty():
		return false

	if not bool(context.get("active", false)):
		return false

	var store_id: String = str(context.get("store_id", "")).strip_edges()
	if store_id == "":
		return false

	var surface_state: Dictionary = _contract_surface_runtime_state("food_contract_hub")
	if surface_state.is_empty():
		return false

	if bool(surface_state.get("grocery_manual_leave_committed", false)):
		return false

	var state_store_id: String = str(surface_state.get("store_id", "")).strip_edges()
	var inside_store: bool = bool(surface_state.get("grocery_inside_store", state_store_id != ""))

	if not inside_store:
		return false

	if state_store_id != "" and state_store_id != store_id:
		return false

	return true


func _close_food_contract_surface_from_header_x(reason: String = "manual_close") -> void:
	if gs == null or gs.ui_contract_engine == null:
		_stop_grocery_store_music("food_contract_surface_closed_without_ui_engine:%s" % reason)
		return

	var surface_state: Dictionary = _contract_surface_runtime_state("food_contract_hub")
	var leaving_store_id: String = str(surface_state.get("store_id", "")).strip_edges()
	var was_inside_store: bool = bool(surface_state.get("grocery_inside_store", leaving_store_id != ""))

	_clear_grocery_relationship_profile_context("food_contract_surface_closed:%s" % reason)

	set_meta("grocery_aisle_carousel_transition_token", int(get_meta("grocery_aisle_carousel_transition_token", 0)) + 1)
	set_meta("grocery_aisle_carousel_transition_active", false)

	if was_inside_store or leaving_store_id != "" or _grocery_store_music_is_active():
		var viewport_size: Vector2 = get_viewport_rect().size
		var context:= {
			"panel": current_panel,
			"player_id": int(gs.player.id) if gs.player != null else -1,
			"actor_id": int(gs.player.id) if gs.player != null else -1,
			"year": int(gs.year),
			"viewport_width": int(viewport_size.x),
			"viewport_height": int(viewport_size.y),
			"device_profile": _ui_contract_device_profile_from_viewport(viewport_size),
			"active_section_id": str(surface_state.get("active_section_id", ui_contract_active_section_id)),
			"manual_surface_close": true,
			"close_surface_reason": reason
		}

		var report: Dictionary = gs.ui_contract_engine.route_interaction("food_contract_hub", "grocery_back:stores", {}, context)
		var action_result: Dictionary = report.get("action_result", {}) if typeof(report.get("action_result", {})) == TYPE_DICTIONARY else {}

		if not report.is_empty():
			_sync_food_lifestyle_audio_from_contract_route("food_contract_hub", "grocery_back:stores", report, action_result)
		else:
			_stop_grocery_store_music("food_contract_surface_manual_close_fallback:%s" % reason)

		gs.ui_contract_engine.sync_surface_state("food_contract_hub", {
			"store_id": "",
			"aisle_id": "",
			"grocery_inside_store": false,
			"grocery_cart_unlocked": false,
			"grocery_ready_for_cashier": false,
			"grocery_self_checkout_active": false,
			"self_checkout_state": "",
			"self_checkout_machine_id": "",
			"self_checkout_exit_ready": false,
			"active_cashier": {},
			"last_action_report": {},
			"active_section_id": "stores",
			"notice": "You left the store.",
			"grocery_manual_leave_committed": true,
			"grocery_manual_leave_reason": reason,
			"grocery_manual_leave_store_id": leaving_store_id,
			"grocery_manual_leave_at_ms": int(Time.get_ticks_msec())
		})
		gs.ui_contract_engine.set_active_section("food_contract_hub", "stores")

	if gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("stop_grocery_store_realtime_session"):
		if leaving_store_id != "":
			gs.grocery_store_engine.stop_grocery_store_realtime_session(leaving_store_id)
		else:
			gs.grocery_store_engine.stop_grocery_store_realtime_session()

	set_meta("grocery_store_realtime_mode_active", false)


func _close_contract_surface_panel(reason: String = "manual_close") -> void:
	var closing_surface_id: String = str(ui_contract_active_surface_id).strip_edges()

	if closing_surface_id == "food_contract_hub":
		_close_food_contract_surface_from_header_x(reason)

	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		ui_contract_surface_panel.visible = false
		ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

	ui_contract_active_surface_id = ""
	ui_contract_active_section_id = ""

	set_meta("contract_surface_closed_reason", reason)
	set_meta("contract_surface_closed_at_ms", int(Time.get_ticks_msec()))
	set_meta("runtime_floating_hud_restore_requested_after_contract_surface_close", true)

	_update_food_lifestyle_hud()
	_update_crown_hud()
	_update_belongings_hud()
	_update_rick_weapon_shop_hud(false)
	_sync_runtime_floating_hud_layering()
