	institution_hub_active_surface_key = key


func _hide_all_institution_hub_deck_surfaces() -> void:
	for raw_key in institution_hub_surface_deck.keys():
		var surface: Dictionary = MainSceneHelpers._safe_dictionary(
			institution_hub_surface_deck.get(
				raw_key,
				{}
			)
		)
		var overlay: Control = surface.get(
			"overlay",
			null
		) as Control

		if (
			overlay == null
			or not is_instance_valid(overlay)
		):
			continue

		overlay.visible = false
		overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)


func _ensure_institution_hub_surface_shell(
	kind: String,
	section: String,
	reason: String = (
		"institution_surface_shell"
	)
) -> bool:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_kind == "":
		return false

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	var key: String = (
		_institution_hub_surface_key(
			clean_kind,
			clean_section
		)
	)
	var existing: Dictionary = MainSceneHelpers._safe_dictionary(
		institution_hub_surface_deck.get(
			key,
			{}
		)
	)
	var existing_overlay: Control = existing.get(
		"overlay",
		null
	) as Control

	if (
		existing_overlay != null
		and is_instance_valid(existing_overlay)
	):
		return true

	var previous_key: String = (
		institution_hub_active_surface_key
	)

	if (
		institution_hub_overlay != null
		and is_instance_valid(
			institution_hub_overlay
		)
	):
		_store_active_institution_hub_surface()

		if previous_key == "":
			previous_key = (
				institution_hub_active_surface_key
			)

	_clear_active_institution_hub_references()

	institution_hub_kind = clean_kind
	institution_hub_current_section = (
		clean_section
	)
	institution_hub_open = false

	_ensure_institution_hub_overlay()

	if (
		institution_hub_overlay == null
		or not is_instance_valid(
			institution_hub_overlay
		)
	):
		return false

	institution_hub_overlay.visible = false
	institution_hub_overlay.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	institution_hub_overlay.set_meta(
		"institution_surface_truth_state",
		"observable_partial"
	)
	institution_hub_overlay.set_meta(
		"institution_surface_hydrated",
		false
	)
	institution_hub_overlay.set_meta(
		"institution_surface_shell_reason",
		reason
	)
	institution_hub_overlay.set_meta(
		"institution_surface_shell_hot",
		true
	)

	if institution_hub_title != null:
		institution_hub_title.text = (
			"%s HUB"
			% clean_kind.to_upper()
		)

	if institution_hub_status_label != null:
		institution_hub_status_label.text = (
			"%s exists and remains observable while deeper truth resolves."
			% clean_kind.capitalize()
		)

	var shell_surface: Dictionary = (
		_capture_active_institution_hub_surface(
			clean_kind,
			clean_section
		)
	)
	institution_hub_surface_deck [key] = (
		shell_surface
	)

	if (
		previous_key != ""
		and institution_hub_surface_deck.has(
			previous_key
		)
	):
		_install_institution_hub_surface(
			MainSceneHelpers._safe_dictionary(
				institution_hub_surface_deck.get(
					previous_key,
					{}
				)
			)
		)
	else:
		_install_institution_hub_surface(
			shell_surface
		)

	return true


func _hydrate_institution_hub_surface(
	kind: String,
	section: String,
	reason: String = (
		"institution_surface_hydration"
	)
) -> bool:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_kind == "":
		return false

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	if clean_kind == "relationships":
		clean_section = MainSceneLogic._relationship_hub_resolve_section_id(gs, 
			clean_section
		)

		if clean_section == "":
			clean_section = "family"

	var key: String = _institution_hub_surface_key(
		clean_kind,
		clean_section
	)

	if not _ensure_institution_hub_surface_shell(
		clean_kind,
		clean_section,
		reason
	):
		return false

	var previous_key: String = (
		institution_hub_active_surface_key
	)
	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		institution_hub_surface_deck.get(
			key,
			{}
		)
	)

	if not _install_institution_hub_surface(
		surface
	):
		return false

	institution_hub_kind = clean_kind
	institution_hub_current_section = clean_section
	institution_hub_open = true

	_refresh_institution_hub()

	var overlay_ready: bool = (
		institution_hub_overlay != null
		and is_instance_valid(
			institution_hub_overlay
		)
	)
	var list_ready: bool = (
		institution_hub_list != null
		and is_instance_valid(
			institution_hub_list
		)
		and institution_hub_list.get_child_count() > 0
	)
	var section_lane_ready: bool = (
		clean_kind != "relationships"
		or (
			institution_hub_section_bar != null
			and is_instance_valid(
				institution_hub_section_bar
			)
			and institution_hub_section_bar.get_child_count() > 0
		)
	)
	var projection_composed: bool = (
		overlay_ready
		and list_ready
		and section_lane_ready
	)

	institution_hub_open = false

	if overlay_ready:
		institution_hub_overlay.visible = false
		institution_hub_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		institution_hub_overlay.set_meta(
			"institution_surface_truth_state",
			(
				"hot"
				if projection_composed
				else "observable_partial"
			)
		)
		institution_hub_overlay.set_meta(
			"institution_surface_hydrated",
			projection_composed
		)
		institution_hub_overlay.set_meta(
			"institution_surface_hydrated_reason",
			reason
		)
		institution_hub_overlay.set_meta(
			"institution_surface_hydrated_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		institution_hub_overlay.set_meta(
			"institution_surface_projection_composed",
			projection_composed
		)

	var captured_surface: Dictionary = (
		_capture_active_institution_hub_surface(
			clean_kind,
			clean_section
		)
	)
	captured_surface ["truth_state"] = (
		"hot"
			if projection_composed
			else "observable_partial"
	)
	captured_surface ["hydrated"] = projection_composed
	captured_surface ["projection_composed"] = (
		projection_composed
	)
	captured_surface ["projection_child_count"] = (
		institution_hub_list.get_child_count()
			if (
				institution_hub_list != null
				and is_instance_valid(
					institution_hub_list
				)
			)
			else 0
	)
	captured_surface ["hydrated_reason"] = reason
	captured_surface ["hydrated_at_ms"] = int(
		Time.get_ticks_msec()
	)
	institution_hub_surface_deck [key] = captured_surface

	if (
		previous_key != ""
		and institution_hub_surface_deck.has(
			previous_key
		)
	):
		_install_institution_hub_surface(
			MainSceneHelpers._safe_dictionary(
				institution_hub_surface_deck.get(
					previous_key,
					{}
				)
			)
		)
	else:
		_install_institution_hub_surface(
			captured_surface
		)

	return projection_composed

func _activate_institution_hub_surface(
	kind: String,
	section: String
) -> bool:
	if (
		gs == null
		or gs.player == null
	):
		return false

	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	if clean_kind == "relationships":
		clean_section = MainSceneLogic._relationship_hub_resolve_section_id(gs, 
			clean_section
		)

		if clean_section == "":
			clean_section = "family"

	var actor_id: int = int(
		gs.player.id
	)
	var key: String = _institution_hub_surface_key(
		clean_kind,
		clean_section,
		actor_id
	)
	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		institution_hub_surface_deck.get(
			key,
			{}
		)
	)



	if (
		surface.is_empty()
		or not _main_tab_surface_is_renderable(
			clean_kind,
			clean_section
		)
		or not _native_main_tab_surface_is_hot(
			clean_kind,
			clean_section
		)
	):
		return false

	if not _install_institution_hub_surface(
		surface
	):
		return false

	_hide_all_institution_hub_deck_surfaces()



	if not _install_institution_hub_surface(
		surface
	):
		return false

	institution_hub_kind = clean_kind
	institution_hub_current_section = clean_section
	institution_hub_open = true
	institution_hub_overlay.visible = true
	institution_hub_overlay.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	institution_hub_overlay.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	institution_hub_overlay.z_as_relative = false
	institution_hub_overlay.z_index = 120

	_bring_modal_to_front(
		institution_hub_overlay
	)

	set_meta(
		"institution_surface_revealed_actor_id",
		actor_id
	)
	set_meta(
		"institution_surface_revealed_key",
		key
	)
	set_meta(
		"institution_surface_revealed_complete_projection",
		true
	)

	return true
func _prewarm_native_main_tab_shell(
	panel_id: String,
	reason: String = "native_main_tab_shell_prewarm"
) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	var clean_panel: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_panel == "":
		return {
			"success": false,
			"reason": "empty_panel_id"
		}

	var shell_hot: bool = false

	match clean_panel:
		"life":
			shell_hot = (
				output_label != null
				and is_instance_valid(
					output_label
				)
			)

		"world":
			_ensure_world_feed_popup()
			shell_hot = (
				world_feed_popup != null
				and is_instance_valid(
					world_feed_popup
				)
			)

			if shell_hot:
				world_feed_popup.visible = false
				world_feed_popup.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

		"activities":
			_ensure_activities_hub_panel()
			shell_hot = (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
			)

			if shell_hot:
				activities_action_open = false
				activities_hub_panel.visible = false
				activities_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

		"mods":
			_ensure_mod_menu_panel()
			_ensure_mod_bundle_menu_panel()

			shell_hot = (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and mod_bundle_menu_panel != null
				and is_instance_valid(
					mod_bundle_menu_panel
				)
			)

			if shell_hot:
				mod_menu_panel.visible = false
				mod_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				mod_menu_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				mod_bundle_menu_panel.visible = false
				mod_bundle_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				mod_bundle_menu_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

		"career":
			_ensure_career_hub_panel()

			shell_hot = (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
			)

			if shell_hot:
				career_hub_panel.visible = false
				career_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				career_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

		"school":
			var school_panel: SchoolHubPanel = (
				_ensure_school_hub_panel()
			)

			shell_hot = (
				school_panel != null
				and school_panel.has_surface_shell()
			)

			if shell_hot:
				school_panel.hide_surface()

		"relationships":
			var relationship_panel: RelationshipHubPanel = (
				_ensure_relationship_hub_panel()
			)

			shell_hot = (
				relationship_panel != null
				and relationship_panel.has_surface_shell()
			)

			if shell_hot:
				relationship_panel.hide_surface()

			_prewarm_relationship_profile_popup_shell_for_relationship_hub(
				"%s_relationship_profile_shell" % reason
			)

		_:
			shell_hot = false

	set_meta(
		"native_main_tab_shell_hot_%s" % clean_panel,
		shell_hot
	)
	set_meta(
		"native_main_tab_shell_hot_%s_at_ms" % clean_panel,
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"native_main_tab_shell_hot_%s_reason" % clean_panel,
		reason
	)

	if typeof(
		gs.scenario_state
	) == TYPE_DICTIONARY:
		gs.scenario_state [
			"native_main_tab_shell_hot_%s" % clean_panel
		] = shell_hot
		gs.scenario_state [
			"native_main_tab_shell_hot_%s_at_ms" % clean_panel
		] = int(
			Time.get_ticks_msec()
		)

	return {
		"success": shell_hot,
		"panel_id": clean_panel,
		"shell_hot": shell_hot,
		"click_path_build_forbidden": true,
		"ui_is_renderer_only": true
	}

func _global_prewarm_verify_native_main_tab_shell(
	panel_id: String
) -> Dictionary:
	var clean_panel: String = str(
		panel_id
	).strip_edges().to_lower()
	var hot: bool = bool(
		get_meta(
			"native_main_tab_shell_hot_%s"
			% clean_panel,
			false
		)
	)

	if (
		gs != null
		and typeof(gs.scenario_state)
		== TYPE_DICTIONARY
	):
		hot = (
			hot
			or bool(
				gs.scenario_state.get(
					"native_main_tab_shell_hot_%s"
					% clean_panel,
					false
				)
			)
		)

	return {
		"success": hot,
		"reason": (
			"native_main_tab_shell_hot"
			if hot
			else "native_main_tab_shell_cold"
		),
		"panel_id": clean_panel,
		"shell_only": true,
		"click_path_build_forbidden": true,
		"ui_is_renderer_only": true
	}
func _institution_hub_add_entity_relationship_group(title_text: String, cards: Array, empty_text: String = "None", options: Dictionary = {}) -> void:
	if institution_hub_list == null:
		return
	var section_key: String = str(options.get("section_key", "pets")).strip_edges().to_lower()
	var highlight_cards: bool = bool(options.get("highlight_cards", true))
	var columns: int = int(options.get("columns", 2))
	var palette: Dictionary = MainSceneHelpers._relationship_hub_section_palette(section_key)
	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var panel_style: StyleBoxFlat = MainSceneHelpers._institution_hub_inner_panel_style(institution_hub_kind).duplicate()
	panel_style.border_color = Color(palette.get("accent", Color(0.72, 1.0, 0.62, 0.92)))
	panel_style.border_width_left = 2
	panel_style.border_width_top = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel.add_theme_stylebox_override("panel", panel_style)
	institution_hub_list.add_child(panel)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_bottom", 12)
	panel.add_child(margin)

	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 10)
	margin.add_child(vbox)

	var title:= Label.new()
	title.text = title_text
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", Color(palette.get("accent", Color(0.72, 1.0, 0.62, 0.92))))
	vbox.add_child(title)

	var subtitle_text: String = str(options.get("subtitle", "")).strip_edges()
	if subtitle_text != "":
		var subtitle:= Label.new()
		subtitle.text = subtitle_text
		subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		subtitle.add_theme_color_override("font_color", Color(0.9, 1.0, 0.9, 0.84))
		vbox.add_child(subtitle)

	if cards.is_empty():
		var empty_label:= Label.new()
		empty_label.text = empty_text
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty_label.add_theme_color_override("font_color", Color(0.88, 0.94, 0.88, 0.86))
		vbox.add_child(empty_label)
		return

	var grid:= GridContainer.new()
	grid.columns = max(1, columns)
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	grid.add_theme_constant_override("h_separation", 12)
	grid.add_theme_constant_override("v_separation", 12)
	grid.set_meta("relationship_group_featured", highlight_cards)
	grid.set_meta("relationship_group_section", section_key)
	vbox.add_child(grid)

	for raw_card in cards:
		var card_contract: Dictionary = raw_card if typeof(raw_card) == TYPE_DICTIONARY else {}
		if card_contract.is_empty():
			continue
		_institution_hub_add_entity_relationship_card(card_contract, grid, section_key, highlight_cards)

func _institution_hub_add_entity_relationship_card(card_contract: Dictionary, target_parent: Control, section_key: String = "pets", featured: bool = true) -> void:
	if target_parent == null:
		return

	var target_entity: Dictionary = MainSceneHelpers._safe_dictionary(card_contract.get("target_entity", {}))
	var entity_id: String = str(card_contract.get("target_entity_id", target_entity.get("entity_id", ""))).strip_edges()
	if entity_id == "":
		return

	var bond_value: int = clampi(int(card_contract.get("bond", 50)), 0, 100)
	var health_value: int = clampi(int(card_contract.get("health", 100)), 0, 100)
	var health_max: int = max(1, int(card_contract.get("health_max", 100)))
	var card_state: String = str(card_contract.get("state", "warm")).strip_edges().to_lower()
	var species_name: String = str(target_entity.get("species_name", target_entity.get("species_id", "Animal")))
	var sub_species_name: String = str(target_entity.get("sub_species_name", "")).strip_edges()
	var lineage_name: String = sub_species_name if sub_species_name != "" else species_name
	var role_text: String = str(card_contract.get("role", "Companion")).strip_edges()
	var display_name: String = str(target_entity.get("display_name", "Companion"))
	var age_value: int = int(target_entity.get("age", target_entity.get("age_years", 0)))
	var danger_value: int = clampi(int(card_contract.get("danger_level", target_entity.get("danger_level", 0))), 0, 10)
	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.custom_minimum_size = Vector2(0, 258 if featured else 224)
	card.mouse_filter = Control.MOUSE_FILTER_PASS
	card.set_meta("relationship_card_entity_id", entity_id)
	card.set_meta("relationship_card_state", card_state)
	card.set_meta("relationship_card_featured", featured)
	card.set_meta("relationship_card_section_key", section_key)
	card.set_meta("relationship_card_bond", bond_value)
	card.set_meta("relationship_card_hovered", false)
	card.set_meta("relationship_card_is_entity", true)
	card.set_meta("relationship_card_contract", card_contract.duplicate(true))
	card.set_meta("relationship_card_contract_engine_owned", true)
	card.add_theme_stylebox_override("panel", _relationship_hub_cached_person_card_style(card_state, featured, section_key, bond_value, false, 0, 8))
	card.mouse_entered.connect(_relationship_hub_card_hover_changed.bind(card, true))
	card.mouse_exited.connect(_relationship_hub_card_hover_changed.bind(card, false))
	target_parent.add_child(card)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	card.add_child(margin)

	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 8)
	margin.add_child(vbox)

	var name_label:= Label.new()
	name_label.text = "%s • Age %d" % [display_name, age_value]
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.add_theme_font_size_override("font_size", 17 if featured else 16)
	name_label.add_theme_color_override("font_color", Color(0.98, 1.0, 0.96, 1.0))
	vbox.add_child(name_label)

	var species_label:= Label.new()
	species_label.text = "The %s" % lineage_name
