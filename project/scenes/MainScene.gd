func _global_runtime_kill_claim_allowed(claim_type: String, source: String, reason: String = "", context: Dictionary = {}) -> bool:
	var engine:= _ensure_global_runtime_kill_contract_engine()
	if engine == null:
		return true

	var clean_context: Dictionary = context.duplicate(true)
	clean_context ["current_panel"] = current_panel
	clean_context ["visible_shell_sovereign"] = _playable_life_shell_has_visible_sovereignty()

	var report: Dictionary = engine.request_claim(claim_type, source, reason, clean_context)

	if bool(report.get("allowed", false)):
		var clean_claim: String = str(claim_type).strip_edges()
		if clean_claim != "renderer_frame" and clean_claim != "audio_runtime" and clean_claim != "input_read":
			EraLog.truth("GLOBAL_RUNTIME_CLAIM_ALLOWED|claim=%s|source=%s|reason=%s|panel=%s|at_ms=%d" % [
				clean_claim,
				source,
				reason,
				current_panel,
				int(Time.get_ticks_msec())
			])
		return true

	_global_runtime_kill_apply_denied_claim(report)
	return false


func _global_runtime_kill_apply_denied_claim(report: Dictionary) -> void:
	var claim_type: String = str(report.get("claim_type", "")).strip_edges()
	var reason: String = str(report.get("reason", "global_runtime_kill_denied")).strip_edges()
	if reason == "":
		reason = "global_runtime_kill_denied"

	set_meta("global_runtime_kill_last_denied_claim", report.duplicate(true))
	set_meta("global_runtime_kill_last_denied_claim_at_ms", int(Time.get_ticks_msec()))

	match claim_type:
		"loading":
			_global_runtime_kill_clear_loading_claim(reason)
		"busy":
			_global_runtime_kill_clear_busy_claim(reason)
		"input_block":
			_global_runtime_kill_clear_input_block_claim(reason)
		"runtime_boot":
			_global_runtime_kill_clear_runtime_boot_claim(reason)
		"ui_rebuild":
			_global_runtime_kill_clear_ui_rebuild_claim(reason)
		"priority_escalation":
			_global_runtime_kill_clear_priority_escalation_claim(reason)
		"foreground_tail_work":
			_global_runtime_kill_clear_runtime_boot_claim(reason)
		"contract_bookkeeping":
			_global_runtime_kill_clear_runtime_boot_claim(reason)
		_:
			_global_runtime_kill_apply_visible_shell_law(reason)


func _global_runtime_kill_apply_visible_shell_law(reason: String = "visible_shell_law") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("startup_live_shell_loading", false)
	set_meta("startup_birth_loading_overlay_active", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("post_spawn_ui_finalize_pending", false)
	set_meta("spawn_ready_ui_first_frame_boundary_active", false)
	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("age_up_loading_cosmetic_finish_pending", false)
	set_meta("life_runtime_systems_quarantined_until_world_prewarm_seen", false)
	set_meta("life_runtime_systems_quarantine_reason", "")
	set_meta("life_runtime_systems_quarantine_until_ms", 0)
	set_meta("ready_shell_blocks_loading_runtime", true)
	set_meta("ready_shell_visible_loading_forbidden", true)
	set_meta("ready_shell_visible_loading_forbidden_reason", reason)
	set_meta("ready_shell_visible_loading_forbidden_at_ms", now_ms)
	set_meta("god_mode_ready_shell_background_tail_only", true)
	set_meta("tail_work_after_visible_surface_background_only", true)
	set_meta("tail_work_after_visible_surface_may_not_block_ui", true)
	set_meta("tail_work_after_visible_surface_may_not_start_loading", true)
	set_meta("world_tail_work_may_not_block_visible_shell", true)

	age_up_loading_runtime_active = false
	age_up_loading_finish_requested = false
	age_up_loading_result = {}
	age_up_loading_paint_hold_frames = 0
	age_up_loading_exit_started_ms = 0

	if age_up_loading_exit_tween != null:
		age_up_loading_exit_tween.kill()
		age_up_loading_exit_tween = null

	if age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false
		age_up_loading_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var last_reason: String = str(get_meta("global_runtime_kill_last_state_write_reason", ""))
	var next_write_ms: int = int(get_meta("global_runtime_kill_next_state_write_ms", 0))
	var should_write_state: bool = reason != last_reason or now_ms >= next_write_ms

	if not should_write_state:
		return

	set_meta("global_runtime_kill_last_state_write_reason", reason)
	set_meta("global_runtime_kill_next_state_write_ms", now_ms + 750)

	EraLog.truth("GLOBAL_RUNTIME_VISIBLE_SHELL_LAW|reason=%s|panel=%s|at_ms=%d" % [
		reason,
		current_panel,
		now_ms
	])

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["loading_runtime"] = {}
		gs.scenario_state ["startup_live_shell_loading"] = false
		gs.scenario_state ["startup_birth_loading_overlay_active"] = false
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["age_up_post_loading_finalize_pending"] = false
		gs.scenario_state ["age_up_transition_busy"] = false
		gs.scenario_state ["age_up_loading_runtime_active"] = false
		gs.scenario_state ["age_up_loading_runtime_begin_pending"] = false
		gs.scenario_state ["visible_age_up_runtime_from_button"] = false
		gs.scenario_state ["life_runtime_systems_quarantined"] = false
		gs.scenario_state ["life_runtime_systems_quarantine_reason"] = ""
		gs.scenario_state ["life_runtime_systems_soft_ui_resume_allowed"] = true
		gs.scenario_state ["life_runtime_background_tail_deferred"] = true
		gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
		gs.scenario_state ["world_tail_work_may_not_block_visible_shell"] = true
		gs.scenario_state ["ready_shell_blocks_loading_runtime"] = true
		gs.scenario_state ["ready_shell_visible_loading_forbidden"] = true
		gs.scenario_state ["ready_shell_visible_loading_forbidden_reason"] = reason
		gs.scenario_state ["ready_shell_visible_loading_forbidden_at_ms"] = now_ms
		gs.scenario_state ["tail_work_after_visible_surface_background_only"] = true
		gs.scenario_state ["tail_work_after_visible_surface_may_not_block_ui"] = true
		gs.scenario_state ["tail_work_after_visible_surface_may_not_start_loading"] = true
		gs.scenario_state ["body_contract_tail_work_pending"] = false
		gs.scenario_state ["body_contract_tail_work_background_pending"] = true

		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
		guard ["global_runtime_kill_contract_active"] = true
		guard ["ui_loading_forbidden_after_player_control"] = true
		guard ["ready_shell_blocks_loading_runtime"] = true
		guard ["ui_tail_work_yield_to_input"] = true
		guard ["defer_noncritical_systems"] = true
		guard ["playable_life_shell_input_sovereignty"] = true
		guard ["tail_work_after_visible_surface_background_only"] = true
		guard ["tail_work_after_visible_surface_may_not_block_ui"] = true
		guard ["last_action"] = "global_runtime_kill_apply_visible_shell_law"
		guard ["last_action_reason"] = reason
		guard ["last_action_ms"] = now_ms
		gs.scenario_state ["runtime_guard"] = guard

