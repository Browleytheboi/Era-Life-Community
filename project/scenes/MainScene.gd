func _express_relationship_hub_panel_action(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var expression: Dictionary = payload.duplicate(true)
	var actor_id: int = int(
		gs.player.id
	)
	var action_id: String = str(
		expression.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()

	if action_id == "":
		action_id = "refresh"

	expression ["actor_id"] = actor_id
	expression ["action_id"] = action_id
	expression ["section_id"] = str(
		expression.get(
			"section_id",
			relationships_hub_active_section_id
		)
	).strip_edges().to_lower()
	expression ["source"] = str(
		expression.get(
			"source",
			"mainscene.relationship_hub_panel"
		)
	)
	expression ["ui_is_renderer_only"] = true

	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "relationship_hub_panel_action",
		"surface_id": "relationship_hub_panel",
		"action_id": action_id,
		"payload": expression.duplicate(true),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"relationships_hub_contract_engine"
			),
			"method": "resolve_intent",
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": expression ["source"]
	}, {
		"actor_id": actor_id,
		"surface_id": "relationship_hub_panel",
		"action_id": action_id,
		"source": expression ["source"],
		"ui_is_expression_only": true
	})

	var result: Dictionary = _hub_panel_route_result(
		report
	)
	cached_last_result = result.duplicate(true)

	var hub_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"hub_contract",
			{}
		)
	)

	if not hub_contract.is_empty():
		var panel: RelationshipHubPanel = (
			_ensure_relationship_hub_panel()
		)

		if (
			panel != null
			and is_instance_valid(
				panel
			)
		):
			panel.render_contract(
				hub_contract
			)

			relationship_hub_panel_active_actor_id = actor_id
			relationships_hub_active_section_id = str(
				hub_contract.get(
					"active_section",
					expression.get(
						"section_id",
						relationships_hub_active_section_id
					)
				)
			).strip_edges().to_lower()

	var action_result: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"result",
			{}
		)
	)

	if (
		not action_result.is_empty()
		and (
			action_result.has("popup_text")
			or action_result.has("text")
		)
	):
		_maybe_show_action_result_popup(
			action_result
		)
	elif (
		not bool(
			result.get(
				"success",
				true
			)
		)
		and (
			result.has("popup_text")
			or result.has("text")
			or result.has("reason")
		)
	):
		_maybe_show_action_result_popup(
			result
		)
func _express_school_hub_panel_action(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var expression: Dictionary = payload.duplicate(true)
	var actor_id: int = int(
		gs.player.id
	)
	var action_id: String = str(
		expression.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()

	if action_id == "":
		action_id = "refresh"

	expression ["actor_id"] = actor_id
	expression ["action_id"] = action_id
	expression ["section_id"] = str(
		expression.get(
			"section_id",
			school_hub_active_section_id
		)
	).strip_edges().to_lower()
	expression ["source"] = str(
		expression.get(
			"source",
			"mainscene.school_hub_panel"
		)
	)
	expression ["ui_is_renderer_only"] = true

	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "school_hub_panel_action",
		"surface_id": "school_hub_panel",
		"action_id": action_id,
		"payload": expression.duplicate(true),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"school_hub_contract_engine"
			),
			"method": "resolve_intent",
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": expression ["source"]
	}, {
		"actor_id": actor_id,
		"surface_id": "school_hub_panel",
		"action_id": action_id,
		"source": expression ["source"],
		"ui_is_expression_only": true
	})

	var result: Dictionary = _hub_panel_route_result(
		report
	)
	cached_last_result = result.duplicate(true)

	var hub_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"hub_contract",
			{}
		)
	)

	if not hub_contract.is_empty():
		var panel: SchoolHubPanel = (
			_ensure_school_hub_panel()
		)

		if (
			panel != null
			and is_instance_valid(
				panel
			)
		):
			panel.render_contract(
				hub_contract
			)

			school_hub_active_actor_id = actor_id
			school_hub_active_section_id = str(
				hub_contract.get(
					"active_section",
					expression.get(
						"section_id",
						school_hub_active_section_id
					)
				)
			).strip_edges().to_lower()

	var action_result: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"result",
			{}
		)
	)

	if (
		not action_result.is_empty()
		and (
			action_result.has("popup_text")
			or action_result.has("text")
		)
	):
		_maybe_show_action_result_popup(
			action_result
		)
	elif (
		not bool(
			result.get(
				"success",
				true
			)
		)
		and (
			result.has("popup_text")
			or result.has("text")
			or result.has("reason")
		)
	):
		_maybe_show_action_result_popup(
			result
		)
func _relationship_hub_surface_has_rendered_cards() -> bool:
	if str(institution_hub_kind).strip_edges().to_lower() != "relationships":
		return false

	if institution_hub_overlay == null:
		return false
	if not is_instance_valid(institution_hub_overlay):
		return false
	if not institution_hub_overlay.visible:
		return false

	if institution_hub_list == null:
		return false
	if not is_instance_valid(institution_hub_list):
		return false
	if institution_hub_list.get_child_count() <= 0:
		return false

	if not institution_hub_experience_rows.is_empty():
		for raw_row in institution_hub_experience_rows:
			if typeof(raw_row) != TYPE_DICTIONARY:
				continue

			var row: Dictionary = raw_row
			if not bool(row.get("relationship_card", false)):
				continue

			var raw_card_surface: Variant = row.get("card_surface", null)
			if raw_card_surface is Control:
				var card_surface: Control = raw_card_surface as Control
				if card_surface != null and is_instance_valid(card_surface) and card_surface.is_inside_tree():
					return true

		return false

	return MainSceneHelpers._relationship_hub_control_tree_has_rendered_card(institution_hub_list)


