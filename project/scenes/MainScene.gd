func _continue_other_country_browser_contract_observation(
	cache_key: String,
	attempt: int = 0
) -> void:
	var clean_cache_key: String = str(cache_key).strip_edges()

	if (
		clean_cache_key == ""
		or clean_cache_key != _other_country_browser_cache_key()
	):
		set_meta(
			"other_countries_browser_contract_observation_armed",
			false
		)
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		return

	var cached_key: String = str(
		get_meta(
			"other_countries_browser_entries_cache_key",
			""
		)
	).strip_edges()
	var cached_entries_raw: Variant = get_meta(
		"other_countries_browser_entries_cache",
		[]
	)

	if (
		cached_key == clean_cache_key
		and typeof(cached_entries_raw) == TYPE_ARRAY
		and not (cached_entries_raw as Array).is_empty()
	):
		set_meta(
			"other_countries_browser_contract_observation_armed",
			false
		)
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		return

	var contract: Dictionary = (
		_world_browser_contract_from_projection_mailbox(
			clean_cache_key
		)
	)

	set_meta(
		"other_countries_browser_contract_observation_attempt",
		attempt
	)
	set_meta(
		"other_countries_browser_contract_observation_engine_calls",
		0
	)
	set_meta(
		"other_countries_browser_contract_observation_mailbox_only",
		true
	)

	if not contract.is_empty():
		_install_world_browser_contract_packet(
			clean_cache_key,
			contract
		)
		return

	if attempt >= 900:
		set_meta(
			"other_countries_browser_contract_observation_armed",
			false
		)
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		set_meta(
			"other_countries_browser_contract_observation_timeout",
			true
		)
		set_meta(
			"other_countries_browser_contract_observation_timeout_attempts",
			attempt
		)
		return

	var observation_tree:= get_tree()

	if observation_tree == null:
		call_deferred(
			"_continue_other_country_browser_contract_observation",
			clean_cache_key,
			attempt + 1
		)
		return

	observation_tree.process_frame.connect(
		Callable(
			self,
			"_continue_other_country_browser_contract_observation"
		).bind(
			clean_cache_key,
			attempt + 1
		),
		CONNECT_ONE_SHOT
	)

func _world_browser_contract_from_projection_mailbox(
	cache_key: String
) -> Dictionary:
	if gs == null:
		return {}

	var clean_cache_key: String = str(cache_key).strip_edges()

	if clean_cache_key == "":
		return {}

	var direct_raw: Variant = gs.get_meta(
		"world_browser_projection_contract_mailbox",
		{}
	)

	if typeof(direct_raw) == TYPE_DICTIONARY:
		var direct_contract: Dictionary = direct_raw as Dictionary

		if (
			str(
				direct_contract.get(
					"signature",
					""
				)
			).strip_edges() == clean_cache_key
			and bool(
				direct_contract.get(
					"projection_complete",
					false
				)
			)
		):
			return direct_contract.duplicate(false)

	var contracts_raw: Variant = gs.get_meta(
		"world_browser_projection_contracts_by_signature",
		{}
	)

	if typeof(contracts_raw) != TYPE_DICTIONARY:
		return {}

	var contracts: Dictionary = contracts_raw as Dictionary
	var contract_raw: Variant = contracts.get(
		clean_cache_key,
		{}
	)

	if typeof(contract_raw) != TYPE_DICTIONARY:
		return {}

	var contract: Dictionary = contract_raw as Dictionary

	if not bool(
		contract.get(
			"projection_complete",
			false
		)
	):
		return {}

	return contract.duplicate(false)
func _prewarm_other_country_browser_cache() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	_ensure_world_browser_contract_ready_bridge()

	var resolved_key: String = (
		_other_country_browser_cache_key()
	)
	var cached_key: String = str(
		get_meta(
			"other_countries_browser_entries_cache_key",
			""
		)
	).strip_edges()
	var cached_entries_raw: Variant = get_meta(
		"other_countries_browser_entries_cache",
		[]
	)

	var live_observation_signature: String = str(
		get_meta(
			"other_countries_live_observation_signature",
			""
		)
	).strip_edges()

	if live_observation_signature != resolved_key:
		set_meta(
			"other_countries_live_entry_keys",
			{}
		)
		set_meta(
			"other_countries_live_section_grids",
			{}
		)
		set_meta(
			"other_countries_live_section_blocks",
			{}
		)
		set_meta(
			"other_countries_browser_card_registry",
			{}
		)
		set_meta(
			"other_countries_live_observation_signature",
			resolved_key
		)
	if (
		cached_key == resolved_key
		and typeof(
			cached_entries_raw
		) == TYPE_ARRAY
		and not (
			cached_entries_raw as Array
		).is_empty()
	):
		return

	var mailbox_contract: Dictionary = (
		_world_browser_contract_from_projection_mailbox(
			resolved_key
		)
	)

	if not mailbox_contract.is_empty():
		_install_world_browser_contract_packet(
			resolved_key,
			mailbox_contract
		)
		return

	var pending_key: String = str(
		get_meta(
			"other_countries_browser_entries_pending_cache_key",
			""
		)
	).strip_edges()

	if (
		bool(
			get_meta(
				"other_countries_browser_cache_building",
				false
			)
		)
		and pending_key == resolved_key
	):
		return

	set_meta(
		"other_countries_browser_cache_building",
		true
	)
	set_meta(
		"other_countries_browser_entries_pending_cache_key",
		resolved_key
	)
	set_meta(
		"other_countries_browser_contract_source",
		"global_intent_contract_engine"
	)
	set_meta(
		"other_countries_browser_main_scene_engine_resolution",
		false
	)
	set_meta(
		"other_countries_browser_ui_direct_engine_access",
		false
	)
	set_meta(
		"other_countries_browser_ready_gate_member",
		false
	)
	set_meta(
		"other_countries_browser_build_on_click",
		false
	)
	set_meta(
		"other_countries_browser_projection_request_count",
		int(
			get_meta(
				"other_countries_browser_projection_request_count",
				0
			)
		) + 1
	)

	var report: Dictionary = (
		_request_world_browser_contract_projection(
			resolved_key
		)
	)
	var contract: Dictionary = (
		_world_browser_contract_from_intent_report(
			report
		)
	)

	set_meta(
		"other_countries_browser_contract_request_report",
		report.duplicate(false)
	)
	set_meta(
		"other_countries_browser_contract_request_success",
		bool(
			report.get(
				"success",
				false
			)
		)
	)
	set_meta(
		"other_countries_browser_contract_request_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"other_countries_browser_repeated_global_intent_polling",
		false
	)

	if not contract.is_empty():
		_install_world_browser_contract_packet(
			resolved_key,
			contract
		)
		return

	if not bool(
		report.get(
			"success",
			false
		)
	):
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		set_meta(
			"other_countries_browser_contract_observation_armed",
			false
		)
		return

	if bool(
		get_meta(
			"other_countries_browser_contract_observation_armed",
			false
		)
	):
		return

	set_meta(
		"other_countries_browser_contract_observation_armed",
		true
	)

	call_deferred(
		"_continue_other_country_browser_contract_observation",
		resolved_key,
		0
	)
func _other_country_live_section_grid(
		list: VBoxContainer,
		entry: Dictionary
) -> GridContainer:
		if list == null:
			return null

		var realm_raw: Variant = entry.get(
			"realm",
			{}
		)
		var realm: Dictionary = (
			realm_raw as Dictionary
			if typeof(realm_raw) == TYPE_DICTIONARY
			else {}
		)
		var section: String = (
			_other_country_entry_browser_section(
				entry,
				realm
			)
		)
		var singleton_interrealm_authority: bool = (
			section == "interrealm_authority"
		)
		var grids_raw: Variant = get_meta(
			"other_countries_live_section_grids",
			{}
		)
		var grids: Dictionary = (
			grids_raw as Dictionary
			if typeof(grids_raw) == TYPE_DICTIONARY
			else {}
		)

		if grids.has(
			section
		):
			var existing:= grids.get(
				section,
				null
			) as GridContainer

			if (
				existing != null
				and is_instance_valid(
					existing
				)
			):
				return existing

		for raw_child in list.get_children():
			var existing_block:= raw_child as VBoxContainer

			if (
				existing_block == null
				or not is_instance_valid(existing_block)
				or str(
					existing_block.get_meta(
						"other_country_live_section",
						""
					)
				) != section
			):
				continue

			for raw_grandchild in existing_block.get_children():
				var existing_grid:= raw_grandchild as GridContainer

				if existing_grid == null:
					continue

				if str(
					existing_grid.get_meta(
						"other_country_live_section",
						""
					)
				) != section:
					continue

				grids [section] = existing_grid
				set_meta(
					"other_countries_live_section_grids",
					grids
				)

				var adopted_blocks_raw: Variant = get_meta(
					"other_countries_live_section_blocks",
					{}
				)
				var adopted_blocks: Dictionary = (
					adopted_blocks_raw as Dictionary
					if typeof(adopted_blocks_raw) == TYPE_DICTIONARY
					else {}
				)
				adopted_blocks [section] = existing_block
				set_meta(
					"other_countries_live_section_blocks",
					adopted_blocks
				)

				set_meta(
					"other_countries_existing_section_block_readopted",
					section
				)

				return existing_grid

		var section_priority: int = (
			MainSceneHelpers._other_country_browser_section_priority(
				section
			)
		)
		var section_block:= VBoxContainer.new()
		section_block.name = (
			"OtherCountryLiveSection_%s"
			% section
		)
		section_block.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		section_block.add_theme_constant_override(
			"separation",
			8
		)
		section_block.set_meta(
			"other_country_live_section",
			section
		)
		section_block.set_meta(
			"other_country_live_section_priority",
			section_priority
		)
		section_block.set_meta(
			"ui_is_renderer_only",
			true
		)

		_append_other_country_section_divider(
			section_block,
			MainSceneHelpers._other_country_browser_section_title(
				section
			),
			section != "standard_realms"
		)

		var grid:= GridContainer.new()
		grid.name = (
			"OtherCountryLiveGrid_%s"
			% section
		)
		grid.columns = (
			1
			if singleton_interrealm_authority
			else (
				3
				if get_viewport_rect().size.x >= 1180.0
				else (
					2
					if get_viewport_rect().size.x >= 720.0
					else 1
				)
			)
		)
		grid.size_flags_horizontal = (
			Control.SIZE_SHRINK_CENTER
			if singleton_interrealm_authority
			else Control.SIZE_EXPAND_FILL
		)

		if singleton_interrealm_authority:
			grid.custom_minimum_size = Vector2(
				minf(
					420.0,
					maxf(
						238.0,
						get_viewport_rect().size.x - 80.0
					)
				),
				0.0
			)
			grid.set_meta(
				"singleton_interrealm_authority_centered",
				true
			)

		grid.add_theme_constant_override(
			"h_separation",
			10
		)
		grid.add_theme_constant_override(
			"v_separation",
			10
		)
		grid.set_meta(
			"other_country_live_section",
			section
		)
		grid.set_meta(
			"ui_is_renderer_only",
			true
		)

		section_block.add_child(
			grid
		)
		list.add_child(
			section_block
		)

		var insertion_index: int = (
			list.get_child_count() - 1
		)

		for child_index in range(
			list.get_child_count() - 1
		):
			var existing_child:= list.get_child(
				child_index
			)

			if (
				existing_child == null
				or not existing_child.has_meta(
					"other_country_live_section_priority"
				)
			):
				continue

			var existing_priority: int = int(
				existing_child.get_meta(
					"other_country_live_section_priority",
					999
				)
			)

			if existing_priority > section_priority:
				insertion_index = child_index
				break

		list.move_child(
			section_block,
			insertion_index
		)

		grids [
			section
		] = grid

		var blocks_raw: Variant = get_meta(
			"other_countries_live_section_blocks",
			{}
		)
		var blocks: Dictionary = (
			blocks_raw as Dictionary
			if typeof(blocks_raw) == TYPE_DICTIONARY
			else {}
		)

		blocks [
			section
		] = section_block

		set_meta(
			"other_countries_live_section_grids",
			grids
		)
		set_meta(
			"other_countries_live_section_blocks",
			blocks
		)

		return grid
func _prewarm_other_country_browser_cache_deferred(
	cache_key: String,
	_attempt: int = 0
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		return

	if cache_key != _other_country_browser_cache_key():
		set_meta(
			"other_countries_browser_cache_building",
			false
		)
		return


	set_meta(
		"other_countries_browser_deferred_resolver_called_engines",
		false
	)
	set_meta(
		"other_countries_browser_deferred_resolver_built_rows",
		false
	)
	set_meta(
		"other_countries_browser_deferred_resolver_ready_gate_member",
		false
	)

	_prewarm_other_country_browser_cache()
func _apply_live_other_country_card_palette(
	card: Control,
	entry: Dictionary
) -> void:
	if (
		card == null
		or not is_instance_valid(
			card
		)
	):
		return

	var realm_raw: Variant = entry.get(
		"realm",
		{}
	)
	var realm: Dictionary = (
		realm_raw as Dictionary
		if typeof(realm_raw) == TYPE_DICTIONARY
		else {}
	)
	var military_label: String = str(
		entry.get(
			"military_label",
			realm.get(
				"military_label",
				"Military"
			)
		)
	).strip_edges()

	if military_label == "":
		military_label = "Military"
	var native_element: String = (
		_other_country_resolve_native_element(
			entry,
			realm
		)
	)
	var palette: Dictionary = (
		MainSceneHelpers._build_other_country_elemental_palette(
			native_element
		)
	)

	if palette.is_empty():
		palette = (
			_build_other_country_ordinary_era_palette()
		)

	if card is PanelContainer:
		var panel_style:= StyleBoxFlat.new()
		panel_style.bg_color = palette.get(
			"card_bg",
			Color(
				0.035,
				0.042,
				0.068,
				0.98
			)
		)
		panel_style.border_color = palette.get(
			"card_border",
			Color(
				0.58,
				0.7,
				0.92,
				0.68
			)
		)
		panel_style.shadow_color = palette.get(
			"card_shadow",
			Color(
				0.0,
				0.0,
				0.0,
				0.24
			)
		)
		panel_style.shadow_size = int(
			palette.get(
				"card_shadow_size",
				10
			)
		)
		panel_style.set_border_width_all(
			1
		)
		panel_style.set_corner_radius_all(
			12
		)
		panel_style.content_margin_left = 12.0
		panel_style.content_margin_top = 10.0
		panel_style.content_margin_right = 12.0
		panel_style.content_margin_bottom = 10.0

		(card as PanelContainer).add_theme_stylebox_override(
			"panel",
			panel_style
		)

	var queue: Array = [
		card
	]

	while not queue.is_empty():
		var node_raw: Variant = (
			queue.pop_front()
		)

		if not (node_raw is Node):
			continue

		var node:= node_raw as Node

		if node is Button:
			MainSceneHelpers._apply_other_country_browser_button_palette(
				node as Button,
				palette
			)

		if node is Label:
			var label:= node as Label

			label.add_theme_color_override(
				"font_color",
				palette.get(
					"summary_font",
					Color(
						0.9,
						0.94,
						1.0,
						0.94
					)
				)
			)

			if (
				military_label != "Military"
				and label.text.contains(
					"Military:"
				)
			):
				label.text = label.text.replace(
					"Military:",
					"%s:" % military_label
				)

		for child in node.get_children():
			queue.append(
				child
			)
func _append_other_country_browser_live_entry(
		entry: Dictionary
) -> void:
		if entry.is_empty():
			return

		var popup:= get_node_or_null(
			"OtherCountriesPopup"
		)

		if popup == null:
			_ensure_other_countries_popup()
			popup = get_node_or_null(
				"OtherCountriesPopup"
			)

		if popup == null:
			return

		var list:= popup.find_child(
			"List",
			true,
			false
		) as VBoxContainer

		if list == null:
			return

		list.visible = true

		var entry_kind: String = str(
			entry.get(
				"entry_kind",
				"realm"
			)
		).strip_edges().to_lower()
		var entry_id: String = str(
			entry.get(
				"entry_id",
				""
			)
		).strip_edges()
		var entry_name: String = str(
			entry.get(
				"name",
				entry_id
			)
		).strip_edges()
		var realm: Dictionary = MainSceneHelpers._safe_dictionary(
			entry.get(
				"realm",
				{}
			)
		)
		var realm_name: String = str(
			realm.get(
				"name",
				entry_name
			)
		).strip_edges()
		var realm_id: int = int(
			entry.get(
				"realm_id",
				realm.get(
					"realm_id",
					realm.get(
						"id",
						-1
					)
				)
			)
		)
		var aliases: Array = (
			MainSceneLogic._other_country_browser_entry_identity_aliases(
				entry_kind,
				entry_id,
				entry_name,
				realm_name,
				realm_id
			)
		)
		var incoming_entry_key: String = (
			entry_id
			if entry_id != ""
			else MainSceneHelpers._other_country_identity_key(
				entry_name
			)
		)
		var keys_raw: Variant = get_meta(
			"other_countries_live_entry_keys",
			{}
		)
		var keys: Dictionary = (
			(keys_raw as Dictionary).duplicate(false)
			if typeof(keys_raw) == TYPE_DICTIONARY
			else {}
		)
		var provisional_key: String = (
			_other_country_browser_provisional_upgrade_key(
				entry,
				aliases
			)
		)
		var restore_focus: bool = false

		if provisional_key != "":
			var removal_report: Dictionary = (
				_remove_other_country_browser_provisional_entry(
					provisional_key
				)
			)
			var old_aliases: Array = MainSceneHelpers._safe_array(
				removal_report.get(
					"aliases",
					[]
				)
			)

			for raw_alias in old_aliases:
				keys.erase(
					str(raw_alias)
				)

			restore_focus = bool(
				removal_report.get(
					"was_selected",
					false
				)
			)

		for raw_alias in aliases:
			var alias_key: String = str(
				raw_alias
			)

			if keys.has(alias_key):
				set_meta(
					"other_countries_live_duplicate_alias_rejected",
					alias_key
				)
				return

		var grid: GridContainer = (
			_other_country_live_section_grid(
				list,
				entry
			)
		)

		if grid == null:
			return

		for raw_alias in aliases:
			keys [
				str(raw_alias)
			] = true

		set_meta(
			"other_countries_live_entry_keys",
			keys
		)

		var before_count: int = grid.get_child_count()

		_append_other_country_browser_row_resident_lens(
			grid,
			entry
		)

		if grid.get_child_count() > before_count:
			var card:= grid.get_child(
				grid.get_child_count() - 1
			) as Control

			if card != null:
				_apply_live_other_country_card_palette(
					card,
					entry
				)

		if (
			restore_focus
			and incoming_entry_key != ""
		):
			call_deferred(
				"_set_other_country_browser_card_focus",
				incoming_entry_key
			)

		var status:= popup.find_child(
			"Status",
			true,
			false
		) as Label

		if (
			status != null
			and popup.visible
		):
			var canonical_entry_count: int = 0

			for raw_key in keys.keys():
				if str(raw_key).begins_with(
					"realm_id:"
				):
					canonical_entry_count += 1

			status.text = (
				"%d countries and realms published live."
				% max(
					1,
					canonical_entry_count
				)
			)

		set_meta(
			"other_countries_live_entry_last_aliases",
			aliases.duplicate(false)
		)
		set_meta(
			"other_countries_live_entry_full_deck_rebuild",
			false
		)
		set_meta(
			"other_countries_live_entry_prepainted_while_hidden",
			not popup.visible
		)
		set_meta(
			"other_countries_live_canonical_upsert",
			provisional_key != ""
		)
func _other_country_browser_provisional_upgrade_key(
		entry: Dictionary,
		incoming_aliases: Array
) -> String:
		var realm: Dictionary = MainSceneHelpers._safe_dictionary(
			entry.get(
				"realm",
				{}
			)
		)
		var incoming_realm_id: int = int(
			entry.get(
				"realm_id",
				realm.get(
					"realm_id",
					realm.get(
						"id",
						-1
					)
				)
			)
		)

		if incoming_realm_id <= 0:
			return ""

		var registry_raw: Variant = get_meta(
			"other_countries_browser_card_registry",
			{}
		)
		var registry: Dictionary = (
			registry_raw as Dictionary
			if typeof(registry_raw) == TYPE_DICTIONARY
			else {}
		)

		for raw_key in registry.keys():
			var packet: Dictionary = MainSceneHelpers._safe_dictionary(
				registry.get(
					raw_key,
					{}
				)
			)
			var old_entry: Dictionary = MainSceneHelpers._safe_dictionary(
				packet.get(
					"entry",
					{}
				)
			)
			var old_realm: Dictionary = MainSceneHelpers._safe_dictionary(
				old_entry.get(
					"realm",
					{}
				)
			)
			var old_realm_id: int = int(
				old_entry.get(
					"realm_id",
					old_realm.get(
						"realm_id",
						old_realm.get(
							"id",
							-1
						)
					)
				)
			)

			if old_realm_id > 0:
				continue

			var old_kind: String = str(
				old_entry.get(
					"entry_kind",
					"realm"
				)
			).strip_edges().to_lower()
			var old_entry_id: String = str(
				old_entry.get(
					"entry_id",
					""
				)
			).strip_edges()
			var old_name: String = str(
				old_entry.get(
					"name",
					old_entry_id
				)
			).strip_edges()
			var old_realm_name: String = str(
				old_realm.get(
					"name",
					old_name
				)
			).strip_edges()
			var old_aliases: Array = (
				MainSceneLogic._other_country_browser_entry_identity_aliases(
					old_kind,
					old_entry_id,
					old_name,
					old_realm_name,
					old_realm_id
				)
			)

			for raw_alias in incoming_aliases:
				if old_aliases.has(
					str(raw_alias)
				):
					return str(
						raw_key
					)

		return ""
func _remove_other_country_browser_provisional_entry(
		entry_key: String
) -> Dictionary:
		var clean_key: String = str(
			entry_key
		).strip_edges()

		if clean_key == "":
			return {}

		var registry_raw: Variant = get_meta(
			"other_countries_browser_card_registry",
			{}
		)
		var registry: Dictionary = (
			(registry_raw as Dictionary).duplicate(false)
			if typeof(registry_raw) == TYPE_DICTIONARY
			else {}
		)
		var packet: Dictionary = MainSceneHelpers._safe_dictionary(
			registry.get(
				clean_key,
				{}
			)
		)

		if packet.is_empty():
			return {}

		var old_entry: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"entry",
				{}
			)
		)
		var old_realm: Dictionary = MainSceneHelpers._safe_dictionary(
			old_entry.get(
				"realm",
				{}
			)
		)
		var old_kind: String = str(
			old_entry.get(
				"entry_kind",
				"realm"
			)
		).strip_edges().to_lower()
		var old_entry_id: String = str(
			old_entry.get(
				"entry_id",
				""
			)
		).strip_edges()
		var old_name: String = str(
			old_entry.get(
				"name",
				old_entry_id
			)
		).strip_edges()
		var old_realm_name: String = str(
			old_realm.get(
				"name",
				old_name
			)
		).strip_edges()
		var old_realm_id: int = int(
			old_entry.get(
				"realm_id",
				old_realm.get(
					"realm_id",
					old_realm.get(
						"id",
						-1
					)
				)
			)
		)
		var old_aliases: Array = (
			MainSceneLogic._other_country_browser_entry_identity_aliases(
				old_kind,
				old_entry_id,
				old_name,
				old_realm_name,
				old_realm_id
			)
		)
		var selected_key: String = str(
			get_meta(
				"other_countries_browser_selected_entry_key",
				""
			)
		).strip_edges()
		var was_selected: bool = (
			selected_key == clean_key
		)
		var shell:= packet.get(
			"shell",
			null
		) as Control

		if (
			shell != null
			and is_instance_valid(shell)
		):
			var parent:= shell.get_parent()

			if parent != null:
				parent.remove_child(
					shell
				)

			shell.queue_free()

		registry.erase(
			clean_key
		)

		set_meta(
			"other_countries_browser_card_registry",
			registry
		)

		if was_selected:
			set_meta(
				"other_countries_browser_selected_entry_key",
				""
			)

		return {
			"success": true,
			"entry_key": clean_key,
			"aliases": old_aliases,
			"was_selected": was_selected,
		}
func _on_world_browser_contract_ready(
	signature: String,
	contract: Dictionary
) -> void:
	var clean_signature: String = str(
		signature
	).strip_edges()
	var expected_signature: String = (
		_other_country_browser_cache_key()
	)

	if (
		clean_signature == ""
		or clean_signature != expected_signature
		or contract.is_empty()
	):
		return

	var projection_complete: bool = bool(
		contract.get(
			"projection_complete",
			false
		)
	)

	if not projection_complete:
		var published_entry_raw: Variant = (
			contract.get(
				"published_entry",
				{}
			)
		)

		if typeof(published_entry_raw) == TYPE_DICTIONARY:
			var published_entry: Dictionary = (
				published_entry_raw as Dictionary
			)

			call_deferred(
				"_append_other_country_browser_live_entry",
				published_entry.duplicate(false)
			)

		set_meta(
			"other_countries_browser_cache_building",
			true
		)
		set_meta(
			"other_countries_browser_contract_hot",
			false
		)
		set_meta(
			"other_countries_browser_contract_entry_count",
			int(
				contract.get(
					"entry_count",
					0
				)
			)
		)
		return

	var entries_raw: Variant = contract.get(
		"entries",
		[]
	)
	var entries: Array = (
		(entries_raw as Array).duplicate(false)
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)

	set_meta(
		"other_countries_browser_entries_cache_key",
		clean_signature
	)
	set_meta(
		"other_countries_browser_entries_cache",
		entries
	)
	set_meta(
		"other_countries_browser_contract",
		contract.duplicate(false)
	)
	set_meta(
		"other_countries_browser_cache_building",
		false
	)
	set_meta(
		"other_countries_browser_contract_hot",
		bool(
			contract.get(
				"projection_complete",
				false
			)
		)
	)
	set_meta(
		"other_countries_browser_contract_entry_count",
		entries.size()
	)
	set_meta(
		"other_countries_browser_contract_engine_owned",
		true
	)
	set_meta(
		"other_countries_browser_contract_ui_called_engines",
		false
	)
	set_meta(
		"other_countries_browser_contract_build_on_click",
		false
	)
	set_meta(
		"other_countries_browser_contract_ready_gate_member",
		false
	)
	set_meta(
		"other_countries_browser_contract_received_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	var popup:= get_node_or_null(
		"OtherCountriesPopup"
	)

	if (
		popup != null
		and popup.visible
	):
		var list:= popup.find_child(
			"List",
			true,
			false
		) as VBoxContainer
		var status:= popup.find_child(
			"Status",
			true,
			false
		) as Label

		if list != null:
			var live_keys_raw: Variant = get_meta(
				"other_countries_live_entry_keys",
				{}
			)
			var live_keys: Dictionary = (
				live_keys_raw as Dictionary
				if typeof(live_keys_raw) == TYPE_DICTIONARY
				else {}
			)

			if not live_keys.is_empty():
				if status != null:
					status.text = (
						"%d countries and realms are resident."
						% entries.size()
					)
			else:
				_render_other_country_popup_entries(
					list,
					status,
					entries
				)

	EraLog.truth(
		(
			"ERALIFE_WORLD_BROWSER_CONTRACT_TRUTH"
			+ "|signature=%s"
			+ "|hot=%s"
			+ "|entry_count=%d"
			+ "|engine_owned=true"
			+ "|ui_called_engines=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=%d"
		)
		% [
			clean_signature,
			str(
				bool(
					contract.get(
						"projection_complete",
						false
					)
				)
			),
			entries.size(),
			int(
				Time.get_ticks_msec()
			)
		]
	)
func _resolve_other_country_browser_entries_cached() -> Array:
	var cache_key: String = _other_country_browser_cache_key()
	var cached_key: String = str(get_meta("other_countries_browser_entries_cache_key", "")).strip_edges()
	var cached_entries_raw: Variant = get_meta("other_countries_browser_entries_cache", [])

	if cached_key == cache_key and typeof(cached_entries_raw) == TYPE_ARRAY:
		return (cached_entries_raw as Array).duplicate(true)

	if not bool(get_meta("other_countries_browser_cache_building", false)):
		set_meta("other_countries_browser_cache_building", true)
		set_meta("other_countries_browser_entries_pending_cache_key", cache_key)
		call_deferred("_prewarm_other_country_browser_cache_deferred", cache_key, 0)

	return []
func _render_other_country_popup_entries(
	list: VBoxContainer,
	status: Label,
	entries: Array
) -> void:
	if (
		list == null
		or not is_instance_valid(
			list
		)
	):
		return

	if entries.is_empty():
		_clear_container_children(
			list
		)
		list.visible = true

		if status != null:
			status.text = (
				"No visible countries or realms were resolved for this era."
			)

		set_meta(
			"other_countries_popup_chunked_render_complete",
			true
		)
		set_meta(
			"other_countries_popup_chunked_render_total",
			0
		)
		return

	list.visible = true

	var current_signature: String = (
		_other_country_browser_cache_key()
	)
	var live_signature: String = str(
		get_meta(
			"other_countries_live_observation_signature",
			""
		)
	).strip_edges()

	if live_signature != current_signature:
		_clear_container_children(
			list
		)
		set_meta(
			"other_countries_live_entry_keys",
			{}
		)
		set_meta(
			"other_countries_live_section_grids",
			{}
		)
		set_meta(
			"other_countries_live_section_blocks",
			{}
		)
		set_meta(
			"other_countries_browser_card_registry",
			{}
		)
		set_meta(
			"other_countries_live_observation_signature",
			current_signature
		)

	var generation: int = int(
		get_meta(
			"other_countries_cached_live_stream_generation",
			0
		)
	) + 1

	set_meta(
		"other_countries_cached_live_stream_generation",
		generation
	)
	set_meta(
		"other_countries_cached_live_stream_entries",
		entries.duplicate(false)
	)
	set_meta(
		"other_countries_cached_live_stream_cursor",
		0
	)
	set_meta(
		"other_countries_popup_chunked_render_active",
		true
	)
	set_meta(
		"other_countries_popup_chunked_render_complete",
		false
	)
	set_meta(
		"other_countries_popup_chunked_render_total",
		entries.size()
	)
	set_meta(
		"other_countries_popup_render_path",
		"unified_live_grid"
	)
	set_meta(
		"other_countries_popup_legacy_descriptor_layout",
		false
	)

	if status != null:
		status.text = (
			"Countries and realms are resident. "
			+ "Their cards are streaming into the same live grid."
		)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_continue_other_country_cached_live_stream",
			generation
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_other_country_cached_live_stream"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)
func _continue_other_country_cached_live_stream(
	generation: int
) -> void:
	if generation != int(
		get_meta(
			"other_countries_cached_live_stream_generation",
			0
		)
	):
		return

	var entries_raw: Variant = get_meta(
		"other_countries_cached_live_stream_entries",
		[]
	)
	var entries: Array = (
		entries_raw as Array
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)
	var cursor: int = int(
		get_meta(
			"other_countries_cached_live_stream_cursor",
			0
		)
	)

	if cursor >= entries.size():
		set_meta(
			"other_countries_popup_chunked_render_active",
			false
		)
		set_meta(
			"other_countries_popup_chunked_render_complete",
			true
		)
		set_meta(
			"other_countries_popup_prepainted",
			true
		)
		set_meta(
			"other_countries_popup_prepainted_cache_key",
			_other_country_browser_cache_key()
		)
		set_meta(
			"other_countries_popup_prepainted_entry_count",
			entries.size()
		)

		var popup:= get_node_or_null(
			"OtherCountriesPopup"
		)

		if popup != null:
			var status:= popup.find_child(
				"Status",
				true,
				false
			) as Label

			if status != null:
				status.text = (
					"%d countries and realms are resident."
					% entries.size()
				)

		return

	var entry_raw: Variant = entries [
		cursor
	]

	set_meta(
		"other_countries_cached_live_stream_cursor",
		cursor + 1
	)

	if typeof(entry_raw) == TYPE_DICTIONARY:
		_append_other_country_browser_live_entry(
			(entry_raw as Dictionary).duplicate(false)
		)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_continue_other_country_cached_live_stream",
			generation
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_other_country_cached_live_stream"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)
func _continue_other_country_popup_chunked_render(
	render_sequence: int
) -> void:
	if render_sequence != int(
		get_meta(
			"other_countries_popup_render_sequence",
			0
		)
	):
		return

	var popup:= get_node_or_null(
		"OtherCountriesPopup"
	)
	if popup == null:
		set_meta(
			"other_countries_popup_chunked_render_active",
			false
		)
		return

	var list:= popup.find_child(
		"List",
		true,
		false
	) as VBoxContainer
	var status:= popup.find_child(
		"Status",
		true,
		false
	) as Label

	if (
		list == null
		or not is_instance_valid(
			list
		)
	):
		set_meta(
			"other_countries_popup_chunked_render_active",
			false
		)
		return

	var queue_raw: Variant = get_meta(
		"other_countries_popup_render_queue",
		[]
	)
	var queue: Array = (
		queue_raw as Array
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)
	var cursor: int = maxi(
		0,
		int(
			get_meta(
				"other_countries_popup_render_cursor",
				0
			)
		)
	)

	if cursor >= queue.size():
		var completed_at_ms: int = int(
			Time.get_ticks_msec()
		)
		var cache_key: String = (
			_other_country_browser_cache_key()
		)

		set_meta(
			"other_countries_popup_chunked_render_active",
			false
		)
		set_meta(
			"other_countries_popup_chunked_render_complete",
			true
		)
		set_meta(
			"other_countries_popup_chunked_render_completed_at_ms",
			completed_at_ms
		)
		set_meta(
			"other_countries_popup_prepainted",
			true
		)
		set_meta(
			"other_countries_popup_prepainted_cache_key",
			cache_key
		)
		set_meta(
			"other_countries_popup_prepainted_entry_count",
			int(
				get_meta(
					"other_countries_browser_contract_entry_count",
					0
				)
			)
		)
		set_meta(
			"other_countries_popup_hidden_prepaint_allowed",
			true
		)
		remove_meta(
			"other_countries_popup_render_queue"
		)

		if status != null:
			status.text = (
				"Countries and realms are ready. "
				+ "Click any country or realm to open its full overview."
			)

		EraLog.truth(
			"ERALIFE_REALM_BROWSER_PREPAINT_TRUTH"
			+ "|cache_key=" + cache_key
			+ "|cards=" + str(
				list.get_child_count()
			)
			+ "|popup_visible="
			+ str(
				popup.visible
			).to_lower()
			+ "|hidden_prepaint_allowed=true"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(
				completed_at_ms
			)
		)
		return

	if bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		var fenced_tree:= get_tree()
		if fenced_tree == null:
			call_deferred(
				"_continue_other_country_popup_chunked_render",
				render_sequence
			)
			return

		var fenced_timer:= fenced_tree.create_timer(
			0.048
		)
		fenced_timer.timeout.connect(
			Callable(
				self,
				"_continue_other_country_popup_chunked_render"
			).bind(
				render_sequence
			),
			CONNECT_ONE_SHOT
		)
		return

	var frame_started_ms: int = int(
		Time.get_ticks_msec()
	)
	var raw_descriptor: Variant = queue [
		cursor
	]
	cursor += 1

	var rendered_entry_rows: int = 0
	if typeof(raw_descriptor) == TYPE_DICTIONARY:
		var descriptor: Dictionary = (
			raw_descriptor as Dictionary
		)
		var descriptor_kind: String = str(
			descriptor.get(
				"kind",
				""
			)
		).strip_edges().to_lower()

		match descriptor_kind:
			"spacer":
				var spacer:= Control.new()
				spacer.custom_minimum_size = Vector2(
					0.0,
					18.0
				)
				spacer.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				list.add_child(
					spacer
				)

			"divider":
				_append_other_country_section_divider(
					list,
					str(
						descriptor.get(
							"title",
							"REALMS"
						)
					),
					bool(
						descriptor.get(
							"burn",
							false
						)
					)
				)

			"entry":
				var entry_raw: Variant = (
					descriptor.get(
						"entry",
						{}
					)
				)
				if typeof(entry_raw) == TYPE_DICTIONARY:
					_append_other_country_browser_row_resident_lens(
						list,
						entry_raw as Dictionary
					)
					rendered_entry_rows = 1

	set_meta(
		"other_countries_popup_render_cursor",
		cursor
	)
	set_meta(
		"other_countries_popup_last_chunk_descriptors",
		1
	)
	set_meta(
		"other_countries_popup_last_chunk_entry_rows",
		rendered_entry_rows
	)
	set_meta(
		"other_countries_popup_last_chunk_duration_ms",
		maxi(
			0,
			int(
				Time.get_ticks_msec()
			) - frame_started_ms
		)
	)
	set_meta(
		"other_countries_popup_all_rows_rendered_in_one_frame",
		false
	)
	set_meta(
		"other_countries_popup_one_descriptor_per_quantum",
		true
	)
	set_meta(
		"other_countries_popup_heavy_animated_rows_used",
		false
	)
	set_meta(
		"other_countries_popup_resident_lens_rows_used",
		true
	)

	var render_tree:= get_tree()
	if render_tree == null:
		call_deferred(
			"_continue_other_country_popup_chunked_render",
			render_sequence
		)
		return

	var render_timer:= render_tree.create_timer(
		0.032
	)
	render_timer.timeout.connect(
		Callable(
			self,
			"_continue_other_country_popup_chunked_render"
		).bind(
			render_sequence
		),
		CONNECT_ONE_SHOT
	)
func _other_country_browser_resident_deck_hot() -> bool:
	var popup:= get_node_or_null(
		"OtherCountriesPopup"
	)

	if popup == null:
		return false

	var list:= popup.find_child(
		"List",
		true,
		false
	) as VBoxContainer
	var cache_key: String = _other_country_browser_cache_key()
	var entries_raw: Variant = get_meta(
		"other_countries_browser_entries_cache",
		[]
	)
	var entries: Array = (
		entries_raw as Array
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)

	return (
		list != null
		and list.get_child_count() > 0
		and not entries.is_empty()
		and str(
			get_meta(
				"other_countries_browser_entries_cache_key",
				""
			)
		).strip_edges() == cache_key
		and bool(
			get_meta(
				"other_countries_browser_contract_hot",
				false
			)
		)
		and bool(
			get_meta(
				"other_countries_popup_prepainted",
				false
			)
		)
		and str(
			get_meta(
				"other_countries_popup_prepainted_cache_key",
				""
			)
		).strip_edges() == cache_key
	)


func _queue_other_country_browser_resident_prewarm(
	actor_id: int,
	signature: String
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(gs.player.id) != actor_id
	):
		return

	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return

	var request_key: String = "%s::%d" % [
		clean_signature,
		actor_id
	]
	var registry_raw: Variant = get_meta(
		"other_country_browser_residency_registry",
		{}
	)
	var registry: Dictionary = (
		(registry_raw as Dictionary).duplicate(false)
		if typeof(registry_raw) == TYPE_DICTIONARY
		else {}
	)
	var state: Dictionary = MainSceneHelpers._safe_dictionary(
		registry.get(
			request_key,
			{}
		)
	)

	if bool(
		state.get(
			"active",
			false
		)
	):
		return

	if (
		bool(
			state.get(
				"complete",
				false
			)
		)
		and _other_country_browser_resident_deck_hot()
	):
		return

	state = {
		"active": true,
		"complete": false,
		"actor_id": actor_id,
		"signature": clean_signature,
		"request_key": request_key,
		"attempt": 0,
		"ready_gate_member": false,
		"build_on_click": false,
		"queued_at_ms": int(Time.get_ticks_msec())
	}
	registry [
		request_key
	] = state

	set_meta(
		"other_country_browser_residency_registry",
		registry
	)

	call_deferred(
		"_continue_other_country_browser_resident_prewarm",
		actor_id,
		clean_signature,
		request_key
	)


func _continue_other_country_browser_resident_prewarm(
	actor_id: int,
	signature: String,
	request_key: String
) -> void:
	var registry_raw: Variant = get_meta(
		"other_country_browser_residency_registry",
		{}
	)
	var registry: Dictionary = (
		(registry_raw as Dictionary).duplicate(false)
		if typeof(registry_raw) == TYPE_DICTIONARY
		else {}
	)
	var state: Dictionary = MainSceneHelpers._safe_dictionary(
		registry.get(
			request_key,
			{}
		)
	)
	var current_browser_signature: String = str(
		_other_country_browser_cache_key()
	).strip_edges()
	var requested_browser_signature: String = str(
		signature
	).strip_edges()

	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
		or current_browser_signature != requested_browser_signature
	):
		state ["active"] = false
		state ["complete"] = false
		state ["cancelled"] = true
		state ["cancelled_current_browser_signature"] = (
			current_browser_signature
		)
		state ["cancelled_requested_browser_signature"] = (
			requested_browser_signature
		)
		registry [request_key] = state
		set_meta(
			"other_country_browser_residency_registry",
			registry
		)
		return

	if _other_country_browser_resident_deck_hot():
		state ["active"] = false
		state ["complete"] = true
		state ["completed_at_ms"] = int(
			Time.get_ticks_msec()
		)
		registry [request_key] = state
		set_meta(
			"other_country_browser_residency_registry",
			registry
		)

		EraLog.truth(
			"ERALIFE_REALM_BROWSER_RESIDENCY_TRUTH"
			+ "|actor_id=" + str(actor_id)
			+ "|hot=true"
			+ "|cards_prepainted=true"
			+ "|browser_cache_identity_authoritative=true"
			+ "|attached_runtime_signature_required=false"
			+ "|engine_calls_on_click=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	state ["attempt"] = int(
		state.get(
			"attempt",
			0
		)
	) + 1
	state ["last_attempt_at_ms"] = int(
		Time.get_ticks_msec()
	)
	state ["browser_cache_identity_authoritative"] = true
	state ["attached_runtime_signature_required"] = false
	registry [request_key] = state
	set_meta(
		"other_country_browser_residency_registry",
		registry
	)

	_prewarm_other_country_browser_cache()

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_continue_other_country_browser_resident_prewarm",
			actor_id,
			signature,
			request_key
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_other_country_browser_resident_prewarm"
		).bind(
			actor_id,
			signature,
			request_key
		),
		CONNECT_ONE_SHOT
	)
func _append_other_country_browser_row_resident_lens(
	parent: Container,
	entry: Dictionary
) -> void:
	if (
		parent == null
		or not is_instance_valid(
			parent
		)
		or entry.is_empty()
	):
		return

	var realm_raw: Variant = entry.get(
		"realm",
		{}
	)
	var realm: Dictionary = (
		realm_raw as Dictionary
		if typeof(realm_raw) == TYPE_DICTIONARY
		else {}
	)
	var entry_name: String = str(
		entry.get(
			"name",
			entry.get(
				"label",
				realm.get(
					"name",
					realm.get(
						"country",
						"Unknown Realm"
					)
				)
			)
		)
	).strip_edges()
	var entry_kind: String = str(
		entry.get(
			"entry_kind",
			realm.get(
				"realm_type",
				"realm"
			)
		)
	).strip_edges()
	var entry_id: String = str(
		entry.get(
			"entry_id",
			""
		)
	).strip_edges()
	var entry_key: String = entry_id

	if entry_key == "":
		entry_key = MainSceneHelpers._other_country_identity_key(
			entry_name
		)

	var realm_id: int = int(
		entry.get(
			"realm_id",
			realm.get(
				"realm_id",
				realm.get(
					"id",
					-1
				)
			)
		)
	)
	var browser_section: String = (
		_other_country_entry_browser_section(
			entry,
			realm
		)
	)
	var subtitle_text: String = str(
		entry.get(
			"subtitle",
			realm.get(
				"subtitle",
				entry_kind.capitalize()
			)
		)
	).strip_edges()
	var description_text: String = str(
		entry.get(
			"description",
			realm.get(
				"description",
				"A resident realm overview is available."
			)
		)
	).strip_edges()
	var realm_type: String = str(
		realm.get(
			"realm_type",
			realm.get(
				"dimension_type",
				""
			)
		)
	).strip_edges()
	var is_imaginative_realm: bool = (
		entry_kind == "imaginative_realm"
		or realm_type == "imagination_bound"
	)
	var player_presence: Dictionary = (
		MainSceneLogic._other_country_player_presence(gs, 
			entry,
			realm
		)
	)
	var is_player_current_place: bool = bool(
		player_presence.get(
			"is_current_place",
			false
		)
	)
	var population_browse_available: bool = (
		realm_id > 0
		and not MainSceneHelpers._other_country_population_entry_should_hide(
			entry,
			realm
		)
	)

	var leader_contract_raw: Variant = realm.get(
		"leader_identity_contract",
		{}
	)
	var leader_contract: Dictionary = (
		leader_contract_raw as Dictionary
		if typeof(leader_contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var leader_name: String = str(
		entry.get(
			"ruler_name",
			realm.get(
				"ruler_name",
				realm.get(
					"leader_name",
					leader_contract.get(
						"display_name",
						leader_contract.get(
							"name",
							"Unassigned"
						)
					)
				)
			)
		)
	).strip_edges()
	var leader_title: String = str(
		entry.get(
			"ruler_title",
