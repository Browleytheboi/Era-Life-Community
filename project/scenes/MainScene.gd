func _relationship_profile_surface_visible_for_action_result() -> bool:
	if relationship_profile_popup_open:
		return true
	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup) and relationship_profile_popup.visible:
		return true
	if relationship_editor_popup != null and is_instance_valid(relationship_editor_popup) and relationship_editor_popup.visible:
		return true
	if relationships_browser_panel != null and is_instance_valid(relationships_browser_panel) and relationships_browser_panel.visible:
		return true
	return false

func _prioritize_action_result_popup_layer() -> void:
	if action_result_popup == null or not is_instance_valid(action_result_popup):
		return

	if action_result_relationship_profile_return_pending:
		_suspend_relationship_profile_popup_for_action_result()

	var popup_z: int = MainSceneHelpers._safe_modal_z_index(1840, 1840)

	action_result_popup.visible = true
	action_result_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	action_result_popup.focus_mode = Control.FOCUS_ALL
	action_result_popup.z_as_relative = false
	action_result_popup.z_index = popup_z
	action_result_popup.top_level = true
	action_result_popup.set_meta("action_result_popup_has_modal_authority", true)
	action_result_popup.set_meta("action_result_popup_above_relationship_profile", true)

	if action_result_popup_dim != null and is_instance_valid(action_result_popup_dim):
		action_result_popup_dim.visible = true
		action_result_popup_dim.mouse_filter = Control.MOUSE_FILTER_STOP
		action_result_popup_dim.z_as_relative = true
		action_result_popup_dim.z_index = 0

	if action_result_popup_card != null and is_instance_valid(action_result_popup_card):
		action_result_popup_card.visible = true
		action_result_popup_card.mouse_filter = Control.MOUSE_FILTER_STOP
		action_result_popup_card.z_as_relative = true
		action_result_popup_card.z_index = 40

	var popup_parent:= action_result_popup.get_parent()
	if popup_parent != null:
		popup_parent.move_child(action_result_popup, popup_parent.get_child_count() - 1)

	_bring_modal_to_front(action_result_popup)
	action_result_popup.z_index = popup_z
	action_result_popup.grab_focus()
func _suspend_relationship_profile_popup_for_action_result() -> void:
