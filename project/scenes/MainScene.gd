func _pending_situations_lens_count_for_actor(actor: Person, lens_cache: Dictionary = {}, _reason: String = "pending_situations_lens") -> int:
	if actor == null:
		return 0

	var actor_id: int = int(actor.id)
	if actor_id <= 0:
		return 0

	var clean_lens_cache: Dictionary = MainSceneHelpers._safe_dictionary(lens_cache)
	var cache_actor_id: int = int(clean_lens_cache.get("actor_id", actor_id))

	if cache_actor_id == actor_id and clean_lens_cache.has("pending_situations_count"):
		return max(0, int(clean_lens_cache.get("pending_situations_count", 0)))

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var staged_actor_id: int = int(gs.scenario_state.get("pending_situations_zero_frame_actor_id", -1))
		if staged_actor_id == actor_id and bool(gs.scenario_state.get("pending_situations_zero_frame_ready", false)):
			return max(0, int(gs.scenario_state.get("pending_situations_zero_frame_count", 0)))

	return max(0, _pending_situations_count_for_actor(actor))


func _paint_pending_situations_button_for_actor_lens(actor: Person, count: int = -1, reason: String = "pending_situations_actor_lens") -> void:
	if pending_situations_button == null or not is_instance_valid(pending_situations_button):
		return

	if actor == null:
		pending_situations_button.visible = false
		pending_situations_button.disabled = true
		pending_situations_button.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pending_situations_button.text = "Pending Situations (0)"
		pending_situations_button.tooltip_text = "No controlled person is available."
		return

	var actor_id: int = int(actor.id)
	var safe_count: int = count
	if safe_count < 0:
		safe_count = _pending_situations_lens_count_for_actor(actor, {}, reason)

	safe_count = max(0, safe_count)
	var max_urgency: float = (
		_pending_situations_lens_max_urgency(
			actor_id
		)
	)

	pending_situations_button.set_meta(
		"pending_situations_lens_max_urgency",
		max_urgency
	)
	set_meta(
		"pending_situations_button_max_urgency",
		max_urgency
	)
	var actor_name: String = MainSceneHelpers._pending_situations_actor_display_name(actor)

	pending_situations_button.visible = true
	pending_situations_button.disabled = false
	pending_situations_button.mouse_filter = Control.MOUSE_FILTER_STOP
	pending_situations_button.text = "Pending Situations (%d)" % safe_count

	if safe_count == 1:
		pending_situations_button.tooltip_text = "1 unresolved situation is waiting for %s." % actor_name
	elif safe_count > 1:
		pending_situations_button.tooltip_text = "%d unresolved situations are waiting for %s." % [safe_count, actor_name]
	else:
		pending_situations_button.tooltip_text = "No unresolved situations right now."

	pending_situations_button.set_meta("pending_situations_lens_actor_id", actor_id)
	pending_situations_button.set_meta("pending_situations_lens_actor_name", actor_name)
	pending_situations_button.set_meta("pending_situations_lens_count", safe_count)
	pending_situations_button.set_meta("pending_situations_lens_reason", reason)
	pending_situations_button.set_meta("pending_situations_lens_actor_locked", true)

	set_meta("pending_situations_button_actor_id", actor_id)
	set_meta("pending_situations_button_count", safe_count)
	set_meta("pending_situations_button_actor_locked", true)
	set_meta("pending_situations_button_updated_at_ms", int(Time.get_ticks_msec()))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["pending_situations_count"] = safe_count
		gs.scenario_state ["pending_situations_button_actor_id"] = actor_id
		gs.scenario_state ["pending_situations_button_count"] = safe_count
		gs.scenario_state ["pending_situations_zero_frame_actor_id"] = actor_id
		gs.scenario_state ["pending_situations_zero_frame_count"] = safe_count
		gs.scenario_state ["pending_situations_zero_frame_ready"] = true
		gs.scenario_state ["pending_situations_button_actor_locked"] = true
		gs.scenario_state ["pending_situations_button_reason"] = reason
func _bind_pending_situations_lens_to_actor_now(
	actor_id: int,
