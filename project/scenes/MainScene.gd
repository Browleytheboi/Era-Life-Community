func _format_god_mode_bank_balance_value(value: int) -> String:
	var clamped_value:= int(clamp(value, 0, 5000000))
	if clamped_value >= 1000000:
		if clamped_value % 1000000 == 0:
			return "$%dM" % int(float(clamped_value) / 1000000.0)
		return "$%.2fM" % (float(clamped_value) / 1000000.0)
	if clamped_value >= 1000:
		if clamped_value % 1000 == 0:
			return "$%dK" % int(float(clamped_value) / 1000.0)
		return "$%.1fK" % (float(clamped_value) / 1000.0)
	return "$%d" % clamped_value

func _populate_god_mode_month_picker(selected_value: int) -> void:
	if custom_month_spin == null:
		return
	custom_month_spin.clear()
	var clamped_value:= int(clamp(selected_value, 1, 12))
	for i in range(12):
		var month_value:= i + 1
		custom_month_spin.add_item(MainSceneHelpers._god_mode_month_name(month_value))
		custom_month_spin.set_item_metadata(i, month_value)
	custom_month_spin.select(clamped_value - 1)

func _populate_god_mode_day_picker(selected_value: int) -> void:
	if custom_day_spin == null:
		return
	custom_day_spin.clear()
	var month_value:= MainSceneHelpers._selected_god_mode_option_value(custom_month_spin, 1)
	var max_days:= _days_in_god_mode_month(month_value)
	var clamped_value:= int(clamp(selected_value, 1, max_days))
	var option_index:= 0
	for value in range(1, max_days + 1):
		custom_day_spin.add_item(str(value))
		custom_day_spin.set_item_metadata(option_index, value)
		option_index += 1
	custom_day_spin.select(clamped_value - 1)
func _days_in_god_mode_month(month_value: int) -> int:
	match int(clamp(month_value, 1, 12)):
		2:
			var year_value:= 79
			if custom_year_spin != null:
				year_value = int(custom_year_spin.value)
			elif gs != null:
				year_value = int(gs.custom_settings.get("year", 79))
			if MainSceneHelpers._is_god_mode_leap_year(year_value):
				return 29
			return 28
		4, 6, 9, 11:
			return 30
		_:
			return 31

