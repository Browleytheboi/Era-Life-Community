func _on_bending_hub_enter_agni_kai_pressed() -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return
	if not gs.bending_engine.has_method("enter_agni_kai_championship"):
		return

	var result: Dictionary = gs.bending_engine.enter_agni_kai_championship(actor, {
		"source": "bending_hub_enter_agni_kai_pressed"
	})

	var scenario: Dictionary = result.get("scenario", {})
	if typeof(scenario) == TYPE_DICTIONARY and not scenario.is_empty():
		if gs.scenario_engine == null or not gs.scenario_engine.has_method("queue_external_scenario"):
			_maybe_show_action_result_popup({
				"success": false,
				"popup_title": "Scenario Runtime Missing",
				"popup_text": "The Agni Kai match was created, but ScenarioEngine.queue_external_scenario() is unavailable.",
				"popup_footer": "Tap anywhere to continue."
			})
			return

		var queue_result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
		_refresh_scenario_ui_from_result(queue_result)
		if scenario_panel != null:
			scenario_panel.z_as_relative = false
			scenario_panel.z_index = 1000
			_bring_modal_to_front(scenario_panel)

		bending_hud_last_rebuild_signature = ""
		_update_bending_hud()
		return

	_maybe_show_action_result_popup(result)
	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
func _on_bending_hub_advance_agni_kai_pressed() -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return
	if not gs.bending_engine.has_method("advance_agni_kai_championship_round"):
		return

	var result: Dictionary = gs.bending_engine.advance_agni_kai_championship_round(actor, {
		"source": "bending_hub_advance_agni_kai_pressed"
	})

	if bool(result.get("uses_scenario_panel", false)):
		_refresh_scenario_ui_from_result(result)
	else:
		_maybe_show_action_result_popup(result)

	_rebuild_bending_hub_tournament_content()
