func _global_prewarm_population_card_surfaces_now(reason: String = "global_prewarm_population_card_surfaces", realm_ids: Array = []) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var card_engine:= _ensure_population_card_contract_engine()
	var panel:= _ensure_realm_population_contract_panel()

	if card_engine == null or panel == null:
		return {
			"success": false,
			"reason": "missing_population_card_engine_or_panel"
		}

	var ids: Array = realm_ids.duplicate(true)
	if ids.is_empty():
		ids = _population_card_contract_tail_realm_ids()

	var built_count: int = 0
	var failed: Array = []

	for raw_realm_id in ids:
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
		if realm_name == "":
			failed.append({
				"realm_id": realm_id,
				"reason": "missing_realm_name"
			})
			continue

		var view_contract: Dictionary = card_engine.view_contract_for_realm(
			realm_id,
			realm_name,
			{
				"source": "%s_realm_%d" % [reason, realm_id],
				"tail_registry": false,
				"ui_is_renderer_only": true,
				"click_path_build_forbidden": true,
				"ready_door_may_not_wait": true
			}
		)

		if view_contract.is_empty():
			failed.append({
				"realm_id": realm_id,
				"realm_name": realm_name,
				"reason": "empty_population_card_view_contract"
			})
			continue

		if panel.has_method("register_card_graph_packet"):
			var graph_packet: Dictionary = view_contract.get("population_card_graph_packet", {}) if typeof(view_contract.get("population_card_graph_packet", {})) == TYPE_DICTIONARY else {}
			if not graph_packet.is_empty():
				panel.register_card_graph_packet(
					realm_id,
					realm_name,
					graph_packet,
					{
						"source": reason,
						"ui_is_renderer_only": true
					}
				)

		_prewarm_realm_population_contract_panel_for_realm(
			realm_id,
			realm_name,
			view_contract,
			"%s_surface_from_global_prewarm" % reason
		)

		built_count += 1

	gs.scenario_state ["global_prewarm_population_card_surfaces_built_count"] = built_count
	gs.scenario_state ["global_prewarm_population_card_surfaces_failed"] = failed.duplicate(true)
	gs.scenario_state ["global_prewarm_population_card_surfaces_last_reason"] = reason
	gs.scenario_state ["global_prewarm_population_card_surfaces_at_ms"] = int(Time.get_ticks_msec())

	return {
		"success": failed.is_empty(),
		"reason": "population_card_surfaces_hot" if failed.is_empty() else "population_card_surface_failures",
		"built_count": built_count,
		"failed": failed,
		"ui_is_renderer_only": true
	}


func _global_prewarm_verify_population_card_surfaces(realm_ids: Array = []) -> Dictionary:
	var card_engine:= _ensure_population_card_contract_engine()
