func _crown_hud_civic_office_projection(
	actor: Person
) -> Dictionary:
	if actor == null:
		return {}

	var civic_raw: Variant = actor.get(
		"civic_office_contract"
	)

	if typeof(civic_raw) != TYPE_DICTIONARY:
		return {}

	var civic: Dictionary = civic_raw as Dictionary
	var office: String = str(
		civic.get(
			"office",
			""
		)
	).strip_edges()
	var office_full_title: String = str(
		civic.get(
			"office_full_title",
			""
		)
	).strip_edges()
	var country: String = str(
		civic.get(
			"country",
			actor.home_country
		)
	).strip_edges()
	var government_model: String = str(
		civic.get(
			"government_model",
			""
		)
	).strip_edges().to_lower()
	var crown_access: bool = bool(
		civic.get(
			"crown_hub_access",
			false
		)
	)
	var elected_office: bool = (
		crown_access
		and office != ""
		and (
			government_model.contains("republic")
			or office.to_lower().contains("president")
			or bool(
				civic.get(
					"elected_office",
					false
				)
			)
		)
	)

	if not elected_office:
		return {}

	if country == "":
		country = "State"

	var title: String = office

	if title == "":
		title = office_full_title.trim_prefix("The ")

	if title == "":
		title = "Elected Executive"

	return {
		"title": title,
		"realm_name": country,
		"authority_tier": "elected",
		"standing": "Elected",
		"government_model": government_model,
		"office_full_title": office_full_title,
		"elected_office": true
	}
func _crown_hud_actor_scoped_readiness_truth() -> Dictionary:
	var actor_id: int = (
		int(gs.player.id)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)
	var actor_has_crown_presence: bool = (
		actor_id > 0
		and _player_has_crown_presence()
	)
	var contract_actor_id: int = int(
		crown_hub_active_contract.get(
			"actor_id",
			-1
		)
	)
	var contract_hot: bool = (
		actor_id > 0
		and contract_actor_id == actor_id
		and _crown_hub_contract_is_renderable(
			crown_hub_active_contract,
			actor_id
		)
	)
	var surface_revision: String = str(
		crown_hub_active_contract.get(
			"surface_revision",
			""
		)
	).strip_edges()
	var prepainted_actor_id: int = int(
		get_meta(
			"crown_hub_prepainted_actor_id",
			-1
		)
	)
	var prepainted_revision: String = str(
		get_meta(
			"crown_hub_prepainted_surface_revision",
			""
		)
	).strip_edges()
	var prepaint_hot: bool = (
		contract_hot
		and surface_revision != ""
		and prepainted_actor_id == actor_id
		and prepainted_revision == surface_revision
	)

	var crown_shell_hot: bool = (
		crown_hub_overlay != null
		and is_instance_valid(
			crown_hub_overlay
		)
	)
	var action_popup_hot: bool = (
		crown_action_popup != null
		and is_instance_valid(
			crown_action_popup
		)
	)



	var has_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or (
			profile_panel_popup != null
			and is_instance_valid(
				profile_panel_popup
			)
			and profile_panel_popup.visible
		)
		or (
			belongings_item_popup != null
			and is_instance_valid(
				belongings_item_popup
			)
			and belongings_item_popup.visible
		)
		or (
			belongings_item_target_popup != null
			and is_instance_valid(
				belongings_item_target_popup
			)
			and belongings_item_target_popup.visible
		)
		or crown_hub_open
		or (
			action_popup_hot
			and crown_action_popup.visible
		)
	)
	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
	)
	var runtime_surface_scope_allowed: bool = (
		_runtime_floating_hud_buttons_should_render_on_current_surface()
	)
	var surface_ready: bool = (
		actor_has_crown_presence
		and contract_hot
		and prepaint_hot
		and crown_shell_hot
	)
	var button_visible_allowed: bool = (
		runtime_surface_scope_allowed
		and surface_ready
	)

	return {
		"actor_id": actor_id,
		"actor_has_crown_presence": (
			actor_has_crown_presence
		),
		"contract_actor_id": contract_actor_id,
		"contract_hot": contract_hot,
		"surface_revision": surface_revision,
		"prepainted_actor_id": prepainted_actor_id,
		"prepainted_revision": prepainted_revision,
		"prepaint_hot": prepaint_hot,
		"shell_hot": crown_shell_hot,
		"crown_shell_hot": crown_shell_hot,
		"action_popup_hot": action_popup_hot,
		"surface_ready": surface_ready,
		"has_modal_blocker": has_modal_blocker,
		"blocked_by_age_up_loading": (
			blocked_by_age_up_loading
		),
		"allow_embedded_life_view": (
			runtime_surface_scope_allowed
		),
		"runtime_surface_scope_allowed": (
			runtime_surface_scope_allowed
		),
		"button_visible_allowed": (
			button_visible_allowed
		),
		"visibility_authority": (
			"runtime_floating_hud_buttons_should_render_on_current_surface"
			+ "+crown_hud_actor_scoped_readiness_truth"
		),
		"build_on_click": false,
		"ready_gate_member": false
	}
func _update_crown_hud() -> void:
	if (
		crown_hud_button == null
		or not is_instance_valid(
			crown_hud_button
		)
	):
		return

	var readiness: Dictionary = (
		_crown_hud_actor_scoped_readiness_truth()
	)
	var actor_id: int = int(
		readiness.get(
			"actor_id",
			-1
		)
	)
	var can_show: bool = bool(
		readiness.get(
			"button_visible_allowed",
			false
		)
	)



	_apply_zero_frame_hud_button_shell(
		crown_hud_button,
		can_show
	)

	set_meta(
		"crown_hud_actor_scoped_readiness",
		readiness.duplicate(false)
	)
	set_meta(
		"crown_hud_actor_scoped_readiness_actor_id",
		actor_id
	)
	set_meta(
		"crown_hud_actor_scoped_surface_ready",
		bool(
			readiness.get(
				"surface_ready",
				false
			)
		)
	)
	set_meta(
		"crown_hud_actor_scoped_contract_hot",
		bool(
			readiness.get(
				"contract_hot",
				false
			)
		)
	)
	set_meta(
		"crown_hud_actor_scoped_prepaint_hot",
		bool(
			readiness.get(
				"prepaint_hot",
				false
			)
		)
	)
	set_meta(
		"crown_hud_refresh_did_not_cancel_background_service",
		true
	)
	set_meta(
		"crown_hud_refresh_engine_calls",
		false
	)
	set_meta(
		"crown_hud_refresh_contract_build_performed",
		false
	)
	set_meta(
		"crown_hud_refresh_population_query_performed",
		false
	)
	set_meta(
		"crown_hud_refresh_summary_builder_invoked",
		false
	)
	set_meta(
		"crown_hud_refresh_permissions_builder_invoked",
		false
	)
	set_meta(
		"crown_hud_refresh_local_geometry_write_performed",
		false
	)
	set_meta(
		"crown_hud_refresh_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if not can_show:
		return

	crown_hud_button.set_meta(
		"runtime_floating_hud_geometry_authority",
		"sync_runtime_floating_hud_layering"
	)
	crown_hud_button.set_meta(
		"crown_hud_local_stack_layout_forbidden",
		true
	)

	var core: Color = _crown_hud_core_color()
	var pulse: float = (
		(
			sin(
				crown_hud_breathe_time * 2.0
			) + 1.0
		) * 0.5
	)
	var btn_style: StyleBoxFlat = (
		MainSceneHelpers._runtime_stylebox_flat_from_meta(
			crown_hud_button,
			"crown_hud_button_style",
			2,
			16
		)
	)

	if btn_style == null:
		return

	btn_style.bg_color = Color(
		core.r,
		core.g,
		core.b,
		0.18 + (pulse * 0.1)
	)
	btn_style.border_color = Color(
		core.r,
		core.g,
		core.b,
		0.86
	)

	crown_hud_button.add_theme_stylebox_override(
		"normal",
		btn_style
	)
	crown_hud_button.add_theme_stylebox_override(
		"hover",
		btn_style
	)
	crown_hud_button.add_theme_stylebox_override(
		"pressed",
		btn_style
	)
	crown_hud_button.add_theme_color_override(
		"font_color",
		Color.WHITE
	)
	crown_hud_button.text = " "

	var summary: Dictionary = {}
	var permissions: Dictionary = {}
	var summary_raw: Variant = get_meta(
		"crown_hud_cached_summary",
		{}
	)
	var permissions_raw: Variant = get_meta(
		"crown_hud_cached_permissions",
		{}
	)

	if typeof(summary_raw) == TYPE_DICTIONARY:
		summary = (
			summary_raw as Dictionary
		)

	if typeof(permissions_raw) == TYPE_DICTIONARY:
		permissions = (
			permissions_raw as Dictionary
		)

	if (
		crown_hub_active_actor_id == actor_id
		and not crown_hub_active_contract.is_empty()
	):
		for summary_key in [
			"summary",
			"throne_summary",
			"crown_summary"
		]:
			var contract_summary_raw: Variant = (
				crown_hub_active_contract.get(
					summary_key,
					{}
				)
			)

			if typeof(
				contract_summary_raw
			) != TYPE_DICTIONARY:
				continue

			var contract_summary: Dictionary = (
				contract_summary_raw as Dictionary
			)

			if contract_summary.is_empty():
				continue

			summary = contract_summary
			break

		var contract_permissions_raw: Variant = (
			crown_hub_active_contract.get(
				"permissions",
				{}
			)
		)

		if typeof(
			contract_permissions_raw
		) == TYPE_DICTIONARY:
			permissions = (
				contract_permissions_raw as Dictionary
			)

	var civic_projection: Dictionary = (
		_crown_hud_civic_office_projection(
			gs.player
		)
	)

	if not civic_projection.is_empty():
		summary = {
			"title": str(
				civic_projection.get(
					"title",
					"President"
				)
			),
			"realm_name": str(
				civic_projection.get(
					"realm_name",
					"State"
				)
			),
			"standing": str(
				civic_projection.get(
					"standing",
					"Elected"
				)
			)
		}
		permissions = {
			"authority_tier": str(
				civic_projection.get(
					"authority_tier",
					"elected"
				)
			)
		}

	if summary.is_empty():
		var title_text: String = str(
			gs.player.royal_title
		).strip_edges()
		var realm_name: String = str(
			gs.player.home_country
		).strip_edges()

		if title_text == "":
			title_text = (
				"Ruler"
				if bool(
					gs.player.is_ruler
				)
				else "Royal"
			)

		if realm_name == "":
			realm_name = "Realm"

		summary = {
			"title": title_text,
			"realm_name": realm_name,
			"standing": (
				"Ruling"
				if bool(
					gs.player.is_ruler
				)
				else "Royal"
			)
		}

	var authority_tier: String = str(
		permissions.get(
			"authority_tier",
			""
		)
	).strip_edges()

	if authority_tier == "":
		if bool(
			gs.player.is_ruler
		):
			authority_tier = "state"
		elif int(
			gs.player.succession_rank
		) > 0:
			authority_tier = "succession"
		elif bool(
			gs.player.is_royal
		):
			authority_tier = "ceremonial"
		else:
			authority_tier = "none"

	crown_hud_button.tooltip_text = (
		"Open Crown Hub\n%s of %s\nAuthority: %s\nStanding: %s"
		% [
			str(
				summary.get(
					"title",
					"Crown"
				)
			),
			str(
				summary.get(
					"realm_name",
					"Realm"
				)
			),
			authority_tier.capitalize(),
			str(
				summary.get(
					"standing",
					"Royal"
				)
			)
		]
	)

	set_meta(
		"crown_hud_refresh_is_o1",
		true
	)
	set_meta(
		"crown_hud_surface_hot_before_button_visible",
		true
	)
	set_meta(
		"crown_hud_single_visibility_authority",
		true
	)
func _animate_crown_hud(delta: float) -> void:
	crown_hud_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("crown_hud_next_light_refresh_ms", 0))
	if now_ms >= next_refresh_ms:
		set_meta("crown_hud_next_light_refresh_ms", now_ms + 220)
		_update_crown_hud()
	else:
		if crown_hud_button != null and crown_hud_button.visible:
			var quick_core:= _crown_hud_core_color()
			var quick_pulse:= (sin(crown_hud_breathe_time * 2.0) + 1.0) * 0.5
			var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(crown_hud_button, "crown_hud_button_style", 2, 16)
			if btn_style != null:
				btn_style.bg_color = Color(quick_core.r, quick_core.g, quick_core.b, 0.18 + (quick_pulse * 0.1))
				btn_style.border_color = Color(quick_core.r, quick_core.g, quick_core.b, 0.86)

	if crown_hub_overlay != null and crown_hub_overlay.visible:
		_refresh_crown_hub_chrome()

		var next_live_refresh_ms: int = int(get_meta("crown_hub_next_live_bleed_refresh_ms", 0))
		var now_live_ms: int = int(Time.get_ticks_msec())
		if now_live_ms >= next_live_refresh_ms:
			set_meta("crown_hub_next_live_bleed_refresh_ms", now_live_ms + 1400)
			set_meta("crown_hub_live_bleed_refresh_seen_at_ms", now_live_ms)
			set_meta("crown_hub_live_bleed_refresh_policy", "chrome_only_no_full_rebuild_during_animation")

	if crown_action_popup != null and crown_action_popup.visible:
		var core:= _crown_hud_core_color()
		var pulse:= (sin(crown_hud_breathe_time * 1.8) + 1.0) * 0.5
		if crown_action_popup_card != null:
			var popup_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(crown_action_popup_card, "crown_action_popup_style", 2, 20)
			if popup_style != null:
				crown_action_popup_card.add_theme_stylebox_override("panel", popup_style)
				popup_style.bg_color = Color(0.05, 0.06, 0.1, 0.98)
				popup_style.border_color = Color(core.r, core.g, core.b, 0.72 + (pulse * 0.12))
func _restore_playable_life_shell_chrome_from_snapshot(snapshot: Dictionary = {}, reason: String = "playable_life_shell_chrome") -> void:
	if gs == null or gs.player == null:
		return

	set_meta("legacy_playable_life_shell_chrome_restore_intercepted", true)
	set_meta("legacy_playable_life_shell_chrome_restore_intercepted_reason", reason)
	set_meta("legacy_playable_life_shell_chrome_restore_intercepted_at_ms", int(Time.get_ticks_msec()))

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["legacy_playable_life_shell_chrome_restore_intercepted"] = true
		gs.scenario_state ["legacy_playable_life_shell_chrome_restore_intercepted_reason"] = reason
		gs.scenario_state ["legacy_playable_life_shell_layout_forbidden"] = true
		gs.scenario_state ["main_scene_is_stage_not_performer"] = true

	_seal_upgraded_playable_life_shell_surface(snapshot.duplicate(true), "%s_upgraded_surface" % reason)
