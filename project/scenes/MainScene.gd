func _school_hub_rebuild_population_grid(grid: Control, rows: Array) -> void:
	if grid == null:
		return

	_clear_container_children(grid)

	for raw_row in rows:
		var row: Dictionary = MainSceneHelpers._safe_dictionary(raw_row)
		if row.is_empty():
			continue

		var person_id: int = int(row.get("person_id", -1))
		var card:= PanelContainer.new()
		card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		card.add_theme_stylebox_override("panel", MainSceneHelpers._institution_hub_inner_panel_style("school"))
		grid.add_child(card)

		var margin:= MarginContainer.new()
		margin.add_theme_constant_override("margin_left", 10)
		margin.add_theme_constant_override("margin_top", 10)
		margin.add_theme_constant_override("margin_right", 10)
		margin.add_theme_constant_override("margin_bottom", 10)
		card.add_child(margin)

		var vbox:= VBoxContainer.new()
		vbox.add_theme_constant_override("separation", 6)
		margin.add_child(vbox)

		var btn:= Button.new()
		btn.text = "%s (Age %d)" % [
			str(row.get("full_name", "Student")),
			int(row.get("age", 0))
		]
		btn.custom_minimum_size = Vector2(0, 36)
		MainSceneHelpers._style_institution_hub_action_button(btn, "school")
		if person_id > 0:
			btn.pressed.connect(func () -> void:
				_hide_school_population_popup()
				_hide_school_class_roster_popup()
				_on_standard_tab_person_pressed(person_id)
			)
		vbox.add_child(btn)

		var role_label:= Label.new()
		role_label.text = str(row.get("role", "Student"))
		role_label.add_theme_color_override("font_color", Color(0.76, 0.84, 1.0, 0.92))
		vbox.add_child(role_label)

		var popularity: int = clamp(int(row.get("popularity", 0)), 0, 100)
		var pop_label:= Label.new()
		pop_label.text = "Popularity: %d%%" % popularity
		pop_label.add_theme_color_override("font_color", Color(0.82, 0.9, 1.0, 0.96))
		vbox.add_child(pop_label)

		var bar:= ProgressBar.new()
		bar.min_value = 0
		bar.max_value = 100
		bar.value = popularity
		bar.custom_minimum_size = Vector2(0, 16)
		bar.show_percentage = false
		vbox.add_child(bar)


func _drive_school_hub_live_surface(delta: float) -> void:
	if not institution_hub_open:
		return
	if str(institution_hub_kind).strip_edges().to_lower() != "school":
		return
	if gs == null or gs.player == null or gs.school_engine == null:
		return

	var accumulator: float = float(get_meta("school_hub_live_surface_accumulator", 0.0)) + delta
	if accumulator < 1.15:
		set_meta("school_hub_live_surface_accumulator", accumulator)
		return

	set_meta("school_hub_live_surface_accumulator", 0.0)

	if institution_hub_current_section == "meal":
		_refresh_institution_hub()

	var popup:= get_node_or_null("SchoolPopulationPopup")
	if popup != null:
		var snapshot: Dictionary = gs.school_engine.get_school_ecosystem_snapshot(gs.player)
		var rows: Array = _school_hub_population_rows_from_snapshot(gs.player, snapshot)
		var grid:= popup.get_node_or_null("SchoolPopulationGrid")
		if grid != null:
			_school_hub_rebuild_population_grid(grid, rows)
func _collect_immediate_family_relationship_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	var alive_parent_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, person.parents)
	var alive_sibling_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, _collect_sibling_ids_for_person(person))

	for raw_id in alive_parent_ids:
		MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(raw_id))
	for raw_id in alive_sibling_ids:
		MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(raw_id))

	return out
func _build_relationship_institution_hub_section(section: String) -> void:
	_build_relationships_institution_hub_section(section)
func _relationship_hub_add_family_secondary_lanes(alive_in_law_ids: Array, alive_aunt_uncle_ids: Array, alive_niece_nephew_ids: Array) -> void:
	var lanes: Array = [
		{
			"title": "In-Laws",
			"ids": alive_in_law_ids,
			"empty_text": "None yet.",
			"options": {
				"section_key": "family"
			}
		},
		{
			"title": "Aunts / Uncles",
			"ids": alive_aunt_uncle_ids,
			"empty_text": "None yet — this lane is ready for expansion.",
			"options": {
				"section_key": "family"
			}
		},
		{
			"title": "Nieces / Nephews",
			"ids": alive_niece_nephew_ids,
			"empty_text": "None yet — this lane is ready for expansion.",
			"options": {
				"section_key": "family"
			}
		}
	]

	var populated_lanes: Array = []
	var empty_lanes: Array = []

	for raw_lane in lanes:
		var lane: Dictionary = raw_lane
		var ids: Array = lane.get("ids", [])
		if MainSceneHelpers._relationship_hub_family_lane_has_members(ids):
			populated_lanes.append(lane)
		else:
			empty_lanes.append(lane)

	var ordered_lanes: Array = []
	ordered_lanes.append_array(populated_lanes)
	ordered_lanes.append_array(empty_lanes)

	for raw_ordered_lane in ordered_lanes:
		var ordered_lane: Dictionary = raw_ordered_lane
		_institution_hub_add_people_group(
			str(ordered_lane.get("title", "")),
			ordered_lane.get("ids", []),
			str(ordered_lane.get("empty_text", "None yet.")),
			ordered_lane.get("options", {})
		)
func _build_relationships_institution_hub_section(section: String) -> void:
	var p: Person = gs.player
	if p == null:
		return

	var sibling_ids: Array = _collect_sibling_ids_for_person(p)
	var grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, p, 2)
	var great_grandparent_ids: Array = MainSceneLogic._collect_ancestor_generation_ids(gs, p, 3)
	var in_law_ids: Array = _collect_player_in_law_ids(p)
	var aunt_uncle_ids: Array = _collect_player_aunt_uncle_ids(p)
	var niece_nephew_ids: Array = _collect_player_niece_nephew_ids(p)
	var fling_ids: Array = MainSceneLogic._collect_player_fling_ids(gs, p)
	var _alive_parent_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, p.parents)
	var _alive_sibling_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, sibling_ids)
	var immediate_family_ids: Array = _collect_immediate_family_relationship_ids(p)
	var alive_grandparent_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, grandparent_ids)
	var alive_great_grandparent_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, great_grandparent_ids)
	var alive_in_law_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, in_law_ids)
	var alive_aunt_uncle_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, aunt_uncle_ids)
	var alive_niece_nephew_ids: Array = MainSceneLogic._collect_alive_institution_relationship_ids(gs, niece_nephew_ids)
	var dead_great_grandparent_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, great_grandparent_ids)
	var dead_grandparent_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, grandparent_ids)
	var dead_parent_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, p.parents)
	var dead_sibling_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, sibling_ids)
	var dead_child_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, p.children)
	var dead_grandchild_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, MainSceneLogic._collect_descendant_generation_ids(gs, p, 2))
	var dead_great_grandchild_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, MainSceneLogic._collect_descendant_generation_ids(gs, p, 3))
	var dead_in_law_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, in_law_ids)
	var dead_aunt_uncle_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, aunt_uncle_ids)
	var dead_niece_nephew_ids: Array = MainSceneLogic._collect_dead_institution_relationship_ids(gs, niece_nephew_ids)
	var household_anchor: Person = MainSceneLogic._resolve_player_household_anchor(gs, p)
	var custodial_parent: Person = MainSceneLogic._resolve_player_custodial_parent(gs, p)
	var household_member_ids: Array = _collect_player_household_member_ids(p)
	var household_focus_ids: Array = []
	var household_focus_seen: Dictionary = {}

	if custodial_parent != null and int(p.age) < 18:
		MainSceneHelpers._add_unique_institution_relationship_id(household_focus_ids, household_focus_seen, int(custodial_parent.id))
	if household_anchor != null:
		MainSceneHelpers._add_unique_institution_relationship_id(household_focus_ids, household_focus_seen, int(household_anchor.id))

	match section:
		"family":
			_institution_hub_add_people_group(
				"Immediate Family",
				immediate_family_ids,
				"No immediate family is visible right now.",
				{
					"premium": true,
					"subtitle": "Parents and siblings stay pinned here as the top-priority relationship lane.",
					"highlight_cards": true,
					"columns": 2,
					"section_key": "family"
				}
			)

			_relationship_hub_add_family_secondary_lanes(
				alive_in_law_ids,
				alive_aunt_uncle_ids,
				alive_niece_nephew_ids
			)

		"ancestors":
			_institution_hub_add_people_group(
				"Grandparents",
				alive_grandparent_ids,
				"No living grandparents are visible right now.",
				{
					"premium": true,
					"subtitle": "Your direct ancestor lane is separated from immediate family so grandparent relationships stay easy to scan.",
					"section_key": "ancestors",
					"columns": 2
				}
			)
			_institution_hub_add_people_group(
				"Great-Grandparents",
				alive_great_grandparent_ids,
				"No living great-grandparents are visible right now.",
				{
					"section_key": "ancestors"
				}
			)

		"household":
			_institution_hub_add_card("Household State", _build_household_status_lines(p))
			_institution_hub_add_card("Household Property", MainSceneLogic._build_household_property_card_lines(gs, p))

			if p.age >= 18:
				_institution_hub_add_action_button("Leave Household", "Relationship Household Leave")
			else:
				_institution_hub_add_action_button("Try To Leave Household", "Relationship Household Run Away")

			if custodial_parent != null and int(p.age) < 18:
				_institution_hub_add_section_header("Custodial Parent")
				_institution_hub_add_person_button(custodial_parent)

			if household_anchor != null and not (custodial_parent != null and int(p.age) < 18 and int(household_anchor.id) == int(custodial_parent.id)):
				_institution_hub_add_section_header("Household Anchor")
				_institution_hub_add_person_button(household_anchor)

			_institution_hub_add_people_group(
				"Household Members",
				household_member_ids,
				"No active household members are visible right now.",
				{
					"premium": true,
					"subtitle": "Everyone still living under this roof stays clickable here without duplicating the anchor lane above.",
					"exclude_ids": household_focus_ids,
					"section_key": "household"
				}
			)

		"partner":
			_institution_hub_add_section_header("Partner")
			var valid_partner = gs.get_valid_partner(p, true, true)
			if valid_partner != null:
				_institution_hub_add_person_button(valid_partner)
			else:
				_institution_hub_add_info_label("None")

			_institution_hub_add_people_group(
				"Flings",
				fling_ids,
				"No flings yet.",
				{
					"premium": true,
					"subtitle": "Writing flings and casual flings live here without occupying the serious partner slot.",
					"section_key": "partner"
				}
			)
			_institution_hub_add_people_group(
				"In-Laws",
				alive_in_law_ids,
				"None yet.",
				{
					"section_key": "partner"
				}
			)

		"descendants":
			_institution_hub_add_people_group(
				"Children",
				p.children,
				"None yet.",
				{
					"section_key": "descendants",
					"columns": 2
				}
			)
			_institution_hub_add_people_group(
				"Grandchildren",
				MainSceneLogic._collect_descendant_generation_ids(gs, p, 2),
				"None yet.",
				{
					"section_key": "descendants"
				}
			)
			_institution_hub_add_people_group(
				"Great-Grandchildren",
				MainSceneLogic._collect_descendant_generation_ids(gs, p, 3),
				"None yet.",
				{
					"section_key": "descendants"
				}
			)

		"dead":
			_institution_hub_add_people_group("Great-Grandparents", dead_great_grandparent_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Grandparents", dead_grandparent_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Parents", dead_parent_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Siblings", dead_sibling_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Children", dead_child_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Grandchildren", dead_grandchild_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Great-Grandchildren", dead_great_grandchild_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("In-Laws", dead_in_law_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Aunts / Uncles", dead_aunt_uncle_ids, "None.", { "section_key": "dead"})
			_institution_hub_add_people_group("Nieces / Nephews", dead_niece_nephew_ids, "None.", { "section_key": "dead"})

		"social":
			_institution_hub_add_people_group(
				"Friends",
				p.friends,
				"No friends are visible right now.",
				{
					"premium": true,
					"section_key": "social"
				}
			)
			_institution_hub_add_people_group(
				"Aunts / Uncles",
				alive_aunt_uncle_ids,
				"None yet — this lane is ready for expansion.",
				{
					"section_key": "social"
				}
			)
			_institution_hub_add_people_group(
				"Nieces / Nephews",
				alive_niece_nephew_ids,
				"None yet — this lane is ready for expansion.",
				{
					"section_key": "social"
				}
			)

		"pets":
			var pet_cards: Array = MainSceneLogic._relationship_hub_pet_card_contracts_for_player(gs)
			_institution_hub_add_entity_relationship_group(
				"Pets",
				pet_cards,
				"No pets are connected to your household yet.",
				{
					"premium": true,
					"section_key": "pets",
					"columns": 2,
					"subtitle": "Animals and companions are graph-backed entities. The relationship hub only renders the graph."
				}
			)

		"exes":
			_institution_hub_add_people_group(
