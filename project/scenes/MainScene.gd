	if title_card_account_popup == null:
		return

	var title:= title_card_account_popup.find_child("AccountTitle", true, false) as Label
	var send_button:= title_card_account_popup.find_child("SendCodeButton", true, false) as Button
	var submit_button:= title_card_account_popup.find_child("SubmitButton", true, false) as Button

	if title_card_account_mode == "login":
		if title != null:
