		return

	_ensure_career_hub_panel()

	career_hub_active_actor_id = int(
		gs.player.id
	)
	career_hub_active_section_id = "overview"
	career_hub_active_lane = "full_time"

	_open_career_hub_zero_frame_door(
		"print_career_hub_first_frame"
	)
func _deferred_refresh_career_panel_contract(
	actor_id: int,
	reason: String
) -> void:
	if gs == null:
		return

	var actor: Person = (
		gs.get_or_reactivate_npc_by_id(
			actor_id
		)
	)

	if (
		actor == null
		and gs.player != null
		and int(
			gs.player.id
		) == actor_id
	):
		actor = gs.player

	if actor == null:
		return

	_request_career_hub_contract(
		actor,
		{
			"action_id": "refresh",
			"section_id": (
				career_hub_active_section_id
			),
			"lane": career_hub_active_lane,
			"source": reason
		},
		true
	)
func _on_career_panel_intent_requested(
	payload: Dictionary
) -> void:
	if gs == null or gs.player == null:
		return

	career_panel_active_section_id = str(
		payload.get(
			"section_id",
			career_panel_active_section_id
		)
	).strip_edges().to_lower()

	if career_panel_active_section_id == "":
		career_panel_active_section_id = "overview"

	_request_career_panel_contract(
		gs.player,
		payload
	)


