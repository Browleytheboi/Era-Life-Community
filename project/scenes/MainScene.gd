func _render_desktop_native_main_tab(panel_id: String) -> bool:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()

	if _render_incarceration_tab_if_needed(clean_panel, "desktop_native_main_tab"):
		return true

	match clean_panel:
		"life":
			if institution_hub_open:
				_hide_institution_hub()
			if activities_action_open:
				_hide_activities_action_panel()
			if world_feed_popup_open:
				_hide_world_action_panel()
			if output_label != null:
				output_label.visible = false
			_print_life_panel()
			return true

		"world":
			current_panel = "world"

			if output_label != null:
				output_label.visible = false
			if institution_hub_open:
				_hide_institution_hub()
			if activities_action_open:
				_hide_activities_action_panel()
			if standard_tab_popup_open:
				_hide_standard_tab_popup()
			if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
				_hide_profile_panel_popup()

			_show_world_action_panel()

			if world_feed_popup_title != null:
				world_feed_popup_title.text = "WORLD"

			set_meta("world_tab_native_feed_opened_zero_frame", true)
			set_meta("world_tab_native_feed_opened_at_ms", int(Time.get_ticks_msec()))
			set_meta("world_tab_shell_packet_forbidden", true)

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["world_tab_native_feed_opened_zero_frame"] = true
				gs.scenario_state ["world_tab_shell_packet_forbidden"] = true
				gs.scenario_state ["world_tab_actual_designed_feed_visible"] = true

			if world_feed_popup_feed != null and world_feed_popup_feed.get_line_count() <= 0:
				call_deferred("_begin_world_feed_progressive_full_render", "native_world_tab_zero_frame_empty_feed")
			else:
				call_deferred("_reconcile_world_tab_deeper_truth_after_open", _build_main_tab_ui_packet_context("world"))

			return true

		"relationships":
			current_panel = "relationships"

			if output_label != null:
				output_label.visible = false
			if activities_action_open:
				_hide_activities_action_panel()
			if standard_tab_popup_open:
				_hide_standard_tab_popup()
			if world_feed_popup_open:
				_hide_world_action_panel()
			if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
				_hide_profile_panel_popup()

			_print_relationships_panel()
			return true

		"career":
			current_panel = "career"

			if output_label != null:
				output_label.visible = false
			if activities_action_open:
				_hide_activities_action_panel()
			if standard_tab_popup_open:
				_hide_standard_tab_popup()
			if world_feed_popup_open:
				_hide_world_action_panel()
			if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
				_hide_profile_panel_popup()

			_print_career_panel()
			return true

		"school":
			current_panel = "school"

			if output_label != null:
				output_label.visible = false
			if activities_action_open:
				_hide_activities_action_panel()
			if standard_tab_popup_open:
				_hide_standard_tab_popup()
			if world_feed_popup_open:
				_hide_world_action_panel()
			if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
				_hide_profile_panel_popup()

			_print_school_panel()
			return true

		"activities":
			current_panel = "activities"

			if output_label != null:
				output_label.visible = false
			if institution_hub_open:
				_hide_institution_hub()
			if standard_tab_popup_open:
				_hide_standard_tab_popup()
			if world_feed_popup_open:
				_hide_world_action_panel()
			if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible:
				_hide_profile_panel_popup()

			_print_activities_panel()
			return true
		"mods":
			current_panel = "mods"

			if output_label != null:
				output_label.visible = false

			if institution_hub_open:
				_hide_institution_hub()

			if activities_action_open:
				_hide_activities_action_panel()

			if standard_tab_popup_open:
				_hide_standard_tab_popup()

			if world_feed_popup_open:
				_hide_world_action_panel()

			if (
				profile_panel_popup != null
				and is_instance_valid(
					profile_panel_popup
				)
				and profile_panel_popup.visible
			):
				_hide_profile_panel_popup()

			_print_mod_menu_panel()
			return true
		_:
			return false
func _refresh_current_panel():
	if not _god_mode_ui_locked():
		_apply_centered_live_layout()

	if (
		gs != null
		and gs.afterlife_active
		and bool(
			gs.afterlife_state.get(
				"ui_lock_tabs",
				false
			)
		)
	):
		_hide_floating_quick_panels()

		if relationship_profile_popup_open:
			_hide_relationship_profile_popup()

		if relationships_browser_open:
			_hide_relationship_browser()

		if institution_hub_open:
			_hide_institution_hub()

		if activities_action_open:
			_hide_activities_action_panel()

		if standard_tab_popup_open:
			_hide_standard_tab_popup()

		if (
			profile_panel_popup != null
			and profile_panel_popup.visible
		):
			_hide_profile_panel_popup()

		if world_feed_popup_open:
			_hide_world_action_panel()

		_cancel_panel_content_transition()

		if output_label != null:
			output_label.visible = false

		_refresh_era_surface_panels()
		_update_player_stats_overlay()
		_apply_ui_nav_button_visuals()
		return

	var previous_panel: String = (
		panel_content_transition_last_panel
	)

	if current_panel != "":
		_hide_floating_quick_panels()

	if (
		relationship_profile_popup_open
		and current_panel != "relationships"
	):
		_hide_relationship_profile_popup()

	if (
		relationships_browser_open
		and current_panel != "relationships"
	):
		_hide_relationship_browser()

	if (
		institution_hub_open
		and current_panel not in [
			"relationships",
			"career",
			"school"
		]
	):
		_hide_institution_hub()

	if (
		activities_action_open
		and current_panel != "activities"
	):
		_hide_activities_action_panel()

	if (
		standard_tab_popup_open
		and current_panel not in [
			"life",
			"relationships",
			"career",
			"school",
			"activities"
		]
	):
		_hide_standard_tab_popup()

	if (
		profile_panel_popup != null
		and profile_panel_popup.visible
		and current_panel != "profile"
	):
		_hide_profile_panel_popup()

	if current_panel == "world":
		_open_world_tab_shell_immediate(
			"refresh_current_panel_world"
		)
		call_deferred(
			"_apply_ui_nav_button_visuals"
		)
		return

	var rendered_main_panel: bool = false

	if MainSceneHelpers._main_tab_uses_desktop_native_renderer(
		current_panel
	):
		rendered_main_panel = (
			_render_desktop_native_main_tab(
				current_panel
			)
		)

	if (
		not rendered_main_panel
		and current_panel in [
			"life",
			"relationships",
			"career",
			"school",
			"activities",
			"mods"
		]
	):
		if (
			output_label != null
			and current_panel != "life"
		):
			output_label.visible = false

		rendered_main_panel = (
			_try_render_main_tab_ui_packet(
				current_panel
			)
		)

		if not rendered_main_panel:
			rendered_main_panel = (
				_render_main_tab_pending_shell(
					current_panel
				)
			)

	if not rendered_main_panel:
		match current_panel:
			"profile":
				if output_label != null:
					output_label.visible = false

				_print_profile_panel()

			_:
				if institution_hub_open:
					_hide_institution_hub()

				if output_label != null:
					output_label.visible = true

				if age_up_diary_entries.is_empty():
					output_label.clear()

				if not age_up_diary_entries.is_empty():
					_render_life_diary_panel()

	_refresh_era_surface_panels()
	_update_player_stats_overlay()
	_apply_ui_nav_button_visuals()

	var target_surface: Control = (
		_get_panel_transition_surface_for_key(
			current_panel
		)
	)

	if current_panel == "":
		_cancel_panel_content_transition()
	elif current_panel != previous_panel:
		_begin_panel_content_transition(
			current_panel
		)
	elif target_surface != null:
		_restore_panel_transition_surface(
			target_surface
		)