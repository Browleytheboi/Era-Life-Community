func _sort_crown_diplomacy_realms(entries: Array) -> Array:
	var out: Array = entries.duplicate(true)

	for i in range(out.size()):
		var entry_raw: Variant = out [i]
		if typeof(entry_raw) != TYPE_DICTIONARY:
			continue

		var entry: Dictionary = entry_raw
		var realm_id: int = int(entry.get("realm_id", -1))
		var realm_raw: Variant = entry.get("realm", {})
		var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}
		var hydrated_realm: Dictionary = realm.duplicate(true)

		if gs != null and gs.realm_engine != null and gs.realm_engine.has_method("ensure_realm_defaults"):
			var ensured: Dictionary = gs.realm_engine.ensure_realm_defaults(realm_id)
			if not ensured.is_empty():
				hydrated_realm = ensured

		var live_population: int = int(hydrated_realm.get("population", 0))
		if gs != null and gs.realm_engine != null and gs.realm_engine.has_method("get_total_population_for_realm"):
			live_population = max(live_population, int(gs.realm_engine.get_total_population_for_realm(realm_id)))

		var power_preview: Dictionary = {}
		if gs != null and gs.realm_engine != null and gs.realm_engine.has_method("get_realm_power_snapshot"):
			power_preview = gs.realm_engine.get_realm_power_snapshot(realm_id)

		var relation_score: int = MainSceneLogic._get_crown_realm_relation_score(gs, realm_id)

		hydrated_realm ["_live_population"] = live_population
		hydrated_realm ["_has_cached_live_population"] = true
		hydrated_realm ["_power_preview"] = power_preview.duplicate(true)
		hydrated_realm ["_has_cached_power_preview"] = true
		hydrated_realm ["_relation_score"] = relation_score
		hydrated_realm ["_has_cached_relation_score"] = true

		entry ["realm"] = hydrated_realm
		entry ["_sort_name"] = str(hydrated_realm.get("name", "")).to_lower()
		entry ["_sort_population"] = live_population
		entry ["_sort_treasury"] = int(hydrated_realm.get("treasury", 0))
		entry ["_sort_military"] = int(power_preview.get("military_stockpile", hydrated_realm.get("military_stockpile", 0)))
		entry ["_sort_relation"] = relation_score
		out [i] = entry

	match crown_hub_diplomacy_sort_key:
		"name_asc":
			out.sort_custom(func (a, b):
				var a_dict: Dictionary = a
				var b_dict: Dictionary = b
				return str(a_dict.get("_sort_name", "")) < str(b_dict.get("_sort_name", ""))
			)
		"population_desc":
			out.sort_custom(func (a, b):
				var a_dict: Dictionary = a
				var b_dict: Dictionary = b
				return int(a_dict.get("_sort_population", 0)) > int(b_dict.get("_sort_population", 0))
			)
		"treasury_desc":
			out.sort_custom(func (a, b):
				var a_dict: Dictionary = a
				var b_dict: Dictionary = b
				return int(a_dict.get("_sort_treasury", 0)) > int(b_dict.get("_sort_treasury", 0))
			)
		"military_desc":
			out.sort_custom(func (a, b):
				var a_dict: Dictionary = a
				var b_dict: Dictionary = b
				return int(a_dict.get("_sort_military", 0)) > int(b_dict.get("_sort_military", 0))
			)
		_:
			out.sort_custom(func (a, b):
				var a_dict: Dictionary = a
				var b_dict: Dictionary = b
				return int(a_dict.get("_sort_relation", 0)) > int(b_dict.get("_sort_relation", 0))
			)

	return out
func _begin_crown_action_grid(columns: int = 3) -> GridContainer:
	if crown_hub_list == null:
		return null

	var grid:= GridContainer.new()
	grid.columns = max(1, int(columns))
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	grid.add_theme_constant_override("h_separation", 10)
	grid.add_theme_constant_override("v_separation", 10)
	grid.set_meta("crown_action_grid_cards_visible_first_glance", true)
	crown_hub_list.add_child(grid)
	crown_hub_list.set_meta("crown_action_grid_root", grid)
	return grid


func _end_crown_action_grid() -> void:
	if crown_hub_list == null:
		return
	if crown_hub_list.has_meta("crown_action_grid_root"):
		crown_hub_list.remove_meta("crown_action_grid_root")


func _crown_hub_action_parent() -> Control:
	if crown_hub_list == null or not is_instance_valid(crown_hub_list):
		return null

	if not crown_hub_list.has_meta("crown_action_grid_root"):
		return crown_hub_list

	var grid_raw: Variant = crown_hub_list.get_meta("crown_action_grid_root")
	if grid_raw is GridContainer and is_instance_valid(grid_raw):
		return grid_raw as GridContainer

	crown_hub_list.remove_meta("crown_action_grid_root")
	crown_hub_list.set_meta("crown_action_grid_stale_reference_repaired", true)
	crown_hub_list.set_meta("crown_action_grid_stale_reference_repaired_at_ms", int(Time.get_ticks_msec()))

	return crown_hub_list
func _append_crown_action_row(
	title_text: String,
	subtitle_text: String,
	action_id: String,
	enabled: bool = true,
	payload: Dictionary = {}
) -> void:
	if crown_hub_list == null:
		return

	var core:= _crown_hud_core_color()
	var consequence: Dictionary = _crown_hub_consequence_preview_for_action(action_id, payload)
	var severity: String = str(consequence.get("severity", "neutral"))
	var is_danger: bool = severity == "danger"
	var is_critical: bool = bool(consequence.get("critical", false))
	var preview_text: String = str(consequence.get("preview", "")).strip_edges()

	var action_parent: Control = _crown_hub_action_parent()
	if action_parent == null:
		return

	var using_grid: bool = action_parent is GridContainer

	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	card.custom_minimum_size = Vector2(0, 116 if using_grid else 110 if preview_text != "" else 92)
	card.mouse_filter = Control.MOUSE_FILTER_STOP
	card.z_index = 5 if is_critical else 2
	card.set_meta("crown_action_id", action_id)
	card.set_meta("crown_action_danger", is_danger)
	card.set_meta("crown_action_critical", is_critical)
	card.set_meta("crown_action_grid_card", using_grid)
	action_parent.add_child(card)
	var style: StyleBoxFlat = MainSceneLogic._crown_hub_depth_style(
		card,
		"crown_action_row_depth_style",
		"danger" if is_danger and enabled else "recessed",
		core,
		is_critical,
		is_danger and enabled
	)
	if not enabled:
		style.bg_color = Color(0.04, 0.04, 0.055, 0.7)
		style.border_color = Color(0.42, 0.38, 0.32, 0.24)

	card.add_theme_stylebox_override("panel", style)

	var payload_copy: Dictionary = payload.duplicate(true)
	card.gui_input.connect(func (event: InputEvent) -> void:
		if not enabled:
			return

		if event is InputEventMouseMotion and is_danger:
			var hover_style: StyleBoxFlat = MainSceneLogic._crown_hub_depth_style(card, "crown_action_row_depth_style", "danger", core, true, true)
			hover_style.bg_color = Color(0.11, 0.018, 0.026, 0.985)
			card.add_theme_stylebox_override("panel", hover_style)

		if event is InputEventMouseButton:
			var mouse_event:= event as InputEventMouseButton
			if mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed:
				_show_crown_action_popup(action_id, payload_copy.duplicate(true))
	)

	card.mouse_exited.connect(func () -> void:
		var reset_style: StyleBoxFlat = MainSceneLogic._crown_hub_depth_style(
			card,
			"crown_action_row_depth_style",
			"danger" if is_danger and enabled else "recessed",
			core,
			is_critical,
			is_danger and enabled
		)
		card.add_theme_stylebox_override("panel", reset_style)
	)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 16)
	margin.add_theme_constant_override("margin_bottom", 12)
