func _crown_hub_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}






	var queue: Array = [
		report
	]
	var inspected: int = 0
	var preferred_keys: Array = [
		"route_report",
		"result",
		"engine_report",
		"target_report",
		"commit_report",
		"command_report",
		"payload",
		"crr_report"
	]

	while (
		not queue.is_empty()
		and inspected < 64
	):
		var cursor_raw: Variant = queue.pop_front()

		if typeof(cursor_raw) != TYPE_DICTIONARY:
			continue

		var cursor: Dictionary = cursor_raw as Dictionary
		inspected += 1

		if cursor.has("crown_hub_contract"):
			var direct_raw: Variant = cursor.get(
				"crown_hub_contract",
				{}
			)

			if (
				typeof(direct_raw) == TYPE_DICTIONARY
				and not (
					direct_raw as Dictionary
				).is_empty()
			):
				return cursor.duplicate(false)

		if str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges() == "eralife.crown_hub_contract":
			return {
				"success": bool(
					cursor.get(
						"success",
						true
					)
				),
				"type": "crown_hub_projection_resolved",
				"crown_hub_contract": (
					cursor.duplicate(false)
				)
			}

		for raw_key in preferred_keys:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if not nested.is_empty():
				queue.append(nested)

		for raw_key in cursor.keys():
			if str(raw_key) in preferred_keys:
				continue

			var dynamic_raw: Variant = cursor.get(
				raw_key,
				{}
			)

			if typeof(dynamic_raw) != TYPE_DICTIONARY:
				continue

			var dynamic_nested: Dictionary = (
				dynamic_raw as Dictionary
			)

			if not dynamic_nested.is_empty():
				queue.append(dynamic_nested)

	set_meta(
		"crown_hub_route_inspection_deep_copy_performed",
		false
	)
	set_meta(
		"crown_hub_route_inspection_count",
		inspected
	)

	return {}

