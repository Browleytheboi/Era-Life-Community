	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
	_update_player_stats_overlay()



func _on_bending_hub_save_skill_allocation_pressed() -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return
	if not gs.bending_engine.has_method("allocate_bending_skill_point"):
		return

	_bending_hub_validate_pending_skill_allocation_actor(actor)

	var pending_total: int = _bending_hub_pending_skill_allocation_total()
	if pending_total <= 0:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "No Pending Allocation",
			"popup_text": "Stage skill points first, then save them.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	if pending_total > int(actor.bending_skill_points):
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Allocation Over Budget",
			"popup_text": "Pending allocation requires %d points, but you only have %d.\n\nReset allocation and try again." % [
				pending_total,
				int(actor.bending_skill_points)
			],
			"popup_footer": "Tap anywhere to continue."
		})
		return

	var applied_rows: Array = []
	var failed_rows: Array = []
	var keys: Array = bending_hub_pending_skill_allocation.keys()
	keys.sort()

	for raw_key in keys:
		var stat_name: String = str(raw_key).strip_edges().to_lower()
		var amount: int = max(0, int(bending_hub_pending_skill_allocation.get(stat_name, 0)))
		if stat_name == "" or amount <= 0:
			continue

		var result: Dictionary = gs.bending_engine.allocate_bending_skill_point(actor, stat_name, amount)
		if bool(result.get("success", false)):
			applied_rows.append("%s: %d → %d / %d | spent %d" % [
				stat_name.capitalize(),
				int(result.get("before", 0)),
				int(result.get("after", 0)),
				int(result.get("cap", 100)),
				int(result.get("spent", amount))
			])
			bending_hub_pending_skill_allocation.erase(stat_name)
		else:
			failed_rows.append("%s: %s" % [
				stat_name.capitalize(),
				str(result.get("reason", result.get("popup_text", "Could not apply.")))
			])

	var popup_text: String = ""
	if not applied_rows.is_empty():
		popup_text += "Saved allocation:\n%s" % "\n".join(applied_rows)
	if not failed_rows.is_empty():
		if popup_text != "":
			popup_text += "\n\n"
		popup_text += "Still pending / failed:\n%s" % "\n".join(failed_rows)

	if popup_text == "":
		popup_text = "No allocation was changed."

	_maybe_show_action_result_popup({
		"success": failed_rows.is_empty(),
		"popup_title": "Allocation Saved" if failed_rows.is_empty() else "Allocation Partially Saved",
		"popup_text": popup_text,
		"popup_footer": "Tap anywhere to continue."
	})

	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
	_update_player_stats_overlay()
func _bending_hub_visual_element_color(element: String, corrupted:= false, legendary:= false) -> Color:
	var clean_element: String = str(element).strip_edges().to_lower()
	var base_color: Color = _bending_hud_element_color(clean_element)

	if corrupted:
		base_color = base_color.lerp(Color(0.06, 0.02, 0.1, 1.0), 0.58)

	if legendary:
		base_color = base_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.22)

	return base_color


func _build_bending_hub_ability_style(profile: Dictionary, pulse: float, disabled:= false) -> StyleBoxFlat:
	var clean_element: String = str(profile.get("element", "")).strip_edges().to_lower()
	var visual_tier: String = str(profile.get("visual_tier", "low")).strip_edges().to_lower()
	var corrupted: bool = bool(profile.get("corrupted_bending", false))
	var legendary: bool = visual_tier == "legendary" or bool(profile.get("legendary_mastery", false))

	var core: Color = _bending_hub_visual_element_color(clean_element, corrupted, legendary)
	var rank: int = max(1, int(profile.get("visual_rank", 1)))
	var aura_alpha: float = clamp(float(profile.get("aura_alpha", 0.22)), 0.08, 0.82)
	var radius: int = max(8, int(profile.get("aura_radius", 12)))

	var breathing_boost: float = 0.0
	if visual_tier == "mid":
		breathing_boost = pulse * 0.08
	elif visual_tier == "high":
		breathing_boost = pulse * 0.14
	elif visual_tier == "legendary":
		breathing_boost = pulse * 0.22

	var alpha_scale: float = 0.46 if disabled else 1.0

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(
		clampf(core.r * (0.11 + float(rank) * 0.025), 0.015, 0.3),
		clampf(core.g * (0.11 + float(rank) * 0.025), 0.015, 0.3),
		clampf(core.b * (0.11 + float(rank) * 0.025), 0.015, 0.34),
		(0.28 + breathing_boost) * alpha_scale
	)
	style.border_color = Color(core.r, core.g, core.b, (0.34 + breathing_boost + aura_alpha * 0.28) * alpha_scale)
	style.shadow_color = Color(core.r, core.g, core.b, (aura_alpha + breathing_boost) * alpha_scale)
	style.shadow_size = int(round(float(radius) * (0.62 + pulse * 0.3)))
	style.shadow_offset = Vector2.ZERO
	style.border_width_left = 1 + int(rank >= 2)
	style.border_width_top = 1 + int(rank >= 2)
	style.border_width_right = 1 + int(rank >= 2)
	style.border_width_bottom = 1 + int(rank >= 2)
	style.corner_radius_top_left = 14
	style.corner_radius_top_right = 14
	style.corner_radius_bottom_left = 14
	style.corner_radius_bottom_right = 14

	return style


func _apply_bending_hub_ability_visual_state(shell: Control, name_btn: Button, use_btn: Button, profile: Dictionary, pulse: float, disabled:= false) -> void:
	if profile.is_empty():
		return

	var style: StyleBoxFlat = _build_bending_hub_ability_style(profile, pulse, disabled)
	var clean_element: String = str(profile.get("element", "")).strip_edges().to_lower()
	var visual_tier: String = str(profile.get("visual_tier", "low")).strip_edges().to_lower()
	var corrupted: bool = bool(profile.get("corrupted_bending", false))
	var legendary: bool = visual_tier == "legendary" or bool(profile.get("legendary_mastery", false))
	var core: Color = _bending_hub_visual_element_color(clean_element, corrupted, legendary)
	var disabled_alpha: float = 0.48 if disabled else 1.0

	var panel_shell:= shell as PanelContainer
	if panel_shell != null:
		panel_shell.add_theme_stylebox_override("panel", style)
		panel_shell.modulate = Color(1.0, 1.0, 1.0, disabled_alpha)

	if name_btn != null:
		name_btn.add_theme_stylebox_override("normal", style)
		name_btn.add_theme_stylebox_override("hover", style)
		name_btn.add_theme_stylebox_override("pressed", style)
		name_btn.add_theme_stylebox_override("disabled", style)
		name_btn.add_theme_color_override("font_color", core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.24))
		name_btn.add_theme_color_override("font_shadow_color", Color(core.r, core.g, core.b, 0.34 + pulse * 0.22))
		name_btn.add_theme_constant_override("shadow_outline_size", 1 + int(visual_tier in ["high", "legendary"]))

	if use_btn != null:
		use_btn.add_theme_stylebox_override("normal", style)
		use_btn.add_theme_stylebox_override("hover", style)
		use_btn.add_theme_stylebox_override("pressed", style)
		use_btn.add_theme_stylebox_override("disabled", style)
		use_btn.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 0.72 if disabled else 1.0))


func _animate_bending_hub_ability_visuals(pulse: float) -> void:
	if bending_hud_ability_visual_controls.is_empty():
		_update_bending_hub_legendary_vignette(false, Color(0.0, 0.0, 0.0, 0.0), pulse)
		return

	var has_legendary: bool = false
	var legendary_color:= Color(0.4, 0.8, 1.0, 1.0)

	for raw_entry in bending_hud_ability_visual_controls:
		var entry: Dictionary = raw_entry
		var shell: Control = entry.get("shell", null)
		var name_btn: Button = entry.get("name_btn", null)
		var use_btn: Button = entry.get("use_btn", null)
		var profile: Dictionary = entry.get("profile", {})
		var disabled: bool = bool(entry.get("disabled", false))

		var speed: float = max(0.4, float(profile.get("pulse_speed", 0.85)))
		var local_pulse: float = (sin(bending_hud_breathe_time * speed * 2.0) + 1.0) * 0.5

		_apply_bending_hub_ability_visual_state(shell, name_btn, use_btn, profile, local_pulse, disabled)

		if bool(profile.get("legendary_vignette", false)):
			has_legendary = true
			legendary_color = _bending_hub_visual_element_color(
				str(profile.get("element", "")),
				bool(profile.get("corrupted_bending", false)),
				true
			)

	_update_bending_hub_legendary_vignette(has_legendary, legendary_color, pulse)


func _update_bending_hub_legendary_vignette(show_vignette: bool, core: Color, pulse: float) -> void:
	if bending_hud_legendary_vignette == null:
		return

	var should_show: bool = show_vignette and bending_hud_open and bending_hud_panel != null and bending_hud_panel.visible
	bending_hud_legendary_vignette.visible = should_show

	if not should_show:
		return

	bending_hud_legendary_vignette.color = Color(
		clampf(core.r * 0.18, 0.0, 0.22),
		clampf(core.g * 0.18, 0.0, 0.22),
		clampf(core.b * 0.18, 0.0, 0.28),
		0.18 + pulse * 0.12
	)


func _apply_bending_hud_avatar_state_button_visual_state(pulse: float) -> void:
	if bending_hud_avatar_state_button == null:
		return
	if gs == null or gs.player == null:
		return

	var is_avatar: bool = str(gs.player.bending_type).strip_edges().to_lower() == "avatar"
	if not is_avatar or not bending_hud_avatar_state_button.visible:
		return

	var colors: Array = [
		_bending_hud_element_color("air"),
		_bending_hud_element_color("water"),
		_bending_hud_element_color("earth"),
		_bending_hud_element_color("fire")
	]

	var cycle_float: float = fmod(max(0.0, bending_hud_breathe_time * 1.35), float(colors.size()))
	var idx: int = int(floor(cycle_float)) % colors.size()
	var next_idx: int = (idx + 1) % colors.size()
	var blend: float = cycle_float - floor(cycle_float)
	var core: Color = (colors [idx] as Color).lerp(colors [next_idx], blend)
	var unlocked: bool = bool(gs.player.avatar_state_unlocked) and not bool(gs.player.avatar_state_used)
	var alpha_scale: float = 1.0 if unlocked else 0.48

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(core.r * 0.16, core.g * 0.16, core.b * 0.16, (0.3 + pulse * 0.12) * alpha_scale)
	style.border_color = Color(core.r, core.g, core.b, (0.62 + pulse * 0.22) * alpha_scale)
	style.shadow_color = Color(core.r, core.g, core.b, (0.46 + pulse * 0.24) * alpha_scale)
	style.shadow_size = int(round(30.0 + pulse * 18.0))
	style.shadow_offset = Vector2.ZERO
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.corner_radius_top_left = 16
	style.corner_radius_top_right = 16
	style.corner_radius_bottom_left = 16
	style.corner_radius_bottom_right = 16

	bending_hud_avatar_state_button.add_theme_stylebox_override("normal", style)
	bending_hud_avatar_state_button.add_theme_stylebox_override("hover", style)
	bending_hud_avatar_state_button.add_theme_stylebox_override("pressed", style)
	bending_hud_avatar_state_button.add_theme_stylebox_override("disabled", style)
	bending_hud_avatar_state_button.add_theme_color_override("font_color", core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.34))
	bending_hud_avatar_state_button.add_theme_color_override("font_shadow_color", Color(core.r, core.g, core.b, 0.54))
	bending_hud_avatar_state_button.add_theme_constant_override("shadow_outline_size", 3)
func _apply_bending_hub_level_surface(row: Control, label: Label, bar: ProgressBar, element: String, level: int) -> void:
	if label == null or bar == null:
		return

	var safe_level: int = clamp(int(level), 0, 100)
	var resolved: Dictionary = MainSceneHelpers._bending_hub_level_surface(element, safe_level)
	var title_text: String = str(resolved.get("title_text", "%s: Dormant" % str(element).capitalize()))
	var flavor: String = str(resolved.get("flavor", ""))
	var bar_text: String = str(resolved.get("bar_text", "Level %d" % safe_level))

	label.text = title_text
	label.tooltip_text = "%s bending level %d\n%s" % [
		str(element).capitalize(),
		safe_level,
		flavor
	]

	if row != null:
		var flavor_label:= row.find_child("FlavorLabel", true, false) as Label
		if flavor_label != null:
			flavor_label.text = flavor
			flavor_label.visible = flavor != ""
			flavor_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
			flavor_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	bar.max_value = 100.0
	bar.set_meta("bending_hub_surface", true)
	bar.set_meta("bending_element", str(element).strip_edges().to_lower())
	bar.set_meta("bending_level", safe_level)

	var value_label:= bar.find_child("ValueLabel", true, false) as Label
	if value_label != null:
		value_label.text = bar_text
		value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		value_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
