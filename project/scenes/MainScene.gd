func _show_bending_dojo_history_popup(payload: Dictionary) -> void:
	var popup:= AcceptDialog.new()
	popup.title = "Dojo History"
	popup.exclusive = false
	popup.size = Vector2(780, 700)

	var scroll:= ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(740, 580)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO

	var box:= VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override("separation", 8)
	scroll.add_child(box)

	var dojo: Dictionary = payload.get("dojo", {}) if typeof(payload.get("dojo", {})) == TYPE_DICTIONARY else {}
	var history: Dictionary = payload.get("history", {}) if typeof(payload.get("history", {})) == TYPE_DICTIONARY else {}
	var rivalries: Array = payload.get("rivalries", []) if typeof(payload.get("rivalries", [])) == TYPE_ARRAY else []

	var header:= Label.new()
	header.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	header.text = "%s\nFounded: %d\nYears Active: %d\nCurrent Sensei: %s" % [
		str(dojo.get("name", history.get("dojo_name", "Bending Dojo"))),
		int(history.get("founded_year", 0)),
		int(history.get("years_active", 0)),
		str(history.get("active_sensei_name", "None"))
	]
	box.add_child(header)

	var lineage_title:= Label.new()
	lineage_title.text = "\nSensei Lineage"
	box.add_child(lineage_title)

	var lineage: Array = history.get("sensei_lineage", []) if typeof(history.get("sensei_lineage", [])) == TYPE_ARRAY else []
	if lineage.is_empty():
		var empty_lineage:= Label.new()
		empty_lineage.text = "No sensei lineage has been recorded yet."
		box.add_child(empty_lineage)
	else:
		for raw_lineage in lineage:
			if typeof(raw_lineage) != TYPE_DICTIONARY:
				continue

			var lineage_row: Dictionary = raw_lineage
			var lineage_label:= Label.new()
			lineage_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			lineage_label.text = "%s • %d → %s • %s" % [
				str(lineage_row.get("sensei_name", "Unknown")),
				int(lineage_row.get("start_year", 0)),
				"Present" if int(lineage_row.get("end_year", -1)) < 0 else str(int(lineage_row.get("end_year", 0))),
				str(lineage_row.get("status", "former")).capitalize()
			]
			box.add_child(lineage_label)

	var rivalry_title:= Label.new()
	rivalry_title.text = "\nDojo Rivalries"
	box.add_child(rivalry_title)

	if rivalries.is_empty():
		var empty_rivalries:= Label.new()
		empty_rivalries.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_rivalries.text = "No major rivalries have formed yet."
		box.add_child(empty_rivalries)
	else:
		for raw_rivalry in rivalries:
			if typeof(raw_rivalry) != TYPE_DICTIONARY:
				continue

			var rivalry: Dictionary = raw_rivalry
			var rivalry_label:= Label.new()
			rivalry_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			rivalry_label.text = "%s vs %s\nHeat: %d\nRecord: %d - %d" % [
				str(rivalry.get("dojo_a_name", "Dojo A")),
				str(rivalry.get("dojo_b_name", "Dojo B")),
				int(rivalry.get("heat", 0)),
				int(rivalry.get("dojo_a_wins", 0)),
				int(rivalry.get("dojo_b_wins", 0))
			]
			box.add_child(rivalry_label)

	var events_title:= Label.new()
	events_title.text = "\nNotable Events"
	box.add_child(events_title)

	var events: Array = history.get("notable_events", []) if typeof(history.get("notable_events", [])) == TYPE_ARRAY else []
	if events.is_empty():
		var empty_events:= Label.new()
		empty_events.text = "No notable events have been recorded yet."
		box.add_child(empty_events)
	else:
		for i in range(events.size() - 1, max(-1, events.size() - 11), -1):
			if typeof(events [i]) != TYPE_DICTIONARY:
				continue

			var event_row: Dictionary = events [i]
			var event_label:= Label.new()
			event_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			event_label.text = "%d • %s" % [
				int(event_row.get("year", 0)),
				str(event_row.get("text", "A dojo event occurred."))
			]
			box.add_child(event_label)

	popup.add_child(scroll)
	add_child(popup)
	popup.popup_centered()
