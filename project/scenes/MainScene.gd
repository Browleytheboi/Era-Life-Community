	value_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	value_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	value_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	value_label.add_theme_font_size_override("font_size", 11 if featured else 10)
	value_label.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 0.96))
	value_label.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.72))
	value_label.add_theme_constant_override("shadow_offset_x", 0)
	value_label.add_theme_constant_override("shadow_offset_y", 1)
	bar.add_child(value_label)

	bar.clip_contents = true

	var background:= StyleBoxFlat.new()
	background.bg_color = Color(soft_color.r, soft_color.g, soft_color.b, 0.3)
	background.border_width_left = 0
	background.border_width_top = 0
	background.border_width_right = 0
	background.border_width_bottom = 0
	background.corner_radius_top_left = 10
	background.corner_radius_top_right = 10
	background.corner_radius_bottom_left = 10
	background.corner_radius_bottom_right = 10
	background.shadow_color = Color(0.0, 0.0, 0.0, 0.26)
	background.shadow_size = 2
	background.shadow_offset = Vector2.ZERO

	var fill:= StyleBoxFlat.new()
	fill.bg_color = resolved_fill_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.12)
	fill.border_width_left = 0
	fill.border_width_top = 0
	fill.border_width_right = 0
	fill.border_width_bottom = 0
	fill.corner_radius_top_left = 10
	fill.corner_radius_top_right = 10
	fill.corner_radius_bottom_left = 10
	fill.corner_radius_bottom_right = 10
	fill.shadow_color = Color(glow_color.r, glow_color.g, glow_color.b, 0.18)
