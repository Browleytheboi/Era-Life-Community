func _drive_institution_hub_smooth_scroll(delta: float) -> void:
	if institution_hub_scroll == null:
		return

	var active: bool = bool(institution_hub_scroll.get_meta("smooth_scroll_active", false))
	var vbar:= institution_hub_scroll.get_v_scroll_bar()
	if vbar == null:
		return

	var max_scroll: float = max(0.0, float(vbar.max_value - vbar.page))
	if max_scroll <= 0.0:
		institution_hub_scroll.set_meta("smooth_scroll_active", false)
		institution_hub_scroll.set_meta("smooth_scroll_target", 0.0)
		return

	var current_value: float = float(institution_hub_scroll.scroll_vertical)
	var target_value: float = clamp(float(institution_hub_scroll.get_meta("smooth_scroll_target", current_value)), 0.0, max_scroll)

	if not active:
		institution_hub_scroll.set_meta("smooth_scroll_target", current_value)
		return

	var relationship_scroll: bool = str(institution_hub_kind).strip_edges().to_lower() == "relationships"
	var distance: float = abs(target_value - current_value)

	if distance <= 0.01:
		institution_hub_scroll.set_meta("smooth_scroll_active", false)
		institution_hub_scroll.set_meta("smooth_scroll_target", float(institution_hub_scroll.scroll_vertical))
		return

	var min_speed: float = 420.0
	var distance_multiplier: float = 14.0
	var snap_distance: float = 0.75

	if relationship_scroll:
		min_speed = 1400.0
		distance_multiplier = 34.0
		snap_distance = 2.0
		if distance >= 260.0:
			distance_multiplier = 44.0

	var speed: float = max(min_speed, distance * distance_multiplier)
	var next_value: float = move_toward(current_value, target_value, speed * delta)
	institution_hub_scroll.scroll_vertical = int(round(clamp(next_value, 0.0, max_scroll)))

	if abs(target_value - next_value) <= snap_distance:
		institution_hub_scroll.scroll_vertical = int(round(target_value))
		institution_hub_scroll.set_meta("smooth_scroll_active", false)
		institution_hub_scroll.set_meta("smooth_scroll_target", float(institution_hub_scroll.scroll_vertical))

func _institution_hub_smooth_scroll_step() -> float:
	var base_step: float = 104.0
	if str(institution_hub_kind).strip_edges().to_lower() == "relationships":
		base_step = 188.0
	return base_step


func _institution_hub_scroll_is_recently_active() -> bool:
	if institution_hub_scroll == null:
		return false

	if bool(institution_hub_scroll.get_meta("smooth_scroll_active", false)):
		return true

	var last_ms: int = int(institution_hub_scroll.get_meta("smooth_scroll_last_input_ms", 0))
	if last_ms <= 0:
		return false

	var recent_window_ms: int = 260
	if str(institution_hub_kind).strip_edges().to_lower() == "relationships":
		recent_window_ms = 520

	return int(Time.get_ticks_msec()) - last_ms <= recent_window_ms

func _institution_hub_row_data_is_scroll_visible(row_data: Dictionary, overscan: float = 96.0) -> bool:
	if str(institution_hub_kind).strip_edges().to_lower() == "relationships":
		if row_data.has("_scroll_visible"):
			return bool(row_data.get("_scroll_visible", true))

	return _institution_hub_row_data_compute_scroll_visible(row_data, overscan)


func _institution_hub_control_is_scroll_visible(control: Control, overscan: float = 96.0) -> bool:
	if control == null:
		return true
	if institution_hub_scroll == null:
		return true
	if not is_instance_valid(control):
		return false

	var viewport_rect: Rect2 = institution_hub_scroll.get_global_rect()
	viewport_rect.position.y -= overscan
	viewport_rect.size.y += overscan * 2.0

	var control_rect: Rect2 = control.get_global_rect()
	return viewport_rect.intersects(control_rect)


func _institution_hub_scrollbar_hover_changed(hovered: bool) -> void:
