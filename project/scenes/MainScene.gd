func _render_action_result_popup_choices(
	result: Dictionary
) -> void:
	action_result_popup_choice_context.clear()

	if action_result_popup_choices == null:
		return

	var approval_card:= action_result_popup_choices.get_node_or_null(
		"ActionResultApprovalCard"
	) as Control

	if approval_card != null:
		approval_card.visible = false

	for child in action_result_popup_choices.get_children():
		if not (child is Button):
			continue

		var pooled_button: Button = child as Button
		pooled_button.visible = false
		pooled_button.disabled = true
		pooled_button.text = ""
		pooled_button.tooltip_text = ""

	var rendered_crown_approval_bar: bool = _render_crown_action_approval_bar(
		result
	)
	var choices: Array = MainSceneHelpers._safe_array(
		result.get(
			"choices",
			[]
		)
	)
	var render_count: int = mini(
		choices.size(),
		24
	)

	action_result_popup_choice_context = {
		"result": result.duplicate(false),
		"choices": choices.duplicate(false),
		"choice_count": render_count,
		"choice_pool_capacity": 24
	}

	for index in range(render_count):
		var choice: Dictionary = MainSceneHelpers._safe_dictionary(
			choices [index]
		)
		var button:= action_result_popup_choices.get_node_or_null(
			"ActionResultChoice%02d" % index
		) as Button

		if button == null:
			continue

		button.text = str(
			choice.get(
				"label",
				choice.get(
					"text",
					choice.get(
						"id",
						"Choose"
					)
				)
			)
		)

		var preview_lines: Array = MainSceneHelpers._safe_array(
			choice.get(
				"preview_lines",
				[]
			)
		)

		if not preview_lines.is_empty():
			button.tooltip_text = "\n".join(
				preview_lines
			)

		button.visible = true
		button.disabled = false
		button.set_meta(
			"action_result_choice_index",
			index
		)

	action_result_popup_choices.visible = (
		rendered_crown_approval_bar
		or render_count > 0
	)

	set_meta(
		"action_result_popup_choice_controls_reused",
		true
	)
	set_meta(
		"action_result_popup_choice_controls_built_on_open",
		false
	)
func _on_action_result_popup_choice_pressed(
	choice: Dictionary
) -> void:
	var pet_detail_action: String = str(
		choice.get(
			"detail_action",
			""
		)
	).strip_edges().to_lower()

	if pet_detail_action == "pet_rename_prompt":
		_begin_pet_rename_choice_mode(
			choice
		)
		return

	if pet_detail_action == "pet_rename_commit":
		_commit_pet_rename_from_popup_buffer()
		return

	if pet_detail_action == "pet_keep_name":
		_finish_pet_rename_keep_original()
		return
	if not _global_intent_commit_scope_active():
		var detail_action: String = str(
			choice.get(
				"detail_action",
				""
			)
		).strip_edges().to_lower()
		var engine_backed_choice: bool = (
			detail_action in [
				"engine_call",
				"hub_engine_call",
				"resolve_hub_action"
			]
		)

		if engine_backed_choice:
			if action_result_popup_body != null:
				action_result_popup_body.text = (
					"Committing your choice…"
				)

			if action_result_popup_choices != null:
				action_result_popup_choices.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			set_meta(
				"action_result_choice_engine_work_on_press",
				false
			)

			call_deferred(
				"_commit_action_result_popup_choice_engine_call_deferred",
				choice.duplicate(false)
			)
			return

		var choice_id: String = str(
			choice.get(
				"id",
				choice.get(
					"option_id",
					choice.get(
						"text",
						"popup_choice"
					)
				)
			)
		).strip_edges()

		_express_global_ui_intent(
			{
				"intent_type": "action_result_choice",
				"surface_id": "action_result_popup",
				"action_id": choice_id,
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"payload": {
					"choice": choice.duplicate(false)
				},
				"legacy_callback": (
					"_on_action_result_popup_choice_pressed"
				),
				"legacy_args": [
					choice.duplicate(false)
				],
				"target": {
					"route_kind": "main_scene_legacy_callback",
					"callback": (
						"_on_action_result_popup_choice_pressed"
					)
				},
				"source": "mainscene.action_result_popup"
			},
			{
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"immutable_contract_references": true
			}
		)
		return

	var result: Dictionary = MainSceneHelpers._safe_dictionary(
		action_result_popup_choice_context.get(
			"result",
			{}
		)
	)
	var followup: Dictionary = MainSceneHelpers._safe_dictionary(
		choice.get(
			"followup",
			result.get(
				"followup",
				{}
			)
		)
	)

	if not followup.is_empty():
		pending_action_result_followup = (
			followup.duplicate(false)
		)

	_hide_action_result_popup()

	if not followup.is_empty():
		call_deferred(
			"_service_action_result_followup_after_close",
			followup.duplicate(false)
		)

	_schedule_action_result_post_resolution_reconcile(
		"action_result_popup_choice_committed",
		{
			"source": "action_result_popup_choice",
			"choice_id": str(
				choice.get(
					"id",
					choice.get(
						"option_id",
						""
					)
				)
			),
		}
	)
func _commit_action_result_popup_choice_engine_call_deferred(
	choice: Dictionary
) -> void:
	var engine_result: Dictionary = (
		_resolve_action_result_popup_choice_engine_call(
			choice
		)
	)

	if engine_result.is_empty():
		return

	_hide_action_result_popup()

	var relationship_section: String = str(
		engine_result.get(
			"relationship_hub_reveal_section",
			""
		)
	).strip_edges().to_lower()

	if relationship_section != "":
		var revealed: bool = (
			_reveal_resident_relationship_hub_section_now(
				relationship_section,
				"action_result_relationship_hub_reveal"
			)
		)

		if not revealed:
			_maybe_show_action_result_popup({
				"success": true,
				"popup_title": "Marriage Planner",
				"popup_text": (
					"The resident Partner surface is still publishing."
				),
				"popup_footer": (
					"Nothing is blocked. It will become observable when its contract arrives."
				)
			})

		return

	var open_surface_id: String = str(
		engine_result.get(
			"open_surface_id",
			""
		)
	).strip_edges()

	if open_surface_id != "":
		var open_section_id: String = str(
			engine_result.get(
				"open_section_id",
				""
			)
		).strip_edges()

		call_deferred(
			"_open_contract_surface",
			open_surface_id,
			open_section_id
		)

		return

	_maybe_show_action_result_popup(
		engine_result
	)

	_schedule_action_result_post_resolution_reconcile(
		"action_result_popup_engine_choice_committed",
		{
			"source": (
				"action_result_popup_engine_choice"
			),
			"choice_id": str(
				choice.get(
					"id",
					choice.get(
						"option_id",
						""
					)
				)
			),
		}
	)
func _resolve_action_result_popup_choice_engine_call(
	choice: Dictionary
) -> Dictionary:
	var detail_action: String = str(
		choice.get(
			"detail_action",
			""
		)
	).strip_edges().to_lower()

	if detail_action not in [
		"engine_call",
		"hub_engine_call",
		"resolve_hub_action"
	]:
		return {}

	if (
		gs == null
		or gs.player == null
	):
		return {
			"success": false,
			"popup_title": "Action Failed",
			"popup_text": (
				"No active player was available for this choice."
			),
			"popup_footer": "The choice could not be routed."
		}

	var actor_id: int = int(
		gs.player.id
	)
	var engine_property: String = str(
		choice.get(
			"engine_property",
			"superhero_engine"
		)
	).strip_edges()
	var method_name: String = str(
		choice.get(
			"method",
			"resolve_hub_action"
		)
	).strip_edges()
	var payload: Dictionary = (
		_superpower_hub_safe_dictionary(
			choice.get(
				"payload",
				{}
			)
		)
	)

	if payload.is_empty():
		payload ["action_id"] = str(
			choice.get(
				"id",
				""
			)
		)

	payload ["source"] = str(
		payload.get(
			"source",
			"mainscene.action_result_popup_choice"
		)
	)
	payload ["actor_id"] = actor_id

	var action_id: String = str(
		payload.get(
			"action_id",
			payload.get(
				"action",
				choice.get(
					"id",
					"popup_choice"
				)
			)
		)
	).strip_edges()
	var target_id: int = int(
		payload.get(
			"target_id",
			actor_id
		)
	)
	var commits_reality_truth: bool = bool(
		choice.get(
			"commits_reality_truth",
			false
		)
	)
	var authority_prevalidated: bool = bool(
		choice.get(
			"authority_prevalidated",
			not commits_reality_truth
		)
	)
	var ephemeral_choice: bool = (
		not commits_reality_truth
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": target_id,
			"intent_type": "action_result_choice_engine_intent",
			"surface_id": "action_result_popup",
			"action_id": action_id,
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": ephemeral_choice,
			"skip_global_intent_persistence": ephemeral_choice,
			"skip_crr_observation": ephemeral_choice,
			"skip_checks_and_balances": authority_prevalidated,
			"authority_prevalidated": authority_prevalidated,
			"payload": payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": engine_property,
				"method": method_name,
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": payload ["source"]
		},
		{
			"actor_id": actor_id,
			"target_id": target_id,
			"surface_id": "action_result_popup",
			"action_id": action_id,
			"source": payload ["source"],
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": ephemeral_choice,
			"skip_global_intent_persistence": ephemeral_choice,
			"skip_crr_observation": ephemeral_choice,
			"skip_checks_and_balances": authority_prevalidated,
			"authority_prevalidated": authority_prevalidated
		}
	)
	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)

	if typeof(result_raw) == TYPE_DICTIONARY:
		return (
			result_raw as Dictionary
		).duplicate(false)

	return {
		"success": false,
		"popup_title": "Action Unavailable",
		"popup_text": (
			"The selected choice could not reach %s.%s()."
			% [
				engine_property,
				method_name
			]
		),
		"popup_footer": "Choice routing failed safely."
	}
func _maybe_show_pending_upce_interpretation_popup() -> void:
	if gs == null:
		return
	if action_result_popup_open:
		return
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	var pending_raw: Variant = gs.scenario_state.get("pending_upce_interpretations", [])
	if typeof(pending_raw) != TYPE_ARRAY:
		return

	var pending: Array = (pending_raw as Array).duplicate(true)
	if pending.is_empty():
		return

	var kept: Array = []
	var report: Dictionary = {}

	while not pending.is_empty():
		var report_raw: Variant = pending.pop_front()
		if typeof(report_raw) != TYPE_DICTIONARY:
			continue

		var candidate: Dictionary = report_raw as Dictionary
		if _should_discard_pending_upce_popup(candidate):
			continue

		report = candidate
		break

	for raw_remaining in pending:
		kept.append(raw_remaining)

	gs.scenario_state ["pending_upce_interpretations"] = kept

	if report.is_empty():
		return

	var event: Dictionary = {}
	var event_raw: Variant = report.get("event", {})
	if typeof(event_raw) == TYPE_DICTIONARY:
		event = event_raw as Dictionary

	var popup_text: String = str(report.get("player_narrative", report.get("clear_narrative", ""))).strip_edges()

	var consequences_raw: Variant = report.get("visible_consequences", [])
	if typeof(consequences_raw) == TYPE_ARRAY and not (consequences_raw as Array).is_empty():
		popup_text += "\n\nConsequences:"
		for raw_line in consequences_raw:
			var line: String = str(raw_line).strip_edges()
			if line != "":
				popup_text += "\n• %s" % line

	var hooks_raw: Variant = report.get("future_hooks", [])
	if typeof(hooks_raw) == TYPE_ARRAY and not (hooks_raw as Array).is_empty():
		popup_text += "\n\nFuture hooks:"
		for raw_hook in hooks_raw:
			var hook: String = str(raw_hook).replace("_", " ").capitalize()
			if hook != "":
				popup_text += "\n• %s" % hook

	if popup_text.strip_edges() == "":
		return

	var popup_title: String = str(report.get("popup_title", event.get("popup_title", "Interpretation"))).strip_edges()
	if popup_title == "":
		popup_title = "Interpretation"

	_maybe_show_action_result_popup({
		"success": true,
		"popup_title": popup_title,
		"popup_text": popup_text,
		"popup_footer": str(report.get("popup_footer", event.get("popup_footer", "Tap anywhere to continue."))),
		"text": popup_text,
		"source": "upce_engine",
		"upce_interpretation": report.duplicate(true)
	})

func _should_discard_pending_upce_popup(report: Dictionary) -> bool:
	if report.is_empty():
		return true

	var event: Dictionary = {}
	var event_raw: Variant = report.get("event", {})
	if typeof(event_raw) == TYPE_DICTIONARY:
		event = event_raw as Dictionary

	var allow_boot_popup: bool = bool(report.get("allow_boot_player_ui_interpretation", event.get("allow_boot_player_ui_interpretation", false)))
	if _upce_pending_popup_runtime_gate_active() and not allow_boot_popup:
		return true

	if bool(report.get("suppress_player_ui_interpretation", false)):
		return true
	if bool(event.get("suppress_player_ui_interpretation", false)):
		return true
	if bool(report.get("suppress_upce_player_popup", false)):
		return true
	if bool(event.get("suppress_upce_player_popup", false)):
		return true

	var force_popup: bool = bool(report.get("force_player_ui_interpretation", event.get("force_player_ui_interpretation", false)))
	var explicit_popup: bool = bool(report.get("show_player_ui_interpretation", event.get("show_player_ui_interpretation", false)))

	if not force_popup and not explicit_popup:
		return true

	var classification: Dictionary = {}
	var classification_raw: Variant = report.get("classification", event.get("classification", {}))
	if typeof(classification_raw) == TYPE_DICTIONARY:
		classification = classification_raw as Dictionary

	var event_name: String = str(event.get("event_name", report.get("event_name", ""))).strip_edges().to_lower()
	var event_type: String = str(event.get("event_type", "")).strip_edges().to_lower()
	var source: String = str(event.get("source", report.get("source", ""))).strip_edges().to_lower()

	var is_object_perception: bool = event_name == "object.perceived" or event_type == "object_perception" or bool(classification.get("object_perception", false))
	if is_object_perception and not force_popup and not bool(event.get("allow_object_perception_popup", report.get("allow_object_perception_popup", false))):
		return true

	if not force_popup:
		if source.find("spawn") >= 0:
			return true
		if source.find("bootstrap") >= 0:
			return true
		if source.find("birth_shell") >= 0:
			return true

	return false

func _upce_pending_popup_runtime_gate_active() -> bool:
	if gs == null:
		return true

	if bool(get_meta("startup_live_shell_loading", false)):
		return true
	if bool(get_meta("startup_birth_loading_overlay_active", false)):
		return true
	if bool(get_meta("age_up_post_loading_finalize_pending", false)):
		return true

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	if bool(gs.scenario_state.get("birth_shell_first_boot", false)):
		return true
	if bool(gs.scenario_state.get("birth_shell_first_boot_active", false)):
		return true
	if bool(gs.scenario_state.get("birth_shell_deferred_boot_pending", false)):
		return true
	if bool(gs.scenario_state.get("post_spawn_ui_finalize_pending", false)):
		return true
	if bool(gs.scenario_state.get("post_spawn_world_prewarm_pending", false)):
		return true
	if bool(gs.scenario_state.get("deferred_data_bootstrap_pending", false)):
		return true
	if bool(gs.scenario_state.get("deferred_runtime_watchers_bootstrap", false)):
		return true

	return false
