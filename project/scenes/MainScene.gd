func _set_birth_shell_interactive_controls_visible(should_show_controls: bool) -> void:
	var root:= get_node_or_null("UIContainer") as Control
	if root == null:
		return

	root.visible = true

	_bind_ui_nav_buttons()

	for key in ui_nav_buttons.keys():
		var button: Button = ui_nav_buttons.get(key, null)
		if button == null or not is_instance_valid(button):
			continue

		button.visible = should_show_controls
		button.disabled = not should_show_controls
		button.mouse_filter = Control.MOUSE_FILTER_STOP if should_show_controls else Control.MOUSE_FILTER_IGNORE

	if should_show_controls:
		if output_label != null and is_instance_valid(output_label):
			output_label.visible = true
			output_label.scroll_active = true
			output_label.bbcode_enabled = true

		_ensure_player_stats_overlay()
		if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
			player_stats_overlay.visible = gs != null and gs.player != null
		_ensure_belongings_hud()
		_ensure_bending_hud_button_shell()
		_ensure_crown_hud()
		_ensure_food_lifestyle_hud()
		var show_belongings: bool = _player_has_visible_belongings()
		var show_bending: bool = _player_has_visible_bending()
		var show_food_lifestyle: bool = _food_lifestyle_food_hub_available()
		var show_restaurant_lifestyle: bool = _food_lifestyle_restaurant_hub_available()

		if belongings_hud_button != null and is_instance_valid(belongings_hud_button):
			belongings_hud_button.visible = show_belongings
			belongings_hud_button.disabled = not show_belongings
