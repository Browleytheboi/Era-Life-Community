	return {
		"bar": bar,
		"value_label": value_label,
		"title_label": title,
		"flavor_label": flavor_label,
		"fill_style": fill,
		"fill_color": resolved_fill_color,
		"glow_color": glow_color,
		"born_hot": true,
		"target": safe_target,
		"max_value": safe_max
	}
func _collect_sibling_ids_for_person(person: Person) -> Array:
	var out: Array = []
	if person == null or gs == null:
		return out

	var person_parent_ids: Array = MainSceneHelpers._relationship_safe_person_id_array(person, "parents")
	if person_parent_ids.is_empty():
		return out

	var seen: Dictionary = {}
	for raw_npc in gs.npcs:
		if raw_npc == null or not (raw_npc is Person):
			continue

		var npc: Person = raw_npc as Person
		if int(npc.id) == int(person.id):
			continue

		if MainSceneHelpers._relationship_people_share_any_parent_id(person_parent_ids, MainSceneHelpers._relationship_safe_person_id_array(npc, "parents")):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(npc.id))

	return out
func _collect_player_in_law_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	var partner: Person = gs.get_valid_partner(person, true, true)
	if partner != null:
		for pid in partner.parents:
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(pid))
		for sid in _collect_sibling_ids_for_person(partner):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(sid))

	for sibling_id in _collect_sibling_ids_for_person(person):
		var sibling: Person = gs.get_or_reactivate_npc_by_id(int(sibling_id))
		if sibling == null:
			continue
		var sibling_partner: Person = gs.get_valid_partner(sibling, true, true)
		if sibling_partner != null and int(sibling_partner.id) != int(person.id):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(sibling_partner.id))

	for child_id in person.children:
		var child: Person = gs.get_or_reactivate_npc_by_id(int(child_id))
		if child == null:
			continue
		var child_partner: Person = gs.get_valid_partner(child, true, true)
		if child_partner != null and int(child_partner.id) != int(person.id):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(child_partner.id))

	return out

func _collect_player_aunt_uncle_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	for parent_id in person.parents:
		var parent: Person = gs.get_or_reactivate_npc_by_id(int(parent_id))
		if parent == null:
			continue
		for relative_id in _collect_sibling_ids_for_person(parent):
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(relative_id))

	return out

func _collect_player_niece_nephew_ids(person: Person) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if person == null or gs == null:
		return out

	for sibling_id in _collect_sibling_ids_for_person(person):
		var sibling: Person = gs.get_or_reactivate_npc_by_id(int(sibling_id))
		if sibling == null:
			continue
		for child_id in sibling.children:
			MainSceneHelpers._add_unique_institution_relationship_id(out, seen, int(child_id))

	return out
func _institution_hub_add_people_group(title_text: String, ids: Array, empty_text: String = "None", options: Dictionary = {}) -> void:
	if institution_hub_list == null:
		return

	var clean_ids: Array = []
	var seen: Dictionary = {}
	var excluded: Dictionary = {}
	var exclude_ids = options.get("exclude_ids", [])

	for raw_excluded in exclude_ids:
		var excluded_id: int = int(raw_excluded)
		if excluded_id > 0:
			excluded [excluded_id] = true

	for raw_id in ids:
		var clean_id: int = int(raw_id)
		if clean_id <= 0:
			continue
		if excluded.has(clean_id):
			continue
		if seen.has(clean_id):
			continue
		seen [clean_id] = true
		clean_ids.append(clean_id)

	var premium: bool = bool(options.get("premium", false))
	var subtitle_text: String = str(options.get("subtitle", "")).strip_edges()
	var relationships_mode: bool = str(institution_hub_kind).strip_edges().to_lower() == "relationships"
	var highlight_cards: bool = bool(options.get("highlight_cards", false))
	var section_key: String = str(options.get("section_key", institution_hub_current_section)).strip_edges().to_lower()
	var columns: int = int(options.get("columns", 0))

	if relationships_mode:
		var engine: RelationshipsHubContractEngine = _ensure_relationships_hub_contract_engine()
		var group_contract: Dictionary = {}

		if engine != null and gs != null and gs.player != null:
			group_contract = engine.emit_group_contract(gs.player, title_text, clean_ids, empty_text, options, {
				"source": "mainscene.institution_hub_add_people_group",
				"section_key": section_key,
				"highlight_cards": highlight_cards
			})

		if not group_contract.is_empty():
			clean_ids = MainSceneHelpers._safe_array(group_contract.get("ids", clean_ids))
			set_meta("relationships_hub_last_group_contract", group_contract.duplicate(true))

			var group_contracts: Dictionary = MainSceneHelpers._safe_dictionary(get_meta("relationships_hub_group_contract_by_title", {}))
			group_contracts [str(title_text)] = group_contract.duplicate(true)
			set_meta("relationships_hub_group_contract_by_title", group_contracts)
		else:
			clean_ids = _relationship_hub_sorted_ids_by_bond(clean_ids, gs.player)

		if columns <= 0:
			columns = 2 if highlight_cards else 3

		var palette: Dictionary = MainSceneHelpers._relationship_hub_section_palette(section_key)

		var panel:= PanelContainer.new()
		panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL

		var panel_style: StyleBoxFlat = MainSceneHelpers._institution_hub_inner_panel_style(institution_hub_kind).duplicate()
		panel_style.border_color = Color(palette.get("accent", Color(1.0, 0.48, 0.72, 0.9)))
		panel_style.border_width_left = 2 if highlight_cards else 1
		panel_style.border_width_top = 2 if highlight_cards else 1
		panel_style.border_width_right = 2 if highlight_cards else 1
		panel_style.border_width_bottom = 2 if highlight_cards else 1
		panel.add_theme_stylebox_override("panel", panel_style)
		institution_hub_list.add_child(panel)

		var margin:= MarginContainer.new()
		margin.add_theme_constant_override("margin_left", 14)
		margin.add_theme_constant_override("margin_top", 12)
		margin.add_theme_constant_override("margin_right", 14)
		margin.add_theme_constant_override("margin_bottom", 12)
		panel.add_child(margin)

		var vbox:= VBoxContainer.new()
		vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		vbox.add_theme_constant_override("separation", 10 if highlight_cards else 8)
		margin.add_child(vbox)

		var title:= Label.new()
		title.text = title_text
		title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		title.add_theme_font_size_override("font_size", 20 if highlight_cards else 18)
		title.add_theme_color_override("font_color", Color(palette.get("accent", Color(1.0, 0.88, 0.96, 1.0))))
		vbox.add_child(title)

		if subtitle_text != "":
			var subtitle:= Label.new()
			subtitle.text = subtitle_text
			subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			subtitle.add_theme_color_override("font_color", Color(0.92, 0.9, 1.0, 0.9))
			vbox.add_child(subtitle)

		if clean_ids.is_empty():
			var empty_label:= Label.new()
			empty_label.text = empty_text
			empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			empty_label.add_theme_color_override("font_color", Color(0.88, 0.9, 1.0, 0.86))
			vbox.add_child(empty_label)
			return

		var grid:= GridContainer.new()
		grid.columns = columns
		grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		grid.add_theme_constant_override("h_separation", 12 if highlight_cards else 10)
		grid.add_theme_constant_override("v_separation", 12 if highlight_cards else 10)
		grid.set_meta("relationship_group_featured", highlight_cards)
		grid.set_meta("relationship_group_section", section_key)
		vbox.add_child(grid)

		for raw_id in clean_ids:
			_institution_hub_add_person_or_relation_by_id(int(raw_id), "", grid)
		return

	if premium:
		var premium_panel:= PanelContainer.new()
		premium_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		premium_panel.add_theme_stylebox_override("panel", MainSceneHelpers._institution_hub_inner_panel_style(institution_hub_kind))
		institution_hub_list.add_child(premium_panel)

		var premium_margin:= MarginContainer.new()
		premium_margin.add_theme_constant_override("margin_left", 14)
		premium_margin.add_theme_constant_override("margin_top", 12)
		premium_margin.add_theme_constant_override("margin_right", 14)
		premium_margin.add_theme_constant_override("margin_bottom", 12)
		premium_panel.add_child(premium_margin)

		var premium_vbox:= VBoxContainer.new()
		premium_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		premium_vbox.add_theme_constant_override("separation", 10)
		premium_margin.add_child(premium_vbox)

		var premium_title:= Label.new()
		premium_title.text = title_text
		premium_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		premium_title.add_theme_font_size_override("font_size", 18)
		premium_title.add_theme_color_override("font_color", Color(1.0, 0.88, 0.96, 1.0))
		premium_vbox.add_child(premium_title)

		if subtitle_text != "":
			var premium_subtitle:= Label.new()
			premium_subtitle.text = subtitle_text
			premium_subtitle.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			premium_subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			premium_subtitle.add_theme_color_override("font_color", Color(0.92, 0.82, 1.0, 0.92))
			premium_vbox.add_child(premium_subtitle)

		if clean_ids.is_empty():
			var premium_empty:= Label.new()
			premium_empty.text = empty_text
			premium_empty.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			premium_empty.add_theme_color_override("font_color", Color(0.88, 0.9, 1.0, 0.86))
			premium_vbox.add_child(premium_empty)
			return

		for raw_id in clean_ids:
			_institution_hub_add_person_or_relation_by_id(int(raw_id), "", premium_vbox)
		return

	_institution_hub_add_section_header(title_text)

	if clean_ids.is_empty():
		_institution_hub_add_info_label(empty_text)
		return

	for raw_id in clean_ids:
		_institution_hub_add_person_or_relation_by_id(int(raw_id))
func _institution_hub_add_live_stat_card(title_text: String, stat_rows: Array, surface_context: Dictionary = {}) -> void:
	if institution_hub_list == null:
		return
	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	institution_hub_list.add_child(panel)
	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	panel.add_child(margin)
	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 8)
	margin.add_child(vbox)
	var title:= Label.new()
	title.text = title_text
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	vbox.add_child(title)
	var shared_surface_context: Dictionary = surface_context.duplicate(true) if typeof(surface_context) == TYPE_DICTIONARY else {}
	for raw_stat in stat_rows:
		if typeof(raw_stat) != TYPE_DICTIONARY:
			continue
		var stat_def: Dictionary = raw_stat
		var stat_title: String = str(stat_def.get("title", "")).strip_edges()
		if stat_title == "":
			continue
		var stat_max: int = max(1, int(stat_def.get("max_value", 100)))
		var stat_value: int = clamp(int(stat_def.get("value", 0)), 0, stat_max)
		var stat_danger: bool = bool(stat_def.get("danger", false))
		var row_surface_context: Dictionary = shared_surface_context.duplicate(true)
		var local_surface_context_raw: Variant = stat_def.get("surface_context", {})
		if typeof(local_surface_context_raw) == TYPE_DICTIONARY:
			var local_surface_context: Dictionary = local_surface_context_raw
			for key in local_surface_context.keys():
				row_surface_context [str(key)] = local_surface_context [key]
		var built:= _make_player_stat_row(stat_title, stat_max)
		vbox.add_child(built.row)
		built.bar.custom_minimum_size = Vector2(0, 20)
		built.bar.value = 0.0
		_apply_player_stat_surface_content(
			built.label,
			built.bar,
			stat_title,
			0,
			stat_max,
			row_surface_context
		)
		_refresh_player_stat_surface_title_text(
			built.label,
			built.bar,
			0,
			stat_max,
			stat_title
		)
		_refresh_player_stat_bar_value_text(
			built.bar,
			0,
			stat_max,
			stat_title
		)
		_apply_player_stat_row_visual_state(
			built.label,
			built.bar,
			stat_title,
			false,
			stat_danger,
			0.0
		)
		institution_hub_experience_rows.append({
			"label": built.label,
			"bar": built.bar,
			"title": stat_title,
			"target": float(stat_value),
			"danger": stat_danger
		})

