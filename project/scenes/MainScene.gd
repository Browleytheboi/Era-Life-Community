func _show_choose_ereality_entry_transition_shell(message: String = "Opening God Mode...") -> void:
	if choose_adventure_entry_overlay == null or not is_instance_valid(choose_adventure_entry_overlay):
		return

	var cover:= choose_adventure_entry_overlay.get_node_or_null("__ChooseErealityDoorwayCover") as ColorRect
	if cover == null:
		cover = ColorRect.new()
		cover.name = "__ChooseErealityDoorwayCover"
		cover.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		cover.mouse_filter = Control.MOUSE_FILTER_STOP
		cover.z_as_relative = false
		cover.z_index = 1400
		cover.color = Color(0.025, 0.01, 0.04, 0.82)
		choose_adventure_entry_overlay.add_child(cover)

		var center:= CenterContainer.new()
		center.name = "DoorwayCenter"
		center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		center.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cover.add_child(center)

		var label:= Label.new()
		label.name = "DoorwayLabel"
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		label.add_theme_font_size_override("font_size", 28)
		label.add_theme_color_override("font_color", Color(1.0, 0.94, 0.82, 1.0))
		center.add_child(label)

	var doorway_label:= cover.get_node_or_null("DoorwayCenter/DoorwayLabel") as Label
	if doorway_label != null:
		doorway_label.text = message

	cover.visible = true
	cover.modulate = Color(1.0, 1.0, 1.0, 1.0)


