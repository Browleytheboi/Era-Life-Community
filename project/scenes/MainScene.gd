	_household_creator_clear_body()

	var list_card:= MainSceneHelpers._household_creator_section_card("Created Household")
	household_creator_scroll_body.add_child(list_card)

	var list_body: VBoxContainer = list_card.get_meta("body", null)
	if list_body == null:
		return

	household_creator_created_member_list = VBoxContainer.new()
	household_creator_created_member_list.name = "household_creator_created_member_list"
	household_creator_created_member_list.add_theme_constant_override("separation", 8)
	list_body.add_child(household_creator_created_member_list)

	_household_creator_refresh_created_member_list()

	var actions:= HBoxContainer.new()
	actions.add_theme_constant_override("separation", 12)
	list_body.add_child(actions)

	if household_creator_created_members.size() < 8:
		household_creator_create_member_button = Button.new()
		household_creator_create_member_button.name = "HouseholdCreatorCreateMemberButton"
		household_creator_create_member_button.text = "+ Create Member #%d" % (household_creator_created_members.size() + 1)
		household_creator_create_member_button.custom_minimum_size = Vector2(280, 54)
		_style_god_mode_button(household_creator_create_member_button, true)
		household_creator_create_member_button.pressed.connect(Callable(self, "_household_creator_begin_member_editor").bind(-1))
		actions.add_child(household_creator_create_member_button)

	household_creator_continue_button = Button.new()
	household_creator_continue_button.name = "HouseholdCreatorContinueButton"
	household_creator_continue_button.custom_minimum_size = Vector2(260, 54)
	household_creator_continue_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_style_god_mode_button(household_creator_continue_button, true)

	if household_creator_created_members.size() <= 1:
		household_creator_continue_button.text = "Continue anyway"
	else:
		household_creator_continue_button.text = "Continue"

	household_creator_continue_button.disabled = household_creator_created_members.is_empty()
	household_creator_continue_button.pressed.connect(_on_household_creator_continue_pressed)
	actions.add_child(household_creator_continue_button)


func _household_creator_refresh_created_member_list() -> void:
	if household_creator_created_member_list == null or not is_instance_valid(household_creator_created_member_list):
		return

	for child in household_creator_created_member_list.get_children():
		child.queue_free()

	if household_creator_created_members.is_empty():
		var empty:= Label.new()
		empty.text = "No household members yet. Create Member #1 must be an adult."
		empty.add_theme_font_size_override("font_size", 16)
		empty.add_theme_color_override("font_color", Color(1.0, 0.76, 0.66, 0.88))
		household_creator_created_member_list.add_child(empty)
		return

	for i in range(household_creator_created_members.size()):
		var member: Dictionary = household_creator_created_members [i]
		var button:= Button.new()
		button.text = "%s %s • Age %d • %s" % [
			str(member.get("first_name", "")).strip_edges(),
			str(member.get("last_name", "")).strip_edges(),
			int(member.get("age", 0)),
			str(member.get("age_stage", "")).strip_edges()
		]
		button.custom_minimum_size = Vector2(0, 52)
		_style_god_mode_button(button, false)
		button.pressed.connect(Callable(self, "_household_creator_begin_member_editor").bind(i))
		household_creator_created_member_list.add_child(button)


func _household_creator_begin_member_editor(member_index: int = -1) -> void:
	household_creator_current_step = "member_basic"
	household_creator_active_member_index = member_index
	household_creator_confirm_no_family = false
