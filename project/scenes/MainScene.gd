func _execute_god_mode_viewer_residency_request(
	panel_state: Dictionary,
	reason: String
) -> void:
	var engine:= _ensure_god_mode_contract_engine()

	if engine == null:
		_set_god_mode_prewarm_progress(
			0.0,
			"God Mode contract authority is unavailable.",
			false
		)
		return

	var prewarming_reason: String = (
		"prewarming_button_pressed"
	)




	set_meta(
		"god_mode_manual_world_seed_prewarm_authorized",
		true
	)

	if gs != null:
		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"god_mode_manual_world_seed_prewarm_authorized"
		] = true

	var settings:= _build_default_custom_settings()

	for key in panel_state.keys():
		settings [key] = panel_state [key]

	settings ["_god_mode_entry_kind"] = str(
		settings.get(
			"_god_mode_entry_kind",
			"custom"
		)
	)
	settings ["starting_infinity_stones"] = clampi(
		int(
			settings.get(
				"starting_infinity_stones",
				0
			)
		),
		0,
		2
	)
	settings ["start_with_red_bonnet"] = bool(
		settings.get(
			"start_with_red_bonnet",
			false
		)
	)

	settings = MainSceneLogic._canonicalize_god_mode_reality_settings(
		settings,
		"viewer_residency_requested_before_seed_contract"
	)
	settings = _apply_god_mode_reality_candidate_to_settings(
		settings,
		prewarming_reason
	)
	settings = MainSceneLogic._canonicalize_god_mode_reality_settings(
		settings,
		"viewer_residency_requested_after_seed_contract"
	)

	var candidate_raw: Variant = settings.get(
		"_prebirth_reality_candidate",
		{}
	)
	var candidate: Dictionary = (
		(candidate_raw as Dictionary).duplicate(true)
		if typeof(candidate_raw) == TYPE_DICTIONARY
		else {}
	)
	var seed_contract_raw: Variant = settings.get(
		"seed_contract",
		{}
	)
	var seed_contract: Dictionary = (
		(seed_contract_raw as Dictionary).duplicate(true)
		if typeof(seed_contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var world_seed: int = int(
		settings.get(
			"world_seed",
			candidate.get(
				"world_seed",
				seed_contract.get(
					"seed",
					-1
				)
			)
		)
	)

	if world_seed <= 0:
		set_meta(
			"god_mode_life_prewarm_pending",
			false
		)
		set_meta(
			"god_mode_life_prewarm_running",
			false
		)
		set_meta(
			"god_mode_life_prewarm_ready",
			false
		)
		_set_god_mode_prewarm_progress(
			0.0,
			(
				"Prewarming rejected an invalid world seed "
				+ "before residency construction began."
			),
			false
		)
		push_error(
			"GOD_MODE_PREWARMING_INVALID_WORLD_SEED|reason=%s"
			% reason
		)
		return

	candidate ["world_seed"] = world_seed
	seed_contract ["schema"] = str(
		seed_contract.get(
			"schema",
			"eralife.seed_contract"
		)
	)
	seed_contract ["version"] = maxi(
		1,
		int(
			seed_contract.get(
				"version",
				1
			)
		)
	)
	seed_contract ["seed"] = world_seed
	seed_contract ["candidate_id"] = str(
		candidate.get(
			"candidate_id",
			settings.get(
				"_prebirth_reality_candidate_id",
				""
			)
		)
	)
	seed_contract ["single_target_reality"] = true

	settings ["world_seed"] = world_seed
	settings ["seed_contract"] = seed_contract.duplicate(true)
	settings ["_prebirth_reality_candidate"] = (
		candidate.duplicate(true)
	)
	settings ["_prebirth_reality_candidate_id"] = str(
		candidate.get(
			"candidate_id",
			""
		)
	)

	if gs != null:
		if typeof(
			gs.custom_settings
		) != TYPE_DICTIONARY:
			gs.custom_settings = {}

		for raw_key in settings.keys():
			gs.custom_settings [raw_key] = settings [
				raw_key
			]

		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"god_mode_viewer_prewarm_requested"
		] = true
		gs.scenario_state [
			"god_mode_viewer_prewarm_reason"
		] = reason
		gs.scenario_state [
			"god_mode_viewer_prewarm_requested_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
		gs.scenario_state [
			"god_mode_ui_is_viewer_only"
		] = true
		gs.scenario_state [
			"god_mode_main_scene_authority_removed"
		] = true
		gs.scenario_state [
			"materialize_world_seed_on_initialize"
		] = false
		gs.scenario_state [
			"defer_static_world_bootstrap"
		] = true
		gs.scenario_state [
			"defer_live_runtime_watchers"
		] = true
		gs.scenario_state [
			"reality_residency_selected"
		] = true
		gs.scenario_state [
			"world_seed"
		] = world_seed
		gs.scenario_state [
			"seed_contract"
		] = seed_contract.duplicate(true)
		gs.scenario_state [
			"prewarming_transaction_reason"
		] = prewarming_reason

	set_meta(
		"god_mode_panel_contract_emitted",
		true
	)
	set_meta(
		"god_mode_panel_contract_emitted_reason",
		reason
	)
	set_meta(
		"god_mode_panel_contract_emitted_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"god_mode_prewarm_must_not_show_loading",
		true
	)
	set_meta(
		"god_mode_prewarm_visible_loading_forbidden",
		true
	)

	_suppress_prelife_loading_surfaces_for_god_mode(
		"%s_before_emit_residency_contract"
		% reason
	)

	var emit_report: Dictionary = (
		engine.emit_prewarm_contract(
			settings.duplicate(true),
			{
				"source": reason,
				"prewarming_transaction_reason": prewarming_reason,
				"world_seed": world_seed,
				"prewarm_must_not_show_loading": true,
			}
		)
	)

	if (
		god_mode_viewer != null
		and is_instance_valid(
			god_mode_viewer
		)
	):
		god_mode_viewer.bind_contract_engine(
			engine
		)

	if not bool(
		emit_report.get(
			"success",
			false
		)
	):
		_set_god_mode_prewarm_progress(
			0.0,
			str(
				emit_report.get(
					"reason",
					"Reality residency contract was rejected."
				)
			),
			false
		)
		return

	var queue_report: Dictionary = (
		_queue_god_mode_life_prewarm_from_settings(
			settings.duplicate(true),
			prewarming_reason,
			false
		)
	)

	if (
		queue_report.is_empty()
		or not bool(
			queue_report.get(
				"success",
				false
			)
		)
	):
		_set_god_mode_prewarm_progress(
			0.0,
			str(
				queue_report.get(
					"reason",
					"Resident reality could not be selected."
				)
			),
			false
		)

func _begin_renderer_present_fence(
	reason: String,
	grace_ms: int = 180
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_grace_ms: int = maxi(
		0,
		grace_ms
	)
	var generation: int = int(
		get_meta(
			"renderer_present_fence_generation",
			0
		)
	) + 1

	set_meta(
		"renderer_present_fence_generation",
		generation
	)
	set_meta(
		"renderer_present_fence_active",
		true
	)
	set_meta(
		"renderer_present_fence_reason",
		reason
	)
	set_meta(
		"renderer_present_fence_started_at_ms",
		now_ms
	)
	set_meta(
		"renderer_present_fence_grace_ms",
		clean_grace_ms
	)
	set_meta(
		"renderer_present_fence_painted_generation",
		-1
	)
	set_meta(
		"renderer_present_fence_blocks_engine_work",
		true
	)
	set_meta(
		"renderer_present_fence_blocks_projection_work",
		true
	)
	set_meta(
		"renderer_present_fence_blocks_background_tail",
		true
	)
	set_meta(
		"renderer_present_fence_ui_remains_interactive",
		true
	)
	set_meta(
		"renderer_present_fence_disables_main_scene_process",
		false
	)
	set_meta(
		"renderer_present_fence_uses_stable_signal_callable",
		true
	)




	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var runtime_guard: Dictionary = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"runtime_guard",
				{}
			)
		)

		runtime_guard [
			"renderer_present_fence_active"
		] = true
		runtime_guard [
			"renderer_present_fence_generation"
		] = generation
		runtime_guard [
			"renderer_present_fence_reason"
		] = reason
		runtime_guard [
			"ready_door_projection_quantum_forbidden"
		] = true
		runtime_guard [
			"renderer_present_fence_started_at_ms"
		] = now_ms

		gs.scenario_state [
			"runtime_guard"
		] = runtime_guard
		gs.scenario_state [
			"ready_door_projection_service_may_not_run"
		] = true
		gs.scenario_state [
			"renderer_present_fence_active"
		] = true
		gs.scenario_state [
			"renderer_present_fence_generation"
		] = generation
		gs.scenario_state [
			"renderer_present_fence_reason"
		] = reason
		gs.scenario_state [
			"renderer_present_fence_disables_renderer_process"
		] = false

	var frame_post_draw_callback: Callable = Callable(
		self,
		"_on_renderer_present_frame_post_draw"
	)
	var connection_error: int = OK



	if not RenderingServer.is_connected(
		"frame_post_draw",
		frame_post_draw_callback
	):
		connection_error = RenderingServer.connect(
			"frame_post_draw",
			frame_post_draw_callback
		)

	set_meta(
		"renderer_present_fence_render_signal_connected",
		connection_error == OK
	)
	set_meta(
		"renderer_present_fence_render_signal_error",
		connection_error
	)



	call_deferred(
		"_renderer_present_fence_scene_tree_fallback",
		generation,
		reason,
		clean_grace_ms
	)
func _on_renderer_present_frame_post_draw() -> void:
	if not bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		return

	var generation: int = int(
		get_meta(
			"renderer_present_fence_generation",
			-1
		)
	)

	if generation <= 0:
		return

	_renderer_present_fence_after_paint(
		generation,
		str(
			get_meta(
				"renderer_present_fence_reason",
				"renderer_present_fence"
			)
		),
		maxi(
			0,
			int(
				get_meta(
					"renderer_present_fence_grace_ms",
					0
				)
			)
		),
		"render_server_frame_post_draw"
	)

func _renderer_present_fence_scene_tree_fallback(
	generation: int,
	reason: String,
	grace_ms: int
) -> void:
	var tree:= get_tree()

	if tree == null:
		_renderer_present_fence_after_paint(
			generation,
			reason,
			grace_ms,
			"missing_scene_tree_fallback"
		)
		return

	await tree.process_frame
	await tree.process_frame

	_renderer_present_fence_after_paint(
		generation,
		reason,
		grace_ms,
		"scene_tree_two_frame_fallback"
	)


func _renderer_present_fence_after_paint(
	generation: int,
	reason: String,
	grace_ms: int,
	paint_source: String
) -> void:
	if generation != int(
		get_meta(
			"renderer_present_fence_generation",
			-1
		)
	):
		return

	if generation == int(
		get_meta(
			"renderer_present_fence_painted_generation",
			-1
		)
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var release_after_ms: int = (
		now_ms
		+ maxi(
			0,
			grace_ms
		)
	)

	set_meta(
		"renderer_present_fence_painted_generation",
		generation
	)
	set_meta(
		"renderer_present_fence_painted_at_ms",
		now_ms
	)
	set_meta(
		"renderer_present_fence_paint_source",
		paint_source
	)
	set_meta(
		"renderer_present_fence_release_after_ms",
		release_after_ms
	)

	call_deferred(
		"_release_renderer_present_fence_after_grace",
		generation,
		reason,
		release_after_ms,
		paint_source
	)


func _release_renderer_present_fence_after_grace(
	generation: int,
	reason: String,
	release_after_ms: int,
	paint_source: String
) -> void:
	var tree:= get_tree()

	if tree != null:
		var remaining_ms: int = maxi(
			0,
			release_after_ms
			- int(
				Time.get_ticks_msec()
			)
		)

		if remaining_ms > 0:
			await tree.create_timer(
				float(remaining_ms) / 1000.0
			).timeout

		await tree.process_frame

	if generation != int(
		get_meta(
			"renderer_present_fence_generation",
			-1
		)
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"renderer_present_fence_active",
		false
	)
	set_meta(
		"renderer_present_fence_released_at_ms",
		now_ms
	)
	set_meta(
		"renderer_present_fence_release_reason",
		reason
	)
	set_meta(
		"renderer_present_fence_release_paint_source",
		paint_source
	)
	set_meta(
		"renderer_present_fence_blocks_engine_work",
		false
	)
	set_meta(
		"renderer_present_fence_blocks_projection_work",
