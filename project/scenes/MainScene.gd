func _resident_actor_lens_candidate_ids_for_actor(
	actor: Person
) -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	if (
		gs == null
		or actor == null
		or int(actor.id) <= 0
	):
		return out

	MainSceneHelpers._resident_actor_lens_push_candidate_id(
		int(actor.id),
		out,
		seen
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		for raw_target_id in MainSceneHelpers._safe_array(
			gs.scenario_state.get(
				"resident_first_frame_relationship_target_ids",
				[]
			)
		):
			MainSceneHelpers._resident_actor_lens_push_candidate_id(
				raw_target_id,
				out,
				seen
			)

	for field_name in [
		"parents",
		"children",
		"siblings",
		"household_member_ids",
		"relationship_ids",
		"visible_relationship_ids"
	]:
		var raw_related_ids: Variant = actor.get(
			field_name
		)

		for raw_related_id in MainSceneHelpers._safe_array(
			raw_related_ids
			if raw_related_ids != null
			else []
		):
			MainSceneHelpers._resident_actor_lens_push_candidate_id(
				raw_related_id,
				out,
				seen
			)

	for scalar_field in [
		"partner_id",
		"spouse_id",
		"mother_id",
		"father_id",
		"guardian_id"
	]:
		var raw_scalar: Variant = actor.get(
			scalar_field
		)

		if raw_scalar == null:
			continue

		MainSceneHelpers._resident_actor_lens_push_candidate_id(
			raw_scalar,
			out,
			seen
		)

	return out
func _resident_actor_for_lens_candidate_id(
	actor_id: int
) -> Person:
	if (
		gs == null
		or actor_id <= 0
	):
		return null

	if (
		gs.player != null
		and int(gs.player.id) == actor_id
	):
		return gs.player

	if gs.has_method(
		"get_or_reactivate_npc_by_id"
	):
		var reactivated: Variant = gs.get_or_reactivate_npc_by_id(
			actor_id
		)

		if reactivated is Person:
			return reactivated as Person

	if gs.has_method(
		"get_npc_by_id"
	):
		var npc: Variant = gs.get_npc_by_id(
			actor_id
		)

		if npc is Person:
			return npc as Person

	return null
func _schedule_initial_observable_actor_lens_residency_service(
	delay_seconds: float = 0.1
) -> void:
	if bool(
		get_meta(
			"resident_observable_actor_lens_service_timer_active",
			false
		)
	):
		return

	set_meta(
		"resident_observable_actor_lens_service_timer_active",
		true
	)
	set_meta(
		"resident_observable_actor_lens_service_scheduled_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"resident_observable_actor_lens_service_ready_path_member",
		false
	)
	set_meta(
		"resident_observable_actor_lens_service_click_path_member",
		false
	)

	var tree: SceneTree = get_tree()

	if tree == null:
		call_deferred(
			"_service_initial_observable_actor_lens_residency"
		)
		return

	tree.create_timer(
		maxf(
			0.05,
			delay_seconds
		)
	).timeout.connect(
		Callable(
			self,
			"_service_initial_observable_actor_lens_residency"
		),
		CONNECT_ONE_SHOT
	)
func _queue_initial_observable_actor_lens_residency(
	reason: String = "resident_reality_observable_actor_lens_lane"
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var candidate_ids: Array = (
		_resident_actor_lens_candidate_ids_for_actor(
			gs.player
		)
	)

	if candidate_ids.is_empty():
		return

	var queue: Array = []
	var seen: Dictionary = {}

	for raw_id in candidate_ids:
		var actor_id: int = int(raw_id)

		if actor_id <= 0:
			continue

		if seen.has(actor_id):
			continue

		seen [actor_id] = true
		queue.append(actor_id)

	set_meta(
		"resident_observable_actor_lens_queue",
		queue.duplicate(false)
	)
	set_meta(
		"resident_observable_actor_lens_queue_reason",
		reason
	)
	set_meta(
		"resident_observable_actor_lens_queue_started_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"resident_observable_actor_lens_ready_gate_member",
		false
	)
	set_meta(
		"resident_observable_actor_lens_blocks_ready",
		false
	)
	set_meta(
		"resident_observable_actor_lens_click_path_work",
		false
	)
	set_meta(
		"resident_observable_actor_lens_queue_is_descriptor_only",
		true
	)
	set_meta(
		"resident_observable_actor_lens_queue_does_not_build_renderers",
		true
	)
	set_meta(
		"resident_observable_actor_lens_queue_does_not_service_immediately",
		true
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"resident_observable_actor_lens_queue"
	] = queue.duplicate(false)
	gs.scenario_state [
		"resident_observable_actor_lens_queue_reason"
	] = reason
	gs.scenario_state [
		"resident_observable_actor_lens_ready_gate_member"
	] = false
	gs.scenario_state [
		"resident_observable_actor_lens_blocks_ready"
	] = false
	gs.scenario_state [
		"resident_observable_actor_lens_click_path_work"
	] = false
	gs.scenario_state [
		"resident_observable_actor_lens_queue_is_descriptor_only"
	] = true
	gs.scenario_state [
		"resident_observable_actor_lens_queue_does_not_build_renderers"
	] = true
	gs.scenario_state [
		"resident_observable_actor_lens_queue_does_not_service_immediately"
	] = true

	_schedule_initial_observable_actor_lens_residency_service(
		0.12
	)
func _resident_observable_actor_lens_service_may_run_now() -> bool:
	if (
		gs == null
		or gs.player == null
	):
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	if bool(
		gs.scenario_state.get(
			"ready_door_first_paint_pending",
			false
		)
	):
		return false

	if bool(
		gs.scenario_state.get(
			"ready_visual_reveal_pending",
			false
		)
	):
		return false

	if bool(
		gs.scenario_state.get(
			"ready_visual_reveal_in_progress",
			false
		)
	):
		return false

	if (
		bool(
			gs.scenario_state.get(
				"resident_runtime_binding_active",
				false
			)
		)
		and not bool(
			gs.scenario_state.get(
				"resident_runtime_binding_complete",
				false
			)
		)
	):
		return false

	if bool(
		get_meta(
			"ready_button_door_drop_active",
			false
		)
	):
		return false

	if bool(
		get_meta(
			"ready_visual_reveal_active",
			false
		)
	):
		return false

	return true
func _service_initial_observable_actor_lens_residency() -> void:
	set_meta(
		"resident_observable_actor_lens_service_timer_active",
		false
	)

	if (
		gs == null
		or gs.player == null
	):
		return

	if not _resident_observable_actor_lens_service_may_run_now():
		set_meta(
			"resident_observable_actor_lens_service_paused_for_ready_or_first_paint",
			true
		)
		set_meta(
			"resident_observable_actor_lens_service_paused_at_ms",
			int(Time.get_ticks_msec())
		)

		_schedule_initial_observable_actor_lens_residency_service(
			0.18
		)
		return

	var queue_raw: Variant = get_meta(
		"resident_observable_actor_lens_queue",
		[]
	)
	var queue: Array = (
		queue_raw.duplicate(false)
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)

	if queue.is_empty():
		set_meta(
			"resident_observable_actor_lens_queue_complete",
			true
		)
		set_meta(
			"resident_observable_actor_lens_queue_completed_at_ms",
			int(Time.get_ticks_msec())
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"resident_observable_actor_lens_queue_complete"
			] = true
			gs.scenario_state [
				"resident_observable_actor_lens_queue_completed_at_ms"
			] = int(Time.get_ticks_msec())

		return

	var actor_id: int = int(
		queue.pop_front()
	)

	set_meta(
		"resident_observable_actor_lens_queue",
		queue.duplicate(false)
	)

	if actor_id > 0:
		var intent_report: Dictionary = _express_global_ui_intent(
			{
				"actor_id": int(gs.player.id),
				"target_id": actor_id,
				"intent_type": "relationships_hub_resident_actor_lens_queue_intent",
				"surface_id": "resident_actor_lens_background_lane",
				"action_id": "queue_switch_shell_stage",
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"skip_checks_and_balances": true,
				"authority_prevalidated": true,
				"payload": {
					"action_id": "queue_switch_shell_stage",
					"target_id": actor_id,
					"source": "mainscene.initial_observable_actor_lens_residency",
					"background_only": true,
					"ready_gate_member": false,
					"visible_click_work_forbidden": true,
					"ui_is_renderer_only": true
				},
				"target": {
					"route_kind": "engine_method",
					"engine_property": "relationships_hub_contract_engine",
					"method": "resolve_intent",
					"pass_actor_payload": true,
					"actor_id": int(gs.player.id)
				},
				"source": "mainscene.initial_observable_actor_lens_residency"
			},
			{
				"actor_id": int(gs.player.id),
				"target_id": actor_id,
				"surface_id": "resident_actor_lens_background_lane",
				"action_id": "queue_switch_shell_stage",
				"source": "mainscene.initial_observable_actor_lens_residency",
				"ready_gate_member": false,
				"visible_click_work_forbidden": true
			}
		)

		set_meta(
			"resident_observable_actor_lens_last_actor_id",
			actor_id
		)
		set_meta(
			"resident_observable_actor_lens_last_serviced_at_ms",
			int(Time.get_ticks_msec())
		)
		set_meta(
			"resident_observable_actor_lens_last_route_success",
			bool(
				_contract_route_result(intent_report).get(
					"success",
					false
				)
			)
		)
		set_meta(
			"resident_observable_actor_lens_service_built_renderer_deck",
			false
		)
		set_meta(
			"resident_observable_actor_lens_service_called_profile_prewarm",
			false
		)

	if not queue.is_empty():
		_schedule_initial_observable_actor_lens_residency_service(
			0.06
		)
func _relationship_profile_prewarmed_playable_life_shell_for_actor(actor: Person) -> Dictionary:
	if actor == null:
		return {}

	var store: Dictionary = MainSceneLogic._relationship_profile_zero_frame_shell_store(gs)
	var raw_shell: Variant = store.get(str(int(actor.id)), {})
	if typeof(raw_shell) != TYPE_DICTIONARY:
		return {}

	var shell: Dictionary = raw_shell as Dictionary
	if shell.is_empty():
		return {}

	if int(shell.get("actor_id", -1)) != int(actor.id):
		return {}

	var current_lens_key: String = _world_seed_ui_lens_key()
	var shell_lens_key: String = str(shell.get("world_seed_ui_lens_key", "")).strip_edges()

	if shell_lens_key == "" or shell_lens_key != current_lens_key:
		store.erase(str(int(actor.id)))
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["relationship_profile_zero_frame_life_shell_by_actor"] = store
			gs.scenario_state ["relationship_profile_shell_rejected_stale_world_lens"] = true
			gs.scenario_state ["relationship_profile_shell_rejected_actor_id"] = int(actor.id)
			gs.scenario_state ["relationship_profile_shell_rejected_lens_key"] = shell_lens_key
			gs.scenario_state ["relationship_profile_shell_current_lens_key"] = current_lens_key
		return {}

	if int(shell.get("world_year", int(gs.year) if gs != null else -999999)) != int(gs.year):
		store.erase(str(int(actor.id)))
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["relationship_profile_shell_rejected_stale_year"] = true
			gs.scenario_state ["relationship_profile_shell_rejected_actor_id"] = int(actor.id)
		return {}

	set_meta("relationship_profile_shell_lookup_returned_hot_reference", true)
	set_meta("relationship_profile_shell_lookup_actor_id", int(actor.id))
	set_meta("relationship_profile_shell_lookup_world_lens_key", current_lens_key)
	set_meta("relationship_profile_shell_lookup_at_ms", int(Time.get_ticks_msec()))

	return shell

func _ensure_playable_life_viewer() -> PlayableLifeViewer:
	if playable_life_viewer == null:
		playable_life_viewer = PlayableLifeViewer.new()
	return playable_life_viewer
func _relationship_profile_platform_renderer_shell_is_hot(hud_truth: Dictionary = {}) -> bool:
	if output_label == null or not is_instance_valid(output_label):
		return false
	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		return false
	if player_stats_root == null or not is_instance_valid(player_stats_root):
		return false

	if ui_nav_buttons.is_empty():
		return false

	var required_nav_keys: Array [String] = [
		"world",
		"life",
		"school",
		"activities",
		"relationships",
		"career",
		"age_up"
	]

	for key in required_nav_keys:
		var nav_button: Button = ui_nav_buttons.get(key, null) as Button
		if nav_button == null or not is_instance_valid(nav_button):
			return false

	if not _relationship_profile_runtime_hud_shells_ready_for_truth(hud_truth):
		return false

	return true
func _relationship_profile_playable_life_shell_is_hot(actor: Person) -> bool:
	if actor == null:
		return false

	var shell: Dictionary = _relationship_profile_prewarmed_playable_life_shell_for_actor(actor)
	if shell.is_empty():
		return false
	if not bool(shell.get("playable_life_shell_ready", false)):
		return false
	if not bool(shell.get("playable_life_viewer_ready", false)):
		return false
	if not bool(shell.get("platform_renderer_shell_ready", false)):
		return false

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(shell.get("surface_contract", {}))
	if surface.is_empty():
		return false
	if int(surface.get("actor_id", -1)) != int(actor.id):
		return false

	var viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(shell.get("playable_life_viewer_render_packet", shell.get("viewer_render_packet", {})))
	if viewer_packet.is_empty():
		return false
	if int(viewer_packet.get("actor_id", -1)) != int(actor.id):
		return false

	var render_policy: Dictionary = MainSceneHelpers._safe_dictionary(viewer_packet.get("render_policy", {}))
	if bool(render_policy.get("viewer_waits", true)):
		return false
	if bool(render_policy.get("viewer_calls_simulation", true)):
		return false
	if bool(render_policy.get("viewer_mutates_simulation_state", true)):
		return false
	if bool(render_policy.get("viewer_fetches_data", true)):
		return false
	if bool(render_policy.get("viewer_rebuilds_layout", true)):
		return false
	if not bool(render_policy.get("render_immediately", false)):
		return false
	if not bool(render_policy.get("press_only_commits_pointer", false)):
		return false

	var hud_packet: Dictionary = MainSceneHelpers._safe_dictionary(viewer_packet.get("hud_packet", {}))
	var hud_truth: Dictionary = MainSceneHelpers._safe_dictionary(hud_packet.get("hud_truth", surface.get("hud_truth", {})))
	if not _relationship_profile_platform_renderer_shell_is_hot(hud_truth):
		return false

	return true

func _relationship_profile_stage_playable_life_shell_for_actor(actor: Person, surface_contract: Dictionary, switch_text: String = "", reason: String = "relationship_profile_shell_stage") -> Dictionary:
	if gs == null or actor == null:
		return {}

	var actor_id: int = int(actor.id)
	if actor_id <= 0:
		return {}

	var surface: Dictionary = surface_contract.duplicate(true)
	if surface.is_empty():
		return {}

	var actor_name: String = MainSceneHelpers._person_display_name_for_identity_switch(actor)
	var clean_switch_text: String = str(switch_text).strip_edges()
	var life_lines: Array = _relationship_profile_life_diary_lines_for_shell(actor, clean_switch_text)
	var life_entries: Array = _relationship_profile_life_diary_entries_for_shell(actor, life_lines)
	var surface_context: Dictionary = _relationship_profile_fast_player_stat_surface_context(actor)
	var hud_truth: Dictionary = MainSceneHelpers._safe_dictionary(surface.get("hud_truth", {}))

	_bind_ui_nav_buttons()

	var hud_shell_ready: bool = _relationship_profile_runtime_hud_shells_ready_for_truth(hud_truth)
	if not hud_truth.is_empty() and not hud_shell_ready:
		_relationship_profile_prewarm_runtime_hud_shells_for_truth(hud_truth.duplicate(true), reason)
		hud_shell_ready = _relationship_profile_runtime_hud_shells_ready_for_truth(hud_truth)

	var platform_shell_ready: bool = _relationship_profile_platform_renderer_shell_is_hot(hud_truth)

	var signature: String = "relationship_profile_zero_frame_shell:%d:%d:%d" % [
		actor_id,
		int(gs.year),
		int(actor.age)
	]
	var world_lens_key: String = _world_seed_ui_lens_key()
	surface ["actor_id"] = actor_id
	surface ["actor_name"] = actor_name
	surface ["current_panel"] = "life"
	surface ["player_id"] = actor_id
	surface ["player_stats_surface_context"] = surface_context.duplicate(true)
	surface ["surface_context"] = surface_context.duplicate(true)
	surface ["life_diary_lines"] = life_lines.duplicate(true)
	surface ["life_diary_entries"] = life_entries.duplicate(true)
	surface ["life_diary_signature"] = signature
	surface ["prewarmed_playable_life_shell"] = true
	surface ["runtime_hud_shell_prewarmed"] = hud_shell_ready
	surface ["switch_press_must_not_build_surface"] = true
