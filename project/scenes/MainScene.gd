func _prepaint_crown_war_ally_picker(
	payload: Dictionary
) -> void:
	if (
		crown_action_popup_options == null
		or payload.is_empty()
	):
		return

	var war_id: String = str(
		payload.get(
			"war_id",
			""
		)
	).strip_edges()
	if (
		war_id == ""
		or crown_war_ally_picker_deck_by_war_id.has(
			war_id
		)
	):
		return

	var allies_raw: Variant = payload.get(
		"ally_candidates",
		[]
	)
	if typeof(allies_raw) != TYPE_ARRAY:
		return

	var deck:= VBoxContainer.new()
	deck.name = (
		"WarAllyPicker_%s"
		% war_id
	)
	deck.visible = false
	deck.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	deck.add_theme_constant_override(
		"separation",
		8
	)
	crown_action_popup_options.add_child(
		deck
	)

	for raw_ally in allies_raw as Array:
		if typeof(raw_ally) != TYPE_DICTIONARY:
			continue

		var ally: Dictionary = raw_ally as Dictionary
		var ally_realm_id: int = int(
			ally.get(
				"realm_id",
				-1
			)
		)
		if ally_realm_id <= 0:
			continue

		var button:= Button.new()
		button.text = "%s • %s (%+d)" % [
			str(
				ally.get(
					"name",
					"Ally"
				)
			),
			str(
				ally.get(
					"relation_tier",
					"Ally"
				)
			),
			int(
				ally.get(
					"relation_score",
					0
				)
			)
		]
		button.custom_minimum_size = Vector2(
			0,
			42
		)
		button.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		button.pressed.connect(
			Callable(
				self,
				"_queue_crown_war_intent_from_renderer"
			).bind(
				"set_war_strategy",
				{
					"war_id": war_id,
					"intent": "call_for_aid",
					"ally_realm_id": ally_realm_id
				}
			)
		)
		deck.add_child(
			button
		)

	crown_war_ally_picker_deck_by_war_id [
		war_id
	] = deck

	set_meta(
		"crown_war_ally_picker_prepainted_%s"
		% war_id,
		true
	)
