func _continue_playable_life_shell_chrome_microstage(snapshot: Dictionary, reason: String, stage_index: int = 0) -> void:
	if gs == null or gs.player == null:
		return

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(snapshot)
	if surface.is_empty():
		return

	if str(get_meta("god_mode_zero_frame_entry_staged_snapshot", {})) == "":
		set_meta("god_mode_zero_frame_entry_staged_snapshot", surface.duplicate(true))

	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("playable_life_shell_microstage_active", true)
	set_meta("playable_life_shell_microstage_index", stage_index)
	set_meta("playable_life_shell_microstage_reason", reason)
	set_meta("playable_life_shell_microstage_at_ms", now_ms)
	set_meta("playable_life_shell_microstage_may_not_deadlock_ready_door", true)

	match stage_index:
		0:
			_lock_first_frame_ui_snapshot(surface.duplicate(true), "%s_microstage_snapshot" % reason)

		1:
			var root:= get_node_or_null("UIContainer") as Control
			if root != null and is_instance_valid(root):
				root.visible = true
				root.mouse_filter = Control.MOUSE_FILTER_PASS
				root.process_mode = Node.PROCESS_MODE_INHERIT
				root.z_as_relative = false
				root.z_index = 10

		2:
			current_panel = "life"
			if output_label != null and is_instance_valid(output_label):
				output_label.visible = true
				output_label.scroll_active = true
				output_label.bbcode_enabled = true
				output_label.mouse_filter = Control.MOUSE_FILTER_IGNORE

				if str(output_label.text).strip_edges() == "":
					_paint_spawn_ready_life_diary_surface("%s_microstage_life_diary" % reason)

		3:
			_ensure_player_stats_overlay()
			if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
				player_stats_overlay.visible = true
				player_stats_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
				player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
				player_stats_overlay.z_as_relative = false
				player_stats_overlay.z_index = 30

		4:
			_arm_main_tab_input_contract_for_playable_shell("%s_microstage_main_tab_input_contract" % reason)
			_apply_centered_live_layout()

		5:
			_refresh_era_background_fill()
			_ensure_era_border_overlay()
			_show_era_border_overlay_for_current_era(false)
			_layout_era_border_overlay()

			if era_border_overlay != null and is_instance_valid(era_border_overlay):
				era_border_overlay.visible = true
				era_border_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
				era_border_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
				era_border_overlay.z_as_relative = false
				era_border_overlay.z_index = 900

		6:
			_preseal_spawn_ready_runtime_hud_shell_from_snapshot("%s_microstage_hud_preseal" % reason)
			_reveal_spawn_ready_runtime_hud_buttons_if_existing("%s_microstage_hud_reveal" % reason)
			_paint_pending_situations_button_from_zero_frame_truth(surface.duplicate(true), "%s_microstage_pending_button" % reason)
			_sync_runtime_floating_hud_layering()

		7:
			_prewarm_native_main_tab_shell(
				"life",
				"%s_microstage_life_shell"
				% reason
			)

		8:
			_prewarm_native_main_tab_shell(
				"world",
				"%s_microstage_world_shell"
				% reason
			)

			_prestyle_world_tab_surface_for_current_era(
				"%s_microstage_world_shell"
				% reason
			)

		9:
			_prewarm_native_main_tab_shell(
				"activities",
				"%s_microstage_activities_shell"
				% reason
			)

		10:
			_prewarm_native_main_tab_shell(
				"career",
				"%s_microstage_career_shell"
				% reason
			)

		11:
			_prewarm_native_main_tab_shell(
				"school",
				"%s_microstage_school_shell"
				% reason
			)

		12:
			_prewarm_native_main_tab_shell(
				"relationships",
				"%s_microstage_relationships_shell"
				% reason
			)

		13:
			_prewarm_native_main_tab_shell(
				"mods",
				"%s_microstage_mods_shell"
				% reason
			)

		14:
			set_meta(
				"global_prewarm_contract_gate_required_before_ready",
				true
			)
			set_meta(
				"global_prewarm_contract_gate_started_at_ms",
				now_ms
			)
			set_meta(
				"global_prewarm_contract_gate_reason",
				reason
			)
