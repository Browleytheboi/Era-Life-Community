func _arm_life_diary_focus_latest_year_process_frame() -> void:
	if not bool(
		get_meta(
			"life_diary_focus_latest_year_pending",
			false
		)
	):
		return

	var tree:= get_tree()

	if tree == null:
		_scroll_life_diary_to_bottom()
		set_meta(
			"life_diary_focus_latest_year_pending",
			false
		)
		set_meta(
			"life_diary_focus_latest_year_attempts",
			0
		)
		return

	var callback:= Callable(
		self,
		"_settle_life_diary_focus_latest_year"
	)

	if tree.process_frame.is_connected(
		callback
	):
		return

	tree.process_frame.connect(
		callback,
		CONNECT_ONE_SHOT
	)
func _on_age_up_loading_exit_finished() -> void:
	_age_up_truth_probe_mark("exit_finished_enter", {
		"runtime_active": age_up_loading_runtime_active,
		"transition_busy": bool(get_meta("age_up_transition_busy", false))
	})

	var pending_deferred: int = -1
	if gs != null and gs.event_bus != null and gs.event_bus.has_method("get_pending_deferred_delivery_count"):
		pending_deferred = int(gs.event_bus.get_pending_deferred_delivery_count())

	var loading_complete: bool = false
	var year_in_progress: bool = false
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		year_in_progress = bool(gs.scenario_state.get("year_in_progress", false))
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
		loading_complete = (
			str(loading.get("completion_state", "")).strip_edges() == "complete"
			and bool(loading.get("is_complete", false))
			and str(loading.get("current_phase", "")).strip_edges() == "complete"
		)

	var visible_handoff_built: bool = bool(get_meta("age_up_loading_safe_handoff_built", false))
	var ui_first_released: bool = bool(get_meta("age_up_loading_ui_first_released", false))
	var may_release_with_deferred_tail: bool = loading_complete and not year_in_progress and (visible_handoff_built or ui_first_released)

	if age_up_loading_runtime_active and not _age_up_loading_runtime_ready_to_release():
		if may_release_with_deferred_tail:
			_age_up_truth_probe_mark("exit_finished_release_with_deferred_tail", {
				"pending_deferred": pending_deferred,
				"safe_handoff_built": visible_handoff_built,
				"ui_first_released": ui_first_released
			})
		else:
			_age_up_truth_probe_mark("exit_finished_delayed_runtime_still_busy", {
				"year_in_progress": year_in_progress,
				"pending_deferred": pending_deferred,
				"safe_handoff_built": visible_handoff_built,
				"ui_first_released": ui_first_released
			})

			age_up_loading_exit_tween = null




			if loading_complete and not age_up_loading_finish_requested:
				age_up_loading_finish_requested = true

			age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 2)

			if age_up_loading_overlay != null:
				age_up_loading_overlay.visible = true
				age_up_loading_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)

			return

	if not age_up_loading_runtime_active and not bool(get_meta("age_up_transition_busy", false)):
		_age_up_truth_probe_finish("exit_finished_return_not_active")
		call_deferred("_run_post_loading_idle_refresh")
		call_deferred("_update_player_stats_overlay")
		return

	var should_finalize_post_loading: bool = bool(get_meta("age_up_post_loading_finalize_pending", false))

	_hide_age_up_loading_overlay()

	age_up_loading_runtime_active = false
	age_up_loading_finish_requested = false
	age_up_loading_exit_tween = null

	set_meta("age_up_transition_busy", false)

	var zero_frame_post_overlay_raw: Variant = get_meta("age_up_zero_frame_post_overlay_result", {})
	var zero_frame_post_overlay_result: Dictionary = zero_frame_post_overlay_raw if typeof(zero_frame_post_overlay_raw) == TYPE_DICTIONARY else {}
	if not zero_frame_post_overlay_result.is_empty():
		set_meta("age_up_zero_frame_post_overlay_result", {})
		call_deferred("_show_age_up_output", zero_frame_post_overlay_result.duplicate(true), false, "zero_frame_post_overlay")

	call_deferred("_force_age_up_life_diary_surface_after_handoff", "age_up_loading_exit_finished")
	call_deferred("_update_player_stats_overlay")
	call_deferred("_try_surface_controlled_death_after_age_up", "age_up_loading_exit_finished")

	var now_ms: int = int(Time.get_ticks_msec())
	var restore_hold_frames: int = 6 if should_finalize_post_loading else 4
	var restore_hold_ms: int = 180 if should_finalize_post_loading else 120

	set_meta("live_diagnostics_post_overlay_restore_frames", restore_hold_frames)
	set_meta("live_diagnostics_post_overlay_restore_until_ms", now_ms + restore_hold_ms)
	set_meta(
		"live_diagnostics_hidden_refresh_next_ms",
		max(int(get_meta("live_diagnostics_hidden_refresh_next_ms", 0)), now_ms + 1500)
	)
	set_meta(
		"ui_idle_bus_flush_next_ms",
		max(int(get_meta("ui_idle_bus_flush_next_ms", 0)), now_ms + 140)
	)

	var rewind_next_step_ms: int = int(get_meta("post_age_up_rewind_snapshot_next_step_ms", 0))
	if rewind_next_step_ms > 0:
		set_meta(
			"post_age_up_rewind_snapshot_next_step_ms",
			max(rewind_next_step_ms, now_ms + 900)
		)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_deferred_flush_pending"] = true
		gs.scenario_state ["age_up_deferred_flush_next_ms"] = 0

	if should_finalize_post_loading:
		set_meta("age_up_post_loading_finalize_pending", false)
		if has_method("_finalize_post_age_up_loading_handoff"):
			call_deferred("_finalize_post_age_up_loading_handoff")
		else:
			_age_up_truth_probe_mark("missing_finalize_post_loading_handoff_fallback")
			call_deferred("_run_post_loading_idle_refresh")
	else:
		set_meta("age_up_loading_safe_handoff_queued", false)
		set_meta("age_up_loading_safe_handoff_built", false)
		call_deferred("_run_post_loading_idle_refresh")

	_age_up_truth_probe_finish("exit_finished_complete")
func _finalize_post_age_up_loading_handoff() -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var finalize_started_ms: int = int(get_meta("age_up_post_loading_finalize_started_ms", 0))

	if finalize_started_ms <= 0:
		finalize_started_ms = now_ms
		set_meta("age_up_post_loading_finalize_started_ms", finalize_started_ms)

	var finalize_attempts: int = int(get_meta("age_up_post_loading_finalize_attempts", 0)) + 1
	set_meta("age_up_post_loading_finalize_attempts", finalize_attempts)

	var still_busy: bool = age_up_loading_runtime_active or bool(get_meta("age_up_transition_busy", false))
	var finalize_elapsed_ms: int = max(0, now_ms - finalize_started_ms)

	if still_busy and finalize_attempts < 8 and finalize_elapsed_ms < 600:
		_age_up_truth_probe_mark("finalize_post_loading_handoff_wait", {
			"attempts": finalize_attempts,
			"elapsed_ms": finalize_elapsed_ms,
			"runtime_active": age_up_loading_runtime_active,
			"transition_busy": bool(get_meta("age_up_transition_busy", false))
		})
		call_deferred("_finalize_post_age_up_loading_handoff")
		return

	if still_busy:
		_age_up_truth_probe_mark("finalize_post_loading_handoff_force_release", {
			"attempts": finalize_attempts,
			"elapsed_ms": finalize_elapsed_ms,
			"runtime_active": age_up_loading_runtime_active,
			"transition_busy": bool(get_meta("age_up_transition_busy", false))
		})
		age_up_loading_runtime_active = false
		set_meta("age_up_transition_busy", false)

	_age_up_truth_probe_mark("finalize_post_loading_handoff_enter", {
		"safe_handoff_queued": bool(get_meta("age_up_loading_safe_handoff_queued", false)),
		"safe_handoff_built": bool(get_meta("age_up_loading_safe_handoff_built", false))
	})

	set_meta("age_up_post_loading_finalize_started_ms", 0)
	set_meta("age_up_post_loading_finalize_attempts", 0)
	set_meta("age_up_loading_safe_handoff_queued", false)
	set_meta("age_up_loading_safe_handoff_built", false)
	set_meta("age_up_loading_safe_handoff_rekick_requested", false)
	set_meta("age_up_loading_output_pipeline", {})

	var settle_until_ms: int = now_ms + 1200
	set_meta("age_up_post_live_tail_settle_until_ms", settle_until_ms)
	set_meta("age_up_post_live_tail_refresh_stage", 0)
	set_meta("age_up_post_live_tail_refresh_next_ms", now_ms + 72)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 1200)
	set_meta("ui_idle_bus_flush_next_ms", max(int(get_meta("ui_idle_bus_flush_next_ms", 0)), now_ms + 360))
	set_meta("post_age_up_rewind_snapshot_next_step_ms", max(int(get_meta("post_age_up_rewind_snapshot_next_step_ms", 0)), now_ms + 1500))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var existing_guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var existing_guard: Dictionary = existing_guard_raw if typeof(existing_guard_raw) == TYPE_DICTIONARY else {}

		existing_guard ["post_age_up_tail_settle_active"] = true
		existing_guard ["post_age_up_tail_settle_until_ms"] = settle_until_ms
		existing_guard ["post_age_up_tail_flush_budget"] = min(int(existing_guard.get("post_age_up_tail_flush_budget", 1)), 1)
		existing_guard ["post_age_up_tail_flush_interval_ms"] = max(int(existing_guard.get("post_age_up_tail_flush_interval_ms", 160)), 160)
		existing_guard ["post_age_up_tail_ui_stage_budget"] = min(int(existing_guard.get("post_age_up_tail_ui_stage_budget", 1)), 1)
		existing_guard ["post_age_up_tail_rewind_delay_ms"] = max(int(existing_guard.get("post_age_up_tail_rewind_delay_ms", 1200)), 1200)
		existing_guard ["post_age_up_tail_speculative_delay_ms"] = max(int(existing_guard.get("post_age_up_tail_speculative_delay_ms", 1800)), 1800)
		existing_guard ["ui_tail_work_yield_to_input"] = true
		existing_guard ["fallback_cached_ui"] = true
		existing_guard ["defer_refresh_once"] = true
		existing_guard ["control_release_priority"] = "ui_first"
		existing_guard ["last_action"] = "post_age_up_live_tail_settle"
		existing_guard ["last_action_ms"] = now_ms

		gs.scenario_state ["runtime_guard"] = existing_guard
		gs.scenario_state ["age_up_truth_probe_disable_auto_patcher"] = false
		gs.scenario_state ["age_up_truth_probe_disable_live_patch_guard"] = false
		gs.scenario_state ["age_up_deferred_flush_pending"] = true
		gs.scenario_state ["age_up_deferred_flush_next_ms"] = now_ms + 220
		gs.scenario_state ["age_up_post_live_tail_settle_until_ms"] = settle_until_ms

		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
		if not loading.is_empty():
			loading ["completion_state"] = "complete"
			loading ["is_complete"] = true
			loading ["current_phase"] = "complete"
			loading ["session_stage"] = "complete"
			loading ["subline"] = ""
			loading ["post_age_up_tail_settle_until_ms"] = settle_until_ms
			gs.scenario_state ["loading_runtime"] = loading

	set_meta("age_up_truth_probe_disable_live_diagnostics", false)
	set_meta("age_up_truth_probe_disable_live_diagnostics_until_ms", 0)
	set_meta("live_diagnostics_manual_throttle_enabled", true)
	set_meta("live_diagnostics_post_overlay_restore_frames", 8)
	set_meta("live_diagnostics_post_overlay_restore_until_ms", now_ms + 900)

	_global_runtime_kill_relock_after_player_action("finalize_post_age_up_loading_handoff")
	call_deferred("_run_post_loading_idle_refresh")
func _post_age_up_surface_blocking_live_tail() -> bool:
	var now_ms: int = int(Time.get_ticks_msec())
	if _runtime_interactive_surface_busy(now_ms):
		return true

	return (
		relationships_browser_open
		or relationship_profile_popup_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or activities_action_open
		or panel_content_transition_active
		or (profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible)
	)

func _run_post_loading_idle_refresh() -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if age_up_loading_runtime_active or bool(get_meta("age_up_transition_busy", false)):
		var restore_attempts: int = int(get_meta("age_up_post_loading_idle_refresh_attempts", 0)) + 1
		set_meta("age_up_post_loading_idle_refresh_attempts", restore_attempts)

		if restore_attempts < 12:
			call_deferred("_run_post_loading_idle_refresh")
			return

		_age_up_truth_probe_mark("post_loading_idle_refresh_force_unbusy", {
			"attempts": restore_attempts,
			"runtime_active": age_up_loading_runtime_active,
			"transition_busy": bool(get_meta("age_up_transition_busy", false))
		})

		age_up_loading_runtime_active = false
		set_meta("age_up_transition_busy", false)

	set_meta("age_up_post_loading_idle_refresh_attempts", 0)

	var loading_safe_handoff_queued: bool = bool(get_meta("age_up_loading_safe_handoff_queued", false))
	var loading_safe_handoff_built: bool = bool(get_meta("age_up_loading_safe_handoff_built", false))

	if loading_safe_handoff_queued and not loading_safe_handoff_built:
		var handoff_wait_started_ms: int = int(get_meta("age_up_post_loading_handoff_wait_started_ms", 0))
		if handoff_wait_started_ms <= 0:
			handoff_wait_started_ms = now_ms
			set_meta("age_up_post_loading_handoff_wait_started_ms", handoff_wait_started_ms)

		var handoff_wait_elapsed_ms: int = max(0, now_ms - handoff_wait_started_ms)
		var handoff_wait_attempts: int = int(get_meta("age_up_post_loading_handoff_wait_attempts", 0)) + 1
		set_meta("age_up_post_loading_handoff_wait_attempts", handoff_wait_attempts)

		if handoff_wait_elapsed_ms < 500 and handoff_wait_attempts < 8:
			call_deferred("_run_post_loading_idle_refresh")
			return

		_age_up_truth_probe_mark("post_loading_idle_refresh_force_clear_handoff", {
			"elapsed_ms": handoff_wait_elapsed_ms,
			"attempts": handoff_wait_attempts
		})

		set_meta("age_up_loading_safe_handoff_queued", false)
		set_meta("age_up_loading_safe_handoff_built", true)
		set_meta("age_up_post_loading_handoff_wait_started_ms", 0)
		set_meta("age_up_post_loading_handoff_wait_attempts", 0)

	var blocking_surface_open: bool = _post_age_up_surface_blocking_live_tail()

	if output_label != null and current_panel == "" and not blocking_surface_open:
		output_label.visible = true

	if player_stats_overlay != null and not blocking_surface_open:
		player_stats_overlay.visible = true

	if bending_hud_button != null and not blocking_surface_open:
		bending_hud_button.visible = true

	set_meta("age_up_post_live_tail_refresh_stage", 0)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_truth_probe_disable_auto_patcher"] = false
		gs.scenario_state ["age_up_truth_probe_disable_live_patch_guard"] = false

		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}

		var settle_until_ms: int = max(
			int(guard.get("post_age_up_tail_settle_until_ms", 0)),
			int(get_meta("age_up_post_live_tail_settle_until_ms", 0))
		)

		if settle_until_ms <= now_ms:
			settle_until_ms = now_ms + 700

		guard ["post_age_up_tail_settle_active"] = true
		guard ["post_age_up_tail_settle_until_ms"] = settle_until_ms
		guard ["fallback_cached_ui"] = true
		guard ["defer_refresh_once"] = true
		guard ["control_release_priority"] = "ui_first"
		guard ["ui_tail_work_yield_to_input"] = true

		gs.scenario_state ["runtime_guard"] = guard
		gs.scenario_state ["age_up_deferred_flush_pending"] = true

		if int(gs.scenario_state.get("age_up_deferred_flush_next_ms", 0)) <= now_ms:
			gs.scenario_state ["age_up_deferred_flush_next_ms"] = now_ms + 220

	_force_age_up_life_diary_surface_after_handoff("post_loading_idle_refresh")
	_try_surface_controlled_death_after_age_up("post_loading_idle_refresh")

	_age_up_truth_probe_mark("post_loading_idle_refresh_staged", {
		"blocking_surface_open": blocking_surface_open,
		"settle_until_ms": int(get_meta("age_up_post_live_tail_settle_until_ms", 0))
	})

	_schedule_post_loading_idle_refresh_stage(24)

	_schedule_post_loading_idle_refresh_stage(24)
func _mark_ui_interaction_activity(
		reason: String = "input",
		grace_ms: int = 180
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_reason: String = str(
		reason
	).strip_edges().to_lower()
	var pointer_only: bool = clean_reason in [
		"mouse_motion_probe",
