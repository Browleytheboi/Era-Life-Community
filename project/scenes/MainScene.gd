	lines.append("Military: %s" % _crown_compact_number(float(realm.get("military_stockpile", realm.get("military_units", 0)))))
	lines.append("Goods: %s" % _crown_compact_number(float(realm.get("goods_stockpile", 0))))
	lines.append("")
	lines.append("Civic Pressure")
