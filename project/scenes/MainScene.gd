			"pet_shop_background_prewarm_actor_id",
			actor_id
		)
		set_meta(
			"pet_shop_background_prewarm_click_repair_scheduled",
			false
		)
		return

	var renderer_hot: bool = (
		_render_pet_shop_surface_contract(
			contract,
			actor_id,
			true
		)
	)

	if not renderer_hot:
		set_meta(
			"pet_shop_background_prewarm_renderer_failed",
			true
		)
		set_meta(
			"pet_shop_background_prewarm_actor_id",
			actor_id
		)
		set_meta(
			"pet_shop_background_prewarm_click_repair_scheduled",
			false
		)
		return


	if not pet_shop_open:
		pet_shop_panel.visible = false
		pet_shop_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	set_meta(
		"pet_shop_background_prewarm_renderer_failed",
		false
	)
	set_meta(
		"pet_shop_background_prewarm_complete",
		true
	)
	set_meta(
		"pet_shop_background_prewarm_actor_id",
		actor_id
	)
	set_meta(
		"pet_shop_background_prewarm_listing_count",
		int(
			pet_shop_panel.get_meta(
				"resident_listing_count",
				0
			)
		)
	)
	set_meta(
		"pet_shop_background_prewarm_multi_grid",
		bool(
			pet_shop_panel.get_meta(
				"multi_grid_renderer",
				false
			)
		)
	)
	set_meta(
		"pet_shop_background_prewarm_ready_gate_member",
		false
	)
	set_meta(
		"pet_shop_background_prewarm_build_on_click",
		false
	)
