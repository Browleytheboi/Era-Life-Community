		relationship_profile_popup_switch_button.gui_input.connect(switch_gui_callable)

	MainSceneHelpers._style_institution_hub_action_button(relationship_profile_popup_switch_button, "relationships")

	if relationship_profile_popup_edit_button != null and is_instance_valid(relationship_profile_popup_edit_button):
