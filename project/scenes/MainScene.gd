func _household_creator_save_unfinished_and_exit() -> void:
	var draft: Dictionary = _household_creator_build_unfinished_draft()
	if draft.is_empty():
		_household_creator_discard_and_exit()
		return

	MainSceneLogic._household_creator_store_unfinished_draft(gs, draft)

	EraLog.truth(JSON.stringify({
		"schema": "eralife.household_creator_unfinished_saved_debug",
		"version": 1,
		"success": true,
		"draft_id": str(draft.get("draft_id", "")),
		"world_seed": int(draft.get("world_contract", {}).get("world_seed", -1)) if typeof(draft.get("world_contract", {})) == TYPE_DICTIONARY else -1,
		"member_count": int(draft.get("created_members", []).size()) if typeof(draft.get("created_members", [])) == TYPE_ARRAY else 0,
		"saved_at_ms": int(Time.get_ticks_msec())
	}))

	_hide_household_creator_panel()
	_show_choose_adventure_entry_panel()


func _household_creator_discard_and_exit() -> void:
	_household_creator_terminate_world_seed("household_creator_discard_and_exit")
	_household_creator_reset_builder_runtime(true)
	_hide_household_creator_panel()
	_show_choose_adventure_entry_panel()


func _household_creator_terminate_world_seed(reason: String = "household_creator_terminate") -> void:
	var terminated_seed: int = int(household_creator_world_contract.get("world_seed", -1))
	var terminated_candidate_id: String = str(household_creator_world_contract.get("_prebirth_reality_candidate_id", ""))

	_reset_god_mode_reality_candidate(reason)

	remove_meta("household_creator_prewarm_active")
	remove_meta("household_creator_waiting_for_start_selection")
	remove_meta("household_creator_auto_start_after_prewarm")
	remove_meta("household_creator_auto_start_key")

	if gs != null:
		if typeof(gs.custom_settings) == TYPE_DICTIONARY:
			gs.custom_settings.erase("household_spawn_contract")
			gs.custom_settings.erase("world_seed")
			gs.custom_settings.erase("seed_contract")
			gs.custom_settings.erase("_prebirth_reality_candidate")
			gs.custom_settings.erase("_prebirth_reality_candidate_id")

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state.erase("household_creator_prewarm_active")
			gs.scenario_state.erase("household_creator_waiting_for_start_selection")
			gs.scenario_state.erase("household_creator_last_world_seed_prewarm_report")

	EraLog.truth(JSON.stringify({
		"schema": "eralife.household_world_seed_termination_debug",
		"version": 1,
		"success": true,
		"reason": reason,
		"terminated_world_seed": terminated_seed,
		"terminated_candidate_id": terminated_candidate_id,
		"terminated_at_ms": int(Time.get_ticks_msec())
	}))


func _household_creator_reset_builder_runtime(clear_active_draft: bool = false) -> void:
	household_creator_world_contract.clear()
	household_creator_created_members.clear()
	household_creator_pending_member_basic_contract.clear()
	household_creator_pending_settings.clear()
	household_creator_active_member_index = -1
	household_creator_world_prewarmed = false
	household_creator_confirm_no_family = false
	_household_creator_clear_member_stat_controls()

	if clear_active_draft:
		household_creator_active_draft_id = ""


func _household_creator_build_unfinished_draft() -> Dictionary:
	if household_creator_created_members.is_empty():
		return {}

	var world_seed: int = int(household_creator_world_contract.get("world_seed", -1))
	var first_member: Dictionary = household_creator_created_members [0] if typeof(household_creator_created_members [0]) == TYPE_DICTIONARY else {}

	var draft_id: String = household_creator_active_draft_id.strip_edges()
	if draft_id == "":
		draft_id = "unfinished_household_%d_%d" % [
			max(1, world_seed),
			int(Time.get_unix_time_from_system())
		]
		household_creator_active_draft_id = draft_id

	var household_name: String = ("%s %s Household" % [
		str(first_member.get("last_name", "")).strip_edges(),
		str(first_member.get("first_name", "")).strip_edges()
	]).strip_edges()
	if household_name == "Household":
		household_name = "Unfinished Household"

	return {
		"schema": "eralife.unfinished_household_creation_contract",
		"version": 1,
		"draft_id": draft_id,
		"builder_step": "roster",
		"world_prewarmed": household_creator_world_prewarmed,
		"world_contract": household_creator_world_contract.duplicate(true),
		"created_members": household_creator_created_members.duplicate(true),
		"active_member_index": -1,
		"overview": {
			"household_name": household_name,
			"member_count": household_creator_created_members.size(),
			"world_seed": world_seed,
			"era": str(household_creator_world_contract.get("era", "Modern")),
			"year": int(household_creator_world_contract.get("year", 2000)),
			"country": str(household_creator_world_contract.get("country", "")),
			"city": str(household_creator_world_contract.get("city", ""))
		},
		"saved_at_ms": int(Time.get_ticks_msec()),
		"saved_at_unix": int(Time.get_unix_time_from_system())
	}

