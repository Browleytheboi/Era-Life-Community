				"realm_id": realm_id,
				"scope_id": scope_id,
				"reason": "missing_global_node_scope"
			})

	return {
		"success": missing.is_empty(),
		"reason": "global_node_population_scopes_hot" if missing.is_empty() else "global_node_population_scopes_missing",
		"checked_count": ids.size(),
		"missing": missing,
		"ui_is_renderer_only": true
	}

func _schedule_presidential_parent_federal_population_stream_after_player_control(reason: String = "presidential_parent_tail_population") -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if not bool(gs.scenario_state.get("presidential_parent_contract_federal_population_pending_after_player_control", false)):
		return

	if bool(get_meta("presidential_parent_federal_population_tail_stream_pending", false)):
		return

	set_meta("presidential_parent_federal_population_tail_stream_pending", true)
	set_meta("presidential_parent_federal_population_tail_stream_reason", reason)
	set_meta("presidential_parent_federal_population_tail_stream_scheduled_at_ms", int(Time.get_ticks_msec()))

	gs.scenario_state ["presidential_parent_federal_population_tail_stream_pending"] = true
	gs.scenario_state ["presidential_parent_federal_population_tail_stream_reason"] = reason
	gs.scenario_state ["presidential_parent_federal_population_tail_stream_scheduled_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["presidential_parent_contract_federal_population_external_stream_driver"] = true
	gs.scenario_state ["presidential_parent_contract_federal_population_blocks_ready"] = false
	gs.scenario_state ["presidential_parent_contract_federal_population_surface_is_tail_work"] = true

	call_deferred("_run_presidential_parent_federal_population_stream_after_player_control_tick", reason)


func _run_presidential_parent_federal_population_stream_after_player_control_tick(reason: String = "presidential_parent_tail_population") -> void:
	if gs == null:
		set_meta("presidential_parent_federal_population_tail_stream_pending", false)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if not _playable_life_surface_player_control_released():
		var wait_tree:= get_tree()
		if wait_tree == null:
			call_deferred("_run_presidential_parent_federal_population_stream_after_player_control_tick", reason)
			return

		var wait_timer:= wait_tree.create_timer(0.1)
		wait_timer.timeout.connect(
			Callable(self, "_run_presidential_parent_federal_population_stream_after_player_control_tick").bind(reason),
			CONNECT_ONE_SHOT
		)
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if _ui_interaction_grace_active(now_ms):
		var grace_tree:= get_tree()
		if grace_tree == null:
			call_deferred("_run_presidential_parent_federal_population_stream_after_player_control_tick", reason)
			return

		var grace_timer:= grace_tree.create_timer(0.12)
		grace_timer.timeout.connect(
			Callable(self, "_run_presidential_parent_federal_population_stream_after_player_control_tick").bind(reason),
			CONNECT_ONE_SHOT
		)
		return

	var us_realm_id: int = int(gs.scenario_state.get("presidential_parent_contract_us_realm_id", -1))
	if us_realm_id <= 0:
		set_meta("presidential_parent_federal_population_tail_stream_pending", false)
		gs.scenario_state ["presidential_parent_federal_population_tail_stream_pending"] = false
		return

	var cursor: int = int(gs.scenario_state.get("presidential_parent_contract_federal_population_stream_cursor", 0))

	gs.scenario_state ["presidential_parent_contract_federal_population_external_stream_driver"] = true
	gs.scenario_state ["presidential_parent_contract_federal_population_stream_running"] = true
	gs.scenario_state ["presidential_parent_contract_federal_population_pending_after_player_control"] = true

	if gs.has_method("_presidential_parent_contract_materialize_federal_republic_population_stream_tick"):
		gs.call("_presidential_parent_contract_materialize_federal_republic_population_stream_tick", us_realm_id, cursor)

	var complete: bool = bool(gs.scenario_state.get("presidential_parent_contract_federal_population_complete", false)) \
or bool(gs.scenario_state.get("presidential_parent_contract_federal_population_stream_complete", false))

	if complete:
		set_meta("presidential_parent_federal_population_tail_stream_pending", false)
		set_meta("presidential_parent_federal_population_tail_stream_complete", true)
		set_meta("presidential_parent_federal_population_tail_stream_completed_at_ms", int(Time.get_ticks_msec()))

		gs.scenario_state ["presidential_parent_federal_population_tail_stream_pending"] = false
		gs.scenario_state ["presidential_parent_federal_population_tail_stream_complete"] = true
		gs.scenario_state ["presidential_parent_federal_population_tail_stream_completed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["presidential_parent_contract_federal_population_pending_after_player_control"] = false
		gs.scenario_state ["presidential_parent_contract_federal_population_external_stream_driver"] = false

		_schedule_population_lens_runtime_surface_stream_after_shell("%s_population_lens_refresh" % reason)
		return

	var tail_tree:= get_tree()
	if tail_tree == null:
		call_deferred("_run_presidential_parent_federal_population_stream_after_player_control_tick", reason)
		return

	var tail_timer:= tail_tree.create_timer(0.04)
	tail_timer.timeout.connect(
		Callable(self, "_run_presidential_parent_federal_population_stream_after_player_control_tick").bind(reason),
		CONNECT_ONE_SHOT
	)
func _global_prewarm_verify_realm_population_lens_packets(realm_ids: Array = []) -> Dictionary:
	var panel:= _ensure_realm_population_contract_panel()
	if panel == null:
		return {
			"success": false,
			"reason": "missing_realm_population_contract_panel"
		}

	var ids: Array = realm_ids.duplicate(true)
	if ids.is_empty():
		ids = _population_card_contract_tail_realm_ids()

	var missing: Array = []

	for raw_realm_id in ids:
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
		var graph_hot: bool = true
		var surface_hot: bool = true

		if panel.has_method("has_card_graph_packet_for"):
			graph_hot = panel.has_card_graph_packet_for(realm_id, realm_name)

		if panel.has_method("has_surface_for"):
			surface_hot = panel.has_surface_for(realm_id, realm_name)

		if not graph_hot or not surface_hot:
			missing.append({
				"realm_id": realm_id,
				"realm_name": realm_name,
				"graph_hot": graph_hot,
				"surface_hot": surface_hot,
				"reason": "population_lens_packet_or_surface_missing"
			})

	return {
		"success": missing.is_empty(),
		"reason": "realm_population_lens_packets_hot" if missing.is_empty() else "realm_population_lens_packets_missing",
		"checked_count": ids.size(),
		"missing": missing,
		"ui_is_renderer_only": true,
		"click_path_build_forbidden": true,
	}
func _tail_prewarm_population_card_contract_registry(
	reason: String = "population_card_contract_tail_registry",
	realm_ids: Array = [],
	cursor: int = 0
) -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var card_engine:= _ensure_population_card_contract_engine()
	var panel:= _ensure_realm_population_contract_panel()

	if card_engine == null or panel == null:
		gs.scenario_state ["population_card_contract_tail_registry_failed"] = true
		gs.scenario_state ["population_card_contract_tail_registry_failed_reason"] = "missing_engine_or_panel"
		gs.scenario_state ["population_card_contract_tail_registry_failed_at_ms"] = int(Time.get_ticks_msec())
		return

	if realm_ids.is_empty():
		realm_ids = _population_card_contract_tail_realm_ids()

	if cursor >= realm_ids.size():
		gs.scenario_state ["population_card_contract_tail_registry_complete"] = true
		gs.scenario_state ["population_card_contract_tail_registry_complete_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["population_card_contract_tail_registry_reason"] = reason
		gs.scenario_state ["population_card_contract_tail_registry_count"] = realm_ids.size()
		gs.scenario_state ["population_cards_are_contract_artifacts"] = true
		gs.scenario_state ["ready_door_latch_does_not_wait_for_population_cards"] = true
		return

	var realm_id: int = int(realm_ids [cursor])
	if realm_id <= 0:
		call_deferred("_tail_prewarm_population_card_contract_registry", reason, realm_ids, cursor + 1)
		return

	var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
	if realm_name == "":
		call_deferred("_tail_prewarm_population_card_contract_registry", reason, realm_ids, cursor + 1)
		return

	var view_contract: Dictionary = card_engine.view_contract_for_realm(
		realm_id,
		realm_name,
		{
			"source": "%s_realm_%d" % [reason, realm_id],
			"tail_registry": true,
			"ui_is_renderer_only": true,
			"click_path_build_forbidden": true,
			"ready_door_may_not_wait": true
		}
	)

	if not view_contract.is_empty():
		if panel.has_method("register_card_graph_packet"):
			var graph_packet: Dictionary = view_contract.get("population_card_graph_packet", {}) if typeof(view_contract.get("population_card_graph_packet", {})) == TYPE_DICTIONARY else {}
			if not graph_packet.is_empty():
				panel.register_card_graph_packet(
					realm_id,
					realm_name,
					graph_packet,
					{
						"source": reason,
						"tail_registry": true,
						"ui_is_renderer_only": true
					}
				)

		_prewarm_realm_population_contract_panel_for_realm(
			realm_id,
			realm_name,
			view_contract,
			"%s_surface_from_population_card_contract" % reason
		)

	gs.scenario_state ["population_card_contract_tail_registry_cursor"] = cursor
	gs.scenario_state ["population_card_contract_tail_registry_current_realm_id"] = realm_id
	gs.scenario_state ["population_card_contract_tail_registry_current_realm_name"] = realm_name
	gs.scenario_state ["population_card_contract_tail_registry_last_tick_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["population_card_contract_tail_registry_ready_door_may_not_wait"] = true

	call_deferred("_tail_prewarm_population_card_contract_registry", reason, realm_ids, cursor + 1)


func _population_card_contract_tail_realm_ids() -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	if gs != null and gs.player != null:
		var player_realm_id: int = int(gs.player.realm_id)
		if player_realm_id > 0:
			out.append(player_realm_id)
			seen [player_realm_id] = true

	if gs == null or gs.realm_engine == null:
		return out

	if not ("realms" in gs.realm_engine) or typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return out

	for raw_realm_id in gs.realm_engine.realms.keys():
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue
		if seen.has(realm_id):
			continue

		out.append(realm_id)
		seen [realm_id] = true

	return out
func _population_lens_registry_snapshot(reason: String = "snapshot") -> Dictionary:
	var panel:= _ensure_realm_population_contract_panel()
	var out: Dictionary = {
		"reason": reason,
		"panel_exists": panel != null,
		"surface_count": 0,
		"alias_count": 0,
		"active_realm_key": "",
		"created_at_ms": int(Time.get_ticks_msec())
	}

	if panel == null:
		return out

	out ["surface_count"] = panel.surfaces_by_realm.size()
	out ["alias_count"] = panel.surface_key_by_alias.size()
	out ["active_realm_key"] = str(panel.active_realm_key)

	return out


func _population_lens_preferred_city_for_country(country_name: String, era_key: String = "") -> String:
	var clean_country: String = str(country_name).strip_edges()
	if clean_country == "":
		return ""

	var clean_era: String = str(era_key).strip_edges()
	if clean_era == "":
		clean_era = _selected_era_key()

	if gs != null and gs.era_engine != null and gs.era_engine.has_method("get_cities_for_era_country"):
		var cities: Array = gs.era_engine.get_cities_for_era_country(clean_era, clean_country)
		if not cities.is_empty():
			return str(cities [0]).strip_edges()

	if gs != null and gs.player != null:
		var fallback_city: String = str(gs.player.home_city if str(gs.player.home_city).strip_edges() != "" else gs.player.birth_city).strip_edges()
		if fallback_city != "":
			return fallback_city

	return "Capital City"


func _population_lens_era_country_names_for_global_prewarm() -> Array:
	var out: Array = []
	if gs == null:
		return out

	var era_key: String = _selected_era_key()
	if gs.era != null:
		var era_name: String = str(gs.era.name).strip_edges()
		if era_name != "":
			era_key = era_name.replace(" Era", "")

	var reality_mode: String = str(gs.reality_mode).strip_edges().to_lower()
	if reality_mode == "":
		reality_mode = str(gs.custom_settings.get("reality_mode", "chaos")).strip_edges().to_lower() if typeof(gs.custom_settings) == TYPE_DICTIONARY else "chaos"

	if gs.family_creation_contract_engine != null and gs.family_creation_contract_engine.has_method("country_options_for"):
		out = gs.family_creation_contract_engine.country_options_for(era_key, reality_mode)

	if out.is_empty() and gs.era_engine != null and gs.era_engine.has_method("get_countries_for_era"):
		out = gs.era_engine.get_countries_for_era(era_key)

	if out.is_empty():
		match era_key.to_lower():
			"ancient":
				out = ["China", "Egypt", "Greece", "Kush", "Persia", "Rome", "Maurya Empire", "Kingdom of Aksum", "Earth Kingdom", "Fire Nation", "Northern Water Tribe", "Southern Water Tribe", "Northern Air Temple", "Southern Air Temple", "Eastern Air Temple", "Western Air Temple"]
			"medieval":
				out = ["Byzantium", "England", "France", "Japan", "Mali", "Norway", "Earth Kingdom", "Fire Nation", "Northern Water Tribe", "Southern Water Tribe", "Northern Air Temple", "Southern Air Temple", "Eastern Air Temple", "Western Air Temple"]
			"industrial":
				out = ["Brazil", "England", "France", "Germany", "Japan", "United States", "Earth Kingdom", "Fire Nation", "Northern Water Tribe", "Southern Water Tribe", "Republic City"]
			"future":
				out = ["Atlantic Federation", "Lunar Commonwealth", "Mars Colony", "Neo Japan", "Pan-African Union", "United States", "Sol Colony", "Jovian Compact", "Saturn Ring Authority", "Inner Worlds Treaty", "Low Earth Assembly", "Deep Space Network", "Solar Accord", "Western Coalition"]
			_:
				out = ["Brazil", "Canada", "France", "Japan", "Mexico", "South Korea", "United Kingdom", "United States", "Earth Kingdom", "Fire Nation", "Northern Water Tribe", "Southern Water Tribe", "Republic City"]

	var seen: Dictionary = {}
	var deduped: Array = []

	for raw_country in out:
		var country: String = str(raw_country).strip_edges()
		if country == "":
			continue

		var key: String = MainSceneHelpers._other_country_identity_key(country)
		if seen.has(key):
			continue

		seen [key] = true
		deduped.append(country)

	return deduped


func _materialize_population_lens_realm_for_country(country_name: String, reason: String = "population_lens_country_materialize") -> Dictionary:
	if gs == null or gs.realm_engine == null:
		return {
			"success": false,
			"reason": "missing_realm_engine",
			"country": country_name
		}

	if typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return {
			"success": false,
			"reason": "missing_realm_dictionary",
			"country": country_name
		}

	var clean_country: String = str(country_name).strip_edges()
	if clean_country == "":
		return {
			"success": false,
			"reason": "empty_country"
		}

	var era_key: String = _selected_era_key()
	var preferred_city: String = _population_lens_preferred_city_for_country(clean_country, era_key)

	var previous_contract_only_flag: Variant = null
	var had_contract_only_flag: bool = false

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		had_contract_only_flag = gs.scenario_state.has("royalty_heavy_bootstrap_forbidden_during_prewarm")
		previous_contract_only_flag = gs.scenario_state.get("royalty_heavy_bootstrap_forbidden_during_prewarm", false)
		gs.scenario_state ["royalty_heavy_bootstrap_forbidden_during_prewarm"] = false
		gs.scenario_state ["population_lens_country_materialization_active"] = true
		gs.scenario_state ["population_lens_country_materialization_country"] = clean_country
		gs.scenario_state ["population_lens_country_materialization_reason"] = reason

	var realm_id: int = -1
	if gs.realm_engine.has_method("ensure_realm_for_country"):
		realm_id = int(gs.realm_engine.ensure_realm_for_country(clean_country, preferred_city))

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if had_contract_only_flag:
			gs.scenario_state ["royalty_heavy_bootstrap_forbidden_during_prewarm"] = previous_contract_only_flag
		else:
			gs.scenario_state.erase("royalty_heavy_bootstrap_forbidden_during_prewarm")
		gs.scenario_state ["population_lens_country_materialization_active"] = false

	if realm_id <= 0 or not gs.realm_engine.realms.has(realm_id):
		MainSceneLogic._population_lens_prewarm_trace_event(gs, "realm_id_failed", {
			"country": clean_country,
			"preferred_city": preferred_city,
			"reason": reason
		})
		return {
			"success": false,
			"reason": "realm_id_failed",
			"country": clean_country,
			"preferred_city": preferred_city
		}

	var surface_report: Dictionary = {}
	if gs.realm_engine.has_method("ensure_realm_population_surface_contract"):
		surface_report = gs.realm_engine.ensure_realm_population_surface_contract(
			realm_id,
			preferred_city,
			{
				"source": "%s_population_lens_realm_surface" % reason,
				"ui_is_renderer": false,
				"allow_resident_materialization": true,
				"allow_governance_bootstrap": true,
				"force_materialize_for_population_lens": true,
				"click_path": false,
				"prewarm_path": true,
				"population_lens_viewer": true,
				"realm_population_contract_panel": true
			}
		)

	var realm_raw: Variant = gs.realm_engine.realms.get(realm_id, {})
	var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}
	var realm_name: String = str(realm.get("name", clean_country)).strip_edges()
	if realm_name == "":
		realm_name = clean_country

	var aliases: Array = [
		clean_country,
		realm_name,
		str(realm.get("country", "")),
		str(realm.get("realm_contract_resolved_from_country", "")),
		str(realm_id)
	]

	var view_contract: Dictionary = _crown_population_view_contract_for_realm(realm_id, realm_name, true)
	if view_contract.is_empty():
		MainSceneLogic._population_lens_prewarm_trace_event(gs, "view_contract_empty", {
			"country": clean_country,
			"realm_id": realm_id,
			"realm_name": realm_name,
			"surface_report": surface_report.duplicate(true)
		})
		return {
			"success": false,
			"reason": "view_contract_empty",
			"country": clean_country,
			"realm_id": realm_id,
			"realm_name": realm_name,
			"surface_report": surface_report.duplicate(true)
		}

	view_contract ["surface_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_required_hot_before_click"] = true
	view_contract ["population_lens_viewer_surface_provider"] = "RealmPopulationContractPanel"
	view_contract ["population_lens_click_path_build_forbidden"] = true
	view_contract ["population_lens_global_country_prewarm"] = true

	_prewarm_realm_population_contract_panel_for_realm(
		realm_id,
		realm_name,
		view_contract,
		"%s_visual_surface" % reason
	)

	var panel:= _ensure_realm_population_contract_panel()
	var panel_hot: bool = panel != null and panel.has_surface_for(realm_id, realm_name)

	var officials_count: int = (view_contract.get("officials", []) as Array).size() if typeof(view_contract.get("officials", [])) == TYPE_ARRAY else 0
	var nobles_count: int = (view_contract.get("nobles", []) as Array).size() if typeof(view_contract.get("nobles", [])) == TYPE_ARRAY else 0
	var masters_count: int = (view_contract.get("masters", []) as Array).size() if typeof(view_contract.get("masters", [])) == TYPE_ARRAY else 0
	var citizens_count: int = (view_contract.get("citizens", []) as Array).size() if typeof(view_contract.get("citizens", [])) == TYPE_ARRAY else 0

	if panel_hot:
		panel.add_aliases(realm_id, realm_name, aliases)

		MainSceneLogic._population_lens_prewarm_trace_event(gs, "surface_registered", {
			"country": clean_country,
			"realm_id": realm_id,
			"realm_name": realm_name,
			"officials": officials_count,
			"nobles": nobles_count,
			"masters": masters_count,
			"citizens": citizens_count
		})
	else:
		MainSceneLogic._population_lens_prewarm_trace_event(gs, "surface_failed_to_register", {
			"country": clean_country,
			"realm_id": realm_id,
			"realm_name": realm_name,
			"registry": _population_lens_registry_snapshot("surface_failed_to_register")
		})

	return {
		"success": panel_hot,
		"reason": "hot" if panel_hot else "surface_failed_to_register",
		"country": clean_country,
		"realm_id": realm_id,
		"realm_name": realm_name,
		"panel_hot": panel_hot,
		"view_contract": view_contract.duplicate(true),
		"surface_report": surface_report.duplicate(true),
		"surface_aliases": aliases.duplicate(true)
	}
func _prewarm_all_era_country_population_lenses_global(reason: String = "global_population_lens_prewarm") -> Dictionary:
	if gs == null or gs.realm_engine == null:
		return {
			"success": false,
			"reason": "missing_realm_engine"
		}

	_ensure_population_lens_viewer()
	_ensure_realm_population_contract_panel()
	_ensure_realm_population_surface_cache_root()

	var countries: Array = _population_lens_era_country_names_for_global_prewarm()
	var reports: Array = []
	var hot_count: int = 0
	var miss_count: int = 0

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "global_country_prewarm_begin", {
		"reason": reason,
		"country_count": countries.size(),
		"registry_before": _population_lens_registry_snapshot("before_global_country_prewarm")
	})

	for raw_country in countries:
		var country: String = str(raw_country).strip_edges()
		if country == "":
			continue

		var report: Dictionary = _materialize_population_lens_realm_for_country(
			country,
			"%s_%s" % [reason, MainSceneHelpers._other_country_identity_key(country)]
		)

		reports.append(report.duplicate(true))

		if bool(report.get("success", false)):
			hot_count += 1
		else:
			miss_count += 1

	var final_report: Dictionary = {
		"success": miss_count == 0 and hot_count > 0,
		"reason": reason,
		"country_count": countries.size(),
		"hot_count": hot_count,
		"miss_count": miss_count,
		"reports": reports.duplicate(true),
		"registry_after": _population_lens_registry_snapshot("after_global_country_prewarm")
	}

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["population_lens_global_country_prewarm_report"] = final_report.duplicate(true)
		gs.scenario_state ["population_lens_global_country_prewarm_hot_count"] = hot_count
		gs.scenario_state ["population_lens_global_country_prewarm_miss_count"] = miss_count
		gs.scenario_state ["population_lens_global_country_prewarm_complete"] = true
		gs.scenario_state ["population_lens_global_country_prewarm_success"] = bool(final_report.get("success", false))

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "global_country_prewarm_complete", final_report)

	return final_report
func _ensure_other_country_population_surface_hot(
	entry: Dictionary,
	reason: String = "other_country_population_surface_prewarm",
	allow_create: bool = false
) -> Dictionary:
	if entry.is_empty():
		return {
			"success": false,
			"reason": "empty_entry"
		}

	if gs == null or gs.realm_engine == null:
		return {
			"success": false,
			"reason": "missing_realm_engine"
		}

	if typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return {
			"success": false,
			"reason": "missing_realm_dictionary"
		}

	if allow_create and gs.realm_engine.realms.is_empty() and gs.realm_engine.has_method("bootstrap_realms_for_era"):
		gs.realm_engine.bootstrap_realms_for_era()

	var realm_raw: Variant = entry.get("realm", {})
	var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}

	if MainSceneHelpers._other_country_population_entry_should_hide(entry, realm):
		return {
			"success": false,
			"reason": "hidden_population_surface"
		}

	var realm_name: String = MainSceneHelpers._other_country_population_realm_name_from_entry(entry, realm)
	var preferred_city: String = MainSceneLogic._other_country_population_preferred_city(gs, entry, realm)
	var realm_id: int = MainSceneLogic._resolve_existing_realm_id_for_other_country_population_entry(gs, entry)

	var aliases: Array = [
		str(entry.get("entry_id", "")),
		str(entry.get("name", "")),
		realm_name,
		str(realm.get("name", "")),
		str(realm.get("country", "")),
		str(realm.get("realm_contract_resolved_from_country", "")),
		str(realm.get("browser_visual_theme", "")),
		str(realm.get("overview_visual_theme", ""))
	]

	var panel:= _ensure_realm_population_contract_panel()
	if panel == null:
		return {
			"success": false,
			"reason": "missing_population_contract_panel",
			"realm_id": realm_id,
			"realm_name": realm_name
		}

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_surface_hot_check", {
		"entry_name": str(entry.get("name", "")),
		"realm_name": realm_name,
		"realm_id_before": realm_id,
		"allow_create": allow_create,
		"reason": reason
	})

	if realm_id <= 0 and allow_create:
		var materialize_report: Dictionary = _materialize_population_lens_realm_for_country(
			realm_name,
			"%s_entry_materialize" % reason
		)

		if bool(materialize_report.get("success", false)):
			realm_id = int(materialize_report.get("realm_id", -1))
			realm_name = str(materialize_report.get("realm_name", realm_name)).strip_edges()

			var materialized_aliases: Array = materialize_report.get("surface_aliases", []) if typeof(materialize_report.get("surface_aliases", [])) == TYPE_ARRAY else []
			for raw_materialized_alias in materialized_aliases:
				var materialized_alias: String = str(raw_materialized_alias).strip_edges()
				if materialized_alias != "" and not aliases.has(materialized_alias):
					aliases.append(materialized_alias)

	if realm_id <= 0 and not allow_create:
		var alias_packet: Dictionary = panel.surface_packet_for(-1, realm_name)
		if alias_packet.is_empty():
			for raw_alias in aliases:
				alias_packet = panel.surface_packet_for(-1, str(raw_alias))
				if not alias_packet.is_empty():
					break

		if not alias_packet.is_empty():
			return {
				"success": true,
				"reason": "hot_by_alias",
				"realm_id": int(alias_packet.get("realm_id", -1)),
				"realm_name": str(alias_packet.get("realm_name", realm_name)),
				"panel_hot": true,
				"surface_aliases": aliases.duplicate(true),
			}

		MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_click_guard_surface_not_hot", {
			"entry_name": str(entry.get("name", "")),
			"realm_name": realm_name,
			"realm_id": realm_id,
			"allow_create": allow_create,
			"registry": _population_lens_registry_snapshot("other_country_click_guard_surface_not_hot")
		})

		return {
			"success": false,
			"reason": "surface_not_hot",
			"realm_id": realm_id,
			"realm_name": realm_name,
			"panel_hot": false,
			"surface_aliases": aliases.duplicate(true),
		}

	if realm_id <= 0 or not gs.realm_engine.realms.has(realm_id):
		return {
			"success": false,
			"reason": "missing_existing_realm_contract",
			"realm_name": realm_name,
			"surface_aliases": aliases.duplicate(true)
		}

	if gs.realm_engine.has_method("ensure_realm_population_surface_contract") and allow_create:
		var surface_contract_report: Dictionary = gs.realm_engine.ensure_realm_population_surface_contract(
			realm_id,
			preferred_city,
			{
				"source": "%s_population_lens_surface" % reason,
				"ui_is_renderer": false,
				"allow_resident_materialization": true,
				"allow_governance_bootstrap": true,
				"force_materialize_for_population_lens": true,
				"click_path": false,
				"prewarm_path": true,
				"population_lens_viewer": true,
				"realm_population_contract_panel": true
			}
		)

		MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_surface_contract_ensured", {
			"entry_name": str(entry.get("name", "")),
			"realm_id": realm_id,
			"realm_name": realm_name,
			"surface_contract_report": surface_contract_report.duplicate(true)
		})

	var realm_engine_raw: Variant = gs.realm_engine.realms.get(realm_id, {})
	if typeof(realm_engine_raw) == TYPE_DICTIONARY:
		var realm_engine_realm: Dictionary = realm_engine_raw
		var resolved_name: String = str(realm_engine_realm.get("name", realm_name)).strip_edges()
		if resolved_name != "":
			realm_name = resolved_name

		for raw_engine_alias in [
			str(realm_engine_realm.get("name", "")),
			str(realm_engine_realm.get("country", "")),
			str(realm_engine_realm.get("realm_contract_resolved_from_country", "")),
			str(realm_id)
		]:
			var engine_alias: String = str(raw_engine_alias).strip_edges()
			if engine_alias != "" and not aliases.has(engine_alias):
				aliases.append(engine_alias)

	if not allow_create:
		var hot: bool = panel.has_surface_for(realm_id, realm_name)

		if not hot:
			for raw_alias in aliases:
				var alias_name: String = str(raw_alias).strip_edges()
				if alias_name == "":
					continue

				if panel.has_surface_for(realm_id, alias_name):
					realm_name = alias_name
					hot = true
					break

		if not hot:
			for raw_alias in aliases:
				var alias_packet: Dictionary = panel.surface_packet_for(realm_id, str(raw_alias))
				if not alias_packet.is_empty():
					hot = true
					realm_name = str(alias_packet.get("realm_name", realm_name)).strip_edges()
					break

		if not hot:
			var reconcile_report: Dictionary = MainSceneLogic._other_country_reconcile_observable_population_surface(gs, 
				panel,
				realm_id,
				realm_name,
				aliases,
				"%s_reconcile_observable_surface" % reason
			)

			if bool(reconcile_report.get("success", false)):
				hot = true
				realm_name = str(reconcile_report.get("realm_name", realm_name)).strip_edges()

		if hot:
			panel.add_aliases(realm_id, realm_name, aliases)

		return {
			"success": hot,
			"reason": "hot" if hot else "surface_not_hot",
			"realm_id": realm_id,
			"realm_name": realm_name,
			"panel_hot": hot,
			"surface_aliases": aliases.duplicate(true),
			"alias_resolved": hot
		}
	var view_contract: Dictionary = _crown_population_view_contract_for_realm(realm_id, realm_name, true)
	if view_contract.is_empty():
		MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_view_contract_empty", {
			"entry_name": str(entry.get("name", "")),
			"realm_id": realm_id,
			"realm_name": realm_name
		})

		return {
			"success": false,
			"reason": "empty_view_contract",
			"realm_id": realm_id,
			"realm_name": realm_name,
			"surface_aliases": aliases.duplicate(true)
		}

	view_contract ["surface_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_source_entry"] = entry.duplicate(true)
	view_contract ["population_lens_required_hot_before_click"] = true
	view_contract ["population_lens_click_path_build_forbidden"] = true

	_prewarm_realm_population_contract_panel_for_realm(
		realm_id,
		realm_name,
		view_contract,
		"%s_visual_surface" % reason
	)

	var panel_hot: bool = panel.has_surface_for(realm_id, realm_name)
	if panel_hot:
		panel.add_aliases(realm_id, realm_name, aliases)

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_surface_registered", {
		"entry_name": str(entry.get("name", "")),
		"realm_id": realm_id,
		"realm_name": realm_name,
		"panel_hot": panel_hot
	})

	return {
		"success": panel_hot,
		"reason": "hot" if panel_hot else "surface_failed_to_register",
		"realm_id": realm_id,
		"realm_name": realm_name,
		"view_contract": view_contract.duplicate(true),
		"panel_hot": panel_hot,
		"surface_aliases": aliases.duplicate(true)
	}
func _population_lens_registry_ready_for_player_control(reason: String = "population_lens_registry_ready_check") -> bool:
	var panel:= _ensure_realm_population_contract_panel()
	if panel == null:
		return false

	var snapshot: Dictionary = _population_lens_registry_snapshot(reason)
	if int(snapshot.get("surface_count", 0)) <= 0:
		return false

	if gs == null or gs.player == null:
		return false

	var player_realm_id: int = int(gs.player.realm_id)
	if player_realm_id > 0:
		var player_realm_name: String = MainSceneLogic._crown_realm_name(gs, player_realm_id)
		if player_realm_name != "" and panel.has_surface_for(player_realm_id, player_realm_name):
			return true

	for raw_entry in _build_other_country_browser_entries():
		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue

		var entry: Dictionary = raw_entry
		var realm_raw: Variant = entry.get("realm", {})
		var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}

		if MainSceneHelpers._other_country_population_entry_should_hide(entry, realm):
			continue

		var packet: Dictionary = _ensure_other_country_population_surface_hot(
			entry,
			"%s_verify_visible_entry" % reason,
			false
		)

		if bool(packet.get("success", false)):
			return true

	return int(snapshot.get("surface_count", 0)) > 0
func _population_lens_runtime_surface_is_hot(realm_id: int, realm_name: String = "") -> bool:
	var panel:= _ensure_realm_population_contract_panel()
	if panel == null:
		return false

	return panel.has_surface_for(realm_id, realm_name)


func _prewarm_player_realm_population_lens_surface(reason: String = "player_realm_population_lens_prewarm") -> bool:
	if gs == null or gs.player == null or gs.realm_engine == null:
		return false

	if typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return false

	var player_realm_id: int = int(gs.player.realm_id)
	var preferred_city: String = str(gs.player.home_city if str(gs.player.home_city).strip_edges() != "" else gs.player.birth_city).strip_edges()

	if player_realm_id <= 0 or not gs.realm_engine.realms.has(player_realm_id):
		for raw_name in [
			str(gs.player.home_country).strip_edges(),
			str(gs.player.birth_country).strip_edges(),
			str(gs.player.bending_nation).strip_edges()
		]:
			var clean_name: String = str(raw_name).strip_edges()
			if clean_name == "":
				continue

			if gs.realm_engine.has_method("ensure_realm_for_country"):
				player_realm_id = int(gs.realm_engine.ensure_realm_for_country(clean_name, preferred_city))

			if player_realm_id > 0 and gs.realm_engine.realms.has(player_realm_id):
				gs.player.realm_id = player_realm_id
				break

	if player_realm_id <= 0 or not gs.realm_engine.realms.has(player_realm_id):
		return false

	var realm_raw: Variant = gs.realm_engine.realms.get(player_realm_id, {})
	var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}

	var realm_name: String = str(realm.get("name", realm.get("country", ""))).strip_edges()
	if realm_name == "":
		realm_name = MainSceneLogic._crown_realm_name(gs, player_realm_id)

	if realm_name == "":
		return false

	if MainSceneLogic._crown_population_uses_federal_republic_lens(gs, player_realm_id, realm_name) and not MainSceneLogic._presidential_parent_federal_population_stream_complete_for_realm(gs, player_realm_id):
		if gs.world_observability_contract_engine != null:
			gs.world_observability_contract_engine.ensure_realm_observable_surface(
				player_realm_id,
				realm_name,
				{
					"source": "%s_world_observability_surface" % reason,
					"hydration_optional": true,
					"ready_door_may_not_wait": true,
					"ui_is_renderer_only": true
				}
			)

		_schedule_presidential_parent_federal_population_stream_after_player_control(
			"%s_tail_hydration" % reason
		)

	var aliases: Array = [
		realm_name,
		str(realm.get("name", "")),
		str(realm.get("country", "")),
		str(realm.get("realm_contract_resolved_from_country", "")),
		str(realm.get("browser_visual_theme", "")),
		str(realm.get("overview_visual_theme", "")),
		str(gs.player.home_country),
		str(gs.player.birth_country),
		str(gs.player.bending_nation),
		str(player_realm_id)
	]

	if gs.realm_engine.has_method("ensure_realm_population_surface_contract"):
		gs.realm_engine.ensure_realm_population_surface_contract(
			player_realm_id,
			str(realm.get("capital_city", realm.get("capital", preferred_city))).strip_edges(),
			{
				"source": "%s_player_realm_population_lens_surface" % reason,
				"ui_is_renderer": false,
				"allow_resident_materialization": true,
				"allow_governance_bootstrap": true,
				"force_materialize_for_population_lens": true,
				"click_path": false,
				"prewarm_path": true,
				"population_lens_viewer": true,
				"realm_population_contract_panel": true,
				"ready_door_may_not_wait": true
			}
		)

	var view_contract: Dictionary = _crown_population_view_contract_for_realm(player_realm_id, realm_name, true)
	if view_contract.is_empty():
		return false

	view_contract ["surface_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_aliases"] = aliases.duplicate(true)
	view_contract ["population_lens_required_hot_before_click"] = false
	view_contract ["population_lens_viewer_surface_provider"] = "RealmPopulationContractPanel"
	view_contract ["population_lens_click_path_build_forbidden"] = true
	view_contract ["player_realm_population_lens_surface"] = true
	view_contract ["ready_door_may_not_wait"] = true
	view_contract ["federal_population_stream_complete"] = MainSceneLogic._presidential_parent_federal_population_stream_complete_for_realm(gs, player_realm_id)

	_prewarm_realm_population_contract_panel_for_realm(
		player_realm_id,
		realm_name,
		view_contract,
		"%s_player_realm_contract_panel_surface" % reason
	)

	var panel:= _ensure_realm_population_contract_panel()
	if panel != null and panel.has_surface_for(player_realm_id, realm_name):
		panel.add_aliases(player_realm_id, realm_name, aliases)
		return true

	return false
func _prewarm_population_lens_runtime_surfaces_before_player_control(reason: String = "population_lens_runtime_prewarm") -> bool:
	if gs == null:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	_ensure_population_lens_viewer()
	_ensure_realm_population_contract_panel()
	_ensure_realm_population_surface_cache_root()

	var registry_after: Dictionary = _population_lens_registry_snapshot("%s_ready_gate_lightweight_snapshot" % reason)
	var force_stamp_ms: int = int(Time.get_ticks_msec())

	set_meta("population_lens_surfaces_hot_gate_was_checked", true)
	set_meta("population_lens_runtime_surfaces_prewarmed_before_player_control", false)
	set_meta("population_lens_runtime_surfaces_stream_after_shell", true)
	set_meta("population_lens_ready_gate_is_lightweight", true)
	set_meta("population_lens_ready_gate_builds_surfaces", false)
	set_meta("population_lens_registry_force_happened_before_shell_release", false)
	set_meta("population_lens_registry_forced_hot_before_player_control", false)
	set_meta("population_lens_registry_ready_before_shell_release", true)
	set_meta("ready_door_latch_waits_for_population_lens_registry", false)
	set_meta("ready_door_latch_does_not_wait_for_population_cards", true)

	gs.scenario_state ["population_lens_surfaces_hot_gate_was_checked"] = true
	gs.scenario_state ["population_lens_hot_gate_active"] = false
	gs.scenario_state ["population_lens_hot_gate_reason"] = reason
	gs.scenario_state ["population_lens_ready_gate_is_lightweight"] = true
	gs.scenario_state ["population_lens_ready_gate_builds_surfaces"] = false
	gs.scenario_state ["population_lens_runtime_surfaces_stream_after_shell"] = true
	gs.scenario_state ["population_lens_runtime_surfaces_prewarmed_before_player_control"] = false
	gs.scenario_state ["population_lens_registry_force_happened_before_shell_release"] = false
	gs.scenario_state ["population_lens_registry_forced_hot_before_player_control"] = false
	gs.scenario_state ["population_lens_registry_ready_before_shell_release"] = true
	gs.scenario_state ["population_lens_runtime_surface_registry_after"] = registry_after.duplicate(true)
	gs.scenario_state ["population_lens_registry_snapshot_before_shell_release"] = registry_after.duplicate(true)
	gs.scenario_state ["population_lens_click_path_build_forbidden"] = true
	gs.scenario_state ["population_lens_click_path_reveal_only"] = true
	gs.scenario_state ["intent_is_not_action_population_lens"] = true
	gs.scenario_state ["population_cards_are_not_ready_door_latch"] = true
	gs.scenario_state ["ready_door_latch_waits_for_population_lens_registry"] = false
	gs.scenario_state ["ready_door_latch_does_not_wait_for_population_cards"] = true
	gs.scenario_state ["population_lens_ready_gate_checked_at_ms"] = force_stamp_ms

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "runtime_surface_hot_gate_lightweight_complete", {
		"reason": reason,
		"registry_after": registry_after.duplicate(true),
	})

	_schedule_population_lens_runtime_surface_stream_after_shell("%s_tail_stream" % reason)

	return true
func _schedule_population_lens_runtime_surface_stream_after_shell(reason: String = "population_lens_tail_stream") -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if bool(get_meta("population_lens_runtime_surface_stream_pending", false)):
		return

	set_meta("population_lens_runtime_surface_stream_pending", true)
	set_meta("population_lens_runtime_surface_stream_reason", reason)
	set_meta("population_lens_runtime_surface_stream_cursor", 0)
	set_meta("population_lens_runtime_surface_stream_scheduled_at_ms", int(Time.get_ticks_msec()))

	gs.scenario_state ["population_lens_runtime_surface_stream_pending"] = true
	gs.scenario_state ["population_lens_runtime_surface_stream_reason"] = reason
	gs.scenario_state ["population_lens_runtime_surface_stream_cursor"] = 0
	gs.scenario_state ["population_lens_runtime_surface_stream_scheduled_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["population_lens_runtime_surface_stream_does_not_block_ready"] = true

	call_deferred("_run_population_lens_runtime_surface_stream_tick", reason, 0)


func _run_population_lens_runtime_surface_stream_tick(
	reason: String = "population_lens_tail_stream",
	cursor: int = 0
) -> void:
	if gs == null:
		set_meta(
			"population_lens_runtime_surface_stream_pending",
			false
		)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if _ui_interaction_grace_active(
		now_ms
	):
		var grace_tree:= get_tree()

		if grace_tree == null:
			call_deferred(
				"_run_population_lens_runtime_surface_stream_tick",
				reason,
				cursor
			)
			return

		var grace_timer:= grace_tree.create_timer(
			0.12
		)

		grace_timer.timeout.connect(
			Callable(
				self,
				"_run_population_lens_runtime_surface_stream_tick"
			).bind(
				reason,
				cursor
			),
			CONNECT_ONE_SHOT
		)
		return

	var realm_ids: Array = (
		_population_card_contract_tail_realm_ids()
	)
	var stream_realm_ids: Array = []

	if gs.player != null:
		var player_realm_id: int = int(
			gs.player.realm_id
		)

		if player_realm_id > 0:
			stream_realm_ids.append(
				player_realm_id
			)

	for raw_realm_id in realm_ids:
		var candidate_realm_id: int = int(
			raw_realm_id
		)

		if (
			candidate_realm_id > 0
			and candidate_realm_id not in stream_realm_ids
		):
			stream_realm_ids.append(
				candidate_realm_id
			)

	if cursor >= stream_realm_ids.size():
		set_meta(
			"population_lens_runtime_surface_stream_pending",
			false
		)
		set_meta(
			"population_lens_runtime_surface_stream_complete",
			true
		)
		set_meta(
			"population_lens_runtime_surface_stream_completed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		gs.scenario_state [
			"population_lens_runtime_surface_stream_pending"
		] = false
		gs.scenario_state [
			"population_lens_runtime_surface_stream_complete"
		] = true
		gs.scenario_state [
			"population_lens_runtime_surface_stream_completed_at_ms"
		] = int(
			Time.get_ticks_msec()
		)

		return

	var realm_id: int = int(
		stream_realm_ids [
			cursor
		]
	)
	var realm_name: String = (
		MainSceneLogic._population_card_contract_tail_realm_name(gs, 
			realm_id
		)
	)

	if (
		realm_id > 0
		and realm_name != ""
	):
		var panel:= _ensure_realm_population_contract_panel()

		if panel != null:
			panel.register_surface_shell(
				realm_id,
				realm_name,
				{
					"source": (
						"%s_realm_%d_shell"
						% [
							reason,
							realm_id
						]
					),
					"ready_door_may_not_wait": true,
					"ui_is_renderer_only": true
				}
			)

		var queue_report: Dictionary = (
			_request_realm_population_truth_shards(
				realm_id,
				realm_name,
				"%s_realm_%d_truth_shards"
				% [
					reason,
					realm_id
				]
			)
		)

		gs.scenario_state [
			"population_lens_runtime_surface_stream_last_queue_report"
		] = queue_report.duplicate(true)
		gs.scenario_state [
			"population_lens_runtime_surface_stream_last_realm_id"
		] = realm_id
		gs.scenario_state [
			"population_lens_runtime_surface_stream_last_realm_name"
		] = realm_name

	set_meta(
		"population_lens_runtime_surface_stream_cursor",
		cursor + 1
	)
	gs.scenario_state [
		"population_lens_runtime_surface_stream_cursor"
	] = cursor + 1
	gs.scenario_state [
		"population_lens_runtime_surface_stream_last_tick_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	gs.scenario_state [
		"population_lens_runtime_surface_stream_full_surface_builds"
	] = false
	gs.scenario_state [
		"population_lens_runtime_surface_stream_shells_then_shards"
	] = true

	var tail_tree:= get_tree()

	if tail_tree == null:
		call_deferred(
			"_run_population_lens_runtime_surface_stream_tick",
			reason,
			cursor + 1
		)
		return

	var tail_timer:= tail_tree.create_timer(
		0.05
	)

	tail_timer.timeout.connect(
		Callable(
			self,
			"_run_population_lens_runtime_surface_stream_tick"
		).bind(
			reason,
			cursor + 1
		),
		CONNECT_ONE_SHOT
	)
func _prewarm_realm_population_contract_panel_for_realm(
	realm_id: int,
	realm_name: String,
	view_contract: Dictionary,
	reason: String
) -> void:
	if (
		realm_id <= 0
		or view_contract.is_empty()
	):
		return

	var panel:= _ensure_realm_population_contract_panel()

	if panel == null:
		return

	var clean_name: String = str(
		realm_name
	).strip_edges()

	if clean_name == "":
		clean_name = "Realm %d" % realm_id

	if not panel.has_surface_for(
		realm_id,
		clean_name
	):
		panel.register_surface_shell(
			realm_id,
			clean_name,
			{
				"source": reason,
				"click_path_build_forbidden": true,
				"ready_door_may_not_wait": true,
				"ui_is_renderer_only": true
			}
		)

	var queue_report: Dictionary = (
		panel.queue_incremental_projection(
			realm_id,
			clean_name,
			view_contract,
			{
				"source": reason,
				"click_path_build_forbidden": true,
				"ready_door_may_not_wait": true,
				"ui_is_renderer_only": true
			}
		)
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"realm_population_incremental_prewarm_last_report"
		] = queue_report.duplicate(true)
		gs.scenario_state [
			"realm_population_incremental_prewarm_realm_id"
		] = realm_id
		gs.scenario_state [
			"realm_population_incremental_prewarm_reason"
		] = reason
		gs.scenario_state [
			"realm_population_full_surface_background_build_forbidden"
		] = true
func _prewarm_crown_population_wall_view_contracts(reason: String = "idle_population_wall_prewarm") -> void:
	if gs == null or gs.realm_engine == null:
		return

	if typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return

	var panel:= _ensure_realm_population_contract_panel()
	var cache_root:= _ensure_realm_population_surface_cache_root()
	var viewer:= _ensure_population_lens_viewer()

	if panel == null or cache_root == null or viewer == null:
		return

	if gs.realm_engine.realms.is_empty() and gs.realm_engine.has_method("bootstrap_realms_for_era"):
		gs.realm_engine.bootstrap_realms_for_era()

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "crown_population_wall_prewarm_begin", {
		"reason": reason,
		"registry_before": _population_lens_registry_snapshot("crown_population_wall_prewarm_begin")
	})

	var prewarmed_realm_ids: Dictionary = {}
	var prewarmed_count: int = 0
	var country_surface_count: int = 0
	var contract_miss_count: int = 0
	var entry_packets: Array = []
	var aliases_by_realm_id: Dictionary = {}

	var global_country_report: Dictionary = _prewarm_all_era_country_population_lenses_global(
		"%s_global_country_coverage" % reason
	)

	var player_realm_hot: bool = _prewarm_player_realm_population_lens_surface("%s_player_realm_first" % reason)
	if player_realm_hot and gs != null and gs.player != null:
		var player_realm_id: int = int(gs.player.realm_id)
		if player_realm_id > 0:
			prewarmed_realm_ids [player_realm_id] = true
			prewarmed_count += 1

	for raw_entry in _build_other_country_browser_entries():
		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue

		var entry: Dictionary = raw_entry
		var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
		var packet: Dictionary = _ensure_other_country_population_surface_hot(
			entry,
			"%s_other_country_%s_surface" % [
				reason,
				entry_id if entry_id != "" else "surface"
			],
			true
		)

		if not bool(packet.get("success", false)):
			contract_miss_count += 1
			MainSceneLogic._population_lens_prewarm_trace_event(gs, "other_country_entry_surface_miss", {
				"entry_id": entry_id,
				"entry_name": str(entry.get("name", "")),
				"packet": packet.duplicate(true)
			})
			continue

		var packet_realm_id: int = int(packet.get("realm_id", -1))
		if packet_realm_id <= 0:
			contract_miss_count += 1
			continue

		entry_packets.append(packet.duplicate(true))

		var packet_aliases: Array = packet.get("surface_aliases", []) if typeof(packet.get("surface_aliases", [])) == TYPE_ARRAY else []
		var current_aliases: Array = aliases_by_realm_id.get(packet_realm_id, []) if typeof(aliases_by_realm_id.get(packet_realm_id, [])) == TYPE_ARRAY else []

		for raw_alias in packet_aliases:
			var alias_text: String = str(raw_alias).strip_edges()
			if alias_text != "" and not current_aliases.has(alias_text):
				current_aliases.append(alias_text)

		var packet_realm_name: String = str(packet.get("realm_name", entry.get("name", ""))).strip_edges()
		if packet_realm_name != "" and not current_aliases.has(packet_realm_name):
			current_aliases.append(packet_realm_name)

		aliases_by_realm_id [packet_realm_id] = current_aliases

	for raw_realm_id in gs.realm_engine.realms.keys():
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var realm_raw: Variant = gs.realm_engine.realms.get(raw_realm_id, gs.realm_engine.realms.get(realm_id, {}))
		if typeof(realm_raw) != TYPE_DICTIONARY:
			continue

		var realm: Dictionary = realm_raw
		var realm_name: String = str(realm.get("name", realm.get("country", ""))).strip_edges()
		if realm_name == "":
			realm_name = MainSceneLogic._crown_realm_name(gs, realm_id)

		if realm_name == "":
			contract_miss_count += 1
			continue

		if MainSceneHelpers._crown_population_wall_should_hide_for_realm(realm_id, realm_name, realm):
			continue

		if gs.realm_engine.has_method("ensure_realm_population_surface_contract"):
			var surface_contract_report: Dictionary = gs.realm_engine.ensure_realm_population_surface_contract(
				realm_id,
				str(realm.get("capital_city", realm.get("capital", ""))).strip_edges(),
				{
					"source": "%s_existing_realm_surface" % reason,
					"ui_is_renderer": false,
					"allow_resident_materialization": true,
					"allow_governance_bootstrap": true,
					"force_materialize_for_population_lens": true,
					"click_path": false,
					"prewarm_path": true,
					"population_lens_viewer": true,
					"realm_population_contract_panel": true
				}
			)

			MainSceneLogic._population_lens_prewarm_trace_event(gs, "existing_realm_surface_contract_ensured", {
				"realm_id": realm_id,
				"realm_name": realm_name,
				"report": surface_contract_report.duplicate(true)
			})

		var realm_aliases: Array = aliases_by_realm_id.get(realm_id, []) if typeof(aliases_by_realm_id.get(realm_id, [])) == TYPE_ARRAY else []

		for raw_alias in [
			realm_name,
			str(realm.get("name", "")),
			str(realm.get("country", "")),
			str(realm.get("realm_contract_resolved_from_country", "")),
			str(realm.get("browser_visual_theme", "")),
			str(realm.get("overview_visual_theme", "")),
			str(realm.get("entry_id", "")),
			str(realm_id)
		]:
			var alias_text: String = str(raw_alias).strip_edges()
			if alias_text != "" and not realm_aliases.has(alias_text):
				realm_aliases.append(alias_text)

		var view_contract: Dictionary = _crown_population_view_contract_for_realm(realm_id, realm_name, true)
		if view_contract.is_empty():
			contract_miss_count += 1
			MainSceneLogic._population_lens_prewarm_trace_event(gs, "existing_realm_view_contract_empty", {
				"realm_id": realm_id,
				"realm_name": realm_name
			})
			continue

		view_contract ["surface_aliases"] = realm_aliases.duplicate(true)
		view_contract ["population_lens_aliases"] = realm_aliases.duplicate(true)
		view_contract ["population_lens_required_hot_before_click"] = true
		view_contract ["population_lens_viewer_surface_provider"] = "RealmPopulationContractPanel"
		view_contract ["population_lens_click_path_build_forbidden"] = true

		_prewarm_realm_population_contract_panel_for_realm(
			realm_id,
			realm_name,
			view_contract,
			"%s_existing_realm_visual_surface" % reason
		)

		if panel.has_surface_for(realm_id, realm_name):
			panel.add_aliases(realm_id, realm_name, realm_aliases)
			if not prewarmed_realm_ids.has(realm_id):
				prewarmed_realm_ids [realm_id] = true
				prewarmed_count += 1
		else:
			contract_miss_count += 1
			MainSceneLogic._population_lens_prewarm_trace_event(gs, "existing_realm_surface_failed_to_register", {
				"realm_id": realm_id,
				"realm_name": realm_name,
				"registry": _population_lens_registry_snapshot("existing_realm_surface_failed_to_register")
			})

	for raw_packet in entry_packets:
		if typeof(raw_packet) != TYPE_DICTIONARY:
			continue

		var packet: Dictionary = raw_packet
		var packet_realm_id: int = int(packet.get("realm_id", -1))
		if packet_realm_id <= 0:
			continue

		var packet_realm_name: String = str(packet.get("realm_name", "")).strip_edges()
		var packet_aliases: Array = packet.get("surface_aliases", []) if typeof(packet.get("surface_aliases", [])) == TYPE_ARRAY else []

		if packet_realm_name != "" and panel.has_surface_for(packet_realm_id, packet_realm_name):
			panel.add_aliases(packet_realm_id, packet_realm_name, packet_aliases)

		if not prewarmed_realm_ids.has(packet_realm_id) and packet_realm_name != "" and panel.has_surface_for(packet_realm_id, packet_realm_name):
			prewarmed_realm_ids [packet_realm_id] = true
			country_surface_count += 1
			prewarmed_count += 1

	var current_player_realm_hot: bool = false
	if gs != null and gs.player != null:
		var current_player_realm_id: int = int(gs.player.realm_id)
		var current_player_realm_name: String = MainSceneLogic._crown_realm_name(gs, current_player_realm_id)
		current_player_realm_hot = current_player_realm_id > 0 and panel.has_surface_for(current_player_realm_id, current_player_realm_name)

	var registry_after: Dictionary = _population_lens_registry_snapshot("crown_population_wall_prewarm_complete")

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["crown_population_wall_view_contracts_prewarmed"] = true
		gs.scenario_state ["crown_population_wall_view_contracts_prewarmed_reason"] = reason
		gs.scenario_state ["crown_population_wall_view_contracts_prewarmed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["realm_population_contract_panels_prewarmed"] = prewarmed_count > 0
		gs.scenario_state ["realm_population_contract_panels_are_reveal_only"] = true
		gs.scenario_state ["realm_population_ui_build_on_press_forbidden"] = true
		gs.scenario_state ["realm_population_other_country_surfaces_prewarmed"] = true
		gs.scenario_state ["realm_population_lens_viewer_is_universal"] = true
		gs.scenario_state ["realm_population_contract_panel_is_provider_only"] = true
		gs.scenario_state ["population_lens_viewer_owns_visual_projection"] = true
		gs.scenario_state ["realm_population_contract_panel_prewarmed_count"] = prewarmed_count
		gs.scenario_state ["realm_population_country_surface_prewarmed_count"] = country_surface_count
		gs.scenario_state ["realm_population_contract_panel_miss_count"] = contract_miss_count
		gs.scenario_state ["realm_population_player_realm_surface_hot"] = current_player_realm_hot
		gs.scenario_state ["realm_population_player_realm_surface_required"] = true
		gs.scenario_state ["population_lens_registry_snapshot_after_prewarm"] = registry_after.duplicate(true)
		gs.scenario_state ["population_lens_global_country_report"] = global_country_report.duplicate(true)

	MainSceneLogic._population_lens_prewarm_trace_event(gs, "crown_population_wall_prewarm_complete", {
		"reason": reason,
		"prewarmed_count": prewarmed_count,
		"country_surface_count": country_surface_count,
		"contract_miss_count": contract_miss_count,
		"player_realm_hot": current_player_realm_hot,
		"registry_after": registry_after.duplicate(true)
	})
func _queue_realm_population_truth_observation(
	realm_id: int,
	realm_name: String,
	reason: String
) -> Dictionary:
	if realm_id <= 0:
		return {
			"success": false,
			"reason": "invalid_realm_id",
			"realm_id": realm_id,
			"ui_is_expression_only": true
		}

	var clean_name: String = str(
		realm_name
	).strip_edges()

	if clean_name == "":
		clean_name = "Realm %d" % realm_id

	var queue_key: String = "%d:%s" % [
		realm_id,
		clean_name.to_lower()
	]

	if not realm_population_observation_keys.has(
		queue_key
	):
		realm_population_observation_keys [
			queue_key
		] = true
		realm_population_observation_queue.append({
			"queue_key": queue_key,
			"realm_id": realm_id,
			"realm_name": clean_name,
			"reason": reason,
			"retry_count": 0,
			"queued_at_ms": int(
				Time.get_ticks_msec()
			),
			"ui_is_expression_only": true
		})

	if not realm_population_observation_service_armed:
		realm_population_observation_generation += 1

		_schedule_realm_population_observation_service(
			realm_population_observation_generation,
			0.016
		)

	return {
		"success": true,
		"realm_id": realm_id,
		"realm_name": clean_name,
		"queued": true,
		"queue_size": realm_population_observation_queue.size(),
		"ui_is_expression_only": true
	}


func _schedule_realm_population_observation_service(
	generation: int,
	delay_seconds: float = 0.016
) -> void:
	if generation != realm_population_observation_generation:
		return

	if realm_population_observation_service_armed:
		return

	realm_population_observation_service_armed = true

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_realm_population_observation_queue",
			generation
		)
		return

	var timer:= tree.create_timer(
		clampf(
			delay_seconds,
			0.016,
			0.25
		),
		true,
		false,
		true
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_realm_population_observation_queue"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)


func _service_realm_population_observation_queue(
	generation: int
) -> void:
	realm_population_observation_service_armed = false

	if generation != realm_population_observation_generation:
		return

	if realm_population_observation_queue.is_empty():
		return

	var row_raw: Variant = (
		realm_population_observation_queue.pop_front()
	)

	if typeof(row_raw) != TYPE_DICTIONARY:
		_schedule_realm_population_observation_service(
			generation,
			0.032
		)
		return

	var row: Dictionary = (
		row_raw as Dictionary
	)
	var queue_key: String = str(
		row.get(
			"queue_key",
			""
		)
	)
	var realm_id: int = int(
		row.get(
			"realm_id",
			-1
		)
	)
	var realm_name: String = str(
		row.get(
			"realm_name",
			""
		)
	)
	var reason: String = str(
		row.get(
			"reason",
			"realm_population_observation_service"
		)
	)
	var retry_count: int = int(
		row.get(
			"retry_count",
			0
		)
	)
	var report: Dictionary = (
		_request_realm_population_truth_shards(
			realm_id,
			realm_name,
			reason
		)
	)

	if bool(
		report.get(
			"success",
			false
		)
	):
		realm_population_observation_keys.erase(
			queue_key
		)
	elif retry_count < 120:
		row [
			"retry_count"
		] = retry_count + 1
		row [
			"last_retry_at_ms"
		] = int(
			Time.get_ticks_msec()
		)

		realm_population_observation_queue.append(
			row
		)
	else:
		realm_population_observation_keys.erase(
			queue_key
		)

	set_meta(
		"realm_population_observation_last_report",
		report.duplicate(false)
	)
	set_meta(
		"realm_population_observation_last_realm_id",
		realm_id
	)
	set_meta(
		"realm_population_observation_click_path_authority_call",
		false
	)

	if not realm_population_observation_queue.is_empty():
		_schedule_realm_population_observation_service(
			generation,
			0.048
		)
func _request_realm_population_truth_shards(
	realm_id: int,
	realm_name: String,
	reason: String = "realm_population_observation_request"
) -> Dictionary:
	if gs == null or realm_id <= 0:
		return {
			"success": false,
			"reason": "missing_game_state_or_invalid_realm",
			"realm_id": realm_id,
			"ui_is_expression_only": true
		}

	var resolved_realm_name: String = str(
		realm_name
	).strip_edges()

	if resolved_realm_name == "":
		resolved_realm_name = MainSceneLogic._crown_realm_name(gs, 
			realm_id
		)

	if resolved_realm_name == "":
		resolved_realm_name = (
			"Realm %d"
			% realm_id
		)

	var observation_context: Dictionary = {
		"source": reason,
		"reason": reason,
		"realm_id": realm_id,
		"realm_name": resolved_realm_name,
		"surface_already_exists": true,
		"ready_door_may_not_wait": true,
		"immutable_contract_references": true,
		"ephemeral_infrastructure_intent": true,
		"skip_global_intent_persistence": true,
		"skip_crr_observation": true,
		"authority_prevalidated": true,
		"skip_checks_and_balances": true,
		"background_only": true,
		"blocks_ui": false,
		"microtask_budget": 1,
		"ui_is_expression_only": true,
		"ui_is_renderer_only": true
	}

	return _express_global_ui_intent(
		{
			"intent_type": (
				"realm_population_observation_request"
			),
			"surface_id": (
				"realm_population_contract_panel"
			),
			"action_id": (
				"observe_realm_population_truth:%d"
				% realm_id
			),
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"background_only": true,
			"blocks_ui": false,
			"microtask_budget": 1,
			"payload": observation_context,
			"target": {
				"route_kind": "engine_method",
				"engine_property": "population_shard_engine",
				"method": (
					"enqueue_truth_resolution_shards_for_realm"
				),
				"args": [
					realm_id,
					resolved_realm_name,
					observation_context
				],
				"pass_actor_payload": false
			},
			"source": reason
		},
		{
			"source": reason,
			"surface_id": (
				"realm_population_contract_panel"
			),
			"action_id": (
				"observe_realm_population_truth:%d"
				% realm_id
			),
			"realm_id": realm_id,
			"realm_name": resolved_realm_name,
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"background_only": true,
			"blocks_ui": false,
			"microtask_budget": 1,
			"ui_is_expression_only": true
		}
	)
func _render_crown_population_ecosystem_surface(
	realm_id: int,
	realm_name: String
) -> void:
	if crown_action_popup_options == null:
		return

	_unmount_active_realm_population_contract_surface()

	_clear_container_children(
		crown_action_popup_options
	)

	var resolved_realm_name: String = str(
		realm_name
	).strip_edges()

	if resolved_realm_name == "":
		resolved_realm_name = MainSceneLogic._crown_realm_name(gs, 
			realm_id
		)

	if resolved_realm_name == "":
		resolved_realm_name = (
			"Realm %d"
			% realm_id
		)

	var element: String = (
		MainSceneLogic._crown_population_realm_element(gs, 
			realm_id,
			resolved_realm_name
		)
	)
	var accent: Color = (
		MainSceneHelpers._crown_population_element_color(
			element,
			_crown_hud_core_color()
		)
	)

	_set_crown_action_popup_population_surface_mode(
		true,
		accent
	)

	if crown_action_popup_title != null:
		crown_action_popup_title.text = (
			"REALM POPULATION • %s"
			% resolved_realm_name.to_upper()
		)

	if crown_action_popup_status != null:
		crown_action_popup_status.text = (
			"Population Lens: revealing the existing realm surface."
		)

	var panel:= (
		_ensure_realm_population_contract_panel()
	)

	if panel == null:
		if crown_action_popup_status != null:
			crown_action_popup_status.text = (
				"Population Lens provider is unavailable."
			)

		return

	if not panel.has_surface_for(
		realm_id,
		resolved_realm_name
	):
		panel.register_surface_shell(
			realm_id,
			resolved_realm_name,
			{
				"source": (
					"crown_population_click_surface_shell"
				),
				"realm_id": realm_id,
				"realm_name": resolved_realm_name,
				"truth_state": "partial",
				"click_path_build_forbidden": true,
				"click_path_materialization_forbidden": true,
				"ui_is_renderer_only": true
			}
		)

	var mounted: bool = (
		_mount_prebuilt_realm_population_contract_panel(
			realm_id,
			resolved_realm_name
		)
	)

	if not mounted:
		if crown_action_popup_status != null:
			crown_action_popup_status.text = (
				"Population Lens could not mount its observable surface shell."
			)

		var miss_label:= Label.new()

		miss_label.autowrap_mode = (
			TextServer.AUTOWRAP_WORD_SMART
		)
		miss_label.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		miss_label.text = (
			"The realm exists, but its lightweight population "
			+ "surface shell could not be mounted. No synchronous "
			+ "population build was attempted."
		)
		miss_label.add_theme_color_override(
			"font_color",
			Color(
				1.0,
				0.78,
				0.42,
				0.94
			)
		)

		crown_action_popup_options.add_child(
			miss_label
		)

		return



	var queue_report: Dictionary = (
		_queue_realm_population_truth_observation(
			realm_id,
			resolved_realm_name,
			"crown_population_surface_visible_truth_request"
		)
	)

	if crown_action_popup_status != null:
		if bool(
			queue_report.get(
				"success",
				false
			)
		):
			crown_action_popup_status.text = (
				"Population Lens: surface visible. Government, "
				+ "court, social-class, and citizen cards are "
				+ "publishing live."
			)
		else:
			crown_action_popup_status.text = (
				"Population Lens is visible. Its detached "
				+ "observation request has not entered the "
				+ "queue yet."
			)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"realm_population_click_reveal_only"
		] = true
		gs.scenario_state [
			"realm_population_click_realm_id"
		] = realm_id
		gs.scenario_state [
			"realm_population_click_realm_name"
		] = resolved_realm_name
		gs.scenario_state [
			"realm_population_click_surface_mounted_before_truth"
		] = true
		gs.scenario_state [
			"realm_population_click_truth_queue_report"
		] = queue_report.duplicate(false)
		gs.scenario_state [
			"realm_population_click_authority_invoked_synchronously"
		] = false
		gs.scenario_state [
			"realm_population_click_force_rebuild_forbidden"
		] = true
		gs.scenario_state [
			"realm_population_click_population_scan_forbidden"
		] = true
		gs.scenario_state [
			"realm_population_click_materialization_forbidden"
		] = true
		gs.scenario_state [
			"realm_population_click_ui_remained_interactive"
		] = true
		gs.scenario_state [
			"realm_population_click_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
func _mount_prebuilt_realm_population_contract_panel(
	realm_id: int,
	realm_name: String
) -> bool:
	var panel:= (
		_ensure_realm_population_contract_panel()
	)

	if panel == null:
		return false

	if not panel.has_surface_for(
		realm_id,
		realm_name
	):
		return false

	var mount_packet: Dictionary = (
		panel.mount_surface_for(
			realm_id,
			realm_name,
			crown_action_popup_options
		)
	)

	if not bool(
		mount_packet.get(
			"success",
			false
		)
	):
		return false

	var view_contract_raw: Variant = (
		mount_packet.get(
			"view_contract",
			{}
		)
	)
	var view_contract: Dictionary = (
		view_contract_raw as Dictionary
		if typeof(
			view_contract_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if view_contract.is_empty():
		return false

	var mounted_realm_id: int = int(
		mount_packet.get(
			"realm_id",
			realm_id
		)
	)
	var mounted_realm_name: String = str(
		view_contract.get(
			"realm_name",
			mount_packet.get(
				"realm_name",
				realm_name
			)
		)
	).strip_edges()

	if mounted_realm_name == "":
		mounted_realm_name = realm_name

	var element: String = str(
		view_contract.get(
			"element",
			MainSceneLogic._crown_population_realm_element(gs, 
				mounted_realm_id,
				mounted_realm_name
			)
		)
	)
	var accent: Color = (
		MainSceneHelpers._crown_population_element_color(
			element,
			_crown_hud_core_color()
		)
	)

	_set_crown_action_popup_population_surface_mode(
		true,
		accent
	)

	var graph_nodes_raw: Variant = (
		mount_packet.get(
			"graph_nodes",
			{}
		)
	)
	var graph_nodes: Dictionary = (
		graph_nodes_raw as Dictionary
		if typeof(
			graph_nodes_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var surface:= mount_packet.get(
		"surface",
		null
	) as Control

	if (
		surface != null
		and is_instance_valid(
			surface
		)
	):
		surface.visible = true
		surface.show()
		surface.mouse_filter = (
			Control.MOUSE_FILTER_PASS
		)
		surface.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		surface.size_flags_vertical = (
			Control.SIZE_EXPAND_FILL
		)
		surface.set_meta(
			"population_lens_mounted_from_realm_population_contract_panel",
			true
		)
		surface.set_meta(
			"population_lens_click_path_reveal_only",
			true
		)
		surface.set_meta(
			"population_lens_ui_build_on_press_forbidden",
			true
		)
		surface.set_meta(
			"population_lens_click_path_graph_scan_forbidden",
			true
		)
		surface.set_meta(
			"population_lens_click_path_projection_rebuild_forbidden",
			true
		)
		surface.set_meta(
			"population_lens_click_path_rebind_forbidden",
			true
		)

		if (
			graph_nodes.is_empty()
			and surface.has_meta(
				"population_lens_graph_nodes_prebound"
			)
		):
			var prebound_raw: Variant = surface.get_meta(
				"population_lens_graph_nodes_prebound",
				{}
			)

			if typeof(prebound_raw) == TYPE_DICTIONARY:
				graph_nodes = (
					prebound_raw as Dictionary
				)

	if crown_action_popup != null:
		crown_action_popup.set_meta(
			"crown_population_graph_nodes",
			graph_nodes
		)
		crown_action_popup.set_meta(
			"realm_population_view_contract",
			view_contract.duplicate(false)
		)
		crown_action_popup.set_meta(
			"realm_population_realm_id",
			mounted_realm_id
		)
		crown_action_popup.set_meta(
			"realm_population_realm_name",
			mounted_realm_name
		)
		crown_action_popup.set_meta(
			"population_lens_graph_nodes_mounted_from_prebound_index",
			true
		)
		crown_action_popup.set_meta(
			"population_lens_graph_click_path_scan_forbidden",
			true
		)
		crown_action_popup.set_meta(
			"population_lens_graph_click_path_rebind_forbidden",
			true
		)
		crown_action_popup.set_meta(
			"population_lens_graph_click_path_projection_rebuild_forbidden",
			true
		)
		crown_action_popup.set_meta(
			"population_lens_graph_node_count",
			graph_nodes.size()
		)

	crown_action_popup_title.text = (
		"REALM POPULATION • %s"
		% mounted_realm_name.to_upper()
	)
	crown_action_popup_status.text = (
		"Population Lens: resident shell mounted. "
		+ "Population cards are streaming live."
	)

	return true
func _set_crown_diplomacy_card_hover(
	entry_key: String,
	hovered: bool
) -> void:
	var packet: Dictionary = MainSceneHelpers._safe_dictionary(
		crown_hub_diplomacy_card_registry.get(
			entry_key,
			{}
		)
	)

	if packet.is_empty():
		return

	var card:= packet.get(
		"card",
		null
	) as PanelContainer
	var style:= packet.get(
		"style",
		null
	) as StyleBoxFlat
	var core_raw: Variant = packet.get(
		"core",
		Color(
			0.42,
			0.72,
			0.96,
			1.0
		)
	)
	var core: Color = (
		core_raw as Color
		if typeof(core_raw) == TYPE_COLOR
		else Color(
			0.42,
			0.72,
			0.96,
			1.0
		)
	)
	var selected: bool = (
		crown_hub_diplomacy_selected_entry_key
		== entry_key
	)

	if (
		card == null
		or not is_instance_valid(
			card
		)
		or style == null
	):
		return

	style.bg_color = Color(
		core.r * (
			0.17
			if hovered or selected
			else 0.1
		),
		core.g * (
			0.17
			if hovered or selected
			else 0.1
		),
		core.b * (
			0.19
			if hovered or selected
			else 0.12
		),
		0.98
	)
	style.border_color = Color(
		core.r,
		core.g,
		core.b,
		(
			1.0
			if hovered or selected
			else 0.86
		)
	)
	style.shadow_color = Color(
		core.r,
		core.g,
		core.b,
		(
			0.58
			if selected
			else (
				0.42
				if hovered
				else 0.2
			)
		)
	)
	style.shadow_size = (
		24
		if selected
		else (
			18
			if hovered
			else 12
		)
	)

	card.queue_redraw()
func _ensure_population_lens_incremental_section_grid(
	surface: Control,
	section_key: String,
	title_text: String,
	subtitle_text: String,
	accent: Color,
	columns: int
) -> GridContainer:
	if (
		surface == null
		or not is_instance_valid(
			surface
		)
	):
		return null

	var grids_raw: Variant = surface.get_meta(
		"population_incremental_section_grids",
		{}
	)
	var grids: Dictionary = (
		grids_raw as Dictionary
		if typeof(grids_raw) == TYPE_DICTIONARY
		else {}
	)
	var existing_grid:= grids.get(
		section_key,
		null
	) as GridContainer

	if (
		existing_grid != null
		and is_instance_valid(
			existing_grid
		)
	):
		return existing_grid

	var sections_root:= surface.get_meta(
		"population_incremental_sections_root",
		null
	) as VBoxContainer

	if (
		sections_root == null
		or not is_instance_valid(
			sections_root
		)
	):
		return null

	var panel:= PanelContainer.new()
	panel.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	sections_root.add_child(
		panel
	)

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(
		accent.r * 0.04,
		accent.g * 0.04,
		accent.b * 0.05,
		0.94
	)
	style.border_color = Color(
		accent.r,
		accent.g,
		accent.b,
		0.48
	)
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.corner_radius_top_left = 14
	style.corner_radius_top_right = 14
	style.corner_radius_bottom_left = 14
	style.corner_radius_bottom_right = 14
	panel.add_theme_stylebox_override(
		"panel",
		style
	)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override(
		"margin_left",
		8
	)
	margin.add_theme_constant_override(
		"margin_top",
		8
	)
	margin.add_theme_constant_override(
		"margin_right",
		8
	)
	margin.add_theme_constant_override(
		"margin_bottom",
		8
	)
	panel.add_child(
		margin
	)

	var box:= VBoxContainer.new()
	box.add_theme_constant_override(
		"separation",
		6
	)
	margin.add_child(
		box
	)

	var title:= Label.new()
	title.text = "%s • 0" % title_text
	title.add_theme_font_size_override(
		"font_size",
		16
	)
	title.add_theme_color_override(
		"font_color",
		accent
	)
	box.add_child(
		title
	)

	var subtitle:= Label.new()
	subtitle.text = subtitle_text
	subtitle.autowrap_mode = (
		TextServer.AUTOWRAP_WORD_SMART
	)
	subtitle.add_theme_font_size_override(
		"font_size",
		11
	)
	box.add_child(
		subtitle
	)

	var grid:= GridContainer.new()
	grid.columns = maxi(
		1,
		columns
	)
	grid.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	grid.add_theme_constant_override(
		"h_separation",
		6
	)
	grid.add_theme_constant_override(
		"v_separation",
		6
	)
	grid.set_meta(
		"population_incremental_section_title",
		title
	)
	grid.set_meta(
		"population_incremental_section_base_title",
		title_text
	)
	grid.set_meta(
		"population_incremental_section_key",
		section_key
	)
	grid.set_meta(
		"population_incremental_section_panel",
		panel
	)
	box.add_child(
		grid
	)

	grids [
		section_key
	] = grid

	surface.set_meta(
		"population_incremental_section_grids",
		grids
	)
	_reorder_population_lens_incremental_sections_from_contract(
		surface
	)
	return grid
func _park_crown_diplomacy_surface_resident() -> void:
		if (
			crown_hub_list == null
			or crown_hub_overlay == null
			or crown_hub_diplomacy_grid == null
			or not is_instance_valid(
				crown_hub_diplomacy_grid
			)
			or not crown_hub_diplomacy_resident_nodes.is_empty()
		):
			return

		var resident_nodes: Array = []

		for child in crown_hub_list.get_children():
			if child == null:
				continue

			crown_hub_list.remove_child(
				child
			)
			crown_hub_overlay.add_child(
				child
			)

			if child is CanvasItem:
				(
					child as CanvasItem
				).visible = false

			resident_nodes.append(
				child
			)

		crown_hub_diplomacy_resident_nodes = (
			resident_nodes
		)

		set_meta(
			"crown_diplomacy_surface_parked_resident",
			not resident_nodes.is_empty()
		)
		set_meta(
			"crown_diplomacy_surface_cards_destroyed_on_leave",
			false
		)
		set_meta(
			"crown_diplomacy_surface_card_count_parked",
			crown_hub_diplomacy_card_registry.size()
		)
func _restore_crown_diplomacy_surface_resident() -> bool:
		if (
			crown_hub_list == null
			or crown_hub_diplomacy_resident_nodes.is_empty()
		):
			return false

		_clear_container_children(
			crown_hub_list
		)

		var restored_count: int = 0

		for raw_node in crown_hub_diplomacy_resident_nodes:
			var node:= raw_node as Node

			if (
				node == null
				or not is_instance_valid(
					node
				)
			):
				continue

			var parent:= node.get_parent()

			if parent != null:
				parent.remove_child(
					node
				)

			crown_hub_list.add_child(
				node
			)

			if node is CanvasItem:
				(
					node as CanvasItem
				).visible = true

			restored_count += 1

		crown_hub_diplomacy_resident_nodes = []

		_apply_crown_diplomacy_filter_and_sort()

		set_meta(
			"crown_diplomacy_surface_parked_resident",
			false
		)
		set_meta(
			"crown_diplomacy_surface_restored_without_republish",
			restored_count > 0
		)
		set_meta(
			"crown_diplomacy_surface_restore_card_count",
			crown_hub_diplomacy_card_registry.size()
		)

		return restored_count > 0
func _population_lens_viewer_apply_incremental_realm_population_contract(
	surface: Control,
	realm_id: int,
	realm_name: String,
	view_contract: Dictionary,
	_context: Dictionary = {}
) -> Dictionary:
	if (
		surface == null
		or not is_instance_valid(
			surface
		)
		or realm_id <= 0
		or view_contract.is_empty()
	):
		return {
			"success": false,
			"reason": (
				"invalid_incremental_population_surface"
			),
			"complete": true,
			"ui_is_renderer_only": true
		}

	var element: String = str(
		view_contract.get(
			"element",
			MainSceneLogic._crown_population_realm_element(gs, 
				realm_id,
				realm_name
			)
		)
	)
	var realm_accent: Color = (
		MainSceneHelpers._crown_population_element_color(
			element,
			_crown_hud_core_color()
		)
	)
	var federal_republic: bool = (
		bool(
			view_contract.get(
				"federal_republic_population_contract",
				false
			)
		)
		or MainSceneLogic._crown_population_uses_federal_republic_lens(gs, 
			realm_id,
			realm_name
		)
	)

	var pending_raw: Variant = surface.get_meta(
		"population_incremental_pending_rows",
		[]
	)
	var pending_rows: Array = (
		pending_raw as Array
		if typeof(pending_raw) == TYPE_ARRAY
		else []
	)

	var rendered_raw: Variant = surface.get_meta(
		"population_incremental_rendered_entity_ids",
		{}
	)
	var rendered_ids: Dictionary = (
		rendered_raw as Dictionary
		if typeof(rendered_raw) == TYPE_DICTIONARY
		else {}
	)

	var queued_raw: Variant = surface.get_meta(
		"population_incremental_queued_entity_ids",
		{}
	)
	var queued_ids: Dictionary = (
		queued_raw as Dictionary
		if typeof(queued_raw) == TYPE_DICTIONARY
		else {}
	)

	var cards_raw: Variant = surface.get_meta(
		"population_incremental_card_by_entity_id",
		{}
	)
	var card_by_entity_id: Dictionary = (
		cards_raw as Dictionary
		if typeof(cards_raw) == TYPE_DICTIONARY
		else {}
	)

	var removed_raw: Variant = view_contract.get(
		"removed_entity_ids",
		[]
	)
	var removed_entity_ids: Array = (
		removed_raw as Array
		if typeof(removed_raw) == TYPE_ARRAY
		else []
	)
	var replaced_raw: Variant = view_contract.get(
		"replaced_entity_ids",
		[]
	)
	var replaced_entity_ids: Array = (
		replaced_raw as Array
		if typeof(replaced_raw) == TYPE_ARRAY
		else []
	)

	var contract_signature: String = (
		"%d:%d:%d:%d:%d:%s"
		% [
			realm_id,
			int(
				view_contract.get(
					"built_at_ms",
					0
				)
			),
			int(
				view_contract.get(
					"delta_row_count",
					0
				)
			),
			removed_entity_ids.size(),
			replaced_entity_ids.size(),
			str(
				view_contract.get(
					"truth_state",
					"partial"
				)
			)
		]
	)
	var ingested_signature: String = str(
		surface.get_meta(
			"population_incremental_ingested_contract_signature",
			""
		)
	)
	var ingest_new_delta: bool = (
		contract_signature != ingested_signature
	)

	if ingest_new_delta:
		var invalidated_ids: Dictionary = {}
		for raw_identity in removed_entity_ids:
			invalidated_ids [
				str(raw_identity)
			] = true
		for raw_identity in replaced_entity_ids:
			invalidated_ids [
				str(raw_identity)
			] = true

		if not invalidated_ids.is_empty():
			var retained_pending: Array = []
			for raw_pending in pending_rows:
				if typeof(raw_pending) != TYPE_DICTIONARY:
					continue

				var pending_job: Dictionary = (
					raw_pending as Dictionary
				)
				var pending_identity: String = str(
					pending_job.get(
						"identity",
						""
					)
				)
				if invalidated_ids.has(
					pending_identity
				):
					continue
				retained_pending.append(
					pending_job
				)

			pending_rows = retained_pending

			for raw_identity in invalidated_ids.keys():
				var identity: String = str(
					raw_identity
				)
				var mounted:= card_by_entity_id.get(
					identity,
					null
				) as Control

				if (
					mounted != null
					and is_instance_valid(
						mounted
					)
				):
					var mounted_parent:= (
						mounted.get_parent()
					)
					if mounted_parent != null:
						mounted_parent.remove_child(
							mounted
						)
					mounted.queue_free()

				card_by_entity_id.erase(
					identity
				)
				rendered_ids.erase(
					identity
				)
				queued_ids.erase(
					identity
				)

		var specs: Array = (
			MainSceneLogic._population_lens_incremental_section_specs(
				view_contract,
				realm_accent,
				element,
				federal_republic
			)
		)

		for raw_spec in specs:
			if typeof(raw_spec) != TYPE_DICTIONARY:
				continue

			var spec: Dictionary = raw_spec as Dictionary
			var rows_raw: Variant = spec.get(
				"rows",
				[]
			)
			if typeof(rows_raw) != TYPE_ARRAY:
				continue

			for raw_row in rows_raw as Array:
				var candidate_identity: String = (
					MainSceneHelpers._population_lens_incremental_entity_key(
						raw_row
					)
				)
				if (
					candidate_identity == ""
					or rendered_ids.has(
						candidate_identity
					)
					or queued_ids.has(
						candidate_identity
					)
				):
					continue

				var queued_job: Dictionary = (
					spec.duplicate(false)
				)
				queued_job.erase(
					"rows"
				)
				queued_job ["row"] = raw_row
				queued_job ["identity"] = (
					candidate_identity
				)

				pending_rows.append(
					queued_job
				)
				queued_ids [candidate_identity] = true

		surface.set_meta(
			"population_incremental_ingested_contract_signature",
			contract_signature
		)
		surface.set_meta(
			"population_incremental_contract_signature",
			contract_signature
		)
		surface.set_meta(
			"realm_population_view_contract",
			view_contract
		)

		var sections_raw: Variant = view_contract.get(
			"population_section_contracts",
			[]
		)
		surface.set_meta(
			"population_sections_are_contract_driven",
			(
				typeof(sections_raw) == TYPE_ARRAY
				and not (
					sections_raw as Array
				).is_empty()
			)
		)

	surface.set_meta(
		"population_incremental_pending_rows",
		pending_rows
	)
	surface.set_meta(
		"population_incremental_queued_entity_ids",
		queued_ids
	)
	surface.set_meta(
		"population_incremental_rendered_entity_ids",
		rendered_ids
	)
	surface.set_meta(
		"population_incremental_card_by_entity_id",
		card_by_entity_id
	)

	if pending_rows.is_empty():
		var final_status:= surface.get_meta(
			"population_incremental_status_label",
			null
		) as Label
		if (
			final_status != null
			and is_instance_valid(
				final_status
			)
		):
			final_status.text = (
				"%d population cards are resident."
				% rendered_ids.size()
			)

		surface.set_meta(
			"realm_population_truth_state",
			(
				"hot"
				if bool(
					view_contract.get(
						"truth_complete",
						false
					)
				)
				else "partial"
			)
		)
		surface.set_meta(
			"realm_population_runtime_hydration_pending",
			false
		)

		return {
			"success": true,
			"complete": true,
			"realm_id": realm_id,
			"rendered": rendered_ids.size(),
			"remaining": 0,
			"removed": removed_entity_ids.size(),
			"replaced": replaced_entity_ids.size(),
			"renderer_delta_ingested_once": true,
			"one_card_per_timer_quantum": true,
			"ui_is_renderer_only": true
		}

	var active_job_raw: Variant = (
		pending_rows.pop_front()
	)
	var active_job: Dictionary = (
		active_job_raw as Dictionary
		if typeof(active_job_raw) == TYPE_DICTIONARY
		else {}
	)
	var active_identity: String = str(
		active_job.get(
			"identity",
			""
		)
	)
	var section_key: String = str(
		active_job.get(
			"key",
			"population"
		)
	)
	var section_kind: String = str(
		active_job.get(
			"section_kind",
			section_key
		)
	)

	var accent_raw: Variant = active_job.get(
		"accent",
		realm_accent
	)
	var accent: Color = (
		accent_raw as Color
		if typeof(accent_raw) == TYPE_COLOR
		else realm_accent
	)

	var grid: GridContainer = (
		_ensure_population_lens_incremental_section_grid(
			surface,
			section_key,
			str(
				active_job.get(
					"title",
					"POPULATION"
				)
			),
			str(
				active_job.get(
					"subtitle",
					""
				)
			),
			accent,
			int(
				active_job.get(
					"columns",
					5
				)
			)
		)
	)

	var row: Variant = active_job.get(
		"row",
		null
	)
	var before_child_count: int = (
		grid.get_child_count()
		if (
			grid != null
			and is_instance_valid(
				grid
			)
		)
		else 0
	)

	if (
		grid != null
		and is_instance_valid(
			grid
		)
	):
		if row is Person:
			_append_crown_population_capsule(
				grid,
				row as Person,
				realm_id,
				section_kind,
				accent,
				float(
					active_job.get(
						"glow",
						0.16
					)
				),
				element
			)
		elif typeof(row) == TYPE_DICTIONARY:
			_append_crown_population_observable_node_capsule(
				grid,
				row as Dictionary,
				realm_id,
				section_kind,
				accent,
				float(
					active_job.get(
						"glow",
						0.16
					)
				),
				element
			)

		if (
			active_identity != ""
			and grid.get_child_count() > before_child_count
		):
			var mounted_card:= grid.get_child(
				grid.get_child_count() - 1
			) as Control
			if mounted_card != null:
				card_by_entity_id [
					active_identity
				] = mounted_card

	if active_identity != "":
		rendered_ids [active_identity] = true
		queued_ids.erase(
			active_identity
		)

	var rendered_count: int = rendered_ids.size()
	var publication_checkpoint: bool = (
		rendered_count % 8 == 0
		or pending_rows.is_empty()
	)

	if (
		publication_checkpoint
		and grid != null
		and is_instance_valid(
			grid
		)
	):
		var title_label:= grid.get_meta(
			"population_incremental_section_title",
			null
		) as Label
		if (
			title_label != null
			and is_instance_valid(
				title_label
			)
		):
			title_label.text = "%s • %d" % [
				str(
					grid.get_meta(
						"population_incremental_section_base_title",
						"POPULATION"
					)
				),
				grid.get_child_count()
			]

	surface.set_meta(
		"population_incremental_pending_rows",
		pending_rows
	)
	surface.set_meta(
		"population_incremental_rendered_entity_ids",
		rendered_ids
	)
	surface.set_meta(
		"population_incremental_queued_entity_ids",
		queued_ids
	)
	surface.set_meta(
		"population_incremental_card_by_entity_id",
		card_by_entity_id
	)
	surface.set_meta(
		"population_incremental_cards_rendered",
		rendered_count
	)
	surface.set_meta(
		"realm_population_truth_state",
		(
			"hot"
			if (
				pending_rows.is_empty()
				and bool(
					view_contract.get(
						"truth_complete",
						false
					)
				)
			)
			else "partial"
		)
	)
	surface.set_meta(
		"realm_population_runtime_hydration_pending",
		not pending_rows.is_empty()
	)

	if publication_checkpoint:
		var status_label:= surface.get_meta(
			"population_incremental_status_label",
			null
		) as Label
		if (
			status_label != null
			and is_instance_valid(
				status_label
			)
		):
			status_label.text = (
				"%d cards published • %d queued"
				% [
					rendered_count,
					pending_rows.size()
				]
			)

	return {
		"success": true,
		"complete": pending_rows.is_empty(),
		"realm_id": realm_id,
		"rendered": rendered_count,
		"remaining": pending_rows.size(),
		"removed": removed_entity_ids.size(),
		"replaced": replaced_entity_ids.size(),
		"renderer_delta_ingested_once": true,
		"status_layout_update_checkpoint": (
			publication_checkpoint
		),
		"one_card_per_timer_quantum": true,
		"ui_is_renderer_only": true
	}
func _population_lens_viewer_build_realm_population_surface(
	realm_id: int,
	realm_name: String,
	view_contract: Dictionary,
	reason: String = "population_lens_viewer_surface_build"
) -> Control:
	return _build_crown_population_ecosystem_surface_node(
		realm_id,
		realm_name,
		view_contract,
		reason
	)


func _population_lens_viewer_commit_graph_node_index(
	graph_nodes: Dictionary,
	view_contract: Dictionary = {}
) -> Dictionary:
	if crown_action_popup == null:
		return {
			"success": false,
			"reason": "missing_crown_action_popup"
		}

	crown_action_popup.set_meta("crown_population_graph_nodes", graph_nodes.duplicate(true))
	crown_action_popup.set_meta(
		"crown_population_graph_contracts",
		view_contract.get("graph_node_contracts", {}).duplicate(true) if typeof(view_contract.get("graph_node_contracts", {})) == TYPE_DICTIONARY else {}
	)
	crown_action_popup.set_meta("population_lens_graph_nodes_mounted_from_prebound_index", true)
	crown_action_popup.set_meta("population_lens_graph_click_path_scan_forbidden", true)
	crown_action_popup.set_meta("population_lens_graph_node_count", graph_nodes.size())

	if bool(crown_action_popup.get_meta("crown_population_graph_active", false)):
		_refresh_crown_population_graph_hover_from_meta()

	return {
		"success": true,
		"graph_node_count": graph_nodes.size(),
		"ui_is_renderer_only": true,
	}
func _build_crown_population_ecosystem_surface_node(
	realm_id: int,
	realm_name: String,
	view_contract: Dictionary,
	reason: String = "realm_population_surface_build"
) -> Control:
	var element: String = str(view_contract.get("element", MainSceneLogic._crown_population_realm_element(gs, realm_id, realm_name)))
	var accent: Color = MainSceneHelpers._crown_population_element_color(element, _crown_hud_core_color())

	var royals: Array = view_contract.get("royals", view_contract.get("officials", [])) if typeof(view_contract.get("royals", view_contract.get("officials", []))) == TYPE_ARRAY else []
	var nobles: Array = view_contract.get("nobles", []) if typeof(view_contract.get("nobles", [])) == TYPE_ARRAY else []
	var masters: Array = view_contract.get("masters", []) if typeof(view_contract.get("masters", [])) == TYPE_ARRAY else []
	var citizens: Array = view_contract.get("citizens", []) if typeof(view_contract.get("citizens", [])) == TYPE_ARRAY else []

	var federal_republic: bool = bool(view_contract.get("federal_republic_population_contract", false)) \
or MainSceneLogic._crown_population_uses_federal_republic_lens(gs, realm_id, realm_name)
	var federal_executive: Array = view_contract.get("federal_executive", []) if typeof(view_contract.get("federal_executive", [])) == TYPE_ARRAY else []
	var federal_cabinet: Array = view_contract.get("federal_cabinet", []) if typeof(view_contract.get("federal_cabinet", [])) == TYPE_ARRAY else []
	var federal_senate: Array = view_contract.get("federal_senate", []) if typeof(view_contract.get("federal_senate", [])) == TYPE_ARRAY else []
	var federal_supreme_court: Array = view_contract.get("federal_supreme_court", []) if typeof(view_contract.get("federal_supreme_court", [])) == TYPE_ARRAY else []
	var federal_governors: Array = view_contract.get("federal_governors", []) if typeof(view_contract.get("federal_governors", [])) == TYPE_ARRAY else []
	if federal_republic:
		if federal_executive.is_empty() and not royals.is_empty():
			federal_executive = royals.duplicate(true)

		royals = []
		nobles = []
		masters = []
	var root:= VBoxContainer.new()
	root.name = "RealmPopulationContractSurface_%d" % realm_id
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.size_flags_vertical = Control.SIZE_EXPAND_FILL
	root.custom_minimum_size = Vector2(0, 0)
	root.add_theme_constant_override("separation", 10)
	root.set_meta("realm_population_contract_surface", true)
	root.set_meta("realm_population_realm_id", realm_id)
	root.set_meta("realm_population_realm_name", realm_name)
	root.set_meta("realm_population_view_contract", view_contract.duplicate(true))
	root.set_meta("realm_population_surface_build_reason", reason)
	root.set_meta("ui_build_on_press_forbidden", true)
	root.set_meta("surface_is_prebuilt", true)

	var overview:= PanelContainer.new()
	overview.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_child(overview)

	var overview_style:= StyleBoxFlat.new()
	overview_style.bg_color = Color(accent.r * 0.08, accent.g * 0.07, accent.b * 0.1, 0.96)
	overview_style.border_width_left = 2
	overview_style.border_width_top = 2
	overview_style.border_width_right = 2
	overview_style.border_width_bottom = 2
	overview_style.border_color = Color(accent.r, accent.g, accent.b, 0.76)
	overview_style.corner_radius_top_left = 20
	overview_style.corner_radius_top_right = 20
	overview_style.corner_radius_bottom_left = 20
	overview_style.corner_radius_bottom_right = 20
	overview.add_theme_stylebox_override("panel", overview_style)

	var overview_margin:= MarginContainer.new()
	overview_margin.add_theme_constant_override("margin_left", 12)
	overview_margin.add_theme_constant_override("margin_top", 10)
	overview_margin.add_theme_constant_override("margin_right", 12)
	overview_margin.add_theme_constant_override("margin_bottom", 10)
	overview.add_child(overview_margin)

	var overview_box:= VBoxContainer.new()
	overview_box.add_theme_constant_override("separation", 6)
	overview_margin.add_child(overview_box)

	var headline:= Label.new()
	headline.text = "LIVING POLITICAL ECOSYSTEM"
	headline.add_theme_font_size_override("font_size", 20)
	headline.add_theme_color_override("font_color", Color(accent.r, accent.g, accent.b, 1.0))
	overview_box.add_child(headline)

	var subline:= Label.new()
	if federal_republic:
		subline.text = "Federal executive, cabinet, senate, supreme court, state governors, and civilian strata are rendered from a hot federal republic population packet. Browse Population is a door, not a build request."
	else:
		subline.text = "Royal court, noble court, elemental masters, and civilian strata are rendered from a hot RealmPopulationContractPanel surface. Browse Population is a door, not a build request."
	subline.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	subline.add_theme_color_override("font_color", Color(0.86, 0.9, 1.0, 0.78))
	overview_box.add_child(subline)

	var countline:= Label.new()
	if federal_republic:
		countline.text = "Visible federal wall: %d executive • %d cabinet • %d senators • %d justices • %d governors • %d citizens" % [
			federal_executive.size(),
			federal_cabinet.size(),
			federal_senate.size(),
			federal_supreme_court.size(),
			federal_governors.size(),
			citizens.size()
		]
	else:
		countline.text = "Visible wall: %d royals • %d nobles • %d masters • %d citizens" % [
			royals.size(),
			nobles.size(),
			masters.size(),
			citizens.size()
		]
	countline.add_theme_color_override("font_color", Color(1.0, 0.94, 0.72, 0.9))
	overview_box.add_child(countline)

	var stability_toggle:= Button.new()
	stability_toggle.text = "Hide Realm Stability" if crown_action_popup != null and bool(crown_action_popup.get_meta("realm_stability_overlay_enabled", false)) else "Show Realm Stability"
	stability_toggle.custom_minimum_size = Vector2(0, 34)
	stability_toggle.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	MainSceneLogic._apply_crown_population_name_button_style(stability_toggle, null, "official", accent, Color(1.0, 0.58, 0.28, 1.0))
	stability_toggle.pressed.connect(
		Callable(self, "_toggle_crown_population_realm_stability_overlay").bind(realm_id, realm_name)
	)
	overview_box.add_child(stability_toggle)

	if crown_action_popup != null and bool(crown_action_popup.get_meta("realm_stability_overlay_enabled", false)):
		_append_crown_population_realm_stability_overlay(root, realm_id, royals, nobles, masters, citizens, accent, realm_name)
	if federal_republic:
		_append_crown_population_section(
			root,
			"EXECUTIVE OFFICE",
			"President and First Lady sit together at the top of the federal civic wall.",
			federal_executive,
			realm_id,
			"federal_executive",
			Color(0.34, 0.56, 1.0, 1.0),
			0.36,
			element
		)

		_append_crown_population_section(
			root,
			"PRESIDENT'S CABINET",
			"Federal executive department leadership. These cards are civic contract roles, not royal or noble court cards.",
			federal_cabinet,
			realm_id,
			"federal_cabinet",
			Color(0.42, 0.66, 1.0, 1.0),
			0.24,
			element
		)

		_append_crown_population_section(
			root,
			"SENATE",
			"One hundred senators: two per geographical state. State assignment is stored in the card contract metadata.",
			federal_senate,
			realm_id,
			"federal_senate",
			Color(0.38, 0.54, 0.98, 1.0),
			0.2,
			element
		)

		_append_crown_population_section(
			root,
			"SUPREME COURT",
			"Nine Supreme Court justices. Judicial authority is rendered as a separate federal branch, not as noble court.",
			federal_supreme_court,
			realm_id,
			"federal_supreme_court",
			Color(0.7, 0.56, 1.0, 1.0),
			0.22,
			element
		)

		_append_crown_population_section(
			root,
			"STATE GOVERNORS",
			"Fifty state governors: one per geographical state. Governors sit below the federal branches but above regular citizens.",
			federal_governors,
			realm_id,
			"federal_governor",
			Color(0.48, 0.82, 0.62, 1.0),
			0.18,
			element
		)

		_append_crown_population_citizen_strata_sections(
			root,
			citizens,
			realm_id,
			realm_name,
			accent,
			element
		)

		return root

	_append_crown_population_section(
		root,
		"ROYAL COURT",
		"Larger golden capsules. These are only the ruler, ruler partner, direct heirs, princes, princesses, and explicit sovereignty titles.",
		royals,
		realm_id,
		"official",
		Color(1.0, 0.78, 0.24, 1.0),
		0.34,
		element
	)

	_append_crown_population_section(
		root,
		"NOBLE COURT",
		"Dukes, Duchesses, Marquesses, Marchionesses, Lords, Ladies, high nobles, and ducal houses sit below the royal court but above regular citizens.",
		nobles,
		realm_id,
		"noble",
		Color(0.78, 0.56, 1.0, 1.0),
		0.28,
		element
	)

	if element != "":
		_append_crown_population_section(
			root,
			"%s BENDING MASTERS" % element.to_upper(),
			"Elemental power sits beneath court authority and is queried from active realm-aligned benders, not generated by the UI.",
			masters,
			realm_id,
			"master",
			accent,
			0.42,
			element
		)

	_append_crown_population_citizen_strata_sections(
		root,
		citizens,
		realm_id,
		realm_name,
		accent,
		element
	)

	return root
func _append_crown_population_full_target_action(parent: Control, label_text: String, option_id: String, payload: Dictionary, accent: Color = Color(0.78, 0.56, 1.0, 1.0)) -> void:
	var button:= Button.new()
	button.text = label_text
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.custom_minimum_size = Vector2(0, 38)

	MainSceneLogic._apply_crown_population_name_button_style(button, null, "official", accent, accent)
	button.pressed.connect(_on_crown_popup_option_pressed.bind(option_id, payload.duplicate(true)))
	parent.add_child(button)


func _set_crown_population_full_target_bucket_hover_state(bucket: PanelContainer, accent: Color, hovered: bool) -> void:
	if bucket == null or not is_instance_valid(bucket):
		return

	bucket.add_theme_stylebox_override("panel", MainSceneHelpers._crown_population_full_target_bucket_style(accent, hovered))


func _append_crown_population_full_target_bucket(parent: Control, title_text: String, actions: Array, payload: Dictionary, accent: Color) -> void:
	var bucket_accent: Color = MainSceneHelpers._crown_population_full_target_bucket_color(title_text, accent)

	var bucket:= PanelContainer.new()
	bucket.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bucket.mouse_filter = Control.MOUSE_FILTER_PASS
	parent.add_child(bucket)

	bucket.add_theme_stylebox_override("panel", MainSceneHelpers._crown_population_full_target_bucket_style(bucket_accent, false))
	bucket.mouse_entered.connect(_set_crown_population_full_target_bucket_hover_state.bind(bucket, bucket_accent, true))
	bucket.mouse_exited.connect(_set_crown_population_full_target_bucket_hover_state.bind(bucket, bucket_accent, false))

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 10)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 10)
	margin.add_theme_constant_override("margin_bottom", 10)
	bucket.add_child(margin)

	var box:= VBoxContainer.new()
	box.add_theme_constant_override("separation", 8)
	margin.add_child(box)

	var title:= Label.new()
	title.text = title_text
	title.add_theme_font_size_override("font_size", 14)
	title.add_theme_color_override("font_color", Color(bucket_accent.r, bucket_accent.g, bucket_accent.b, 1.0))
	box.add_child(title)

	for raw_action in actions:
		if typeof(raw_action) != TYPE_DICTIONARY:
			continue

		var action: Dictionary = raw_action
		_append_crown_population_full_target_action(
			box,
			str(action.get("label", "Action")),
			str(action.get("option_id", "")),
			payload,
			bucket_accent
		)

func _render_crown_population_full_target_surface(target: Person, payload: Dictionary) -> void:
	if crown_action_popup_options == null or target == null:
		return

	_clear_container_children(crown_action_popup_options)

	var realm_id: int = int(payload.get("target_realm_id", target.realm_id))
	if realm_id <= 0:
		realm_id = int(target.realm_id)

	var realm_name: String = MainSceneLogic._crown_realm_name(gs, realm_id)
	var element: String = MainSceneLogic._crown_population_realm_element(gs, realm_id, realm_name)
	var accent: Color = MainSceneHelpers._crown_population_element_color(element, _crown_hud_core_color())
	var removal_label: String = MainSceneHelpers._build_crown_population_removal_label(target)

	_set_crown_action_popup_population_surface_mode(true, accent)

	crown_action_popup_title.text = "POPULATION TARGET • %s" % _relationship_display_name(target).to_upper()
	crown_action_popup_status.text = ""

	var root:= VBoxContainer.new()
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_theme_constant_override("separation", 14)
	crown_action_popup_options.add_child(root)
	var nav_row:= HBoxContainer.new()
	nav_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nav_row.add_theme_constant_override("separation", 8)
	root.add_child(nav_row)

	var back_button:= Button.new()
	back_button.text = "← Back to Realm Population"
	back_button.custom_minimum_size = Vector2(210, 38)
	MainSceneLogic._apply_crown_population_name_button_style(back_button, target, "official", accent, Color(1.0, 0.78, 0.24, 1.0))
	back_button.pressed.connect(_render_crown_population_ecosystem_surface.bind(realm_id, realm_name))
	nav_row.add_child(back_button)

	var nav_spacer:= Control.new()
	nav_spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nav_row.add_child(nav_spacer)

	var close_hint:= Label.new()
	close_hint.text = "Close Realm Wall stays on the opposite edge."
	close_hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	close_hint.add_theme_font_size_override("font_size", 10)
	close_hint.add_theme_color_override("font_color", Color(0.86, 0.9, 1.0, 0.66))
	nav_row.add_child(close_hint)
	var hero:= PanelContainer.new()
	hero.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_child(hero)
	var target_section_kind: String = "master" if MainSceneLogic._is_crown_population_element_master(gs, target, realm_id, element) else "noble" if _is_crown_population_noble_court_member(target, realm_id) else "official" if _is_crown_realm_official(target, realm_id) else "citizen"
	hero.add_theme_stylebox_override("panel", _crown_population_card_style(target, target_section_kind, accent, 0.34, true, false, realm_id, element, realm_name))

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 14)
	margin.add_theme_constant_override("margin_right", 16)
	margin.add_theme_constant_override("margin_bottom", 14)
	hero.add_child(margin)

	var hero_box:= VBoxContainer.new()
	hero_box.add_theme_constant_override("separation", 8)
	margin.add_child(hero_box)

	var role_label: String = _crown_population_role_label(
		target,
		realm_id,
		"master" if MainSceneLogic._is_crown_population_element_master(gs, target, realm_id, element) else "official" if _is_crown_realm_official(target, realm_id) else "citizen",
		element
	)

	var headline:= Label.new()
	headline.text = "%s • %s • Age %d" % [
		_relationship_display_name(target),
		role_label,
		int(target.age)
	]
	headline.add_theme_font_size_override("font_size", 22)
	headline.add_theme_color_override("font_color", Color(1.0, 0.94, 0.72, 1.0))
	hero_box.add_child(headline)

	var context:= Label.new()
	context.text = "Realm: %s • Bloodline: %s • %s" % [
		realm_name,
		MainSceneHelpers._crown_population_bloodline_key(target),
		MainSceneLogic._crown_population_current_action_text(target)
	]
	context.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	context.add_theme_color_override("font_color", Color(0.86, 0.9, 1.0, 0.82))
	hero_box.add_child(context)

	var status_grid:= GridContainer.new()
	status_grid.columns = 4
	status_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hero_box.add_child(status_grid)

	var target_power_contract: Dictionary = _crown_population_power_map_contract(target, realm_id, target_section_kind, element, realm_name)
	_append_crown_population_status_bar(status_grid, "Health", clampi(int(round(float(target.health))), 0, 100), accent)
	_append_crown_population_status_bar(status_grid, "Hunger", clampi(int(round(float(target.hunger))), 0, 100), accent)
	_append_crown_population_status_bar(status_grid, "Mental", clampi(int(round(float(target.mental_health))), 0, 100), accent)
	_append_crown_population_status_bar(status_grid, "Influence", int(target_power_contract.get("influence", 0)), accent)
	_append_crown_population_status_bar(status_grid, "Succession", int(target_power_contract.get("succession_pressure", 0)), accent)
	_append_crown_population_status_bar(status_grid, "Approval", clampi(int(target.approval), 0, 100), accent)

	var lower_grid:= GridContainer.new()
	lower_grid.columns = 2
	lower_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lower_grid.add_theme_constant_override("h_separation", 12)
	lower_grid.add_theme_constant_override("v_separation", 12)
	root.add_child(lower_grid)

	var relation_panel:= PanelContainer.new()
	relation_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lower_grid.add_child(relation_panel)

	var relation_margin:= MarginContainer.new()
	relation_margin.add_theme_constant_override("margin_left", 12)
	relation_margin.add_theme_constant_override("margin_top", 12)
	relation_margin.add_theme_constant_override("margin_right", 12)
	relation_margin.add_theme_constant_override("margin_bottom", 12)
	relation_panel.add_child(relation_margin)

	var relation_box:= VBoxContainer.new()
	relation_box.add_theme_constant_override("separation", 8)
	relation_margin.add_child(relation_box)
	_append_crown_population_relationship_cards(relation_box, target, MainSceneLogic._crown_population_bloodline_color(target, accent))

	var action_grid:= GridContainer.new()
	action_grid.columns = 3
	action_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_child(action_grid)

	_append_crown_population_full_target_bucket(
		action_grid,
		"PROFILE LENS",
		[
			{ "label": "Open Profile", "option_id": "population_open_profile"}
		],
		payload,
		accent
	)

	_append_crown_population_full_target_bucket(
		action_grid,
		"COURT LEVERAGE",
		[
			{ "label": "Recruit", "option_id": "population_recruit"},
			{ "label": "Spy On", "option_id": "population_spy"}
		],
		payload,
		accent
	)

	_append_crown_population_full_target_bucket(
		action_grid,
		"DYNASTY / FAMILY",
		[
			{ "label": "Marry Into", "option_id": "population_marry_into"},
			{ "label": "Assign Royal Title", "option_id": "route:population_promote"}
		],
		payload,
		accent
	)

	_append_crown_population_full_target_bucket(
		action_grid,
		"STATE FORCE",
		[
			{ "label": "Exile", "option_id": "population_exile"},
			{ "label": removal_label, "option_id": "route:population_remove_target"}
		],
		payload,
		accent
	)
func _show_crown_action_popup(action_id: String, payload: Dictionary = {}) -> void:
	if action_id in ["court", "diplomacy"]:
		_set_crown_hub_section(action_id)
		return
	_ensure_crown_action_popup()
	if crown_action_popup == null:
		return

	_set_crown_action_popup_population_surface_mode(action_id in ["population", "population_profile"])

	crown_action_popup_context = {
		"action_id": action_id,
		"payload": payload.duplicate(true)
	}
	crown_action_popup.visible = true
	crown_action_popup_dim.visible = true
	crown_action_popup_body.clear()
	crown_action_popup_input.text = ""
	crown_action_popup_input.visible = false
	crown_action_popup_confirm_button.visible = false
	crown_action_popup_status.text = ""

	_unmount_active_realm_population_contract_surface()
	_clear_container_children(crown_action_popup_options)

	var summary: Dictionary = (
		_crown_hub_cached_summary()
	)

	if summary.is_empty():
		summary = MainSceneHelpers._safe_dictionary(
			crown_hub_active_contract.get(
				"summary",
				{}
			)
		)
	var target_realm_id: int = int(payload.get("target_realm_id", -1))
	var target_realm_name: String = MainSceneLogic._crown_realm_name(gs, target_realm_id)

	match action_id:
		"mediate_citizens":
			var mediation_case: Dictionary = _build_crown_mediation_case()
			crown_action_popup_title.text = "MEDIATE YOUR CITIZENS"
			crown_action_popup_body.append_text(str(mediation_case.get("intro", "Two citizens have come before the throne.")) + "\n\n")
			crown_action_popup_body.append_text(str(mediation_case.get("left_summary", "")) + "\n")
			crown_action_popup_body.append_text(str(mediation_case.get("right_summary", "")) + "\n\n")
			crown_action_popup_body.append_text(str(mediation_case.get("dispute", "")) + "\n\n")
			crown_action_popup_body.append_text("Choose the response that lowers heat without humiliating either side.\n")

			for raw_choice in MainSceneHelpers._safe_array(mediation_case.get("choices", [])):
				if typeof(raw_choice) != TYPE_DICTIONARY:
					continue
				var choice: Dictionary = raw_choice
				var choice_payload: Dictionary = mediation_case.duplicate(true)
				choice_payload ["choice"] = choice.duplicate(true)
				_append_crown_popup_option(str(choice.get("label", "Respond")), "mediate_citizens_choice", choice_payload)

		"law_review":
			var law_proposal: Dictionary = MainSceneLogic._build_crown_law_review_proposal(gs)
			crown_action_popup_title.text = "LAW REVIEW"
			crown_action_popup_body.append_text("%s\n\n" % str(law_proposal.get("title", "Proposed Law")))
			crown_action_popup_body.append_text("%s\n\n" % str(law_proposal.get("description", "The court has brought a law before you.")))
			crown_action_popup_body.append_text("Court reading: %s\n" % str(law_proposal.get("court_reading", "The realm is watching.")))
			crown_action_popup_body.append_text("Risk: %s\n" % str(law_proposal.get("risk_label", "Moderate")))
			crown_action_popup_body.append_text("Era: %s\n\n" % str(law_proposal.get("era", "Modern")))

			_append_crown_popup_option("Sign it into law", "law_sign", law_proposal.duplicate(true))
			_append_crown_popup_option("Reject the proposal", "law_reject_contextual", law_proposal.duplicate(true))
			_append_crown_popup_option("Demand revisions", "law_revise_contextual", law_proposal.duplicate(true))
			_append_crown_popup_option("Delay the vote", "law_delay_contextual", law_proposal.duplicate(true))

		"country_diplomacy":
			var country_name: String = str(payload.get("country", "Unknown Country")).strip_edges()
			crown_action_popup_title.text = country_name.to_upper()
			crown_action_popup_body.append_text("Diplomacy profile for %s.\n\n" % country_name)
			crown_action_popup_body.append_text("Era: %s\n" % str(payload.get("era", MainSceneLogic._crown_current_era_key(gs))))
			crown_action_popup_body.append_text("Posture: %s\n" % str(payload.get("posture", "Neutral")))
			crown_action_popup_body.append_text("Estimated population: %s\n" % _crown_compact_number(float(payload.get("population", 0))))
			crown_action_popup_body.append_text("Military pressure: %s\n" % str(payload.get("military_label", "Unknown")))
			crown_action_popup_body.append_text("Trade mood: %s\n\n" % str(payload.get("trade_mood", "Open")))
			_append_crown_popup_option("Send Friendly Envoy", "country_envoy", payload.duplicate(true))
			_append_crown_popup_option("Offer Trade Mission", "country_trade", payload.duplicate(true))
			_append_crown_popup_option("Issue Formal Warning", "country_warning", payload.duplicate(true))
		"abdicate":
			crown_action_popup_title.text = "ABDICATION"
			crown_action_popup_body.append_text("Choose how you want to step away from power.\n")
			_append_crown_popup_option("Retire Quietly", "abdicate_retire")
			_append_crown_popup_option("Support Heir", "abdicate_support_heir")
			_append_crown_popup_option("Found Breakaway Realm", "abdicate_breakaway")
		"celebrity":
			crown_action_popup_title.text = "ROYAL CELEBRITY"
			crown_action_popup_body.append_text("Prestige actions raise fame but can invite scandal.\n")
			_append_crown_popup_option("Throw a Royal Gala", "celebrity_gala")
			_append_crown_popup_option("Public Media Appearance", "celebrity_media")
			_append_crown_popup_option("Prestige Charity Banquet", "celebrity_charity")
		"execute":
			crown_action_popup_title.text = "EXECUTION TARGETS"
			crown_action_popup_body.append_text("Pick a target. Court figures create political shock. Random citizens create public outrage.\n")
			var targets: Array = _build_crown_execution_targets()
			if targets.is_empty():
				crown_action_popup_status.text = "No valid execution targets were found in your current political orbit."
			for raw_target in targets:
				if raw_target == null or not (raw_target is Person):
					continue
				var target: Person = raw_target
				var target_role: String = _crown_execution_target_role(target)
				var title_text: String = str(target.royal_title).strip_edges()
				if title_text == "":
					title_text = str(target.job).strip_edges()
				if title_text == "":
					title_text = str(target.social_class).strip_edges()
				if title_text == "":
					title_text = "Citizen"
				_append_crown_popup_option(
					"%s %s  •  %s  •  %s" % [target.first_name, target.last_name, target_role, title_text],
					"route:execute_method",
					{
						"target_id": int(target.id),
						"target_role": target_role
					}
				)

		"execute_method":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			crown_action_popup_title.text = "EXECUTE %s" % (_relationship_display_name(target) if target != null else "TARGET")
			crown_action_popup_body.append_text("Choose the sentence method. Severity changes approval loss, scandal, and public outrage.\n")

			var methods: Array = MainSceneLogic._build_crown_execution_methods(gs)
			for raw_method in methods:
				if typeof(raw_method) != TYPE_DICTIONARY:
					continue
				var method: Dictionary = raw_method
				var method_payload: Dictionary = payload.duplicate(true)
				method_payload ["method"] = method.duplicate(true)
				_append_crown_popup_option(
					"%s  •  Severity %d/100" % [str(method.get("label", "Execution")), int(method.get("severity", 50))],
					"route:execute_plea",
					method_payload
				)

			_append_crown_popup_option("Exile Instead", "execute_exile", payload)

		"execute_plea":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			var method: Dictionary = payload.get("method", {}) if typeof(payload.get("method", {})) == TYPE_DICTIONARY else {}
			crown_action_popup_title.text = "FINAL MERCY HEARING"
			if target == null or not target.alive:
				crown_action_popup_status.text = "That target is no longer valid."
			else:
				crown_action_popup_body.append_text(_build_crown_execution_plea_text(target, method))
				_append_crown_popup_option("Carry out the sentence", "execute_confirm", payload)
				_append_crown_popup_option("Spare them and exile them", "execute_exile", payload)
				_append_crown_popup_option("Pardon them", "execute_pardon", payload)

		"honorific":
			crown_action_popup_title.text = "HONORIFIC"
			crown_action_popup_body.append_text("Select the public-facing address style for the current ruler.\n")
			for title_text in MainSceneLogic._build_crown_honorific_options(gs):
				_append_crown_popup_option(title_text, "set_honorific", { "title": title_text})

		"public_service":
			crown_action_popup_title.text = "ROYAL DUTIES"
			crown_action_popup_body.append_text("Choose a public-facing duty route.\n")
			_append_crown_popup_option("Hospital Visit", "public_service", { "kind": "hospital", "approval_delta": 8, "fame_delta": 3})
			_append_crown_popup_option("Relief Tour", "public_service", { "kind": "relief", "approval_delta": 10, "fame_delta": 2})
			_append_crown_popup_option("Unity Speech", "public_service", { "kind": "speech", "approval_delta": 6, "fame_delta": 4})
			_append_crown_popup_option("Military Inspection", "public_service", { "kind": "inspection", "approval_delta": 4, "fame_delta": 2})
		"public_disservice":
			crown_action_popup_title.text = "PUBLIC DISSERVICE"
			crown_action_popup_body.append_text("Short-term leverage, long-term rot.\n")
			_append_crown_popup_option("Court Excess", "public_disservice", { "kind": "court_excess", "approval_delta": -8, "scandal_delta": 10})
			_append_crown_popup_option("Corrupt Crackdown", "public_disservice", { "kind": "crackdown", "approval_delta": -10, "scandal_delta": 8})
			_append_crown_popup_option("Vanity Project Embezzlement", "public_disservice", { "kind": "embezzle", "approval_delta": -12, "scandal_delta": 12})
		"create_realm":
			crown_action_popup_title.text = "FOUND REALM"
			crown_action_popup_body.append_text("This uses your existing realm-engine creation seam and then enriches the spawned realm with government style and treasury-facing metadata.\n")
			crown_action_popup_input.visible = true
			crown_action_popup_input.placeholder_text = "Realm name"
			crown_action_popup_confirm_button.visible = true
			crown_action_popup_confirm_button.text = "Found Realm"
		"government_style":
			crown_action_popup_title.text = "GOVERNMENT STYLE"
			crown_action_popup_body.append_text("Government style becomes a permissions layer on top of the player’s title and claim state.\n")
			for style_name in ["Monarchy", "Democracy", "Republic", "Dictatorship", "Communism", "Anarchy"]:
				_append_crown_popup_option(style_name, "set_government_style", { "style": style_name})
		"realm_overview":
			var overview_realm_id: int = int(gs.player.realm_id)
			var overview_realm: Dictionary = MainSceneLogic._resolve_player_realm_dict(gs)
			var overview_currency_name: String = str(overview_realm.get("currency_name", MainSceneLogic._crown_default_currency_name_for_realm(gs, str(summary.get("realm_name", ""))))).strip_edges()
			crown_action_popup_title.text = "REALM OVERVIEW"
			crown_action_popup_body.append_text(
				"Realm: %s\nGovernment: %s\nPopulation: %s\nLand: %s\nTreasury: %s\nMilitary: %s\nGoods: %s\nStanding: %s\nApproval: %d\nLegitimacy: %d" % [
					str(summary.get("realm_name", "Realm")),
					str(summary.get("government_style", "State")),
					str(summary.get("population_label", "%s people" % _crown_compact_number(float(summary.get("population", 0))))),
					str(summary.get("land_label", "%s km²" % _crown_compact_number(float(summary.get("land", 0))))),
					_format_crown_treasury_label(int(summary.get("treasury", 0)), overview_currency_name),
					str(summary.get("military_stockpile_label", "%s units" % _crown_compact_number(float(summary.get("military_stockpile", 0))))),
					str(summary.get("goods_stockpile_label", "%s units" % _crown_compact_number(float(summary.get("goods_stockpile", 0))))),
					str(summary.get("standing", "Stable")),
					int(summary.get("approval", 0)),
					int(summary.get("legitimacy", 0))
				]
			)
			_append_crown_popup_option("Browse Population", "population", { "target_realm_id": overview_realm_id})
		"hidden_realm_overview":
			var hidden_realm_id: String = str(payload.get("hidden_realm_id", "")).strip_edges()
			var hidden_realm: Dictionary = payload.get("realm", {})
			var hidden_currency_name: String = str(hidden_realm.get("currency_name", "Era Crowns")).strip_edges()
			var hidden_capital: String = str(hidden_realm.get("capital_city", "Unknown")).strip_edges()
			var hidden_subzones: Array = hidden_realm.get("subzones", [])
			var hidden_trade_rules: Dictionary = hidden_realm.get("trade_rules", {})
			var hidden_services: Dictionary = hidden_realm.get("services", {})
			crown_action_popup_title.text = "HIDDEN REALM OVERVIEW"
			crown_action_popup_body.append_text(
				"Realm: %s\nGovernment: %s\nPopulation: %s\nLand: %s\nTreasury: %s\nMilitary: %s\nGoods: %s\nCapital: %s\nSubzones: %d\nAccess: %s\nBribes: %s\nTrade: %s" % [
					str(hidden_realm.get("name", "Hidden Realm")),
					str(hidden_realm.get("government_style", "State")),
					"%s people" % _crown_compact_number(float(hidden_realm.get("population", 0))),
					str(hidden_realm.get("land_label", "%s km²" % _crown_compact_number(float(hidden_realm.get("land", hidden_realm.get("land_size", 0)))))),
					_format_crown_treasury_label(int(hidden_realm.get("treasury", 0)), hidden_currency_name),
					"%s units" % _crown_compact_number(float(hidden_realm.get("military_stockpile", hidden_realm.get("military_units", 0)))),
					"%s units" % _crown_compact_number(float(hidden_realm.get("goods_stockpile", 0))),
					hidden_capital,
					int(hidden_subzones.size()),
					str(hidden_realm.get("entry_rule", "restricted")).replace("_", " ").capitalize(),
					"Allowed" if bool(hidden_trade_rules.get("accepts_bribes", true)) else "Refused",
					"Rare artifacts only" if bool(hidden_trade_rules.get("rare_artifacts_only", false)) else "Standard"
				]
			)
			if bool((hidden_services.get("war_resolution", {}) as Dictionary).get("enabled", false)):
				crown_action_popup_body.append_text("\nService: War Resolution")
			if bool((hidden_services.get("massive_loans", {}) as Dictionary).get("enabled", false)):
				crown_action_popup_body.append_text("\nService: Massive Loans")
			if bool((hidden_services.get("balance_restoration", {}) as Dictionary).get("enabled", false)):
				crown_action_popup_body.append_text("\nService: Balance Restoration")
			if not bool(hidden_realm.get("hide_people_button", false)):
				_append_crown_popup_option("Browse Population", "population", { "target_realm_id": -1, "hidden_realm_id": hidden_realm_id})
		"population":
			var browse_realm_id: int = _resolve_crown_population_realm_id(payload)

			if browse_realm_id <= 0:
				crown_action_popup_title.text = "REALM POPULATION"
				crown_action_popup_status.text = "RealmEngine has no already-existing country or realm contract to render for this population view. Click did not create one."
			else:
				var browse_realm_name: String = str(payload.get("target_realm_name", "")).strip_edges()
				if browse_realm_name == "":
					var payload_realm_raw: Variant = payload.get("realm", {})
					var payload_realm: Dictionary = payload_realm_raw if typeof(payload_realm_raw) == TYPE_DICTIONARY else {}
					browse_realm_name = str(payload_realm.get("name", "")).strip_edges()
				if browse_realm_name == "":
					browse_realm_name = MainSceneLogic._crown_realm_name(gs, browse_realm_id)

				crown_population_wall_last_realm_id = browse_realm_id
				crown_population_wall_last_realm_name = browse_realm_name

				_render_crown_population_ecosystem_surface(browse_realm_id, browse_realm_name)
		"population_profile":
			var target_id: int = int(payload.get("target_id", -1))
