func _commit_pet_rename_choice_deferred(
	entity_id: String,
	new_name: String
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		gs.player.id
	)

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"intent_type": "animal_identity_mutation",
				"surface_id": "action_result_popup",
				"action_id": "rename_owned_animal",
				"immutable_contract_references": true,
				"skip_crr_observation": true,
				"payload": {
					"actor_id": actor_id,
					"entity_id": entity_id,
					"new_name": new_name,
					"source": (
						"mainscene.pet_rename"
					)
				},
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"animal_contract_engine"
					),
					"method": (
						"rename_owned_animal"
					),
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene.pet_rename"
				)
			},
			{
				"actor_id": actor_id,
				"entity_id": entity_id,
				"action_id": "rename_owned_animal",
				"immutable_contract_references": true,
				"skip_crr_observation": true
			}
		)
	)

	var route_result: Dictionary = (
		_contract_route_result(
			report
		)
	)

	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)

	var result: Dictionary = (
		result_raw as Dictionary
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)

	if action_result_popup != null:
		action_result_popup.set_meta(
			"pet_rename_mode",
			false
		)

	_hide_action_result_popup()

	if not result.is_empty():
		_maybe_show_action_result_popup(
			result
		)

	set_meta(
		"pet_rename_relationship_projection_owned_by_producer",
		true
	)
	set_meta(
		"pet_rename_diary_owned_by_producer",
		true
	)
	set_meta(
		"pet_rename_ui_requested_engine_followup",
		false
	)
func _service_action_result_followup_after_close(
	followup: Dictionary
) -> void:
	await RenderingServer.frame_post_draw

	if followup.is_empty():
		return

	cached_last_result = followup.duplicate(false)

	var followup_type: String = str(
		followup.get(
			"type",
			""
		)
	).strip_edges()

	if followup_type == "enter_universe_after_popup":
		_clear_action_result_relationship_profile_return()

		var enter_path: String = str(
			followup.get(
				"path",
				""
			)
		).strip_edges()
		var enter_label: String = str(
			followup.get(
				"label",
				"another universe"
			)
		).strip_edges()

		_prepare_reality_fusion_universe_entry(
			enter_path,
			enter_label
		)
		_load_life_from_slot(
			enter_path,
			{
				"source": "reality_fusion_enter_universe",
				"profile": "reality_fusion_enter_universe_playable_first"
			}
		)
		return

	_maybe_show_action_result_popup(
		followup
	)
