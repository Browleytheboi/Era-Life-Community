	render_policy [
		"viewer_fetches_data"
	] = false
	render_policy [
		"viewer_rebuilds_layout"
	] = false
	render_policy [
		"render_immediately"
	] = true
	render_policy [
		"press_frame_lens_only"
	] = true
	render_policy [
		"full_packet_apply_forbidden_on_switch_press"
