func _rick_weapon_shop_raise_people_tracker_popup() -> void:
	var dim:= get_node_or_null("RickWeaponShopPeopleTrackerDim")
	if dim == null:
		return

	var parent:= dim.get_parent()
	if parent != null:
		parent.move_child(dim, parent.get_child_count() - 1)

	if dim is CanvasItem:
		var dim_canvas:= dim as CanvasItem
		dim_canvas.z_as_relative = false
		dim_canvas.z_index = MainSceneHelpers._safe_modal_z_index(1700, 1700)

	if dim is Control:
		var dim_control:= dim as Control
		dim_control.mouse_filter = Control.MOUSE_FILTER_STOP
		dim_control.focus_mode = Control.FOCUS_ALL
		dim_control.call_deferred("grab_focus")

	var panel:= dim.get_node_or_null("Panel")
	if panel is CanvasItem:
		var panel_canvas:= panel as CanvasItem
		panel_canvas.z_as_relative = true
		panel_canvas.z_index = 2

	if panel is Control:
		var panel_control:= panel as Control
		panel_control.mouse_filter = Control.MOUSE_FILTER_STOP
		panel_control.focus_mode = Control.FOCUS_ALL
