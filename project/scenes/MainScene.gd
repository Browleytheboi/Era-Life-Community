func _show_boxing_entry_popup() -> void:
	_ensure_boxing_entry_popup()
	boxing_entry_selected_mode = ""

	if boxing_entry_popup == null or not is_instance_valid(boxing_entry_popup):
		return

	current_panel = "life"
	_hide_activities_action_panel()
	_quarantine_runtime_floating_hud_buttons_for_surface("boxing_entry_popup")
	_render_boxing_entry_mode_step()

	boxing_entry_popup.visible = true
	boxing_entry_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	_bring_modal_to_front(boxing_entry_popup)
	boxing_entry_popup.grab_focus()


func _hide_boxing_entry_popup() -> void:
	if boxing_entry_popup != null and is_instance_valid(boxing_entry_popup):
		boxing_entry_popup.visible = false
		boxing_entry_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE
