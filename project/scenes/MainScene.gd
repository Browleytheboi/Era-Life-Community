func _world_feed_progressive_is_current(token: int) -> bool:
	if current_panel != "world":
		return false
	if int(get_meta("world_feed_progressive_render_token", -1)) != token:
		return false
	if gs == null:
		return false
	if world_feed_popup_feed == null:
		return false
	return true


func _world_feed_progressive_scan_chunk(token: int) -> void:
	if not _world_feed_progressive_is_current(token):
		return

	var state_raw: Variant = get_meta(
		"world_feed_progressive_render_state",
		{}
	)
	if typeof(state_raw) != TYPE_DICTIONARY:
		return

	var state: Dictionary = (
		state_raw as Dictionary
	).duplicate(false)
	var scan_index: int = int(
		state.get(
			"scan_index",
			0
		)
	)
	var feed_size: int = int(
		state.get(
			"feed_size",
			0
		)
	)
	var current_year: int = int(
		state.get(
			"current_year",
			int(gs.year)
		)
	)
	var years_in_order: Array = state.get(
		"years_in_order",
		[]
	)
	var year_buckets: Dictionary = state.get(
		"year_buckets",
		{}
	)
	var world_feed_display_dedupe: Dictionary = state.get(
		"world_feed_display_dedupe",
		{}
	)
	var visible_event_count: int = int(
		state.get(
			"visible_event_count",
			0
		)
	)




	var max_items_per_chunk: int = clampi(
		int(
			get_meta(
				"world_feed_progressive_scan_items_per_chunk",
				12
			)
		),
		1,
		12
	)
	var max_usec_per_chunk: int = clampi(
		int(
			get_meta(
				"world_feed_progressive_scan_usec_per_chunk",
				700
			)
		),
		100,
		700
	)
	var chunk_start_usec: int = int(
		Time.get_ticks_usec()
	)
	var processed: int = 0

	while (
		scan_index < feed_size
		and processed < max_items_per_chunk
	):
		if (
			processed > 0
			and int(
				Time.get_ticks_usec()
			) - chunk_start_usec >= max_usec_per_chunk
		):
			break

		var raw_feed_entry: Variant = gs.world_feed [
			scan_index
		]
		scan_index += 1
		processed += 1

		var entry: Dictionary = gs.normalize_world_feed_entry(
			raw_feed_entry
		)
		if str(
			entry.get(
				"event_name",
				""
			)
		).strip_edges().to_lower() == "startup_seed":
			continue

		var display_key: String = MainSceneLogic._world_feed_display_dedupe_key(gs, 
			entry
		)
		if (
			display_key != ""
			and world_feed_display_dedupe.has(
				display_key
			)
		):
			continue

		if display_key != "":
			world_feed_display_dedupe [
				display_key
			] = true

		var entry_year: int = int(
			entry.get(
				"year",
				current_year
			)
		)
		var section_key: String = MainSceneLogic._world_feed_section_key(gs, 
			entry
		)

		if not year_buckets.has(entry_year):
			year_buckets [entry_year] = {
				"section_order": [],
				"sections": {},
				"section_scores": {}
			}
			years_in_order.append(entry_year)

		var year_bucket: Dictionary = year_buckets.get(
			entry_year,
			{}
		)
		var section_order: Array = year_bucket.get(
			"section_order",
			[]
		)
		var sections: Dictionary = year_bucket.get(
			"sections",
			{}
		)
		var section_scores: Dictionary = year_bucket.get(
			"section_scores",
			{}
		)

		if not sections.has(section_key):
			sections [section_key] = []
			section_order.append(section_key)

		var section_entries: Array = sections.get(
			section_key,
			[]
		)
		section_entries.append(entry)
		sections [section_key] = section_entries
		section_scores [section_key] = float(
			section_scores.get(
				section_key,
				0.0
			)
		) + MainSceneLogic._world_feed_entry_importance_score(gs, entry)

		year_bucket ["section_order"] = section_order
		year_bucket ["sections"] = sections
		year_bucket ["section_scores"] = section_scores
		year_buckets [entry_year] = year_bucket
		visible_event_count += 1

	state ["scan_index"] = scan_index
	state ["years_in_order"] = years_in_order
	state ["year_buckets"] = year_buckets
	state ["world_feed_display_dedupe"] = world_feed_display_dedupe
	state ["visible_event_count"] = visible_event_count
	state ["last_scan_quantum_items"] = processed
	set_meta(
		"world_feed_progressive_render_state",
		state
	)

	if scan_index < feed_size:
		_arm_world_feed_progressive_process_frame_step(
			"scan",
			token
		)
		return

	_arm_world_feed_progressive_process_frame_step(
		"prepare",
		token
	)

func _world_feed_progressive_prepare_render(token: int) -> void:
	if not _world_feed_progressive_is_current(token):
		return

	var state_raw: Variant = get_meta(
		"world_feed_progressive_render_state",
		{}
	)
	if typeof(state_raw) != TYPE_DICTIONARY:
		return

	var state: Dictionary = (
		state_raw as Dictionary
	).duplicate(false)
	var years_in_order: Array = state.get(
		"years_in_order",
		[]
	)
	var year_buckets: Dictionary = state.get(
		"year_buckets",
		{}
	)
	var section_orders_by_year: Dictionary = state.get(
		"section_orders_by_year",
		{}
	)
	var prepare_year_index: int = int(
		state.get(
			"prepare_year_index",
			0
		)
	)





	if prepare_year_index < years_in_order.size():
		var entry_year: int = int(
			years_in_order [
				prepare_year_index
			]
		)
		var year_bucket: Dictionary = year_buckets.get(
			entry_year,
			{}
		)
		section_orders_by_year [
			str(entry_year)
		] = _sort_world_feed_sections_for_year(
			year_bucket
		)
		prepare_year_index += 1

		state [
			"section_orders_by_year"
		] = section_orders_by_year
		state [
			"prepare_year_index"
		] = prepare_year_index
		set_meta(
			"world_feed_progressive_render_state",
			state
		)

		if prepare_year_index < years_in_order.size():
			_arm_world_feed_progressive_process_frame_step(
				"prepare",
				token
			)
			return

	state ["render_year_index"] = 0
	state ["render_section_index"] = 0
	state ["render_entry_index"] = 0
	state ["render_year_header_done"] = false
	state ["render_section_header_done"] = false
	set_meta(
		"world_feed_progressive_render_state",
		state
	)
	_arm_world_feed_progressive_process_frame_step(
		"render",
		token
	)

func _world_feed_progressive_render_chunk(token: int) -> void:
	if not _world_feed_progressive_is_current(token):
		return

	var state_raw: Variant = get_meta(
		"world_feed_progressive_render_state",
		{}
	)
	if typeof(state_raw) != TYPE_DICTIONARY:
		return

	var state: Dictionary = (
		state_raw as Dictionary
	).duplicate(false)
	var visible_event_count: int = int(
		state.get(
			"visible_event_count",
			0
		)
	)

	if visible_event_count <= 0:
		_append_world_feed_colored_line(
			"No world events right now.",
			Color(
				0.88,
				0.9,
				0.94,
				0.92
			)
		)
		_append_world_feed_colored_line(
			"======================",
			Color(
				1.0,
				0.96,
				0.84,
				1.0
			)
		)
		world_feed_popup_feed.scroll_to_line(
			max(
				world_feed_popup_feed.get_line_count() - 1,
				0
			)
		)
		set_meta(
			"world_feed_progressive_render_state",
			{}
		)
		return

	var years_in_order: Array = state.get(
		"years_in_order",
		[]
	)
	var year_buckets: Dictionary = state.get(
		"year_buckets",
		{}
	)
	var section_orders_by_year: Dictionary = state.get(
		"section_orders_by_year",
		{}
	)
	var render_year_index: int = int(
		state.get(
			"render_year_index",
			0
		)
	)
	var render_section_index: int = int(
		state.get(
			"render_section_index",
			0
		)
	)
	var render_entry_index: int = int(
		state.get(
			"render_entry_index",
			0
		)
	)
	var render_year_header_done: bool = bool(
		state.get(
			"render_year_header_done",
			false
		)
	)
	var render_section_header_done: bool = bool(
		state.get(
			"render_section_header_done",
			false
		)
	)

	var max_lines_per_chunk: int = clampi(
		int(
			get_meta(
				"world_feed_progressive_lines_per_chunk",
				6
			)
		),
		1,
		6
	)
	var max_usec_per_chunk: int = clampi(
		int(
			get_meta(
				"world_feed_progressive_render_usec_per_chunk",
				800
			)
		),
		100,
		800
	)
	var chunk_start_usec: int = int(
		Time.get_ticks_usec()
	)
	var appended_lines: int = 0

	while (
		render_year_index < years_in_order.size()
		and appended_lines < max_lines_per_chunk
	):
		if (
			appended_lines > 0
			and int(
				Time.get_ticks_usec()
			) - chunk_start_usec >= max_usec_per_chunk
		):
			break

		var entry_year: int = int(
			years_in_order [
				render_year_index
			]
		)
		var year_bucket: Dictionary = year_buckets.get(
			entry_year,
			{}
		)
		var sections: Dictionary = year_bucket.get(
			"sections",
			{}
		)
		var sorted_section_order: Array = section_orders_by_year.get(
			str(entry_year),
			[]
		)

		if not render_year_header_done:
			_append_world_feed_centered_year_line(
				"Year: %s" % _format_year(
					entry_year
				),
				Color(
					1.0,
					0.9,
					0.72,
					1.0
				)
			)
			_append_world_feed_colored_line(
				"",
				Color(
					1.0,
					1.0,
					1.0,
					1.0
				)
			)
			render_year_header_done = true
			render_section_index = 0
			render_entry_index = 0
			render_section_header_done = false
			appended_lines += 2
			continue

		if render_section_index >= sorted_section_order.size():
			if render_year_index < years_in_order.size() - 1:
				_append_world_feed_colored_line(
					"",
					Color(
						1.0,
						1.0,
						1.0,
						1.0
					)
				)
				appended_lines += 1

			render_year_index += 1
			render_section_index = 0
			render_entry_index = 0
			render_year_header_done = false
			render_section_header_done = false
			continue

		var section_key: String = str(
			sorted_section_order [
				render_section_index
			]
		)
		var section_entries: Array = sections.get(
			section_key,
			[]
		)

		if section_entries.is_empty():
			render_section_index += 1
			render_entry_index = 0
			render_section_header_done = false
			continue

		if not render_section_header_done:
			_append_world_feed_section_header(
				section_key,
				int(
					section_entries.size()
				)
			)
			render_section_header_done = true
			appended_lines += 1
			continue

		while (
			render_entry_index < section_entries.size()
			and appended_lines < max_lines_per_chunk
		):
			if (
				appended_lines > 0
				and int(
					Time.get_ticks_usec()
				) - chunk_start_usec >= max_usec_per_chunk
			):
				break

			var section_entry: Dictionary = section_entries [
				render_entry_index
			]
			_append_world_feed_entry_line(
				section_entry
			)
			render_entry_index += 1
			appended_lines += 1

		if render_entry_index >= section_entries.size():
			_append_world_feed_colored_line(
				"",
				Color(
					1.0,
					1.0,
					1.0,
					1.0
				)
			)
			render_section_index += 1
			render_entry_index = 0
			render_section_header_done = false
			appended_lines += 1

	state ["render_year_index"] = render_year_index
	state ["render_section_index"] = render_section_index
	state ["render_entry_index"] = render_entry_index
	state ["render_year_header_done"] = render_year_header_done
	state ["render_section_header_done"] = render_section_header_done
	state ["last_render_quantum_lines"] = appended_lines
	set_meta(
		"world_feed_progressive_render_state",
		state
	)

	if render_year_index < years_in_order.size():
		_arm_world_feed_progressive_process_frame_step(
			"render",
			token
		)
		return

	_append_world_feed_colored_line(
		"======================",
		Color(
			1.0,
			0.96,
			0.84,
			1.0
		)
	)
	world_feed_popup_feed.scroll_to_line(
		max(
			world_feed_popup_feed.get_line_count() - 1,
			0
		)
	)
	set_meta(
		"world_feed_progressive_render_state",
		{}
	)
func _scroll_standard_tab_popup_left_to_bottom() -> void:
	if standard_tab_popup_left_scroll == null:
		return

