func _on_resident_relationship_section_contract_ready(
	signature: String,
	actor_id: int,
	section_id: String,
	section_contract: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(
			gs.player.id
		) != actor_id
		or section_contract.is_empty()
	):
		return

	var clean_signature: String = str(
		signature
	).strip_edges()
	var clean_section_id: String = str(
		section_id
	).strip_edges().to_lower()

	if (
		clean_signature == ""
		or clean_section_id == ""
	):
		return

	var tracked_signature: String = str(
		get_meta(
			"god_mode_life_prewarm_signature",
			""
		)
	).strip_edges()
	var attached_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()

	if (
		tracked_signature == ""
		and attached_signature == ""
	):
		return

	if (
		clean_signature != tracked_signature
		and clean_signature != attached_signature
	):
		return

	var cached_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var cached_contracts: Dictionary = (
		(cached_contracts_raw as Dictionary).duplicate(false)
		if typeof(cached_contracts_raw) == TYPE_DICTIONARY
		else {}
	)




	var relationships_raw: Variant = cached_contracts.get(
		"relationships",
		{}
	)
	var relationships_contract: Dictionary = (
		(relationships_raw as Dictionary).duplicate(false)
		if typeof(relationships_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		relationships_contract.is_empty()
		and relationship_hub_panel != null
		and is_instance_valid(
			relationship_hub_panel
		)
		and not relationship_hub_panel.active_contract.is_empty()
	):
		relationships_contract = (
			relationship_hub_panel
			.active_contract
			.duplicate(false)
		)

	if relationships_contract.is_empty():
		relationships_contract = {
			"actor_id": actor_id,
			"active_section_id": (
				relationships_hub_active_section_id
				if relationships_hub_active_section_id != ""
				else "family"
			),
			"section_contracts": {},
			"projection_pending": true,
			"projection_complete": false,
			"truth_state": "streaming",
			"immutable_surface_contract": true,
			"ui_is_renderer_only": true
		}

	var section_contracts_raw: Variant = relationships_contract.get(
		"section_contracts",
		{}
	)
	var section_contracts: Dictionary = (
		(section_contracts_raw as Dictionary).duplicate(false)
		if typeof(section_contracts_raw) == TYPE_DICTIONARY
		else {}
	)
	var installed_section_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		section_contracts.get(
			clean_section_id,
			{}
		)
	)






	var incoming_revision: String = str(
		section_contract.get(
			"surface_revision",
			""
		)
	).strip_edges()
	var installed_revision: String = str(
		installed_section_contract.get(
			"surface_revision",
			""
		)
	).strip_edges()
	var incoming_world_year: int = -999999
	var installed_world_year: int = -999999

	var incoming_revision_parts: PackedStringArray = (
		incoming_revision.split(":")
	)
	if (
		incoming_revision_parts.size() >= 2
		and str(
			incoming_revision_parts [0]
		).is_valid_int()
		and int(
			incoming_revision_parts [0]
		) == actor_id
		and str(
			incoming_revision_parts [1]
		).is_valid_int()
	):
		incoming_world_year = int(
			incoming_revision_parts [1]
		)

	var installed_revision_parts: PackedStringArray = (
		installed_revision.split(":")
	)
	if (
		installed_revision_parts.size() >= 2
		and str(
			installed_revision_parts [0]
		).is_valid_int()
		and int(
			installed_revision_parts [0]
		) == actor_id
		and str(
			installed_revision_parts [1]
		).is_valid_int()
	):
		installed_world_year = int(
			installed_revision_parts [1]
		)

	var reject_temporal_rollback: bool = (
		incoming_world_year != -999999
		and installed_world_year != -999999
		and incoming_world_year < installed_world_year
	)
	var reject_stream_rollback: bool = false

	if (
		not reject_temporal_rollback
		and incoming_world_year != -999999
		and installed_world_year != -999999
		and incoming_world_year == installed_world_year
		and not installed_section_contract.is_empty()
	):
		var incoming_groups: Array = MainSceneHelpers._safe_array(
			section_contract.get(
				"groups",
				[]
			)
		)
		var installed_groups: Array = MainSceneHelpers._safe_array(
			installed_section_contract.get(
				"groups",
				[]
			)
		)
		var incoming_section_complete: bool = bool(
			section_contract.get(
				"section_projection_complete",
				section_contract.get(
					"projection_complete",
					false
				)
			)
		)
		var installed_section_complete: bool = bool(
			installed_section_contract.get(
				"section_projection_complete",
				installed_section_contract.get(
					"projection_complete",
					false
				)
			)
		)

		reject_stream_rollback = (
			incoming_groups.size() < installed_groups.size()
			or (
				incoming_groups.size() == installed_groups.size()
				and installed_section_complete
				and not incoming_section_complete
			)
		)

	if (
		reject_temporal_rollback
		or reject_stream_rollback
	):
		set_meta(
			"resident_relationship_section_rollback_rejected",
			true
		)
		set_meta(
			"resident_relationship_section_rollback_rejected_id",
			clean_section_id
		)
		set_meta(
			"resident_relationship_section_rollback_incoming_revision",
			incoming_revision
		)
		set_meta(
			"resident_relationship_section_rollback_installed_revision",
			installed_revision
		)
		set_meta(
			"resident_relationship_section_rollback_incoming_year",
			incoming_world_year
		)
		set_meta(
			"resident_relationship_section_rollback_installed_year",
			installed_world_year
		)
		set_meta(
			"resident_relationship_section_rollback_temporal",
			reject_temporal_rollback
		)
		set_meta(
			"resident_relationship_section_rollback_stream",
			reject_stream_rollback
		)
		set_meta(
			"resident_relationship_section_rollback_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	section_contracts [
		clean_section_id
	] = section_contract.duplicate(false)

	relationships_contract [
		"section_contracts"
	] = section_contracts
	relationships_contract [
		"background_section_refresh_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	relationships_contract [
		"background_section_refresh_id"
	] = clean_section_id

	var active_section_id: String = str(
		relationships_contract.get(
			"active_section_id",
			relationships_contract.get(
				"active_section",
				"family"
			)
		)
	).strip_edges().to_lower()

	if active_section_id == clean_section_id:
		var groups_raw: Variant = section_contract.get(
			"groups",
			[]
		)

		relationships_contract [
			"groups"
		] = (
			(groups_raw as Array).duplicate(false)
			if typeof(groups_raw) == TYPE_ARRAY
			else []
		)
		relationships_contract [
			"truth_state"
		] = str(
			section_contract.get(
				"truth_state",
				"streaming"
			)
		)

	cached_contracts [
		"relationships"
	] = relationships_contract

	set_meta(
		"resident_main_tab_surface_contracts",
		cached_contracts
	)







	if (
		relationship_hub_panel != null
		and is_instance_valid(
			relationship_hub_panel
		)
		and relationship_hub_panel.has_method(
			"stream_section_contract_background"
		)
	):
		relationship_hub_panel.stream_section_contract_background(
			clean_section_id,
			section_contract
		)

	set_meta(
		"resident_relationship_section_last_id",
		clean_section_id
	)
	set_meta(
		"resident_relationship_section_last_actor_id",
		actor_id
	)
	set_meta(
		"resident_relationship_section_last_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_relationship_section_engine_calls",
		false
	)
	set_meta(
		"resident_relationship_section_build_on_click",
		false
	)
	set_meta(
		"resident_relationship_section_ready_gate_member",
		false
	)
	set_meta(
		"resident_relationship_section_recursive_copy_performed",
		false
	)
	set_meta(
		"resident_relationship_section_game_state_write_performed",
		false
	)
	set_meta(
		"resident_relationship_section_rollback_rejected",
		false
	)
	set_meta(
		"resident_relationship_section_last_accepted_world_year",
		incoming_world_year
	)
func _queue_post_ready_observable_surface_deck_prewarm(
	actor_id: int,
	signature: String
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(gs.player.id) != actor_id
	):
		return

	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return

	var request_key: String = "%s::%d" % [
		clean_signature,
		actor_id
	]
	var registry: Dictionary = MainSceneHelpers._safe_dictionary(
		get_meta(
			"post_ready_observable_surface_deck_prewarm_registry",
			{}
		)
	).duplicate(false)
	var request_state: Dictionary = MainSceneHelpers._safe_dictionary(
		registry.get(
			request_key,
			{}
		)
	).duplicate(false)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var attached_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()




	if attached_signature != clean_signature:
		request_state ["request_key"] = request_key
		request_state ["signature"] = clean_signature
		request_state ["actor_id"] = actor_id
		request_state ["active"] = true
		request_state ["complete"] = false
		request_state ["cancelled"] = false
		request_state ["waiting_for_residency_attach"] = true
		request_state ["attach_signature_observed"] = attached_signature
		request_state ["queued_at_ms"] = int(
			request_state.get(
				"queued_at_ms",
				now_ms
			)
		)
		request_state ["last_service_at_ms"] = now_ms
		request_state ["ready_gate_member"] = false
		request_state ["build_on_click"] = false

		var attach_tree:= get_tree()

		if attach_tree == null:
			request_state ["attach_retry_scheduled"] = true
			request_state [
				"attach_retry_schedule_mode"
			] = "call_deferred"
			registry [request_key] = request_state

			set_meta(
				"post_ready_observable_surface_deck_prewarm_registry",
				registry
			)

			call_deferred(
				"_queue_post_ready_observable_surface_deck_prewarm",
				actor_id,
				clean_signature
			)
			return

		var attach_retry_callback: Callable = Callable(
			self,
			"_queue_post_ready_observable_surface_deck_prewarm"
		).bind(
			actor_id,
			clean_signature
		)
		var retry_already_connected: bool = (
			attach_tree.process_frame.is_connected(
				attach_retry_callback
			)
		)

		if not retry_already_connected:
			attach_tree.process_frame.connect(
				attach_retry_callback,
				CONNECT_ONE_SHOT
			)

		request_state ["attach_retry_scheduled"] = true
		request_state [
			"attach_retry_schedule_mode"
		] = "process_frame_one_shot"
		request_state [
			"attach_retry_callable_already_connected"
		] = retry_already_connected
		request_state [
			"duplicate_signal_connection_attempted"
		] = false
		registry [request_key] = request_state

		set_meta(
			"post_ready_observable_surface_deck_prewarm_registry",
			registry
		)
		set_meta(
			"post_ready_observable_surface_deck_waiting_for_attach",
			true
		)
		set_meta(
			"post_ready_observable_surface_deck_waiting_signature",
			clean_signature
		)
		set_meta(
			"post_ready_observable_surface_deck_attach_retry_connected",
			true
		)
		set_meta(
			"post_ready_observable_surface_deck_duplicate_signal_forbidden",
			true
		)
		return

	request_state ["waiting_for_residency_attach"] = false
	request_state ["attach_retry_scheduled"] = false
	request_state ["attach_signature_observed"] = attached_signature
	registry [request_key] = request_state

	set_meta(
		"post_ready_observable_surface_deck_prewarm_registry",
		registry
	)
	set_meta(
		"post_ready_observable_surface_deck_waiting_for_attach",
		false
	)

	var destination_deck_hot: bool = (
		_asset_destination_surface_deck_is_hot_for_actor(
			actor_id
		)
	)

	if (
		bool(
			request_state.get(
				"complete",
				false
			)
		)
		and destination_deck_hot
	):
		call_deferred(
			"_prewarm_crime_hub_contract_for_actor",
			actor_id,
			clean_signature,
			"completed_destination_deck_crime_residency"
		)
		call_deferred(
			"_refresh_pet_shop_panel"
		)
		call_deferred(
			"_queue_other_country_browser_resident_prewarm",
			actor_id,
			clean_signature
		)
		return

	if (
		bool(
			request_state.get(
				"active",
				false
			)
		)
		and not destination_deck_hot
		and not bool(
			request_state.get(
				"waiting_for_residency_attach",
				false
			)
		)
	):
		var last_service_at_ms: int = int(
			request_state.get(
				"last_service_at_ms",
				request_state.get(
					"queued_at_ms",
					0
				)
			)
		)

		if (
			last_service_at_ms > 0
			and now_ms - last_service_at_ms < 1000
		):
			return

		request_state ["active"] = false
		request_state ["complete"] = false
		request_state ["stale_active_rearmed"] = true
		request_state ["stale_active_rearmed_at_ms"] = now_ms






	if destination_deck_hot:
		call_deferred(
			"_prewarm_crime_hub_contract_for_actor",
			actor_id,
			clean_signature,
			"destination_deck_already_hot_crime_residency"
		)
		call_deferred(
			"_refresh_pet_shop_panel"
		)
		call_deferred(
			"_queue_other_country_browser_resident_prewarm",
			actor_id,
			clean_signature
		)
		return

	var previous_complete: bool = bool(
		request_state.get(
			"complete",
			false
		)
	)
	request_state = {
		"request_key": request_key,
		"signature": clean_signature,
		"actor_id": actor_id,
		"active": true,
		"complete": false,
		"cancelled": false,
		"waiting_for_residency_attach": false,
		"attach_retry_scheduled": false,
		"stage_index": 0,
		"property_surface_cursor": int(
			request_state.get(
				"property_surface_cursor",
				0
			)
		),
		"queued_at_ms": int(
			request_state.get(
				"queued_at_ms",
				now_ms
			)
		),
		"last_service_at_ms": now_ms,
		"rearmed_after_false_completion": previous_complete,
		"ready_gate_member": false,
		"build_on_click": false
	}
	registry [request_key] = request_state

	set_meta(
		"post_ready_observable_surface_deck_prewarm_registry",
		registry
	)
	set_meta(
		"post_ready_observable_surface_deck_prewarm_ready_gate_member",
		false
	)
	set_meta(
		"post_ready_observable_surface_deck_prewarm_build_on_click",
		false
	)
	set_meta(
		"post_ready_observable_surface_deck_prewarm_uses_dynamic_meta_keys",
		false
	)
	set_meta(
		"post_ready_observable_surface_deck_false_completion_forbidden",
		true
	)
	set_meta(
		"post_ready_observable_surface_deck_actual_actor_hot_validated",
		true
	)

	call_deferred(
		"_prewarm_crime_hub_contract_for_actor",
		actor_id,
		clean_signature,
		"post_ready_crime_hub_residency"
	)
	call_deferred(
		"_refresh_pet_shop_panel"
	)
	call_deferred(
		"_queue_other_country_browser_resident_prewarm",
		actor_id,
		clean_signature
	)
	call_deferred(
		"_continue_post_ready_observable_surface_deck_prewarm",
		actor_id,
		clean_signature,
		request_key,
		0
	)
func _ensure_world_feed_live_observation_subscription() -> void:
	if world_feed_live_observation_source == gs:
		return

	var callback:= Callable(
		self,
		"_on_world_feed_entry_contract_committed"
	)

	if (
		world_feed_live_observation_source != null
		and is_instance_valid(
			world_feed_live_observation_source
		)
	):
		if (
			world_feed_live_observation_source.has_signal(
				"world_feed_entry_contract_committed"
			)
			and world_feed_live_observation_source.is_connected(
				"world_feed_entry_contract_committed",
				callback
			)
		):
			world_feed_live_observation_source.disconnect(
				"world_feed_entry_contract_committed",
				callback
			)

	world_feed_live_observation_source = gs
	world_feed_live_observation_queue.clear()
	world_feed_live_observation_head = 0
	world_feed_live_observation_last_year = -999999

	if gs == null:
		return

	if not gs.has_signal(
		"world_feed_entry_contract_committed"
	):
		return

	if not gs.is_connected(
		"world_feed_entry_contract_committed",
		callback
	):
		gs.connect(
			"world_feed_entry_contract_committed",
			callback
		)


func _on_world_feed_entry_contract_committed(
	contract: Dictionary
) -> void:
	if gs == null:
		return

	if str(
		contract.get(
			"schema",
			""
		)
	).strip_edges() != "eralife.world_feed_entry_commit_contract":
		return

	if current_panel != "world":
		return

	if not world_feed_popup_open:
		return

	if not _interactive_surface_is_visible(
		world_feed_popup
	):
		return

	var entry_raw: Variant = contract.get(
		"entry",
		{}
	)
	if typeof(entry_raw) != TYPE_DICTIONARY:
		return

	var entry: Dictionary = (
		(entry_raw as Dictionary).duplicate(false)
	)

	if str(
		entry.get(
			"event_name",
			""
		)
	).strip_edges().to_lower() == "startup_seed":
		return



	world_feed_live_observation_queue.append(
		entry
	)


func _drive_world_feed_live_observation_stream(
	max_entries_per_frame: int = 1
) -> void:
	if gs == null:
		return

	if current_panel != "world":
		return

	if not world_feed_popup_open:
		return

	if not _interactive_surface_is_visible(
		world_feed_popup
	):
		return

	if world_feed_popup_feed == null:
		return

	var progressive_raw: Variant = get_meta(
		"world_feed_progressive_render_state",
		{}
	)
	if (
		typeof(progressive_raw) == TYPE_DICTIONARY
		and not (
			progressive_raw as Dictionary
		).is_empty()
	):
		return

	var appended_any: bool = false
	var canonical_year: int = int(
		gs.year
	)

	if world_feed_live_observation_last_year == -999999:
		world_feed_live_observation_last_year = canonical_year
	elif world_feed_live_observation_last_year != canonical_year:
		_append_world_feed_colored_line(
			"",
			Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
		)
		_append_world_feed_centered_year_line(
			"Year: %s" % _format_year(
				canonical_year
			),
			Color(
				1.0,
				0.9,
				0.72,
				1.0
			)
		)
		_append_world_feed_colored_line(
			"",
			Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
		)

		world_feed_live_observation_last_year = canonical_year
		appended_any = true

	var budget: int = maxi(
		1,
		max_entries_per_frame
	)

	while (
		budget > 0
		and world_feed_live_observation_head
		< world_feed_live_observation_queue.size()
	):
		var raw_entry: Variant = world_feed_live_observation_queue [
			world_feed_live_observation_head
		]
		world_feed_live_observation_head += 1
		budget -= 1

		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue

		var entry: Dictionary = gs.normalize_world_feed_entry(
			raw_entry
		)

		if str(
			entry.get(
				"event_name",
				""
			)
		).strip_edges().to_lower() == "startup_seed":
			continue

		var entry_year: int = int(
			entry.get(
				"year",
				canonical_year
			)
		)

		if entry_year != world_feed_live_observation_last_year:
			_append_world_feed_colored_line(
				"",
				Color(
					1.0,
					1.0,
					1.0,
					1.0
				)
			)
			_append_world_feed_centered_year_line(
				"Year: %s" % _format_year(
					entry_year
				),
				Color(
					1.0,
					0.9,
					0.72,
					1.0
				)
			)
			_append_world_feed_colored_line(
				"",
				Color(
					1.0,
					1.0,
					1.0,
					1.0
				)
			)
			world_feed_live_observation_last_year = entry_year

		_append_world_feed_entry_line(
			entry
		)
		appended_any = true

	if (
		world_feed_live_observation_head
		>= world_feed_live_observation_queue.size()
	):
		world_feed_live_observation_queue.clear()
		world_feed_live_observation_head = 0

	if appended_any:
		world_feed_popup_feed.scroll_to_line(
			max(
				world_feed_popup_feed.get_line_count() - 1,
				0
			)
		)
func _continue_post_ready_observable_surface_deck_prewarm(
	actor_id: int,
	signature: String,
	request_key: String,
	stage_index: int
) -> void:
	var registry_raw: Variant = get_meta(
		"post_ready_observable_surface_deck_prewarm_registry",
		{}
	)
	var registry: Dictionary = (
		(registry_raw as Dictionary).duplicate(false)
		if typeof(registry_raw) == TYPE_DICTIONARY
		else {}
	)
	var request_state_raw: Variant = registry.get(
		request_key,
		{}
	)
	var request_state: Dictionary = (
		(request_state_raw as Dictionary).duplicate(false)
		if typeof(request_state_raw) == TYPE_DICTIONARY
		else {
			"request_key": request_key,
			"signature": signature,
			"actor_id": actor_id,
			"active": true,
			"complete": false,
			"cancelled": false,
			"ready_gate_member": false,
			"build_on_click": false
		}
	)

	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
		or str(
			reality_residency_attached_signature
		).strip_edges() != str(
			signature
		).strip_edges()
	):
		request_state ["active"] = false
		request_state ["complete"] = false
		request_state ["cancelled"] = true
		request_state ["cancelled_at_stage"] = stage_index
		request_state ["cancelled_at_ms"] = int(
			Time.get_ticks_msec()
		)
		registry [request_key] = request_state
		set_meta(
			"post_ready_observable_surface_deck_prewarm_registry",
			registry
		)
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var retry_not_before_ms: int = int(
		request_state.get(
			"retry_not_before_ms",
			0
		)
	)

	if now_ms < retry_not_before_ms:
		var retry_wait_tree:= get_tree()

		if retry_wait_tree == null:
			call_deferred(
				"_continue_post_ready_observable_surface_deck_prewarm",
				actor_id,
				signature,
				request_key,
				stage_index
			)
			return

		retry_wait_tree.process_frame.connect(
			Callable(
				self,
				"_continue_post_ready_observable_surface_deck_prewarm"
			).bind(
				actor_id,
				signature,
				request_key,
				stage_index
			),
			CONNECT_ONE_SHOT
		)
		return

	request_state ["active"] = true
	request_state ["complete"] = false
	request_state ["stage_index"] = stage_index
	request_state ["last_service_at_ms"] = now_ms
	request_state ["waiting_for_input"] = false
	request_state ["waiting_for_present_fence"] = false
	request_state.erase(
		"retry_not_before_ms"
	)
	registry [request_key] = request_state
	set_meta(
		"post_ready_observable_surface_deck_prewarm_registry",
		registry
	)



	if bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		request_state ["waiting_for_present_fence"] = true
		request_state ["yielded_at_stage"] = stage_index
		request_state ["yielded_at_ms"] = now_ms
		registry [request_key] = request_state
		set_meta(
			"post_ready_observable_surface_deck_prewarm_registry",
			registry
		)
		var present_tree:= get_tree()

		if present_tree == null:
			call_deferred(
				"_continue_post_ready_observable_surface_deck_prewarm",
				actor_id,
				signature,
				request_key,
				stage_index
			)
			return

		present_tree.process_frame.connect(
			Callable(
				self,
				"_continue_post_ready_observable_surface_deck_prewarm"
			).bind(
				actor_id,
				signature,
				request_key,
				stage_index
			),
			CONNECT_ONE_SHOT
		)
		return

	match stage_index:
		0:
			_ensure_assets_panel()
			_ensure_property_market_panel()
			_ensure_vehicle_market_panel()
			_ensure_property_viewer_panel()
			_ensure_modification_panel()
			_ensure_artifact_shop_panel()
			_ensure_pet_shop_panel()
			_ensure_action_result_popup()
			_ensure_other_countries_popup()

		1:
			_prewarm_asset_surface_deck_for_actor(
				gs.player,
				"post_ready_activities_destination_deck",
				false
			)

		2:
			var property_space_report: Dictionary = (
				_prewarm_next_property_space_contract_for_actor(
					gs.player,
					int(
						request_state.get(
							"property_surface_cursor",
							0
						)
					),
					"post_ready_property_space_deck"
				)
			)

			request_state ["property_surface_cursor"] = int(
				property_space_report.get(
					"next_cursor",
					0
				)
			)
			request_state ["property_surfaces_hot"] = bool(
				property_space_report.get(
					"complete",
					false
				)
			)
			registry [request_key] = request_state
			set_meta(
				"post_ready_observable_surface_deck_prewarm_registry",
				registry
			)

			if not bool(
				property_space_report.get(
					"complete",
					false
				)
			):
				var property_tree:= get_tree()

				if property_tree == null:
					call_deferred(
						"_continue_post_ready_observable_surface_deck_prewarm",
						actor_id,
						signature,
						request_key,
						stage_index
					)
					return

				property_tree.process_frame.connect(
					Callable(
						self,
						"_continue_post_ready_observable_surface_deck_prewarm"
					).bind(
						actor_id,
						signature,
						request_key,
						stage_index
					),
					CONNECT_ONE_SHOT
				)
				return

		3:
			_prime_artifact_shop_surface(
				"post_ready_artifact_shop_destination"
			)

		4:
			_refresh_pet_shop_panel()

			if (
				pet_shop_panel != null
				and is_instance_valid(
					pet_shop_panel
				)
			):
				pet_shop_panel.visible = false
				pet_shop_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

		5:
			_prewarm_other_country_browser_cache()

		_:
			var assets_hot: bool = (
				assets_panel != null
				and is_instance_valid(
					assets_panel
				)
				and int(
					assets_panel.get_meta(
						"prepainted_actor_id",
						-1
					)
				) == actor_id
				and int(
					assets_panel.active_contract.get(
						"actor_id",
						-1
					)
				) == actor_id
			)
			var property_hot: bool = (
				property_market_panel != null
				and is_instance_valid(
					property_market_panel
				)
				and int(
					property_market_panel.get_meta(
						"prepainted_actor_id",
						-1
					)
				) == actor_id
				and int(
					property_market_panel.active_contract.get(
						"actor_id",
						-1
					)
				) == actor_id
			)
			var vehicle_hot: bool = (
				vehicle_market_panel != null
				and is_instance_valid(
					vehicle_market_panel
				)
				and int(
					vehicle_market_panel.get_meta(
						"prepainted_actor_id",
						-1
					)
				) == actor_id
				and int(
					vehicle_market_panel.active_contract.get(
						"actor_id",
						-1
					)
				) == actor_id
			)
			var property_surfaces_hot: bool = bool(
				request_state.get(
					"property_surfaces_hot",
					false
				)
			)
			var artifact_hot: bool = (
				_artifact_shop_surface_is_hot()
				and int(
					artifact_shop_active_contract.get(
						"actor_id",
						actor_id
					)
				) == actor_id
			)
			var pet_hot: bool = (
				pet_shop_panel != null
				and is_instance_valid(
					pet_shop_panel
				)
				and int(
					pet_shop_panel.get_meta(
						"prepainted_actor_id",
						-1
					)
				) == actor_id
			)
			var deck_hot: bool = (
				assets_hot
				and property_hot
				and vehicle_hot
				and property_surfaces_hot
				and artifact_hot
				and pet_hot
			)
			var completed_at_ms: int = int(
				Time.get_ticks_msec()
			)

			request_state ["assets_hot"] = assets_hot
			request_state ["property_hot"] = property_hot
			request_state ["vehicle_hot"] = vehicle_hot
			request_state ["property_surfaces_hot"] = (
				property_surfaces_hot
			)
			request_state ["artifact_hot"] = artifact_hot
			request_state ["pet_hot"] = pet_hot
			request_state ["cancelled"] = false
			request_state ["stage_index"] = stage_index
			request_state ["input_grace_starvation_forbidden"] = true
			request_state ["last_validation_at_ms"] = completed_at_ms

			if not deck_hot:
				var retry_stage: int = 1

				if (
					assets_hot
					and property_hot
					and vehicle_hot
				):
					retry_stage = (
						2
						if not property_surfaces_hot
						else 3
					)

					if (
						property_surfaces_hot
						and artifact_hot
					):
						retry_stage = 4

				request_state ["active"] = true
				request_state ["complete"] = false
				request_state ["retry_stage"] = retry_stage
				request_state ["retry_count"] = int(
					request_state.get(
						"retry_count",
						0
					)
				) + 1
				request_state ["retry_not_before_ms"] = (
					completed_at_ms + 64
				)
				registry [request_key] = request_state
				set_meta(
					"post_ready_observable_surface_deck_prewarm_registry",
					registry
				)

				EraLog.truth(
					"ERALIFE_POST_READY_OBSERVABLE_DECK_TRUTH"
					+ "|signature=" + signature
					+ "|actor_id=" + str(actor_id)
					+ "|complete=false"
					+ "|retry_stage=" + str(retry_stage)
					+ "|assets_hot=" + str(assets_hot).to_lower()
					+ "|property_hot=" + str(property_hot).to_lower()
					+ "|vehicle_hot=" + str(vehicle_hot).to_lower()
					+ "|property_surfaces_hot="
					+ str(property_surfaces_hot).to_lower()
					+ "|artifact_hot=" + str(artifact_hot).to_lower()
					+ "|pet_hot=" + str(pet_hot).to_lower()
					+ "|false_completion_forbidden=true"
					+ "|ready_gate_member=false"
					+ "|build_on_click=false"
					+ "|at_ms=" + str(completed_at_ms)
				)

				var retry_tree:= get_tree()

				if retry_tree == null:
					call_deferred(
						"_continue_post_ready_observable_surface_deck_prewarm",
						actor_id,
						signature,
						request_key,
						retry_stage
					)
					return

				retry_tree.process_frame.connect(
					Callable(
						self,
						"_continue_post_ready_observable_surface_deck_prewarm"
					).bind(
						actor_id,
						signature,
						request_key,
						retry_stage
					),
					CONNECT_ONE_SHOT
				)
				return

			request_state ["active"] = false
			request_state ["complete"] = true
			request_state ["completed_at_ms"] = completed_at_ms
			request_state.erase(
				"retry_not_before_ms"
			)
			registry [request_key] = request_state

			set_meta(
				"post_ready_observable_surface_deck_prewarm_registry",
				registry
			)
			set_meta(
				"post_ready_observable_surface_deck_prewarm_completed_at_ms",
				completed_at_ms
			)
			set_meta(
				"post_ready_observable_surface_deck_ready_gate_member",
				false
			)
			set_meta(
				"post_ready_observable_surface_deck_one_surface_per_frame",
				true
			)
			set_meta(
				"post_ready_observable_surface_deck_dynamic_meta_keys_used",
				false
			)
			set_meta(
				"post_ready_observable_surface_deck_input_grace_starvation_forbidden",
				true
			)

			EraLog.truth(
				"ERALIFE_POST_READY_OBSERVABLE_DECK_TRUTH"
				+ "|signature=" + signature
				+ "|actor_id=" + str(actor_id)
				+ "|complete=true"
				+ "|assets_hot=true"
				+ "|property_hot=true"
				+ "|vehicle_hot=true"
				+ "|property_surfaces_hot=true"
				+ "|artifact_hot=true"
				+ "|pet_hot=true"
				+ "|false_completion_forbidden=true"
				+ "|registry_key_safe=true"
				+ "|one_surface_per_frame=true"
				+ "|ready_gate_member=false"
				+ "|build_on_click=false"
				+ "|at_ms=" + str(completed_at_ms)
			)
			return

	var advance_tree:= get_tree()

	if advance_tree == null:
		call_deferred(
			"_continue_post_ready_observable_surface_deck_prewarm",
			actor_id,
			signature,
			request_key,
			stage_index + 1
		)
		return

	advance_tree.process_frame.connect(
		Callable(
			self,
			"_continue_post_ready_observable_surface_deck_prewarm"
		).bind(
			actor_id,
			signature,
			request_key,
			stage_index + 1
		),
		CONNECT_ONE_SHOT
	)
func _apply_grocery_realtime_lens_patch_contract(
		patch: Dictionary
) -> void:
	if patch.is_empty():
		return

	var store_id: String = str(
		patch.get(
