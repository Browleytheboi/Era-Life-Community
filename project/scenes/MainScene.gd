func _restore_market_parent_surface(
	return_surface_key: String,
	reason: String
) -> void:
	var clean_key: String = str(
		return_surface_key
	).strip_edges().to_lower()

	match clean_key:
		"assets_contract_panel":
			if (
				assets_panel != null
				and is_instance_valid(
					assets_panel
				)
			):
				assets_panel_open = true
				assets_panel.visible = true
				assets_panel.mouse_filter = (
					Control.MOUSE_FILTER_STOP
				)
				assets_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				_claim_interactive_surface_authority(
					assets_panel,
					"assets_contract_panel",
					reason,
					true,
					true
				)
				return

		"activities_action_panel":
			if (
				activities_action_panel != null
				and is_instance_valid(
					activities_action_panel
				)
			):
				activities_action_open = true
				activities_action_panel.visible = true
				activities_action_panel.mouse_filter = (
					Control.MOUSE_FILTER_STOP
				)
				activities_action_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				_claim_interactive_surface_authority(
					activities_action_panel,
					"activities_action_panel",
					reason,
					true,
					true
				)
				return

		"standard_tab_popup":
			_restore_standard_tab_popup_after_child_surface()
			return

		_:
			_reveal_existing_life_shell_after_surface_close(
				reason
			)
