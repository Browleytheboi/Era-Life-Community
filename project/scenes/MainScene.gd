		"checkpoint_restoration_mouse_motion"
	]
	var requested_grace_ms: int = maxi(
		0,
		grace_ms
	)
	var effective_grace_ms: int = (
		64
		if pointer_only
		else maxi(
			80,
			requested_grace_ms
		)
	)
	var until_ms: int = now_ms + effective_grace_ms

	set_meta(
		"ui_interaction_last_reason",
