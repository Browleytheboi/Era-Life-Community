func _build_god_mode_life_prewarm_contract(settings: Dictionary, reason: String = "god_mode") -> Dictionary:
	var safe_settings: Dictionary = settings.duplicate(true)
	var feature_overrides: Dictionary = {}
	var feature_raw: Variant = safe_settings.get("feature_overrides", {})
	if typeof(feature_raw) == TYPE_DICTIONARY:
		feature_overrides = (feature_raw as Dictionary).duplicate(true)

	var power_config: Dictionary = {}
	var power_raw: Variant = safe_settings.get("superpower_configurator", null)
	if typeof(power_raw) == TYPE_DICTIONARY:
		power_config = (power_raw as Dictionary).duplicate(true)

	var bending_type: String = str(safe_settings.get("bending_type", "none")).strip_edges().to_lower()
	var reality_mode: String = str(safe_settings.get("reality_mode", "realistic")).strip_edges().to_lower()
	if reality_mode == "":
		reality_mode = "realistic"
	var household_contract: Dictionary = _household_spawn_contract_from_settings(safe_settings)
	var household_enabled: bool = not household_contract.is_empty()
	var world_seed: int = int(safe_settings.get("world_seed", safe_settings.get("seed", -1)))
	var seed_contract_raw: Variant = safe_settings.get("seed_contract", {})
	if world_seed <= 0 and typeof(seed_contract_raw) == TYPE_DICTIONARY:
		world_seed = int((seed_contract_raw as Dictionary).get("seed", -1))

	var soul_seed_contract: Dictionary = {
		"schema": "eralife.soul_seed_prewarm_contract",
		"version": 1,
		"source": "god_mode_life_prewarm",
