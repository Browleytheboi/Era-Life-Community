		return

	var title: String = str(section.get("title", "Section"))
	var render_mode: String = str(section.get("render_mode", "entry_cards")).strip_edges().to_lower()

	if render_mode == "info_card":
		var lines: Array = _superpower_hub_safe_array(section.get("lines", []))
		if lines.is_empty():
			lines = _superpower_hub_safe_array(section.get("rows", []))
		_add_superpower_hub_info_card(str(section.get("info_title", title)), lines)
		return

	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.add_theme_stylebox_override("panel", MainSceneHelpers._build_superpower_hub_panel_style())
	superpower_hub_content_box.add_child(card)

	var box:= VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override("separation", 10)
	card.add_child(box)

	var title_label:= Label.new()
	title_label.text = title
	title_label.add_theme_font_size_override("font_size", 22)
	title_label.add_theme_color_override("font_color", Color(1.0, 0.82, 1.0, 1.0))
	box.add_child(title_label)

	if render_mode == "action_grid":
		_add_superpower_hub_action_grid_to_box(box, _superpower_hub_safe_array(section.get("actions", [])))
		return

	var rows: Array = _superpower_hub_safe_array(section.get("rows", []))
	if rows.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "Nothing to display yet."
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.add_theme_font_size_override("font_size", 15)
		empty_label.add_theme_color_override("font_color", Color(0.88, 0.82, 1.0, 0.96))
		box.add_child(empty_label)
		return

	for raw_row in rows:
		var entry: Dictionary = _superpower_hub_entry_dictionary(raw_row)
		_add_superpower_hub_entry_card(box, str(section.get("id", "")), entry)
func _add_superpower_hub_action_grid_to_box(parent: VBoxContainer, actions: Array) -> void:
	if parent == null:
		return

	if actions.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "No hero actions are available yet."
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.add_theme_font_size_override("font_size", 15)
		empty_label.add_theme_color_override("font_color", Color(0.88, 0.82, 1.0, 0.96))
		parent.add_child(empty_label)
		return

	var action_grid:= GridContainer.new()
	action_grid.columns = 2
	action_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	action_grid.add_theme_constant_override("h_separation", 8)
	action_grid.add_theme_constant_override("v_separation", 8)
	parent.add_child(action_grid)

	for raw_action in actions:
		if typeof(raw_action) != TYPE_DICTIONARY:
			continue

		var action: Dictionary = _superpower_hub_safe_dictionary(raw_action)
		var button:= Button.new()
		button.text = str(action.get("label", "Action"))
		button.tooltip_text = str(action.get("description", ""))
		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		button.focus_mode = Control.FOCUS_NONE
		button.disabled = bool(action.get("disabled", false))
		button.pressed.connect(_on_superpower_hub_entry_action_pressed.bind(action))
		_style_god_mode_button(button, true)
		action_grid.add_child(button)
func _rebuild_superpower_hub_section_bar(sections: Array) -> void:
	if superpower_hub_section_bar == null:
		return

	_clear_container_children(superpower_hub_section_bar)
	superpower_hub_section_buttons.clear()

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue

		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		var section_id: String = str(section.get("id", "")).strip_edges().to_lower()
		if section_id == "":
			continue

		var button:= Button.new()
		button.text = str(section.get("title", section_id.replace("_", " ").capitalize()))
		button.custom_minimum_size = Vector2(180, 44)
		button.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		button.focus_mode = Control.FOCUS_NONE
		button.pressed.connect(_set_superpower_hub_section.bind(section_id))
		_style_god_mode_button(button, false)
		superpower_hub_section_bar.add_child(button)
		superpower_hub_section_buttons [section_id] = button


func _superpower_hub_selected_section(payload: Dictionary) -> Dictionary:
	var sections: Array = _superpower_hub_safe_array(payload.get("sections", []))
	var valid_ids: Array = []

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue
		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		var section_id: String = str(section.get("id", "")).strip_edges().to_lower()
		if section_id != "":
			valid_ids.append(section_id)

	var clean_section: String = str(superpower_hub_current_section).strip_edges().to_lower()
	if clean_section == "" or clean_section not in valid_ids:
		clean_section = str(payload.get("default_section_id", "")).strip_edges().to_lower()
	if clean_section == "" or clean_section not in valid_ids:
		if not valid_ids.is_empty():
			clean_section = str(valid_ids [0])

	superpower_hub_current_section = clean_section

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue
		var section: Dictionary = _superpower_hub_safe_dictionary(raw_section)
		if str(section.get("id", "")).strip_edges().to_lower() == clean_section:
			return section

	return {}


func _set_superpower_hub_section(section_id: String) -> void:
	var clean_section: String = str(section_id).strip_edges().to_lower()
	if clean_section == "":
		return

	superpower_hub_current_section = clean_section
	_precompute_super_runtime_surface_cache_for_state(gs, "superpower_hub_section_click")
	_render_superpower_hub_overlay()

func _sync_superpower_hub_section_buttons() -> void:
	var selected_id: String = str(superpower_hub_current_section).strip_edges().to_lower()
	var core:= Color(0.82, 0.42, 1.0, 1.0)

	for raw_key in superpower_hub_section_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = superpower_hub_section_buttons.get(key, null)
		if button == null:
			continue

		var selected: bool = key == selected_id
		var style: StyleBoxFlat = null
		if button.has_meta("superpower_hub_section_style"):
			style = button.get_meta("superpower_hub_section_style") as StyleBoxFlat

		if style == null:
			style = StyleBoxFlat.new()
			style.border_width_left = 2
			style.border_width_top = 2
			style.border_width_right = 2
			style.border_width_bottom = 2
			style.corner_radius_top_left = 14
			style.corner_radius_top_right = 14
			style.corner_radius_bottom_left = 14
			style.corner_radius_bottom_right = 14
			button.set_meta("superpower_hub_section_style", style)
			button.add_theme_stylebox_override("normal", style)
			button.add_theme_stylebox_override("hover", style)
			button.add_theme_stylebox_override("pressed", style)

		style.bg_color = Color(core.r, core.g, core.b, 0.24 if selected else 0.1)
		style.border_color = Color(core.r, core.g, core.b, 0.88 if selected else 0.34)
		button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))


func _superpower_hub_entry_dictionary(raw_row: Variant) -> Dictionary:
	if typeof(raw_row) == TYPE_DICTIONARY:
		return (raw_row as Dictionary).duplicate(true)

	return {
		"label": str(raw_row),
		"description": "",
		"overview_title": str(raw_row),
		"overview_lines": [str(raw_row)],
		"clickable": true
	}


