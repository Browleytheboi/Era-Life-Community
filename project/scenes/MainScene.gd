		)

		prepared_count += 1

	var complete: bool = (
		required_count == prepared_count
	)

	set_meta(
		"property_viewer_surface_deck_actor_id",
		actor_id
	)
	set_meta(
		"property_viewer_surface_deck_required_count",
		required_count
	)
	set_meta(
		"property_viewer_surface_deck_prepared_count",
		prepared_count
	)
	set_meta(
		"property_viewer_surface_deck_hot",
		complete
	)
	set_meta(
		"property_viewer_surface_deck_build_on_click",
		false
	)

	return complete


func _property_viewer_surface_panel_for(
	actor_id: int,
	property_id: int
) -> PropertyViewer:
	if (
		actor_id <= 0
		or property_id <= 0
	):
		return null

	var direct_key: String = MainSceneHelpers._property_viewer_surface_panel_key(
		actor_id,
		property_id
	)
	var panel_raw: Variant = (
		property_viewer_surface_panel_by_key.get(
			direct_key,
			null
		)
	)

	if (
		typeof(panel_raw) == TYPE_OBJECT
		and is_instance_valid(panel_raw)
		and panel_raw is PropertyViewer
	):
		return panel_raw as PropertyViewer

	for raw_key in property_viewer_surface_panel_by_key.keys():
		var candidate_raw: Variant = (
			property_viewer_surface_panel_by_key.get(
				raw_key,
				null
			)
		)

		if (
			typeof(candidate_raw) != TYPE_OBJECT
			or not is_instance_valid(candidate_raw)
			or not candidate_raw is PropertyViewer
		):
			continue

		var candidate: PropertyViewer = (
			candidate_raw as PropertyViewer
		)
		var candidate_property_id: int = int(
			candidate.get_meta(
				"property_viewer_asset_id",
				candidate.get_meta(
					"property_id",
					-1
				)
			)
		)

		if candidate_property_id != property_id:
			continue

		var candidate_actor_id: int = int(
			candidate.get_meta(
				"property_viewer_actor_id",
				-1
			)
		)
		var candidate_owner_id: int = int(
			candidate.get_meta(
				"property_viewer_owner_id",
				-1
			)
		)

		if (
			candidate_actor_id == actor_id
			or candidate_owner_id == actor_id
			or candidate_actor_id <= 0
		):
			property_viewer_surface_panel_by_key [
				direct_key
			] = candidate

			candidate.set_meta(
				"property_viewer_resident_alias_actor_id",
				actor_id
			)
			candidate.set_meta(
				"property_viewer_resident_alias_property_id",
				property_id
			)
			candidate.set_meta(
				"property_viewer_resident_alias_build_performed",
				false
			)

			return candidate

	return null
func _ensure_property_viewer_panel() -> void:
	if property_viewer_panel != null and is_instance_valid(property_viewer_panel):
		property_viewer_panel.bind_host(self, gs)
		return

	property_viewer_panel = PropertyViewer.new()
	property_viewer_panel.name = "PropertyViewer"
	property_viewer_panel.visible = false
	property_viewer_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	property_viewer_panel.z_index = 174
	property_viewer_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	property_viewer_panel.bind_host(self, gs)
	property_viewer_panel.close_requested.connect(_hide_property_viewer_panel)
	property_viewer_panel.property_action_requested.connect(_on_property_viewer_action_requested)
	property_viewer_panel.makeover_action_requested.connect(_on_property_makeover_action_requested)
	add_child(property_viewer_panel)


func _hide_property_viewer_panel() -> void:
	var exiting_actor_id: int = -1
	var exiting_property_id: int = -1
	var exiting_property_owner_id: int = -1
	var exit_reset_required: bool = false

	if (
		property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
	):
		exit_reset_required = (
			property_viewer_panel.visible
			or property_viewer_open
		)

		exiting_actor_id = int(
			property_viewer_panel.get_meta(
				"property_viewer_actor_id",
				(
					int(
						gs.player.id
					)
					if (
						gs != null
						and gs.player != null
					)
					else -1
				)
			)
		)

		exiting_property_id = int(
			property_viewer_panel.get_meta(
				"property_viewer_asset_id",
				-1
			)
		)

		exiting_property_owner_id = int(
			property_viewer_panel.get_meta(
				"property_viewer_owner_id",
				exiting_actor_id
			)
		)

	property_viewer_open = false

	if (
		property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
	):
		property_viewer_panel.visible = false
		property_viewer_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		property_viewer_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)

		property_viewer_panel.set_meta(
			"interactive_surface_input_suspended",
			true
		)
		property_viewer_panel.set_meta(
			"interactive_surface_released",
			true
		)
		property_viewer_panel.set_meta(
			"interactive_surface_released_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)



	if (
		exit_reset_required
		and exiting_actor_id > 0
		and exiting_property_id > 0
	):
		call_deferred(
			"_commit_property_exit_deferred",
			exiting_actor_id,
			exiting_property_id,
			exiting_property_owner_id
		)

	var return_surface_key: String = str(
		get_meta(
			"property_viewer_return_surface_key",
			""
		)
	).strip_edges().to_lower()

	var return_actor_id: int = int(
		get_meta(
			"property_viewer_return_surface_actor_id",
			-1
		)
	)

	if has_meta(
		"property_viewer_return_surface_key"
	):
		remove_meta(
			"property_viewer_return_surface_key"
		)

	if has_meta(
		"property_viewer_return_surface_actor_id"
	):
		remove_meta(
			"property_viewer_return_surface_actor_id"
		)

	var return_surface: Control = (
		_interactive_surface_authority_candidate_by_key(
			return_surface_key
		)
	)

	var actor_still_matches: bool = (
		return_actor_id <= 0
		or (
			gs != null
			and gs.player != null
			and int(
				gs.player.id
			) == return_actor_id
		)
	)

	if (
		actor_still_matches
		and return_surface != null
		and is_instance_valid(
			return_surface
		)
	):
		return_surface.visible = true
		return_surface.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)
		return_surface.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)

		if return_surface == assets_panel:
			assets_panel_open = true
		elif return_surface == property_market_panel:
			property_market_open = true
		elif return_surface == vehicle_market_panel:
			vehicle_market_open = true

		_claim_interactive_surface_authority(
			return_surface,
			return_surface_key,
			"property_viewer_zero_frame_return",
			true,
			true
		)

		set_meta(
			"property_viewer_return_reveal_only",
			true
		)
		set_meta(
			"property_viewer_return_engine_calls",
			false
		)
		set_meta(
			"property_viewer_return_render_performed",
			false
		)
		set_meta(
			"property_viewer_return_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	_restore_standard_tab_popup_after_child_surface()
func _commit_property_exit_deferred(
	actor_id: int,
	property_id: int,
	property_owner_id: int
) -> void:
	if (
		gs == null
		or actor_id <= 0
		or property_id <= 0
	):
		return

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"intent_type": (
					"spatial_traversal"
				),
				"surface_id": (
					"property_viewer_panel"
				),
				"action_id": "leave_property",
				"immutable_contract_references": true,
				"skip_crr_observation": true,
				"payload": {
					"actor_id": actor_id,
					"property_id": property_id,
					"property_owner_id": (
						property_owner_id
					),
					"action_id": "leave_property",
					"source": (
						"mainscene.property_exit_deferred"
					),
					"ui_is_renderer_only": true,
				},
				"target": {
					"route_kind": (
						"engine_method"
					),
					"engine_property": (
						"spatial_traversal_contract_engine"
					),
					"method": (
						"leave_property_space"
					),
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene.property_exit_deferred"
				)
			},
			{
				"actor_id": actor_id,
				"surface_id": (
					"property_viewer_panel"
				),
				"action_id": "leave_property",
				"source": (
					"mainscene.property_exit_deferred"
				),
				"immutable_contract_references": true,
				"skip_crr_observation": true
			}
		)
	)

	var result: Dictionary = (
		_property_spatial_route_result(
			report
		)
	)

	var delta_raw: Variant = result.get(
		"surface_delta_contract",
		{}
	)

	var resident_panel: PropertyViewer = (
		_property_viewer_surface_panel_for(
			actor_id,
			property_id
		)
	)

	if (
		typeof(delta_raw) == TYPE_DICTIONARY
		and not (
			delta_raw as Dictionary
		).is_empty()
		and resident_panel != null
		and is_instance_valid(
			resident_panel
		)
	):
		resident_panel.apply_surface_delta(
			delta_raw as Dictionary
		)




	_queue_auxiliary_surface_observation_task(
		"property_destination_target",
		actor_id,
		(
			"property_exit_reset_%d"
			% property_id
		),
		{
			"property_id": property_id,
			"property_owner_id": (
				property_owner_id
			)
		}
	)

	set_meta(
		"property_exit_reset_committed",
		bool(
			result.get(
				"success",
				false
			)
		)
	)
	set_meta(
		"property_exit_reset_click_path_work",
		false
	)
	set_meta(
		"property_exit_reset_next_entry_at_entrance",
		true
	)

func _property_viewer_request_contract(
	property_owner: Person,
	surface_actor: Person,
	asset_id: int,
	mode: String,
	status_text: String = ""
) -> Dictionary:
	if (
		gs == null
		or property_owner == null
		or surface_actor == null
		or asset_id <= 0
	):
		return {
			"success": false,
			"schema": "eralife.property_space.surface_contract",
			"version": 1,
			"mode": mode,
			"actor_id": (
				int(surface_actor.id)
				if surface_actor != null
				else -1
			),
			"property_owner_id": (
				int(property_owner.id)
				if property_owner != null
				else -1
			),
			"property_id": asset_id,
			"title": "PROPERTY SPACE",
			"subtitle": "The property request was incomplete.",
			"status_text": "CRR blocked an invalid property surface request.",
			"floors": [],
			"active_floor": 0,
			"active_room": "entryway",
			"current_room": {},
			"room_navigation_actions": [],
			"navigation_actions": [],
			"movement_options": [],
			"spatial_movement_actions": [],
			"room_interaction_actions": [],
			"makeover_paths": [],
			"actions": [
				{
					"action_id": "leave_property",
					"label": "Leave Property"
				}
			],
			"truth_state": "invalid_request_but_observable",
			"ui_is_renderer_only": true,
		}

	var resolved_status_text: String = (
		status_text.strip_edges()
	)

	if (
		resolved_status_text == ""
		and mode == "interior"
	):
		resolved_status_text = (
			"You enter through the front door and close it behind you."
		)

	var method_name: String = (
		"emit_property_space_contract"
	)

	if mode == "makeover":
		method_name = (
			"emit_makeover_surface_contract"
		)

	var actor_id: int = int(
		surface_actor.id
	)
	var property_owner_id: int = int(
		property_owner.id
	)

	var payload: Dictionary = {
		"actor_id": actor_id,
		"property_owner_id": property_owner_id,
		"property_id": asset_id,
		"mode": mode,
		"status_text": resolved_status_text,
		"source": (
			"mainscene.property_viewer_surface_request"
		),
		"ui_is_renderer_only": true
	}

	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": (
			"property_space_surface_request"
		),
		"surface_id": "property_viewer_panel",
		"action_id": "view_property_%s" % mode,
		"payload": payload.duplicate(true),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"property_makeover_contract_engine"
			),
			"method": method_name,
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": "mainscene.property_viewer"
	}, {
		"actor_id": actor_id,
		"source": "mainscene.property_viewer",
		"surface_id": "property_viewer_panel",
		"action_id": "view_property_%s" % mode
	})

	var result: Dictionary = (
		_market_panel_route_result(report)
	)

	if (
		typeof(
			result.get(
				"surface_contract",
				{}
			)
		) == TYPE_DICTIONARY
	):
		var routed_surface: Dictionary = (
			result.get(
				"surface_contract",
				{}
			) as Dictionary
		).duplicate(true)

		if not routed_surface.is_empty():
			routed_surface ["actor_id"] = int(
				routed_surface.get(
					"actor_id",
					actor_id
				)
			)
			routed_surface ["property_owner_id"] = int(
				routed_surface.get(
					"property_owner_id",
					property_owner_id
				)
			)
			routed_surface ["property_id"] = int(
				routed_surface.get(
					"property_id",
					asset_id
				)
			)

			if str(
				routed_surface.get(
					"status_text",
					""
				)
			).strip_edges() == "":
				routed_surface ["status_text"] = (
					resolved_status_text
				)

			if _property_viewer_contract_is_crr_complete(
				routed_surface,
				mode
			):
				return routed_surface

	if bool(
		result.get(
			"success",
			false
		)
	):
		result ["actor_id"] = int(
			result.get(
				"actor_id",
				actor_id
			)
		)
		result ["property_owner_id"] = int(
			result.get(
				"property_owner_id",
				property_owner_id
			)
		)
		result ["property_id"] = int(
			result.get(
				"property_id",
				asset_id
			)
		)

		if str(
			result.get(
				"status_text",
				""
			)
		).strip_edges() == "":
			result ["status_text"] = (
				resolved_status_text
			)

		var has_expected_surface_payload: bool = (
			(
				mode == "makeover"
				and typeof(
					result.get(
						"makeover_paths",
						[]
					)
				) == TYPE_ARRAY
			)
			or (
				mode != "makeover"
				and typeof(
					result.get(
						"floors",
						[]
					)
				) == TYPE_ARRAY
			)
		)

		if (
			has_expected_surface_payload
			and _property_viewer_contract_is_crr_complete(
				result,
				mode
			)
		):
			return result.duplicate(true)





	return {
		"success": false,
		"schema": "eralife.property_space.surface_contract",
		"version": 1,
		"mode": mode,
		"actor_id": actor_id,
		"property_owner_id": property_owner_id,
		"property_id": asset_id,
		"title": "PROPERTY SPACE",
		"subtitle": "The property exists, but its surface contract could not be hydrated.",
		"status_text": (
			resolved_status_text
			if resolved_status_text != ""
			else (
				"CRR fallback: property surface contract failed to hydrate."
			)
		),
		"floors": [],
		"active_floor": 0,
		"active_room": "entryway",
		"current_room": {},
		"room_navigation_actions": [],
		"navigation_actions": [],
		"movement_options": [],
		"spatial_movement_actions": [],
		"room_interaction_actions": [],
		"makeover_paths": [],
		"actions": [
			{
				"action_id": "open_makeover",
				"label": "Open Property Makeover"
			},
			{
				"action_id": "view_household",
				"label": "View Household Members"
			},
			{
				"action_id": "leave_property",
				"label": "Leave Property"
			}
		],
		"truth_state": (
			"surface_contract_missing_but_observable"
		),
		"ui_is_renderer_only": true,
	}
func _property_viewer_contract_is_crr_complete(contract: Dictionary, mode: String) -> bool:
	if contract.is_empty():
		return false

	if mode == "makeover":
		var makeover_paths_raw: Variant = contract.get("makeover_paths", [])
		return typeof(makeover_paths_raw) == TYPE_ARRAY and not (makeover_paths_raw as Array).is_empty()

	var has_movement: bool = false
	for movement_key in [
		"room_navigation_actions",
		"navigation_actions",
		"movement_options",
		"spatial_movement_actions"
	]:
		var movement_actions_raw: Variant = contract.get(movement_key, [])
		if typeof(movement_actions_raw) == TYPE_ARRAY and not (movement_actions_raw as Array).is_empty():
			has_movement = true
			break

	var has_property_actions: bool = false
	var property_actions_raw: Variant = contract.get("actions", [])
	if typeof(property_actions_raw) == TYPE_ARRAY:
		for raw_action in property_actions_raw:
			if typeof(raw_action) != TYPE_DICTIONARY:
				continue

			var action: Dictionary = raw_action
			var action_id: String = str(action.get("action_id", "")).strip_edges()
			if action_id not in ["", "move_room", "move_to_room", "navigate_floor", "inspect_room", "use_fixture"]:
				has_property_actions = true
				break

	return has_movement and has_property_actions
func _queue_eralife_network_live_presence_after_visible_shell() -> void:
	if gs == null or gs.player == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var life_id: String = str(
		gs.scenario_state.get(
			"life_id",
			""
		)
	).strip_edges()

	if life_id == "":
		life_id = "life_%d_%d" % [
			int(gs.player.id),
			int(gs.year)
		]

	var publish_key: String = "%s|%d" % [
		life_id,
		int(gs.player.id)
	]
	var queued_keys: Dictionary = (
		gs.scenario_state.get(
			"network_presence_publish_queued_keys",
			{}
		)
		if typeof(
			gs.scenario_state.get(
				"network_presence_publish_queued_keys",
				{}
			)
		) == TYPE_DICTIONARY
		else {}
	)

	if bool(
		queued_keys.get(
			publish_key,
			false
		)
	):
		return

	queued_keys [publish_key] = true
	gs.scenario_state [
		"network_presence_publish_queued_keys"
	] = queued_keys

	call_deferred(
		"_publish_eralife_network_live_presence_after_visible_shell",
		publish_key,
		life_id
	)


func _publish_eralife_network_live_presence_after_visible_shell(
	publish_key: String,
	life_id: String
) -> void:
	if gs == null or gs.player == null:
		return

	if not gs.has_method(
		"queue_command_envelope"
	):
		return

	var drain_report: Dictionary = (
		gs.queue_command_envelope({
			"command": (
				"self_host_network.publish_presence"
			),
			"life_id": life_id,
			"source": (
				"mainscene.visible_playable_life_shell"
			),
			"ui_is_renderer_only": true,
			"auto_drain": true
		})
	)
	var report: Dictionary = (
		MainSceneHelpers._first_handled_command_report(
			drain_report
		)
	)

	if bool(
		report.get(
			"success",
			false
		)
	):
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	var queued_keys: Dictionary = (
		gs.scenario_state.get(
			"network_presence_publish_queued_keys",
			{}
		)
		if typeof(
			gs.scenario_state.get(
				"network_presence_publish_queued_keys",
				{}
			)
		) == TYPE_DICTIONARY
		else {}
	)

	queued_keys.erase(publish_key)
	gs.scenario_state [
		"network_presence_publish_queued_keys"
	] = queued_keys
func _on_property_viewer_action_requested(
	action_id: String,
	payload: Dictionary
) -> void:
	if gs == null:
		return

	var surface_actor: Person = gs.player
	if (
		surface_actor == null
		and property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
	):
		var cached_actor_id: int = int(
			property_viewer_panel.get_meta(
				"property_viewer_actor_id",
				-1
			)
		)
		if cached_actor_id > 0:
			surface_actor = (
				gs.get_or_reactivate_npc_by_id(
					cached_actor_id
				)
			)

	if surface_actor == null:
		return

	var active_surface_contract: Dictionary = {}
	if (
		property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
		and "active_contract" in property_viewer_panel
	):
		var active_raw: Variant = (
			property_viewer_panel.active_contract
		)
		if typeof(active_raw) == TYPE_DICTIONARY:


			active_surface_contract = (
				active_raw as Dictionary
			)

	var property_id: int = int(
		payload.get(
			"property_id",
			-1
		)
	)
	if (
		property_id <= 0
		and property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
	):
		property_id = int(
			property_viewer_panel.get_meta(
				"property_viewer_asset_id",
				-1
			)
		)
	if property_id <= 0:
		property_id = int(
			active_surface_contract.get(
				"property_id",
				-1
			)
		)

	var property_owner_id: int = int(
		payload.get(
			"property_owner_id",
			-1
		)
	)
	if (
		property_owner_id <= 0
		and property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
	):
		property_owner_id = int(
			property_viewer_panel.get_meta(
				"property_viewer_owner_id",
				-1
			)
		)
	if property_owner_id <= 0:
		property_owner_id = int(
			active_surface_contract.get(
				"property_owner_id",
				-1
			)
		)

	var traversal_payload: Dictionary = (
		MainSceneHelpers._compact_property_spatial_intent_payload(
			payload,
			action_id,
			int(surface_actor.id),
			property_id,
			property_owner_id
		)
	)

	if action_id == "open_minigame_host":
		var mini_game_payload: Dictionary = (
			traversal_payload.duplicate(false)
		)
		mini_game_payload ["action_id"] = "open_host"
		mini_game_payload ["intent_type"] = "minigame"
		mini_game_payload ["surface_id"] = "minigame_panel"
		mini_game_payload ["active_section"] = "games"
		mini_game_payload ["source"] = (
			"mainscene.property_viewer.minigame_host"
		)
		mini_game_payload ["ui_is_renderer_only"] = true
		_on_mini_game_intent_requested(
			mini_game_payload
		)
		return

	if action_id == "open_makeover":
		if property_id <= 0:
			_maybe_show_action_result_popup({
				"success": false,
				"popup_title": "Property Makeover",
				"popup_text": (
					"No property was attached to this makeover request."
				),
				"popup_footer": (
					"CRR blocked an invalid construction intent before mutation."
				)
			})
			return

		var property_owner: Person = surface_actor
		if property_owner_id > 0:
			var resolved_owner: Person = (
				gs.get_or_reactivate_npc_by_id(
					property_owner_id
				)
			)
			if resolved_owner != null:
				property_owner = resolved_owner

		_show_property_makeover_panel(
			property_owner,
			property_id
		)
		return

	if action_id == "leave_property":
		_hide_property_viewer_panel()
		return

	set_meta(
		"property_spatial_action_engine_work_on_press",
		false
	)
	set_meta(
		"property_spatial_action_surface_rebuild_on_press",
		false
	)
	set_meta(
		"property_spatial_action_deep_copy_on_press",
		false
	)
	set_meta(
		"property_spatial_action_scalar_intent_only",
		true
	)
	set_meta(
		"property_spatial_action_requested_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)




	call_deferred(
		"_commit_property_viewer_action_deferred",
		int(surface_actor.id),
		action_id,
		traversal_payload
	)
func _commit_property_viewer_action_deferred(
	actor_id: int,
	action_id: String,
	traversal_payload: Dictionary
) -> void:
	if (
		gs == null
		or actor_id <= 0
	):
		return

	var surface_actor: Person = null
	if (
		gs.player != null
		and int(
			gs.player.id
		) == actor_id
	):
		surface_actor = gs.player
	else:
		surface_actor = (
			gs.get_or_reactivate_npc_by_id(
				actor_id
			)
		)

	if surface_actor == null:
		return

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"intent_type": "spatial_traversal",
			"surface_id": "property_viewer_panel",
			"action_id": action_id,



			"immutable_contract_references": true,




			"skip_crr_observation": true,

			"payload": traversal_payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"spatial_traversal_contract_engine"
				),
				"method": (
					"commit_property_space_action"
				),
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": "mainscene.property_viewer"
		},
		{
			"actor_id": actor_id,
			"source": "mainscene.property_viewer",
			"surface_id": "property_viewer_panel",
			"action_id": action_id,
			"immutable_contract_references": true,
			"skip_crr_observation": true
		}
	)

	var result: Dictionary = (
		_property_spatial_route_result(
			report
		)
	)

	var delta: Dictionary = {}
	var delta_raw: Variant = result.get(
		"surface_delta_contract",
		result.get(
			"surface_delta",
			{}
		)
	)
	if typeof(delta_raw) == TYPE_DICTIONARY:
		delta = delta_raw as Dictionary

	var delta_applied: bool = false
	if (
		not delta.is_empty()
		and property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
		and property_viewer_panel.has_method(
			"apply_surface_delta"
		)
	):
		property_viewer_panel.apply_surface_delta(
			delta
		)
		delta_applied = true

	var presentation_cue: String = str(
		result.get(
			"presentation_cue",
			delta.get(
				"presentation_cue",
				""
			)
		)
	).strip_edges()

	if (
		bool(
			result.get(
				"success",
				false
			)
		)
		and presentation_cue != ""
	):
		_play_property_spatial_audio_cue(
			presentation_cue
		)

	var result_text: String = str(
		result.get(
			"text",
			result.get(
				"narrative",
				""
			)
		)
	)




	if action_id == "inspect_room":
		set_meta(
			"property_inspect_observation_only",
			true
		)
		set_meta(
			"property_inspect_modal_opened",
			false
		)

	elif action_id == "use_fixture":
		set_meta(
			"property_fixture_focus_observation_only",
			true
		)
		set_meta(
			"property_fixture_focus_modal_opened",
			false
		)

	elif action_id == "view_household":
		_maybe_show_action_result_popup({
			"success": bool(
				result.get(
					"success",
					true
				)
			),
			"popup_title": str(
				result.get(
					"popup_title",
					"Property Space"
				)
			),
			"popup_text": (
				result_text
				if result_text != ""
				else "The property interaction resolved."
			),
			"popup_footer": (
				"The room remains resident behind this result."
			)
		})

	set_meta(
		"property_spatial_result_rendered",
		delta_applied
	)
	set_meta(
		"property_spatial_surface_delta_applied",
		delta_applied
	)
	set_meta(
		"property_spatial_surface_rebuild_performed",
		false
	)
	set_meta(
		"property_spatial_full_surface_returned",
		false
	)
	set_meta(
		"property_spatial_global_crr_reobservation_performed",
		false
	)
	set_meta(
		"property_spatial_result_deep_copy_performed",
		false
	)

	if delta_applied:
		return




	if (
		property_viewer_panel != null
		and is_instance_valid(
			property_viewer_panel
		)
		and property_viewer_panel.status_label != null
		and is_instance_valid(
			property_viewer_panel.status_label
		)
	):
		property_viewer_panel.status_label.text = (
			result_text
			if result_text != ""
			else (
				"That route is not currently observable."
			)
		)
func _prewarm_property_spatial_audio_lane(
	attempt: int = 0
) -> void:
	if property_spatial_audio_prewarm_complete:
		return

	if (
		property_spatial_audio_prewarm_active
		and attempt == 0
	):
		return

	property_spatial_audio_prewarm_active = true

	_ensure_property_spatial_audio_players()

	var pending: bool = false
	var unresolved: bool = false
	var request_reasons: Dictionary = {}

	for cue_key in [
		"walking",
		"door_lock",
		"door_unlock"
	]:
		if property_spatial_audio_stream_cache.has(
			cue_key
		):
			request_reasons [
				cue_key
			] = "resident_cache_hot"
			continue

		var cue_report: Dictionary = (
			_request_property_spatial_audio_stream(
				cue_key
			)
		)

		request_reasons [
			cue_key
		] = str(
			cue_report.get(
				"reason",
				"unknown"
			)
		)

		if bool(
			cue_report.get(
				"pending",
				false
			)
		):
			pending = true

		if not property_spatial_audio_stream_cache.has(
			cue_key
		):
			unresolved = true

	property_spatial_audio_prewarm_complete = (
		property_spatial_audio_stream_cache.has(
			"walking"
		)
		and property_spatial_audio_stream_cache.has(
			"door_lock"
		)
		and property_spatial_audio_stream_cache.has(
			"door_unlock"
		)
	)

	set_meta(
		"property_spatial_audio_last_request_reasons",
		request_reasons.duplicate(false)
	)
	set_meta(
		"property_spatial_audio_last_attempt",
		attempt
	)
	set_meta(
		"property_spatial_audio_last_pending",
		pending
	)
	set_meta(
		"property_spatial_audio_last_unresolved",
		unresolved
	)
	set_meta(
		"property_spatial_audio_ready_gate_member",
		false
	)
	set_meta(
		"property_spatial_audio_build_on_press",
		false
	)

	if property_spatial_audio_prewarm_complete:
		property_spatial_audio_prewarm_active = false

		set_meta(
			"property_spatial_audio_prewarm_complete",
			true
		)
		set_meta(
			"property_spatial_audio_prewarmed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"property_spatial_audio_retry_scheduled",
			false
		)

		return

	var tree:= get_tree()

	if tree == null:
		property_spatial_audio_prewarm_active = false

		set_meta(
			"property_spatial_audio_prewarm_complete",
			false
		)
		set_meta(
			"property_spatial_audio_retry_scheduled",
			false
		)
		set_meta(
			"property_spatial_audio_retry_reason",
			"scene_tree_unavailable"
		)

		return




	var retry_delay_seconds: float = 0.05

	if attempt >= 120:
		retry_delay_seconds = 1.0
	elif not pending:
		retry_delay_seconds = 0.25

	var timer:= tree.create_timer(
		retry_delay_seconds
	)

	timer.timeout.connect(
		Callable(
			self,
			"_prewarm_property_spatial_audio_lane"
		).bind(
			attempt + 1
		),
		CONNECT_ONE_SHOT
	)

	set_meta(
		"property_spatial_audio_prewarm_complete",
		false
	)
	set_meta(
		"property_spatial_audio_retry_scheduled",
		true
	)
	set_meta(
		"property_spatial_audio_retry_delay_seconds",
		retry_delay_seconds
	)
	set_meta(
		"property_spatial_audio_retry_attempt",
		attempt + 1
	)
	set_meta(
		"property_spatial_audio_retry_scheduled_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)


func _ensure_property_spatial_audio_players() -> void:
	if not property_spatial_audio_players.is_empty():
		return



	for index in range(6):
		var player:= AudioStreamPlayer.new()
		player.name = (
			"PropertySpatialOneShot%d"
			% index
		)
		player.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		player.stream_paused = false
		player.autoplay = false
		player.bus = "Master"
		add_child(
			player
		)
		property_spatial_audio_players.append(
			player
		)


func _request_property_spatial_audio_stream(
	cue_key: String
) -> Dictionary:
	var candidate_paths: Array = []

	match cue_key:
		"walking":
			candidate_paths = [
				"res://Audio/Walking.ogg",
				"res://audio/Walking.ogg",
				"res://Audio/SFX/Walking.ogg",
				"res://audio/sfx/Walking.ogg",
				"res://Walking.ogg"
			]
		"door_lock":
			candidate_paths = [
				"res://Audio/DoorLock.ogg",
				"res://audio/DoorLock.ogg",
				"res://Audio/SFX/DoorLock.ogg",
				"res://audio/sfx/DoorLock.ogg",
				"res://DoorLock.ogg"
			]
		"door_unlock":
			candidate_paths = [
				"res://Audio/DoorUnlock.ogg",
				"res://audio/DoorUnlock.ogg",
				"res://Audio/SFX/DoorUnlock.ogg",
				"res://audio/sfx/DoorUnlock.ogg",
				"res://DoorUnlock.ogg"
			]
		_:
			return {
				"success": false,
				"ready": false,
				"pending": false,
				"reason": "unknown_property_spatial_audio_cue"
			}

	var engine = _ensure_era_audio_engine()
	if (
		engine == null
		or not engine.has_method(
			"request_audio_stream"
		)
	):
		return {
			"success": false,
			"ready": false,
			"pending": false,
			"reason": "missing_era_audio_engine"
		}

	var report: Dictionary = (
		engine.request_audio_stream(
			candidate_paths,
			{
				"source": (
					"mainscene.property_spatial_audio"
				),
				"cue_key": cue_key,
				"one_shot": true,
				"precache_only": true,
				"ready_gate_member": false,
				"build_on_press": false
			}
		)
	)

	var stream_raw: Variant = report.get(
		"stream",
		null
	)
	if stream_raw is AudioStream:
		property_spatial_audio_stream_cache [
			cue_key
		] = stream_raw as AudioStream

	return report


func _play_property_spatial_audio_cue(
	cue_key: String
) -> void:
	if (
		property_spatial_audio_players.is_empty()
		or not property_spatial_audio_stream_cache.has(
			cue_key
		)
	):
		return

	var stream_raw: Variant = (
		property_spatial_audio_stream_cache.get(
			cue_key,
			null
		)
	)
	if not stream_raw is AudioStream:
		return

	var pool_size: int = (
		property_spatial_audio_players.size()
	)
	if pool_size <= 0:
		return

	property_spatial_audio_player_cursor = (
		property_spatial_audio_player_cursor
		% pool_size
	)
	var player_raw: Variant = (
		property_spatial_audio_players [
			property_spatial_audio_player_cursor
		]
	)
	property_spatial_audio_player_cursor = (
		(property_spatial_audio_player_cursor + 1)
		% pool_size
	)

	if not player_raw is AudioStreamPlayer:
		return

	var player: AudioStreamPlayer = (
		player_raw as AudioStreamPlayer
	)
	if not is_instance_valid(player):
		return

	player.stream = stream_raw as AudioStream
	player.stream_paused = false
	player.pitch_scale = 1.0
	player.play()
func _on_crown_resident_diplomacy_entry_published(
		actor_id: int,
		entry: Dictionary
) -> void:
		if (
			gs == null
			or gs.player == null
			or int(
				gs.player.id
			) != actor_id
			or entry.is_empty()
		):
			return

		var entry_key: String = (
			MainSceneHelpers._crown_diplomacy_entry_key(
				entry
			)
		)

		if entry_key != "":
			var entries_raw: Variant = get_meta(
				"crown_diplomacy_stream_entries",
				[]
			)
			var entries: Array = (
				(entries_raw as Array).duplicate(false)
				if typeof(entries_raw) == TYPE_ARRAY
				else []
			)
			var replaced: bool = false

			for index in range(
				entries.size()
			):
				var existing: Dictionary = MainSceneHelpers._safe_dictionary(
					entries [
						index
					]
				)

				if MainSceneHelpers._crown_diplomacy_entry_key(
					existing
				) != entry_key:
					continue

				entries [
					index
				] = entry.duplicate(false)
				replaced = true
				break

			if not replaced:
				entries.append(
					entry.duplicate(false)
				)

			set_meta(
				"crown_diplomacy_stream_entries",
				entries
			)
			set_meta(
				"crown_diplomacy_last_published_entry_key",
				entry_key
			)
			set_meta(
				"crown_diplomacy_published_entry_retained_when_hidden",
				true
			)

		var resident_grid_hot: bool = (
			crown_hub_diplomacy_grid != null
			and is_instance_valid(
				crown_hub_diplomacy_grid
			)
		)




		if resident_grid_hot:
			call_deferred(
				"_replace_crown_diplomacy_entry_live",
				entry.duplicate(false)
			)

			set_meta(
				"crown_diplomacy_hidden_resident_card_updated",
				not (
					crown_hub_open
					and crown_hub_current_section == "diplomacy"
				)
			)

			return

		if (
			not crown_hub_open
			or crown_hub_current_section != "diplomacy"
		):
			return

		call_deferred(
			"_replace_crown_diplomacy_entry_live",
			entry.duplicate(false)
		)
func _ensure_crown_you_rule_here_banner_for_card(
		packet: Dictionary
) -> void:
		if packet.is_empty():
			return

		var entry: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"entry",
				{}
			)
		)
		var card:= packet.get(
			"card",
			null
		) as PanelContainer

		if (
			card == null
			or not is_instance_valid(
				card
			)
		):
			return

		var margin:= (
			card.get_child(0)
			as MarginContainer
			if card.get_child_count() > 0
			else null
		)

		if (
			margin == null
			or margin.get_child_count() <= 0
		):
			return

		var root:= (
			margin.get_child(0)
			as VBoxContainer
		)

		if root == null:
			return

		var existing:= root.get_node_or_null(
			"CrownYouRuleHereBanner"
		) as PanelContainer
		var player_rules_here: bool = bool(
			entry.get(
				"is_player_country",
				false
			)
		)

		if not player_rules_here:
			if existing != null:
				root.remove_child(
					existing
				)
				existing.queue_free()

			return

		if existing != null:
			return

		var core_raw: Variant = packet.get(
			"core",
			_crown_hud_core_color()
		)
		var core: Color = (
			core_raw as Color
			if typeof(core_raw) == TYPE_COLOR
			else _crown_hud_core_color()
		)

		var banner:= PanelContainer.new()
		banner.name = "CrownYouRuleHereBanner"
		banner.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		banner.custom_minimum_size = Vector2(
			0,
			48
		)
		banner.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

		var style:= StyleBoxFlat.new()
		style.bg_color = Color(
			core.r * 0.24,
			core.g * 0.2,
			core.b * 0.1,
			0.98
		)
		style.border_color = Color(
			1.0,
			0.82,
			0.3,
			0.98
		)
		style.set_border_width_all(
			2
		)
		style.set_corner_radius_all(
			12
		)
		style.shadow_color = Color(
			1.0,
			0.72,
			0.18,
			0.3
		)
		style.shadow_size = 10
		banner.add_theme_stylebox_override(
			"panel",
			style
		)

		var banner_margin:= MarginContainer.new()
		banner_margin.add_theme_constant_override(
			"margin_left",
			10
		)
		banner_margin.add_theme_constant_override(
			"margin_top",
			7
		)
		banner_margin.add_theme_constant_override(
