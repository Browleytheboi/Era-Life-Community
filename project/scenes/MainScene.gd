func _show_career_coworkers_panel(coworker_ids: Array) -> void:
	if gs == null or gs.player == null:
		return

	var effective_coworker_ids: Array = []
	var seen_ids: Dictionary = {}

	for coworker_id_value in coworker_ids:
		var coworker_id: int = int(coworker_id_value)
		if coworker_id <= 0 or seen_ids.has(coworker_id):
			continue
		seen_ids [coworker_id] = true
		effective_coworker_ids.append(coworker_id)

	if effective_coworker_ids.is_empty() and gs.workplace_engine != null:
		var fallback_coworkers: Array = gs.workplace_engine.get_coworkers(gs.player)
		for coworker_value in fallback_coworkers:
			if coworker_value == null:
				continue
			var fallback_id: int = int(coworker_value.id)
			if fallback_id <= 0 or seen_ids.has(fallback_id):
				continue
			seen_ids [fallback_id] = true
			effective_coworker_ids.append(fallback_id)

	career_coworkers_cached_ids = effective_coworker_ids.duplicate()

	_ensure_career_coworkers_popup()
	if career_coworkers_popup == null or career_coworkers_popup_list == null:
		return

	if standard_tab_popup_open:
		_hide_standard_tab_popup()

	career_coworkers_popup_open = true
	career_coworkers_popup.visible = true

	var popup_parent:= career_coworkers_popup.get_parent()
	if popup_parent != null:
		popup_parent.move_child(
			career_coworkers_popup,
			popup_parent.get_child_count() - 1
		)

	if output_label != null:
		output_label.visible = false
	if player_stats_overlay != null:
		player_stats_overlay.visible = false
	if career_coworkers_popup_list_scroll != null:
		career_coworkers_popup_list_scroll.scroll_vertical = 0

	career_coworkers_popup_title.text = "WORKPLACE MAP • %s" % (
		gs.player.job if gs.player.job != "" else "COWORKERS"
	)

	_clear_container_children(career_coworkers_popup_list)
	career_coworkers_popup_status.text = ""

	var intro_card:= PanelContainer.new()
	intro_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	career_coworkers_popup_list.add_child(intro_card)
	intro_card.add_theme_stylebox_override(
		"panel",
		_build_era_surface_panel_style("main", true, 0.18, false)
	)

	var intro_margin:= MarginContainer.new()
	intro_margin.add_theme_constant_override("margin_left", 12)
	intro_margin.add_theme_constant_override("margin_top", 12)
	intro_margin.add_theme_constant_override("margin_right", 12)
	intro_margin.add_theme_constant_override("margin_bottom", 12)
	intro_card.add_child(intro_margin)

	var intro_root:= VBoxContainer.new()
	intro_root.add_theme_constant_override("separation", 4)
	intro_margin.add_child(intro_root)

	var job_label:= Label.new()
	job_label.text = "My Job: %s" % (gs.player.job if gs.player.job != "" else "Unemployed")
	intro_root.add_child(job_label)

	var workplace_label:= Label.new()
	workplace_label.text = "Workplace: %s" % (
		gs.player.current_workplace_id if gs.player.current_workplace_id != "" else "Unknown"
	)
	intro_root.add_child(workplace_label)

	var grouped: Dictionary = {}
	var display_order: Array = []
	var visible_count: int = 0

	for coworker_id in effective_coworker_ids:
		var coworker: Person = gs.get_or_reactivate_npc_by_id(int(coworker_id))
		if coworker == null or not coworker.alive:
			continue

		visible_count += 1
		var group_name: String = MainSceneLogic._career_coworker_group_label(gs, coworker)
		if not grouped.has(group_name):
			grouped [group_name] = []
			display_order.append(group_name)

		var bucket: Array = []
		var bucket_value = grouped [group_name]
		if bucket_value is Array:
			bucket = bucket_value
		bucket.append(coworker)
		grouped [group_name] = bucket

	var count_label:= Label.new()
	count_label.text = "Visible Coworkers: %d" % visible_count
	intro_root.add_child(count_label)

	var hint_label:= Label.new()
	hint_label.text = "Tap a coworker to open the full profile with workplace actions."
	hint_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	intro_root.add_child(hint_label)

	if display_order.is_empty():
		career_coworkers_popup_status.text = "No coworkers are available right now."
		return

	for group_name_value in display_order:
		var group_name: String = str(group_name_value)
		_career_add_coworker_section_header(group_name)

		var group_bucket: Array = []
		var group_bucket_value = grouped.get(group_name, [])
		if group_bucket_value is Array:
			group_bucket = group_bucket_value

		for coworker_value in group_bucket:
			if coworker_value is Person:
				_career_add_coworker_button(coworker_value)
