func _install_world_browser_contract_packet(
	signature: String,
	contract: Dictionary
) -> bool:
	var clean_signature: String = str(signature).strip_edges()
	var expected_signature: String = _other_country_browser_cache_key()

	if (
		clean_signature == ""
		or clean_signature != expected_signature
		or contract.is_empty()
	):
		return false

	var entries_raw: Variant = contract.get(
		"entries",
		[]
	)
	var entries: Array = (
		(entries_raw as Array).duplicate(false)
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)

	set_meta(
		"other_countries_browser_entries_cache_key",
		clean_signature
	)
	set_meta(
		"other_countries_browser_entries_cache",
		entries
	)
	set_meta(
		"other_countries_browser_contract",
		contract.duplicate(false)
	)
	set_meta(
		"other_countries_browser_cache_building",
		false
	)
	set_meta(
		"other_countries_browser_contract_observation_armed",
		false
	)
	set_meta(
		"other_countries_browser_contract_hot",
		bool(
			contract.get(
				"projection_complete",
				false
			)
		)
	)
	set_meta(
		"other_countries_browser_contract_entry_count",
		entries.size()
	)
	set_meta(
		"other_countries_browser_contract_engine_owned",
		true
	)
	set_meta(
		"other_countries_browser_contract_ui_called_engines",
		false
	)
	set_meta(
		"other_countries_browser_contract_routed_through_global_intent",
		true
	)
	set_meta(
		"other_countries_browser_contract_build_on_click",
		false
	)
	set_meta(
		"other_countries_browser_contract_ready_gate_member",
		false
	)
	set_meta(
		"other_countries_browser_contract_received_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"other_countries_browser_card_prepaint_pending",
		true
	)
	set_meta(
		"other_countries_browser_card_prepaint_signature",
		clean_signature
	)

	_ensure_other_countries_popup()

	call_deferred(
		"_continue_world_browser_card_prepaint_when_idle",
		clean_signature,
		0
	)

	EraLog.truth(
		"ERALIFE_WORLD_BROWSER_CONTRACT_TRUTH"
		+ "|signature=" + clean_signature
		+ "|hot=" + str(
			bool(
				contract.get(
