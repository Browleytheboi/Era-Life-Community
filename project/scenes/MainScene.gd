			_apply_player_stat_surface_content(player_stats_fame_label, player_stats_fame_bar, "Fame", fame_value, fame_max, surface_context)

	if approval_row != null:
		approval_row.visible = show_approval
		if approval_label != null:
			approval_label.visible = show_approval
		if approval_bar != null:
			approval_bar.visible = show_approval

		if show_approval and approval_label != null and approval_bar != null:
			_apply_player_stat_surface_content(
				approval_label,
				approval_bar,
				"Approval",
				approval_display_value,
				100,
				surface_context
			)
		elif approval_bar != null:
			approval_bar.value = 0.0

	player_stats_overlay.set_meta("player_stats_current_actor_id", int(p.id))
	player_stats_overlay.set_meta("player_stats_bank_actor_id", int(p.id))
	player_stats_overlay.remove_meta("player_stats_force_truth_actor_id")
	player_stats_overlay.remove_meta("player_stats_force_truth_reason")

	_apply_player_stats_overlay_visual_state(player_stats_overlay_hovered)

func _sync_player_stats_incarceration_lens(actor: Person) -> void:
	if player_stats_root == null or not is_instance_valid(player_stats_root):
		return

	var header: Label = player_stats_root.get_node_or_null("IncarcerationStatusHeader") as Label
	if header == null:
		header = Label.new()
		header.name = "IncarcerationStatusHeader"
		header.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		header.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		header.add_theme_font_size_override("font_size", 12)
		header.add_theme_color_override("font_color", Color(1.0, 0.38, 0.32, 1.0))
		player_stats_root.add_child(header)
		player_stats_root.move_child(header, min(1, player_stats_root.get_child_count() - 1))

	var context: Dictionary = MainSceneHelpers._incarceration_context_for_actor(actor)
	var active: bool = not context.is_empty()

	header.visible = active
	if not active:
		_set_player_stats_incarceration_rows_visible(false)
		return

	var facility: String = str(context.get("facility_type", context.get("facility_label", "Facility")))
	var security: String = str(context.get("security_level", "Low"))
	var sentence_years: int = int(context.get("sentence_years", 0))
	var years_served: int = int(context.get("years_served", 0))
	var months_served: int = int(context.get("months_served", years_served * 12))

	header.text = "🚫 INCARCERATED — %s\nSentence: %d year%s • Time Served: %d month%s\nSecurity Level: %s" % [
		facility.to_upper(),
		sentence_years,
		"" if sentence_years == 1 else "s",
		months_served,
		"" if months_served == 1 else "s",
		security
	]

	_sync_player_stats_incarceration_rows(actor)


func _sync_player_stats_incarceration_rows(actor: Person) -> void:
	if actor == null or player_stats_rows_root == null:
		return

	var stats: Dictionary = MainSceneHelpers._safe_dictionary(actor.incarceration_stats)
	var rows: Array = [
		{ "title": "Inmate Reputation", "key": "respect", "value": int(stats.get("respect", 30))},
		{ "title": "Safety", "key": "safety", "value": int(stats.get("safety", 60))},
		{ "title": "Mental Stability", "key": "mental_stability", "value": int(stats.get("mental_stability", 56))},
		{ "title": "Guard Attention", "key": "guard_heat", "value": int(stats.get("guard_heat", 20))},
		{ "title": "Contraband Risk", "key": "contraband_risk", "value": int(stats.get("contraband_risk", 12))}
	]

	for row_data in rows:
		var title: String = str(row_data.get("title", "Incarceration"))
		var node_name: String = "IncarcerationStat_%s" % title.replace(" ", "_")
		var row: Control = player_stats_rows_root.get_node_or_null(node_name) as Control
		var label: Label = null
		var bar: ProgressBar = null

		if row == null:
			var built: Dictionary = _make_player_stat_row(title, 100)
			row = built.get("row", null)
			label = built.get("label", null)
			bar = built.get("bar", null)
			if row == null or label == null or bar == null:
				continue
			row.name = node_name
			player_stats_rows_root.add_child(row)
		else:
			label = row.get_child(0) as Label
			bar = row.get_child(2) as ProgressBar if row.get_child_count() >= 3 else null

		var value: int = clampi(int(row_data.get("value", 0)), 0, 100)
		row.visible = true
		row.mouse_filter = Control.MOUSE_FILTER_PASS

		if bar != null:
			bar.max_value = 100
			bar.value = value
			_refresh_player_stat_bar_value_text(bar, value, 100, title)

		if label != null:
			label.text = "%s: %d / 100" % [title, value]

		if bar != null:
			var danger: bool = title in ["Guard Attention", "Contraband Risk"] and value >= 70
			_apply_player_stat_row_visual_state(label, bar, title, false, danger, 0.0)


