		household_creator_pending_member_basic_contract.clear()
		_household_creator_clear_member_stat_controls()
		_household_creator_begin_member_editor(household_creator_active_member_index)
	)
	buttons.add_child(household_creator_member_start_over_button)
func _household_creator_clear_member_stat_controls() -> void:
	if typeof(household_creator_member_stats_sliders) != TYPE_DICTIONARY:
		household_creator_member_stats_sliders = {}

	household_creator_member_stats_sliders.clear()


func _household_creator_register_member_stat_control(stat_key: String, range_ref: Range) -> void:
	var clean_key: String = str(stat_key).strip_edges()
	if clean_key == "":
		return
	if range_ref == null or not is_instance_valid(range_ref):
		return

	household_creator_member_stats_sliders [clean_key] = range_ref


func _household_creator_collect_member_stats() -> Dictionary:
	var stats: Dictionary = {}

	if typeof(household_creator_member_stats_sliders) != TYPE_DICTIONARY:
		household_creator_member_stats_sliders = {}
		return stats

	for raw_key in household_creator_member_stats_sliders.keys():
		var stat_key: String = str(raw_key).strip_edges()
		if stat_key == "":
			continue

		var range_ref: Variant = household_creator_member_stats_sliders.get(raw_key, null)
		if range_ref == null:
			continue
		if not (range_ref is Object):
			continue
		if not is_instance_valid(range_ref):
			continue
		if not (range_ref is Range):
			continue

		stats [stat_key] = int(clamp(int((range_ref as Range).value), 0, 100))

	return stats
