func _unmask_main_tab_input_contract_after_cover_drop(reason: String = "ready_cover_drop") -> void:
	if not bool(get_meta("main_tab_input_contract_hot", false)):
		return

	for key in _get_ui_nav_order():
		var button: Button = ui_nav_buttons.get(key, null) as Button
		if button == null or not is_instance_valid(button):
			continue

		button.visible = true
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = Node.PROCESS_MODE_INHERIT
		button.z_as_relative = false
		button.z_index = 20
		button.set_meta("main_tab_input_contract_unmasked_after_cover_drop", true)
		button.set_meta("main_tab_input_contract_unmasked_reason", reason)
		button.set_meta("main_tab_input_contract_unmasked_at_ms", int(Time.get_ticks_msec()))

	set_meta("main_tab_input_contract_unmasked_after_cover_drop", true)
	set_meta("main_tab_input_contract_unmasked_reason", reason)
	set_meta("main_tab_input_contract_unmasked_at_ms", int(Time.get_ticks_msec()))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_tab_input_contract_unmasked_after_cover_drop"] = true
		gs.scenario_state ["main_tab_input_contract_unmasked_reason"] = reason

	_apply_ui_nav_button_visuals()
func _emit_god_mode_handoff_contract_after_zero_frame_reveal(settings: Dictionary, reason: String = "god_mode_zero_frame_revealed") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty() and _global_runtime_visible_shell_control_grace_active(now_ms):
		_schedule_god_mode_post_visible_handoff_bookkeeping_after_control_grace(
			settings.duplicate(true),
			reason,
			"Mainscene._emit_god_mode_handoff_contract_after_zero_frame_reveal.control_grace"
		)
		return

	if settings.is_empty():
		EraLog.truth("GLOBAL_RUNTIME_POST_VISIBLE_BOOKKEEPING_SKIPPED|reason=%s|empty_settings=1|at_ms=%d" % [
			reason,
			now_ms
		])
		return

	if not _global_runtime_kill_claim_allowed("contract_bookkeeping", "Mainscene._emit_god_mode_handoff_contract_after_zero_frame_reveal", reason, {
		"state_only": true,
		"background_only": true,
		"blocks_ui": false,
		"ui_safe_microtask": true,
		"microtask_budget": 1
	}):
		_schedule_god_mode_post_visible_handoff_bookkeeping_after_control_grace(
			settings.duplicate(true),
			"%s_claim_denied_retry" % reason,
			"Mainscene._emit_god_mode_handoff_contract_after_zero_frame_reveal.denied"
		)
		return

	set_meta("god_mode_post_reveal_handoff_contract_pending", true)
	set_meta("god_mode_post_reveal_handoff_contract_reason", reason)
	set_meta("god_mode_post_reveal_handoff_contract_scheduled_at_ms", now_ms)
	set_meta("god_mode_post_reveal_handoff_contract_state_only_microtask", true)

	EraLog.truth("GLOBAL_RUNTIME_POST_VISIBLE_BOOKKEEPING_READY|reason=%s|at_ms=%d" % [
		reason,
		now_ms
	])

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_post_reveal_handoff_contract_pending"] = true
		gs.scenario_state ["god_mode_post_reveal_handoff_contract_reason"] = reason
