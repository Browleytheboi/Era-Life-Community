	_begin_runtime_interaction_quiet_window(reason, 80)

	current_panel = ""
	if output_label != null:
		output_label.visible = true

	set_meta("boxing_hud_next_light_refresh_ms", int(Time.get_ticks_msec()) + 900)

	_boxing_hud_prime_visible_after_unlock(controlled_actor_id, reason)

