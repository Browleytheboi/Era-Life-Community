		return

	var visual: Dictionary = MainSceneHelpers._contract_surface_visual_theme(surface, surface_id)
	var bg: Color = Color(0.025, 0.032, 0.045, 0.975)
	var border: Color = Color(0.7, 0.96, 1.0, 0.54)

	if visual.has("bg"):
		bg = visual.get("bg")
	if visual.has("border"):
		border = visual.get("border")

	ui_contract_surface_panel.add_theme_stylebox_override("panel", MainSceneHelpers._contract_make_stylebox(bg, border, 2, 18))


func _apply_contract_row_runtime_visual_fx(row_panel: PanelContainer, row_visual: Dictionary, _row_dict: Dictionary = {}) -> void:
	if row_panel == null or not is_instance_valid(row_panel):
		return
	if bool(row_panel.get_meta("contract_row_visual_fx_applied", false)):
		return

	row_panel.set_meta("contract_row_visual_fx_applied", true)

	if bool(row_visual.get("pulse_glow", false)):
		var pulse_tint: Color = row_visual.get("pulse_tint", Color(1.0, 1.0, 1.0, 1.0))
		var pulse_seconds: float = float(row_visual.get("pulse_seconds", 0.82))
		var pulse_color:= Color(
			clamp(1.0 + ((pulse_tint.r - 1.0) * 0.18), 0.0, 1.0),
			clamp(1.0 + ((pulse_tint.g - 1.0) * 0.18), 0.0, 1.0),
			clamp(1.0 + ((pulse_tint.b - 1.0) * 0.18), 0.0, 1.0),
			1.0
		)
		row_panel.self_modulate = Color(1.0, 1.0, 1.0, 1.0)
		var pulse_tween:= create_tween().bind_node(row_panel)
		pulse_tween.set_loops()
		pulse_tween.set_trans(Tween.TRANS_SINE)
		pulse_tween.set_ease(Tween.EASE_IN_OUT)
		pulse_tween.tween_property(row_panel, "self_modulate", pulse_color, pulse_seconds)
		pulse_tween.tween_property(row_panel, "self_modulate", Color(1.0, 1.0, 1.0, 1.0), pulse_seconds)

	if row_visual.has("orbit_color"):
		var orbit_color: Color = row_visual.get("orbit_color")
		if orbit_color.a > 0.0:
			_attach_contract_row_border_orbiter(row_panel, orbit_color, float(row_visual.get("orbit_seconds", 2.1)))


func _attach_contract_row_border_orbiter(row_panel: PanelContainer, orbit_color: Color, orbit_seconds: float = 2.1) -> void:
	if row_panel == null or not is_instance_valid(row_panel):
		return
	if row_panel.has_node("BorderOrbiterFx"):
		return

	var overlay:= Control.new()
	overlay.name = "BorderOrbiterFx"
	overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.anchor_left = 0.0
	overlay.anchor_top = 0.0
	overlay.anchor_right = 1.0
	overlay.anchor_bottom = 1.0
	overlay.offset_left = 0.0
	overlay.offset_top = 0.0
	overlay.offset_right = 0.0
	overlay.offset_bottom = 0.0
	overlay.z_index = 7
	row_panel.add_child(overlay)

	var orbiter:= PanelContainer.new()
	orbiter.name = "Orbiter"
	orbiter.mouse_filter = Control.MOUSE_FILTER_IGNORE
	orbiter.custom_minimum_size = Vector2(10.0, 10.0)
	orbiter.size = Vector2(10.0, 10.0)
	var orbiter_style: StyleBoxFlat = MainSceneHelpers._contract_make_stylebox(orbit_color, Color(1.0, 1.0, 1.0, 0.76), 1, 12)
	orbiter_style.shadow_color = Color(orbit_color.r, orbit_color.g, orbit_color.b, 0.56)
	orbiter_style.shadow_size = 7
	orbiter_style.shadow_offset = Vector2.ZERO
	orbiter.add_theme_stylebox_override("panel", orbiter_style)
	overlay.add_child(orbiter)

	call_deferred("_run_contract_row_border_orbiter", overlay, orbiter, orbit_seconds)


func _run_contract_row_border_orbiter(track: Control, orbiter: Control, orbit_seconds: float = 2.1) -> void:
	if get_tree() != null:
		await get_tree().process_frame

	while track != null and is_instance_valid(track) and orbiter != null and is_instance_valid(orbiter):
		var orbiter_size: Vector2 = orbiter.size
		if orbiter_size.x <= 0.0 or orbiter_size.y <= 0.0:
			orbiter_size = orbiter.custom_minimum_size

		var pad: float = 4.0
		var max_x: float = max(pad, track.size.x - orbiter_size.x - pad)
		var max_y: float = max(pad, track.size.y - orbiter_size.y - pad)

		var points: Array = [
			Vector2(pad, pad),
			Vector2(max_x, pad),
			Vector2(max_x, max_y),
			Vector2(pad, max_y),
			Vector2(pad, pad)
		]

		orbiter.position = points [0]

		for i in range(points.size() - 1):
			if track == null or not is_instance_valid(track) or orbiter == null or not is_instance_valid(orbiter):
				return

			var tween:= create_tween().bind_node(orbiter)
			tween.set_trans(Tween.TRANS_LINEAR)
			tween.set_ease(Tween.EASE_IN_OUT)
			tween.tween_property(orbiter, "position", points [i + 1], max(0.18, orbit_seconds / 4.0))
			await tween.finished
