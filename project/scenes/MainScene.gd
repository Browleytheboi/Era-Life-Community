			),
			96
		)

	var did_you_know_panel = get_meta("age_up_loading_did_you_know_panel", null)
	if material_bucket_changed and did_you_know_panel != null:
		_apply_cached_era_surface_panel_style(
			did_you_know_panel,
			"panel",
			"age_up_loading_did_you_know_panel",
			"main",
			false,
			clamp(0.3 + pulse_strength * 0.9, 0.0, 1.0),
			false
		)

	var did_you_know_edge_glow = get_meta("age_up_loading_did_you_know_edge_glow", null)
	if did_you_know_edge_glow != null and did_you_know_edge_glow is ColorRect:
		var edge_glow_mix: float = 0.5 + (0.5 *
		sin(age_up_loading_shimmer_elapsed * 1.4))
		var edge_color: Color = core.lerp(Color(1.0, 1.0, 1.0, 1.0),
		0.48 + (edge_glow_mix * 0.16))
		_apply_cached_color_rect_color(
			did_you_know_edge_glow,
			"age_up_loading_did_you_know_edge_glow",
			Color(
				edge_color.r,
				edge_color.g,
				edge_color.b,
				0.18 + (0.12 * edge_glow_mix)
			),
			96
		)

	var did_you_know_heading = get_meta("age_up_loading_did_you_know_heading", null)
	if material_bucket_changed and did_you_know_heading != null:
		var heading_glow: float = 0.5 + (0.5 *
		sin(age_up_loading_shimmer_elapsed * 0.85))
		_apply_cached_theme_color_override(
			did_you_know_heading,
			"font_color",
			"age_up_loading_did_you_know_heading",
			core.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.62 + heading_glow *
			0.1)
		)

	if did_you_know_heading != null:
		_apply_cached_control_scale(
			did_you_know_heading,
			"age_up_loading_did_you_know_heading",
			did_you_know_heading_scale
		)

	if material_bucket_changed and age_up_loading_did_you_know_front_body != null:
		_apply_cached_theme_color_override(
			age_up_loading_did_you_know_front_body,
			"font_color",
			"age_up_loading_did_you_know_front_body",
			did_you_know_body_color
		)

	if material_bucket_changed and age_up_loading_did_you_know_back_body != null:
		_apply_cached_theme_color_override(
			age_up_loading_did_you_know_back_body,
			"font_color",
			"age_up_loading_did_you_know_back_body",
			did_you_know_body_color
		)

	_animate_age_up_loading_did_you_know_crossfade(anim_delta)
	_animate_age_up_loading_did_you_know_scroll(anim_delta)

	var eralife_logo = get_meta("age_up_loading_eralife_logo", null)
	var overlay_size_snapshot_raw: Variant = get_meta("age_up_loading_overlay_size_snapshot", Vector2.ZERO)
	var overlay_size: Vector2 = overlay_size_snapshot_raw if typeof(overlay_size_snapshot_raw) == TYPE_VECTOR2 else Vector2.ZERO
	if bucket_changed or overlay_size.x <= 1.0 or overlay_size.y <= 1.0:
		overlay_size = age_up_loading_overlay.size
	if overlay_size.x <= 1.0 or overlay_size.y <= 1.0:
		overlay_size = get_viewport_rect().size
	set_meta("age_up_loading_overlay_size_snapshot", overlay_size)

	var logo_size_snapshot_raw: Variant = get_meta(
		"age_up_loading_eralife_logo_size_snapshot",
		Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72.0)
	)
	var estimated_logo_size: Vector2 = logo_size_snapshot_raw if typeof(logo_size_snapshot_raw) == TYPE_VECTOR2 else Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72.0)
	if eralife_logo != null and eralife_logo is RichTextLabel:
		if bucket_changed or estimated_logo_size.x <= 1.0 or estimated_logo_size.y <= 1.0:
			estimated_logo_size = eralife_logo.size
		if estimated_logo_size.x <= 1.0 or estimated_logo_size.y <= 1.0:
			estimated_logo_size = Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72.0)
		set_meta("age_up_loading_eralife_logo_size_snapshot",
		estimated_logo_size)
	else:
		estimated_logo_size = Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72.0)

	while age_up_loading_eralife_type_elapsed >= AGE_UP_LOADING_ERALIFE_TYPE_INTERVAL:
		age_up_loading_eralife_type_elapsed -= AGE_UP_LOADING_ERALIFE_TYPE_INTERVAL
		if age_up_loading_eralife_type_direction > 0:
			if age_up_loading_eralife_type_char_count < AGE_UP_LOADING_ERALIFE_TEXT.length():
				age_up_loading_eralife_type_char_count += 1
			else:
				age_up_loading_eralife_hold_elapsed += AGE_UP_LOADING_ERALIFE_TYPE_INTERVAL
				if age_up_loading_eralife_hold_elapsed >= AGE_UP_LOADING_ERALIFE_HOLD_DURATION:
					age_up_loading_eralife_hold_elapsed = 0.0
					age_up_loading_eralife_type_direction = -1
		else:
			if age_up_loading_eralife_type_char_count > 0:
				age_up_loading_eralife_type_char_count -= 1
			else:
				age_up_loading_eralife_type_direction = 1
				age_up_loading_eralife_corner_index = (age_up_loading_eralife_corner_index + 1) % 3

	var corner_positions: Array = [
		Vector2(max(36.0, overlay_size.x - estimated_logo_size.x - 34.0), 30.0),
		Vector2(
			max(36.0, overlay_size.x - estimated_logo_size.x - 34.0),
			max(36.0, overlay_size.y - estimated_logo_size.y - 24.0)
		),
		Vector2(34.0, 30.0)
	]
	var corner_position: Vector2 = corner_positions [age_up_loading_eralife_corner_index %
	corner_positions.size()]
	var glow_pulse: float = 0.5 + (0.5 *
	sin(age_up_loading_shimmer_elapsed * 1.9))
	var idle_float: Vector2 = Vector2(
		sin(age_up_loading_shimmer_elapsed * 0.62) * (0.55 + glow_pulse * 0.35),
		cos(age_up_loading_shimmer_elapsed * 0.56) * (0.45 + glow_pulse * 0.3)
	)
	var logo_position: Vector2 = corner_position + idle_float
	var logo_rotation: float = sin(age_up_loading_shimmer_elapsed *
	0.24) * 0.0035
	var logo_scale: Vector2 = Vector2.ONE * (1.01 + pulse_strength *
	0.024 + glow_pulse * 0.016)
	var logo_modulate: Color = Color(
		1.0,
		1.0,
		1.0,
		0.8 + (0.12 * glow_pulse)
	)

	if eralife_logo != null and eralife_logo is RichTextLabel:
		_apply_cached_control_position(
			eralife_logo,
			"age_up_loading_eralife_logo",
			logo_position,
			4
		)
		_apply_cached_control_rotation(
			eralife_logo,
			"age_up_loading_eralife_logo",
			logo_rotation
		)
		_apply_cached_control_scale(
			eralife_logo,
			"age_up_loading_eralife_logo",
			logo_scale
		)
		_apply_cached_canvas_item_modulate(
			eralife_logo,
			"age_up_loading_eralife_logo",
			logo_modulate
		)

	_refresh_age_up_loading_eralife_logo_render(false)
func _build_era_surface_panel_style_cache_key(
	surface_kind: String,
	is_hovered: bool = false,
	pulse_strength: float = 0.0,
	danger_state: bool = false,
	phase_bucket: int = -1
) -> String:
	var theme_key: String = _current_era_ui_theme_key()
	var pulse_bucket: int = int(round(clamp(pulse_strength, 0.0, 1.0) * 24.0))
	return "%s|%s|%d|%d|%d|%d" % [
		theme_key,
		surface_kind,
		1 if is_hovered else 0,
		1 if danger_state else 0,
		pulse_bucket,
		phase_bucket
	]
func _get_cached_era_surface_panel_style(
	surface_kind: String,
	is_hovered: bool = false,
	pulse_strength: float = 0.0,
	danger_state: bool = false,
	phase_bucket: int = -1
) -> StyleBoxFlat:
	var cache_key: String = _build_era_surface_panel_style_cache_key(
		surface_kind,
		is_hovered,
		pulse_strength,
		danger_state,
		phase_bucket
	)
	var cache_raw: Variant = get_meta("era_surface_panel_style_cache", {})
	var cache: Dictionary = cache_raw if typeof(cache_raw) == TYPE_DICTIONARY else {}

	if cache.has(cache_key):
		var cached_raw: Variant = cache.get(cache_key, null)
		if cached_raw is StyleBoxFlat:
			return cached_raw

	var style: StyleBoxFlat = _build_era_surface_panel_style(
		surface_kind,
		is_hovered,
		pulse_strength,
		danger_state
	)

	if not cache.has(cache_key) and cache.size() >= 48:
		var existing_keys: Array = cache.keys()
		if not existing_keys.is_empty():
			cache.erase(existing_keys [0])

	cache [cache_key] = style
	set_meta("era_surface_panel_style_cache", cache)
	return style
func _build_era_surface_button_style(
	surface_kind: String = "main",
	is_hovered: bool = false,
	pulse_strength: float = 0.0
) -> StyleBoxFlat:
	var theme_key: String = _current_era_ui_theme_key()
	var data: Dictionary = MainSceneHelpers._era_surface_theme_data(theme_key, surface_kind)
	var style:= StyleBoxFlat.new()

	var bg: Color = data.get("hover_bg", Color(0.08, 0.15, 0.3, 0.9)) if is_hovered else data.get("bg", Color(0.05, 0.09, 0.18, 0.84))
	var border_color: Color = data.get("hover_border", Color(1.0, 1.0, 1.0, 0.26)) if is_hovered else data.get("border", Color(1.0, 1.0, 1.0, 0.14))
	var glow_color: Color = data.get("hover_glow", Color(1.0, 1.0, 1.0, 0.18)) if is_hovered else data.get("glow", Color(1.0, 1.0, 1.0, 0.08))
	var glow_size: int = int(data.get("hover_glow_size", 14)) if is_hovered else int(data.get("glow_size", 8))

	if is_hovered:
		bg = bg.lerp(Color(1.0, 1.0, 1.0, bg.a), 0.045)
		border_color.a = clamp(border_color.a + 0.08, 0.0, 1.0)
		glow_color.a = clamp(glow_color.a + 0.06, 0.0, 1.0)
		glow_size += 2

	if pulse_strength > 0.0:
		bg = bg.lerp(Color(1.0, 1.0, 1.0, bg.a), 0.035 * pulse_strength)
		border_color.a = clamp(border_color.a + 0.07 * pulse_strength, 0.0, 1.0)
		glow_color.a = clamp(glow_color.a + 0.08 * pulse_strength, 0.0, 1.0)
		glow_size += int(round(3.0 * pulse_strength))

	match theme_key:
		"ancient":
			border_color = border_color.lerp(Color(1.0, 0.84, 0.58, border_color.a), 0.2 if is_hovered else 0.08)
			glow_color = glow_color.lerp(Color(1.0, 0.76, 0.42, glow_color.a), 0.18 if is_hovered else 0.06)
		"industrial":
			border_color = border_color.lerp(Color(0.94, 0.74, 0.38, border_color.a), 0.2 if is_hovered else 0.08)
			glow_color = glow_color.lerp(Color(0.95, 0.72, 0.34, glow_color.a), 0.18 if is_hovered else 0.06)
		"medieval":
			border_color = border_color.lerp(Color(0.92, 0.96, 1.0, border_color.a), 0.2 if is_hovered else 0.08)
			glow_color = glow_color.lerp(Color(0.84, 0.92, 1.0, glow_color.a), 0.18 if is_hovered else 0.06)
		"future":
			border_color = border_color.lerp(Color(0.62, 0.92, 1.0, border_color.a), 0.22 if is_hovered else 0.1)
			glow_color = glow_color.lerp(Color(0.36, 0.96, 1.0, glow_color.a), 0.22 if is_hovered else 0.1)
		_:
			border_color = border_color.lerp(Color(1.0, 1.0, 1.0, border_color.a), 0.16 if is_hovered else 0.06)
			glow_color = glow_color.lerp(Color(1.0, 1.0, 1.0, glow_color.a), 0.12 if is_hovered else 0.04)

	style.bg_color = bg

	var radius: int = int(data.get("radius", 14))
	style.corner_radius_top_left = radius
	style.corner_radius_top_right = radius
	style.corner_radius_bottom_right = radius
	style.corner_radius_bottom_left = radius

	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.border_color = border_color

	style.shadow_color = glow_color
	style.shadow_size = glow_size
	style.shadow_offset = Vector2.ZERO

	style.content_margin_left = 12
	style.content_margin_top = 8
	style.content_margin_right = 12
	style.content_margin_bottom = 8

	return style
func _apply_cached_era_surface_panel_style(
	target: Control,
	override_name: String,
	cache_slot: String,
	surface_kind: String,
	is_hovered: bool = false,
	pulse_strength: float = 0.0,
	danger_state: bool = false,
	phase_bucket: int = -1
) -> void:
	if target == null or not is_instance_valid(target):
		return

	var cache_key: String = _build_era_surface_panel_style_cache_key(
		surface_kind,
		is_hovered,
		pulse_strength,
		danger_state,
		phase_bucket
	)
	var applied_meta_key: String = "era_surface_panel_style_last_%s" % cache_slot
	var last_cache_key: String = str(get_meta(applied_meta_key, ""))

	if last_cache_key == cache_key:
		return

	target.add_theme_stylebox_override(
		override_name,
		_get_cached_era_surface_panel_style(
			surface_kind,
			is_hovered,
			pulse_strength,
			danger_state,
			phase_bucket
		)
	)
	set_meta(applied_meta_key, cache_key)
func _apply_cached_theme_color_override(
	target: Control,
	override_name: String,
	cache_slot: String,
	color: Color,
	quantization_steps: int = 64
) -> void:
	if target == null or not is_instance_valid(target):
		return

	var cache_key: String = MainSceneHelpers._build_theme_color_override_cache_key(
		override_name,
		color,
		quantization_steps
	)
	var applied_meta_key: String = "theme_color_override_last_%s" % cache_slot
	var last_cache_key: String = str(get_meta(applied_meta_key, ""))

	if last_cache_key == cache_key:
		return

	target.add_theme_color_override(override_name, color)
	set_meta(applied_meta_key, cache_key)
func _apply_cached_control_scale(
	target: Control,
	cache_slot: String,
	scale_value: Vector2,
	quantization_steps: int = 384
) -> void:
	if target == null or not is_instance_valid(target):
		return

	var cache_key: String = MainSceneHelpers._build_control_scale_cache_key(
		scale_value,
		quantization_steps
	)
	var applied_meta_key: String = "control_scale_last_%s" % cache_slot
	var last_cache_key: String = str(get_meta(applied_meta_key, ""))

	if last_cache_key == cache_key:
		return

	target.scale = scale_value
	set_meta(applied_meta_key, cache_key)
func _apply_cached_control_rotation(
	target: Control,
	cache_slot: String,
	rotation_value: float,
	quantization_steps: int = 8192
) -> void:
	if target == null or not is_instance_valid(target):
		return
	var cache_key: String = MainSceneHelpers._build_control_rotation_cache_key(
		rotation_value,
		quantization_steps
	)
