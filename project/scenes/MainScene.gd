func _on_career_hub_person_profile_requested(
	target_id: int,
	prepared_profile: Dictionary
) -> void:
	if (
		gs == null
		or target_id <= 0
		or prepared_profile.is_empty()
	):
		return

	var target_raw: Variant = prepared_profile.get(
		"target_pointer",
		null
	)

	if not (
		target_raw is Person
	):
		return

	var target: Person = (
		target_raw as Person
	)

	if (
		target == null
		or int(
			target.id
		) != target_id
	):
		return

	var profile_contract: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			prepared_profile.get(
				"relationship_profile_contract",
				{}
			)
		)
	)

	if (
		profile_contract.is_empty()
		or int(
			profile_contract.get(
				"target_id",
				-1
			)
		) != target_id
		or str(
			profile_contract.get(
				"truth_state",
				""
			)
		) != "hot"
	):
		if (
			career_hub_panel != null
			and is_instance_valid(
				career_hub_panel
			)
		):
			career_hub_panel.set_status(
				(
					"That coworker's resident relationship "
					+ "profile is still publishing."
				)
			)
		return

	_on_relationship_hub_full_profile_pressed(
		target_id,
		target,
		profile_contract,
		"career_hub",
		false
	)
func _ensure_career_panel() -> void:
	if (
		career_panel != null
		and is_instance_valid(
			career_panel
		)
	):
		return

	career_panel = CareerPanel.new()
	career_panel.name = "CareerPanel"
	career_panel.visible = false
	career_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	career_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)

	career_panel.request_intent.connect(
		_on_career_panel_intent_requested
	)
	career_panel.request_close.connect(
		_on_career_panel_close_requested
	)
	career_panel.request_coworker_profile.connect(
		_on_career_panel_coworker_profile_requested
	)

	add_child(
		career_panel
	)

	career_panel.set_meta(
		"persistent_child_surface_shell_hot",
		true
	)
	career_panel.set_meta(
		"ui_is_renderer_only",
		true
	)
func _request_career_panel_contract(
	actor: Person,
	payload: Dictionary = {}
) -> Dictionary:
	if gs == null or actor == null:
		return {}

	var resolved_payload: Dictionary = (
		payload.duplicate(true)
	)
	resolved_payload ["actor_id"] = int(
		actor.id
	)
	resolved_payload ["section_id"] = str(
		resolved_payload.get(
			"section_id",
			career_panel_active_section_id
		)
	)
	resolved_payload ["source"] = str(
		resolved_payload.get(
			"source",
			"mainscene.career_panel"
		)
	)
	resolved_payload [
		"ui_is_expression_only"
	] = true

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": int(actor.id),
				"target_id": int(actor.id),
				"intent_type": (
					"career_contract_intent"
				),
				"surface_id": "career_panel",
				"action_id": str(
					resolved_payload.get(
						"action_id",
						"refresh"
					)
				),
				"payload": resolved_payload,
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"career_contract_engine"
					),
					"method": "resolve_intent",
					"pass_actor_payload": true,
					"actor_id": int(actor.id)
				},
				"source": str(
					resolved_payload.get(
						"source",
						""
					)
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": int(actor.id),
				"target_id": int(actor.id),
				"surface_id": "career_panel",
				"action_id": str(
					resolved_payload.get(
						"action_id",
						"refresh"
					)
				),
				"source": str(
					resolved_payload.get(
						"source",
						""
					)
				)
			}
		)
	)

	var route_result: Dictionary = (
		MainSceneHelpers._career_contract_route_result(
			report
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"career_panel_contract",
			{}
		)
	)

	if contract.is_empty():
		return route_result

	career_panel_active_actor_id = int(
		actor.id
	)
	career_panel_active_section_id = str(
		contract.get(
			"active_section",
			career_panel_active_section_id
		)
	)

	_ensure_career_panel()

	career_panel.open_contract(
		contract
	)
	career_panel.z_as_relative = false
	career_panel.z_index = 245

	var panel_parent: Node = career_panel.get_parent()

	if panel_parent != null:
		panel_parent.move_child(
			career_panel,
			panel_parent.get_child_count() - 1
		)

	var result_type: String = str(
		route_result.get(
			"type",
			""
		)
	)

	if result_type == "open_career_coworkers_panel":
		_show_career_coworkers_panel(
			MainSceneHelpers._safe_array(
				route_result.get(
					"coworker_ids",
					[]
				)
			)
		)

	var result_text: String = str(
		route_result.get(
			"text",
			""
		)
	).strip_edges()

	if result_text != "":
		_append_text_to_diary(
			result_text,
			false
		)
		_maybe_show_action_result_popup(
			route_result
		)

	return route_result
func _render_contract_row_stat_bars(row_shell: VBoxContainer, row_dict: Dictionary) -> void:
	if row_shell == null or not is_instance_valid(row_shell):
		return

	var bars_raw: Variant = row_dict.get("stat_bars", [])
	if typeof(bars_raw) != TYPE_ARRAY:
		return

	var bars: Array = bars_raw
	if bars.is_empty():
		return

	var stat_box:= VBoxContainer.new()
	stat_box.add_theme_constant_override("separation", 4)
	row_shell.add_child(stat_box)

	for raw_bar in bars:
		if typeof(raw_bar) != TYPE_DICTIONARY:
			continue

		var bar_data: Dictionary = raw_bar
		var label:= Label.new()
		label.text = "%s • %d/100" % [
			str(bar_data.get("label", "Stat")),
			int(bar_data.get("value", 0))
		]
		stat_box.add_child(label)

		var bar:= ProgressBar.new()
		bar.min_value = 0.0
		bar.max_value = 100.0
		bar.value = 0.0
		bar.custom_minimum_size = Vector2(220, 10)
		stat_box.add_child(bar)

		var target_value: float = clamp(float(bar_data.get("value", 0)), 0.0, 100.0)
		var tween:= create_tween().bind_node(bar)
		tween.set_trans(Tween.TRANS_SINE)
		tween.set_ease(Tween.EASE_OUT)
		tween.tween_property(bar, "value", target_value, 0.34)
func _grocery_aisle_carousel_transition_distance() -> float:
	var fallback_width: float = get_viewport_rect().size.x
	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		fallback_width = max(fallback_width, ui_contract_surface_panel.size.x)

	return clamp(fallback_width * 0.11, 52.0, 128.0)


func _restore_grocery_aisle_carousel_mouse_filter(old_mouse_filter: int) -> void:
	if ui_contract_surface_panel == null or not is_instance_valid(ui_contract_surface_panel):
		return

	match old_mouse_filter:
		int(Control.MOUSE_FILTER_IGNORE):
			ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		int(Control.MOUSE_FILTER_PASS):
			ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_PASS
		int(Control.MOUSE_FILTER_STOP):
			ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_STOP
		_:
			ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_STOP
func _open_contract_surface_with_grocery_aisle_carousel_transition(surface_id: String, section_id: String, direction: int = 1) -> void:
	var clean_surface: String = str(surface_id).strip_edges()
	var clean_section: String = str(section_id).strip_edges()

	if clean_surface == "":
		return

	if direction == 0:
		direction = 1

	if ui_contract_surface_root == null or not is_instance_valid(ui_contract_surface_root):
		_open_contract_surface(clean_surface, clean_section)
		return

	if bool(get_meta("grocery_aisle_carousel_transition_active", false)):
		_open_contract_surface(clean_surface, clean_section)
		return

	var transition_token: int = int(get_meta("grocery_aisle_carousel_transition_token", 0)) + 1
	set_meta("grocery_aisle_carousel_transition_token", transition_token)
	set_meta("grocery_aisle_carousel_transition_active", true)
	set_meta("grocery_aisle_carousel_transition_started_at_ms", int(Time.get_ticks_msec()))
	set_meta("grocery_aisle_carousel_transition_direction", direction)

	var transition_distance: float = _grocery_aisle_carousel_transition_distance()
	var old_root: Control = ui_contract_surface_root
	var old_origin: Vector2 = old_root.position
	var old_mouse_filter: int = int(Control.MOUSE_FILTER_STOP)

	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		old_mouse_filter = int(ui_contract_surface_panel.mouse_filter)
		ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

	old_root.modulate = Color(1.0, 1.0, 1.0, 1.0)

	var exit_tween:= create_tween().bind_node(old_root)
	exit_tween.set_parallel(true)
	exit_tween.set_trans(Tween.TRANS_QUAD)
	exit_tween.set_ease(Tween.EASE_IN)
	exit_tween.tween_property(old_root, "position:x", old_origin.x - (transition_distance * float(direction)), 0.105)
	exit_tween.tween_property(old_root, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.105)
	exit_tween.set_parallel(false)

	await exit_tween.finished

	if transition_token != int(get_meta("grocery_aisle_carousel_transition_token", 0)):
		_restore_grocery_aisle_carousel_mouse_filter(old_mouse_filter)
		return

	_open_contract_surface(clean_surface, clean_section)

	if get_tree() != null:
		await get_tree().process_frame

	if ui_contract_surface_root == null or not is_instance_valid(ui_contract_surface_root):
		_restore_grocery_aisle_carousel_mouse_filter(old_mouse_filter)
		set_meta("grocery_aisle_carousel_transition_active", false)
		return

	var new_root: Control = ui_contract_surface_root
	var new_origin: Vector2 = new_root.position
	new_root.position = Vector2(new_origin.x + (transition_distance * float(direction)), new_origin.y)
	new_root.modulate = Color(1.0, 1.0, 1.0, 0.0)

	var enter_tween:= create_tween().bind_node(new_root)
	enter_tween.set_parallel(true)
	enter_tween.set_trans(Tween.TRANS_QUAD)
	enter_tween.set_ease(Tween.EASE_OUT)
	enter_tween.tween_property(new_root, "position:x", new_origin.x, 0.145)
	enter_tween.tween_property(new_root, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.145)
	enter_tween.set_parallel(false)

	await enter_tween.finished

	if transition_token != int(get_meta("grocery_aisle_carousel_transition_token", 0)):
		_restore_grocery_aisle_carousel_mouse_filter(old_mouse_filter)
		return

	if new_root != null and is_instance_valid(new_root):
		new_root.position = new_origin
		new_root.modulate = Color(1.0, 1.0, 1.0, 1.0)

	_restore_grocery_aisle_carousel_mouse_filter(old_mouse_filter)

	set_meta("grocery_aisle_carousel_transition_active", false)
	set_meta("grocery_aisle_carousel_transition_finished_at_ms", int(Time.get_ticks_msec()))
func _grocery_relationship_profile_context() -> Dictionary:
	var raw_context: Variant = get_meta("grocery_relationship_profile_context", {})
	if typeof(raw_context) == TYPE_DICTIONARY:
		return (raw_context as Dictionary).duplicate(true)
	return {}


func _grocery_relationship_profile_context_is_active() -> bool:
	var context: Dictionary = _grocery_relationship_profile_context()
	if context.is_empty():
		return false
	if str(context.get("store_id", "")).strip_edges() == "":
		return false
	return bool(context.get("active", true))


func _remember_grocery_relationship_profile_context(store_id: String, aisle_id: String, person_id: int, reason: String = "grocery_relationship_profile") -> void:
	var clean_store_id: String = str(store_id).strip_edges()
	var clean_aisle_id: String = str(aisle_id).strip_edges()

	if clean_store_id == "" and gs != null and gs.ui_contract_engine != null:
		var surface_state: Dictionary = gs.ui_contract_engine.surface_runtime_state.get("food_contract_hub", {}) if typeof(gs.ui_contract_engine.surface_runtime_state.get("food_contract_hub", {})) == TYPE_DICTIONARY else {}
		clean_store_id = str(surface_state.get("store_id", "")).strip_edges()
		clean_aisle_id = str(surface_state.get("aisle_id", clean_aisle_id)).strip_edges()

	if clean_store_id == "":
		return

	var context: Dictionary = {
		"active": true,
		"store_id": clean_store_id,
		"aisle_id": clean_aisle_id,
		"person_id": int(person_id),
		"surface_id": "food_contract_hub",
		"return_context": "food_contract_hub",
		"reason": reason,
		"created_at_ms": int(Time.get_ticks_msec())
	}
	set_meta("grocery_relationship_profile_context", context)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["grocery_relationship_profile_context"] = context.duplicate(true)


func _clear_grocery_relationship_profile_context(reason: String = "clear") -> void:
	var context: Dictionary = _grocery_relationship_profile_context()
	context ["active"] = false
	context ["cleared_reason"] = reason
	context ["cleared_at_ms"] = int(Time.get_ticks_msec())
	set_meta("grocery_relationship_profile_context", context)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["grocery_relationship_profile_context"] = context.duplicate(true)


func _restore_grocery_surface_from_relationship_context(reason: String = "restore_grocery_surface") -> bool:
	if gs == null or gs.ui_contract_engine == null:
		return false

	var context: Dictionary = _grocery_relationship_profile_context()
	var store_id: String = str(context.get("store_id", "")).strip_edges()
	var aisle_id: String = str(context.get("aisle_id", "")).strip_edges()
	if store_id == "":
		return false

	if aisle_id == "" and gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("first_aisle_id_for_store"):
		aisle_id = str(gs.grocery_store_engine.first_aisle_id_for_store(store_id)).strip_edges()

	var has_items: bool = false
	if gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("actor_cart_has_items") and gs.player != null:
		has_items = bool(gs.grocery_store_engine.actor_cart_has_items(gs.player))

	gs.ui_contract_engine.sync_surface_state("food_contract_hub", {
		"store_id": store_id,
		"aisle_id": aisle_id,
		"grocery_inside_store": true,
		"grocery_cart_unlocked": has_items,
		"grocery_ready_for_cashier": false,
		"notice": "",
		"relationship_restore_reason": reason
	})
	gs.ui_contract_engine.set_active_section("food_contract_hub", "aisles")

	current_panel = "life"
	_set_main_gameplay_ui_visible(true)
	_open_contract_surface("food_contract_hub", "aisles")
	_start_grocery_store_music(store_id, "restore_grocery_surface:%s" % reason)
	_update_food_lifestyle_hud()
	return true
func _drive_grocery_store_realtime_contract(
		delta: float
) -> void:
	if gs == null:
		return

	var relationship_context_active: bool = (
		_grocery_relationship_profile_context_is_active()
	)
	var relationship_context: Dictionary = (
		_grocery_relationship_profile_context()
	)
	var realtime_mode_active: bool = bool(
		get_meta(
			"grocery_store_realtime_mode_active",
			false
		)
	)
	var last_resident_store_id: String = str(
		get_meta(
			"grocery_store_realtime_last_resident_store_id",
			""
		)
	).strip_edges()



	if (
		not realtime_mode_active
		and not relationship_context_active
	):
		if last_resident_store_id != "":
			_request_runtime_engine_method_intent(
				"grocery_store_engine",
				"stop_grocery_store_realtime_session",
				[
					last_resident_store_id
				],
				"grocery_realtime_stop",
				"mainscene.grocery_realtime_service"
			)
			set_meta(
				"grocery_store_realtime_last_resident_store_id",
				""
			)

		return

	var store_id: String = str(
		relationship_context.get(
			"store_id",
			get_meta(
				"grocery_store_realtime_mode_store_id",
				""
			)
		)
	).strip_edges()
	var aisle_id: String = str(
		relationship_context.get(
			"aisle_id",
			get_meta(
				"grocery_store_realtime_mode_aisle_id",
				""
			)
		)
	).strip_edges()

	if (
		store_id == ""
		or aisle_id == ""
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var next_service_ms: int = int(
		get_meta(
			"grocery_store_realtime_next_service_ms",
			0
		)
	)

	if now_ms < next_service_ms:
		return



	set_meta(
		"grocery_store_realtime_next_service_ms",
		now_ms + 100
	)

	var actor_id: int = (
		int(gs.player.id)
		if gs.player != null
		else -1
	)

	var service_report: Dictionary = (
		_request_runtime_engine_method_intent(
			"grocery_store_engine",
			"drive_grocery_store_realtime_session",
			[
				store_id,
				aisle_id,
				delta,
				{
					"source": (
						"mainscene_realtime_food_residency"
					),
					"player_id": actor_id,
					"actor_id": actor_id,
					"active_section_id": (
						ui_contract_active_section_id
					),
					"shopper_quantum_limit": 1,
					"interactive_lens_has_absolute_priority": true,
					"ui_is_expression_only": true,
				}
			],
			"grocery_realtime_quantum:%s:%s"
			% [
				store_id,
				aisle_id
			],
			"mainscene.grocery_realtime_service"
		)
	)

	set_meta(
		"grocery_store_realtime_mode_year_locked",
		true
	)
	set_meta(
		"grocery_store_realtime_mode_store_id",
		store_id
	)
	set_meta(
		"grocery_store_realtime_mode_aisle_id",
		aisle_id
	)
	set_meta(
		"grocery_store_realtime_last_resident_store_id",
		store_id
	)
	set_meta(
		"grocery_store_realtime_last_service_report",
		service_report.duplicate(false)
	)
	set_meta(
		"grocery_store_realtime_full_surface_refresh_performed",
		false
	)

	var lens_patch_raw: Variant = (
		service_report.get(
			"lens_patch_contract",
			{}
		)
	)
	if typeof(lens_patch_raw) == TYPE_DICTIONARY:
		var lens_patch: Dictionary = (
			lens_patch_raw as Dictionary
		).duplicate(false)

		if not lens_patch.is_empty():
			set_meta(
				"grocery_realtime_last_lens_patch",
				lens_patch.duplicate(false)
			)
			_apply_grocery_realtime_lens_patch_contract(
				lens_patch
			)

	var next_popup_refresh_ms: int = int(
		get_meta(
			"grocery_store_realtime_next_popup_refresh_ms",
			0
		)
	)

	if (
		bool(
			get_meta(
				"grocery_aisle_shoppers_popup_open",
				false
			)
		)
		and now_ms >= next_popup_refresh_ms
	):
		set_meta(
			"grocery_store_realtime_next_popup_refresh_ms",
			now_ms + 1150
		)
		_refresh_grocery_aisle_shoppers_popup(
			store_id,
			aisle_id
		)




func _close_grocery_aisle_shoppers_popup(
		restore_aisle_surface: bool = true
) -> void:
	var store_id: String = str(
		get_meta(
			"grocery_aisle_shoppers_popup_store_id",
			""
		)
	).strip_edges()
	var aisle_id: String = str(
		get_meta(
