func _set_main_menu_surface_isolated(active: bool, reason: String = "main_menu") -> void:
	if active and gs != null and gs.player != null:
		if _playable_life_shell_has_visible_sovereignty() \
or _global_runtime_kill_current_runtime_domain() == "simulation" \
or bool(get_meta("main_menu_surface_terminated_for_playable_entry", false)):
			_hard_kill_choose_adventure_surface_for_playable_entry("%s_blocked_live_player" % reason)
			return

	if active and _god_mode_runtime_severed():
		var returning_to_main_menu_without_live_player: bool = (
			_global_runtime_kill_current_runtime_domain() == "main_menu"
			and (gs == null or gs.player == null)
		)

		if returning_to_main_menu_without_live_player:
			_reset_god_mode_runtime_firewall_for_intentional_return("%s_allow_main_menu_surface" % reason)
			set_meta("main_menu_surface_terminated_for_playable_entry", false)
			set_meta("choose_adventure_surface_hard_killed_for_playable_entry", false)
		else:
			var firewall:= _ensure_god_mode_runtime_firewall_engine()
			if firewall != null:
				firewall.confess("_set_main_menu_surface_isolated", "main_menu_surface_active_true", reason, true)
			set_meta("main_menu_surface_active", false)
			set_meta("main_menu_surface_terminated_for_playable_entry", true)
			set_meta("main_menu_surface_terminated_reason", reason)
			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["main_menu_surface_active"] = false
				gs.scenario_state ["main_menu_surface_terminated_for_playable_entry"] = true
				gs.scenario_state ["main_menu_surface_terminated_reason"] = reason
			return

	var root:= get_node_or_null("UIContainer") as Control
	if root != null and is_instance_valid(root):
		root.visible = not active
		root.mouse_filter = Control.MOUSE_FILTER_IGNORE if active else Control.MOUSE_FILTER_PASS

	if output_label != null and is_instance_valid(output_label):
		output_label.visible = false if active else output_label.visible
		if active:
			output_label.scroll_active = false

	for key in ui_nav_buttons.keys():
		var button: Button = ui_nav_buttons.get(key, null)
		if button == null or not is_instance_valid(button):
			continue

		if active:
			button.visible = false
			button.disabled = true
			button.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_set_birth_shell_interactive_controls_visible(false if active else true)

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay) and active:
		player_stats_overlay.visible = false

	if profile_panel_popup != null and is_instance_valid(profile_panel_popup) and active:
		profile_panel_popup.visible = false

	if relationships_browser_panel != null and is_instance_valid(relationships_browser_panel) and active:
		relationships_browser_panel.visible = false

	if activities_action_panel != null and is_instance_valid(activities_action_panel) and active:
		activities_action_panel.visible = false

	if world_feed_popup != null and is_instance_valid(world_feed_popup) and active:
		world_feed_popup.visible = false
		world_feed_popup_open = false

	if standard_tab_popup != null and is_instance_valid(standard_tab_popup) and active:
		standard_tab_popup.visible = false
		standard_tab_popup_open = false

	if active:
		_close_runtime_floating_huds_for_god_mode()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_menu_surface_active"] = active
		gs.scenario_state ["main_menu_surface_reason"] = reason
		gs.scenario_state ["main_gameplay_ui_visible"] = not active
		gs.scenario_state ["main_nav_buttons_visible"] = not active
		gs.scenario_state ["age_up_button_visible"] = not active
func _terminate_main_menu_surface_for_playable_entry(
		reason: String = "playable_entry"
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var playable_shell_has_sovereignty: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)





	if not playable_shell_has_sovereignty:
		_global_runtime_kill_enter_transition_runtime(
			reason,
			{
				"menu_cleanup_may_not_build_gameplay_ui": true,
				"guard_ms": 900
			}
		)
	else:
		set_meta(
			"main_menu_cleanup_preserved_simulation_domain",
			true
		)
		set_meta(
			"main_menu_cleanup_preserved_simulation_domain_reason",
			reason
		)
		set_meta(
			"main_menu_cleanup_preserved_simulation_domain_at_ms",
			now_ms
		)

	_hard_kill_choose_adventure_surface_for_playable_entry(
		reason
	)

	set_meta(
		"main_menu_surface_active",
		false
	)
	set_meta(
		"main_menu_surface_terminated_for_playable_entry",
		true
	)
	set_meta(
		"main_menu_surface_terminated_reason",
		reason
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"main_menu_surface_active"
		] = false
		gs.scenario_state [
			"main_menu_surface_terminated_for_playable_entry"
		] = true
		gs.scenario_state [
			"main_menu_surface_terminated_reason"
		] = reason
		gs.scenario_state [
			"menu_cleanup_may_not_build_gameplay_ui"
		] = true
		gs.scenario_state [
			"minimum_shell_fallback_banned"
		] = true
		gs.scenario_state [
			"god_mode_viewer_modal_open"
		] = false
		gs.scenario_state [
			"main_menu_cleanup_preserved_simulation_domain"
		] = playable_shell_has_sovereignty
		gs.scenario_state [
			"main_menu_cleanup_preserved_simulation_domain_reason"
		] = reason
		gs.scenario_state [
			"main_menu_cleanup_preserved_simulation_domain_at_ms"
		] = now_ms




	if playable_shell_has_sovereignty:
		_global_runtime_kill_enter_simulation_runtime(
			"%s_preserve_visible_playable_shell" % reason,
			{
				"source": (
					"main_menu_visual_cleanup_after_ready"
				),
				"playable_life_shell_visible": true,
			}
		)
func _resident_playable_life_shell_surface_is_hot() -> bool:
	var root:= get_node_or_null(
		"UIContainer"
	) as Control
	var era_background:= get_node_or_null(
		"__EraBackgroundFill"
	) as ColorRect
	var missing: Array = []

	if root == null or not is_instance_valid(root):
		missing.append("UIContainer")

	if output_label == null or not is_instance_valid(output_label):
		missing.append("output_label")

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		missing.append("player_stats_overlay")

	if era_background == null or not is_instance_valid(era_background):
		missing.append("__EraBackgroundFill")

	if era_border_overlay == null or not is_instance_valid(era_border_overlay):
		missing.append("era_border_overlay")




	var required_hud_nodes: Array = [
		["belongings_hud_button", belongings_hud_button],
		["belongings_hud_panel", belongings_hud_panel],
		["bending_hud_button", bending_hud_button],
		["crown_hud_button", crown_hud_button],
		["food_lifestyle_hud_button", food_lifestyle_hud_button],
		["restaurant_lifestyle_hud_button", restaurant_lifestyle_hud_button],
		["rick_weapon_shop_hud_button", rick_weapon_shop_hud_button],
		["boxing_hud_button", boxing_hud_button],
		["superpower_hud_button", superpower_hud_button],
		["power_hud_button", power_hud_button],
		["wizard_hud_button", wizard_hud_button],
		["wizard_hud_panel", wizard_hud_panel]
	]

	for required_row_raw in required_hud_nodes:
		var required_row: Array = required_row_raw as Array
		var node_name: String = str(required_row [0])
		var node_value: Variant = required_row [1]
		if node_value == null or not is_instance_valid(node_value):
			missing.append(node_name)

	for raw_key in _get_ui_nav_order():
		var key: String = str(raw_key)
		var nav_button:= ui_nav_buttons.get(
			key,
			null
		) as Button
		if nav_button == null or not is_instance_valid(nav_button):
			missing.append(
				"ui_nav_button:%s" % key
			)

	var shell_hot: bool = missing.is_empty()
	var truth_signature: String = "%s|%s" % [
		str(shell_hot),
		JSON.stringify(missing)
	]
	var previous_truth_signature: String = str(
		get_meta(
			"resident_playable_life_shell_truth_signature",
			""
		)
	)

	if truth_signature != previous_truth_signature:
		EraLog.truth(
			(
				"ERALIFE_LIFE_SHELL_TRUTH"
				+ "|hot=%s"
				+ "|missing=%s"
				+ "|nav_button_count=%d"
				+ "|required_nav_count=%d"
			)
			% [
				str(shell_hot),
				JSON.stringify(missing),
				ui_nav_buttons.size(),
				_get_ui_nav_order().size()
			]
		)
		set_meta(
			"resident_playable_life_shell_truth_signature",
			truth_signature
		)

	set_meta(
		"resident_playable_life_shell_surface_hot",
		shell_hot
	)
	set_meta(
		"resident_playable_life_shell_surface_missing",
		missing.duplicate(false)
	)
	set_meta(
		"resident_playable_life_shell_surface_checked_at_ms",
		int(Time.get_ticks_msec())
	)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"resident_playable_life_shell_surface_hot"
		] = shell_hot
		gs.scenario_state [
			"resident_playable_life_shell_surface_missing"
		] = missing.duplicate(false)
		gs.scenario_state [
			"resident_playable_life_shell_surface_checked_at_ms"
		] = int(Time.get_ticks_msec())

	return shell_hot
func _cancel_resident_playable_life_shell_surface_prime(
	reason: String
) -> void:
	var cancellation_sequence: int = int(
		get_meta(
			"resident_playable_life_shell_surface_prime_cancellation_sequence",
			0
		)
	) + 1

	set_meta(
		"resident_playable_life_shell_surface_prime_active",
		false
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_cancelled",
		true
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_cancelled_reason",
		reason
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_cancelled_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_cancellation_sequence",
		cancellation_sequence
	)

	remove_meta(
		"resident_playable_life_shell_pending_snapshot"
	)
	remove_meta(
		"resident_playable_life_shell_pending_reason"
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"resident_playable_life_shell_surface_prime_active"
		] = false
		gs.scenario_state [
			"resident_playable_life_shell_surface_prime_cancelled"
		] = true
		gs.scenario_state [
			"resident_playable_life_shell_surface_prime_cancelled_reason"
		] = reason
		gs.scenario_state [
			"resident_playable_life_shell_surface_prime_cancelled_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
		gs.scenario_state [
			"resident_playable_life_shell_surface_prime_cancellation_sequence"
		] = cancellation_sequence
func _prime_resident_playable_life_shell_surface(
	reason: String = "resident_playable_life_shell_prime"
) -> void:
	var structural_shell_hot: bool = (
		_resident_playable_life_shell_surface_is_hot()
	)
	var checkpoint_cooperative_prime: bool = (
		reason.begins_with(
			"title_card_"
		)
		or reason.contains(
			"checkpoint"
		)
	)
	var target_signature: String = str(
		get_meta(
			"checkpoint_reality_handoff_target_signature",
			""
		)
	).strip_edges()
	var bound_signature: String = str(
		get_meta(
			"checkpoint_reality_handoff_bound_signature",
			""
		)
	).strip_edges()
	var live_checkpoint_rebind: bool = (
		checkpoint_cooperative_prime
		and bool(
			get_meta(
				"checkpoint_reality_handoff_live_rebind_requested",
				false
			)
		)
		and target_signature != ""
	)
	var force_reality_rebind: bool = (
		live_checkpoint_rebind
		and bound_signature != target_signature
	)

	if (
		structural_shell_hot
		and not force_reality_rebind
	):
		set_meta(
			"resident_playable_life_shell_surface_hot",
			true
		)
		return

	if (
		checkpoint_cooperative_prime
		and not live_checkpoint_rebind
	):
		set_meta(
			"resident_playable_life_shell_surface_prime_waiting_for_observation",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_waiting_reason",
			reason
		)
		return

	if bool(
		get_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
	):
		return

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root == null or not is_instance_valid(root):
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"ui_container_missing"
		)
		return

	var previous_shell_visible: bool = bool(
		get_meta(
			"checkpoint_reality_handoff_previous_shell_visible",
			false
		)
	)

	root.process_mode = Node.PROCESS_MODE_INHERIT

	if live_checkpoint_rebind:
		root.visible = previous_shell_visible
		root.mouse_filter = (
			Control.MOUSE_FILTER_PASS
			if previous_shell_visible
			else Control.MOUSE_FILTER_IGNORE
		)
	else:
		root.visible = false
		root.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	set_meta(
		"resident_playable_life_shell_surface_prime_active",
		true
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_reason",
		reason
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_stage",
		0
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_live_publication",
		live_checkpoint_rebind
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_waiting_for_observation",
		false
	)
	set_meta(
		"resident_playable_life_shell_surface_prime_force_reality_rebind",
		force_reality_rebind
	)
	set_meta(
		"legacy_playable_life_shell_raw_state_forbidden",
		true
	)

	if live_checkpoint_rebind:
		var callback:= Callable(
			self,
			"_continue_checkpoint_live_life_shell_surface_prime"
		).bind(
			reason,
			0
		)

		if not callback.is_valid():
			set_meta(
				"resident_playable_life_shell_surface_prime_active",
				false
			)
			set_meta(
				"resident_playable_life_shell_surface_prime_failed",
				true
			)
			set_meta(
				"resident_playable_life_shell_surface_prime_failure_reason",
				"checkpoint_prime_callable_invalid"
			)
			return

		var tree:= get_tree()

		if tree == null:
			call_deferred(
				"_continue_checkpoint_live_life_shell_surface_prime",
				reason,
				0
			)
			return

		var connection_error: int = (
			tree.process_frame.connect(
				callback,
				CONNECT_ONE_SHOT
			)
		)

		if connection_error != OK:
			call_deferred(
				"_continue_checkpoint_live_life_shell_surface_prime",
				reason,
				0
			)

		return

	call_deferred(
		"_continue_resident_playable_life_shell_surface_prime",
		reason,
		0
	)
func _continue_resident_playable_life_shell_surface_prime(
		reason: String,
		stage_index: int
) -> void:
	if not bool(
		get_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
	):
		return

	if bool(
		get_meta(
			"playable_life_shell_atomic_visual_commit_complete",
			false
		)
	):
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		return

	var checkpoint_cooperative_prime: bool = bool(
		get_meta(
			"resident_playable_life_shell_surface_prime_live_publication",
			false
		)
	)
	var max_stage_index: int = 8

	set_meta(
		"resident_playable_life_shell_surface_prime_stage",
		stage_index
	)

	if stage_index > max_stage_index:
		var final_hot: bool = (
			_resident_playable_life_shell_surface_is_hot()
		)
		if not final_hot:
			set_meta(
				"resident_playable_life_shell_surface_prime_active",
				false
			)
			set_meta(
				"resident_playable_life_shell_surface_prime_failed",
				true
			)
			set_meta(
				"resident_playable_life_shell_surface_prime_failure_reason",
				"resident_chassis_incomplete_after_final_stage"
			)
			return

	match stage_index:
		0:
			_ensure_player_stats_overlay()
		1:
			_ensure_belongings_hud()
		2:
			_ensure_bending_hud()
		3:
			_ensure_crown_hud()
		4:
			_ensure_food_lifestyle_hud()
			_ensure_rick_weapon_shop_hud()
		5:
			_ensure_boxing_hud()
		6:
			_ensure_superpower_hud()
			_ensure_power_hud()
			_ensure_wizard_hud()
		7:
			_bind_ui_nav_buttons()
			_apply_centered_live_layout()
		8:
			_refresh_era_background_fill()
			_ensure_era_border_overlay()
		_:
			pass

	var shell_hot: bool = (
		_resident_playable_life_shell_surface_is_hot()
	)

	if shell_hot:
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_complete",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_completed_at_ms",
			int(Time.get_ticks_msec())
		)

		var pending_snapshot_raw: Variant = get_meta(
			"resident_playable_life_shell_pending_snapshot",
			{}
		)
		if typeof(pending_snapshot_raw) == TYPE_DICTIONARY:
			var pending_snapshot: Dictionary = (
				pending_snapshot_raw as Dictionary
			)
			if not pending_snapshot.is_empty():
				_project_prebuilt_first_frame_snapshot_into_existing_shell(
					pending_snapshot,
					"resident_shell_prime_pending_snapshot"
				)

		remove_meta(
			"resident_playable_life_shell_pending_snapshot"
		)
		remove_meta(
			"resident_playable_life_shell_pending_reason"
		)
		return

	if stage_index >= max_stage_index:
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"resident_chassis_still_cold_after_final_stage"
		)
		return



	set_meta(
		"resident_playable_life_shell_surface_prime_active",
		true
	)

	if not checkpoint_cooperative_prime:
		call_deferred(
			"_continue_resident_playable_life_shell_surface_prime",
			reason,
			stage_index + 1
		)
		return

	var tree:= get_tree()
	if tree == null:
		call_deferred(
			"_continue_resident_playable_life_shell_surface_prime",
			reason,
			stage_index + 1
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_resident_playable_life_shell_surface_prime"
		).bind(
			reason,
			stage_index + 1
		),
		CONNECT_ONE_SHOT
	)
func _continue_checkpoint_live_life_shell_surface_prime(
	reason: String,
	stage_index: int
) -> void:
	if not bool(
		get_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
	):
		return

	if (
		gs == null
		or gs.player == null
	):
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"checkpoint_actor_truth_missing"
		)
		return

	if gs.era == null:
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"checkpoint_era_truth_missing"
		)
		return

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root == null or not is_instance_valid(root):
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"ui_container_missing"
		)
		return

	root.process_mode = Node.PROCESS_MODE_INHERIT

	set_meta(
		"resident_playable_life_shell_surface_prime_stage",
		stage_index
	)

	var resume_raw: Variant = get_meta(
		"checkpoint_reality_handoff_resume_contract",
		get_meta(
			"title_card_checkpoint_resume_lens_prewarm_contract",
			{}
		)
	)
	var resume_contract: Dictionary = (
		resume_raw as Dictionary
		if typeof(
			resume_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var first_frame_raw: Variant = (
		resume_contract.get(
			"first_frame_ui_snapshot",
			{}
		)
	)
	var first_frame: Dictionary = (
		first_frame_raw as Dictionary
		if typeof(
			first_frame_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var hud_raw: Variant = (
		resume_contract.get(
			"runtime_hud_visibility_snapshot",
			{}
		)
	)
	var hud_snapshot: Dictionary = (
		hud_raw as Dictionary
		if typeof(
			hud_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var target_signature: String = str(
		get_meta(
			"checkpoint_reality_handoff_target_signature",
			reality_residency_attached_signature
		)
	).strip_edges()
	var entry_surface: String = str(
		get_meta(
			"checkpoint_reality_handoff_entry_surface",
			"saved_life_picker"
		)
	).strip_edges()
	var stage_label: String = ""

	if first_frame.is_empty():
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"checkpoint_first_frame_packet_missing"
		)
		return

	var first_frame_actor_id: int = int(
		first_frame.get(
			"actor_id",
			first_frame.get(
				"player_id",
				-1
			)
		)
	)

	if (
		first_frame_actor_id <= 0
		or first_frame_actor_id
		!= int(
			gs.player.id
		)
	):
		set_meta(
			"resident_playable_life_shell_surface_prime_active",
			false
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failed",
			true
		)
		set_meta(
			"resident_playable_life_shell_surface_prime_failure_reason",
			"checkpoint_first_frame_actor_mismatch"
		)
		return

	match stage_index:
		0:
			stage_label = "me.identity"


			_bind_ui_nav_buttons()

			for raw_key in _get_ui_nav_order():
				var key: String = str(
					raw_key
				)
				var nav_button:= (
					ui_nav_buttons.get(
						key,
						null
					) as Button
				)

				if (
					nav_button == null
					or not is_instance_valid(
						nav_button
					)
				):
					continue

				nav_button.visible = true
				nav_button.disabled = false
				nav_button.mouse_filter = (
					Control.MOUSE_FILTER_STOP
				)
				nav_button.focus_mode = (
					Control.FOCUS_NONE
				)
				nav_button.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)
				nav_button.set_meta(
					"checkpoint_resume_visible_means_interactive",
					true
				)
				nav_button.set_meta(
					"checkpoint_resume_projection_may_stream_after_open",
					true
				)

			set_meta(
				"main_tab_input_contract_hot",
				true
			)
			set_meta(
				"checkpoint_resume_visible_nav_disabled_count",
				0
			)

			if (
				output_label != null
				and is_instance_valid(
					output_label
				)
			):
				output_label.visible = false
				output_label.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			_ensure_player_stats_overlay()

			if (
				player_stats_overlay == null
				or not is_instance_valid(
					player_stats_overlay
				)
			):
				set_meta(
					"resident_playable_life_shell_surface_prime_active",
					false
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_failed",
					true
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_failure_reason",
					"player_stats_overlay_missing"
				)
				return

			var first_frame_consumed: bool = (
				_project_prebuilt_first_frame_snapshot_into_existing_shell(
					first_frame,
					"checkpoint_reality_handoff_identity"
				)
			)

			if not first_frame_consumed:
				set_meta(
					"resident_playable_life_shell_surface_prime_active",
					false
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_failed",
					true
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_failure_reason",
					"checkpoint_first_frame_projection_failed"
				)
				return

			if (
				output_label != null
				and is_instance_valid(
					output_label
				)
			):
				output_label.visible = false

			player_stats_overlay.visible = true
			player_stats_overlay.modulate = (
				Color.WHITE
			)
			player_stats_overlay.mouse_filter = (
				Control.MOUSE_FILTER_PASS
			)

			player_stats_overlay.set_meta(
				"player_stats_current_actor_id",
				int(
					gs.player.id
				)
			)
			player_stats_overlay.set_meta(
				"player_stats_bank_actor_id",
				int(
					gs.player.id
				)
			)
			player_stats_overlay.set_meta(
				"checkpoint_reality_identity_packet_bound",
				true
			)

			if not hud_snapshot.is_empty():
				_apply_checkpoint_resume_hud_snapshot_to_existing_nodes(
					hud_snapshot,
					"checkpoint_reality_handoff_identity"
				)

			_refresh_era_background_fill()

			var era_background:= (
				get_node_or_null(
					"__EraBackgroundFill"
				) as ColorRect
			)

			if (
				era_background != null
				and is_instance_valid(
					era_background
				)
			):
				era_background.visible = true
				era_background.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			current_panel = "life"
			root.visible = true
			root.mouse_filter = (
				Control.MOUSE_FILTER_PASS
			)

			if (
				entry_surface
				== "title_card_continue"
			):
				startup_intro_exiting = true
				startup_intro_sequence_generation += 1

				_finish_title_card_continue_intro_cleanup()

			set_meta(
				"title_card_continue_progressive_surface_visible",
				true
			)
			set_meta(
				"checkpoint_reality_handoff_identity_published",
				true
			)
			set_meta(
				"checkpoint_reality_handoff_identity_actor_id",
				int(
					gs.player.id
				)
			)
			set_meta(
				"checkpoint_reality_handoff_identity_signature",
				target_signature
			)
			set_meta(
				"checkpoint_reality_handoff_stale_prelife_text_visible",
				false
			)

		1:
			stage_label = (
				"my_life.era_frame"
			)

			_ensure_era_border_zero_frame_from_snapshot(
				first_frame,
				"checkpoint_reality_handoff"
			)
			_show_era_border_overlay_for_current_era(
				false
			)
			_layout_era_border_overlay()

			if (
				era_border_overlay != null
				and is_instance_valid(
					era_border_overlay
				)
			):
				era_border_overlay.visible = true
				era_border_overlay.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			_apply_ui_nav_button_visuals()

		2:
			stage_label = (
				"my_life.life_diary"
			)

			if (
				output_label != null
				and is_instance_valid(
					output_label
				)
			):
				output_label.visible = true
				output_label.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				output_label.scroll_active = true
				output_label.bbcode_enabled = true

		3:
			stage_label = (
				"my_life.navigation"
			)

			_bind_ui_nav_buttons()
			_apply_centered_live_layout()
			_apply_ui_nav_button_visuals()

			var committed_at_ms: int = int(
				Time.get_ticks_msec()
			)
			var shell_hot: bool = (
				_resident_playable_life_shell_surface_is_hot()
			)

			if not shell_hot:
				set_meta(
					"resident_playable_life_shell_surface_prime_failed",
					true
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_failure_reason",
					"checkpoint_core_shell_not_hot_after_publication"
				)
				set_meta(
					"resident_playable_life_shell_surface_prime_active",
					false
				)
				return

			set_meta(
				"resident_playable_life_shell_surface_hot",
				true
			)
			set_meta(
				"playable_life_shell_atomic_visual_commit_complete",
				true
			)
			set_meta(
				"playable_life_shell_atomic_visual_commit_at_ms",
				committed_at_ms
			)
			set_meta(
				"checkpoint_progressive_core_shell_commit_complete",
				true
			)
			set_meta(
				"checkpoint_reality_handoff_bound_signature",
				target_signature
			)
			set_meta(
				"resident_playable_life_shell_surface_prime_active",
				false
			)
			set_meta(
				"checkpoint_live_life_shell_core_bloom_complete",
				true
			)

			_queue_checkpoint_reality_surface_publication_tail(
