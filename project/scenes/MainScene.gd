func _rick_weapon_shop_purchase_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report
	]
	var inspected: int = 0
	var fallback: Dictionary = {}

	while (
		not queue.is_empty()
		and inspected < 96
	):
		var raw_cursor: Variant = queue.pop_front()
		inspected += 1

		if typeof(
			raw_cursor
		) == TYPE_ARRAY:
			for nested_raw in raw_cursor as Array:
				if (
					typeof(nested_raw) == TYPE_DICTIONARY
					or typeof(nested_raw) == TYPE_ARRAY
				):
					queue.append(
						nested_raw
					)

			continue

		if typeof(
			raw_cursor
		) != TYPE_DICTIONARY:
			continue

		var cursor: Dictionary = (
			raw_cursor as Dictionary
		)

		if str(
			cursor.get(
				"mode",
				""
			)
		).strip_edges().to_lower() == (
			"weapon_purchase"
		):
			return cursor.duplicate(false)

		if (
			cursor.has(
				"weapon_name"
			)
			and (
				cursor.has(
					"popup_text"
				)
				or cursor.has(
					"cost"
				)
			)
		):
			return cursor.duplicate(false)

		if (
			fallback.is_empty()
			and bool(
				cursor.get(
					"success",
					false
				)
			)
		):
			fallback = cursor.duplicate(false)

		for key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				key,
				null
			)

			if (
				typeof(nested_raw) == TYPE_DICTIONARY
				or typeof(nested_raw) == TYPE_ARRAY
			):
				queue.append(
					nested_raw
				)

	return fallback

func _rick_weapon_shop_purchase_weapon_now(
	weapon_name: String,
	contract_id: String,
	show_popup: bool = true
) -> Dictionary:
	if (
		gs == null
		or gs.player == null
	):
		return {}

	var actor_id: int = int(
		gs.player.id
	)
	var routed_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "purchase_weapon",
		"surface_id": "rick_weapon_shop",
		"action_id": "purchase_weapon",
		"payload": {
			"actor_id": actor_id,
			"contract_id": contract_id,
			"weapon_name": weapon_name,
			"source": (
				"mainscene_rick_weapon_shop_buy"
			),
			"immutable_contract_references": true
		},
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"runtime_contract_engine"
			),
			"method": (
				"resolve_weapon_shop_purchase_intent"
			),
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": (
			"mainscene_rick_weapon_shop_buy"
		),
		"immutable_contract_references": true,
		"ephemeral_infrastructure_intent": true,
		"skip_global_intent_persistence": true,
		"skip_crr_observation": true
	}, {
		"actor_id": actor_id,
		"surface_id": "rick_weapon_shop",
		"action_id": "purchase_weapon",
		"source": (
			"mainscene_rick_weapon_shop_buy"
		),
		"immutable_contract_references": true,
		"skip_crr_observation": true
	})
	var result: Dictionary = (
		_rick_weapon_shop_purchase_route_result(
			report
		)
	)

	if show_popup:
		_maybe_show_action_result_popup(
			result
			)

		_consume_bank_delta_from_observable_receipt(
			result,
			"rick_weapon_shop.weapon_purchase"
		)

	var state_raw: Variant = (
		rick_weapon_shop_active_contract.get(
			"shop_runtime_state",
			{}
		)
	)
	var state: Dictionary = (
		(
			state_raw as Dictionary
		).duplicate(false)
		if typeof(
			state_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var inside_raw: Variant = state.get(
		"inside",
		{}
	)
	var inside: Dictionary = (
		(
			inside_raw as Dictionary
		).duplicate(false)
		if typeof(
			inside_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var success: bool = bool(
		result.get(
			"success",
			false
		)
	)
	var live_text: String = (
		(
			"Rick watches the purchase resolve.\n"
			+ "Rick: \"Transaction complete. "
			+ "Consequences pending.\""
		)
		if success
		else str(
			result.get(
				"popup_text",
				result.get(
					"text",
					"Rick rejects the transaction."
				)
			)
		)
	)

	state ["mode"] = "inside"
	inside ["rick_live_text"] = live_text
	inside ["last_purchase_weapon_name"] = weapon_name
	inside ["last_purchase_success"] = success
	inside ["last_purchase_at_ms"] = int(
		Time.get_ticks_msec()
	)
	state ["inside"] = inside

	rick_weapon_shop_active_contract [
		"shop_runtime_state"
	] = state

	if (
		rick_weapon_shop_popup_footer != null
		and is_instance_valid(
			rick_weapon_shop_popup_footer
		)
	):
		rick_weapon_shop_popup_footer.text = live_text

	belongings_hud_content_dirty = true

	set_meta(
		"rick_weapon_shop_purchase_full_rebuild_performed",
		false
	)
	set_meta(
		"rick_weapon_shop_purchase_catalog_rescan_performed",
		bool(
			result.get(
				"global_object_catalog_rescanned",
				false
			)
		)
	)

	EraLog.truth(
		(
			"ERALIFE_RICK_PURCHASE_TRUTH"
			+ "|weapon=%s"
			+ "|success=%s"
			+ "|full_shop_rebuild=false"
			+ "|catalog_rescan=%s"
			+ "|elapsed_ms=%d"
		)
		% [
			weapon_name,
			str(
				success
			),
			str(
				bool(
					result.get(
						"global_object_catalog_rescanned",
						false
					)
				)
			),
			maxi(
				0,
				int(
					Time.get_ticks_msec()
				) - routed_at_ms
			)
		]
	)

	return result

func _rick_weapon_shop_checkout_cart_now(
	contract_id: String
) -> void:
	var state: Dictionary = MainSceneHelpers._safe_dictionary(
		rick_weapon_shop_active_contract.get(
			"shop_runtime_state",
			{}
		)
	)
	var inside: Dictionary = MainSceneHelpers._safe_dictionary(
		state.get(
			"inside",
			{}
		)
	)
	var cart: Array = MainSceneHelpers._safe_array(
		inside.get(
			"player_cart",
			[]
		)
	)

	if cart.is_empty():
		return

	var bought: Array = []
	var failed: Array = []




	var processed_weapon_keys: Dictionary = {}

	for raw_weapon in cart:
		if typeof(raw_weapon) != TYPE_DICTIONARY:
			continue

		var weapon: Dictionary = raw_weapon as Dictionary
		var weapon_name: String = str(
			weapon.get(
				"name",
				weapon.get(
					"display_name",
					""
				)
			)
		).strip_edges()

		if weapon_name == "":
			continue

		var weapon_key: String = (
			weapon_name.to_lower()
		)

		if processed_weapon_keys.has(
			weapon_key
		):
			continue

		processed_weapon_keys [
			weapon_key
		] = true

		var result: Dictionary = (
			_rick_weapon_shop_purchase_weapon_now(
				weapon_name,
				contract_id,
				false
			)
		)

		if bool(
			result.get(
				"success",
				false
			)
		):
			bought.append(
				weapon_name
			)
		else:
			failed.append(
				weapon_name
			)

	var refreshed_state: Dictionary = MainSceneHelpers._safe_dictionary(
		rick_weapon_shop_active_contract.get(
			"shop_runtime_state",
			{}
		)
	)
	var refreshed_inside: Dictionary = MainSceneHelpers._safe_dictionary(
		refreshed_state.get(
			"inside",
			{}
		)
	)

	refreshed_inside ["player_cart"] = []
	refreshed_inside ["player_holding_for_checkout"] = false
	refreshed_inside ["held_weapon_name"] = ""
	refreshed_inside ["checkout_section_open"] = false
	refreshed_inside ["rick_live_text"] = (
		"Rick clears the cart.\n"
		+ "Rick: \"That is either preparation or foreshadowing.\""
	)
	refreshed_state ["inside"] = refreshed_inside
	rick_weapon_shop_active_contract [
		"shop_runtime_state"
	] = refreshed_state

	_maybe_show_action_result_popup({
		"success": failed.is_empty(),
		"popup_title": "Rick's Checkout",
		"popup_text": "Bought: %s%s" % [
			(
				", ".join(bought)
				if not bought.is_empty()
				else "nothing"
			),
			(
				"\nFailed: %s" % ", ".join(failed)
				if not failed.is_empty()
				else ""
			)
		],
		"popup_footer": "Tap anywhere to continue.",
		"unique_purchase_intent_count": (
			processed_weapon_keys.size()
		)
	})

	_populate_rick_weapon_shop_popup(
		rick_weapon_shop_active_contract
	)
func _rick_weapon_shop_prepare_live_state(contract: Dictionary) -> Dictionary:
	var out: Dictionary = contract.duplicate(true)
	var state: Dictionary = MainSceneHelpers._safe_dictionary(out.get("shop_runtime_state", {}))
	if state.is_empty():
		state = _rick_weapon_shop_default_live_state()

	if not state.has("mode"):
		state ["mode"] = str(get_meta("rick_weapon_shop_mode", "outside"))

	if not state.has("outside") or MainSceneHelpers._safe_dictionary(state.get("outside", {})).is_empty():
		state ["outside"] = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside", {}))

	if not state.has("outside_people") or MainSceneHelpers._safe_dictionary(state.get("outside_people", {})).is_empty():
		state ["outside_people"] = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside_people", {}))

	if not state.has("inside") or MainSceneHelpers._safe_dictionary(state.get("inside", {})).is_empty():
		state ["inside"] = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("inside", {}))

	var inside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("inside", {}))
	if not inside.has("browsers"):
		inside ["browsers"] = _rick_weapon_shop_make_people_group(int(inside.get("people_browsing", 0)), "browsing", "eyeballing the weapon wall")
	if not inside.has("checking_out_person"):
		inside ["checking_out_person"] = _rick_weapon_shop_make_person("checkout", "checking out with Rick") if int(inside.get("person_checking_out", 0)) > 0 else {}
	if not inside.has("player_cart"):
		inside ["player_cart"] = []
	if not inside.has("player_holding_for_checkout"):
		inside ["player_holding_for_checkout"] = false
	if not inside.has("held_weapon_name"):
		inside ["held_weapon_name"] = ""
	if not inside.has("checkout_section_open"):
		inside ["checkout_section_open"] = false

	inside ["people_browsing"] = MainSceneHelpers._safe_array(inside.get("browsers", [])).size()
	inside ["person_checking_out"] = 1 if not MainSceneHelpers._safe_dictionary(inside.get("checking_out_person", {})).is_empty() else 0
	state ["inside"] = inside

	out ["shop_runtime_state"] = state
	return out
func _rick_weapon_shop_default_live_state() -> Dictionary:
	var rng:= RandomNumberGenerator.new()
	rng.randomize()

	var walking_by_count: int = MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.72, 5)
	var checkout_count: int = int(rng.randi_range(0, 1))
	var browsing_count: int = int(rng.randi_range(0, 3))

	return {
		"mode": "outside",
		"outside": {
			"people_walking_by": walking_by_count,
			"people_walking_in": 0,
			"people_walking_out": 0,
			"pending_people_inside": 0
		},
		"outside_people": {
			"walking_by": _rick_weapon_shop_make_people_group(walking_by_count, "walking_by", "walking past Rick's shop"),
			"walking_in": [],
			"walking_out": []
		},
		"inside": {
			"people_browsing": browsing_count,
			"person_checking_out": checkout_count,
			"browsers": _rick_weapon_shop_make_people_group(browsing_count, "browsing", "eyeballing the weapon wall"),
			"checking_out_person": _rick_weapon_shop_make_person("checkout", "checking out with Rick") if checkout_count > 0 else {},
			"player_cart": [],
			"player_holding_for_checkout": false,
			"held_weapon_name": "",
			"checkout_section_open": false,
			"last_live_line": MainSceneHelpers._rick_weapon_shop_random_checkout_line() if checkout_count > 0 else "",
			"rick_live_text": ""
		}
	}
func _rick_weapon_shop_make_person(zone_id: String, activity: String) -> Dictionary:
	var rng:= RandomNumberGenerator.new()
	rng.randomize()

	var first_names: Array = ["Avery", "Jordan", "Maya", "Chris", "Taylor", "Sam", "Riley", "Morgan", "Imani", "Devon", "Andre", "Nia", "Kai", "Noelle", "Talia", "Malik", "Sienna", "Jasper", "Amara", "Theo"]
	var last_names: Array = ["Vale", "Cross", "Stone", "Rivera", "Chen", "Okafor", "Bennett", "Hale", "Morrow", "Reed", "Sato", "Nadir", "Brooks", "Khan", "West", "Bell", "Ashford", "Grey", "Locke", "Marin"]
	var first_name: String = str(first_names [int(rng.randi_range(0, first_names.size() - 1))])
	var last_name: String = str(last_names [int(rng.randi_range(0, last_names.size() - 1))])
	var eyeballing: String = _rick_weapon_shop_random_inventory_name() if zone_id == "browsing" else ""

	return {
		"person_id": "rick_shop_person_%s_%d_%d" % [zone_id, int(Time.get_ticks_msec()), int(rng.randi_range(1000, 9999))],
		"first_name": first_name,
		"last_name": last_name,
		"full_name": "%s %s" % [first_name, last_name],
		"age": int(rng.randi_range(18, 74)),
		"zone_id": zone_id,
		"activity": activity,
		"eyeballing": eyeballing,
		"created_at_ms": int(Time.get_ticks_msec())
	}


func _rick_weapon_shop_make_people_group(count: int, zone_id: String, activity: String) -> Array:
	var people: Array = []
	for i in range(max(0, count)):
		people.append(_rick_weapon_shop_make_person(zone_id, activity))
	return people


func _rick_weapon_shop_random_inventory_name() -> String:
	var inventory: Array = MainSceneHelpers._safe_array(rick_weapon_shop_active_contract.get("inventory", [])) if not rick_weapon_shop_active_contract.is_empty() else []
	var names: Array = []

	for raw_weapon in inventory:
		if typeof(raw_weapon) != TYPE_DICTIONARY:
			continue
		var weapon: Dictionary = raw_weapon as Dictionary
		var weapon_name: String = str(weapon.get("name", weapon.get("display_name", ""))).strip_edges()
		if weapon_name != "":
			names.append(weapon_name)

	var rng:= RandomNumberGenerator.new()
	rng.randomize()

	if names.is_empty():
		var fallback: Array = ["the front wall", "the cheap rack", "the expensive rack", "something Rick refuses to explain"]
		return str(fallback [int(rng.randi_range(0, fallback.size() - 1))])

	return str(names [int(rng.randi_range(0, names.size() - 1))])
func _tick_rick_weapon_shop_live(_delta: float) -> void:
	if not rick_weapon_shop_popup_open:
		return
	if rick_weapon_shop_popup == null or not is_instance_valid(rick_weapon_shop_popup):
		return
	if not rick_weapon_shop_popup.visible:
		return
	if rick_weapon_shop_active_contract.is_empty():
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var next_tick_ms: int = int(get_meta("rick_weapon_shop_live_next_tick_ms", 0))
	if now_ms < next_tick_ms:
		return

	var rng:= RandomNumberGenerator.new()
	rng.randomize()

	var state: Dictionary = MainSceneHelpers._safe_dictionary(rick_weapon_shop_active_contract.get("shop_runtime_state", {}))
	if state.is_empty():
		state = _rick_weapon_shop_default_live_state()

	var mode: String = str(state.get("mode", get_meta("rick_weapon_shop_mode", "outside"))).strip_edges().to_lower()
	if mode == "":
		mode = "outside"

	var outside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside", {}))
	var outside_people: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside_people", {}))
	var inside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("inside", {}))

	if outside.is_empty():
		outside = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside", {}))
	if outside_people.is_empty():
		outside_people = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside_people", {}))
	if inside.is_empty():
		inside = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("inside", {}))

	var pending_inside_from_street: int = int(outside.get("pending_people_inside", 0))
	var walking_by_count: int = max(1, MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.72, 5))
	var walking_in_count: int = 0
	var walking_out_count: int = 0

	outside_people ["walking_by"] = _rick_weapon_shop_make_people_group(walking_by_count, "walking_by", "walking past Rick's shop")
	outside_people ["walking_in"] = []
	outside_people ["walking_out"] = []

	var browsers: Array = MainSceneHelpers._safe_array(inside.get("browsers", []))
	var checking_out_person: Dictionary = MainSceneHelpers._safe_dictionary(inside.get("checking_out_person", {}))

	if mode == "inside":
		if rng.randf() < 0.36 and browsers.size() < 5:
			var entering_group: int = MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.42, 2)
			if entering_group > 0:
				walking_in_count = entering_group
				var entering_people: Array = _rick_weapon_shop_make_people_group(entering_group, "walking_in", "entering Rick's shop")
				outside_people ["walking_in"] = entering_people
				pending_inside_from_street += entering_group

				for raw_person in entering_people:
					if typeof(raw_person) != TYPE_DICTIONARY:
						continue

					var person: Dictionary = (raw_person as Dictionary).duplicate(true)
					person ["zone_id"] = "browsing"
					person ["activity"] = "eyeballing the weapon wall"
					person ["eyeballing"] = _rick_weapon_shop_random_inventory_name()
					browsers.append(person)

		if not checking_out_person.is_empty() and rng.randf() < 0.5:
			walking_out_count = 1
			var leaving_person: Dictionary = checking_out_person.duplicate(true)
			leaving_person ["zone_id"] = "walking_out"
			leaving_person ["activity"] = "leaving after checking out with Rick"
			outside_people ["walking_out"] = [leaving_person]
			checking_out_person = {}
			pending_inside_from_street = max(0, pending_inside_from_street - 1)
			inside ["last_live_line"] = MainSceneHelpers._rick_weapon_shop_random_checkout_line()
		elif checking_out_person.is_empty() and rng.randf() < 0.32:
			checking_out_person = _rick_weapon_shop_make_person("checkout", "checking out with Rick")
			inside ["last_live_line"] = "A customer steps up to Rick's counter.\nRick: \"Quick question. Are we buying this for protection or a future apology?\""

		if browsers.size() > 0 and rng.randf() < 0.26:
			var leaving_browsers: int = min(browsers.size(), MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.55, 2))
			if leaving_browsers > 0:
				var leaving_people: Array = []
				for i in range(leaving_browsers):
					var leaving: Dictionary = MainSceneHelpers._safe_dictionary(browsers.pop_front())
					leaving ["zone_id"] = "walking_out"
					leaving ["activity"] = "leaving Rick's shop without buying anything"
					leaving_people.append(leaving)

				walking_out_count = max(walking_out_count, leaving_people.size())
				outside_people ["walking_out"] = leaving_people
				pending_inside_from_street = max(0, pending_inside_from_street - leaving_people.size())

		if browsers.size() > 5:
			browsers = browsers.slice(0, 5)
	else:
		walking_in_count = MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.28, 2)
		if walking_in_count > 0:
			outside_people ["walking_in"] = _rick_weapon_shop_make_people_group(walking_in_count, "walking_in", "entering Rick's shop")
			pending_inside_from_street += walking_in_count

		if pending_inside_from_street > 0:
			walking_out_count = MainSceneHelpers._rick_weapon_shop_live_flow_count(rng, 0.22, min(2, pending_inside_from_street))
			if walking_out_count > 0:
				outside_people ["walking_out"] = _rick_weapon_shop_make_people_group(walking_out_count, "walking_out", "leaving Rick's shop")
				pending_inside_from_street = max(0, pending_inside_from_street - walking_out_count)

	outside ["people_walking_by"] = walking_by_count
	outside ["people_walking_in"] = walking_in_count
	outside ["people_walking_out"] = walking_out_count
	outside ["pending_people_inside"] = pending_inside_from_street

	inside ["browsers"] = browsers
	inside ["checking_out_person"] = checking_out_person
	inside ["people_browsing"] = browsers.size()
	inside ["person_checking_out"] = 1 if not checking_out_person.is_empty() else 0

	state ["mode"] = mode
	state ["outside"] = outside
	state ["outside_people"] = outside_people
	state ["inside"] = inside

	rick_weapon_shop_active_contract ["shop_runtime_state"] = state
	set_meta("rick_weapon_shop_live_next_tick_ms", now_ms + MainSceneHelpers._rick_weapon_shop_random_jitter_ms(1100, 3800))
	set_meta("rick_weapon_shop_live_tick_patched_visuals_only", true)
	set_meta("rick_weapon_shop_live_tick_no_full_popup_rebuild", true)
	set_meta("rick_weapon_shop_live_tick_at_ms", now_ms)

	_prime_rick_weapon_shop_live_state_for_visible_street("rick_weapon_shop_live_tick_prime")
	_rick_weapon_shop_apply_live_state_visual_patch("rick_weapon_shop_live_tick")

	if get_node_or_null("RickWeaponShopPeopleTrackerDim") != null:
		call_deferred("_populate_rick_weapon_shop_people_tracker_popup")

	call_deferred("_rick_weapon_shop_try_auto_checkout")
func _rick_weapon_shop_counter_badge(label_text: String, value: int, tracker_key: String = "", show_value: bool = true) -> PanelContainer:
	var badge:= PanelContainer.new()
	badge.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	badge.mouse_filter = Control.MOUSE_FILTER_STOP
	badge.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	if tracker_key != "":
		badge.name = "RickWeaponShopCounter_%s" % tracker_key
		badge.set_meta("rick_weapon_shop_counter_tracker_key", tracker_key)
		badge.set_meta("rick_weapon_shop_counter_label_text", label_text)
		badge.set_meta("rick_weapon_shop_counter_show_value", show_value)
		badge.gui_input.connect(Callable(self, "_on_rick_weapon_shop_counter_badge_gui_input").bind(tracker_key))

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.18, 0.12, 0.075, 0.96)
	style.border_color = Color(1.0, 0.64, 0.24, 0.55)
	style.set_border_width_all(1)
	style.set_corner_radius_all(16)
	badge.add_theme_stylebox_override("panel", style)

	var margin:= MarginContainer.new()
	margin.name = "Margin"
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_bottom", 10)
	badge.add_child(margin)

	var label:= Label.new()
	label.name = "ValueLabel"
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.text = MainSceneLogic._rick_weapon_shop_population_badge_text(label_text, value, show_value)
	label.add_theme_font_size_override("font_size", 14)
	label.add_theme_color_override("font_color", Color(1.0, 0.88, 0.62, 1.0))
	margin.add_child(label)

	return badge
func _rick_weapon_shop_patch_counter_badge(tracker_key: String, label_text: String, value: int, show_value: bool = true) -> void:
	if rick_weapon_shop_popup == null or not is_instance_valid(rick_weapon_shop_popup):
		return

	var clean_key: String = str(tracker_key).strip_edges()
	if clean_key == "":
		return

	var badge_node:= rick_weapon_shop_popup.find_child("RickWeaponShopCounter_%s" % clean_key, true, false)
	if badge_node == null:
		return

	if badge_node is Control:
		var badge_control:= badge_node as Control
		badge_control.mouse_filter = Control.MOUSE_FILTER_STOP
		badge_control.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	var label:= badge_node.find_child("ValueLabel", true, false) as Label
	if label == null or not is_instance_valid(label):
		return

	label.text = MainSceneLogic._rick_weapon_shop_population_badge_text(label_text, value, show_value)


func _rick_weapon_shop_apply_live_state_visual_patch(reason: String = "rick_weapon_shop_live_patch") -> void:
	if not rick_weapon_shop_popup_open:
		return
	if rick_weapon_shop_popup == null or not is_instance_valid(rick_weapon_shop_popup):
		return
	if not rick_weapon_shop_popup.visible:
		return
	if rick_weapon_shop_active_contract.is_empty():
		return

	var state: Dictionary = MainSceneHelpers._safe_dictionary(rick_weapon_shop_active_contract.get("shop_runtime_state", {}))
	if state.is_empty():
		return

	var outside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside", {}))
	var inside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("inside", {}))

	var walking_by_count: int = int(outside.get("people_walking_by", 0))
	var walking_in_count: int = int(outside.get("people_walking_in", 0))
	var walking_out_count: int = int(outside.get("people_walking_out", 0))

	var browsing_count: int = MainSceneHelpers._safe_array(inside.get("browsers", [])).size()
	var checking_out_count: int = 1 if not MainSceneHelpers._safe_dictionary(inside.get("checking_out_person", {})).is_empty() else 0
	var inside_count: int = browsing_count + checking_out_count

	_rick_weapon_shop_patch_counter_badge("walking_by", "People walking by", walking_by_count)
	_rick_weapon_shop_patch_counter_badge("walking_in", "People walking in", walking_in_count)
	_rick_weapon_shop_patch_counter_badge("walking_out", "People walking out", walking_out_count)
	_rick_weapon_shop_patch_counter_badge("inside_all", "People in the store", inside_count)
	_rick_weapon_shop_patch_counter_badge("browsing", "People browsing", browsing_count)
	_rick_weapon_shop_patch_counter_badge("checking_out", "Person checking out", checking_out_count)

	var inside_live_text:= rick_weapon_shop_popup.find_child("RickWeaponShopInsideLiveText", true, false) as Label
	if inside_live_text != null and is_instance_valid(inside_live_text):
		inside_live_text.text = MainSceneLogic._rick_weapon_shop_inside_live_text(rick_weapon_shop_active_contract, state)

	set_meta("rick_weapon_shop_live_visual_patch_applied", true)
	set_meta("rick_weapon_shop_live_visual_patch_reason", reason)
	set_meta("rick_weapon_shop_live_visual_patch_at_ms", int(Time.get_ticks_msec()))


func _rick_weapon_shop_request_popup_repaint(reason: String = "rick_weapon_shop_repaint") -> void:
	if bool(get_meta("rick_weapon_shop_popup_repaint_pending", false)):
		return

	set_meta("rick_weapon_shop_popup_repaint_pending", true)
	set_meta("rick_weapon_shop_popup_repaint_reason", reason)
	set_meta("rick_weapon_shop_popup_repaint_requested_at_ms", int(Time.get_ticks_msec()))

	call_deferred("_rick_weapon_shop_repaint_popup_if_open", reason)


func _rick_weapon_shop_repaint_popup_if_open(reason: String = "rick_weapon_shop_repaint") -> void:
	set_meta("rick_weapon_shop_popup_repaint_pending", false)

	if not rick_weapon_shop_popup_open:
		return
	if rick_weapon_shop_active_contract.is_empty():
		return

	set_meta("rick_weapon_shop_popup_repaint_visual_tail", true)
	set_meta("rick_weapon_shop_popup_repaint_reason", reason)
	set_meta("rick_weapon_shop_popup_repaint_at_ms", int(Time.get_ticks_msec()))

	_populate_rick_weapon_shop_popup(rick_weapon_shop_active_contract)
	_rick_weapon_shop_apply_live_state_visual_patch("%s_after_repaint" % reason)
func _on_rick_weapon_shop_counter_badge_gui_input(event: InputEvent, tracker_key: String) -> void:
