func _school_hub_maybe_queue_meal_approach_scenario() -> void:
	if gs == null or gs.player == null or gs.school_engine == null or gs.scenario_engine == null:
		return
	if str(institution_hub_kind).strip_edges().to_lower() != "school":
		return
	if str(institution_hub_current_section).strip_edges().to_lower() != "meal":
		return
	if typeof(gs.scenario_state) == TYPE_DICTIONARY and str(gs.scenario_state.get("pending_type", "")).strip_edges() != "":
		return
	if not gs.school_engine.has_method("consume_school_meal_approach_scenario"):
		return

	var scenario: Dictionary = gs.school_engine.consume_school_meal_approach_scenario(gs.player)
	if scenario.is_empty():
		return
	if not gs.scenario_engine.has_method("queue_external_scenario"):
		return

	var queue_result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
	_refresh_scenario_ui_from_result(queue_result)
	_school_hub_arm_meal_approach_timeout(scenario)
func _school_hub_arm_meal_approach_timeout(scenario: Dictionary) -> void:
	var scenario_id: String = str(scenario.get("id", "")).strip_edges()
	var timeout_seconds: float = float(scenario.get("auto_timeout_seconds", 14.0))
	var timeout_label: String = str(scenario.get("auto_timeout_label", "Ignore them")).strip_edges()

	if timeout_label == "":
		timeout_label = "Ignore them"

	if scenario_id == "" or timeout_seconds <= 0.0:
		return

	var timer:= get_node_or_null("SchoolMealApproachTimeoutTimer") as Timer
	if timer == null:
		timer = Timer.new()
		timer.name = "SchoolMealApproachTimeoutTimer"
		timer.one_shot = true
		timer.process_callback = Timer.TIMER_PROCESS_IDLE
		add_child(timer)

	var timeout_callable:= Callable(self, "_on_school_meal_approach_timeout_timer_timeout")
	if not timer.timeout.is_connected(timeout_callable):
		timer.timeout.connect(timeout_callable)

	timer.stop()
	timer.wait_time = clamp(timeout_seconds, 0.1, 30.0)
	timer.set_meta("scenario_id", scenario_id)
	timer.set_meta("timeout_label", timeout_label)
	timer.start()

func _on_school_meal_approach_timeout_timer_timeout() -> void:
	var timer:= get_node_or_null("SchoolMealApproachTimeoutTimer") as Timer
	if timer == null:
		return

	var scenario_id: String = str(timer.get_meta("scenario_id", "")).strip_edges()
	var timeout_label: String = str(timer.get_meta("timeout_label", "")).strip_edges()

	if scenario_id == "" or timeout_label == "":
		return
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return
	if str(gs.scenario_state.get("pending_type", "")).strip_edges() == "":
		return

	var bundle_raw: Variant = gs.scenario_state.get("current_bundle", [])
	if typeof(bundle_raw) != TYPE_ARRAY:
		return

	var bundle: Array = bundle_raw as Array
	var index: int = int(gs.scenario_state.get("current_bundle_index", 0))
	if index < 0 or index >= bundle.size():
		return

	var active_scenario: Dictionary = MainSceneHelpers._safe_dictionary(bundle [index])
	if str(active_scenario.get("id", "")).strip_edges() != scenario_id:
		return

	_on_scenario_action_pressed(timeout_label)
