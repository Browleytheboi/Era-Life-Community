		border = border.lerp(Color(1.0, 0.92, 0.7, border.a), 0.26)
		border_hover = border_hover.lerp(Color(1.0, 0.97, 0.84, border_hover.a), 0.34)
		status = status.lerp(Color(1.0, 0.94, 0.72, 1.0), 0.32)
		preview = preview.lerp(Color(1.0, 0.95, 0.82, 1.0), 0.24)

	return {
		"panel_base": panel_base,
		"panel_hover": panel_hover,
		"border": border,
		"border_hover": border_hover,
		"shadow": shadow,
		"shadow_hover": shadow_hover,
		"panel_modulate_idle": panel_modulate_idle,
		"panel_modulate_hover": panel_modulate_hover,
		"dim": dim,
		"title": title,
		"subtitle": subtitle,
		"body": body,
		"status": status,
		"preview": preview,
		"accent": accent,
		"accent_soft": accent_soft,
		"panel_corner_radius": panel_corner_radius,
		"panel_margin": panel_margin,
		"panel_shadow_size_idle": panel_shadow_size_idle,
		"panel_shadow_size_hover": panel_shadow_size_hover,
		"panel_shadow_y_idle": panel_shadow_y_idle,
		"panel_shadow_y_hover": panel_shadow_y_hover,
		"panel_hover_scale": panel_hover_scale,
		"panel_reveal_start_scale": panel_reveal_start_scale,
		"panel_reveal_overshoot": panel_reveal_overshoot,
		"panel_parallax_amount": panel_parallax_amount,
		"content_parallax_amount": content_parallax_amount,
		"background_parallax_amount": background_parallax_amount,
		"background_drift_speed": background_drift_speed,
		"background_drift_amplitude": background_drift_amplitude,
		"pointer_follow": pointer_follow,
		"surface_rotation": surface_rotation,
		"rim_alpha": rim_alpha,
		"rim_hover_alpha": rim_hover_alpha,
		"surface_light_alpha": surface_light_alpha,
		"surface_light_hover_alpha": surface_light_hover_alpha,
		"field_radius": field_radius,
		"field_lift": field_lift,
		"slider_energy": slider_energy,
		"slider_track_shadow": Color(shadow_hover.r, shadow_hover.g, shadow_hover.b, 0.24),
		"field_base": Color(panel_base.r * 0.72, panel_base.g * 0.72, panel_base.b * 0.72, 0.9),
		"field_hover": Color(panel_hover.r * 0.78, panel_hover.g * 0.78, panel_hover.b * 0.78, 0.94),
		"field_focus": Color(accent_soft.r, accent_soft.g, accent_soft.b, 0.96),
		"field_border": Color(border.r, border.g, border.b, 0.4),
		"field_border_hover": Color(border_hover.r, border_hover.g, border_hover.b, 0.64),
		"field_border_focus": Color(accent.r, accent.g, accent.b, 0.86),
		"field_shadow": Color(shadow.r, shadow.g, shadow.b, 0.14),
		"field_shadow_hover": Color(shadow_hover.r, shadow_hover.g, shadow_hover.b, 0.22),
		"field_shadow_focus": Color(accent.r, accent.g, accent.b, 0.2)
	}

func _ensure_god_mode_presentation_surface() -> void:
	if god_mode_start_panel != null:
		var surface_root:= god_mode_start_panel.get_node_or_null("GodModePresentationSurface") as Control
		if surface_root != null:
			surface_root.visible = false
			surface_root.queue_free()

	if god_mode_background_dim != null:
		var background_surface:= god_mode_background_dim.get_node_or_null("GodModeBackgroundSurface") as ColorRect
		if background_surface != null:
			background_surface.visible = false
			background_surface.queue_free()

func _apply_god_mode_presentation_surface_styles() -> void:
	if god_mode_start_panel != null:
		var surface_root:= god_mode_start_panel.get_node_or_null("GodModePresentationSurface") as Control
		if surface_root != null:
			surface_root.visible = false
			surface_root.queue_free()

	if god_mode_background_dim != null:
		var background_surface:= god_mode_background_dim.get_node_or_null("GodModeBackgroundSurface") as ColorRect
		if background_surface != null:
			background_surface.visible = false
			background_surface.queue_free()

func _register_god_mode_presentation_tree(root: Control) -> void:
	god_mode_presentation_controls.clear()
	if root == null:
		return
	_register_god_mode_presentation_branch(root)

func _register_god_mode_presentation_branch(node: Control) -> void:
	if node == null:
		return
	_register_god_mode_presentation_control(node)
	for child in node.get_children():
		if child is Control:
			_register_god_mode_presentation_branch(child)

func _register_god_mode_presentation_control(control: Control) -> void:
	if control == null:
		return
	if not MainSceneHelpers._is_god_mode_presentation_control(control):
		return
	if not god_mode_presentation_controls.has(control):
		god_mode_presentation_controls.append(control)
	if not bool(control.get_meta("god_mode_presenter_connected", false)):
		control.set_meta("god_mode_presenter_connected", true)
		control.set_meta("god_mode_presenter_hovered", false)
		control.mouse_entered.connect(_on_god_mode_presenter_control_mouse_entered.bind(control))
		control.mouse_exited.connect(_on_god_mode_presenter_control_mouse_exited.bind(control))
		control.focus_entered.connect(_on_god_mode_presenter_control_focus_entered.bind(control))
		control.focus_exited.connect(_on_god_mode_presenter_control_focus_exited.bind(control))
	if control is SpinBox:
		var line_edit:= (control as SpinBox).get_line_edit()
		if line_edit != null and not god_mode_presentation_controls.has(line_edit):
			_register_god_mode_presentation_control(line_edit)
	_apply_god_mode_presentation_control_state(control, MainSceneHelpers._god_mode_presenter_state_for(control), false)

func _build_god_mode_presenter_field_style(state: String) -> StyleBoxFlat:
	var profile:= god_mode_presentation_profile
	if profile.is_empty():
		profile = _build_god_mode_presentation_profile()

	var bg: Color = Color(profile.get("field_base", Color(0.09, 0.05, 0.15, 0.92)))
	var border: Color = Color(profile.get("field_border", Color(0.63, 0.46, 0.92, 0.34)))
	var shadow: Color = Color(profile.get("field_shadow", Color(0.3, 0.12, 0.52, 0.12)))

	match state:
		"hover":
			bg = Color(profile.get("field_hover", bg.lightened(0.05)))
			border = Color(profile.get("field_border_hover", border.lightened(0.18)))
			shadow = Color(profile.get("field_shadow_hover", shadow))
		"focus":
			bg = Color(profile.get("field_focus", bg.lightened(0.08)))
			border = Color(profile.get("field_border_focus", border.lightened(0.24)))
			shadow = Color(profile.get("field_shadow_focus", shadow))
		"pressed":
			bg = Color(profile.get("field_focus", bg.lightened(0.12))).darkened(0.04)
			border = Color(profile.get("field_border_focus", border.lightened(0.28)))
			shadow = Color(profile.get("field_shadow_focus", shadow))
		_:
			pass

	var radius:= int(profile.get("field_radius", 14))
	var style:= StyleBoxFlat.new()
	style.bg_color = bg
	style.border_width_left = 1
	style.border_width_top = 2
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.border_color = border
	style.corner_radius_top_left = radius
	style.corner_radius_top_right = radius
	style.corner_radius_bottom_right = radius
	style.corner_radius_bottom_left = radius
	style.content_margin_left = 12
	style.content_margin_top = 10
	style.content_margin_right = 12
	style.content_margin_bottom = 10
	style.shadow_color = shadow
	style.shadow_size = 10 if state in ["hover", "focus", "pressed"] else 8
	style.shadow_offset = Vector2(0, float(profile.get("field_lift", 2.0)) if state in ["hover", "focus", "pressed"] else 1.0)
	return style

func _tween_god_mode_presenter_control(control: Control,
target_scale: Vector2, target_modulate: Color) -> void:
	if control == null or not is_instance_valid(control):
		return
	var tween: Tween = null
	if control.has_meta("god_mode_presenter_tween"):
		var existing_tween = control.get_meta("god_mode_presenter_tween")
		if existing_tween is Tween:
			tween = existing_tween
	if tween != null:
		tween.kill()
	tween = create_tween().bind_node(control)
	control.set_meta("god_mode_presenter_tween", tween)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(control, "scale", target_scale, 0.12)
	tween.parallel().tween_property(control, "self_modulate", target_modulate, 0.12)

func _apply_god_mode_presentation_control_state(control: Control, state: String, animated: bool = true) -> void:
	if control == null:
		return

	var profile:= god_mode_presentation_profile
	if profile.is_empty():
		profile = _build_god_mode_presentation_profile()

	var body: Color = Color(profile.get("body", Color(0.98, 0.95, 1.0, 0.86)))
	var accent: Color = Color(profile.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
	var target_scale:= Vector2.ONE
	var target_modulate:= Color(0.99, 0.99, 1.0, 1.0)

	match state:
		"hover":
			target_scale = Vector2.ONE * 1.014
			target_modulate = Color(1.0, 1.0, 1.0, 1.0)
		"focus":
			target_scale = Vector2.ONE * 1.018
			target_modulate = Color(1.0, 1.0, 1.0, 1.0)
		"pressed":
			target_scale = Vector2.ONE * 0.995
			target_modulate = Color(1.0, 1.0, 1.0, 1.0)
		_:
			pass

	if control is Button:
		var button:= control as Button
		_style_god_mode_button(button, button == god_mode_start_button)
		if button == god_mode_start_button and state in ["hover", "focus"]:
			target_scale *= 1.008
	elif control is OptionButton:
		var option:= control as OptionButton
		_style_god_mode_option_button(option)
		option.add_theme_stylebox_override("normal", _build_god_mode_presenter_field_style("idle"))
		option.add_theme_stylebox_override("hover", _build_god_mode_presenter_field_style("hover"))
		option.add_theme_stylebox_override("pressed", _build_god_mode_presenter_field_style("pressed"))
		option.add_theme_stylebox_override("focus", _build_god_mode_presenter_field_style("focus"))
		option.add_theme_color_override("font_color", body)
		option.add_theme_color_override("font_focus_color", Color(1.0, 1.0, 1.0, 1.0))
	elif control is LineEdit:
		var line_edit:= control as LineEdit
		line_edit.add_theme_font_size_override("font_size", 16)
		line_edit.add_theme_color_override("font_color", body)
		line_edit.add_theme_color_override("caret_color", accent)
		line_edit.add_theme_color_override("font_placeholder_color", Color(body.r, body.g, body.b, 0.52))
		line_edit.add_theme_stylebox_override("normal", _build_god_mode_presenter_field_style("idle"))
		line_edit.add_theme_stylebox_override("focus", _build_god_mode_presenter_field_style("focus"))
		line_edit.add_theme_stylebox_override("read_only", _build_god_mode_presenter_field_style("idle"))
	elif control is SpinBox:
		var spin:= control as SpinBox
		spin.add_theme_stylebox_override("normal", _build_god_mode_presenter_field_style("idle"))
		spin.add_theme_stylebox_override("hover", _build_god_mode_presenter_field_style("hover"))
		spin.add_theme_stylebox_override("pressed", _build_god_mode_presenter_field_style("pressed"))
		spin.add_theme_stylebox_override("focus", _build_god_mode_presenter_field_style("focus"))
		spin.add_theme_color_override("font_color", body)
		var spin_line_edit:= spin.get_line_edit()
		if spin_line_edit != null:
			spin_line_edit.add_theme_stylebox_override("normal", _build_god_mode_presenter_field_style("idle"))
			spin_line_edit.add_theme_stylebox_override("focus", _build_god_mode_presenter_field_style("focus"))
			spin_line_edit.add_theme_color_override("font_color", body)
			spin_line_edit.add_theme_color_override("caret_color", accent)
	elif control is CheckBox:
		var toggle:= control as CheckBox
		toggle.custom_minimum_size = Vector2(0, 38)
		toggle.add_theme_font_size_override("font_size", 16)
		toggle.add_theme_color_override("font_color", body)
		toggle.add_theme_color_override("font_focus_color", Color(1.0, 1.0, 1.0, 1.0))
		toggle.add_theme_stylebox_override("normal", _build_god_mode_presenter_field_style("idle"))
		toggle.add_theme_stylebox_override("hover", _build_god_mode_presenter_field_style("hover"))
		toggle.add_theme_stylebox_override("pressed", _build_god_mode_presenter_field_style("pressed"))
		toggle.add_theme_stylebox_override("focus", _build_god_mode_presenter_field_style("focus"))

	if animated:
		_tween_god_mode_presenter_control(control, target_scale, target_modulate)
	else:
		control.scale = target_scale
		control.self_modulate = target_modulate

func _apply_god_mode_presenter_tree_styles(animated: bool = true) -> void:
	for raw_control in god_mode_presentation_controls:
		var control: Control = raw_control
		if control == null or not is_instance_valid(control):
			continue
		_apply_god_mode_presentation_control_state(control, MainSceneHelpers._god_mode_presenter_state_for(control), animated)

func _on_god_mode_presenter_control_mouse_entered(control: Control) -> void:
	if control == null:
