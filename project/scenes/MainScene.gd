func _show_boxing_gym_hub_panel(tab_id: String = "common") -> void:
	if gs == null or gs.player == null:
		return
	if gs.boxing_gym_engine == null or not gs.boxing_gym_engine.has_method("build_gym_hub_payload"):
		return

	boxing_gym_hub_selected_tab = str(tab_id).strip_edges()
	if boxing_gym_hub_selected_tab == "":
		boxing_gym_hub_selected_tab = "common"

	var payload: Dictionary = gs.boxing_gym_engine.build_gym_hub_payload(gs.player, boxing_gym_hub_selected_tab)
	var visual_contract: Dictionary = MainSceneLogic._boxing_hub_visual_contract(gs)

	if boxing_gym_hub_popup == null or not is_instance_valid(boxing_gym_hub_popup):
		boxing_gym_hub_popup = PopupPanel.new()
		boxing_gym_hub_popup.name = "BoxingGymHubPopup"
		boxing_gym_hub_popup.exclusive = false
		boxing_gym_hub_popup.borderless = true
		boxing_gym_hub_popup.unresizable = true
		add_child(boxing_gym_hub_popup)
	else:
		boxing_gym_hub_popup.exclusive = false
		boxing_gym_hub_popup.borderless = true
		boxing_gym_hub_popup.unresizable = true

	for child in boxing_gym_hub_popup.get_children():
		child.queue_free()

	boxing_gym_hub_popup.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_popup_style(visual_contract))

	var popup_size: Vector2i = _boxing_hub_desktop_fullscreen_size()
	var gym_size:= Vector2i(int(float(popup_size.x) * 0.86), int(float(popup_size.y) * 0.84))
	boxing_gym_hub_popup.size = gym_size
	boxing_gym_hub_popup.position = Vector2i(
		int((popup_size.x - gym_size.x) / 2.0),
		int((popup_size.y - gym_size.y) / 2.0)
	)

	var root:= MarginContainer.new()
	root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.add_theme_constant_override("margin_left", 10)
	root.add_theme_constant_override("margin_top", 10)
	root.add_theme_constant_override("margin_right", 10)
	root.add_theme_constant_override("margin_bottom", 10)
	boxing_gym_hub_popup.add_child(root)

	var frame:= PanelContainer.new()
	frame.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	frame.size_flags_vertical = Control.SIZE_EXPAND_FILL
	frame.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_shell_style(visual_contract))
	root.add_child(frame)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_bottom", 12)
	frame.add_child(margin)

	var shell:= VBoxContainer.new()
	shell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	shell.size_flags_vertical = Control.SIZE_EXPAND_FILL
	shell.add_theme_constant_override("separation", 8)
	margin.add_child(shell)

	var header:= HBoxContainer.new()
	header.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_theme_constant_override("separation", 10)
	shell.add_child(header)

	var title_stack:= VBoxContainer.new()
	title_stack.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(title_stack)

	var title:= Label.new()
	title.text = "🏋️ GYM HUB"
	title.add_theme_font_size_override("font_size", 25)
	title.add_theme_color_override("font_color", Color(1.0, 0.88, 0.58, 1.0))
	title_stack.add_child(title)

	var subtitle:= Label.new()
	subtitle.text = str(payload.get("gym_name", "No gym"))
	subtitle.add_theme_font_size_override("font_size", 13)
	subtitle.add_theme_color_override("font_color", visual_contract.get("muted_text", Color(0.86, 0.9, 1.0, 0.84)))
	title_stack.add_child(subtitle)

	var close_btn:= Button.new()
	close_btn.text = "X"
	close_btn.custom_minimum_size = Vector2(46, 46)
	close_btn.focus_mode = Control.FOCUS_NONE
	close_btn.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_close_button_style(visual_contract, "normal"))
	close_btn.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_close_button_style(visual_contract, "hover"))
	close_btn.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_close_button_style(visual_contract, "pressed"))
	close_btn.add_theme_color_override("font_color", Color(1.0, 0.95, 0.82, 1.0))
	close_btn.pressed.connect(func ():
		boxing_gym_hub_open = false
		if boxing_gym_hub_popup != null and is_instance_valid(boxing_gym_hub_popup):
			boxing_gym_hub_popup.hide()
		_sync_runtime_floating_hud_layering()
	)
	header.add_child(close_btn)

	var sections: Array = payload.get("sections", []) if typeof(payload.get("sections", [])) == TYPE_ARRAY else []
	var tab_grid:= GridContainer.new()
	tab_grid.columns = max(1, sections.size())
	tab_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tab_grid.add_theme_constant_override("h_separation", 8)
	shell.add_child(tab_grid)

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue

		var section: Dictionary = raw_section
		var section_id: String = str(section.get("id", "")).strip_edges()
		if section_id == "":
			continue

		var selected: bool = section_id == boxing_gym_hub_selected_tab
		var btn:= Button.new()
		btn.text = "%s %s" % [str(section.get("emoji", "")), str(section.get("title", section_id.capitalize()))]
		btn.custom_minimum_size = Vector2(130, 38)
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.focus_mode = Control.FOCUS_NONE
		btn.add_theme_stylebox_override("normal", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "selected" if selected else "normal"))
		btn.add_theme_stylebox_override("hover", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "selected_hover" if selected else "hover"))
		btn.add_theme_stylebox_override("pressed", MainSceneHelpers._boxing_hub_tab_button_style(visual_contract, "pressed"))
		btn.add_theme_color_override("font_color", Color(1.0, 0.94, 0.8, 1.0))
		btn.pressed.connect(func ():
			_show_boxing_gym_hub_panel(section_id)
		)
		tab_grid.add_child(btn)

	var scroll:= ScrollContainer.new()
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	shell.add_child(scroll)

	var content:= VBoxContainer.new()
	content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	content.add_theme_constant_override("separation", 8)
	scroll.add_child(content)

	for raw_section in sections:
		if typeof(raw_section) != TYPE_DICTIONARY:
			continue

		var section: Dictionary = raw_section
		if str(section.get("id", "")) != boxing_gym_hub_selected_tab:
			continue

		_render_boxing_hub_section(content, section)
		break

	boxing_gym_hub_open = true
	boxing_gym_hub_popup.popup()
	_bring_modal_to_front(boxing_gym_hub_popup)
	_sync_runtime_floating_hud_layering()
