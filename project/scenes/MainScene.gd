func _apply_relationship_profile_switch_visible_lens_from_packet_now(
	target: Person,
	viewer_packet: Dictionary,
	result: Dictionary,
	source: String = (
		"relationship_profile_switch_visible_packet"
	)
) -> bool:
	if (
		gs == null
		or target == null
	):
		return false

	if (
		typeof(
			viewer_packet
		) != TYPE_DICTIONARY
		or viewer_packet.is_empty()
	):
		return false

	var target_id: int = int(
		target.id
	)

	if target_id <= 0:
		return false

	var packet: Dictionary = (
		viewer_packet.duplicate(false)
	)
	var surface_contract: Dictionary = (
		_zero_frame_contract_dictionary(
			packet.get(
				"surface_contract",
				{}
			)
		)
	)

	if surface_contract.is_empty():
		return false

	if int(
		surface_contract.get(
			"actor_id",
			-1
		)
	) != target_id:
		return false

	var clean_text: String = str(
		result.get(
			"text",
			(
				"I started living as %s."
				% MainSceneHelpers._person_display_name_for_identity_switch(
					target
				)
			)
		)
	).strip_edges()

	if clean_text == "":
		clean_text = (
			"I started living as %s."
			% MainSceneHelpers._person_display_name_for_identity_switch(
				target
			)
		)




	var render_policy: Dictionary = (
		_zero_frame_contract_dictionary(
			packet.get(
				"render_policy",
				{}
			)
		)
	)
	render_policy [
		"tail_apply_forbidden"
	] = true
	render_policy [
		"relationship_profile_switch_tail_apply_forbidden"
	] = true
	render_policy [
		"switch_packet_fully_consumed_before_modal_close"
