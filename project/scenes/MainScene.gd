				0
			)
		) + 1
		set_meta(
			"career_hub_projection_sequence",
			projection_sequence
		)

		resolved_payload [
			"projection_request_id"
		] = "%d:%d:%d:%s:%s" % [
			int(
				actor.id
			),
			projection_sequence,
			int(
				Time.get_ticks_msec()
			),
			action_id,
			str(
				resolved_payload.get(
					"section_id",
					"overview"
				)
			)
		]

	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": int(
					actor.id
				),
				"target_id": int(
					actor.id
				),
				"intent_type": (
					"career_hub_contract_intent"
				),
				"surface_id": (
					"career_hub_panel"
				),
				"action_id": action_id,
				"payload": resolved_payload,
				"target": {
					"route_kind": (
						"engine_method"
					),
					"engine_property": (
						"career_hub_contract_engine"
					),
					"method": "resolve_intent",
					"pass_actor_payload": true,
					"actor_id": int(
						actor.id
					)
				},
				"source": str(
					resolved_payload.get(
						"source",
						""
					)
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": int(
					actor.id
				),
				"target_id": int(
					actor.id
				),
				"surface_id": (
					"career_hub_panel"
				),
				"action_id": action_id,
				"source": str(
					resolved_payload.get(
						"source",
						""
					)
				)
			}
		)
	)
	var route_result: Dictionary = (
		_career_hub_contract_route_result(
			report
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"career_hub_contract",
			{}
		)
	)
	var preserved_existing_hot_contract: bool = false
	_ensure_career_hub_panel()



	if (
		contract.is_empty()
		and career_hub_panel != null
		and is_instance_valid(
			career_hub_panel
		)
	):


		var existing_contract: Dictionary = (
			career_hub_panel.active_contract
		)

		if _career_hub_contract_is_hot(
			existing_contract,
			int(
				actor.id
			)
		):
			contract = existing_contract
			preserved_existing_hot_contract = true



			route_result [
				"career_hub_contract"
			] = existing_contract
			route_result [
				"career_hub_cached_projection_preserved"
			] = true
			route_result [
				"career_hub_cached_projection_reference_reused"
			] = true
			route_result [
				"career_hub_cached_projection_deep_copy_performed"
			] = false
	var contract_hot: bool = (
		_career_hub_contract_is_hot(
			contract,
			int(
				actor.id
			)
		)
	)

	set_meta(
		"native_main_tab_surface_hot_career",
