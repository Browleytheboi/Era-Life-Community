func _suspend_activities_hub_for_child_surface(
	child_surface_key: String
) -> bool:
	var clean_child_key: String = str(
		child_surface_key
	).strip_edges().to_lower()
	var return_to_activities: bool = (
		activities_action_open
		and activities_action_panel != null
		and is_instance_valid(
			activities_action_panel
		)
		and activities_action_panel.visible
	)

	if not return_to_activities:
		return false

	activities_action_panel.visible = false
	activities_action_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	activities_action_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	activities_action_panel.set_meta(
		"activities_hub_suspended_for_child_surface",
		true
	)
	activities_action_panel.set_meta(
		"activities_hub_suspended_child_surface_key",
		clean_child_key
	)
	activities_action_panel.set_meta(
		"activities_hub_suspended_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	activities_action_panel.set_meta(
		"activities_hub_child_surface_build_performed",
		false
	)
	activities_action_panel.set_meta(
		"activities_hub_child_surface_engine_calls",
		false
	)

	set_meta(
		"activities_hub_child_surface_active_key",
		clean_child_key
	)
	set_meta(
		"activities_hub_child_surface_return_available",
		true
	)
	set_meta(
		"activities_hub_child_surface_handoff_visual_only",
		true
	)

	return true
