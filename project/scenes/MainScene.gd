		"minigame_physical_input_build_performed",
		false
	)
	set_meta(
		"minigame_physical_input_actor_id",
		actor_id
	)
	set_meta(
		"minigame_intent_scheduled_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	call_deferred(
		"_commit_mini_game_intent_deferred",
		immutable_intent
	)
func _commit_mini_game_intent_deferred(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var requested_actor_id: int = int(
		payload.get(
			"actor_id",
			-1
		)
	)



	if requested_actor_id != int(
		gs.player.id
	):
		return

	var clean_payload: Dictionary = (
		payload.duplicate(false)
	)

	var action_id: String = str(
		clean_payload.get(
			"action_id",
			"emit_hub"
		)
	).strip_edges().to_lower()

	clean_payload [
		"action_id"
	] = action_id
	clean_payload [
		"actor_id"
	] = requested_actor_id
	clean_payload [
		"intent_type"
	] = "minigame"
	clean_payload [
		"surface_id"
	] = "minigame_panel"
	clean_payload [
		"ui_is_renderer_only"
	] = true





	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": requested_actor_id,
			"intent_type": "minigame",
			"surface_id": "minigame_panel",
			"action_id": action_id,
			"payload": clean_payload.duplicate(false),
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"mini_game_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": requested_actor_id
			},
			"source": str(
				clean_payload.get(
					"source",
					"mainscene.minigame_panel"
				)
			),
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"immutable_contract_references": true,
			"ready_gate_member": false
		},
		{
			"actor_id": requested_actor_id,
			"source": "mainscene.minigame_panel",
			"surface_id": "minigame_panel",
			"action_id": action_id,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"immutable_contract_references": true,
			"ready_gate_member": false,
			"ui_is_renderer_only": true
		}
	)

	var result: Dictionary = _mini_game_route_result(
		report
	)



	if bool(
		result.get(
			"input_ack",
			false
		)
	):
		set_meta(
			"minigame_continuous_input_ack_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"minigame_continuous_input_hub_rebuild",
			false
		)
		return

	var observation_raw: Variant = result.get(
		"session_observation_packet",
		{}
	)

	if typeof(
		observation_raw
	) == TYPE_DICTIONARY:
		var observation_packet: Dictionary = (
			observation_raw as Dictionary
		)

		if not observation_packet.is_empty():
			_on_mini_game_session_observation_ready(
				str(
					observation_packet.get(
						"session_id",
						""
					)
				),
				observation_packet
			)
			return

	var contract_raw: Variant = result.get(
		"mini_game_contract",
		result.get(
			"hub_contract",
			{}
		)
	)

	var contract: Dictionary = (
		contract_raw as Dictionary
		if typeof(contract_raw) == TYPE_DICTIONARY
		else {}
	)

	if contract.is_empty():
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "MiniGame Ecosystem",
			"popup_text": str(
				result.get(
					"text",
					result.get(
						"reason",
						(
							"The committed MiniGame intent did not "
							+ "return an observable surface."
						)
					)
				)
			),
			"popup_footer": (
				"The UI did not launch or mutate gameplay directly."
			)
		})
		return

	_show_mini_game_panel(
		contract
	)

	set_meta(
		"minigame_deferred_commit_actor_id",
		requested_actor_id
	)
	set_meta(
		"minigame_deferred_commit_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"minigame_build_on_input",
		false
	)
func _mini_game_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report
	]
	var inspected: int = 0
	var success_fallback: Dictionary = {}
	var failure_fallback: Dictionary = {}

	while (
		not queue.is_empty()
		and inspected < 128
	):
		var raw_cursor: Variant = queue.pop_front()
		inspected += 1

		if typeof(
			raw_cursor
		) == TYPE_ARRAY:
			for nested_raw in raw_cursor as Array:
				if (
					typeof(nested_raw) == TYPE_DICTIONARY
					or typeof(nested_raw) == TYPE_ARRAY
				):
					queue.append(
						nested_raw
					)
			continue

		if typeof(
			raw_cursor
		) != TYPE_DICTIONARY:
			continue

		var cursor: Dictionary = (
			raw_cursor as Dictionary
		)

		var schema: String = str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges().to_lower()

		if bool(
			cursor.get(
				"input_ack",
				false
			)
		):
			return cursor.duplicate(false)

		if schema == "eralife.minigame_session_observation_packet":
			return {
				"success": true,
				"session_observation_packet": (
					cursor.duplicate(false)
				),
				"ui_is_renderer_only": true
			}

		var wrapped_contract: Dictionary = {}

		if cursor.has(
			"mini_game_contract"
		):
			var wrapped_raw: Variant = cursor.get(
				"mini_game_contract",
				{}
			)
			if typeof(wrapped_raw) == TYPE_DICTIONARY:
				wrapped_contract = (
					wrapped_raw as Dictionary
				)

		if (
			wrapped_contract.is_empty()
			and cursor.has(
				"hub_contract"
			)
		):
			var hub_raw: Variant = cursor.get(
				"hub_contract",
				{}
			)
			if typeof(hub_raw) == TYPE_DICTIONARY:
				wrapped_contract = (
					hub_raw as Dictionary
				)

		if not wrapped_contract.is_empty():
			var wrapped_schema: String = str(
				wrapped_contract.get(
					"schema",
					""
				)
			).strip_edges().to_lower()

			if wrapped_schema in [
				"eralife.minigame_hub_contract",
				"eralife.minigame_surface_packet"
			]:
				return cursor.duplicate(false)

			if bool(
				wrapped_contract.get(
					"authoritative_projection",
					false
				)
			):
				return cursor.duplicate(false)

		if schema in [
			"eralife.minigame_hub_contract",
			"eralife.minigame_surface_packet"
		]:
			var direct_contract: Dictionary = (
				cursor.duplicate(false)
			)

			return {
				"success": bool(
					direct_contract.get(
						"success",
						true
					)
				),
				"mini_game_contract": direct_contract,
				"hub_contract": direct_contract,
				"ui_is_renderer_only": true
			}

		if bool(
			cursor.get(
				"success",
				false
			)
		):
			if success_fallback.is_empty():
				success_fallback = (
					cursor.duplicate(false)
				)
		elif (
			failure_fallback.is_empty()
			and (
				cursor.has(
					"reason"
				)
				or cursor.has(
					"text"
				)
			)
		):
			failure_fallback = (
				cursor.duplicate(false)
			)

		for raw_value in cursor.values():
			if (
				typeof(raw_value) == TYPE_DICTIONARY
				or typeof(raw_value) == TYPE_ARRAY
			):
				queue.append(
					raw_value
				)

	if not failure_fallback.is_empty():
		return failure_fallback

	return success_fallback
func _request_reality_residency_intent(
		action_id: String,
		payload: Dictionary = {},
		source: String = "mainscene.reality_residency"
) -> Dictionary:
	var residency_authority: GameState = (
		reality_residency_host_game_state
	)

	if residency_authority == null:
		residency_authority = gs

	if residency_authority == null:
		return {
			"success": false,
			"reason": (
				"missing_reality_residency_host_game_state"
			)
		}

	var authority_instance_id: int = int(
		residency_authority.get_instance_id()
	)
	var clean_action_id: String = str(
		action_id
	).strip_edges().to_lower()
	var outgoing: Dictionary = payload.duplicate(false)

	outgoing ["action_id"] = clean_action_id
	outgoing ["source"] = source
	outgoing ["ui_is_expression_only"] = true
	outgoing [
		"residency_authority_instance_id"
	] = authority_instance_id
	outgoing [
		"residency_authority_is_persistent_host"
	] = (
		residency_authority
		== reality_residency_host_game_state
	)
	outgoing [
		"residency_intent_never_routes_through_attached_life"
	] = true
	outgoing [
		"global_intent_duplicate_suppression_allowed"
	] = false
	outgoing [
		"skip_crr_observation"
	] = true
	outgoing [
		"skip_global_intent_persistence"
	] = true
	outgoing [
		"ephemeral_infrastructure_intent"
	] = true
	outgoing [
		"residency_manager_owns_service_scheduling"
	] = true
	outgoing [
		"renderer_may_not_advance_runtime"
	] = (
		clean_action_id in [
			"observe",
			"status"
		]
	)

	if clean_action_id == "service":
		outgoing ["max_steps"] = clampi(
			int(
				outgoing.get(
					"max_steps",
					1
				)
			),
			1,
			1
		)
		outgoing ["frame_budget_ms"] = clampi(
			int(
				outgoing.get(
					"frame_budget_ms",
					1
				)
			),
			1,
			2
		)
		outgoing [
			"service_request_id"
		] = (
			"resident_service:%d:%d:%s"
			% [
				authority_instance_id,
				int(
					Engine.get_process_frames()
				),
				str(
					outgoing.get(
						"signature",
						""
					)
				)
			]
		)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": (
				MainSceneLogic._global_intent_current_actor_id(gs)
			),
			"target_id": (
				MainSceneLogic._global_intent_current_actor_id(gs)
			),
			"intent_type": (
				"reality_residency_contract_intent"
			),
			"surface_id": (
				"god_mode_prebirth_surface"
			),
			"action_id": clean_action_id,
			"payload": outgoing,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"reality_residency_contract_engine"
				),
				"method": "resolve_intent",
				"pass_intent_context": true
			},
			"source": source,
			"skip_crr_observation": true,
			"skip_global_intent_persistence": true,
			"ephemeral_infrastructure_intent": true,
			"global_intent_duplicate_suppression_allowed": false,
			"ui_is_expression_only": true
		},
		{
			"surface_id": (
				"god_mode_prebirth_surface"
			),
			"action_id": clean_action_id,
			"source": source,
			"intent_authority_game_state": (
				residency_authority
			),
			"intent_authority_scope": (
				"persistent_reality_residency_host"
			),
			"skip_crr_observation": true,
			"skip_global_intent_persistence": true,
			"ephemeral_infrastructure_intent": true,
			"ui_is_expression_only": true
		}
	)
	var routed_report: Dictionary = (
		MainSceneHelpers._reality_residency_route_result(
			report
		)
	)

	if not bool(
		routed_report.get(
			"success",
			false
		)
	):
		EraLog.truth(
			(
				"ERALIFE_RESIDENCY_INTENT_GATEWAY"
				+ "|action=%s"
				+ "|success=false"
				+ "|reason=%s"
				+ "|authority_instance_id=%d"
				+ "|authority_is_host=%s"
				+ "|global_intent_ready=%s"
				+ "|residency_contract_ready=%s"
			)
			% [
				clean_action_id,
				str(
					routed_report.get(
						"reason",
						"reality_residency_intent_rejected"
					)
				),
				authority_instance_id,
				str(
					residency_authority
					== reality_residency_host_game_state
				),
				str(
					residency_authority
					.global_intent_contract_engine
					!= null
				),
				str(
					residency_authority
					.reality_residency_contract_engine
					!= null
				)
			]
		)

	routed_report [
		"global_intent_hot_path_deep_copy_performed"
	] = false
	routed_report [
		"global_intent_persistence_skipped"
	] = true
	routed_report [
		"global_intent_crr_skipped"
	] = true

	return routed_report
func _begin_reality_residency_background_service() -> void:
	if gs == null:
		return

	var tree:= get_tree()



	if _startup_intro_surface_exclusive_active():
		if tree != null:
			await tree.process_frame

