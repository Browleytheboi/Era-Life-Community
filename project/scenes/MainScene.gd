			tokens ["sound_active_id"] = "ui_nav_modern_active"

	match reality_mode:
		"realistic":
			var realistic_glow: Color = tokens ["glow"]
			realistic_glow.a *= 0.7
			tokens ["glow"] = realistic_glow
			tokens ["glow_size"] = max(2.0, float(tokens ["glow_size"]) - 2.0)
