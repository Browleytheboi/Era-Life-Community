func _enforce_playable_life_surface_authority_now(
		reason: String = "playable_life_surface_authority"
) -> bool:
	if (
		gs == null
		or gs.player == null
	):
		return false

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}







	if _playable_life_surface_player_control_released():
		var observed_at_ms: int = int(
			Time.get_ticks_msec()
		)

		set_meta(
			"playable_life_surface_authority_observed_after_release",
			true
		)
		set_meta(
			"playable_life_surface_authority_observed_after_release_reason",
			reason
		)
		set_meta(
			"playable_life_surface_authority_observed_after_release_at_ms",
			observed_at_ms
		)

		gs.scenario_state [
			"playable_life_surface_authority_observed_after_release"
		] = true
		gs.scenario_state [
			"playable_life_surface_authority_observed_after_release_reason"
		] = reason
		gs.scenario_state [
			"playable_life_surface_authority_observed_after_release_at_ms"
		] = observed_at_ms
		gs.scenario_state [
			"playable_life_surface_authority_reentry_forbidden"
		] = true

		return true

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var last_enforce_ms: int = int(
		get_meta(
			"playable_life_surface_authority_last_enforce_ms",
			0
		)
	)

	if (
		now_ms - last_enforce_ms < 64
		and bool(
			gs.scenario_state.get(
				"playable_life_surface_authority_enforced",
				false
			)
		)
	):
		return true

	set_meta(
		"playable_life_surface_authority_last_enforce_ms",
		now_ms
	)

	_arm_playable_life_surface_authority_lock(
		reason
	)
	_retire_all_prelife_visual_authority_for_playable_life(
		reason
	)

	if (
		current_panel == ""
		or current_panel in [
			"god_mode",
			"main_menu",
			"startup",
			"prelife"
		]
	):
		current_panel = "life"

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if (
		root != null
		and is_instance_valid(
			root
		)
	):
		root.visible = true
		root.mouse_filter = (
			Control.MOUSE_FILTER_PASS
		)

	if (
		output_label != null
		and is_instance_valid(
			output_label
		)
	):
		output_label.visible = (
			current_panel == "life"
		)
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

		if str(
			output_label.text
		).strip_edges() == "":
			_paint_spawn_ready_life_diary_shell_first_frame(
				"%s_force_life_diary" % reason
			)

	_bind_ui_nav_buttons()

	for key in ui_nav_buttons.keys():
		var button: Button = (
			ui_nav_buttons.get(
				key,
				null
			) as Button
		)

		if (
			button == null
			or not is_instance_valid(
				button
			)
		):
			continue

		button.visible = true
		button.disabled = false
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)

	_apply_ui_nav_button_visuals()
	_set_birth_shell_interactive_controls_visible(
		true
	)

	_ensure_player_stats_overlay()

	if (
		player_stats_overlay != null
		and is_instance_valid(
			player_stats_overlay
		)
	):
		player_stats_overlay.visible = true
		player_stats_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_preseal_spawn_ready_runtime_hud_shell_from_snapshot(
		"%s_authority_enforce" % reason
	)
	_reveal_spawn_ready_runtime_hud_buttons_if_existing(
		"%s_authority_enforce" % reason
	)
	_sync_runtime_floating_hud_layering()

	if (
		era_border_overlay == null
		or not is_instance_valid(
			era_border_overlay
		)
		or not era_border_overlay.visible
	):
		_show_era_border_overlay_for_current_era(
			true
		)

	gs.scenario_state [
		"spawn_ready_live_ui_shell_released"
	] = true
	gs.scenario_state [
		"spawn_ready_live_ui_shell_released_at_ms"
	] = now_ms
	gs.scenario_state [
		"spawn_ready_live_ui_shell_reconciled"
	] = true
	gs.scenario_state [
		"birth_shell_player_control_released"
	] = true
	gs.scenario_state [
		"birth_shell_player_control_released_at_ms"
	] = now_ms
	gs.scenario_state [
		"main_gameplay_ui_visible"
	] = true
	gs.scenario_state [
		"main_nav_buttons_visible"
	] = true
	gs.scenario_state [
		"age_up_button_visible"
	] = true
	gs.scenario_state [
		"playable_life_surface_has_visual_authority"
	] = true
	gs.scenario_state [
		"playable_life_surface_authority_enforced"
	] = true
	gs.scenario_state [
		"playable_life_surface_authority_enforced_reason"
	] = reason
	gs.scenario_state [
		"playable_life_surface_authority_enforced_at_ms"
	] = now_ms
