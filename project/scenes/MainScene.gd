func _seed_institution_hub_surface_observable_content(
	kind: String,
	section: String,
	reason: String
) -> void:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_kind == "":
		return

	if clean_section == "":
		clean_section = (
			"family"
				if clean_kind == "relationships"
				else "overview"
		)

	if clean_kind == "relationships":
		clean_section = MainSceneLogic._relationship_hub_resolve_section_id(gs, 
			clean_section
		)

		if clean_section == "":
			clean_section = "family"

	var key: String = _institution_hub_surface_key(
		clean_kind,
		clean_section
	)
	var hydrated: bool = _hydrate_institution_hub_surface(
		clean_kind,
		clean_section,
		"%s_authoritative_surface_prewarm" % reason
	)
	var renderable: bool = (
		hydrated
			and _main_tab_surface_is_renderable(
				clean_kind,
				clean_section
			)
			and _native_main_tab_surface_is_hot(
				clean_kind,
				clean_section
			)
	)

	if not renderable:
		set_meta(
			"institution_surface_prewarm_integrity_failure",
			true
		)
		set_meta(
			"institution_surface_prewarm_integrity_failure_key",
			key
		)
		set_meta(
			"institution_surface_prewarm_integrity_failure_reason",
			reason
		)
		set_meta(
			"institution_surface_prewarm_integrity_failure_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		_schedule_institution_hub_surface_reconciliation(
			clean_kind,
			clean_section,
			"%s_background_reconciliation" % reason
		)
		return

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		institution_hub_surface_deck.get(
			key,
			{}
		)
	)

	if surface.is_empty():
		set_meta(
			"institution_surface_prewarm_integrity_failure",
			true
		)
		set_meta(
			"institution_surface_prewarm_integrity_failure_key",
			key
		)
		set_meta(
			"institution_surface_prewarm_integrity_failure_reason",
			"%s_surface_missing_after_hydration" % reason
		)
		_schedule_institution_hub_surface_reconciliation(
			clean_kind,
			clean_section,
			"%s_missing_surface_reconciliation" % reason
		)
		return

	surface ["truth_state"] = "hot"
	surface ["hydrated"] = true
	surface ["observable_content_seeded"] = true
	surface ["authoritative_content_precomposed"] = true
	surface ["precomposed_reason"] = reason
	surface ["precomposed_at_ms"] = int(
		Time.get_ticks_msec()
	)
	institution_hub_surface_deck [key] = surface

	set_meta(
		"institution_surface_prewarm_integrity_failure",
		false
	)
	set_meta(
		"institution_surface_authoritative_content_precomposed",
		true
	)
	set_meta(
		"institution_surface_authoritative_content_precomposed_key",
		key
	)
func _schedule_institution_hub_surface_reconciliation(
	kind: String,
	section: String,
	reason: String,
	attempt: int = 0
) -> void:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_kind == "":
		return

	if clean_section == "":
		clean_section = (
			"family"
				if clean_kind == "relationships"
				else "overview"
		)

	var key: String = _institution_hub_surface_key(
		clean_kind,
		clean_section
	)
	var pending_meta_key: String = (
		"institution_surface_reconciliation_pending_%s"
			% key.replace(
				":",
				"_"
			).replace(
				"/",
				"_"
			)
	)

	if (
		attempt == 0
			and bool(
				get_meta(
					pending_meta_key,
					false
				)
			)
	):
		return

	if attempt == 0:
		set_meta(
			pending_meta_key,
			true
		)

	if attempt >= 16:
		set_meta(
			pending_meta_key,
			false
		)
		set_meta(
			"institution_surface_reconciliation_exhausted",
			true
		)
		set_meta(
			"institution_surface_reconciliation_exhausted_key",
			key
		)
		set_meta(
			"institution_surface_reconciliation_exhausted_reason",
			reason
		)
		return

	var delay_seconds: float = minf(
		0.3,
		0.05 + float(attempt) * 0.02
	)
	var scene_tree:= get_tree()

	if scene_tree == null:
		call_deferred(
			"_continue_institution_hub_surface_reconciliation",
			clean_kind,
			clean_section,
			reason,
			attempt,
			pending_meta_key
		)
		return

	var timer:= scene_tree.create_timer(
		delay_seconds
	)
	timer.timeout.connect(
		Callable(
			self,
			"_continue_institution_hub_surface_reconciliation"
		).bind(
			clean_kind,
			clean_section,
			reason,
			attempt,
			pending_meta_key
		),
		CONNECT_ONE_SHOT
	)


func _continue_institution_hub_surface_reconciliation(
	kind: String,
	section: String,
	reason: String,
	attempt: int,
	pending_meta_key: String
) -> void:
	if gs == null or gs.player == null:
		set_meta(
			pending_meta_key,
			false
		)
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		_ui_interaction_grace_active(
			now_ms
		)
			or _post_spawn_ui_is_busy_for_prewarm()
	):
		_schedule_institution_hub_surface_reconciliation(
			kind,
			section,
			reason,
			attempt + 1
		)
		return

	var hydrated: bool = _hydrate_institution_hub_surface(
		kind,
		section,
		"%s_attempt_%d" % [
			reason,
			attempt + 1
		]
	)
	var hot: bool = (
		hydrated
			and _native_main_tab_surface_is_hot(
				kind,
				section
			)
	)

	if hot:
		set_meta(
			pending_meta_key,
			false
		)
		set_meta(
			"institution_surface_reconciliation_succeeded",
			true
		)
		set_meta(
			"institution_surface_reconciliation_succeeded_key",
			_institution_hub_surface_key(
				kind,
				section
			)
		)
		set_meta(
			"institution_surface_reconciliation_succeeded_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	_schedule_institution_hub_surface_reconciliation(
		kind,
		section,
		reason,
		attempt + 1
	)

func _prime_native_main_tab_renderable_surface(
	panel_id: String,
	reason: String = "main_tab_renderable_prime"
) -> bool:
	if (
		gs == null
		or gs.player == null
	):
		return false

	var clean_spec: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_spec == "":
		return false

	var parts: PackedStringArray = clean_spec.split(
		"::"
	)
	var clean_panel: String = str(
		parts [0]
	).strip_edges().to_lower()
	var clean_section: String = ""

	if parts.size() >= 2:
		clean_section = str(
			parts [1]
		).strip_edges().to_lower()

	match clean_panel:
		"life":
			return (
				output_label != null
				and is_instance_valid(
					output_label
				)
			)

		"world":
			_ensure_world_feed_popup()

			return _main_tab_surface_is_renderable(
				"world"
			)

		"career":
			_ensure_career_hub_panel()

			if (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
				and not _career_hub_contract_is_renderable(
					career_hub_panel.active_contract,
					int(
						gs.player.id
					)
				)
			):
				_request_career_hub_observable_contract(
					gs.player,
					(
						"Professional truth is reconciling "
						+ "behind this continuous surface."
					),
					(
						"%s_career_hub_renderable_prime"
						% reason
					)
				)

			if (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
			):
				career_hub_panel.visible = false
				career_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			return _main_tab_surface_is_renderable(
				"career"
			)

		"activities":
			_ensure_activities_hub_panel()

			if (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
				and not (
					activities_hub_panel
					.has_renderable_contract(
						int(
							gs.player.id
						)
					)
				)
			):
				_request_activities_hub_contract(
					gs.player,
					{
						"action_id": "observe_partial",
						"section_id": (
							activities_hub_active_section_id
						),
						"status_text": (
							"Activity truth is reconciling "
							+ "behind this continuous surface."
						),
						"source": (
							"%s_activities_hub_renderable_prime"
							% reason
						)
					},
					false
				)

			if (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
			):
				activities_hub_panel.visible = false
				activities_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			return _main_tab_surface_is_renderable(
				"activities"
			)

		"school":
			if clean_section == "":
				clean_section = "overview"

			var school_panel: SchoolHubPanel = (
				_ensure_school_hub_panel()
			)

			if school_panel == null:
				return false

			_request_school_hub_panel_contract(
				gs.player,
				clean_section,
				false,
				"%s_school" % reason,
				true
			)

			school_panel.hide_surface()

			return school_panel.has_renderable_contract(
				int(
					gs.player.id
				)
			)
		"relationships":
			if clean_section == "":
				clean_section = "family"

			var relationship_panel: RelationshipHubPanel = (
				_ensure_relationship_hub_panel()
			)

			if relationship_panel == null:
				return false

			_request_relationship_hub_panel_contract(
				gs.player,
				clean_section,
				false,
				"%s_relationships" % reason,
				true
			)

			relationship_panel.hide_surface()

			return relationship_panel.has_renderable_contract(
				int(
					gs.player.id
				)
			)

		"mods":
			_ensure_mod_menu_panel()

			if (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and not mod_menu_panel.has_renderable_contract(
					int(
						gs.player.id
					)
				)
			):
				_request_mod_menu_contract(
					gs.player,
					{
						"action_id": "open_menu",
						"section_id": (
							mod_menu_active_section_id
						),
						"status_text": (
							"Mod Hub reality is observable."
						),
						"source": (
							"%s_mod_menu_authoritative_prime"
							% reason
						)
					},
					false
				)



			if (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and not mod_menu_panel.has_renderable_contract(
					int(
						gs.player.id
					)
				)
			):
				_request_mod_menu_contract(
					gs.player,
					{
						"action_id": "observe_partial",
						"section_id": (
							mod_menu_active_section_id
						),
						"status_text": (
							"Mod Hub truth remains observable "
							+ "through its safe contract."
						),
						"source": (
							"%s_mod_menu_partial_fallback"
							% reason
						)
					},
					false
				)

			if (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
			):
				mod_menu_panel.visible = false
				mod_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)

			return _main_tab_surface_is_renderable(
				"mods"
			)

		_:
			return false
func _main_tab_real_surface_exists_for_reveal(
		panel_id: String
) -> bool:
	var clean_panel: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_panel == "":
		return false



	_rebind_persistent_main_tab_renderer_references()

	var surface_exists: bool = false

	match clean_panel:
		"life":
			surface_exists = (
				output_label != null
				and is_instance_valid(
					output_label
				)
			)

		"world":
			surface_exists = (
				world_feed_popup != null
				and is_instance_valid(
					world_feed_popup
				)
				and world_feed_popup_feed != null
				and is_instance_valid(
					world_feed_popup_feed
				)
			)

		"relationships":
			surface_exists = (
				relationship_hub_panel != null
				and is_instance_valid(
					relationship_hub_panel
				)
				and relationship_hub_panel.has_surface_shell()
			)

		"school":
			surface_exists = (
				school_hub_panel != null
				and is_instance_valid(
					school_hub_panel
				)
				and school_hub_panel.has_surface_shell()
			)

		"career":
			surface_exists = (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
			)

		"activities":
			surface_exists = (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
			)

		"mods":
			surface_exists = (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
			)

		_:
			surface_exists = false

	set_meta(
		"main_tab_real_surface_exists_last_panel",
		clean_panel
	)
	set_meta(
		"main_tab_real_surface_exists_last_result",
		surface_exists
	)
	set_meta(
		"main_tab_real_surface_exists_built_on_check",
		false
	)
	set_meta(
		"main_tab_real_surface_exists_engine_query",
		false
	)

	return surface_exists
func _request_native_main_tab_surface_prewarm_idle(panel_id: String, reason: String = "native_tab_surface_idle_prewarm") -> void:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	if clean_panel == "":
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var existing_panel: String = str(get_meta("native_main_tab_surface_prewarm_requested_panel", "")).strip_edges().to_lower()
	var already_requested: bool = bool(get_meta("native_main_tab_surface_prewarm_requested", false))
	var request_until_ms: int = int(get_meta("native_main_tab_surface_prewarm_request_until_ms", 0))

	if already_requested and existing_panel == clean_panel and now_ms < request_until_ms:
		return

	set_meta("native_main_tab_surface_prewarm_requested", true)
	set_meta("native_main_tab_surface_prewarm_requested_panel", clean_panel)
	set_meta("native_main_tab_surface_prewarm_requested_reason", reason)
	set_meta("native_main_tab_surface_prewarm_requested_at_ms", now_ms)
	set_meta("native_main_tab_surface_prewarm_request_until_ms", now_ms + 1500)
	set_meta("native_main_tab_surface_prewarm_must_wait_for_idle", true)
	set_meta("native_main_tab_surface_prewarm_must_not_run_on_click_frame", true)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_native_main_tab_surface_prewarm_if_idle", clean_panel, reason)
		return

	var wait_seconds: float = 0.22
	if _ui_interaction_grace_active(now_ms):
		wait_seconds = 0.34

	var timer:= tree.create_timer(wait_seconds)
	timer.timeout.connect(
		Callable(self, "_run_native_main_tab_surface_prewarm_if_idle").bind(clean_panel, reason),
		CONNECT_ONE_SHOT
	)


func _run_native_main_tab_surface_prewarm_if_idle(
		panel_id: String,
		reason: String = "native_tab_surface_idle_prewarm"
) -> void:
	var clean_spec: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_spec == "":
		return

	var parts: PackedStringArray = clean_spec.split(
		"::"
	)
	var clean_panel: String = str(
		parts [0]
	).strip_edges().to_lower()
	var retry_key: String = clean_spec.replace(
		"::",
		"_"
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"native_main_tab_surface_prewarm_requested",
		false
	)
	set_meta(
		"native_main_tab_surface_prewarm_requested_panel",
		""
	)
	set_meta(
		"native_main_tab_surface_prewarm_request_until_ms",
		0
	)
	set_meta(
		"native_main_tab_surface_retry_pending_%s"
		% retry_key,
		false
	)
	set_meta(
		"native_main_tab_surface_retry_count_%s"
		% retry_key,
		0
	)
	set_meta(
		"native_main_tab_surface_retry_loop_removed_%s"
		% retry_key,
		true
	)

	var panel_was_open: bool = (
		current_panel == clean_panel
	)
	var projection_hot: bool = (
		_main_tab_surface_is_renderable(
			clean_spec
		)
	)

	set_meta(
		"native_main_tab_continuous_projection_panel",
		clean_spec
	)
	set_meta(
		"native_main_tab_continuous_projection_hot",
		projection_hot
	)
	set_meta(
		"native_main_tab_continuous_projection_at_ms",
		now_ms
	)
	set_meta(
		"native_main_tab_continuous_projection_built_on_click",
		false
	)
	set_meta(
		"native_main_tab_continuous_projection_engine_called",
		false
	)
	set_meta(
		"native_main_tab_continuous_projection_intent_expressed",
		false
	)
	set_meta(
		"native_main_tab_continuous_projection_retry_scheduled",
		false
	)
	set_meta(
		"native_main_tab_surface_waiting_for_resident_packet_%s"
		% clean_panel,
		not projection_hot
	)

	if not projection_hot:
		return

	set_meta(
		"native_main_tab_surface_hot_%s"
		% clean_panel,
		true
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s"
		% clean_panel,
		true
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s_at_ms"
		% clean_panel,
		now_ms
	)

	if panel_was_open:
		_restore_open_main_tab_after_background_projection(
			clean_panel,
			"%s_existing_packet_observed"
			% reason
		)
func _restore_open_main_tab_after_background_projection(
		panel_id: String,
		reason: String = "background_projection_arrived"
) -> void:
	var clean_panel: String = str(
		panel_id
	).strip_edges().to_lower()

	if (
		clean_panel == ""
		or current_panel != clean_panel
	):
		return

	var surface: Control = null

	match clean_panel:
		"world":
			surface = world_feed_popup

			if (
				world_feed_popup != null
				and is_instance_valid(
					world_feed_popup
				)
			):
				world_feed_popup_open = true

		"relationships":
			surface = relationship_hub_panel

		"school":
			surface = school_hub_panel

		"career":
			surface = career_hub_panel

		"activities":
			surface = activities_hub_panel
			activities_action_open = true

		"mods":
			surface = mod_menu_panel

		_:
			return

	if (
		surface == null
		or not is_instance_valid(
			surface
		)
	):
		return

	surface.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	surface.visible = true
	surface.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	surface.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	surface.z_as_relative = false
	surface.z_index = 560

	_bring_modal_to_front(
		surface
	)
	_claim_interactive_surface_authority(
		surface,
		"main_tab_background_projection:%s"
		% clean_panel,
		reason,
		true,
		true
	)
	_apply_main_tab_press_frame_nav_state(
		clean_panel,
		reason
	)

	set_meta(
		"main_tab_background_projection_revealed",
		true
	)
	set_meta(
		"main_tab_background_projection_revealed_panel",
		clean_panel
	)
	set_meta(
		"main_tab_background_projection_revealed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"main_tab_background_projection_engine_called",
		false
	)
	set_meta(
		"main_tab_background_projection_build_performed",
		false
	)
func _open_main_tab_zero_frame_door(
		panel_id: String,
		reason: String = "main_tab_button"
) -> bool:
	var clean_panel: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_panel == "":
		return false

	_begin_zero_frame_ui_input_fence(
		"%s:%s"
		% [
			reason,
			clean_panel
		],
		280
	)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var previous_panel: String = str(
		current_panel
	).strip_edges().to_lower()
	var institution_section: String = ""

	if clean_panel == "relationships":
		institution_section = (
			MainSceneLogic._relationship_hub_resolve_section_id(gs, 
				relationships_hub_active_section_id
			)
		)

		if institution_section == "":
			institution_section = "family"
	elif clean_panel == "school":
		institution_section = "overview"

	var legacy_shell_latch_hot: bool = bool(
		get_meta(
			"native_main_tab_shell_hot_%s"
			% clean_panel,
			false
		)
	)
	var real_surface_exists: bool = (
		_main_tab_real_surface_exists_for_reveal(
			clean_panel
		)
	)
	var surface_renderable: bool = (
		_main_tab_surface_is_renderable(
			clean_panel,
			institution_section
		)
	)
	var actor_truth_hot: bool = (
		_native_main_tab_surface_is_hot(
			clean_panel,
			institution_section
		)
		if clean_panel in [
			"relationships",
			"school"
		]
		else surface_renderable
	)



	if not real_surface_exists:
		set_meta(
			"main_tab_zero_frame_door_integrity_failure",
			true
		)
		set_meta(
			"main_tab_zero_frame_door_integrity_failure_panel",
			clean_panel
		)
		set_meta(
			"main_tab_zero_frame_door_integrity_failure_at_ms",
			now_ms
		)
		set_meta(
			"main_tab_zero_frame_door_kept_current_surface_visible",
			true
		)
		set_meta(
			"main_tab_zero_frame_door_failure_reason",
			"real_renderer_surface_missing"
		)
		set_meta(
			"main_tab_zero_frame_door_queued_projection_request",
			false
		)

		_apply_main_tab_press_frame_nav_state(
			previous_panel,
			"%s_real_renderer_surface_missing"
			% reason
		)

		EraLog.truth(
			(
				"ERALIFE_MAIN_TAB_DOOR_TRUTH"
				+ "|panel=%s"
				+ "|opened=false"
				+ "|real_surface_exists=false"
				+ "|legacy_shell_latch_hot=%s"
				+ "|legacy_shell_latch_controls_door=false"
				+ "|build_on_click=false"
			)
			% [
				clean_panel,
				str(
					legacy_shell_latch_hot
				)
			]
		)

		return false

	set_meta(
		"main_tab_zero_frame_door_integrity_failure",
		false
	)
	set_meta(
		"main_tab_press_frame_build_forbidden",
		true
	)
	set_meta(
		"main_tab_press_frame_refresh_forbidden",
		true
	)
	set_meta(
		"main_tab_press_frame_reveal_only",
		true
	)
	set_meta(
		"main_tab_press_frame_panel",
		clean_panel
	)
	set_meta(
		"main_tab_press_frame_at_ms",
		now_ms
	)
	set_meta(
		"main_tab_press_actor_truth_hot",
		actor_truth_hot
	)
	set_meta(
		"main_tab_press_actor_truth_may_stream_after_reveal",
		not actor_truth_hot
	)
	set_meta(
		"main_tab_press_real_surface_exists",
		true
	)
	set_meta(
		"main_tab_press_legacy_shell_latch_hot",
		legacy_shell_latch_hot
	)
	set_meta(
		"main_tab_press_legacy_shell_latch_controls_door",
		false
	)
	set_meta(
		"main_tab_press_engine_intent_expressed",
		false
	)
	set_meta(
		"main_tab_press_projection_request_queued",
		false
	)

	var opened: bool = false

	match clean_panel:
		"life":
			opened = (
				_open_life_diary_native_surface(
					"%s_life_native_door"
					% reason
				)
			)

		"world":
			opened = (
				_open_world_tab_shell_immediate(
					"%s_world_native_door"
					% reason
				)
			)

		"relationships":
			opened = (
				_open_institution_tab_zero_frame_door(
					"relationships",
					institution_section,
					(
						"%s_relationships_native_door"
						% reason
					)
				)
			)

		"career":
			opened = (
				_open_career_hub_zero_frame_door(
					"%s_career_hub_native_door"
					% reason
				)
			)

		"school":
			opened = (
				_open_institution_tab_zero_frame_door(
					"school",
					institution_section,
					(
						"%s_school_native_door"
						% reason
					)
				)
			)

		"activities":
			opened = (
				_open_activities_hub_zero_frame_door(
					"%s_activities_native_door"
					% reason
				)
			)

		"mods":
			opened = (
				_open_mod_menu_zero_frame_door(
					"%s_mod_menu_native_door"
					% reason
				)
			)

		_:
			return false

	if not opened:
		current_panel = previous_panel

		if (
			previous_panel == "life"
			and output_label != null
			and is_instance_valid(
				output_label
			)
		):
			output_label.visible = true
			output_label.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		_apply_main_tab_press_frame_nav_state(
			previous_panel,
			"%s_open_failed_kept_previous"
			% reason
		)

		set_meta(
			"main_tab_open_failed_after_real_surface_check",
			true
		)
		set_meta(
			"main_tab_open_failed_after_real_surface_check_panel",
			clean_panel
		)
		set_meta(
			"main_tab_open_failed_queued_projection_request",
			false
		)

		return false

	current_panel = clean_panel

	_apply_main_tab_press_frame_nav_state(
		clean_panel,
		reason
	)

	set_meta(
		"main_tab_first_press_opened",
		true
	)
	set_meta(
		"main_tab_first_press_opened_panel",
		clean_panel
	)
	set_meta(
		"main_tab_first_press_opened_at_ms",
		now_ms
	)
	set_meta(
		"main_tab_first_press_opened_before_actor_truth",
		not actor_truth_hot
	)
	set_meta(
		"main_tab_actor_truth_controls_door",
		false
	)
	set_meta(
		"main_tab_click_mutated_simulation_truth",
		false
	)

	EraLog.truth(
		(
			"ERALIFE_MAIN_TAB_DOOR_TRUTH"
			+ "|panel=%s"
			+ "|opened=%s"
			+ "|real_surface_exists=%s"
			+ "|legacy_shell_latch_hot=%s"
			+ "|legacy_shell_latch_controls_door=false"
			+ "|surface_renderable=%s"
			+ "|actor_truth_hot=%s"
			+ "|actor_truth_controls_door=false"
			+ "|engine_intent_expressed=false"
			+ "|projection_request_queued=false"
			+ "|build_on_click=false"
		)
		% [
			clean_panel,
			str(
				opened
			),
			str(
				real_surface_exists
			),
			str(
				legacy_shell_latch_hot
			),
			str(
				surface_renderable
			),
			str(
				actor_truth_hot
			)
		]
	)

	return true
func _queue_controlled_actor_institution_surface_prime(
		kind: String,
		section: String,
		reason: String,
		reveal_when_ready: bool = false
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var clean_reason: String = str(
		reason
	).strip_edges().to_lower()
	var lifecycle_projection_request: bool = (
		clean_reason.find(
			"ready_room"
		) != -1
		or clean_reason.find(
			"prewarm"
		) != -1
		or clean_reason.find(
			"control_switch"
		) != -1
		or clean_reason.find(
			"character_switch"
		) != -1
		or clean_reason.find(
			"retarget"
		) != -1
		or clean_reason.find(
			"resident_rebind"
		) != -1
	)



	if not lifecycle_projection_request:
		set_meta(
			"institution_surface_prime_rejected_from_click_path",
			true
		)
		set_meta(
			"institution_surface_prime_rejected_reason",
			reason
		)
		set_meta(
			"institution_surface_prime_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"institution_surface_prime_click_scheduled_work",
			false
		)
		return

	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_kind not in [
		"relationships",
		"school"
	]:
		return

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	if clean_kind == "relationships":
		clean_section = MainSceneLogic._relationship_hub_resolve_section_id(gs, 
			clean_section
		)

		if clean_section == "":
			clean_section = "family"

	var actor_id: int = int(
		gs.player.id
	)
	var world_lens_key: String = str(
		_world_seed_ui_lens_key()
	).strip_edges()

	if world_lens_key == "":
		world_lens_key = "unbound"

	var request_key: String = _institution_hub_surface_key(
		clean_kind,
		clean_section,
		actor_id
	)
	var requests: Dictionary = MainSceneHelpers._safe_dictionary(
		get_meta(
			"institution_surface_prime_requests",
			{}
		)
	)
	var existing: Dictionary = MainSceneHelpers._safe_dictionary(
		requests.get(
			request_key,
			{}
		)
	)

	if not existing.is_empty():
		if reveal_when_ready:
			existing [
				"reveal_when_ready"
			] = true
			existing [
				"origin_panel"
			] = str(
				current_panel
			)
			existing [
				"reason"
			] = reason
			requests [
				request_key
			] = existing

			set_meta(
				"institution_surface_prime_requests",
				requests
			)

		return

	var request_id: int = int(
		get_meta(
			"institution_surface_prime_sequence",
			0
		)
	) + 1

	set_meta(
		"institution_surface_prime_sequence",
		request_id
	)

	requests [
		request_key
	] = {
		"request_id": request_id,
		"request_key": request_key,
		"kind": clean_kind,
		"section": clean_section,
		"actor_id": actor_id,
		"world_lens_key": world_lens_key,
		"reason": reason,
		"attempt": 0,
		"reveal_when_ready": reveal_when_ready,
		"origin_panel": str(
			current_panel
		),
		"requested_at_ms": int(
			Time.get_ticks_msec()
		),
	}

	set_meta(
		"institution_surface_prime_requests",
		requests
	)
	set_meta(
		"institution_surface_prime_queued",
		true
	)
	set_meta(
		"institution_surface_prime_queued_key",
		request_key
	)

	call_deferred(
		"_continue_controlled_actor_institution_surface_prime",
		request_key,
		request_id
	)

func _continue_controlled_actor_institution_surface_prime(
		request_key: String,
		request_id: int
) -> void:
	var requests: Dictionary = MainSceneHelpers._safe_dictionary(
		get_meta(
			"institution_surface_prime_requests",
			{}
		)
	)
	var request: Dictionary = MainSceneHelpers._safe_dictionary(
		requests.get(
			request_key,
			{}
		)
	)

	if (
		request.is_empty()
		or int(
			request.get(
				"request_id",
				-1
			)
		) != request_id
	):
		return

	if (
		gs == null
		or gs.player == null
	):
		requests.erase(
			request_key
		)
		set_meta(
			"institution_surface_prime_requests",
			requests
		)
		return

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)
	var current_actor_id: int = int(
		gs.player.id
	)
	var requested_world_lens_key: String = str(
		request.get(
			"world_lens_key",
			""
		)
	)
	var current_world_lens_key: String = str(
		_world_seed_ui_lens_key()
	).strip_edges()

	if current_world_lens_key == "":
		current_world_lens_key = "unbound"



	if (
		actor_id != current_actor_id
		or requested_world_lens_key
		!= current_world_lens_key
	):
		requests.erase(
			request_key
		)
		set_meta(
			"institution_surface_prime_requests",
			requests
		)
		set_meta(
			"institution_surface_prime_discarded_stale_request",
			true
		)
		return

	var kind: String = str(
		request.get(
			"kind",
			""
		)
	).strip_edges().to_lower()
	var section: String = str(
		request.get(
			"section",
			""
		)
	).strip_edges().to_lower()

	if (
		kind == "relationships"
		and section == ""
	):
		section = "family"
	elif (
		kind == "school"
		and section == ""
	):
		section = "overview"

	if _native_main_tab_surface_is_hot(
		kind,
		section
	):
		var reveal_when_ready: bool = bool(
			request.get(
				"reveal_when_ready",
				false
			)
		)
		var origin_panel: String = str(
			request.get(
				"origin_panel",
				"life"
			)
		)
		var completion_reason: String = str(
			request.get(
				"reason",
				"institution_surface_prime"
			)
		)

		requests.erase(
			request_key
		)
		set_meta(
			"institution_surface_prime_requests",
			requests
		)
		set_meta(
			"institution_surface_prime_completed",
			true
		)
		set_meta(
			"institution_surface_prime_completed_key",
			request_key
		)
		set_meta(
			"institution_surface_prime_completed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		if (
			reveal_when_ready
			and str(
				current_panel
			).strip_edges().to_lower()
			== origin_panel
		):
			call_deferred(
				"_open_main_tab_zero_frame_door",
				kind,
				"%s_auto_reveal"
				% completion_reason
			)

		return

	var attempt: int = int(
		request.get(
			"attempt",
			0
		)
	)

	if attempt >= 24:
		requests.erase(
			request_key
		)
		set_meta(
			"institution_surface_prime_requests",
			requests
		)
		set_meta(
			"institution_surface_prime_exhausted",
			true
		)
		set_meta(
			"institution_surface_prime_exhausted_key",
			request_key
		)
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		not _ui_interaction_grace_active(
			now_ms
		)
		and not _post_spawn_ui_is_busy_for_prewarm()
	):
		var request_reason: String = (
			"%s_actor_%d_attempt_%d"
			% [
				str(
					request.get(
						"reason",
						"institution_surface_prime"
					)
				),
				actor_id,
				attempt + 1
			]
		)
		var route_report: Dictionary = {}

		match kind:
			"relationships":
				route_report = (
					_request_relationship_hub_panel_contract_by_actor_id(
						actor_id,
						section,
						false,
						request_reason,
						true
					)
				)

			"school":
				route_report = (
					_request_school_hub_panel_contract_by_actor_id(
						actor_id,
						section,
						false,
						request_reason,
						true
					)
				)

			_:
				requests.erase(
					request_key
				)
				set_meta(
					"institution_surface_prime_requests",
					requests
				)
				set_meta(
					"institution_surface_prime_invalid_kind",
					kind
				)
				return

		request [
			"attempt"
		] = attempt + 1
		request [
			"last_attempt_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
		request [
			"last_route_report"
		] = route_report.duplicate(true)
		request [
			"last_route_success"
		] = bool(
			route_report.get(
				"success",
				false
			)
		)

		requests [
			request_key
		] = request

		set_meta(
			"institution_surface_prime_requests",
			requests
		)
		set_meta(
			"institution_surface_prime_uses_dedicated_panel_contract",
			true
		)
		set_meta(
			"institution_surface_prime_legacy_overlay_hydration_forbidden",
			true
		)

	_schedule_controlled_actor_institution_surface_prime_retry(
		request_key,
		request_id,
		minf(
			0.3,
			0.04 + float(
				attempt
			) * 0.015
		)
	)

func _schedule_controlled_actor_institution_surface_prime_retry(
	request_key: String,
	request_id: int,
	delay_seconds: float
) -> void:
	var scene_tree:= get_tree()

	if scene_tree == null:
		call_deferred(
			"_continue_controlled_actor_institution_surface_prime",
			request_key,
			request_id
		)
		return

	var timer:= scene_tree.create_timer(
		maxf(
			0.01,
			delay_seconds
		)
	)

	timer.timeout.connect(
		Callable(
			self,
			"_continue_controlled_actor_institution_surface_prime"
		).bind(
			request_key,
			request_id
		),
		CONNECT_ONE_SHOT
	)
