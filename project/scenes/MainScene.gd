func _school_hub_add_academic_record_snapshot(postsecondary: Dictionary) -> void:
	var era_name: String = ""
	if gs != null and gs.era != null:
		era_name = str(gs.era.name).strip_edges()

	var p: Person = gs.player if gs != null else null
	var school_name: String = ""
	var program_text: String = "None"
	if p != null:
		school_name = str(p.school_name).strip_edges()
		program_text = str(p.education_level).strip_edges()
	if school_name == "" or school_name == "None":
		school_name = "Local Schooling"
	if program_text == "" or program_text == "None":
		program_text = "Broad study"

	match era_name:
		"Ancient Era":
			_institution_hub_add_card("Academic Record Snapshot", [
				"Learning Model: Broad foundational instruction",
				"Institution: %s" % school_name,
				"Path: %s" % program_text,
				"Core Study: rhetoric, mathematics, philosophy, letters, civic debate",
				"Practical Training: apprenticeships under a master",
				"Elite Mentorship: private tutors, philosophers, orators, and scientists"
			])
			return

		"Medieval Era":
			_institution_hub_add_card("Academic Record Snapshot", [
				"Learning Model: monastic, guild, court, or apprenticeship instruction",
				"Institution: %s" % school_name,
				"Path: %s" % program_text,
				"Core Study: letters, ledgers, faith, oaths, craft practice, etiquette, combat",
				"Practical Training: apprenticeships under masters and patrons",
				"Scholarly Structure: broad study, not modern degree majors"
			])
			return

	var record: Dictionary = MainSceneHelpers._safe_dictionary(postsecondary.get("record", {}))
	var active_major: String = str(postsecondary.get("active_major", "")).strip_edges()
	var completed_majors: Array = MainSceneHelpers._safe_array(record.get("completed_college_majors", []))
	var graduate_schools: Array = MainSceneHelpers._safe_array(record.get("graduate_schools", []))
	var performance: int = int(postsecondary.get("college_performance_score", 0))

	_institution_hub_add_card("Academic Record Snapshot", [
		"Current Major: %s" % (active_major if active_major != "" else "None"),
		"Completed Majors: %s" % (MainSceneHelpers._school_hub_join_strings(completed_majors) if not completed_majors.is_empty() else "None"),
		"Graduate Schools: %s" % (MainSceneHelpers._school_hub_join_strings(graduate_schools) if not graduate_schools.is_empty() else "None"),
		"College Performance: %d%%" % performance
	])
