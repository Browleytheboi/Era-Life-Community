func _resolve_age_up_loading_copy_bucket(overlay_context: Dictionary, loading: Dictionary) -> Dictionary:
	var context_rows_raw: Variant = overlay_context.get("flavor_rows", [])
	var context_rows: Array = context_rows_raw if typeof(context_rows_raw) == TYPE_ARRAY else []
	var uses_context_rows: bool = not context_rows.is_empty()

	var dominant_domain: String = str(loading.get("dominant_domain", overlay_context.get("dominant_domain", "general"))).strip_edges()
	if dominant_domain == "":
		dominant_domain = "general"

	if not uses_context_rows:
		var bucket_key: String = MainSceneHelpers._build_age_up_loading_copy_bucket_key(overlay_context, loading)
		var cached_raw: Variant = age_up_loading_copy_bucket_cache.get(bucket_key, {})
		var cached: Dictionary = cached_raw if typeof(cached_raw) == TYPE_DICTIONARY else {}
		if not cached.is_empty():
			return cached.duplicate(true)

	var resolved_rows: Array = context_rows.duplicate(true)
	if resolved_rows.is_empty():
		resolved_rows = _default_age_up_loading_flavor_rows(overlay_context)

	var bucket: Dictionary = {
		"rows": resolved_rows.duplicate(true),
		"dominant_domain": dominant_domain,
		"dominant_domain_text": dominant_domain.replace("_", " ").capitalize()
	}

	if not uses_context_rows:
		var store_key: String = MainSceneHelpers._build_age_up_loading_copy_bucket_key(overlay_context, loading)
		if not age_up_loading_copy_bucket_cache.has(store_key) and age_up_loading_copy_bucket_cache.size() >= 8:
			var existing_keys: Array = age_up_loading_copy_bucket_cache.keys()
			if not existing_keys.is_empty():
				age_up_loading_copy_bucket_cache.erase(existing_keys [0])
		age_up_loading_copy_bucket_cache [store_key] = bucket.duplicate(true)

	return bucket
func _refresh_age_up_loading_text_from_state(force: bool = false) -> void:
	if age_up_loading_overlay == null or not age_up_loading_overlay.visible:
		return
	var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {}) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
	var overlay_context_raw: Variant = loading.get("overlay_context", {})
	var overlay_context: Dictionary = overlay_context_raw if typeof(overlay_context_raw) == TYPE_DICTIONARY else {}

	var refresh_signature: String = MainSceneHelpers._build_age_up_loading_text_refresh_signature(loading, overlay_context)
	var now_ms: int = int(Time.get_ticks_msec())
	var next_refresh_ms: int = int(get_meta("age_up_loading_text_refresh_next_ms", 0))
	var last_signature: String = str(get_meta("age_up_loading_text_refresh_signature", ""))
	var should_advance_loading_copy: bool = force or age_up_loading_message_elapsed >= AGE_UP_LOADING_MESSAGE_INTERVAL
	var first_text_boot: bool = age_up_loading_cached_headline_text == "" or age_up_loading_cached_subtitle_text == "" or age_up_loading_cached_phase_text == "" or age_up_loading_cached_footer_text == ""

	if not force and not first_text_boot and not should_advance_loading_copy and refresh_signature == last_signature and now_ms < next_refresh_ms:
		return

	set_meta("age_up_loading_text_refresh_signature", refresh_signature)
	set_meta("age_up_loading_text_refresh_next_ms", now_ms + MainSceneHelpers._resolve_age_up_loading_text_refresh_interval_ms(loading, overlay_context))

	var copy_bucket: Dictionary = _resolve_age_up_loading_copy_bucket(overlay_context, loading)
	var rows_raw: Variant = copy_bucket.get("rows", [])
	var rows: Array = rows_raw if typeof(rows_raw) == TYPE_ARRAY else []
	if rows.is_empty():
		rows = _default_age_up_loading_flavor_rows(overlay_context)
	if should_advance_loading_copy:
		age_up_loading_message_elapsed = 0.0
		if not rows.is_empty():
			age_up_loading_message_index = (age_up_loading_message_index + 1) % rows.size()
	var current_phase: String = str(loading.get("current_phase", "preflight"))
	var completion_state: String = str(loading.get("completion_state", "running"))
	var session_stage: String = str(loading.get("session_stage", "boot"))
	var stall_score: float = float(loading.get("stall_score", 0.0))
	var reality_mode: String = str(overlay_context.get("reality_mode", "realistic"))
	var headline: String = str(overlay_context.get("headline", "Time is moving..."))
	var subline: String = str(overlay_context.get("subline", "Simulating the next year..."))
	if not rows.is_empty():
		var row: Dictionary = rows [age_up_loading_message_index % rows.size()]
		headline = str(row.get("headline", headline))
		subline = str(row.get("subline", subline))
	if completion_state == "complete" and session_stage == "complete":
		headline = "Year resolved."
		subline = "Pulling the next turn into view..."
	elif session_stage == "settling_previous_year":
		headline = "Time is still settling..."
		subline = "Deferred work from the last year is being cleared..."
	elif session_stage == "settling_current_year":
		headline = "Reality is stabilizing..."
		subline = "Final commits are locking the new year into place..."
	elif reality_mode == "chaos" and stall_score >= 72.0:
		headline = "Reality is struggling to keep up..."
		subline = "Chaos-mode drift is forcing rough corrections..."
	if age_up_loading_title != null and (force or age_up_loading_cached_headline_text != headline):
		age_up_loading_title.text = headline
		age_up_loading_cached_headline_text = headline
	if age_up_loading_subtitle != null and (force or age_up_loading_cached_subtitle_text != subline):
		age_up_loading_subtitle.text = subline
		age_up_loading_cached_subtitle_text = subline
	var phase_text: String = MainSceneHelpers._age_up_loading_phase_display_text(current_phase)
	if age_up_loading_phase_label != null and (force or age_up_loading_cached_phase_text != phase_text):
		age_up_loading_phase_label.text = phase_text
		age_up_loading_cached_phase_text = phase_text
	var footer_parts: Array = []
	var era_name: String = str(overlay_context.get("era_name", "")).strip_edges()
	if era_name != "":
		footer_parts.append(era_name)
	var dominant_domain: String = str(copy_bucket.get("dominant_domain", loading.get("dominant_domain", overlay_context.get("dominant_domain", "general"))))
	var dominant_domain_text: String = str(copy_bucket.get("dominant_domain_text", "")).strip_edges()
	if dominant_domain != "":
		if dominant_domain_text == "":
			dominant_domain_text = dominant_domain.replace("_", " ").capitalize()
		footer_parts.append(dominant_domain_text)
	var target_year: int = int(overlay_context.get("target_year", gs.year if gs != null else 0))
	footer_parts.append(_format_year(target_year))
	var footer_text: String = " • ".join(footer_parts)
	if age_up_loading_footer != null and (force or age_up_loading_cached_footer_text != footer_text):
		age_up_loading_footer.text = footer_text
		age_up_loading_cached_footer_text = footer_text
	var did_you_know_rows: Array = _build_age_up_loading_did_you_know_rows(overlay_context)
	var should_advance_did_you_know: bool = force or age_up_loading_did_you_know_current_key == ""
	if not should_advance_did_you_know:
		var viewport_snapshot: Dictionary = _resolve_age_up_loading_did_you_know_viewport_snapshot(false)
		if not viewport_snapshot.is_empty():
			var overflow: float = float(viewport_snapshot.get("overflow", 0.0))
			if overflow <= 2.0:
				should_advance_did_you_know = should_advance_loading_copy
			else:
				var minimum_hold_time: float = float(viewport_snapshot.get("minimum_hold_time", 0.0))
				should_advance_did_you_know = age_up_loading_did_you_know_scroll_elapsed >= minimum_hold_time
		else:
			should_advance_did_you_know = should_advance_loading_copy
	var selected_did_row: Dictionary = _pick_age_up_loading_did_you_know_row(
		did_you_know_rows,
		should_advance_did_you_know
	)
	var did_you_know_text: String = "The next year is being staged behind the curtain."
	if not selected_did_row.is_empty():
		did_you_know_text = str(selected_did_row.get("text", did_you_know_text))
	_set_age_up_loading_did_you_know_text(
		did_you_know_text,
		force or age_up_loading_did_you_know_current_key == ""
	)
