func _get_crown_allocation_draft(
		summary: Dictionary = {}
) -> Dictionary:
		var fallback: Dictionary = {
			"tax_rate": 10.0,
			"treasury_pct": 34,
			"military_pct": 33,
			"goods_pct": 33
		}

		if gs == null or gs.player == null:
			return fallback

		var key: String = MainSceneLogic._get_crown_allocation_draft_key(gs)

		if key == "":
			return fallback

		var store_raw: Variant = get_meta(
			"crown_allocation_draft_lens_by_key",
			{}
		)
		var store: Dictionary = (
			store_raw as Dictionary
			if typeof(store_raw) == TYPE_DICTIONARY
			else {}
		)
		var existing: Dictionary = MainSceneHelpers._safe_dictionary(
			store.get(
				key,
				{}
			)
		)

		if existing.is_empty():
			existing = {
				"tax_rate": clamp(
					float(
						summary.get(
							"tax_rate",
							10.0
						)
					),
					0.0,
					40.0
				),
				"treasury_pct": int(
					summary.get(
						"allocation_treasury_pct",
						34
					)
				),
				"military_pct": int(
					summary.get(
						"allocation_military_pct",
						33
					)
				),
				"goods_pct": int(
					summary.get(
						"allocation_goods_pct",
						33
					)
				)
			}

		return MainSceneHelpers._sanitize_crown_allocation_split(
			existing
		)

func _store_crown_allocation_draft(
		draft: Dictionary
) -> void:
		if gs == null or gs.player == null:
			return

		var key: String = MainSceneLogic._get_crown_allocation_draft_key(gs)

		if key == "":
			return

		var store_raw: Variant = get_meta(
			"crown_allocation_draft_lens_by_key",
			{}
		)
		var store: Dictionary = (
			store_raw as Dictionary
			if typeof(store_raw) == TYPE_DICTIONARY
			else {}
		)
		store [key] = MainSceneHelpers._sanitize_crown_allocation_split(
			draft
		)
		set_meta(
			"crown_allocation_draft_lens_by_key",
			store
		)
		set_meta(
			"crown_allocation_draft_mutated_game_state",
			false
		)


func _on_crown_allocation_tax_changed(
		value: float
) -> void:
		var summary: Dictionary = _crown_hub_cached_summary()

		if summary.is_empty():
			return

		var draft: Dictionary = _get_crown_allocation_draft(
			summary
		)
		draft ["tax_rate"] = clamp(
			float(round(value)),
			0.0,
			40.0
		)
		_store_crown_allocation_draft(
			draft
		)
		_refresh_crown_allocation_live_state()

		set_meta(
			"crown_allocation_slider_engine_calls",
			false
		)

func _on_crown_allocation_bucket_changed(
		value: float,
		bucket_key: String
) -> void:
		var summary: Dictionary = _crown_hub_cached_summary()

		if summary.is_empty():
			return

		var draft: Dictionary = _get_crown_allocation_draft(
			summary
		)
		draft = MainSceneLogic._rebalance_crown_allocation_draft(
			draft,
			bucket_key,
			clamp(
				int(round(value)),
				0,
				100
			)
		)
		_store_crown_allocation_draft(
			draft
		)
		_refresh_crown_allocation_live_state()

		set_meta(
			"crown_allocation_slider_engine_calls",
			false
		)

func _append_crown_allocation_bucket_row(
	parent: VBoxContainer,
	summary: Dictionary,
	label_text: String,
	bucket_key: String,
	pct: int,
	amount: int,
	_max_pct: int,
	editable: bool,
	unit_cost: int = 0,
	unit_label: String = "units"
) -> void:
	if parent == null:
		return

	var core:= _crown_hud_core_color()
	var currency_name: String = str(summary.get("currency_name", "")).strip_edges()

	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.set_meta("crown_allocation_bucket_key", bucket_key)
	card.set_meta("crown_allocation_bucket_pct", pct)
	card.set_meta("crown_allocation_bucket_amount", amount)
	parent.add_child(card)

	card.add_theme_stylebox_override("panel", MainSceneLogic._crown_hub_depth_style(card, "crown_allocation_bucket_style", "lowest", core, false, false))

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 14)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 14)
	margin.add_theme_constant_override("margin_bottom", 12)
	card.add_child(margin)

	var root:= VBoxContainer.new()
	root.add_theme_constant_override("separation", 6)
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	margin.add_child(root)

	var top_row:= HBoxContainer.new()
	top_row.add_theme_constant_override("separation", 8)
	root.add_child(top_row)

	var title:= Label.new()
	title.text = "%s" % label_text
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title.add_theme_color_override("font_color", Color(1.0, 0.88, 0.58, 1.0))
	top_row.add_child(title)

	var pct_label:= Label.new()
	pct_label.text = "%d%%" % pct
	pct_label.add_theme_color_override("font_color", Color(0.78, 0.92, 1.0, 0.95))
	top_row.add_child(pct_label)

	var amount_label:= Label.new()
	amount_label.text = _format_crown_treasury_label(amount, currency_name)
	amount_label.add_theme_color_override("font_color", Color(1.0, 0.8, 0.32, 0.92))
	root.add_child(amount_label)

	var unit_line = null
	if unit_cost > 0:
		var units: int = int(floor(float(amount) / float(max(1, unit_cost))))
		unit_line = Label.new()
		unit_line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		unit_line.text = "Projected output: %s %s @ %s each" % [
			_crown_compact_number(float(units)),
			unit_label,
			_format_crown_treasury_label(unit_cost, currency_name)
		]
		unit_line.add_theme_color_override("font_color", Color(0.76, 0.92, 1.0, 0.88))
		root.add_child(unit_line)

	var slider:= HSlider.new()
	slider.min_value = 0
	slider.max_value = 100
	slider.step = 1
	slider.value = clamp(float(pct), 0.0, 100.0)
	slider.editable = editable
	slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_crown_hub_style_slider(slider, bucket_key)
	slider.value_changed.connect(_on_crown_allocation_bucket_changed.bind(bucket_key))
	root.add_child(slider)

	var help_line:= Label.new()
	help_line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	help_line.text = MainSceneHelpers._crown_allocation_bucket_help_line(bucket_key)
	help_line.add_theme_color_override("font_color", Color(0.78, 0.78, 0.74, 0.78))
	root.add_child(help_line)

	var buckets_raw: Variant = crown_hub_allocation_live_nodes.get("buckets", {})
	var buckets: Dictionary = buckets_raw if typeof(buckets_raw) == TYPE_DICTIONARY else {}
	buckets [bucket_key] = {
		"card": card,
		"title": title,
		"pct_label": pct_label,
		"amount_label": amount_label,
		"unit_line": unit_line,
		"slider": slider,
		"help_line": help_line,
		"unit_cost": unit_cost,
		"unit_label": unit_label
	}
	crown_hub_allocation_live_nodes ["buckets"] = buckets
func _append_crown_allocation_section(summary: Dictionary, permissions: Dictionary) -> void:
	if crown_hub_list == null:
		return
	var can_edit: bool = bool(permissions.get("can_manage_allocation", false))
	var realm: Dictionary = MainSceneLogic._resolve_player_realm_dict(gs)
	var current_year_locked: bool = int(realm.get("allocation_last_set_year", -1)) == int(gs.year)
	var editable: bool = can_edit and not current_year_locked
	var draft: Dictionary = _get_crown_allocation_draft(summary)
	var projection: Dictionary = MainSceneLogic._build_crown_allocation_projection(summary, realm, draft)
	var has_changes: bool = MainSceneLogic._crown_allocation_draft_has_changes(summary, realm, draft)
	var tax_rate: float = float(projection.get("tax_rate", 10.0))
	var treasury_pct: int = int(projection.get("treasury_pct", 34))
	var military_pct: int = int(projection.get("military_pct", 33))
	var goods_pct: int = int(projection.get("goods_pct", 33))
	var currency_name: String = str(summary.get("currency_name", "")).strip_edges()
	var happiness_delta: int = int(projection.get("happiness_delta", 0))
	var approval_delta: int = int(projection.get("approval_delta", 0))
	var respect_delta: int = int(projection.get("respect_delta", 0))
	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.size_flags_vertical = Control.SIZE_EXPAND_FILL
	crown_hub_list.add_child(card)
	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 16)
	margin.add_theme_constant_override("margin_right", 16)
	margin.add_theme_constant_override("margin_bottom", 16)
	card.add_child(margin)
	var root:= VBoxContainer.new()
	root.add_theme_constant_override("separation", 10)
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	margin.add_child(root)
	var title:= Label.new()
	title.text = "ALLOCATION"
	title.add_theme_font_size_override("font_size", 20)
	root.add_child(title)
	var tax_header:= HBoxContainer.new()
	tax_header.add_theme_constant_override("separation", 8)
	root.add_child(tax_header)
	var tax_label:= Label.new()
	tax_label.text = "Taxes: %d%%" % int(round(tax_rate))
	tax_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tax_header.add_child(tax_label)
	var happiness_label:= Label.new()
	happiness_label.text = "Happiness next year: %s%d • Approval: %s%d • Respect: %s%d" % [
		"+" if happiness_delta >= 0 else "",
		happiness_delta,
		"+" if approval_delta >= 0 else "",
		approval_delta,
		"+" if respect_delta >= 0 else "",
		respect_delta
	]
	tax_header.add_child(happiness_label)
	var tax_slider:= HSlider.new()
	tax_slider.min_value = 0
	tax_slider.max_value = 40
	tax_slider.step = 1
	tax_slider.value = tax_rate
	tax_slider.editable = editable
	tax_slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_crown_hub_style_slider(
		tax_slider,
		"tax_rate"
	)
	tax_slider.value_changed.connect(_on_crown_allocation_tax_changed)
	root.add_child(tax_slider)
	var revenue_label:= Label.new()
	revenue_label.text = "Total Tax Revenue: %s / yr" % _format_crown_treasury_label(int(projection.get("tax_revenue", 0)), currency_name)
	root.add_child(revenue_label)
	var pool_label:= Label.new()
	pool_label.text = "Saved Allocation Pool: %s" % _format_crown_treasury_label(int(projection.get("saved_reserve", 0)), currency_name)
	root.add_child(pool_label)
	var available_label:= Label.new()
	available_label.text = "Available To Allocate Right Now: %s" % _format_crown_treasury_label(int(projection.get("available_pool", 0)), currency_name)
	root.add_child(available_label)
	var next_year_header:= Label.new()
	next_year_header.text = "NEXT YEAR OUTPUT"
	next_year_header.add_theme_font_size_override("font_size", 16)
	root.add_child(next_year_header)
	var next_year_label:= Label.new()
	next_year_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	next_year_label.text = "Treasury +%s • Military +%s units • Goods +%s units • Carryover %s" % [
		_format_crown_treasury_label(int(projection.get("treasury_amount", 0)), currency_name),
		_crown_compact_number(float(projection.get("military_units", 0))),
		_crown_compact_number(float(projection.get("goods_units", 0))),
		_format_crown_treasury_label(int(projection.get("carryover_amount", 0)), currency_name)
	]
