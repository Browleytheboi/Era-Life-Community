func _queue_auxiliary_surface_observation_task(
	task_id: String,
	actor_id: int,
	reason: String,
	task_context: Dictionary = {}
) -> Dictionary:
	var clean_task_id: String = str(
		task_id
	).strip_edges().to_lower()

	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(gs.player.id) != actor_id
	):
		return {
			"success": false,
			"reason": "invalid_auxiliary_observation_actor",
			"task_id": clean_task_id,
			"actor_id": actor_id,
			"ui_is_expression_only": true
		}

	if clean_task_id not in [
		"pet_shop_surface",
		"compact_assets_surface",
		"asset_surface_deck",
		"property_destination_surface_deck",
		"property_market_surface",
		"property_destination_target"
	]:
		return {
			"success": false,
			"reason": "invalid_auxiliary_observation_task",
			"task_id": clean_task_id,
			"actor_id": actor_id,
			"ui_is_expression_only": true
		}

	var queue_raw: Variant = get_meta(
		"first_life_auxiliary_surface_residency_queue",
		[]
	)
	var existing_queue: Array = (
		(queue_raw as Array).duplicate(false)
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)
	var queue: Array = []
	var requested_row: Dictionary = {}
	var already_queued: bool = false
	var requested_property_id: int = int(
		task_context.get(
			"property_id",
			-1
		)
	)



	for raw_row in existing_queue:
		var row: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_row
		)
		var row_actor_id: int = int(
			row.get(
				"actor_id",
				-1
			)
		)
		var row_task_id: String = str(
			row.get(
				"task_id",
				""
			)
		).strip_edges().to_lower()
		var row_property_id: int = int(
			MainSceneHelpers._safe_dictionary(
				row.get(
					"task_context",
					{}
				)
			).get(
				"property_id",
				-1
			)
		)
		var same_task_identity: bool = (
			row_actor_id == actor_id
			and row_task_id == clean_task_id
			and (
				clean_task_id != "property_destination_target"
				or row_property_id == requested_property_id
			)
		)


		if (
			row_actor_id > 0
			and row_actor_id != actor_id
		):
			continue

		if same_task_identity:
			already_queued = true
			requested_row = row.duplicate(false)
			continue

		queue.append(
			row
		)

	if requested_row.is_empty():
		requested_row = {
			"task_id": clean_task_id,
			"actor_id": actor_id,
			"retry_count": 0,
			"reason": reason,
			"observation_requested": true,
			"observation_priority": true,
			"queued_at_ms": int(
				Time.get_ticks_msec()
			),
			"task_context": task_context.duplicate(false),
			"frame_safe_progressive": (
				clean_task_id in [
					"compact_assets_surface",
					"property_market_surface",
					"property_destination_target"
				]
			),
			"ready_gate_member": false,
			"ui_is_expression_only": true
		}

		if (
			clean_task_id
			== "property_destination_surface_deck"
		):
			requested_row [
				"cursor"
			] = 0

		if clean_task_id == "property_destination_target":
			requested_row [
				"target_phase"
			] = "interior"
	else:
		requested_row [
			"reason"
		] = reason
		requested_row [
			"observation_requested"
		] = true

	requested_row [
		"observation_priority"
	] = true
	requested_row [
		"observation_promoted_at_ms"
	] = int(
		Time.get_ticks_msec()
	)


	queue.push_front(
		requested_row
	)

	set_meta(
		"first_life_auxiliary_surface_residency_queue",
		queue
	)
	set_meta(
		"first_life_auxiliary_surface_residency_complete",
		false
	)
	set_meta(
		"auxiliary_surface_observation_last_task_id",
		clean_task_id
	)
	set_meta(
		"auxiliary_surface_observation_last_actor_id",
		actor_id
	)
	set_meta(
		"auxiliary_surface_observation_last_reason",
		reason
	)
	set_meta(
		"auxiliary_surface_observation_promoted_to_front",
		true
	)
	set_meta(
		"auxiliary_surface_observation_authority_work_performed",
		false
	)
	set_meta(
		"auxiliary_surface_observation_ready_gate_member",
		false
	)

	_arm_first_life_auxiliary_surface_residency(
		0.02
	)

	return {
		"success": true,
		"task_id": clean_task_id,
		"actor_id": actor_id,
		"queued": not already_queued,
		"already_queued": already_queued,
		"queue_size": queue.size(),
		"ready_gate_member": false,
		"ui_is_expression_only": true
	}
func _arm_first_life_auxiliary_surface_residency(
	delay_seconds: float = 0.04
) -> void:
	if bool(
		get_meta(
			"first_life_auxiliary_surface_residency_service_active",
			false
		)
	):
		return

	set_meta(
		"first_life_auxiliary_surface_residency_service_active",
		true
	)

	var tree: SceneTree = get_tree()

	if tree == null:
		call_deferred(
			"_service_first_life_auxiliary_surface_residency_with_input_priority"
		)
		return

	tree.create_timer(
		maxf(
			0.02,
			delay_seconds
		)
	).timeout.connect(
		Callable(
			self,
			"_service_first_life_auxiliary_surface_residency_with_input_priority"
		),
		CONNECT_ONE_SHOT
	)
func _service_first_life_auxiliary_surface_residency_with_input_priority() -> void:
	set_meta(
		"first_life_auxiliary_surface_residency_service_active",
		false
	)

	if (
		gs == null
		or gs.player == null
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var ui_interaction_active: bool = (
		_ui_interaction_grace_active(
			now_ms
		)
	)







	set_meta(
		"first_life_auxiliary_surface_residency_paused_for_interaction",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_interaction_grace_blocks_work",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_ui_concurrent",
		true
	)
	set_meta(
		"first_life_auxiliary_surface_residency_idle_required",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_ui_interaction_active",
		ui_interaction_active
	)
	set_meta(
		"first_life_auxiliary_surface_residency_input_priority_at_ms",
		now_ms
	)

	_service_first_life_auxiliary_surface_residency()
func _queue_auxiliary_surface_observation_after_visible_frame(
	task_id: String,
	actor_id: int,
	reason: String
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(gs.player.id) != actor_id
	):
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_queue_auxiliary_surface_observation_task",
			task_id,
			actor_id,
			reason
		)
		return

	var timer:= tree.create_timer(
		0.032
	)

	timer.timeout.connect(
		Callable(
			self,
			"_queue_auxiliary_surface_observation_task"
		).bind(
			task_id,
			actor_id,
			reason
		),
		CONNECT_ONE_SHOT
	)
func _prewarm_targeted_property_destination_quantum(
	target_actor: Person,
	property_id: int,
	property_owner_id: int,
	surface_kind: String,
	reason: String
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
		or property_id <= 0
	):
		return {}

	var actor_id: int = int(
		target_actor.id
	)
	var clean_surface_kind: String = str(
		surface_kind
	).strip_edges().to_lower()

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": (
				"property_destination_target_observation"
			),
			"surface_id": (
				"property_destination_deck"
			),
			"action_id": (
				"prewarm_property_space_surface"
			),
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"actor_id": actor_id,
				"property_owner_id": property_owner_id,
				"property_id": property_id,
				"surface_kind": clean_surface_kind,
				"source": reason,
				"prewarm_only": true,
				"read_only": true,
				"visible_click_work_forbidden": true,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"assets_contract_engine"
				),
				"method": (
					"prewarm_property_space_surface_for_actor"
				),
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": reason
		},
		{
			"actor_id": actor_id,
			"surface_id": (
				"property_destination_deck"
			),
			"action_id": (
				"prewarm_property_space_surface"
			),
			"source": reason,
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true
		}
	)

	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)
	var result: Dictionary = (
		(result_raw as Dictionary).duplicate(false)
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)

	if result.is_empty():
		return {}

	var property_key: String = str(
		property_id
	)

	var renderer_hot: bool = false

	if clean_surface_kind == "interior":
		var interior_raw: Variant = result.get(
			"property_space_surface_contract",
			{}
		)

		var interior: Dictionary = (
			interior_raw as Dictionary
			if typeof(interior_raw) == TYPE_DICTIONARY
			else {}
		)

		if not interior.is_empty():
			renderer_hot = (
				_prewarm_property_viewer_surface_deck_for_actor(
					target_actor,
					{
						property_key: interior
					}
				)
			)

		var interior_contract_hot: bool = bool(
			result.get(
				"interior_surface_hot",
				not interior.is_empty()
			)
		)

		var enter_and_view_hot: bool = (
			interior_contract_hot
			and renderer_hot
			and (
				_property_viewer_surface_panel_for(
					actor_id,
					property_id
				) != null
			)
		)



		if (
			assets_panel != null
			and is_instance_valid(
				assets_panel
			)
		):
			assets_panel.apply_progressive_surface_patch({
				"actor_id": actor_id,
				"patch_kind": "property_destination",
				"property_id": property_id,
				"enter_and_view_hot": (
					enter_and_view_hot
				),
				"interior_contract_hot": (
					interior_contract_hot
				),
				"interior_renderer_hot": (
					renderer_hot
				),
				"build_on_click": false,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			})

		result [
			"renderer_hot"
		] = renderer_hot
		result [
			"enter_and_view_hot"
		] = enter_and_view_hot
		result [
			"success"
		] = (
			bool(
				result.get(
					"success",
					false
				)
			)
			and renderer_hot
		)

	elif clean_surface_kind == "makeover":
		var makeover_raw: Variant = result.get(
			"property_makeover_surface_contract",
			{}
		)

		var makeover: Dictionary = (
			makeover_raw as Dictionary
			if typeof(makeover_raw) == TYPE_DICTIONARY
			else {}
		)

		if not makeover.is_empty():
			renderer_hot = (
				_prepaint_property_makeover_surface_deck_for_actor(
					target_actor,
					{
						property_key: makeover
					}
				)
			)

		result [
			"renderer_hot"
		] = renderer_hot
		result [
			"success"
		] = (
			bool(
				result.get(
					"success",
					false
				)
			)
			and renderer_hot
		)

	return result
func _service_first_life_auxiliary_surface_residency() -> void:
	set_meta(
		"first_life_auxiliary_surface_residency_service_active",
		false
	)

	if (
		gs == null
		or gs.player == null
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)




	if (
		bool(
			get_meta(
				"renderer_present_fence_active",
				false
			)
		)
		or bool(
			get_meta(
				"ready_button_door_drop_active",
				false
			)
		)
		or bool(
			get_meta(
				"ready_visual_reveal_active",
				false
			)
		)
	):
		set_meta(
			"first_life_auxiliary_surface_residency_paused_for_presentation",
			true
		)
		set_meta(
			"first_life_auxiliary_surface_residency_paused_for_interaction",
			false
		)
		set_meta(
			"first_life_auxiliary_surface_residency_paused_at_ms",
			now_ms
		)

		_arm_first_life_auxiliary_surface_residency(
			0.064
		)
		return

	set_meta(
		"first_life_auxiliary_surface_residency_paused_for_presentation",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_paused_for_interaction",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_interaction_grace_blocks_work",
		false
	)

	var queue_raw: Variant = get_meta(
		"first_life_auxiliary_surface_residency_queue",
		[]
	)
	var queue: Array = (
		(queue_raw as Array).duplicate(false)
		if typeof(queue_raw) == TYPE_ARRAY
		else []
	)

	if queue.is_empty():
		set_meta(
			"first_life_auxiliary_surface_residency_complete",
			true
		)
		set_meta(
			"first_life_auxiliary_surface_residency_completed_at_ms",
			now_ms
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"first_life_auxiliary_surface_residency_complete"
			] = true
			gs.scenario_state [
				"first_life_auxiliary_surface_residency_completed_at_ms"
			] = now_ms

		return

	var row: Dictionary = MainSceneHelpers._safe_dictionary(
		queue.pop_front()
	)
	var task_id: String = str(
		row.get(
			"task_id",
			""
		)
	).strip_edges().to_lower()
	var actor_id: int = int(
		row.get(
			"actor_id",
			-1
		)
	)
	var retry_count: int = int(
		row.get(
			"retry_count",
			0
		)
	)
	var retry_not_before_ms: int = int(
		row.get(
			"retry_not_before_ms",
			0
		)
	)
	var reason: String = str(
		row.get(
			"reason",
			"first_life_auxiliary_surface_residency"
		)
	)

	if (
		actor_id <= 0
		or actor_id != int(gs.player.id)
	):
		set_meta(
			"first_life_auxiliary_surface_residency_queue",
			queue
		)

		if not queue.is_empty():
			_arm_first_life_auxiliary_surface_residency(
				0.04
			)

		return

	if (
		retry_not_before_ms > 0
		and now_ms < retry_not_before_ms
	):
		queue.append(
			row
		)

		set_meta(
			"first_life_auxiliary_surface_residency_queue",
			queue
		)

		_arm_first_life_auxiliary_surface_residency(
			clampf(
				float(
					retry_not_before_ms - now_ms
				) / 1000.0,
				0.02,
				0.16
			)
		)
		return

	var quantum_started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var task_hot: bool = false
	var task_complete: bool = true
	var task_should_requeue: bool = false

	match task_id:
		"property_market_surface":
			var property_market_report: Dictionary = (
				_prewarm_property_market_surface_quantum_for_actor(
					gs.player,
					"%s_property_market_surface"
					% reason
				)
			)

			task_hot = bool(
				property_market_report.get(
					"success",
					false
				)
			)
			task_complete = bool(
				property_market_report.get(
					"complete",
					false
				)
			)
			task_should_requeue = (
				task_hot
				and not task_complete
			)

			if task_should_requeue:
				row [
					"frame_safe_progressive"
				] = true
				row [
					"retry_not_before_ms"
				] = now_ms + 16
		"pet_shop_surface":
			var pet_report: Dictionary = (
				_prewarm_compact_pet_shop_surface_for_actor(
					gs.player,
					"%s_pet_shop_surface"
					% reason
				)
			)
			task_hot = bool(
				pet_report.get(
					"success",
					false
				)
			)
			task_complete = task_hot

			if task_hot:
				set_meta(
					"first_life_pet_shop_contract_hot",
					true
				)
				set_meta(
					"first_life_pet_shop_card_stream_owned_by_panel",
					true
				)
		"property_destination_target":
			var task_context: Dictionary = MainSceneHelpers._safe_dictionary(
				row.get(
					"task_context",
					{}
				)
			)
			var property_id: int = int(
				task_context.get(
					"property_id",
					-1
				)
			)
			var property_owner_id: int = int(
				task_context.get(
					"property_owner_id",
					actor_id
				)
			)
			var target_phase: String = str(
				row.get(
					"target_phase",
					"interior"
				)
			)

			var target_report: Dictionary = (
				_prewarm_targeted_property_destination_quantum(
					gs.player,
					property_id,
					property_owner_id,
					target_phase,
					"%s_property_%d_%s"
					% [
						reason,
						property_id,
						target_phase
					]
				)
			)

			task_hot = bool(
				target_report.get(
					"success",
					false
				)
			)

			if (
				target_phase == "interior"
				and task_hot
			):
				row [
					"target_phase"
				] = "makeover"
				task_complete = false
				task_should_requeue = true
			elif (
				target_phase == "makeover"
				and task_hot
			):
				task_complete = true
				task_should_requeue = false
			else:
				task_complete = false
				task_should_requeue = true

			row [
				"frame_safe_progressive"
			] = true
			row [
				"retry_not_before_ms"
			] = now_ms + 16
		"compact_assets_surface":
			var assets_report: Dictionary = (
				_prewarm_compact_assets_surface_for_actor(
					gs.player,
					"%s_compact_assets_surface"
					% reason
				)
			)

			task_hot = bool(
				assets_report.get(
					"success",
					false
				)
			)
			task_complete = bool(
				assets_report.get(
					"complete",
					false
				)
			)
			task_should_requeue = (
				task_hot
				and not task_complete
			)

			if task_should_requeue:
				row [
					"retry_not_before_ms"
				] = now_ms + 16
				row [
					"frame_safe_progressive"
				] = true
				row [
					"retry_count"
				] = retry_count

		"asset_surface_deck":
			var deck_report: Dictionary = (
				_prewarm_asset_surface_deck_for_actor(
					gs.player,
					"%s_asset_surface_deck"
					% reason,
					false
				)
			)



			task_hot = (
				not deck_report.is_empty()
				and _asset_surface_pack_has_authoritative_market_truth(
					deck_report,
					actor_id
				)
			)
			task_complete = task_hot
			task_should_requeue = not task_complete

			set_meta(
				"first_life_asset_surface_deck_packet_present",
				not deck_report.is_empty()
			)
			set_meta(
				"first_life_asset_surface_deck_authoritative_hot",
				task_hot
			)
			set_meta(
				"first_life_asset_surface_deck_retry_required",
				not task_complete
			)

			if task_hot:
				set_meta(
					"first_life_asset_market_streams_owned_by_panels",
					true
				)

		"property_destination_surface_deck":
			var cursor: int = maxi(
				0,
				int(
					row.get(
						"cursor",
						0
					)
				)
			)
			var property_surface_report: Dictionary = (
				_prewarm_next_property_space_contract_for_actor(
					gs.player,
					cursor,
					(
						"%s_property_destination_surface_deck"
						% reason
					)
				)
			)
			task_hot = bool(
				property_surface_report.get(
					"success",
					false
				)
			)
			task_complete = bool(
				property_surface_report.get(
					"complete",
					false
				)
			)
			row [
				"cursor"
			] = int(
				property_surface_report.get(
					"next_cursor",
					cursor
				)
			)
			row [
				"property_destination_surface_report"
			] = property_surface_report.duplicate(
				false
			)
			row [
				"property_destination_surface_last_step_at_ms"
			] = now_ms

			set_meta(
				"first_life_property_destination_surface_deck_hot",
				task_complete
			)
			set_meta(
				"first_life_property_destination_surface_deck_cursor",
				int(
					row.get(
						"cursor",
						0
					)
				)
			)
			set_meta(
				"first_life_property_destination_surface_deck_build_on_click",
				false
			)
			set_meta(
				"first_life_property_destination_surface_deck_ready_gate_member",
				false
			)

			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state [
					"first_life_property_destination_surface_deck_hot"
				] = task_complete
				gs.scenario_state [
					"first_life_property_destination_surface_deck_cursor"
				] = int(
					row.get(
						"cursor",
						0
					)
				)
				gs.scenario_state [
					"first_life_property_destination_surface_deck_build_on_click"
				] = false
				gs.scenario_state [
					"first_life_property_destination_surface_deck_ready_gate_member"
				] = false

			if not task_complete:
				task_should_requeue = true

		_:
			task_hot = true
			task_complete = true

	if (
		not task_complete
		and retry_count < 120
	):
		row [
			"retry_count"
		] = retry_count + 1
		row [
			"last_retry_at_ms"
		] = now_ms
		if bool(
			row.get(
				"frame_safe_progressive",
				false
			)
		):
			row [
				"retry_not_before_ms"
			] = now_ms + 16
		else:
			row [
				"retry_not_before_ms"
			] = now_ms + clampi(
				64 + retry_count * 8,
				64,
				320
			)

		if not task_should_requeue:
			task_should_requeue = true

		if task_should_requeue:
			queue.append(
				row
			)

	set_meta(
		"first_life_auxiliary_surface_residency_queue",
		queue
	)
	set_meta(
		"first_life_auxiliary_surface_residency_last_task",
		task_id
	)
	set_meta(
		"first_life_auxiliary_surface_residency_last_task_hot",
		task_hot
	)
	set_meta(
		"first_life_auxiliary_surface_residency_last_task_complete",
		task_complete
	)
	set_meta(
		"first_life_auxiliary_surface_residency_last_task_at_ms",
		now_ms
	)
	set_meta(
		"first_life_auxiliary_surface_residency_ready_gate_member",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_click_path_work",
		false
	)
	set_meta(
		"first_life_auxiliary_surface_residency_interaction_starvation_forbidden",
		true
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_last_task"
		] = task_id
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_last_task_hot"
		] = task_hot
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_last_task_complete"
		] = task_complete
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_remaining"
		] = queue.size()
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_ready_gate_member"
		] = false
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_click_path_work"
		] = false
		gs.scenario_state [
			"first_life_auxiliary_surface_residency_interaction_starvation_forbidden"
		] = true

	if not queue.is_empty():
		var quantum_elapsed_ms: int = maxi(
			0,
			int(
				Time.get_ticks_msec()
			) - quantum_started_at_ms
		)
		var next_delay: float = clampf(
			maxf(
				0.04,
				float(
					quantum_elapsed_ms
				) / 1000.0 * 2.5
			),
			0.04,
			0.32
		)

		_arm_first_life_auxiliary_surface_residency(
			next_delay
		)
	else:
		set_meta(
			"first_life_auxiliary_surface_residency_complete",
			true
		)
		set_meta(
			"first_life_auxiliary_surface_residency_completed_at_ms",
			now_ms
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"first_life_auxiliary_surface_residency_complete"
			] = true
			gs.scenario_state [
				"first_life_auxiliary_surface_residency_completed_at_ms"
			] = now_ms
func _prewarm_compact_assets_surface_for_actor(
	target_actor: Person,
	reason: String = "compact_assets_surface_prewarm"
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
	):
		return {}

	_ensure_assets_panel()

	if (
		assets_panel == null
		or not is_instance_valid(
			assets_panel
		)
	):
		return {}

	var target_actor_id: int = int(
		target_actor.id
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": target_actor_id,
			"target_id": target_actor_id,
			"intent_type": "observe_assets_surface_quantum",
			"surface_id": "assets_contract_panel",
			"action_id": "service_actor_portfolio_observation_quantum",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"actor_id": target_actor_id,
				"source": reason,
				"force_rebuild": false,
				"prewarm_only": true,
				"visible_click_work_forbidden": true,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "assets_contract_engine",
				"method": "service_actor_portfolio_observation_quantum",
				"pass_actor_payload": true,
				"actor_id": target_actor_id
			},
			"source": reason
		},
		{
			"actor_id": target_actor_id,
			"target_id": target_actor_id,
			"surface_id": "assets_contract_panel",
			"action_id": "service_actor_portfolio_observation_quantum",
			"source": reason,
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"ready_gate_member": false
		}
	)

	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)
	var quantum: Dictionary = (
		(result_raw as Dictionary).duplicate(false)
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)

	if quantum.is_empty():
		return {}

	var patch_raw: Variant = quantum.get(
		"surface_patch",
		{}
	)

	if (
		typeof(patch_raw) == TYPE_DICTIONARY
		and not (patch_raw as Dictionary).is_empty()
	):
		var patch: Dictionary = (
			patch_raw as Dictionary
		)
		var patch_kind: String = str(
			patch.get(
				"patch_kind",
				""
			)
		).strip_edges().to_lower()

		if patch_kind == "property_row":
			var property_row: Dictionary = MainSceneHelpers._safe_dictionary(
				patch.get(
					"property_row",
					{}
				)
			)
			var property_id: int = int(
				property_row.get(
					"property_id",
					property_row.get(
						"asset_id",
						-1
					)
				)
			)
			var property_owner_id: int = int(
				property_row.get(
					"owner_id",
					target_actor_id
				)
			)

			if property_id > 0:
				_queue_auxiliary_surface_observation_task(
					"property_destination_target",
					target_actor_id,
					(
						"%s_property_%d_destination"
						% [
							reason,
							property_id
						]
					),
					{
						"property_id": property_id,
						"property_owner_id": (
							property_owner_id
						)
					}
				)

		assets_panel.actor = target_actor
		assets_panel.apply_progressive_surface_patch(
			patch
		)

	var complete: bool = bool(
		quantum.get(
			"complete",
			false
		)
	)

	if complete:
		var surface_raw: Variant = quantum.get(
			"assets_surface_contract",
			{}
		)
		var surface_contract: Dictionary = (
			(surface_raw as Dictionary).duplicate(false)
			if typeof(surface_raw) == TYPE_DICTIONARY
			else {}
		)

		if not surface_contract.is_empty():
			var portfolio_cache_key: String = (
				"%s|portfolio_only"
				% _asset_surface_pack_cache_key(
					target_actor
				)
			)
			var portfolio_pack: Dictionary = {
				"success": true,
				"actor_id": target_actor_id,
				"actor_age": int(
					target_actor.age
				),
				"bank_balance": int(
					target_actor.bank_balance
				),
				"year": int(
					gs.year
				),
				"assets_surface_contract": surface_contract,
				"surface_pack_scope": "portfolio_only",
				"visible_click_work_required": false,
				"prewarmed": true,
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			}

			asset_surface_pack_by_actor [
				portfolio_cache_key
			] = portfolio_pack

	set_meta(
		"compact_assets_surface_quantum_complete",
		complete
	)
	set_meta(
		"compact_assets_surface_quantum_phase",
		str(
			quantum.get(
				"phase",
				"complete"
			)
		)
	)
	set_meta(
		"compact_assets_surface_one_observable_unit_per_quantum",
		true
	)
	set_meta(
		"compact_assets_surface_ui_blocking_work_forbidden",
		true
	)

	return quantum
func _continue_prewarm_native_main_tab_surfaces_for_ready_room(
	tasks: Array,
	index: int = 0,
	reason: String = "ready_room_tab_surface_prewarm",
	retry_count: int = 0
) -> void:
	if index >= tasks.size():
		var shell_failures: Array = []
		var required_failures: Array = []
		var background_failures: Array = []

		var shell_raw: Variant = get_meta(
			"ready_room_native_tab_renderable_failures",
			[]
		)
		var required_raw: Variant = get_meta(
			"ready_room_native_tab_required_truth_failures",
			[]
		)
		var background_raw: Variant = get_meta(
			"ready_room_background_truth_failures",
			[]
		)

		if typeof(shell_raw) == TYPE_ARRAY:
			shell_failures = (
				shell_raw as Array
			).duplicate()

		if typeof(required_raw) == TYPE_ARRAY:
			required_failures = (
				required_raw as Array
			).duplicate()

		if typeof(background_raw) == TYPE_ARRAY:
			background_failures = (
				background_raw as Array
			).duplicate()

		var actor_bound_hot: bool = (
			shell_failures.is_empty()
			and required_failures.is_empty()
		)
		var completion_now_ms: int = int(
			Time.get_ticks_msec()
		)

		set_meta(
			"ready_room_native_tab_surface_prewarm_active",
			false
		)
		set_meta(
			"ready_room_native_tab_surface_prewarm_complete",
			actor_bound_hot
		)
		set_meta(
			"ready_room_native_tab_renderable_complete",
			actor_bound_hot
		)
		set_meta(
			"ready_room_actor_bound_surfaces_hot",
			actor_bound_hot
		)
		set_meta(
			"ready_room_native_tab_surface_prewarm_cursor",
			tasks.size()
		)
		set_meta(
			"ready_room_native_tab_shells_complete_at_ms",
			completion_now_ms
		)
		set_meta(
			"ready_room_background_truth_pending",
			false
		)
		set_meta(
			"ready_room_background_truth_complete",
			true
		)
		set_meta(
			"ready_room_background_truth_complete_at_ms",
			completion_now_ms
		)
		set_meta(
			"ready_room_background_truth_degraded",
			not background_failures.is_empty()
		)
		set_meta(
			"ready_room_native_tab_tail_does_not_block_ready",
			true
		)

		if (
			gs != null
			and typeof(gs.scenario_state) == TYPE_DICTIONARY
		):
			gs.scenario_state [
				"ready_room_native_tab_surface_prewarm_active"
			] = false
			gs.scenario_state [
				"ready_room_native_tab_surface_prewarm_complete"
			] = actor_bound_hot
			gs.scenario_state [
				"ready_room_native_tab_renderable_complete"
			] = actor_bound_hot
			gs.scenario_state [
				"ready_room_actor_bound_surfaces_hot"
			] = actor_bound_hot
			gs.scenario_state [
				"ready_room_native_tab_renderable_failures"
			] = shell_failures.duplicate()
			gs.scenario_state [
				"ready_room_native_tab_required_truth_failures"
			] = required_failures.duplicate()
			gs.scenario_state [
				"ready_room_background_truth_failures"
			] = background_failures.duplicate()
			gs.scenario_state [
				"ready_room_background_truth_pending"
			] = false
			gs.scenario_state [
				"ready_room_background_truth_complete"
			] = true
			gs.scenario_state [
				"ready_room_background_truth_degraded"
			] = not background_failures.is_empty()
			gs.scenario_state [
				"ready_room_native_tab_tail_does_not_block_ready"
			] = true
			gs.scenario_state [
				"population_lens_truth_remains_background"
			] = true



		for raw_failure in shell_failures + required_failures:
			var failed_task: String = str(
				raw_failure
			).strip_edges().to_lower()
			var panel_id: String = failed_task

			if panel_id.begins_with("shell::"):
				panel_id = panel_id.trim_prefix(
					"shell::"
				)
			elif panel_id.begins_with("truth::"):
				panel_id = panel_id.trim_prefix(
					"truth::"
				)

			if panel_id.contains("::"):
				panel_id = str(
					panel_id.split(
						"::"
					) [0]
				)

			if panel_id in [
				"life",
				"world",
				"relationships",
				"school",
				"career",
				"activities",
				"mods"
			]:
				_request_native_main_tab_surface_prewarm_idle(
					panel_id,
					"%s_tail_reconcile_%s" % [
						reason,
						panel_id
					]
				)

		return

	var prewarm_tree:= get_tree()
	var service_now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		_ui_interaction_grace_active(
			service_now_ms
		)
		or _post_spawn_ui_is_busy_for_prewarm()
	):
		if prewarm_tree == null:
			call_deferred(
				"_continue_prewarm_native_main_tab_surfaces_for_ready_room",
				tasks,
				index,
				reason,
				retry_count
			)
			return

		var grace_timer:= prewarm_tree.create_timer(
			0.12
		)
		grace_timer.timeout.connect(
			Callable(
				self,
				"_continue_prewarm_native_main_tab_surfaces_for_ready_room"
			).bind(
				tasks,
				index,
				reason,
				retry_count
			),
			CONNECT_ONE_SHOT
		)
		return

	var task_id: String = str(
		tasks [index]
	).strip_edges().to_lower()
	var task_hot: bool = false

	if task_id.begins_with("shell::"):
		var shell_panel_id: String = task_id.trim_prefix(
			"shell::"
		)
		var shell_report: Dictionary = (
			_prewarm_native_main_tab_shell(
				shell_panel_id,
				"%s_shell_%s" % [
					reason,
					shell_panel_id
				]
			)
		)

		task_hot = bool(
			shell_report.get(
				"success",
				false
			)
		)

	elif task_id.begins_with("truth::"):
		var truth_task_id: String = task_id.trim_prefix(
			"truth::"
		)

		task_hot = _prime_ready_room_required_surface(
			truth_task_id,
			"%s_truth_%s" % [
				reason,
				truth_task_id.replace(
					"::",
					"_"
				)
			]
		)

	elif task_id == "compact_assets_surface":
		if (
			gs != null
			and gs.player != null
		):
			var compact_assets_report: Dictionary = (
				_prewarm_compact_assets_surface_for_actor(
					gs.player,
					"%s_compact_assets_surface" % reason
				)
			)
			task_hot = not compact_assets_report.is_empty()

	elif task_id == "asset_surface_deck":
		if (
			gs != null
			and gs.player != null
		):
			var asset_report: Dictionary = (
				_prewarm_asset_surface_deck_for_actor(
					gs.player,
					"%s_asset_surface_deck" % reason,
					false
				)
			)
			task_hot = not asset_report.is_empty()

	elif task_id == "artifact_observability":
		var artifact_report: Dictionary = (
			_request_artifact_observability_contract(
				"%s_artifact_observability" % reason
			)
		)

		task_hot = (
			not artifact_report.is_empty()
			and not artifact_observability_contract.is_empty()
			and bool(
				artifact_observability_contract.get(
					"projection_composed",
					false
				)
			)
		)

	elif task_id == "artifact_shop":
		task_hot = _prime_artifact_shop_surface(
			"%s_artifact_shop" % reason
		)

	set_meta(
		"ready_room_background_truth_last_task",
		task_id
	)
	set_meta(
		"ready_room_background_truth_last_index",
		index
	)
	set_meta(
		"ready_room_background_truth_last_retry_count",
		retry_count
	)
	set_meta(
		"ready_room_background_truth_last_hot",
		task_hot
	)
	set_meta(
		"ready_room_background_truth_last_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"ready_room_native_tab_surface_prewarm_cursor",
		index
	)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"ready_room_native_tab_surface_prewarm_cursor"
		] = index
		gs.scenario_state [
			"ready_room_native_tab_surface_prewarm_current_task"
		] = task_id
		gs.scenario_state [
			"ready_room_native_tab_surface_prewarm_current_retry"
		] = retry_count


	if not task_hot and retry_count < 1:
		if prewarm_tree == null:
			call_deferred(
				"_continue_prewarm_native_main_tab_surfaces_for_ready_room",
				tasks,
				index,
				reason,
				retry_count + 1
			)
			return

		prewarm_tree.process_frame.connect(
			Callable(
				self,
				"_continue_prewarm_native_main_tab_surfaces_for_ready_room"
			).bind(
				tasks,
				index,
				reason,
				retry_count + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	if not task_hot:
		if task_id.begins_with("shell::"):
			var shell_failures: Array = []
			var shell_raw: Variant = get_meta(
				"ready_room_native_tab_renderable_failures",
				[]
			)

			if typeof(shell_raw) == TYPE_ARRAY:
				shell_failures = (
					shell_raw as Array
				).duplicate()

			if not shell_failures.has(task_id):
				shell_failures.append(
					task_id
				)

			set_meta(
				"ready_room_native_tab_renderable_failures",
				shell_failures
			)

		elif task_id.begins_with("truth::"):
			var required_failures: Array = []
			var required_raw: Variant = get_meta(
				"ready_room_native_tab_required_truth_failures",
				[]
			)

			if typeof(required_raw) == TYPE_ARRAY:
				required_failures = (
					required_raw as Array
				).duplicate()

			if not required_failures.has(task_id):
				required_failures.append(
					task_id
				)

			set_meta(
				"ready_room_native_tab_required_truth_failures",
				required_failures
			)

		else:
			var background_failures: Array = []
			var background_raw: Variant = get_meta(
				"ready_room_background_truth_failures",
				[]
			)

			if typeof(background_raw) == TYPE_ARRAY:
				background_failures = (
					background_raw as Array
				).duplicate()

			if not background_failures.has(task_id):
				background_failures.append(
					task_id
				)

			set_meta(
				"ready_room_background_truth_failures",
				background_failures
			)

		set_meta(
			"ready_room_background_truth_degraded",
			true
		)
		set_meta(
			"ready_room_background_truth_degraded_task",
			task_id
		)

	var next_index: int = index + 1

	if prewarm_tree == null:
		call_deferred(
			"_continue_prewarm_native_main_tab_surfaces_for_ready_room",
			tasks,
			next_index,
			reason,
			0
		)
		return


	prewarm_tree.process_frame.connect(
		Callable(
			self,
			"_continue_prewarm_native_main_tab_surfaces_for_ready_room"
		).bind(
			tasks,
			next_index,
			reason,
			0
		),
		CONNECT_ONE_SHOT
	)
func _institution_hub_rendered_surface_kind() -> String:
	if institution_hub_overlay == null or not is_instance_valid(institution_hub_overlay):
		return ""

	var rendered_kind: String = str(institution_hub_overlay.get_meta("institution_hub_rendered_kind", "")).strip_edges().to_lower()
	if rendered_kind != "":
		return rendered_kind

	return str(institution_hub_kind).strip_edges().to_lower()


func _institution_hub_rendered_surface_section() -> String:
	if institution_hub_overlay == null or not is_instance_valid(institution_hub_overlay):
		return ""

	var rendered_section: String = str(institution_hub_overlay.get_meta("institution_hub_rendered_section", "")).strip_edges().to_lower()
	if rendered_section != "":
		return rendered_section

	return str(institution_hub_current_section).strip_edges().to_lower()


func _institution_hub_surface_is_owned_by(kind: String, section: String = "") -> bool:
	var clean_kind: String = str(kind).strip_edges().to_lower()
	var clean_section: String = str(section).strip_edges().to_lower()

	if clean_kind == "":
		return false

	if institution_hub_overlay == null or not is_instance_valid(institution_hub_overlay):
		return false

	if institution_hub_list == null or not is_instance_valid(institution_hub_list):
		return false

	if institution_hub_list.get_child_count() <= 0:
		return false

	var rendered_kind: String = _institution_hub_rendered_surface_kind()
	var rendered_section: String = _institution_hub_rendered_surface_section()

	if rendered_kind != clean_kind:
		return false

	match clean_kind:
		"relationships":
			return _relationship_hub_surface_has_rendered_cards()

		"career", "school":
			if clean_section == "":
				clean_section = "overview"
			return rendered_section == clean_section or rendered_section == "overview"

		_:
			return false


func _mark_institution_hub_rendered_surface_owner(kind: String, section: String, reason: String = "institution_hub_rendered_owner") -> void:
	var clean_kind: String = str(kind).strip_edges().to_lower()
	var clean_section: String = str(section).strip_edges().to_lower()

	if clean_kind == "":
		return
	if clean_section == "":
		clean_section = "overview"

	set_meta("institution_hub_rendered_surface_kind", clean_kind)
	set_meta("institution_hub_rendered_surface_section", clean_section)
	set_meta("institution_hub_rendered_surface_reason", reason)
	set_meta("institution_hub_rendered_surface_at_ms", int(Time.get_ticks_msec()))

	if institution_hub_overlay != null and is_instance_valid(institution_hub_overlay):
		institution_hub_overlay.set_meta("institution_hub_rendered_kind", clean_kind)
		institution_hub_overlay.set_meta("institution_hub_rendered_section", clean_section)
		institution_hub_overlay.set_meta("institution_hub_rendered_reason", reason)
		institution_hub_overlay.set_meta("institution_hub_rendered_at_ms", int(Time.get_ticks_msec()))

	if institution_hub_list != null and is_instance_valid(institution_hub_list):
		institution_hub_list.set_meta("institution_hub_rendered_kind", clean_kind)
		institution_hub_list.set_meta("institution_hub_rendered_section", clean_section)
		institution_hub_list.set_meta("institution_hub_rendered_reason", reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["institution_hub_rendered_surface_kind"] = clean_kind
		gs.scenario_state ["institution_hub_rendered_surface_section"] = clean_section
		gs.scenario_state ["institution_hub_rendered_surface_reason"] = reason
func _career_hub_contract_is_hot(
	contract: Dictionary,
	actor_id: int = -1
) -> bool:
	if contract.is_empty():
		return false

	if not bool(
		contract.get(
			"success",
			false
		)
	):
		return false

	if str(
		contract.get(
			"schema",
			""
		)
	).strip_edges() != "eralife.career_hub_contract":
		return false

	if (
		actor_id > 0
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	var truth_state: String = str(
		contract.get(
			"truth_state",
			""
		)
	).strip_edges().to_lower()

	if truth_state not in [
		"hot",
		"authoritative_hot"
	]:
		return false

	if MainSceneHelpers._safe_array(
		contract.get(
			"section_tabs",
			[]
		)
	).is_empty():
		return false

	if MainSceneHelpers._safe_array(
		contract.get(
			"overview_cards",
			[]
		)
	).is_empty():
		return false

	if MainSceneHelpers._safe_dictionary(
		contract.get(
			"identity_overview",
			{}
		)
	).is_empty():
		return false

	return true


func _native_main_tab_surface_is_hot(
		panel_id: String,
		section_id: String = ""
) -> bool:
	var clean_spec: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_spec == "":
		return false

	var parts: PackedStringArray = clean_spec.split(
		"::"
	)
	var clean_panel: String = str(
		parts [0]
	).strip_edges().to_lower()
	var clean_section: String = str(
		section_id
	).strip_edges().to_lower()

	if (
		clean_section == ""
		and parts.size() >= 2
	):
		clean_section = str(
			parts [1]
		).strip_edges().to_lower()

	if clean_section == "":
		clean_section = (
			"family"
			if clean_panel == "relationships"
			else "overview"
		)

	match clean_panel:
		"life":
			return (
				output_label != null
				and is_instance_valid(
					output_label
				)
			)

		"world":
			return (
				world_feed_popup != null
				and is_instance_valid(
					world_feed_popup
				)
				and world_feed_popup_feed != null
				and is_instance_valid(
					world_feed_popup_feed
				)
			)

		"activities":
			return (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
				and activities_hub_panel.has_hot_contract(
					(
						int(
							gs.player.id
						)
						if (
							gs != null
							and gs.player != null
						)
						else -1
					)
				)
			)

		"career":
			return (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
				and _career_hub_contract_is_hot(
					career_hub_panel.active_contract,
					(
						int(
							gs.player.id
						)
						if (
							gs != null
							and gs.player != null
						)
						else -1
					)
				)
			)

		"mods":
			return (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and mod_menu_panel.has_hot_contract(
					(
						int(
							gs.player.id
						)
						if (
							gs != null
							and gs.player != null
						)
						else -1
					)
				)
			)

		"crime":
			if (
				gs == null
				or gs.player == null
			):
				return false

			return (
				crime_panel != null
				and is_instance_valid(
					crime_panel
				)
				and crime_panel.has_renderable_contract(
					int(
						gs.player.id
					)
				)
			)

		"relationships":
			if (
				gs == null
				or gs.player == null
			):
				return false



			return (
				relationship_hub_panel != null
				and is_instance_valid(
					relationship_hub_panel
				)
				and relationship_hub_panel.has_renderable_contract(
					int(
						gs.player.id
					)
				)
			)

		"school":
			if (
				gs == null
				or gs.player == null
			):
				return false



			return (
				school_hub_panel != null
				and is_instance_valid(
					school_hub_panel
				)
				and school_hub_panel.has_renderable_contract(
					int(
						gs.player.id
					)
				)
			)

		_:
			return false
