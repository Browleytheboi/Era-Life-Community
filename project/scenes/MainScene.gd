func _install_institution_hub_surface(
	surface: Dictionary
) -> bool:
	if (
		surface.is_empty()
		or gs == null
		or gs.player == null
	):
		return false

	var controlled_actor_id: int = int(
		gs.player.id
	)
	var surface_actor_id: int = int(
		surface.get(
			"actor_id",
			-1
		)
	)
	var current_world_lens_key: String = str(
		_world_seed_ui_lens_key()
	).strip_edges()
	var surface_world_lens_key: String = str(
		surface.get(
			"world_lens_key",
			""
		)
	).strip_edges()

	if current_world_lens_key == "":
		current_world_lens_key = "unbound"

	if (
		surface_actor_id != controlled_actor_id
		or surface_world_lens_key
		!= current_world_lens_key
	):
		set_meta(
			"institution_surface_install_rejected_stale_viewpoint",
			true
		)
		set_meta(
			"institution_surface_install_rejected_actor_id",
			surface_actor_id
		)
		set_meta(
			"institution_surface_install_expected_actor_id",
			controlled_actor_id
		)
		set_meta(
			"institution_surface_install_rejected_lens_key",
			surface_world_lens_key
		)
		set_meta(
			"institution_surface_install_expected_lens_key",
			current_world_lens_key
		)
		return false

	var overlay: Control = surface.get(
		"overlay",
		null
	) as Control

	if (
		overlay == null
		or not is_instance_valid(
			overlay
		)
	):
		return false

	institution_hub_overlay = overlay
	institution_hub_dim = surface.get(
		"dim",
		null
	) as ColorRect
	institution_hub_card = surface.get(
		"card",
		null
	) as PanelContainer
	institution_hub_back_button = surface.get(
		"back_button",
		null
	) as Button
	institution_hub_title = surface.get(
		"title",
		null
	) as Label
	institution_hub_header_chip = surface.get(
		"header_chip",
		null
	) as PanelContainer
	institution_hub_header_chip_label = (
		surface.get(
			"header_chip_label",
			null
		) as Label
	)
	institution_hub_section_bar = surface.get(
		"section_bar",
		null
	) as GridContainer

	var raw_section_buttons: Variant = surface.get(
		"section_buttons",
		{}
	)
	institution_hub_section_buttons = (
		raw_section_buttons
		if typeof(
			raw_section_buttons
		) == TYPE_DICTIONARY
		else {}
	)

	institution_hub_summary_label = surface.get(
		"summary_label",
		null
	) as RichTextLabel
	institution_hub_scroll = surface.get(
		"scroll",
		null
	) as ScrollContainer
	institution_hub_list = surface.get(
		"list",
		null
	) as VBoxContainer
	institution_hub_status_label = surface.get(
		"status_label",
		null
	) as Label

	var raw_experience_rows: Variant = surface.get(
		"experience_rows",
		[]
	)
	institution_hub_experience_rows = (
		raw_experience_rows
		if typeof(
			raw_experience_rows
		) == TYPE_ARRAY
		else []
	)

	institution_hub_experience_breathe_time = float(
		surface.get(
			"experience_breathe_time",
			0.0
		)
	)
	institution_hub_scroll_last_vertical = int(
		surface.get(
			"scroll_last_vertical",
			-1
		)
	)
	institution_hub_scroll_fade_hold = float(
		surface.get(
			"scroll_fade_hold",
			0.0
		)
	)
	institution_hub_kind = str(
		surface.get(
			"kind",
			""
		)
	)
	institution_hub_current_section = str(
		surface.get(
			"section",
			"overview"
		)
	)
	institution_hub_active_surface_key = str(
		surface.get(
			"surface_key",
			""
		)
	)

	set_meta(
		"institution_surface_installed_actor_id",
		controlled_actor_id
	)
	set_meta(
		"institution_surface_installed_world_lens_key",
		current_world_lens_key
	)
	set_meta(
		"institution_surface_install_rejected_stale_viewpoint",
		false
	)

	return true


