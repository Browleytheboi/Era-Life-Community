) -> Dictionary:
	if (
		gs == null
		or actor_id <= 0
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return {}

	var resident_cache: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"resident_pet_shop_surface_contract_by_actor",
			{}
		)
	)

	if resident_cache.is_empty():
		return {}

	var direct_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		resident_cache.get(
			MainSceneLogic._pet_shop_actor_cache_key(gs, 
				actor_id
			),
			resident_cache.get(
				str(actor_id),
				{}
			)
		)
	)

	if (
		not direct_contract.is_empty()
		and bool(
			direct_contract.get(
				"success",
				false
			)
		)
		and int(
			direct_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
		and str(
			direct_contract.get(
				"schema",
				""
			)
		) == "eralife.pet_shop.surface_contract"
		and not MainSceneHelpers._safe_array(
			direct_contract.get(
				"listings",
				[]
			)
		).is_empty()
	):
		return direct_contract

	var queue: Array = [
		resident_cache.duplicate(true)
	]
	var cursor_index: int = 0
	var visited_signatures: Dictionary = {}

	while (
		cursor_index < queue.size()
		and cursor_index < 192
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue [cursor_index]
		)
		cursor_index += 1

		if cursor.is_empty():
			continue

		var cursor_signature: String = str(
			hash(cursor)
		)

		if visited_signatures.has(
			cursor_signature
		):
			continue

		visited_signatures [
			cursor_signature
		] = true

		if (
			bool(
				cursor.get(
					"success",
					false
				)
			)
			and int(
				cursor.get(
					"actor_id",
					-1
				)
			) == actor_id
			and str(
				cursor.get(
					"schema",
					""
				)
			) == "eralife.pet_shop.surface_contract"
			and not MainSceneHelpers._safe_array(
				cursor.get(
					"listings",
					[]
				)
			).is_empty()
		):
			return cursor.duplicate(true)

		for raw_value in cursor.values():
			if typeof(raw_value) == TYPE_DICTIONARY:
				var nested: Dictionary = (
					raw_value as Dictionary
				).duplicate(true)

				if not nested.is_empty():
					queue.append(
						nested
					)

			elif typeof(raw_value) == TYPE_ARRAY:
				for raw_entry in raw_value as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(true)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

	return {}
