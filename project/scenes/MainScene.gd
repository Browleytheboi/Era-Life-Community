func _result_crosses_life_boundary(result: Dictionary) -> bool:
	if typeof(result) != TYPE_DICTIONARY:
		return false

	var result_type: String = str(result.get("type", "")).strip_edges()
	if result_type.begins_with("afterlife"):
		return true
	if result_type in [
		"no_descendants",
		"afterlife_exit_random_life",
		"afterlife_exit_custom_life",
		"afterlife_reincarnated",
		"player_line_birth_naming_form"
	]:
		return true

	var followup_raw: Variant = result.get("followup_result", {})
	if typeof(followup_raw) == TYPE_DICTIONARY:
		var followup: Dictionary = followup_raw
		if not followup.is_empty() and _result_crosses_life_boundary(followup):
			return true

	if gs != null and bool(gs.awaiting_new_life):
		if gs.player == null:
			return true
		if not gs.player.alive:
			return true

	return false
