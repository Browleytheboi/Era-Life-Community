	set_meta("rick_weapon_shop_click_contract_emit_deferred", true)
	set_meta("rick_weapon_shop_click_sync_hud_update_forbidden", true)
	set_meta("rick_weapon_shop_click_at_ms", int(Time.get_ticks_msec()))

	set_meta("rick_weapon_shop_mode", "outside")
	set_meta("rick_weapon_shop_selected_weapon_name", "")

	if rick_weapon_shop_popup_dim != null and is_instance_valid(rick_weapon_shop_popup_dim):
		rick_weapon_shop_popup_dim.visible = true
		rick_weapon_shop_popup_dim.mouse_filter = Control.MOUSE_FILTER_STOP

	if rick_weapon_shop_popup != null and is_instance_valid(rick_weapon_shop_popup):
		rick_weapon_shop_popup.visible = true
		rick_weapon_shop_popup.mouse_filter = Control.MOUSE_FILTER_STOP

	rick_weapon_shop_popup_open = true

	if rick_weapon_shop_popup_dim != null and is_instance_valid(rick_weapon_shop_popup_dim):
		_bring_modal_to_front(rick_weapon_shop_popup_dim)

	if rick_weapon_shop_popup != null and is_instance_valid(rick_weapon_shop_popup):
		_bring_modal_to_front(rick_weapon_shop_popup)

	call_deferred("_populate_rick_weapon_shop_popup_after_visual_open")
	call_deferred("_sync_runtime_floating_hud_layering")
func _populate_rick_weapon_shop_popup_after_visual_open() -> void:
	if not rick_weapon_shop_popup_open:
		return

	var contract: Dictionary = _rick_weapon_shop_emit_contract()
	if contract.is_empty():
		_close_rick_weapon_shop_popup()
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Rick's Weapon Shop",
			"popup_text": "Rick's weapon shop contract could not be emitted.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	set_meta("rick_weapon_shop_live_next_tick_ms", 0)

	rick_weapon_shop_active_contract = _rick_weapon_shop_prepare_live_state(contract)
	_prime_rick_weapon_shop_live_state_for_visible_street("rick_weapon_shop_visual_open")
	_populate_rick_weapon_shop_popup(rick_weapon_shop_active_contract)

	if rick_weapon_shop_popup != null and is_instance_valid(rick_weapon_shop_popup):
		rick_weapon_shop_popup.visible = true
		rick_weapon_shop_popup.mouse_filter = Control.MOUSE_FILTER_STOP
		_bring_modal_to_front(rick_weapon_shop_popup)

	_rick_weapon_shop_apply_live_state_visual_patch("rick_weapon_shop_open_initial_patch")
	_schedule_rick_weapon_shop_live_visual_tick("rick_weapon_shop_open")

	call_deferred("_update_rick_weapon_shop_hud", false)
	call_deferred("_sync_runtime_floating_hud_layering")
func _prime_rick_weapon_shop_live_state_for_visible_street(reason: String = "rick_weapon_shop_prime_live") -> void:
	if rick_weapon_shop_active_contract.is_empty():
		return

	var state: Dictionary = MainSceneHelpers._safe_dictionary(rick_weapon_shop_active_contract.get("shop_runtime_state", {}))
	if state.is_empty():
		state = _rick_weapon_shop_default_live_state()

	var outside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside", {}))
	if outside.is_empty():
		outside = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside", {}))

	var outside_people: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside_people", {}))
	if outside_people.is_empty():
		outside_people = MainSceneHelpers._safe_dictionary(_rick_weapon_shop_default_live_state().get("outside_people", {}))

	var current_walking_by: int = int(outside.get("people_walking_by", 0))
	if current_walking_by <= 0:
		var rng:= RandomNumberGenerator.new()
		rng.randomize()
		current_walking_by = int(rng.randi_range(1, 4))
		outside ["people_walking_by"] = current_walking_by
		outside_people ["walking_by"] = _rick_weapon_shop_make_people_group(current_walking_by, "walking_by", "walking past Rick's shop")

	state ["mode"] = str(state.get("mode", get_meta("rick_weapon_shop_mode", "outside"))).strip_edges().to_lower()
	if str(state ["mode"]) == "":
		state ["mode"] = "outside"

	state ["outside"] = outside
	state ["outside_people"] = outside_people

	rick_weapon_shop_active_contract ["shop_runtime_state"] = state

	set_meta("rick_weapon_shop_live_state_primed_for_visible_street", true)
	set_meta("rick_weapon_shop_live_state_prime_reason", reason)
	set_meta("rick_weapon_shop_live_state_prime_at_ms", int(Time.get_ticks_msec()))


func _schedule_rick_weapon_shop_live_visual_tick(reason: String = "rick_weapon_shop_live_visual") -> void:
	if not rick_weapon_shop_popup_open:
		return

	var generation: int = int(get_meta("rick_weapon_shop_live_visual_timer_generation", 0)) + 1
	set_meta("rick_weapon_shop_live_visual_timer_generation", generation)
	set_meta("rick_weapon_shop_live_visual_timer_reason", reason)
	set_meta("rick_weapon_shop_live_visual_timer_scheduled_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		call_deferred("_rick_weapon_shop_live_visual_tick_timer", generation)
		return

	var timer:= tree.create_timer(0.75)
	timer.timeout.connect(
		Callable(self, "_rick_weapon_shop_live_visual_tick_timer").bind(generation),
		CONNECT_ONE_SHOT
	)


func _rick_weapon_shop_live_visual_tick_timer(generation: int) -> void:
	if int(get_meta("rick_weapon_shop_live_visual_timer_generation", 0)) != int(generation):
		return

	if not rick_weapon_shop_popup_open:
		return

	if rick_weapon_shop_popup == null or not is_instance_valid(rick_weapon_shop_popup):
		return

	if not rick_weapon_shop_popup.visible:
		return

	_tick_rick_weapon_shop_live(0.0)

	if rick_weapon_shop_popup_open:
		_schedule_rick_weapon_shop_live_visual_tick("rick_weapon_shop_live_visual_reschedule")
func _close_rick_weapon_shop_popup() -> void:
	rick_weapon_shop_popup_open = false

	set_meta("rick_weapon_shop_mode", "outside")
	set_meta("rick_weapon_shop_selected_weapon_name", "")
	set_meta("rick_weapon_shop_close_visual_only", true)
	set_meta("rick_weapon_shop_close_visual_only_at_ms", int(Time.get_ticks_msec()))
	set_meta("rick_weapon_shop_close_sync_layering_forbidden", true)
	set_meta("rick_weapon_shop_close_stops_live_tick_immediately", true)
	set_meta("rick_weapon_shop_live_next_tick_ms", 2147483647)

	var live_generation: int = int(get_meta("rick_weapon_shop_live_visual_timer_generation", 0)) + 1
	set_meta("rick_weapon_shop_live_visual_timer_generation", live_generation)
	set_meta("rick_weapon_shop_live_visual_timer_cancelled_by_close", true)

	if rick_weapon_shop_popup != null and is_instance_valid(rick_weapon_shop_popup):
		rick_weapon_shop_popup.visible = false
		rick_weapon_shop_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if rick_weapon_shop_popup_dim != null and is_instance_valid(rick_weapon_shop_popup_dim):
		rick_weapon_shop_popup_dim.visible = false
		rick_weapon_shop_popup_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_close_rick_weapon_shop_people_tracker_popup()

	if current_panel == "":
		current_panel = "life"

	call_deferred("_restore_runtime_hud_button_shells_after_surface_change", "rick_weapon_shop_closed_restore_actor_huds")
	call_deferred("_reveal_spawn_ready_runtime_hud_buttons_if_existing", "rick_weapon_shop_closed_existing_hud_reveal")
	call_deferred("_update_rick_weapon_shop_hud", false)
	call_deferred("_sync_runtime_floating_hud_layering")
func _on_rick_weapon_shop_dim_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mb:= event as InputEventMouseButton
		if mb.pressed and mb.button_index == MOUSE_BUTTON_LEFT:
			accept_event()
			_close_rick_weapon_shop_popup()


func _rick_weapon_shop_emit_contract() -> Dictionary:
	if gs == null:
		return {}

	if gs.runtime_contract_engine != null and gs.runtime_contract_engine.has_method("emit_weapon_shop_contract_for_current_world"):
		var report: Dictionary = gs.runtime_contract_engine.emit_weapon_shop_contract_for_current_world({
			"source": "mainscene_rick_weapon_shop_hud",
			"actor_id": int(gs.player.id) if gs.player != null else -1
		})
		var contract: Dictionary = MainSceneHelpers._safe_dictionary(report.get("contract", {}))
		if not contract.is_empty():
			return contract

		var contract_id: String = str(report.get("contract_id", "")).strip_edges()
		if contract_id != "" and gs.runtime_contract_engine.has_method("get_contract_for_space"):
			var fetched: Dictionary = gs.runtime_contract_engine.get_contract_for_space("weapon_shop", "rick_weapon_shop", {
				"source": "mainscene_rick_weapon_shop_hud_fetch"
			})
			if not fetched.is_empty():
				return fetched

	if gs.weapons_engine != null and gs.weapons_engine.has_method("get_weapons_for_context"):
		var era_name: String = MainSceneLogic._rick_weapon_shop_best_era(gs)
		var country: String = MainSceneLogic._rick_weapon_shop_best_country(gs)
		var city: String = MainSceneLogic._rick_weapon_shop_best_city(gs)
		return {
			"contract_id": "fallback_rick_weapon_shop",
			"contract_type": "weapon_shop",
			"location": {
				"name": "Rick's Weapon Counter",
				"era": era_name,
				"country": country,
				"city": city
			},
			"vendor": {
				"id": "rick_global_entity",
				"display_name": MainSceneLogic._rick_weapon_shop_local_rick_name(country),
			},
			"rick_flavor": {
				"appearance": "Rick appears behind the counter like the code owed him rent.",
				"quote": "Everything has an edge.",
				"shopkeeper_note": "Fallback manifestation active."
			},
			"player_recognition": {
				"line": "Rick looks up like this has happened before."
			},
			"memory_echoes": [],
			"shop_runtime_state": _rick_weapon_shop_default_live_state(),
			"inventory": gs.weapons_engine.get_weapons_for_context({
				"era": era_name,
				"country": country,
				"city": city,
				"shop_id": "rick_weapon_shop",
				"vendor": "rick"
			})
		}

	return {}

func _populate_rick_weapon_shop_popup(contract: Dictionary) -> void:
	if rick_weapon_shop_popup_list == null:
		return

	for child in rick_weapon_shop_popup_list.get_children():
		child.queue_free()

	var prepared_contract: Dictionary = _rick_weapon_shop_prepare_live_state(contract)
	rick_weapon_shop_active_contract = prepared_contract.duplicate(true)

	var state: Dictionary = MainSceneHelpers._safe_dictionary(prepared_contract.get("shop_runtime_state", {}))
	var mode: String = str(state.get("mode", get_meta("rick_weapon_shop_mode", "outside"))).strip_edges().to_lower()
	if mode == "":
		mode = "outside"

	set_meta("rick_weapon_shop_mode", mode)

	if mode == "inside":
		_populate_rick_weapon_shop_inside(prepared_contract, state)
	else:
		_populate_rick_weapon_shop_outside(prepared_contract, state)
func _populate_rick_weapon_shop_outside(contract: Dictionary, state: Dictionary) -> void:
	var location: Dictionary = MainSceneHelpers._safe_dictionary(contract.get("location", {}))
	var flavor: Dictionary = MainSceneHelpers._safe_dictionary(contract.get("rick_flavor", {}))
	var outside: Dictionary = MainSceneHelpers._safe_dictionary(state.get("outside", {}))

	rick_weapon_shop_popup_title.text = "OUTSIDE OF RICK'S WEAPONS SHOP"
	rick_weapon_shop_popup_subtitle.text = "%s • %s, %s\nThe orange border hums around the door like the building knows you clicked the button." % [
		str(location.get("name", "Rick's Weapon Counter")),
		str(location.get("era", "")),
		str(location.get("country", ""))
	]
	rick_weapon_shop_popup_footer.text = str(flavor.get("appearance", "Rick is somewhere inside. Somehow."))

	var street_card:= MainSceneHelpers._rick_weapon_shop_section_panel(Color(0.1, 0.075, 0.055, 0.94), Color(1.0, 0.58, 0.2, 0.52))
	rick_weapon_shop_popup_list.add_child(street_card)

	var street_margin: MarginContainer = street_card.get_meta("margin", null)
	if street_margin == null:
		return

	var street_body:= VBoxContainer.new()
	street_body.add_theme_constant_override("separation", 16)
	street_margin.add_child(street_body)

	var street_title:= Label.new()
	street_title.text = "LIVE STREET OUTSIDE THE SHOP"
	street_title.add_theme_font_size_override("font_size", 18)
	street_title.add_theme_color_override("font_color", Color(1.0, 0.88, 0.6, 1.0))
	street_body.add_child(street_title)

	var badge_row:= HBoxContainer.new()
	badge_row.add_theme_constant_override("separation", 12)
	street_body.add_child(badge_row)

	badge_row.add_child(_rick_weapon_shop_counter_badge("People walking by", int(outside.get("people_walking_by", 0)), "walking_by"))
	badge_row.add_child(_rick_weapon_shop_counter_badge("People walking in", int(outside.get("people_walking_in", 0)), "walking_in"))

	if int(outside.get("people_walking_in", 0)) > 0 or int(outside.get("people_walking_out", 0)) > 0:
		badge_row.add_child(_rick_weapon_shop_counter_badge("People walking out", int(outside.get("people_walking_out", 0)), "walking_out"))

	var atmosphere:= Label.new()
	atmosphere.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	atmosphere.text = "People drift past with little pocket-sized lives. Some glance at the weapons sign. Some pretend they did not. The door waits."
	atmosphere.add_theme_font_size_override("font_size", 15)
	atmosphere.add_theme_color_override("font_color", Color(0.94, 0.84, 0.72, 0.94))
	street_body.add_child(atmosphere)

	var enter_button:= Button.new()
	enter_button.text = "ENTER RICK'S SHOP"
	enter_button.focus_mode = Control.FOCUS_NONE
	enter_button.custom_minimum_size = Vector2(0, 72)
	enter_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	enter_button.add_theme_font_size_override("font_size", 24)
	enter_button.pressed.connect(_on_rick_weapon_shop_enter_pressed)
	street_body.add_child(enter_button)
func _populate_rick_weapon_shop_inside(
	contract: Dictionary,
	state: Dictionary
) -> void:
	var location: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"location",
			{}
		)
	)
	var vendor: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"vendor",
			{}
		)
	)
	var flavor: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"rick_flavor",
			{}
		)
	)
	var recognition: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"player_recognition",
			{}
		)
	)
	var inventory: Array = MainSceneHelpers._safe_array(
		contract.get(
			"inventory",
			[]
		)
	)
	var shop_name: String = str(
		location.get(
			"name",
			"Rick's Weapon Counter"
		)
	)
	var vendor_name: String = str(
		vendor.get(
			"display_name",
			"Rick"
		)
	)
	var quote: String = str(
		flavor.get(
			"quote",
			"Everything has an edge."
		)
	)
	var appearance: String = str(
		flavor.get(
			"appearance",
			"Rick is here. Somehow."
		)
	)
	var recognition_line: String = (
		str(
			recognition.get(
				"line",
				""
			)
		).strip_edges()
		if MainSceneLogic._rick_weapon_shop_should_show_recognition(gs, 
			contract
		)
		else ""
	)

	rick_weapon_shop_popup_title.text = "      %s" % shop_name
	rick_weapon_shop_popup_subtitle.text = (
		"%s • %s, %s\n“%s”%s"
		% [
			vendor_name,
			str(
				location.get(
					"era",
					""
				)
			),
			str(
				location.get(
					"country",
					""
				)
			),
			quote,
			(
				"\n%s" % recognition_line
				if recognition_line != ""
				else ""
			)
		]
	)
	rick_weapon_shop_popup_footer.text = appearance

	_add_rick_weapon_shop_inside_live_strip(
		contract,
		state
	)
	_add_rick_weapon_shop_checkout_section(
		contract,
		state
	)

	if inventory.is_empty():
		var empty_label:= Label.new()
		empty_label.text = (
			"Rick's walls are empty in this manifestation. "
			+ "That feels worse than a full wall."
		)
		empty_label.autowrap_mode = (
			TextServer.AUTOWRAP_WORD_SMART
		)
		empty_label.add_theme_color_override(
			"font_color",
			Color(
				1.0,
				0.82,
				0.58,
				0.92
			)
		)
		rick_weapon_shop_popup_list.add_child(
			empty_label
		)
		return

	var grid:= GridContainer.new()
	grid.name = "RickWeaponInventoryGrid"
	grid.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	grid.add_theme_constant_override(
		"h_separation",
		12
	)
	grid.add_theme_constant_override(
		"v_separation",
		12
	)

	var viewport_width: float = get_viewport_rect().size.x

	if viewport_width >= 1500.0:
		grid.columns = 3
	elif viewport_width >= 900.0:
		grid.columns = 2
	else:
		grid.columns = 1

	rick_weapon_shop_popup_list.add_child(
		grid
	)

	for raw_weapon in inventory:
		if typeof(
			raw_weapon
		) != TYPE_DICTIONARY:
			continue

		_add_rick_weapon_shop_weapon_row(
			raw_weapon as Dictionary,
			contract,
			grid
		)
func _add_rick_weapon_shop_weapon_row(
