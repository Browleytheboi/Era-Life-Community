		MainSceneHelpers._style_god_mode_check_box(control as CheckBox)

func _god_mode_field_palette() -> Dictionary:
	var palette:= _current_god_mode_palette()
	var panel_base: Color = Color(palette.get("panel_base", Color(0.17, 0.1, 0.27, 0.95)))
	var panel_hover: Color = Color(palette.get("panel_hover", Color(0.2, 0.12, 0.3, 0.97)))
	var accent: Color = Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
	var shadow: Color = Color(palette.get("shadow_hover", Color(0.42, 0.22, 0.7, 0.3)))

	var panel_base_field:= Color(panel_base.r, panel_base.g, panel_base.b, clamp(panel_base.a, 0.92, 0.98))
	var panel_hover_field:= Color(panel_hover.r, panel_hover.g, panel_hover.b, clamp(panel_hover.a, 0.94, 0.99))

	return {
		"normal_bg": panel_base_field,
		"hover_bg": panel_hover_field,
		"pressed_bg": panel_hover_field.lightened(0.04),
		"focus_bg": panel_hover_field.lightened(0.02),

		"normal_border": Color(accent.r, accent.g, accent.b, 0.58),
		"hover_border": Color(accent.r, accent.g, accent.b, 0.78),
		"pressed_border": Color(accent.r, accent.g, accent.b, 0.92),
		"focus_border": Color(accent.r, accent.g, accent.b, 0.96),

		"normal_shadow": Color(shadow.r, shadow.g, shadow.b, 0.24),
		"hover_shadow": Color(shadow.r, shadow.g, shadow.b, 0.34),
		"pressed_shadow": Color(shadow.r, shadow.g, shadow.b, 0.4),
		"focus_shadow": Color(shadow.r, shadow.g, shadow.b, 0.38)
	}
