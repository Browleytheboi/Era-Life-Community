func _lock_first_frame_ui_snapshot(snapshot: Dictionary, reason: String = "first_frame") -> void:
	if snapshot.is_empty():
		return

	var locked: Dictionary = snapshot.duplicate(true)
	locked ["reason"] = reason
	locked ["locked_at_ms"] = int(Time.get_ticks_msec())
	locked ["runtime_snapshot_locked"] = true
	locked ["ui_packet_consumer_only"] = true

	set_meta("first_frame_ui_snapshot", locked.duplicate(true))
	set_meta("first_frame_ui_snapshot_locked", true)
	set_meta("first_frame_ui_snapshot_consumed", false)

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["first_frame_ui_snapshot"] = locked.duplicate(true)
		gs.scenario_state ["first_frame_ui_snapshot_locked"] = true
		gs.scenario_state ["first_frame_ui_snapshot_reason"] = reason
		gs.scenario_state ["ui_runtime_first_frame_snapshot_id"] = str(locked.get("player_id", ""))

func _truth_first_god_mode_ready_snapshot(reason: String = "truth_first_ready") -> Dictionary:
	var snapshot: Dictionary = _current_first_frame_ui_snapshot()
	if not snapshot.is_empty():
		return snapshot.duplicate(true)

	var staged_raw: Variant = get_meta("god_mode_zero_frame_entry_staged_snapshot", {})
	if typeof(staged_raw) == TYPE_DICTIONARY and not (staged_raw as Dictionary).is_empty():
		return (staged_raw as Dictionary).duplicate(true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var state_staged_raw: Variant = gs.scenario_state.get("god_mode_zero_frame_entry_staged_snapshot", {})
		if typeof(state_staged_raw) == TYPE_DICTIONARY and not (state_staged_raw as Dictionary).is_empty():
			return (state_staged_raw as Dictionary).duplicate(true)

		var prebuilt_raw: Variant = gs.scenario_state.get("prebuilt_first_frame_ui_snapshot", {})
		if typeof(prebuilt_raw) == TYPE_DICTIONARY and not (prebuilt_raw as Dictionary).is_empty():
			return (prebuilt_raw as Dictionary).duplicate(true)

	if gs != null and gs.player != null:
		return _build_first_frame_ui_snapshot_from_game_state(gs, "%s_rebuilt_truth_snapshot" % reason)

	return {}

