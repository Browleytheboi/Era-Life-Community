		refresh_mode == "post_loading_finalize"
		or refresh_mode == "ui_first_release"
	)
	var birth_shell_safe_release: bool = (
		refresh_mode == "birth_shell_ui_released"
		or refresh_mode == "birth_shell_safe_release"
		or refresh_mode == "post_spawn_idle_prewarm_complete"
