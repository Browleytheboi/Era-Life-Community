func _render_nearby_switch_shell_contract() -> void:
	_ensure_nearby_switch_popup()

	if nearby_switch_list == null:
		return

	_clear_container_children(nearby_switch_list)

	if nearby_switch_status_label != null:
		nearby_switch_status_label.text = "Nearby lives are surfacing from a household-and-neighborhood contract."

	var rows: Array = _nearby_switch_contract_snapshot_rows(36)
	if rows.is_empty():
		if nearby_switch_status_label != null:
			nearby_switch_status_label.text = "Nearby lives are stabilizing. Try again in a moment."
		var empty:= Label.new()
		empty.text = "No switchable lives surfaced in the first contract snapshot."
		empty.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		nearby_switch_list.add_child(empty)
		return

	if nearby_switch_status_label != null:
		nearby_switch_status_label.text = "Household appears first. Neighbors and local strangers fill in behind them."

	_render_nearby_switch_contract_rows(rows)


func _nearby_switch_contract_snapshot_rows(limit: int = 24) -> Array:
	var out: Array = []
	if gs == null or gs.player == null:
		return out
	if not ("npcs" in gs) or typeof(gs.npcs) != TYPE_ARRAY:
		return out

	var player: Person = gs.player
	var player_country: String = MainSceneLogic._person_contract_country(player)
	var player_city: String = MainSceneLogic._person_contract_city(player)

	var household_rows: Array = []
	var neighbor_rows: Array = []
	var local_stranger_rows: Array = []
	var extended_family_rows: Array = []
	var country_stranger_rows: Array = []

	var seen_ids: Dictionary = {}

	for raw_npc in gs.npcs:
		if raw_npc == null or not (raw_npc is Person):
			continue

		var npc: Person = raw_npc as Person
		if npc == null:
			continue
		if int(npc.id) == int(player.id):
			continue
		if seen_ids.has(int(npc.id)):
			continue
		if not bool(npc.alive):
			continue

		var npc_country: String = MainSceneLogic._person_contract_country(npc)
		var npc_city: String = MainSceneLogic._person_contract_city(npc)

		if player_country != "" and npc_country != "" and npc_country != player_country:
			continue

		var distance: int = MainSceneLogic._nearby_switch_contract_distance_to_player(gs, npc)
		var is_household: bool = MainSceneLogic._nearby_switch_is_immediate_household_member(gs, npc)
		var is_family: bool = MainSceneLogic._nearby_switch_is_family_member(gs, npc)
		var same_city: bool = player_city != "" and npc_city != "" and npc_city == player_city
		var same_country: bool = player_country != "" and npc_country == player_country

		var row: Dictionary = {
			"npc": npc,
			"distance": distance,
			"city": npc_city,
			"country": npc_country,
			"is_household": is_household,
			"is_family": is_family,
			"lane": "nearby"
		}

		seen_ids [int(npc.id)] = true

		if is_household:
			row ["distance"] = 0
			row ["lane"] = "Household"
			household_rows.append(row)
		elif same_city and not is_family:
			row ["lane"] = "Neighbor"
			neighbor_rows.append(row)
		elif same_city:
			row ["lane"] = "Nearby Family"
			extended_family_rows.append(row)
		elif same_country and not is_family:
			row ["lane"] = "Local Stranger"
			country_stranger_rows.append(row)
		elif same_country:
			row ["lane"] = "Extended Family"
			extended_family_rows.append(row)

	household_rows.sort_custom(func (a, b): return str((a.get("npc") as Person).last_name) < str((b.get("npc") as Person).last_name))
	neighbor_rows.sort_custom(func (a, b): return int(a.get("distance", 999999)) < int(b.get("distance", 999999)))
	local_stranger_rows.sort_custom(func (a, b): return int(a.get("distance", 999999)) < int(b.get("distance", 999999)))
	country_stranger_rows.sort_custom(func (a, b): return int(a.get("distance", 999999)) < int(b.get("distance", 999999)))
	extended_family_rows.sort_custom(func (a, b): return int(a.get("distance", 999999)) < int(b.get("distance", 999999)))

	for bucket in [household_rows, neighbor_rows, local_stranger_rows, country_stranger_rows, extended_family_rows]:
		for raw_row in bucket:
			if out.size() >= limit:
				return out
			if typeof(raw_row) == TYPE_DICTIONARY:
				out.append(raw_row)

	return out
func _render_nearby_switch_contract_rows(rows: Array) -> void:
	if nearby_switch_list == null:
		return

	for raw_row in rows:
		if typeof(raw_row) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = raw_row
		var npc: Person = MainSceneHelpers._nearby_switch_row_person(row)
		if npc == null:
			continue

		var btn:= Button.new()
		btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.custom_minimum_size = Vector2(0, 58)

		var where:= MainSceneLogic._person_contract_city(npc)
		if where == "":
			where = MainSceneLogic._person_contract_country(npc)
		if where == "":
			where = "Unknown Locale"

		var distance: int = int(row.get("distance", MainSceneLogic._nearby_switch_contract_distance_to_player(gs, npc)))
		var lane: String = str(row.get("lane", "Nearby")).strip_edges()
		if lane == "":
			lane = "Nearby"

		btn.text = "%s %s\n%s • Age %d • %s • %s • %d miles away" % [
			str(npc.first_name),
			str(npc.last_name),
			lane,
			int(npc.age),
			str(npc.gender),
			where,
			distance
		]

		btn.add_theme_stylebox_override("normal", _build_ui_nav_button_style("normal", 0.18, false))
		btn.add_theme_stylebox_override("hover", _build_ui_nav_button_style("hover", 0.4, false))
		btn.add_theme_stylebox_override("pressed", _build_ui_nav_button_style("pressed", 0.6, false))
		btn.add_theme_stylebox_override("focus", _build_ui_nav_button_style("hover", 0.5, false))
		btn.pressed.connect(_on_nearby_switch_target_pressed.bind(int(npc.id)))
		nearby_switch_list.add_child(btn)
func _close_nearby_switch_popup() -> void:
	nearby_switch_open = false
	if nearby_switch_popup != null:
		nearby_switch_popup.visible = false

func _refresh_nearby_switch_popup_list() -> void:
	_ensure_nearby_switch_popup()
	_clear_container_children(nearby_switch_list)
	if gs == null or gs.player == null:
		if nearby_switch_status_label != null:
			nearby_switch_status_label.text = "No active life loaded."
		return

	var added_return_to_created_button: bool = false
	var original_id: int = -1
	if gs.controlled_lineage_ids.size() > 0:
		original_id = int(gs.controlled_lineage_ids [0])

	if original_id > 0 and original_id != int(gs.player.id):
		var original_target: Person = gs.get_or_reactivate_npc_by_id(original_id)
		if original_target != null and original_target.alive:
			var return_btn:= Button.new()
			return_btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
			return_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			return_btn.custom_minimum_size = Vector2(0, 64)
			return_btn.text = "↩ Switch back to your created character\n%s %s • Age %d" % [
				original_target.first_name,
				original_target.last_name,
				int(original_target.age)
			]
			return_btn.add_theme_stylebox_override("normal", _build_ui_nav_button_style("hover", 0.22, false))
			return_btn.add_theme_stylebox_override("hover", _build_ui_nav_button_style("pressed", 0.48, false))
			return_btn.add_theme_stylebox_override("pressed", _build_ui_nav_button_style("pressed", 0.68, false))
			return_btn.add_theme_stylebox_override("focus", _build_ui_nav_button_style("pressed", 0.56, false))
			return_btn.pressed.connect(func () -> void:
				if gs == null or gs.family_control_engine == null:
					return
				if gs.family_control_engine.switch_to_character(original_target):
					var switch_text: String = "I started living as %s." % MainSceneHelpers._person_display_name_for_identity_switch(original_target)
					_commit_relationship_control_switch_to_life_diary({
						"success": true,
						"text": switch_text,
						"identity_switch": true,
						"controlled_person_id": int(original_target.id),
						"controlled_person_name": MainSceneHelpers._person_display_name_for_identity_switch(original_target),
						"source": "nearby_switch_return"
					}, switch_text)
			)
			nearby_switch_list.add_child(return_btn)
			added_return_to_created_button = true

	var nearby_rows: Array = _nearby_switch_contract_snapshot_rows(80)

	if nearby_rows.is_empty() and gs.family_control_engine != null and gs.family_control_engine.has_method("get_nearby_strangers"):
		var engine_nearby: Array = gs.family_control_engine.get_nearby_strangers(80)
		var player_country: String = MainSceneLogic._person_contract_country(gs.player)
		var seen_ids: Dictionary = {}

		for raw_npc in engine_nearby:
			if raw_npc == null or not (raw_npc is Person):
				continue

			var npc: Person = raw_npc as Person
			if npc == null:
				continue
			if seen_ids.has(int(npc.id)):
				continue

			var npc_country: String = MainSceneLogic._person_contract_country(npc)
			if player_country != "" and npc_country != "" and npc_country != player_country:
				continue

			seen_ids [int(npc.id)] = true
			nearby_rows.append({
				"npc": npc,
				"distance": MainSceneLogic._nearby_switch_contract_distance_to_player(gs, npc),
				"city": MainSceneLogic._person_contract_city(npc),
				"country": npc_country,
				"lane": "Local Stranger",
				"is_family": MainSceneLogic._nearby_switch_is_family_member(gs, npc)
			})

			if nearby_rows.size() >= 80:
				break

	if nearby_rows.is_empty():
		if nearby_switch_status_label != null:
			nearby_switch_status_label.text = "No neighbors or strangers surfaced in this contract snapshot." if not added_return_to_created_button else "No neighbors or strangers surfaced in this contract snapshot. You can still return to your created character."
		if not added_return_to_created_button:
			var empty:= Label.new()
			empty.text = "Nobody nearby is switchable right now."
			empty.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			nearby_switch_list.add_child(empty)
		return

	if nearby_switch_status_label != null:
		nearby_switch_status_label.text = "Household appears first at 0 miles. Neighbors and local strangers fill in behind them."

	_render_nearby_switch_contract_rows(nearby_rows)

