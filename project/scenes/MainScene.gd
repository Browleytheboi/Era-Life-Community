func _apply_institution_hub_visual_theme(kind: String) -> void:
	if institution_hub_card == null:
		return

	var clean_kind: String = str(kind).strip_edges().to_lower()
	var accent: Color = Color(0.42, 0.62, 1.0, 0.88)
	var top_color: Color = Color(0.03, 0.045, 0.085, 0.99)
	var base_color: Color = Color(0.015, 0.02, 0.04, 0.99)

	match clean_kind:
		"school":
			accent = Color(0.46, 0.72, 1.0, 0.92)
			top_color = Color(0.026, 0.05, 0.095, 0.99)
			base_color = Color(0.01, 0.018, 0.045, 0.99)
		"relationships":
			accent = Color(1.0, 0.48, 0.72, 0.9)
			top_color = Color(0.07, 0.028, 0.06, 0.99)
			base_color = Color(0.03, 0.015, 0.035, 0.99)
		"career":
			accent = Color(0.52, 0.92, 0.72, 0.88)
			top_color = Color(0.025, 0.07, 0.05, 0.99)
			base_color = Color(0.012, 0.035, 0.026, 0.99)

	var resolved_panel_color: Color = base_color.lerp(top_color, 0.18)
	var resolved_shadow_color: Color = top_color.darkened(0.82)
	var resolved_status_color: Color = top_color.lerp(Color(0.72, 0.82, 1.0, 0.86), 0.35)

	var style:= StyleBoxFlat.new()
	style.bg_color = resolved_panel_color
	style.border_color = accent
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.corner_radius_top_left = 24
	style.corner_radius_top_right = 24
	style.corner_radius_bottom_left = 24
	style.corner_radius_bottom_right = 24
	style.shadow_color = Color(0.0, 0.0, 0.0, 0.7)
	style.shadow_size = 20
	style.shadow_offset = Vector2(0, 8)
	institution_hub_card.add_theme_stylebox_override("panel", style)

	if institution_hub_dim != null:
		institution_hub_dim.color = resolved_shadow_color.lerp(Color(0.003, 0.004, 0.012, 0.84), 0.76)

	if institution_hub_title != null:
		institution_hub_title.add_theme_color_override("font_color", Color(0.94, 0.97, 1.0, 1.0))
		institution_hub_title.add_theme_color_override("font_shadow_color", accent.darkened(0.75))
		institution_hub_title.add_theme_constant_override("shadow_offset_x", 0)
		institution_hub_title.add_theme_constant_override("shadow_offset_y", 2)

