func _action_result_popup_text_is_symbol_codepoint(codepoint: int) -> bool:
	return (
		(codepoint >= 126976 and codepoint <= 129791)
		or (codepoint >= 9728 and codepoint <= 10175)
		or codepoint == 8205
		or codepoint == 65039
	)

func _action_result_popup_text_line_is_symbols_only(text: String) -> bool:
	var line:= str(text).strip_edges()
	if line == "":
		return false
	for i in range(line.length()):
		var codepoint:= line.unicode_at(i)
		if codepoint == 32 or codepoint == 9:
			continue
		if not _action_result_popup_text_is_symbol_codepoint(codepoint):
			return false
	return true

func _action_result_normalize_popup_text_layout(text: String) -> String:
	var out:= str(text).strip_edges()
	if out == "":
		return ""
	var raw_lines:= out.split("\n", false)
	var cleaned: Array = []
	for raw_line in raw_lines:
		var line:= str(raw_line).strip_edges()
		if line == "":
			continue
		cleaned.append(line)
	if cleaned.is_empty():
		return ""
	if cleaned.size() >= 2 and _action_result_popup_text_line_is_symbols_only(str(cleaned [0])):
		cleaned [0] = "%s %s" % [str(cleaned [0]).strip_edges(), str(cleaned [1]).strip_edges()]
		cleaned.remove_at(1)
	var packed_lines:= PackedStringArray()
	for line in cleaned:
		packed_lines.append(str(line))
	return "\n".join(packed_lines).strip_edges()

func _action_result_split_popup_text_prefix(text: String) -> Dictionary:
	var normalized:= _action_result_normalize_popup_text_layout(text)
	if normalized == "":
		return { "prefix": "", "body": ""}
	var idx:= 0
	while idx < normalized.length():
		var codepoint:= normalized.unicode_at(idx)
		if codepoint == 32 or codepoint == 9:
			idx += 1
			continue
		if _action_result_popup_text_is_symbol_codepoint(codepoint):
			idx += 1
			continue
		break
	if idx <= 0:
		return { "prefix": "", "body": normalized}
	var prefix:= normalized.substr(0, idx).strip_edges()
	var body:= normalized.substr(idx).strip_edges()
	if prefix == "" or body == "":
		return { "prefix": "", "body": normalized}
	return { "prefix": "%s " % prefix, "body": body}

func _player_diary_text_to_popup_text(text: String) -> String:
	var popup_parts:= _action_result_split_popup_text_prefix(text)
	var leading_prefix:= str(popup_parts.get("prefix", ""))
	var out: String = str(popup_parts.get("body", str(text).strip_edges())).strip_edges()
	if out == "":
		return ""
	if out.begins_with("I have "):
		out = "You have " + out.substr(7)
	elif out.begins_with("I’ve "):
		out = "You’ve " + out.substr(5)
	elif out.begins_with("I've "):
		out = "You've " + out.substr(5)
	elif out.begins_with("I am "):
		out = "You are " + out.substr(5)
	elif out.begins_with("I'm "):
		out = "You're " + out.substr(4)
	elif out.begins_with("I "):
		out = "You " + out.substr(2)
	out = out.replace("\nI have ", "\nYou have ")
	out = out.replace("\nI’ve ", "\nYou’ve ")
	out = out.replace("\nI've ", "\nYou've ")
	out = out.replace("\nI am ", "\nYou are ")
	out = out.replace("\nI'm ", "\nYou're ")
	out = out.replace("\nI ", "\nYou ")
	out = out.replace(". I have ", ". You have ")
	out = out.replace(". I’ve ", ". You’ve ")
	out = out.replace(". I've ", ". You've ")
	out = out.replace(". I am ", ". You are ")
	out = out.replace(". I'm ", ". You're ")
	out = out.replace(". I ", ". You ")
	out = out.replace("! I have ", "! You have ")
	out = out.replace("! I’ve ", "! You’ve ")
	out = out.replace("! I've ", "! You've ")
	out = out.replace("! I am ", "! You are ")
	out = out.replace("! I'm ", "! You're ")
	out = out.replace("! I ", "! You ")
	out = out.replace("? I have ", "? You have ")
	out = out.replace("? I’ve ", "? You’ve ")
	out = out.replace("? I've ", "? You've ")
	out = out.replace("? I am ", "? You are ")
	out = out.replace("? I'm ", "? You're ")
	out = out.replace("? I ", "? You ")
	out = out.replace(" my ", " your ")
	out = out.replace(" My ", " Your ")
	out = out.replace(" me ", " you ")
	out = out.replace(" me.", " you.")
	out = out.replace(" me!", " you!")
	out = out.replace(" me?", " you?")
	return (leading_prefix + out).strip_edges()
func _hide_action_result_popup() -> void:
	var closed_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var has_followup: bool = (
		typeof(pending_action_result_followup) == TYPE_DICTIONARY
		and not pending_action_result_followup.is_empty()
	)

	action_result_popup_open = false

	if (
		action_result_popup != null
		and is_instance_valid(action_result_popup)
	):
		action_result_popup.set_meta(
			"action_result_popup_generation",
			int(
				action_result_popup.get_meta(
					"action_result_popup_generation",
					0
				)
			) + 1
		)
		action_result_popup.visible = false
		action_result_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE
		action_result_popup.set_meta(
			"reality_surge_input_unlock_ms",
			0
		)
		action_result_popup.set_meta(
			"interactive_surface_claimed",
			false
		)

	if (
		action_result_popup_dim != null
		and is_instance_valid(action_result_popup_dim)
	):
		action_result_popup_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

	action_result_popup_choice_context.clear()

	var return_surface_restored: bool = (
		_restore_action_result_return_surface_authority()
	)
	var reconcile_payload: Dictionary = {
		"source": "action_result_popup_closed",
		"return_surface_restored": return_surface_restored,
		"pet_shop_surface_dirty": bool(
			get_meta(
				"pet_shop_post_popup_refresh_pending",
				false
			)
		),
		"red_bonnet_inventory_dirty": bool(
			get_meta(
				"red_bonnet_post_popup_inventory_refresh_pending",
				false
			)
		),
		"boxing_hud_dirty": bool(
			get_meta(
				"boxing_hud_reveal_pending_after_action_result",
				false
			)
		),
		"boxing_actor_id": int(
			get_meta(
				"boxing_hud_reveal_pending_actor_id",
				-1
			)
		)
	}

	set_meta(
		"pet_shop_post_popup_refresh_pending",
		false
	)
	set_meta(
		"red_bonnet_post_popup_inventory_refresh_pending",
		false
	)
	set_meta(
		"boxing_hud_reveal_pending_after_action_result",
		false
	)
	remove_meta(
		"boxing_hud_reveal_pending_actor_id"
	)
	remove_meta(
		"boxing_hud_reveal_pending_at_ms"
	)

	set_meta(
		"action_result_popup_closed_visual_only",
		true
	)
	set_meta(
		"action_result_popup_close_sync_hud_refresh_forbidden",
		true
	)
	set_meta(
		"action_result_popup_close_sync_diary_render_forbidden",
		true
	)
	set_meta(
		"action_result_popup_return_surface_restored_before_tail",
		return_surface_restored
	)
	set_meta(
		"action_result_popup_closed_at_ms",
		closed_at_ms
	)
	set_meta(
		"action_result_popup_close_quiet_window_started",
		false
	)
	set_meta(
		"action_result_popup_close_diary_cache_invalidated_synchronously",
		false
	)

	if not has_followup:
		call_deferred(
			"_restore_pending_situation_viewer_after_action_result_if_needed"
		)

	call_deferred(
		"_schedule_action_result_post_resolution_reconcile",
		"action_result_popup_closed_visual_only",
		reconcile_payload
	)

	EraLog.truth(
		"ERALIFE_ACTION_RESULT_POPUP_CLOSE_TRUTH"
		+ "|visible=false"
		+ "|return_surface_restored="
		+ str(return_surface_restored).to_lower()
		+ "|sync_diary_render=false"
		+ "|sync_hud_refresh=false"
		+ "|quiet_window=false"
		+ "|at_ms=" + str(closed_at_ms)
	)
func _boxing_mark_roster_projection_available_after_unlock(actor_id: int = -1, reason: String = "boxing_unlock") -> void:
	if gs == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var priority_division: String = ""
	var priority_gender: String = "Male"

	if gs.player != null and (actor_id <= 0 or int(gs.player.id) == actor_id):
		if typeof(gs.player.boxing_profile) == TYPE_DICTIONARY:
			priority_division = str(gs.player.boxing_profile.get("weight_class", "")).strip_edges()
			priority_gender = str(gs.player.boxing_profile.get("boxing_gender_division", "Male")).strip_edges()

	if priority_gender == "":
		priority_gender = "Male"

	gs.scenario_state ["boxing_roster_projection_available"] = true
	gs.scenario_state ["boxing_roster_projection_reason"] = reason
	gs.scenario_state ["boxing_roster_projection_actor_id"] = actor_id
	gs.scenario_state ["boxing_roster_projection_priority_division"] = priority_division
	gs.scenario_state ["boxing_roster_projection_priority_gender"] = priority_gender
	gs.scenario_state ["boxing_roster_projection_at_ms"] = int(Time.get_ticks_msec())

	gs.scenario_state ["boxing_world_sync_heavy_bootstrap_deferred"] = true
	gs.scenario_state ["boxing_world_sync_heavy_bootstrap_deferred_reason"] = reason
	gs.scenario_state ["boxing_world_factions_priority_division"] = priority_division
	gs.scenario_state ["boxing_world_factions_priority_gender"] = priority_gender
func _refresh_boxing_hud_after_action_result_popup_close(reason: String = "boxing_hud_reveal_after_action_result_popup", actor_id: int = -1) -> void:
	if gs == null or gs.player == null:
		return

	var controlled_actor_id: int = int(gs.player.id)
	if actor_id > 0 and actor_id != controlled_actor_id:
		call_deferred("_schedule_runtime_huds_after_boxing_reveal", reason)
