func _on_action_result_popup_pooled_choice_pressed(
	choice_index: int
) -> void:
	var choices: Array = MainSceneHelpers._safe_array(
		action_result_popup_choice_context.get(
			"choices",
			[]
		)
	)

	if choice_index < 0 or choice_index >= choices.size():
		return

	var choice: Dictionary = MainSceneHelpers._safe_dictionary(
		choices [choice_index]
	)

	if choice.is_empty():
		return

	_on_action_result_popup_choice_pressed(
		choice
	)
func _action_result_popup_should_use_fullscreen(
	result: Dictionary
) -> bool:
	if typeof(result) != TYPE_DICTIONARY:
		return false

	if bool(
		result.get(
			"fullscreen_popup",
			false
		)
	):
		return true

	if str(
		result.get(
			"popup_surface_mode",
			""
		)
	).strip_edges().to_lower() in [
		"fullscreen",
		"independent_browser",
		"candidate_browser"
	]:
		return true

	if _result_crosses_life_boundary(
		result
	):
		return true

	var popup_title: String = str(
		result.get(
			"popup_title",
			""
		)
	).strip_edges().to_lower()

	if popup_title in [
		"death",
		"defeat",
		"afterlife"
	]:
		var popup_text: String = str(
			result.get(
				"popup_text",
				result.get(
					"text",
					""
				)
			)
		).strip_edges().to_lower()

		return (
			popup_text.find("died") >= 0
			or popup_text.find("death") >= 0
			or popup_text.find("took your life") >= 0
			or popup_text.find("killed") >= 0
			or popup_text.find("smoked by dwarves") >= 0
		)

	return false

func _apply_action_result_popup_layout_for_result(result: Dictionary) -> void:
	if action_result_popup == null or action_result_popup_card == null:
		return

	var fullscreen: bool = _action_result_popup_should_use_fullscreen(result)
	var viewport_size: Vector2 = get_viewport_rect().size

	if fullscreen:
		action_result_popup_dim.color = Color(0.0, 0.0, 0.0, 0.88)
