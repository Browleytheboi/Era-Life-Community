func _career_hub_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var inspected: int = 0
	var preferred_keys: Array = [
		"route_report",
		"result",
		"engine_report",
		"target_report",
		"commit_report",
		"command_report",
		"payload",
		"crr_report"
	]

	while (
		not queue.is_empty()
		and inspected < 64
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		if cursor.has(
			"career_hub_contract"
		):
			var direct_contract: Dictionary = (
				MainSceneHelpers._safe_dictionary(
					cursor.get(
						"career_hub_contract",
						{}
					)
				)
			)

			if not direct_contract.is_empty():
				return cursor

		if str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges() == "eralife.career_hub_contract":
			return {
				"success": bool(
					cursor.get(
						"success",
						true
					)
				),
				"type": (
					"career_hub_projection_resolved"
				),
				"career_hub_contract": (
					cursor.duplicate(true)
				)
			}

		for raw_key in preferred_keys:
			var nested_raw: Variant = cursor.get(
				str(
					raw_key
				),
				{}
			)

			if typeof(nested_raw) == TYPE_DICTIONARY:
				var nested: Dictionary = (
					nested_raw as Dictionary
				).duplicate(true)

				if not nested.is_empty():
					queue.append(
						nested
					)


		for raw_key in cursor.keys():
			if str(
				raw_key
			) in preferred_keys:
				continue

			var dynamic_nested_raw: Variant = cursor.get(
				raw_key,
				{}
			)

			if (
				typeof(dynamic_nested_raw)
				== TYPE_DICTIONARY
			):
				var dynamic_nested: Dictionary = (
					dynamic_nested_raw as Dictionary
				).duplicate(true)

				if not dynamic_nested.is_empty():
					queue.append(
						dynamic_nested
					)

	return {}

func _request_career_hub_observable_contract(
	actor: Person,
	status_text: String,
	source: String
) -> Dictionary:
	if (
		gs == null
		or actor == null
	):
		return {}

	_ensure_career_hub_panel()



	if (
		career_hub_panel != null
		and is_instance_valid(
			career_hub_panel
		)
		and _career_hub_contract_is_hot(
			career_hub_panel.active_contract,
			int(
				actor.id
			)
		)
	):
		return {
			"success": true,
			"type": "career_hub_cached_hot_projection_preserved",
			"career_hub_contract": (
				career_hub_panel
				.active_contract
				.duplicate(true)
			)
		}

	var projection_sequence: int = int(
		get_meta(
			"career_hub_observable_projection_sequence",
			0
		)
	) + 1
	set_meta(
		"career_hub_observable_projection_sequence",
		projection_sequence
	)

	var payload: Dictionary = {
		"actor_id": int(
			actor.id
		),
		"active_section": career_hub_active_section_id,
		"career_lane": career_hub_active_lane,
		"status_text": status_text,
		"source": source,
		"projection_request_id": "%d:%d:%d:observe_partial" % [
			int(
				actor.id
			),
			projection_sequence,
			int(
				Time.get_ticks_msec()
			)
		],
		"ui_is_expression_only": true
	}
	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"intent_type": (
				"career_hub_observable_contract_intent"
			),
			"surface_id": "career_hub_panel",
			"action_id": "observe_partial",
			"payload": payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"career_hub_contract_engine"
				),
				"method": "emit_observable_contract",
				"pass_actor_payload": true,
				"actor_id": int(
					actor.id
				)
			},
			"source": source,
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"surface_id": "career_hub_panel",
			"action_id": "observe_partial",
			"source": source
		}
	)
	var route_result: Dictionary = (
		_career_hub_contract_route_result(
			report
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"career_hub_contract",
			{}
		)
	)

	if not _career_hub_contract_is_renderable(
		contract,
		int(
			actor.id
		)
	):
		return route_result

	career_hub_active_actor_id = int(
		actor.id
	)
	career_hub_active_section_id = str(
		contract.get(
			"active_section",
			career_hub_active_section_id
		)
	).strip_edges().to_lower()
	career_hub_active_lane = str(
		contract.get(
			"career_lane",
			career_hub_active_lane
		)
	).strip_edges().to_lower()

	if career_hub_active_section_id == "":
		career_hub_active_section_id = "overview"

	if career_hub_active_lane not in [
		"full_time",
		"part_time"
	]:
		career_hub_active_lane = "full_time"

	career_hub_panel.open_contract(
