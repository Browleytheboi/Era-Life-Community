	var detail:= Label.new()
	detail.autowrap_mode = (
		TextServer.AUTOWRAP_WORD_SMART
	)
	detail.text = "%s • %s • %s\n%s" % [
		str(
			weapon.get(
				"type",
				"weapon"
			)
		).capitalize(),
		str(
			weapon.get(
				"legality_label",
				"Legal"
			)
