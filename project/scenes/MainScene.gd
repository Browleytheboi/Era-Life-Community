func _open_relationship_money_popup(target: Person) -> void:
	_ensure_relationship_money_popup()
	if target == null or gs == null or gs.player == null:
		return

	relationship_money_popup_target_id = int(target.id)

	if relationship_profile_popup != null:
		relationship_profile_popup.visible = false

	relationship_money_popup.visible = true
	_bring_modal_to_front(relationship_money_popup)

	var max_amount: int = max(0, int(gs.player.bank_balance))
	relationship_money_popup_slider.min_value = 0
	relationship_money_popup_slider.max_value = max_amount
	relationship_money_popup_slider.step = 1
	relationship_money_popup_slider.value = max_amount

	relationship_money_popup_title.text = "Send Money to %s %s" % [
		target.first_name,
		target.last_name
	]
	relationship_money_popup_status.text = ""
	_on_relationship_money_slider_changed(relationship_money_popup_slider.value)
func _on_relationship_money_slider_changed(value: float) -> void:
	if relationship_money_popup_value_label == null or gs == null or gs.economy_engine == null:
		return
	relationship_money_popup_value_label.text = gs.economy_engine.format_money(int(value))
func _close_relationship_money_popup() -> void:
	var target_id: int = relationship_money_popup_target_id
	relationship_money_popup_target_id = -1

	if relationship_money_popup != null:
		relationship_money_popup.visible = false

	if relationship_profile_popup_open and target_id > 0:
		var target: Person = gs.get_or_reactivate_npc_by_id(target_id) if gs != null else null
		if target != null:
			_show_relationship_profile_popup(target)
func _on_relationship_money_confirm_pressed() -> void:
	if gs == null or gs.relationship_activities_engine == null:
		return
	if relationship_money_popup_target_id <= 0:
		return
	var target: Person = gs.get_or_reactivate_npc_by_id(relationship_money_popup_target_id)
	if target == null:
		return

	var amount: int = int(relationship_money_popup_slider.value)
	var result: Dictionary = gs.relationship_activities_engine.give_money(target, amount)

	_close_relationship_money_popup()
	cached_last_result = result
	_append_text_to_diary(str(result.get("text", "Done.")), false)
	_render_life_diary_panel()
	_update_player_stats_overlay()

	if relationship_profile_popup_open and target != null:
		_show_relationship_profile_popup(target)
func _make_relationship_browser_action_button(label: String, action_id: String, target_id: int = -1) -> Button:
	var btn:= Button.new()
	btn.text = label
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	btn.custom_minimum_size = Vector2(0, 48)
	btn.mouse_filter = Control.MOUSE_FILTER_STOP
	btn.focus_mode = Control.FOCUS_ALL
	btn.disabled = false

	var resolved_target_id: int = _relationship_profile_active_target_id(target_id)
	btn.set_meta("relationship_profile_action_id", action_id)
	btn.set_meta("relationship_profile_target_id", resolved_target_id)

	var target: Person = _relationship_profile_active_target(resolved_target_id)
	var switch_shell_hot: bool = true

	if action_id == "switch_to_character":
		var switch_target_alive: bool = target != null and bool(target.alive) and float(target.health) > 0.0
		switch_shell_hot = switch_target_alive and _relationship_profile_playable_life_shell_is_hot(target)
		var switch_intent_allowed: bool = switch_target_alive and switch_shell_hot

		if switch_target_alive and not switch_shell_hot:
			call_deferred(
				"_prewarm_relationship_profile_zero_frame_switch_candidate",
				target,
				"relationship_profile_action_button_surface_not_hot"
			)

		btn.disabled = not switch_intent_allowed
		btn.mouse_filter = Control.MOUSE_FILTER_STOP if switch_intent_allowed else Control.MOUSE_FILTER_IGNORE
		btn.focus_mode = Control.FOCUS_ALL if switch_intent_allowed else Control.FOCUS_NONE
		btn.tooltip_text = "" if switch_shell_hot else "Switch lens is staging. The button unlocks when this actor's life shell is ready."
		btn.set_meta("switch_zero_frame_packet_hot", switch_shell_hot)
		btn.set_meta("switch_pointer_fallback_allowed", false)
		btn.set_meta("switch_button_is_intent_door_not_packet_gate", true)
		btn.set_meta("switch_button_requires_prewarmed_target_lens_packet", true)

	var pressed_callable: Callable = Callable(self, "_on_relationship_browser_action_pressed").bind(action_id, resolved_target_id)
	if not btn.pressed.is_connected(pressed_callable):
		btn.pressed.connect(pressed_callable)

	var gui_callable: Callable = Callable(self, "_on_relationship_profile_action_button_gui_input").bind(action_id, resolved_target_id)
	if not btn.gui_input.is_connected(gui_callable):
		btn.gui_input.connect(gui_callable)

	btn.add_theme_stylebox_override("normal", _build_ui_nav_button_style("normal", 0.24, false))
	btn.add_theme_stylebox_override("hover", _build_ui_nav_button_style("hover", 0.62, false))
	btn.add_theme_stylebox_override("pressed", _build_ui_nav_button_style("pressed", 0.92, false))
	btn.add_theme_stylebox_override("focus", _build_ui_nav_button_style("hover", 0.75, false))
	btn.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))

	if action_id == "switch_to_character":
		btn.custom_minimum_size = Vector2(0, 56)
		btn.add_theme_stylebox_override("normal", _build_ui_nav_button_style("hover", 0.6 if switch_shell_hot else 0.2, false))
		btn.add_theme_stylebox_override("hover", _build_ui_nav_button_style("pressed", 0.82 if switch_shell_hot else 0.2, false))
		btn.add_theme_stylebox_override("pressed", _build_ui_nav_button_style("pressed", 1.0 if switch_shell_hot else 0.2, false))
		btn.add_theme_stylebox_override("focus", _build_ui_nav_button_style("pressed", 0.9 if switch_shell_hot else 0.2, false))
		btn.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0) if switch_shell_hot else Color(0.65, 0.72, 0.76, 0.82))

	return btn
func _populate_relationship_browser_actions(_target: Person) -> void:
	_clear_container_children(relationships_browser_actions)



func _open_relationship_profile_for_person_id(
	person_id: int,
	return_context: String = ""
) -> void:
	if gs == null:
		return

	var target_id: int = int(person_id)

	if target_id <= 0:
		return




	var target: Person = (
		_relationship_profile_resolve_target_for_ui(
			target_id,
			false
		)
	)

	if target == null:
		if (
			relationship_hub_panel != null
			and is_instance_valid(
				relationship_hub_panel
			)
		):
			relationship_hub_panel.set_status(
				"That relationship profile is not currently observable."
			)
		return



	var previous_surface_only_cache: bool = bool(
		get_meta(
			"relationship_profile_cache_surface_only_no_switch_prewarm",
			false
		)
	)

	set_meta(
		"relationship_profile_cache_surface_only_no_switch_prewarm",
		true
	)
	_relationship_profile_cache_target_for_surface(
		target
	)
	set_meta(
		"relationship_profile_cache_surface_only_no_switch_prewarm",
		previous_surface_only_cache
	)

	var clean_return_context: String = str(
		return_context
	).strip_edges()

	if clean_return_context != "":
		relationship_profile_return_context = clean_return_context
	elif ui_contract_active_surface_id.strip_edges() == (
		"relationship_contract_hub"
	):
		relationship_profile_return_context = (
			"relationship_contract_hub"
		)
	elif (
		institution_hub_open
		and institution_hub_kind.strip_edges().to_lower()
		== "relationships"
	):
		relationship_profile_return_context = (
			"institution_relationship_hub"
		)
	elif (
		relationships_browser_open
		or current_panel == "relationships"
	):
		relationship_profile_return_context = (
			"relationship_contract_hub"
		)

	_show_relationship_profile_popup(
		target
	)
func _on_relationship_browser_target_pressed(npc_id: int) -> void:
	_open_relationship_profile_for_person_id(npc_id, "relationship_contract_hub")
func _can_ask_out_target(target: Person) -> bool:
	if target == null or gs == null or gs.player == null:
		return false
	if not target.alive or not gs.player.alive:
		return false
	if int(target.id) == int(gs.player.id):
		return false

	var relation_label:= _relationship_label_for_target(target)
	var blocked_relation_labels:= [
		"Father", "Mother",
		"Brother", "Sister",
		"Son", "Daughter", "Child",
		"Father-in-Law", "Mother-in-Law",
		"Brother-in-Law", "Sister-in-Law",
		"Grandfather-in-Law", "Grandmother-in-Law",
		"Great Grandfather-in-Law", "Great Grandmother-in-Law",
		"Maternal Grandfather", "Maternal Grandmother",
		"Paternal Grandfather", "Paternal Grandmother",
		"Maternal Great Grandfather", "Maternal Great Grandmother",
		"Paternal Great Grandfather", "Paternal Great Grandmother",
		"Husband", "Wife",
		"Fiancé", "Fiancée",
		"Boyfriend", "Girlfriend",
		"Partner"
	]
	if relation_label in blocked_relation_labels:
		return false

	var player_age: int = int(gs.player.age)
	var target_age: int = int(target.age)
	if player_age < 14:
		return false
	if player_age < 18:
		return target_age >= 14 and target_age <= 17
	return target_age >= 18
