	card.set_meta("observable_population_node", node.duplicate(true))
	card.set_meta("realm_id", realm_id)
	card.set_meta("section_kind", section_kind)
	card.set_meta("ui_is_renderer_only", true)
	card.set_meta("runtime_person_materialization_forbidden", true)


func _build_crown_population_realm_stability_contract(realm_id: int, officials: Array, nobles: Array, _masters: Array, citizens: Array, realm_name: String = "") -> Dictionary:
	var ruler_pressure: int = 0
	var noble_pressure: int = 0
	var citizen_pressure: int = 0
	var merchant_pressure: int = 0
	var peasant_pressure: int = 0

	for raw_official in officials:
		var official: Person = raw_official
		if official != null:
			ruler_pressure = max(ruler_pressure, _crown_population_successcion_pressure_value(official, realm_id, "official"))

	for raw_noble in nobles:
		var noble: Person = raw_noble
		if noble != null:
			noble_pressure = max(noble_pressure, _crown_population_successcion_pressure_value(noble, realm_id, "noble"))

	for raw_citizen in citizens:
		var citizen: Person = raw_citizen
		if citizen == null:
			continue

		var strata_key: String = _crown_population_citizen_strata_key(citizen, realm_id, realm_name)
		var unrest: int = clampi(int(round((float(citizen.hunger) * 0.45) + (float(100 - citizen.mental_health) * 0.3) + (float(100 - citizen.health) * 0.25))), 0, 100)

		if strata_key in ["merchant", "upper_class", "elite"]:
			merchant_pressure = max(merchant_pressure, MainSceneLogic._crown_population_influence_value(gs, citizen, realm_id, "citizen"))
		elif strata_key in ["peasant", "low_class"]:
			peasant_pressure = max(peasant_pressure, unrest)

		citizen_pressure = max(citizen_pressure, unrest)

	var overall: int = clampi(int(round((float(ruler_pressure) * 0.25) + (float(noble_pressure) * 0.24) + (float(citizen_pressure) * 0.27) + (float(peasant_pressure) * 0.14) + (float(merchant_pressure) * 0.1))), 0, 100)

	return {
		"schema": "eralife.realm_stability_view_contract",
		"version": 1,
		"realm_id": realm_id,
		"ruler_pressure": ruler_pressure,
		"noble_pressure": noble_pressure,
		"citizen_unrest": citizen_pressure,
		"merchant_pressure": merchant_pressure,
		"peasant_unrest": peasant_pressure,
		"overall_tension": overall,
		"ui_is_renderer_only": true
	}


