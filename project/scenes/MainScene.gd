func _interactive_surface_is_visible(surface: Variant) -> bool:
	if surface == null:
		return false

	if typeof(surface) != TYPE_OBJECT:
		return false

	if not is_instance_valid(surface):
		return false

	if not (surface is Control):
		return false

	var control_surface: Control = (
		surface as Control
	)

	return bool(
		control_surface.visible
	)

func _enforce_single_interactive_surface_authority(
	active_surface: Control,
	active_key: String,
	reason: String = "surface_claim"
) -> void:
	var previous_key: String = str(
		get_meta(
			"last_interactive_surface_claimed",
			""
		)
	).strip_edges().to_lower()

	if previous_key != "" and previous_key != active_key:
		var previous_surface: Control = (
			_interactive_surface_authority_candidate_by_key(
				previous_key
			)
		)

		if (
			previous_surface != null
			and is_instance_valid(previous_surface)
			and previous_surface != active_surface
		):
			previous_surface.mouse_filter = Control.MOUSE_FILTER_IGNORE
			previous_surface.set_meta(
				"interactive_surface_input_suspended",
				true
			)
			previous_surface.set_meta(
				"interactive_surface_suspended_by",
				active_key
			)
			previous_surface.set_meta(
				"interactive_surface_suspended_reason",
				reason
			)
			previous_surface.set_meta(
				"interactive_surface_suspended_at_ms",
				int(Time.get_ticks_msec())
			)

	active_surface.set_meta(
		"interactive_surface_input_suspended",
		false
	)
	active_surface.set_meta(
		"interactive_surface_authority_contract",
		{
			"schema": "eralife.global_surface_authority_contract",
			"version": 2,
			"active_surface": active_key,
			"previous_surface": previous_key,
			"reason": reason,
			"claimed_at_ms": int(Time.get_ticks_msec()),
			"law": "only_previous_and_active_surfaces_are_touched",
		}
	)
func _claim_interactive_surface_authority(
	surface: Control,
	surface_key: String,
	reason: String = "surface_claim",
	stop_mouse: bool = true,
	bring_front: bool = true
) -> bool:
	if surface == null or not is_instance_valid(surface):
		return false

	var clean_key: String = str(
		surface_key
	).strip_edges().to_lower()

	if clean_key == "":
		clean_key = "surface"



	var previous_key: String = str(
		get_meta(
			"last_interactive_surface_claimed",
			""
		)
	).strip_edges().to_lower()
	var previous_surface: Control = null

	if previous_key != "" and previous_key != clean_key:
		previous_surface = (
			_interactive_surface_authority_candidate_by_key(
				previous_key
			)
		)




	var has_declared_modal_z: bool = surface.has_meta(
		"modal_z_floor"
	)
	var declared_modal_z: int = int(
		surface.get_meta(
			"modal_z_floor",
			surface.z_index
		)
	)
	var minimum_surface_z: int = 720

	if has_declared_modal_z:
		minimum_surface_z = maxi(
			minimum_surface_z,
			declared_modal_z
		)
	elif (
		previous_surface != null
		and is_instance_valid(
			previous_surface
		)
	):



		minimum_surface_z = maxi(
			minimum_surface_z,
			previous_surface.z_index + 1
		)

	var registry_raw: Variant = get_meta(
		"interactive_surface_authority_registry",
		{}
	)
	var registry: Dictionary = (
		registry_raw as Dictionary
		if typeof(registry_raw) == TYPE_DICTIONARY
		else {}
	)
	registry [clean_key] = weakref(
		surface
	)
	set_meta(
		"interactive_surface_authority_registry",
		registry
	)

	surface.visible = true
	surface.process_mode = Node.PROCESS_MODE_INHERIT
	surface.z_as_relative = false

	if has_declared_modal_z:
		surface.z_index = MainSceneHelpers._safe_modal_z_index(
			declared_modal_z,
			minimum_surface_z
		)
	else:
		surface.z_index = maxi(
			surface.z_index,
			minimum_surface_z
		)

	if stop_mouse:
		surface.mouse_filter = Control.MOUSE_FILTER_STOP

	if bring_front:
		_bring_modal_to_front(
			surface
		)

	_enforce_single_interactive_surface_authority(
		surface,
		clean_key,
		reason
	)

	if _interactive_surface_should_quarantine_runtime_huds(
		clean_key
	):
		_quarantine_runtime_floating_hud_buttons_for_surface(
			"interactive_surface_claim:%s" % clean_key
		)
	else:
		call_deferred(
			"_update_boxing_hud"
		)
		call_deferred(
			"_sync_runtime_floating_hud_layering"
		)

	surface.set_meta(
		"interactive_surface_key",
		clean_key
	)
	surface.set_meta(
		"interactive_surface_claimed",
		true
	)
	surface.set_meta(
		"interactive_surface_claim_reason",
		reason
	)
	surface.set_meta(
		"interactive_surface_claimed_ms",
		int(Time.get_ticks_msec())
	)
	surface.set_meta(
		"interactive_surface_first_paint_has_priority",
		true
	)
	surface.set_meta(
		"interactive_surface_background_work_must_yield",
		true
	)
	surface.set_meta(
		"interactive_surface_timed_input_fence_started",
		false
	)
	surface.set_meta(
		"interactive_surface_resident_reveal_only",
		true
	)
	surface.set_meta(
		"interactive_surface_declared_modal_z",
		declared_modal_z
	)
	surface.set_meta(
		"interactive_surface_declared_modal_z_authoritative",
		has_declared_modal_z
	)
	surface.set_meta(
		"interactive_surface_navigation_history_may_raise_modal_z",
		not has_declared_modal_z
	)

	set_meta(
		"last_interactive_surface_claimed",
		clean_key
	)
	set_meta(
		"last_interactive_surface_claim_reason",
		reason
	)
	set_meta(
		"last_interactive_surface_claimed_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"interactive_surface_claim_scene_tree_scan_performed",
		false
	)
	set_meta(
		"interactive_surface_claim_reserved_input_frame",
		false
	)
	set_meta(
		"interactive_surface_claim_timed_input_fence_started",
		false
	)
	set_meta(
		"interactive_surface_claim_minimum_z",
		minimum_surface_z
	)

	return true
func _interactive_surface_should_quarantine_runtime_huds(
	surface_key: String
) -> bool:
	var clean_key: String = str(
		surface_key
	).strip_edges().to_lower()

	if clean_key.begins_with(
		"standard_tab_popup"
	):
		return false





	if clean_key in [
		"assets_contract_panel",
		"property_market_panel",
		"vehicle_market_panel",
		"property_viewer_panel",
		"property_makeover_panel"
	]:
		return false

	if (
		clean_key.begins_with(
			"assets_contract_panel:"
		)
		or clean_key.begins_with(
			"property_market_panel:"
		)
		or clean_key.begins_with(
			"vehicle_market_panel:"
		)
		or clean_key.begins_with(
			"property_viewer_panel:"
		)
		or clean_key.begins_with(
			"property_makeover_panel:"
		)
	):
		return false

	if clean_key.begins_with(
		"institution_hub:"
	):
		var kind: String = clean_key.replace(
			"institution_hub:",
			""
		).strip_edges()

		if kind in [
			"",
			"life",
			"world",
			"school",
			"activities",
			"relationships",
			"career"
		]:
			return false

	return true
func _claim_institution_hub_surface_authority(kind: String = "", reason: String = "institution_hub_claim") -> bool:
	if institution_hub_overlay == null:
		return false
	if not is_instance_valid(institution_hub_overlay):
		return false

	var clean_kind: String = str(kind).strip_edges().to_lower()
	if clean_kind == "":
		clean_kind = str(institution_hub_kind).strip_edges().to_lower()

	if clean_kind != "":
		institution_hub_kind = clean_kind

	institution_hub_open = true

	if clean_kind == "relationships":
		current_panel = "relationships"

	var claimed: bool = _claim_interactive_surface_authority(
		institution_hub_overlay,
		"institution_hub:%s" % clean_kind,
		reason,
		true,
		true
	)

	if claimed:
		set_meta("institution_hub_surface_claim_reason", reason)
		set_meta("institution_hub_surface_claimed_ms", int(Time.get_ticks_msec()))

	return claimed


func _visible_institution_hub_surface_should_render() -> bool:
	if institution_hub_overlay == null:
		return false
	if not is_instance_valid(institution_hub_overlay):
		return false
	if not institution_hub_overlay.visible:
		return false

	institution_hub_open = true

	if str(institution_hub_kind).strip_edges().to_lower() == "relationships":
		current_panel = "relationships"

