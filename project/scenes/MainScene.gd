		_lock_first_frame_ui_snapshot(shell_snapshot, "deferred_begin_prewarmed_capsule_shell_only")

		_force_spawn_ready_live_ui_shell("deferred_begin_prewarmed_capsule_shell_only")
		_schedule_post_first_frame_god_mode_life_boot("deferred_begin_prewarmed_capsule_shell_only")
		return



	gs._hydrate_reality_settings()

	var fallback_snapshot: Dictionary = _build_first_frame_ui_snapshot_from_game_state(gs, "deferred_begin_fresh_life_boot")
	_lock_first_frame_ui_snapshot(fallback_snapshot, "deferred_begin_fresh_life_boot")

	_finalize_game_boot()
	set_meta("god_mode_capsule_entry_handoff_active", false)
func _build_random_god_mode_settings() -> Dictionary:
	var settings:= _build_default_custom_settings()

	if gs == null:
		return settings

	var era_engine:= _get_ui_era_engine()

	if era_engine == null:
		return settings

	var reality_modes: Array = [
		"realistic",
		"enhanced",
		"chaos"
	]
	var reality_mode: String = str(
		reality_modes [
			randi() % reality_modes.size()
		]
	)

	var era_keys: Array = _era_keys_for_picker()

	if era_keys.is_empty():
		era_keys = [
			"Modern"
		]

	var era_key: String = str(
		era_keys [
			randi() % era_keys.size()
		]
	)
	var era_data: Dictionary = era_engine.eras.get(
		era_key,
		{}
	)
	var start_year: int = int(
		era_data.get(
			"start_year",
			_representative_default_year_for_era(
				era_key
			)
		)
	)
	var end_year: int = int(
		era_data.get(
			"end_year",
			start_year
		)
	)

	if end_year < start_year:
		var swap_year: int = start_year
		start_year = end_year
		end_year = swap_year

	var random_year: int = randi_range(
		start_year,
		end_year
	)
	var gender: String = (
		"Male"
		if (
			randi() % 2
		) == 0
		else "Female"
	)

	var countries: Array = (
		era_engine.get_countries_for_era(
			era_key
		)
	)

	countries = MainSceneLogic._filter_birth_countries_for_reality_mode(
		countries,
		reality_mode
	)

	var country: String = ""

	if not countries.is_empty():
		country = str(
			countries [
				randi() % countries.size()
			]
		)

	var cities: Array = (
		era_engine.get_cities_for_era_country(
			era_key,
			country
		)
	)

	cities = _filter_birth_cities_for_reality_mode(
		era_key,
		cities,
		reality_mode
	)

	var city: String = ""

	if not cities.is_empty():
		city = str(
			cities [
				randi() % cities.size()
			]
		)
	elif country == "":
		var any_cities: Array = (
			era_engine.get_cities_for_era_country(
				era_key,
				""
			)
		)

		any_cities = _filter_birth_cities_for_reality_mode(
			era_key,
			any_cities,
			reality_mode
		)

		if not any_cities.is_empty():
			city = str(
				any_cities [
					randi() % any_cities.size()
				]
			)
			country = str(
				era_engine.get_country_for_era_city(
					era_key,
					city
				)
			)

	if (
		country == ""
		and city != ""
	):
		country = str(
			era_engine.get_country_for_era_city(
				era_key,
				city
			)
		)

	if (
		not MainSceneLogic._reality_mode_allows_elemental_birth_locations(
			reality_mode
		)
		and MainSceneHelpers._is_elemental_nation_name(
			country
		)
	):
		country = ""
		city = ""




	var royal_social_class_mode: bool = false

	if country != "":
		var government_style: String = (
			_country_government_style_for_picker(
				country,
				era_key
			)
		)
		var lowered_country: String = (
			country.to_lower()
		)

		royal_social_class_mode = (
			MainSceneHelpers._government_style_supports_royalty(
				government_style
			)
			or MainSceneHelpers._is_elemental_nation_name(
				country
			)
			or lowered_country.contains(
				"kingdom"
			)
			or lowered_country.contains(
				"empire"
			)
			or lowered_country.contains(
				"sultanate"
			)
			or lowered_country.contains(
				"dynasty"
			)
		)

	var social_class_choices: Array = [
		"Lower Class",
		"Working Class",
		"Middle Class",
		"Upperclass",
		"Elite"
	]

	if royal_social_class_mode:
		social_class_choices = [
			"Peasant",
			"Commoner",
			"Merchant",
			"Noble",
			"Royal"
		]

	var social_class: String = str(
		social_class_choices [
			randi() % social_class_choices.size()
		]
	)

	var era_name: String = str(
		era_data.get(
			"name",
			"%s Era" % era_key
		)
	)
	var names_db: NamesDB = gs.names_db

	if names_db == null:
		names_db = NamesDB.new(
			gs
		)

	var first_name: String = str(
		names_db.random_first_for_era(
			gender,
			era_name
		)
	)
	var last_name: String = str(
		names_db.last_name_for_birthplace(
			era_name,
			city,
			country
		)
	)

	if last_name.strip_edges() == "":
		last_name = str(
			names_db.random_last_for_era(
				era_name
			)
		)

	var bank_balance: int = int(
		randi_range(
			0,
			100
		)
	) * 50000

	var bending_choices: Array = [
		"none",
		"air",
		"water",
		"earth",
		"fire",
		"avatar"
	]

	if not MainSceneLogic._reality_mode_allows_elemental_birth_locations(
		reality_mode
	):
		bending_choices = [
			"none"
		]

	settings [
		"first_name"
	] = first_name
	settings [
		"last_name"
	] = last_name
	settings [
		"gender"
	] = gender
	settings [
		"social_class"
	] = social_class
	settings [
		"royal_rank"
	] = ""
	settings [
		"year_locked"
	] = false
	settings [
		"bending_type"
	] = str(
		bending_choices [
			randi() % bending_choices.size()
		]
	)
	settings [
		"year"
	] = random_year
	settings [
		"month"
	] = randi_range(
		1,
		12
	)
	settings [
		"day"
	] = randi_range(
		1,
		28
	)
	settings [
		"era"
	] = era_key
	settings [
		"country"
	] = country
	settings [
		"city"
	] = city
	settings [
		"health"
	] = randi_range(
		25,
		200
	)
	settings [
		"smarts"
	] = randi_range(
		0,
		100
	)
	settings [
		"looks"
	] = randi_range(
		0,
		100
	)
	settings [
		"mental_health"
	] = randi_range(
		0,
		100
	)
	settings [
		"satisfaction"
	] = randi_range(
		0,
		100
	)
	settings [
		"fertility"
	] = randi_range(
		0,
		100
	)
	settings [
		"bank_balance"
	] = bank_balance
	settings [
		"starting_infinity_stones"
	] = randi_range(
		0,
		2
	)
	settings [
		"start_with_red_bonnet"
	] = bool(
		(
			randi() % 100
		) < 20
	)
	settings [
		"reality_mode"
	] = reality_mode
	settings [
		"feature_overrides"
	] = MainSceneHelpers._feature_overrides_for_mode(
		reality_mode
	)
	settings [
		"reality_mode_label"
	] = MainSceneLogic._display_reality_mode_label_from_settings(
		settings
	)
	settings [
		"_god_mode_entry_kind"
	] = "random"

	return settings

func _on_god_mode_start_random_life_pressed() -> void:
	if gs == null:
		return

	_reset_god_mode_reality_candidate("random_life_pressed")

	var settings:= _build_random_god_mode_settings()
	settings ["_god_mode_entry_kind"] = "random"
	settings = _apply_god_mode_reality_candidate_to_settings(settings, "random_life_pressed")

	var signature: String = _god_mode_life_prewarm_signature(settings)
	if signature == "":
		_restore_god_mode_start_button_after_failed_entry("Random life could not build a valid prewarm signature.")
		return

	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("god_mode_random_life_start_after_prewarm_requested", true)
	set_meta("god_mode_random_life_start_after_prewarm_settings", settings.duplicate(true))
	set_meta("god_mode_random_life_start_after_prewarm_signature", signature)
	set_meta("god_mode_capsule_entry_handoff_active", true)
	set_meta("god_mode_life_entry_full_ui_required", true)
	set_meta("prewarmed_capsule_entry_shell_first", false)
	set_meta("god_mode_shell_first_handoff_requested", false)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("startup_birth_loading_overlay_active", false)
	set_meta("birth_entry_reality_surge_active", false)
	set_meta("birth_entry_reality_surge_first_frame_committed", true)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 240)
	set_meta("spawn_ready_era_border_fast_until_ms", now_ms + 2400)

	if god_mode_start_random_life_button != null and is_instance_valid(god_mode_start_random_life_button):
		god_mode_start_random_life_button.disabled = true
		god_mode_start_random_life_button.text = "Entering EraLife..."
		god_mode_start_random_life_button.tooltip_text = "Building and entering a random prewarmed EraLife reality."
		god_mode_start_random_life_button.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if god_mode_start_button != null and is_instance_valid(god_mode_start_button):
		god_mode_start_button.disabled = true
		god_mode_start_button.text = "Entering EraLife..."
		god_mode_start_button.tooltip_text = "Entering EraLife."

	_set_god_mode_prewarm_progress(
		1.0 if _is_god_mode_life_prewarm_ready_for_settings(settings) else 0.16,
		"Entering EraLife..." if _is_god_mode_life_prewarm_ready_for_settings(settings) else "Prewarming a random EraLife reality...",
		_is_god_mode_life_prewarm_ready_for_settings(settings)
	)

	if _is_god_mode_life_prewarm_ready_for_settings(settings):
		set_meta("god_mode_life_start_prevalidated_signature", signature)
		call_deferred("_enter_random_god_mode_life_from_ready_prewarm", signature, "random_life_pressed_hot_capsule")
		return

	var queue_report: Dictionary = _queue_god_mode_life_prewarm_from_settings(settings, "random_life_pressed", false)
	if queue_report.is_empty() or not bool(queue_report.get("success", false)):
		set_meta("god_mode_random_life_start_after_prewarm_requested", false)
		set_meta("god_mode_capsule_entry_handoff_active", false)
		remove_meta("god_mode_life_start_prevalidated_signature")
		_restore_god_mode_start_button_after_failed_entry(
			str(queue_report.get("reason", "Random life prewarm could not be queued."))
		)
func _enter_random_god_mode_life_from_ready_prewarm(signature: String, reason: String = "random_life_prewarm_ready") -> void:
	if str(get_meta("god_mode_random_life_start_after_prewarm_signature", "")).strip_edges() != signature:
		return

	var settings_raw: Variant = get_meta("god_mode_random_life_start_after_prewarm_settings", {})
	if typeof(settings_raw) != TYPE_DICTIONARY:
		set_meta("god_mode_random_life_start_after_prewarm_requested", false)
		set_meta("god_mode_capsule_entry_handoff_active", false)
		remove_meta("god_mode_life_start_prevalidated_signature")
		_restore_god_mode_start_button_after_failed_entry("Random life prewarm finished, but its settings packet was missing.")
		return

	var settings: Dictionary = (settings_raw as Dictionary).duplicate(true)

	if not _is_god_mode_life_prewarm_ready_for_settings(settings):
		set_meta("god_mode_capsule_entry_handoff_active", false)
		remove_meta("god_mode_life_start_prevalidated_signature")
		_restore_god_mode_start_button_after_failed_entry("Random life prewarm was not ready when entry tried to consume it.")
		return

	set_meta("god_mode_life_start_prevalidated_signature", signature)
	set_meta("god_mode_life_entry_full_ui_required", true)
	set_meta("prewarmed_capsule_entry_shell_first", false)
	set_meta("god_mode_shell_first_handoff_requested", false)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)

	var entered: bool = _enter_prewarmed_god_mode_life_full_ui_now(settings, reason)

	remove_meta("god_mode_life_start_prevalidated_signature")

	if entered:
		set_meta("god_mode_random_life_start_after_prewarm_requested", false)
		remove_meta("god_mode_random_life_start_after_prewarm_settings")
		remove_meta("god_mode_random_life_start_after_prewarm_signature")
		return

	set_meta("god_mode_random_life_start_after_prewarm_requested", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	_restore_god_mode_start_button_after_failed_entry("Random life prewarm was marked ready, but its hot capsule could not be consumed.")
func _begin_zero_frame_ui_render_enforcement(reason: String = "zero_frame_ui", hold_ms: int = 1200) -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var until_ms: int = now_ms + max(250, hold_ms)

	set_meta("zero_frame_ui_render_enforcement_active", true)
	set_meta("zero_frame_ui_render_enforcement_reason", reason)
	set_meta("zero_frame_ui_render_enforcement_started_at_ms", now_ms)
	set_meta("zero_frame_ui_render_enforcement_until_ms", until_ms)

	set_meta("runtime_interaction_quiet_until_ms", max(int(get_meta("runtime_interaction_quiet_until_ms", 0)), until_ms))
	set_meta("runtime_interaction_quiet_reason", reason)
	set_meta("ui_interaction_grace_until_ms", max(int(get_meta("ui_interaction_grace_until_ms", 0)), until_ms))

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["zero_frame_ui_render_enforcement_active"] = true
		gs.scenario_state ["zero_frame_ui_render_enforcement_reason"] = reason
		gs.scenario_state ["zero_frame_ui_render_enforcement_started_at_ms"] = now_ms
		gs.scenario_state ["zero_frame_ui_render_enforcement_until_ms"] = until_ms
		gs.scenario_state ["ui_first_frame_render_policy"] = "visible_shell_first_no_truth_work"
		gs.scenario_state ["ui_runtime_truth_mutation_blocked_until_ms"] = until_ms


func _zero_frame_ui_render_enforcement_active(now_ms: int = -1) -> bool:
	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	var local_until_ms: int = int(get_meta("zero_frame_ui_render_enforcement_until_ms", 0))
	if bool(get_meta("zero_frame_ui_render_enforcement_active", false)) and check_ms < local_until_ms:
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var state_until_ms: int = int(gs.scenario_state.get("zero_frame_ui_render_enforcement_until_ms", 0))
		if bool(gs.scenario_state.get("zero_frame_ui_render_enforcement_active", false)) and check_ms < state_until_ms:
			return true

	return false


func _release_zero_frame_ui_render_enforcement(reason: String = "zero_frame_ui") -> void:
