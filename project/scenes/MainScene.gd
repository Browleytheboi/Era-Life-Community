	var bank_actor_id: int = int(p.id)
	var previous_bank_actor_id: int = int(player_stats_overlay.get_meta("player_stats_bank_actor_id", -1))
	var bank_actor_changed: bool = previous_bank_actor_id != bank_actor_id

