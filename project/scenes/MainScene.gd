	_animate_standard_tab_experience(delta)
	_animate_relationship_popup_experience(delta)
	_animate_ui_nav_buttons(delta)
	_animate_panel_content_transition(delta)
	_animate_era_border_overlay(delta)
	_drive_era_audio_contract_runtime(delta)
	_drive_ui_pointer_activity_probe(now_ms)
func _global_runtime_kill_clamp_visible_shell_frame_no_state_spam(now_ms: int) -> void:
	if age_up_loading_runtime_active:
		age_up_loading_runtime_active = false

	if age_up_loading_finish_requested:
		age_up_loading_finish_requested = false

	if not age_up_loading_result.is_empty():
		age_up_loading_result = {}

	age_up_loading_paint_hold_frames = 0
	age_up_loading_exit_started_ms = 0

	if bool(get_meta("startup_live_shell_loading", false)):
		set_meta("startup_live_shell_loading", false)

	if bool(get_meta("startup_birth_loading_overlay_active", false)):
		set_meta("startup_birth_loading_overlay_active", false)

	if bool(get_meta("age_up_post_loading_finalize_pending", false)):
		set_meta("age_up_post_loading_finalize_pending", false)

	if bool(get_meta("post_spawn_ui_finalize_pending", false)):
		set_meta("post_spawn_ui_finalize_pending", false)

	if bool(get_meta("age_up_transition_busy", false)):
		set_meta("age_up_transition_busy", false)

	if bool(get_meta("life_runtime_systems_quarantined_until_world_prewarm_seen", false)):
		set_meta("life_runtime_systems_quarantined_until_world_prewarm_seen", false)

	if age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible:
		age_up_loading_overlay.visible = false
		age_up_loading_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var next_truth_ms: int = int(get_meta("global_runtime_kill_frame_truth_next_ms", 0))
	if now_ms >= next_truth_ms:
		set_meta("global_runtime_kill_frame_truth_next_ms", now_ms + 750)
		EraLog.truth("GLOBAL_RUNTIME_FRAME_LOCK|alive=1|panel=%s|loading_active=%s|busy=%s|boot_pending=%s|tab_prewarm=%s|relationship_tail=%s|at_ms=%d" % [
			current_panel,
			str(age_up_loading_runtime_active),
			str(get_meta("age_up_transition_busy", false)),
			str(get_meta("post_first_frame_god_mode_life_boot_pending", false)),
			str(get_meta("spawn_ready_main_tab_packet_prewarm_running", false)),
			str(get_meta("relationships_hub_next_switch_shell_tail_flush_ms", 0)),
			now_ms
		])
