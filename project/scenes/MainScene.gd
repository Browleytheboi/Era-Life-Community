	set_meta("age_up_post_live_tail_refresh_stage", 0)
	set_meta("age_up_tail_background_allowed_after_ms", 0)
	set_meta("age_up_post_live_tail_settle_until_ms", 0)
	set_meta("post_age_up_rewind_snapshot_pending", false)
	set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
