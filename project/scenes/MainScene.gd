func _pet_shop_listing_variants(
	listing: Dictionary
) -> Array:
	var variants_raw: Variant = listing.get(
		"variant_contracts",
		[]
	)

	if (
		typeof(variants_raw) == TYPE_ARRAY
		and not (
			variants_raw as Array
		).is_empty()
	):
		return variants_raw as Array

	return [
		{
			"variant_id": str(
				listing.get(
					"default_variant_id",
					"%s:default"
					% str(
						listing.get(
							"listing_id",
							"companion"
						)
					)
				)
			),
			"display_name": str(
				listing.get(
					"display_name",
					"Companion"
				)
			),
			"sub_species_name": str(
				listing.get(
					"sub_species_name",
					""
				)
			),
			"gender": str(
				listing.get(
					"gender",
					""
				)
			),
			"gender_label": str(
				listing.get(
					"gender_label",
					""
				)
			),
			"age_years": int(
				listing.get(
					"age_years",
					0
				)
			),
			"age_label": str(
				listing.get(
					"age_label",
					"Age unknown"
				)
			),
			"age_stage_label": str(
				listing.get(
					"age_stage_label",
					""
				)
			),
			"breeding_status_label": str(
				listing.get(
					"breeding_status_label",
					""
				)
			),
			"price": int(
				listing.get(
					"price",
					0
				)
			),
			"stats": listing.get(
				"stats",
				{}
			),
			"traits": listing.get(
				"traits",
				[]
			),
			"social_type": str(
				listing.get(
					"social_type",
					"companion"
				)
			)
		}
	]


func _pet_shop_cycle_listing_variant(
	card: PanelContainer,
	direction: int
) -> void:
	if (
		card == null
		or not is_instance_valid(
			card
		)
	):
		return

	var variants_raw: Variant = card.get_meta(
		"pet_shop_variant_contracts",
		[]
	)

	if typeof(variants_raw) != TYPE_ARRAY:
		return

	var variants: Array = (
		variants_raw as Array
	)

	if variants.size() <= 1:
		return

	var current_index: int = int(
		card.get_meta(
			"pet_shop_variant_index",
			0
		)
	)

	var next_index: int = (
		current_index + direction
	)

	if next_index < 0:
		next_index = variants.size() - 1
	elif next_index >= variants.size():
		next_index = 0

	_pet_shop_apply_variant_to_card(
		card,
		next_index
	)

	card.set_meta(
		"pet_shop_variant_arrow_engine_calls",
		false
	)
	card.set_meta(
		"pet_shop_variant_arrow_contract_resolution",
		false
	)


func _pet_shop_apply_variant_to_card(
	card: PanelContainer,
	variant_index: int
) -> void:
	if (
		card == null
		or not is_instance_valid(
			card
		)
	):
		return

	var listing_raw: Variant = card.get_meta(
		"pet_shop_listing_contract",
		{}
	)

	var variants_raw: Variant = card.get_meta(
		"pet_shop_variant_contracts",
		[]
	)

	var nodes_raw: Variant = card.get_meta(
		"pet_shop_variant_nodes",
		{}
	)

	if (
		typeof(listing_raw) != TYPE_DICTIONARY
		or typeof(variants_raw) != TYPE_ARRAY
		or typeof(nodes_raw) != TYPE_DICTIONARY
	):
		return

	var listing: Dictionary = (
		listing_raw as Dictionary
	)
	var variants: Array = (
		variants_raw as Array
	)
	var nodes: Dictionary = (
		nodes_raw as Dictionary
	)

	if variants.is_empty():
		return

	var resolved_index: int = clampi(
		variant_index,
		0,
		variants.size() - 1
	)

	var variant_raw: Variant = variants [
		resolved_index
	]

	if typeof(variant_raw) != TYPE_DICTIONARY:
		return

	var variant: Dictionary = (
		variant_raw as Dictionary
	)

	var species_name: String = str(
		listing.get(
			"display_name",
			variant.get(
				"species_name",
				"Companion"
			)
		)
	).strip_edges()

	var variant_name: String = str(
		variant.get(
			"sub_species_name",
			variant.get(
				"display_name",
				species_name
			)
		)
	).strip_edges()

	if variant_name == "":
		variant_name = species_name

	var title: Label = nodes.get(
		"title",
		null
	) as Label

	if title != null:
		var title_key: String = (
			variant_name.to_lower()
		)
		var species_key: String = (
			species_name.to_lower()
		)

		title.text = (
			variant_name
			if (
				species_key == ""
				or title_key.find(
					species_key
				) >= 0
			)
			else "%s %s"
			% [
				variant_name,
				species_name
			]
		)

	var subtitle: Label = nodes.get(
		"subtitle",
		null
	) as Label

	if subtitle != null:
		var subtitle_parts: Array = []

		var gender_label: String = str(
			variant.get(
				"gender_label",
				""
			)
		).strip_edges()

		if gender_label != "":
			subtitle_parts.append(
				gender_label
			)

		var age_stage_label: String = str(
			variant.get(
				"age_stage_label",
				""
			)
		).strip_edges()

		if age_stage_label != "":
			subtitle_parts.append(
				age_stage_label
			)

		var age_label: String = str(
			variant.get(
				"age_label",
				""
			)
		).strip_edges()

		if age_label != "":
			subtitle_parts.append(
				age_label
			)

		var breeding_label: String = str(
			variant.get(
				"breeding_status_label",
				""
			)
		).strip_edges()

		if breeding_label != "":
			subtitle_parts.append(
				breeding_label
			)

		subtitle.text = " • ".join(
			subtitle_parts
		)

	var price_label: Label = nodes.get(
		"price",
		null
	) as Label

	var variant_price: int = int(
		variant.get(
			"price",
			listing.get(
				"price",
				0
			)
		)
	)

	if price_label != null:
		price_label.text = (
			"$%d"
			% variant_price
		)

	var counter: Label = nodes.get(
		"counter",
		null
	) as Label

	if counter != null:
		counter.text = (
			"%d / %d"
			% [
				resolved_index + 1,
				variants.size()
			]
		)

	var description: Label = nodes.get(
		"description",
		null
	) as Label

	if description != null:
		description.text = str(
			listing.get(
				"description",
				(
					"A resident companion whose identity and "
					+ "behavior are already resolved."
				)
			)
		)

	var stats_raw: Variant = variant.get(
		"stats",
		listing.get(
			"stats",
			{}
		)
	)

	var stats: Dictionary = (
		stats_raw as Dictionary
		if typeof(stats_raw) == TYPE_DICTIONARY
		else {}
	)

	var stat_nodes_raw: Variant = nodes.get(
		"stats",
		{}
	)

	if typeof(stat_nodes_raw) == TYPE_DICTIONARY:
		var stat_nodes: Dictionary = (
			stat_nodes_raw as Dictionary
		)

		for stat_key in stat_nodes.keys():
			var row_raw: Variant = stat_nodes [
				stat_key
			]

			if typeof(row_raw) != TYPE_DICTIONARY:
				continue

			var row: Dictionary = (
				row_raw as Dictionary
			)

			var raw_value: int = int(
				stats.get(
					stat_key,
					0
				)
			)

			var display_value: int = (
				clampi(
					raw_value * 10,
					0,
					100
				)
				if stat_key == "danger"
				else clampi(
					raw_value,
					0,
					100
				)
			)

			var stat_label: Label = row.get(
				"label",
				null
			) as Label

			var stat_bar: ProgressBar = row.get(
				"bar",
				null
			) as ProgressBar

			if stat_label != null:
				stat_label.text = (
					"%s %d%%"
					% [
						str(
							stat_key
						).to_upper(),
						display_value
					]
				)

			if stat_bar != null:
				stat_bar.value = display_value

	var trait_label: Label = nodes.get(
		"traits",
		null
	) as Label

	if trait_label != null:
		var traits_raw: Variant = variant.get(
			"traits",
			listing.get(
				"traits",
				[]
			)
		)

		var traits: Array = (
			traits_raw as Array
			if typeof(traits_raw) == TYPE_ARRAY
			else []
		)

		var trait_labels: Array = []

		for trait_index in range(
			mini(
				traits.size(),
				3
			)
		):
			trait_labels.append(
				str(
					traits [
						trait_index
					]
				)
				.replace(
					"_",
					" "
				)
				.capitalize()
			)

		trait_label.text = (
			"✦ %s"
			% " • ".join(
				trait_labels
			)
			if not trait_labels.is_empty()
			else ""
		)

	var affordable: bool = bool(
		listing.get(
			"affordable",
			true
		)
	)

	var buy_button: Button = nodes.get(
		"buy_button",
		null
	) as Button

	if buy_button != null:
		buy_button.text = (
			"BRING HOME"
			if affordable
			else "INSUFFICIENT FUNDS"
		)
		buy_button.disabled = not affordable

	var previous_button: Button = nodes.get(
		"previous_button",
		null
	) as Button
	var next_button: Button = nodes.get(
		"next_button",
		null
	) as Button

	if previous_button != null:
		previous_button.visible = variants.size() > 1

	if next_button != null:
		next_button.visible = variants.size() > 1

	card.set_meta(
		"pet_shop_variant_index",
		resolved_index
	)
	card.set_meta(
		"pet_shop_selected_variant_id",
		str(
			variant.get(
				"variant_id",
				""
			)
		)
	)


func _pet_shop_buy_selected_variant(
	card: PanelContainer
) -> void:
	if (
		card == null
		or not is_instance_valid(
			card
		)
	):
		return

	var listing_raw: Variant = card.get_meta(
		"pet_shop_listing_contract",
		{}
	)

	if typeof(listing_raw) != TYPE_DICTIONARY:
		return

	var listing: Dictionary = (
		listing_raw as Dictionary
	)

	_on_pet_shop_listing_pressed(
		str(
			listing.get(
				"listing_id",
				""
			)
		),
		str(
			card.get_meta(
				"pet_shop_selected_variant_id",
				""
			)
		)
