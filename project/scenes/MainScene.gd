		gs != null
		and typeof(gs.scenario_state)
		== TYPE_DICTIONARY
	):
		gs.scenario_state [
			"relationship_profile_popup_shell_hot"
		] = true
		gs.scenario_state [
			"relationship_profile_open_is_door_not_build"
		] = true
		gs.scenario_state [
			"relationship_profile_open_press_work_forbidden"
		] = true

func _relationship_profile_bank_balance_text(
	target: Person
) -> String:
	if target == null:
		return "$0 USD"

	var amount: int = int(
		round(
			float(target.bank_balance)
		)
	)

	if (
		gs != null
		and gs.economy_engine != null
		and gs.economy_engine.has_method(
			"format_money"
		)
	):
		return gs.economy_engine.format_money(
			amount,
			target
		)

	var negative: bool = amount < 0
	var digits: String = str(
		abs(amount)
	)
	var grouped: String = ""

	while digits.length() > 3:
		grouped = (
			","
			+ digits.substr(
				digits.length() - 3,
				3
			)
			+ grouped
		)
		digits = digits.substr(
			0,
			digits.length() - 3
		)

	grouped = digits + grouped

	if negative:
		grouped = "-" + grouped

	return (
		"$%s USD"
		% grouped
	)

func _relationship_profile_header_row() -> HBoxContainer:
	var possible_controls: Array = [
		relationship_profile_popup_title,
		relationship_profile_popup_bank_label,
		relationship_profile_popup_edit_button,
		relationship_profile_popup_back_button,
		relationship_profile_popup_switch_button
	]

	for raw_control in possible_controls:
		if raw_control == null:
			continue
		if not is_instance_valid(raw_control):
			continue

		var control:= raw_control as Control
		if control == null:
			continue

		var parent_node:= control.get_parent()
		if parent_node != null and parent_node is HBoxContainer:
			return parent_node as HBoxContainer

	return null
func _relationship_profile_lock_header_order(header_row: HBoxContainer) -> void:
	if header_row == null or not is_instance_valid(header_row):
		return

	var ordered_controls: Array = [
		relationship_profile_popup_back_button,
		relationship_profile_popup_bank_label,
		relationship_profile_popup_title,
		relationship_profile_popup_switch_button,
		relationship_profile_popup_edit_button
	]

	var desired_index: int = 0
	for raw_control in ordered_controls:
		if raw_control == null:
			continue
		if not is_instance_valid(raw_control):
			continue

		var control:= raw_control as Control
		if control == null:
			continue

		var old_parent:= control.get_parent()
		if old_parent != null and old_parent != header_row:
			old_parent.remove_child(control)

		if control.get_parent() == null:
			header_row.add_child(control)

		if control.get_parent() == header_row and control.get_index() != desired_index:
			header_row.move_child(control, desired_index)

		desired_index += 1


func _relationship_profile_header_order_is_locked(header_row: HBoxContainer) -> bool:
	if header_row == null or not is_instance_valid(header_row):
		return false

	var ordered_controls: Array = [
		relationship_profile_popup_back_button,
		relationship_profile_popup_bank_label,
		relationship_profile_popup_title,
		relationship_profile_popup_switch_button,
		relationship_profile_popup_edit_button
	]

	var expected_index: int = 0
	for raw_control in ordered_controls:
		if raw_control == null:
			continue
		if not is_instance_valid(raw_control):
			continue

		var control:= raw_control as Control
		if control == null:
			continue

		if control.get_parent() != header_row:
			return false

		if control.get_index() != expected_index:
			return false

		expected_index += 1

	return true


func _relationship_profile_header_needs_repair(target: Person) -> bool:
	var header_row: HBoxContainer = _relationship_profile_header_row()
	if header_row == null:
		return true

	if relationship_profile_popup_switch_button == null or not is_instance_valid(relationship_profile_popup_switch_button):
		return true

	if relationship_profile_popup_switch_button.get_parent() != header_row:
		return true

	if relationship_profile_popup_edit_button != null and is_instance_valid(relationship_profile_popup_edit_button):
		if relationship_profile_popup_edit_button.get_parent() != header_row:
			return true

	if relationship_profile_popup_title != null and is_instance_valid(relationship_profile_popup_title):
		if str(relationship_profile_popup_title.text).strip_edges().ends_with(","):
			return true

	if target != null:
		if int(relationship_profile_popup_switch_button.get_meta("relationship_profile_target_id", -1)) != int(target.id):
			return true

	return not _relationship_profile_header_order_is_locked(header_row)

