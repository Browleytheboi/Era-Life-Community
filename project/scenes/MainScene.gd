func _refresh_crown_hub_chrome() -> void:
		if (
			crown_hub_overlay == null
			or not crown_hub_overlay.visible
			or gs == null
			or gs.player == null
		):
			return

		var summary: Dictionary = (
			_crown_hub_current_summary_for_chrome()
		)
		var core:= _crown_hud_core_color()
		var mood_color: Color = (
			MainSceneHelpers._crown_hub_mood_color(
				summary
			)
		)
		var pulse:= (
			(sin(crown_hud_breathe_time * 1.85) + 1.0)
			* 0.5
		)
		var section_name: String = str(
			crown_hub_current_section
		).strip_edges().to_lower()
		var published_section_ids: Dictionary = {}

		for raw_tab in MainSceneHelpers._safe_array(
			crown_hub_active_contract.get(
				"section_tabs",
				[]
			)
		):
			var tab: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_tab
			)
			var tab_id: String = str(
				tab.get(
					"id",
					tab.get(
						"key",
						""
					)
				)
			).strip_edges().to_lower()

			if tab_id != "":
				published_section_ids [
					tab_id
				] = true

		var war_tab_visible: bool = (
			published_section_ids.has(
				"war"
			)
			or bool(
				crown_hub_active_contract.get(
					"dynamic_war_tab_required",
					false
				)
			)
		)

		if crown_hub_dim != null:
			crown_hub_dim.color = Color(
				mood_color.r * 0.72 + core.r * 0.08,
				mood_color.g * 0.72 + core.g * 0.06,
				mood_color.b * 0.82 + core.b * 0.08,
				0.82
			)

		var room_tone:= (
			crown_hub_overlay.get_node_or_null(
				"CrownHubRoomTone"
