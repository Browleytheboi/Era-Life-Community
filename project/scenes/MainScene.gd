func _set_checkpoint_resume_nav_destination_ready(
	surface_id: String,
	projection_hot: bool
) -> void:
	var clean_surface_id: String = str(
		surface_id
	).strip_edges().to_lower()

	if not ui_nav_buttons.has(
		clean_surface_id
	):
		return

	var button:= ui_nav_buttons.get(
		clean_surface_id,
		null
	) as Button

	if (
		button == null
		or not is_instance_valid(
			button
		)
	):
		return


	button.visible = true
	button.disabled = false
	button.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	button.focus_mode = (
		Control.FOCUS_NONE
	)
	button.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)

	if projection_hot:
		button.tooltip_text = ""
	else:
		button.tooltip_text = (
			"Live truth is publishing into this surface."
		)

	button.set_meta(
		"checkpoint_resume_projection_hot",
		projection_hot
	)
	button.set_meta(
		"checkpoint_resume_visible_means_interactive",
		true
	)

	set_meta(
		"checkpoint_resume_nav_destination_%s_ready"
		% clean_surface_id,
		true
	)
	set_meta(
		"checkpoint_resume_nav_destination_%s_projection_hot"
		% clean_surface_id,
		projection_hot
	)
	set_meta(
		"checkpoint_resume_nav_destination_%s_ready_at_ms"
		% clean_surface_id,
		int(
			Time.get_ticks_msec()
		)
	)
