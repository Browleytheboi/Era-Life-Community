func _schedule_playable_life_viewer_packet_tail_apply(packet: Dictionary, clean_text: String = "", reason: String = "viewer_packet_tail_apply") -> void:
	if typeof(packet) != TYPE_DICTIONARY or packet.is_empty():
		return

	if MainSceneLogic._playable_life_viewer_packet_tail_apply_forbidden(packet, reason):
		set_meta("playable_life_viewer_tail_packet_apply_blocked", true)
		set_meta("playable_life_viewer_tail_packet_apply_blocked_reason", reason)
		set_meta("playable_life_viewer_tail_packet_apply_blocked_at_ms", int(Time.get_ticks_msec()))
		set_meta("playable_life_viewer_tail_packet_apply_blocked_for_relationship_switch", true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["playable_life_viewer_tail_packet_apply_blocked"] = true
			gs.scenario_state ["playable_life_viewer_tail_packet_apply_blocked_reason"] = reason
			gs.scenario_state ["playable_life_viewer_tail_packet_apply_blocked_at_ms"] = int(Time.get_ticks_msec())
			gs.scenario_state ["playable_life_viewer_tail_packet_apply_blocked_for_relationship_switch"] = true

		return

	set_meta("playable_life_viewer_tail_packet_apply_scheduled", true)
	set_meta("playable_life_viewer_tail_packet_apply_reason", reason)
	set_meta("playable_life_viewer_tail_packet_apply_at_ms", int(Time.get_ticks_msec()))
	set_meta("playable_life_viewer_tail_packet_apply_not_press_frame", true)
	set_meta("playable_life_viewer_tail_packet_apply_visible_frame_barrier", true)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_apply_playable_life_viewer_packet_zero_frame", packet, clean_text)
		call_deferred("_update_player_stats_overlay")
		return

	var timer:= tree.create_timer(0.42)
	timer.timeout.connect(
		func () -> void:
			_apply_playable_life_viewer_packet_zero_frame(packet, clean_text)
			_update_player_stats_overlay(),
		CONNECT_ONE_SHOT
	)
func _retarget_player_stats_overlay_lens_only(
	actor: Person,
	reason: String = "truth_anchor_lens_retarget",
	lens_cache: Dictionary = {}
) -> void:
	if actor == null:
		return

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		return

	var actor_id: int = int(actor.id)
	var clean_lens_cache: Dictionary = MainSceneHelpers._safe_dictionary(lens_cache)

	player_stats_overlay.visible = true
	player_stats_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
	player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_PASS
	player_stats_overlay.z_as_relative = false
	player_stats_overlay.z_index = 30
	player_stats_overlay.set_meta("player_stats_current_actor_id", actor_id)
	player_stats_overlay.set_meta("player_stats_bank_actor_id", actor_id)
	player_stats_overlay.set_meta("player_stats_force_truth_actor_id", actor_id)
	player_stats_overlay.set_meta("player_stats_force_truth_reason", reason)

	set_meta("startup_live_shell_loading", false)
	set_meta("player_stats_spawn_cinematic_pending", false)
	set_meta("player_stats_spawn_fill_consumed", false)

	var first_name: String = str(actor.first_name).strip_edges()
	var last_name: String = str(actor.last_name).strip_edges()
	var full_name: String = ("%s %s" % [first_name, last_name]).strip_edges()

	if full_name == "":
		full_name = str(clean_lens_cache.get("actor_name", "")).strip_edges()

	if full_name == "":
		full_name = MainSceneHelpers._person_display_name_for_identity_switch(actor)

