func _update_crown_throne_metrics(summary: Dictionary) -> void:
	var approval_value: int = clampi(int(summary.get("approval", 0)), 0, 100)
	var happiness_value: int = clampi(int(summary.get("happiness", 50)), 0, 100)
	var treasury_value: int = int(summary.get("treasury", 0))
	var approval_delta: int = int(summary.get("preview_approval_delta", 0))
	var happiness_delta: int = int(summary.get("preview_happiness_delta", 0))
	var preview_active: bool = bool(summary.get("preview_active", false))
	var pulse:= (sin(crown_hud_breathe_time * 2.6) + 1.0) * 0.5

	if crown_hub_approval_label != null:
		var trend_text: String = ""
		if preview_active:
			trend_text = "  Projection %s%d" % ["+" if approval_delta >= 0 else "", approval_delta]
		var approval_label_text: String = "Presidential Approval" if _crown_hub_uses_federal_republic_layout() else "Ruler Approval"
		crown_hub_approval_label.text = "%s: %d/100%s" % [approval_label_text, approval_value, trend_text]
		crown_hub_approval_label.add_theme_color_override(
			"font_color",
			MainSceneHelpers._crown_hub_projection_color(approval_delta) if preview_active else Color(1.0, 0.88, 0.62, 0.88 + (pulse * 0.12))
		)

	if crown_hub_happiness_label != null:
		var happiness_text: String = ""
		if preview_active:
			happiness_text = "  Projection %s%d" % ["+" if happiness_delta >= 0 else "", happiness_delta]
		crown_hub_happiness_label.text = "Citizen Happiness: %d/100%s" % [happiness_value, happiness_text]
		crown_hub_happiness_label.add_theme_color_override(
			"font_color",
			MainSceneHelpers._crown_hub_projection_color(happiness_delta) if preview_active else Color(0.76, 0.92, 1.0, 0.88 + (pulse * 0.12))
		)
		crown_hub_happiness_label.position.x = 1.5 * sin(crown_hud_breathe_time * 14.0) if happiness_value <= 25 else 0.0

	if crown_hub_approval_bar != null:
		crown_hub_approval_bar.modulate = Color(1.0, 0.94 + (pulse * 0.06), 0.72, 1.0)
	if crown_hub_happiness_bar != null:
		crown_hub_happiness_bar.modulate = Color(1.0, 0.82, 0.82, 1.0) if happiness_value <= 25 else Color(0.86, 0.94, 1.0, 1.0)

	if treasury_value >= 1000000:
		crown_hub_shimmer_labels.append(crown_hub_approval_label)

	_animate_crown_metric_bar(crown_hub_approval_bar, approval_value)
	_animate_crown_metric_bar(crown_hub_happiness_bar, happiness_value)
func _animate_crown_metric_bar(bar: ProgressBar, target_value: int) -> void:
	if bar == null:
		return

	var clamped_target: int = clamp(target_value, 0, 100)
	var previous_target: int = int(bar.get_meta("crown_metric_target", -1)) if bar.has_meta("crown_metric_target") else -1
	bar.set_meta("crown_metric_target", clamped_target)

	if previous_target == clamped_target and int(round(float(bar.value))) == clamped_target:
		return

	var tween:= create_tween()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(bar, "value", clamped_target, 0.45)


func _animate_crown_shimmer_labels(_core: Color, pulse: float) -> void:
	if crown_hub_shimmer_labels.is_empty():
		return

	var alpha_value: float = 0.76 + (pulse * 0.24)
	var glow_value: float = 0.62 + (pulse * 0.3)

	for raw_label in crown_hub_shimmer_labels.duplicate():
		if raw_label == null or not is_instance_valid(raw_label):
			crown_hub_shimmer_labels.erase(raw_label)
			continue

		var label: Label = raw_label as Label
		if label == null:
			continue

		label.add_theme_color_override("font_color", Color(1.0, glow_value, 0.26, alpha_value))
		label.modulate = Color(1.0, 1.0, 1.0, 0.92 + (pulse * 0.08))

func _append_crown_realm_row(realm_id: int, realm: Dictionary, permissions: Dictionary) -> void:
	if crown_hub_list == null:
		return

	var resolved_realm: Dictionary = realm.duplicate(true)
	if resolved_realm.is_empty() and gs != null and gs.realm_engine != null and gs.realm_engine.has_method("ensure_realm_defaults"):
		var hydrated: Dictionary = gs.realm_engine.ensure_realm_defaults(realm_id)
		if not hydrated.is_empty():
			resolved_realm = hydrated

	var realm_name: String = str(resolved_realm.get("name", "Realm")).strip_edges()
	var stored_population: int = int(resolved_realm.get("population", 0))

	var live_population: int = int(resolved_realm.get("_live_population", 0))
	if not bool(resolved_realm.get("_has_cached_live_population", false)) and gs != null and gs.realm_engine != null and gs.realm_engine.has_method("get_total_population_for_realm"):
		live_population = int(gs.realm_engine.get_total_population_for_realm(realm_id))

	var population: int = max(stored_population, live_population)
	var land: int = int(resolved_realm.get("land", resolved_realm.get("land_size", 0)))
	var land_descriptor: String = str(resolved_realm.get("land_label", "Territory")).strip_edges()
	var treasury: int = int(resolved_realm.get("treasury", 0))
	var currency_name: String = str(resolved_realm.get("currency_name", MainSceneLogic._crown_default_currency_name_for_realm(gs, realm_name))).strip_edges()
	var treasury_label: String = _format_crown_treasury_label(treasury, currency_name)
	var government_style: String = str(resolved_realm.get("government_style", "State")).strip_edges()
	var country_quality: int = int(resolved_realm.get("country_quality", 0))
	var capital_city: String = str(resolved_realm.get("capital_city", "")).strip_edges()
	var subzones_raw: Variant = resolved_realm.get("subzones", [])
	var subzones: Array = subzones_raw if typeof(subzones_raw) == TYPE_ARRAY else []

	var relation_score: int = int(resolved_realm.get("_relation_score", 0))
	if not bool(resolved_realm.get("_has_cached_relation_score", false)):
		relation_score = MainSceneLogic._get_crown_realm_relation_score(gs, realm_id)

	var power_preview_raw: Variant = resolved_realm.get("_power_preview", {})
	var power_preview: Dictionary = power_preview_raw if typeof(power_preview_raw) == TYPE_DICTIONARY else {}
	if power_preview.is_empty() and not bool(resolved_realm.get("_has_cached_power_preview", false)) and gs != null and gs.realm_engine != null and gs.realm_engine.has_method("get_realm_power_snapshot"):
		power_preview = gs.realm_engine.get_realm_power_snapshot(realm_id)

	var military_stockpile: int = int(power_preview.get("military_stockpile", resolved_realm.get("military_stockpile", 0)))
	var goods_stockpile: int = int(power_preview.get("goods_stockpile", resolved_realm.get("goods_stockpile", 0)))
	var population_display_label: String = str(power_preview.get("population_label", "%s people" % _crown_compact_number(float(population)))).strip_edges()
	var population_change_label: String = str(power_preview.get("population_change_label", "Stable")).strip_edges()
	var population_trend_label: String = str(power_preview.get("population_trend_label", "Stable")).strip_edges()
	var land_display_label: String = str(power_preview.get("land_label", "%s km²" % _crown_compact_number(float(land)))).strip_edges()
	var treasury_display_label: String = str(power_preview.get("treasury_label", treasury_label)).strip_edges()
	var military_display_label: String = str(power_preview.get("military_label", "%s units" % _crown_compact_number(float(military_stockpile)))).strip_edges()
	var goods_display_label: String = str(power_preview.get("goods_label", "%s units" % _crown_compact_number(float(goods_stockpile)))).strip_edges()

	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	crown_hub_list.add_child(card)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	card.add_child(margin)

	var box:= VBoxContainer.new()
	box.add_theme_constant_override("separation", 8)
	margin.add_child(box)

	var title:= Label.new()
	title.text = "%s • Pop %s • Land %s • Treasury %s • Mil %s • Goods %s" % [
		realm_name,
		population_display_label,
		land_display_label,
		treasury_display_label,
		military_display_label,
		goods_display_label
	]
	title.add_theme_font_size_override("font_size", 18)
	box.add_child(title)

	var population_fragment: String = ""
	if population_change_label == "Stable":
		population_fragment = " • Population: Stable"
	else:
		population_fragment = " • Population: %s (%s)" % [
			population_trend_label,
			population_change_label
		]

	var capital_fragment: String = " • Capital: %s" % capital_city if capital_city != "" else ""
	var subzone_fragment: String = " • Subzones: %d" % subzones.size() if not subzones.is_empty() else ""
	var descriptor_fragment: String = " • %s" % land_descriptor if land_descriptor != "" else ""

	var relation_label:= Label.new()
	relation_label.text = "Relation: %s • Government: %s • Quality: %d%s%s%s%s" % [
		MainSceneHelpers._crown_relation_label(relation_score),
		government_style if government_style != "" else "State",
		country_quality,
		population_fragment,
		descriptor_fragment,
		capital_fragment,
		subzone_fragment
	]
	box.add_child(relation_label)

	var actions:= HBoxContainer.new()
	actions.add_theme_constant_override("separation", 8)
	box.add_child(actions)

	for button_data in [
		{ "label": "Trade", "action": "trade", "enabled": bool(permissions.get("can_trade", false))},
		{ "label": "Gift", "action": "gift", "enabled": bool(permissions.get("can_gift", false))},
		{ "label": "Bribe", "action": "bribe", "enabled": bool(permissions.get("can_bribe", false))},
		{ "label": "War", "action": "war", "enabled": bool(permissions.get("can_declare_war", false))},
		{ "label": "People", "action": "population", "enabled": true}
	]:
		var btn:= Button.new()
		btn.text = str(button_data.get("label", "Open"))
		btn.disabled = not bool(button_data.get("enabled", false))
		btn.custom_minimum_size = Vector2(96, 40)
		btn.pressed.connect(_show_crown_action_popup.bind(
			str(button_data.get("action", "")),
			{ "target_realm_id": realm_id}
		))
		actions.add_child(btn)

func _refresh_crown_hub() -> void:
	_ensure_crown_hub_overlay()
	if crown_hub_overlay == null or not crown_hub_overlay.visible or gs == null or gs.player == null:
		return

	var core:= _crown_hud_core_color()
	var pulse:= (sin(crown_hud_breathe_time * 1.85) + 1.0) * 0.5
	if crown_hub_dim != null:
		crown_hub_dim.color = Color(core.r * 0.1, core.g * 0.08, core.b * 0.12, 0.8)
	if crown_hub_card != null:
		var panel_style:= StyleBoxFlat.new()
		panel_style.bg_color = Color(0.04, 0.06, 0.1, 0.97)
		panel_style.border_width_left = 2
		panel_style.border_width_top = 2
		panel_style.border_width_right = 2
		panel_style.border_width_bottom = 2
