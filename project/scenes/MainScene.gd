func _household_creator_handle_stat_bar_input(event: InputEvent, hit_area: Control, bar: ProgressBar, value_label: Label) -> void:
	if hit_area == null or bar == null or value_label == null:
		return
	if not is_instance_valid(hit_area) or not is_instance_valid(bar) or not is_instance_valid(value_label):
		return

	if event is InputEventMouseButton:
		var mouse_button: InputEventMouseButton = event as InputEventMouseButton
		if mouse_button.button_index != MOUSE_BUTTON_LEFT:
			return

		hit_area.set_meta("household_stat_bar_dragging", mouse_button.pressed)
		if mouse_button.pressed:
			_household_creator_set_stat_bar_from_local_x(hit_area, bar, value_label, mouse_button.position.x, true)
		return

	if event is InputEventMouseMotion and bool(hit_area.get_meta("household_stat_bar_dragging", false)):
		var motion: InputEventMouseMotion = event as InputEventMouseMotion
		_household_creator_set_stat_bar_from_local_x(hit_area, bar, value_label, motion.position.x, false)


func _household_creator_set_stat_bar_from_local_x(hit_area: Control, bar: ProgressBar, value_label: Label, local_x: float, animate: bool) -> void:
	var width: float = max(1.0, hit_area.size.x)
	var ratio: float = clamp(local_x / width, 0.0, 1.0)
	var target_value: int = int(round(ratio * 100.0))

	value_label.text = str(target_value)

	if animate:
		var tween:= create_tween()
		tween.set_trans(Tween.TRANS_QUAD)
		tween.set_ease(Tween.EASE_OUT)
		tween.tween_property(bar, "value", target_value, 0.12)
	else:
		bar.value = target_value


func _on_household_member_save_pressed() -> void:
	var member: Dictionary = household_creator_pending_member_basic_contract.duplicate(true)
	if member.is_empty():
		member = _household_creator_read_member_basic()

	var validation: Dictionary = _household_creator_validate_member_basic(member)
	if not bool(validation.get("success", false)):
		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = str(validation.get("reason", "Member contract invalid."))
		return

	var stats: Dictionary = _household_creator_collect_member_stats()

	member ["stats"] = stats
	member ["local_key"] = "person_%d" % (household_creator_active_member_index if household_creator_active_member_index >= 0 else household_creator_created_members.size())
	member ["slot_index"] = household_creator_active_member_index if household_creator_active_member_index >= 0 else household_creator_created_members.size()
	member ["city"] = str(household_creator_world_contract.get("city", ""))
	member ["country"] = str(household_creator_world_contract.get("country", ""))
	member ["era"] = str(household_creator_world_contract.get("era", "Modern"))
	member ["year"] = int(household_creator_world_contract.get("year", 2000))
	member ["money"] = MainSceneHelpers._household_creator_starting_money_for_class(str(member.get("social_class", household_creator_world_contract.get("default_social_class", "Middle Class"))))
	member ["reputation"] = 0
	member ["trauma"] = ""

	if household_creator_active_member_index >= 0 and household_creator_active_member_index < household_creator_created_members.size():
		household_creator_created_members [household_creator_active_member_index] = member
	else:
		household_creator_created_members.append(member)

	household_creator_active_member_index = -1
	_household_creator_clear_member_stat_controls()
	household_creator_pending_member_basic_contract.clear()

	if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
		household_creator_status_label.text = "%s %s was added to this household." % [str(member.get("first_name", "")), str(member.get("last_name", ""))]

	_household_creator_render_member_roster()

func _on_household_creator_continue_pressed() -> void:
	if household_creator_created_members.is_empty():
		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = "Create at least one adult member before continuing."
		return

	if household_creator_created_members.size() == 1 and not household_creator_confirm_no_family:
		household_creator_confirm_no_family = true
		if household_creator_continue_button != null and is_instance_valid(household_creator_continue_button):
			household_creator_continue_button.text = "Yes — start with no family"
		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = "Are you SURE you want this life to start with no created family? You can still go back and create Member #2."
		return

	var auto_start_single: bool = household_creator_created_members.size() == 1
	_begin_household_final_life_prewarm(auto_start_single)


func _begin_household_final_life_prewarm(auto_start_single: bool) -> void:
	var contract: Dictionary = _household_creator_final_contract()
	var settings: Dictionary = _household_creator_settings_from_contract(contract)

	household_creator_pending_settings = settings.duplicate(true)

	if household_creator_active_draft_id.strip_edges() != "":
		MainSceneLogic._household_creator_remove_unfinished_draft(gs, household_creator_active_draft_id)

	set_meta("household_creator_auto_start_after_prewarm", auto_start_single)
	set_meta("household_creator_auto_start_key", "person_0")
	set_meta("household_creator_waiting_for_start_selection", true)

	if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
		if auto_start_single:
			household_creator_status_label.text = "Prewarming this solo household life. No family members will be created."
		else:
			household_creator_status_label.text = "Prewarming full household life. Start selection will appear when ready."

	if household_creator_prewarm_progress_bar != null and is_instance_valid(household_creator_prewarm_progress_bar):
		household_creator_prewarm_progress_bar.value = 0.05

	_queue_god_mode_life_prewarm_from_settings(settings, "prewarm_button_pressed", true)
func _household_creator_show_choice_prompt(title_text: String, body_text: String, yes_text: String, no_text: String, yes_callable: Callable, no_callable: Callable) -> void:
	_household_creator_close_choice_prompt()

	household_creator_prompt_overlay = Control.new()
