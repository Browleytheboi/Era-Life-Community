func _set_bending_hub_section(section: String) -> void:
	var clean_section: String = str(section).strip_edges().to_lower()
	if clean_section == "":
		return
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"

	var quiet_ms: int = 110 if clean_section == "tournaments" else 220
	_begin_runtime_interaction_quiet_window("bending_hub_section_%s" % clean_section, quiet_ms)

	bending_hud_current_section = clean_section
	bending_hud_open = true

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["bending_hud_last_section"] = clean_section
		gs.scenario_state ["bending_hub_section_zero_frame_boundary"] = true
		gs.scenario_state ["bending_hub_section_truth_rebuild_deferred"] = true
		gs.scenario_state ["bending_hub_section_truth_rebuild_deferred_reason"] = clean_section
		gs.scenario_state ["bending_hub_section_truth_rebuild_deferred_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["bending_hub_section_visible_state_locked_before_truth"] = true

	if bending_hud_scroll != null:
		bending_hud_scroll.scroll_vertical = 0

	if clean_section == "tournaments":
		_render_bending_hub_tournament_loading_shell("section_intent_first_frame")
		var section_signatures_raw: Variant = get_meta("bending_hud_section_signatures", {})
		var section_signatures: Dictionary = section_signatures_raw if typeof(section_signatures_raw) == TYPE_DICTIONARY else {}
		section_signatures.erase("tournaments")
		set_meta("bending_hud_section_signatures", section_signatures)
		set_meta("bending_hub_tournament_section_shell_first", true)
		set_meta("bending_hub_tournament_section_shell_first_at_ms", int(Time.get_ticks_msec()))

	_persist_runtime_hud_visibility_snapshot("bending_section_%s" % clean_section)

	_refresh_bending_hub_lightweight_snapshot(clean_section)
	_sync_bending_hub_section_visibility()

	set_meta("bending_hub_content_rebuild_queued", true)
	call_deferred(
		"_defer_bending_hub_content_rebuild_after_open",
		clean_section,
		_bending_hub_signature_for_section(clean_section),
		0
	)
func _rebuild_bending_hub_current_section_deferred(expected_section: String, attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.player == null or gs.bending_engine == null:
		return

	var live_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	var clean_expected: String = str(expected_section).strip_edges().to_lower()
	if live_section != clean_expected:
		return
	if not bending_hud_open:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var quiet_until_ms: int = int(get_meta("runtime_interaction_quiet_until_ms", 0))
	if quiet_until_ms > now_ms and attempt < 10:
		var delay_seconds: float = clamp(float(quiet_until_ms - now_ms) / 1000.0, 0.03, 0.12)
		var timer:= tree.create_timer(delay_seconds)
		timer.timeout.connect(
			Callable(self, "_rebuild_bending_hub_current_section_deferred").bind(clean_expected, attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	_rebuild_bending_hub_content(false)
	set_meta("bending_hub_content_rebuild_queued", false)
	_sync_bending_hub_section_visibility()

func _sync_bending_hub_section_visibility() -> void:
	var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"
	bending_hud_current_section = clean_section

	if bending_hud_title_label != null:
		bending_hud_title_label.text = "BENDING HUB • %s" % MainSceneHelpers._bending_hub_section_title(clean_section)

	if bending_hud_profile_box != null:
		bending_hud_profile_box.visible = clean_section == "profile"
	if bending_hud_stats_box != null:
		bending_hud_stats_box.visible = clean_section == "stats"
	if bending_hud_actions_box != null:
		bending_hud_actions_box.visible = clean_section == "training"
	if bending_hud_skill_points_box != null:
		bending_hud_skill_points_box.visible = clean_section == "skill_points"
	if bending_hud_abilities_box != null:
		bending_hud_abilities_box.visible = clean_section == "abilities"
	if bending_hud_tournaments_box != null:
		bending_hud_tournaments_box.visible = clean_section == "tournaments"

	var core: Color = _bending_hub_core_color()
	for raw_key in bending_hud_section_buttons.keys():
		var key: String = str(raw_key)
		var button: Button = bending_hud_section_buttons.get(key, null)
		if button == null:
			continue

		var selected: bool = key == clean_section
		var style: StyleBoxFlat = null
		if button.has_meta("bending_hub_section_style"):
			style = button.get_meta("bending_hub_section_style") as StyleBoxFlat

		if style == null:
			style = StyleBoxFlat.new()
			style.border_width_left = 2
			style.border_width_top = 2
			style.border_width_right = 2
			style.border_width_bottom = 2
			style.corner_radius_top_left = 14
			style.corner_radius_top_right = 14
			style.corner_radius_bottom_left = 14
			style.corner_radius_bottom_right = 14
			button.set_meta("bending_hub_section_style", style)
			button.add_theme_stylebox_override("normal", style)
			button.add_theme_stylebox_override("hover", style)
			button.add_theme_stylebox_override("pressed", style)

		style.bg_color = Color(core.r, core.g, core.b, 0.24 if selected else 0.1)
		style.border_color = Color(core.r, core.g, core.b, 0.88 if selected else 0.34)
		button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
func _bending_hub_core_color() -> Color:
	return _bending_hud_core_color()
func _toggle_bending_hud() -> void:
	var opening: bool = not bending_hud_open

	_begin_runtime_interaction_quiet_window("toggle_bending_hud", 80 if opening else 60)

	if opening:
		_set_runtime_floating_hud_forced_open("bending", true)
		_ensure_bending_hud()

		var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()
		if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
			clean_section = "profile"

		bending_hud_current_section = clean_section
		bending_hud_open = true

		if gs != null and typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var return_panel: String = str(current_panel).strip_edges()
			if return_panel == "":
				return_panel = "life"
			gs.scenario_state ["bending_hud_return_panel"] = return_panel
			gs.scenario_state ["bending_hud_last_section"] = clean_section
			gs.scenario_state ["spawn_shell_last_main_panel"] = return_panel
			gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false
			gs.scenario_state ["bending_hub_open_zero_frame_boundary"] = true
			gs.scenario_state ["bending_hub_open_truth_rebuild_deferred"] = true
			gs.scenario_state ["bending_hub_open_truth_rebuild_deferred_at_ms"] = int(Time.get_ticks_msec())

		if bending_hud_legendary_vignette != null:
			var core: Color = _bending_hub_core_color()
			bending_hud_legendary_vignette.visible = true
			bending_hud_legendary_vignette.color = Color(core.r * 0.18, core.g * 0.18, core.b * 0.24, 0.54)

		if bending_hud_panel != null and is_instance_valid(bending_hud_panel):
			bending_hud_panel.visible = true

		set_meta("spawn_ready_runtime_hud_shell_only_active", false)

		_refresh_bending_hub_lightweight_snapshot(clean_section)
		_sync_bending_hub_section_visibility()

		set_meta("bending_hub_content_rebuild_queued", true)
		call_deferred(
			"_defer_bending_hub_content_rebuild_after_open",
			clean_section,
			_bending_hub_signature_for_section(clean_section),
			0
		)

		_persist_runtime_hud_visibility_snapshot("bending_open")
		return

	_set_runtime_floating_hud_forced_open("bending", false)
	bending_hud_open = false
	set_meta("bending_hub_content_rebuild_queued", false)

	if bending_hud_panel != null and is_instance_valid(bending_hud_panel):
		bending_hud_panel.visible = false
	if bending_hud_legendary_vignette != null:
		bending_hud_legendary_vignette.visible = false

	var restore_panel: String = "life"
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		restore_panel = str(gs.scenario_state.get("bending_hud_return_panel", "life")).strip_edges()
	if restore_panel == "":
		restore_panel = "life"

	current_panel = restore_panel

	if current_panel == "life" and output_label != null:
		output_label.visible = true
		output_label.scroll_active = true

	_persist_runtime_hud_visibility_snapshot("bending_close")
	_update_bending_hud_button_border_overlay(0.5)
	_sync_runtime_floating_hud_layering()
func _defer_bending_hub_content_rebuild_after_open(
	expected_section: String = "profile",
	expected_signature: String = "",
	attempt: int = 0
) -> void:
	var tree:= get_tree()

	if tree == null:
		return

	await tree.process_frame

	if (
		gs == null
		or gs.player == null
		or gs.bending_engine == null
	):
		set_meta(
			"bending_hub_content_rebuild_queued",
			false
		)
		return

	if not bending_hud_open:
		set_meta(
			"bending_hub_content_rebuild_queued",
			false
		)
		return

	var live_section: String = str(
		bending_hud_current_section
	).strip_edges().to_lower()
	var clean_expected: String = str(
		expected_section
	).strip_edges().to_lower()

	if clean_expected == "":
		clean_expected = "profile"

	if live_section != clean_expected:
		return




	if clean_expected == "abilities":
		_refresh_bending_hub_lightweight_snapshot(
			clean_expected
		)
		_sync_bending_hub_section_visibility()

		set_meta(
			"bending_hub_content_rebuild_queued",
			false
		)
		set_meta(
			"bending_hub_abilities_build_on_observation",
			false
		)
		return

	_refresh_bending_hub_lightweight_snapshot(
		clean_expected
	)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var quiet_until_ms: int = int(
		get_meta(
			"runtime_interaction_quiet_until_ms",
			0
		)
	)

	if (
		quiet_until_ms > now_ms
		and attempt < 14
	):
		var delay_seconds: float = clamp(
			float(
				quiet_until_ms - now_ms
			) / 1000.0,
			0.05,
			0.22
		)
		var timer:= tree.create_timer(
			delay_seconds
		)

		timer.timeout.connect(
			Callable(
				self,
				"_defer_bending_hub_content_rebuild_after_open"
			).bind(
				clean_expected,
				expected_signature,
				attempt + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	var live_signature: String = (
		_bending_hub_player_signature()
	)

	if (
		expected_signature != ""
		and live_signature != expected_signature
		and attempt < 14
	):
		var retry_timer:= tree.create_timer(
			0.16
		)

		retry_timer.timeout.connect(
			Callable(
				self,
				"_defer_bending_hub_content_rebuild_after_open"
			).bind(
				clean_expected,
				live_signature,
				attempt + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	_rebuild_bending_hub_content(
		false
	)
	_refresh_bending_hub_lightweight_snapshot(
		clean_expected
	)
	_sync_bending_hub_section_visibility()

	set_meta(
		"bending_hub_content_rebuild_queued",
		false
	)
func _bending_hub_prewarm_signature() -> String:
	if gs == null or gs.player == null:
		return ""

	var parts: Array = []

	for raw_section in MainSceneHelpers._bending_hub_valid_sections():
		var section: String = str(raw_section).strip_edges().to_lower()
		if section == "":
			continue
		parts.append("%s:%s" % [section, _bending_hub_signature_for_section(section)])

	return "||".join(parts)

func _bending_hub_surface_prewarm_ready() -> bool:
	var signature: String = _bending_hub_prewarm_signature()
	if signature == "":
		return false
	return signature == str(bending_hud_last_prewarm_signature)

func _refresh_bending_hub_lightweight_snapshot(section: String = "") -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null:
		return

	var clean_section: String = str(section).strip_edges().to_lower()
	if clean_section == "":
		clean_section = str(bending_hud_current_section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"

	var display_type: String = "None"
	var actor_type: String = str(actor.bending_type).strip_edges().to_lower()
	if actor_type != "" and actor_type != "none":
		display_type = actor_type.capitalize()

	if bending_hud_subtitle_label != null:
		bending_hud_subtitle_label.text = "Type: %s\nNation: %s" % [
			display_type,
			actor.bending_nation if str(actor.bending_nation).strip_edges() != "" else "None"
		]

	if bending_hud_potential_label != null:
		var potential_text: String = ""
		if gs.bending_engine != null and gs.bending_engine.has_method("get_bending_potential_summary"):
			var potential_summary: Dictionary = gs.bending_engine.get_bending_potential_summary(actor)
			potential_text = str(potential_summary.get("text", "")).strip_edges()

		if potential_text == "":
			var best_element: String = ""
			var best_value: int = 0
			for element in ["air", "water", "earth", "fire"]:
				var potential_value: int = 0
				if gs.bending_engine != null and gs.bending_engine.has_method("get_bending_latent_potential"):
					potential_value = int(gs.bending_engine.get_bending_latent_potential(actor, element))
				else:
					potential_value = clamp(int(actor.bending_latent_potential.get(element, 0)), 0, 100)

				if potential_value > best_value:
					best_value = potential_value
					best_element = element

			if best_value > 0 and best_element != "":
				potential_text = "Latent Potential: %s %d" % [best_element.capitalize(), best_value]
			else:
				potential_text = "Latent Potential: None"

		bending_hud_potential_label.text = potential_text
		bending_hud_potential_label.visible = potential_text != ""

	if clean_section == "stats" or clean_section == "profile":
		for element in ["air", "water", "earth", "fire"]:
			var row_data: Dictionary = bending_hud_rows.get(element, {})
			var row: Control = row_data.get("row", null)
			var label: Label = row_data.get("label", null)
			var bar: ProgressBar = row_data.get("bar", null)

			var mastery_value: int = clamp(int(actor.bending_mastery.get(element, 0)), 0, 100)
			var potential_value: int = 0
			if gs.bending_engine != null and gs.bending_engine.has_method("get_bending_latent_potential"):
				potential_value = int(gs.bending_engine.get_bending_latent_potential(actor, element))
			else:
				potential_value = clamp(int(actor.bending_latent_potential.get(element, 0)), 0, 100)

			bending_hud_targets [element] = float(mastery_value)

			if row != null:
				row.visible = mastery_value > 0 or potential_value > 0 or actor_type == "avatar" or actor_type == element

			if bar != null:
				bar.max_value = 100.0
				bar.set_meta("bending_level", mastery_value)
				if not bending_hud_open:
					bar.value = float(mastery_value)

			_apply_bending_hub_level_surface(row, label, bar, element, mastery_value)
func _request_bending_hub_surface_prewarm(
	force:= false
) -> void:
	if (
		gs == null
		or gs.player == null
		or gs.bending_engine == null
	):
		return

	var signature: String = (
		_bending_hub_prewarm_signature()
	)

	if signature == "":
		return

	if (
		not force
		and signature
		== bending_hud_last_prewarm_signature
	):
		return

	if (
		signature
		== bending_hud_prewarm_requested_signature
	):
		return

	if bending_hud_prewarm_in_progress:
		set_meta(
			"bending_hub_surface_prewarm_requeue_signature",
			signature
		)
		return

	bending_hud_prewarm_requested_signature = signature



	call_deferred(
		"_prewarm_bending_hub_surface_deferred",
		signature
	)
func _prewarm_bending_hub_surface_deferred(
	expected_signature: String
) -> void:
	if bending_hud_prewarm_in_progress:
		set_meta(
			"bending_hub_surface_prewarm_requeue_signature",
			expected_signature
		)
		return

	if (
		gs == null
		or gs.player == null
		or gs.bending_engine == null
	):
		bending_hud_prewarm_requested_signature = ""
		return

	var live_signature: String = (
		_bending_hub_prewarm_signature()
	)

	if live_signature != expected_signature:
		bending_hud_prewarm_requested_signature = ""

		_request_bending_hub_surface_prewarm(
			false
		)
		return

	var generation: int = int(
		get_meta(
			"bending_hub_surface_prewarm_generation",
			0
		)
	) + 1

	bending_hud_prewarm_in_progress = true

	set_meta(
		"bending_hub_surface_prewarm_generation",
		generation
	)
	set_meta(
		"bending_hub_surface_prewarm_job",
		{
			"generation": generation,
			"signature": expected_signature,
			"actor_id": int(
				gs.player.id
			),
			"year": int(
				gs.year
			),
			"payload_keys": [
				"training_elements",
				"awakening_elements",
				"skill_allocation_rows",
				"abilities",
				"world_championship",
				"agni_kai",
				"dojo"
			],
			"cursor": 0,
			"payloads": {},
			"started_at_ms": int(
				Time.get_ticks_msec()
			),
			"observation_required": false,
			"idle_required": false,
			"ready_gate_member": false
		}
	)
	set_meta(
		"bending_hub_surface_prewarm_deferred_until_idle",
		false
	)

	_schedule_bending_hub_surface_prewarm_quantum(
		generation,
		0.01
	)
func _schedule_bending_hub_surface_prewarm_quantum(
	generation: int,
	delay_seconds: float = 0.02
) -> void:
	if generation != int(
		get_meta(
			"bending_hub_surface_prewarm_generation",
			0
		)
	):
		return

	var scheduled_generation: int = int(
		get_meta(
			"bending_hub_surface_prewarm_scheduled_generation",
			-1
		)
	)

	if scheduled_generation == generation:
		return

	set_meta(
		"bending_hub_surface_prewarm_scheduled_generation",
		generation
	)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_bending_hub_surface_prewarm_quantum",
			generation
		)
		return

	var timer:= tree.create_timer(
		maxf(
			0.01,
			delay_seconds
		)
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_bending_hub_surface_prewarm_quantum"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)


func _service_bending_hub_surface_prewarm_quantum(
	generation: int
) -> void:
	if generation != int(
		get_meta(
			"bending_hub_surface_prewarm_generation",
			0
		)
	):
		return

	set_meta(
		"bending_hub_surface_prewarm_scheduled_generation",
		-1
	)

	var job_raw: Variant = get_meta(
		"bending_hub_surface_prewarm_job",
		{}
	)
	var job: Dictionary = (
		job_raw as Dictionary
		if typeof(job_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		job.is_empty()
		or int(
			job.get(
				"generation",
				-1
			)
		) != generation
	):
		return

	if (
		gs == null
		or gs.player == null
		or gs.bending_engine == null
	):
		bending_hud_prewarm_in_progress = false
		bending_hud_prewarm_requested_signature = ""
		return

	var expected_actor_id: int = int(
		job.get(
			"actor_id",
			-1
		)
	)
	var live_actor_id: int = int(
		gs.player.id
	)
	var expected_signature: String = str(
		job.get(
			"signature",
			""
		)
	)
	var live_signature: String = (
		_bending_hub_prewarm_signature()
	)

	if (
		expected_actor_id != live_actor_id
		or expected_signature != live_signature
	):
		bending_hud_prewarm_in_progress = false
		bending_hud_prewarm_requested_signature = ""

		set_meta(
			"bending_hub_surface_prewarm_job",
			{}
		)

		_request_bending_hub_surface_prewarm(
			true
		)
		return

	var payload_keys_raw: Variant = job.get(
		"payload_keys",
		[]
	)
	var payload_keys: Array = (
		payload_keys_raw as Array
		if typeof(payload_keys_raw) == TYPE_ARRAY
		else []
	)
	var cursor: int = int(
		job.get(
			"cursor",
			0
		)
	)
	var payloads_raw: Variant = job.get(
		"payloads",
		{}
	)
	var payloads: Dictionary = (
		payloads_raw as Dictionary
		if typeof(payloads_raw) == TYPE_DICTIONARY
		else {}
	)

	if cursor >= payload_keys.size():
		var cache: Dictionary = {
			"schema": "eralife.bending_hub_runtime_surface_cache",
			"version": 2,
			"signature": (
				MainSceneHelpers._bending_hub_surface_cache_signature_for_state(
					gs
				)
			),
			"prewarm_signature": expected_signature,
			"reason": "resident_progressive_publication",
			"actor_id": live_actor_id,
			"year": int(
				gs.year
			),
			"created_at_ms": int(
				job.get(
					"started_at_ms",
					Time.get_ticks_msec()
				)
			),
			"completed_at_ms": int(
				Time.get_ticks_msec()
			),
			"payloads": payloads,
			"projection_complete": true,
			"progressive_observability": true,
			"observation_required": false,
			"idle_required": false,
		}

		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"bending_hub_runtime_surface_cache"
		] = cache.duplicate(false)

		gs.scenario_state [
			"bending_hub_runtime_surface_cache_truth_deferred"
		] = false

		gs.scenario_state [
			"bending_hub_runtime_surface_cache_truth_ready_at_ms"
		] = int(
			Time.get_ticks_msec()
		)

		var section_signatures: Dictionary = {}

		for raw_section in MainSceneHelpers._bending_hub_valid_sections():
			var section: String = str(
				raw_section
			).strip_edges().to_lower()

			if section == "":
				continue

			section_signatures [
				section
			] = _bending_hub_signature_for_section(
				section
			)

		set_meta(
			"bending_hud_section_signatures",
			section_signatures
		)

		bending_hud_last_prewarm_signature = (
			expected_signature
		)
		bending_hud_prewarm_requested_signature = ""
		bending_hud_prewarm_in_progress = false

		set_meta(
			"bending_hub_surface_prewarm_job",
			{}
		)
		set_meta(
			"bending_hub_surface_prewarm_completed_generation",
			generation
		)

		var requeue_signature: String = str(
			get_meta(
				"bending_hub_surface_prewarm_requeue_signature",
				""
			)
		)

		remove_meta(
			"bending_hub_surface_prewarm_requeue_signature"
		)

		if (
			requeue_signature != ""
			and requeue_signature
			!= expected_signature
		):
			_request_bending_hub_surface_prewarm(
				true
			)

		return

	var payload_key: String = str(
		payload_keys [
			cursor
		]
	).strip_edges().to_lower()

	var actor: Person = gs.player
	var payload_value: Variant = null

	match payload_key:
		"training_elements":
			if gs.bending_engine.has_method(
				"get_bending_training_elements"
			):
				payload_value = (
					gs.bending_engine
					.get_bending_training_elements(
						actor
					)
				)

		"awakening_elements":
			if gs.bending_engine.has_method(
				"get_bending_awakening_options"
			):
				payload_value = (
					gs.bending_engine
					.get_bending_awakening_options(
						actor
					)
				)

		"skill_allocation_rows":
			if gs.bending_engine.has_method(
				"get_bending_skill_allocation_rows"
			):
				payload_value = (
					gs.bending_engine
					.get_bending_skill_allocation_rows(
						actor
					)
				)

		"abilities":
			if gs.bending_engine.has_method(
				"get_available_bending_abilities"
			):
				payload_value = (
					gs.bending_engine
					.get_available_bending_abilities(
						actor
					)
				)

		"world_championship":
			if gs.bending_engine.has_method(
				"get_bending_world_championship_hub_payload"
			):
				payload_value = (
					gs.bending_engine
					.get_bending_world_championship_hub_payload(
						actor
					)
				)

		"agni_kai":
			if gs.bending_engine.has_method(
				"get_agni_kai_championship_payload"
			):
				payload_value = (
					gs.bending_engine
					.get_agni_kai_championship_payload(
						actor
					)
				)

		"dojo":
			if (
				gs.bending_dojo_engine != null
				and gs.bending_dojo_engine.has_method(
					"get_dojo_hub_payload"
				)
			):
				payload_value = (
					gs.bending_dojo_engine
					.get_dojo_hub_payload(
						actor,
						{
							"source": (
								"bending_hub_resident_progressive_publication"
							),
							"observation_required": false
						}
					)
				)

	if payload_value == null:
		if payload_key in [
			"training_elements",
			"awakening_elements",
			"skill_allocation_rows",
			"abilities"
		]:
			payload_value = []
		else:
			payload_value = {}

	payloads [
		payload_key
	] = payload_value

	job ["payloads"] = payloads
	job ["cursor"] = cursor + 1

	var partial_cache: Dictionary = {
		"schema": "eralife.bending_hub_runtime_surface_cache",
		"version": 2,
		"signature": (
			MainSceneHelpers._bending_hub_surface_cache_signature_for_state(
				gs
			)
		),
		"prewarm_signature": expected_signature,
		"reason": "resident_progressive_publication",
		"actor_id": live_actor_id,
		"year": int(
			gs.year
		),
		"created_at_ms": int(
			job.get(
				"started_at_ms",
				Time.get_ticks_msec()
			)
		),
		"payloads": payloads,
		"projection_complete": false,
		"published_payload_count": cursor + 1,
		"target_payload_count": payload_keys.size(),
		"progressive_observability": true,
		"observation_required": false,
		"idle_required": false,
	}

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"bending_hub_runtime_surface_cache"
	] = partial_cache.duplicate(false)

	set_meta(
		"bending_hub_surface_prewarm_job",
		job
	)

	if (
		payload_key == "abilities"
		and typeof(payload_value) == TYPE_ARRAY
	):
		_queue_bending_hub_resident_ability_card_stream(
			payload_value as Array,
			live_actor_id,
			expected_signature
		)

	_schedule_bending_hub_surface_prewarm_quantum(
		generation,
		0.02
	)
func _on_bending_hud_avatar_state_pressed() -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return

	gs.bending_engine.activate_avatar_state(actor)
	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()

	if activities_action_status_label != null:
		activities_action_status_label.text = "Avatar State activated."
func _bending_hub_signature_for_section(section: String) -> String:
	var clean_section: String = str(section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"

	var original_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	bending_hud_current_section = clean_section
	var signature: String = _bending_hub_player_signature()
	bending_hud_current_section = original_section

	return signature
func _bending_hub_player_signature() -> String:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null:
		return "none"

	var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"

	var parts: Array = [
		"schema:eralife.bending_hub_slice_signature",
		"actor:%d" % int(actor.id),
		"age:%d" % int(actor.age),
		"year:%d" % int(gs.year),
		"section:%s" % clean_section,
		"type:%s" % str(actor.bending_type),
		"nation:%s" % str(actor.bending_nation),
		"avatar_unlocked:%s" % str(actor.avatar_state_unlocked),
		"avatar_used:%s" % str(actor.avatar_state_used)
	]

	for element in ["air", "water", "earth", "fire"]:
		parts.append("%s:%s" % [element, str(actor.bending_mastery.get(element, 0))])
		parts.append("%s_potential:%s" % [element, str(actor.bending_latent_potential.get(element, 0))])

	match clean_section:
		"skill_points":
			var combat_profile: Dictionary = actor.bending_combat_profile if typeof(actor.bending_combat_profile) == TYPE_DICTIONARY else {}
			var skill_caps: Dictionary = combat_profile.get("skill_caps", {}) if typeof(combat_profile.get("skill_caps", {})) == TYPE_DICTIONARY else {}
			parts.append("skill_points:%d" % int(actor.bending_skill_points))
			parts.append("pending_actor:%d" % int(bending_hub_pending_skill_allocation_actor_id))
			parts.append("pending:%s" % str(bending_hub_pending_skill_allocation))
			for stat_name in ["accuracy", "power", "guard", "counter", "evasion", "focus"]:
				parts.append("%s:%s/%s" % [
					stat_name,
					str(combat_profile.get(stat_name, 50)),
					str(skill_caps.get(stat_name, 100))
				])
			parts.append("style_points_spent:%s" % str(combat_profile.get("style_points_spent", 0)))
		"abilities":
			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				var cooldowns: Dictionary = gs.scenario_state.get("bending_ability_cooldowns", {}) if typeof(gs.scenario_state.get("bending_ability_cooldowns", {})) == TYPE_DICTIONARY else {}
				if not cooldowns.is_empty():
					var cooldown_keys: Array = cooldowns.keys()
					cooldown_keys.sort()
					for cooldown_key in cooldown_keys:
						parts.append("cooldown:%s:%s" % [str(cooldown_key), str(cooldowns.get(cooldown_key, ""))])
				for flag_bucket in ["bending_goal_flags", "bending_story_flags", "bending_unlock_flags"]:
					var raw_flags: Variant = gs.scenario_state.get(flag_bucket, {})
					if typeof(raw_flags) == TYPE_DICTIONARY:
						parts.append("%s_size:%d" % [flag_bucket, (raw_flags as Dictionary).size()])
					elif typeof(raw_flags) == TYPE_ARRAY:
						parts.append("%s_size:%d" % [flag_bucket, (raw_flags as Array).size()])
		"tournaments":
			var tournament_profile: Dictionary = actor.bending_tournament_profile if typeof(actor.bending_tournament_profile) == TYPE_DICTIONARY else {}
			parts.append("tournament_profile_size:%d" % tournament_profile.size())
			parts.append("tournament_wins:%s" % str(tournament_profile.get("wins", tournament_profile.get("championship_wins", 0))))
			parts.append("tournament_titles:%s" % str(tournament_profile.get("title_counts", {})))
			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				var world_raw: Variant = gs.scenario_state.get("bending_world_championship", {})
				if typeof(world_raw) == TYPE_DICTIONARY:
					var world_state: Dictionary = world_raw
					var tournaments: Dictionary = world_state.get("tournaments", {}) if typeof(world_state.get("tournaments", {})) == TYPE_DICTIONARY else {}
					var history: Array = world_state.get("tournament_history", []) if typeof(world_state.get("tournament_history", [])) == TYPE_ARRAY else []
					parts.append("bending_world_version:%s" % str(world_state.get("version", 0)))
					parts.append("tournament_count:%d" % tournaments.size())
					parts.append("history_count:%d" % history.size())
					parts.append("last_report:%s" % str(world_state.get("last_report", {})))
		"profile":
			parts.append("respect:%s" % str(actor.respect))
			parts.append("respect_profile_size:%d" % (actor.respect_profile.size() if typeof(actor.respect_profile) == TYPE_DICTIONARY else 0))
			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				var profile_world_raw: Variant = gs.scenario_state.get("bending_world_championship", {})
				if typeof(profile_world_raw) == TYPE_DICTIONARY:
					var profile_world_state: Dictionary = profile_world_raw
					var previous_avatars: Array = profile_world_state.get("previous_avatars", []) if typeof(profile_world_state.get("previous_avatars", [])) == TYPE_ARRAY else []
					parts.append("previous_avatar_count:%d" % previous_avatars.size())
					if not previous_avatars.is_empty() and typeof(previous_avatars [previous_avatars.size() - 1]) == TYPE_DICTIONARY:
						var last_avatar: Dictionary = previous_avatars [previous_avatars.size() - 1]
						parts.append("last_avatar:%s:%s" % [
							str(last_avatar.get("name", "")),
							str(last_avatar.get("death_year", ""))
						])
		"training":
			parts.append("best_level:%s" % str(gs.bending_engine.get_primary_bending_level(actor) if gs.bending_engine != null and gs.bending_engine.has_method("get_primary_bending_level") else 0))
		"stats":
			parts.append("willpower:%d" % _bending_hub_willpower_value(actor))

	return "|".join(parts)
func _bending_hub_willpower_value(actor: Person) -> int:
	if actor == null:
		return 0

	if gs != null and "willpower_engine" in gs and gs.willpower_engine != null and gs.willpower_engine.has_method("score"):
		return int(round(float(gs.willpower_engine.score(actor, {
			"source": "bending_hub_willpower_preview",
			"scope": "bending_duel"
		}))))

	if "willpower" in actor:
		return int(round(float(actor.willpower)))

	return 50



func _bending_hub_willpower_preview_text(actor: Person) -> String:
	var value: int = _bending_hub_willpower_value(actor)
	return "Willpower: %d • %s" % [
		value,
		MainSceneHelpers._bending_hub_willpower_descriptor(value)
	]
func _make_bending_hub_button(text: String, disabled:= false) -> Button:
	var btn:= Button.new()
	btn.text = text
	btn.disabled = disabled
	btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	btn.custom_minimum_size = Vector2(0, 52)
	btn.add_theme_font_size_override("font_size", 15)

	var core: Color = _bending_hub_core_color()

	var normal_style:= StyleBoxFlat.new()
	normal_style.bg_color = Color(0.025, 0.035, 0.06, 0.97 if not disabled else 0.7)
	normal_style.border_width_left = 2
	normal_style.border_width_top = 2
	normal_style.border_width_right = 2
	normal_style.border_width_bottom = 2
	normal_style.border_color = Color(core.r, core.g, core.b, 0.38 if not disabled else 0.16)
	normal_style.corner_radius_top_left = 18
	normal_style.corner_radius_top_right = 18
	normal_style.corner_radius_bottom_left = 18
	normal_style.corner_radius_bottom_right = 18
	normal_style.content_margin_left = 16
	normal_style.content_margin_top = 10
	normal_style.content_margin_right = 16
	normal_style.content_margin_bottom = 10
	normal_style.shadow_color = Color(core.r, core.g, core.b, 0.12)
	normal_style.shadow_size = 12
	normal_style.shadow_offset = Vector2(0, 4)

	var hover_style:= normal_style.duplicate()
	hover_style.bg_color = Color(0.045, 0.065, 0.105, 0.99 if not disabled else 0.72)
	hover_style.border_color = Color(core.r, core.g, core.b, 0.68 if not disabled else 0.2)
	hover_style.shadow_color = Color(core.r, core.g, core.b, 0.24)
	hover_style.shadow_size = 20

	var pressed_style:= normal_style.duplicate()
