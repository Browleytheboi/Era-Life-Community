	startup_intro_skip_tween.tween_callback(Callable(self, "_start_startup_intro_skip_idle_pulse"))
func _build_startup_intro_skip_glitch_timing() -> Dictionary:
	var timing: Dictionary = {
		"lead_in": 1.05,
		"flash_a": 0.07,
		"flash_b": 0.05,
		"flash_c": 0.08,
		"flash_d": 0.05,
		"settle_in": 0.12,
		"settle_out": 0.2
	}

	var sequence: Array = _startup_intro_cached_sequence_for_generation(
		"startup_intro_current_intro_sequence",
		"startup_intro_current_intro_sequence_generation"
	)
	if sequence.is_empty():
		set_meta("startup_intro_skip_glitch_timing_used_default_without_sequence_build", true)
		set_meta("startup_intro_skip_glitch_timing_used_default_at_ms", int(Time.get_ticks_msec()))
		return timing

	var beat_windows: Array = []
	var sample_count: int = min(sequence.size(), 4)

	for i in range(sample_count):
		var raw_beat: Variant = sequence [i]
		if typeof(raw_beat) != TYPE_DICTIONARY:
			continue

		var beat: Dictionary = raw_beat
		var beat_window: float = max(
			0.05,
			float(beat.get("fade_in", 0.2)) + float(beat.get("hold", 0.2))
		)
		beat_windows.append(beat_window)

	if beat_windows.size() > 0:
		timing ["lead_in"] = clampf(float(beat_windows [0]) * 0.92, 0.28, 1.2)

	if beat_windows.size() > 1:
		timing ["flash_a"] = clampf(float(beat_windows [1]) * 0.42, 0.05, 0.12)

	if beat_windows.size() > 2:
		timing ["flash_b"] = clampf(float(beat_windows [2]) * 0.3, 0.04, 0.09)

	if beat_windows.size() > 3:
		timing ["flash_c"] = clampf(float(beat_windows [3]) * 0.58, 0.06, 0.14)
		timing ["flash_d"] = clampf(float(beat_windows [3]) * 0.34, 0.04, 0.1)

	var settle_source: float = 0.2
	if beat_windows.size() > 0:
		settle_source = float(beat_windows [beat_windows.size() - 1])

	timing ["settle_in"] = clampf(settle_source * 0.78, 0.1, 0.18)
	timing ["settle_out"] = clampf(settle_source * 1.25, 0.16, 0.3)

	set_meta("startup_intro_skip_glitch_timing_used_cached_sequence", true)
	set_meta("startup_intro_skip_glitch_timing_used_cached_sequence_at_ms", int(Time.get_ticks_msec()))

	return timing
