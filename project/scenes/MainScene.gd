	control.set_meta("god_mode_presenter_hovered", true)
	_apply_god_mode_presentation_control_state(control, MainSceneHelpers._god_mode_presenter_state_for(control))

func _on_god_mode_presenter_control_mouse_exited(control: Control) -> void:
	if control == null:
		return
	control.set_meta("god_mode_presenter_hovered", false)
	_apply_god_mode_presentation_control_state(control, MainSceneHelpers._god_mode_presenter_state_for(control))

func _on_god_mode_presenter_control_focus_entered(control: Control) -> void:
	if control == null:
		return
	_apply_god_mode_presentation_control_state(control, "focus")

func _on_god_mode_presenter_control_focus_exited(control: Control) -> void:
	if control == null:
		return
	_apply_god_mode_presentation_control_state(control, MainSceneHelpers._god_mode_presenter_state_for(control))
func _god_mode_current_subtitle_glitch_color() -> Color:
	var colors: Array = MainSceneHelpers._god_mode_subtitle_glitch_color_cycle()
	if colors.is_empty():
		return Color(0.24, 0.86, 1.0, 1.0)

	var index: int = int(get_meta("god_mode_subtitle_glitch_color_index", 0))
	index = posmod(index, colors.size())
	return Color(colors [index])


func _advance_god_mode_subtitle_glitch_color() -> void:
	var colors: Array = MainSceneHelpers._god_mode_subtitle_glitch_color_cycle()
	if colors.is_empty():
		return

	var next_index: int = int(get_meta("god_mode_subtitle_glitch_color_index", 0)) + 1
	next_index = posmod(next_index, colors.size())
	set_meta("god_mode_subtitle_glitch_color_index", next_index)
	set_meta("god_mode_subtitle_glitch_color_changed_at_ms", int(Time.get_ticks_msec()))
func _apply_god_mode_subtitle_glitch_visual() -> void:
	if god_mode_subtitle_label == null or not is_instance_valid(god_mode_subtitle_label):
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var base_text: String = str(god_mode_subtitle_label.get_meta("god_mode_glitch_base_text", "CHOOSE YOUR EREALITY"))
	var next_ms: int = int(god_mode_subtitle_label.get_meta("god_mode_glitch_next_ms", now_ms + 2400))
	var until_ms: int = int(god_mode_subtitle_label.get_meta("god_mode_glitch_until_ms", 0))
	var was_glitching: bool = bool(god_mode_subtitle_label.get_meta("god_mode_glitch_active", false))

	if now_ms >= next_ms and now_ms >= until_ms:
		var rng:= RandomNumberGenerator.new()
		rng.seed = int(abs(hash("%s|%s|god_mode_glitch" % [str(now_ms), base_text])))
		god_mode_subtitle_label.set_meta("god_mode_glitch_until_ms", now_ms + int(rng.randi_range(90, 170)))
		god_mode_subtitle_label.set_meta("god_mode_glitch_next_ms", now_ms + int(rng.randi_range(2600, 5200)))
		god_mode_subtitle_label.set_meta("god_mode_glitch_active", true)

	until_ms = int(god_mode_subtitle_label.get_meta("god_mode_glitch_until_ms", 0))

	if now_ms < until_ms:
		var palette:= _current_god_mode_palette()
		var glitch_color: Color = _god_mode_current_subtitle_glitch_color()
		var title: Color = Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0)))
		var phase: int = int(floor(float(now_ms) / 38.0)) % 4

		match phase:
			0:
				god_mode_subtitle_label.text = "CHOOSE YOUR EREALITY"
				god_mode_subtitle_label.position.x = -2.0
			1:
				god_mode_subtitle_label.text = "CHOOSE YOUR EREAL1TY"
				god_mode_subtitle_label.position.x = 2.0
			2:
				god_mode_subtitle_label.text = "CHOOSE YØUR EREALITY"
				god_mode_subtitle_label.position.x = -1.0
			_:
				god_mode_subtitle_label.text = base_text
				god_mode_subtitle_label.position.x = 1.0

		god_mode_subtitle_label.add_theme_color_override(
			"font_color",
			glitch_color.lerp(title, 0.42)
		)
		god_mode_subtitle_label.rotation = deg_to_rad(0.2 if phase % 2 == 0 else -0.2)
	else:
		if was_glitching:
			_advance_god_mode_subtitle_glitch_color()
			god_mode_subtitle_label.set_meta("god_mode_glitch_active", false)

		var settled_color: Color = _god_mode_current_subtitle_glitch_color()
		god_mode_subtitle_label.text = base_text
		god_mode_subtitle_label.position.x = 0.0
		god_mode_subtitle_label.rotation = 0.0
		god_mode_subtitle_label.add_theme_color_override("font_color", settled_color)
func _animate_god_mode_presentation(delta: float) -> void:
	if not _god_mode_runtime_allowed("_animate_god_mode_presentation", "animate"):
		return

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return
	if not god_mode_start_panel.visible:
		return
	if god_mode_presentation_profile.is_empty():
		god_mode_presentation_profile = _build_god_mode_presentation_profile()

	var breathing: Dictionary = _build_god_mode_breathing_profile()
	var tau: float = PI * 2.0

	god_mode_presentation_panel_breath_phase = fposmod(
		god_mode_presentation_panel_breath_phase + (
			delta * (tau / max(0.001, float(breathing.get("panel_breath_cycle", 7.0))))
		),
		tau
	)
	god_mode_presentation_slider_streak_phase = fposmod(
		god_mode_presentation_slider_streak_phase + (
			delta * (tau / max(0.001, float(breathing.get("slider_streak_cycle", 5.8))))
		),
		tau
	)
	god_mode_presentation_mode_heartbeat_phase = fposmod(
		god_mode_presentation_mode_heartbeat_phase + (
			delta * (tau / max(0.001, float(breathing.get("mode_heartbeat_cycle", 1.85))))
		),
		tau
	)

	var viewport_size:= get_viewport_rect().size
	if viewport_size.x <= 0.0 or viewport_size.y <= 0.0:
		return

	var mouse_pos:= get_viewport().get_mouse_position()
	var pointer_target:= Vector2(
		clamp((mouse_pos.x / viewport_size.x) * 2.0 - 1.0, -1.0, 1.0),
		clamp((mouse_pos.y / viewport_size.y) * 2.0 - 1.0, -1.0, 1.0)
	)
	var follow:= float(god_mode_presentation_profile.get("pointer_follow", 6.0))
	god_mode_presentation_pointer = god_mode_presentation_pointer.lerp(
		pointer_target,
		min(1.0, delta * follow)
	)

	var panel_parallax:= float(god_mode_presentation_profile.get("panel_parallax_amount", 8.0))
	var content_parallax:= float(god_mode_presentation_profile.get("content_parallax_amount", 5.0))
	var background_parallax:= float(god_mode_presentation_profile.get("background_parallax_amount", 4.0))
	var surface_rotation:= float(god_mode_presentation_profile.get("surface_rotation", 0.01))

	var surface_root:= god_mode_start_panel.get_node_or_null("GodModePresentationSurface") as Control
	if surface_root != null:
		surface_root.position = Vector2(
			god_mode_presentation_pointer.x * panel_parallax,
			god_mode_presentation_pointer.y * panel_parallax
		)
		surface_root.rotation = - god_mode_presentation_pointer.x * surface_rotation

		var light_plane:= surface_root.get_node_or_null("LightPlane") as ColorRect
		if light_plane != null:
			light_plane.position = Vector2(
				- god_mode_presentation_pointer.x * panel_parallax * 0.65,
				- god_mode_presentation_pointer.y * panel_parallax * 0.35
			)

		var top_light:= surface_root.get_node_or_null("TopLight") as ColorRect
		if top_light != null:
			top_light.position = Vector2(
				- god_mode_presentation_pointer.x * panel_parallax * 0.45,
				-10.0 + god_mode_presentation_pointer.y * 2.0
			)

	var scroll:= god_mode_start_panel.get_node_or_null("GodModeContentScroll") as ScrollContainer
	if scroll != null:
		scroll.position = Vector2(
			- god_mode_presentation_pointer.x * content_parallax,
			- god_mode_presentation_pointer.y * content_parallax
		)

	if god_mode_background_dim != null:
		var background_surface:= god_mode_background_dim.get_node_or_null("GodModeBackgroundSurface") as ColorRect
		if background_surface != null:
			god_mode_presentation_background_phase += delta * float(
				god_mode_presentation_profile.get("background_drift_speed", 0.38)
			)
			var drift:= Vector2(
				sin(god_mode_presentation_background_phase),
				cos(god_mode_presentation_background_phase * 0.84)
			) * float(god_mode_presentation_profile.get("background_drift_amplitude", 10.0))
			background_surface.position = drift + (god_mode_presentation_pointer * background_parallax)

	_apply_god_mode_panel_breathing_visual()
	_apply_god_mode_section_label_breathing_visual()
	_apply_god_mode_subtitle_glitch_visual()
	_apply_god_mode_row_label_breathing_visual()
	_apply_god_mode_section_divider_breathing_visual()
	_animate_god_mode_slider_streaks()
	_refresh_reality_mode_state_buttons()
func _current_god_mode_palette_signature() -> String:
	var effective_mode: String = _selected_reality_mode_text()
	var is_custom: bool = not _toggle_state_matches_mode(effective_mode)
	var era_key: String = _current_god_mode_era_key_for_presentation()
	var entry_default_palette_active: bool = _god_mode_entry_default_palette_active()
	return "%s|%s|%s|entry_default:%s" % [effective_mode, str(is_custom), era_key, str(entry_default_palette_active)]
func _build_god_mode_breathing_profile() -> Dictionary:
	var effective_mode: String = _selected_reality_mode_text()
	var is_custom: bool = not _toggle_state_matches_mode(effective_mode)

	var panel_breath_cycle:= 7.0
	var slider_streak_cycle:= 5.8
	var mode_heartbeat_cycle:= 1.85
	var panel_breath_border_mix:= 0.18
	var panel_breath_shadow_boost:= 8.0
	var panel_breath_highlight_mix:= 0.06
	var slider_streak_width_ratio:= 0.16
	var slider_streak_alpha:= 0.08
	var mode_heartbeat_shadow_boost:= 0.18
	var mode_heartbeat_light_mix:= 0.08

	match effective_mode:
		"realistic":
			panel_breath_cycle = 7.6
			slider_streak_cycle = 6.4
			mode_heartbeat_cycle = 1.95
			panel_breath_border_mix = 0.14
			panel_breath_shadow_boost = 6.0
			panel_breath_highlight_mix = 0.04
			slider_streak_width_ratio = 0.14
			slider_streak_alpha = 0.06
			mode_heartbeat_shadow_boost = 0.14
			mode_heartbeat_light_mix = 0.05
		"enhanced":
			panel_breath_cycle = 7.0
			slider_streak_cycle = 5.8
			mode_heartbeat_cycle = 1.88
		"chaos":
			panel_breath_cycle = 6.4
			slider_streak_cycle = 5.0
			mode_heartbeat_cycle = 1.72
			panel_breath_border_mix = 0.22
			panel_breath_shadow_boost = 10.0
			panel_breath_highlight_mix = 0.08
			slider_streak_width_ratio = 0.18
			slider_streak_alpha = 0.1
			mode_heartbeat_shadow_boost = 0.22
			mode_heartbeat_light_mix = 0.1

	if is_custom:
		panel_breath_border_mix += 0.03
		panel_breath_shadow_boost += 1.5
		slider_streak_alpha += 0.01
		mode_heartbeat_shadow_boost += 0.02

	return {
		"panel_breath_cycle": panel_breath_cycle,
		"slider_streak_cycle": slider_streak_cycle,
		"mode_heartbeat_cycle": mode_heartbeat_cycle,
		"panel_breath_border_mix": panel_breath_border_mix,
		"panel_breath_shadow_boost": panel_breath_shadow_boost,
		"panel_breath_highlight_mix": panel_breath_highlight_mix,
		"slider_streak_width_ratio": slider_streak_width_ratio,
		"slider_streak_alpha": slider_streak_alpha,
		"mode_heartbeat_shadow_boost": mode_heartbeat_shadow_boost,
		"mode_heartbeat_light_mix": mode_heartbeat_light_mix
	}

