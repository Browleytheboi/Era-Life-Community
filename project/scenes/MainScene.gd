	if not bool(
		get_meta(
			"startup_cinematic_first_process_frame_observed",
			false
		)
	):
		set_meta(
			"startup_cinematic_first_process_frame_observed",
			true
		)

		tree.process_frame.connect(
			Callable(
				self,
				"_finish_mainscene_ready_after_first_cinematic_paint"
			),
			CONNECT_ONE_SHOT
		)
		return

	var identity_report_raw: Variant = get_meta(
		"title_card_identity_contract",
		{}
	)
	var identity_report: Dictionary = (
		(identity_report_raw as Dictionary).duplicate(true)
		if typeof(identity_report_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		gs != null
		and gs.has_method(
			"resolve_title_card_identity_contract"
		)
	):
		identity_report = (
			gs.resolve_title_card_identity_contract(
				{
					"source": (
						"mainscene_ready_after_"
						+ "first_cinematic_paint"
					),
				}
			)
		)

	set_meta(
		"title_card_identity_contract",
		identity_report.duplicate(true)
	)
	set_meta(
		"title_card_identity_resolved",
		bool(
			identity_report.get(
