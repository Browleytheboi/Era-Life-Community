func _resolve_player_household_departure() -> Dictionary:
	var p: Person = gs.player
	if p == null:
		return {}

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var household_state_raw: Variant = gs.scenario_state.get("household_state", {})
	var household_state: Dictionary = household_state_raw if typeof(household_state_raw) == TYPE_DICTIONARY else {}

	if int(p.age) >= 18:
		household_state ["forced_self_anchor_player_id"] = int(p.id)
		gs.scenario_state ["household_state"] = household_state

		var text:= "You left the household and began living under your own roof.\n\nIt may still be the same city, the same block, and maybe even the same kind of home for now — but socially and structurally, you are no longer living under somebody else’s household."
		_append_text_to_diary(text, false)
		return {
			"popup_title": "Household Changed",
			"popup_text": text,
			"popup_footer": "Tap anywhere to continue."
		}

	return _build_runaway_attempt_result(p)
func _build_runaway_attempt_result(person: Person) -> Dictionary:
	var anchor: Person = MainSceneLogic._resolve_player_household_anchor(gs, person)
	var place_text: String = "home"
	if str(person.home_city).strip_edges() != "" and str(person.home_country).strip_edges() != "":
		place_text = "%s, %s" % [person.home_city, person.home_country]
	elif str(person.home_city).strip_edges() != "":
		place_text = person.home_city
	elif str(person.home_country).strip_edges() != "":
		place_text = person.home_country

	var household_state_raw: Variant = gs.scenario_state.get("household_state", {})
	var household_state: Dictionary = household_state_raw if typeof(household_state_raw) == TYPE_DICTIONARY else {}

	var death_roll: int = randi_range(1, 100)
	var success_roll: int = randi_range(1, 100)

	if death_roll <= 6:
		var death_stories: Array = [
			"You slipped away from %s in the dark, tried to sleep in a place no child should have been sleeping, and never woke up." % place_text,
			"You ran from home certain freedom would feel cinematic. Instead, the era caught up to you faster than courage could.",
			"You made it out of the house, but not out of danger. The world beyond the household was harsher than you understood."
		]
		var death_text: String = str(death_stories [randi() % death_stories.size()])

		person.alive = false
		person.health = 0
		person.cause_of_death = "Died after running away from home"

		if gs.event_bus != null:
			gs.event_bus.emit(ActionEventTypes.PLAYER_DIED, {
				"cause": person.cause_of_death
			})

		return {
			"popup_title": "You Died",
			"popup_text": death_text,
			"popup_footer": "Tap anywhere to continue."
		}

	if success_roll <= 18:
		household_state ["forced_self_anchor_player_id"] = int(person.id)
		gs.scenario_state ["household_state"] = household_state

		var success_text:= "You actually got away.\n\nIt was messy, scared, and way less glamorous than the fantasy — but you separated yourself from the household and are now surviving on your own."
		_append_text_to_diary(success_text, false)
		return {
			"popup_title": "You Got Away",
			"popup_text": success_text,
			"popup_footer": "Tap anywhere to continue."
		}

	var fail_stories: Array = [
		"You stuffed clothes into a bag, made it halfway down the road, and got spotted by %s before the escape could even become a story." % (_relationship_display_name(anchor) if anchor != null else "your household"),
		"You tried to disappear into %s, but somebody recognized you almost immediately and called your family." % place_text,
		"You attempted a dramatic runaway arc, but it ended with you hungry, tired, and caught near the exact property you thought you had cleverly escaped.",
		"You made a bold break for freedom and somehow got brought back home faster than it took you to leave.",
		"You ran away with the confidence of a legend and the planning skills of a confused raccoon. Your parents found you."
	]

	var fail_text: String = str(fail_stories [randi() % fail_stories.size()])
	_append_text_to_diary(fail_text, false)

	return {
		"popup_title": "Runaway Failed",
		"popup_text": fail_text,
		"popup_footer": "Tap anywhere to continue."
	}
