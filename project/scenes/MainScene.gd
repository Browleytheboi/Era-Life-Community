			"interactive_surface_input_suspended",
			true
		)

	var return_surface_key: String = str(
		get_meta(
			"property_market_return_surface_key",
			"life"
		)
	)

	remove_meta(
		"property_market_return_surface_key"
	)

	_restore_market_parent_surface(
		return_surface_key,
		"property_market_back"
	)

func _refresh_property_market_panel(status_text: String = "", selected_template_id: String = "") -> void:
	if property_market_panel == null or not is_instance_valid(property_market_panel):
		return

	var contract: Dictionary = _property_market_request_surface_contract("mainscene.property_market_panel_refresh", status_text, selected_template_id)
	if contract.is_empty():
		property_market_panel.render_surface_contract({
			"success": false,
			"title": "Property Market",
			"subtitle": "No property market contract is available.",
			"listing_card_contracts": [],
			"truth_state": "missing_surface_contract",
			"ui_is_renderer_only": true
		})
		return

	property_market_panel.open_for_actor(gs.player, contract)


func _property_market_request_surface_contract(
	source: String = (
		"mainscene.property_market_surface_request"
	),
	status_text: String = "",
	selected_template_id: String = ""
) -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	var payload: Dictionary = {
		"actor_id": int(gs.player.id),
		"source": source,
		"status_text": status_text,
		"selected_template_id": selected_template_id,
		"ui_is_renderer_only": true
	}
	var report: Dictionary = _express_global_ui_intent({
		"actor_id": int(gs.player.id),
		"intent_type": (
			"property_market_surface_request"
		),
		"surface_id": (
			"property_market_contract_panel"
		),
		"action_id": (
			"view_property_market_panel"
		),
		"payload": payload.duplicate(true),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"property_market_contract_engine"
			),
			"method": (
				"emit_market_surface_contract"
			),
			"pass_actor_payload": true,
			"actor_id": int(gs.player.id)
		},
		"source": source
	}, {
		"actor_id": int(gs.player.id),
		"source": source,
		"surface_id": (
			"property_market_contract_panel"
		),
		"action_id": (
			"view_property_market_panel"
		)
	})
	var result: Dictionary = (
		_market_panel_route_result(
			report
		)
	)

	if typeof(
		result.get(
			"surface_contract",
			{}
		)
	) == TYPE_DICTIONARY:
		var routed_contract: Dictionary = (
			result.get(
				"surface_contract",
				{}
			) as Dictionary
		).duplicate(true)

		if MainSceneLogic._market_surface_contract_is_renderable(
			routed_contract,
			"property"
		):
			return routed_contract

	if MainSceneLogic._market_surface_contract_is_renderable(
		result,
		"property"
	):
		return result.duplicate(true)

	return MainSceneLogic._observable_asset_market_surface_contract(gs, 
		gs.player,
		"property",
		status_text
	)

func _on_property_market_listing_action_requested(
