	_truth_paint_player_stat_bar_now(player_stats_looks_label, player_stats_looks_bar, "Looks", looks_value, looks_max, surface_context)
	_truth_paint_player_stat_bar_now(player_stats_smarts_label, player_stats_smarts_bar, "Smarts", smarts_value, smarts_max, surface_context)
	_truth_paint_player_stat_bar_now(player_stats_mental_label, player_stats_mental_bar, "Mental", mental_value, mental_max, surface_context)
	_truth_paint_player_stat_bar_now(player_stats_willpower_label, player_stats_willpower_bar, "Willpower", willpower_value, willpower_max, surface_context)
	_truth_paint_player_stat_bar_now(player_stats_happiness_label, player_stats_happiness_bar, "Happiness", happiness_value, happiness_max, surface_context)
	_truth_paint_player_stat_bar_now(player_stats_imagination_label, player_stats_imagination_bar, "Imagination", imagination_value, imagination_max, surface_context)

