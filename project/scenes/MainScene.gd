func _schedule_god_mode_start_panel_hydration_after_first_paint(reason: String = "god_mode_open") -> void:
	set_meta("god_mode_start_panel_hydration_pending", true)
	set_meta("god_mode_start_panel_hydration_reason", reason)
	set_meta("god_mode_start_panel_hydration_scheduled_at_ms", int(Time.get_ticks_msec()))

	if bool(get_meta("god_mode_start_panel_hydration_frame_connected", false)):
		return

	set_meta("god_mode_start_panel_hydration_frame_connected", true)

	var hydrate_callable:= Callable(self, "_hydrate_god_mode_start_panel_after_first_paint").bind(reason)
	RenderingServer.frame_post_draw.connect(hydrate_callable, CONNECT_ONE_SHOT)


func _hydrate_god_mode_start_panel_after_first_paint(reason: String = "god_mode_open") -> void:
	set_meta("god_mode_start_panel_hydration_frame_connected", false)

	var tree:= get_tree()
	if tree != null:
		await tree.process_frame

	set_meta("god_mode_start_panel_hydration_started_at_ms", int(Time.get_ticks_msec()))

	_prepare_god_mode_ui_shell_only_contract_for_entry("%s_hydrate_after_first_paint" % reason)
	set_meta("god_mode_panel_ui_prewarm_allowed", true)
	_prewarm_god_mode_start_panel_for_entry()
	set_meta("god_mode_panel_ui_prewarm_allowed", false)

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		set_meta("god_mode_start_panel_hydration_pending", false)
		return

	_reveal_prewarmed_god_mode_start_panel()
	_hide_god_mode_start_panel_zero_frame_shell("%s_hydrated" % reason)

	set_meta("god_mode_start_panel_hydration_pending", false)
	set_meta("god_mode_zero_frame_open_active", false)
	set_meta("god_mode_start_panel_hydrated_at_ms", int(Time.get_ticks_msec()))

	call_deferred("_begin_god_mode_seed_crafting_session_after_panel_settled", "%s_hydrated" % reason)
