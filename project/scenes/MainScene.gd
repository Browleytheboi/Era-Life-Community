func _schedule_deferred_live_reality_stream_bind_for_spawn(reason: String = "spawn_ready") -> void:
	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("live_reality_bind", "Mainscene._schedule_deferred_live_reality_stream_bind_for_spawn", reason, {
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": false
		}):
			set_meta("deferred_live_reality_stream_bind_pending", false)
			set_meta("deferred_live_reality_stream_bind_soft_deferred", true)
			set_meta("deferred_live_reality_stream_bind_blocked_by_global_runtime_kill", true)
			set_meta("deferred_live_reality_stream_bind_blocked_reason", reason)
			set_meta("deferred_live_reality_stream_bind_blocked_at_ms", int(Time.get_ticks_msec()))

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = false
				gs.scenario_state ["deferred_live_reality_stream_bind_soft_deferred"] = true
				gs.scenario_state ["deferred_live_reality_stream_bind_blocked_by_global_runtime_kill"] = true
				gs.scenario_state ["live_reality_stream_bind_may_not_touch_visible_shell"] = true

			return

	set_meta("deferred_live_reality_stream_bind_pending", true)
	set_meta("deferred_live_reality_stream_bind_reason", reason)
	set_meta("deferred_live_reality_stream_bind_scheduled_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		return

	var delay_seconds: float = 1.1
	var now_ms: int = int(Time.get_ticks_msec())

	if bool(get_meta("prewarmed_capsule_entry_shell_first", false)) or bool(get_meta("spawn_ready_runtime_hud_shell_only_active", false)):
		delay_seconds = 5.25
		set_meta("age_up_tail_background_allowed_after_ms", now_ms + 5200)
		set_meta("ui_idle_bus_flush_next_ms", now_ms + 900)

	var timer:= tree.create_timer(delay_seconds)
	timer.timeout.connect(
		Callable(self, "_run_deferred_live_reality_stream_bind_for_spawn").bind(reason, 0),
		CONNECT_ONE_SHOT
	)

func _run_deferred_live_reality_stream_bind_for_spawn(reason: String = "spawn_ready", pass_index: int = 0) -> void:
	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("live_reality_bind", "Mainscene._run_deferred_live_reality_stream_bind_for_spawn", reason, {
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": false,
			"pass_index": pass_index
		}):
			set_meta("deferred_live_reality_stream_bind_pending", false)
			set_meta("deferred_live_reality_stream_bind_soft_deferred", true)
			set_meta("deferred_live_reality_stream_bind_run_blocked_by_global_runtime_kill", true)
			set_meta("deferred_live_reality_stream_bind_run_blocked_reason", reason)
			set_meta("deferred_live_reality_stream_bind_run_blocked_at_ms", int(Time.get_ticks_msec()))

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = false
				gs.scenario_state ["deferred_live_reality_stream_bind_soft_deferred"] = true
				gs.scenario_state ["live_reality_stream_bind_run_blocked_by_global_runtime_kill"] = true
				gs.scenario_state ["live_reality_stream_bind_may_not_touch_visible_shell"] = true

			return

	if gs == null or gs.player == null:
		set_meta("deferred_live_reality_stream_bind_pending", false)
		return

	var tree:= get_tree()
	if tree == null:
		set_meta("deferred_live_reality_stream_bind_pending", false)
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if not _background_tail_work_allowed(now_ms):
		set_meta("deferred_live_reality_stream_bind_waiting_for_tail_boundary", true)
		set_meta("deferred_live_reality_stream_bind_waiting_reason", reason)
		set_meta("deferred_live_reality_stream_bind_waiting_pass_index", pass_index)
		set_meta("deferred_live_reality_stream_bind_next_try_ms", now_ms + 950)

		var tail_wait_timer:= tree.create_timer(0.95)
		tail_wait_timer.timeout.connect(
			Callable(self, "_run_deferred_live_reality_stream_bind_for_spawn").bind(reason, pass_index + 1),
			CONNECT_ONE_SHOT
		)
		return

	if _runtime_interactive_surface_busy(now_ms) or _post_spawn_ui_is_busy_for_prewarm() or _ui_interaction_grace_active(now_ms):
		var wait_timer:= tree.create_timer(1.25)
		wait_timer.timeout.connect(
			Callable(self, "_run_deferred_live_reality_stream_bind_for_spawn").bind(reason, pass_index + 1),
			CONNECT_ONE_SHOT
		)
		return

	set_meta("deferred_live_reality_stream_bind_waiting_for_tail_boundary", false)
	set_meta("deferred_live_reality_stream_bind_pending", false)
	set_meta("deferred_live_reality_stream_bind_completed_at_ms", now_ms)
	_bind_live_reality_stream_for_spawn(reason)
func _runtime_boot_maybe_buffer_ui_action(action: Dictionary, payload: Dictionary, fallback_domain: String, engine_property: String, method_name: String, source_id: String) -> bool:
	if gs == null:
		return false
	if not gs.has_method("resolve_runtime_boot_domain_gate"):
		return false

	var domain_id: String = MainSceneHelpers._runtime_boot_domain_for_hub_action(action, fallback_domain, engine_property, payload)
	var action_id: String = str(action.get("id", payload.get("action", ""))).strip_edges().to_lower()
	if action_id == "":
		action_id = "runtime.intent"

	var gate: Dictionary = _superpower_hub_safe_dictionary(gs.resolve_runtime_boot_domain_gate(domain_id, action_id, {
		"source": source_id,
		"engine_property": engine_property,
		"method": method_name,
		"payload": payload.duplicate(true),
		"ui_action": action.duplicate(true)
	}))

	if bool(gate.get("allowed", true)):
		return false

	var queue_report: Dictionary = {}
	if bool(gate.get("buffer_intent", false)) and gs.has_method("queue_runtime_boot_intent"):
		queue_report = _superpower_hub_safe_dictionary(gs.queue_runtime_boot_intent({
			"domain": domain_id,
			"cie_domain": MainSceneHelpers._runtime_boot_cie_domain_for_action(domain_id, action_id),
			"action_id": action_id,
			"actor_id": int(gs.player.id) if gs.player != null else -1,
			"engine_property": engine_property,
			"method": method_name,
			"payload": payload.duplicate(true),
			"source": source_id,
			"ui_action": action.duplicate(true),
			"resolution_strategy": str(gate.get("resolution_strategy", "prefer_existing_if_available")),
			"causality_inversion_allowed": bool(gate.get("causality_inversion_allowed", true)),
			"truth_layer_required": bool(gate.get("truth_layer_required", false)),
			"local_shell_text": str(gate.get("popup_title", "Reality is still assembling."))
		}))

	var local_shell_packet: Dictionary = _superpower_hub_safe_dictionary(queue_report.get("local_shell_packet", {}))
	var popup_title: String = str(gate.get("popup_title", "Reality is still assembling."))
	var popup_text: String = str(gate.get("popup_text", "This action is being held until the system behind it becomes live."))

	if not local_shell_packet.is_empty():
		var shell: Dictionary = _superpower_hub_safe_dictionary(local_shell_packet.get("local_shell", {}))
		popup_title = str(shell.get("text", popup_title))
		popup_text = "The local shell accepted your intent before canonical reality finished loading."

	_maybe_show_action_result_popup({
		"success": bool(gate.get("buffer_intent", false)),
		"popup_title": popup_title,
		"popup_text": popup_text,
		"popup_footer": "Local Shell → IPS → CRBS → CIE → Truth Layer → Retrofit.",
		"text": popup_text,
		"runtime_boot_gate": gate.duplicate(true),
		"runtime_boot_queue_report": queue_report.duplicate(true),
		"local_shell_packet": local_shell_packet.duplicate(true)
	})

	if has_method("_continue_post_spawn_world_prewarm"):
		call_deferred("_continue_post_spawn_world_prewarm", int(get_meta("life_boot_ticket", -1)))

	return true


func _flush_runtime_boot_buffered_ui_intents() -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty():
		var next_write_ms: int = int(get_meta("runtime_boot_buffered_ui_intents_suspended_next_state_write_ms", 0))
		if now_ms >= next_write_ms:
			set_meta("runtime_boot_buffered_ui_intents_flush_suspended_by_visible_shell", true)
			set_meta("runtime_boot_buffered_ui_intents_flush_suspended_at_ms", now_ms)
			set_meta("runtime_boot_buffered_ui_intents_flush_blocked_by_global_runtime_kill", false)
			set_meta("runtime_boot_buffered_ui_intents_suspended_next_state_write_ms", now_ms + 5000)
			set_meta("ui_idle_bus_flush_next_ms", now_ms + 5000)

			if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["runtime_boot_buffered_ui_intents_flush_suspended_by_visible_shell"] = true
				gs.scenario_state ["runtime_boot_buffered_ui_intents_flush_suspended_at_ms"] = now_ms
				gs.scenario_state ["runtime_boot_buffered_ui_intents_may_not_override_visible_shell"] = true
				gs.scenario_state ["runtime_boot_buffered_ui_intents_wait_for_non_perceptual_window"] = true
				gs.scenario_state ["player_perception_realtime_contract_enforced"] = true

		return

	if gs == null or gs.player == null:
		return
	if not gs.has_method("consume_runtime_boot_intents_for_domain"):
		return

	var domains: Array = ["powers", "superhero", "artifacts", "bending", "world", "runtime"]

	for raw_domain in domains:
		var domain_id: String = str(raw_domain)
		var intents: Array = gs.consume_runtime_boot_intents_for_domain(domain_id)

		for raw_intent in intents:
			if typeof(raw_intent) != TYPE_DICTIONARY:
				continue

			var intent: Dictionary = _superpower_hub_safe_dictionary(raw_intent)
			var engine_property: String = str(intent.get("engine_property", "")).strip_edges()
			var method_name: String = str(intent.get("method", "")).strip_edges()
			var payload: Dictionary = _superpower_hub_safe_dictionary(intent.get("payload", {}))
			var action_id: String = str(intent.get("action_id", payload.get("action", ""))).strip_edges().to_lower()

			if action_id == "":
				action_id = "runtime.intent"

			if payload.is_empty():
				payload ["action"] = action_id

			var result: Dictionary = {}

			if bool(intent.get("causality_inversion_allowed", false)) and gs.has_method("resolve_causality_inverted_intent"):
				var cie_report: Dictionary = _superpower_hub_safe_dictionary(gs.resolve_causality_inverted_intent(gs.player, {
					"action_id": action_id,
					"domain": str(intent.get("cie_domain", MainSceneHelpers._runtime_boot_cie_domain_for_action(domain_id, action_id))),
					"payload": payload.duplicate(true),
					"resolution_strategy": str(intent.get("resolution_strategy", "generate_if_missing"))
				}, {
					"source": "runtime_boot_buffer_flush",
					"crbs_domain": domain_id,
					"engine_property": engine_property,
					"method": method_name,
					"remote_truth_layer": bool(intent.get("truth_layer_required", false))
				}))

				if bool(cie_report.get("success", false)):
					result = cie_report.duplicate(true)
				else:
					result = {
						"success": false,
						"popup_title": str(cie_report.get("popup_title", "Reality could not invert causality.")),
						"popup_text": str(cie_report.get("reason", "CIE rejected the buffered intent.")),
						"causality_inversion": cie_report.duplicate(true)
					}

			if result.is_empty():
				if engine_property == "" or method_name == "":
					continue

				var engine = gs.get(engine_property)
				if engine != null and engine.has_method(method_name):
					result = _superpower_hub_safe_dictionary(engine.call(method_name, gs.player, payload))
				else:
					result = {
						"success": false,
						"popup_title": "Buffered intent could not resolve.",
						"popup_text": "Reality released the action, but the target engine was not available.",
						"engine_property": engine_property,
						"method": method_name
					}

			if not result.has("popup_footer"):
				result ["popup_footer"] = "Queued intent resolved through CRBS and the causality pipeline."

			if domain_id == "powers" and power_hub_open:
				_render_power_hub_overlay()
			elif domain_id == "superhero" and superpower_hub_open:
				_render_superpower_hub_overlay()
			elif domain_id == "bending":
				bending_hud_last_rebuild_signature = ""
				_update_bending_hud()

			_maybe_show_action_result_popup(result)
func _runtime_boot_domain_status_lines(domain_id: String) -> Array:
	if gs == null:
		return []
	if not gs.has_method("get_runtime_boot_scheduler_snapshot"):
		return []

	var snapshot: Dictionary = _superpower_hub_safe_dictionary(gs.get_runtime_boot_scheduler_snapshot())
	if not bool(snapshot.get("pending", false)):
		return []

	var domain_states: Dictionary = _superpower_hub_safe_dictionary(snapshot.get("domain_states", {}))
	var state: Dictionary = _superpower_hub_safe_dictionary(domain_states.get(str(domain_id).strip_edges().to_lower(), {}))
	if state.is_empty():
		return []

	var visibility_state: String = str(state.get("visibility_state", "hidden")).strip_edges().to_lower()
	var interaction_state: String = str(state.get("interaction_state", "locked")).strip_edges().to_lower()
	var execution_state: String = str(state.get("execution_state", "deferred")).strip_edges().to_lower()

	if visibility_state == "hidden" or execution_state == "complete":
		return []

	return [
		"Visibility: %s" % visibility_state.capitalize(),
		"Interaction: %s" % interaction_state.capitalize(),
		"Execution: %s" % execution_state.capitalize(),
		str(state.get("player_status_text", "Reality is still assembling this system."))
	]
func _render_superpower_hub_overlay() -> void:
	if superpower_hub_content_box == null:
		return

	_clear_container_children(superpower_hub_content_box)

	var payload: Dictionary = _superpower_hub_payload()
	superpower_hub_active_payload = payload.duplicate(true)

	var profile: Dictionary = _superpower_hub_safe_dictionary(payload.get("profile", {}))
	var hub_identity: Dictionary = _superpower_hub_safe_dictionary(payload.get("hub_identity", {}))

	if superpower_hub_title != null:
		var alias_text: String = str(profile.get("public_alias", "")).strip_edges()
		if alias_text == "":
			alias_text = str(payload.get("actor_name", "SECRET SUPER LIFE")).strip_edges()
		if alias_text == "":
			alias_text = "SECRET SUPER LIFE"

		var identity_title: String = str(hub_identity.get("title", "PUBLIC LIFE")).strip_edges()
		if identity_title == "":
			identity_title = "PUBLIC LIFE"

		superpower_hub_title.text = "%s • %s" % [
			identity_title.to_upper(),
			alias_text.to_upper()
		]

	var sections: Array = _superpower_hub_safe_array(payload.get("sections", []))
	_rebuild_superpower_hub_section_bar(sections)
	var boot_lines: Array = _runtime_boot_domain_status_lines("superhero")
	if not bool(payload.get("runtime_cache_ready", false)) and not boot_lines.is_empty():
		_add_superpower_hub_info_card("CITY SIGNAL STILL ASSEMBLING", boot_lines)
	var selected_section: Dictionary = _superpower_hub_selected_section(payload)
	if selected_section.is_empty():
		_add_superpower_hub_info_card("PUBLIC LIFE", [
			"No Super Hero Hub sections are available yet.",
			"PowerEngine and SuperHeroEngine can still append sections through contract payloads."
		])
		return

	_add_superpower_hub_section(selected_section)
	_sync_superpower_hub_section_buttons()


