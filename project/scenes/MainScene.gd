			target_id
		)
		+ "|previous_actor_id=" + str(
			previous_actor_id
		)
		+ "|identity_bound="
		+ str(
			visible_lens_bound
		).to_lower()
		+ "|native_switch_lens_finalized="
		+ str(
			native_switch_lens_finalized
		).to_lower()
		+ "|stats_retargeted=true"
		+ "|pending_lens_bound="
		+ str(
			pending_lens_bound
		).to_lower()
		+ "|commit_bound_packet_used="
		+ str(
			used_commit_bound_packet
		).to_lower()
		+ "|main_tab_deck_hot="
		+ str(
			main_tab_deck_hot
		).to_lower()
		+ "|diary_history_bound="
		+ str(
			diary_history_bound
		).to_lower()
		+ "|old_diary_retired=true"
		+ "|old_actor_fallback=false"
		+ "|progressive_support=true"
		+ "|generic_refresh=false"
		+ "|engine_calls=false"
		+ "|build_on_handoff=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(
			Time.get_ticks_msec()
		)
	)
func _install_switched_actor_support_surfaces_from_store(
	target_id: int,
	source: String = "relationship_profile_switch_tail",
	stage_index: int = 0
) -> void:
	if (
		gs == null
		or gs.player == null
		or target_id <= 0
		or int(gs.player.id) != target_id
	):
		return

	if stage_index > 0:
		return

	var target: Person = gs.player
	var support_registry: Dictionary = {}

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		support_registry = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"resident_control_switch_support_surface_packet_by_actor",
				gs.scenario_state.get(
					"observable_control_switch_support_surface_packet_by_actor",
					{}
				)
			)
		)

	var support_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		support_registry.get(
			str(target_id),
			{}
		)
	)
	var support_packet_requested_after_visible: bool = false

	if support_packet.is_empty():
		_detach_actor_scoped_renderer_bindings_for_control_switch(
			target_id,
			(
				"%s_support_packet_missing_prevent_old_surface_reuse"
				% source
			)
		)




		var pointer_registry: Dictionary = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"profile_pointer_packet_by_actor",
				{}
			)
		)
		var pointer_packet: Dictionary = MainSceneHelpers._safe_dictionary(
			pointer_registry.get(
				str(target_id),
				{}
			)
		)

		var pointer_diary_hot: bool = (
			_install_switched_actor_life_diary_from_published_packet(
				target,
				pointer_packet,
				"%s_pointer_packet_without_support_deck"
				% source
			)
			if not pointer_packet.is_empty()
			else false
		)




		var crown_rebind_hot: bool = (
			_install_switched_actor_crown_contract_from_packet(
				target,
				{},
				"%s_without_support_deck"
				% source
			)
		)

		set_meta(
			"switched_actor_support_packet_missing_after_visible",
			true
		)
		set_meta(
			"switched_actor_support_packet_missing_actor_id",
			target_id
		)
		set_meta(
			"switched_actor_support_packet_sync_request_forbidden",
			true
		)
		set_meta(
			"switched_actor_support_packet_old_surface_reuse_forbidden",
			true
		)
		set_meta(
			"switched_actor_support_packet_tail_lookup_deep_scan_forbidden",
			true
		)
		set_meta(
			"switched_actor_pointer_diary_bound_without_support_packet",
			pointer_diary_hot
		)
		set_meta(
			"switched_actor_crown_rebind_armed_without_support_packet",
			not crown_rebind_hot
			or _player_has_crown_presence()
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"switched_actor_support_packet_missing_after_visible"
			] = true
			gs.scenario_state [
				"switched_actor_support_packet_missing_actor_id"
			] = target_id
			gs.scenario_state [
				"switched_actor_support_packet_sync_request_forbidden"
			] = true
			gs.scenario_state [
				"switched_actor_support_packet_tail_lookup_deep_scan_forbidden"
			] = true
			gs.scenario_state [
				"switched_actor_support_surfaces_installed"
			] = false
			gs.scenario_state [
				"controlled_actor_old_surface_reuse_forbidden"
			] = true
			gs.scenario_state [
				"switched_actor_pointer_diary_bound_without_support_packet"
			] = pointer_diary_hot
			gs.scenario_state [
				"switched_actor_crown_residency_independent_of_support_packet"
			] = true

		EraLog.truth(
			"ERALIFE_SWITCH_SUPPORT_SURFACE_TRUTH"
			+ "|actor_id=" + str(target_id)
			+ "|support_packet_missing=true"
			+ "|pointer_diary_hot="
			+ str(pointer_diary_hot).to_lower()
			+ "|crown_autonomous_rebind=true"
			+ "|main_tabs_owned_by_reality_projection=true"
			+ "|old_surface_reuse_forbidden=true"
			+ "|sync_request_forbidden=true"
			+ "|tail_lookup_deep_scan=false"
			+ "|engine_calls=false"
			+ "|frame_waits=0"
			+ "|build_on_switch=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)

		return

	var profile_registry: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"profile_pointer_packet_by_actor",
			{}
		)
	)
	var profile_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		profile_registry.get(
			str(target_id),
			{}
		)
	)
	var profile_surface: Dictionary = MainSceneHelpers._safe_dictionary(
		profile_packet.get(
			"surface_contract",
			{}
		)
	)
	var deck: Dictionary = MainSceneHelpers._safe_dictionary(
		support_packet.get(
			"main_tab_surface_contracts",
			profile_packet.get(
				"main_tab_surface_contracts",
				profile_surface.get(
					"main_tab_surface_contracts",
					{}
				)
			)
		)
	)

	var support_viewer_packet: Dictionary = (
		profile_packet.duplicate(false)
	)

	if support_viewer_packet.is_empty():
		support_viewer_packet = (
			support_packet.duplicate(false)
		)

	for raw_key in [
		"asset_surface_pack",
		"assets_surface_contract",
		"property_market_surface_contract",
		"vehicle_market_surface_contract",
		"vehicle_market_surface_deck",
		"crime_hub_contract",
		"pet_shop_surface_contract",
		"pending_situations_payload",
		"crown_hub_contract"
	]:
		var key: String = str(
			raw_key
		)
		var support_value: Variant = (
			support_packet.get(
				key,
				null
			)
		)

		if typeof(support_value) == TYPE_DICTIONARY:
			support_viewer_packet [
				key
			] = (
				support_value as Dictionary
			).duplicate(false)

	var life_diary_hot: bool = (
		_install_switched_actor_life_diary_from_published_packet(
			target,
			profile_packet,
			"%s_profile_packet" % source
		)
	)
	var assets_hot: bool = (
		_install_switched_actor_assets_contract_from_packet(
			target,
			support_viewer_packet
		)
	)
	var pet_hot: bool = (
		_render_pet_shop_surface_contract(
			MainSceneHelpers._safe_dictionary(
				support_packet.get(
					"pet_shop_surface_contract",
					deck.get(
						"pet_shop",
						support_viewer_packet.get(
							"pet_shop_surface_contract",
							{}
						)
					)
				)
			),
			target_id,
			false
		)
	)
	var crime_hot: bool = (
		_install_switched_actor_crime_contract_from_packet(
			target,
			MainSceneHelpers._safe_dictionary(
				support_packet.get(
					"crime_hub_contract",
					deck.get(
						"crime",
						support_viewer_packet.get(
							"crime_hub_contract",
							{}
						)
					)
				)
			)
		)
	)
	var pending_hot: bool = (
		_install_switched_actor_pending_contract_from_packet(
			target,
			MainSceneHelpers._safe_dictionary(
				support_packet.get(
					"pending_situations_payload",
					deck.get(
						"pending_situations",
						support_viewer_packet.get(
							"pending_situations_payload",
							{}
						)
					)
				)
			)
		)
	)

	var crown_expected: bool = (
		_player_has_crown_presence()
	)
	var crown_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		support_packet.get(
			"crown_hub_contract",
			deck.get(
				"crown",
				support_viewer_packet.get(
					"crown_hub_contract",
					{}
				)
			)
		)
	)
	var crown_hot: bool = (
		_install_switched_actor_crown_contract_from_packet(
			target,
			crown_contract,
			source
		)
		if crown_expected
		else crown_contract.is_empty()
	)

	_update_pending_situations_button()
	_update_crown_hud()

	var main_tabs_hot: bool = (
		_resident_main_tab_renderer_deck_is_hot(
			target_id
		)
	)
	var required_surfaces_hot: bool = (
		main_tabs_hot
		and assets_hot
		and pet_hot
		and crime_hot
		and pending_hot
		and crown_hot
	)
	var installed_at_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"switched_actor_support_surfaces_installed",
		required_surfaces_hot
	)
	set_meta(
		"switched_actor_support_surfaces_installed_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_support_surfaces_installed_at_ms",
		installed_at_ms
	)
	set_meta(
		"switched_actor_support_surfaces_engine_calls_performed",
		support_packet_requested_after_visible
	)
	set_meta(
		"switched_actor_support_surface_atomic_mount",
		required_surfaces_hot
	)
	set_meta(
		"switched_actor_support_surface_frame_waits",
		0
	)
	set_meta(
		"switched_actor_support_packet_direct_mount",
		true
	)
	set_meta(
		"switched_actor_support_packet_profile_shell_dependency",
		false
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"switched_actor_support_surfaces_installed"
		] = required_surfaces_hot
		gs.scenario_state [
			"switched_actor_support_surfaces_installed_actor_id"
		] = target_id
		gs.scenario_state [
			"switched_actor_main_tabs_hot"
		] = main_tabs_hot
		gs.scenario_state [
			"switched_actor_support_surface_engine_calls"
		] = support_packet_requested_after_visible
		gs.scenario_state [
			"switched_actor_support_surface_frame_waits"
		] = 0
		gs.scenario_state [
			"switched_actor_support_packet_direct_mount"
		] = true
		gs.scenario_state [
			"switched_actor_support_packet_profile_shell_dependency"
		] = false

	EraLog.truth(
		"ERALIFE_SWITCH_SUPPORT_SURFACE_TRUTH"
		+ "|actor_id=" + str(target_id)
		+ "|main_tabs_hot=" + str(main_tabs_hot).to_lower()
		+ "|life_diary_hot=" + str(life_diary_hot).to_lower()
		+ "|assets_hot=" + str(assets_hot).to_lower()
		+ "|pet_hot=" + str(pet_hot).to_lower()
		+ "|crime_hot=" + str(crime_hot).to_lower()
		+ "|pending_hot=" + str(pending_hot).to_lower()
		+ "|crown_hot=" + str(crown_hot).to_lower()
		+ "|support_packet_direct_mount=true"
		+ "|profile_shell_dependency=false"
		+ "|support_packet_requested_after_visible="
		+ str(
			support_packet_requested_after_visible
		).to_lower()
		+ "|atomic_mount="
		+ str(required_surfaces_hot).to_lower()
		+ "|frame_waits=0"
		+ "|engine_calls="
		+ str(
			support_packet_requested_after_visible
		).to_lower()
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(installed_at_ms)
	)
func _install_switched_actor_assets_contract_from_packet(
	target: Person,
	viewer_packet: Dictionary
) -> bool:
	if (
		gs == null
		or target == null
		or viewer_packet.is_empty()
	):
		return false

	var target_id: int = int(target.id)
	var asset_surface_pack: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"asset_surface_pack",
			{}
		)
	)
	var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"surface_contract",
			{}
		)
	)

	if asset_surface_pack.is_empty():
		asset_surface_pack = MainSceneHelpers._safe_dictionary(
			surface_contract.get(
				"asset_surface_pack",
				{}
			)
		)

	var assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack.get(
			"assets_surface_contract",
			viewer_packet.get(
				"assets_surface_contract",
				surface_contract.get(
					"assets_surface_contract",
					{}
				)
			)
		)
	)
	var property_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack.get(
			"property_market_surface_contract",
			viewer_packet.get(
				"property_market_surface_contract",
				surface_contract.get(
					"property_market_surface_contract",
					{}
				)
			)
		)
	)
	var vehicle_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack.get(
			"vehicle_market_surface_contract",
			viewer_packet.get(
				"vehicle_market_surface_contract",
				surface_contract.get(
					"vehicle_market_surface_contract",
					{}
				)
			)
		)
	)
	var vehicle_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack.get(
			"vehicle_market_surface_deck",
			viewer_packet.get(
				"vehicle_market_surface_deck",
				surface_contract.get(
					"vehicle_market_surface_deck",
					{}
				)
			)
		)
	)
	var property_spaces_by_id: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack.get(
			"property_space_surface_contracts_by_id",
			viewer_packet.get(
				"property_space_surface_contracts_by_id",
				surface_contract.get(
					"property_space_surface_contracts_by_id",
					{}
				)
			)
		)
	)
	var pack_hot: bool = (
		int(
			asset_surface_pack.get(
				"actor_id",
				target_id
			)
		) == target_id
		and int(
			assets_contract.get(
				"actor_id",
				-1
			)
		) == target_id
		and int(
			property_contract.get(
				"actor_id",
				-1
			)
		) == target_id
		and int(
			vehicle_contract.get(
				"actor_id",
				-1
			)
		) == target_id
		and not assets_contract.is_empty()
		and not property_contract.is_empty()
		and not vehicle_contract.is_empty()
	)

	if not pack_hot:
		set_meta(
			"switched_actor_assets_contract_missing_from_packet",
			true
		)
		set_meta(
			"switched_actor_assets_contract_missing_actor_id",
			target_id
		)
		set_meta(
			"switched_actor_assets_contract_local_repair_forbidden",
			true
		)
		return false

	_ensure_assets_panel()
	_ensure_property_market_panel()
	_ensure_vehicle_market_panel()

	var property_space_renderer_deck_hot: bool = (
		_prewarm_property_viewer_surface_deck_for_actor(
			target,
			property_spaces_by_id
		)
	)

	asset_surface_pack ["success"] = true
	asset_surface_pack ["actor_id"] = target_id
	asset_surface_pack [
		"assets_surface_contract"
	] = assets_contract.duplicate(true)
	asset_surface_pack [
		"property_market_surface_contract"
	] = property_contract.duplicate(true)
	asset_surface_pack [
		"vehicle_market_surface_contract"
	] = vehicle_contract.duplicate(true)
	asset_surface_pack [
		"vehicle_market_surface_deck"
	] = vehicle_deck.duplicate(true)
	asset_surface_pack [
		"property_space_surface_contracts_by_id"
	] = property_spaces_by_id.duplicate(true)
	asset_surface_pack ["prewarmed"] = true
	asset_surface_pack ["visible_click_work_required"] = false
	asset_surface_pack ["visible_click_work_forbidden"] = true
	asset_surface_pack ["installed_from_switch_packet"] = true

	var cache_key: String = _asset_surface_pack_cache_key(
		target
	)
	asset_surface_pack_by_actor [
		cache_key
	] = asset_surface_pack.duplicate(true)

	_prewarm_vehicle_market_panel_surface_deck(
		target,
		vehicle_deck,
		"switched_actor_packet_vehicle_deck"
	)

	if (
		assets_panel != null
		and is_instance_valid(assets_panel)
	):
		assets_panel.actor = target
		assets_panel.render_surface_contract(
			assets_contract
		)
		assets_panel.visible = false
		assets_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		assets_panel.set_meta(
			"prepainted_before_assets_click",
			true
		)
		assets_panel.set_meta(
			"prepainted_actor_id",
			target_id
		)

	if (
		property_market_panel != null
		and is_instance_valid(property_market_panel)
	):
		property_market_panel.actor = target
		property_market_panel.render_surface_contract(
			property_contract
		)
		property_market_panel.visible = false
		property_market_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		property_market_panel.set_meta(
			"prepainted_before_market_click",
			true
		)
		property_market_panel.set_meta(
			"prepainted_actor_id",
			target_id
		)

	if (
		vehicle_market_panel != null
		and is_instance_valid(vehicle_market_panel)
	):
		vehicle_market_panel.actor = target
		vehicle_market_panel.render_surface_contract(
			vehicle_contract
		)
		vehicle_market_panel.visible = false
		vehicle_market_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		vehicle_market_panel.set_meta(
			"prepainted_before_market_click",
			true
		)
		vehicle_market_panel.set_meta(
			"prepainted_actor_id",
			target_id
		)

	set_meta(
		"asset_surface_deck_hot_actor_id",
		target_id
	)
	set_meta(
		"asset_surface_deck_hot_reason",
		"switched_actor_packet"
	)
	set_meta(
		"asset_surface_click_build_forbidden",
		true
	)
	set_meta(
		"switched_actor_assets_contract_installed",
		true
	)
	set_meta(
		"switched_actor_assets_contract_installed_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_assets_contract_frame_waits",
		0
	)
	set_meta(
		"switched_actor_assets_contract_engine_calls",
		false
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var rollup_by_actor: Dictionary = MainSceneHelpers._safe_dictionary(
			gs.scenario_state.get(
				"resident_asset_rollup_by_actor",
				{}
			)
		)
		rollup_by_actor [str(target_id)] = {
			"property_count": MainSceneHelpers._safe_array(
				assets_contract.get(
					"property_asset_rows",
					[]
				)
			).size(),
			"vehicle_count": MainSceneHelpers._safe_array(
				assets_contract.get(
					"vehicle_asset_rows",
					[]
				)
			).size(),
			"property_space_count": property_spaces_by_id.size(),
			"updated_at_ms": int(
				Time.get_ticks_msec()
			)
		}
		gs.scenario_state [
			"resident_asset_rollup_by_actor"
		] = rollup_by_actor
		gs.scenario_state [
			"switched_actor_assets_contract_pending"
		] = false
		gs.scenario_state [
			"switched_actor_property_space_renderer_deck_hot"
		] = property_space_renderer_deck_hot
		gs.scenario_state [
			"switched_actor_property_space_renderer_deck_actor_id"
		] = target_id
		gs.scenario_state [
			"switched_actor_property_space_renderer_deck_count"
		] = property_spaces_by_id.size()
		gs.scenario_state [
			"switched_actor_property_space_renderer_build_on_click"
		] = false

		set_meta(
			"switched_actor_property_space_renderer_deck_hot",
			property_space_renderer_deck_hot
		)
		set_meta(
			"switched_actor_property_space_renderer_deck_actor_id",
			target_id
		)

	return property_space_renderer_deck_hot
func _schedule_pet_shop_surface_stream_quantum(
	generation: int,
	delay_seconds: float = 0.016
) -> void:
	if generation != pet_shop_surface_stream_generation:
		if (
			pet_shop_surface_stream_armed_generation
			== generation
		):
			pet_shop_surface_stream_service_armed = false
			pet_shop_surface_stream_armed_generation = -1

		return

	if (
		pet_shop_surface_stream_service_armed
		and pet_shop_surface_stream_armed_generation
		!= generation
	):
		pet_shop_surface_stream_service_armed = false
		pet_shop_surface_stream_armed_generation = -1

	if (
		pet_shop_surface_stream_service_armed
		and pet_shop_surface_stream_armed_generation
		== generation
	):
		return

	pet_shop_surface_stream_service_armed = true
	pet_shop_surface_stream_armed_generation = generation

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_pet_shop_surface_stream_quantum",
			generation
		)
		return

	var safe_delay: float = clampf(
		delay_seconds,
		0.016,
		0.25
	)
	var timer:= tree.create_timer(
		safe_delay,
		true,
		false,
		true
	)
	var callback: Callable = Callable(
		self,
		"_service_pet_shop_surface_stream_quantum"
	).bind(
		generation
	)
	var connection_error: int = (
		timer.timeout.connect(
			callback,
			CONNECT_ONE_SHOT
		)
	)

	if connection_error != OK:
		pet_shop_surface_stream_service_armed = false
		pet_shop_surface_stream_armed_generation = -1

		set_meta(
			"pet_shop_surface_stream_timer_connection_failed",
			true
		)
		set_meta(
			"pet_shop_surface_stream_timer_connection_error",
			connection_error
		)
		set_meta(
			"pet_shop_surface_stream_timer_failed_generation",
			generation
		)

		call_deferred(
			"_schedule_pet_shop_surface_stream_quantum",
			generation,
			safe_delay
		)
		return

	if (
		pet_shop_panel != null
		and is_instance_valid(
			pet_shop_panel
		)
	):
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_timer_armed",
			true
		)
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_timer_generation",
			generation
		)
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_timer_armed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

func _pet_shop_surface_stream_grid(
	category_id: String
) -> GridContainer:
	var clean_category_id: String = str(
		category_id
	).strip_edges().to_lower()

	if clean_category_id == "":
		clean_category_id = "companion"

	var existing_raw: Variant = (
		pet_shop_surface_stream_grids.get(
			clean_category_id,
			null
		)
	)

	if existing_raw is GridContainer:
		var existing_grid: GridContainer = (
			existing_raw as GridContainer
		)

		if is_instance_valid(
			existing_grid
		):
			return existing_grid

	if (
		pet_shop_list == null
		or not is_instance_valid(
			pet_shop_list
		)
	):
		return null

	var section_label:= Label.new()
	section_label.text = (
		MainSceneHelpers._pet_shop_listing_category_label(
			clean_category_id
		)
	)
	section_label.add_theme_font_size_override(
		"font_size",
		19
	)
	section_label.add_theme_color_override(
		"font_color",
		Color(
			1.0,
			0.86,
			0.62,
			0.96
		)
	)
	section_label.set_meta(
		"pet_shop_stream_section_label",
		true
	)
	section_label.set_meta(
		"pet_shop_category_id",
		clean_category_id
	)
	pet_shop_list.add_child(
		section_label
	)

	var grid:= GridContainer.new()
	grid.columns = 3
	grid.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	grid.add_theme_constant_override(
		"h_separation",
		14
	)
	grid.add_theme_constant_override(
		"v_separation",
		14
	)
	grid.set_meta(
		"pet_shop_category_id",
		clean_category_id
	)
	grid.set_meta(
		"listing_contracts_precomputed",
		true
	)
	grid.set_meta(
		"one_card_per_timer_quantum",
		true
	)
	pet_shop_list.add_child(
		grid
	)

	pet_shop_surface_stream_grids [
		clean_category_id
	] = grid

	return grid


func _service_pet_shop_surface_stream_quantum(
	generation: int
) -> void:
	if (
		pet_shop_surface_stream_armed_generation
		== generation
	):
		pet_shop_surface_stream_service_armed = false
		pet_shop_surface_stream_armed_generation = -1

	if generation != pet_shop_surface_stream_generation:
		return

	if (
		pet_shop_panel == null
		or not is_instance_valid(
			pet_shop_panel
		)
		or pet_shop_list == null
		or not is_instance_valid(
			pet_shop_list
		)
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)



	if pet_shop_surface_stream_queue.is_empty():
		pet_shop_panel.set_meta(
			"resident_listing_count",
			pet_shop_surface_stream_rendered_count
		)
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_pending",
			false
		)
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_complete",
			true
		)
		pet_shop_panel.set_meta(
			"pet_shop_surface_stream_completed_at_ms",
			now_ms
		)
		pet_shop_panel.set_meta(
			"blank_surface_impossible",
			pet_shop_surface_stream_rendered_count
			> 0
		)

		if (
			pet_shop_status != null
			and is_instance_valid(
				pet_shop_status
			)
		):
			pet_shop_status.text = (
				"%d premium animal contracts are resident."
				% pet_shop_surface_stream_rendered_count
			)

		return

	var job_raw: Variant = (
		pet_shop_surface_stream_queue.pop_front()
	)

	if typeof(job_raw) != TYPE_DICTIONARY:
		_schedule_pet_shop_surface_stream_quantum(
			generation,
			0.016
		)
		return

	var job: Dictionary = (
		job_raw as Dictionary
	)
	var category_id: String = str(
		job.get(
			"category_id",
			"companion"
		)
	)
	var listing_raw: Variant = job.get(
		"listing",
		{}
	)

	if typeof(listing_raw) == TYPE_DICTIONARY:
		var listing: Dictionary = (
			listing_raw as Dictionary
		)
		var grid: GridContainer = (
			_pet_shop_surface_stream_grid(
				category_id
			)
		)

		if (
			grid != null
			and is_instance_valid(
				grid
			)
		):
			_pet_shop_add_listing_card(
				listing,
				grid
			)
			pet_shop_surface_stream_rendered_count += 1

	pet_shop_panel.set_meta(
		"resident_listing_count",
		pet_shop_surface_stream_rendered_count
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_remaining",
		pet_shop_surface_stream_queue.size()
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_last_card_at_ms",
		now_ms
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_pending",
		not pet_shop_surface_stream_queue.is_empty()
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_pointer_motion_can_starve",
		false
	)

	if (
		pet_shop_status != null
		and is_instance_valid(
			pet_shop_status
		)
	):
		pet_shop_status.text = (
			"%d/%d premium animal cards published live."
			% [
				pet_shop_surface_stream_rendered_count,
				pet_shop_surface_stream_target_count
			]
		)

	_schedule_pet_shop_surface_stream_quantum(
		generation,
		0.016
	)
func _render_pet_shop_surface_contract(
	contract: Dictionary,
	actor_id: int,
	preserve_visibility: bool = true
) -> bool:
	if (
		contract.is_empty()
		or actor_id <= 0
		or not bool(
			contract.get(
				"success",
				false
			)
		)
		or int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
		or str(
			contract.get(
				"schema",
				""
			)
		) != "eralife.pet_shop.surface_contract"
	):
		return false

	var listings_raw: Variant = contract.get(
		"listings",
		[]
	)
	var listings: Array = (
		listings_raw as Array
		if typeof(listings_raw) == TYPE_ARRAY
		else []
	)

	if listings.is_empty():
		set_meta(
			"pet_shop_empty_contract_rejected",
			true
		)
		set_meta(
			"pet_shop_empty_contract_rejected_actor_id",
			actor_id
		)
		set_meta(
			"pet_shop_existing_cards_preserved",
			true
		)
		return false

	_ensure_pet_shop_panel()

	if (
		pet_shop_panel == null
		or not is_instance_valid(
			pet_shop_panel
		)
		or pet_shop_list == null
		or not is_instance_valid(
			pet_shop_list
		)
	):
		return false

	var incoming_revision: String = str(
		contract.get(
			"surface_revision",
			contract.get(
				"revision",
				contract.get(
					"created_at_ms",
					""
				)
			)
		)
	).strip_edges()

	if incoming_revision == "":
		incoming_revision = "%d:%s" % [
			actor_id,
			str(
				hash(
					listings
				)
			)
		]

	var same_stream_identity: bool = (
		pet_shop_surface_stream_actor_id == actor_id
		and pet_shop_surface_stream_revision
		== incoming_revision
	)
	var existing_projection_present: bool = (
		pet_shop_surface_stream_rendered_count > 0
		and pet_shop_list.get_child_count() > 0
	)
	var existing_stream_pending: bool = (
		not pet_shop_surface_stream_queue.is_empty()
		or bool(
			pet_shop_panel.get_meta(
				"pet_shop_surface_stream_pending",
				false
			)
		)
	)
	var was_visible: bool = (
		pet_shop_panel.visible
	)
	var previous_mouse_filter: Control.MouseFilter = (
		pet_shop_panel.mouse_filter
	)




	if (
		same_stream_identity
		and (
			existing_projection_present
			or existing_stream_pending
		)
	):
		if (
			existing_stream_pending
			and not pet_shop_surface_stream_service_armed
		):
			_schedule_pet_shop_surface_stream_quantum(
				pet_shop_surface_stream_generation,
				0.016
			)

		pet_shop_panel.set_meta(
			"pet_shop_duplicate_contract_reused",
			true
		)
		pet_shop_panel.set_meta(
			"pet_shop_duplicate_contract_cleared_cards",
			false
		)
		pet_shop_panel.set_meta(
			"pet_shop_duplicate_contract_restarted_generation",
			false
		)

		if preserve_visibility:
			pet_shop_panel.visible = was_visible
			pet_shop_panel.mouse_filter = (
				previous_mouse_filter
			)

		return true

	var stream_queue: Array = []

	for raw_category_id in [
		"companion",
		"working",
		"exotic",
		"mythical"
	]:
		var category_id: String = str(
			raw_category_id
		)

		for raw_listing in listings:
			if typeof(raw_listing) != TYPE_DICTIONARY:
				continue

			var listing: Dictionary = (
				raw_listing as Dictionary
			)

			if listing.is_empty():
				continue

			if (
				_pet_shop_listing_category(
					listing
				) != category_id
			):
				continue

			stream_queue.append({
				"category_id": category_id,
				"listing": listing,
			})

	if stream_queue.is_empty():
		set_meta(
			"pet_shop_card_render_invariant_failed",
			true
		)
		return false

	pet_shop_surface_stream_generation += 1
	pet_shop_surface_stream_service_armed = false
	pet_shop_surface_stream_queue = stream_queue
	pet_shop_surface_stream_grids.clear()
	pet_shop_surface_stream_actor_id = actor_id
	pet_shop_surface_stream_revision = incoming_revision
	pet_shop_surface_stream_target_count = (
		stream_queue.size()
	)
	pet_shop_surface_stream_rendered_count = 0

	_clear_container_children(
		pet_shop_list
	)

	if pet_shop_title != null:
		pet_shop_title.text = str(
			contract.get(
				"title",
				"Pet Shop"
			)
		).to_upper()

	if pet_shop_subtitle != null:
		pet_shop_subtitle.text = str(
			contract.get(
				"subtitle",
				"Premium animal contracts are publishing live."
			)
		)

	if pet_shop_status != null:
		pet_shop_status.text = (
			"Publishing 0/%d premium animal cards live."
			% stream_queue.size()
		)

	pet_shop_panel.set_meta(
		"prepainted_actor_id",
		actor_id
	)
	pet_shop_panel.set_meta(
		"prepainted_surface_revision",
		incoming_revision
	)
	pet_shop_panel.set_meta(
		"prepainted_before_pet_shop_click",
		true
	)
	pet_shop_panel.set_meta(
		"resident_listing_count",
		0
	)
	pet_shop_panel.set_meta(
		"resident_listing_target_count",
		stream_queue.size()
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_pending",
		true
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_complete",
		false
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_generation",
		pet_shop_surface_stream_generation
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_revision",
		incoming_revision
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_one_card_per_quantum",
		true
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_yields_to_clicks",
		true
	)
	pet_shop_panel.set_meta(
		"pet_shop_surface_stream_yields_to_pointer_motion",
		false
	)
	pet_shop_panel.set_meta(
		"pet_shop_duplicate_contract_restart_forbidden",
		true
	)
	pet_shop_panel.set_meta(
		"multi_grid_renderer",
		true
	)
	pet_shop_panel.set_meta(
		"grid_columns",
		3
	)
	pet_shop_panel.set_meta(
		"generic_card_renderer_replaced",
		true
	)
	pet_shop_panel.set_meta(
		"empty_unlabelled_surface_impossible",
		true
	)

	if preserve_visibility:
		pet_shop_panel.visible = was_visible
		pet_shop_panel.mouse_filter = (
			previous_mouse_filter
		)
	else:
		pet_shop_panel.visible = false
		pet_shop_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_schedule_pet_shop_surface_stream_quantum(
		pet_shop_surface_stream_generation,
		0.016
	)

	return true
