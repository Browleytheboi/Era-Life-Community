		rick_weapon_shop_popup_subtitle != null
		and is_instance_valid(
			rick_weapon_shop_popup_subtitle
		)
	):
		rick_weapon_shop_popup_subtitle.text = (
			"Holding %s for checkout."
			% weapon_name
		)

	EraLog.truth(
		(
			"ERALIFE_RICK_HOLD_TRUTH"
			+ "|weapon=%s"
			+ "|full_shop_rebuild=false"
			+ "|engine_call=false"
			+ "|at_ms=%d"
		)
		% [
			weapon_name,
			int(
				Time.get_ticks_msec()
			)
		]
	)


func _rick_weapon_shop_is_rick_busy() -> bool:
