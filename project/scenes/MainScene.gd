			tokens ["text_hover"] = Color(1.0, 0.97, 0.9, 1.0)
			tokens ["text_shadow"] = Color(0.26, 0.16, 0.05, 0.3)
			tokens ["sound_hover_id"] = "ui_nav_ancient_hover"
			tokens ["sound_press_id"] = "ui_nav_ancient_press"
			tokens ["sound_active_id"] = "ui_nav_ancient_active"
		"industrial":
			tokens ["bg"] = Color(0.16, 0.15, 0.14, 0.9)
			tokens ["border"] = Color(0.88, 0.7, 0.38, 0.2)
			tokens ["glow"] = Color(0.94, 0.78, 0.42, 0.05)
			tokens ["glow_size"] = 6.0
			tokens ["text"] = Color(0.96, 0.92, 0.84, 1.0)
			tokens ["text_hover"] = Color(1.0, 0.97, 0.9, 1.0)
			tokens ["text_shadow"] = Color(0.18, 0.14, 0.1, 0.34)
			tokens ["sound_hover_id"] = "ui_nav_industrial_hover"
			tokens ["sound_press_id"] = "ui_nav_industrial_press"
			tokens ["sound_active_id"] = "ui_nav_industrial_active"
		"medieval":
			tokens ["bg"] = Color(0.14, 0.16, 0.19, 0.88)
			tokens ["border"] = Color(0.92, 0.96, 1.0, 0.18)
			tokens ["glow"] = Color(0.88, 0.94, 1.0, 0.03)
			tokens ["glow_size"] = 4.0
			tokens ["text"] = Color(0.94, 0.97, 1.0, 1.0)
			tokens ["text_hover"] = Color(1.0, 1.0, 1.0, 1.0)
			tokens ["text_shadow"] = Color(0.08, 0.1, 0.14, 0.32)
			tokens ["sound_hover_id"] = "ui_nav_medieval_hover"
			tokens ["sound_press_id"] = "ui_nav_medieval_press"
			tokens ["sound_active_id"] = "ui_nav_medieval_active"
		"future":
			tokens ["bg"] = Color(0.08, 0.13, 0.18, 0.88)
			tokens ["border"] = Color(0.62, 0.86, 0.96, 0.16)
			tokens ["glow"] = Color(0.36, 0.96, 1.0, 0.05)
			tokens ["glow_size"] = 6.0
			tokens ["text"] = Color(0.92, 0.99, 1.0, 1.0)
			tokens ["text_hover"] = Color(0.98, 1.0, 1.0, 1.0)
			tokens ["text_shadow"] = Color(0.02, 0.12, 0.16, 0.34)
