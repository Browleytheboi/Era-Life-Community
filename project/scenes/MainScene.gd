func _assert_truth_first_playable_life_shell_frame(reason: String = "truth_first_playable_shell") -> bool:
	if gs == null or gs.player == null:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var snapshot: Dictionary = _truth_first_god_mode_ready_snapshot(reason)
	if snapshot.is_empty():
		set_meta("truth_first_playable_shell_failed_missing_snapshot", true)
		set_meta("truth_first_playable_shell_failed_reason", reason)
		set_meta("truth_first_playable_shell_failed_at_ms", int(Time.get_ticks_msec()))
		return false

	return _compose_god_mode_ready_final_playable_life_shell_frame(
		snapshot.duplicate(true),
		"%s_assert_truth_first" % reason
	)
func _current_first_frame_ui_snapshot() -> Dictionary:
	var meta_raw: Variant = get_meta("first_frame_ui_snapshot", {})
	if typeof(meta_raw) == TYPE_DICTIONARY and not (meta_raw as Dictionary).is_empty():
		return (meta_raw as Dictionary).duplicate(true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var state_raw: Variant = gs.scenario_state.get("first_frame_ui_snapshot", {})
		if typeof(state_raw) == TYPE_DICTIONARY:
			return (state_raw as Dictionary).duplicate(true)

	return {}


