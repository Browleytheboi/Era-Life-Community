	set_meta(
		"institution_tab_click_section",
		clean_section
	)
	set_meta(
		"institution_tab_click_reason",
		reason
	)
	set_meta(
		"institution_tab_click_at_ms",
		now_ms
	)
	set_meta(
		"institution_tab_click_actor_contract_hot",
		actor_contract_hot
	)
	set_meta(
		"institution_tab_click_actor_contract_controls_door",
		true
	)



	if not actor_contract_hot:
		panel.prepare_observable_actor_shell(
			actor_id,
			(
