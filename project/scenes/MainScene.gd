	relationship_profile_popup_actions = actions_cache
	relationship_popup_experience_rows = []
	relationship_popup_money_widgets = []

	var surface_context: Dictionary = (
		_build_player_stat_surface_context(
			target,
			"third_person",
			gs.player
		)
	)
	var stat_rows: Array = [
		{
			"title": "Bond",
			"value": (
				MainSceneLogic._relationship_profile_popup_fast_bond_score(gs, 
					target
				)
			),
			"max": 100
		},
		{
			"title": "Hunger",
