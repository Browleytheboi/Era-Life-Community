func _render_checkpoint_resume_life_diary_packet_only() -> bool:
	if (
		gs == null
		or gs.player == null
		or output_label == null
	):
		return false

	if not _checkpoint_resume_birth_intro_forbidden():
		return false





	var resume_raw: Variant = get_meta(
		"title_card_checkpoint_resume_lens_prewarm_contract",
		{}
	)
	var resume_contract: Dictionary = (
		resume_raw as Dictionary
		if typeof(resume_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		resume_contract.is_empty()
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		var scenario_resume_raw: Variant = gs.scenario_state.get(
			"checkpoint_resume_contract",
			{}
		)
		resume_contract = (
			scenario_resume_raw as Dictionary
			if typeof(scenario_resume_raw) == TYPE_DICTIONARY
			else {}
		)


	var lines: Array = (
		MainSceneHelpers._checkpoint_resume_saved_diary_lines_from_contract(
			resume_contract
		)
	)



	if lines.is_empty():
		var first_frame_raw: Variant = resume_contract.get(
			"first_frame_ui_snapshot",
			{}
		)
		var first_frame: Dictionary = (
			first_frame_raw as Dictionary
			if typeof(first_frame_raw) == TYPE_DICTIONARY
			else {}
		)
		var first_frame_lines_raw: Variant = first_frame.get(
			"life_diary_lines",
			[]
		)

		if typeof(first_frame_lines_raw) == TYPE_ARRAY:
			lines = (
				(first_frame_lines_raw as Array).duplicate(false)
			)



	if lines.is_empty():
		var latest_raw: Variant = resume_contract.get(
			"latest_life_diary_lines",
			[]
		)

		if typeof(latest_raw) == TYPE_ARRAY:
			lines = (
				(latest_raw as Array).duplicate(false)
			)



	if lines.is_empty():
		var cached_lines_raw: Variant = get_meta(
			"life_diary_render_cached_lines",
			[]
		)

		if typeof(cached_lines_raw) == TYPE_ARRAY:
			lines = (
				(cached_lines_raw as Array).duplicate(false)
			)

	var diary_signature: String = (
		_life_diary_render_signature()
	)
	var saved_entries_raw: Variant = resume_contract.get(
		"life_diary_entries",
		[]
	)
	var saved_entry_count: int = (
		(saved_entries_raw as Array).size()
		if typeof(saved_entries_raw) == TYPE_ARRAY
		else 0
	)

	set_meta(
		"checkpoint_resume_diary_loader_called",
		false
	)
	set_meta(
		"checkpoint_resume_birth_intro_builder_called",
		false
	)
	set_meta(
		"checkpoint_resume_diary_birth_lines_filtered",
		false
	)
	set_meta(
		"checkpoint_resume_diary_synthetic_lines_generated",
		false
	)
	set_meta(
		"checkpoint_resume_diary_full_saved_entry_count",
		saved_entry_count
	)
	set_meta(
		"checkpoint_resume_diary_restored_from_immutable_contract",
		true
	)

	output_label.visible = true
	output_label.mouse_filter = (
		Control.MOUSE_FILTER_PASS
	)
	output_label.scroll_active = true
	output_label.bbcode_enabled = true

	_install_life_diary_touchpad_scroll_contract(
		"render_checkpoint_resume_life_diary_packet_only"
	)

	if lines.is_empty():


		set_meta(
			"checkpoint_resume_diary_empty_packet_preserved_observable_truth",
			true
		)
		set_meta(
			"checkpoint_resume_diary_empty_packet_cleared_output",
			false
		)
		return true

	set_meta(
		"life_diary_render_cached_lines",
		lines.duplicate(false)
	)
	set_meta(
		"life_diary_render_cached_signature",
		diary_signature
	)
	output_label.set_meta(
		"life_diary_render_signature",
		diary_signature
	)

	_ui_block(
		lines
	)

	return true
func _defer_spawn_ready_runtime_hud_reveal(reason: String = "spawn_ready") -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.player == null:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if _runtime_interactive_surface_busy(now_ms) or _ui_interaction_grace_active(now_ms):
		var timer:= tree.create_timer(0.35)
		timer.timeout.connect(
			Callable(self, "_defer_spawn_ready_runtime_hud_reveal").bind(reason),
			CONNECT_ONE_SHOT
		)
		return

	_reveal_spawn_ready_runtime_hud_buttons_shell_only(reason)


func _schedule_action_result_post_resolution_reconcile(
	reason: String = "action_result",
	result: Dictionary = {}
) -> void:
	var clean_reason: String = str(
		reason
	).strip_edges()

	if clean_reason == "":
		clean_reason = "action_result"

	set_meta(
		"action_result_post_resolution_reconcile_pending",
		true
	)
	set_meta(
		"action_result_post_resolution_reconcile_reason",
		clean_reason
	)
	set_meta(
		"action_result_post_resolution_reconcile_scheduled_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"action_result_post_resolution_reconcile_payload",
		result.duplicate(false)
	)
	set_meta(
		"action_result_post_resolution_reconcile_surface_teardown_safe",
		true
	)
	set_meta(
		"action_result_post_resolution_reconcile_quiet_window_started",
		false
	)
	set_meta(
		"action_result_post_resolution_reconcile_diary_invalidated_synchronously",
		false
	)

	call_deferred(
		"_run_action_result_post_resolution_reconcile",
		clean_reason,
		0
	)

func _run_action_result_post_resolution_reconcile(
	reason: String = "action_result",
	pass_index: int = 0
) -> void:
	await RenderingServer.frame_post_draw

	if gs == null:
		set_meta(
			"action_result_post_resolution_reconcile_pending",
			false
		)
		return

	var hard_boot_busy: bool = (
		bool(
			get_meta(
				"god_mode_capsule_entry_handoff_active",
				false
			)
		)
		or age_up_loading_runtime_active
		or bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
		or bool(
			get_meta(
				"startup_live_shell_loading",
				false
			)
		)
	)

	if (
		hard_boot_busy
		or action_result_popup_open
		or bool(
			get_meta(
				"renderer_present_fence_active",
				false
			)
		)
	):
		if pass_index < 10:
			call_deferred(
				"_run_action_result_post_resolution_reconcile",
				reason,
				pass_index + 1
			)
			return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var payload_raw: Variant = get_meta(
		"action_result_post_resolution_reconcile_payload",
		{}
	)
	var payload: Dictionary = (
		payload_raw as Dictionary
		if typeof(payload_raw) == TYPE_DICTIONARY
		else {}
	)

	set_meta(
		"action_result_post_resolution_reconcile_pending",
		false
	)
	set_meta(
		"action_result_post_resolution_reconcile_finished_at_ms",
		now_ms
	)
	set_meta(
		"action_result_post_resolution_reconcile_last_reason",
		reason
	)
	set_meta(
		"action_result_post_resolution_reconcile_surface_teardown_safe",
		false
	)
	set_meta(
		"action_result_post_resolution_reconcile_render_only",
		true
	)
	set_meta(
		"action_result_post_resolution_reconcile_sync_updates_forbidden",
		true
	)
	set_meta(
		"action_result_post_resolution_reconcile_opened_life_diary",
		false
	)
	set_meta(
		"action_result_post_resolution_reconcile_refreshed_player_stats",
		false
	)



	set_meta(
		"life_diary_truth_invalidated_for_next_render",
		true
	)
	belongings_hud_content_dirty = true

	if bool(
		payload.get(
			"pet_shop_surface_dirty",
			false
		)
	):
		set_meta(
			"pet_shop_surface_contract_dirty",
			true
		)

	if bool(
		payload.get(
			"red_bonnet_inventory_dirty",
			false
		)
	):
		set_meta(
			"red_bonnet_inventory_surface_dirty",
			true
		)

	if bool(
		payload.get(
			"boxing_hud_dirty",
			false
		)
	):
		set_meta(
			"boxing_hud_surface_dirty",
			true
		)
		set_meta(
			"boxing_hud_surface_dirty_actor_id",
			int(
				payload.get(
					"boxing_actor_id",
					-1
				)
			)
		)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"action_result_post_resolution_reconcile_render_only"
		] = true
		gs.scenario_state [
			"action_result_post_resolution_reconcile_sync_updates_forbidden"
		] = true
		gs.scenario_state [
			"life_diary_truth_invalidated_for_next_render"
		] = true
		gs.scenario_state [
			"action_result_popup_close_forced_diary_render"
		] = false
		gs.scenario_state [
			"action_result_popup_close_forced_hud_refresh"
		] = false

	EraLog.truth(
		"ERALIFE_ACTION_RESULT_RECONCILE_TRUTH"
		+ "|reason=" + reason
		+ "|diary_render=false"
		+ "|hud_refresh=false"
		+ "|tab_refresh=false"
		+ "|truth_marked_dirty=true"
		+ "|at_ms=" + str(now_ms)
	)
func _on_action_result_popup_gui_input(
	event: InputEvent
) -> void:
	if not action_result_popup_open:
		return

	var pet_rename_mode: bool = bool(
		action_result_popup.get_meta(
			"pet_rename_mode",
			false
		)
		if (
			action_result_popup != null
			and is_instance_valid(
				action_result_popup
			)
		)
		else false
	)

	if pet_rename_mode:
		if not (
			event is InputEventKey
			and event.pressed
			and not event.echo
		):
			return

		var key_event: InputEventKey = (
			event as InputEventKey
		)

		var buffer: String = str(
			action_result_popup.get_meta(
				"pet_rename_buffer",
				""
			)
		)

		if key_event.keycode == KEY_BACKSPACE:
			if buffer.length() > 0:
				buffer = buffer.substr(
					0,
					buffer.length() - 1
				)

		elif key_event.keycode in [
			KEY_ENTER,
			KEY_KP_ENTER
		]:
			get_viewport().set_input_as_handled()
			_commit_pet_rename_from_popup_buffer()
			return

		elif key_event.keycode == KEY_ESCAPE:
			get_viewport().set_input_as_handled()
			_finish_pet_rename_keep_original()
			return

		elif (
			key_event.unicode > 0
			and buffer.length() < 32
		):
			var typed_character: String = (
				String.chr(
					key_event.unicode
				)
			)

			if typed_character not in [
				"\n",
				"
",
				"\t"
			]:
				buffer += typed_character

		action_result_popup.set_meta(
			"pet_rename_buffer",
			buffer
		)

		_update_pet_rename_prompt_body()

		get_viewport().set_input_as_handled()
		return

	var choice_count: int = int(
		action_result_popup_choice_context.get(
			"choice_count",
			0
		)
	)

	if choice_count > 0:
		return

	if action_result_popup != null:
		var reality_surge_unlock_ms: int = int(
			action_result_popup.get_meta(
				"reality_surge_input_unlock_ms",
				0
			)
		)

		if reality_surge_unlock_ms > int(
			Time.get_ticks_msec()
		):
			get_viewport().set_input_as_handled()
			return

	var should_dismiss: bool = false

	if event is InputEventMouseButton:
		should_dismiss = (
			event.pressed
			and event.button_index
			== MOUSE_BUTTON_LEFT
		)

	elif event is InputEventScreenTouch:
		should_dismiss = event.pressed

	elif event is InputEventKey:
		should_dismiss = (
			event.pressed
			and not event.echo
		)

	elif event is InputEventJoypadButton:
		should_dismiss = event.pressed

	if not should_dismiss:
		return

	get_viewport().set_input_as_handled()

	var followup: Dictionary = {}

	if (
		typeof(
			pending_action_result_followup
		) == TYPE_DICTIONARY
		and not pending_action_result_followup.is_empty()
	):
		followup = (
			pending_action_result_followup
			.duplicate(false)
		)
		pending_action_result_followup = {}

	_hide_action_result_popup()

	if not followup.is_empty():
		call_deferred(
			"_service_action_result_followup_after_close",
			followup
		)
func _begin_pet_rename_choice_mode(
	choice: Dictionary
) -> void:
	if (
		action_result_popup == null
		or action_result_popup_body == null
		or action_result_popup_choices == null
	):
		return

	var entity_id: String = str(
		choice.get(
			"entity_id",
			""
		)
	).strip_edges()

	var original_name: String = str(
		choice.get(
			"original_name",
			"Companion"
		)
	).strip_edges()

	if entity_id == "":
		return

	action_result_popup.set_meta(
		"pet_rename_mode",
		true
	)
	action_result_popup.set_meta(
		"pet_rename_entity_id",
		entity_id
	)
	action_result_popup.set_meta(
		"pet_rename_original_name",
		original_name
	)
	action_result_popup.set_meta(
		"pet_rename_buffer",
		""
	)

	var rename_choices: Array = [
		{
			"id": "pet_rename_commit",
			"label": "SAVE NEW NAME",
			"detail_action": "pet_rename_commit",
			"entity_id": entity_id
		},
		{
			"id": "pet_keep_name",
			"label": (
				"KEEP %s"
				% original_name.to_upper()
			),
			"detail_action": "pet_keep_name",
			"entity_id": entity_id,
			"original_name": original_name
		}
	]

	action_result_popup_choice_context [
		"choices"
	] = rename_choices
	action_result_popup_choice_context [
		"choice_count"
	] = 2

	for index in range(24):
		var button:= (
			action_result_popup_choices
			.get_node_or_null(
				"ActionResultChoice%02d"
				% index
			) as Button
		)

		if button == null:
			continue

		if index < rename_choices.size():
			var rename_choice: Dictionary = (
				rename_choices [
					index
				] as Dictionary
			)

			button.text = str(
				rename_choice.get(
					"label",
					"Choose"
				)
			)
			button.visible = true
			button.disabled = false
		else:
			button.visible = false
			button.disabled = true

	action_result_popup_choices.visible = true

	if action_result_popup_footer != null:
		action_result_popup_footer.text = (
			"Type the new name, then choose SAVE NEW NAME."
		)

	_update_pet_rename_prompt_body()

	action_result_popup.grab_focus()


func _update_pet_rename_prompt_body() -> void:
	if (
		action_result_popup == null
		or action_result_popup_body == null
		or not bool(
			action_result_popup.get_meta(
				"pet_rename_mode",
				false
			)
		)
	):
		return

	var original_name: String = str(
		action_result_popup.get_meta(
			"pet_rename_original_name",
			"Companion"
		)
	)

	var buffer: String = str(
		action_result_popup.get_meta(
			"pet_rename_buffer",
			""
		)
	)

	action_result_popup_body.text = (
		"Rename %s.\n\nNew name: %s▌"
		% [
			original_name,
			buffer
		]
	)


