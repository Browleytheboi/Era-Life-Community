func _other_country_inject_current_player_country(countries: Array) -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	var push_country:= func (raw_country) -> void:
		var country: String = str(raw_country).strip_edges()
		if country == "":
			return

		var key: String = MainSceneHelpers._other_country_identity_key(country)
		if key == "":
			return
		if seen.has(key):
			return

		out.append(country)
		seen [key] = true

	if gs != null and gs.player != null:
		var player_country: String = str(gs.player.home_country).strip_edges()
		if player_country == "":
			player_country = str(gs.player.birth_country).strip_edges()

		if player_country != "":
			push_country.call(player_country)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var us_realm_id: int = int(gs.scenario_state.get("presidential_parent_contract_us_realm_id", -1))
		if us_realm_id > 0:
			push_country.call("United States")

	for raw_country in countries:
		push_country.call(raw_country)

	return out
func _other_country_contract_special_realm_entry(spec: Dictionary) -> Dictionary:
	var realm_name: String = str(spec.get("name", "Realm")).strip_edges()
	if realm_name == "":
		return {}

	var resolved_realm: Dictionary = _other_country_find_existing_realm_by_name(realm_name)
	if resolved_realm.is_empty():
		return {}

	var realm_id: int = int(resolved_realm.get("realm_id", resolved_realm.get("id", 0)))
	var entry_id: String = str(spec.get("entry_id", "")).strip_edges()
	if entry_id == "":
		entry_id = str(realm_id) if realm_id > 0 else MainSceneHelpers._other_country_identity_key(realm_name)

	return _normalize_other_country_browser_entry({
		"entry_kind": "realm",
		"entry_id": entry_id,
		"name": realm_name,
		"label": realm_name,
		"realm": resolved_realm.duplicate(true),
		"realm_id": realm_id,
		"source": "other_country_contract_special_realm_entry.existing_only",
		"ui_safe": true,
		"contract_status": "satisfied",
		"_sort_priority": int(spec.get("_sort_priority", 8))
	}, "other_country_contract_special_realm_entry.existing_only")
func _other_country_find_existing_realm_by_name(realm_name: String) -> Dictionary:
	if gs == null or not ("realm_engine" in gs) or gs.realm_engine == null:
		return {}

	var clean_name: String = str(realm_name).strip_edges().to_lower()
	if clean_name == "":
		return {}

	if not ("realms" in gs.realm_engine) or typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return {}

	for raw_realm_id in gs.realm_engine.realms.keys():
		var realm: Dictionary = MainSceneLogic._resolve_surface_realm_dict(gs, raw_realm_id)
		if realm.is_empty():
			continue

		var existing_name: String = str(realm.get("name", "")).strip_edges().to_lower()
		if existing_name == clean_name:
			return realm.duplicate(true)

	return {}
func _other_country_browser_current_era_key() -> String:
	var era_key: String = ""

	if gs != null and "era" in gs and gs.era != null:
		if "name" in gs.era:
			era_key = str(gs.era.name).strip_edges()
		else:
			era_key = str(gs.era).strip_edges()

	if era_key == "" and gs != null and "custom_settings" in gs and typeof(gs.custom_settings) == TYPE_DICTIONARY:
		era_key = str(gs.custom_settings.get("era", "")).strip_edges()

	if era_key == "":
		era_key = _selected_era_key()

	return era_key


