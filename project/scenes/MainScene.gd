		lines.append("")
		lines.append("Guide-Light: %s" % str(realm.get("guide_name", ruler_name)))
		lines.append("Realm Nature: %s" % str(realm.get("government_style", "Perception-Bound Mythic Domain")))
		lines.append("Population in Wonder: %s" % _crown_compact_number(float(realm.get("population", 0))))
