func _get_crown_cached_realm_dict(raw_realm_id: Variant) -> Dictionary:
	if gs == null or gs.realm_engine == null:
		return {}

	var realms_raw: Variant = gs.realm_engine.realms
	var realms: Dictionary = realms_raw if typeof(realms_raw) == TYPE_DICTIONARY else {}
	if realms.is_empty():
		return {}

	var raw_key: String = str(raw_realm_id).strip_edges()
	var int_key: int = int(raw_realm_id)
	var realm_raw: Variant = {}

	if realms.has(raw_realm_id):
		realm_raw = realms.get(raw_realm_id, {})
	elif raw_key != "" and realms.has(raw_key):
		realm_raw = realms.get(raw_key, {})
	elif realms.has(int_key):
		realm_raw = realms.get(int_key, {})

	if typeof(realm_raw) != TYPE_DICTIONARY:
		return {}

	return (realm_raw as Dictionary).duplicate(true)


func _sort_crown_diplomacy_country_entries(
	entries: Array
) -> Array:
	var out: Array = entries.duplicate(false)

	out.sort_custom(
		func (
			a: Variant,
			b: Variant
		) -> bool:
			var a_dict: Dictionary = (
				a as Dictionary
				if typeof(a) == TYPE_DICTIONARY
				else {}
			)

			var b_dict: Dictionary = (
				b as Dictionary
				if typeof(b) == TYPE_DICTIONARY
				else {}
			)



			var a_player: bool = bool(
				a_dict.get(
					"is_player_country",
					false
				)
			)

			var b_player: bool = bool(
				b_dict.get(
					"is_player_country",
					false
				)
			)

			if a_player != b_player:
				return a_player

			if crown_hub_diplomacy_sort_key == "population_desc":
				var a_rank: int = int(
					a_dict.get(
						"population_rank",
						0
					)
				)

				var b_rank: int = int(
					b_dict.get(
						"population_rank",
						0
					)
				)

				if (
					a_rank > 0
					and b_rank > 0
					and a_rank != b_rank
				):
					return a_rank < b_rank

				var a_population: int = int(
					a_dict.get(
						"population",
						0
					)
				)

				var b_population: int = int(
					b_dict.get(
						"population",
						0
					)
				)

				if a_population != b_population:
					return (
						a_population
						> b_population
					)

				return str(
					a_dict.get(
						"country",
						""
					)
				).to_lower() < str(
					b_dict.get(
						"country",
						""
					)
				).to_lower()

			var a_era_kingdom: bool = bool(
				a_dict.get(
					"is_era_kingdom",
					false
				)
			)

			var b_era_kingdom: bool = bool(
				b_dict.get(
					"is_era_kingdom",
					false
				)
			)

			if a_era_kingdom != b_era_kingdom:
				return a_era_kingdom

			match crown_hub_diplomacy_sort_key:
				"treasury_desc":
					var a_treasury: int = int(
						a_dict.get(
							"treasury",
							0
						)
					)

					var b_treasury: int = int(
						b_dict.get(
							"treasury",
							0
						)
					)

					if a_treasury != b_treasury:
						return (
							a_treasury
							> b_treasury
						)

				"military_desc":
					var a_military: int = int(
						a_dict.get(
							"military_stockpile",
							0
						)
					)

					var b_military: int = int(
						b_dict.get(
							"military_stockpile",
							0
						)
					)

					if a_military != b_military:
						return (
							a_military
							> b_military
						)

				"relation_desc":
					var a_relation: int = int(
						a_dict.get(
							"relation_score",
							0
						)
					)

					var b_relation: int = int(
						b_dict.get(
							"relation_score",
							0
						)
					)

					if a_relation != b_relation:
						return (
							a_relation
							> b_relation
						)

			return str(
				a_dict.get(
					"country",
					""
				)
			).to_lower() < str(
				b_dict.get(
					"country",
					""
				)
			).to_lower()
	)

	return out
func _sync_crown_diplomacy_population_rank_badge(
