func _bending_hub_actor_for_async_payload(actor_id: int) -> Person:
	var actor: Person = _bending_hub_actor()
	if actor != null and int(actor.id) == actor_id:
		return actor

	if gs != null and gs.has_method("get_or_reactivate_npc_by_id"):
		var resolved: Variant = gs.get_or_reactivate_npc_by_id(actor_id)
		if resolved is Person:
			return resolved as Person

	if gs != null and gs.player != null and int(gs.player.id) == actor_id:
		return gs.player

	return null


func _resolve_bending_hub_tournament_history_payload_deferred(actor_id: int, attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.bending_engine == null:
		set_meta("bending_hub_async_tournament_payload_pending", false)
		return

	var actor: Person = _bending_hub_actor_for_async_payload(actor_id)
	if actor == null:
		set_meta("bending_hub_async_tournament_payload_pending", false)
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if (_runtime_interactive_surface_busy(now_ms) or _ui_interaction_grace_active(now_ms)) and attempt < 18:
		var timer:= tree.create_timer(0.1)
		timer.timeout.connect(
			Callable(self, "_resolve_bending_hub_tournament_history_payload_deferred").bind(actor_id, attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	var payload: Dictionary = gs.bending_engine.get_bending_tournament_history_payload(actor)
	set_meta("bending_hub_async_tournament_payload_pending", false)
	set_meta("bending_hub_async_tournament_payload_kind", "")
	_show_bending_hub_tournament_history_popup(payload)


func _resolve_bending_hub_match_archive_payload_deferred(actor_id: int, attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.bending_engine == null:
