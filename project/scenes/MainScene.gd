func _on_household_creator_back_pressed() -> void:
	if household_creator_created_members.size() > 0:
		_household_creator_show_choice_prompt(
			"Save unfinished household?",
			"You have created at least one household member. Save this unfinished household so you can resume it later?",
			"Save and Leave",
			"Discard",
			Callable(self, "_household_creator_save_unfinished_and_exit"),
			Callable(self, "_household_creator_discard_and_exit")
		)
		return

	if household_creator_world_prewarmed or not household_creator_world_contract.is_empty():
		_household_creator_show_choice_prompt(
			"Leave household creation?",
			"Are you SURE you want to leave? This will terminate the prewarmed household world seed.",
			"Yes, Leave",
			"Stay",
			Callable(self, "_household_creator_discard_and_exit"),
			Callable()
		)
		return

	_hide_household_creator_panel()
	_show_choose_adventure_entry_panel()


func _household_creator_scroll_by(delta: int) -> void:
	if household_creator_scroll == null or not is_instance_valid(household_creator_scroll):
		return

	var bar:= household_creator_scroll.get_v_scroll_bar()
	if bar == null:
		return

	bar.value = clamp(bar.value + float(delta), bar.min_value, bar.max_value)


