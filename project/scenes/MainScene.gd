func _make_relationship_browser_target_button(npc: Person, npc_id: int, section: String) -> Button:
	var btn:= Button.new()
	if npc == null:
		return btn

	var romantic_sections:= [
		"Partner",
		"Boyfriend",
		"Girlfriend",
		"Fiancé",
		"Fiancée",
		"Husband",
		"Wife"
	]

	var prefix:= "✦ "
	if not npc.alive:
		prefix = "✝ "
	elif section in romantic_sections:
		prefix = "♥ "
	elif section == "Parents":
		prefix = "◆ "
	elif section == "Children":
		prefix = "◉ "
	elif section == "Friends":
		prefix = "★ "

	btn.text = prefix + _format_relationship_person(npc)
	btn.alignment = HORIZONTAL_ALIGNMENT_LEFT
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	btn.custom_minimum_size = Vector2(0, 52)
	btn.add_theme_stylebox_override("normal", _build_ui_nav_button_style("normal", 0.18, false))
	btn.add_theme_stylebox_override("hover", _build_ui_nav_button_style("hover", 0.55, false))
	btn.add_theme_stylebox_override("pressed", _build_ui_nav_button_style("pressed", 0.9, false))
	btn.add_theme_stylebox_override("focus", _build_ui_nav_button_style("hover", 0.75, false))
	if not npc.alive:
		btn.add_theme_color_override("font_color", Color(0.82, 0.82, 0.82, 0.92))
	else:
		btn.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))

	btn.pressed.connect(_on_relationship_browser_target_pressed.bind(npc_id))
	return btn
func _on_relationship_browser_action_pressed(action_id: String, preferred_target_id: int = -1) -> void:
	if gs == null:
		return

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "relationship_action",
			"surface_id": "relationship_profile",
			"action_id": action_id,
			"target_id": int(preferred_target_id),
			"legacy_callback": "_on_relationship_browser_action_pressed",
			"legacy_args": [
				action_id,
				preferred_target_id
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_relationship_browser_action_pressed",
				"target_id": int(preferred_target_id)
			},
			"source": "mainscene.relationship_browser_action"
		}, {
			"source": "mainscene.relationship_browser_action",
			"surface_id": "relationship_profile",
			"action_id": action_id,
			"target_id": int(preferred_target_id),
			"legacy_callback": "_on_relationship_browser_action_pressed",
			"legacy_args": [
				action_id,
				preferred_target_id
			]
		})
		return

	var target: Person = _relationship_profile_active_target(preferred_target_id)
	if target == null:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = "No relationship target is currently selected."
		return

	var resolved_target_id: int = int(target.id)
	if not _relationship_profile_try_consume_click("action", action_id, resolved_target_id):
		return

	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
		relationship_profile_popup.set_meta("relationship_profile_target_id", resolved_target_id)

	relationships_browser_selected_id = resolved_target_id

	if not _relationship_profile_action_allowed_for_player_age(action_id, target):
		var locked_result: Dictionary = _relationship_profile_action_locked_result(action_id, target)
		var locked_text: String = str(locked_result.get("text", "")).strip_edges()

		if locked_text != "":
			_append_text_to_diary(locked_text, false)

		_prime_relationship_action_result_handoff(target)

		locked_result ["action_result_popup_must_have_modal_authority"] = true
		locked_result ["relationship_action_result_committed"] = true
		locked_result ["ui_result_lens_deferred"] = true

		call_deferred("_maybe_show_action_result_popup", locked_result.duplicate(true))
		call_deferred("_render_life_diary_panel")
		call_deferred("_scroll_life_diary_to_bottom")
		call_deferred("_update_player_stats_overlay")
		return

	if action_id.begins_with("relationship_contract:"):
		var relationship_contract_result: Dictionary = {}

		if gs.relationship_activities_engine != null and gs.relationship_activities_engine.has_method("resolve_relationship_action"):
			relationship_contract_result = gs.relationship_activities_engine.resolve_relationship_action(gs.player, target, action_id, {
				"source": "relationship_profile_popup",
				"surface": "relationship_profile",
				"return_context": relationship_profile_return_context,
			})
		else:
			relationship_contract_result = {
				"success": false,
				"text": "Relationship activities are not available right now.",
				"popup_title": "Relationship Action",
				"popup_text": "Relationship activities are not available right now.",
				"popup_footer": "Tap anywhere to continue."
			}

		var relationship_contract_text: String = str(relationship_contract_result.get("text", "Done.")).strip_edges()
		if relationship_contract_text == "":
			relationship_contract_text = "Done."

		_append_text_to_diary(relationship_contract_text, false)
		_invalidate_life_diary_contract_render_cache("relationship_contract_action_committed")
		_prime_relationship_action_result_handoff(target)

		set_meta("relationship_action_result_committed_visual_only", true)
		set_meta("relationship_action_result_committed_at_ms", int(Time.get_ticks_msec()))
		set_meta("relationship_action_result_sync_diary_render_forbidden", true)
		set_meta("relationship_action_result_sync_stats_update_forbidden", true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["relationship_action_result_committed_visual_only"] = true
			gs.scenario_state ["relationship_action_result_sync_diary_render_forbidden"] = true
			gs.scenario_state ["relationship_action_result_sync_stats_update_forbidden"] = true

		relationship_contract_result ["action_result_popup_must_have_modal_authority"] = true
		relationship_contract_result ["relationship_action_result_committed"] = true
		relationship_contract_result ["ui_result_lens_deferred"] = true

		call_deferred("_maybe_show_action_result_popup", relationship_contract_result.duplicate(true))

		var open_surface_id: String = str(relationship_contract_result.get("open_surface_id", "")).strip_edges()
		if open_surface_id != "":
			var open_section_id: String = str(relationship_contract_result.get("open_section_id", "")).strip_edges()
			_clear_action_result_relationship_profile_return()
			_hide_relationship_profile_popup()
			call_deferred("_open_contract_surface", open_surface_id, open_section_id)
			return

		if relationship_profile_popup_open and not action_result_popup_open:
			_show_relationship_profile_popup(target)

		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = relationship_contract_text

		_prioritize_relationship_profile_popup_layer()
		return
	if action_id.begins_with("coworker_"):
		var coworker_result: Dictionary = MainSceneLogic._resolve_coworker_profile_action(gs, target, action_id)
		var coworker_text:= str(coworker_result.get("text", "Done."))
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = coworker_text
		_clear_container_children(relationship_profile_popup_actions)
		_inject_relationship_profile_experience(target)
		_populate_relationship_popup_actions(target)
		_update_player_stats_overlay()
		return
	if action_id.begins_with("Use Bending:"):
		var ability_id: String = action_id.replace("Use Bending:", "")
		var bending_result: Dictionary = {}
		if gs.bending_engine != null:
			bending_result = gs.bending_engine.use_bending_ability(gs.player, target, ability_id)
		else:
			bending_result = { "success": false, "text": "The bending engine is not available."}
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = str(bending_result.get("text", "Done."))
		_clear_container_children(relationship_profile_popup_actions)
		_inject_relationship_profile_experience(target)
		_populate_relationship_popup_actions(target)
		_update_player_stats_overlay()
		_update_player_stats_overlay()
		_prime_relationship_action_result_handoff(target)
		_maybe_show_action_result_popup(bending_result)
		return
	var result: Dictionary = {}
	var result_text:= ""
	var relation_label:= _relationship_label_for_target(target)
	var did_switch:= false
	match action_id:
		"switch_to_character":
			_commit_relationship_profile_zero_frame_switch_now(target, "relationship_profile_action_switch_button")
			return
		"compliment":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.compliment(target)
		"converse":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.converse(target)
		"make_love":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.make_love(target)
		"birth_control":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.discuss_birth_control(target)
		"gift":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.gift(target, {
					"name": "Flowers",
					"value": 50
				})
		"give_money":
			_open_relationship_money_popup(target)
			return
		"foreign_romance_write_to_them":
			result = _resolve_foreign_romance_write_to_them(target)
		"insult":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.insult(target)
		"betray":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.betray(target)
		"stage_coup":
			if gs.politics_engine != null:
				result = gs.politics_engine.attempt_coup(gs.player, target)
		"Befriend":
			result = _try_befriend_target(target)
		"Unfriend":
			result = MainSceneLogic._unfriend_target(gs, target)
		"Ask Out":
			if gs.relationship_activities_engine != null:
				result = gs.relationship_activities_engine.ask_out(target)
		"Train Bending":
			if str(target.bending_type) == "none":
				result = { "success": false, "text": "%s cannot bend." % target.first_name}
			elif gs.bending_engine != null:
				result = gs.bending_engine.train_with_teacher(gs.player, target, str(target.bending_type))
			result_text = "I worked with my %s %s on their %s bending." % [
				relation_label,
				target.first_name,
				str(target.bending_type)
			]
		"Challenge To Bending Duel":
			_queue_relationship_bending_duel_scenario(target)
			return
		"Teach Bending":
			if gs.bending_engine != null:
				result = gs.bending_engine.teach_bending(
					gs.player,
					target,
					MainSceneLogic._relationship_popup_default_element_for_player(gs)
				)
		"Grant Bending":
			if not MainSceneLogic._can_avatar_alter_bending(gs):
				result = { "success": false, "text": "You must be at least 12 years old to grant bending."}
			else:
				var grantable:= MainSceneHelpers._grantable_avatar_elements_for_target(target)
				if grantable.is_empty():
					result = { "success": false, "text": "%s already has every base element." % target.first_name}
				elif grantable.size() == 1:
					var only_element:= str(grantable [0])
					if gs.bending_engine != null:
						result = gs.bending_engine.avatar_grant_element(gs.player, target, only_element)
						result_text = "I gave my %s %s %s bending." % [relation_label, target.first_name, only_element]
				else:
					relationship_profile_popup_grant_picker_open = true
					relationship_profile_popup_remove_picker_open = false
					_clear_container_children(relationship_profile_popup_actions)
					_populate_relationship_popup_actions(target)
					if relationship_profile_popup_status != null:
						relationship_profile_popup_status.text = "Choose which element to grant."
					return
		"Cancel Grant Picker":
			relationship_profile_popup_grant_picker_open = false
			_clear_container_children(relationship_profile_popup_actions)
			_populate_relationship_popup_actions(target)
			if relationship_profile_popup_status != null:
				relationship_profile_popup_status.text = ""
			return
		"Remove Bending":
			if not MainSceneLogic._can_avatar_alter_bending(gs):
				result = { "success": false, "text": "You must be at least 12 years old to remove bending."}
			else:
				var removable:= MainSceneHelpers._removable_avatar_elements_for_target(target)
				if removable.is_empty():
					result = { "success": false, "text": "%s has no active bending to remove." % target.first_name}
				elif removable.size() == 1:
					var only_element:= str(removable [0])
					if gs.bending_engine != null:
						result = gs.bending_engine.avatar_remove_element(gs.player, target, only_element)
						result_text = "I removed %s bending from my %s %s." % [
							only_element,
							relation_label,
							target.first_name
						]
				else:
					relationship_profile_popup_remove_picker_open = true
					relationship_profile_popup_grant_picker_open = false
					_clear_container_children(relationship_profile_popup_actions)
					_populate_relationship_popup_actions(target)
					if relationship_profile_popup_status != null:
						relationship_profile_popup_status.text = "Choose which element to remove."
					return
		"Cancel Remove Picker":
			relationship_profile_popup_remove_picker_open = false
			_clear_container_children(relationship_profile_popup_actions)
			_populate_relationship_popup_actions(target)
			if relationship_profile_popup_status != null:
				relationship_profile_popup_status.text = ""
			return
		_:
			if action_id.begins_with("Grant Element:"):
				var element:= action_id.get_slice(":", 1).to_lower()
				if gs.bending_engine != null:
					result = gs.bending_engine.avatar_grant_element(gs.player, target, element)
					result_text = "I gave my %s %s %s bending." % [
						relation_label,
						target.first_name,
						element
					]
			elif action_id.begins_with("Remove Element:"):
				var element_to_remove:= action_id.get_slice(":", 1).to_lower()
				if gs.bending_engine != null:
					result = gs.bending_engine.avatar_remove_element(gs.player, target, element_to_remove)
					result_text = "I removed %s bending from my %s %s." % [
						element_to_remove,
						relation_label,
						target.first_name
					]
			else:
				result = { "success": false, "text": "Unknown action."}

	if result_text == "":
		result_text = str(result.get("text", "Done."))

	relationship_profile_popup_grant_picker_open = false
	relationship_profile_popup_remove_picker_open = false

	if did_switch:
		_commit_relationship_control_switch_to_life_diary(result, result_text)
		return

	_append_text_to_diary(result_text, false)
	_append_text_to_diary(result_text, false)
	_prime_relationship_action_result_handoff(target)

	result ["action_result_popup_must_have_modal_authority"] = true
	result ["relationship_action_result_committed"] = true
	result ["ui_result_lens_deferred"] = true

	call_deferred("_maybe_show_action_result_popup", result.duplicate(true))
	call_deferred("_render_life_diary_panel")
	call_deferred("_scroll_life_diary_to_bottom")
	call_deferred("_update_player_stats_overlay")
	call_deferred("_refresh_relationship_browser_list")

	if relationships_browser_status_label != null:
		relationships_browser_status_label.text = result_text

	if relationship_profile_popup_open and not action_result_popup_open:
		_show_relationship_profile_popup(target)
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = result_text
		_prioritize_relationship_profile_popup_layer()

	return
func _resolve_foreign_romance_write_to_them(target: Person) -> Dictionary:
	if gs == null or gs.player == null or target == null:
		return {
			"success": false,
			"text": "I tried to write to them, but the relationship could not be resolved.",
			"popup_title": "Writing Fling",
			"popup_text": "The writing fling could not be resolved.",
			"popup_footer": "Tap anywhere to continue."
		}

	if not MainSceneLogic._relationship_profile_target_is_foreign_writing_fling(gs, target):
		return {
			"success": false,
			"text": "I could not write to them as a long-distance fling.",
			"popup_title": "Writing Fling",
			"popup_text": "This action is only available for long-distance writing flings in another country.",
			"popup_footer": "Tap anywhere to continue."
		}

	var affection_gain: int = 4
	if gs.relationship_engine != null and gs.relationship_engine.has_method("adjust_relationship"):
		gs.relationship_engine.adjust_relationship(gs.player, target, affection_gain)
	else:
		gs.player.affection [int(target.id)] = clamp(int(gs.player.affection.get(int(target.id), 50)) + affection_gain, 0, 100)
		target.affection [int(gs.player.id)] = clamp(int(target.affection.get(int(gs.player.id), 50)) + affection_gain, 0, 100)

	var diary_text: String = "I wrote to %s in %s, %s and kept our long-distance writing fling alive." % [
		_relationship_display_name(target),
		str(target.home_city),
		str(target.home_country)
	]

	var popup_text: String = "You wrote to %s in %s, %s. The distance still makes everything slower, but the letter kept the spark alive." % [
		_relationship_display_name(target),
		str(target.home_city),
		str(target.home_country)
	]

	var world_text: String = "%s wrote to %s across countries and kept their long-distance writing fling alive." % [
		_relationship_display_name(gs.player),
		_relationship_display_name(target)
	]

	if gs.has_method("push_world_feed"):
		gs.push_world_feed(world_text, {
			"world_text": world_text,
			"player_text": diary_text,
			"npc_id": int(target.id),
			"personally_relevant": true,
			"category": "relationship",
			"event_name": "foreign_romance_writing_fling_letter",
			"source": "relationship_profile_popup"
		})

	return {
		"success": true,
		"text": diary_text,
		"journal_text": diary_text,
		"player_text": diary_text,
		"world_feed_text": world_text,
		"popup_title": "Letter Sent",
		"popup_text": popup_text,
		"popup_footer": "Tap anywhere to continue."
	}
func _stash_life_diary_for_actor(actor_id: int) -> void:
	if actor_id <= 0:
		return

	set_meta(MainSceneHelpers._life_diary_actor_cache_key(actor_id), age_up_diary_entries.duplicate(true))

	var flat_cached_raw: Variant = get_meta("life_diary_render_cached_lines", [])
	if typeof(flat_cached_raw) == TYPE_ARRAY:
		set_meta(MainSceneHelpers._life_diary_actor_flat_cache_key(actor_id), (flat_cached_raw as Array).duplicate(true))


func _restore_life_diary_for_actor(actor: Person, switch_text: String = "") -> void:
	if actor == null:
		return

	var actor_id: int = int(actor.id)
	var cached_raw: Variant = get_meta(MainSceneHelpers._life_diary_actor_cache_key(actor_id), [])

	if typeof(cached_raw) == TYPE_ARRAY and not (cached_raw as Array).is_empty():
		age_up_diary_entries = (cached_raw as Array).duplicate(true)
	else:
		var lines: Array = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(actor.age)
		]

		var name_text: String = MainSceneHelpers._person_display_name_for_identity_switch(actor)
		if switch_text.strip_edges() != "":
			lines.append(switch_text.strip_edges())
		else:
			lines.append("I started living as %s." % name_text)

		lines.append("This life was already in motion before I took control.")
		lines.append("The world feed remains global; this diary is this person's personal lens.")

		age_up_diary_entries = []
		_append_diary_entry(lines)

	_reset_diary_delta_cursors()
	set_meta("life_diary_render_cached_lines", _flatten_life_diary_lines().duplicate(true))
	set_meta("life_diary_render_cached_signature", _life_diary_render_signature())
func _restore_life_diary_for_actor_zero_frame(actor: Person, switch_text: String = "") -> Array:
	var engine:= _ensure_life_diary_contract_engine()
	if engine != null:
		if int(actor.age) <= 0 and not engine.has_diary_for_actor(int(actor.id)):
			engine.ensure_birth_intro_for_actor(actor, {
				"source": "restore_life_diary_for_actor_zero_frame",
			})

		var contract_entries: Array = engine.diary_entries_for_actor(int(actor.id), {
			"source": "restore_life_diary_for_actor_zero_frame"
		})
		var contract_lines: Array = engine.diary_lines_for_actor(int(actor.id), {
			"source": "restore_life_diary_for_actor_zero_frame"
		})

		if not contract_entries.is_empty() and not contract_lines.is_empty():
			age_up_diary_entries = contract_entries.duplicate(true)
			_reset_diary_delta_cursors()
			set_meta(MainSceneHelpers._life_diary_actor_cache_key(int(actor.id)), contract_entries.duplicate(true))
			set_meta(MainSceneHelpers._life_diary_actor_flat_cache_key(int(actor.id)), contract_lines.duplicate(true))
			set_meta("life_diary_render_cached_lines", contract_lines.duplicate(true))
			set_meta("life_diary_render_cached_signature", engine.signature_for_actor(int(actor.id)))
			return contract_lines.duplicate(true)
	if actor == null:
		return []

	var actor_id: int = int(actor.id)

	var cached_entries_raw: Variant = get_meta(MainSceneHelpers._life_diary_actor_cache_key(actor_id), [])
	if typeof(cached_entries_raw) == TYPE_ARRAY and not (cached_entries_raw as Array).is_empty():
		age_up_diary_entries = (cached_entries_raw as Array).duplicate(true)

	var flat_cached_raw: Variant = get_meta(MainSceneHelpers._life_diary_actor_flat_cache_key(actor_id), [])
	var flat_lines: Array = []
	if typeof(flat_cached_raw) == TYPE_ARRAY and not (flat_cached_raw as Array).is_empty():
		flat_lines = (flat_cached_raw as Array).duplicate(true)

	if flat_lines.is_empty():
		var name_text: String = MainSceneHelpers._person_display_name_for_identity_switch(actor)
		var intro_text: String = str(switch_text).strip_edges()
		if intro_text == "":
			intro_text = "I started living as %s." % name_text

		flat_lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(actor.age),
			intro_text,
			"This life was already in motion before I took control.",
			"The world feed remains global; this diary is this person's personal lens."
		]

		age_up_diary_entries = []
		_append_diary_entry(flat_lines)

	_reset_diary_delta_cursors()
	set_meta("life_diary_render_cached_lines", flat_lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", "zero_frame_switch:%d:%d:%d" % [
		actor_id,
		int(gs.year),
		int(actor.age)
	])

	return flat_lines.duplicate(true)
func _close_relationship_modal_stack_for_control_switch() -> void:
	_hide_relationship_profile_popup()
	_hide_relationship_browser()

	if institution_hub_open:
		_hide_institution_hub()

	if institution_hub_overlay != null and is_instance_valid(institution_hub_overlay):
		institution_hub_overlay.visible = false
		institution_hub_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		ui_contract_surface_panel.visible = false
		ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if ui_contract_active_surface_id.strip_edges() == "relationship_contract_hub":
		ui_contract_active_surface_id = ""
		ui_contract_active_section_id = ""

	if nearby_switch_open:
		_close_nearby_switch_popup()

	if world_feed_popup_open:
		_hide_world_action_panel()

	if standard_tab_popup_open:
		_hide_standard_tab_popup()

	if activities_action_open:
		_hide_activities_action_panel()

	_hide_floating_quick_panels()

	current_panel = "life"
	_set_main_gameplay_ui_visible(true)

	if output_label != null and is_instance_valid(output_label):
		output_label.visible = true
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true
func _commit_relationship_control_switch_to_life_diary(result: Dictionary, result_text: String) -> void:
	var clean_text: String = str(result_text).strip_edges()
	if clean_text == "":
		clean_text = str(result.get("text", "I started living as someone else.")).strip_edges()

	var previous_controlled_person_id: int = int(result.get("previous_controlled_person_id", -1))
	if previous_controlled_person_id > 0:
		_stash_life_diary_for_actor(previous_controlled_person_id)

	var grocery_context: Dictionary = _grocery_relationship_profile_context()
	var grocery_context_active: bool = _grocery_relationship_context_should_restore_surface(grocery_context)
	if not grocery_context_active and bool(grocery_context.get("active", false)):
		_clear_grocery_relationship_profile_context("relationship_control_switch_stale_grocery_context")

	_hide_relationship_modal_stack_visual_only_for_zero_frame_switch()

	var surface_lines: Array = []
	if gs != null and gs.player != null:
		surface_lines = _restore_life_diary_for_actor_zero_frame(gs.player, clean_text)
	else:
		_append_text_to_diary(clean_text, false)
		surface_lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: 0",
			clean_text
		]

	_apply_zero_frame_consciousness_switch_surface(result, clean_text, surface_lines)

	belongings_hud_content_dirty = false

	var now_ms: int = int(Time.get_ticks_msec())
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["relationship_control_switch_committed_to_life_diary"] = true
		gs.scenario_state ["relationship_control_switch_committed_at_ms"] = now_ms
		gs.scenario_state ["relationship_control_switch_text"] = clean_text
		gs.scenario_state ["relationship_control_switch_preserved_grocery_store"] = grocery_context_active
		gs.scenario_state ["zero_frame_consciousness_switch_visible_handoff_complete"] = true
		gs.scenario_state ["zero_frame_consciousness_switch_visible_handoff_ms"] = now_ms
		gs.scenario_state ["zero_frame_consciousness_switch_no_heavy_rebuild_on_press"] = true
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_active"] = true
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_actor_id"] = int(gs.player.id) if gs.player != null else -1
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_until_ms"] = now_ms + 3500
		gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_pending"] = false
		gs.scenario_state ["zero_frame_consciousness_switch_full_refresh_stage"] = 0
		gs.scenario_state.erase("zero_frame_consciousness_switch_full_refresh_next_ms")

	if grocery_context_active:
		call_deferred(
			"_finish_relationship_control_switch_grocery_restore_deferred",
			grocery_context.duplicate(true),
			previous_controlled_person_id
		)

	_zero_frame_consciousness_switch_background_refresh(result.duplicate(true))


	call_deferred("_close_relationship_modal_stack_for_control_switch")
	call_deferred("_scroll_life_diary_to_bottom")
func _apply_zero_frame_consciousness_switch_surface(result: Dictionary, clean_text: String = "", surface_lines: Array = []) -> void:
	if gs == null or gs.player == null:
		return

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(result.get("surface_contract", {}))
	if surface.is_empty() and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		surface = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("zero_frame_consciousness_switch_surface", {}))

	var actor: Person = gs.player
	var actor_name: String = str(surface.get("actor_name", MainSceneHelpers._person_display_name_for_identity_switch(actor))).strip_edges()
	if actor_name == "":
		actor_name = MainSceneHelpers._person_display_name_for_identity_switch(actor)

	if output_label != null and is_instance_valid(output_label):
		output_label.visible = true
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

		var visible_lines: Array = surface_lines.duplicate(true)
		if visible_lines.is_empty():
			var cached_lines_raw: Variant = get_meta("life_diary_render_cached_lines", [])
			visible_lines = cached_lines_raw if typeof(cached_lines_raw) == TYPE_ARRAY else []

		if not visible_lines.is_empty():
			output_label.set_meta("life_diary_render_signature", str(get_meta("life_diary_render_cached_signature", "")))
			_ui_block(visible_lines.duplicate(true))
		elif clean_text.strip_edges() != "":
			_ui_block([
				"Year: %s" % _format_year(gs.year),
				"Age: %d" % int(actor.age),
				clean_text.strip_edges(),
				"This life was already in motion before I took control.",
				"The world feed remains global; this diary is this person's personal lens."
			])
	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		if bool(surface.get("playable_life_viewer_packet_consumed", false)):
			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["zero_frame_switch_overlay_missing_but_build_forbidden"] = true
				gs.scenario_state ["zero_frame_switch_overlay_missing_actor_id"] = int(gs.player.id)
				gs.scenario_state ["zero_frame_switch_overlay_missing_at_ms"] = int(Time.get_ticks_msec())
			return

		call_deferred("_update_player_stats_overlay")
		_apply_zero_frame_consciousness_switch_hud_surface(surface, "zero_frame_switch_overlay_missing_deferred")
		return

	player_stats_overlay.visible = true
	player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var overlay_title:= player_stats_root.get_node_or_null("TitleLabel") as Label
	if overlay_title != null:
		overlay_title.text = actor_name

	var bank_balance: int = max(0, int(surface.get("bank_balance", actor.bank_balance)))
	player_stats_bank_target = float(bank_balance)
	player_stats_bank_display_value = float(bank_balance)
	player_stats_overlay.set_meta("player_stats_bank_actor_id", int(actor.id))

	if player_stats_bank_label != null:
		player_stats_bank_label.text = _format_player_stats_bank_amount(bank_balance)

	if pending_situations_button != null and is_instance_valid(pending_situations_button):
		var pending_count: int = int(surface.get("pending_situations_count", 0))
		pending_situations_button.visible = true
		pending_situations_button.disabled = false
		pending_situations_button.mouse_filter = Control.MOUSE_FILTER_STOP
		pending_situations_button.text = "Pending Situations (%d)" % pending_count
		pending_situations_button.tooltip_text = "No unresolved situations right now." if pending_count <= 0 else "%d unresolved situations are waiting for %s." % [pending_count, actor_name]

	var viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(result.get("playable_life_viewer_render_packet", {}))
	var player_stats_packet: Dictionary = MainSceneHelpers._safe_dictionary(viewer_packet.get("player_stats_packet", {}))
	var surface_context: Dictionary = MainSceneHelpers._safe_dictionary(player_stats_packet.get("surface_context", surface.get("player_stats_surface_context", surface.get("surface_context", {}))))
	if surface_context.is_empty():
		if bool(surface.get("prewarmed_playable_life_shell", false)) or bool(surface.get("press_frame_commit", false)):
			surface_context = _relationship_profile_fast_player_stat_surface_context(actor)
		else:
			surface_context = _build_player_stat_surface_context(actor)

	var health_value: int = max(0, int(player_stats_packet.get("health", surface.get("health", int(actor.health)))))
	var hunger_value: int = max(0, int(player_stats_packet.get("hunger", surface.get("hunger", _player_stats_hunger_value(actor)))))
	var mental_value: int = max(0, int(player_stats_packet.get("mental_health", surface.get("mental_health", int(actor.mental_health)))))
	var willpower_value: int = max(0, int(player_stats_packet.get("willpower", surface.get("willpower", _bending_hub_willpower_value(actor)))))
	var happiness_value: int = max(0, int(player_stats_packet.get("happiness", surface.get("happiness", int(actor.satisfaction)))))
	var smarts_value: int = max(0, int(player_stats_packet.get("smarts", surface.get("smarts", int(actor.smarts)))))
	var looks_value: int = max(0, int(player_stats_packet.get("looks", surface.get("looks", int(actor.looks)))))
	var imagination_value: int = max(0, int(player_stats_packet.get("imagination", surface.get("imagination", int(actor.imagination)))))
	var fame_value: int = max(0, int(player_stats_packet.get("fame", surface.get("fame", int(actor.fame)))))
	var approval_value: int = clamp(int(player_stats_packet.get("approval", surface.get("approval", int(actor.approval)))), 0, 100)

	player_stats_health_target = float(health_value)
	player_stats_hunger_target = float(hunger_value)
	player_stats_mental_target = float(mental_value)
	player_stats_willpower_target = float(willpower_value)
	player_stats_happiness_target = float(happiness_value)
	player_stats_smarts_target = float(smarts_value)
	player_stats_looks_target = float(looks_value)
	player_stats_imagination_target = float(imagination_value)
	player_stats_fame_target = float(fame_value)

	if player_stats_health_label != null and player_stats_health_bar != null:
		_apply_player_stat_surface_content(player_stats_health_label, player_stats_health_bar, "Health", health_value, MainSceneHelpers._health_base_display_max(health_value), surface_context)
	if player_stats_hunger_label != null and player_stats_hunger_bar != null:
		_apply_player_stat_surface_content(player_stats_hunger_label, player_stats_hunger_bar, "Hunger", hunger_value, 100, surface_context)
	if player_stats_mental_label != null and player_stats_mental_bar != null:
		_apply_player_stat_surface_content(player_stats_mental_label, player_stats_mental_bar, "Mental", mental_value, max(100, mental_value), surface_context)
	if player_stats_willpower_label != null and player_stats_willpower_bar != null:
		_apply_player_stat_surface_content(player_stats_willpower_label, player_stats_willpower_bar, "Willpower", willpower_value, max(150, willpower_value), surface_context)
	if player_stats_happiness_label != null and player_stats_happiness_bar != null:
		_apply_player_stat_surface_content(player_stats_happiness_label, player_stats_happiness_bar, "Happiness", happiness_value, max(100, happiness_value), surface_context)
	if player_stats_smarts_label != null and player_stats_smarts_bar != null:
		_apply_player_stat_surface_content(player_stats_smarts_label, player_stats_smarts_bar, "Smarts", smarts_value, max(100, smarts_value), surface_context)
	if player_stats_looks_label != null and player_stats_looks_bar != null:
		_apply_player_stat_surface_content(player_stats_looks_label, player_stats_looks_bar, "Looks", looks_value, max(100, looks_value), surface_context)
	if player_stats_imagination_label != null and player_stats_imagination_bar != null:
		_apply_player_stat_surface_content(player_stats_imagination_label, player_stats_imagination_bar, "Imagination", imagination_value, max(100, imagination_value), surface_context)

	if player_stats_fame_row != null:
		player_stats_fame_row.visible = fame_value > 0
	if fame_value > 0 and player_stats_fame_label != null and player_stats_fame_bar != null:
		_apply_player_stat_surface_content(player_stats_fame_label, player_stats_fame_bar, "Fame", fame_value, max(100, fame_value), surface_context)

	var approval_widgets: Dictionary = _get_player_stats_approval_widgets()
	var approval_row: Control = approval_widgets.get("row", null) as Control
	var approval_label: Label = approval_widgets.get("label", null) as Label
	var approval_bar: ProgressBar = approval_widgets.get("bar", null) as ProgressBar
	var show_approval: bool = MainSceneLogic._player_has_meaningful_approval(actor)

	if approval_row != null:
		approval_row.visible = show_approval
	if approval_label != null:
		approval_label.visible = show_approval
	if approval_bar != null:
		approval_bar.visible = show_approval
	if show_approval and approval_label != null and approval_bar != null:
		_apply_player_stat_surface_content(approval_label, approval_bar, "Approval", approval_value, 100, surface_context)
	_apply_zero_frame_consciousness_switch_hud_surface(surface, "zero_frame_consciousness_switch_surface")
	_apply_player_stats_overlay_visual_state(player_stats_overlay_hovered)

func _apply_zero_frame_consciousness_switch_hud_surface(surface: Dictionary, reason: String = "zero_frame_consciousness_switch_surface") -> void:
	if gs == null or gs.player == null:
		return

	var hud_truth: Dictionary = MainSceneHelpers._safe_dictionary(surface.get("hud_truth", {}))

	if hud_truth.is_empty() and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var runtime_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("runtime_hud_visibility_snapshot", {}))
		hud_truth = {
			"belongings_available": bool(runtime_snapshot.get("belongings_available", runtime_snapshot.get("belongings_button_visible", true))),
			"bending_available": bool(runtime_snapshot.get("bending_available", runtime_snapshot.get("bending_button_visible", false))),
			"crown_available": bool(runtime_snapshot.get("crown_available", runtime_snapshot.get("crown_button_visible", false))),
			"food_lifestyle_available": bool(runtime_snapshot.get("food_lifestyle_available", runtime_snapshot.get("food_lifestyle_button_visible", false))),
			"restaurant_lifestyle_available": bool(runtime_snapshot.get("restaurant_lifestyle_available", runtime_snapshot.get("restaurant_lifestyle_button_visible", false))),
			"rick_weapon_shop_available": bool(runtime_snapshot.get("rick_weapon_shop_available", runtime_snapshot.get("rick_weapon_shop_button_visible", false))),
			"boxing_available": bool(runtime_snapshot.get("boxing_available", runtime_snapshot.get("boxing_button_visible", false))),
			"superhero_available": bool(runtime_snapshot.get("superhero_available", runtime_snapshot.get("superpower_available", false))),
			"superpower_available": bool(runtime_snapshot.get("superpower_available", runtime_snapshot.get("superhero_available", false))),
			"power_available": bool(runtime_snapshot.get("power_available", runtime_snapshot.get("power_button_visible", false))),
			"wizard_available": bool(runtime_snapshot.get("wizard_available", runtime_snapshot.get("wizard_button_visible", false)))
		}

	var show_belongings: bool = bool(hud_truth.get("belongings_available", hud_truth.get("belongings", true)))
	var show_bending: bool = bool(hud_truth.get("bending_available", hud_truth.get("bending", false)))
	var show_crown: bool = bool(hud_truth.get("crown_available", hud_truth.get("crown", false)))
	var show_food: bool = bool(hud_truth.get("food_lifestyle_available", hud_truth.get("grocery_store_available", false)))
	var show_restaurant: bool = bool(hud_truth.get("restaurant_lifestyle_available", hud_truth.get("restaurant_available", false)))
	var show_rick: bool = bool(hud_truth.get("rick_weapon_shop_available", false))
	var show_boxing: bool = bool(hud_truth.get("boxing_available", hud_truth.get("boxing", false)))
	var show_superhero: bool = bool(hud_truth.get("superhero_available", hud_truth.get("superhero", false)))
	var show_superpower: bool = bool(hud_truth.get("superpower_available", hud_truth.get("superpower", show_superhero)))
	var show_power: bool = bool(hud_truth.get("power_available", hud_truth.get("power", false)))
	var show_wizard: bool = bool(hud_truth.get("wizard_available", hud_truth.get("wizard", false)))

	var hud_shell_prewarmed: bool = bool(surface.get("runtime_hud_shell_prewarmed", false)) or bool(surface.get("prewarmed_playable_life_shell", false))
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		hud_shell_prewarmed = hud_shell_prewarmed or bool(gs.scenario_state.get("relationship_profile_zero_frame_runtime_hud_shell_prewarmed", false))

	if not hud_shell_prewarmed:
		call_deferred("_relationship_profile_prewarm_runtime_hud_shells_for_truth", hud_truth.duplicate(true), "%s_deferred_shell_missing" % reason)

	_apply_zero_frame_hud_button_shell(belongings_hud_button, show_belongings)
	_apply_zero_frame_hud_button_shell(bending_hud_button, show_bending)
	_apply_zero_frame_hud_button_shell(crown_hud_button, show_crown)
	_apply_zero_frame_hud_button_shell(food_lifestyle_hud_button, show_food)
	_apply_zero_frame_hud_button_shell(restaurant_lifestyle_hud_button, show_restaurant)
	_apply_zero_frame_hud_button_shell(rick_weapon_shop_hud_button, show_rick)
	_apply_zero_frame_hud_button_shell(boxing_hud_button, show_boxing)
	_apply_zero_frame_hud_button_shell(superpower_hud_button, show_superpower or show_superhero)
	_apply_zero_frame_hud_button_shell(power_hud_button, show_power)
	_apply_zero_frame_hud_button_shell(wizard_hud_button, show_wizard)

	if bending_hud_button != null and is_instance_valid(bending_hud_button) and show_bending:
		bending_hud_button.text = _bending_hud_button_icon()

	if rick_weapon_shop_hud_button != null and is_instance_valid(rick_weapon_shop_hud_button) and show_rick:
		MainSceneLogic._style_rick_weapon_shop_button(rick_weapon_shop_hud_button, 0.5)




	_sync_runtime_floating_hud_layering_for_spawn_shell(
		"%s_immediate_actor_stack" % reason
	)
	call_deferred(
		"_sync_runtime_floating_hud_layering_for_spawn_shell",
		"%s_deferred_actor_stack_geometry" % reason
	)

	_refresh_existing_activities_actor_affordances(
		activities_action_panel,
		"%s_actor_affordance_retarget" % reason
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var runtime_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("runtime_hud_visibility_snapshot", {}))

		runtime_snapshot ["player_id"] = int(gs.player.id)
		runtime_snapshot ["controlled_actor_id"] = int(gs.player.id)
		runtime_snapshot ["controlled_actor_name"] = MainSceneHelpers._person_display_name_for_identity_switch(gs.player)
		runtime_snapshot ["current_panel"] = "life"

		runtime_snapshot ["belongings_available"] = show_belongings
		runtime_snapshot ["belongings_button_visible"] = show_belongings
		runtime_snapshot ["bending_available"] = show_bending
		runtime_snapshot ["bending_button_visible"] = show_bending
		runtime_snapshot ["crown_available"] = show_crown
		runtime_snapshot ["crown_button_visible"] = show_crown
		runtime_snapshot ["food_lifestyle_available"] = show_food
		runtime_snapshot ["food_lifestyle_button_visible"] = show_food
		runtime_snapshot ["restaurant_lifestyle_available"] = show_restaurant
		runtime_snapshot ["restaurant_lifestyle_button_visible"] = show_restaurant
		runtime_snapshot ["rick_weapon_shop_available"] = show_rick
		runtime_snapshot ["rick_weapon_shop_button_visible"] = show_rick
		runtime_snapshot ["boxing_available"] = show_boxing
		runtime_snapshot ["boxing_button_visible"] = show_boxing
		runtime_snapshot ["superhero_available"] = show_superhero
		runtime_snapshot ["superpower_available"] = show_superpower or show_superhero
		runtime_snapshot ["superpower_button_visible"] = show_superpower or show_superhero
		runtime_snapshot ["power_available"] = show_power
		runtime_snapshot ["power_button_visible"] = show_power
		runtime_snapshot ["wizard_available"] = show_wizard
		runtime_snapshot ["wizard_button_visible"] = show_wizard

		runtime_snapshot ["shell_only"] = false
		runtime_snapshot ["zero_frame_switch_truth"] = true
		runtime_snapshot ["zero_frame_switch_surface_locked"] = true
		runtime_snapshot ["reason"] = reason
		runtime_snapshot ["updated_at_ms"] = int(Time.get_ticks_msec())

		gs.scenario_state ["runtime_hud_visibility_snapshot"] = runtime_snapshot
		gs.scenario_state ["runtime_hud_visibility_snapshot_reason"] = reason
		gs.scenario_state ["runtime_hud_visibility_snapshot_at_ms"] = int(Time.get_ticks_msec())
func _apply_zero_frame_hud_button_shell(
	button: Button,
	should_show: bool
) -> void:
	if (
		button == null
		or not is_instance_valid(
			button
		)
	):
		return

	var effective_should_show: bool = (
		should_show
	)
	var crown_readiness_gate_applied: bool = false
	var crown_readiness: Dictionary = {}



	if (
		button == bending_hud_button
		and not MainSceneLogic._bending_feature_enabled_by_reality_contract(gs)
	):
		effective_should_show = false





	if button == crown_hud_button:
		crown_readiness_gate_applied = true
		crown_readiness = (
			_crown_hud_actor_scoped_readiness_truth()
		)
		effective_should_show = (
			should_show
			and bool(
				crown_readiness.get(
					"button_visible_allowed",
					false
				)
			)
		)

	button.visible = effective_should_show
	button.disabled = not effective_should_show
	button.mouse_filter = (
		Control.MOUSE_FILTER_STOP
		if effective_should_show
		else Control.MOUSE_FILTER_IGNORE
	)
	button.focus_mode = Control.FOCUS_NONE
	button.modulate = Color(
		1.0,
		1.0,
		1.0,
		(
			1.0
			if effective_should_show
			else 0.0
		)
	)

	if effective_should_show:
		_apply_runtime_floating_hud_button_visual_contract(
			button
		)
	else:
		button.scale = Vector2.ONE

	button.set_meta(
		"zero_frame_switch_shell_applied",
		true
	)
	button.set_meta(
		"zero_frame_switch_shell_requested_show",
		should_show
	)
	button.set_meta(
		"zero_frame_switch_shell_should_show",
		effective_should_show
	)
	button.set_meta(
		"zero_frame_switch_shell_not_applicable_hidden",
		not effective_should_show
	)
	button.set_meta(
		"zero_frame_switch_shell_hidden_without_hitbox",
		not effective_should_show
	)
	button.set_meta(
		"zero_frame_switch_shell_requires_canonical_stack_slot",
		effective_should_show
	)
	button.set_meta(
		"zero_frame_switch_shell_explicit_feature_contract_applied",
		button == bending_hud_button
	)
	button.set_meta(
		"zero_frame_switch_shell_crown_readiness_gate_applied",
		crown_readiness_gate_applied
	)
	button.set_meta(
		"zero_frame_switch_shell_crown_surface_ready",
		bool(
			crown_readiness.get(
				"surface_ready",
				false
			)
		)
		if crown_readiness_gate_applied
		else false
	)
	button.set_meta(
		"zero_frame_switch_shell_crown_generic_presence_override_rejected",
		(
			crown_readiness_gate_applied
			and should_show
			and not effective_should_show
		)
	)
	button.set_meta(
		"zero_frame_switch_shell_applied_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _zero_frame_switch_surface_lock_active(now_ms: int = -1) -> bool:
	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	if not bool(gs.scenario_state.get("zero_frame_consciousness_switch_surface_lock_active", false)):
		return false

	var lock_until_ms: int = int(gs.scenario_state.get("zero_frame_consciousness_switch_surface_lock_until_ms", 0))
	if lock_until_ms <= 0 or check_ms >= lock_until_ms:
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_active"] = false
		gs.scenario_state.erase("zero_frame_consciousness_switch_surface_lock_until_ms")
		return false

	if gs.player != null:
		var locked_actor_id: int = int(gs.scenario_state.get("zero_frame_consciousness_switch_surface_lock_actor_id", -1))
		if locked_actor_id > 0 and locked_actor_id != int(gs.player.id):
			gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_active"] = false
			gs.scenario_state.erase("zero_frame_consciousness_switch_surface_lock_until_ms")
			return false

	return true


func _refresh_locked_zero_frame_switch_surface(reason: String = "zero_frame_switch_surface_lock") -> void:
	if not _zero_frame_switch_surface_lock_active():
		return

	var surface: Dictionary = MainSceneLogic._locked_zero_frame_switch_surface(gs)
	if surface.is_empty():
		return

	_apply_zero_frame_consciousness_switch_surface({
		"surface_contract": surface.duplicate(true),
		"zero_frame_consciousness_switch": true,
		"source": reason
	}, "", [])
func _zero_frame_consciousness_switch_background_refresh(
	_result: Dictionary
) -> void:
	if gs == null or gs.player == null:
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var actor_id: int = int(
		gs.player.id
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"zero_frame_consciousness_switch_background_refresh_queued"
	] = true
	gs.scenario_state [
		"zero_frame_consciousness_switch_background_refresh_ms"
	] = now_ms
	gs.scenario_state [
		"zero_frame_consciousness_switch_tail_pending"
	] = true
	gs.scenario_state [
		"zero_frame_consciousness_switch_full_refresh_pending"
	] = false
	gs.scenario_state [
		"zero_frame_consciousness_switch_full_refresh_stage"
	] = 0
	gs.scenario_state.erase(
		"zero_frame_consciousness_switch_full_refresh_next_ms"
	)



	gs.scenario_state [
		"zero_frame_consciousness_switch_surface_lock_active"
	] = false
	gs.scenario_state [
		"zero_frame_consciousness_switch_surface_lock_actor_id"
	] = actor_id
	gs.scenario_state [
		"zero_frame_consciousness_switch_surface_lock_until_ms"
	] = now_ms
	gs.scenario_state [
		"zero_frame_consciousness_switch_interaction_released"
	] = true
	gs.scenario_state [
		"zero_frame_consciousness_switch_interaction_released_at_ms"
	] = now_ms

	var guard_raw: Variant = (
		gs.scenario_state.get(
			"runtime_guard",
			{}
		)
	)
	var guard: Dictionary = (
		guard_raw
		if typeof(guard_raw) == TYPE_DICTIONARY
		else {}
	)

	guard ["zero_frame_consciousness_switch"] = true
	guard ["switch_visible_handoff_complete"] = true
	guard ["switch_surface_lock_active"] = false
	guard ["switch_surface_lock_until_ms"] = now_ms
	guard ["defer_full_hud_rebuild"] = false
	guard ["defer_full_life_diary_rebuild"] = false
	guard ["ui_tail_work_yield_to_input"] = true
	guard ["interactive_input_has_absolute_priority"] = true
	guard ["switch_interaction_released"] = true
	guard ["switch_interaction_released_actor_id"] = actor_id
	guard ["last_action"] = (
		"release_zero_frame_switch_surface_after_visible_handoff"
	)
	guard ["last_action_ms"] = now_ms

	gs.scenario_state [
		"runtime_guard"
	] = guard

	set_meta(
		"zero_frame_consciousness_switch_surface_lock_active",
		false
	)
	set_meta(
		"zero_frame_consciousness_switch_surface_lock_until_ms",
		now_ms
	)
	set_meta(
		"zero_frame_consciousness_switch_interaction_released",
		true
	)
	set_meta(
		"zero_frame_consciousness_switch_interaction_released_actor_id",
		actor_id
	)
	set_meta(
		"zero_frame_consciousness_switch_interaction_released_at_ms",
		now_ms
	)



	_sync_runtime_floating_hud_layering()

	EraLog.truth(
		"ERALIFE_SWITCH_INTERACTION_RELEASE_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|surface_lock=false"
		+ "|hud_geometry_authority=runtime_floating_stack"
		+ "|full_hud_rebuild=false"
		+ "|full_diary_rebuild=false"
		+ "|input_released=true"
		+ "|at_ms=" + str(now_ms)
	)
func _finish_relationship_control_switch_grocery_restore_deferred(grocery_context: Dictionary, previous_controlled_person_id: int) -> void:
	if gs == null:
		return
	if gs.player == null:
		return
	if gs.grocery_store_engine == null:
		return

	var grocery_store_id: String = str(grocery_context.get("store_id", "")).strip_edges()
	var grocery_aisle_id: String = str(grocery_context.get("aisle_id", "")).strip_edges()
	if grocery_store_id == "":
		return

	if previous_controlled_person_id > 0 and gs.grocery_store_engine.has_method("anchor_control_switch_origin_actor_in_grocery_store"):
		gs.grocery_store_engine.anchor_control_switch_origin_actor_in_grocery_store(previous_controlled_person_id, grocery_store_id, grocery_aisle_id, {
			"source": "relationship_control_switch_inside_grocery_store_deferred",
			"controlled_person_id": int(gs.player.id),
			"linger_ms": 45000
		})

	if gs.grocery_store_engine.has_method("transfer_grocery_shopper_cart_to_actor"):
		gs.grocery_store_engine.transfer_grocery_shopper_cart_to_actor(gs.player, grocery_store_id, grocery_aisle_id, {
			"source": "relationship_control_switch_inside_grocery_store_deferred",
			"previous_controlled_person_id": previous_controlled_person_id,
			"controlled_person_id": int(gs.player.id)
		})

	_start_grocery_store_music(grocery_store_id, "relationship_control_switch_preserve_grocery_music")
	_restore_grocery_surface_from_relationship_context("relationship_control_switch_deferred")

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["relationship_control_switch_grocery_restore_finished_at_ms"] = int(Time.get_ticks_msec())


