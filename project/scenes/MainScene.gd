func _open_career_job_overview_from_browser(job_kind: String, job_name: String) -> void:
	var clean_job_kind: String = str(job_kind).strip_edges()
	var clean_job_name: String = str(job_name).strip_edges()
	if clean_job_name == "":
		_maybe_show_action_result_popup({
			"popup_title": "Career Browser",
			"popup_text": "That career could not be opened because its job name was empty.",
			"popup_footer": "Tap anywhere to continue."
		})
		return
	_show_career_job_overview(clean_job_kind, clean_job_name)

func _apply_career_job_from_overview(job_kind: String, job_name: String) -> void:
	var clean_job_kind: String = str(job_kind).strip_edges()
	var clean_job_name: String = str(job_name).strip_edges()

	if clean_job_name == "":
		_maybe_show_action_result_popup({
			"popup_title": "Career Application",
			"popup_text": "You tried to apply for a career, but the job could not be resolved.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	if gs == null or gs.player == null or gs.career_engine == null:
		_maybe_show_action_result_popup({
			"popup_title": "Career Application",
			"popup_text": "The career system is not available right now.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	var raw_result: Variant = null

	if clean_job_kind == "part_time":
		raw_result = gs.career_engine.apply_for_part_time_job(gs.player, clean_job_name)
	elif clean_job_kind == "famous":
		if clean_job_name == "Boxer":
			if gs.boxing_engine != null:
				raw_result = gs.boxing_engine.start_boxing_career(gs.player)
			else:
				raw_result = {
					"success": false,
					"text": "The boxing system is not available right now."
				}
		else:
			raw_result = {
				"success": false,
				"text": "%s is listed as a famous career track, but its dedicated domain is not wired yet." % clean_job_name
			}
	else:
		raw_result = gs.career_engine.apply_for_job(gs.player, clean_job_name)

	var result: Dictionary = raw_result if typeof(raw_result) == TYPE_DICTIONARY else {}
	result = MainSceneHelpers._normalize_career_job_apply_result(clean_job_name, result)

	_dismiss_career_job_browser_stack()
	_hide_institution_hub()

	var result_text: String = str(result.get("text", "")).strip_edges()
	if result_text != "":
		_append_text_to_diary(result_text, false)

	_maybe_show_action_result_popup(result)
	_render_life_diary_panel()
	_update_player_stats_overlay()
	current_opportunities_cache.clear()
	if gs.opportunity_engine != null and gs.player != null:
		current_opportunities_cache = gs.opportunity_engine.generate_opportunities(gs.player)
	_refresh_activities_action_panel()
func _show_career_job_browser(job_kind: String) -> void:
	if gs == null or gs.player == null or gs.career_engine == null:
		return
	var p: Person = gs.player
	var jobs: Array = []
