	]


func _god_mode_or_menu_presentation_active() -> bool:
	if _god_mode_runtime_severed():
		return false

	if gs != null and gs.player != null:
		if _playable_life_shell_has_visible_sovereignty() \
or _global_runtime_kill_current_runtime_domain() == "simulation":
			return false

	if current_panel == "choose_adventure_entry":
		return true

	if choose_adventure_entry_overlay != null \
and is_instance_valid(choose_adventure_entry_overlay) \
and choose_adventure_entry_overlay.visible:
		return true

	if choose_adventure_scenario_panel != null \
and is_instance_valid(choose_adventure_scenario_panel) \
and choose_adventure_scenario_panel.visible:
		return true

	if household_creator_overlay != null \
and is_instance_valid(household_creator_overlay) \
and household_creator_overlay.visible:
		return true

	if god_mode_start_panel != null \
and is_instance_valid(god_mode_start_panel) \
and god_mode_start_panel.visible:
		if not _god_mode_meta_bool("god_mode_atomic_shell_handoff_active", false, "_god_mode_or_menu_presentation_active"):
			return true

	return false

func _era_audio_runtime_should_drive_world_music() -> bool:
	if not era_audio_enabled:
		return false

	if gs == null or gs.player == null:
		return false

	if _death_transition_audio_owns_contract():
		return false

	var god_mode_life_audio_claim: bool = (
		current_panel == "life"
		and bool(
			get_meta(
				"spawn_ready_visible_ui_ready_for_audio",
				false
			)
		)
		and bool(
			get_meta(
				"god_mode_ready_revealed_staged_surface",
				false
			)
		)
	)
	var loaded_life_audio_claim: bool = (
		current_panel == "life"
		and bool(
			get_meta(
				"loaded_life_audio_claim",
				false
			)
		)
	)
	var resident_life_audio_claim: bool = (
		current_panel == "life"
		and (
			_playable_life_surface_player_control_released()
			or _playable_life_shell_has_visible_sovereignty()
		)
	)
	var playable_life_audio_claim: bool = (
		god_mode_life_audio_claim
		or loaded_life_audio_claim
		or resident_life_audio_claim
	)

	if not playable_life_audio_claim:
		if _god_mode_or_menu_presentation_active():
			return false

		if bool(
			get_meta(
				"god_mode_audio_handoff_armed",
				false
			)
		):
			return false

	if bool(
		get_meta(
			"character_switch_audio_duck_active",
			false
		)
	):
		return false

	if _grocery_store_music_is_active():
		return false

	return true
