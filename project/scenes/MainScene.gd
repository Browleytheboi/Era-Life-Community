	return custom_city_picker.get_item_text(idx)

func _god_mode_current_bending_locations_allowed() -> bool:
	var selected_mode: String = _selected_reality_mode_text()
	if selected_mode == "realistic":
		return false

	var bending_toggle: BaseButton = _feature_override_toggle_for_key("bending")
	if bending_toggle != null:
		return bool(bending_toggle.button_pressed)

	return MainSceneLogic._reality_mode_allows_elemental_birth_locations(selected_mode)


func _filter_birth_cities_for_reality_mode(era_key: String, city_items: Array, mode_text: String) -> Array:
	if MainSceneLogic._reality_mode_allows_elemental_birth_locations(mode_text):
		return city_items.duplicate(true)

	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return city_items.duplicate(true)

	var filtered: Array = []
	for raw_city in city_items:
		var city_text: String = str(raw_city).strip_edges()
		if city_text == "":
			continue

		var country_text: String = str(era_engine.get_country_for_era_city(era_key, city_text)).strip_edges()
		if MainSceneHelpers._is_elemental_nation_name(country_text):
			continue

		filtered.append(city_text)

	return filtered


func _filter_birth_cities_for_current_reality_mode(era_key: String, city_items: Array) -> Array:
	return _filter_birth_cities_for_reality_mode(
		era_key,
		city_items,
		_selected_reality_mode_text()
	)
