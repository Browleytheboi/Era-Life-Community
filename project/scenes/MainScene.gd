func _append_world_feed_section_header(section_key: String, entry_count: int = 0) -> void:
	var base_color: Color = MainSceneHelpers._world_feed_section_color(section_key)
	var emphasized: Color = base_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.14)
	var label: String = MainSceneHelpers._world_feed_section_label(section_key)
	if entry_count > 0:
		label = "%s • %d" % [label, entry_count]
	var divider: String = "━━━━━━━━━━━━"
	_append_world_feed_colored_line("%s  [ %s ]  %s" % [divider, label, divider], emphasized, true, 17)

func _append_world_feed_compact_entry_block(_entry: Dictionary, text: String, accent: Color) -> void:
	var lines: Array = MainSceneHelpers._world_feed_trimmed_lines(text)
	if lines.is_empty():
		return
	var headline_color: Color = accent.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.08)
	var detail_color: Color = accent.lerp(Color(0.84, 0.88, 0.94, 1.0), 0.6)
	var normalized_entry: Dictionary = _entry
	if gs != null:
		normalized_entry = gs.normalize_world_feed_entry(_entry)
	var section_key: String = MainSceneLogic._world_feed_section_key(gs, normalized_entry)
	var collapsed_rows: Array = []
	if section_key == "politics":
		collapsed_rows = MainSceneLogic._collapse_realm_politics_compact_lines(lines)
	_append_world_feed_colored_line(str(lines [0]), headline_color, true, 16)
	if not collapsed_rows.is_empty():
		var max_collapsed_rows: int = 4
		var collapsed_count: int = min(max_collapsed_rows, collapsed_rows.size())
		for i in range(collapsed_count):
			_append_world_feed_colored_line("• " + str(collapsed_rows [i]), detail_color, false, 14)
		var collapsed_remaining: int = max(0, collapsed_rows.size() - collapsed_count)
		if collapsed_remaining > 0:
			_append_world_feed_colored_line("… +%d more details" % collapsed_remaining, detail_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.08), false, 13)
		return
	var max_detail_lines: int = 4
	var detail_count: int = min(max_detail_lines, max(0, lines.size() - 1))
	for i in range(detail_count):
		_append_world_feed_colored_line("• " + str(lines [i + 1]), detail_color, false, 14)
	var remaining: int = max(0, lines.size() - 1 - detail_count)
	if remaining > 0:
		_append_world_feed_colored_line("… +%d more details" % remaining, detail_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.08), false, 13)
func _ensure_life_diary_contract_engine() -> LifeDiaryContractEngine:
	if gs == null:
		return null

	if gs.life_diary_contract_engine == null:
		gs.life_diary_contract_engine = LifeDiaryContractEngine.new(
			gs
		)

	life_diary_contract_engine = (
		gs.life_diary_contract_engine
	)

	if (
		life_diary_contract_engine != null
		and life_diary_contract_engine.gs != gs
	):
		if life_diary_contract_engine.has_method(
			"bind_game_state_quiet"
		):
			life_diary_contract_engine.bind_game_state_quiet(
				gs
			)
		else:
			life_diary_contract_engine.bind_game_state(
				gs,
				false
			)

	if (
		life_diary_contract_engine != null
		and life_diary_contract_engine.has_signal(
			"diary_entry_committed"
		)
	):
		var diary_callback: Callable = Callable(
			self,
			"_on_life_diary_entry_committed"
		)

		if not life_diary_contract_engine.is_connected(
			"diary_entry_committed",
			diary_callback
		):
			life_diary_contract_engine.connect(
				"diary_entry_committed",
				diary_callback
			)

	if typeof(
		gs.contract_runtime_engines
	) == TYPE_DICTIONARY:
		gs.contract_runtime_engines [
			"life_diary_contract_engine"
		] = life_diary_contract_engine

	return life_diary_contract_engine
func _on_life_diary_entry_committed(
	actor_id: int,
	delta_contract: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(
			gs.player.id
		) != actor_id
		or delta_contract.is_empty()
	):
		return

	var loaded_owner_id: int = int(
		get_meta(
			"life_diary_loaded_owner_id",
			-1
		)
	)





	if (
		loaded_owner_id != actor_id
		or age_up_diary_entries.is_empty()
	):
		set_meta(
			"life_diary_loaded_owner_id",
			-1
		)
		set_meta(
			"life_diary_render_cached_signature",
			""
		)
		set_meta(
			"life_diary_render_cached_lines",
			[]
		)

		if output_label != null:
			output_label.set_meta(
				"life_diary_render_signature",
				""
			)

		return

	var incoming_lines: Array = MainSceneHelpers._safe_array(
		delta_contract.get(
			"lines",
			[]
		)
	)

	if incoming_lines.is_empty():
		return

	var target_year: int = int(
		delta_contract.get(
			"year",
			gs.year
		)
	)
	var target_age: int = int(
		delta_contract.get(
			"age",
			gs.player.age
		)
	)

	var year_line: String = _format_year(
		target_year
	)
	var age_line: String = "Age: %d" % target_age
	var body_lines: Array = []

	for raw_line in incoming_lines:
		var line_text: String = str(
			raw_line
		).strip_edges()

		if (
			line_text == ""
			or _is_life_diary_year_header_line(
				line_text
			)
			or line_text.begins_with(
				"Age: "
			)
		):
			continue

		if not body_lines.has(
			line_text
		):
			body_lines.append(
				line_text
			)

	var merged: bool = false
	var newly_added_lines: Array = []

	for index in range(
		age_up_diary_entries.size() - 1,
		-1,
		-1
	):
		var entry_raw: Variant = (
			age_up_diary_entries [
				index
			]
		)

		if typeof(entry_raw) != TYPE_ARRAY:
			continue

		var entry_lines: Array = (
			(entry_raw as Array).duplicate(
				false
			)
		)

		if entry_lines.size() < 2:
			continue

		if (
			MainSceneHelpers._life_diary_year_header_text(
				str(
					entry_lines [0]
				)
			) != year_line
			or str(
				entry_lines [1]
			).strip_edges() != age_line
		):
			continue

		for raw_body_line in body_lines:
			var body_line: String = str(
				raw_body_line
			)

			if not entry_lines.has(
				body_line
			):
				entry_lines.append(
					body_line
				)
				newly_added_lines.append(
					body_line
				)

		age_up_diary_entries [
			index
		] = entry_lines

		merged = true
		break

	if not merged:
		var next_entry: Array = [
			year_line,
			age_line
		]

		for raw_body_line in body_lines:
			var body_line: String = str(
				raw_body_line
			)

			next_entry.append(
				body_line
			)
			newly_added_lines.append(
				body_line
			)

		age_up_diary_entries.append(
			next_entry
		)

	set_meta(
		"life_diary_loaded_owner_id",
		actor_id
	)
	set_meta(
		"life_diary_render_cached_signature",
		""
	)
	set_meta(
		"life_diary_render_cached_lines",
		[]
	)
	set_meta(
		"life_diary_last_resident_delta_signature",
		str(
			delta_contract.get(
				"signature",
				""
			)
		)
	)
	set_meta(
		"life_diary_last_resident_delta_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"life_diary_delta_engine_calls",
		false
	)

	var can_patch_visible_lens: bool = (
		output_label != null
		and is_instance_valid(
			output_label
		)
		and output_label.visible
		and current_panel in [
			"",
			"life"
		]
		and (
			not merged
			or not newly_added_lines.is_empty()
		)
	)

	set_meta(
		"life_diary_delta_render_call",
		can_patch_visible_lens
	)

	if output_label != null:
		output_label.set_meta(
			"life_diary_render_signature",
			""
		)

	if not can_patch_visible_lens:
		return

	output_label.bbcode_enabled = true
	output_label.scroll_active = true



	_detach_life_diary_focus_spacer(
		output_label
	)

	var latest_visible_focus_paragraph: int = -1

	if not merged:
		output_label.append_text(
			"\n"
		)

		_append_formatted_life_diary_line(
			output_label,
			year_line
		)
		_append_formatted_life_diary_line(
			output_label,
			age_line
		)

		latest_visible_focus_paragraph = maxi(
			0,
			output_label.get_paragraph_count() - 2
		)

	for raw_line in newly_added_lines:
		_append_formatted_life_diary_line(
			output_label,
			str(
				raw_line
			)
		)

	_attach_life_diary_focus_spacer(
		output_label
	)

	if latest_visible_focus_paragraph >= 0:
		set_meta(
			"life_diary_latest_visible_focus_line",
			latest_visible_focus_paragraph
		)
		set_meta(
			"life_diary_latest_visible_focus_line_valid",
			true
		)

	_request_life_diary_focus_latest_year(
		"life_diary_entry_committed"
	)

	set_meta(
		"life_diary_delta_history_rebuilt",
		false
	)
	set_meta(
		"life_diary_delta_focus_spacer_republished",
		true
	)
func _life_diary_sync_runtime_cache_from_contract(actor_id: int, reason: String = "life_diary_contract_sync") -> void:
	if gs == null:
		return

	var engine:= _ensure_life_diary_contract_engine()
	if engine == null:
		return

	var clean_actor_id: int = int(actor_id)
	if clean_actor_id <= 0:
		clean_actor_id = MainSceneLogic._current_life_diary_owner_id(gs)
	if clean_actor_id <= 0:
		return

	var entries: Array = engine.diary_entries_for_actor(clean_actor_id, {
		"source": reason,
	})

	if not entries.is_empty():
		age_up_diary_entries = entries.duplicate(true)

	var flat_lines: Array = engine.diary_lines_for_actor(clean_actor_id, {
		"source": reason,
	})

	if not flat_lines.is_empty():
		set_meta("life_diary_render_cached_lines", flat_lines.duplicate(true))
		set_meta("life_diary_render_cached_signature", engine.signature_for_actor(clean_actor_id))

	set_meta("life_diary_loaded_owner_id", clean_actor_id)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["life_diary_authority_actor_id"] = clean_actor_id
		gs.scenario_state ["life_diary_authority_signature"] = engine.signature_for_actor(clean_actor_id)
		gs.scenario_state ["life_diary_authority_sync_reason"] = reason
		gs.scenario_state ["life_diary_authority_sync_at_ms"] = int(Time.get_ticks_msec())


func _emit_birth_intro_diary_contract_for_current_actor(lines: Array, reason: String = "birth_intro") -> void:
	if gs == null or gs.player == null:
		return

	var engine:= _ensure_life_diary_contract_engine()
	if engine == null:
		return

	var report: Dictionary = engine.emit_birth_intro_lines_for_actor(gs.player, lines, MainSceneLogic._life_diary_bridge_context(gs, reason, {
		"source": reason,
		"preserve_lines_exactly": true,
	}))

	_life_diary_sync_runtime_cache_from_contract(int(gs.player.id), str(report.get("mode", reason)))
	_save_active_life_diary_state()
	_mark_life_diary_mutated(reason)

func _save_active_life_diary_state() -> void:
	var owner_id: int = MainSceneLogic._current_life_diary_owner_id(gs)
	if gs == null or owner_id <= 0:
		return

	var engine:= _ensure_life_diary_contract_engine()
	if engine != null:
		var contract_entries: Array = engine.diary_entries_for_actor(owner_id, {
			"source": "save_active_life_diary_state"
		})
		if not contract_entries.is_empty():
			age_up_diary_entries = contract_entries.duplicate(true)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["life_diary_contract_engine_state"] = engine.export_state()
			gs.scenario_state ["life_diary_contract_engine_contract"] = engine.contract()
			gs.scenario_state ["life_diary_authority_save_pipeline_participant"] = true

	var store: Dictionary = MainSceneLogic._ensure_life_diary_state_store(gs)
	var key: String = str(owner_id)
	var existing_raw: Variant = store.get(key, {})
	var existing: Dictionary = existing_raw if typeof(existing_raw) == TYPE_DICTIONARY else {}

	age_up_diary_entries = _dedupe_life_diary_entries_for_owner(age_up_diary_entries, owner_id)

	store [key] = {
		"entries": age_up_diary_entries.duplicate(true),
		"world_feed_cursor": int(diary_world_feed_cursor),
		"global_memory_cursor": int(diary_global_memory_cursor),
		"player_memory_cursor": int(diary_player_memory_cursor),
		"owner_year": int(gs.year),
		"owner_age": int(gs.player.age),
		"life_diary_contract_signature": engine.signature_for_actor(owner_id) if engine != null else "",
		"pending_situation_diary_bypasses_generic_first_person_rewrite": bool(existing.get("pending_situation_diary_bypasses_generic_first_person_rewrite", false)),
		"pending_situation_diary_single_source": str(existing.get("pending_situation_diary_single_source", "")),
		"pending_situation_diary_fingerprints": MainSceneLogic._pending_situation_diary_fingerprints_from_entries(age_up_diary_entries, MainSceneHelpers._safe_array(existing.get("pending_situation_diary_fingerprints", [])))
	}

	gs.scenario_state ["life_diary_state_by_npc"] = store
	set_meta("life_diary_loaded_owner_id", owner_id)

func _load_life_diary_state_for_active_player(force_rebuild: bool = false) -> void:
	if gs == null or gs.player == null:
		age_up_diary_entries = []
		diary_world_feed_cursor = 0
		diary_global_memory_cursor = 0
		diary_player_memory_cursor = 0
		set_meta("life_diary_loaded_owner_id", -1)
		return

	var owner_id: int = MainSceneLogic._current_life_diary_owner_id(gs)
	var store: Dictionary = MainSceneLogic._ensure_life_diary_state_store(gs)
	var bucket_raw: Variant = store.get(str(owner_id), {})
	var bucket: Dictionary = bucket_raw if typeof(bucket_raw) == TYPE_DICTIONARY else {}

	var player_memory_id: int = int(gs.player.id)
	var global_memories: Array = gs.memory_engine.get_memories(player_memory_id) if gs.memory_engine != null else []
	var player_memories: Array = gs.player.memories if gs.player.memories != null else []

	var engine:= _ensure_life_diary_contract_engine()
	if engine != null:
		var engine_state_raw: Variant = gs.scenario_state.get("life_diary_contract_engine_state", {})
		if typeof(engine_state_raw) == TYPE_DICTIONARY and not (engine_state_raw as Dictionary).is_empty():
			engine.import_state(engine_state_raw as Dictionary)

		if not bucket.is_empty() and not engine.has_diary_for_actor(owner_id):
			engine.append_legacy_entries_for_actor(owner_id, MainSceneHelpers._safe_array(bucket.get("entries", [])), {
				"source": "load_life_diary_state_for_active_player_legacy_bucket",
				"owner_id": owner_id,
			})

		if force_rebuild or not engine.has_diary_for_actor(owner_id):
			var lines: Array = _build_loaded_life_diary_snapshot_lines()
			if lines.is_empty():
				lines = [
					"Year: %s" % _format_year(gs.year),
					"Age: %d" % gs.player.age,
					"I stepped back into this life with my story already in motion."
				]

			engine.enqueue_intent({
				"type": "legacy_entry",
				"actor_id": owner_id,
				"lines": lines.duplicate(true),
				"year": int(gs.year),
				"age": int(gs.player.age),
				"source": "load_life_diary_state_for_active_player_rebuild",
				"preserve_lines_exactly": true
			}, MainSceneLogic._life_diary_bridge_context(gs, "load_life_diary_state_for_active_player_rebuild"))

		age_up_diary_entries = engine.diary_entries_for_actor(owner_id, {
			"source": "load_life_diary_state_for_active_player"
		})

		if age_up_diary_entries.is_empty():
			var fallback_lines: Array = _build_loaded_life_diary_snapshot_lines()
			if fallback_lines.is_empty():
				fallback_lines = [
					"Year: %s" % _format_year(gs.year),
					"Age: %d" % gs.player.age,
					"I stepped back into this life with my story already in motion."
				]
			age_up_diary_entries = [fallback_lines.duplicate(true)]

		diary_world_feed_cursor = int(clamp(int(bucket.get("world_feed_cursor", gs.world_feed.size())), 0, gs.world_feed.size()))
		diary_global_memory_cursor = int(clamp(int(bucket.get("global_memory_cursor", global_memories.size())), 0, global_memories.size()))
		diary_player_memory_cursor = int(clamp(int(bucket.get("player_memory_cursor", player_memories.size())), 0, player_memories.size()))

		set_meta("life_diary_loaded_owner_id", owner_id)
		_life_diary_sync_runtime_cache_from_contract(owner_id, "load_life_diary_state_for_active_player")
		_save_active_life_diary_state()
		return

	age_up_diary_entries = []
	diary_world_feed_cursor = gs.world_feed.size()
	diary_global_memory_cursor = global_memories.size()
	diary_player_memory_cursor = player_memories.size()
	set_meta("life_diary_loaded_owner_id", owner_id)
func _ensure_active_life_diary_loaded(force_rebuild: bool = false) -> void:
	if gs == null or gs.player == null:
		age_up_diary_entries = []
		diary_world_feed_cursor = 0
		diary_global_memory_cursor = 0
		diary_player_memory_cursor = 0
		set_meta("life_diary_loaded_owner_id", -1)
		return

	var owner_id: int = MainSceneLogic._current_life_diary_owner_id(gs)
	var loaded_owner_id: int = int(get_meta("life_diary_loaded_owner_id", -1))
	if force_rebuild or loaded_owner_id != owner_id or age_up_diary_entries.is_empty():
		_load_life_diary_state_for_active_player(force_rebuild)

func _sort_world_feed_sections_for_year(year_bucket: Dictionary) -> Array:
	var ordered: Array = year_bucket.get("section_order", []).duplicate()
	var section_latest_positions: Dictionary = year_bucket.get("section_latest_positions", {})
	var section_scores: Dictionary = year_bucket.get("section_scores", {})

	ordered.sort_custom(func (a, b):
		var a_key: String = str(a)
		var b_key: String = str(b)
		var a_latest_position: int = int(section_latest_positions.get(a_key, -1))
		var b_latest_position: int = int(section_latest_positions.get(b_key, -1))

		if a_latest_position != b_latest_position:
			return a_latest_position < b_latest_position

		var a_score: float = float(section_scores.get(a_key, 0.0))
		var b_score: float = float(section_scores.get(b_key, 0.0))
		if absf(a_score - b_score) > 0.01:
			return a_score < b_score

		var a_priority: int = MainSceneHelpers._world_feed_section_priority(a_key)
		var b_priority: int = MainSceneHelpers._world_feed_section_priority(b_key)
		if a_priority != b_priority:
			return a_priority < b_priority

		return a_key < b_key
	)

	return ordered
func _format_relationship_person(npc: Person, label: String = "") -> String:
	if npc == null:
		return ""
	var prefix:= ""
	if label != "":
		prefix = label + ": "
	var full_name:= _relationship_display_name(npc)
	if not npc.alive:
		return "%s%s (died at %d)" % [prefix, full_name, npc.age]
	return "%s%s (age %d)" % [prefix, full_name, npc.age]


func _format_relationship_by_id(npc_id: int, label: String = "") -> String:
	if npc_id <= 0:
		return ""

	var active = gs.get_npc_by_id(npc_id)
	if active != null:
		return _format_relationship_person(active, label)

	var dormant = gs.get_dormant_npc_snapshot(npc_id)
	if typeof(dormant) == TYPE_DICTIONARY and not dormant.is_empty():
		var prefix:= ""
		if label != "":
			prefix = label + ": "
		var full_name:= _relationship_display_name_from_dict(dormant)
		if not bool(dormant.get("alive", true)):
			return "%s%s (died at %d)" % [prefix, full_name, int(dormant.get("age", 0))]
		var reactivated = gs.get_or_reactivate_npc_by_id(npc_id)
		if reactivated != null:
			return _format_relationship_person(reactivated, label)

	var grave = gs.npc_graveyard.get(npc_id, {})
	if typeof(grave) == TYPE_DICTIONARY and not grave.is_empty():
		var prefix:= ""
		if label != "":
			prefix = label + ": "
		return "%s%s (died at %d)" % [
			prefix,
			str(grave.get("name", "Unknown")),
			int(grave.get("age", 0))
		]

	var npc = gs.get_or_reactivate_npc_by_id(npc_id)
	if npc != null:
		return _format_relationship_person(npc, label)
	return ""


