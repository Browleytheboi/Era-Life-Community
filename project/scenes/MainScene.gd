func _live_diagnostics_opening_frame_quarantine_active() -> bool:
	if not age_up_loading_runtime_active:
		return false
	var hold_frames: int = int(get_meta("live_diagnostics_opening_quarantine_frames", 0))
	if hold_frames > 0:
		return true
	var quarantine_until_ms: int = int(get_meta("live_diagnostics_opening_quarantine_until_ms", 0))
	if quarantine_until_ms > 0 and int(Time.get_ticks_msec()) < quarantine_until_ms:
		return true
	var visible_started_ms: int = int(age_up_loading_visible_started_ms)
	if visible_started_ms <= 0:
		return false
	return int(Time.get_ticks_msec()) - visible_started_ms < 34
