func _hide_floating_quick_panels() -> void:
	belongings_hud_open = false
	if belongings_hud_panel != null and is_instance_valid(belongings_hud_panel):
		belongings_hud_panel.visible = false




	if belongings_hud_button != null and is_instance_valid(belongings_hud_button):
		var show_belongings: bool = MainSceneLogic._runtime_hud_snapshot_flag(gs, "belongings_button_visible", MainSceneLogic._runtime_hud_snapshot_flag(gs, "belongings_available", true))
		if gs != null and gs.player != null and gs.belongings_engine != null:
			show_belongings = show_belongings or _player_has_visible_belongings()
		_apply_zero_frame_hud_button_shell(belongings_hud_button, show_belongings)

	_hide_belonging_item_popup()
	_hide_artifact_target_popup()

	bending_hud_open = false
	# The vignette is a full-screen tint; if it is left visible after the hub
	# closes it dims the whole game. _toggle_bending_hud() already handles this,
	# these two close paths did not.
	if bending_hud_legendary_vignette != null and is_instance_valid(bending_hud_legendary_vignette):
		bending_hud_legendary_vignette.visible = false
	if bending_hud_panel != null and is_instance_valid(bending_hud_panel):
		bending_hud_panel.visible = false
	if bending_hud_button != null and is_instance_valid(bending_hud_button):
		_apply_zero_frame_hud_button_shell(bending_hud_button, MainSceneLogic._runtime_hud_snapshot_flag(gs, "bending_button_visible", MainSceneLogic._runtime_hud_snapshot_flag(gs, "bending_available", false)))

	crown_hub_open = false
	if crown_hud_button != null and is_instance_valid(crown_hud_button):
		_apply_zero_frame_hud_button_shell(crown_hud_button, MainSceneLogic._runtime_hud_snapshot_flag(gs, "crown_button_visible", MainSceneLogic._runtime_hud_snapshot_flag(gs, "crown_available", false)))
	if crown_hub_overlay != null and is_instance_valid(crown_hub_overlay):
		crown_hub_overlay.visible = false
	if crown_action_popup != null and is_instance_valid(crown_action_popup):
		crown_action_popup.visible = false
	if crown_action_popup_dim != null and is_instance_valid(crown_action_popup_dim):
		crown_action_popup_dim.visible = false

	_restore_runtime_hud_button_shells_after_surface_change("hide_floating_quick_panels")
func _hide_belonging_item_popup() -> void:
	var property_id: int = int(
		belongings_item_popup_current_item.get(
			"property_id",
			belongings_item_popup_current_item.get(
				"asset_id",
				belongings_item_popup_current_item.get(
					"id",
					-1
				)
			)
		)
	)
	var actor_id: int = (
		int(
			gs.player.id
		)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)

	if (
		actor_id > 0
		and property_id > 0
	):
		_disarm_targeted_property_destination_observation(
			actor_id,
			property_id
		)

	if belongings_item_popup != null:
		belongings_item_popup.visible = false

	if belongings_item_popup_dim != null:
		belongings_item_popup_dim.visible = false

	belongings_item_popup_current_item = {}
	belongings_item_popup_current_category = ""

	call_deferred(
		"_sync_runtime_floating_hud_layering"
	)

func _build_belonging_item_popup_text(item: Dictionary, category: String) -> String:
	var lines: Array = []
	lines.append("Category: %s" % category)

	var item_type: String = str(item.get("type", "Item")).strip_edges()
	if item_type != "":
		lines.append("Type: %s" % item_type)

	var overview_lines_raw: Variant = item.get("overview_lines", [])
	if typeof(overview_lines_raw) == TYPE_ARRAY:
		for raw_overview_line in overview_lines_raw as Array:
			var overview_line: String = str(raw_overview_line).strip_edges()
			if overview_line != "":
				lines.append(overview_line)

	var market_profile: Dictionary = MainSceneLogic._resolve_belonging_market_profile(gs, item)
	if not market_profile.is_empty():
		var current_value: int = int(market_profile.get("current_value", 0))
		var base_value: int = int(market_profile.get("base_value", current_value))
		var annual_appreciation_rate: float = float(market_profile.get("annual_appreciation_rate", 0.0))

		if current_value > 0:
			lines.append("Value: %s" % _format_belonging_money_value(current_value))

		if base_value > 0 and base_value != current_value:
			lines.append("Purchase Price: %s" % _format_belonging_money_value(base_value))

		if annual_appreciation_rate > 0.0:
			lines.append("Appreciation: %.1f%% compounded yearly" % (annual_appreciation_rate * 100.0))
	elif item.has("value"):
		var item_value: int = int(item.get("value", 0))
		lines.append("Value: %s" % _format_belonging_money_value(item_value))

	var origin_era: String = str(item.get("origin_era", "")).strip_edges()
	if origin_era != "":
		lines.append("Origin Era: %s" % origin_era)

	var acquired_year: int = int(item.get("acquired_year", 0))
	if acquired_year != 0:
		var contract_id: String = str(item.get("contract_id", "")).strip_edges()
		var asset_kind: String = str(item.get("asset_kind", "")).strip_edges()
		var official_residence: bool = contract_id == "official_residence_white_house" \
or asset_kind == "official_residence" \
or bool(MainSceneHelpers._safe_dictionary(item.get("reality_identity", {})).get("official_residence", false))

		if official_residence:
			lines.append("Moved in: Year %d" % acquired_year)
		else:
			lines.append("Acquired: Year %d" % acquired_year)

	var ability: String = str(item.get("ability", "")).strip_edges()
	if ability != "":
		lines.append("")
		lines.append("Ability")
		lines.append(ability)

	var lore: String = MainSceneLogic._resolve_belonging_display_lore(gs, item)
	if lore != "":
		lines.append("")
		lines.append("Lore")
		lines.append(lore)

	var out:= ""
	for i in range(lines.size()):
		if i > 0:
			out += "\n"
		out += str(lines [i])

	return out
