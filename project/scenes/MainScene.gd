func _resident_profile_switch_packet_for_actor_id(
	actor_id: int
) -> Dictionary:
	if (
		gs == null
		or actor_id <= 0
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return {}

	var packet_cache: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"profile_pointer_packet_by_actor",
			{}
		)
	)

	var direct_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		packet_cache.get(
			str(actor_id),
			{}
		)
	)

	if _relationship_profile_switch_packet_core_hot(
		direct_packet,
		actor_id
	):
		return direct_packet

	var queue: Array = [
		packet_cache.duplicate(false)
	]
	var cursor_index: int = 0
	var visited_signatures: Dictionary = {}

	while (
		cursor_index < queue.size()
		and cursor_index < 192
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue [cursor_index]
		)
		cursor_index += 1

		if cursor.is_empty():
			continue

		var cursor_signature: String = str(
			hash(cursor)
		)

		if visited_signatures.has(
			cursor_signature
		):
			continue

		visited_signatures [
			cursor_signature
		] = true

		if _relationship_profile_switch_packet_core_hot(
			cursor,
			actor_id
		):
			return cursor.duplicate(false)

		for packet_key in [
			"viewer_packet",
			"switch_packet",
			"profile_switch_packet",
			"profile_pointer_packet",
			"resident_actor_lens_packet",
			"control_pointer_packet",
			"render_packet",
			"packet"
		]:
			var nested_packet: Dictionary = MainSceneHelpers._safe_dictionary(
				cursor.get(
					packet_key,
					{}
				)
			)

			if nested_packet.is_empty():
				continue

			if _relationship_profile_switch_packet_core_hot(
				nested_packet,
				actor_id
			):
				return nested_packet.duplicate(false)

			queue.append(
				nested_packet
			)

		for raw_value in cursor.values():
			if typeof(raw_value) == TYPE_DICTIONARY:
				var nested: Dictionary = (
					raw_value as Dictionary
				).duplicate(false)

				if not nested.is_empty():
					queue.append(
						nested
					)

			elif typeof(raw_value) == TYPE_ARRAY:
				for raw_entry in raw_value as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(false)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

	return {}

func _relationship_profile_contract_with_resident_switch_successor(
	profile_contract: Dictionary,
	target_id: int
) -> Dictionary:
	var resolved_contract: Dictionary = (
		profile_contract.duplicate(false)
	)

	if target_id <= 0:
		return resolved_contract

	var resident_packet: Dictionary = (
		_resident_profile_switch_packet_for_actor_id(
			target_id
		)
	)



	if not _relationship_profile_switch_packet_core_hot(
		resident_packet,
		target_id
	):
		return resolved_contract

	resolved_contract [
		"switch_packet"
	] = resident_packet.duplicate(false)
	resolved_contract [
		"switch_packet_hot"
	] = true
	resolved_contract [
		"switch_packet_core_hot"
	] = true
	resolved_contract [
		"switch_semantically_available"
	] = true
	resolved_contract [
		"can_switch"
	] = true
	resolved_contract [
		"resident_actor_renderer_deck_hot"
	] = _resident_main_tab_renderer_deck_is_hot(
		target_id
	)
	resolved_contract [
		"support_deck_blocks_switch"
	] = false
	resolved_contract [
		"switch_readiness_authority"
	] = "UniversalSwitchContractEngine"
	resolved_contract [
		"switch_packet_successor_installed"
	] = true

	return resolved_contract


func _publish_resident_actor_lens_to_profile_surface(
	actor_id: int
) -> bool:
	if (
		actor_id <= 0
		or not _resident_main_tab_renderer_deck_is_hot(
			actor_id
		)
	):
		return false

	var resident_packet: Dictionary = (
		_resident_profile_switch_packet_for_actor_id(
			actor_id
		)
	)

	if not _relationship_profile_switch_packet_core_hot(
		resident_packet,
		actor_id
	):
		return false

	var cache_raw: Variant = get_meta(
		"relationship_profile_contract_by_target",
		{}
	)
	var profile_cache: Dictionary = (
		(cache_raw as Dictionary).duplicate(false)
		if typeof(cache_raw) == TYPE_DICTIONARY
		else {}
	)
	var cached_profile: Dictionary = MainSceneHelpers._safe_dictionary(
		profile_cache.get(
			str(actor_id),
			{}
		)
	)

	if not cached_profile.is_empty():
		profile_cache [
			str(actor_id)
		] = (
			_relationship_profile_contract_with_resident_switch_successor(
				cached_profile,
				actor_id
			)
		)
		set_meta(
			"relationship_profile_contract_by_target",
			profile_cache
		)

	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
		and int(
			relationship_profile_panel.active_target_id
		) == actor_id
		and relationship_profile_panel.has_method(
			"install_resident_switch_packet"
		)
	):
		relationship_profile_panel.install_resident_switch_packet(
			resident_packet
		)

	set_meta(
		"resident_actor_lens_published_to_profile_actor_id",
		actor_id
	)
	set_meta(
		"resident_actor_lens_published_to_profile_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	return true
func _animate_institution_hub_experience(delta: float) -> void:
	if not _institution_hub_runtime_surface_active():
		return

	var clean_kind: String = str(institution_hub_kind).strip_edges().to_lower()
	var relationship_hub_active: bool = clean_kind == "relationships" and _relationship_hub_runtime_surface_active()
	var school_hub_active: bool = clean_kind == "school"

	if school_hub_active:
		_drive_school_hub_live_surface(delta)

	institution_hub_experience_breathe_time += delta

	var pulse_strength: float = (sin(institution_hub_experience_breathe_time * 2.15) + 1.0) * 0.5
	var scroll_recent: bool = false
	var navigation_window: bool = false

	if relationship_hub_active:
		scroll_recent = _institution_hub_scroll_is_recently_active()
		navigation_window = _relationship_hub_navigation_perf_window_active()

	if institution_hub_back_button != null:
		_style_institution_hub_back_button(
			clean_kind,
			bool(institution_hub_back_button.get_meta("institution_hub_back_hovered", false)),
			pulse_strength
		)

	if relationship_hub_active:
		var now_ms: int = int(Time.get_ticks_msec())

		var next_visual_ms: int = int(get_meta("relationship_hub_next_visual_runtime_ms", 0))
		if now_ms >= next_visual_ms:
			var visual_interval_ms: int = 33
			if scroll_recent:
				visual_interval_ms = 56
			elif navigation_window:
				visual_interval_ms = 42

			set_meta("relationship_hub_next_visual_runtime_ms", now_ms + visual_interval_ms)
			_relationship_hub_refresh_runtime_visibility_cache(false)

		var next_truth_ms: int = int(get_meta("relationship_hub_next_truth_runtime_ms", 0))
		if now_ms >= next_truth_ms:
			var truth_interval_ms: int = 360
			if scroll_recent:
				truth_interval_ms = 620
			elif navigation_window:
				truth_interval_ms = 520

			set_meta("relationship_hub_next_truth_runtime_ms", now_ms + truth_interval_ms)
			_relationship_hub_live_refresh_visible_cards(false)

			_flush_relationship_hub_contract_engine_tail_work("relationship_hub_idle_switch_shell_tail")

		for raw_key in institution_hub_section_buttons.keys():
			var section_btn: Button = institution_hub_section_buttons.get(raw_key, null)
			if section_btn == null:
				continue

			var tab_key: String = str(section_btn.get_meta("relationship_tab_key", "")).strip_edges().to_lower()
			var is_selected: bool = bool(section_btn.get_meta("relationship_tab_selected", false))

			if not is_selected:
				section_btn.modulate = Color(1.0, 1.0, 1.0, 1.0)
				section_btn.scale = Vector2.ONE
				continue

			match tab_key:
				"family":
					var heartbeat: float = sin(institution_hub_experience_breathe_time * 4.0)
					section_btn.modulate = Color(1.0, 0.98, 1.0, 0.96 + ((heartbeat + 1.0) * 0.02))
					section_btn.scale = Vector2.ONE * (1.0 + heartbeat * 0.01)
				"household":
					var breathe: float = sin(institution_hub_experience_breathe_time * 2.2)
					section_btn.modulate = Color(1.0, 1.0, 0.98, 0.97 + ((breathe + 1.0) * 0.015))
					section_btn.scale = Vector2.ONE * (1.0 + breathe * 0.006)
				"dead":
					section_btn.modulate = Color(0.96, 0.98, 1.0, 0.9 + (pulse_strength * 0.05))
					section_btn.scale = Vector2.ONE
				"exes":
					var flicker: float = sin(institution_hub_experience_breathe_time * 9.0)
					section_btn.modulate = Color(1.0, 0.98, 1.0, 0.9 + ((flicker + 1.0) * 0.03))
					section_btn.scale = Vector2.ONE
				_:
					section_btn.modulate = Color(1.0, 1.0, 1.0, 1.0)
					section_btn.scale = Vector2.ONE

	if institution_hub_experience_rows.is_empty():
		return

	var relationship_row_budget: int = 999999
	if relationship_hub_active:
		if scroll_recent:
			relationship_row_budget = 18
		elif navigation_window:
			relationship_row_budget = 24
		else:
			relationship_row_budget = 32

	var processed_relationship_rows: int = 0

	for row_data in institution_hub_experience_rows:
		if relationship_hub_active:
			if processed_relationship_rows >= relationship_row_budget:
				break
			if not _institution_hub_row_data_is_scroll_visible(row_data, 240.0):
				continue
			processed_relationship_rows += 1

		if bool(row_data.get("mini_bar", false)):
			var mini_bar: ProgressBar = row_data.get("bar", null)
			var value_label: Label = row_data.get("value_label", null)
			var title_label: Label = row_data.get("title_label", null)
			var flavor_label: Label = row_data.get("flavor_label", null)
			var mini_title: String = str(row_data.get("title", "")).strip_edges()
			var mini_target: float = float(row_data.get("target", 0.0))
			var mini_max: int = max(1, int(row_data.get("max_value", 100)))
			var surface_context_raw: Variant = row_data.get("surface_context", {})
			var surface_context: Dictionary = surface_context_raw if typeof(surface_context_raw) == TYPE_DICTIONARY else {}

			if mini_bar != null:
				mini_bar.max_value = mini_max

				var mini_speed: float = max(45.0, abs(mini_target - float(mini_bar.value)) * delta * 8.0)
				mini_bar.value = move_toward(float(mini_bar.value), mini_target, mini_speed)

				var current_value: int = clamp(int(round(float(mini_bar.value))), 0, mini_max)
				var last_surface_value: int = int(row_data.get("_mini_last_surface_value", -999999))
				var last_surface_max: int = int(row_data.get("_mini_last_surface_max", -1))

				if current_value != last_surface_value or mini_max != last_surface_max:
					_relationship_hub_apply_mini_stat_surface_content(
						title_label,
						flavor_label,
						mini_bar,
						mini_title,
						current_value,
						mini_max,
						surface_context
					)
					row_data ["_mini_last_surface_value"] = current_value
					row_data ["_mini_last_surface_max"] = mini_max

				_relationship_hub_apply_mini_stat_glow_if_needed(row_data, current_value, mini_max, pulse_strength)

				if value_label != null and int(row_data.get("_mini_last_label_value", -999999)) != current_value:
					value_label.text = "%d" % current_value
					row_data ["_mini_last_label_value"] = current_value

			continue

		if bool(row_data.get("relationship_card", false)):
			var card_surface: PanelContainer = row_data.get("card_surface", null)
			var card_state: String = str(row_data.get("card_state", "warm")).strip_edges().to_lower()
			var card_featured: bool = bool(row_data.get("card_featured", false))
			var card_section_key: String = str(row_data.get("card_section_key", institution_hub_current_section)).strip_edges().to_lower()
			var card_bond: int = clamp(int(row_data.get("card_bond", 50)), 0, 100)
			var card_is_self: bool = bool(row_data.get("card_is_self", false))

			if card_surface != null:
				var pivot_key: String = "%d|%d" % [int(card_surface.size.x), int(card_surface.size.y)]
				if str(row_data.get("_card_pivot_key", "")) != pivot_key:
					card_surface.pivot_offset = card_surface.size * 0.5
					row_data ["_card_pivot_key"] = pivot_key

				_relationship_hub_apply_card_style_if_needed(
					row_data,
					card_surface,
					card_state,
					card_featured,
					card_section_key,
					card_bond,
					pulse_strength
				)

				if card_is_self:
					card_surface.modulate = Color(1.0, 0.98, 1.0, 0.96 + (pulse_strength * 0.04))
					card_surface.scale = Vector2.ONE
				else:
					match card_state:
						"warm":
							card_surface.modulate = Color(1.0, 1.0, 1.0, 0.96 + (pulse_strength * 0.04))
							card_surface.scale = Vector2.ONE
						"strained":
							card_surface.modulate = Color(0.95, 0.98, 1.0, 0.95)
							card_surface.scale = Vector2.ONE
						"conflict":
							var tension: float = sin(institution_hub_experience_breathe_time * 10.0)
							card_surface.modulate = Color(1.0, 0.97, 0.98, 0.9 + ((tension + 1.0) * 0.03))
							card_surface.scale = Vector2.ONE * (1.0 + tension * 0.004)
						_:
							card_surface.modulate = Color(1.0, 1.0, 1.0, 1.0)
							card_surface.scale = Vector2.ONE

			continue

		var label: Label = row_data.get("label", null)
		var bar: ProgressBar = row_data.get("bar", null)
		var title: String = str(row_data.get("title", ""))
		var target: float = float(row_data.get("target", 0.0))
		var danger: bool = bool(row_data.get("danger", false))

		if bar != null:
			var speed_scale: float = max(40.0, abs(target - float(bar.value)) * delta * 6.0)
			bar.value = move_toward(float(bar.value), target, speed_scale)
			_refresh_player_stat_bar_value_text(
				bar,
				int(round(bar.value)),
				int(round(bar.max_value)),
				title
			)
			_refresh_player_stat_surface_title_text(
				label,
				bar,
				int(round(bar.value)),
				int(round(bar.max_value)),
				title
			)
			_apply_player_stat_row_visual_state(
				label,
				bar,
				title,
				false,
				danger,
				pulse_strength
			)

