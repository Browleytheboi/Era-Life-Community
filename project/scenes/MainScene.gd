func _ensure_relationship_profile_page_cache_root() -> void:
	_ensure_relationship_profile_popup()

	if (
		relationship_profile_page_cache_root != null
		and is_instance_valid(
			relationship_profile_page_cache_root
		)
	):
		return

	if (
		relationship_profile_popup == null
		or not is_instance_valid(
			relationship_profile_popup
		)
	):
		return

	relationship_profile_page_cache_root = Control.new()
	relationship_profile_page_cache_root.name = (
		"RelationshipProfilePageCacheRoot"
	)
	relationship_profile_page_cache_root.visible = false
	relationship_profile_page_cache_root.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	relationship_profile_page_cache_root.process_mode = (
		Node.PROCESS_MODE_DISABLED
	)
	relationship_profile_popup.add_child(
		relationship_profile_page_cache_root
	)


func _relationship_profile_page_is_hot(
	target: Person
) -> bool:
	if target == null:
		return false

	var cache_key: String = (
		MainSceneLogic._relationship_profile_page_cache_key(gs, 
			target
		)
	)
	var page_raw: Variant = (
		relationship_profile_page_cache.get(
			cache_key,
			{}
		)
	)

	if typeof(page_raw) != TYPE_DICTIONARY:
		return false

	var page: Dictionary = page_raw as Dictionary
	var holder: Control = page.get(
		"holder",
		null
	) as Control
	var stats_cache: GridContainer = page.get(
		"stats_cache",
		null
	) as GridContainer
	var actions_cache: VBoxContainer = page.get(
		"actions_cache",
		null
	) as VBoxContainer

	if holder == null or not is_instance_valid(holder):
		return false

	if stats_cache == null or not is_instance_valid(stats_cache):
		return false

	if actions_cache == null or not is_instance_valid(actions_cache):
		return false

	if not page.has("profile_text"):
		return false

	return (
		_relationship_profile_playable_life_shell_is_hot(
			target
		)
	)


func _prewarm_relationship_profile_page_for_target(
	target: Person,
	reason: String = "relationship_profile_page_prewarm"
) -> bool:
	if gs == null or target == null:
		return false

	var target_id: int = int(target.id)

	if target_id <= 0:
		return false

	_ensure_relationship_profile_page_cache_root()

	if (
		relationship_profile_page_cache_root == null
		or not is_instance_valid(
			relationship_profile_page_cache_root
		)
	):
		return false

	var cache_key: String = (
		MainSceneLogic._relationship_profile_page_cache_key(gs, 
			target
		)
	)
	var signature: String = (
		MainSceneLogic._relationship_profile_page_signature(gs, 
			target
		)
	)
	var existing_raw: Variant = (
		relationship_profile_page_cache.get(
			cache_key,
			{}
		)
	)

	if typeof(existing_raw) == TYPE_DICTIONARY:
		var existing_page: Dictionary = (
			existing_raw as Dictionary
		)
		var existing_holder: Control = existing_page.get(
			"holder",
			null
		) as Control

		if (
			str(
				existing_page.get(
					"signature",
					""
				)
			) == signature
			and existing_holder != null
			and is_instance_valid(existing_holder)
		):
			if not _relationship_profile_playable_life_shell_is_hot(
				target
			):
				_relationship_profile_request_zero_frame_switch_room_prewarm(
					target,
					"%s_switch_shell_repair" % reason,
					true
				)
				var repair_target_shell: Dictionary = (
					_relationship_profile_prewarmed_playable_life_shell_for_actor(
						target
					)
				)
				var repair_target_viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(
					repair_target_shell.get(
						"playable_life_viewer_render_packet",
						repair_target_shell.get(
							"viewer_render_packet",
							{}
						)
					)
				)
				var repair_target_surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
					repair_target_viewer_packet.get(
						"surface_contract",
						{}
					)
				)
				var repair_target_main_tab_contracts: Dictionary = MainSceneHelpers._safe_dictionary(
					repair_target_viewer_packet.get(
						"main_tab_surface_contracts",
						repair_target_surface_contract.get(
							"main_tab_surface_contracts",
							{}
						)
					)
				)

				if not repair_target_main_tab_contracts.is_empty():
					_queue_resident_main_tab_renderer_deck_prewarm(
						target_id,
						repair_target_main_tab_contracts,
						"%s_target_main_tab_renderer_deck"
						% reason
					)

			if _asset_surface_pack_for_actor(target).is_empty():
				_prewarm_asset_surface_deck_for_actor(
					target,
					"%s_asset_deck_repair" % reason,
					false
				)

			return (
				_relationship_profile_page_is_hot(
					target
				)
			)

		if (
			existing_holder != null
			and is_instance_valid(existing_holder)
			and relationship_profile_active_page_key != cache_key
		):
			existing_holder.queue_free()

	relationship_profile_page_cache.erase(
		cache_key
	)

	_relationship_profile_request_zero_frame_switch_room_prewarm(
		target,
		"%s_switch_shell" % reason,
		true
	)
	var prepared_target_shell: Dictionary = (
		_relationship_profile_prewarmed_playable_life_shell_for_actor(
			target
		)
	)
	var prepared_target_viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		prepared_target_shell.get(
			"playable_life_viewer_render_packet",
			prepared_target_shell.get(
				"viewer_render_packet",
				{}
			)
		)
	)
	var prepared_target_surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		prepared_target_viewer_packet.get(
			"surface_contract",
			{}
		)
	)
