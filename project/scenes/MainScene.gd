	set_meta("god_mode_birth_tail_work_may_not_block_ui", true)
	set_meta("god_mode_birth_tail_work_may_not_start_loading", true)

	_convert_visible_shell_tail_work_to_background_only("%s_mark_surface_rendered" % reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["body_contract_tail_work_pending"] = false
		gs.scenario_state ["body_contract_tail_work_background_pending"] = true
		gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = true
		gs.scenario_state ["ui_background_reconciliation_streaming"] = true
		gs.scenario_state ["tail_work_after_visible_surface_waits_for_player_control"] = false
