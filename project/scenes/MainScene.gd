	lines.append("Prosperity: %d/100" % int(clamp(int(realm.get("prosperity", 50)), 0, 100)))
	lines.append("Stability: %d/100" % int(clamp(int(realm.get("stability", 50)), 0, 100)))
	lines.append("Subzones: %d" % int(subzones.size()))

	if bool(realm.get("visible_to_owner_only", false)):
		lines.append("Visibility: Owner Only")
	if bool(realm.get("hide_people_button", false)):
		lines.append("Population Surface: Hidden")

	var trade_rules: Dictionary = realm.get("trade_rules", {})
	if typeof(trade_rules) == TYPE_DICTIONARY and not trade_rules.is_empty():
		lines.append("")
		lines.append("Trade Rules:")
		lines.append("Bribes: %s" % ("Allowed" if bool(trade_rules.get("accepts_bribes", true)) else "Refused"))
		lines.append("Trade Scope: %s" % ("Rare artifacts only" if bool(trade_rules.get("rare_artifacts_only", false)) else "Standard"))

	var services: Dictionary = realm.get("services", {})
	if typeof(services) == TYPE_DICTIONARY and not services.is_empty():
		lines.append("")
		lines.append("State Services:")
		if bool((services.get("war_resolution", {}) as Dictionary).get("enabled", false)):
			lines.append("• War Resolution")
		if bool((services.get("massive_loans", {}) as Dictionary).get("enabled", false)):
			lines.append("• Massive Loans")
		if bool((services.get("balance_restoration", {}) as Dictionary).get("enabled", false)):
			lines.append("• Balance Restoration")

	if not subzones.is_empty():
		lines.append("")
		lines.append("Subzones:")
		for raw_zone in subzones:
			lines.append("• %s" % str(raw_zone))

	return lines
func _other_country_ordinary_overview_flavor(entry: Dictionary, realm: Dictionary) -> Dictionary:
	var entry_name: String = str(entry.get("name", realm.get("name", "This realm"))).strip_edges()
	var government_style: String = str(realm.get("government_style", "State")).strip_edges()
	var prosperity: int = int(clamp(int(realm.get("prosperity", 50)), 0, 100))
	var stability: int = int(clamp(int(realm.get("stability", 50)), 0, 100))
	var loyalty: int = int(clamp(int(realm.get("loyalty", 50)), 0, 100))

	var mood: String = "watchful"
	if prosperity >= 72 and stability >= 65:
		mood = "confident"
	elif stability <= 35:
		mood = "uneasy"
	elif loyalty <= 35:
		mood = "restless"

	var intro: String = "%s is not a gray card in the world-state. It has institutions, pressure, money, people, and a ruler whose office can be felt across the surface." % entry_name

	match mood:
		"confident":
			intro = "%s feels established and self-assured. Trade routes move, officials answer, and the ruler's authority reaches farther than the capital." % entry_name
		"uneasy":
			intro = "%s is holding together, but the seams are visible. Stability is being tested beneath the official surface." % entry_name
		"restless":
			intro = "%s obeys the structure of government, but loyalty is not passion. The people are watching the throne closely." % entry_name

	return {
		"title": "%s Surface" % government_style,
		"intro": intro
	}
func _restart_terabithia_overview_marquee(clip_holder: Control, clip_shell: PanelContainer, marquee_track: Control, marquee_text_a: Label, marquee_text_b: Label, requested_visible_width: float, marquee_speed: float, marquee_track_height: float, marquee_text_y: float, imagination_ratio: float) -> void:
	if not is_instance_valid(clip_holder) \
or not is_instance_valid(clip_shell) \
or not is_instance_valid(marquee_track) \
or not is_instance_valid(marquee_text_a) \
or not is_instance_valid(marquee_text_b):
		return

	if bool(clip_shell.get_meta("terabithia_marquee_layout_busy", false)):
		return

	clip_shell.set_meta("terabithia_marquee_layout_busy", true)

	var holder_span: float = floor(clip_holder.size.x)
	if holder_span <= 0.0 and clip_holder.get_parent() != null and clip_holder.get_parent() is Control:
		holder_span = floor((clip_holder.get_parent() as Control).size.x)

	var target_visible_span: float = max(requested_visible_width, 1.0)
	if holder_span > 0.0:
		target_visible_span = min(target_visible_span, max(holder_span - 12.0, 1.0))

	var desired_clip_min:= Vector2(
		target_visible_span,
		max(marquee_track_height, 1.0)
	)
	if clip_shell.custom_minimum_size != desired_clip_min:
		clip_shell.custom_minimum_size = desired_clip_min

	clip_shell.clip_contents = true

	var live_visible_span: float = max(
		floor(
			clip_shell.size.x if clip_shell.size.x > 0.0 else target_visible_span
		),
		1.0
	)

	var sentence_span_a: float = max(
		ceil(max(marquee_text_a.size.x, marquee_text_a.get_combined_minimum_size().x)),
		1.0
	)
	var sentence_span_b: float = max(
		ceil(max(marquee_text_b.size.x, marquee_text_b.get_combined_minimum_size().x)),
		1.0
	)
	var sentence_span: float = max(sentence_span_a, sentence_span_b, live_visible_span, 1.0)
	var loop_gap: float = 36.0
	var cycle_span: float = sentence_span + loop_gap

	var clamped_imagination_ratio: float = clampf(imagination_ratio, 0.0, 1.0)
	var imagination_bias: float = lerpf(0.97, 1.07, clamped_imagination_ratio)
	var effective_speed: float = max(marquee_speed * imagination_bias, 0.01)
	var duration: float = max(cycle_span / effective_speed, 0.01)

	var desired_track_min:= Vector2(
		max((cycle_span * 2.0) + live_visible_span, live_visible_span),
		marquee_track_height
	)
	if marquee_track.custom_minimum_size != desired_track_min:
		marquee_track.custom_minimum_size = desired_track_min

	var desired_a_pos:= Vector2(0.0, marquee_text_y)
	var desired_b_pos:= Vector2(cycle_span, marquee_text_y)
	if marquee_text_a.position != desired_a_pos:
		marquee_text_a.position = desired_a_pos
	if marquee_text_b.position != desired_b_pos:
		marquee_text_b.position = desired_b_pos

	var layout_signature: String = "%d|%d|%d|%d|%.3f|%.3f" % [
		int(round(live_visible_span)),
		int(round(sentence_span)),
		int(round(cycle_span)),
		int(round(marquee_track_height)),
		marquee_text_y,
		effective_speed
	]

	var previous_signature: String = str(
		clip_shell.get_meta("terabithia_marquee_layout_signature", "")
	).strip_edges()

	var existing_tween: Tween = null
	if clip_shell.has_meta("terabithia_marquee_tween"):
		var raw_existing_tween = clip_shell.get_meta("terabithia_marquee_tween")
		if raw_existing_tween is Tween and is_instance_valid(raw_existing_tween):
			existing_tween = raw_existing_tween

	if previous_signature == layout_signature and existing_tween != null:
		clip_shell.set_meta("terabithia_marquee_layout_busy", false)
		return

	if existing_tween != null:
		existing_tween.kill()

	var marquee_tween:= create_tween().bind_node(marquee_track)
	clip_shell.set_meta("terabithia_marquee_tween", marquee_tween)
	clip_shell.set_meta("terabithia_marquee_layout_signature", layout_signature)

	marquee_track.position = Vector2.ZERO
	marquee_tween.set_loops()
	marquee_tween.tween_property(
		marquee_track,
		"position",
		Vector2(- cycle_span, 0.0),
		duration
	).from(Vector2.ZERO).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)

	clip_shell.set_meta("terabithia_marquee_layout_busy", false)
func _ensure_world_action_panel() -> void:
	_ensure_world_feed_popup()

func _show_world_action_panel() -> void:
	_ensure_world_feed_popup()
	if world_feed_popup == null:
		return
	if not is_instance_valid(world_feed_popup):
		return

	world_feed_popup_open = true
	_claim_interactive_surface_authority(world_feed_popup, "world_action_panel", "show_world_action_panel", true, true)

	if world_feed_popup_card != null:
		world_feed_popup_card.add_theme_stylebox_override(
			"panel",
			_build_era_surface_panel_style("main", false, 0.0, false)
		)

	if world_action_panel != null:
		world_action_panel.add_theme_stylebox_override(
			"panel",
			_build_era_surface_panel_style("main", false, 0.0, false)
		)

	if auto_preserve_toggle != null and gs != null:
		auto_preserve_toggle.set_block_signals(true)
		auto_preserve_toggle.button_pressed = bool(gs.custom_settings.get("auto_preserve", false))
		auto_preserve_toggle.set_block_signals(false)

	if output_label != null:
		output_label.visible = false
	if relationships_browser_panel != null:
		relationships_browser_panel.visible = false
	if activities_action_panel != null:
		activities_action_panel.visible = false
	if player_stats_overlay != null:
		player_stats_overlay.visible = false

	call_deferred("_refresh_world_feed_reality_capsule_status")
func _on_auto_preserve_toggled(pressed: bool) -> void:
	if gs == null:
		return
	if typeof(gs.custom_settings) != TYPE_DICTIONARY:
		gs.custom_settings = {}

	gs.custom_settings ["auto_preserve"] = pressed

	if world_actions_status_label != null:
		world_actions_status_label.text = "Auto-Preserve enabled." if pressed else "Auto-Preserve disabled."


func _hide_world_action_panel() -> void:
	world_feed_popup_open = false

	if world_feed_popup != null and is_instance_valid(world_feed_popup):
		world_feed_popup.visible = false
		world_feed_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if world_action_panel != null and is_instance_valid(world_action_panel):
		world_action_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_close_nearby_switch_popup()

	if output_label != null \
and not relationships_browser_open \
and not relationship_profile_popup_open \
and not standard_tab_popup_open \
and not activities_action_open:
		output_label.visible = true
		output_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

	if player_stats_overlay != null \
and is_instance_valid(player_stats_overlay) \
and not relationships_browser_open \
and not relationship_profile_popup_open \
and not standard_tab_popup_open \
and not activities_action_open:
		player_stats_overlay.visible = true
		player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	belongings_hud_content_dirty = true

	set_meta("world_action_panel_closed_visual_only", true)
	set_meta("world_action_panel_closed_visual_only_at_ms", int(Time.get_ticks_msec()))
	set_meta("world_action_panel_close_sync_updates_forbidden", true)

	call_deferred("_restore_runtime_hud_button_shells_after_surface_change", "world_action_panel_closed_visual_only")
	call_deferred("_apply_ui_nav_button_visuals")

