func _pet_shop_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var cursor: Dictionary = report
	var last_nonempty: Dictionary = report



	for _index in range(16):
		if cursor.is_empty():
			break

		last_nonempty = cursor

		var result_type: String = str(
			cursor.get(
				"type",
				""
			)
		).strip_edges().to_lower()

		if result_type in [
			"pet_shop_acquisition_resolved",
			"pet_shop_intent_rejected"
		]:
			return cursor.duplicate(false)

		var direct_contract_raw: Variant = cursor.get(
			"pet_shop_surface_contract",
			{}
		)

		if typeof(direct_contract_raw) == TYPE_DICTIONARY:
			var direct_contract: Dictionary = (
				direct_contract_raw as Dictionary
			)

			if (
				not direct_contract.is_empty()
				and str(
					direct_contract.get(
						"schema",
						""
					)
				) == "eralife.pet_shop.surface_contract"
			):
				return cursor.duplicate(false)

		for contract_key in [
			"surface_contract",
			"shop_contract",
			"contract",
			"projection_contract",
			"resident_contract"
		]:
			var surface_raw: Variant = cursor.get(
				contract_key,
				{}
			)

			if typeof(surface_raw) != TYPE_DICTIONARY:
				continue

			var surface_contract: Dictionary = (
				surface_raw as Dictionary
			)

			if (
				not surface_contract.is_empty()
				and str(
					surface_contract.get(
						"schema",
						""
					)
				) == "eralife.pet_shop.surface_contract"
			):
				var resolved: Dictionary = (
					cursor.duplicate(false)
				)

				resolved [
					"pet_shop_surface_contract"
				] = surface_contract

				return resolved

		var found_nested: bool = false


		for key in [
			"result",
			"route_report",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				key,
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			cursor = nested
			found_nested = true
			break

		if found_nested:
			continue



		if (
			cursor.has(
				"success"
			)
			and (
				cursor.has(
					"text"
				)
				or cursor.has(
					"popup_text"
				)
			)
		):
			return cursor.duplicate(false)

		break

	return last_nonempty.duplicate(false)
func _resident_pet_shop_surface_contract_for_actor(
	actor_id: int
) -> Dictionary:
	if (
		gs == null
		or actor_id <= 0
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return {}

	for raw_registry_key in [
		"resident_pet_shop_surface_contract_by_actor",
		"observable_pet_shop_surface_contract_by_actor",
		"pet_shop_surface_contract_by_actor"
	]:
		var registry_key: String = str(
			raw_registry_key
		)
		var registry_raw: Variant = (
			gs.scenario_state.get(
				registry_key,
				{}
			)
		)

		if typeof(
			registry_raw
		) != TYPE_DICTIONARY:
			continue

		var registry: Dictionary = (
			registry_raw as Dictionary
		)
		var contract_raw: Variant = registry.get(
			str(
				actor_id
			),
			registry.get(
				actor_id,
				{}
			)
		)

		if typeof(
			contract_raw
		) != TYPE_DICTIONARY:
			continue

		var contract: Dictionary = (
			contract_raw as Dictionary
		)
		var listings: Array = MainSceneHelpers._safe_array(
			contract.get(
				"listings",
				[]
			)
		)

		if (
			str(
				contract.get(
					"schema",
					""
				)
			) == "eralife.pet_shop.surface_contract"
			and bool(
				contract.get(
					"success",
					false
				)
			)
			and int(
				contract.get(
					"actor_id",
					-1
				)
			) == actor_id
			and not listings.is_empty()
		):
			return contract.duplicate(
				false
			)

	return {}
func _prewarm_compact_pet_shop_surface_for_actor(
	target_actor: Person,
	reason: String = "compact_pet_shop_surface_prewarm"
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
	):
		return {}

	_ensure_pet_shop_panel()

	if (
		pet_shop_panel == null
		or not is_instance_valid(
			pet_shop_panel
		)
		or pet_shop_list == null
		or not is_instance_valid(
			pet_shop_list
		)
	):
		set_meta(
			"compact_pet_shop_surface_prewarm_missing_renderer",
			true
		)
		return {}

	var actor_id: int = int(
		target_actor.id
	)

	if actor_id <= 0:
		return {}

	var contract: Dictionary = (
		_resident_pet_shop_surface_contract_for_actor(
			actor_id
		)
	)
	var resident_registry_hit: bool = (
		not contract.is_empty()
	)
	var authority_route_performed: bool = false

	if contract.is_empty():
		authority_route_performed = true

		var report: Dictionary = (
			_express_global_ui_intent(
				{
					"actor_id": actor_id,
					"target_id": actor_id,
					"intent_type": (
						"pet_shop_contract_intent"
					),
					"surface_id": (
						"pet_shop_contract_panel"
					),
					"action_id": "emit_surface",
					"immutable_contract_references": true,
					"ephemeral_infrastructure_intent": true,
					"skip_global_intent_persistence": true,
					"skip_crr_observation": true,
					"authority_prevalidated": true,
					"skip_checks_and_balances": true,
					"payload": {
						"action_id": "emit_surface",
						"actor_id": actor_id,
						"source": reason,
						"read_only": true,
						"prewarm_only": true,
						"visible_click_work_forbidden": true,
						"ready_gate_member": false,
						"ui_is_renderer_only": true
					},
					"target": {
						"route_kind": "engine_method",
						"engine_property": (
							"pet_shop_contract_engine"
						),
						"method": "resolve_intent",
						"pass_actor_payload": true,
						"actor_id": actor_id
					},
					"source": reason
				},
				{
					"actor_id": actor_id,
					"target_id": actor_id,
					"surface_id": (
						"pet_shop_contract_panel"
					),
					"action_id": "emit_surface",
					"source": reason,
					"ready_gate_member": false
				}
			)
		)
		var route_result: Dictionary = (
			_pet_shop_contract_route_result(
				report
			)
		)

		contract = MainSceneHelpers._safe_dictionary(
			route_result.get(
				"pet_shop_surface_contract",
				{}
			)
		)




		if contract.is_empty():
			contract = (
				_resident_pet_shop_surface_contract_for_actor(
					actor_id
				)
			)

	var listings: Array = MainSceneHelpers._safe_array(
		contract.get(
			"listings",
			[]
		)
	)

	if (
		contract.is_empty()
		or not bool(
			contract.get(
				"success",
				false
			)
		)
		or int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
		or listings.is_empty()
	):
		set_meta(
			"compact_pet_shop_surface_prewarm_failed",
			true
		)
		set_meta(
			"compact_pet_shop_surface_prewarm_actor_id",
			actor_id
		)
		set_meta(
			"compact_pet_shop_surface_prewarm_reason",
			reason
		)
		set_meta(
			"compact_pet_shop_surface_prewarm_build_on_click",
			false
		)
		set_meta(
			"compact_pet_shop_surface_authority_route_performed",
			authority_route_performed
		)
		set_meta(
			"compact_pet_shop_surface_resident_registry_hit",
			resident_registry_hit
		)

		return {}

	var renderer_hot: bool = (
		_render_pet_shop_surface_contract(
			contract,
			actor_id,
			true
		)
	)

	if not renderer_hot:
		set_meta(
			"compact_pet_shop_surface_prewarm_renderer_failed",
			true
		)
		set_meta(
			"compact_pet_shop_surface_prewarm_actor_id",
			actor_id
		)

		return {}

	if not pet_shop_open:
		pet_shop_panel.visible = false
		pet_shop_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	set_meta(
		"compact_pet_shop_surface_prewarmed",
		true
	)
	set_meta(
		"compact_pet_shop_surface_prewarmed_actor_id",
		actor_id
	)
	set_meta(
		"compact_pet_shop_surface_prewarmed_listing_count",
		listings.size()
	)
	set_meta(
		"compact_pet_shop_surface_prewarmed_multi_grid",
		bool(
			pet_shop_panel.get_meta(
				"multi_grid_renderer",
				false
			)
		)
	)
	set_meta(
		"compact_pet_shop_surface_prewarmed_reason",
		reason
	)
	set_meta(
		"compact_pet_shop_surface_ready_gate_member",
		false
	)
	set_meta(
		"compact_pet_shop_surface_build_on_click",
		false
	)
	set_meta(
		"compact_pet_shop_surface_authority_route_performed",
		authority_route_performed
	)
	set_meta(
		"compact_pet_shop_surface_resident_registry_hit",
		resident_registry_hit
	)
	set_meta(
		"compact_pet_shop_surface_prewarmed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	return {
		"success": true,
		"actor_id": actor_id,
		"pet_shop_surface_contract": (
			contract.duplicate(false)
		),
		"listing_count": listings.size(),
		"resident_registry_hit": (
			resident_registry_hit
		),
		"authority_route_performed": (
			authority_route_performed
		),
		"ready_gate_member": false,
		"visible_click_work_required": false,
		"visible_click_work_forbidden": true,
		"ui_is_renderer_only": true
	}
