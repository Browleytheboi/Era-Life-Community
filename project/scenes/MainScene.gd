func _social_class_picker() -> OptionButton:
	return god_mode_start_panel.get_meta("custom_social_class_picker", null) as OptionButton if god_mode_start_panel != null else null

func _royal_rank_picker() -> OptionButton:
	return god_mode_start_panel.get_meta("custom_royal_rank_picker", null) as OptionButton if god_mode_start_panel != null else null

func _country_government_style_for_picker(country: String, era_key: String = "") -> String:
	var text:= str(country).strip_edges()
	if text == "":
		return ""

	if MainSceneHelpers._is_elemental_nation_name(text):
		return "Monarchy"

	var resolved_era_key:= str(era_key).strip_edges()
	if resolved_era_key == "":
		resolved_era_key = _selected_era_key()

	var era_engine:= _get_ui_era_engine()
	if era_engine != null and era_engine.has_method("get_birth_locations_for_era"):
		for entry in era_engine.get_birth_locations_for_era(resolved_era_key):
			if typeof(entry) != TYPE_DICTIONARY:
				continue
			if str(entry.get("country", "")).strip_edges().to_lower() != text.to_lower():
				continue
			var government_style:= str(entry.get("government_style", "")).strip_edges()
			if government_style != "":
				return government_style

	var lowered:= text.to_lower()
	if lowered.contains("empire"):
		return "Empire"
	if lowered.contains("kingdom") or lowered.contains("sultanate") or lowered.contains("dynasty"):
		return "Monarchy"

	return ""

func _default_social_class_for_current_picker_state() -> String:
	var options:= _social_class_options_for_current_picker_state()
	if options.has("Commoner"):
		return "Commoner"
	if options.has("Middle Class"):
		return "Middle Class"
	if not options.is_empty():
		return str(options [0])
	return "Commoner"

func _royal_rank_is_available_for_current_picker_state() -> bool:
	var social_class_picker:= _social_class_picker()
	if social_class_picker == null or social_class_picker.item_count <= 0:
		return false

	var social_class_text:= MainSceneHelpers._normalize_social_class_picker_value(
		social_class_picker.get_item_text(
			social_class_picker.get_selected_id()
		)
	)
	if social_class_text not in ["Royal", "Noble"]:
		return false

	return _country_or_era_supports_royal_picker_mode()

func _selected_royal_rank_seed_from_picker() -> String:
	var royal_rank_picker:= _royal_rank_picker()
	if royal_rank_picker == null or royal_rank_picker.item_count <= 0:
		return ""

	var selected_idx:= royal_rank_picker.get_selected_id()
	if selected_idx < 0 or selected_idx >= royal_rank_picker.item_count:
		return ""

	var metadata: Variant = royal_rank_picker.get_item_metadata(selected_idx)
	var seed_text:= str(metadata).strip_edges()
	if seed_text != "":
		return seed_text

	return str(royal_rank_picker.get_item_text(selected_idx)).strip_edges()

func _select_royal_rank_picker_by_seed_or_text(preferred_value: String) -> bool:
	var royal_rank_picker:= _royal_rank_picker()
	var wanted:= str(preferred_value).strip_edges()
	if royal_rank_picker == null or wanted == "":
		return false

	for i in range(royal_rank_picker.item_count):
		var metadata:= str(royal_rank_picker.get_item_metadata(i)).strip_edges()
		var item_text:= str(royal_rank_picker.get_item_text(i)).strip_edges()
		if metadata == wanted or item_text == wanted:
			royal_rank_picker.select(i)
			return true

	return false

func _refresh_custom_royal_rank_picker_preserving_selection(preferred_value: String = "") -> void:
	var royal_rank_picker:= _royal_rank_picker()
	if royal_rank_picker == null:
		return

	royal_rank_picker.clear()
	royal_rank_picker.disabled = true

	var rank_available:= _royal_rank_is_available_for_current_picker_state()
	_set_god_mode_labeled_row_visible("royal_rank", rank_available)

	if not rank_available:
		_style_god_mode_option_button(royal_rank_picker)
		return

	var social_class_text:= ""
	var social_class_picker:= _social_class_picker()
	if social_class_picker != null and social_class_picker.item_count > 0:
		social_class_text = MainSceneHelpers._normalize_social_class_picker_value(
			social_class_picker.get_item_text(
				social_class_picker.get_selected_id()
			)
		)

	var option_rows: Array = []
	if gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("get_spawnable_royal_rank_options"):
		option_rows = gs.royalty_engine.get_spawnable_royal_rank_options(
			_selected_country_text(),
			_selected_era_key()
		)

	if option_rows.is_empty():
		option_rows = [
			{ "seed": "Royal Child", "label": "Prince / Princess"},
			{ "seed": "Heir Line", "label": "Crown Prince / Crown Princess"},
			{ "seed": "Ducal Line", "label": "Duke / Duchess"},
			{ "seed": "Marcher Line", "label": "Marquess / Marchioness"}
		]

	if social_class_text == "Noble":
		var filtered_rows: Array = []
		for raw_row in option_rows:
			if typeof(raw_row) != TYPE_DICTIONARY:
				continue
			var row: Dictionary = raw_row
			var seed_text:= str(row.get("seed", "")).strip_edges()
			if seed_text in ["Ducal Line", "Marcher Line", "Lesser Royal"]:
				filtered_rows.append(row)
		option_rows = filtered_rows

	for row in option_rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue

		var seed_text:= str(row.get("seed", "")).strip_edges()
		var label_text:= str(row.get("label", "")).strip_edges()
		if seed_text == "" or label_text == "":
			continue

		royal_rank_picker.add_item(label_text)
		var item_idx:= royal_rank_picker.item_count - 1
		royal_rank_picker.set_item_metadata(item_idx, seed_text)

	royal_rank_picker.disabled = royal_rank_picker.item_count <= 0
	if royal_rank_picker.disabled:
		_style_god_mode_option_button(royal_rank_picker)
		return

	var preferred_seed:= str(preferred_value).strip_edges()
	if preferred_seed == "Lesser Royal":
		preferred_seed = "Ducal Line"

	var fallback_seed:= "Ducal Line" if social_class_text == "Noble" else "Royal Child"
	if not _select_royal_rank_picker_by_seed_or_text(preferred_seed):
		_select_royal_rank_picker_by_seed_or_text(fallback_seed)

	if royal_rank_picker.get_selected_id() < 0 and royal_rank_picker.item_count > 0:
		royal_rank_picker.select(0)

	_style_god_mode_option_button(royal_rank_picker)
func _country_or_era_supports_royal_picker_mode() -> bool:
	var country:= _selected_country_text()
	if country != "":
		return _country_uses_royal_social_classes(country)

	var era_key:= _selected_era_key()
	var era_engine:= _get_ui_era_engine()
	if era_engine != null and era_engine.has_method("get_countries_for_era"):
		for country_name in era_engine.get_countries_for_era(era_key):
			if _country_uses_royal_social_classes(str(country_name)):
				return true

	return false

func _country_uses_royal_social_classes(country: String) -> bool:
	var text:= str(country).strip_edges()
	if text == "":
		return false
	if MainSceneHelpers._is_elemental_nation_name(text):
		return true

	var government_style:= _country_government_style_for_picker(text, _selected_era_key())
	if MainSceneHelpers._government_style_supports_royalty(government_style):
		return true

	var lowered:= text.to_lower()
	return lowered.contains("kingdom") \
or lowered.contains("empire") \
or lowered.contains("sultanate") \
or lowered.contains("dynasty")

func _social_class_options_for_current_picker_state() -> Array:
	if not _country_or_era_supports_royal_picker_mode():
		return [
			"Lower Class",
			"Working Class",
			"Middle Class",
			"Upperclass",
			"Elite"
		]

	return [
		"Peasant",
		"Commoner",
		"Merchant",
		_noble_social_class_picker_label(),
		_royal_social_class_picker_label()
	]

func _refresh_custom_social_class_picker_preserving_selection(preferred_text: String = "") -> void:
	var social_class_picker:= _social_class_picker()
	var royal_rank_picker:= _royal_rank_picker()
	if social_class_picker == null:
		return

	var previous_rank_value:= _selected_royal_rank_seed_from_picker()
	var previous_rank_text:= ""
	if royal_rank_picker != null and royal_rank_picker.item_count > 0:
		previous_rank_text = royal_rank_picker.get_item_text(
			royal_rank_picker.get_selected_id()
		)

	var current_text:= preferred_text
	if current_text == "" and social_class_picker.item_count > 0:
		current_text = social_class_picker.get_item_text(
			social_class_picker.get_selected_id()
		)

	current_text = MainSceneHelpers._normalize_social_class_picker_value(current_text)

	var options:= _social_class_options_for_current_picker_state()
	var default_text:= _default_social_class_for_current_picker_state()
	if current_text == "":
		current_text = default_text

	if current_text in ["Royal", "Noble"] and not _country_or_era_supports_royal_picker_mode():
		current_text = default_text

	var picker_text:= current_text
	if current_text == "Royal" and _country_or_era_supports_royal_picker_mode():
		picker_text = _royal_social_class_picker_label()
	elif current_text == "Noble" and _country_or_era_supports_royal_picker_mode():
		picker_text = _noble_social_class_picker_label()

	if not options.has(picker_text):
