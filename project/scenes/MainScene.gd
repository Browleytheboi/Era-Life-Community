func _set_crown_action_popup_war_preview_mode(
	enabled: bool
) -> void:
	if crown_action_popup_body != null:
		crown_action_popup_body.visible = true
		crown_action_popup_body.bbcode_enabled = (
			enabled
			or crown_action_popup_body.bbcode_enabled
		)
		crown_action_popup_body.fit_content = false
		crown_action_popup_body.scroll_active = true
		crown_action_popup_body.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		crown_action_popup_body.size_flags_vertical = (
			Control.SIZE_EXPAND_FILL
			if enabled
			else Control.SIZE_SHRINK_BEGIN
		)
		crown_action_popup_body.custom_minimum_size = (
			Vector2(
				0,
				0 if enabled else 140
			)
		)

	if crown_action_popup_input != null:
		crown_action_popup_input.visible = false

	if crown_action_popup_options_scroll != null:
		crown_action_popup_options_scroll.visible = (
			not enabled
		)

		crown_action_popup_options_scroll.custom_minimum_size = (
			Vector2.ZERO
		)

		crown_action_popup_options_scroll.size_flags_vertical = (
			Control.SIZE_SHRINK_BEGIN
			if enabled
			else Control.SIZE_EXPAND_FILL
		)

		crown_action_popup_options_scroll.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
			if enabled
			else Control.MOUSE_FILTER_PASS
		)

	if crown_action_popup_options != null:
		crown_action_popup_options.visible = (
			not enabled
		)

		crown_action_popup_options.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
			if enabled
			else Control.MOUSE_FILTER_PASS
		)

	if crown_action_popup_status != null:
		crown_action_popup_status.size_flags_vertical = (
			Control.SIZE_SHRINK_END
		)

	set_meta(
		"crown_action_popup_war_preview_mode",
		enabled
	)

	set_meta(
		"crown_action_popup_blank_expanding_options_scroll_visible",
		false
	)

	set_meta(
		"crown_action_popup_war_preview_body_owns_remaining_height",
		enabled
	)

	set_meta(
		"crown_action_popup_war_preview_requires_outer_scroll",
		false
	)
func _on_crown_action_popup_visibility_changed() -> void:
	if (
		crown_action_popup == null
		or crown_action_popup_dim == null
		or crown_action_popup_card == null
	):
		return

	if not crown_action_popup.visible:
		_set_crown_action_popup_population_surface_mode(
			false
		)
		_set_crown_action_popup_war_preview_mode(
			false
		)

		if crown_action_popup_body != null:
			crown_action_popup_body.visible = true
			crown_action_popup_body.bbcode_enabled = false
			crown_action_popup_body.clear()

		if crown_action_popup_options != null:
			crown_action_popup_options.visible = true
			crown_action_popup_options.clip_contents = false

			for raw_child in (
				crown_action_popup_options.get_children()
			):
				if raw_child is Control:
					(raw_child as Control).visible = true

		if crown_action_popup_options_scroll != null:
			crown_action_popup_options_scroll.visible = true

		if crown_action_popup_input != null:
			crown_action_popup_input.visible = false

		if crown_action_popup_confirm_button != null:
			crown_action_popup_confirm_button.visible = false
			crown_action_popup_confirm_button.disabled = false

		if crown_action_popup_status != null:
			crown_action_popup_status.text = ""

		crown_action_popup_card.modulate.a = 1.0

		set_meta(
			"crown_action_popup_shared_renderer_state_restored",
			true
		)
		set_meta(
			"crown_action_popup_shared_renderer_restore_engine_calls",
			false
		)
		return

	var target_dim: Color = (
		crown_action_popup_dim.color
	)
	if target_dim.a <= 0.0:
		target_dim = Color(
			0.0,
			0.0,
			0.0,
			0.68
		)

	crown_action_popup_dim.visible = true
	crown_action_popup_dim.color = Color(
		target_dim.r,
		target_dim.g,
		target_dim.b,
		0.0
	)
	crown_action_popup_card.modulate.a = 0.0

	var reveal_tween: Tween = create_tween()
	reveal_tween.bind_node(
		crown_action_popup
	)
	reveal_tween.set_parallel(
		true
	)
	reveal_tween.tween_property(
		crown_action_popup_dim,
		"color",
		target_dim,
		0.16
	)
	reveal_tween.tween_property(
		crown_action_popup_card,
		"modulate:a",
		1.0,
		0.16
	)

	call_deferred(
		"_render_crown_contract_action_surface_if_available"
	)
	call_deferred(
		"_queue_crown_war_preview_priority_from_renderer"
	)

	set_meta(
		"crown_action_popup_visual_fade_only",
		true
	)
	set_meta(
		"crown_action_popup_engine_work_performed",
		false
	)
func _crown_contract_action_surface(
		action_id: String
) -> Dictionary:
		var clean_action_id: String = str(
			action_id
		).strip_edges().to_lower()

		if clean_action_id == "":
			return {}

		var section_surfaces: Dictionary = MainSceneHelpers._safe_dictionary(
			crown_hub_active_contract.get(
				"section_surfaces",
				{}
			)
		)
		var action_surfaces: Dictionary = MainSceneHelpers._safe_dictionary(
			section_surfaces.get(
				"_action_surfaces",
				{}
			)
		)

		return MainSceneHelpers._safe_dictionary(
			action_surfaces.get(
				clean_action_id,
				{}
			)
		)


func _render_crown_contract_action_surface_if_available() -> void:
		if (
			crown_action_popup == null
			or not crown_action_popup.visible
			or crown_action_popup_title == null
			or crown_action_popup_body == null
			or crown_action_popup_options == null
		):
			return

		var action_id: String = str(
			crown_action_popup_context.get(
				"action_id",
				""
			)
		).strip_edges().to_lower()

		if action_id in [
			"",
			"war_preview_pending",
			"war_confirm_contract",
			"population",
			"population_profile"
		]:
			return

		var surface: Dictionary = _crown_contract_action_surface(
			action_id
		)

		if surface.is_empty():
			return

		_set_crown_action_popup_population_surface_mode(false)

		crown_action_popup_body.visible = true
		crown_action_popup_options.visible = true
		crown_action_popup_confirm_button.visible = false
		crown_action_popup_input.visible = false

		var options_scroll:= (
			crown_action_popup_options.get_parent()
			as ScrollContainer
		)

		if options_scroll != null:
			options_scroll.visible = true

		crown_action_popup_title.text = str(
			surface.get(
				"title",
				action_id.replace("_", " ").to_upper()
			)
		)

		crown_action_popup_body.clear()
		_clear_container_children(
			crown_action_popup_options
		)

		var surface_kind: String = str(
			surface.get(
				"surface_kind",
				"choice_list"
			)
		).strip_edges().to_lower()

		if surface_kind == "law_swipe":
			_render_crown_law_swipe_contract(
				surface
			)
		else:
			crown_action_popup_body.bbcode_enabled = false
			crown_action_popup_body.append_text(
				str(
					surface.get(
						"body",
						"Choose an action."
					)
				)
			)

		for raw_option in MainSceneHelpers._safe_array(
			surface.get(
				"options",
				[]
			)
		):
			var option: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_option
			)

			if option.is_empty():
				continue

			var authority_action_id: String = str(
				option.get(
					"action_id",
					""
				)
			).strip_edges().to_lower()

			if authority_action_id == "":
				continue

			var option_payload: Dictionary = MainSceneHelpers._safe_dictionary(
				option.get(
					"payload",
					{}
				)
			)
			option_payload [
				"crown_action_surface_id"
			] = action_id
			option_payload [
				"section_id"
			] = str(
				surface.get(
					"section_id",
					crown_hub_current_section
				)
			)

			_append_crown_popup_option(
				str(
					option.get(
						"label",
						authority_action_id.replace(
							"_",
							" "
						).capitalize()
					)
				),
				"contract:%s" % authority_action_id,
				option_payload
			)

		if crown_action_popup_status != null:
			crown_action_popup_status.text = str(
				surface.get(
					"status_text",
					"Every choice is already published by CrownHubContractEngine."
				)
			)

		set_meta(
			"crown_action_surface_contract_rendered",
			action_id
		)
		set_meta(
			"crown_action_surface_ui_created_truth",
			false
		)
		set_meta(
			"crown_action_surface_engine_calls",
			false
		)


func _render_crown_law_swipe_contract(
		surface: Dictionary
) -> void:
		if crown_action_popup_body == null:
			return

		var proposal: Dictionary = MainSceneHelpers._safe_dictionary(
			surface.get(
				"law_review_contract",
				{}
			)
		)
		var vote_split: Dictionary = MainSceneHelpers._safe_dictionary(
			proposal.get(
				"vote_split",
				{}
			)
		)

		var lines: Array = [
			"[center][font_size=14][color=#AEB9D6]LAW REVIEW[/color][/font_size][/center]",
			"",
			"[center][font_size=25][b][color=#FFD86B]%s[/color][/b][/font_size][/center]"
			% str(
				proposal.get(
					"title",
					"Proposed Law"
				)
			),
			"",
			"[center][font_size=17]%s[/font_size][/center]"
			% str(
				proposal.get(
					"description",
					""
				)
			),
			"",
			"[center][color=#88D9FF][b]%s[/b][/color][/center]"
			% str(
				proposal.get(
					"risk_label",
					"Unrated"
				)
			),
			"",
			"[color=#C4CCE5]%s[/color]"
			% str(
				proposal.get(
					"institution_reading",
					"The realm is watching the decision."
				)
			)
		]

		if not vote_split.is_empty():
			lines.append("")
			lines.append(
				(
					"[table=2]"
					+ "[cell][b]HOUSE[/b][/cell]"
					+ "[cell]%d FOR • %d AGAINST[/cell]"
					+ "[cell][b]SENATE[/b][/cell]"
					+ "[cell]%d FOR • %d AGAINST[/cell]"
					+ "[/table]"
				)
				% [
					int(vote_split.get("house_for", 0)),
					int(vote_split.get("house_against", 0)),
					int(vote_split.get("senate_for", 0)),
					int(vote_split.get("senate_against", 0))
				]
			)
			lines.append("")
			lines.append(
				"[color=#FFCB55]A presidential veto may be overridden by a two-thirds vote in both chambers.[/color]"
			)

		lines.append("")
		lines.append(
			"[center][color=#909AB6]Choose the law's constitutional destination below.[/color][/center]"
		)

		crown_action_popup_body.bbcode_enabled = true
		crown_action_popup_body.append_text(
			"\n".join(lines)
		)
func _hide_crown_action_popup() -> void:
	var closing_context: Dictionary = (
		crown_action_popup_context.duplicate(false)
	)
	var return_to_other_countries: bool = bool(
		closing_context.get(
			"return_to_other_countries_popup",
			false
		)
	)

	crown_action_popup_context = {}

	_unmount_active_realm_population_contract_surface()

	if crown_action_popup != null:
		crown_action_popup.visible = false
		crown_action_popup.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	if crown_action_popup_dim != null:
		crown_action_popup_dim.visible = false

	if return_to_other_countries:
		var other_countries_popup:= get_node_or_null(
			"OtherCountriesPopup"
		)

		if other_countries_popup != null:
			other_countries_popup.visible = true
			other_countries_popup.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			other_countries_popup.process_mode = (
				Node.PROCESS_MODE_INHERIT
			)
			_bring_modal_to_front(
				other_countries_popup
			)

			set_meta(
				"other_countries_population_return_pointer_restore",
				true
			)
			set_meta(
				"other_countries_population_return_rebuilt_cards",
				false
			)
			set_meta(
				"other_countries_population_return_engine_calls",
				false
			)

	_flush_pending_crown_action_result()
func _append_crown_popup_option(label_text: String, option_id: String, payload: Dictionary = {}) -> void:
	if crown_action_popup_options == null:
		return
	var button:= Button.new()
	button.text = label_text
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.custom_minimum_size = Vector2(0, 44)
	button.pressed.connect(_on_crown_popup_option_pressed.bind(option_id, payload.duplicate(true)))
	crown_action_popup_options.add_child(button)
func _set_crown_action_popup_population_surface_mode(enabled: bool, accent: Color = Color(1.0, 0.84, 0.36, 1.0)) -> void:
	if crown_action_popup_card != null:
		if enabled:
			crown_action_popup_card.anchor_left = 0.035
			crown_action_popup_card.anchor_right = 0.965
			crown_action_popup_card.anchor_top = 0.035
			crown_action_popup_card.anchor_bottom = 0.965
			crown_action_popup_card.offset_left = 0
			crown_action_popup_card.offset_right = 0
			crown_action_popup_card.offset_top = 0
			crown_action_popup_card.offset_bottom = 0
			crown_action_popup_card.custom_minimum_size = Vector2(0, 0)
			crown_action_popup_card.clip_contents = true
		else:
			crown_action_popup_card.anchor_left = 0.5
			crown_action_popup_card.anchor_right = 0.5
			crown_action_popup_card.anchor_top = 0.5
			crown_action_popup_card.anchor_bottom = 0.5
			crown_action_popup_card.offset_left = -360
			crown_action_popup_card.offset_right = 360
			crown_action_popup_card.offset_top = -280
			crown_action_popup_card.offset_bottom = 280
			crown_action_popup_card.clip_contents = false

		var style:= StyleBoxFlat.new()
		style.bg_color = Color(0.018, 0.022, 0.034, 0.992) if enabled else Color(0.04, 0.06, 0.1, 0.97)
		style.border_width_left = 2
		style.border_width_top = 2
		style.border_width_right = 2
		style.border_width_bottom = 2
		style.border_color = Color(accent.r, accent.g, accent.b, 0.88 if enabled else 0.58)
		style.corner_radius_top_left = 20 if enabled else 18
		style.corner_radius_top_right = 20 if enabled else 18
		style.corner_radius_bottom_left = 20 if enabled else 18
		style.corner_radius_bottom_right = 20 if enabled else 18
		crown_action_popup_card.add_theme_stylebox_override("panel", style)

	if crown_action_popup_dim != null:
		crown_action_popup_dim.color = Color(accent.r * 0.08, accent.g * 0.07, accent.b * 0.1, 0.9) if enabled else Color(0.0, 0.0, 0.0, 0.68)

	if crown_action_popup_body != null:
		crown_action_popup_body.visible = not enabled

	if crown_action_popup_options != null:
		crown_action_popup_options.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		crown_action_popup_options.size_flags_vertical = Control.SIZE_EXPAND_FILL
		crown_action_popup_options.custom_minimum_size = Vector2(0, 0)
		crown_action_popup_options.clip_contents = enabled

		var options_scroll:= crown_action_popup_options.get_parent() as ScrollContainer
		if options_scroll != null:
			options_scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			options_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
			options_scroll.custom_minimum_size = Vector2(0, 0)
			options_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
			options_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
			options_scroll.clip_contents = true
			MainSceneHelpers._style_crown_population_scrollbar(options_scroll, accent)

	_style_crown_population_close_button(accent, enabled)
func _crown_population_role_label(target: Person, realm_id: int, section_kind: String, element: String = "") -> String:
	if target == null:
		return "Resident"

	var clean_section: String = str(section_kind).strip_edges().to_lower()
	var federal_title: String = _person_federal_republic_government_title(target, realm_id, false)

	if federal_title != "" and clean_section in [
		"federal_executive",
		"federal_cabinet",
		"federal_senate",
		"federal_supreme_court",
		"federal_governor",
		"official"
	]:
		return federal_title

	var court_title: String = _crown_population_resolved_court_title(target, realm_id)

	if clean_section == "federal_executive":
		if federal_title != "":
			return federal_title
		var executive_job: String = str(target.job).strip_edges()
		if executive_job != "":
			return MainSceneHelpers._crown_title_case(executive_job)
		return "Executive Branch"

	if clean_section == "federal_cabinet":
		if federal_title != "":
			return federal_title
		var cabinet_job: String = str(target.job).strip_edges()
		if cabinet_job != "":
			return MainSceneHelpers._crown_title_case(cabinet_job)
		return "Cabinet Official"

	if clean_section == "federal_senate":
		if federal_title != "":
			return federal_title
		return "Senator"

	if clean_section == "federal_supreme_court":
		if federal_title != "":
			return federal_title
		return "Supreme Court Justice"

	if clean_section == "federal_governor":
		if federal_title != "":
			return federal_title
		return "State Governor"

	if clean_section == "official":
		if court_title != "":
			return court_title
		return _build_crown_government_official_label(target, realm_id)

	if clean_section == "noble":
		if court_title != "":
			return court_title
		return "Lady" if str(target.gender).strip_edges().to_lower() == "female" else "Lord"

	if clean_section == "master":
		var clean_element: String = str(element).strip_edges().capitalize()
		if court_title != "":
			return "%s • %s Master" % [court_title, clean_element] if clean_element != "" else "%s • Bending Master" % court_title
		return "%s Master" % clean_element if clean_element != "" else "Bending Master"

	if court_title != "" and MainSceneHelpers._crown_population_title_tier_from_text(court_title) in ["heir", "royal_child", "ducal", "marcher", "lord"]:
		return court_title

	if clean_section == "citizen":
		var modern_citizen_label: String = MainSceneLogic._crown_population_modern_citizen_role_label(gs, target, realm_id, MainSceneLogic._crown_realm_name(gs, realm_id))
		if modern_citizen_label != "":
			return modern_citizen_label

	var job_text: String = str(target.job).strip_edges()
	if job_text != "":
		return MainSceneHelpers._crown_title_case(job_text)

	var class_text: String = str(target.social_class).strip_edges()
	if class_text != "":
		var class_key: String = class_text.strip_edges().to_lower()
		if MainSceneLogic._crown_population_uses_modern_class_lens(gs, realm_id, MainSceneLogic._crown_realm_name(gs, realm_id)) and class_key in ["commoner", "peasant", "merchant"]:
			return "Citizen"
		return class_text

	return "Citizen"
func _crown_population_role_accent_color(section_kind: String, accent: Color, target: Person = null) -> Color:
	var clean_section: String = str(section_kind).strip_edges().to_lower()



	match clean_section:
		"official":
			return Color(1.0, 0.78, 0.26, 1.0)

		"noble":
			var title_text: String = _crown_population_resolved_court_title(target, int(target.realm_id)) if target != null else ""
			var tier: String = MainSceneHelpers._crown_population_title_tier_from_text(title_text)
			match tier:
				"ducal":
					return Color(0.72, 0.44, 1.0, 1.0)
				"marcher":
					return Color(0.44, 0.92, 0.78, 1.0)
				"lord":
					return Color(0.92, 0.62, 1.0, 1.0)
				_:
					return Color(0.84, 0.68, 1.0, 1.0)

		"master":
			return Color(accent.r, accent.g, accent.b, 1.0)

		_:
			return Color(accent.r, accent.g, accent.b, 0.92)


func _set_crown_population_card_hover_state(card: PanelContainer, target: Person, section_kind: String, accent: Color, glow_strength: float, expanded: bool, hovered: bool, realm_id: int = -1, element: String = "", realm_name: String = "") -> void:
	if card == null or not is_instance_valid(card):
		return

	card.add_theme_stylebox_override(
		"panel",
		_crown_population_card_style(
			target,
			section_kind,
			accent,
			glow_strength,
			expanded,
			hovered,
			realm_id,
			element,
			realm_name
		)
	)

	if hovered:
		_show_crown_population_graph_hover(
			card,
			target,
			section_kind,
			accent,
			realm_id,
			element,
			realm_name
		)
	else:
		_hide_crown_population_graph_hover()

func _prime_crown_population_card_micro_pulse(card: PanelContainer, target: Person, section_kind: String, realm_id: int = -1, element: String = "", realm_name: String = "") -> void:
	if card == null or not is_instance_valid(card):
		return

	if target == null:
		return

	var resolved_realm_id: int = realm_id if realm_id > 0 else int(target.realm_id)

	if not MainSceneLogic._crown_population_is_ruler_partner_card(gs, target, resolved_realm_id):
		return

	if bool(card.get_meta("crown_population_micro_pulse_started", false)):
		return

	card.set_meta("crown_population_micro_pulse_started", true)
	card.set_meta("crown_population_royal_pair_outer_border_pulse", true)

	var pulse:= card.create_tween()
	if pulse == null:
		return

	pulse.set_loops()

	pulse.tween_method(
		func (value: float) -> void:
			if card == null or not is_instance_valid(card):
				return

			card.add_theme_stylebox_override(
				"panel",
				_crown_population_card_style(
					target,
					section_kind,
					Color(1.0, 0.78, 0.24, 1.0),
					value,
					false,
					false,
					resolved_realm_id,
					element,
					realm_name
				)
			),
		0.34,
		0.62,
		1.85
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	pulse.tween_method(
		func (value: float) -> void:
			if card == null or not is_instance_valid(card):
				return

			card.add_theme_stylebox_override(
				"panel",
				_crown_population_card_style(
					target,
					section_kind,
					Color(1.0, 0.78, 0.24, 1.0),
					value,
					false,
					false,
					resolved_realm_id,
					element,
					realm_name
				)
			),
		0.62,
		0.34,
		2.15
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
func _style_crown_population_close_button(accent: Color, enabled: bool) -> void:
	if crown_action_popup_cancel_button == null:
		return

	crown_action_popup_cancel_button.text = "Close Realm Wall" if enabled else "Close"
	crown_action_popup_cancel_button.custom_minimum_size = Vector2(150 if enabled else 100, 40)

	var normal:= StyleBoxFlat.new()
	normal.bg_color = Color(accent.r * 0.1, accent.g * 0.085, accent.b * 0.065, 0.96) if enabled else Color(0.08, 0.09, 0.11, 0.94)
	normal.border_width_left = 2
	normal.border_width_top = 2
	normal.border_width_right = 2
	normal.border_width_bottom = 2
	normal.border_color = Color(accent.r, accent.g, accent.b, 0.55) if enabled else Color(0.52, 0.56, 0.64, 0.4)
	normal.corner_radius_top_left = 14
	normal.corner_radius_top_right = 14
	normal.corner_radius_bottom_left = 14
	normal.corner_radius_bottom_right = 14

	var hover:= normal.duplicate() as StyleBoxFlat
	hover.bg_color = Color(1.0, 0.92, 0.74, 0.98)
	hover.border_color = Color(1.0, 0.84, 0.4, 1.0)

	var pressed:= normal.duplicate() as StyleBoxFlat
	pressed.bg_color = Color(accent.r * 0.22, accent.g * 0.18, accent.b * 0.1, 0.98)
	pressed.border_color = Color(1.0, 0.74, 0.3, 1.0)

	crown_action_popup_cancel_button.add_theme_stylebox_override("normal", normal)
	crown_action_popup_cancel_button.add_theme_stylebox_override("hover", hover)
	crown_action_popup_cancel_button.add_theme_stylebox_override("pressed", pressed)
	crown_action_popup_cancel_button.add_theme_color_override("font_color", Color(1.0, 0.94, 0.78, 1.0) if enabled else Color(0.88, 0.9, 0.96, 1.0))
	crown_action_popup_cancel_button.add_theme_color_override("font_hover_color", Color(0.14, 0.1, 0.04, 1.0))
	crown_action_popup_cancel_button.add_theme_color_override("font_pressed_color", Color(1.0, 0.9, 0.6, 1.0))


func _crown_population_card_style(target: Person, section_kind: String, accent: Color, glow_strength: float, expanded: bool = false, hovered: bool = false, realm_id: int = -1, element: String = "", realm_name: String = "") -> StyleBoxFlat:
	var style:= StyleBoxFlat.new()
	var bg_alpha: float = 0.94
	var border_alpha: float = 0.38 + glow_strength
	var resolved_realm_id: int = realm_id if realm_id > 0 else int(target.realm_id) if target != null else -1
	var royal_pair_card: bool = target != null and MainSceneLogic._crown_population_is_ruler_partner_card(gs, target, resolved_realm_id)
	match section_kind:
		"official":
			style.bg_color = Color(0.125, 0.088, 0.03, bg_alpha)
			style.border_color = Color(1.0, 0.78, 0.24, clamp(border_alpha + 0.22, 0.0, 1.0))
		"noble":
			var noble_accent: Color = _crown_population_role_accent_color(section_kind, accent, target)
			style.bg_color = Color(noble_accent.r * 0.12, noble_accent.g * 0.085, noble_accent.b * 0.16, bg_alpha)
			style.border_color = Color(noble_accent.r, noble_accent.g, noble_accent.b, clamp(border_alpha + 0.24, 0.0, 1.0))
		"master":
			style.bg_color = Color(accent.r * 0.16, accent.g * 0.15, accent.b * 0.18, bg_alpha)
			style.border_color = Color(accent.r, accent.g, accent.b, clamp(border_alpha + 0.3, 0.0, 1.0))
		_:
			style.bg_color = Color(accent.r * 0.075, accent.g * 0.07, accent.b * 0.09, bg_alpha)
			style.border_color = Color(accent.r, accent.g, accent.b, clamp(border_alpha, 0.0, 0.72))

	if target != null:
		var power: Dictionary = _crown_population_power_map_contract(target, resolved_realm_id, section_kind, element, realm_name)
		var influence: int = int(power.get("influence", 0))
		var succession_pressure: int = int(power.get("succession_pressure", 0))
		var class_bleed: Dictionary = power.get("class_bleed", {}) if typeof(power.get("class_bleed", {})) == TYPE_DICTIONARY else {}

		if bool(power.get("next_in_line", false)):
			style.border_color = Color(1.0, 0.86, 0.28, 1.0)
			style.bg_color = style.bg_color.lerp(Color(1.0, 0.78, 0.24, style.bg_color.a), 0.1)

		if bool(power.get("rising_threat", false)):
			style.border_color = style.border_color.lerp(Color(1.0, 0.22, 0.16, 1.0), 0.42)
			style.bg_color = style.bg_color.lerp(Color(0.6, 0.08, 0.04, style.bg_color.a), 0.16)
		elif bool(power.get("unstable_claim", false)):
			style.border_color = style.border_color.lerp(Color(1.0, 0.52, 0.18, 1.0), 0.3)

		if bool(class_bleed.get("active", false)):
			var bleed_tint: Color = Color(class_bleed.get("tint", Color(1.0, 1.0, 1.0, 0.0)))
			style.bg_color = style.bg_color.lerp(Color(bleed_tint.r, bleed_tint.g, bleed_tint.b, style.bg_color.a), clampf(bleed_tint.a, 0.0, 0.35))

		var influence_shadow: float = clampf(float(influence) / 100.0, 0.0, 1.0)
		style.shadow_color = Color(style.border_color.r, style.border_color.g, style.border_color.b, 0.1 + influence_shadow * 0.22)
		style.shadow_size = int(2 + influence_shadow * 10.0)

		if succession_pressure >= 70:
			style.shadow_color = style.shadow_color.lerp(Color(1.0, 0.3, 0.14, 0.38), 0.4)
			style.shadow_size = max(style.shadow_size, 9)

	if target != null and gs != null and gs.player != null and int(target.id) == int(gs.player.id):
		style.bg_color = Color(0.1, 0.085, 0.03, 0.96)
		style.border_color = Color(1.0, 0.95, 0.54, 1.0)
	if royal_pair_card:
		style.border_color = Color(1.0, 0.82, 0.28, 1.0)
		style.shadow_color = Color(1.0, 0.72, 0.22, 0.34 + clampf(glow_strength, 0.0, 0.36))
		style.shadow_size = max(style.shadow_size, 14 + int(round(glow_strength * 12.0)))
		style.bg_color = style.bg_color.lerp(Color(0.22, 0.13, 0.025, style.bg_color.a), 0.24)
	if hovered:
		style.bg_color = style.bg_color.lerp(Color(1.0, 0.93, 0.76, style.bg_color.a), 0.16)
		style.border_color = Color(1.0, 0.91, 0.72, 1.0)
		style.shadow_size = max(style.shadow_size, 12)
		style.shadow_color = Color(1.0, 0.78, 0.36, 0.34)

	style.border_width_left = 3 if hovered else 2
	style.border_width_top = 3 if hovered else 2
	style.border_width_right = 3 if hovered else 2
	style.border_width_bottom = 3 if hovered else 2
	style.corner_radius_top_left = 18 if expanded else 15
	style.corner_radius_top_right = 18 if expanded else 15
	style.corner_radius_bottom_left = 18 if expanded else 15
	style.corner_radius_bottom_right = 18 if expanded else 15
	style.shadow_offset = Vector2.ZERO
	return style
func _crown_population_stat_palette(label_text: String, fallback: Color) -> Dictionary:
	var normalized: String = str(label_text).strip_edges()

	match normalized:
		"Health", "Hunger", "Mental", "Smarts", "Looks", "Approval", "Fame", "Bond":
			if has_method("_resolve_player_stat_palette"):
				return _resolve_player_stat_palette(normalized)
		"Respect":
			return {
				"core": Color(0.74, 0.88, 1.0, 1.0),
				"soft": Color(0.18, 0.28, 0.44, 0.98),
				"glow": Color(0.74, 0.88, 1.0, 0.22),
				"label": Color(0.92, 0.97, 1.0, 1.0)
			}
		"Loyalty":
			return {
				"core": Color(0.72, 0.66, 1.0, 1.0),
				"soft": Color(0.22, 0.18, 0.48, 0.98),
				"glow": Color(0.72, 0.66, 1.0, 0.24),
				"label": Color(0.95, 0.93, 1.0, 1.0)
			}
		"Throne", "Succession", "Claim":
			return {
				"core": Color(1.0, 0.78, 0.24, 1.0),
				"soft": Color(0.48, 0.3, 0.08, 0.98),
				"glow": Color(1.0, 0.78, 0.24, 0.28),
				"label": Color(1.0, 0.95, 0.82, 1.0)
			}
		"Influence", "Court", "House":
			return {
				"core": Color(0.82, 0.58, 1.0, 1.0),
				"soft": Color(0.3, 0.16, 0.48, 0.98),
				"glow": Color(0.82, 0.58, 1.0, 0.26),
				"label": Color(0.98, 0.92, 1.0, 1.0)
			}
		"Wealth", "Trade", "Market":
			return {
				"core": Color(0.44, 0.92, 0.62, 1.0),
				"soft": Color(0.1, 0.36, 0.2, 0.98),
				"glow": Color(0.44, 0.92, 0.62, 0.24),
				"label": Color(0.9, 1.0, 0.94, 1.0)
			}
		"Survival", "Labor":
			return {
				"core": Color(0.74, 0.56, 0.34, 1.0),
				"soft": Color(0.34, 0.22, 0.12, 0.98),
				"glow": Color(0.74, 0.56, 0.34, 0.2),
				"label": Color(1.0, 0.94, 0.84, 1.0)
			}

	return {
		"core": Color(fallback.r, fallback.g, fallback.b, 1.0),
		"soft": Color(fallback.r * 0.24, fallback.g * 0.24, fallback.b * 0.24, 0.98),
		"glow": Color(fallback.r, fallback.g, fallback.b, 0.22),
		"label": Color(1.0, 0.96, 0.88, 1.0)
	}


func _crown_population_successcion_pressure_value(target: Person, realm_id: int, section_kind: String) -> int:
	if target == null:
		return 0

	if MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id):
		return 100

	var succession_rank: int = int(target.succession_rank)
	var blood_proximity: float = 0.0
	if succession_rank > 0:
		blood_proximity = maxf(0.0, 100.0 - float(succession_rank * 7))

	var age_pressure: float = clampf(float(target.age) / 70.0 * 100.0, 0.0, 100.0)
	var loyalty_value: int = MainSceneLogic._crown_population_loyalty_value(gs, target, realm_id, section_kind)
	if loyalty_value < 0:
		loyalty_value = 100

	var popularity: float = float(clampi(int(round((float(target.fame) + float(target.respect) + float(target.approval)) / 3.0)), 0, 100))

	var ruler_health: float = 65.0
	var ruler: Person = MainSceneLogic._crown_population_realm_ruler_for(gs, realm_id)
	if ruler != null:
		ruler_health = clampf(float(ruler.health), 0.0, 100.0)

	var pressure: float = 0.0
	pressure += blood_proximity * 0.46
	pressure += age_pressure * 0.07
	pressure += popularity * 0.18
	pressure += float(100 - loyalty_value) * 0.13
	pressure += float(100.0 - ruler_health) * 0.16

	if _is_crown_population_noble_court_member(target, realm_id) and succession_rank > 0 and succession_rank <= 20:
		pressure += 8.0

	if bool(target.exiled) or bool(target.deposed):
		pressure += 14.0

	return clampi(int(round(pressure)), 0, 100)


func _crown_population_class_bleed_contract(target: Person, realm_id: int, section_kind: String, realm_name: String = "") -> Dictionary:
	var out:= {
		"active": false,
		"label": "",
		"tint": Color(1.0, 1.0, 1.0, 0.0),
		"pressure": 0
	}

	if target == null:
		return out

	var strata_key: String = _crown_population_citizen_strata_key(target, realm_id, realm_name) if has_method("_crown_population_citizen_strata_key") else "commoner"
	var wealth: int = int(target.bank_balance)
	var popularity: int = clampi(int(round((float(target.fame) + float(target.respect) + float(target.approval)) / 3.0)), 0, 100)

	if section_kind == "noble" and wealth < 5000 and popularity < 35:
		out ["active"] = true
		out ["label"] = "Noble decline"
		out ["tint"] = Color(0.9, 0.22, 0.24, 0.18)
		out ["pressure"] = clampi(45 + int((35 - popularity) * 0.9), 0, 100)
		return out

	if strata_key == "merchant" and (wealth >= 100000 or popularity >= 70):
		out ["active"] = true
		out ["label"] = "Merchant rising"
		out ["tint"] = Color(1.0, 0.78, 0.24, 0.18)
		out ["pressure"] = clampi(42 + int(popularity * 0.45), 0, 100)
		return out

	if strata_key == "peasant" and popularity >= 60:
		out ["active"] = true
		out ["label"] = "Lowborn ascent"
		out ["tint"] = Color(0.46, 0.92, 0.62, 0.16)
		out ["pressure"] = clampi(38 + int(popularity * 0.42), 0, 100)
		return out

	if target.partner != null and (_is_crown_population_noble_court_member(target.partner, realm_id) or _is_crown_population_royal_court_member(target.partner, realm_id)):
		out ["active"] = true
		out ["label"] = "Marriage bridge"
		out ["tint"] = Color(0.82, 0.58, 1.0, 0.18)
		out ["pressure"] = 62
		return out

	return out


func _crown_population_power_map_contract(target: Person, realm_id: int, section_kind: String, element: String = "", realm_name: String = "") -> Dictionary:
	var clean_section: String = str(section_kind).strip_edges().to_lower()
	var influence: int = MainSceneLogic._crown_population_influence_value(gs, target, realm_id, clean_section, element)
	var succession_pressure: int = _crown_population_successcion_pressure_value(target, realm_id, clean_section)
	var loyalty_value: int = MainSceneLogic._crown_population_loyalty_value(gs, target, realm_id, clean_section)
	if loyalty_value < 0:
		loyalty_value = 100

	var class_bleed: Dictionary = _crown_population_class_bleed_contract(target, realm_id, clean_section, realm_name)
	var claim_visuals_allowed: bool = clean_section == "official" or clean_section == "noble"

	var next_in_line: bool = false
	var unstable_claim: bool = false
	var rising_threat: bool = false

	if claim_visuals_allowed and target != null:
		next_in_line = int(target.succession_rank) == 1 and not MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id)
		unstable_claim = succession_pressure >= 58 and loyalty_value <= 42
		rising_threat = succession_pressure >= 72 and not MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id)

	if not claim_visuals_allowed:
		succession_pressure = 0

	return {
		"schema": "eralife.crown_population_power_map_view_contract",
		"version": 2,
		"target_id": int(target.id) if target != null else -1,
		"realm_id": realm_id,
		"section_kind": clean_section,
		"influence": influence,
		"succession_pressure": succession_pressure,
		"loyalty": loyalty_value,
		"class_bleed": class_bleed,
		"next_in_line": next_in_line,
		"unstable_claim": unstable_claim,
		"rising_threat": rising_threat,
		"claim_visuals_allowed": claim_visuals_allowed,
		"ui_is_renderer_only": true,
	}
func _crown_population_contextual_stat_rows(target: Person, realm_id: int, section_kind: String, element: String = "", realm_name: String = "") -> Array:
	var rows: Array = []
	if target == null:
		return rows

	var power: Dictionary = _crown_population_power_map_contract(target, realm_id, section_kind, element, realm_name)
	var loyalty_value: int = int(power.get("loyalty", 50))

	match section_kind:
		"official":
			rows.append({ "label": "Throne", "value": int(power.get("succession_pressure", 0))})
			rows.append({ "label": "Approval", "value": clampi(int(target.approval), 0, 100)})
			rows.append({ "label": "Influence", "value": int(power.get("influence", 0))})
			rows.append({ "label": "Loyalty", "value": loyalty_value})
		"noble":
			rows.append({ "label": "House", "value": clampi(int(round((float(target.fame) + float(target.respect)) / 2.0)), 0, 100)})
			rows.append({ "label": "Court", "value": int(power.get("influence", 0))})
			rows.append({ "label": "Claim", "value": int(power.get("succession_pressure", 0))})
			rows.append({ "label": "Loyalty", "value": loyalty_value})
		"master":
			var clean_element: String = str(element).strip_edges().to_lower()
			var mastery_value: int = 0
			if typeof(target.bending_mastery) == TYPE_DICTIONARY:
				mastery_value = int(target.bending_mastery.get(clean_element, 0))
			rows.append({ "label": "Influence", "value": int(power.get("influence", 0))})
			rows.append({ "label": "Respect", "value": clampi(int(target.respect), 0, 100)})
			rows.append({ "label": "Mental", "value": clampi(int(round(float(target.mental_health))), 0, 100)})
			rows.append({ "label": "Mastery", "value": clampi(mastery_value, 0, 100)})
		_:
			var strata_key: String = _crown_population_citizen_strata_key(target, realm_id, realm_name) if has_method("_crown_population_citizen_strata_key") else "commoner"
			if strata_key in ["merchant", "upper_class", "elite"]:
				rows.append({ "label": "Wealth", "value": clampi(int(round(log(max(1.0, float(target.bank_balance))) * 7.0)), 0, 100)})
				rows.append({ "label": "Trade", "value": clampi(int(round((float(target.smarts) + float(target.respect)) / 2.0)), 0, 100)})
				rows.append({ "label": "Market", "value": int(power.get("influence", 0))})
				rows.append({ "label": "Mental", "value": clampi(int(round(float(target.mental_health))), 0, 100)})
			elif strata_key in ["peasant", "low_class"]:
				rows.append({ "label": "Survival", "value": clampi(int(round((float(target.health) + float(100 - target.hunger)) / 2.0)), 0, 100)})
				rows.append({ "label": "Hunger", "value": clampi(int(round(float(target.hunger))), 0, 100)})
				rows.append({ "label": "Labor", "value": clampi(int(round((float(target.health) + float(target.mental_health)) / 2.0)), 0, 100)})
				rows.append({ "label": "Loyalty", "value": loyalty_value})
			else:
				rows.append({ "label": "Health", "value": clampi(int(round(float(target.health))), 0, 100)})
				rows.append({ "label": "Mental", "value": clampi(int(round(float(target.mental_health))), 0, 100)})
				rows.append({ "label": "Smarts", "value": clampi(int(round(float(target.smarts))), 0, 100)})
				rows.append({ "label": "Looks", "value": clampi(int(round(float(target.looks))), 0, 100)})

	return rows


func _append_crown_population_power_tags(parent: Control, target: Person, realm_id: int, section_kind: String, accent: Color, element: String = "", realm_name: String = "") -> void:
	if parent == null or target == null:
		return

	var power: Dictionary = _crown_population_power_map_contract(target, realm_id, section_kind, element, realm_name)
	var tags: Array = []

	if bool(power.get("next_in_line", false)):
		tags.append({ "text": "👑 NEXT IN LINE", "color": Color(1.0, 0.8, 0.24, 1.0)})
	if bool(power.get("rising_threat", false)):
		tags.append({ "text": "🔥 RISING CLAIM", "color": Color(1.0, 0.34, 0.22, 1.0)})
	elif bool(power.get("unstable_claim", false)):
		tags.append({ "text": "⚠ UNSTABLE CLAIM", "color": Color(1.0, 0.58, 0.22, 1.0)})

	var class_bleed: Dictionary = power.get("class_bleed", {}) if typeof(power.get("class_bleed", {})) == TYPE_DICTIONARY else {}
	if bool(class_bleed.get("active", false)):
		tags.append({ "text": "↯ %s" % str(class_bleed.get("label", "Class pressure")).to_upper(), "color": Color(accent.r, accent.g, accent.b, 1.0)})

	if tags.is_empty():
		return

	var row:= HBoxContainer.new()
	row.add_theme_constant_override("separation", 4)
	parent.add_child(row)

	for raw_tag in tags:
		var tag: Dictionary = raw_tag
		var chip:= Label.new()
		chip.text = str(tag.get("text", ""))
		chip.add_theme_font_size_override("font_size", 9)
		chip.add_theme_color_override("font_color", Color(tag.get("color", Color(1.0, 0.94, 0.72, 1.0))))
		row.add_child(chip)
func _append_crown_population_status_bar(parent: Control, label_text: String, value: int, accent: Color) -> void:
	var holder:= Control.new()
	holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	holder.custom_minimum_size = Vector2(0, 18)
	parent.add_child(holder)

	var palette: Dictionary = _crown_population_stat_palette(label_text, accent)
	var core: Color = Color(palette.get("core", Color(accent.r, accent.g, accent.b, 1.0)))
	var soft: Color = Color(palette.get("soft", Color(accent.r * 0.24, accent.g * 0.24, accent.b * 0.24, 0.98)))
	var glow: Color = Color(palette.get("glow", Color(accent.r, accent.g, accent.b, 0.22)))
