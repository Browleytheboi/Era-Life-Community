		relationship_profile_popup_edit_button.custom_minimum_size = Vector2(118, 42)
		relationship_profile_popup_edit_button.size_flags_horizontal = Control.SIZE_SHRINK_END
		relationship_profile_popup_edit_button.mouse_filter = Control.MOUSE_FILTER_STOP
		relationship_profile_popup_edit_button.focus_mode = Control.FOCUS_ALL
