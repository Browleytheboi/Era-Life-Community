func _build_crown_mediation_case() -> Dictionary:
	var candidates: Array = []
	if gs != null:
		for raw_npc in gs.npcs:
			if raw_npc == null or not (raw_npc is Person):
				continue
			var npc: Person = raw_npc as Person
			if gs.player != null and int(npc.id) == int(gs.player.id):
				continue
			if not npc.alive:
				continue
			candidates.append(npc)

	var left_name: String = "Mira Stone"
	var right_name: String = "Tomas Reed"
	var left_age: int = 34
	var right_age: int = 41
	var left_pressure: int = 62
	var right_pressure: int = 58

	if candidates.size() >= 2:
		var left: Person = candidates [int(randi_range(0, candidates.size() - 1))]
		var right: Person = candidates [int(randi_range(0, candidates.size() - 1))]
		if int(left.id) == int(right.id) and candidates.size() > 1:
			right = candidates [(candidates.find(left) + 1) % candidates.size()]
		left_name = ("%s %s" % [left.first_name, left.last_name]).strip_edges()
		right_name = ("%s %s" % [right.first_name, right.last_name]).strip_edges()
		left_age = int(left.age)
		right_age = int(right.age)
		left_pressure = clamp(100 - int(left.satisfaction), 0, 100)
		right_pressure = clamp(100 - int(right.satisfaction), 0, 100)

	var disputes: Array = [
		{
			"dispute": "%s says %s has been letting goats tear through the market garden, while %s says the garden fence was built across an old public path." % [left_name, right_name, right_name],
			"wise": "Order the path surveyed, repair the fence together, and split the goat damage through public mediation."
		},
		{
			"dispute": "%s claims %s borrowed family tools and returned them broken. %s says the tools were already damaged and the accusation is humiliating." % [left_name, right_name, right_name],
			"wise": "Have the tools repaired from a small shared fine, then require a witness ledger for future borrowing."
		},
		{
			"dispute": "%s says %s keeps spreading rumors at the well. %s says the rumors are warnings, not lies." % [left_name, right_name, right_name],
			"wise": "Separate truth from insult, require a public correction for false claims, and protect honest warnings."
		},
		{
			"dispute": "%s and %s both claim the same festival stall location, and both families say their grandparents used it first." % [left_name, right_name],
			"wise": "Rotate the stall yearly and give the opening morning to the family with documented prior use."
		}
	]

	var picked: Dictionary = disputes [int(randi_range(0, disputes.size() - 1))].duplicate(true)

	return {
		"intro": "Two citizens stand before your court. The room is tense, but not beyond repair.",
		"left_summary": "%s • Age %d • Pressure %d/100 %s" % [left_name, left_age, left_pressure, MainSceneHelpers._crown_tiny_stat_bar(left_pressure)],
		"right_summary": "%s • Age %d • Pressure %d/100 %s" % [right_name, right_age, right_pressure, MainSceneHelpers._crown_tiny_stat_bar(right_pressure)],
		"dispute": str(picked.get("dispute", "")),
		"choices": [
			{
				"label": "Hear both sides, name the wound, and give a balanced remedy",
				"wisdom_score": 88,
				"approval_delta": 5,
				"willpower_delta": 4,
				"result_text": "The dispute cools. Both citizens feel seen, even if neither got everything they wanted."
			},
			{
				"label": "Punish the louder citizen to restore order fast",
				"wisdom_score": 35,
				"approval_delta": -4,
				"willpower_delta": 0,
				"result_text": "The court goes quiet, but resentment leaves with them."
			},
			{
				"label": str(picked.get("wise", "Create a practical compromise and make both parties share repair costs.")),
				"wisdom_score": 94,
				"approval_delta": 7,
				"willpower_delta": 6,
				"result_text": "Your solution lands with unusual clarity. The court murmurs like it just watched wisdom become policy."
			},
			{
				"label": "Dismiss them and tell them to solve it outside",
				"wisdom_score": 15,
				"approval_delta": -7,
				"willpower_delta": 0,
				"result_text": "The citizens leave angrier than they arrived. The court remembers."
			}
		]
	}


func _next_crown_diplomacy_stream_generation() -> int:
	var generation: int = int(get_meta("crown_diplomacy_stream_generation", 0)) + 1
	set_meta("crown_diplomacy_stream_generation", generation)
	return generation


func _crown_diplomacy_stream_is_current(generation: int) -> bool:
	if not crown_hub_open:
		return false
	if crown_hub_overlay == null or not is_instance_valid(crown_hub_overlay):
		return false
	if not crown_hub_overlay.visible:
		return false
	if crown_hub_current_section != "diplomacy":
		return false
	return int(get_meta("crown_diplomacy_stream_generation", 0)) == int(generation)


