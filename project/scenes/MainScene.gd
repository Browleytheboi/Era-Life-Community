		"font_disabled_color",
		Color(0.82, 0.82, 0.84, 0.58)
	)
	button.add_theme_color_override(
		"font_shadow_color",
		Color(
			core_color.r,
			core_color.g,
			core_color.b,
			0.38
		)
	)
	button.add_theme_constant_override("shadow_offset_x", 0)
	button.add_theme_constant_override("shadow_offset_y", 2)
	button.add_theme_font_size_override("font_size", 24)

	button.set_meta(
		"runtime_floating_hud_visual_contract_applied",
		true
	)
	button.set_meta(
		"runtime_floating_hud_visual_signature",
		visual_signature
	)
	button.set_meta(
		"runtime_floating_hud_visual_core_color",
