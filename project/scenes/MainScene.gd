func _sync_startup_intro_audio_contract(
	reason: String = "startup_intro",
	force_restart_audio: bool = false
) -> void:
	if not era_audio_enabled:
		return

	var engine = _ensure_era_audio_engine()

	if engine == null:
		return

	set_meta(
		"god_mode_audio_fadeout_requested",
		true
	)
	set_meta(
		"god_mode_audio_handoff_armed",
		false
	)

	var should_force_restart: bool = (
		force_restart_audio
		or bool(
			get_meta(
				"startup_intro_force_audio_restart_on_next_sync",
				false
			)
		)
	)
	var context: Dictionary = (
		_startup_intro_audio_context(
			reason
		)
	)

	if should_force_restart:
		context ["force_restart_audio"] = true
		context ["audio_force_restart"] = true
		context [
			"audio_restart_policy"
		] = "force_from_beginning"
		context ["audio_fade_ms"] = 35

		set_meta(
			"startup_intro_force_audio_restart_on_next_sync",
			false
		)
	else:
		context ["force_restart_audio"] = false

	var report: Dictionary = (
		engine.apply_audio_contract(
			era_audio_contract,
			context
		)
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var audio_started: bool = bool(
		report.get(
			"audio_started",
			false
		)
	)
	var audio_pending: bool = bool(
		report.get(
			"pending",
			false
		)
	)
	var audio_claim_accepted: bool = bool(
		report.get(
			"success",
			false
		)
	)
	var visual_epoch_ms: int = int(
		get_meta(
			"startup_intro_visual_epoch_ms",
			0
		)
	)




	if (
		visual_epoch_ms <= 0
		or should_force_restart
		or not bool(
			get_meta(
				"startup_intro_sequence_runner_active",
				false
			)
		)
	):
		visual_epoch_ms = now_ms

	set_meta(
		"startup_intro_visual_epoch_ms",
		visual_epoch_ms
	)
	set_meta(
		"startup_intro_contract_audio_active",
		audio_started
	)
	set_meta(
		"startup_intro_contract_audio_pending",
		audio_pending
	)
	set_meta(
		"startup_intro_audio_claim_accepted",
		audio_claim_accepted
	)
	if audio_started:
		visual_epoch_ms = now_ms

	set_meta(
		"startup_intro_visual_epoch_ms",
		visual_epoch_ms
	)
	set_meta(
		"startup_intro_audio_started_at_ms",
		(
			now_ms
			if audio_started
			else 0
		)
	)
	set_meta(
		"startup_intro_audio_claimed_at_ms",
		now_ms
	)
	set_meta(
		"startup_intro_audio_last_reason",
		reason
	)
	set_meta(
		"startup_intro_audio_last_report",
		report.duplicate(true)
	)
	set_meta(
		"startup_intro_audio_force_restart_last_used",
		should_force_restart
	)
	set_meta(
		"startup_intro_audio_force_restart_last_used_at_ms",
		now_ms if should_force_restart else 0
	)
	set_meta(
		"startup_intro_visual_waits_for_pending_audio",
		audio_pending
	)
	set_meta(
		"startup_intro_pending_audio_may_not_zero_visual_epoch",
		true
	)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"startup_intro_audio_contract_last_report"
		] = report.duplicate(true)
		gs.scenario_state [
			"startup_intro_audio_contract_last_reason"
		] = reason
		gs.scenario_state [
			"startup_intro_audio_contract_last_sync_at_ms"
		] = now_ms
		gs.scenario_state [
			"startup_intro_audio_started"
		] = audio_started
		gs.scenario_state [
			"startup_intro_audio_pending"
		] = audio_pending
		gs.scenario_state [
			"startup_intro_audio_force_restart_last_used"
		] = should_force_restart
		gs.scenario_state [
			"startup_intro_visual_epoch_ms"
		] = visual_epoch_ms
		gs.scenario_state [
			"startup_intro_pending_audio_may_not_skip_visual_sequence"
		] = true
func _transition_audio_from_startup_intro_to_god_mode(reason: String = "startup_intro_exit", fade_ms: int = 760) -> void:
