func _show_save_load_reality_build_panel(context: Dictionary = {}) -> void:
	_ensure_save_load_reality_build_panel()
	save_load_reality_build_open = true
	_update_save_load_reality_build_panel(context)
	if save_load_reality_build_panel != null:
		save_load_reality_build_panel.visible = true
		save_load_reality_build_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE


func _update_save_load_reality_build_panel(
	context: Dictionary = {}
) -> void:
	_ensure_save_load_reality_build_panel()

	if save_load_reality_build_panel == null:
		return

	if (
		save_load_reality_build_title_label != null
		and context.has("title")
	):
		save_load_reality_build_title_label.text = str(
			context.get(
				"title",
				"Reconstructing Saved Life"
			)
		)

	if (
		save_load_reality_build_body_label != null
		and context.has("body")
	):
		save_load_reality_build_body_label.text = str(
			context.get(
				"body",
				""
			)
		)

	if save_load_reality_build_status_label != null:
		var status_text: String = str(
			context.get(
				"status",
				""
			)
		).strip_edges()

		if status_text == "":
			status_text = (
				MainSceneLogic._save_load_reality_build_status_from_scheduler(gs)
			)

		save_load_reality_build_status_label.text = status_text

	if save_load_reality_build_progress_bar != null:
		var progress: float = clampf(
			float(
				context.get(
					"progress",
					_save_load_reality_build_progress_from_scheduler()
				)
			),
			0.0,
			1.0
		)
		save_load_reality_build_progress_bar.value = (
			progress * 100.0
		)

	var interaction_state: String = str(
		context.get(
			"interaction_state",
			"buffered"
		)
	).strip_edges().to_lower()
	var root:= get_node_or_null(
		"UIContainer"
	) as Control
	var live_shell_committed: bool = (
		gs != null
		and gs.player != null
		and root != null
		and is_instance_valid(root)
		and root.visible
		and bool(
			get_meta(
				"playable_life_shell_atomic_visual_commit_complete",
				false
			)
		)
	)
	var should_present: bool = not (
		interaction_state == "live"
		and live_shell_committed
	)

	save_load_reality_build_panel.visible = should_present
	save_load_reality_build_open = should_present
	save_load_reality_build_panel.modulate = Color.WHITE
	save_load_reality_build_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)

	set_meta(
		"save_load_reality_build_panel_suppressed_by_live_shell",
		not should_present
	)


func _hide_save_load_reality_build_panel(
	force: bool = false
) -> void:
	if save_load_reality_build_panel == null:
		return

	if not force:
		save_load_reality_build_panel.modulate = Color(
			1.0,
			1.0,
			1.0,
			0.92
		)

		var tree:= get_tree()

		if tree == null:
			_hide_save_load_reality_build_panel(true)
			return

		var timer:= tree.create_timer(1.25)
		timer.timeout.connect(
			Callable(
				self,
				"_hide_save_load_reality_build_panel"
			).bind(true),
			CONNECT_ONE_SHOT
		)
		return

	save_load_reality_build_panel.visible = false
	save_load_reality_build_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	save_load_reality_build_panel.modulate = Color.WHITE
	save_load_reality_build_open = false

func _save_load_reality_build_progress_from_scheduler() -> float:
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return 0.5

	var queue_size: int = int(gs.scenario_state.get("background_hydration_queue_size", 0))
	if queue_size <= 0:
		return 1.0

	var last_queue_size: int = max(1, int(get_meta("background_hydration_last_queue_size", queue_size)))
	return clamp(0.68 + (float(last_queue_size - queue_size) / float(last_queue_size)) * 0.28, 0.68, 0.96)
func _clear_loaded_game_transient_loading_state() -> void:
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_loading_finish_wait_started_ms", 0)
	set_meta("age_up_loading_safe_handoff_rekick_requested", false)
	set_meta("age_up_loading_safe_handoff_attempts", 0)
	set_meta("age_up_loading_prewarm_ready", false)
	set_meta("age_up_loading_visual_bucket", -1)

	if age_up_loading_runtime_active:
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null:
		age_up_loading_overlay.visible = false

	age_up_loading_runtime_active = false
	age_up_loading_finish_requested = false
	age_up_loading_result = {}
	age_up_loading_exit_started_ms = 0
	age_up_loading_paint_hold_frames = 0

	if age_up_loading_exit_tween != null:
		age_up_loading_exit_tween.kill()
		age_up_loading_exit_tween = null

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state ["loading_runtime"] = {}
		gs.scenario_state ["age_up_tail_runtime_pending"] = false
		gs.scenario_state ["age_up_deferred_flush_pending"] = false
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["birth_shell_deferred_boot_pending"] = false
		gs.scenario_state ["birth_shell_deferred_boot_complete"] = true

		gs.scenario_state.erase("speculative_next_year_cache")
		gs.scenario_state.erase("age_up_tail_runtime_next_ms")
		gs.scenario_state.erase("age_up_tail_runtime_started_ms")
		gs.scenario_state.erase("age_up_tail_runtime_reason")
		gs.scenario_state.erase("age_up_tail_last_phase")
		gs.scenario_state.erase("age_up_deferred_flush_next_ms")


func _save_current_life_to_slot(manual_preserve: bool = true) -> void:
	if gs == null or gs.player == null:
		if world_actions_status_label != null:
			world_actions_status_label.text = "No active life to preserve."
		return

	if bool(get_meta("world_lineage_save_in_progress", false)):
		if world_actions_status_label != null:
			world_actions_status_label.text = "Preserving lineage already..."
		return

	MainSceneHelpers._ensure_saved_lives_dir()

	var save_path: String = _build_current_save_slot_path() if manual_preserve else MainSceneLogic._build_current_auto_preserve_path(gs)
	set_meta("world_lineage_save_in_progress", true)
	set_meta("world_lineage_save_path", save_path)
	set_meta("world_lineage_save_manual_preserve", manual_preserve)
	set_meta("world_lineage_save_started_ms", int(Time.get_ticks_msec()))

	if world_actions_status_label != null:
		if manual_preserve:
			world_actions_status_label.text = "Preserving lineage..."
		else:
			world_actions_status_label.text = "Auto-preserving lineage..."

	call_deferred("_save_current_life_to_slot_deferred", save_path, manual_preserve)
func _save_current_life_to_slot_deferred(
	path: String,
	manual_preserve: bool = true
) -> void:
	var started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_path: String = str(
		path
	).strip_edges()

	if clean_path == "":
		set_meta(
			"world_lineage_save_in_progress",
			false
		)

		if world_actions_status_label != null:
			world_actions_status_label.text = (
				"Could not build a save path."
			)

		return

	if (
		gs == null
		or gs.player == null
	):
		set_meta(
			"world_lineage_save_in_progress",
			false
		)

		if world_actions_status_label != null:
			world_actions_status_label.text = (
				"No active life to preserve."
			)

		return

	if world_actions_status_label != null:
		world_actions_status_label.text = (
			"Saving life and reality checkpoint..."
		)

	var actor_id: int = int(
		gs.player.id
	)
	var actor_first_name: String = str(
		gs.player.first_name
	).strip_edges()
	var residency_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()

	if (
		residency_signature == ""
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		residency_signature = str(
			gs.scenario_state.get(
				"resident_runtime_attached_signature",
				gs.scenario_state.get(
					"resident_runtime_signature",
					""
				)
			)
		).strip_edges()

	var checkpoint_first_frame_snapshot: Dictionary = {}

	if typeof(
		gs.scenario_state
	) == TYPE_DICTIONARY:
		var first_frame_raw: Variant = (
			gs.scenario_state.get(
				"zero_frame_consciousness_switch_surface",
				gs.scenario_state.get(
					"prebuilt_first_frame_ui_snapshot",
					{}
				)
			)
		)

		if typeof(
			first_frame_raw
		) == TYPE_DICTIONARY:
			checkpoint_first_frame_snapshot = (
				first_frame_raw as Dictionary
			).duplicate(false)

	if checkpoint_first_frame_snapshot.is_empty():
		checkpoint_first_frame_snapshot = (
			_build_first_frame_ui_snapshot_from_game_state(
				gs,
				"world_feed_reality_checkpoint"
			)
		)

	var save_options: Dictionary = {
		"source": (
			"world_tab_manual_preserve"
			if manual_preserve
			else "world_tab_auto_preserve"
		),
		"profile": (
			"interactive_manual_reality_checkpoint"
			if manual_preserve
			else "interactive_auto_reality_checkpoint"
		),
		"interactive_save": true,
		"fast_interactive_universe_save": true,
		"checkpoint_save": true,
		"checkpoint_actor_id": actor_id,
		"actor_id": actor_id,
		"controlled_actor_id": actor_id,
		"residency_signature": residency_signature,
		"checkpoint_residency_signature": (
			residency_signature
		),
		"checkpoint_current_panel": current_panel,
		"current_panel": current_panel,
		"active_context": current_panel,
		"checkpoint_first_frame_snapshot": (
			checkpoint_first_frame_snapshot.duplicate(false)
		),
		"preserve_unknown_slices": false,
		"write_structured_slices": false,
		"deferred_reason": (
			"world_tab_reality_checkpoint_preserve"
		),
		"skip_memory_compaction": true,
		"skip_world_feed_normalization": true,
		"skip_prune": true,
		"skip_archive": true,
		"skip_warm_runtime_snapshot": true,
		"skip_runtime_registry_refresh": true,
		"skip_summary_cache": false,
		"skip_last_payload_cache": true,
		"skip_cross_device_checkpoint": true,
		"skip_continuity_capsule": true,
		"scene_route": current_panel,
		"ui_surface": "world_actions_panel",
		"checkpoint_dependencies_must_be_hot": true,
		"checkpoint_actor_limit": 256,
		"ui_is_expression_only": true,
	}

	# FIX: "target_engine_unavailable" on Save Game. The intent below routes to
	# gs.game_state_serialization_runtime, but that engine is created lazily -- only
	# inside GameState.save_game() and one other path. If neither has run in this
	# session the property is still null, the route resolves to nothing, and the save
	# fails with that reason instead of saving. Create it before routing.
	if gs != null and gs.game_state_serialization_runtime == null:
		gs.game_state_serialization_runtime = GameStateSerializationRuntime.new(gs)

	var save_report: Dictionary = (
		_request_runtime_engine_method_intent(
			"game_state_serialization_runtime",
			"save_interactive_reality_checkpoint",
			[
				clean_path,
				save_options
			],
			"preserve_lineage_checkpoint",
			"mainscene.world_save_preserve_lineage"
		)
	)

	var checkpoint_raw: Variant = (
		save_report.get(
			"reality_checkpoint_commit",
			{}
		)
	)
	var checkpoint_report: Dictionary = (
		(checkpoint_raw as Dictionary).duplicate(false)
		if typeof(
			checkpoint_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var summary_raw: Variant = save_report.get(
		"summary",
		{}
	)
	var save_summary: Dictionary = (
		(summary_raw as Dictionary).duplicate(false)
		if typeof(
			summary_raw
		) == TYPE_DICTIONARY
		else {}
	)



	var file_saved: bool = bool(
		save_report.get(
			"wrote_file",
			save_report.get(
				"success",
				false
			)
		)
	)
	var checkpoint_saved: bool = bool(
		checkpoint_report.get(
			"success",
			false
		)
	)
	var save_succeeded: bool = (
		bool(
			save_report.get(
				"success",
				false
			)
		)
		and file_saved
		and checkpoint_saved
	)

	var finished_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var duration_ms: int = maxi(
		0,
		finished_at_ms - started_at_ms
	)

	set_meta(
		"world_lineage_save_in_progress",
		false
	)
	set_meta(
		"world_lineage_save_last_report",
		save_report.duplicate(false)
	)
	set_meta(
		"world_lineage_checkpoint_last_report",
		checkpoint_report.duplicate(false)
	)
	set_meta(
		"world_lineage_save_last_summary",
		save_summary.duplicate(false)
	)
	set_meta(
		"world_lineage_save_last_duration_ms",
		duration_ms
	)
	set_meta(
		"world_lineage_save_created_reality_checkpoint",
		checkpoint_saved
	)
	set_meta(
		"world_lineage_save_checkpoint_actor_id",
		actor_id
	)
	set_meta(
		"world_lineage_save_checkpoint_signature",
		residency_signature
	)
	set_meta(
		"world_lineage_save_renderer_called_engine_directly",
		false
	)
	set_meta(
		"world_lineage_save_global_intent_routed",
		bool(
			save_report.get(
				"global_intent_routed",
				false
			)
		)
	)
	set_meta(
		"world_lineage_save_full_universe_walk_performed",
		bool(
			save_report.get(
				"full_universe_walk_performed",
				false
			)
		)
	)

	EraLog.truth(
		(
			"ERALIFE_LINEAGE_SAVE_LENS_TRUTH"
			+ "|success=%s"
			+ "|actor_id=%d"
			+ "|file_saved=%s"
			+ "|checkpoint_saved=%s"
			+ "|global_intent_routed=%s"
			+ "|renderer_called_engine_directly=false"
			+ "|full_universe_walk=%s"
			+ "|duration_ms=%d"
			+ "|at_ms=%d"
		)
		% [
			str(save_succeeded).to_lower(),
			actor_id,
			str(file_saved).to_lower(),
			str(checkpoint_saved).to_lower(),
			str(
				save_report.get(
					"global_intent_routed",
					false
				)
			).to_lower(),
			str(
				save_report.get(
					"full_universe_walk_performed",
					false
				)
			).to_lower(),
			duration_ms,
			finished_at_ms
		]
	)

	if world_actions_status_label != null:
		if save_succeeded:
			if manual_preserve:
				world_actions_status_label.text = (
					"Saved %s and their reality checkpoint."
					% actor_first_name
				)
			else:
				world_actions_status_label.text = (
					"Auto-saved %s and their reality checkpoint."
					% actor_first_name
				)
		elif file_saved:
			world_actions_status_label.text = (
				(
					"Life file was written, but the reality "
					+ "checkpoint could not be committed."
				)
			)
		else:
			var failure_reason: String = str(
				save_report.get(
					"reason",
					"Save failed."
				)
			).strip_edges()

			if failure_reason == "":
				failure_reason = "Save failed."

			world_actions_status_label.text = (
				failure_reason
			)

	if (
		save_succeeded
		and saved_life_picker_popup != null
		and saved_life_picker_popup.visible
	):
		_refresh_saved_life_picker_list()
func _prepare_reality_fusion_universe_entry(path: String, label: String) -> void:
	if gs == null or gs.player == null:
		return

	var snapshot: Dictionary = {}
	if gs.has_method("_serialize_npc"):
		snapshot = gs.call("_serialize_npc", gs.player)
	else:
		for prop in gs.player.get_property_list():
			var prop_name: String = str(prop.name)
			snapshot [prop_name] = gs.player.get(prop_name)

	snapshot ["reality_fusion_original_player_id"] = int(gs.player.id)
	snapshot ["reality_fusion_original_universe_year"] = int(gs.year)
	snapshot ["reality_fusion_entered_from_label"] = str(label)

	if gs.player.has_method("export_contract_slice"):
		snapshot ["person_contract_slice"] = gs.player.call("export_contract_slice", {
			"source": "reality_fusion_universe_entry",
			"entered_from_label": str(label),
			"original_player_id": int(gs.player.id),
			"original_universe_year": int(gs.year),
		})

	var source_mode: String = "unknown"
	if gs.has_method("get_reality_mode"):
		source_mode = str(gs.get_reality_mode())

	var diary_snapshot: Array = []
	if has_method("_ensure_active_life_diary_loaded"):
		_ensure_active_life_diary_loaded(false)

	for raw_entry in age_up_diary_entries:
		if typeof(raw_entry) == TYPE_ARRAY:
			diary_snapshot.append((raw_entry as Array).duplicate(true))
		else:
			var line: String = str(raw_entry).strip_edges()
			if line != "":
				diary_snapshot.append([line])

	var current_output_text: String = ""
	if output_label != null:
		current_output_text = str(output_label.text)

	set_meta("reality_fusion_entering_player_snapshot", snapshot)
	set_meta("reality_fusion_entering_universe_path", str(path).strip_edges())
	set_meta("reality_fusion_entering_universe_label", str(label).strip_edges())
	set_meta("reality_fusion_entering_source_mode", source_mode)
	set_meta("reality_fusion_entering_diary_entries", diary_snapshot)
	set_meta("reality_fusion_entering_output_text", current_output_text)
	set_meta("reality_fusion_entering_diary_target_label", str(label).strip_edges())
func _try_attach_ready_checkpoint_immediately(
	path: String,
	load_options: Dictionary
) -> bool:
	var clean_path: String = str(path).strip_edges()

	if (
		clean_path == ""
		or not FileAccess.file_exists(clean_path)
	):
		return false

	var signature: String = (
		MainSceneLogic._checkpoint_residency_signature_from_load_options(
			clean_path,
			load_options
		)
	)
	var resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options(
			load_options
		)
	)

	if signature == "":
		return false

	var attach_report: Dictionary = (
		_request_reality_residency_intent(
			"attach",
			{
				"signature": signature,
				"checkpoint_path": clean_path,
				"checkpoint_resume_contract": (
					resume_contract.duplicate(false)
				),
				"checkpoint_attach": true,
				"pause_checkpoint_tail_while_lens_attached": true,
				"runtime_rebuild_forbidden": true,
				"attach_on_input_frame": true
			},
			(
				"mainscene.title_card_continue."
				+ "attach_existing_ready_checkpoint"
			)
		)
	)
	var resident_raw: Variant = attach_report.get(
		"game_state",
		attach_report.get(
			"runtime_ref",
			null
		)
	)

	if (
		not bool(attach_report.get("success", false))
		or not (resident_raw is GameState)
	):
		return false

	var resident_gs: GameState = resident_raw as GameState
	var attached_resume_raw: Variant = attach_report.get(
		"checkpoint_resume_contract",
		resume_contract
	)
	var attached_resume_contract: Dictionary = (
		(attached_resume_raw as Dictionary).duplicate(false)
		if typeof(attached_resume_raw) == TYPE_DICTIONARY
		else resume_contract.duplicate(false)
	)
	var first_frame_raw: Variant = attach_report.get(
		"checkpoint_first_frame_ui_snapshot",
		attached_resume_contract.get(
			"first_frame_ui_snapshot",
			{}
		)
	)

	if (
		attached_resume_contract.is_empty()
		and typeof(first_frame_raw) != TYPE_DICTIONARY
	):
		return false

	if not _adopt_attached_resident_game_state(
		resident_gs,
		signature
	):
		return false

	var immediate_options: Dictionary = load_options.duplicate(false)
	immediate_options ["residency_signature"] = signature
	immediate_options ["checkpoint_resume_contract"] = (
		attached_resume_contract.duplicate(false)
	)
	immediate_options ["entry_surface"] = "title_card_continue"
	immediate_options ["immediate_resident_attach"] = true
	immediate_options ["runtime_rebuild_forbidden"] = true
	immediate_options [
		"binary_decode_is_not_first_frame_authority"
	] = true

	set_meta(
		"saved_life_resident_chassis_pending",
		false
	)
	set_meta(
		"saved_life_resident_chassis_ready",
		true
	)
	set_meta(
		"saved_life_resident_chassis_ready_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"saved_life_residency_request_pending",
		false
	)
	set_meta(
		"title_card_continue_immediate_resident_attach",
		true
	)

	_present_attached_checkpoint_lens_now(
		attached_resume_contract,
		attach_report,
		immediate_options,
		0
	)

	return true
func _load_life_from_slot(
	path: String,
	load_options: Dictionary = {}
) -> void:
	var clean_path: String = str(
		path
	).strip_edges()

	if clean_path == "":
		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = (
				"That save slot does not point to a file."
			)
		return

	if not FileAccess.file_exists(
		clean_path
	):
		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = (
				"That save file is missing."
			)

		if world_actions_status_label != null:
			world_actions_status_label.text = (
				"That save file is missing."
			)
		return

	_bootstrap_gs_for_save_load_if_needed()

	var live_load_options: Dictionary = (
		load_options.duplicate(false)
	)

	live_load_options ["source"] = str(
		live_load_options.get(
			"source",
			"saved_lineage_picker"
		)
	)
	live_load_options ["load_mode"] = str(
		live_load_options.get(
			"load_mode",
			"playable_first"
		)
	)
	live_load_options ["profile"] = str(
		live_load_options.get(
			"profile",
			"live_saved_life_shell"
		)
	)
	live_load_options ["background_enabled"] = bool(
		live_load_options.get(
			"background_enabled",
			true
		)
	)
	live_load_options ["live_shell_requested"] = true
	live_load_options ["contract_driven_existence"] = true
	live_load_options ["deferred_reality"] = true
	live_load_options ["buffered_intention"] = true
	live_load_options ["live_system_emergence"] = true
	live_load_options ["entry_surface"] = str(
		live_load_options.get(
			"entry_surface",
			get_meta(
				"saved_life_load_entry_surface",
				"saved_life_picker"
			)
		)
	)
	live_load_options ["saved_life_label"] = str(
		live_load_options.get(
			"saved_life_label",
			"Saved Life"
		)
	)

	var resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options(
			live_load_options
		)
	)
	var canonical_signature: String = (
		MainSceneLogic._checkpoint_residency_signature_from_load_options(
			clean_path,
			live_load_options
		)
	)
	var title_card_continue: bool = (
		str(
			live_load_options.get(
				"entry_surface",
				""
			)
		).strip_edges() == "title_card_continue"
	)
	var previous_reality_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()
	var previous_reality_shell_visible: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)

	live_load_options ["residency_signature"] = (
		canonical_signature
	)
	live_load_options ["resident_reattach_preferred"] = true
	live_load_options [
		"resident_runtime_rebuild_forbidden"
	] = true
	live_load_options ["checkpoint_resume_contract"] = (
		resume_contract.duplicate(false)
	)
	live_load_options [
		"transactional_reality_switch"
	] = true
	live_load_options [
		"preserve_active_reality_until_commit"
	] = true
	live_load_options [
		"checkpoint_reservation_declared"
	] = bool(
		live_load_options.get(
			"checkpoint_reservation_declared",
			false
		)
	)
	live_load_options [
		"attach_on_input_frame"
	] = false
	live_load_options [
		"previous_reality_signature"
	] = previous_reality_signature
	live_load_options [
		"previous_reality_shell_visible"
	] = previous_reality_shell_visible



	if not title_card_continue:
		_close_saved_life_picker()
	else:
		set_meta(
			"title_card_continue_reconstruction_panel_suppressed",
			true
		)
		set_meta(
			"title_card_continue_uses_checkpoint_resume_contract",
			not resume_contract.is_empty()
		)
		set_meta(
			"title_card_continue_uses_canonical_residency_signature",
			canonical_signature != ""
		)

	set_meta(
		"saved_life_residency_request_pending",
		true
	)
	set_meta(
		"saved_life_residency_signature",
		canonical_signature
	)
	set_meta(
		"saved_life_checkpoint_resume_contract",
		resume_contract.duplicate(false)
	)
	set_meta(
		"saved_reality_transaction_target_signature",
		canonical_signature
	)
	set_meta(
		"saved_reality_transaction_target_path",
		clean_path
	)
	set_meta(
		"saved_reality_transaction_prepare_active",
		true
	)
	set_meta(
		"saved_reality_transaction_existing_reality_remains_authoritative",
		true
	)
	set_meta(
		"saved_reality_transaction_transition_runtime_used",
		false
	)
	set_meta(
		"saved_reality_transaction_loading_overlay_used",
		false
	)
	set_meta(
		"saved_reality_transaction_click_work",
		false
	)
	set_meta(
		"saved_reality_transaction_requested_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	call_deferred(
		"_load_life_from_slot_deferred",
		clean_path,
		live_load_options
	)
func _rollback_checkpoint_reality_handoff_attach(
	previous_signature: String,
	target_signature: String,
	reason: String
) -> void:
	var clean_previous: String = str(
		previous_signature
	).strip_edges()
	var clean_target: String = str(
		target_signature
	).strip_edges()
	var clean_reason: String = str(
		reason
	).strip_edges()

	if clean_previous != "":
		_request_reality_residency_intent(
			"attach",
			{
				"signature": clean_previous,
				"checkpoint_attach": false,
				"runtime_rebuild_forbidden": true,
				"attach_on_input_frame": false,
				"source": (
					"checkpoint_reality_handoff_rollback"
				)
			},
			(
				"mainscene."
				+ "checkpoint_reality_handoff_rollback"
			)
		)
	elif clean_target != "":
		_request_reality_residency_intent(
			"detach",
			{
				"signature": clean_target,
				"source": (
					"checkpoint_reality_handoff_rollback"
				)
			},
			(
				"mainscene."
				+ "checkpoint_reality_handoff_rollback"
			)
		)

	set_meta(
		"checkpoint_reality_handoff_rolled_back",
		true
	)
	set_meta(
		"checkpoint_reality_handoff_rollback_reason",
		clean_reason
	)
	set_meta(
		"checkpoint_reality_handoff_rollback_previous_signature",
		clean_previous
	)
	set_meta(
		"checkpoint_reality_handoff_rollback_target_signature",
		clean_target
	)
	set_meta(
		"checkpoint_reality_handoff_rollback_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _publish_saved_reality_transaction_observation(
	label: String,
	stage_id: String,
	progress: float,
	resident_ready: bool,
	projection_ready: bool
) -> void:
	var clean_label: String = str(
		label
	).strip_edges()
	var clean_stage: String = str(
		stage_id
	).strip_edges()

	if clean_label == "":
		clean_label = "Saved Reality"

	if clean_stage == "":
		clean_stage = "resident_core"

	var percent: int = clampi(
		int(
			round(
				clampf(
					progress,
					0.0,
					1.0
				) * 100.0
			)
		),
		0,
		100
	)
	var status_text: String = ""

	if resident_ready:
		status_text = (
			"%s resident core is hot. Rebinding the Life lens..."
			% clean_label
		)
	else:
		status_text = (
			"Observing %s • %s • %d%%"
			% [
				clean_label,
				_residency_stage_label(
					clean_stage
				),
				percent
			]
		)

	if (
		world_actions_status_label != null
		and is_instance_valid(
			world_actions_status_label
		)
	):
		world_actions_status_label.text = status_text

	if (
		saved_life_picker_status_label != null
		and is_instance_valid(
			saved_life_picker_status_label
		)
		and saved_life_picker_popup != null
		and is_instance_valid(
			saved_life_picker_popup
		)
		and saved_life_picker_popup.visible
	):
		saved_life_picker_status_label.text = status_text

	set_meta(
		"saved_reality_observation_stage",
		clean_stage
	)
	set_meta(
		"saved_reality_observation_progress",
		clampf(
			progress,
			0.0,
			1.0
		)
	)
	set_meta(
		"saved_reality_observation_resident_ready",
		resident_ready
	)
	set_meta(
		"saved_reality_observation_projection_enrichment_ready",
		projection_ready
	)
	set_meta(
		"saved_reality_observation_projection_blocks_handoff",
		false
	)
	set_meta(
		"saved_reality_observation_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _load_life_from_slot_deferred(
	path: String,
	load_options: Dictionary = {}
) -> void:
	var clean_path: String = str(
		path
	).strip_edges()

	if clean_path == "":
		_finish_failed_life_load(
			"That save slot does not point to a file."
		)
		return

	if not FileAccess.file_exists(
		clean_path
	):
		_finish_failed_life_load(
			"That save file is missing."
		)
		return

	_bootstrap_gs_for_save_load_if_needed()

	if gs == null:
		_finish_failed_life_load(
			"Reality residency could not be created."
		)
		return

	var signature: String = (
		MainSceneLogic._checkpoint_residency_signature_from_load_options(
			clean_path,
			load_options
		)
	)
	var resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options(
			load_options
		)
	)
	var continue_raw: Variant = load_options.get(
		"continue_contract",
		{}
	)
	var continue_contract: Dictionary = (
		continue_raw as Dictionary
		if typeof(continue_raw) == TYPE_DICTIONARY
		else {}
	)
	var entry_surface: String = str(
		load_options.get(
			"entry_surface",
			get_meta(
				"saved_life_load_entry_surface",
				"saved_life_picker"
			)
		)
	).strip_edges()
	var title_card_continue: bool = (
		entry_surface == "title_card_continue"
	)
	var previous_signature: String = str(
		load_options.get(
			"previous_reality_signature",
			reality_residency_attached_signature
		)
	).strip_edges()
	var previous_shell_visible: bool = bool(
		load_options.get(
			"previous_reality_shell_visible",
			_playable_life_shell_has_visible_sovereignty()
		)
	)
	var saved_life_label: String = str(
		load_options.get(
			"saved_life_label",
			"Saved Reality"
		)
	).strip_edges()

	if signature == "":
		_finish_failed_life_load(
			"Saved-life residency signature is missing."
		)
		return

	var next_load_options: Dictionary = (
		load_options.duplicate(false)
	)

	next_load_options [
		"checkpoint_path"
	] = clean_path

	var reservation_declared: bool = bool(
		next_load_options.get(
			"checkpoint_reservation_declared",
			false
		)
	)
	var status_report: Dictionary = {}

	# DIAGNOSTIC: this is the load path the picker actually uses -- the earlier
	# instrumentation went on _load_saved_life_playable_first(), which has no callers
	# at all. Report which residency branch runs and what it returns.
	var load_slot_log_count: int = int(get_meta("load_slot_entry_log_count", 0)) + 1
	set_meta("load_slot_entry_log_count", load_slot_log_count)

	if load_slot_log_count <= 3 or load_slot_log_count % 500 == 0:
		EraLog.truth(
			"ERALIFE_LOAD_SLOT|attempt=%d|signature=%s|reservation_declared=%s|path=%s"
			% [load_slot_log_count, str(signature), str(reservation_declared), str(clean_path)]
		)

	if reservation_declared:
		status_report = (
			_request_reality_residency_intent(
				"status",
				{
					"signature": signature,
					"source": (
						"saved_reality_transaction_observation"
					),
					"transactional_reality_switch": true,
				},
				(
					"mainscene."
					+ "saved_reality_transaction_observation"
				)
			)
		)
	else:
		status_report = (
			_request_reality_residency_intent(
				"reserve_checkpoint",
				{
					"signature": signature,
					"checkpoint_path": clean_path,
					"path": clean_path,
					"authority": "local",
					"checkpoint_resume_contract": (
						resume_contract.duplicate(false)
					),
					"continue_contract": (
						continue_contract.duplicate(false)
					),
					"load_options": (
						next_load_options.duplicate(false)
					),
					"resident_reattach_preferred": true,
					"runtime_rebuild_forbidden": true,
					"transactional_reality_switch": true,
					"preserve_active_reality_until_commit": true,
					"source": (
						"saved_reality_transaction_reserve"
					)
				},
				(
					"mainscene."
					+ "saved_reality_transaction_reserve"
				)
			)
		)

		next_load_options [
			"checkpoint_reservation_declared"
		] = true

	if not bool(
		status_report.get(
			"success",
			false
		)
	):
		_finish_failed_life_load(
			str(
				status_report.get(
					"reason",
					"Saved reality could not be reserved."
				)
			)
		)
		return

	# Throttled: this polls until residency reports ready, and when it never does the
	# unthrottled version logged ~1,400 identical lines and drowned everything else.
	var residency_poll_count: int = int(
		get_meta("load_slot_residency_poll_count", 0)
	) + 1
	set_meta("load_slot_residency_poll_count", residency_poll_count)

	if residency_poll_count <= 5 or residency_poll_count % 100 == 0:
		EraLog.truth(
			"ERALIFE_LOAD_SLOT|stage=residency_status|poll=%d|success=%s|ready=%s|reason=%s"
			% [
				residency_poll_count,
				str(status_report.get("success", false)),
				str(status_report.get("ready", false)),
				str(status_report.get("reason", "-"))
			]
		)

	var residency_ready: bool = bool(
		status_report.get(
			"ready",
			false
		)
	)
	var projection_ready: bool = bool(
		status_report.get(
			"projection_ready",
			false
		)
	)



	var critical_contract_set_ready: bool = (
		residency_ready
	)
	var progress: float = clampf(
		float(
			status_report.get(
				"progress",
				0.0
			)
		),
		0.0,
		1.0
	)
	var stage_id: String = str(
		status_report.get(
			"stage_id",
			status_report.get(
				"state",
				"resident_runtime"
			)
		)
	)

	set_meta(
		"saved_life_resident_chassis_pending",
		not critical_contract_set_ready
	)
	set_meta(
		"saved_life_resident_chassis_stage",
		stage_id
	)
	set_meta(
		"saved_life_resident_chassis_progress",
		progress
	)
	set_meta(
		"saved_reality_transaction_target_ready",
		residency_ready
	)
	set_meta(
		"saved_reality_transaction_target_projection_ready",
		projection_ready
	)
	set_meta(
		"saved_reality_transaction_progressive_observable_ready",
		residency_ready
	)
	set_meta(
		"saved_reality_transaction_projection_is_enrichment_only",
		true
	)
	set_meta(
		"saved_reality_transaction_critical_contract_set_ready",
		critical_contract_set_ready
	)
	set_meta(
		"saved_reality_transaction_previous_reality_still_authoritative",
		true
	)

	if not title_card_continue:
		_publish_saved_reality_transaction_observation(
			saved_life_label,
			stage_id,
			progress,
			residency_ready,
			projection_ready
		)

	if not critical_contract_set_ready:
		_schedule_saved_life_residency_observation(
			clean_path,
			next_load_options
		)
		return

	var attach_report: Dictionary = (
		_request_reality_residency_intent(
			"attach",
			{
				"signature": signature,
				"checkpoint_path": clean_path,
				"checkpoint_resume_contract": (
					resume_contract.duplicate(false)
				),
				"checkpoint_attach": true,
				"pause_checkpoint_tail_while_lens_attached": false,
				"runtime_rebuild_forbidden": true,
				"attach_on_input_frame": false,
				"previous_reality_signature": previous_signature,
				"source": (
					"saved_reality_transaction_commit"
				)
			},
			(
				"mainscene."
				+ "saved_reality_transaction_commit"
			)
		)
	)

	if not bool(
		attach_report.get(
			"success",
			false
		)
	):
		_finish_failed_life_load(
			str(
				attach_report.get(
					"reason",
					"Saved reality could not attach."
				)
			)
		)
		return

	var attached_signature: String = str(
		attach_report.get(
			"signature",
			""
		)
	).strip_edges()

	if attached_signature != signature:
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"attached_signature_mismatch"
		)
		return

	var resident_raw: Variant = attach_report.get(
		"game_state",
		attach_report.get(
			"runtime_ref",
			null
		)
	)

	if not (
		resident_raw is GameState
	):
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"resident_runtime_missing"
		)
		return

	var resident_gs: GameState = (
		resident_raw as GameState
	)

	if (
		resident_gs == null
		or resident_gs.player == null
	):
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"resident_actor_missing"
		)
		return

	var attached_resume_raw: Variant = attach_report.get(
		"checkpoint_resume_contract",
		resume_contract
	)
	var attached_resume_contract: Dictionary = (
		(attached_resume_raw as Dictionary).duplicate(false)
		if typeof(attached_resume_raw) == TYPE_DICTIONARY
		else resume_contract.duplicate(false)
	)
	var first_frame_raw: Variant = attach_report.get(
		"checkpoint_first_frame_ui_snapshot",
		attached_resume_contract.get(
			"first_frame_ui_snapshot",
			{}
		)
	)
	var first_frame: Dictionary = (
		first_frame_raw as Dictionary
		if typeof(first_frame_raw) == TYPE_DICTIONARY
		else {}
	)
	var first_frame_actor_id: int = int(
		first_frame.get(
			"actor_id",
			first_frame.get(
				"player_id",
				-1
			)
		)
	)


	if first_frame.is_empty():
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"first_frame_packet_missing"
		)
		return

	if (
		first_frame_actor_id > 0
		and first_frame_actor_id != int(
			resident_gs.player.id
		)
	):
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"first_frame_actor_mismatch"
		)
		return

	if not _adopt_attached_resident_game_state(
		resident_gs,
		signature
	):
		_rollback_checkpoint_reality_handoff_attach(
			previous_signature,
			signature,
			"resident_adoption_failed"
		)
		return

	var normalized_resume: Dictionary = (
		_checkpoint_resume_contract_from_attached_projection(
			attached_resume_contract,
			attach_report
		)
	)

	if normalized_resume.is_empty():
		return

	var normalized_first_frame_raw: Variant = (
		normalized_resume.get(
			"first_frame_ui_snapshot",
			{}
		)
	)
	var normalized_first_frame: Dictionary = (
		normalized_first_frame_raw as Dictionary
		if typeof(
			normalized_first_frame_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if normalized_first_frame.is_empty():
		return

	var load_report: Dictionary = MainSceneHelpers._safe_dictionary(
		attach_report.get(
			"rehydration_report",
			{}
		)
	)

	if load_report.is_empty():
		load_report = {
			"success": true,
			"background_active": bool(
				attach_report.get(
					"background_active",
					false
				)
			),
		}

	var resident_engine_graph_ready: bool = bool(
		attach_report.get(
			"resident_engine_graph_ready",
			load_report.get(
				"resident_engine_graph_ready",
				false
			)
		)
	)
	var resident_engine_graph_background_tail: bool = bool(
		attach_report.get(
			"resident_engine_graph_background_tail",
			load_report.get(
				"resident_engine_graph_background_tail",
				not resident_engine_graph_ready
			)
		)
	)

	load_report ["success"] = true
	load_report ["live_shell_ready"] = true
	load_report ["ui_release_policy"] = (
		"resident_checkpoint_transaction"
	)
	load_report ["resident_engine_graph_ready"] = (
		resident_engine_graph_ready
	)
	load_report ["resident_engine_graph_background_tail"] = (
		resident_engine_graph_background_tail
	)
	load_report ["background_active"] = (
		bool(
			load_report.get(
				"background_active",
				false
			)
		)
		or resident_engine_graph_background_tail
	)
	load_report [
		"main_tab_rooms_must_be_hot_before_release"
	] = false
	load_report ["entry_surface"] = entry_surface
	load_report ["saved_life_label"] = saved_life_label
	load_report ["residency_signature"] = signature
	load_report ["checkpoint_resume_contract"] = (
		normalized_resume.duplicate(false)
	)
	load_report [
		"transactional_reality_switch"
	] = true
	load_report [
		"projection_enrichment_required_before_handoff"
	] = false

	if (
		not title_card_continue
		and has_meta(
			"reality_fusion_entering_player_snapshot"
		)
	):
		_apply_reality_fusion_entered_player_if_needed(
			clean_path,
			load_report
		)
		_apply_loaded_game_to_ui(
			load_report
		)
		return

	set_meta(
		"saved_life_resident_chassis_pending",
		false
	)
	set_meta(
		"saved_life_resident_chassis_ready",
		true
	)
	set_meta(
		"saved_life_resident_chassis_ready_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"saved_life_residency_tail_pending",
		resident_engine_graph_background_tail
	)
	set_meta(
		"saved_life_residency_request_pending",
		false
	)
	set_meta(
		"saved_reality_transaction_prepare_active",
		false
	)
	set_meta(
		"saved_reality_transaction_authority_committed",
		true
	)
	set_meta(
		"saved_reality_transaction_previous_signature",
		previous_signature
	)
	set_meta(
		"saved_reality_transaction_committed_signature",
		signature
	)
	set_meta(
		"saved_reality_transaction_committed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if not title_card_continue:
		_publish_saved_reality_transaction_observation(
			saved_life_label,
			"authority_handoff",
			1.0,
			true,
			projection_ready
		)

	_begin_attached_checkpoint_reality_handoff(
		normalized_resume,
		attach_report,
		next_load_options,
		previous_signature,
		previous_shell_visible
	)
func _queue_attached_checkpoint_lens_present(
	resume_contract: Dictionary,
	attach_report: Dictionary,
	load_options: Dictionary,
	poll_count: int = 0
) -> void:
	var tree:= get_tree()
	var callback: Callable = Callable(
		self,
		"_present_attached_checkpoint_lens_now"
	).bind(
		resume_contract.duplicate(false),
		attach_report.duplicate(false),
		load_options.duplicate(false),
		poll_count
	)

	if tree == null:
		call_deferred(
			"_present_attached_checkpoint_lens_now",
			resume_contract.duplicate(false),
			attach_report.duplicate(false),
			load_options.duplicate(false),
			poll_count
		)
		return

	tree.process_frame.connect(
		callback,
		CONNECT_ONE_SHOT
	)
func _present_attached_checkpoint_lens_now(
	resume_contract: Dictionary,
	attach_report: Dictionary,
	load_options: Dictionary,
	poll_count: int = 0
) -> void:
	if gs == null or gs.player == null:
		_finish_failed_life_load(
			"The attached checkpoint lost its playable actor."
		)
		return

	var expected_signature: String = str(
		load_options.get(
			"residency_signature",
			resume_contract.get(
				"residency_signature",
				""
			)
		)
	).strip_edges()

	var attached_signature: String = str(
		attach_report.get(
			"signature",
			reality_residency_attached_signature
		)
	).strip_edges()

	if (
		expected_signature == ""
		or attached_signature
		!= expected_signature
		or reality_residency_attached_signature
		!= expected_signature
	):
		set_meta(
