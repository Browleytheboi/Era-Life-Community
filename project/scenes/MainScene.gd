func _representative_default_year_for_era(era_key: String) -> int:
	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return 79

	var era_data = era_engine.eras.get(era_key, {})
	if typeof(era_data) != TYPE_DICTIONARY:
		if custom_year_spin != null:
			return int(custom_year_spin.value)
		return 79

	var start_year: int = int(era_data.get("start_year", 79))
	var end_year: int = int(era_data.get("end_year", start_year))
	var representative_year: int = start_year

	match era_key:
		"Ancient":
			representative_year = 79
		"Medieval":
			representative_year = 1066
		"Industrial":
			representative_year = 1900
		"Modern":
			representative_year = 2000
		"Future":
			representative_year = 2100

	return int(clamp(representative_year, start_year, end_year))

func _on_custom_era_picker_item_selected(index: int) -> void:
	if custom_birth_ui_syncing:
		return
	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return
	var era_key: String = custom_era_picker.get_item_text(index)
	var era_data = era_engine.eras.get(era_key, {})
	if typeof(era_data) == TYPE_DICTIONARY and custom_year_spin != null:
		var snapped_year: int = _representative_default_year_for_era(era_key)
		custom_birth_ui_syncing = true
		custom_year_spin.value = snapped_year
		if custom_year_line_edit != null:
			custom_year_line_edit.text = str(snapped_year)
		custom_birth_ui_syncing = false

	_mark_god_mode_reality_shape_changed("era_changed")
	_refresh_birth_location_pickers("", "", false)
	_refresh_custom_social_class_picker_preserving_selection()
	_refresh_god_mode_preview_label()
	_refresh_god_mode_start_button_state()


func _on_custom_country_picker_item_selected(index: int) -> void:
