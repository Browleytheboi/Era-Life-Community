func _try_show_life_panel_ui_packet() -> bool:
	if gs == null or gs.player == null:
		return false

	var context: Dictionary = _build_life_panel_ui_packet_context()
	var packet: Dictionary = {}

	if "reality_orchestrator" in gs and gs.reality_orchestrator != null:
		if gs.reality_orchestrator.has_method("consume_prewarmed_ui_surface_packet"):
			packet = gs.reality_orchestrator.consume_prewarmed_ui_surface_packet("life_panel", context)

	if packet.is_empty() and "ui_contract_engine" in gs and gs.ui_contract_engine != null:
		if gs.ui_contract_engine.has_method("build_ui_packet"):
			packet = gs.ui_contract_engine.build_ui_packet("life_panel", context)

	return _render_life_panel_ui_packet(packet)


func _build_life_panel_ui_packet_context() -> Dictionary:
	var lines: Array = []

	if gs == null or gs.player == null:
		return {
			"surface_id": "life_panel",
			"source": "mainscene.life_panel_packet_context",
			"diary_lines": lines,
			"diary_revision": "empty"
		}

	_ensure_active_life_diary_loaded(false)

	lines = _ensure_spawn_ready_birth_intro_entry("life_panel_packet_context")
	if lines.is_empty():
		_rebuild_loaded_life_diary_snapshot_if_needed()
		lines = _flatten_life_diary_lines()

	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(gs.player.age),
			"My life has begun."
		]

	set_meta("life_diary_render_cached_lines", lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", _life_diary_render_signature())

	return {
