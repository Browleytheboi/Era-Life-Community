func _reveal_spawn_ready_runtime_hud_buttons_if_existing(
		reason: String = "spawn_ready"
) -> void:
	if gs == null or gs.player == null:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if _zero_frame_switch_surface_lock_active(now_ms):
		_refresh_locked_zero_frame_switch_surface(
			"%s_blocked_by_zero_frame_switch_surface_lock" % reason
		)
		return

	set_meta(
		"spawn_ready_runtime_hud_shell_only_active",
		true
	)
	set_meta(
		"spawn_ready_runtime_hud_shell_only_reason",
		reason
	)
	set_meta(
		"spawn_ready_runtime_hud_shell_only_started_at_ms",
		now_ms
	)
	set_meta(
		"spawn_ready_runtime_hud_reveal_existing_nodes_only",
		true
	)
	set_meta(
		"spawn_ready_runtime_hud_reveal_sync_updates_forbidden",
		true
	)
	set_meta(
		"runtime_hud_shell_reveal_policy",
		"resident_snapshot_reveal_only"
	)
	set_meta(
		"runtime_hud_shell_reveal_reason",
		reason
	)

	var snapshot: Dictionary = {}
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var snapshot_raw: Variant = gs.scenario_state.get(
			"runtime_hud_visibility_snapshot",
			{}
		)
		if typeof(snapshot_raw) == TYPE_DICTIONARY:
			snapshot = snapshot_raw as Dictionary

	var snapshot_actor_id: int = int(
		snapshot.get(
			"controlled_actor_id",
			snapshot.get(
				"player_id",
				snapshot.get(
					"actor_id",
					-1
				)
			)
		)
	)
	var snapshot_matches_actor: bool = (
		not snapshot.is_empty()
		and snapshot_actor_id > 0
		and snapshot_actor_id == int(gs.player.id)
	)

	if not snapshot_matches_actor:
		set_meta(
			"spawn_ready_runtime_hud_snapshot_missing",
			true
		)
		set_meta(
			"spawn_ready_runtime_hud_snapshot_missing_actor_id",
			int(gs.player.id)
		)
		set_meta(
			"spawn_ready_runtime_hud_snapshot_missing_at_ms",
			now_ms
		)
		return

	var show_belongings: bool = bool(
		snapshot.get(
			"belongings_button_visible",
			snapshot.get(
				"belongings_available",
				false
			)
		)
	)
	var show_bending: bool = bool(
		snapshot.get(
			"bending_button_visible",
			snapshot.get("bending_available", false)
		)
	)
	var show_crown: bool = bool(
		snapshot.get(
			"crown_button_visible",
			snapshot.get("crown_available", false)
		)
	)
	var show_food_lifestyle: bool = bool(
		snapshot.get(
			"food_lifestyle_button_visible",
			snapshot.get("food_lifestyle_available", false)
		)
	)
	var show_restaurant_lifestyle: bool = bool(
		snapshot.get(
			"restaurant_lifestyle_button_visible",
			snapshot.get("restaurant_lifestyle_available", false)
		)
	)
	var show_rick: bool = bool(
		snapshot.get(
			"rick_weapon_shop_button_visible",
			snapshot.get("rick_weapon_shop_available", false)
		)
	)
	var show_boxing: bool = bool(
		snapshot.get(
			"boxing_button_visible",
			snapshot.get("boxing_available", false)
		)
	)
	var show_superpower: bool = bool(
		snapshot.get(
			"superpower_button_visible",
			snapshot.get("superpower_available", false)
		)
	)
	var show_power: bool = bool(
		snapshot.get(
			"power_button_visible",
			snapshot.get("power_available", false)
		)
	)
	var show_wizard: bool = bool(
		snapshot.get(
			"wizard_button_visible",
			snapshot.get("wizard_available", false)
		)
	)

	var restored_panel: String = str(
		snapshot.get(
			"current_panel",
			current_panel
		)
	).strip_edges()
	if restored_panel == "":
		restored_panel = "life"
	current_panel = restored_panel

	for key in ui_nav_buttons.keys():
		var button: Button = ui_nav_buttons.get(
			key,
			null
		) as Button
		if button == null or not is_instance_valid(button):
			continue
		button.visible = true
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.focus_mode = Control.FOCUS_NONE

	_apply_ui_nav_button_visuals()
	_set_birth_shell_interactive_controls_visible(true)

	if output_label != null and is_instance_valid(output_label):
		output_label.visible = true
		output_label.scroll_active = true
		output_label.bbcode_enabled = true
		output_label.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true
		player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_apply_zero_frame_hud_button_shell(
		belongings_hud_button,
		show_belongings
	)
	_apply_zero_frame_hud_button_shell(
		bending_hud_button,
		show_bending
	)
	_apply_zero_frame_hud_button_shell(
		crown_hud_button,
		show_crown
	)
	_apply_zero_frame_hud_button_shell(
		food_lifestyle_hud_button,
		show_food_lifestyle
	)
	_apply_zero_frame_hud_button_shell(
		restaurant_lifestyle_hud_button,
		show_restaurant_lifestyle
	)
	_apply_zero_frame_hud_button_shell(
		rick_weapon_shop_hud_button,
		show_rick
	)
	_apply_zero_frame_hud_button_shell(
		boxing_hud_button,
		show_boxing
	)
	_apply_zero_frame_hud_button_shell(
		superpower_hud_button,
		show_superpower
	)
	_apply_zero_frame_hud_button_shell(
		power_hud_button,
		show_power
	)
	_apply_zero_frame_hud_button_shell(
		wizard_hud_button,
		show_wizard
	)

	set_meta(
		"spawn_ready_runtime_hud_snapshot_missing",
		false
	)
	set_meta(
		"spawn_ready_runtime_hud_reveal_renderer_only",
		true
	)
	set_meta(
		"spawn_ready_runtime_hud_reveal_mutated_truth",
		false
	)

	_sync_runtime_floating_hud_layering_for_spawn_shell(
		reason
	)
func _schedule_runtime_boot_buffer_flush_after_shell(reason: String = "spawn_ready", delay_seconds: float = 2.0) -> void:
	set_meta("runtime_boot_buffer_flush_after_shell_reason", reason)
	set_meta("runtime_boot_buffer_flush_after_shell_scheduled_at_ms", int(Time.get_ticks_msec()))

	var tree:= get_tree()
	if tree == null:
		call_deferred("_flush_runtime_boot_buffered_ui_intents")
		return

	var timer:= tree.create_timer(max(0.25, delay_seconds))
	timer.timeout.connect(
		Callable(self, "_flush_runtime_boot_buffered_ui_intents"),
		CONNECT_ONE_SHOT
	)
func _checkpoint_resume_birth_intro_forbidden() -> bool:
	if bool(
		get_meta(
			"checkpoint_resume_life_diary_active",
			false
		)
	):
		return true

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		return bool(
			gs.scenario_state.get(
				"checkpoint_resume_not_birth",
				false
			)
		)

	return false
func _render_spawn_ready_life_diary_first_frame(
	reason: String = "spawn_ready"
) -> void:
	if gs == null or gs.player == null:
		return

	if _checkpoint_resume_birth_intro_forbidden():
		set_meta(
			"spawn_ready_birth_intro_blocked_for_checkpoint_resume",
