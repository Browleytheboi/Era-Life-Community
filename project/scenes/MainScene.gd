func _pulse_god_mode_preview_label() -> void:

	if god_mode_preview_label == null or not is_instance_valid(god_mode_preview_label):
		return
	if god_mode_preview_tween != null:
		god_mode_preview_tween.kill()
		god_mode_preview_tween = null
	god_mode_preview_label.scale = Vector2.ONE
	god_mode_preview_label.self_modulate = Color(1.0, 1.0, 1.0, 1.0)
	god_mode_preview_tween = create_tween().bind_node(god_mode_preview_label)
	god_mode_preview_tween.set_trans(Tween.TRANS_SINE)
	god_mode_preview_tween.set_ease(Tween.EASE_OUT)
	god_mode_preview_tween.tween_property(god_mode_preview_label, "scale", Vector2(1.012, 1.012), 0.1)
	god_mode_preview_tween.parallel().tween_property(god_mode_preview_label, "self_modulate", Color(1.0, 0.98, 0.9, 1.0), 0.1)
	god_mode_preview_tween.tween_property(god_mode_preview_label, "scale", Vector2.ONE, 0.16)
	god_mode_preview_tween.parallel().tween_property(god_mode_preview_label, "self_modulate", Color(1.0, 1.0, 1.0, 1.0), 0.16)
func _animate_god_mode_panel_reveal() -> void:

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return
	god_mode_presentation_pointer = Vector2.ZERO
	god_mode_presentation_background_phase = 0.0
	god_mode_presentation_profile = _build_god_mode_presentation_profile()
	_apply_god_mode_presentation_surface_styles()
	god_mode_start_panel.pivot_offset = god_mode_start_panel.size * 0.5
	var reveal_tween: Tween = null
	if god_mode_start_panel.has_meta("god_mode_reveal_tween"):
		var existing_reveal_tween = god_mode_start_panel.get_meta("god_mode_reveal_tween")
		if existing_reveal_tween is Tween:
			reveal_tween = existing_reveal_tween
	if reveal_tween != null:
		reveal_tween.kill()
	god_mode_start_panel.scale = Vector2.ONE * float(god_mode_presentation_profile.get("panel_reveal_start_scale", 0.972))
	god_mode_start_panel.self_modulate = Color(0.94, 0.94, 1.0, 1.0)
	reveal_tween = create_tween().bind_node(god_mode_start_panel)
	god_mode_start_panel.set_meta("god_mode_reveal_tween", reveal_tween)
	reveal_tween.set_trans(Tween.TRANS_SINE)
	reveal_tween.set_ease(Tween.EASE_OUT)
	reveal_tween.tween_property(
		god_mode_start_panel,
		"scale",
		Vector2.ONE * float(god_mode_presentation_profile.get("panel_reveal_overshoot", 1.014)),
		0.14
	)
	reveal_tween.parallel().tween_property(
		god_mode_start_panel,
		"self_modulate",
		Color(1.0, 1.0, 1.0, 1.0),
		0.14
	)
	reveal_tween.tween_property(god_mode_start_panel, "scale", Vector2.ONE, 0.18)
	var surface_root:= god_mode_start_panel.get_node_or_null("GodModePresentationSurface") as Control
	if surface_root != null and is_instance_valid(surface_root):
		surface_root.self_modulate = Color(1.0, 1.0, 1.0, 0.0)
		reveal_tween.parallel().tween_property(surface_root, "self_modulate", Color(1.0, 1.0, 1.0, 1.0), 0.22)

	if god_mode_preview_label != null:
		_pulse_god_mode_preview_label()
	if god_mode_start_button != null:
		god_mode_start_button.scale = Vector2.ONE
		var button_tween:= create_tween()
		button_tween.set_trans(Tween.TRANS_SINE)
		button_tween.set_ease(Tween.EASE_OUT)
		button_tween.tween_interval(0.16)
		button_tween.tween_property(god_mode_start_button, "scale", Vector2(1.035, 1.035), 0.12)
		button_tween.tween_property(god_mode_start_button, "scale", Vector2.ONE, 0.16)

func _finish_god_mode_slider_intro(slider: HSlider, value_label: Label) -> void:
