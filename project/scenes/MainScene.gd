func _force_render_minimum_playable_life_surface_now(reason: String = "minimum_playable_life_surface") -> bool:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("old_minimum_playable_life_surface_requested", true)
	set_meta("old_minimum_playable_life_surface_blocked", true)
	set_meta("old_minimum_playable_life_surface_blocked_reason", reason)
	set_meta("old_minimum_playable_life_surface_blocked_at_ms", now_ms)
	set_meta("minimum_shell_fallback_banned", true)
	set_meta("truth_first_render_required", true)
	set_meta("minimum_shell_redirected_to_final_composer", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["old_minimum_playable_life_surface_requested"] = true
		gs.scenario_state ["old_minimum_playable_life_surface_blocked"] = true
		gs.scenario_state ["old_minimum_playable_life_surface_blocked_reason"] = reason
		gs.scenario_state ["old_minimum_playable_life_surface_blocked_at_ms"] = now_ms
		gs.scenario_state ["minimum_shell_fallback_banned"] = true
		gs.scenario_state ["truth_first_render_required"] = true
		gs.scenario_state ["minimum_shell_redirected_to_final_composer"] = true

	if gs == null or gs.player == null:
		return false

	var snapshot: Dictionary = _truth_first_god_mode_ready_snapshot("%s_minimum_redirect" % reason)
	if snapshot.is_empty():
		snapshot = _build_first_frame_ui_snapshot_from_game_state(gs, "%s_minimum_redirect_rebuild" % reason)

	if snapshot.is_empty():
		return false

	return _compose_god_mode_ready_final_playable_life_shell_frame(
		snapshot.duplicate(true),
		"%s_minimum_redirect_final_composer" % reason
	)
func _open_prewarmed_life_door_from_god_mode_contract(settings: Dictionary, signature: String, handoff_contract: Dictionary, reason: String = "god_mode_entry") -> bool:
	if settings.is_empty():
		return false

	var clean_signature: String = str(signature).strip_edges()
	if clean_signature == "":
		return false

	if not _is_god_mode_life_prewarm_ready_for_settings(settings):
		return false

	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("ready_button_is_door", true)
	set_meta("prewarm_builds_room", true)
	set_meta("ready_opens_room", true)
	set_meta("heavy_world_work_streams_in_background_slices", true)
	set_meta("ui_is_pure_renderer", true)
	set_meta("player_lag_forbidden", true)
	set_meta("blank_shell_forbidden", true)
	set_meta("loading_on_ready_forbidden", true)
	set_meta("ready_button_fallback_build_forbidden", true)
	set_meta("ready_button_must_reveal_preexisting_surface", true)
	set_meta("first_visible_life_shell_must_be_final_composition", true)
	set_meta("god_mode_entry_door_open_started_at_ms", now_ms)
	set_meta("god_mode_entry_door_open_reason", reason)
	set_meta("first_visible_life_shell_final_composition_complete", false)

	var front_buffer_claimed: bool = _claim_prewarmed_god_mode_life_front_buffer_now(
		settings.duplicate(true),
		clean_signature,
		handoff_contract.duplicate(true),
		reason
	)

	if not front_buffer_claimed:
		set_meta("god_mode_ready_front_buffer_claim_failed", true)
		set_meta("god_mode_ready_front_buffer_claim_failed_reason", reason)
		set_meta("god_mode_ready_front_buffer_claim_failed_at_ms", now_ms)
		return false

	var snapshot: Dictionary = _truth_first_god_mode_ready_snapshot(reason)
	if snapshot.is_empty() and gs != null and gs.player != null:
		snapshot = _build_first_frame_ui_snapshot_from_game_state(gs, "%s_ready_door_snapshot_rebuild" % reason)

	if snapshot.is_empty():
		set_meta("god_mode_ready_final_snapshot_missing", true)
		set_meta("god_mode_ready_final_snapshot_missing_reason", reason)
		set_meta("god_mode_ready_final_snapshot_missing_at_ms", now_ms)
		return false

	if not _compose_god_mode_ready_final_playable_life_shell_frame(
		snapshot.duplicate(true),
		"%s_ready_door_final_composition" % reason
	):
		return false

	_zero_frame_hide_prelife_cover_now(reason)
	_release_playable_life_surface_to_player_control_now("%s_ready_door_control_release" % reason)
	_arm_playable_life_surface_authority_lock("%s_door_opened" % reason)
	_enforce_playable_life_surface_authority_now("%s_door_opened" % reason)

	set_meta("god_mode_visible_surface_claimed_before_capsule_consume", true)
	set_meta("god_mode_playable_ui_atomic_commit_complete", true)
	set_meta("god_mode_entry_door_opened", true)
	set_meta("god_mode_entry_door_opened_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_entry_door_opened_reason", reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["ready_button_is_door"] = true
		gs.scenario_state ["prewarm_builds_room"] = true
		gs.scenario_state ["ready_opens_room"] = true
		gs.scenario_state ["heavy_world_work_streams_in_background_slices"] = true
		gs.scenario_state ["ui_is_pure_renderer"] = true
		gs.scenario_state ["player_lag_forbidden"] = true
		gs.scenario_state ["blank_shell_forbidden"] = true
		gs.scenario_state ["loading_on_ready_forbidden"] = true
		gs.scenario_state ["ready_button_fallback_build_forbidden"] = true
		gs.scenario_state ["god_mode_entry_door_opened"] = true
		gs.scenario_state ["god_mode_entry_door_opened_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["god_mode_entry_door_opened_reason"] = reason
		gs.scenario_state ["god_mode_life_front_buffer_claimed"] = true
		gs.scenario_state ["god_mode_playable_ui_atomic_commit_complete"] = true
		gs.scenario_state ["playable_life_surface_has_visual_authority"] = true
		gs.scenario_state ["god_mode_life_prewarm_consumed"] = true
		gs.scenario_state ["god_mode_life_prewarm_consumed_by"] = "ready_button_door_open"
		gs.scenario_state ["god_mode_life_prewarm_consumed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["spawn_shell_entry_policy"] = "full_playable_ui_from_prewarmed_capsule"
		gs.scenario_state ["ui_first_frame_render_policy"] = "resolve_compose_reveal_single_final_shell"
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["defer_static_world_bootstrap"] = true
		gs.scenario_state ["defer_live_runtime_watchers"] = true
		gs.scenario_state ["defer_noncritical_systems_until_player_control"] = true
		gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = true
		gs.scenario_state ["ui_background_reconciliation_streaming"] = true
		gs.scenario_state ["first_visible_life_shell_final_composition_complete"] = true

	_claim_god_mode_tracker_playable_surface("%s_door_opened" % reason)
	_complete_god_mode_tracker_entry("%s_door_opened" % reason)

	return true
func _enqueue_god_mode_handoff_runtime_contract(handoff_contract: Dictionary, reason: String = "god_mode_handoff") -> void:
	if handoff_contract.is_empty() or not bool(handoff_contract.get("success", false)):
		_restore_god_mode_start_button_after_failed_entry(
			str(handoff_contract.get("reason", "Invalid God Mode handoff contract."))
		)
		return

	god_mode_handoff_runtime_contract_queue.clear()
	god_mode_handoff_runtime_contract_queue.append({
		"contract": handoff_contract.duplicate(true),
		"reason": reason,
		"queued_at_ms": int(Time.get_ticks_msec()),
		"consume_policy": "tail_consume_after_visible_playable_surface",
	})

	set_meta("god_mode_handoff_runtime_contract_queue_pending", true)
	set_meta("god_mode_handoff_runtime_contract_queue_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_queued_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_handoff_runtime_contract_queue_same_frame_consume", false)
	set_meta("god_mode_handoff_runtime_contract_queue_same_frame_reason", reason)

	if bool(get_meta("god_mode_handoff_runtime_contract_queue_draining", false)):
		return

	if bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
		_schedule_deferred_god_mode_handoff_contract_consume_after_visible_frame(reason)
		return

	_drain_god_mode_handoff_runtime_contract_queue(reason, 0)
func _schedule_deferred_god_mode_handoff_contract_consume_after_visible_frame(reason: String = "god_mode_handoff") -> void:
	if god_mode_handoff_runtime_contract_queue.is_empty():
		set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", false)
		return

	if bool(get_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", false)):
		return

	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", true)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_scheduled_at_ms", int(Time.get_ticks_msec()))

	var deferred_consume_method: String = "_deferred_consume_god_mode_handoff_contract_after_visible_frame"
	var deferred_consume_callable:= Callable(self, deferred_consume_method)

	if not has_method(deferred_consume_method) or not deferred_consume_callable.is_valid():
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", false)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_missing_callable", true)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_missing_callable_reason", reason)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_missing_callable_at_ms", int(Time.get_ticks_msec()))
		call_deferred("_drain_god_mode_handoff_runtime_contract_queue", "%s_missing_deferred_consume_callable" % reason, 0)
		return

	var tree:= get_tree()
	if tree == null:
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", false)
		call_deferred(deferred_consume_method, reason)
		return

	var timer:= tree.create_timer(0.1)
	timer.timeout.connect(
		deferred_consume_callable.bind(reason),
		CONNECT_ONE_SHOT
	)
func _deferred_consume_god_mode_handoff_contract_after_visible_frame(reason: String = "god_mode_handoff") -> void:
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_connected", false)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_started_at_ms", int(Time.get_ticks_msec()))

	if god_mode_handoff_runtime_contract_queue.is_empty():
		set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_empty", true)
		set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_empty_reason", reason)
		return

	var attempt: int = int(get_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_attempt", 0)) + 1
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_attempt", attempt)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_attempt_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_attempt_at_ms", int(Time.get_ticks_msec()))

	if not bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
		_drain_god_mode_handoff_runtime_contract_queue("%s_no_front_buffer_claim" % reason, 0)
		return

	if not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
		_prime_prewarmed_capsule_live_ui_surface_without_handoff("%s_deferred_atomic_prime_attempt_%d" % [reason, attempt])

		if not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
			_commit_god_mode_to_playable_ui_atomic("%s_deferred_atomic_commit_attempt_%d" % [reason, attempt])

		if not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
			_force_release_god_mode_handoff_to_visible_life_surface("%s_deferred_force_release_attempt_%d" % [reason, attempt])

		if not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)) and attempt < 12:
			_schedule_deferred_god_mode_handoff_contract_consume_after_visible_frame("%s_waiting_for_atomic_commit" % reason)
			return

	if not _god_mode_visible_life_surface_owns_screen("%s_deferred_visible_surface_probe_attempt_%d" % [reason, attempt]):
		_enforce_playable_life_surface_authority_now("%s_deferred_visible_surface_repair_attempt_%d" % [reason, attempt])
		_force_release_god_mode_handoff_to_visible_life_surface("%s_deferred_visible_surface_force_release_attempt_%d" % [reason, attempt])

		if not _god_mode_visible_life_surface_owns_screen("%s_deferred_visible_surface_reprobe_attempt_%d" % [reason, attempt]) and attempt < 12:
			_schedule_deferred_god_mode_handoff_contract_consume_after_visible_frame("%s_waiting_for_visible_surface" % reason)
			return

	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_attempt", 0)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_ready_to_drain", true)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_ready_to_drain_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_deferred_consume_ready_to_drain_at_ms", int(Time.get_ticks_msec()))

	_drain_god_mode_handoff_runtime_contract_queue("%s_after_visible_playable_frame" % reason, 0)
func _schedule_god_mode_handoff_runtime_contract_queue_drain(reason: String = "god_mode_handoff") -> void:
	if god_mode_handoff_runtime_contract_queue.is_empty():
		set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
		set_meta("god_mode_handoff_runtime_contract_queue_drain_connected", false)
		return

	if bool(get_meta("god_mode_handoff_runtime_contract_queue_draining", false)):
		return

	set_meta("god_mode_handoff_runtime_contract_queue_drain_connected", false)
	set_meta("god_mode_handoff_runtime_contract_queue_drain_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_drain_scheduled_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_handoff_runtime_contract_queue_same_frame_consume", true)

	_drain_god_mode_handoff_runtime_contract_queue(reason, 0)


func _drain_god_mode_handoff_runtime_contract_queue_after_draw(reason: String = "god_mode_handoff", attempt: int = 0) -> void:
	set_meta("god_mode_handoff_runtime_contract_queue_drain_connected", false)
	set_meta("god_mode_handoff_runtime_contract_queue_after_draw_skipped", true)
	set_meta("god_mode_handoff_runtime_contract_queue_after_draw_skipped_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_after_draw_skipped_at_ms", int(Time.get_ticks_msec()))

	_drain_god_mode_handoff_runtime_contract_queue(reason, attempt)

func _drain_god_mode_handoff_runtime_contract_queue(reason: String = "god_mode_handoff", _attempt: int = 0) -> void:
	if god_mode_handoff_runtime_contract_queue.is_empty():
		set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
		set_meta("god_mode_handoff_runtime_contract_queue_draining", false)
		return

	if bool(get_meta("god_mode_handoff_runtime_contract_queue_draining", false)):
		var now_ms: int = int(Time.get_ticks_msec())
		var draining_at_ms: int = int(get_meta("god_mode_handoff_runtime_contract_queue_draining_at_ms", 0))
		if draining_at_ms > 0 and now_ms - draining_at_ms < 1200:
			return
		set_meta("god_mode_handoff_runtime_contract_queue_draining", false)
		set_meta("god_mode_handoff_runtime_contract_queue_stale_drain_cleared", true)
		set_meta("god_mode_handoff_runtime_contract_queue_stale_drain_cleared_at_ms", now_ms)

	if bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
		if not _god_mode_visible_life_surface_owns_screen("%s_drain_visible_surface_probe" % reason):
			_force_render_minimum_playable_life_surface_now("%s_drain_minimum_surface_repair" % reason)
			_enforce_playable_life_surface_authority_now("%s_drain_visible_surface_repair" % reason)
			_force_release_god_mode_handoff_to_visible_life_surface("%s_drain_force_release" % reason)

	set_meta("god_mode_handoff_runtime_contract_queue_draining", true)
	set_meta("god_mode_handoff_runtime_contract_queue_draining_reason", reason)
	set_meta("god_mode_handoff_runtime_contract_queue_draining_at_ms", int(Time.get_ticks_msec()))

	var row: Dictionary = god_mode_handoff_runtime_contract_queue.pop_front()
	var contract_raw: Variant = row.get("contract", {})
	var handoff_contract: Dictionary = contract_raw.duplicate(true) if typeof(contract_raw) == TYPE_DICTIONARY else {}

	_consume_god_mode_panel_handoff_contract_after_panel_termination(handoff_contract)

	set_meta("god_mode_handoff_runtime_contract_queue_draining", false)
	set_meta("god_mode_handoff_runtime_contract_queue_pending", not god_mode_handoff_runtime_contract_queue.is_empty())
func _consume_god_mode_panel_handoff_contract_after_panel_termination(handoff_contract: Dictionary) -> void:
	if handoff_contract.is_empty() or not bool(handoff_contract.get("success", false)):
		if bool(get_meta("god_mode_entry_door_opened", false)) or bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
			set_meta("god_mode_panel_handoff_contract_consuming", false)
			set_meta("god_mode_panel_handoff_contract_pending", false)
			set_meta("god_mode_zero_frame_life_entry_pending", false)
			set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
			return

		_restore_god_mode_start_button_after_failed_entry(
			str(handoff_contract.get("reason", "Invalid God Mode handoff contract."))
		)
		return

	var contract_raw: Variant = handoff_contract.get("handoff_contract", {})
	var contract: Dictionary = contract_raw.duplicate(true) if typeof(contract_raw) == TYPE_DICTIONARY else {}

	if contract.is_empty():
		if bool(get_meta("god_mode_entry_door_opened", false)) or bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
			set_meta("god_mode_panel_handoff_contract_consuming", false)
			set_meta("god_mode_panel_handoff_contract_pending", false)
			set_meta("god_mode_zero_frame_life_entry_pending", false)
			set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
			return

		_restore_god_mode_start_button_after_failed_entry("God Mode handoff contract was empty.")
		return

	var settings_raw: Variant = contract.get("settings", handoff_contract.get("settings", {}))
	var settings: Dictionary = settings_raw.duplicate(true) if typeof(settings_raw) == TYPE_DICTIONARY else {}

	if settings.is_empty():
		if bool(get_meta("god_mode_entry_door_opened", false)) or bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
			set_meta("god_mode_panel_handoff_contract_consuming", false)
			set_meta("god_mode_panel_handoff_contract_pending", false)
			set_meta("god_mode_zero_frame_life_entry_pending", false)
			set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
			return

		_restore_god_mode_start_button_after_failed_entry("God Mode handoff contract had no settings payload.")
		return

	var signature: String = str(contract.get("signature", handoff_contract.get("signature", ""))).strip_edges()

	if signature == "":
		if bool(get_meta("god_mode_entry_door_opened", false)) or bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
			set_meta("god_mode_panel_handoff_contract_consuming", false)
			set_meta("god_mode_panel_handoff_contract_pending", false)
			set_meta("god_mode_zero_frame_life_entry_pending", false)
			set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
			return

		_restore_god_mode_start_button_after_failed_entry("God Mode handoff contract had no signature.")
		return

	_sever_god_mode_runtime_authority("consume_god_mode_panel_handoff_contract_after_panel_termination")

	var now_ms: int = int(Time.get_ticks_msec())
	var door_already_opened: bool = (
		bool(get_meta("god_mode_entry_door_opened", false))
		or bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false))
		or bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false))
	)

	if door_already_opened:
		if not _god_mode_visible_life_surface_owns_screen("handoff_consumer_fast_path_probe"):
			_force_render_minimum_playable_life_surface_now("handoff_consumer_fast_path_minimum_surface_repair")
			_prime_prewarmed_capsule_live_ui_surface_without_handoff("handoff_consumer_fast_path_repair")
			_commit_god_mode_to_playable_ui_atomic("handoff_consumer_fast_path_repair")
			_force_release_god_mode_handoff_to_visible_life_surface("handoff_consumer_fast_path_force_release")

		set_meta("god_mode_panel_handoff_contract_consuming", false)
		set_meta("god_mode_panel_handoff_contract_pending", false)
		set_meta("god_mode_zero_frame_life_entry_pending", false)
		set_meta("god_mode_handoff_runtime_contract_queue_pending", false)
		set_meta("god_mode_life_prewarm_consumed", true)
		set_meta("god_mode_life_prewarm_consumed_by", "handoff_consumer_fast_path")
		set_meta("god_mode_life_prewarm_consumed_at_ms", now_ms)
		set_meta("god_mode_second_boot_prevented", true)
		set_meta("god_mode_second_boot_prevented_reason", "door_already_opened")
		set_meta("god_mode_second_boot_prevented_at_ms", now_ms)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["god_mode_life_prewarm_consumed"] = true
			gs.scenario_state ["god_mode_life_prewarm_consumed_by"] = "handoff_consumer_fast_path"
			gs.scenario_state ["god_mode_life_prewarm_consumed_at_ms"] = now_ms
			gs.scenario_state ["god_mode_panel_handoff_contract_pending"] = false
			gs.scenario_state ["god_mode_zero_frame_life_entry_pending"] = false
			gs.scenario_state ["god_mode_second_boot_prevented"] = true
			gs.scenario_state ["god_mode_second_boot_prevented_reason"] = "door_already_opened"
			gs.scenario_state ["playable_life_surface_has_visual_authority"] = true
			gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
			gs.scenario_state ["defer_static_world_bootstrap"] = true
			gs.scenario_state ["defer_live_runtime_watchers"] = true
			gs.scenario_state ["defer_noncritical_systems_until_player_control"] = true
			gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = true
			gs.scenario_state ["ui_background_reconciliation_streaming"] = true

		_arm_playable_life_surface_authority_lock("handoff_consumer_fast_path")
		_enforce_playable_life_surface_authority_now("handoff_consumer_fast_path")
		_schedule_god_mode_post_entry_tail_work_after_control_grace("handoff_consumer_fast_path")
		return

	if not _is_god_mode_life_prewarm_ready_for_settings(settings):
		_restore_god_mode_start_button_after_failed_entry(
			"The handoff contract was emitted, but the matching prewarmed capsule was not ready."
		)
		return

	set_meta("god_mode_panel_handoff_contract_consuming", true)
	set_meta("god_mode_panel_handoff_contract_consuming_signature", signature)
	set_meta("god_mode_panel_handoff_contract_consuming_at_ms", now_ms)
	set_meta("god_mode_life_start_prevalidated_signature", signature)
	set_meta("god_mode_life_entry_full_ui_required", true)
	set_meta("prewarmed_capsule_entry_shell_first", false)
	set_meta("god_mode_shell_first_handoff_requested", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("god_mode_atomic_shell_handoff_active", false)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)

	var entered: bool = _enter_prewarmed_god_mode_life_full_ui_now(
		settings.duplicate(true),
		"god_mode_runtime_firewall_contract_consumer_hot_capsule"
	)

	remove_meta("god_mode_life_start_prevalidated_signature")
	set_meta("god_mode_panel_handoff_contract_consuming", false)
	set_meta("god_mode_panel_handoff_contract_pending", false)
	set_meta("god_mode_zero_frame_life_entry_pending", false)

	if entered:
		_force_render_minimum_playable_life_surface_now("god_mode_runtime_firewall_contract_consumer_hot_capsule")
		_arm_playable_life_surface_authority_lock("god_mode_runtime_firewall_contract_consumer_hot_capsule")
		_enforce_playable_life_surface_authority_now("god_mode_runtime_firewall_contract_consumer_hot_capsule")
		_force_release_god_mode_handoff_to_visible_life_surface("god_mode_runtime_firewall_contract_consumer_hot_capsule")
		return

	_abort_god_mode_tracker_handoff("god_mode_runtime_firewall_contract_consumer_failed")
	_restore_god_mode_start_button_after_failed_entry(
		"The God Mode panel emitted a handoff contract, but the hot runtime capsule could not be consumed."
	)
func _schedule_god_mode_start_life_entry_after_button_paint(handoff_started_ms: int = 0) -> void:
	if bool(get_meta("god_mode_start_life_entry_after_button_paint_connected", false)):
		return

	set_meta("god_mode_start_life_entry_after_button_paint_connected", true)
	set_meta("god_mode_start_life_entry_after_button_paint_scheduled_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_start_life_entry_after_button_paint_handoff_started_ms", handoff_started_ms)

	call_deferred("_resume_god_mode_start_life_entry_after_button_paint", handoff_started_ms)


func _resume_god_mode_start_life_entry_after_button_paint(handoff_started_ms: int = 0) -> void:
	var tree:= get_tree()
	if tree != null:
		await tree.process_frame

	_run_god_mode_start_life_entry_after_button_paint(handoff_started_ms)
func _run_god_mode_start_life_entry_after_button_paint(_handoff_started_ms: int = 0) -> void:
	set_meta("god_mode_start_life_entry_after_button_paint_connected", false)
	set_meta("god_mode_start_button_text_painted_for_handoff", true)
	set_meta("god_mode_start_button_text_painted_for_handoff_at_ms", int(Time.get_ticks_msec()))

	if not bool(get_meta("god_mode_capsule_entry_handoff_active", false)):
		return

	var settings: Dictionary = _god_mode_start_settings_from_ready_prewarm()
	if settings.is_empty() or not _is_god_mode_life_prewarm_ready_for_settings(settings):
		set_meta("god_mode_capsule_entry_handoff_active", false)
		set_meta("god_mode_start_after_prewarm_requested", false)
		set_meta("god_mode_zero_frame_life_entry_pending", false)
		remove_meta("god_mode_life_start_prevalidated_signature")
		_set_god_mode_prewarm_progress(
			0.0,
			"Press Pre warm world seed first. EraLife will only start after this exact loadout has been prewarmed.",
			false
		)
		_refresh_god_mode_start_button_state()
		return

	var now_ms: int = int(Time.get_ticks_msec())
	set_meta("god_mode_shell_first_handoff_requested_at_ms", now_ms)
	set_meta("god_mode_atomic_shell_handoff_started_at_ms", now_ms)
	set_meta("god_mode_life_entry_hot_capsule_started_at_ms", now_ms)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 900)
	set_meta("spawn_ready_era_border_fast_until_ms", now_ms + 2400)

	var entered: bool = _enter_prewarmed_god_mode_life_full_ui_now(
		settings.duplicate(true),
		"god_mode_start_button_zero_frame_hot_capsule_after_paint"
	)

	remove_meta("god_mode_life_start_prevalidated_signature")
	set_meta("god_mode_zero_frame_life_entry_pending", false)

	if entered:
		_arm_playable_life_surface_authority_lock("god_mode_start_button_hot_capsule_consumed_after_paint")
		if not _force_release_god_mode_handoff_to_visible_life_surface("god_mode_start_button_hot_capsule_consumed_after_paint"):
			call_deferred(
				"_deferred_release_god_mode_handoff_cover_after_playable_frame",
				"god_mode_start_button_hot_capsule_consumed_after_paint",
				0
			)
		return

	_abort_god_mode_tracker_handoff("god_mode_start_hot_capsule_missing_after_paint")
	_restore_god_mode_start_button_after_failed_entry(
		"The world seed prewarm was marked ready, but the hot runtime capsule was missing. Press Pre warm world seed again."
	)
func _enter_prewarmed_god_mode_life_full_ui_now(settings: Dictionary, reason: String = "god_mode_start_button") -> bool:
	if not _is_god_mode_life_prewarm_ready_for_settings(settings):
		return false

	var merged_settings:= _build_default_custom_settings()
	for key in settings.keys():
		merged_settings [key] = settings [key]

	var consumed_prewarm: Dictionary = _consume_god_mode_life_prewarm(settings.duplicate(true))
	if not bool(consumed_prewarm.get("success", false)):
		return false

	var consumed_gs_raw: Variant = consumed_prewarm.get("game_state", null)
	if not (consumed_gs_raw is GameState):
		return false

	var consumed_gs: GameState = (
		consumed_gs_raw as GameState
	)

	if (
		consumed_gs == null
		or consumed_gs.player == null
	):
		return false

	var consumed_signature: String = str(
		consumed_prewarm.get(
			"signature",
			""
		)
	).strip_edges()

	if not _adopt_attached_resident_game_state(
		consumed_gs,
		consumed_signature
	):
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(Time.get_ticks_msec())

	var candidate_raw: Variant = merged_settings.get("_prebirth_reality_candidate", {})
	var candidate: Dictionary = candidate_raw.duplicate(true) if typeof(candidate_raw) == TYPE_DICTIONARY else {}

	var seed_contract_raw: Variant = merged_settings.get("seed_contract", {})
	var seed_contract: Dictionary = seed_contract_raw.duplicate(true) if typeof(seed_contract_raw) == TYPE_DICTIONARY else {}

	var world_seed: int = int(merged_settings.get("world_seed", candidate.get("world_seed", seed_contract.get("seed", -1))))

	if seed_contract.is_empty() and world_seed > 0:
		seed_contract = {
			"schema": "eralife.seed_contract",
			"version": 1,
			"seed": world_seed,
			"source": "enter_prewarmed_god_mode_life_full_ui_now",
			"candidate_id": str(candidate.get("candidate_id", merged_settings.get("_prebirth_reality_candidate_id", ""))),
			"single_target_reality": true
		}

	var birth_boot_context: Dictionary = _birth_shell_boot_context_from_settings(merged_settings)
	var target_year: int = int(birth_boot_context.get("target_year", int(merged_settings.get("year", gs.year))))
	var era_key: String = str(birth_boot_context.get("era_key", str(merged_settings.get("era", "")))).strip_edges()

	gs.custom_mode = true
	gs.awaiting_new_life = false
	gs.afterlife_active = false
	gs.afterlife_state.clear()
	gs.custom_settings = merged_settings.duplicate(true)
	gs.year = target_year

	if gs.era_engine != null and typeof(gs.era_engine.eras) == TYPE_DICTIONARY and gs.era_engine.eras.has(era_key):
		gs.era = gs.era_engine.eras.get(era_key, {}).duplicate(true)
	elif gs.era_engine != null and gs.era_engine.has_method("_era_from_year"):
		gs.era = gs.era_engine._era_from_year(target_year)

	if "reality_mode" in gs:
		gs.reality_mode = str(birth_boot_context.get("reality_mode", merged_settings.get("reality_mode", "realistic")))

	var birth_intro_cry_entry_kind: String = str(merged_settings.get("_god_mode_entry_kind", "custom")).strip_edges().to_lower()
	if birth_intro_cry_entry_kind == "":
		birth_intro_cry_entry_kind = "custom"

	if MainSceneHelpers._birth_intro_cry_should_arm_for_settings(merged_settings):
		_arm_birth_intro_cry_for_first_playable_ui("enter_prewarmed_god_mode_life_full_ui_now", birth_intro_cry_entry_kind)
	else:
		_mark_birth_intro_cry_consumed("enter_prewarmed_god_mode_life_full_ui_now_non_newborn_start", false)

	var consumed_contract_raw: Variant = consumed_prewarm.get("contract", {})
	var consumed_contract: Dictionary = consumed_contract_raw.duplicate(true) if typeof(consumed_contract_raw) == TYPE_DICTIONARY else {}

	gs.scenario_state ["god_mode_life_prewarm_consumed"] = true
	gs.scenario_state ["god_mode_life_prewarm_signature"] = str(consumed_prewarm.get("signature", ""))
	gs.scenario_state ["god_mode_life_prewarm_contract"] = consumed_contract.duplicate(true)
	gs.scenario_state ["god_mode_life_finalize_policy"] = "hot_full_ui_no_finalize_game_boot"
	gs.scenario_state ["god_mode_life_finalize_reason"] = reason
	gs.scenario_state ["god_mode_life_finalize_at_ms"] = now_ms
	gs.scenario_state ["world_seed"] = world_seed
	gs.scenario_state ["seed_contract"] = seed_contract.duplicate(true)
	gs.scenario_state ["god_mode_prebirth_reality_candidate"] = candidate.duplicate(true)
	gs.scenario_state ["single_target_reality"] = true
	gs.scenario_state ["prebirth_reality_locked"] = true
	gs.scenario_state ["hydrate_player_before_surrounding_world"] = true

	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = false
	gs.scenario_state ["prewarmed_capsule_entry_requested_at_ms"] = now_ms
	gs.scenario_state ["spawn_shell_entry_policy"] = "full_playable_ui_from_prewarmed_capsule"
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["birth_shell_first_boot"] = false
	gs.scenario_state ["birth_shell_first_boot_active"] = false
	gs.scenario_state ["birth_shell_player_created"] = true
	gs.scenario_state ["birth_shell_player_id"] = int(gs.player.id)
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["ui_first_frame_render_policy"] = "full_playable_ui_visible_no_runtime_work"
	gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false
	gs.scenario_state ["god_mode_life_entry_full_ui_ready"] = true
	gs.scenario_state ["god_mode_life_entry_full_ui_ready_at_ms"] = now_ms
	gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_only_after_player_control_grace"
	gs.scenario_state ["post_spawn_world_prewarm_player_control_grace_until_ms"] = now_ms + 12000
	gs.scenario_state ["defer_static_world_bootstrap"] = true
	gs.scenario_state ["defer_live_runtime_watchers"] = true
	gs.scenario_state ["defer_noncritical_systems_until_player_control"] = true
	gs.scenario_state ["body_contract_tail_work_pending"] = true
	gs.scenario_state ["body_contract_tail_work_source"] = reason
	gs.scenario_state ["live_reality_stream_bound"] = false
	gs.scenario_state ["deferred_live_reality_stream_bind_pending"] = true
	gs.scenario_state ["ui_background_reconciliation_streaming"] = true
	gs.scenario_state ["blank_shell_guard_active"] = false
	gs.scenario_state ["blank_shell_guard_reason"] = "full_ui_prewarmed_capsule_entry"

	set_meta("god_mode_life_boot_uses_prewarmed_spawn", true)
	set_meta("prewarmed_capsule_entry_shell_first", false)
	set_meta("god_mode_shell_first_handoff_requested", false)
	set_meta("god_mode_life_entry_full_ui_required", true)
	set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
	set_meta("god_mode_life_finalization_after_zero_frame_released_at_ms", now_ms)
	set_meta("god_mode_life_finalization_policy", "hot_full_ui_no_finalize_game_boot")
	set_meta("god_mode_atomic_shell_handoff_active", false)
	set_meta("god_mode_capsule_entry_handoff_active", true)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("startup_birth_loading_overlay_active", false)
	set_meta("birth_entry_reality_surge_active", false)
	set_meta("birth_entry_reality_surge_first_frame_committed", true)
	set_meta("spawn_ready_runtime_hud_shell_only_active", false)
	set_meta("spawn_ready_era_border_fast_until_ms", now_ms + 2400)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 12000)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 1200)
	set_meta("live_reality_stream_bound", false)
	set_meta("deferred_live_reality_stream_bind_pending", true)

	var first_frame_snapshot: Dictionary = {}
	var prebuilt_snapshot_raw: Variant = gs.scenario_state.get("prebuilt_first_frame_ui_snapshot", {})
	if typeof(prebuilt_snapshot_raw) == TYPE_DICTIONARY:
		first_frame_snapshot = (prebuilt_snapshot_raw as Dictionary).duplicate(true)

	if first_frame_snapshot.is_empty():
		first_frame_snapshot = _build_first_frame_ui_snapshot_from_game_state(gs, "enter_prewarmed_god_mode_life_full_ui_fallback")

	_lock_first_frame_ui_snapshot(first_frame_snapshot, "enter_prewarmed_god_mode_life_full_ui")

	_request_immediate_god_mode_audio_fade_for_life_entry(reason, 80)
	_reset_age_up_tail_state_for_new_life_handoff(reason)

	current_panel = "life"
	age_up_diary_entries.clear()
	current_opportunities_cache.clear()

	set_meta("main_menu_surface_terminated_for_playable_entry", true)
	set_meta("main_menu_surface_terminated_reason", "enter_prewarmed_god_mode_life_full_ui")
	set_meta("main_menu_surface_active", false)
	set_meta("god_mode_defer_cover_release_until_live_frame", false)
	set_meta("god_mode_cover_keeps_full_panel_visible_until_live_frame", false)
	set_meta("god_mode_handoff_cover_release_pending", false)
	set_meta("spawn_ready_visible_ui_ready_for_audio", false)
	set_meta("god_mode_handoff_cover_release_reason", "enter_prewarmed_god_mode_life_full_ui")
	set_meta("god_mode_playable_ui_atomic_commit_complete", false)

	_terminate_main_menu_surface_for_playable_entry("enter_prewarmed_god_mode_life_full_ui")

	if age_up_loading_runtime_active or (age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay) and age_up_loading_overlay.visible):
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false

	_assert_god_mode_full_ui_entry_contract(merged_settings, "enter_prewarmed_god_mode_life_full_ui")
	_claim_god_mode_tracker_handoff(
		merged_settings,
		str(consumed_prewarm.get("signature", _god_mode_life_prewarm_signature(merged_settings))),
		"enter_prewarmed_god_mode_life_full_ui"
	)

	_prime_prewarmed_capsule_live_ui_surface_without_handoff("enter_prewarmed_god_mode_life_full_ui")

	if not _commit_god_mode_to_playable_ui_atomic("enter_prewarmed_god_mode_life_full_ui"):
		_keep_god_mode_cover_visible_until_playable_ui("enter_prewarmed_god_mode_life_full_ui_commit_not_ready")
		call_deferred(
			"_deferred_release_god_mode_handoff_cover_after_playable_frame",
			"enter_prewarmed_god_mode_life_full_ui_retry",
			0
		)
		return true

	_complete_god_mode_tracker_entry("enter_prewarmed_god_mode_life_full_ui")

	call_deferred("_flush_runtime_boot_buffered_ui_intents")
	_schedule_god_mode_post_entry_tail_work_after_control_grace("enter_prewarmed_god_mode_life_full_ui")

	return true
func _schedule_god_mode_post_entry_tail_work_after_control_grace(reason: String = "god_mode_entry") -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var not_before_ms: int = now_ms + 900
	var existing_not_before_ms: int = int(get_meta("god_mode_birth_tail_work_not_before_ms", 0))
	var control_grace_until_ms: int = _global_runtime_visible_shell_control_grace_until_ms()

	if existing_not_before_ms > not_before_ms:
		not_before_ms = existing_not_before_ms
	if control_grace_until_ms > not_before_ms:
		not_before_ms = control_grace_until_ms + 240

	set_meta("god_mode_post_entry_tail_work_pending", true)
	set_meta("god_mode_post_entry_tail_work_reason", reason)
	set_meta("god_mode_post_entry_tail_work_scheduled_at_ms", now_ms)
	set_meta("god_mode_post_entry_tail_work_not_before_ms", not_before_ms)
	set_meta("god_mode_post_entry_tail_work_background_only", true)
	set_meta("god_mode_post_entry_tail_work_may_not_block_ui", true)
	set_meta("god_mode_post_entry_tail_work_may_not_start_loading", true)

	if bool(get_meta("god_mode_post_entry_tail_work_timer_connected", false)):
		return

	set_meta("god_mode_post_entry_tail_work_timer_connected", true)

	var tree:= get_tree()
	if tree == null:
		set_meta("god_mode_post_entry_tail_work_timer_connected", false)
		return

	var delay_seconds: float = clamp(float(not_before_ms - now_ms) / 1000.0, 0.45, 12.0)
	var timer:= tree.create_timer(delay_seconds)
	timer.timeout.connect(
		Callable(self, "_run_god_mode_post_entry_tail_work_after_control_grace").bind(reason),
		CONNECT_ONE_SHOT
	)
func _run_god_mode_post_entry_tail_work_after_control_grace(reason: String = "god_mode_entry") -> void:
	set_meta("god_mode_post_entry_tail_work_timer_connected", false)

	if gs == null or gs.player == null:
		set_meta("god_mode_post_entry_tail_work_pending", false)
		return

	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty():
		var control_grace_until_ms: int = _global_runtime_visible_shell_control_grace_until_ms()
		if control_grace_until_ms > now_ms:
			set_meta("god_mode_post_entry_tail_work_pending", true)
			set_meta("god_mode_post_entry_tail_work_yielded_to_visible_shell_control_grace", true)
			set_meta("god_mode_post_entry_tail_work_not_before_ms", control_grace_until_ms + 240)
			set_meta("god_mode_post_entry_tail_work_background_only", true)
			set_meta("god_mode_post_entry_tail_work_may_not_block_ui", true)
			set_meta("god_mode_post_entry_tail_work_may_not_start_loading", true)

			var tree:= get_tree()
			if tree == null:
				return

			if bool(get_meta("god_mode_post_entry_tail_work_timer_connected", false)):
				return

			set_meta("god_mode_post_entry_tail_work_timer_connected", true)

			var grace_delay_seconds: float = clamp(float((control_grace_until_ms + 240) - now_ms) / 1000.0, 0.45, 12.0)
			var grace_timer:= tree.create_timer(grace_delay_seconds)
			grace_timer.timeout.connect(
				Callable(self, "_run_god_mode_post_entry_tail_work_after_control_grace").bind(reason),
				CONNECT_ONE_SHOT
			)
			return

		if not _global_runtime_kill_claim_allowed("background_tail", "Mainscene._run_god_mode_post_entry_tail_work_after_control_grace", reason, {
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": true,
			"microtask_budget": 1
		}):
			set_meta("god_mode_post_entry_tail_work_pending", true)
			set_meta("god_mode_post_entry_tail_work_denied_by_global_runtime_kill", true)
			set_meta("god_mode_post_entry_tail_work_denied_reason", reason)
			set_meta("god_mode_post_entry_tail_work_denied_at_ms", now_ms)
			set_meta("god_mode_post_entry_tail_work_not_before_ms", now_ms + 1800)
			set_meta("ui_idle_bus_flush_next_ms", now_ms + 1800)
			return

		_convert_visible_shell_tail_work_to_background_only("%s_visible_shell_sovereignty" % reason)

		set_meta("god_mode_post_entry_tail_work_pending", false)
		set_meta("god_mode_post_entry_tail_work_started_at_ms", now_ms)
		set_meta("god_mode_post_entry_tail_work_background_only", true)
		set_meta("god_mode_post_entry_tail_work_skipped_second_boot", true)
		set_meta("god_mode_post_entry_tail_work_skipped_second_boot_reason", reason)
		set_meta("god_mode_post_entry_tail_work_skipped_second_boot_at_ms", now_ms)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["god_mode_post_entry_tail_work_pending"] = false
			gs.scenario_state ["god_mode_post_entry_tail_work_background_only"] = true
			gs.scenario_state ["god_mode_post_entry_tail_work_skipped_second_boot"] = true
			gs.scenario_state ["body_contract_tail_work_pending"] = false
			gs.scenario_state ["body_contract_tail_work_background_pending"] = true
			gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
			gs.scenario_state ["life_runtime_background_tail_deferred"] = true
			gs.scenario_state ["world_tail_work_may_not_block_visible_shell"] = true
			gs.scenario_state ["ready_shell_blocks_loading_runtime"] = true
			gs.scenario_state ["ready_shell_visible_loading_forbidden"] = true
			gs.scenario_state ["tail_work_after_visible_surface_background_only"] = true
			gs.scenario_state ["tail_work_after_visible_surface_may_not_block_ui"] = true
			gs.scenario_state ["tail_work_after_visible_surface_may_not_start_loading"] = true

		call_deferred("_schedule_deferred_live_reality_stream_bind_for_spawn", "%s_background_after_visible_shell" % reason)
		return

	if not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
		_schedule_god_mode_post_entry_tail_work_after_control_grace("%s_wait_for_atomic_commit" % reason)
		return

	var not_before_ms: int = int(get_meta("god_mode_post_entry_tail_work_not_before_ms", 0))
	var player_control_grace_until_ms: int = 0
	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		player_control_grace_until_ms = int(gs.scenario_state.get("post_spawn_world_prewarm_player_control_grace_until_ms", 0))

	var must_yield_to_player: bool = false
	must_yield_to_player = must_yield_to_player or (not_before_ms > 0 and now_ms < not_before_ms)
	must_yield_to_player = must_yield_to_player or (player_control_grace_until_ms > 0 and now_ms < player_control_grace_until_ms)
	must_yield_to_player = must_yield_to_player or _ui_interaction_grace_active(now_ms)
	must_yield_to_player = must_yield_to_player or _runtime_interactive_surface_busy(now_ms)
	must_yield_to_player = must_yield_to_player or _post_spawn_ui_is_busy_for_prewarm()

	if must_yield_to_player:
		set_meta("god_mode_post_entry_tail_work_pending", true)
		set_meta("god_mode_post_entry_tail_work_yielded_to_player", true)
		set_meta("god_mode_post_entry_tail_work_yielded_to_player_at_ms", now_ms)
		set_meta("god_mode_post_entry_tail_work_yielded_reason", reason)

		var tree:= get_tree()
		if tree == null:
			call_deferred("_run_god_mode_post_entry_tail_work_after_control_grace", reason)
			return

		if bool(get_meta("god_mode_post_entry_tail_work_timer_connected", false)):
			return

		set_meta("god_mode_post_entry_tail_work_timer_connected", true)

		var retry_delay_seconds: float = 0.45
		if player_control_grace_until_ms > now_ms:
			retry_delay_seconds = clamp(float(player_control_grace_until_ms - now_ms) / 1000.0, 0.45, 1.25)
		elif not_before_ms > now_ms:
			retry_delay_seconds = clamp(float(not_before_ms - now_ms) / 1000.0, 0.25, 0.9)

		var retry_timer:= tree.create_timer(retry_delay_seconds)
		retry_timer.timeout.connect(
			Callable(self, "_run_god_mode_post_entry_tail_work_after_control_grace").bind(reason),
			CONNECT_ONE_SHOT
		)
		return

	set_meta("god_mode_post_entry_tail_work_pending", false)
	set_meta("god_mode_post_entry_tail_work_started_at_ms", now_ms)
	set_meta("god_mode_post_entry_tail_work_background_only", true)
	set_meta("god_mode_post_entry_tail_work_skipped_second_boot", true)
	set_meta("god_mode_post_entry_tail_work_skipped_second_boot_reason", reason)
	set_meta("god_mode_post_entry_tail_work_skipped_second_boot_at_ms", now_ms)

	call_deferred("_schedule_deferred_live_reality_stream_bind_for_spawn", "%s_background_after_atomic_playable_ui" % reason)
func _schedule_finalize_previewed_god_mode_life_entry_state_only_after_first_paint(settings: Dictionary, reason: String = "god_mode_start_button") -> void:
	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("post_visible_finalization", "Mainscene._schedule_finalize_previewed_god_mode_life_entry_state_only_after_first_paint", reason, {
			"blocks_ui": true,
			"background_only": false
		}):
			set_meta("god_mode_life_finalization_after_zero_frame_pending", false)
			set_meta("god_mode_life_finalization_after_zero_frame_connected", false)
			set_meta("god_mode_life_finalization_after_zero_frame_blocked_by_global_runtime_kill", true)
			set_meta("god_mode_life_finalization_after_zero_frame_blocked_reason", reason)
			set_meta("god_mode_life_finalization_after_zero_frame_blocked_at_ms", int(Time.get_ticks_msec()))
			return

	set_meta("god_mode_life_finalization_after_zero_frame_pending", true)
	set_meta("god_mode_life_finalization_after_zero_frame_reason", reason)
	set_meta("god_mode_life_finalization_after_zero_frame_scheduled_at_ms", int(Time.get_ticks_msec()))

	if bool(get_meta("god_mode_life_finalization_after_zero_frame_connected", false)):
		return

	set_meta("god_mode_life_finalization_after_zero_frame_connected", true)

	var finalize_callable:= Callable(self, "_finalize_previewed_god_mode_life_entry_state_only_after_first_paint").bind(settings.duplicate(true), reason)
	RenderingServer.frame_post_draw.connect(finalize_callable, CONNECT_ONE_SHOT)


func _finalize_previewed_god_mode_life_entry_state_only_after_first_paint(settings: Dictionary, reason: String = "god_mode_start_button") -> void:
	set_meta("god_mode_life_finalization_after_zero_frame_connected", false)

	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("post_visible_finalization", "Mainscene._finalize_previewed_god_mode_life_entry_state_only_after_first_paint", reason, {
			"blocks_ui": true,
			"background_only": false
		}):
			set_meta("god_mode_life_finalization_after_first_paint_cancelled_by_global_runtime_kill", true)
			set_meta("god_mode_life_finalization_after_first_paint_cancelled_reason", reason)
			set_meta("god_mode_life_finalization_after_first_paint_cancelled_at_ms", int(Time.get_ticks_msec()))
			return

	var tree:= get_tree()
	if tree != null:
		await tree.process_frame

	if _playable_life_shell_has_visible_sovereignty():
