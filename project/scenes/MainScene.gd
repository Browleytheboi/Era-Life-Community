				"main_scene_crime_panel_section_row"
			)
		}
	)

	gs.event_bus.subscribe(
		"crime.hub.incarceration_lens.published",
		self,
		"_on_crime_incarceration_lens_bus_published",
		{
			"lane": "important",
			"allow_defer": false,
