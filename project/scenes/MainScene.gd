func _school_hub_responsive_meal_grid_columns() -> int:
	var width: float = 0.0

	if institution_hub_scroll != null and is_instance_valid(institution_hub_scroll):
		width = max(width, institution_hub_scroll.size.x)

	if institution_hub_list != null and is_instance_valid(institution_hub_list):
		width = max(width, institution_hub_list.size.x)

	if institution_hub_card != null and is_instance_valid(institution_hub_card):
		width = max(width, institution_hub_card.size.x - 56.0)

	if width <= 0.0:
		width = get_viewport_rect().size.x * 0.84

	if width >= 980.0:
		return 3

	return 2


