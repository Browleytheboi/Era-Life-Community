			)

	if belongings_item_target_popup_scroll != null:
		belongings_item_target_popup_scroll.scroll_vertical = 0

	belongings_item_target_popup_dim.visible = true
	belongings_item_target_popup.visible = true
	_bring_modal_to_front(
		belongings_item_target_popup_dim
	)
	_bring_modal_to_front(
		belongings_item_target_popup
	)
func _perform_red_bonnet_targeted_popup_action(
	target: Person
) -> void:
	if (
		gs == null
		or gs.player == null
		or target == null
	):
		return

	var wish_name: String = str(
		belongings_item_target_popup_selected_wish
	).strip_edges()

	if wish_name == "":
		return

	var diary_snapshot: Dictionary = (
		_capture_player_diary_snapshot()
	)

	var result: Dictionary = (
		_express_artifact_interaction_intent(
			"perform_red_bonnet_wish",
			{
				"wish_name": wish_name,
				"target_id": int(
					target.id
				),
				"source": (
					"mainscene"
					+ ".red_bonnet_targeted_wish"
				)
			}
		)
	)

	var result_text: String = str(
		result.get(
			"text",
			result.get(
				"popup_text",
				""
			)
		)
	).strip_edges()

	_hide_artifact_target_popup()

	current_panel = "life"
	_refresh_current_panel()

	if activities_action_status_label != null:
		activities_action_status_label.text = result_text

	if (
		output_label != null
		and result_text != ""
	):
		output_label.text = result_text

	_flush_player_diary_delta(
		diary_snapshot,
		result_text,
		true
	)
	_refresh_identity_bound_surfaces()
	_render_life_diary_panel()
	call_deferred(
		"_scroll_life_diary_to_bottom"
	)
