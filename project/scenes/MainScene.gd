func _show_superpower_hub_detail_panel(payload: Dictionary) -> void:
	_ensure_superpower_hub_detail_panel()
	if superpower_hub_detail_overlay == null:
		return

	superpower_hub_detail_payload = payload.duplicate(true)
	superpower_hub_detail_open = true
	superpower_hub_detail_overlay.visible = true
	superpower_hub_detail_overlay.modulate = Color(1, 1, 1, 0)
	superpower_hub_detail_overlay.scale = Vector2(0.98, 0.98)

	if superpower_hub_detail_title != null:
		superpower_hub_detail_title.text = str(payload.get("title", "POWER DETAIL")).to_upper()

	if superpower_hub_detail_body != null:
		superpower_hub_detail_body.clear()
		var lines: Array = _superpower_hub_safe_array(payload.get("lines", []))
		superpower_hub_detail_body.append_text("\n\n".join(lines))

	if superpower_hub_detail_actions != null:
		_clear_container_children(superpower_hub_detail_actions)
		var actions: Array = _superpower_hub_safe_array(payload.get("actions", []))
		for raw_action in actions:
			if typeof(raw_action) != TYPE_DICTIONARY:
				continue

			var action: Dictionary = _superpower_hub_safe_dictionary(raw_action)
			var button:= Button.new()
			button.text = str(action.get("label", "Choose"))
			button.focus_mode = Control.FOCUS_NONE
			button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			button.disabled = bool(action.get("disabled", false))
			button.tooltip_text = str(action.get("description", action.get("disabled_reason", "")))
			button.pressed.connect(_on_superpower_hub_detail_action_pressed.bind(action))
			_style_god_mode_button(button, true)
			superpower_hub_detail_actions.add_child(button)

	var tween:= create_tween()
	tween.set_parallel(true)
	tween.tween_property(superpower_hub_detail_overlay, "modulate", Color(1, 1, 1, 1), 0.16)
	tween.tween_property(superpower_hub_detail_overlay, "scale", Vector2.ONE, 0.16)
	_bring_modal_to_front(superpower_hub_detail_overlay)
	superpower_hub_detail_overlay.grab_focus()


func _hide_superpower_hub_detail_panel() -> void:
	superpower_hub_detail_open = false
	superpower_hub_detail_payload = {}
	if superpower_hub_detail_overlay != null:
		superpower_hub_detail_overlay.visible = false


func _superpower_hub_action_requires_detail_panel(action: Dictionary) -> bool:
	if bool(action.get("requires_power_action_panel", false)):
		return true

	var payload: Dictionary = _superpower_hub_safe_dictionary(action.get("payload", {}))
	if bool(payload.get("requires_power_action_panel", false)):
		return true

	var action_id: String = str(payload.get("action", action.get("id", ""))).strip_edges().to_lower()
	return action_id in [
		"activate",
		"activate_power",
		"activate_mutation",
		"use_mutation",
		"use_mutated_ability"
	]


func _open_power_use_action_panel(action: Dictionary, source_hub: String) -> void:
	var payload: Dictionary = _superpower_hub_safe_dictionary(action.get("payload", {}))
