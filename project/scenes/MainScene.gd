func _on_bending_dojo_student_profile_pressed(person_id: int) -> void:
	if person_id <= 0:
		return

	_dismiss_bending_dojo_hub_popup()

	if has_method("_open_relationship_profile_for_person_id"):
		call("_open_relationship_profile_for_person_id", person_id)
		return

	_maybe_show_action_result_popup({
		"success": false,
		"popup_title": "Profile",
		"popup_text": "That profile route is not available from this surface yet.",
		"popup_footer": "Tap anywhere to continue."
	})


func _on_bending_dojo_spar_pressed(target_id: int, tier_id: String = "") -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null:
		return
	if not ("bending_dojo_engine" in gs):
		return
	if gs.bending_dojo_engine == null or not gs.bending_dojo_engine.has_method("spar_in_dojo"):
		return

	_dismiss_bending_dojo_hub_popup()

	var result: Dictionary = gs.bending_dojo_engine.spar_in_dojo(actor, target_id, {
		"source": "dojo_hub_spar",
		"interactive": true,
		"tier_id": tier_id,
		"sensei_teaching_enabled": true,
		"style_adaptation_enabled": true,
		"film_study_enabled": true
	})

	if bool(result.get("success", false)) and str(result.get("route", "")) == "scenario_engine":
		if gs.scenario_engine != null and gs.scenario_engine.has_method("queue_external_scenario"):
			var scenario: Dictionary = result.get("scenario", {}) if typeof(result.get("scenario", {})) == TYPE_DICTIONARY else {}
			if not scenario.is_empty():
				var queue_result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
				_refresh_scenario_ui_from_result(queue_result)
		else:
			_maybe_show_action_result_popup({
				"success": false,
				"popup_title": "Scenario Runtime Missing",
				"popup_text": "ScenarioEngine.queue_external_scenario() is unavailable.",
				"popup_footer": "Tap anywhere to continue."
			})
	elif bool(result.get("success", false)) and typeof(result.get("match_payload", {})) == TYPE_DICTIONARY:
		_show_bending_dojo_spar_match_popup(result)
	else:
		_maybe_show_action_result_popup(result)

	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
func _on_bending_dojo_spectate_spar_pressed(dojo_id: String) -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null:
		return
	if not ("bending_dojo_engine" in gs):
		return
	if gs.bending_dojo_engine == null or not gs.bending_dojo_engine.has_method("spectate_dojo_spar"):
		return

	_dismiss_bending_dojo_hub_popup()

	var result: Dictionary = gs.bending_dojo_engine.spectate_dojo_spar(actor, dojo_id, {
		"source": "dojo_hub_spectate_npc_spar",
		"tier_id": "intermediate",
		"sensei_teaching_enabled": true,
		"style_adaptation_enabled": true,
		"film_study_enabled": true,
		"live_spectator_frames_enabled": true
	})

	var frames_raw: Variant = result.get("spectator_frames", [])
	if bool(result.get("success", false)) and typeof(frames_raw) == TYPE_ARRAY and not (frames_raw as Array).is_empty():
		_refresh_scenario_ui_from_result(result)
	elif bool(result.get("success", false)) and typeof(result.get("match_payload", {})) == TYPE_DICTIONARY:
		_show_bending_dojo_spar_match_popup(result)
	else:
		_maybe_show_action_result_popup(result)

	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()

