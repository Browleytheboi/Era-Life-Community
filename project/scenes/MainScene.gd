func _prepare_resident_playable_life_shell_for_attach(
		reason: String
) -> Dictionary:
	var missing: Array = []
	var actor_id: int = -1

	if gs == null or gs.player == null:
		missing.append("game_state_or_player")
	else:
		actor_id = int(gs.player.id)

	var root:= get_node_or_null(
		"UIContainer"
	) as Control
	if root == null or not is_instance_valid(root):
		missing.append("UIContainer")

	var era_background:= get_node_or_null(
		"__EraBackgroundFill"
	) as ColorRect

	if output_label == null or not is_instance_valid(output_label):
		missing.append("LifeDiary")

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		missing.append("PlayerStatsOverlay")

	if era_background == null or not is_instance_valid(era_background):
		missing.append("EraBackgroundFill")

	if era_border_overlay == null or not is_instance_valid(era_border_overlay):
		missing.append("EraBorderOverlay")

	var required_hud_nodes: Array = [
		["BelongingsButton", belongings_hud_button],
		["BelongingsPanel", belongings_hud_panel],
		["BendingButton", bending_hud_button],
		["CrownButton", crown_hud_button],
		["FoodLifestyleButton", food_lifestyle_hud_button],
		["RestaurantLifestyleButton", restaurant_lifestyle_hud_button],
		["RickWeaponShopButton", rick_weapon_shop_hud_button],
		["BoxingButton", boxing_hud_button],
		["SuperpowerButton", superpower_hud_button],
		["PowerButton", power_hud_button],
		["WizardButton", wizard_hud_button],
		["WizardPanel", wizard_hud_panel]
	]

	for required_row_raw in required_hud_nodes:
		var required_row: Array = required_row_raw as Array
		var node_name: String = str(required_row [0])
		var node_value: Variant = required_row [1]
		if node_value == null or not is_instance_valid(node_value):
			missing.append(node_name)

	for raw_key in _get_ui_nav_order():
		var key: String = str(raw_key)
		var button:= ui_nav_buttons.get(
			key,
			null
		) as Button
		if button == null or not is_instance_valid(button):
			missing.append(
				"NavButton:%s" % key
			)

	var success: bool = missing.is_empty()
	var report: Dictionary = {
		"success": success,
		"schema": "eralife.resident_playable_life_shell_attach_report",
		"version": 3,
		"reason": reason,
		"actor_id": actor_id,
		"missing": missing.duplicate(false),
		"shell_is_resident": success,
		"ui_is_renderer_only": true,
		"prepared_at_ms": int(Time.get_ticks_msec())
	}

	set_meta(
		"resident_playable_life_shell_attach_report",
		report.duplicate(false)
	)
	set_meta(
		"resident_playable_life_shell_surface_hot",
		success
	)

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state [
			"resident_playable_life_shell_attach_report"
		] = report.duplicate(false)
		gs.scenario_state [
			"resident_playable_life_shell_surface_hot"
		] = success

	EraLog.truth(
		"ERALIFE_CHECKPOINT_SHELL_CONTRACT_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|hot=" + str(success).to_lower()
		+ "|missing=" + str(missing)
		+ "|visual_constructors_called=false"
		+ "|build_on_attach=false"
		+ "|ready_hydration=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	return report
