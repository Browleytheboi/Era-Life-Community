func _complete_deferred_belonging_popup_contract_action(
	action_spec: Dictionary,
	fallback_item: Dictionary,
	actor_id: int
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
	):
		return




	var tree:= get_tree()

	if tree == null:
		return

	await tree.process_frame

	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
	):
		return

	var result: Dictionary = (
		_execute_belonging_popup_contract_action(
			action_spec,
			fallback_item
		)
	)

	cached_last_result = result

	set_meta(
		"belongings_deferred_authority_completed",
		true
	)
	set_meta(
		"belongings_deferred_authority_completed_actor_id",
		actor_id
	)
	set_meta(
		"belongings_deferred_authority_completed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"belongings_deferred_authority_ready_gate_member",
		false
	)
	set_meta(
		"belongings_deferred_authority_blocks_ui",
		false
	)
	set_meta(
		"belongings_deferred_authority_simulation_ran_during_idle",
		false
	)
	set_meta(
		"belongings_deferred_authority_process_frame_owned",
		true
	)

	var result_type: String = str(
		result.get(
			"type",
			""
		)
	).strip_edges().to_lower()

	if result_type.begins_with(
		"afterlife"
	):



		_refresh_afterlife_ui_from_result(
			result
		)

		belongings_hud_content_dirty = true

		set_meta(
			"death_transition_post_visible_identity_refresh_suppressed",
			true
		)
		set_meta(
			"death_transition_post_visible_diary_refresh_suppressed",
			true
		)
		set_meta(
			"death_transition_post_visible_stats_refresh_suppressed",
			true
		)

		return

	var result_text: String = str(
		result.get(
			"text",
			result.get(
				"popup_text",
				""
			)
		)
	).strip_edges()

	if (
		result_text != ""
		and bool(
			result.get(
				"log_to_diary",
				true
			)
		)
	):
		_append_text_to_diary(
			MainSceneHelpers._compact_diary_text(
				result_text
			),
			false
		)

	if bool(
		action_spec.get(
			"refresh_after",
			false
		)
	):
		belongings_hud_content_dirty = true

		call_deferred(
			"_update_belongings_hud"
		)

	_maybe_show_action_result_popup(
		result
	)
func _complete_belonging_crime_action_after_panel_paint(
	action_spec: Dictionary,
	fallback_item: Dictionary,
	actor_id: int,
	reveal_started_ms: int
) -> void:







	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != actor_id
		or crime_panel == null
		or not is_instance_valid(
			crime_panel
		)
		or not crime_panel_open
	):
		return

	var payload: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			action_spec.get(
				"payload",
				{}
			)
		)
	)

	if not payload.has(
		"source_item"
	):
		payload [
			"source_item"
		] = fallback_item

	payload [
		"action_id"
	] = str(
		payload.get(
			"action_id",
			action_spec.get(
				"id",
				"begin_weapon_action"
			)
		)
	).strip_edges().to_lower()

	payload [
		"section_id"
	] = "targets"

	payload [
		"source"
	] = str(
		payload.get(
			"source",
			"mainscene.belongings_to_crime"
		)
	)

	payload [
		"immutable_contract_references"
	] = true
	payload [
		"build_on_press"
	] = false
	payload [
		"blocks_ui"
	] = false









	_express_crime_hub_panel_action(
		payload
	)

	set_meta(
		"belongings_crime_intent_completed_after_paint",
		true
	)
	set_meta(
		"belongings_crime_intent_completed_after_paint_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"belongings_crime_intent_visible_before_authority_ms",
		maxi(
			0,
			int(
				Time.get_ticks_msec()
			) - reveal_started_ms
		)
	)
	set_meta(
		"belongings_crime_intent_engine_call_performed_here",
		false
	)
	set_meta(
		"belongings_crime_intent_process_frame_wait",
		false
	)
	set_meta(
		"belongings_crime_intent_frame_post_draw_wait",
		false
	)
	set_meta(
		"belongings_crime_target_surface_resident_first",
		false
	)
	set_meta(
		"belongings_crime_unarmed_target_surface_revealed",
		false
	)
	set_meta(
		"belongings_crime_target_surface_waits_for_armed_contract",
		true
	)
func _arm_crime_hub_action_service() -> void:
	if (
		crime_hub_action_service_active
		or crime_hub_action_queue.is_empty()
	):
		return

	var tree:= get_tree()

	if tree == null:
		return

	crime_hub_action_service_active = true

	tree.process_frame.connect(
		Callable(
			self,
			"_service_crime_hub_action_queue"
		),
		CONNECT_ONE_SHOT | CONNECT_DEFERRED
	)
func _execute_belonging_popup_contract_action(
	action_spec: Dictionary,
	fallback_item: Dictionary = {}
) -> Dictionary:
	if (
		gs == null
		or gs.player == null
	):
		return {
			"success": false,
			"popup_title": "Inventory Action",
			"popup_text": (
				"GameState or the controlled actor is unavailable."
			),
			"popup_footer": "Tap anywhere to continue.",
		}

	var engine_property: String = str(
		action_spec.get(
			"engine_property",
			""
		)
	).strip_edges()
	var method_name: String = str(
		action_spec.get(
			"method",
			""
		)
	).strip_edges()
	var call_mode: String = str(
		action_spec.get(
			"call_mode",
			"payload_context"
		)
	).strip_edges().to_lower()

	if (
		engine_property == ""
		or method_name == ""
	):
		return {
			"success": false,
			"popup_title": "Inventory Action",
			"popup_text": (
				"This item action is missing its contracted "
				+ "engine or method."
			),
			"popup_footer": "Tap anywhere to continue.",
		}

	var payload: Dictionary = (
		_belonging_popup_safe_dictionary(
			action_spec.get(
				"payload",
				{}
			)
		)
	)

	if not payload.has("source_item"):
		payload ["source_item"] = (
			fallback_item.duplicate(true)
		)

	var actor_id: int = int(
		gs.player.id
	)
	var action_id: String = str(
		action_spec.get(
			"id",
			action_spec.get(
				"action_id",
				payload.get(
					"action_id",
					"belongings_item_action"
				)
			)
		)
	).strip_edges().to_lower()

	if action_id == "":
		action_id = "belongings_item_action"

	payload ["actor_id"] = actor_id
	payload ["action_id"] = str(
		payload.get(
			"action_id",
			action_id
		)
	).strip_edges().to_lower()
	payload ["source"] = str(
		payload.get(
			"source",
			"mainscene.belonging_item_popup"
		)
	)
	payload ["ui_is_renderer_only"] = true

	var route_target: Dictionary = {
		"route_kind": "engine_method",
		"engine_property": engine_property,
		"method": method_name,
		"actor_id": actor_id,
		"pass_actor_payload": false
	}
	var action_context: Dictionary = {
		"source": "mainscene.belonging_item_popup",
		"item": fallback_item.duplicate(true),
		"actor_id": actor_id,
		"ui_is_expression_only": true
	}

	match call_mode:
		"none":
			route_target ["pass_actor_payload"] = false

		"payload":
			route_target ["args"] = [
				payload.duplicate(true)
			]

		"context":
			route_target ["args"] = [
				action_context.duplicate(true)
			]

		"player_payload":
			route_target ["pass_actor_payload"] = true

		_:
			route_target ["args"] = [
				payload.duplicate(true),
				action_context.duplicate(true)
			]

	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "belongings_item_contract_action",
		"surface_id": "belongings_item_popup",
		"action_id": action_id,
		"payload": payload.duplicate(true),
		"target": route_target.duplicate(true),
		"source": payload ["source"],
		"skip_crr_observation": bool(
			action_spec.get(
				"skip_crr_observation",
				payload.get(
					"skip_crr_observation",
					false
				)
			)
		)
	}, {
		"actor_id": actor_id,
		"surface_id": "belongings_item_popup",
		"action_id": action_id,
		"source": payload ["source"],
		"ui_is_expression_only": true
	})

	return _hub_panel_route_result(
		report
	)
