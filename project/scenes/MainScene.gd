func _on_relationship_profile_popup_back_pressed() -> void:
	if not _relationship_profile_try_consume_click(
		"back"
	):
		return

	var return_context: String = (
		relationship_profile_return_context
	)
	var return_coworker_ids: Array = (
		relationship_profile_return_coworker_ids.duplicate()
	)

	_hide_relationship_profile_popup()

	if return_context == "career_coworkers":
		_show_career_coworkers_panel(
			return_coworker_ids
		)
		return

	if return_context == "crown_hub":
		crown_hub_open = true

		if crown_hub_overlay != null:
			crown_hub_overlay.visible = true

		_refresh_crown_hub()
		_bring_modal_to_front(
			crown_hub_overlay
		)
		return

	if return_context == "food_contract_hub":
		_restore_grocery_surface_from_relationship_context(
			"relationship_profile_back"
		)
		return

	if return_context in [
		"resident_relationship_hub",
		"relationship_contract_hub",
		"relationships_browser",
		"institution_relationship_hub"
	]:
		_restore_relationship_hub_after_profile_back(
			"resident_relationship_hub"
		)
		return

	if current_panel == "relationships":
		_restore_relationship_hub_after_profile_back(
			"resident_relationship_hub"
		)
		return

	if (
		ui_contract_active_surface_id.strip_edges()
		== "relationship_contract_hub"
	):
		_restore_relationship_hub_after_profile_back(
			"resident_relationship_hub"
		)
		return

	if (
		ui_contract_active_surface_id.strip_edges()
		!= ""
	):
		_open_contract_surface(
			ui_contract_active_surface_id
		)
		return

	_update_player_stats_overlay()

func _relationship_label_for_target(target: Person) -> String:
	if gs == null or gs.player == null or target == null:
		return "Stranger"

	if int(target.id) == int(gs.player.id):
		return "You"

	var fling_label: String = MainSceneLogic._relationship_profile_fling_label(gs, target)
	if fling_label != "":
		return fling_label

	var lineage_label: String = MainSceneLogic._relationship_label_from_bidirectional_lineage_facts(gs, target)
	if lineage_label != "":
		return lineage_label

	var family_fallback_label: String = _relationship_profile_family_relation_fallback(target)
	if family_fallback_label != "":
		return family_fallback_label

	if gs.has_method("get_relationship_label_between"):
		var label:= str(gs.get_relationship_label_between(gs.player, target)).strip_edges()
		if label != "" and label != "Stranger":
			return label

	lineage_label = MainSceneLogic._relationship_label_from_bidirectional_lineage_facts(gs, target)
	if lineage_label != "":
		return lineage_label

	return "Stranger"
func _relationship_profile_family_relation_fallback(target: Person) -> String:
	if gs == null or gs.player == null or target == null:
		return ""

	var player: Person = gs.player
	var target_id: int = int(target.id)

	if target_id == int(player.id):
		return "You"

	var niece_nephew_label: String = _relationship_profile_niece_nephew_relation_fallback(target)
	if niece_nephew_label != "":
		return niece_nephew_label

	for raw_parent_id in player.parents:
		var parent_id: int = int(raw_parent_id)
		if parent_id <= 0:
			continue

		var parent: Person = gs.get_or_reactivate_npc_by_id(parent_id)
		if parent == null:
			continue

		if MainSceneLogic._relationship_profile_people_share_any_parent(parent, target) and target_id != int(parent.id) and target_id != int(player.id):
			var aunt_uncle_label: String = "Aunt/Uncle"
			var sibling_label: String = "sibling"

			if str(target.gender) == "Male":
				aunt_uncle_label = "Uncle"
				sibling_label = "brother"
			elif str(target.gender) == "Female":
				aunt_uncle_label = "Aunt"
				sibling_label = "sister"

			var parent_side: String = "Parent"
			if str(parent.gender) == "Male":
				parent_side = "Dad"
			elif str(parent.gender) == "Female":
				parent_side = "Mom"

			var age_order: String = "older" if int(target.age) >= int(parent.age) else "younger"
			return "%s, %s's %s %s" % [aunt_uncle_label, parent_side, age_order, sibling_label]

	return ""

func _try_befriend_target(target: Person) -> Dictionary:
	if target == null or gs.player == null:
		return {
			"success": false,
			"text": "Nobody is selected.",
			"popup_title": "Befriend",
			"popup_text": "Nobody is selected.",
			"popup_footer": "Tap anywhere to continue."
		}

	var relation_label:= _relationship_label_for_target(target)
	var family_relation_labels:= [
		"Father", "Mother",
		"Brother", "Sister",
		"Son", "Daughter", "Child",
		"Father-in-Law", "Mother-in-Law",
		"Brother-in-Law", "Sister-in-Law",
		"Grandfather-in-Law", "Grandmother-in-Law",
		"Great Grandfather-in-Law", "Great Grandmother-in-Law",
		"Maternal Grandfather", "Maternal Grandmother",
		"Paternal Grandfather", "Paternal Grandmother",
		"Maternal Great Grandfather", "Maternal Great Grandmother",
		"Paternal Great Grandfather", "Paternal Great Grandmother"
	]
	var romantic_relation_labels:= [
		"Husband", "Wife",
		"Fiancé", "Fiancée",
		"Boyfriend", "Girlfriend",
		"Partner"
	]

	if relation_label in romantic_relation_labels:
		return {
			"success": false,
			"text": "I already have a romantic relationship with %s %s." % [target.first_name, target.last_name],
			"popup_title": "Befriend",
			"popup_text": "You are already romantically involved with that person.",
			"popup_footer": "Tap anywhere to continue."
		}

	if relation_label in family_relation_labels:
		return {
			"success": false,
			"text": "I am already connected to %s %s as family." % [target.first_name, target.last_name],
			"popup_title": "Befriend",
			"popup_text": "That person is already family.",
			"popup_footer": "Tap anywhere to continue."
		}

	if target.id in gs.player.friends:
		return {
			"success": false,
			"text": "I am already friends with %s %s." % [target.first_name, target.last_name],
			"popup_title": "Befriend",
			"popup_text": "You are already friends with %s %s." % [target.first_name, target.last_name],
			"popup_footer": "Tap anywhere to continue."
		}

	var player:= gs.player
	var score: int = 50
	if gs.relationship_engine != null:
		score = int(gs.relationship_engine.update_relationship(player, target))

	var chance: int = clamp(score + 10, 15, 95)
	if int(player.fame) >= 60:
		chance = 100
	elif MainSceneLogic._is_classmate_target(gs, target) and int(player.looks) >= 85:
		chance = 95

	var success: bool = (randi() % 100) < chance
	if success:
		if target.id not in player.friends:
			player.friends.append(target.id)
		if player.id not in target.friends:
			target.friends.append(player.id)
		player.satisfaction = clamp(int(player.satisfaction) + 4, 0, 100)
		return {
			"success": true,
			"text": "I befriended %s %s." % [target.first_name, target.last_name],
			"popup_title": "Befriend",
			"popup_text": "You befriended %s %s." % [target.first_name, target.last_name],
			"popup_footer": "Tap anywhere to continue."
		}

	player.satisfaction = clamp(int(player.satisfaction) - 8, 0, 100)
	player.mental_health = clamp(int(player.mental_health) - 2, 0, 100)
	return {
		"success": false,
		"text": "I tried to befriend %s %s, but they refused." % [target.first_name, target.last_name],
		"popup_title": "Befriend",
		"popup_text": "You tried to befriend %s %s, but they refused." % [target.first_name, target.last_name],
		"popup_footer": "Tap anywhere to continue."
	}


