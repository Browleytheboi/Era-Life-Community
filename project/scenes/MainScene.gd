		"previous_actor_id": -1,
		"previous_actor_name": "Nobody",
	})

	set_meta("god_mode_birth_tail_work_surface_id", surface_id)
	set_meta("god_mode_birth_tail_work_waiting_for_player_control", false)
	set_meta("god_mode_birth_tail_work_not_before_ms", tail_not_before_ms)
