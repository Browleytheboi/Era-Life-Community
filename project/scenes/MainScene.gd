func _start_checkpoint_resume_era_audio_packet(
	resume_contract: Dictionary
) -> void:
	if resume_contract.is_empty():
		return

	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var engine = _ensure_era_audio_engine()

	if engine == null:
		return

	var context_raw: Variant = resume_contract.get(
		"era_audio_context",
		{}
	)
	var context: Dictionary = (
		(context_raw as Dictionary).duplicate(false)
		if typeof(context_raw) == TYPE_DICTIONARY
		else {}
	)

	if context.is_empty():
		context = _era_audio_context_from_current_world()

	context ["reason"] = "checkpoint_resume_visible_lens"
	context ["source"] = "checkpoint_resume_contract"
	context ["checkpoint_resume"] = true
	context ["birth_intro_audio_forbidden"] = true
	context ["current_panel"] = current_panel
	context ["context_key"] = "checkpoint_resume_visible_lens"
	context.erase("checkpoint_resume_prewarm_only")
	context.erase("audio_volume_db")
	context.erase("audio_fade_ms")

	var report: Dictionary = engine.apply_audio_contract(
		era_audio_contract,
		context
	)
	var now_ms: int = int(Time.get_ticks_msec())

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"era_audio_contract_last_report"
		] = report.duplicate(false)
		gs.scenario_state [
			"era_audio_contract_last_reason"
		] = "checkpoint_resume_visible_lens"
		gs.scenario_state [
			"era_audio_contract_last_sync_at_ms"
		] = now_ms
		gs.scenario_state [
			"checkpoint_resume_era_audio_started"
		] = bool(
			report.get(
				"success",
				false
			)
		)
		gs.scenario_state [
			"checkpoint_resume_era_audio_pending"
		] = bool(
			report.get(
				"pending",
				false
			)
		)
		gs.scenario_state [
			"checkpoint_resume_era_audio_synchronous_load"
		] = false

	set_meta(
		"checkpoint_resume_era_audio_started",
		bool(
			report.get(
				"success",
				false
			)
		)
	)
	set_meta(
		"checkpoint_resume_era_audio_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)
	set_meta(
		"checkpoint_resume_era_audio_started_at_ms",
		now_ms
	)

func _release_title_card_continue_cover_after_atomic_shell(
	poll_count: int = 0
) -> void:
	if not bool(
		get_meta(
			"title_card_continue_cover_held_until_atomic_shell",
			false
		)
	):
		return

	var expected_signature: String = str(
		get_meta(
			"saved_life_residency_signature",
			get_meta(
				"title_card_continue_residency_signature",
				""
			)
		)
	).strip_edges()
	var attached_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()




	if (
		expected_signature == ""
		and attached_signature != ""
	):
		expected_signature = attached_signature
		set_meta(
			"saved_life_residency_signature",
			expected_signature
		)

	var signature_matches: bool = (
		expected_signature != ""
		and attached_signature == expected_signature
	)
	var atomic_shell_ready: bool = bool(
		get_meta(
			"playable_life_shell_atomic_visual_commit_complete",
			false
		)
	)
	var attached_actor_ready: bool = (
		gs != null
		and gs.player != null
	)

	if (
		not atomic_shell_ready
		or not attached_actor_ready
		or not signature_matches
	):
		set_meta(
			"title_card_continue_cover_poll_count",
			poll_count + 1
		)
		set_meta(
			"title_card_continue_cover_waiting_for_atomic_commit",
			true
		)
		set_meta(
			"title_card_continue_cover_waiting_expected_signature",
			expected_signature
		)
		set_meta(
			"title_card_continue_cover_waiting_attached_signature",
			attached_signature
		)

		var tree:= get_tree()

		if tree == null:
			call_deferred(
				"_release_title_card_continue_cover_after_atomic_shell",
				poll_count + 1
			)
			return

		tree.process_frame.connect(
			Callable(
				self,
				"_release_title_card_continue_cover_after_atomic_shell"
			).bind(
				poll_count + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	var released_at_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"title_card_continue_cover_held_until_atomic_shell",
		false
	)
	set_meta(
		"title_card_continue_cover_waiting_for_atomic_commit",
		false
	)
	set_meta(
		"title_card_continue_cover_released_at_ms",
		released_at_ms
	)
	set_meta(
		"title_card_continue_cover_released_for_signature",
		expected_signature
	)
	set_meta(
		"title_card_continue_cover_timeout_forbidden",
		true
	)

	EraLog.truth(
		"ERALIFE_CHECKPOINT_VISIBLE_TRUTH"
		+ "|success=true"
		+ "|actor_id=" + str(
			int(gs.player.id)
		)
		+ "|signature=" + expected_signature
		+ "|shell_atomic=true"
		+ "|shell_surface_hot=" + str(
			_resident_playable_life_shell_surface_is_hot()
		).to_lower()
		+ "|cover_released=true"
		+ "|timeout_used=false"
		+ "|polls=" + str(poll_count)
		+ "|at_ms=" + str(released_at_ms)
	)

	_finish_title_card_continue_intro_cleanup()

func _finish_title_card_continue_intro_cleanup() -> void:



	if (
		not bool(
			get_meta(
				"checkpoint_resume_era_audio_started",
				false
			)
		)
		and not bool(
			get_meta(
				"checkpoint_resume_era_audio_pending",
				false
			)
		)
	):
		var resume_raw: Variant = get_meta(
			"checkpoint_reality_handoff_resume_contract",
			get_meta(
				"title_card_checkpoint_resume_lens_prewarm_contract",
				{}
			)
		)
		var resume_contract: Dictionary = (
			resume_raw as Dictionary
			if typeof(resume_raw) == TYPE_DICTIONARY
			else {}
		)

		if not resume_contract.is_empty():
			_start_checkpoint_resume_era_audio_packet(
				resume_contract
			)

	_kill_startup_intro_runtime_tweens(
		"title_card_continue_current_life"
	)

	if startup_intro_prompt_tween != null:
		startup_intro_prompt_tween.kill()
		startup_intro_prompt_tween = null

	if startup_intro_title_tween != null:
		startup_intro_title_tween.kill()
		startup_intro_title_tween = null

	if startup_intro_skip_tween != null:
		startup_intro_skip_tween.kill()
		startup_intro_skip_tween = null

	if startup_intro_replay_tween != null:
		startup_intro_replay_tween.kill()
		startup_intro_replay_tween = null

	_hide_startup_intro_replay_button()
	_set_startup_intro_title_shine_enabled(
		false
	)

	if (
		startup_intro_overlay != null
		and is_instance_valid(
			startup_intro_overlay
		)
	):
		startup_intro_overlay.visible = false
		startup_intro_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		startup_intro_overlay.queue_free()

	startup_intro_overlay = null
	startup_intro_blackout = null
	startup_intro_year_label = null
	startup_intro_line_label = null
	startup_intro_title_label = null
	startup_intro_subtitle_label = null
	startup_intro_prompt_label = null
	startup_intro_skip_button = null
	startup_intro_replay_button = null

	set_meta(
		"startup_intro_contract_audio_active",
		false
	)
	set_meta(
		"startup_intro_replay_button_accepts_input",
		false
	)
	set_meta(
		"startup_intro_closed_for_title_card_continue",
		true
	)
	set_meta(
		"startup_intro_closed_for_title_card_continue_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
