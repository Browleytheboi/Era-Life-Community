		false
	)

	set_meta(
		"crime_hub_resident_deck_render_performed_here",
		false
	)

	set_meta(
		"crime_hub_resident_deck_ready_gate_member",
		false
	)

	set_meta(
		"crime_hub_resident_deck_build_on_click",
		false
	)

	set_meta(
		"crime_hub_resident_deck_observer_bound_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	EraLog.truth(
		"ERALIFE_CRIME_RESIDENT_OBSERVER_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|resident_deck_hot="
