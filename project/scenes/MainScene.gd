func _flash_reality_surge_stat_echo(surge: Dictionary) -> void:
	if action_result_popup == null or action_result_popup_card == null:
		return

	var stat_echo: Dictionary = {}
	var stat_echo_raw: Variant = surge.get("stat_echo", {})
	if typeof(stat_echo_raw) == TYPE_DICTIONARY:
		stat_echo = stat_echo_raw

	var boosts_raw: Variant = stat_echo.get("temporary_boost", {})
	if typeof(boosts_raw) != TYPE_DICTIONARY:
		return

	var boosts: Dictionary = boosts_raw
	if boosts.is_empty():
		return

	var parts: Array = []
	for key in boosts.keys():
		var amount: int = int(boosts.get(key, 0))
		if amount == 0:
			continue
		parts.append("+%d %s" % [amount, str(key).replace("_", " ").to_upper()])

	if parts.is_empty():
		return

	var label:= Label.new()
	label.text = "  %s  " % " | ".join(PackedStringArray(parts))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", 22)
