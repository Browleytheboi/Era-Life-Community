func _relationship_profile_switch_tail_after_visible_frame(
	target_id: int,
	previous_controlled_person_id: int,
	background_receipt: Dictionary,
	source: String = "relationship_profile_switch_tail"
) -> void:
	var scene_tree:= get_tree()

	if scene_tree != null:
		await scene_tree.process_frame

	if (
		gs == null
		or gs.player == null
		or target_id <= 0
		or int(gs.player.id) != target_id
	):
		return

	var main_tab_pointer_swapped: bool = bool(
		background_receipt.get(
			"actor_renderer_deck_pointer_swapped",
			false
		)
	)

	if not main_tab_pointer_swapped:
		main_tab_pointer_swapped = (
			_activate_resident_main_tab_renderer_deck_for_actor(
				target_id,
				"%s_post_visible_pointer_swap"
				% source
			)
		)




	var main_tab_projection_pending: bool = (
		not main_tab_pointer_swapped
	)

	set_meta(
		"relationship_switch_main_tab_projection_pending",
		main_tab_projection_pending
	)
	set_meta(
		"relationship_switch_main_tab_projection_pending_actor_id",
		target_id
	)
	set_meta(
		"relationship_switch_main_tab_projection_is_valid_partial_state",
		true
	)
	set_meta(
		"relationship_switch_old_actor_renderer_reuse_forbidden",
		true
	)

	_zero_frame_consciousness_switch_background_refresh(
		background_receipt
	)



	call_deferred(
		"_install_switched_actor_support_surfaces_from_store",
		target_id,
		source,
		0
	)
	call_deferred(
		"_scroll_life_diary_to_bottom"
	)

	EraLog.truth(
		"ERALIFE_SWITCH_TAIL_AFTER_VISIBLE_FRAME_TRUTH"
		+ "|actor_id=" + str(target_id)
		+ "|previous_actor_id=" + str(previous_controlled_person_id)
		+ "|visible_frame_passed=true"
		+ "|main_tab_pointer_swap_complete="
		+ str(main_tab_pointer_swapped).to_lower()
		+ "|main_tab_projection_pending="
		+ str(main_tab_projection_pending).to_lower()
		+ "|partial_surface_state_valid=true"
		+ "|main_tab_build_after_switch=false"
		+ "|support_tail_deferred=true"
		+ "|switch_press_waited=false"
		+ "|engine_calls=false"
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)
func _consume_bank_delta_from_observable_receipt(
	receipt: Dictionary,
	source: String
) -> bool:
	if (
		gs == null
		or gs.player == null
		or receipt.is_empty()
	):
		return false

	var bank_report: Dictionary = MainSceneHelpers._safe_dictionary(
		receipt.get(
			"bank_report",
			{}
		)
	)

	if bank_report.is_empty():
		return false

	var actor_id: int = int(
		bank_report.get(
			"actor_id",
			-1
		)
	)



	if actor_id != int(
		gs.player.id
	):
		return false

	var previous_balance: int = maxi(
		0,
		int(
			bank_report.get(
				"previous_balance",
				0
			)
		)
	)
	var new_balance: int = maxi(
		0,
		int(
			bank_report.get(
				"new_balance",
				bank_report.get(
					"balance",
					previous_balance
				)
			)
		)
	)
	var bank_delta: int = int(
		bank_report.get(
			"bank_delta",
			new_balance - previous_balance
		)
	)

	if (
		bank_delta == 0
		and previous_balance == new_balance
	):
		return false

	_queue_player_stats_bank_delta_effect(
		bank_delta,
		previous_balance,
		new_balance,
		{
			"source": source,
			"actor_id": actor_id,
			"transaction_kind": str(
				bank_report.get(
					"transaction_kind",
					"purchase"
				)
			),
			"ui_is_renderer_only": true
		}
	)

	set_meta(
		"bank_delta_receipt_last_source",
		source
	)
	set_meta(
		"bank_delta_receipt_last_actor_id",
		actor_id
	)
	set_meta(
		"bank_delta_receipt_last_delta",
		bank_delta
	)
	set_meta(
		"bank_delta_receipt_last_balance",
		new_balance
	)
	set_meta(
		"bank_delta_receipt_last_consumed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	return true
func _apply_player_stats_packet_to_overlay_zero_frame(player_stats_packet: Dictionary, surface: Dictionary, reason: String = "playable_life_viewer_stats_packet") -> void:
