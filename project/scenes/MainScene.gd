			})
		)
		var continue_raw: Variant = identity_report.get(
			"continue_contract",
			{}
		)
		var continue_contract: Dictionary = (
			(continue_raw as Dictionary).duplicate(true)
			if typeof(continue_raw) == TYPE_DICTIONARY
			else {}
		)

		set_meta(
			"title_card_identity_contract",
			identity_report.duplicate(true)
		)
		set_meta(
			"title_card_continue_contract",
