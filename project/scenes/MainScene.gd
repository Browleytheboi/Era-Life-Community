func _request_relationship_profile_zero_frame_surface_prewarm(
	actor: Person,
	profile_target_id: int,
	reason: String
) -> Dictionary:
	if (
		gs == null
		or actor == null
		or int(actor.id) <= 0
	):
		return {}

	var actor_id: int = int(actor.id)
	var payload: Dictionary = {
		"actor_id": actor_id,
		"target_id": actor_id,
		"relationship_profile_target_id": profile_target_id,
		"source": reason,
		"surface": "relationship_profile_popup",
		"prewarm_only": true,
		"press_frame_ready": true,
		"skip_pending_count": false,
		"ready_gate_member": false,
		"ui_policy": {
			"switch_press_must_not_build_surface": true,
		}
	}
	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"intent_type": (
				"relationship_profile_surface_prewarm"
			),
			"surface_id": (
				"full_relationship_profile_popup"
			),
			"action_id": (
				"prewarm_zero_frame_surface"
			),
			"payload": payload.duplicate(true),
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"universal_switch_contract_engine"
				),
				"method": (
					"prewarm_zero_frame_surface_for_actor"
				),
				"pass_actor_payload": true,
				"actor_id": actor_id
			},
			"source": reason
		},
		{
			"actor_id": actor_id,
			"target_id": actor_id,
			"surface_id": (
				"full_relationship_profile_popup"
			),
			"action_id": (
				"prewarm_zero_frame_surface"
			),
			"source": reason,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true
		}
	)
	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result_raw: Variant = route_result.get(
		"result",
		route_result
	)

	return (
		result_raw as Dictionary
		if typeof(result_raw) == TYPE_DICTIONARY
		else {}
	)
func _support_packet_from_zero_frame_surface_prewarm_report(
	report: Dictionary,
	target_id: int,
	source: String = "zero_frame_surface_prewarm_report"
) -> Dictionary:
	if (
		report.is_empty()
		or target_id <= 0
	):
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var inspected: int = 0

	while (
		not queue.is_empty()
		and inspected < 32
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		if _control_switch_support_surface_packet_is_renderable(
			cursor,
			target_id
		):
			EraLog.truth(
				"SUPPORT_PACKET_LOOKUP_SUCCESS"
				+ "|actor_id=" + str(target_id)
				+ "|source=" + source
				+ "|carrier=direct_report"
				+ "|inspected=" + str(inspected)
				+ "|build_on_switch=false"
				+ "|build_on_click=false"
				+ "|ready_gate_member=false"
				+ "|at_ms=" + str(Time.get_ticks_msec())
			)
			return cursor.duplicate(false)

		var embedded_packet: Dictionary = MainSceneHelpers._safe_dictionary(
			cursor.get(
				"control_switch_support_surface_packet",
				{}
			)
		)

		if _control_switch_support_surface_packet_is_renderable(
			embedded_packet,
			target_id
		):
			EraLog.truth(
				"SUPPORT_PACKET_LOOKUP_SUCCESS"
				+ "|actor_id=" + str(target_id)
				+ "|source=" + source
				+ "|carrier=control_switch_support_surface_packet"
				+ "|inspected=" + str(inspected)
				+ "|build_on_switch=false"
				+ "|build_on_click=false"
				+ "|ready_gate_member=false"
				+ "|at_ms=" + str(Time.get_ticks_msec())
			)
			return embedded_packet.duplicate(false)

		for raw_key in [
			"result",
			"surface_contract",
			"viewer_packet",
			"render_packet",
			"playable_life_viewer_render_packet",
			"viewer_render_packet",
			"payload",
			"route_report",
			"engine_report",
			"target_report"
		]:
			var key: String = str(
				raw_key
			)
			var nested_raw: Variant = cursor.get(
				key,
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				(nested_raw as Dictionary).duplicate(true)
			)

			if not nested.is_empty():
				queue.append(
					nested
				)

	EraLog.truth(
		"SUPPORT_PACKET_LOOKUP_FAILED"
		+ "|actor_id=" + str(target_id)
		+ "|source=" + source
		+ "|reason=prewarm_report_did_not_carry_renderable_support_packet"
		+ "|inspected=" + str(inspected)
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	return {}
func _support_packet_from_relationship_profile_shell(
	shell: Dictionary,
	target_id: int,
	source: String = "relationship_profile_shell"
) -> Dictionary:
	if (
		shell.is_empty()
		or target_id <= 0
	):
		return {}

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		shell.get(
			"surface_contract",
			{}
		)
	)
	var viewer_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		shell.get(
			"playable_life_viewer_render_packet",
			shell.get(
				"viewer_render_packet",
				{}
			)
		)
	)
	var viewer_surface: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"surface_contract",
			{}
		)
	)

	for raw_candidate in [
		shell.get(
			"control_switch_support_surface_packet",
			{}
		),
		surface.get(
			"control_switch_support_surface_packet",
			{}
		),
		viewer_packet.get(
			"control_switch_support_surface_packet",
			{}
		),
		viewer_surface.get(
			"control_switch_support_surface_packet",
			{}
		)
	]:
		var candidate: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_candidate
		)

		if _control_switch_support_surface_packet_is_renderable(
			candidate,
			target_id
		):
			EraLog.truth(
				"SUPPORT_PACKET_LOOKUP_SUCCESS"
				+ "|actor_id=" + str(target_id)
				+ "|source=" + source
				+ "|carrier=relationship_profile_shell"
				+ "|build_on_switch=false"
				+ "|build_on_click=false"
				+ "|ready_gate_member=false"
				+ "|at_ms=" + str(Time.get_ticks_msec())
			)
			return candidate.duplicate(false)

	return {}

func _prewarm_relationship_profile_zero_frame_switch_candidate(
	target: Person,
	reason: String = "relationship_profile"
) -> void:
	if (
		gs == null
		or target == null
		or int(target.id) <= 0
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var target_id: int = int(
		target.id
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if gs.player != null:
		_stash_life_diary_for_actor(
			int(gs.player.id)
		)

	var current_actor: Person = gs.player
	var actor_queue: Array = []

	if current_actor != null:
		actor_queue.append(
			current_actor
		)

	if (
		current_actor == null
		or int(current_actor.id) != target_id
	):
		actor_queue.append(
			target
		)

	for raw_actor in actor_queue:
		if not (raw_actor is Person):
			continue

		var shell_actor: Person = raw_actor as Person

		if (
			shell_actor == null
			or int(shell_actor.id) <= 0
		):
			continue

		var shell_actor_id: int = int(
			shell_actor.id
		)
		var shell: Dictionary = (
			_relationship_profile_prewarmed_playable_life_shell_for_actor(
				shell_actor
			)
		)
		var shell_hot: bool = (
			_relationship_profile_playable_life_shell_is_hot(
				shell_actor
			)
		)
		var support_packet: Dictionary = (
			_support_packet_from_relationship_profile_shell(
				shell,
				shell_actor_id,
				"%s_actor_%d_existing_shell"
				% [
					reason,
					shell_actor_id
				]
			)
		)

		if (
			not shell_hot
			or not _control_switch_support_surface_packet_is_renderable(
				support_packet,
				shell_actor_id
			)
			or not _resident_main_tab_renderer_deck_is_hot(
				shell_actor_id
			)
		):
			var report: Dictionary = (
				_request_relationship_profile_zero_frame_surface_prewarm(
					shell_actor,
					target_id,
					"%s_actor_%d_life_shell"
					% [
						reason,
						shell_actor_id
					]
				)
			)

			var report_support_packet: Dictionary = (
				_support_packet_from_zero_frame_surface_prewarm_report(
					report,
					shell_actor_id,
					"%s_actor_%d_prewarm_report"
					% [
						reason,
						shell_actor_id
					]
				)
			)

			if _control_switch_support_surface_packet_is_renderable(
				report_support_packet,
				shell_actor_id
			):
				support_packet = report_support_packet.duplicate(false)
				_cache_resident_control_switch_support_surface_packet_reference(
					support_packet,
					shell_actor_id,
					"%s_actor_%d_report_support_packet"
					% [
						reason,
						shell_actor_id
					]
				)

			var switch_text: String = ""

			if shell_actor_id == target_id:
				switch_text = (
					"I started living as %s."
					% MainSceneHelpers._person_display_name_for_identity_switch(
						shell_actor
					)
				)

			var staged_surface: Dictionary = MainSceneHelpers._safe_dictionary(
				report.get(
					"surface_contract",
					{}
				)
			)

			if not staged_surface.is_empty():
				if _control_switch_support_surface_packet_is_renderable(
					support_packet,
					shell_actor_id
				):
					staged_surface [
						"control_switch_support_surface_packet"
					] = support_packet.duplicate(false)
					staged_surface [
						"control_switch_support_surface_packet_published"
					] = true

				shell = _relationship_profile_stage_playable_life_shell_for_actor(
					shell_actor,
					staged_surface,
					switch_text,
					"%s_actor_%d_life_shell"
					% [
						reason,
						shell_actor_id
					]
				)

				var staged_support_packet: Dictionary = (
					_support_packet_from_relationship_profile_shell(
						shell,
						shell_actor_id,
						"%s_actor_%d_staged_shell"
						% [
							reason,
							shell_actor_id
						]
					)
				)

				if _control_switch_support_surface_packet_is_renderable(
					staged_support_packet,
					shell_actor_id
				):
					support_packet = staged_support_packet.duplicate(false)
					_cache_resident_control_switch_support_surface_packet_reference(
						support_packet,
						shell_actor_id,
						"%s_actor_%d_staged_shell_support_packet"
						% [
							reason,
							shell_actor_id
						]
					)

		var deck: Dictionary = MainSceneHelpers._safe_dictionary(
			support_packet.get(
				"main_tab_surface_contracts",
				{}
			)
		)

		if not deck.is_empty():
			_queue_resident_main_tab_renderer_deck_prewarm(
				shell_actor_id,
				deck,
