func _relationship_profile_popup_tail_identity_sync_deferred(target_id: int, render_token: int) -> void:
	await get_tree().process_frame

	if not _relationship_profile_popup_render_is_current(target_id, render_token):
		return

	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
		if bool(relationship_profile_popup.get_meta("relationship_profile_local_inspection_only", false)):
			return

	var target: Person = _relationship_profile_popup_safe_target_for_render(target_id, render_token)
	if target == null:
		return

	if gs != null and gs.grocery_store_engine != null and gs.grocery_store_engine.has_method("sanitize_grocery_identity_for_relationship_profile"):
		gs.grocery_store_engine.sanitize_grocery_identity_for_relationship_profile(target, {
			"source": "relationship_profile_popup_tail_identity_sync",
			"return_context": relationship_profile_return_context,
		})

	if not _relationship_profile_popup_render_is_current(target_id, render_token):
		return

	if gs != null and gs.realm_engine != null and bool(target.is_ruler):
		gs.realm_engine.sync_realm_ruler_from_person(target)

	if gs != null and gs.royalty_engine != null:
		if gs.royalty_engine.has_method("_sync_royal_job_identity") and (bool(target.is_royal) or bool(target.is_ruler) or int(target.succession_rank) > 0 or str(target.royal_title).strip_edges() != ""):
			gs.royalty_engine._sync_royal_job_identity(target)
		if gs.royalty_engine.has_method("_apply_royal_fame_floor") and (bool(target.is_royal) or bool(target.is_ruler)):
			gs.royalty_engine._apply_royal_fame_floor(target)
func _relationship_profile_popup_render_is_current(target_id: int, render_token: int) -> bool:
	if relationship_profile_popup == null or not is_instance_valid(relationship_profile_popup):
		return false
	if not relationship_profile_popup_open:
		return false
	if int(relationship_profile_popup.get_meta("relationship_profile_render_token", -1)) != int(render_token):
		return false
	if int(relationship_profile_popup.get_meta("relationship_profile_target_id", -1)) != int(target_id):
		return false
	return true

func _relationship_profile_popup_safe_target_for_render(target_id: int, render_token: int) -> Person:
	if not _relationship_profile_popup_render_is_current(target_id, render_token):
		return null

	var target: Person = _relationship_profile_cached_target_for_id(target_id)
	if target == null and gs != null and gs.has_method("get_npc_by_id"):
		target = gs.get_npc_by_id(target_id)

	if target == null:
		return null

	if int(target.id) != int(target_id):
		return null

	_relationship_profile_cache_target_for_surface(target)
	return target


func _relationship_profile_popup_fast_profile_lines(target: Person) -> Array:
	var lines: Array = []
	if target == null:
		lines.append("No target selected.")
		return lines

	var relation_label: String = _relationship_label_for_target(target)
	var grocery_locked_non_royal: bool = MainSceneLogic._relationship_profile_target_is_grocery_locked_non_royal(target)
	var effective_job: String = MainSceneLogic._relationship_profile_effective_job_for(gs, target, grocery_locked_non_royal)

	var is_federal_civic_actor: bool = _person_uses_federal_republic_civic_title(target, int(target.realm_id))
	var government_title: String = _person_federal_republic_government_title(target, int(target.realm_id), false)
	var federal_social_surface: String = _person_federal_republic_government_title(target, int(target.realm_id), true)

	var effective_social_class: String = str(target.social_class).strip_edges()
	if is_federal_civic_actor and federal_social_surface != "":
		effective_social_class = federal_social_surface
	elif not grocery_locked_non_royal:
		if _is_crown_population_noble_court_member(target, int(target.realm_id)):
			var noble_title: String = _crown_population_resolved_court_title(target, int(target.realm_id))
			effective_social_class = noble_title if noble_title != "" else "Noble"
		elif bool(target.is_royal) or bool(target.is_ruler) or str(target.royal_title).strip_edges() != "":
			var royal_title: String = _crown_population_resolved_court_title(target, int(target.realm_id))
			effective_social_class = royal_title if royal_title != "" else "Royal"

	if effective_social_class == "":
		effective_social_class = "Commoner"

	var effective_income: int = int(target.income)

	var body_profile_truth: Dictionary = _relationship_profile_body_truth_for_profile(target)
	var height_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("height_contract", {}))
	var weight_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("weight_contract", {}))
	var body_type_contract: Dictionary = MainSceneHelpers._safe_dictionary(body_profile_truth.get("body_type_contract", {}))

	var height_text: String = MainSceneHelpers._relationship_profile_height_text_from_contract(height_contract)
	if height_text == "":
		height_text = "Unknown"

	var weight_text: String = MainSceneHelpers._relationship_profile_weight_text_from_contract(weight_contract)
	if weight_text == "":
		weight_text = "Unknown"

	var weight_category: String = str(weight_contract.get("category", "")).strip_edges().capitalize()

	lines.append("===== PROFILE =====")
	lines.append("Relation To Me: %s" % relation_label)
	lines.append("Name: %s" % _relationship_display_name(target))
	lines.append("Age: %d" % int(target.age))
	lines.append("Gender: %s" % str(target.gender))
	lines.append("Height: %s" % height_text)

	if weight_category != "":
		lines.append("Weight: %s • %s" % [weight_text, weight_category])
	else:
		lines.append("Weight: %s" % weight_text)

	if not body_type_contract.is_empty():
		lines.append("Body Type: %s" % str(body_type_contract.get("display_name", "Unknown")))

	lines.append("Job: %s" % effective_job)

	if gs != null and gs.economy_engine != null:
		lines.append("Income: %s" % gs.economy_engine.format_money(effective_income))
	else:
		lines.append("Income: $%d" % effective_income)

	lines.append("Social Class: %s" % effective_social_class)

	if is_federal_civic_actor and government_title != "":
		lines.append("Government Title: %s" % government_title)

	lines.append("Fame Tier: %s" % MainSceneLogic._relationship_profile_effective_fame_tier_for(gs, target))
	lines.append("Home: %s, %s" % [str(target.home_city), str(target.home_country)])
	lines.append("School: %s" % (target.school_name if str(target.school_name).strip_edges() != "" else "None"))

	if MainSceneHelpers._relationship_profile_should_show_pregnancy_line(target):
		var pregnant_text: String = "Yes" if int(target.pregnancy_progress) >= 0 or bool(target.pregnancy_known) else "No"
		lines.append("Pregnant: %s" % pregnant_text)

	if str(target.bending_type).strip_edges() != "" and str(target.bending_type).strip_edges().to_lower() != "none":
		lines.append("Bending Type: %s" % str(target.bending_type).capitalize())
		lines.append("Bending Nation: %s" % str(target.bending_nation))
	else:
		lines.append("Bending Type: None")

	if not is_federal_civic_actor and not grocery_locked_non_royal and (bool(target.is_royal) or bool(target.is_ruler) or str(target.royal_title).strip_edges() != ""):
		var title_text: String = str(target.royal_title).strip_edges()
		if title_text == "":
			title_text = "Royal"
		var succession_text: String = "Current Ruler" if bool(target.is_ruler) or int(target.succession_rank) == 0 else "#%d" % int(target.succession_rank)
		lines.append("Royal Title: %s" % title_text)
		lines.append("Succession: %s" % succession_text)

	lines.append("===================")
	return lines


