	crown_hub_allocation_live_nodes = {
		"editable": editable,
		"tax_label": tax_label,
		"happiness_label": happiness_label,
		"tax_slider": tax_slider,
		"revenue_label": revenue_label,
		"pool_label": pool_label,
		"available_label": available_label,
		"next_year_label": next_year_label,
		"carry_label": null,
		"commit_button": null,
		"idle_label": null,
		"buckets": {}
	}

	_append_crown_allocation_bucket_row(
		root,
		summary,
		"To Treasury",
		"treasury_pct",
		treasury_pct,
		int(projection.get("treasury_amount", 0)),
		100,
		editable
	)
	_append_crown_allocation_bucket_row(
		root,
		summary,
		"Military Production",
		"military_pct",
