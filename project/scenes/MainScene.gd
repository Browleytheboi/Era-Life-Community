func _make_reality_mode_state_button(mode_text: String, title_text: String, subtitle_text: String = "") -> Button:

	var button:= Button.new()
	var resolved_title:= title_text
	var resolved_subtitle:= subtitle_text
	if str(mode_text).to_lower() == "chaos":
		resolved_title = MainSceneLogic._friendly_reality_mode_label(mode_text).to_upper()
	button.text = resolved_title if resolved_subtitle.strip_edges() == "" else "%s\n%s" % [resolved_title, resolved_subtitle]
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.custom_minimum_size = Vector2(0, 84)
	button.alignment = HORIZONTAL_ALIGNMENT_CENTER
	button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	button.add_theme_font_size_override("font_size", 16)
	button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	button.add_theme_color_override("font_hover_color", Color(1.0, 1.0, 1.0, 1.0))
	button.add_theme_color_override("font_pressed_color", Color(1.0, 1.0, 1.0, 1.0))
	button.add_theme_color_override("font_focus_color", Color(1.0, 1.0, 1.0, 1.0))
	button.pressed.connect(_on_reality_mode_state_button_pressed.bind(mode_text))
	button.mouse_exited.connect(_refresh_reality_mode_state_buttons)
	reality_mode_state_buttons [mode_text] = button
	return button

func _refresh_reality_mode_state_buttons() -> void:
	var effective_mode: String = _selected_reality_mode_text()
	var is_custom: bool = not _toggle_state_matches_mode(effective_mode)
	var breathing: Dictionary = _build_god_mode_breathing_profile()

	var primary_beat: float = pow(max(0.0, sin(god_mode_presentation_mode_heartbeat_phase)), 8.0)
	var secondary_beat: float = pow(max(0.0, sin(god_mode_presentation_mode_heartbeat_phase - 0.48)), 14.0)
	var heartbeat_strength: float = clamp(primary_beat + (secondary_beat * 0.72), 0.0, 1.0)

	for raw_mode_text in reality_mode_state_buttons.keys():
		var mode_text: String = str(raw_mode_text)
		var button: Button = reality_mode_state_buttons [mode_text]
		if button == null:
			continue

		var palette: Dictionary = MainSceneHelpers._god_mode_palette_for_mode(mode_text, false)
		var is_selected: bool = mode_text == effective_mode
		var button_heartbeat_strength: float = heartbeat_strength if is_selected else 0.0

		var bg_color: Color = Color(0.09, 0.05, 0.15, 0.88)
		var border_color: Color = Color(0.54, 0.44, 0.76, 0.2)
		var shadow_color: Color = Color(0.2, 0.1, 0.34, 0.1)
		var font_color: Color = Color(0.95, 0.94, 1.0, 0.9)

		if is_selected:
			bg_color = Color(palette.get("accent_soft", bg_color))
			border_color = Color(palette.get("accent", Color(1.0, 1.0, 1.0, 1.0)))
			shadow_color = Color(palette.get("shadow_hover", shadow_color))
			font_color = Color(1.0, 1.0, 1.0, 1.0)

		if is_custom and is_selected:
			border_color = Color(1.0, 0.9, 0.62, 0.98)
			bg_color = Color(0.34, 0.22, 0.1, 0.96)
			shadow_color = Color(0.48, 0.26, 0.1, 0.3)

		var normal_bg:= bg_color
		var normal_border:= border_color
		var normal_shadow:= shadow_color
		var hover_bg:= bg_color.lightened(0.08)
		var hover_border:= Color(border_color.r, border_color.g, border_color.b, min(border_color.a + 0.14, 1.0))
		var hover_shadow:= Color(shadow_color.r, shadow_color.g, shadow_color.b, min(shadow_color.a + 0.08, 1.0))
		var pressed_bg:= bg_color.lightened(0.12)
		var pressed_border:= Color(1.0, 0.98, 0.94, 0.9)
		var pressed_shadow:= Color(shadow_color.r, shadow_color.g, shadow_color.b, min(shadow_color.a + 0.1, 1.0))
		var focus_bg:= bg_color.lightened(0.08)
		var focus_border:= Color(1.0, 0.98, 0.94, 0.94)
		var focus_shadow:= Color(shadow_color.r, shadow_color.g, shadow_color.b, min(shadow_color.a + 0.1, 1.0))

		if is_selected:
			var light_mix: float = float(breathing.get("mode_heartbeat_light_mix", 0.08)) * button_heartbeat_strength
			var shadow_boost: float = float(breathing.get("mode_heartbeat_shadow_boost", 0.18)) * button_heartbeat_strength

			normal_bg = bg_color.lightened(0.12 + (0.06 * button_heartbeat_strength))
			normal_border = Color(border_color.r, border_color.g, border_color.b, max(border_color.a, 0.94))
			normal_border = normal_border.lerp(Color(1.0, 0.99, 0.96, 1.0), light_mix)
			normal_shadow = Color(
				shadow_color.r,
				shadow_color.g,
				shadow_color.b,
				max(shadow_color.a, 0.56 + shadow_boost)
			)

			hover_bg = bg_color.lightened(0.14 + (0.06 * button_heartbeat_strength))
			hover_border = Color(1.0, 0.98, 0.94, min(0.98 + light_mix, 1.0))
			hover_shadow = Color(
				shadow_color.r,
				shadow_color.g,
				shadow_color.b,
				max(shadow_color.a + 0.16, 0.64 + shadow_boost)
			)

			pressed_bg = bg_color.lightened(0.16 + (0.04 * button_heartbeat_strength))
			pressed_border = Color(1.0, 0.99, 0.96, 1.0)
			pressed_shadow = Color(
				shadow_color.r,
				shadow_color.g,
				shadow_color.b,
				max(shadow_color.a + 0.18, 0.68 + shadow_boost)
			)

			focus_bg = hover_bg
			focus_border = pressed_border
			focus_shadow = pressed_shadow

			font_color = font_color.lerp(Color(1.0, 1.0, 1.0, 1.0), 0.16 * button_heartbeat_strength)

		button.set_meta("god_mode_mode_selected", is_selected)
		button.set_meta("god_mode_mode_heartbeat_strength", button_heartbeat_strength)

		button.add_theme_color_override("font_color", font_color)
		button.add_theme_color_override("font_hover_color", Color(1.0, 1.0, 1.0, 1.0))
		button.add_theme_color_override("font_pressed_color", Color(1.0, 1.0, 1.0, 1.0))
		button.add_theme_color_override("font_focus_color", Color(1.0, 1.0, 1.0, 1.0))

		button.add_theme_stylebox_override(
			"normal",
			MainSceneHelpers._build_reality_mode_state_button_style(
				normal_bg,
				normal_border,
				normal_shadow
			)
		)
		button.add_theme_stylebox_override(
			"hover",
			MainSceneHelpers._build_reality_mode_state_button_style(
				hover_bg,
				hover_border,
				hover_shadow
			)
		)
		button.add_theme_stylebox_override(
			"pressed",
			MainSceneHelpers._build_reality_mode_state_button_style(
				pressed_bg,
				pressed_border,
				pressed_shadow
			)
		)
		button.add_theme_stylebox_override(
			"focus",
			MainSceneHelpers._build_reality_mode_state_button_style(
				focus_bg,
				focus_border,
				focus_shadow
			)
		)
