func _open_saved_life_picker(mode: String) -> void:
	_ensure_saved_life_picker_popup()
	if saved_life_picker_popup == null:
		return

	var clean_mode: String = str(mode).strip_edges().to_lower()
	if clean_mode in ["god_load", "godmode_load", "reconstruct", "reconstruct_lineage"]:
		clean_mode = "load"

	if clean_mode == "":
		clean_mode = "load"

	saved_life_picker_mode = clean_mode
	saved_life_picker_pending_path = ""
	saved_life_picker_pending_label = ""

	var picker_layer:= saved_life_picker_popup.get_parent() as CanvasLayer
	if picker_layer != null:
		picker_layer.layer = 300
		var picker_dim:= picker_layer.get_node_or_null("SavedLineagePickerDim") as ColorRect
		if picker_dim != null:
			picker_dim.visible = true
			picker_dim.color = Color(0.015, 0.012, 0.026, 0.82)
			picker_dim.z_as_relative = false
			picker_dim.z_index = 0
			picker_dim.mouse_filter = Control.MOUSE_FILTER_STOP

	var panel_style:= _build_god_mode_panel_style(true)
	panel_style.bg_color = Color(0.035, 0.03, 0.065, 0.995)
	panel_style.border_color = Color(0.92, 0.86, 1.0, 0.92)
	panel_style.shadow_color = Color(0.42, 0.22, 0.7, 0.5)
	panel_style.shadow_size = 22
	panel_style.shadow_offset = Vector2(0, 0)
	saved_life_picker_popup.add_theme_stylebox_override("panel", panel_style)

	match clean_mode:
		"merge":
			saved_life_picker_title_label.text = "MERGE LINEAGE"
			saved_life_picker_status_label.text = "Choose a saved universe to merge."
			saved_life_picker_confirm_button.visible = true
			saved_life_picker_confirm_button.disabled = true
		_:
			saved_life_picker_title_label.text = "LOAD LINEAGE"
			saved_life_picker_status_label.text = "Choose a saved lineage to hydrate."
			saved_life_picker_confirm_button.visible = false
			saved_life_picker_confirm_button.disabled = true

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel) and god_mode_start_panel.visible:
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_start_panel.self_modulate = Color(1.0, 1.0, 1.0, 0.44)

	saved_life_picker_popup.visible = true
	saved_life_picker_popup.show()
	saved_life_picker_popup.top_level = true
	saved_life_picker_popup.z_as_relative = false
	saved_life_picker_popup.z_index = 10
	saved_life_picker_popup.modulate = Color(1.0, 1.0, 1.0, 1.0)
	saved_life_picker_popup.self_modulate = Color(1.0, 1.0, 1.0, 1.0)

	var popup_parent:= saved_life_picker_popup.get_parent()
	if popup_parent != null:
		popup_parent.move_child(saved_life_picker_popup, popup_parent.get_child_count() - 1)

	if saved_life_picker_status_label != null:
		saved_life_picker_status_label.text = "Opening lineage index..."

	if saved_life_picker_list != null:
		_clear_container_children(saved_life_picker_list)
		var loading_label:= Label.new()
		loading_label.text = "Opening lineage index..."
		loading_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		loading_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		saved_life_picker_list.add_child(loading_label)

	call_deferred("_refresh_saved_life_picker_list")


func _close_saved_life_picker() -> void:
	if saved_life_picker_popup != null:
		var picker_layer:= saved_life_picker_popup.get_parent() as CanvasLayer
		if picker_layer != null:
			var picker_dim:= picker_layer.get_node_or_null("SavedLineagePickerDim") as ColorRect
			if picker_dim != null:
				picker_dim.visible = false
				picker_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		saved_life_picker_popup.visible = false

	saved_life_picker_mode = ""
	saved_life_picker_pending_path = ""
	saved_life_picker_pending_label = ""

	if saved_life_picker_confirm_button != null:
		saved_life_picker_confirm_button.disabled = true
	if saved_life_picker_cancel_button != null:
		saved_life_picker_cancel_button.disabled = false

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel) and god_mode_start_panel.visible:
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_STOP
		god_mode_start_panel.self_modulate = Color(1.0, 1.0, 1.0, 1.0)

	_refresh_god_mode_start_button_state()


func _refresh_saved_life_picker_list() -> void:
	if saved_life_picker_list == null:
		return

	if gs == null:
		_bootstrap_gs_for_save_load_if_needed()

	_clear_container_children(saved_life_picker_list)

	var lives: Array = []
	if gs != null and gs.has_method("list_saved_life_summaries"):
		lives = gs.list_saved_life_summaries()

	if lives.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "No saved lineages yet."
		empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		saved_life_picker_list.add_child(empty_label)

		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = "No saved lineages found in your binary save folder yet."
		return

	if saved_life_picker_status_label != null:
		saved_life_picker_status_label.text = "Choose a lineage to hydrate."

	for raw_summary in lives:
		if typeof(raw_summary) != TYPE_DICTIONARY:
			continue

		var summary: Dictionary = raw_summary
		var path: String = str(summary.get("path", "")).strip_edges()
		var player_name: String = str(summary.get("player_name", "Unknown Life")).replace("_", " ").strip_edges()
		var age: int = max(0, int(summary.get("age", 0)))
		var year_value: int = int(summary.get("year", 0))
		var era_name: String = str(summary.get("era_name", "Unknown Era")).strip_edges()

		if player_name == "":
			player_name = "Unknown Life"
		if era_name == "":
			era_name = "Unknown Era"

		var button_text: String = "%s — Age %d, %s, %s" % [
			player_name,
			age,
			_format_year(year_value),
			era_name
		]

		var row_card:= PanelContainer.new()
		row_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row_card.modulate = Color(1.0, 1.0, 1.0, 1.0)
		row_card.self_modulate = Color(1.0, 1.0, 1.0, 1.0)

		var row_style:= _build_god_mode_panel_style(false)
		row_style.bg_color = Color(0.07, 0.06, 0.12, 0.99)
		row_style.border_color = Color(0.8, 0.72, 1.0, 0.66)
		row_style.shadow_color = Color(0.35, 0.18, 0.7, 0.2)
		row_style.shadow_size = 10
		row_card.add_theme_stylebox_override("panel", row_style)
		saved_life_picker_list.add_child(row_card)

		var row:= HBoxContainer.new()
		row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_theme_constant_override("separation", 8)
		row_card.add_child(row)

		var button:= Button.new()
		button.text = button_text
		button.tooltip_text = "Hydrate this saved lineage as a parallel universe."
		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		button.custom_minimum_size = Vector2(0, 54)
		button.disabled = path == ""
		button.pressed.connect(_on_saved_life_picker_entry_pressed.bind(path, button_text))
		row.add_child(button)

		if saved_life_picker_mode != "merge":
			var delete_button:= Button.new()
			delete_button.text = "Delete"
			delete_button.custom_minimum_size = Vector2(110, 54)
			delete_button.disabled = path == ""
			delete_button.pressed.connect(_on_saved_life_picker_delete_pressed.bind(path, button_text))
			row.add_child(delete_button)

func _on_saved_life_picker_delete_button_pressed() -> void:
	# The existing _on_saved_life_picker_delete_pressed(path, label) already deletes
	# correctly -- GameState.delete_saved_life() removes the .bin and its .summary
	# companion -- there was simply no button wired to it. This wrapper deletes
	# whichever save is currently selected, behind a two-press confirmation so a
	# stray click cannot destroy a life.
	var target_path: String = str(saved_life_picker_pending_path).strip_edges()

	if target_path == "":
		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = "Select a save first, then delete."
		return

	if saved_life_picker_delete_armed_path != target_path:
		saved_life_picker_delete_armed_path = target_path

		if saved_life_picker_delete_button != null:
			saved_life_picker_delete_button.text = "Really delete?"

		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = (
				"Press again to permanently delete:\n%s"
				% str(saved_life_picker_pending_label)
			)
		return

	var target_label: String = str(saved_life_picker_pending_label)

	saved_life_picker_delete_armed_path = ""
	saved_life_picker_pending_path = ""
	saved_life_picker_pending_label = ""

	if saved_life_picker_delete_button != null:
		saved_life_picker_delete_button.text = "Delete Save"
		saved_life_picker_delete_button.disabled = true

	_on_saved_life_picker_delete_pressed(
		target_path,
		target_label
	)


func _on_saved_life_picker_delete_pressed(path: String, label: String) -> void:
	if gs == null or path == "":
		return

	var deleted:= gs.delete_saved_life(path)

	if saved_life_picker_status_label != null:
		if deleted:
			saved_life_picker_status_label.text = "Deleted saved life:\n%s" % label
		else:
			saved_life_picker_status_label.text = "Could not delete saved life:\n%s" % label

	_refresh_saved_life_picker_list()
func _on_saved_life_picker_entry_pressed(
	path: String,
	label: String
) -> void:
	var clean_path: String = str(
		path
	).strip_edges()
	var clean_label: String = str(
		label
	).strip_edges()

	if clean_path == "":
		return

	if saved_life_picker_mode == "merge":
		saved_life_picker_pending_path = clean_path
		saved_life_picker_pending_label = clean_label

		if saved_life_picker_status_label != null:
			saved_life_picker_status_label.text = (
				"You REALLY want to bring this Universe here?\n%s"
				% clean_label
			)

		if saved_life_picker_confirm_button != null:
			saved_life_picker_confirm_button.disabled = false

		return



	saved_life_picker_pending_path = clean_path
	saved_life_picker_pending_label = clean_label

	# Selecting a different save cancels any armed delete confirmation.
	if saved_life_picker_delete_armed_path != clean_path:
		saved_life_picker_delete_armed_path = ""

		if saved_life_picker_delete_button != null:
			saved_life_picker_delete_button.text = "Delete Save"

	if saved_life_picker_delete_button != null:
		saved_life_picker_delete_button.disabled = clean_path == ""

	if saved_life_picker_status_label != null:
		saved_life_picker_status_label.text = (
			"Observing resident reality:\n%s"
			% clean_label
		)

	if (
		world_actions_status_label != null
		and is_instance_valid(
			world_actions_status_label
		)
	):
		world_actions_status_label.text = (
			"Observing %s as a resident reality..."
			% clean_label
		)

	set_meta(
		"saved_reality_observation_intent_path",
		clean_path
	)
	set_meta(
		"saved_reality_observation_intent_label",
		clean_label
	)
	set_meta(
		"saved_reality_observation_intent_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"saved_reality_observation_click_engine_work",
		false
	)
	set_meta(
		"saved_reality_observation_click_hydration_work",
		false
	)
	set_meta(
		"saved_reality_observation_click_visual_confirmation",
		true
	)


	call_deferred(
		"_load_life_from_slot",
		clean_path,
		{
			"source_ui": saved_life_picker_mode,
			"saved_life_label": clean_label,
			"entry_surface": str(
				get_meta(
					"saved_life_load_entry_surface",
					"saved_life_picker"
				)
			)
		}
	)
func _on_saved_life_picker_confirm_pressed() -> void:
	if saved_life_picker_mode == "merge":
		_merge_life_from_slot(saved_life_picker_pending_path)


