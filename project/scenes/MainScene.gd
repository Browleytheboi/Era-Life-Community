func _resident_main_tab_contract_deck_is_complete_for_actor(
	deck: Dictionary,
	actor_id: int
) -> bool:
	if (
		actor_id <= 0
		or deck.is_empty()
	):
		return false

	for raw_surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var surface_id: String = str(
			raw_surface_id
		)
		var contract_raw: Variant = deck.get(
			surface_id,
			{}
		)
		var contract: Dictionary = (
			contract_raw as Dictionary
			if typeof(contract_raw) == TYPE_DICTIONARY
			else {}
		)

		if (
			contract.is_empty()
			or int(
				contract.get(
					"actor_id",
					-1
				)
			) != actor_id
		):
			return false

		var schema: String = str(
			contract.get(
				"schema",
				""
			)
		).strip_edges().to_lower()
		var truth_state: String = str(
			contract.get(
				"truth_state",
				""
			)
		).strip_edges().to_lower()

		if (
			schema ==
				"eralife.pointer_only.destination_tab_contract"
			or truth_state ==
				"pointer_only_resident_shell"
			or bool(
				contract.get(
					"pointer_only",
					false
				)
			)
			or bool(
				contract.get(
					"projection_pending",
					false
				)
			)
			or truth_state in [
				"warming",
				"streaming",
				"observable_partial",
				"partial",
				"pending"
			]
		):
			return false

		if (
			contract.has(
				"projection_complete"
			)
			and not bool(
				contract.get(
					"projection_complete",
					false
				)
			)
		):
			return false

	return true
func _route_resident_surface_contract_ready(
	signature: String,
	surface_id: String,
	surface_contract: Dictionary
) -> void:
	var clean_signature: String = str(
		signature
	).strip_edges()
	var clean_surface_id: String = str(
		surface_id
	).strip_edges().to_lower()

	if (
		clean_signature == ""
		or clean_surface_id == ""
		or surface_contract.is_empty()
	):
		return

	var actor_id: int = int(
		surface_contract.get(
			"actor_id",
			-1
		)
	)
	var actor_deck: Dictionary = {}




	if (
		gs != null
		and actor_id > 0
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var deck_by_actor_raw: Variant = (
			gs.scenario_state.get(
				"resident_main_tab_surface_contracts_by_actor",
				{}
			)
		)

		if typeof(
			deck_by_actor_raw
		) == TYPE_DICTIONARY:
			var actor_deck_raw: Variant = (
				(deck_by_actor_raw as Dictionary).get(
					str(actor_id),
					{}
				)
			)

			if typeof(
				actor_deck_raw
			) == TYPE_DICTIONARY:
				actor_deck = (
					(actor_deck_raw as Dictionary)
					.duplicate(false)
				)

	actor_deck [
		clean_surface_id
	] = surface_contract

	var actor_main_tab_deck_hot: bool = (
		_resident_main_tab_contract_deck_is_complete_for_actor(
			actor_deck,
			actor_id
		)
	)



	var controlled_actor_id: int = (
		int(
			gs.player.id
		)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)

	if (
		actor_id <= 0
		or controlled_actor_id <= 0
	):
		set_meta(
			"resident_surface_packet_stale_actor_render_rejected",
			true
		)
		set_meta(
			"resident_surface_packet_stale_actor_id",
			actor_id
		)
		set_meta(
			"resident_surface_packet_controlled_actor_id",
			controlled_actor_id
		)
		set_meta(
			"resident_surface_packet_stale_surface_id",
			clean_surface_id
		)
		set_meta(
			"resident_surface_packet_stale_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return









	if actor_id != controlled_actor_id:
		_queue_resident_main_tab_renderer_deck_prewarm(
			actor_id,
			{
				clean_surface_id: surface_contract
			},
			(
				"resident_surface_background_actor_packet:"
				+ clean_signature
			)
		)

		set_meta(
			"resident_surface_packet_background_actor_retained",
			true
		)
		set_meta(
			"resident_surface_packet_background_actor_id",
			actor_id
		)
		set_meta(
			"resident_surface_packet_background_controlled_actor_id",
			controlled_actor_id
		)
		set_meta(
			"resident_surface_packet_background_surface_id",
			clean_surface_id
		)
		set_meta(
			"resident_surface_packet_background_renderer_prewarm_queued",
			true
		)
		set_meta(
			"resident_surface_packet_background_active_repaint_forbidden",
			true
		)
		set_meta(
			"resident_surface_packet_background_engine_calls",
			false
		)
		set_meta(
			"resident_surface_packet_background_ready_gate_member",
			false
		)
		set_meta(
			"resident_surface_packet_background_observed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		return





	if actor_main_tab_deck_hot:
		set_meta(
			"resident_main_tab_authority_deck_observed_complete",
			true
		)
		set_meta(
			"resident_main_tab_authority_deck_observed_actor_id",
			actor_id
		)
		set_meta(
			"resident_main_tab_authority_deck_observed_signature",
			clean_signature
		)
		set_meta(
			"resident_main_tab_complete_does_not_schedule_simulation_work",
			true
		)

	if not bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		_on_resident_surface_contract_ready(
			clean_signature,
			clean_surface_id,
			surface_contract
		)

		if bool(
			get_meta(
				"resident_main_tab_projection_install_complete",
				false
			)
		):
			set_meta(
				"checkpoint_reality_surface_publication_active",
				false
			)
			set_meta(
				"checkpoint_reality_surface_publication_complete",
				true
			)
			set_meta(
				"checkpoint_reality_surface_publication_truth_complete",
				true
			)
			set_meta(
				"checkpoint_reality_surface_publication_waiting_for_live_tab_contracts",
				false
			)

		return

	var packet_key: String = (
		"%s::%s"
		% [
			clean_signature,
			clean_surface_id
		]
	)
	var packet: Dictionary = {
		"packet_key": packet_key,
		"signature": clean_signature,
		"surface_id": clean_surface_id,
		"surface_contract": (
			surface_contract.duplicate(false)
		),
		"actor_id": actor_id,
		"queued_at_ms": int(
			Time.get_ticks_msec()
		),
		"ready_gate_member": false,
	}
	var replaced_existing: bool = false

	for packet_index in range(
		resident_surface_packet_install_queue.size()
	):
		var queued_raw: Variant = (
			resident_surface_packet_install_queue [
				packet_index
			]
		)
		var queued_packet: Dictionary = (
			queued_raw as Dictionary
			if typeof(queued_raw) == TYPE_DICTIONARY
			else {}
		)

		if str(
			queued_packet.get(
				"packet_key",
				""
			)
		) != packet_key:
			continue

		resident_surface_packet_install_queue [
			packet_index
		] = packet
		replaced_existing = true
		break

	if not replaced_existing:
		resident_surface_packet_install_queue.append(
			packet
		)

	set_meta(
		"resident_surface_packet_install_deferred_for_present_fence",
		true
	)
	set_meta(
		"resident_surface_packet_install_deferred_surface_id",
		clean_surface_id
	)
	set_meta(
		"resident_surface_packet_install_deferred_signature",
		clean_signature
	)
	set_meta(
		"resident_surface_packet_install_deferred_actor_id",
		actor_id
	)
	set_meta(
		"resident_surface_packet_install_deferred_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_surface_packet_install_queue_size",
		resident_surface_packet_install_queue.size()
	)

	_arm_resident_surface_packet_install_service()
func _arm_resident_surface_packet_install_service() -> void:
	if resident_surface_packet_install_service_active:
		return

	if resident_surface_packet_install_queue.is_empty():
		return

	var tree:= get_tree()

	if tree == null:
		return

	var callback:= Callable(
		self,
		"_service_resident_surface_packet_install_queue"
	)

	if tree.process_frame.is_connected(
		callback
	):
		resident_surface_packet_install_service_active = true
		return

	var connection_error: int = (
		tree.process_frame.connect(
			callback,
			CONNECT_ONE_SHOT
		)
	)

	if connection_error != OK:
		return

	resident_surface_packet_install_service_active = true

	set_meta(
		"resident_surface_packet_install_uses_call_deferred",
		false
	)
	set_meta(
		"resident_surface_packet_install_uses_await",
		false
	)
	set_meta(
		"resident_surface_packet_install_requires_input_idle",
		false
	)
	set_meta(
		"resident_surface_packet_install_one_packet_per_process_quantum",
		true
	)
	set_meta(
		"resident_school_packet_may_publish_through_present_fence",
		true
	)

func _service_resident_surface_packet_install_queue() -> void:
	resident_surface_packet_install_service_active = false

	if resident_surface_packet_install_queue.is_empty():
		set_meta(
			"resident_surface_packet_install_deferred_for_present_fence",
			false
		)
		set_meta(
			"resident_surface_packet_install_queue_size",
			0
		)
		return

	var renderer_present_fence_active: bool = bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	)
	var packet_index: int = 0






	if renderer_present_fence_active:
		packet_index = -1

		for candidate_index in range(
			resident_surface_packet_install_queue.size()
		):
			var candidate_raw: Variant = (
				resident_surface_packet_install_queue [
					candidate_index
				]
			)

			if typeof(
				candidate_raw
			) != TYPE_DICTIONARY:
				continue

			var candidate: Dictionary = (
				candidate_raw as Dictionary
			)
			var candidate_surface_id: String = str(
				candidate.get(
					"surface_id",
					""
				)
			).strip_edges().to_lower()

			if candidate_surface_id != "school":
				continue

			packet_index = candidate_index
			break

		if packet_index < 0:
			_arm_resident_surface_packet_install_service()
			return

	var packet_raw: Variant = (
		resident_surface_packet_install_queue.pop_at(
			packet_index
		)
	)

	if typeof(
		packet_raw
	) != TYPE_DICTIONARY:
		set_meta(
			"resident_surface_packet_install_queue_size",
			resident_surface_packet_install_queue.size()
		)

		if not resident_surface_packet_install_queue.is_empty():
			_arm_resident_surface_packet_install_service()

		return

	var packet: Dictionary = (
		packet_raw as Dictionary
	)
	var clean_signature: String = str(
		packet.get(
			"signature",
			""
		)
	).strip_edges()
	var clean_surface_id: String = str(
		packet.get(
			"surface_id",
			""
		)
	).strip_edges().to_lower()
	var contract_raw: Variant = packet.get(
		"surface_contract",
		{}
	)
	var contract: Dictionary = (
		(contract_raw as Dictionary).duplicate(
			false
		)
		if typeof(
			contract_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if (
		clean_signature == ""
		or clean_surface_id == ""
		or contract.is_empty()
	):
		set_meta(
			"resident_surface_packet_install_queue_size",
			resident_surface_packet_install_queue.size()
		)

		if not resident_surface_packet_install_queue.is_empty():
			_arm_resident_surface_packet_install_service()

		return

	var packet_actor_id: int = int(
		contract.get(
			"actor_id",
			packet.get(
				"actor_id",
				-1
			)
		)
	)
	var controlled_actor_id: int = (
		int(
			gs.player.id
		)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)



	if (
		packet_actor_id <= 0
		or controlled_actor_id <= 0
		or packet_actor_id != controlled_actor_id
	):
		set_meta(
			"resident_surface_packet_post_present_stale_discarded",
			true
		)
		set_meta(
			"resident_surface_packet_post_present_stale_actor_id",
			packet_actor_id
		)
		set_meta(
			"resident_surface_packet_post_present_controlled_actor_id",
			controlled_actor_id
		)
		set_meta(
			"resident_surface_packet_post_present_stale_surface_id",
			clean_surface_id
		)
		set_meta(
			"resident_surface_packet_post_present_stale_discarded_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		set_meta(
			"resident_surface_packet_install_queue_size",
			resident_surface_packet_install_queue.size()
		)

		if not resident_surface_packet_install_queue.is_empty():
			_arm_resident_surface_packet_install_service()

		return

	_on_resident_surface_contract_ready(
		clean_signature,
		clean_surface_id,
		contract
	)

	set_meta(
		"resident_surface_packet_last_post_present_install",
		clean_surface_id
	)
	set_meta(
		"resident_surface_packet_last_post_present_install_actor_id",
		packet_actor_id
	)
	set_meta(
		"resident_surface_packet_last_post_present_install_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_surface_packet_install_queue_size",
		resident_surface_packet_install_queue.size()
	)
	set_meta(
		"resident_surface_packet_install_last_quantum_used_await",
		false
	)
	set_meta(
		"resident_surface_packet_install_last_quantum_used_timer",
		false
	)
	set_meta(
		"resident_surface_packet_install_last_quantum_used_call_deferred",
		false
	)

	if clean_surface_id == "school":
		set_meta(
			"resident_school_surface_published_without_present_fence_wait",
			true
		)
		set_meta(
			"resident_school_surface_published_actor_id",
			packet_actor_id
		)
		set_meta(
			"resident_school_surface_publication_engine_calls",
			false
		)
		set_meta(
			"resident_school_surface_publication_simulation_mutation",
			false
		)

	if resident_surface_packet_install_queue.is_empty():
		set_meta(
			"resident_surface_packet_install_deferred_for_present_fence",
			false
		)
		return

	_arm_resident_surface_packet_install_service()
func _on_resident_surface_contract_ready(
	signature: String,
	surface_id: String,
	surface_contract: Dictionary
) -> void:
	var clean_signature: String = str(
		signature
	).strip_edges()
	var clean_surface_id: String = str(
		surface_id
	).strip_edges().to_lower()

	if (
		clean_signature == ""
		or clean_surface_id not in [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]
		or surface_contract.is_empty()
	):
		return

	var tracked_signature: String = str(
		get_meta(
			"god_mode_life_prewarm_signature",
			""
		)
	).strip_edges()
	var current_attached_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()
	var belongs_to_current_reality: bool = (
		clean_signature == tracked_signature
		or clean_signature == current_attached_signature
	)

	if (
		tracked_signature == ""
		and current_attached_signature == ""
	):
		return

	if not belongs_to_current_reality:
		return

	_rebind_persistent_main_tab_renderer_references()



	var contract: Dictionary = (
		surface_contract.duplicate(false)
	)
	var actor_id: int = int(
		contract.get(
			"actor_id",
			-1
		)
	)
	var surface_was_open: bool = (
		current_panel == clean_surface_id
	)
	var surface_hot: bool = false

	match clean_surface_id:
		"relationships":
			if (
				relationship_hub_panel != null
				and is_instance_valid(
					relationship_hub_panel
				)
			):
				relationship_hub_panel.render_contract(
					contract
				)
				relationship_hub_panel_active_actor_id = actor_id
				relationships_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						contract.get(
							"active_section",
							"family"
						)
					)
				).strip_edges().to_lower()

				if surface_was_open:
					relationship_hub_panel.show_surface()
				else:


					relationship_hub_panel.hide_surface()

				surface_hot = (
					relationship_hub_panel
					.has_renderable_contract(
						actor_id
					)
				)

		"school":
			if (
				school_hub_panel != null
				and is_instance_valid(
					school_hub_panel
				)
			):
				school_hub_panel.render_contract(
					contract
				)
				school_hub_active_actor_id = actor_id
				school_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						contract.get(
							"active_section",
							"overview"
						)
					)
				).strip_edges().to_lower()

				if surface_was_open:
					school_hub_panel.show_surface()
				else:


					school_hub_panel.hide_surface()

				surface_hot = (
					school_hub_panel.has_renderable_contract(
						actor_id
					)
				)

		"activities":
			if (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
			):
				activities_hub_panel.render_contract(
					contract
				)
				activities_hub_active_actor_id = actor_id
				activities_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"all"
						)
					)
				).strip_edges().to_lower()

				activities_hub_panel.visible = surface_was_open
				activities_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_STOP
					if surface_was_open
					else Control.MOUSE_FILTER_IGNORE
				)



				activities_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				surface_hot = (
					activities_hub_panel
					.has_renderable_contract(
						actor_id
					)
				)

		"career":
			if (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
			):
				career_hub_panel.render_contract(
					contract
				)
				career_hub_active_actor_id = actor_id
				career_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"overview"
						)
					)
				).strip_edges().to_lower()
				career_hub_active_lane = str(
					contract.get(
						"career_lane",
						"full_time"
					)
				).strip_edges().to_lower()

				career_hub_panel.visible = surface_was_open
				career_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_STOP
					if surface_was_open
					else Control.MOUSE_FILTER_IGNORE
				)
				career_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				surface_hot = (
					_career_hub_contract_is_renderable(
						career_hub_panel.active_contract,
						actor_id
					)
				)

		"mods":
			if (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
			):
				mod_menu_panel.render_contract(
					contract
				)
				mod_menu_active_actor_id = actor_id
				mod_menu_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"bundles"
						)
					)
				).strip_edges().to_lower()

				mod_menu_panel.visible = surface_was_open
				mod_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_STOP
					if surface_was_open
					else Control.MOUSE_FILTER_IGNORE
				)
				mod_menu_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				surface_hot = (
					mod_menu_panel.has_precomposed_surface(
						actor_id
					)
				)

	var cached_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var cached_contracts: Dictionary = (
		(
			cached_contracts_raw as Dictionary
		).duplicate(false)
		if typeof(
			cached_contracts_raw
		) == TYPE_DICTIONARY
		else {}
	)

	cached_contracts [
		clean_surface_id
	] = contract.duplicate(false)

	set_meta(
		"resident_main_tab_surface_contracts",
		cached_contracts
	)
	set_meta(
		"resident_main_tab_projection_install_signature",
		clean_signature
	)
	set_meta(
		"resident_main_tab_projection_install_actor_id",
		actor_id
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s"
		% clean_surface_id,
		surface_hot
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s_at_ms"
		% clean_surface_id,
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_surface_packet_last_surface_id",
		clean_surface_id
	)
	set_meta(
		"resident_surface_packet_last_surface_hot",
		surface_hot
	)
	set_meta(
		"resident_surface_packet_engine_calls",
		false
	)
	set_meta(
		"resident_surface_packet_build_on_click",
		false
	)
	set_meta(
		"resident_surface_packet_ready_gate_member",
		false
	)
	set_meta(
		"resident_surface_packet_renderer_kept_alive_behind_cover",
		true
	)
	set_meta(
		"resident_surface_packet_hidden_renderer_input_enabled",
		false
	)

	var installed_count: int = 0
	var all_surfaces_hot: bool = true

	for required_surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var required_surface_hot: bool = bool(
			get_meta(
				"native_main_tab_surface_projection_installed_%s"
				% required_surface_id,
				false
			)
		)

		if required_surface_hot:
			installed_count += 1
		else:
			all_surfaces_hot = false

	set_meta(
		"resident_main_tab_projection_install_cursor",
		installed_count
	)
	set_meta(
		"resident_main_tab_projection_install_total",
		5
	)
	set_meta(
		"resident_main_tab_projection_install_active",
		not all_surfaces_hot
	)
	set_meta(
		"resident_main_tab_projection_install_complete",
		all_surfaces_hot
	)
	set_meta(
		"ready_room_actor_bound_surfaces_hot",
		all_surfaces_hot
	)
	set_meta(
		"ready_room_background_truth_pending",
		not all_surfaces_hot
	)
	set_meta(
		"ready_room_background_truth_complete",
		all_surfaces_hot
	)

	EraLog.truth(
		(
			"ERALIFE_RESIDENT_SURFACE_PACKET_TRUTH"
			+ "|signature=%s"
			+ "|surface=%s"
			+ "|actor_id=%d"
			+ "|hot=%s"
			+ "|installed=%d/5"
			+ "|all_main_surfaces_hot=%s"
			+ "|renderer_kept_alive=true"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=%d"
		)
		% [
			clean_signature,
			clean_surface_id,
			actor_id,
			str(
				surface_hot
			),
			installed_count,
			str(
				all_surfaces_hot
			),
			int(
				Time.get_ticks_msec()
			)
		]
	)
func _on_resident_projection_ready(
	signature: String,
	projection_contract: Dictionary
) -> void:
