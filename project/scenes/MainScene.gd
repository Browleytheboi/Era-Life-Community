func _god_mode_runtime_severed() -> bool:
	var firewall:= _ensure_god_mode_runtime_firewall_engine()
	if firewall == null:
		return bool(get_meta("god_mode_panel_non_runtime", false))

	return firewall.is_severed() or bool(get_meta("god_mode_panel_non_runtime", false))


func _god_mode_runtime_allowed(source: String, action: String = "runtime_check") -> bool:
	var firewall:= _ensure_god_mode_runtime_firewall_engine()
	if firewall == null:
		return not bool(get_meta("god_mode_panel_non_runtime", false))

	if not firewall.allow_god_mode_runtime(source, action):
		var now_ms: int = int(Time.get_ticks_msec())

		set_meta("god_mode_runtime_firewall_last_blocked_source", source)
		set_meta("god_mode_runtime_firewall_last_blocked_action", action)
		set_meta("god_mode_runtime_firewall_last_blocked_at_ms", now_ms)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["god_mode_runtime_firewall_last_blocked_source"] = source
			gs.scenario_state ["god_mode_runtime_firewall_last_blocked_action"] = action
			gs.scenario_state ["god_mode_runtime_firewall_last_blocked_at_ms"] = now_ms




		var playable_surface_can_own_screen: bool = gs != null and gs.player != null and (
			bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false))
			or bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false))
			or bool(get_meta("playable_life_surface_authority_lock_active", false))
		)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			playable_surface_can_own_screen = playable_surface_can_own_screen or bool(gs.scenario_state.get("god_mode_life_front_buffer_claimed", false))
			playable_surface_can_own_screen = playable_surface_can_own_screen or bool(gs.scenario_state.get("playable_life_surface_has_visual_authority", false))
			playable_surface_can_own_screen = playable_surface_can_own_screen or bool(gs.scenario_state.get("god_mode_playable_ui_atomic_commit_complete", false))

		if playable_surface_can_own_screen and not bool(get_meta("god_mode_runtime_firewall_retired_prelife_visuals_once", false)):
			set_meta("god_mode_runtime_firewall_retired_prelife_visuals_once", true)
			set_meta("god_mode_runtime_firewall_retired_prelife_visuals_once_reason", source)
			set_meta("god_mode_runtime_firewall_retired_prelife_visuals_once_at_ms", now_ms)
			_retire_all_prelife_visual_authority_for_playable_life("%s_firewall_block_once" % source)

		return false

	return true


func _god_mode_meta_bool(key: String, fallback: bool = false, source: String = "meta_read") -> bool:
	var value: bool = bool(get_meta(key, fallback))
	var firewall:= _ensure_god_mode_runtime_firewall_engine()
	if firewall == null:
