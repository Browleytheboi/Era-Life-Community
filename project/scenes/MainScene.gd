func _god_mode_audio_context(reason: String = "god_mode_panel") -> Dictionary:
	var year_value: int = 0

	if custom_year_spin != null and is_instance_valid(custom_year_spin):
		year_value = int(custom_year_spin.value)
	elif gs != null and typeof(gs.custom_settings) == TYPE_DICTIONARY:
		year_value = int(gs.custom_settings.get("year", 0))

	return {
