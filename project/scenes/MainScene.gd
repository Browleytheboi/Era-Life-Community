func _present_god_mode_viewer_modal(
	reason: String = "open_god_mode"
) -> void:
	_global_runtime_kill_enter_main_menu_runtime(
		reason,
		{
			"god_mode_viewer": true,
			"simulation_work_forbidden": true
		}
	)

	var engine:= _ensure_god_mode_contract_engine()

	if engine == null:
		return

	set_meta(
		"god_mode_entry_transition_active",
		true
	)
	set_meta(
		"god_mode_viewer_modal_open_requested",
		true
	)
	set_meta(
		"god_mode_viewer_modal_open_reason",
		reason
	)
	set_meta(
		"god_mode_viewer_modal_open_requested_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"god_mode_zero_frame_open_active",
		false
	)
	set_meta(
		"god_mode_panel_ui_prewarm_allowed",
		false
	)
	set_meta(
		"god_mode_start_panel_idle_prewarm_pending",
		false
	)
	set_meta(
		"god_mode_open_after_hot_cache_requested",
		false
	)

	var settings: Dictionary = {}

	if (
		gs != null
		and typeof(
			gs.custom_settings
		) == TYPE_DICTIONARY
	):
		settings = gs.custom_settings.duplicate(true)

	if (
		god_mode_viewer == null
		or not is_instance_valid(
			god_mode_viewer
		)
	):
		god_mode_viewer = GodModeViewer.new()
		god_mode_viewer.name = "GodModeViewer"

		add_child(
			god_mode_viewer
		)

	if (
		god_mode_viewer == null
		or not is_instance_valid(
			god_mode_viewer
		)
	):
		set_meta(
			"god_mode_entry_transition_active",
			false
		)
		return

	var close_callable:= Callable(
		self,
		"_on_god_mode_viewer_close_requested"
	)

	if not god_mode_viewer.close_requested.is_connected(
		close_callable
	):
		god_mode_viewer.close_requested.connect(
			close_callable
		)

	var prewarm_callable:= Callable(
		self,
		"_on_god_mode_viewer_prewarm_requested"
	)

	if (
		god_mode_viewer.has_signal(
			"prewarm_requested"
		)
		and not god_mode_viewer.prewarm_requested.is_connected(
			prewarm_callable
		)
	):
		god_mode_viewer.prewarm_requested.connect(
			prewarm_callable
		)

	var handoff_callable:= Callable(
		self,
		"_on_god_mode_viewer_handoff_requested"
	)

	if (
		god_mode_viewer.has_signal(
			"handoff_requested"
		)
		and not god_mode_viewer.handoff_requested.is_connected(
			handoff_callable
		)
	):
		god_mode_viewer.handoff_requested.connect(
			handoff_callable
		)

	var residency_candidate_callable:= Callable(
		self,
		"_on_god_mode_viewer_residency_candidate_changed"
	)

	if (
		god_mode_viewer.has_signal(
			"residency_candidate_changed"
		)
		and not god_mode_viewer.residency_candidate_changed.is_connected(
			residency_candidate_callable
		)
	):
		god_mode_viewer.residency_candidate_changed.connect(
			residency_candidate_callable
		)

	god_mode_viewer.bind_contract_engine(
		engine
	)

	if (
		god_mode_viewer.has_method(
			"prebuild_hidden"
		)
		and not bool(
			god_mode_viewer.get_meta(
				"god_mode_viewer_prebuilt_hidden",
				false
			)
		)
	):
		god_mode_viewer.call(
			"prebuild_hidden",
			settings,
			"%s_zero_frame_instance_repair" % reason
		)

	if (
		god_mode_viewer == null
		or not is_instance_valid(
			god_mode_viewer
		)
	):
		set_meta(
			"god_mode_entry_transition_active",
			false
		)
		return

	god_mode_viewer.bind_contract_engine(
		engine
	)
	god_mode_viewer.present_as_modal(
		settings,
		reason
	)
	_bring_modal_to_front(
		god_mode_viewer
	)

	if (
		choose_adventure_entry_overlay != null
		and is_instance_valid(
			choose_adventure_entry_overlay
		)
	):
		var doorway_cover:= (
			choose_adventure_entry_overlay.get_node_or_null(
				"__ChooseErealityDoorwayCover"
			) as Control
		)

		if (
			doorway_cover != null
			and is_instance_valid(
				doorway_cover
			)
		):
			doorway_cover.visible = false
			doorway_cover.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		choose_adventure_entry_overlay.visible = false
		choose_adventure_entry_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_hide_god_mode_start_panel_zero_frame_shell(
		"%s_viewer_modal_open" % reason
	)

	if gs != null:
		if typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state [
			"god_mode_viewer_modal_open"
		] = true
		gs.scenario_state [
			"god_mode_viewer_modal_open_reason"
		] = reason
		gs.scenario_state [
			"god_mode_ui_is_viewer_only"
		] = true
		gs.scenario_state [
			"god_mode_main_scene_authority_removed"
		] = true
		gs.scenario_state [
			"materialize_world_seed_on_initialize"
		] = false
		gs.scenario_state [
			"god_mode_manual_world_seed_prewarm_authorized"
		] = false
		gs.scenario_state [
			"soul_seed_distribution_authorized"
		] = false
		gs.scenario_state [
			"soul_seed_distribution_reason"
		] = "god_mode_viewer_open_only"
		gs.scenario_state [
			"soul_seed_background_distribution_pending"
		] = false
		gs.scenario_state [
			"soul_seed_background_stream_active"
		] = false
		gs.scenario_state [
			"runtime_hud_node_prewarm_authorized"
		] = false
		gs.scenario_state [
			"defer_static_world_bootstrap"
		] = true
		gs.scenario_state [
			"defer_live_runtime_watchers"
		] = true

	set_meta(
		"god_mode_entry_transition_active",
		false
	)
	set_meta(
		"god_mode_viewer_modal_opened",
		true
	)
	set_meta(
		"god_mode_viewer_modal_opened_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	call_deferred(
		"_ensure_god_mode_viewer_modal_front",
		reason
	)
	call_deferred(
		"_sync_god_mode_audio_contract",
		reason
	)
func _ensure_god_mode_viewer_modal_front(reason: String = "god_mode_viewer_modal_front") -> void:
	if god_mode_viewer == null or not is_instance_valid(god_mode_viewer):
		return

	god_mode_viewer.visible = true
	god_mode_viewer.show()
	god_mode_viewer.mouse_filter = Control.MOUSE_FILTER_STOP
	god_mode_viewer.focus_mode = Control.FOCUS_ALL
	god_mode_viewer.top_level = true
	god_mode_viewer.z_as_relative = false
	god_mode_viewer.z_index = max(int(god_mode_viewer.z_index), 2400)

	_bring_modal_to_front(god_mode_viewer)

	if god_mode_viewer.has_method("_force_modal_surface"):
		god_mode_viewer.call("_force_modal_surface", reason)

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		choose_adventure_entry_overlay.visible = false
		choose_adventure_entry_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	set_meta("god_mode_viewer_front_repaired", true)
	set_meta("god_mode_viewer_front_repaired_reason", reason)
	set_meta("god_mode_viewer_front_repaired_at_ms", int(Time.get_ticks_msec()))
func _ensure_god_mode_contract_engine() -> GodModeContractEngine:
	var visible_life_shell_sovereign: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)

	if god_mode_contract_engine == null:



		if visible_life_shell_sovereign:
			set_meta(
				"god_mode_contract_engine_visible_shell_lazy_create_forbidden",
				true
			)
			set_meta(
				"god_mode_contract_engine_visible_shell_lazy_create_forbidden_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)
			return null

		god_mode_contract_engine = GodModeContractEngine.new(
			gs
		)
	elif god_mode_contract_engine.gs != gs:
		if visible_life_shell_sovereign:




			god_mode_contract_engine.bind_game_state_observation_only(
				gs
			)
		else:
			god_mode_contract_engine.bind_game_state(
				gs
			)

	if god_mode_contract_engine == null:
		return null

	god_mode_panel_contract_engine = (
		god_mode_contract_engine.panel_engine
	)
	god_mode_tracker_contract_engine = (
		god_mode_contract_engine.tracker_engine
	)
	god_mode_runtime_firewall_engine = (
		god_mode_contract_engine.firewall_engine
	)

	return god_mode_contract_engine
func _ensure_global_runtime_kill_contract_engine() -> GlobalRuntimeKillContractEngine:
	if global_runtime_kill_contract_engine == null:
		global_runtime_kill_contract_engine = GlobalRuntimeKillContractEngine.new(gs)
		return global_runtime_kill_contract_engine

	if global_runtime_kill_contract_engine.gs != gs:
		if global_runtime_kill_contract_engine.has_method("bind_game_state_quiet"):
			global_runtime_kill_contract_engine.call("bind_game_state_quiet", gs)
		else:
			global_runtime_kill_contract_engine.bind_game_state(gs)

	return global_runtime_kill_contract_engine
func _global_runtime_kill_set_runtime_domain(domain: String, reason: String = "runtime_domain", context: Dictionary = {}) -> void:
	var engine:= _ensure_global_runtime_kill_contract_engine()
	var clean_domain: String = str(domain).strip_edges().to_lower()
	if clean_domain == "":
		clean_domain = "cinematic"

	var clean_context: Dictionary = context.duplicate(true)
	clean_context ["source"] = str(clean_context.get("source", "Mainscene"))
	clean_context ["current_panel"] = current_panel
	clean_context ["playable_life_shell_visible"] = _playable_life_shell_has_visible_sovereignty()

	if engine != null and engine.has_method("set_runtime_domain"):
		engine.call("set_runtime_domain", clean_domain, reason, clean_context)

	_global_runtime_kill_apply_runtime_domain_law(clean_domain, reason, clean_context)


func _global_runtime_kill_enter_cinematic_runtime(reason: String = "cinematic_runtime", context: Dictionary = {}) -> void:
	_global_runtime_kill_set_runtime_domain("cinematic", reason, context)


func _global_runtime_kill_enter_main_menu_runtime(reason: String = "main_menu_runtime", context: Dictionary = {}) -> void:
	_global_runtime_kill_set_runtime_domain("main_menu", reason, context)


func _global_runtime_kill_enter_transition_runtime(reason: String = "transition_runtime", context: Dictionary = {}) -> void:
	_global_runtime_kill_set_runtime_domain("transition", reason, context)


func _global_runtime_kill_enter_simulation_runtime(reason: String = "simulation_runtime", context: Dictionary = {}) -> void:
	_global_runtime_kill_set_runtime_domain("simulation", reason, context)


func _global_runtime_kill_current_runtime_domain() -> String:
	var clean_domain: String = str(get_meta("global_runtime_active_domain", "")).strip_edges().to_lower()

	if clean_domain == "" and gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		clean_domain = str(gs.scenario_state.get("global_runtime_domain", "")).strip_edges().to_lower()

	if clean_domain == "":
		if _playable_life_shell_has_visible_sovereignty():
			return "simulation"
		return "cinematic"

	return clean_domain


func _global_runtime_kill_apply_runtime_domain_law(domain: String, reason: String = "runtime_domain", context: Dictionary = {}) -> void:
	var clean_domain: String = str(domain).strip_edges().to_lower()
	if clean_domain == "":
		clean_domain = "cinematic"

	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("global_runtime_active_domain", clean_domain)
	set_meta("global_runtime_active_domain_reason", reason)
	set_meta("global_runtime_active_domain_at_ms", now_ms)
	set_meta("global_runtime_domain_context", context.duplicate(true))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["global_runtime_domain"] = clean_domain
		gs.scenario_state ["global_runtime_domain_reason"] = reason
		gs.scenario_state ["global_runtime_domain_at_ms"] = now_ms
		gs.scenario_state ["global_runtime_domain_context"] = context.duplicate(true)
		gs.scenario_state ["global_runtime_simulation_allowed"] = clean_domain == "simulation"
		gs.scenario_state ["global_runtime_prelife_domain_active"] = clean_domain in ["cinematic", "main_menu", "transition"]

	if clean_domain == "simulation":
		set_meta("prelife_tail_work_blocked_until_ms", 0)
		set_meta("cinematic_runtime_blocks_simulation", false)
		set_meta("main_menu_runtime_blocks_simulation", false)
		set_meta("transition_runtime_blocks_simulation", false)
		set_meta("main_menu_surface_active", false)
		set_meta("main_menu_surface_terminated_for_playable_entry", true)
		set_meta("choose_adventure_surface_must_not_render_in_simulation", true)

		if _choose_adventure_surface_is_visibly_blocking_playable_entry():
			_hard_kill_choose_adventure_surface_for_playable_entry("%s_runtime_domain_simulation" % reason)

		return

	set_meta("cinematic_runtime_blocks_simulation", clean_domain == "cinematic")
	set_meta("main_menu_runtime_blocks_simulation", clean_domain == "main_menu")
	set_meta("transition_runtime_blocks_simulation", clean_domain == "transition")
	set_meta("prelife_tail_work_blocked_until_ms", now_ms + 1400)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 1200)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 1200)
	set_meta("speculative_year_precompute_next_ms", now_ms + 1800)
	set_meta("spawn_ready_main_tab_packet_prewarm_running", false)
	set_meta("deferred_live_reality_stream_bind_pending", false)
	set_meta("post_first_frame_god_mode_life_boot_pending", false)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["life_runtime_background_tail_deferred"] = true
		gs.scenario_state ["prelife_domain_blocks_simulation_work"] = true
		gs.scenario_state ["prelife_domain_blocks_simulation_reason"] = reason
		gs.scenario_state ["prelife_tail_work_blocked_until_ms"] = now_ms + 1400


func _global_runtime_kill_prelife_domain_frame_active(_now_ms: int = -1) -> bool:
	var clean_domain: String = _global_runtime_kill_current_runtime_domain()
	if clean_domain == "simulation":
		return false

	return clean_domain in ["cinematic", "main_menu", "transition"]


func _drive_global_runtime_prelife_domain_frame(delta: float, now_ms: int) -> void:
	var clean_domain: String = _global_runtime_kill_current_runtime_domain()

	set_meta("ui_idle_bus_flush_next_ms", now_ms + 900)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 900)
	set_meta("speculative_year_precompute_next_ms", now_ms + 1400)
	set_meta("prelife_tail_work_blocked_until_ms", now_ms + 900)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
		guard ["global_runtime_domain"] = clean_domain
		guard ["prelife_runtime_isolated"] = true
		guard ["simulation_work_forbidden"] = true
		guard ["ui_tail_work_yield_to_input"] = true
		guard ["last_action"] = "global_runtime_prelife_domain_frame"
		guard ["last_action_ms"] = now_ms
		gs.scenario_state ["runtime_guard"] = guard

	match clean_domain:
		"cinematic":
			_drive_era_audio_contract_runtime(delta)
			_drive_ui_pointer_activity_probe(now_ms)
		"main_menu":
			if not _god_mode_runtime_severed():
				_animate_god_mode_presentation(delta)
				_drive_god_mode_scrollbar_visibility(delta)
				_drive_god_mode_menu_music_rotation(delta)
			_drive_ui_pointer_activity_probe(now_ms)
		"transition":
			_animate_panel_content_transition(delta)
			_drive_era_audio_contract_runtime(delta)
			_drive_ui_pointer_activity_probe(now_ms)
		_:
			_drive_ui_pointer_activity_probe(now_ms)


func _global_runtime_kill_runtime_domain_allows_background_tail(now_ms: int = -1) -> bool:
	var clean_domain: String = _global_runtime_kill_current_runtime_domain()
	if clean_domain == "simulation":
		return true

	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	set_meta("background_tail_blocked_by_runtime_domain", true)
	set_meta("background_tail_blocked_runtime_domain", clean_domain)
	set_meta("background_tail_blocked_by_runtime_domain_at_ms", check_ms)
	set_meta("ui_idle_bus_flush_next_ms", check_ms + 1200)
	set_meta("age_up_tail_background_allowed_after_ms", check_ms + 1200)
	set_meta("speculative_year_precompute_next_ms", check_ms + 1800)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["background_tail_blocked_by_runtime_domain"] = true
		gs.scenario_state ["background_tail_blocked_runtime_domain"] = clean_domain
		gs.scenario_state ["background_tail_blocked_by_runtime_domain_at_ms"] = check_ms

	return false
func _global_runtime_kill_acquire_playable_shell_authority(reason: String = "playable_shell_visible") -> void:
	var engine:= _ensure_global_runtime_kill_contract_engine()
	if engine == null:
		return

	engine.acquire_playable_shell_authority(reason, {
		"source": "Mainscene",
		"current_panel": current_panel,
		"playable_life_shell_visible": _playable_life_shell_has_visible_sovereignty(),
		"control_grace_ms": 12000
	})

	_global_runtime_kill_apply_visible_shell_law(reason)

func _global_runtime_kill_visible_shell_frame_lock_active(
		now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	if not _playable_life_shell_has_visible_sovereignty():
		return false

	if _visible_age_up_runtime_is_player_initiated():
		return false






	if _playable_life_surface_player_control_released():
		return false

	var engine: GlobalRuntimeKillContractEngine = (
		global_runtime_kill_contract_engine
	)

	if engine == null:
		return false

	if not engine.is_shell_locked():
		return false

	var grace_until_ms: int = int(
		engine.playable_shell_control_grace_until_ms
	)

	return (
		grace_until_ms > 0
		and check_ms < grace_until_ms
	)
func _drive_global_runtime_locked_renderer_only_frame(delta: float, now_ms: int) -> void:
