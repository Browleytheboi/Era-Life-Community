func _world_browser_contract_from_intent_report(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [report]
	var cursor: int = 0

	while cursor < queue.size():
		var current_raw: Variant = queue [cursor]
		cursor += 1

		if typeof(current_raw) != TYPE_DICTIONARY:
			continue

		var current: Dictionary = current_raw as Dictionary
		var contract_raw: Variant = current.get(
			"contract",
			current.get(
				"world_browser_contract",
				{}
			)
		)

		if typeof(contract_raw) == TYPE_DICTIONARY:
			var contract: Dictionary = (
				contract_raw as Dictionary
			)

			if (
				not contract.is_empty()
				and bool(
					contract.get(
						"projection_complete",
						current.get(
							"complete",
							false
						)
					)
				)
			):
				return contract.duplicate(false)

		for raw_key in current.keys():
			var nested_raw: Variant = current.get(
				raw_key
			)

			if typeof(nested_raw) == TYPE_DICTIONARY:
				queue.append(nested_raw)

	return {}


