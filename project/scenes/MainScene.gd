func _show_age_up_loading_overlay() -> void:
	_ensure_age_up_loading_overlay()
	if age_up_loading_overlay == null:
		return

	var loading_context_raw: Variant = get_meta("age_up_loading_deferred_begin_context", {})
	var loading_context: Dictionary = loading_context_raw if typeof(loading_context_raw) == TYPE_DICTIONARY else {}

	if not _global_runtime_kill_claim_allowed("loading", "Mainscene._show_age_up_loading_overlay", "show_age_up_loading_overlay", loading_context.duplicate(true)):
		return

	if _playable_life_shell_loading_overlay_forbidden_now("show_age_up_loading_overlay"):
		_clear_illegal_playable_shell_loading_blockers("show_age_up_loading_overlay_blocked_by_playable_shell")
		return
	if age_up_loading_exit_tween != null:
		age_up_loading_exit_tween.kill()
		age_up_loading_exit_tween = null


	var prewarm_signature: String = MainSceneHelpers._build_age_up_loading_prewarm_signature(loading_context)
	var can_use_prewarm: bool = bool(get_meta("age_up_loading_prewarm_ready", false)) \
and prewarm_signature != "" \
and str(get_meta("age_up_loading_prewarm_signature", "")) == prewarm_signature

	var first_visible_runtime_boot: bool = bool(loading_context.get("first_visible_runtime_boot", false))
	var pure_renderer: bool = bool(loading_context.get("pure_renderer", false))

	var opening_quarantine_frames_default: int = 1 if first_visible_runtime_boot else 2
	var opening_quarantine_ms_default: int = 0 if first_visible_runtime_boot else 16

	var opening_quarantine_frames: int = int(loading_context.get("opening_quarantine_frames", opening_quarantine_frames_default))
	var opening_quarantine_ms: int = int(loading_context.get("opening_quarantine_ms", opening_quarantine_ms_default))

	if not pure_renderer:
		opening_quarantine_frames = max(1, opening_quarantine_frames)
		opening_quarantine_ms = max(8, opening_quarantine_ms)
	else:
		opening_quarantine_frames = max(0, opening_quarantine_frames)
		opening_quarantine_ms = max(0, opening_quarantine_ms)

	var border_theme: Dictionary = _get_cached_age_up_loading_border_theme(true)
	var tint: Color = border_theme.get("core", Color(1.0, 1.0, 1.0, 1.0))

	age_up_loading_runtime_active = true
	age_up_loading_finish_requested = false
	age_up_loading_paint_hold_frames = max(AGE_UP_LOADING_PAINT_HOLD_FRAMES, opening_quarantine_frames)
	age_up_loading_visible_started_ms = Time.get_ticks_msec()
	age_up_loading_exit_started_ms = 0
	age_up_loading_result = {}

	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("live_diagnostics_manual_throttle_enabled", true)
	set_meta("live_diagnostics_opening_quarantine_frames", opening_quarantine_frames)
	set_meta("live_diagnostics_opening_quarantine_until_ms", age_up_loading_visible_started_ms + opening_quarantine_ms)
	set_meta("live_diagnostics_deferred_force_frames", 0)

	live_diagnostics_refresh_accumulator = 0.0
	live_diagnostics_force_frames = 0

	if can_use_prewarm:
		age_up_loading_overlay.visible = true
		age_up_loading_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
		age_up_loading_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
		age_up_loading_flash.color = Color(tint.r, tint.g, tint.b, 0.0)
		age_up_loading_dim.color = Color(0.0, 0.0, 0.0, 1.0)
		_bring_modal_to_front(age_up_loading_overlay)
		set_meta("age_up_loading_prewarm_ready", false)
		_refresh_age_up_loading_text_from_state(false)
		_animate_age_up_loading_overlay(1.0 / 60.0)
		_refresh_age_up_loading_eralife_logo_render(false)
		return

	age_up_loading_message_elapsed = 0.0
	age_up_loading_message_index = 0
	age_up_loading_ring_elapsed = AGE_UP_LOADING_RING_WARM_START_ELAPSED
	age_up_loading_heartbeat_elapsed = AGE_UP_LOADING_HEARTBEAT_WARM_START_ELAPSED
	age_up_loading_shimmer_elapsed = AGE_UP_LOADING_SHIMMER_WARM_START_ELAPSED
	age_up_loading_did_you_know_crossfade_elapsed = 0.0
	age_up_loading_did_you_know_crossfade_active = false
	age_up_loading_did_you_know_front_is_primary = true
	age_up_loading_did_you_know_current_key = ""
	age_up_loading_did_you_know_scroll_elapsed = 0.0
	age_up_loading_eralife_type_elapsed = AGE_UP_LOADING_ERALIFE_WARM_START_ELAPSED
	age_up_loading_eralife_type_char_count = min(AGE_UP_LOADING_ERALIFE_WARM_START_CHARS, AGE_UP_LOADING_ERALIFE_TEXT.length())
	age_up_loading_eralife_type_direction = 1
	age_up_loading_eralife_hold_elapsed = 0.0
	age_up_loading_eralife_corner_index = 0
	age_up_loading_eralife_render_phase_bucket = -1
	age_up_loading_eralife_render_text = ""

	age_up_loading_cached_headline_text = ""
	age_up_loading_cached_subtitle_text = ""
	age_up_loading_cached_phase_text = ""
	age_up_loading_cached_footer_text = ""

	set_meta("age_up_loading_visual_bucket", -1)

	age_up_loading_overlay.visible = true
	age_up_loading_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	age_up_loading_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
	age_up_loading_flash.color = Color(tint.r, tint.g, tint.b, 0.0)
	age_up_loading_dim.color = Color(0.0, 0.0, 0.0, 1.0)

	if age_up_loading_did_you_know_front_body != null:
		age_up_loading_did_you_know_front_body.text = ""
		age_up_loading_did_you_know_front_body.visible = true
		age_up_loading_did_you_know_front_body.position = Vector2.ZERO
		age_up_loading_did_you_know_front_body.modulate = Color(1.0, 1.0, 1.0, 1.0)

	if age_up_loading_did_you_know_back_body != null:
		age_up_loading_did_you_know_back_body.text = ""
		age_up_loading_did_you_know_back_body.visible = false
		age_up_loading_did_you_know_back_body.position = Vector2.ZERO
		age_up_loading_did_you_know_back_body.modulate = Color(1.0, 1.0, 1.0, 0.0)

	_reset_age_up_loading_did_you_know_scroll()

	var eralife_logo = get_meta("age_up_loading_eralife_logo", null)
	if eralife_logo != null:
		eralife_logo.modulate = Color(1.0, 1.0, 1.0, 0.0)

	if eralife_logo is RichTextLabel:
		eralife_logo.custom_minimum_size = Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72)
		eralife_logo.size = Vector2(AGE_UP_LOADING_ERALIFE_MIN_WIDTH, 72)
		eralife_logo.clear()

	_bring_modal_to_front(age_up_loading_overlay)
	_refresh_age_up_loading_text_from_state(true)
	_animate_age_up_loading_overlay(1.0 / 60.0)
	_refresh_age_up_loading_eralife_logo_render(true)
	set_meta("age_up_loading_prewarm_ready", false)


