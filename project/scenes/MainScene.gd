func _render_world_feed_entries_by_year_and_section(entries: Array, current_year: int) -> void:
	var years_in_order: Array = []
	var year_buckets: Dictionary = {}
	var feed_position: int = 0

	for raw_entry in entries:
		feed_position += 1

		if typeof(raw_entry) != TYPE_DICTIONARY:
			continue

		var entry: Dictionary = raw_entry
		var entry_year: int = int(entry.get("year", current_year))
		var section_key: String = MainSceneLogic._world_feed_section_key(gs, entry)

		if not year_buckets.has(entry_year):
			year_buckets [entry_year] = {
				"section_order": [],
				"sections": {},
				"section_scores": {},
				"section_latest_positions": {}
			}
			years_in_order.append(entry_year)

		var year_bucket: Dictionary = year_buckets.get(entry_year, {})
		var section_order: Array = year_bucket.get("section_order", [])
		var sections: Dictionary = year_bucket.get("sections", {})
		var section_scores: Dictionary = year_bucket.get("section_scores", {})
		var section_latest_positions: Dictionary = year_bucket.get("section_latest_positions", {})

		if not sections.has(section_key):
			sections [section_key] = []
			section_order.append(section_key)

		var section_entries: Array = sections.get(section_key, [])
		section_entries.append(entry)
		sections [section_key] = section_entries

		section_scores [section_key] = float(section_scores.get(section_key, 0.0)) + MainSceneLogic._world_feed_entry_importance_score(gs, entry)
		section_latest_positions [section_key] = feed_position

		year_bucket ["section_order"] = section_order
		year_bucket ["sections"] = sections
		year_bucket ["section_scores"] = section_scores
		year_bucket ["section_latest_positions"] = section_latest_positions
		year_buckets [entry_year] = year_bucket

	years_in_order.sort()

	for raw_year in years_in_order:
		var entry_year: int = int(raw_year)
		var year_bucket: Dictionary = year_buckets.get(entry_year, {})
		var sections: Dictionary = year_bucket.get("sections", {})
		var sorted_section_order: Array = _sort_world_feed_sections_for_year(year_bucket)

		_append_world_feed_centered_year_line("Year: %s" % _format_year(entry_year), Color(1.0, 0.9, 0.72, 1.0))
		_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))

		for raw_section_key in sorted_section_order:
			var section_key: String = str(raw_section_key)
			var section_entries: Array = sections.get(section_key, [])
			if section_entries.is_empty():
				continue

			_append_world_feed_section_header(section_key, int(section_entries.size()))

			for raw_section_entry in section_entries:
				if typeof(raw_section_entry) != TYPE_DICTIONARY:
					continue
				_append_world_feed_entry_line(raw_section_entry)

			_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
func _resolve_world_feed_shell_truth_snapshot(_reason: String = "world_shell_truth") -> void:
	if current_panel != "world":
		return
	if gs == null:
		return
	if world_feed_popup == null or not world_feed_popup.visible:
		return
	if world_feed_popup_feed == null:
		return

	world_feed_popup_feed.clear()

	var mode_label:= MainSceneLogic._display_reality_mode_label_from_settings(gs.custom_settings)
	var seed_text:= "World Seed: Unknown"
	if gs.seed_engine != null:
		seed_text = "World Seed: %s" % str(gs.seed_engine.seed_value)

	_append_world_feed_colored_line("===== WORLD FEED =====", Color(1.0, 0.96, 0.84, 1.0))
	_append_world_feed_colored_line(seed_text, Color(0.82, 0.94, 1.0, 1.0))
	_append_world_feed_colored_line("Current Year: %s" % _format_year(gs.year), Color(0.94, 0.96, 1.0, 1.0))
	_append_world_feed_colored_line("Reality Mode: %s" % mode_label, Color(0.94, 0.96, 1.0, 0.94))
	_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))

	var feed_source: Array = []
	if typeof(gs.world_feed) == TYPE_ARRAY:
		feed_source = gs.world_feed

	var max_entries: int = int(get_meta("world_feed_shell_truth_max_entries", 160))
	if max_entries < 40:
		max_entries = 40

	var max_scan: int = int(get_meta("world_feed_shell_truth_max_scan", 2400))
	if max_scan < max_entries:
		max_scan = max_entries

	var current_year: int = int(gs.year)
	var min_recent_year: int = current_year - 3
	var selected_entries: Array = []
	var protected_entries: Array = []
	var dedupe: Dictionary = {}
	var scanned: int = 0

	for feed_index in range(feed_source.size() - 1, -1, -1):
		scanned += 1
		if scanned > max_scan:
			break

		var entry: Dictionary = gs.normalize_world_feed_entry(feed_source [feed_index])
		if str(entry.get("event_name", "")).strip_edges().to_lower() == "startup_seed":
			continue

		var display_key: String = MainSceneLogic._world_feed_display_dedupe_key(gs, entry)
		if display_key != "" and dedupe.has(display_key):
			continue

		var keep_as_protected: bool = MainSceneHelpers._world_feed_entry_is_desktop_world_tab_candidate(entry, current_year, min_recent_year)
		var under_regular_limit: bool = selected_entries.size() < max_entries
		if not under_regular_limit and not keep_as_protected:
			continue

		if display_key != "":
			dedupe [display_key] = true

		if keep_as_protected and int(entry.get("year", current_year)) < min_recent_year:
			protected_entries.append(entry)
		else:
			selected_entries.append(entry)

	selected_entries.append_array(protected_entries)
	selected_entries.sort_custom(func (a, b):
		var entry_a: Dictionary = a
		var entry_b: Dictionary = b
		var year_a: int = int(entry_a.get("year", current_year))
		var year_b: int = int(entry_b.get("year", current_year))
		if year_a == year_b:
			return str(entry_a.get("event_name", "")) < str(entry_b.get("event_name", ""))
		return year_a < year_b
	)

	if selected_entries.is_empty():
		_append_world_feed_colored_line("The world is quiet right now.", Color(0.88, 0.9, 0.94, 0.92))
	else:
		_render_world_feed_entries_by_year_and_section(selected_entries, current_year)

	_append_world_feed_colored_line("", Color(1.0, 1.0, 1.0, 1.0))
	_append_world_feed_colored_line("======================", Color(1.0, 0.96, 0.84, 1.0))

	world_feed_popup_feed.scroll_to_line(max(world_feed_popup_feed.get_line_count() - 1, 0))
func _build_loaded_life_diary_snapshot_lines() -> Array:
	var lines: Array = []
	if gs == null or gs.player == null:
		return lines

	var p:= gs.player
	var seen_lines: Dictionary = {}

	lines.append("Year: %s" % _format_year(gs.year))
	lines.append("Age: %d" % p.age)

	var global_memories: Array = []
	if gs.memory_engine != null:
		global_memories = gs.memory_engine.get_memories(int(p.id))

	var global_start: int = max(0, global_memories.size() - 4)
	for i in range(global_start, global_memories.size()):
		var global_text: String = str(global_memories [i])
		if _should_skip_player_diary_line(global_text):
			continue
		if MainSceneHelpers._custom_household_is_birth_leak_diary_line(global_text) and int(p.age) > 0:
			continue
		_append_unique_diary_line(lines, seen_lines, global_text)

	var player_memories: Array = []
	if p.memories != null:
		player_memories = p.memories

	var player_start: int = max(0, player_memories.size() - 4)
	for i in range(player_start, player_memories.size()):
		var player_text: String = str(player_memories [i])
		if _should_skip_player_diary_line(player_text):
			continue
		if MainSceneHelpers._custom_household_is_birth_leak_diary_line(player_text) and int(p.age) > 0:
			continue
		_append_unique_diary_line(lines, seen_lines, player_text)

	var world_start: int = max(0, gs.world_feed.size() - 18)
	for i in range(world_start, gs.world_feed.size()):
		var entry: Dictionary = gs.normalize_world_feed_entry(gs.world_feed [i])
		var diary_line: String = _diary_line_from_world_feed_entry(entry).strip_edges()

		if _should_skip_player_diary_line(diary_line):
			continue
		if MainSceneHelpers._custom_household_is_birth_leak_diary_line(diary_line) and int(p.age) > 0:
			continue
		_append_unique_diary_line(lines, seen_lines, diary_line)

	if lines.size() <= 2:
		_append_unique_diary_line(
			lines,
			seen_lines,
			"My life was already in motion when this save was reconstructed."
		)

	return lines

func _rebuild_loaded_life_diary_snapshot_if_needed() -> void:
	if gs == null or gs.player == null:
		return
	_ensure_active_life_diary_loaded(false)
	if not age_up_diary_entries.is_empty():
		return
	var lines: Array = _build_loaded_life_diary_snapshot_lines()
	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % gs.player.age,
			"I stepped back into this life with my story already in motion."
		]
	age_up_diary_entries.append(lines)
	_save_active_life_diary_state()
