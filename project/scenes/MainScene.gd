			str(actor_id),
			{}
		)
	)
	var payload_revision: String = (
		_pending_situations_payload_revision(
			payload
		)
	)
	var popup_prepainted: bool = (
		not payload.is_empty()
		and bool(
			payload.get(
				"success",
				false
			)
		)
		and int(
			payload.get(
				"actor_id",
				-1
			)
		) == actor_id
		and int(
			popup_viewer.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and str(
			popup_viewer.get_meta(
				"prepainted_payload_revision",
				""
			)
		) == payload_revision
	)

	if not popup_prepainted:
		set_meta(
			"pending_situations_click_invariant_failed",
			true
		)
		set_meta(
			"pending_situations_click_invariant_failed_actor_id",
			actor_id
		)
		set_meta(
			"pending_situations_click_engine_calls",
			false
		)
		set_meta(
			"pending_situations_click_build_on_click",
			false
		)

		EraLog.truth(
			"ERALIFE_PENDING_SITUATIONS_CLICK_INVARIANT_TRUTH"
			+ "|actor_id=" + str(actor_id)
			+ "|payload_ready="
			+ str(not payload.is_empty()).to_lower()
			+ "|popup_prepainted=false"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	popup_viewer_open = true
	popup_viewer.z_as_relative = false
	popup_viewer.z_index = 760
	popup_viewer.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	popup_viewer.visible = true
	popup_viewer.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	popup_viewer.show()

	_claim_interactive_surface_authority(
		popup_viewer,
		"pending_situations_popup_viewer:%d" % actor_id,
		"pending_situations_resident_payload_reveal",
		true,
		true
	)
	_bring_modal_to_front(
		popup_viewer
	)

	set_meta(
		"pending_situations_click_actor_id",
		actor_id
	)
	set_meta(
		"pending_situations_click_reveal_only",
		true
	)
	set_meta(
		"pending_situations_click_engine_calls",
		false
	)
	set_meta(
		"pending_situations_click_build_on_click",
		false
	)
	set_meta(
		"pending_situations_click_modal_authority_claimed",
		true
	)
	set_meta(
		"pending_situations_click_payload_count",
		int(
			payload.get(
				"count",
				0
			)
		)
	)
func _resident_property_asset_payload_for_actor(
	actor: Person,
	asset_id: int
) -> Dictionary:
	if actor == null or asset_id <= 0:
		return {}

	var pack: Dictionary = _asset_surface_pack_for_actor(
		actor
	)
	var assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"assets_surface_contract",
			{}
		)
	)

	for raw_property_row in MainSceneHelpers._safe_array(
		assets_contract.get(
			"property_asset_rows",
			[]
		)
	):
		var property_row: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_property_row
		)

		if int(
			property_row.get(
				"asset_id",
				property_row.get(
					"property_id",
					property_row.get(
						"id",
						-1
					)
				)
			)
		) != asset_id:
			continue

		var payload: Dictionary = property_row.duplicate(true)
		payload ["id"] = asset_id
		payload ["asset_id"] = asset_id
		payload ["property_id"] = asset_id
		payload ["asset_kind"] = "property"
		payload ["owner_id"] = int(
			payload.get(
				"owner_id",
				actor.id
			)
		)
		payload ["resident_asset_contract"] = true
		payload ["ui_called_property_engine"] = false
		return payload

	if (
		gs != null
		and gs.belongings_engine != null
		and gs.belongings_engine.has_method(
			"get_category_items"
		)
	):
		for category_name in [
			"Real Estate",
			"Property",
			"Properties"
		]:
			for raw_item in MainSceneHelpers._safe_array(
				gs.belongings_engine.get_category_items(
					actor,
					category_name
				)
			):
				var item: Dictionary = MainSceneHelpers._safe_dictionary(
					raw_item
				)
				var item_id: int = int(
					item.get(
						"id",
						item.get(
							"asset_id",
							item.get(
								"property_id",
								-1
							)
						)
					)
				)

				if item_id != asset_id:
					continue

				var payload: Dictionary = item.duplicate(true)
				payload ["id"] = asset_id
				payload ["asset_id"] = asset_id
				payload ["property_id"] = asset_id
				payload ["asset_kind"] = "property"
				payload ["category"] = "Real Estate"
				payload ["owner_id"] = int(
					payload.get(
						"owner_id",
						actor.id
					)
				)
				payload ["resident_asset_contract"] = true
				payload ["resolved_from_belongings_projection"] = true
				payload ["ui_called_property_engine"] = false
				return payload

	return {}

func _on_popup_viewer_contract_selected(
	contract_id: String
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	_ensure_popup_viewer()

	if (
		popup_viewer == null
		or not is_instance_valid(
			popup_viewer
		)
	):
		return

	var clean_contract_id: String = str(
		contract_id
	).strip_edges()

	if clean_contract_id == "":
		return

	var actor_id: int = (
		MainSceneLogic._pending_situations_controlled_actor_id(gs)
	)
	var list_payload: Dictionary = MainSceneHelpers._safe_dictionary(
		popup_viewer.last_list_payload
	)
	var payload_actor_id: int = int(
		list_payload.get(
			"actor_id",
			-1
		)
	)

	if payload_actor_id != actor_id:
		popup_viewer.set_meta(
			"pending_contract_select_rejected",
			true
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_id",
			clean_contract_id
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_reason",
			"payload_actor_mismatch"
		)

		EraLog.truth(
			"ERALIFE_PENDING_CONTRACT_SELECT_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|payload_actor_id=" + str(payload_actor_id)
			+ "|contract_id=" + clean_contract_id
			+ "|reason=payload_actor_mismatch"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)

		return

	var source_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		popup_viewer.active_contracts.get(
			clean_contract_id,
			{}
		)
	)

	if source_contract.is_empty():
		popup_viewer.set_meta(
			"pending_contract_select_rejected",
			true
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_id",
			clean_contract_id
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_reason",
			"resident_view_contract_missing"
		)

		if popup_viewer.footer_label != null:
			popup_viewer.footer_label.text = (
				"That pending-situation view is not resident for "
				+ "the currently controlled actor."
			)

		EraLog.truth(
			"ERALIFE_PENDING_CONTRACT_SELECT_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|contract_id=" + clean_contract_id
			+ "|reason=resident_view_contract_missing"
			+ "|runtime_lookup=false"
			+ "|view_contract_build=false"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)

		return

	var contract_actor_id: int = int(
		source_contract.get(
			"actor_id",
			source_contract.get(
				"viewer_actor_id",
				actor_id
			)
		)
	)

	if contract_actor_id != actor_id:
		popup_viewer.set_meta(
			"pending_contract_select_rejected",
			true
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_id",
			clean_contract_id
		)
		popup_viewer.set_meta(
			"pending_contract_select_rejected_reason",
			"resident_contract_actor_mismatch"
		)

		return

	var view_contract: Dictionary = (
		source_contract.duplicate(true)
	)

	# FIX: the id handed to PopupViewer.present_contract() becomes the id bound to every
	# option button, and resolution looks that id up in ScenarioRuntimeContractEngine's
	# active_popup_contracts, which is keyed by the SOURCE contract id. clean_contract_id
	# here is the per-viewer view id ("view_<source_id>_<viewer_id>"), so overwriting
	# "id" with it made every option button unresolvable and every click a silent no-op.
	view_contract [
		"view_contract_id"
	] = clean_contract_id
	view_contract [
		"id"
	] = str(
		view_contract.get(
			"source_contract_id",
			view_contract.get(
				"contract_id",
				clean_contract_id
			)
		)
	).strip_edges()
	view_contract [
		"contract_id"
	] = str(
		view_contract.get(
			"contract_id",
			clean_contract_id
		)
	)
	view_contract [
		"view_contract_id"
	] = str(
		view_contract.get(
			"view_contract_id",
			clean_contract_id
		)
	)
	view_contract [
		"era_name"
	] = str(
		view_contract.get(
			"era_name",
			MainSceneLogic._pending_situations_current_era_name(gs)
		)
	)
	view_contract [
		"surface_role"
	] = "full_pending_situation"
	view_contract [
		"view_contract"
	] = true
	view_contract [
		"actor_id"
	] = actor_id
	view_contract [
		"viewer_actor_id"
	] = actor_id
	view_contract [
		"selected_from_resident_popup_viewer"
	] = true
	view_contract [
		"click_time_runtime_lookup_required"
	] = false
	view_contract [
		"click_time_build_required"
	] = false
	view_contract [
		"ui_is_renderer_only"
	] = true

	popup_viewer.active_contracts [
		clean_contract_id
	] = view_contract.duplicate(true)

	popup_viewer.present_contract(
		view_contract
	)

	set_meta(
		"pending_situation_contract_selected_from_resident_viewer",
		true
	)
	set_meta(
		"pending_situation_contract_selected_id",
		clean_contract_id
	)
	set_meta(
		"pending_situation_contract_select_click_engine_calls",
		false
	)
	set_meta(
		"pending_situation_contract_select_build_on_click",
		false
	)
	set_meta(
		"pending_situation_contract_select_runtime_lookup",
		false
	)
	set_meta(
		"pending_situation_contract_select_view_build",
		false
	)

	EraLog.truth(
		"ERALIFE_PENDING_CONTRACT_SELECTED"
		+ "|actor_id=" + str(actor_id)
		+ "|contract_id=" + clean_contract_id
		+ "|resident_view_contract=true"
		+ "|runtime_lookup=false"
		+ "|view_contract_build=false"
		+ "|engine_calls=false"
		+ "|build_on_click=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)
func _on_popup_viewer_option_selected(contract_id: String, option_id: String) -> void:
	if gs == null or gs.player == null:
		return

	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "pending_situation_choice",
			"surface_id": "popup_viewer",
			"action_id": option_id,
			"payload": {
				"contract_id": contract_id,
				"option_id": option_id
			},
			"legacy_callback": "_on_popup_viewer_option_selected",
			"legacy_args": [
				contract_id,
				option_id
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_popup_viewer_option_selected"
			},
			"source": "mainscene.popup_viewer_option"
		}, {
			"source": "mainscene.popup_viewer_option",
			"surface_id": "popup_viewer",
			"action_id": option_id,
			"legacy_callback": "_on_popup_viewer_option_selected",
			"legacy_args": [
				contract_id,
				option_id
			]
		})
		return

	_ensure_pending_situation_engines()

	var actor_id: int = MainSceneLogic._pending_situations_controlled_actor_id(gs)

	set_meta("pending_situation_choice_authorized_by_global_intent", true)
	set_meta("pending_situation_choice_authorized_contract_id", contract_id)
	set_meta("pending_situation_choice_authorized_option_id", option_id)
	set_meta("pending_situation_choice_authorized_actor_id", actor_id)
	set_meta("pending_situation_choice_authorized_at_ms", int(Time.get_ticks_msec()))
	set_meta("pending_situation_choice_commit_body_deferred", true)
	set_meta("pending_situation_choice_sync_engine_commit_forbidden", true)
	set_meta("pending_situation_choice_sync_diary_render_forbidden", true)
	set_meta("pending_situation_choice_sync_popup_render_forbidden", true)

	call_deferred(
		"_commit_pending_situation_choice_after_global_intent_authorized",
		contract_id,
		option_id,
		actor_id
	)
func _commit_pending_situation_choice_after_global_intent_authorized(contract_id: String, option_id: String, actor_id: int) -> void:
	if gs == null or gs.player == null:
		return

	_ensure_pending_situation_engines()
	if gs.pending_situations_engine == null:
		return

	var clean_actor_id: int = int(actor_id)
	if clean_actor_id <= 0:
		clean_actor_id = MainSceneLogic._pending_situations_controlled_actor_id(gs)

	var result: Dictionary = gs.pending_situations_engine.resolve_pending_contract(contract_id, option_id, {
		"source": "popup_viewer_deferred_commit_body",
		"target_id": clean_actor_id,
		"viewer_actor_id": clean_actor_id,
		"perspective_actor_id": clean_actor_id,
		"committed_by_global_intent": true,
		"global_intent_authorized_deferred_commit": true,
		"diary_log_is_derived_from_commit": true
	})

	result ["committed_by_global_intent"] = true
	result ["pending_situation_choice_committed"] = true
	result ["global_intent_authorized_deferred_commit"] = true
	result ["diary_log_is_derived_from_commit"] = true
	result ["ui_result_lens_deferred"] = true

	set_meta("pending_situation_choice_committed_visual_lens_deferred", true)
	set_meta("pending_situation_choice_committed_at_ms", int(Time.get_ticks_msec()))
	set_meta("pending_situation_choice_sync_diary_render_forbidden", true)
	set_meta("pending_situation_choice_sync_popup_render_forbidden", true)

	call_deferred(
		"_finalize_pending_situation_choice_result_lens",
		result.duplicate(true),
		clean_actor_id,
		contract_id
	)
func _finalize_pending_situation_choice_result_lens(result: Dictionary, actor_id: int, contract_id: String = "") -> void:
	if typeof(result) != TYPE_DICTIONARY:
		return

	var clean_actor_id: int = int(actor_id)
	if clean_actor_id <= 0:
		clean_actor_id = MainSceneLogic._pending_situations_controlled_actor_id(gs)

	var active_actor_diary_logged: bool = _apply_pending_situation_diary_records(result, clean_actor_id)

	var committed_result_text: String = MainSceneLogic._pending_situation_result_diary_text_from_result(result)
	if committed_result_text != "":
		_append_pending_situation_diary_line_for_actor(
			clean_actor_id,
			committed_result_text,
			"pending_situation_result_committed_text"
		)
		active_actor_diary_logged = true

	_apply_pending_situation_bank_report_to_player_stats_overlay(result, clean_actor_id)

	call_deferred("_update_pending_situations_button")
	call_deferred("_render_life_diary_panel")
	call_deferred("_scroll_life_diary_to_bottom")
	call_deferred("_update_player_stats_overlay")

	var popup_text: String = str(result.get("popup_text", "")).strip_edges()
	if popup_text == "":
		popup_text = str(result.get("text", "")).strip_edges()
	if popup_text == "":
		popup_text = committed_result_text

	# FIX: a failed resolution used to produce an empty popup_text, which skipped the
	# popup branch entirely and made the click look like nothing happened at all.
	# Never let a failure be invisible.
	if popup_text == "" and not bool(result.get("success", false)):
		var failure_reason: String = str(result.get("reason", "unknown")).strip_edges()
		push_warning(
			"Pending situation resolution failed: contract_id=%s requested=%s reason=%s"
			% [
				str(contract_id),
				str(result.get("requested_contract_id", contract_id)),
				failure_reason
			]
		)
		result ["popup_title"] = "Situation Could Not Resolve"
		popup_text = "That choice could not be applied right now. (%s)" % failure_reason

	if popup_text != "":
		result ["popup_text"] = popup_text
		result ["force_immediate_popup"] = true
		result ["pending_situation_result_popup"] = true
		result ["popup_should_restore_pending_situation_viewer"] = true
		result ["pending_situation_restore_actor_id"] = clean_actor_id
		result ["action_result_popup_must_have_modal_authority"] = true
		result ["diary_log_is_derived_from_commit"] = true

		_queue_pending_situation_viewer_restore_after_action_result(clean_actor_id, contract_id)
		_suspend_pending_situation_viewer_for_action_result()
		call_deferred("_maybe_show_action_result_popup", result.duplicate(true))
	else:
		_restore_pending_situation_viewer_after_action_result_if_needed()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["pending_situation_result_lens_finalized"] = true
		gs.scenario_state ["pending_situation_result_lens_actor_id"] = clean_actor_id
		gs.scenario_state ["pending_situation_result_lens_diary_logged"] = active_actor_diary_logged
		gs.scenario_state ["pending_situation_result_lens_finalized_at_ms"] = int(Time.get_ticks_msec())
func _on_popup_viewer_closed() -> void:
	popup_viewer_open = false
	_update_pending_situations_button()
func _play_dragonball_scatter_animation(packet: Dictionary) -> void:
	if typeof(packet) != TYPE_DICTIONARY:
		return

	_clear_dragonball_scatter_animation_layer()

	dragonball_scatter_animation_layer = Control.new()
	dragonball_scatter_animation_layer.name = "DragonBallScatterAnimationLayer"
	dragonball_scatter_animation_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	dragonball_scatter_animation_layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	dragonball_scatter_animation_layer.z_as_relative = false
	dragonball_scatter_animation_layer.z_index = 2000
	add_child(dragonball_scatter_animation_layer)

	var start_rect: Rect2 = _dragonball_animation_start_rect()
	var start_position: Vector2 = start_rect.get_center()
	var viewport_size: Vector2 = get_viewport_rect().size
	var stars: Array = packet.get("stars", [1, 2, 3, 4, 5, 6, 7])
	var total: int = max(1, stars.size())
	var index: int = 0

	for raw_star in stars:
		var star: int = int(raw_star)
		var orb:= Label.new()
		orb.text = MainSceneHelpers._dragonball_scatter_icon(star)
		orb.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		orb.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		orb.mouse_filter = Control.MOUSE_FILTER_IGNORE
		orb.add_theme_font_size_override("font_size", 34)
		orb.add_theme_color_override("font_color", Color(1.0, 0.72, 0.18, 1.0))
		orb.add_theme_color_override("font_shadow_color", Color(0.16, 0.04, 0.0, 0.75))
		orb.add_theme_constant_override("shadow_offset_x", 0)
		orb.add_theme_constant_override("shadow_offset_y", 2)
		orb.position = start_position - Vector2(22, 22)
		orb.size = Vector2(48, 48)
		orb.scale = Vector2(0.72, 0.72)
		dragonball_scatter_animation_layer.add_child(orb)

		var angle: float = (TAU / float(total)) * float(index) - PI * 0.5
		var gather_position: Vector2 = start_position + Vector2(cos(angle), sin(angle)) * (58.0 + float(index % 2) * 14.0)
		var travel: float = max(viewport_size.x, viewport_size.y) * 1.08
		var end_position: Vector2 = start_position + Vector2(cos(angle), sin(angle)) * travel
		end_position.x = clamp(end_position.x, -120.0, viewport_size.x + 120.0)
		end_position.y = clamp(end_position.y, -120.0, viewport_size.y + 120.0)

		var gather_tween:= create_tween()
		gather_tween.tween_interval(float(index) * 0.055)
		gather_tween.parallel().tween_property(orb, "position", gather_position - Vector2(22, 22), 0.46).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		gather_tween.parallel().tween_property(orb, "scale", Vector2(1.16, 1.16), 0.46).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

		var scatter_tween:= create_tween()
		scatter_tween.tween_interval(0.58 + float(index) * 0.075)
		scatter_tween.parallel().tween_property(orb, "position", end_position, 2.05 + float(index) * 0.065).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		scatter_tween.parallel().tween_property(orb, "scale", Vector2(0.16, 0.16), 1.86 + float(index) * 0.045).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		scatter_tween.parallel().tween_property(orb, "modulate:a", 0.0, 1.95 + float(index) * 0.045).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
		scatter_tween.finished.connect(func () -> void:
			if is_instance_valid(orb):
				orb.queue_free()
		)

		index += 1

	var deferred_runtime_payload: Dictionary = {}
	var deferred_runtime_raw: Variant = packet.get("deferred_runtime_payload", {})
	if typeof(deferred_runtime_raw) == TYPE_DICTIONARY:
		deferred_runtime_payload = (deferred_runtime_raw as Dictionary).duplicate(true)

	if not deferred_runtime_payload.is_empty():
		set_meta("__dragonball_scatter_runtime_pending", true)
		call_deferred("_queue_deferred_dragonball_scatter_runtime_after_visual_commit", deferred_runtime_payload)

	var toast_result:= {
		"success": true,
		"popup_title": str(packet.get("popup_title", "Dragon Balls Scattered")),
		"popup_text": str(packet.get("popup_text", "The Dragon Balls scattered back across the world.")),
		"popup_footer": str(packet.get("popup_footer", "They are no longer in your belongings. They can be found again."))
	}

	await get_tree().create_timer(float(packet.get("duration_seconds", 2.65))).timeout

	_clear_dragonball_scatter_animation_layer()

	if not bool(packet.get("suppress_toast", false)):
		_maybe_show_action_result_popup(toast_result)
func _queue_deferred_dragonball_scatter_runtime_after_visual_commit(payload: Dictionary = {}) -> void:
	if typeof(payload) != TYPE_DICTIONARY or payload.is_empty():
		return

	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(2.4).timeout

	call_deferred("_apply_deferred_dragonball_scatter_runtime_after_visual_takeoff", payload)


func _apply_deferred_dragonball_scatter_runtime_after_visual_takeoff(payload: Dictionary = {}) -> void:
	if typeof(payload) != TYPE_DICTIONARY or payload.is_empty():
		set_meta("__dragonball_scatter_runtime_pending", false)
		return

	if gs == null or not "dragonballs_engine" in gs or gs.dragonballs_engine == null:
		set_meta("__dragonball_scatter_runtime_pending", false)
		return

	if not gs.dragonballs_engine.has_method("finalize_deferred_dragonball_scatter"):
		set_meta("__dragonball_scatter_runtime_pending", false)
		return

	var scatter_report: Dictionary = gs.dragonballs_engine.finalize_deferred_dragonball_scatter(payload)
	set_meta("__dragonball_scatter_runtime_pending", false)

	if scatter_report.is_empty():
		return

	belongings_hud_content_dirty = true
	set_meta("__belongings_hud_animation_pause_until_ms", int(Time.get_ticks_msec()) + 260)
	call_deferred("_update_belongings_hud")
func _play_dragonball_arrival_animation(packet: Dictionary) -> void:
	if typeof(packet) != TYPE_DICTIONARY:
		return

	_clear_dragonball_scatter_animation_layer()

	dragonball_scatter_animation_layer = Control.new()
	dragonball_scatter_animation_layer.name = "DragonBallArrivalAnimationLayer"
	dragonball_scatter_animation_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	dragonball_scatter_animation_layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	dragonball_scatter_animation_layer.z_as_relative = false
	dragonball_scatter_animation_layer.z_index = 2001
	add_child(dragonball_scatter_animation_layer)

	var viewport_size: Vector2 = get_viewport_rect().size
	var start_rect: Rect2 = _dragonball_animation_start_rect()
	var target_position: Vector2 = start_rect.get_center()
	var stars: Array = packet.get("stars", [1, 2, 3, 4, 5, 6, 7])
	var total: int = max(1, stars.size())
	var index: int = 0

	for raw_star in stars:
		var star: int = int(raw_star)
		var orb:= Label.new()
		orb.text = MainSceneHelpers._dragonball_scatter_icon(star)
		orb.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		orb.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		orb.mouse_filter = Control.MOUSE_FILTER_IGNORE
		orb.add_theme_font_size_override("font_size", 34)
		orb.add_theme_color_override("font_color", Color(1.0, 0.74, 0.22, 1.0))
		orb.add_theme_color_override("font_shadow_color", Color(0.18, 0.04, 0.0, 0.82))
		orb.add_theme_constant_override("shadow_offset_x", 0)
		orb.add_theme_constant_override("shadow_offset_y", 2)
		orb.size = Vector2(48, 48)
		orb.scale = Vector2(0.38, 0.38)
		orb.modulate.a = 0.0

		var angle: float = (TAU / float(total)) * float(index) - PI * 0.5
		var edge_start: Vector2 = Vector2(
			viewport_size.x * 0.5 + cos(angle) * viewport_size.x * 0.72,
			viewport_size.y * 0.5 + sin(angle) * viewport_size.y * 0.72
		)
		var gather_position: Vector2 = target_position + Vector2(cos(angle), sin(angle)) * (52.0 + float(index % 2) * 18.0)
		orb.position = edge_start - Vector2(24, 24)
		dragonball_scatter_animation_layer.add_child(orb)

		var tween:= create_tween()
		tween.tween_interval(float(index) * 0.055)
		tween.parallel().tween_property(orb, "modulate:a", 1.0, 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.parallel().tween_property(orb, "position", gather_position - Vector2(24, 24), 1.18).set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_OUT)
		tween.parallel().tween_property(orb, "scale", Vector2(1.18, 1.18), 1.18).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tween.tween_interval(0.26)
		tween.parallel().tween_property(orb, "position", target_position - Vector2(24, 24), 0.44).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		tween.parallel().tween_property(orb, "scale", Vector2(0.68, 0.68), 0.44).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		tween.parallel().tween_property(orb, "modulate:a", 0.0, 0.44).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
		tween.finished.connect(func () -> void:
			if is_instance_valid(orb):
				orb.queue_free()
		)

		index += 1

	await get_tree().create_timer(float(packet.get("duration_seconds", 2.25))).timeout
	_clear_dragonball_scatter_animation_layer()
func _dragonball_animation_start_rect() -> Rect2:
	if belongings_hud_button != null and is_instance_valid(belongings_hud_button):
		return belongings_hud_button.get_global_rect()
	if belongings_item_popup != null and is_instance_valid(belongings_item_popup):
		return belongings_item_popup.get_global_rect()
	return Rect2(get_viewport_rect().size * 0.5, Vector2.ZERO)
func _clear_dragonball_scatter_animation_layer() -> void:
	if dragonball_scatter_animation_layer != null and is_instance_valid(dragonball_scatter_animation_layer):
		dragonball_scatter_animation_layer.queue_free()
	dragonball_scatter_animation_layer = null
