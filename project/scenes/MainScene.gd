func _god_mode_should_show_royal_approval_slider() -> bool:
	var social_class_picker:= _social_class_picker()
	if social_class_picker == null or social_class_picker.item_count <= 0:
		return false

	var selected_text: String = MainSceneHelpers._normalize_social_class_picker_value(
		social_class_picker.get_item_text(social_class_picker.get_selected_id())
	)

	return selected_text == "Royal" and _country_or_era_supports_royal_picker_mode()


func _refresh_god_mode_royal_approval_slider_visibility(animated: bool = true) -> void:
	if custom_approval_slider == null:
		return

	var should_show: bool = _god_mode_should_show_royal_approval_slider()
	var row_key:= "approval"
	var was_visible: bool = false

	if god_mode_start_panel != null and god_mode_start_panel.has_meta("god_mode_row_" + row_key):
		var row_raw: Variant = god_mode_start_panel.get_meta("god_mode_row_" + row_key)
		if row_raw is Control:
			was_visible = (row_raw as Control).visible

	_set_god_mode_labeled_row_visible(row_key, should_show)

	if should_show:
		custom_approval_slider.custom_minimum_size = Vector2(0, 28)
		custom_approval_slider.set_meta("god_mode_stat_key", "approval")
		_style_god_mode_slider(custom_approval_slider, custom_approval_value_label)
		MainSceneHelpers._sync_single_stat_value_label(custom_approval_slider, custom_approval_value_label)

		if animated and not was_visible:
			var target_value: float = clamp(float(custom_approval_slider.value), 0.0, 100.0)
			custom_approval_slider.set_meta("god_mode_intro_animating", true)
			custom_approval_slider.value = 0.0
			MainSceneHelpers._sync_single_stat_value_label(custom_approval_slider, custom_approval_value_label)
			_apply_god_mode_slider_visual_state(custom_approval_slider, custom_approval_value_label, "intro")

			var tween:= create_tween()
			tween.set_trans(Tween.TRANS_CUBIC)
			tween.set_ease(Tween.EASE_OUT)
			tween.tween_property(custom_approval_slider, "value", target_value, 0.42)
			tween.tween_interval(0.04)
			tween.tween_callback(
				Callable(self, "_finish_god_mode_slider_intro").bind(custom_approval_slider, custom_approval_value_label)
			)


func _play_god_mode_slider_intro() -> void:
	var slider_pairs: Array = [
		{ "slider": custom_happiness_slider, "label": custom_happiness_value_label, "delay": 0.0},
		{ "slider": custom_health_spin, "label": custom_health_value_label, "delay": 0.03},
		{ "slider": custom_smarts_spin, "label": custom_smarts_value_label, "delay": 0.06},
		{ "slider": custom_looks_spin, "label": custom_looks_value_label, "delay": 0.09},
		{ "slider": custom_mental_health_spin, "label": custom_mental_health_value_label, "delay": 0.12},
		{ "slider": custom_fertility_spin, "label": custom_fertility_value_label, "delay": 0.15}
	]

	for entry in slider_pairs:
		var slider: HSlider = entry.get("slider", null)
		var value_label: Label = entry.get("label", null)
		if slider == null or value_label == null:
			continue

		var target_value:= float(slider.value)
		slider.set_meta("god_mode_intro_animating", true)
		slider.value = 0
		MainSceneHelpers._sync_single_stat_value_label(slider, value_label)
		_apply_god_mode_slider_visual_state(slider, value_label, "intro")

		var tween:= create_tween()
		tween.set_trans(Tween.TRANS_CUBIC)
		tween.set_ease(Tween.EASE_OUT)
		tween.tween_interval(float(entry.get("delay", 0.0)))
		tween.tween_callback(
			Callable(self, "_apply_god_mode_slider_visual_state").bind(slider, value_label, "active")
		)
		tween.tween_property(slider, "value", target_value, 0.42)
		tween.tween_interval(0.04)
		tween.tween_callback(Callable(self, "_finish_god_mode_slider_intro").bind(slider, value_label))
func _make_stat_slider_control(slider: HSlider, value_label: Label, stat_key: String = "") -> HBoxContainer:
	var row:= HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_theme_constant_override("separation", 12)

	var slider_shell:= Control.new()
	slider_shell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	slider_shell.custom_minimum_size = Vector2(
		0,
		max(36.0, slider.custom_minimum_size.y)
	)
	slider_shell.clip_contents = true
	slider_shell.mouse_filter = Control.MOUSE_FILTER_PASS
	row.add_child(slider_shell)

	slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	slider.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	slider.set_meta("god_mode_stat_key", stat_key.to_lower())
	slider_shell.add_child(slider)

	var slider_streak:= Panel.new()
	slider_streak.name = "GodModeSliderStreak"
	slider_streak.mouse_filter = Control.MOUSE_FILTER_IGNORE
	slider_streak.z_index = 4
	slider_streak.anchor_top = 0.5
	slider_streak.anchor_bottom = 0.5
	slider_streak.offset_left = -72
	slider_streak.offset_right = -20
	slider_streak.offset_top = -6
	slider_streak.offset_bottom = 6
	slider_streak.self_modulate = Color(1.0, 1.0, 1.0, 0.0)
	slider_shell.add_child(slider_streak)

	slider.set_meta("god_mode_slider_shell", slider_shell)
	slider.set_meta("god_mode_slider_streak", slider_streak)

	MainSceneHelpers._style_god_mode_value_label(value_label)
	row.add_child(value_label)
	_style_god_mode_slider(slider, value_label)

	slider.value_changed.connect(_on_stat_slider_value_changed.bind(slider, value_label))
	slider.mouse_entered.connect(_on_god_mode_slider_mouse_entered.bind(slider, value_label))
	slider.mouse_exited.connect(_on_god_mode_slider_mouse_exited.bind(slider, value_label))
	return row

func _refresh_god_mode_stat_slider_palette_if_needed(force: bool = false) -> void:
	var palette_signature:= _current_god_mode_palette_signature()
	var slider_pairs: Array = _god_mode_slider_pairs()

	for entry in slider_pairs:
		var slider: HSlider = entry.get("slider", null)
		var value_label: Label = entry.get("label", null)
		if slider == null:
			continue

		var last_signature:= ""
		if slider.has_meta("god_mode_palette_signature"):
			last_signature = str(slider.get_meta("god_mode_palette_signature"))

		if not force and last_signature == palette_signature:
			continue

		slider.set_meta("god_mode_palette_signature", palette_signature)

		var next_state:= "idle"
		var intro_animating:= false
		if slider.has_meta("god_mode_intro_animating"):
			intro_animating = bool(slider.get_meta("god_mode_intro_animating"))

		var hovered:= false
		if slider.has_meta("god_mode_hovered"):
			hovered = bool(slider.get_meta("god_mode_hovered"))

		var emotion_profile: Dictionary = {}
		if slider.has_meta("god_mode_emotion_profile"):
			var emotion_raw: Variant = slider.get_meta("god_mode_emotion_profile")
			if typeof(emotion_raw) == TYPE_DICTIONARY:
				emotion_profile = emotion_raw

		if intro_animating:
			next_state = "intro"
		elif hovered:
			next_state = "hover"
		elif not emotion_profile.is_empty():
			next_state = "active"

		_apply_god_mode_slider_visual_state(slider, value_label, next_state)
func _refresh_stat_slider_value_labels() -> void:
	MainSceneHelpers._sync_single_stat_value_label(custom_happiness_slider, custom_happiness_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_health_spin, custom_health_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_smarts_spin, custom_smarts_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_looks_spin, custom_looks_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_mental_health_spin, custom_mental_health_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_fertility_spin, custom_fertility_value_label)
	MainSceneHelpers._sync_single_stat_value_label(custom_approval_slider, custom_approval_value_label)
	_refresh_god_mode_stat_slider_palette_if_needed(false)
	_refresh_god_mode_royal_approval_slider_visibility(false)

func _on_stat_slider_value_changed(_value: float, slider: HSlider, value_label: Label) -> void:
	MainSceneHelpers._sync_single_stat_value_label(slider, value_label)
	if slider == null:
		return

	var last_value:= float(slider.value)
	if slider.has_meta("god_mode_last_value"):
		last_value = float(slider.get_meta("god_mode_last_value"))

	var delta:= float(slider.value) - last_value
	slider.set_meta("god_mode_last_value", float(slider.value))

	var intro_animating:= false
	if slider.has_meta("god_mode_intro_animating"):
		intro_animating = bool(slider.get_meta("god_mode_intro_animating"))

	if intro_animating or is_zero_approx(delta):
		MainSceneHelpers._clear_god_mode_slider_emotion_profile(slider)
	else:
		slider.set_meta(
			"god_mode_emotion_profile",
			_get_god_mode_slider_emotion_profile(slider, delta)
		)

	_apply_god_mode_slider_visual_state(slider, value_label, "active")
	_queue_god_mode_slider_settle(slider, value_label)

func _animate_god_mode_slider_streaks() -> void:
	if god_mode_start_panel == null:
		return

	var breathing: Dictionary = _build_god_mode_breathing_profile()
	var width_ratio: float = clamp(float(breathing.get("slider_streak_width_ratio", 0.16)), 0.08, 0.34)
	var base_alpha: float = clamp(float(breathing.get("slider_streak_alpha", 0.08)), 0.02, 0.22)
	var phase_normalized: float = fposmod(god_mode_presentation_slider_streak_phase / (PI * 2.0), 1.0)
	var slider_pairs: Array = _god_mode_slider_pairs()

	for i in range(slider_pairs.size()):
		var entry: Dictionary = slider_pairs [i]
		var slider: HSlider = entry.get("slider", null)
		if slider == null or not is_instance_valid(slider):
			continue

		var shell: Control = null
		if slider.has_meta("god_mode_slider_shell"):
			var shell_raw: Variant = slider.get_meta("god_mode_slider_shell")
			if shell_raw is Control:
				shell = shell_raw
		if shell == null or not is_instance_valid(shell):
			continue
		if shell.size.x <= 0.0:
			continue

		var streak: Panel = null
		if slider.has_meta("god_mode_slider_streak"):
			var streak_raw: Variant = slider.get_meta("god_mode_slider_streak")
			if streak_raw is Panel:
				streak = streak_raw
		if streak == null or not is_instance_valid(streak):
			continue

		var stat_palette: Dictionary = MainSceneHelpers._get_god_mode_slider_palette(slider)
		var stat_core: Color = Color(stat_palette.get("core", Color(0.86, 0.54, 1.0, 1.0)))
		var stat_glow: Color = Color(stat_palette.get("glow", Color(0.62, 0.28, 0.9, 0.24)))

		var hovered: bool = bool(slider.get_meta("god_mode_hovered", false))
		var emotion_strength: float = 0.0
		if slider.has_meta("god_mode_emotion_profile"):
			var emotion_raw: Variant = slider.get_meta("god_mode_emotion_profile")
			if typeof(emotion_raw) == TYPE_DICTIONARY:
				emotion_strength = clamp(float((emotion_raw as Dictionary).get("strength", 0.0)), 0.0, 1.0)

		var local_progress: float = fposmod(phase_normalized + (float(i) * 0.17), 1.0)
		var streak_width: float = max(42.0, shell.size.x * width_ratio)
		var left_x: float = lerp(- streak_width, shell.size.x, local_progress)
		var half_height: float = clamp(shell.size.y * 0.18, 5.0, 8.0)

		streak.offset_left = left_x
		streak.offset_right = left_x + streak_width
		streak.offset_top = - half_height
		streak.offset_bottom = half_height

		var shimmer_wave: float = 0.5 + (0.5 * sin(god_mode_presentation_slider_streak_phase + (float(i) * 0.85)))
		var streak_alpha: float = base_alpha + (0.04 * shimmer_wave)
		if hovered:
			streak_alpha += 0.02
		streak_alpha += 0.05 * emotion_strength
		streak_alpha = clamp(streak_alpha, 0.02, 0.24)

		var fill_color: Color = Color(1.0, 1.0, 1.0, streak_alpha).lerp(
			stat_core.lightened(0.18),
			0.34
		)
		var border_color: Color = Color(stat_glow.r, stat_glow.g, stat_glow.b, min(streak_alpha + 0.05, 0.28))
		var shadow_color: Color = Color(stat_glow.r, stat_glow.g, stat_glow.b, min(streak_alpha + 0.1, 0.3))

		streak.add_theme_stylebox_override(
			"panel",
			MainSceneHelpers._build_god_mode_slider_streak_style(fill_color, border_color, shadow_color)
		)
		streak.self_modulate = Color(1.0, 1.0, 1.0, 1.0)
func _style_god_mode_slider(slider: HSlider, value_label: Label) -> void:
	if slider == null:
		return
	slider.set_meta("god_mode_hovered", false)
	slider.set_meta("god_mode_intro_animating", false)
	slider.set_meta("god_mode_slider_settle_tween", null)
	slider.set_meta("god_mode_slider_visual_tween", null)
	slider.set_meta("god_mode_last_value", float(slider.value))
	slider.set_meta("god_mode_emotion_profile", {})
	if value_label != null:
		value_label.set_meta("god_mode_slider_label_tween", null)
	_apply_god_mode_slider_visual_state(slider, value_label, "idle")

func _on_god_mode_slider_mouse_entered(slider: HSlider, value_label: Label) -> void:
	if slider == null:
		return
	slider.set_meta("god_mode_hovered", true)
	_apply_god_mode_slider_visual_state(slider, value_label, "hover")

func _on_god_mode_slider_mouse_exited(slider: HSlider, value_label: Label) -> void:
	if slider == null:
		return
	slider.set_meta("god_mode_hovered", false)
	_queue_god_mode_slider_settle(slider, value_label)

func _queue_god_mode_slider_settle(slider: HSlider, value_label: Label) -> void:
	if slider == null:
		return

	var settle_tween: Tween = null
	if slider.has_meta("god_mode_slider_settle_tween"):
		var existing_settle_tween = slider.get_meta("god_mode_slider_settle_tween")
		if existing_settle_tween is Tween:
			settle_tween = existing_settle_tween

	if settle_tween != null:
		settle_tween.kill()

	settle_tween = create_tween()
	slider.set_meta("god_mode_slider_settle_tween", settle_tween)
	settle_tween.tween_interval(0.16)
	settle_tween.tween_callback(Callable(self, "_settle_god_mode_slider").bind(slider, value_label))

func _settle_god_mode_slider(slider: HSlider, value_label: Label) -> void:
	if slider == null:
		return
	var intro_animating:= false
	if slider.has_meta("god_mode_intro_animating"):
		intro_animating = bool(slider.get_meta("god_mode_intro_animating"))
	if intro_animating:
		return

	MainSceneHelpers._clear_god_mode_slider_emotion_profile(slider)

	var hovered:= false
	if slider.has_meta("god_mode_hovered"):
		hovered = bool(slider.get_meta("god_mode_hovered"))
	var next_state:= "hover" if hovered else "idle"
	_apply_god_mode_slider_visual_state(slider, value_label, next_state)
func _get_god_mode_slider_emotion_profile(slider: HSlider, delta: float) -> Dictionary:
