func _build_era_country_surface_realm(country_name: String, era_key: String) -> Dictionary:
	var clean_country: String = str(country_name).strip_edges()
	if clean_country == "":
		clean_country = "Unknown Country"

	var clean_era: String = str(era_key).strip_edges()
	if clean_era == "":
		clean_era = _selected_era_key()

	var identity_key: String = MainSceneHelpers._other_country_identity_key("%s:%s" % [clean_era, clean_country])
	var realm_id: int = _other_country_surface_realm_id_for_country(clean_country, clean_era)
	var hash_value: int = abs(int(("%s:%d" % [identity_key, realm_id]).hash()))
	var era_lower: String = clean_era.to_lower()

	var population_floor: int = 18000000
	var population_span: int = 220000000
	var treasury_multiplier: int = 2200
	var military_basis_points: int = 850

	match era_lower:
		"ancient":
			population_floor = 900000
			population_span = 64000000
			treasury_multiplier = 180
			military_basis_points = 520
		"medieval":
			population_floor = 2400000
			population_span = 118000000
			treasury_multiplier = 420
			military_basis_points = 680
		"industrial":
			population_floor = 12000000
			population_span = 460000000
			treasury_multiplier = 1350
			military_basis_points = 760
		"modern":
			population_floor = 26000000
			population_span = 1450000000
			treasury_multiplier = 2600
			military_basis_points = 820
		"future":
			population_floor = 60000000
			population_span = 3800000000
			treasury_multiplier = 5400
			military_basis_points = 940

	var population: int = population_floor + int(hash_value % max(1, population_span))
	var prosperity: int = 42 + int(floor(float(hash_value) / 17.0)) % 55
	var stability: int = 38 + int(floor(float(hash_value) / 31.0)) % 58
	var loyalty: int = 35 + int(floor(float(hash_value) / 47.0)) % 60
	var treasury: int = max(1, int(round(float(population) * float(treasury_multiplier) * float(max(1, prosperity)) / 50.0)))
	var military_units: int = max(1, int(round(float(population) * (float(military_basis_points) / 10000.0))))
	var goods_stockpile: int = max(1, int(round(float(population) * (0.18 + (float(prosperity) / 520.0)))))

	return {
		"id": realm_id,
		"realm_id": realm_id,
		"name": clean_country,
		"realm_type": "country",
		"country": clean_country,
		"era": clean_era,
		"government_style": "State",
		"population": population,
		"treasury": treasury,
		"military_units": military_units,
		"military_stockpile": military_units,
		"goods_stockpile": goods_stockpile,
		"loyalty": loyalty,
		"prosperity": prosperity,
		"stability": stability,
		"land_label": "Era territory",
		"ruler_id": -1,
		"ruler_npc_id": -1,
		"ruler_name": "",
		"leader_name": "",
		"surface_ruler_key": "country:%s" % identity_key,
		"surface_ruler_office": MainSceneHelpers._era_country_ruler_surface_label(clean_country, clean_era, hash_value),
		"realm_browser_section": "standard_realms",
		"is_country_surface": true,
		"surface_stats_source": "era_country_surface_projection"
	}
func _other_country_surface_realm_id_for_country(country_name: String, era_key: String) -> int:
	var clean_country: String = str(country_name).strip_edges()
	var clean_era: String = str(era_key).strip_edges()
	if clean_country == "":
		clean_country = "Unknown Country"
	if clean_era == "":
		clean_era = _selected_era_key()

	if gs != null and gs.realm_engine != null and "realms" in gs.realm_engine and typeof(gs.realm_engine.realms) == TYPE_DICTIONARY:
		var wanted_key: String = MainSceneHelpers._other_country_identity_key(clean_country)
		for raw_realm_id in gs.realm_engine.realms.keys():
			var realm_raw: Variant = gs.realm_engine.realms.get(raw_realm_id, {})
			if typeof(realm_raw) != TYPE_DICTIONARY:
				continue

			var realm: Dictionary = realm_raw
			var realm_name_key: String = MainSceneHelpers._other_country_identity_key(str(realm.get("name", "")))
			var realm_country_key: String = MainSceneHelpers._other_country_identity_key(str(realm.get("country", "")))
			if wanted_key != "" and (wanted_key == realm_name_key or wanted_key == realm_country_key):
				return int(raw_realm_id)

	if gs == null:
		return 900000000 + abs(int(("%s:%s" % [clean_era, clean_country]).hash())) % 90000000

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var world_nonce: int = int(gs.scenario_state.get("world_surface_realm_id_nonce", 0))
	if world_nonce <= 0:
		world_nonce = int(Time.get_ticks_usec() % 90000000) + 100000
		gs.scenario_state ["world_surface_realm_id_nonce"] = world_nonce

	var map_raw: Variant = gs.scenario_state.get("other_country_surface_realm_ids_by_key", {})
	var id_map: Dictionary = map_raw if typeof(map_raw) == TYPE_DICTIONARY else {}

	var used_raw: Variant = gs.scenario_state.get("other_country_surface_realm_ids_used", {})
	var used: Dictionary = used_raw if typeof(used_raw) == TYPE_DICTIONARY else {}

	var key: String = MainSceneHelpers._other_country_identity_key("%s:%s" % [clean_era, clean_country])
	if id_map.has(key):
		return int(id_map.get(key, 0))

	var candidate_id: int = 900000000 + abs(int(("%s:%d" % [key, world_nonce]).hash())) % 90000000
	while used.has(str(candidate_id)):
		candidate_id += 1

	id_map [key] = candidate_id
	used [str(candidate_id)] = true

	gs.scenario_state ["other_country_surface_realm_ids_by_key"] = id_map
	gs.scenario_state ["other_country_surface_realm_ids_used"] = used

	return candidate_id
func _other_country_elemental_defense_profile(entry: Dictionary, realm: Dictionary) -> Dictionary:
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var realm_name: String = str(realm.get("name", realm.get("country", entry.get("name", "")))).strip_edges()
	var _lower_name: String = realm_name.to_lower()

	match native_element:
		"air":
			return {
				"defensive_type": "Evasive",
				"typical_personalities": "Spiritual / Non violent",
				"military_label_override": "0, but Everyone if provoked",
				"formal_military_units": 0,
				"military_suffix": ""
			}
		"earth":
			return {
				"defensive_type": "Fortified / Attrition",
				"typical_personalities": "Stubborn / Loyal / Grounded",
				"military_label_override": "",
				"formal_military_units": -1,
				"military_suffix": "large but decentralized"
			}
		"fire":
			return {
				"defensive_type": "Aggressive / Imperial",
				"typical_personalities": "Ambitious / Disciplined / Honor-driven",
				"military_label_override": "",
				"formal_military_units": -1,
				"military_suffix": "centralized imperial force"
			}
		"water":
			return {
				"defensive_type": "Adaptive / Defensive",
				"typical_personalities": "Communal / Resilient / Protective",
				"military_label_override": "",
				"formal_military_units": -1,
				"military_suffix": "tribal defense mobilization"
			}

	return {
		"defensive_type": "Adaptive",
		"typical_personalities": "Element-bound / Culturally rooted",
		"military_label_override": "",
		"formal_military_units": -1,
		"military_suffix": ""
	}

func _other_country_elemental_military_label(entry: Dictionary, realm: Dictionary) -> String:
	var profile: Dictionary = _other_country_elemental_defense_profile(entry, realm)
	var label_override: String = str(profile.get("military_label_override", "")).strip_edges()
	if label_override != "":
		return label_override

	var military_value: float = float(realm.get("military_stockpile", realm.get("military_units", 0)))
	var base_label: String = _crown_compact_number(military_value)
	var suffix: String = str(profile.get("military_suffix", "")).strip_edges()
	if suffix != "":
		return "%s, %s" % [base_label, suffix]
	return base_label


func _hydrate_other_country_browser_entry_surface_stats(entry: Dictionary, _source_hint: String = "") -> Dictionary:
	if typeof(entry) != TYPE_DICTIONARY or entry.is_empty():
		return {}

	var hydrated: Dictionary = entry.duplicate(true)
	var realm_raw: Variant = hydrated.get("realm", {})
	if typeof(realm_raw) != TYPE_DICTIONARY:
		return hydrated

	var realm: Dictionary = (realm_raw as Dictionary).duplicate(true)
	var entry_kind: String = str(hydrated.get("entry_kind", "")).strip_edges().to_lower()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges().to_lower()
	var native_element: String = _other_country_resolve_native_element(hydrated, realm)
	var is_elemental_realm: bool = bool(realm.get("elemental_realm", false)) or native_element in ["air", "water", "earth", "fire"]
	var is_country_surface: bool = entry_kind == "country" or realm_type == "country" or bool(realm.get("is_country_surface", false))

	if not is_elemental_realm and not is_country_surface:
		hydrated ["realm"] = realm
		return hydrated

	if is_country_surface:
		var country_name: String = str(realm.get("country", hydrated.get("name", realm.get("name", "")))).strip_edges()
		var era_key: String = str(realm.get("era", "")).strip_edges()
		if era_key == "":
			era_key = _selected_era_key()

		if int(realm.get("population", 0)) <= 1 and int(realm.get("treasury", 0)) <= 0 and int(realm.get("military_units", 0)) <= 0:
			realm = _build_era_country_surface_realm(country_name, era_key)
		else:
			if int(realm.get("military_stockpile", 0)) <= 0:
				realm ["military_stockpile"] = int(realm.get("military_units", 0))
			if str(realm.get("ruler_id", "")).strip_edges() in ["", "-1", "0"]:
				realm ["ruler_id"] = -1
				realm ["ruler_npc_id"] = -1
				realm ["ruler_name"] = ""
				realm ["leader_name"] = ""
				realm ["surface_ruler_key"] = "country:%s" % MainSceneHelpers._other_country_identity_key("%s:%s" % [era_key, country_name])
				realm ["surface_ruler_office"] = MainSceneHelpers._era_country_ruler_surface_label(country_name, era_key, abs(int(MainSceneHelpers._other_country_identity_key("%s:%s" % [era_key, country_name]).hash())))
				realm = _other_country_ensure_surface_governance_projection(realm)

	if is_elemental_realm:
		var element_key: String = native_element
		if element_key == "":
			element_key = "elemental"

		var identity_key_elemental: String = MainSceneHelpers._other_country_identity_key("%s:%s:%s" % [
			str(hydrated.get("entry_id", "")),
			str(hydrated.get("name", realm.get("name", ""))),
			element_key
		])
		var hash_value: int = abs(int(identity_key_elemental.hash()))

		var population_floor: int = 52000000
		var population_span: int = 260000000
		var treasury_multiplier: int = 1800
		var military_ratio: float = 0.075
		var defense_profile: Dictionary = _other_country_elemental_defense_profile(hydrated, realm)

		match element_key:
			"earth":
				population_floor = 420000000
				population_span = 1200000000
				treasury_multiplier = 2400
				military_ratio = 0.105
			"fire":
				population_floor = 210000000
				population_span = 740000000
				treasury_multiplier = 2900
				military_ratio = 0.118
			"water":
				population_floor = 86000000
				population_span = 360000000
				treasury_multiplier = 1700
				military_ratio = 0.082
			"air":
				population_floor = 18000000
				population_span = 94000000
				treasury_multiplier = 1300
				military_ratio = 0.0

		if int(realm.get("population", 0)) <= 1:
			realm ["population"] = population_floor + int(hash_value % max(1, population_span))
		if int(realm.get("treasury", 0)) <= 0:
			realm ["treasury"] = int(realm.get("population", 1)) * treasury_multiplier

		var formal_military_units: int = int(defense_profile.get("formal_military_units", -1))
		if formal_military_units >= 0:
			realm ["military_units"] = formal_military_units
			realm ["military_stockpile"] = formal_military_units
		elif int(realm.get("military_units", 0)) <= 0 and int(realm.get("military_stockpile", 0)) <= 0:
			realm ["military_units"] = max(1, int(round(float(realm.get("population", 1)) * military_ratio)))
			realm ["military_stockpile"] = int(realm ["military_units"])
		elif int(realm.get("military_stockpile", 0)) <= 0:
			realm ["military_stockpile"] = int(realm.get("military_units", 0))

		realm ["defensive_type"] = str(defense_profile.get("defensive_type", "Adaptive"))
		realm ["typical_personalities"] = str(defense_profile.get("typical_personalities", "Element-bound / Culturally rooted"))
		realm ["military_display_label"] = _other_country_elemental_military_label(hydrated, realm)
		if str(realm.get("ruler_id", "")).strip_edges() in ["", "-1", "0"]:
			realm ["ruler_id"] = -1
			realm ["ruler_npc_id"] = -1
			realm ["ruler_name"] = ""
			realm ["leader_name"] = ""
			realm ["surface_ruler_key"] = "elemental:%s" % identity_key_elemental
			realm ["surface_ruler_office"] = MainSceneHelpers._elemental_realm_ruler_surface_label(element_key)

		realm ["native_element"] = element_key
		realm ["elemental_realm"] = true
		realm ["realm_browser_section"] = "elemental_realms"
		var elemental_origin_name: String = MainSceneLogic._other_country_elemental_surface_origin_name(realm, hydrated)
		if elemental_origin_name != "":
			realm ["ruler_origin_city"] = elemental_origin_name
		realm ["surface_stats_source"] = "elemental_realm_surface_projection"
		realm = _other_country_ensure_surface_governance_projection(realm)

	hydrated ["realm"] = realm
	return hydrated
func _normalize_other_country_browser_entry(entry: Dictionary, source_hint: String = "") -> Dictionary:
	if typeof(entry) != TYPE_DICTIONARY or entry.is_empty():
		return {}

	if gs != null and gs.realm_contract_engine != null and gs.realm_contract_engine.has_method("normalize_surface_entry"):
		var normalized_raw: Variant = gs.realm_contract_engine.normalize_surface_entry(entry, source_hint)
		if typeof(normalized_raw) == TYPE_DICTIONARY and not (normalized_raw as Dictionary).is_empty():
			return _hydrate_other_country_browser_entry_surface_stats((normalized_raw as Dictionary).duplicate(true), source_hint)

	return _hydrate_other_country_browser_entry_surface_stats(entry.duplicate(true), source_hint)

func _other_country_entry_contract(entry: Dictionary, realm: Dictionary = {}) -> Dictionary:
	var entry_contract_raw: Variant = entry.get("realm_contract", {})
	if typeof(entry_contract_raw) == TYPE_DICTIONARY and not (entry_contract_raw as Dictionary).is_empty():
		return entry_contract_raw

	var realm_contract_raw: Variant = realm.get("realm_contract", {})
	if typeof(realm_contract_raw) == TYPE_DICTIONARY and not (realm_contract_raw as Dictionary).is_empty():
		return realm_contract_raw

	return {}

func _other_country_entry_browser_section(entry: Dictionary, realm: Dictionary = {}) -> String:
	var contract: Dictionary = _other_country_entry_contract(entry, realm)
	var section: String = str(contract.get("browser_section", realm.get("realm_browser_section", ""))).strip_edges().to_lower()
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var entry_kind: String = str(entry.get("entry_kind", "")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges().to_lower()
	var browser_visual_theme: String = str(realm.get("browser_visual_theme", "")).strip_edges().to_lower()
	var overview_visual_theme: String = str(realm.get("overview_visual_theme", "")).strip_edges().to_lower()
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var is_elemental_surface: bool = bool(realm.get("elemental_realm", false)) or native_element in ["air", "water", "earth", "fire"] or browser_visual_theme.begins_with("elemental_") or overview_visual_theme.begins_with("elemental_")

	if entry_id == "era_kingdom" or section == "interrealm_authority":
		return "interrealm_authority"
	if section == "space_realms" or entry_kind == "space_realm" or browser_visual_theme in ["vormir", "nidavellir"] or overview_visual_theme in ["vormir", "nidavellir"]:
		return "space_realms"
	if section == "imaginative_realms" or entry_kind == "imaginative_realm" or realm_type == "imagination_bound" or browser_visual_theme == "terabithia" or overview_visual_theme == "terabithia":
		return "imaginative_realms"
	if section == "elemental_realms" or is_elemental_surface:
		return "elemental_realms"
	if section != "" and section not in ["standard_realms", "ordinary_realms", "ordinary", "country", "countries"]:
		return section
	return "standard_realms"
func _build_other_country_browser_entries() -> Array:
	var out: Array = []
	if gs == null or gs.player == null:
		return out

	var allow_elemental_surfaces: bool = MainSceneLogic._other_country_browser_allows_elemental_surfaces(gs)
	var allow_many_realms_surfaces: bool = MainSceneLogic._other_country_browser_allows_many_realms_surfaces(gs)
	var seen_entries: Dictionary = {}

	var era_key: String = ""
	if gs.era != null:
		era_key = str(gs.era.name).strip_edges()
	if era_key == "" and typeof(gs.custom_settings) == TYPE_DICTIONARY:
		era_key = str(gs.custom_settings.get("era", "")).strip_edges()
	if era_key == "":
		era_key = _selected_era_key()

	if gs.era_engine != null and gs.era_engine.has_method("get_countries_for_era"):
		var country_names: Array = gs.era_engine.get_countries_for_era(era_key)
		for raw_country_name in country_names:
			var country_name: String = str(raw_country_name).strip_edges()
			if country_name == "":
				continue

			var country_key: String = MainSceneHelpers._other_country_identity_key(country_name)
			var country_realm: Dictionary = _build_era_country_surface_realm(country_name, era_key)

			var country_entry: Dictionary = _normalize_other_country_browser_entry({
				"entry_kind": "country",
				"entry_id": "country:%s" % country_key,
				"name": country_name,
				"realm": country_realm,
				"_sort_priority": 40
			}, "era_engine")

			MainSceneLogic._append_other_country_browser_entry_unique(out, seen_entries, country_entry)
	if gs.realm_engine != null:
		if gs.realm_engine.realms.is_empty() and gs.realm_engine.has_method("bootstrap_realms_for_era"):
			gs.realm_engine.bootstrap_realms_for_era()

		for raw_realm_id in gs.realm_engine.realms.keys():
			var realm_id: int = int(raw_realm_id)
			var realm: Dictionary = MainSceneLogic._resolve_surface_realm_dict(gs, raw_realm_id)
			if realm.is_empty():
				continue

			var entry_name: String = str(realm.get("name", "Realm")).strip_edges()
			var raw_entry:= {
				"entry_kind": "realm",
				"entry_id": str(realm_id),
				"name": entry_name,
				"realm_id": realm_id,
				"realm": realm.duplicate(true),
				"_sort_priority": 10
			}

			var entry: Dictionary = _normalize_other_country_browser_entry(raw_entry, "realm_engine")
			if entry.is_empty():
				continue

			var normalized_realm_raw: Variant = entry.get("realm", realm)
			var normalized_realm: Dictionary = normalized_realm_raw if typeof(normalized_realm_raw) == TYPE_DICTIONARY else realm
			var browser_section: String = _other_country_entry_browser_section(entry, normalized_realm)

			if browser_section == "elemental_realms":
				if not allow_elemental_surfaces:
					continue
				entry ["_sort_priority"] = int(entry.get("_sort_priority", 6))

			MainSceneLogic._append_other_country_browser_entry_unique(out, seen_entries, entry)

	if allow_many_realms_surfaces:
		for raw_hidden_entry in _build_surface_hidden_realm_entries():
			if typeof(raw_hidden_entry) != TYPE_DICTIONARY:
				continue
			var hidden_entry: Dictionary = _normalize_other_country_browser_entry(raw_hidden_entry as Dictionary, "many_realms_engine")
			if not hidden_entry.is_empty():
				MainSceneLogic._append_other_country_browser_entry_unique(out, seen_entries, hidden_entry)

	if gs.bridge_to_terabithia_engine != null and gs.bridge_to_terabithia_engine.has_method("get_surface_entry_for_player"):
		var terabithia_entry_raw: Variant = gs.bridge_to_terabithia_engine.get_surface_entry_for_player()
		if typeof(terabithia_entry_raw) == TYPE_DICTIONARY and not (terabithia_entry_raw as Dictionary).is_empty():
			var terabithia_entry: Dictionary = _normalize_other_country_browser_entry(terabithia_entry_raw as Dictionary, "bridge_to_terabithia_engine")
			if not terabithia_entry.is_empty():
				MainSceneLogic._append_other_country_browser_entry_unique(
					out,
					seen_entries,
					terabithia_entry
			)

	if gs.vormir_engine != null and gs.vormir_engine.has_method("get_surface_entry_for_player"):
		var vormir_entry_raw: Variant = gs.vormir_engine.get_surface_entry_for_player()
		if typeof(vormir_entry_raw) == TYPE_DICTIONARY and not (vormir_entry_raw as Dictionary).is_empty():
			var vormir_entry: Dictionary = _normalize_other_country_browser_entry(vormir_entry_raw as Dictionary, "vormir_engine")
			if not vormir_entry.is_empty():
				MainSceneLogic._append_other_country_browser_entry_unique(
					out,
					seen_entries,
					vormir_entry
			)


	if gs.nidavellir_engine != null and gs.nidavellir_engine.has_method("get_surface_entry_for_player"):
		var nidavellir_entry_raw: Variant = gs.nidavellir_engine.get_surface_entry_for_player()
		if typeof(nidavellir_entry_raw) == TYPE_DICTIONARY and not (nidavellir_entry_raw as Dictionary).is_empty():
			var nidavellir_entry: Dictionary = _normalize_other_country_browser_entry(nidavellir_entry_raw as Dictionary, "nidavellir_engine")
			if not nidavellir_entry.is_empty():
				MainSceneLogic._append_other_country_browser_entry_unique(
					out,
					seen_entries,
					nidavellir_entry
			)

	if gs.realm_contract_engine != null and gs.realm_contract_engine.has_method("get_external_surface_entries"):
		for raw_external_entry in gs.realm_contract_engine.get_external_surface_entries():
			if typeof(raw_external_entry) != TYPE_DICTIONARY:
				continue
			var external_entry: Dictionary = _normalize_other_country_browser_entry(raw_external_entry as Dictionary, "external_json_pack")
			if not external_entry.is_empty():
				MainSceneLogic._append_other_country_browser_entry_unique(
					out,
					seen_entries,
					external_entry
			)
	out.sort_custom(func (a, b):
		var pa: int = int((a as Dictionary).get("_sort_priority", 99))
		var pb: int = int((b as Dictionary).get("_sort_priority", 99))
		if pa == pb:
			return str((a as Dictionary).get("name", "")) < str((b as Dictionary).get("name", ""))
		return pa < pb
	)

	return out
func _append_other_country_browser_row(parent: VBoxContainer, entry: Dictionary) -> void:
	var realm: Dictionary = entry.get("realm", {})
	var entry_kind: String = str(entry.get("entry_kind", "realm"))
	var entry_name: String = str(entry.get("name", "Country / Realm"))
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges()
	var browser_visual_theme: String = str(realm.get("browser_visual_theme", "")).strip_edges().to_lower()
	var overview_visual_theme: String = str(realm.get("overview_visual_theme", "")).strip_edges().to_lower()
	var special_card_kind: String = str(realm.get("special_card_kind", "")).strip_edges().to_lower()
	var is_era_kingdom: bool = entry_id == "era_kingdom"
	var is_imaginative_realm: bool = entry_kind == "imaginative_realm" or realm_type == "imagination_bound"
	var is_terabithia: bool = entry_id == "terabithia" or browser_visual_theme == "terabithia" or overview_visual_theme == "terabithia"
	var is_vormir: bool = entry_id == "vormir" or browser_visual_theme == "vormir" or overview_visual_theme == "vormir"
	var is_nidavellir: bool = entry_id == "nidavellir" or browser_visual_theme == "nidavellir" or overview_visual_theme == "nidavellir" or special_card_kind == "nidavellir"
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var is_elemental_realm: bool = native_element in ["air", "water", "earth", "fire"]
	var elemental_palette: Dictionary = MainSceneHelpers._build_other_country_elemental_palette(native_element) if is_elemental_realm else {}
	var ordinary_era_palette: Dictionary = _build_other_country_ordinary_era_palette()
	var player_presence: Dictionary = MainSceneLogic._other_country_player_presence(gs, entry, realm)
	var is_player_current_place: bool = bool(player_presence.get("is_current_place", false))

	var terabithia_imagination_ratio: float = 0.0
	var terabithia_aura_bg_alpha: float = 0.2
	var terabithia_aura_shadow_alpha: float = 0.5
	var terabithia_aura_shadow_size: int = 46
	var terabithia_pulse_low: Color = Color(1.08, 1.04, 1.16, 1.0)
	var terabithia_pulse_high: Color = Color(1.18, 1.12, 1.26, 1.0)
	var terabithia_hover_high: Color = Color(1.2, 1.14, 1.28, 1.0)
	if is_terabithia:
		var raw_ratio: Variant = realm.get("imagination_ratio", -1.0)
		if float(raw_ratio) >= 0.0:
			terabithia_imagination_ratio = clampf(float(raw_ratio), 0.0, 1.0)
		elif gs != null and gs.player != null:
			terabithia_imagination_ratio = clampf(
				float(gs.player.imagination) / 100.0,
				0.0,
				1.0
			)

		terabithia_aura_bg_alpha = clampf(
			float(realm.get(
				"browser_aura_bg_alpha",
				lerpf(0.08, 0.28, terabithia_imagination_ratio)
			)),
			0.08,
			0.32
		)
		terabithia_aura_shadow_alpha = clampf(
			float(realm.get(
				"browser_aura_shadow_alpha",
				lerpf(0.18, 0.58, terabithia_imagination_ratio)
			)),
			0.18,
			0.64
		)
		terabithia_aura_shadow_size = max(
			24,
			int(round(float(realm.get(
				"browser_aura_shadow_size",
				28.0 + (terabithia_imagination_ratio * 24.0)
			))))
		)

		var pulse_low_variant: Variant = realm.get("browser_aura_pulse_low", null)
		if pulse_low_variant is Color:
			terabithia_pulse_low = pulse_low_variant
		else:
			terabithia_pulse_low = Color(
				1.02 + (terabithia_imagination_ratio * 0.08),
				1.01 + (terabithia_imagination_ratio * 0.05),
				1.08 + (terabithia_imagination_ratio * 0.1),
				1.0
			)

		var pulse_high_variant: Variant = realm.get("browser_aura_pulse_high", null)
		if pulse_high_variant is Color:
			terabithia_pulse_high = pulse_high_variant
		else:
			terabithia_pulse_high = Color(
				1.08 + (terabithia_imagination_ratio * 0.16),
				1.04 + (terabithia_imagination_ratio * 0.1),
				1.16 + (terabithia_imagination_ratio * 0.14),
				1.0
			)

		terabithia_hover_high = Color(
			terabithia_pulse_high.r + 0.02,
			terabithia_pulse_high.g + 0.02,
			terabithia_pulse_high.b + 0.02,
			1.0
		)

	var nidavellir_gate_ratio: float = 0.0
	var nidavellir_aura_bg_alpha: float = 0.42
	var nidavellir_aura_shadow_alpha: float = 0.94
	var nidavellir_aura_shadow_size: int = 74
	var nidavellir_pulse_low: Color = Color(1.08, 0.82, 0.68, 1.0)
	var nidavellir_pulse_high: Color = Color(1.2, 0.9, 0.78, 1.0)
	var nidavellir_hover_high: Color = Color(1.24, 0.96, 0.86, 1.0)
	var nidavellir_title_bg: Color = Color(0.94, 0.56, 0.4, 0.99)
	var nidavellir_title_border: Color = Color(1.0, 0.9, 0.78, 1.0)
	var nidavellir_title_shadow: Color = Color(1.0, 0.74, 0.48, 0.72)
	var nidavellir_title_hover_bg: Color = Color(1.0, 0.64, 0.46, 1.0)
	var nidavellir_title_hover_border: Color = Color(1.0, 0.96, 0.86, 1.0)
	var nidavellir_title_hover_shadow: Color = Color(1.0, 0.84, 0.6, 0.88)
	var nidavellir_action_bg: Color = nidavellir_title_bg
	var nidavellir_action_border: Color = nidavellir_title_border
	var nidavellir_action_shadow: Color = nidavellir_title_shadow
	var nidavellir_action_hover_bg: Color = nidavellir_title_hover_bg
	var nidavellir_action_hover_border: Color = nidavellir_title_hover_border
	var nidavellir_action_hover_shadow: Color = nidavellir_title_hover_shadow
	var nidavellir_card_title: String = str(realm.get("browser_card_title", "NIDAVELLIR • STAR FORGE")).strip_edges()
	if nidavellir_card_title == "":
		nidavellir_card_title = "NIDAVELLIR • STAR FORGE"

	if is_nidavellir:
		var base_gate_ratio: float = clampf(float(int(realm.get("stone_gate_count", 0))) / 6.0, 0.0, 1.0)
		if bool(realm.get("gauntlet_ready", false)):
			base_gate_ratio += 0.12
		if bool(realm.get("mjolnir_responsive", false)):
			base_gate_ratio += 0.06
		if bool(realm.get("stormbreaker_bifrost_ready", false)):
			base_gate_ratio += 0.06
		nidavellir_gate_ratio = clampf(base_gate_ratio, 0.0, 1.0)
		nidavellir_aura_bg_alpha = clampf(
			float(realm.get(
				"browser_aura_bg_alpha",
				lerpf(0.32, 0.54, nidavellir_gate_ratio)
			)),
			0.3,
			0.62
		)
		nidavellir_aura_shadow_alpha = clampf(
			float(realm.get(
				"browser_aura_shadow_alpha",
				lerpf(0.68, 0.98, nidavellir_gate_ratio)
			)),
			0.6,
			1.0
		)
		nidavellir_aura_shadow_size = max(
			60,
			int(round(float(realm.get(
				"browser_aura_shadow_size",
				64.0 + (nidavellir_gate_ratio * 22.0)
			))))
		)
		var nidavellir_pulse_low_variant: Variant = realm.get("browser_aura_pulse_low", null)
		if nidavellir_pulse_low_variant is Color:
			nidavellir_pulse_low = nidavellir_pulse_low_variant
		else:
			nidavellir_pulse_low = Color(
				1.0,
				0.7 + (nidavellir_gate_ratio * 0.12),
				0.54 + (nidavellir_gate_ratio * 0.12),
				1.0
			)
		var nidavellir_pulse_high_variant: Variant = realm.get("browser_aura_pulse_high", null)
		if nidavellir_pulse_high_variant is Color:
			nidavellir_pulse_high = nidavellir_pulse_high_variant
		else:
			nidavellir_pulse_high = Color(
				1.0,
				0.82 + (nidavellir_gate_ratio * 0.1),
				0.68 + (nidavellir_gate_ratio * 0.12),
				1.0
			)
		nidavellir_hover_high = Color(
			1.0,
			0.9 + (nidavellir_gate_ratio * 0.06),
			0.78 + (nidavellir_gate_ratio * 0.08),
			1.0
		)

	var ruler_name: String = _resolve_other_country_ruler_name(realm)
	var treasury_summary_value: String = _crown_compact_number(float(realm.get("treasury", 0)))
	if bool(realm.get("build_budget_infinite", false)):
		treasury_summary_value = "∞"

	var card: PanelContainer = null
	var aura_shell: PanelContainer = null
	var use_aura_shell: bool = is_era_kingdom or is_vormir or is_nidavellir or is_imaginative_realm or is_elemental_realm or is_player_current_place
	if use_aura_shell:
		aura_shell = PanelContainer.new()
		aura_shell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		aura_shell.custom_minimum_size = Vector2(0, 258) if is_nidavellir else (Vector2(0, 246) if is_vormir else (Vector2(0, 240) if is_era_kingdom else Vector2(0, 232)))
		aura_shell.mouse_filter = Control.MOUSE_FILTER_PASS
		aura_shell.set_meta("other_country_entry_id", entry_id)
		parent.add_child(aura_shell)

		var aura_style:= StyleBoxFlat.new()
		if is_nidavellir:
			aura_style.bg_color = Color(0.34, 0.16, 0.1, nidavellir_aura_bg_alpha)
			aura_style.border_color = Color(1.0, 0.84, 0.68, 0.99)
			aura_style.shadow_color = Color(1.0, 0.66, 0.4, nidavellir_aura_shadow_alpha)
			aura_style.shadow_size = nidavellir_aura_shadow_size
		elif is_vormir:
			aura_style.bg_color = Color(0.035, 0.015, 0.055, 0.72)
			aura_style.border_color = Color(0.62, 0.22, 0.92, 0.92)
			aura_style.shadow_color = Color(0.4, 0.08, 0.82, 0.62)
			aura_style.shadow_size = 52
		elif is_era_kingdom:
			aura_style.bg_color = Color(0.58, 0.28, 0.86, 0.1)
			aura_style.border_color = Color(0.99, 0.84, 0.32, 0.74)
			aura_style.shadow_color = Color(0.98, 0.74, 0.2, 0.32)
			aura_style.shadow_size = 38
		elif is_elemental_realm:
			aura_style.bg_color = elemental_palette.get("aura_bg", Color(0.1, 0.12, 0.18, 0.2))
			aura_style.border_color = elemental_palette.get("aura_border", Color(0.82, 0.86, 0.94, 0.6))
			aura_style.shadow_color = elemental_palette.get("aura_shadow", Color(0.2, 0.24, 0.34, 0.28))
			aura_style.shadow_size = 34
		elif is_terabithia:
			aura_style.bg_color = Color(0.36, 0.28, 0.58, terabithia_aura_bg_alpha)
			aura_style.border_color = Color(
				0.92 + (terabithia_imagination_ratio * 0.08),
				0.88 + (terabithia_imagination_ratio * 0.1),
				1.0,
				0.74 + (terabithia_imagination_ratio * 0.22)
			)
			aura_style.shadow_color = Color(
				0.72 + (terabithia_imagination_ratio * 0.18),
				0.62 + (terabithia_imagination_ratio * 0.18),
				1.0,
				terabithia_aura_shadow_alpha
			)
			aura_style.shadow_size = terabithia_aura_shadow_size
		else:
			aura_style.bg_color = Color(0.1, 0.07, 0.18, 0.46)
			aura_style.border_color = Color(0.56, 0.82, 1.0, 0.52)
			aura_style.shadow_color = Color(0.36, 0.2, 0.78, 0.32)
			aura_style.shadow_size = 34

		if is_player_current_place:
			aura_style.bg_color = aura_style.bg_color.lerp(Color(0.28, 0.22, 0.08, 0.54), 0.44)
			aura_style.border_color = Color(1.0, 0.9, 0.34, 0.96)
			aura_style.shadow_color = Color(1.0, 0.76, 0.22, 0.42)
			aura_style.shadow_size = max(aura_style.shadow_size, 42)

		aura_style.border_width_left = 2
		aura_style.border_width_top = 2
		aura_style.border_width_right = 2
		aura_style.border_width_bottom = 2
		aura_style.corner_radius_top_left = 28
		aura_style.corner_radius_top_right = 28
		aura_style.corner_radius_bottom_left = 28
		aura_style.corner_radius_bottom_right = 28
