	panel.border_width_top = 1
	panel.border_width_right = 1
	panel.border_width_bottom = 1
	panel.border_color = Color(popup_border.r, popup_border.g, popup_border.b, max(popup_border.a, 0.62))
	panel.corner_radius_top_left = 14
	panel.corner_radius_top_right = 14
	panel.corner_radius_bottom_right = 14
	panel.corner_radius_bottom_left = 14
	panel.content_margin_left = 8
	panel.content_margin_top = 8
	panel.content_margin_right = 8
	panel.content_margin_bottom = 8
	panel.shadow_color = Color(popup_shadow.r, popup_shadow.g, popup_shadow.b, max(popup_shadow.a, 0.3))
	panel.shadow_size = 18
	panel.shadow_offset = Vector2(0, 4)
	popup.add_theme_stylebox_override("panel", panel)

	var hover:= StyleBoxFlat.new()
	hover.bg_color = Color(popup_hover_bg.r, popup_hover_bg.g, popup_hover_bg.b, clamp(max(popup_hover_bg.a, panel_hover.a), 0.94, 0.99))
	hover.border_width_left = 1
	hover.border_width_top = 1
	hover.border_width_right = 1
	hover.border_width_bottom = 1
