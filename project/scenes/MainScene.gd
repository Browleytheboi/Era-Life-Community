func _age_up_truth_probe_reset(entry_point: String = "unknown") -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var run_id: String = "%d_%d" % [now_ms, int(randi_range(1000, 9999))]

	set_meta("age_up_truth_probe_active", true)
	set_meta("age_up_truth_probe_run_id", run_id)
	set_meta("age_up_truth_probe_started_ms", now_ms)
	set_meta("age_up_truth_probe_last_mark_ms", now_ms)
	set_meta("age_up_truth_probe_disable_live_diagnostics", true)
	set_meta("age_up_truth_probe_disable_live_diagnostics_until_ms", now_ms + 120000)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_truth_probe_log"] = []
		gs.scenario_state ["age_up_truth_probe_disable_auto_patcher"] = true
		gs.scenario_state ["age_up_truth_probe_disable_live_patch_guard"] = true
		gs.scenario_state ["age_up_truth_probe_started_ms"] = now_ms
		gs.scenario_state ["age_up_truth_probe_run_id"] = run_id
		gs.scenario_state ["runtime_guard"] = {}

	_age_up_truth_probe_mark("probe_reset", {
		"entry_point": entry_point,
	})


func _age_up_truth_probe_mark(
	stage: String,
	extra: Dictionary = {}
) -> void:
	if not bool(
		get_meta(
			"age_up_truth_probe_active",
			false
		)
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	var started_ms: int = int(
		get_meta(
			"age_up_truth_probe_started_ms",
			now_ms
		)
	)

	var last_ms: int = int(
		get_meta(
			"age_up_truth_probe_last_mark_ms",
			now_ms
		)
	)

	set_meta(
		"age_up_truth_probe_last_mark_ms",
		now_ms
	)

	var loading: Dictionary = {}
	var guard: Dictionary = {}
	var pending_deferred_count: int = -1
	var year_in_progress: bool = false
	var bundle_built: bool = false
	var warm_plan_available: bool = false
	var speculative_cache_ready: bool = false

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var loading_raw: Variant = (
			gs.scenario_state.get(
				"loading_runtime",
				{}
			)
		)

		loading = (
			loading_raw
			if typeof(
				loading_raw
			) == TYPE_DICTIONARY
			else {}
		)

		var guard_raw: Variant = (
			gs.scenario_state.get(
				"runtime_guard",
				{}
			)
		)

		guard = (
			guard_raw
			if typeof(
				guard_raw
			) == TYPE_DICTIONARY
			else {}
		)

		year_in_progress = bool(
			gs.scenario_state.get(
				"year_in_progress",
				false
			)
		)

		bundle_built = bool(
			gs.scenario_state.get(
				"bundle_built",
				false
			)
		)

		var warm_raw: Variant = (
			gs.scenario_state.get(
				"warm_runtime_plan",
				{}
			)
		)

		var warm_plan: Dictionary = (
			warm_raw
			if typeof(
				warm_raw
			) == TYPE_DICTIONARY
			else {}
		)

		warm_plan_available = (
			not warm_plan.is_empty()
		)

		var speculative_raw: Variant = (
			gs.scenario_state.get(
				"speculative_next_year_cache",
				{}
			)
		)

		var speculative_cache: Dictionary = (
			speculative_raw
			if typeof(
				speculative_raw
			) == TYPE_DICTIONARY
			else {}
		)

		speculative_cache_ready = bool(
			speculative_cache.get(
				"ready",
				false
			)
		)

	if (
		gs != null
		and gs.event_bus != null
		and gs.event_bus.has_method(
			"get_pending_deferred_delivery_count"
		)
	):
		pending_deferred_count = int(
			gs.event_bus.get_pending_deferred_delivery_count()
		)

	var verbose_probe: bool = bool(
		get_meta(
			"age_up_truth_probe_verbose",
			false
		)
	)

	var packet: Dictionary = {
		"run_id": str(
			get_meta(
				"age_up_truth_probe_run_id",
				""
			)
		),
		"stage": stage,
		"elapsed_ms": now_ms - started_ms,
		"since_last_ms": now_ms - last_ms,
		"game_year": (
			int(
				gs.year
			)
			if gs != null
			else -1
		),
		"player_age": (
			int(
				gs.player.age
			)
			if (
				gs != null
				and gs.player != null
			)
			else -1
		),
		"loading_active": age_up_loading_runtime_active,
		"loading_phase": str(
			loading.get(
				"current_phase",
				""
			)
		),
		"loading_stage": str(
			loading.get(
				"session_stage",
				""
			)
		),
		"completion_state": str(
			loading.get(
				"completion_state",
				""
			)
		),
		"year_in_progress": year_in_progress,
		"bundle_built": bundle_built,
		"pending_deferred": pending_deferred_count,
		"runtime_guard_keys": guard.keys(),
		"warm_plan_available": warm_plan_available,
		"speculative_cache_ready": speculative_cache_ready,
		"extra": extra.duplicate(false)
	}

	if verbose_probe:
		packet [
			"runtime_guard"
		] = guard.duplicate(false)

		var phase_overflow_raw: Variant = (
			gs.scenario_state.get(
				"age_up_runtime_phase_overflow_log",
				[]
			)
			if (
				gs != null
				and typeof(
					gs.scenario_state
				) == TYPE_DICTIONARY
			)
			else []
		)

		packet [
			"phase_overflow_count"
		] = (
			phase_overflow_raw.size()
			if typeof(
				phase_overflow_raw
			) == TYPE_ARRAY
			else 0
		)

		var phase_budget_raw: Variant = (
			gs.scenario_state.get(
				"runtime_phase_budget_report",
				{}
			)
			if (
				gs != null
				and typeof(
					gs.scenario_state
				) == TYPE_DICTIONARY
			)
			else {}
		)

		packet [
			"contract_phase_budget_present"
		] = (
			typeof(
				phase_budget_raw
			) == TYPE_DICTIONARY
			and not (
				phase_budget_raw as Dictionary
			).is_empty()
		)

	EraLog.truth(
		"AGEUP_TRUTH|",
		packet
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var probe_log_raw: Variant = (
			gs.scenario_state.get(
				"age_up_truth_probe_log",
				[]
			)
		)

		var probe_log: Array = (
			probe_log_raw
			if typeof(
				probe_log_raw
			) == TYPE_ARRAY
			else []
		)

		probe_log.append(
			packet.duplicate(false)
		)

		while probe_log.size() > 96:
			probe_log.pop_front()

		gs.scenario_state [
			"age_up_truth_probe_log"
		] = probe_log


func _age_up_truth_probe_mark_throttled(stage: String, extra: Dictionary = {}, interval_ms: int = 250) -> void:
	if not bool(get_meta("age_up_truth_probe_active", false)):
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var key: String = "age_up_truth_probe_throttle_%s_ms" % stage
	var next_ms: int = int(get_meta(key, 0))
	if now_ms < next_ms:
		return

	set_meta(key, now_ms + max(1, interval_ms))
	_age_up_truth_probe_mark(stage, extra)


func _age_up_truth_probe_finish(reason: String = "finished") -> void:
	if not bool(get_meta("age_up_truth_probe_active", false)):
		return

	_age_up_truth_probe_mark("probe_finish", {
		"reason": reason
	})

	set_meta("age_up_truth_probe_active", false)
	set_meta("age_up_truth_probe_disable_live_diagnostics", false)
	set_meta("age_up_truth_probe_disable_live_diagnostics_until_ms", 0)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_truth_probe_disable_auto_patcher"] = false
		gs.scenario_state ["age_up_truth_probe_disable_live_patch_guard"] = false
func _run_age_up_loading_overlay_exclusive_frame(delta: float) -> bool:
	if not age_up_loading_runtime_active:
		return false

	if _playable_life_shell_loading_overlay_forbidden_now("age_up_overlay_exclusive_frame"):
		_clear_illegal_playable_shell_loading_blockers("age_up_overlay_exclusive_frame_blocked_by_playable_shell")
		return false

	var playable_shell_has_control: bool = _playable_life_shell_pointer_motion_is_visual_only()

	var loading_context_raw: Variant = get_meta("age_up_loading_deferred_begin_context", {})
	var loading_context: Dictionary = loading_context_raw if typeof(loading_context_raw) == TYPE_DICTIONARY else {}

	var legal_age_up_runtime: bool = \
bool(get_meta("visible_age_up_runtime_from_button", false)) \
and bool(get_meta("age_up_transition_busy", false)) \
and (
			bool(loading_context.get("visible_age_up_runtime_from_button", false))
or bool(loading_context.get("age_up_button_user_initiated", false))
		)

	var actual_age_up_active: bool = legal_age_up_runtime \
or age_up_loading_finish_requested \
or (not age_up_loading_result.is_empty() and legal_age_up_runtime)

	if playable_shell_has_control and not actual_age_up_active:
		_clear_illegal_playable_shell_loading_blockers("stale_loading_overlay_after_playable_shell")
		return false

	_age_up_truth_probe_mark_throttled("exclusive_frame_enter", {
		"delta": delta
	}, 500)

	_consume_deferred_age_up_loading_begin_refresh()
	_drive_age_up_loading_runtime(delta)

	if _live_diagnostics_opening_frame_quarantine_active():
		var remaining_hold: int = int(get_meta("live_diagnostics_opening_quarantine_frames", 0))
		if remaining_hold > 0:
			set_meta("live_diagnostics_opening_quarantine_frames", remaining_hold - 1)

		if live_diagnostics_force_frames > 0:
			var deferred_force_frames: int = int(get_meta("live_diagnostics_deferred_force_frames", 0))
			if live_diagnostics_force_frames > deferred_force_frames:
				set_meta("live_diagnostics_deferred_force_frames", live_diagnostics_force_frames)

			_age_up_truth_probe_mark_throttled("live_diagnostics_force_frames_deferred", {
				"force_frames": live_diagnostics_force_frames,
				"remaining_hold": remaining_hold
			}, 500)
			live_diagnostics_force_frames = 0

		return true

	if live_diagnostics_force_frames > 0:
		var deferred_force_frames: int = int(get_meta("live_diagnostics_deferred_force_frames", 0))
		if live_diagnostics_force_frames > deferred_force_frames:
			set_meta("live_diagnostics_deferred_force_frames", live_diagnostics_force_frames)

		_age_up_truth_probe_mark_throttled("live_diagnostics_force_frames_zeroed", {
			"force_frames": live_diagnostics_force_frames
		}, 500)
		live_diagnostics_force_frames = 0

	return true
func _live_diagnostics_post_overlay_restore_gate_active() -> bool:
	var hold_frames: int = int(get_meta("live_diagnostics_post_overlay_restore_frames", 0))
	if hold_frames > 0:
		set_meta("live_diagnostics_post_overlay_restore_frames", hold_frames - 1)
		return true

	var restore_until_ms: int = int(get_meta("live_diagnostics_post_overlay_restore_until_ms", 0))
	if restore_until_ms > 0 and int(Time.get_ticks_msec()) < restore_until_ms:
		return true

	return false

func _restore_deferred_live_diagnostics_force_frames_if_ready() -> void:
	var deferred_force_frames: int = int(get_meta("live_diagnostics_deferred_force_frames", 0))
	if deferred_force_frames <= 0:
		return
	if live_diagnostics_force_frames > 0:
		return
	if _live_diagnostics_post_overlay_restore_gate_active():
		return

	live_diagnostics_force_frames = deferred_force_frames
	set_meta("live_diagnostics_deferred_force_frames", 0)
