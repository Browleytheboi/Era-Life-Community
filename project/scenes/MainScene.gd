		"reality_mode": str(birth_boot_context.get("reality_mode", settings.get("reality_mode", "realistic"))),
		"headline": MainSceneHelpers._birth_entry_surge_headline(birth_boot_context),
		"subline": _birth_entry_surge_subline(birth_boot_context),
		"flavor_rows": _birth_entry_surge_flavor_rows(birth_boot_context, settings),
		"created_at_ms": int(Time.get_ticks_msec())
	}
func _repair_god_mode_cover_release_nav_shell(reason: String = "spawn_shell") -> Dictionary:
	_bind_ui_nav_buttons()

	var missing: Array [String] = []
	var repaired: Array [String] = []
	var desired_order: Array [String] = _get_ui_nav_order()

	for key in desired_order:
		var button: Button = ui_nav_buttons.get(key, null)
		if button == null or not is_instance_valid(button):
			missing.append(key)
			continue

		button.visible = true
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		repaired.append(key)

	_apply_ui_nav_button_visuals()

	var report: Dictionary = {
		"ready": missing.is_empty(),
		"missing": missing.duplicate(),
		"repaired": repaired.duplicate(),
		"reason": reason,
		"created_at_ms": int(Time.get_ticks_msec())
	}

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_cover_release_nav_shell_report"] = report.duplicate(true)
		gs.scenario_state ["god_mode_cover_release_nav_shell_ready"] = bool(report.get("ready", false))

	return report
func _spawn_ready_live_ui_shell_has_visible_contract_content() -> bool:
	var root:= get_node_or_null("UIContainer") as Control
	if root == null or not is_instance_valid(root) or not root.visible:
		return false

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay) or not player_stats_overlay.visible:
		return false

	var visible_nav_count: int = 0
	for key in _get_ui_nav_order():
		var button:= ui_nav_buttons.get(key, null) as Button
		if button != null and is_instance_valid(button) and button.visible and not button.disabled:
			visible_nav_count += 1

	if visible_nav_count < 4:
		return false

	if output_label != null and is_instance_valid(output_label) and output_label.visible:
		var output_text: String = str(output_label.text).strip_edges()
		var output_lower: String = output_text.to_lower()
		if output_text != "" and output_lower.find("choose sandbox mode") == -1:
			return true

	if standard_tab_popup != null and is_instance_valid(standard_tab_popup) and standard_tab_popup.visible:
		return true
	if world_feed_popup != null and is_instance_valid(world_feed_popup) and world_feed_popup.visible:
		return true
	if activities_action_panel != null and is_instance_valid(activities_action_panel) and activities_action_panel.visible:
		return true
	if institution_hub_overlay != null and is_instance_valid(institution_hub_overlay) and institution_hub_overlay.visible:
		return true

	return true
func _spawn_ready_live_ui_shell_has_minimum_playable_frame() -> bool:
	if gs == null or gs.player == null:
