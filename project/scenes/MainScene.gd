func _playable_life_surface_authority_lock_active() -> bool:
	if _playable_life_surface_player_control_released():
		return false

	var now_ms: int = int(Time.get_ticks_msec())

	if bool(get_meta("playable_life_surface_authority_lock_active", false)):
		var local_until_ms: int = int(get_meta("playable_life_surface_authority_lock_until_ms", 0))
		if local_until_ms > 0 and now_ms > local_until_ms:
			_disarm_playable_life_surface_authority_lock("authority_lock_timeout")
			return false

		return true

	if bool(get_meta("household_start_actor_entry_authority_lock_active", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(gs.scenario_state.get("playable_life_surface_player_control_released", false)):
			return false
		if bool(gs.scenario_state.get("birth_shell_player_control_released", false)):
			return false

		if bool(gs.scenario_state.get("playable_life_surface_authority_lock_active", false)):
			var state_until_ms: int = int(gs.scenario_state.get("playable_life_surface_authority_lock_until_ms", 0))
			if state_until_ms > 0 and now_ms > state_until_ms:
				gs.scenario_state ["playable_life_surface_authority_lock_active"] = false
				gs.scenario_state ["playable_life_surface_authority_lock_timed_out_at_ms"] = now_ms
				return false

			return gs.player != null

		if bool(gs.scenario_state.get("household_start_actor_entry_authority_lock_active", false)):
			return gs.player != null

	return false

func _arm_playable_life_surface_authority_lock(reason: String = "playable_life_entry") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("playable_life_surface_authority_lock_active", true)
	set_meta("playable_life_surface_authority_lock_reason", reason)
	set_meta("playable_life_surface_authority_lock_started_at_ms", now_ms)
	set_meta("playable_life_surface_authority_lock_until_ms", now_ms + 20000)
	set_meta("god_mode_panel_may_hide_live_ui", false)
	set_meta("main_menu_surface_may_hide_live_ui", false)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["playable_life_surface_authority_lock_active"] = true
		gs.scenario_state ["playable_life_surface_authority_lock_reason"] = reason
		gs.scenario_state ["playable_life_surface_authority_lock_started_at_ms"] = now_ms
		gs.scenario_state ["playable_life_surface_authority_lock_until_ms"] = now_ms + 20000
		gs.scenario_state ["god_mode_panel_may_hide_live_ui"] = false
		gs.scenario_state ["main_menu_surface_may_hide_live_ui"] = false
		gs.scenario_state ["playable_life_surface_has_visual_authority"] = true
func _playable_life_shell_has_visible_sovereignty() -> bool:
	if gs == null or gs.player == null:
		return false

	var visible_life_panel: bool = current_panel == "life"
	var ready_revealed: bool = bool(
		get_meta(
			"god_mode_ready_revealed_staged_surface",
			false
		)
	)
	var player_control_released: bool = bool(
		get_meta(
			"playable_life_surface_player_control_released",
			false
		)
	)
	var shell_visible_meta: bool = bool(
		get_meta(
			"spawn_ready_visible_ui_ready_for_audio",
			false
		)
	)
	var progressive_checkpoint_surface_visible: bool = bool(
		get_meta(
			"title_card_continue_progressive_surface_visible",
			false
		)
	)

	if (
		visible_life_panel
		and (
			ready_revealed
			or player_control_released
			or shell_visible_meta
			or progressive_checkpoint_surface_visible
		)
	):
		return true

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(
			gs.scenario_state.get(
				"god_mode_ready_revealed_staged_surface",
				false
			)
		):
			return true

		if bool(
			gs.scenario_state.get(
				"playable_life_surface_player_control_released",
				false
			)
		):
			return true

		if bool(
			gs.scenario_state.get(
				"birth_shell_player_control_released",
				false
			)
		):
			return true

		if bool(
			gs.scenario_state.get(
				"spawn_ready_live_ui_shell_released",
				false
			)
		):
			return true

		if bool(
			gs.scenario_state.get(
				"playable_life_surface_has_visual_authority",
				false
			)
		):
			return true

		if bool(
			gs.scenario_state.get(
				"playable_life_shell_input_sovereignty",
				false
			)
		):
			return true

	return false
func _global_runtime_visible_shell_control_grace_until_ms() -> int:
	var engine: GlobalRuntimeKillContractEngine = global_runtime_kill_contract_engine
	if engine != null:
		var engine_until_ms: int = int(engine.playable_shell_control_grace_until_ms)
		if engine_until_ms > 0:
			return engine_until_ms

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var engine_state: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("global_runtime_kill_contract_engine_state", {}))
		return int(engine_state.get("playable_shell_control_grace_until_ms", 0))

	return 0

func _schedule_god_mode_post_visible_handoff_bookkeeping_after_control_grace(settings: Dictionary, reason: String = "god_mode_post_visible_bookkeeping", source: String = "post_visible_bookkeeping") -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var grace_until_ms: int = _global_runtime_visible_shell_control_grace_until_ms()
	var not_before_ms: int = now_ms + 12000

	if grace_until_ms > now_ms:
		not_before_ms = grace_until_ms + 500

	var existing_not_before_ms: int = int(get_meta("god_mode_post_reveal_handoff_bookkeeping_not_before_ms", 0))
	if existing_not_before_ms > not_before_ms:
		not_before_ms = existing_not_before_ms

	set_meta("god_mode_post_reveal_handoff_contract_pending", true)
	set_meta("god_mode_post_reveal_handoff_contract_reason", reason)
	set_meta("god_mode_post_reveal_handoff_contract_source", source)
	set_meta("god_mode_post_reveal_handoff_bookkeeping_not_before_ms", not_before_ms)
	set_meta("god_mode_post_reveal_handoff_bookkeeping_deferred_by_control_grace", true)
	set_meta("god_mode_post_reveal_handoff_bookkeeping_deferred_at_ms", now_ms)

	EraLog.truth("GLOBAL_RUNTIME_POST_VISIBLE_BOOKKEEPING_DEFERRED|source=%s|reason=%s|not_before_ms=%d|grace_until_ms=%d|at_ms=%d" % [
		source,
		reason,
		not_before_ms,
		grace_until_ms,
		now_ms
	])

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_post_reveal_handoff_contract_pending"] = true
		gs.scenario_state ["god_mode_post_reveal_handoff_contract_reason"] = reason
		gs.scenario_state ["god_mode_post_reveal_handoff_bookkeeping_not_before_ms"] = not_before_ms
		gs.scenario_state ["god_mode_post_reveal_handoff_bookkeeping_deferred_by_control_grace"] = true
		gs.scenario_state ["handoff_after_visible_surface_must_not_touch_engine_during_control_grace"] = true

	if bool(get_meta("god_mode_post_reveal_handoff_bookkeeping_timer_connected", false)):
		return

	var tree:= get_tree()
	if tree == null:
		return

	set_meta("god_mode_post_reveal_handoff_bookkeeping_timer_connected", true)

	var delay_seconds: float = clamp(float(not_before_ms - now_ms) / 1000.0, 0.5, 20.0)
	var timer:= tree.create_timer(delay_seconds)

	timer.timeout.connect(
		Callable(self, "_emit_god_mode_handoff_contract_after_zero_frame_reveal").bind(settings.duplicate(true), "%s_after_control_grace" % reason),
		CONNECT_ONE_SHOT
	)
func _global_runtime_visible_shell_control_grace_active(now_ms: int = -1) -> bool:
	if not _playable_life_shell_has_visible_sovereignty():
		return false

	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	var grace_until_ms: int = _global_runtime_visible_shell_control_grace_until_ms()
	return grace_until_ms > 0 and check_ms < grace_until_ms
func _visible_age_up_runtime_is_player_initiated() -> bool:
	var pending_raw: Variant = get_meta(
		"age_up_pending_temporal_intent",
		{}
	)
	var pending: Dictionary = (
		pending_raw as Dictionary
		if typeof(
			pending_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if (
		bool(
			get_meta(
				"age_up_temporal_intent_active",
				false
			)
		)
		and not pending.is_empty()
	):
		return true

	var loading_context_raw: Variant = get_meta(
		"age_up_loading_deferred_begin_context",
		{}
	)
	var loading_context: Dictionary = (
		loading_context_raw as Dictionary
		if typeof(
			loading_context_raw
		) == TYPE_DICTIONARY
		else {}
	)

	return (
		bool(
			get_meta(
				"visible_age_up_runtime_from_button",
				false
			)
		)
		and bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
		and (
			bool(
				loading_context.get(
					"visible_age_up_runtime_from_button",
					false
				)
			)
			or bool(
				loading_context.get(
					"age_up_button_user_initiated",
					false
				)
			)
		)
	)


func _convert_visible_shell_tail_work_to_background_only(
		reason: String = "visible_shell_tail_work"
) -> void:
	var scenario_requires_conversion: bool = false

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var loading_runtime_raw: Variant = (
			gs.scenario_state.get(
				"loading_runtime",
				{}
			)
		)

		scenario_requires_conversion = (
			(
				typeof(loading_runtime_raw) == TYPE_DICTIONARY
				and not (
					loading_runtime_raw as Dictionary
				).is_empty()
			)
			or bool(
				gs.scenario_state.get(
					"startup_live_shell_loading",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"startup_birth_loading_overlay_active",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"post_spawn_ui_finalize_pending",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"age_up_post_loading_finalize_pending",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"age_up_transition_busy",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"age_up_loading_runtime_active",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"age_up_loading_runtime_begin_pending",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"life_runtime_systems_quarantined",
					false
				)
			)
		)

	var renderer_requires_conversion: bool = (
		bool(
			get_meta(
				"startup_live_shell_loading",
				false
			)
		)
		or bool(
			get_meta(
				"startup_birth_loading_overlay_active",
				false
			)
		)
		or bool(
			get_meta(
				"age_up_post_loading_finalize_pending",
				false
			)
		)
		or bool(
			get_meta(
				"post_spawn_ui_finalize_pending",
				false
			)
		)
		or bool(
			get_meta(
				"spawn_ready_ui_first_frame_boundary_active",
				false
			)
		)
		or bool(
			get_meta(
				"age_up_loading_runtime_begin_pending",
				false
			)
		)
		or bool(
			get_meta(
				"age_up_loading_cosmetic_finish_pending",
				false
			)
		)
		or bool(
			get_meta(
				"life_runtime_systems_quarantined_until_world_prewarm_seen",
				false
			)
		)
		or age_up_loading_runtime_active
		or age_up_loading_finish_requested
		or not age_up_loading_result.is_empty()
		or age_up_loading_paint_hold_frames > 0
		or age_up_loading_exit_started_ms > 0
		or age_up_loading_exit_tween != null
		or (
			age_up_loading_overlay != null
			and is_instance_valid(
				age_up_loading_overlay
			)
			and age_up_loading_overlay.visible
		)
	)



	if (
		not renderer_requires_conversion
		and not scenario_requires_conversion
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"startup_live_shell_loading",
		false
	)
	set_meta(
		"startup_birth_loading_overlay_active",
		false
	)
	set_meta(
		"age_up_post_loading_finalize_pending",
		false
	)
	set_meta(
		"post_spawn_ui_finalize_pending",
		false
	)
	set_meta(
		"spawn_ready_ui_first_frame_boundary_active",
		false
	)
	set_meta(
		"age_up_loading_runtime_begin_pending",
		false
	)
	set_meta(
		"age_up_loading_runtime_begin_earliest_ms",
		0
	)
	set_meta(
		"age_up_loading_deferred_begin_context",
		{}
	)
	set_meta(
		"age_up_loading_zero_frame_result",
		{}
	)
	set_meta(
		"age_up_loading_cosmetic_finish_pending",
		false
	)
	set_meta(
		"visible_age_up_runtime_from_button",
		false
	)
	set_meta(
		"visible_age_up_runtime_from_button_started_at_ms",
		0
	)
	set_meta(
		"life_runtime_systems_quarantined_until_world_prewarm_seen",
		false
	)
	set_meta(
		"life_runtime_systems_quarantine_reason",
		""
	)
	set_meta(
		"life_runtime_systems_quarantine_until_ms",
		0
	)
	set_meta(
		"god_mode_ready_shell_background_tail_only",
		true
	)
	set_meta(
		"ready_shell_blocks_loading_runtime",
		true
	)
	set_meta(
		"ready_shell_visible_loading_forbidden",
		true
	)
	set_meta(
		"ready_shell_visible_loading_forbidden_reason",
		reason
	)
	set_meta(
		"ready_shell_visible_loading_forbidden_at_ms",
		now_ms
	)

	age_up_loading_runtime_active = false
	age_up_loading_finish_requested = false
	age_up_loading_result = {}
	age_up_loading_paint_hold_frames = 0
	age_up_loading_exit_started_ms = 0

	if age_up_loading_exit_tween != null:
		age_up_loading_exit_tween.kill()
		age_up_loading_exit_tween = null

	if (
		age_up_loading_overlay != null
		and is_instance_valid(
			age_up_loading_overlay
		)
	):
		age_up_loading_overlay.visible = false
		age_up_loading_overlay.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"loading_runtime"
		] = {}
		gs.scenario_state [
			"startup_live_shell_loading"
		] = false
		gs.scenario_state [
			"startup_birth_loading_overlay_active"
		] = false
		gs.scenario_state [
			"post_spawn_ui_finalize_pending"
		] = false
		gs.scenario_state [
			"age_up_post_loading_finalize_pending"
		] = false
		gs.scenario_state [
			"age_up_transition_busy"
		] = false
		gs.scenario_state [
			"age_up_loading_runtime_active"
		] = false
		gs.scenario_state [
			"age_up_loading_runtime_begin_pending"
		] = false
		gs.scenario_state [
			"visible_age_up_runtime_from_button"
		] = false
		gs.scenario_state [
			"life_runtime_systems_quarantined"
		] = false
		gs.scenario_state [
			"life_runtime_systems_quarantine_reason"
		] = ""
		gs.scenario_state [
			"life_runtime_systems_soft_ui_resume_allowed"
		] = true
		gs.scenario_state [
			"life_runtime_background_tail_deferred"
		] = true
		gs.scenario_state [
			"post_spawn_world_prewarm_soft_deferred"
		] = true
		gs.scenario_state [
			"ready_shell_blocks_loading_runtime"
		] = true
		gs.scenario_state [
			"ready_shell_visible_loading_forbidden"
		] = true
		gs.scenario_state [
			"ready_shell_visible_loading_forbidden_reason"
		] = reason
		gs.scenario_state [
			"ready_shell_visible_loading_forbidden_at_ms"
		] = now_ms
		gs.scenario_state [
			"playable_life_shell_input_sovereignty"
		] = true
		gs.scenario_state [
			"ui_pointer_motion_can_never_block_playable_life"
		] = true
		gs.scenario_state [
			"tail_work_after_visible_surface_waits_for_player_control"
		] = true

		var guard_raw: Variant = (
			gs.scenario_state.get(
				"runtime_guard",
				{}
			)
		)
		var guard: Dictionary = (
			guard_raw
			if typeof(guard_raw) == TYPE_DICTIONARY
			else {}
		)

		guard [
			"ui_loading_forbidden_after_player_control"
		] = true
		guard [
			"ready_shell_blocks_loading_runtime"
		] = true
		guard [
			"ui_tail_work_yield_to_input"
		] = true
		guard [
			"defer_noncritical_systems"
		] = true
		guard [
			"playable_life_shell_input_sovereignty"
		] = true
		guard [
			"last_action"
		] = "visible_shell_tail_work_background_only"
		guard [
			"last_action_reason"
		] = reason
		guard [
			"last_action_ms"
		] = now_ms

		gs.scenario_state [
			"runtime_guard"
		] = guard
func _playable_life_shell_pointer_motion_is_visual_only() -> bool:
	if gs == null or gs.player == null:
		return false

	if not _playable_life_surface_player_control_released():
		return false

	return true
func _playable_life_shell_loading_overlay_forbidden_now(reason: String = "playable_shell") -> bool:
	var legal_age_up_runtime: bool = _visible_age_up_runtime_is_player_initiated()

	if legal_age_up_runtime:
		return false

	var visible_shell_sovereign: bool = _playable_life_shell_has_visible_sovereignty()

	if not visible_shell_sovereign:
		return false

	_convert_visible_shell_tail_work_to_background_only(reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["playable_life_shell_visible_loading_forbidden"] = true
		gs.scenario_state ["playable_life_shell_visible_loading_forbidden_reason"] = reason
		gs.scenario_state ["playable_life_shell_visible_loading_forbidden_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["ready_shell_blocks_loading_runtime"] = true
		gs.scenario_state ["ready_shell_blocks_loading_runtime_unless_age_up_button"] = true
		gs.scenario_state ["tail_work_must_remain_background_after_zero_frame_entry"] = true

	return true

func _clear_illegal_playable_shell_loading_blockers(reason: String = "playable_shell_input") -> void:
	if not _playable_life_shell_has_visible_sovereignty():
		return

	var legal_age_up_runtime: bool = _visible_age_up_runtime_is_player_initiated()

	_convert_visible_shell_tail_work_to_background_only(reason)

	if legal_age_up_runtime:
		return

	set_meta("age_up_transition_busy", false)
	set_meta("age_up_loading_safe_handoff_queued", false)
	set_meta("age_up_loading_safe_handoff_built", false)
	set_meta("age_up_loading_safe_output_worker_active", false)
	set_meta("age_up_loading_safe_output_worker_needs_rerun", false)
	set_meta("age_up_loading_output_pipeline", {})
	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("age_up_loading_deferred_begin_context", {})
	set_meta("age_up_loading_zero_frame_result", {})
	set_meta("age_up_loading_cosmetic_finish_pending", false)
	set_meta("visible_age_up_runtime_from_button", false)
	set_meta("visible_age_up_runtime_from_button_started_at_ms", 0)

	age_up_loading_runtime_active = false
	age_up_loading_finish_requested = false
	age_up_loading_result = {}
	age_up_loading_paint_hold_frames = 0
	age_up_loading_exit_started_ms = 0

	if age_up_loading_exit_tween != null:
		age_up_loading_exit_tween.kill()
		age_up_loading_exit_tween = null

	if age_up_loading_overlay != null and is_instance_valid(age_up_loading_overlay):
		age_up_loading_overlay.visible = false
		age_up_loading_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["startup_live_shell_loading"] = false
		gs.scenario_state ["startup_birth_loading_overlay_active"] = false
		gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
		gs.scenario_state ["age_up_post_loading_finalize_pending"] = false
		gs.scenario_state ["spawn_ready_ui_first_frame_boundary_active"] = false
		gs.scenario_state ["age_up_transition_busy"] = false
		gs.scenario_state ["loading_runtime"] = {}
		gs.scenario_state ["age_up_loading_runtime_active"] = false
		gs.scenario_state ["age_up_loading_runtime_begin_pending"] = false
		gs.scenario_state ["visible_age_up_runtime_from_button"] = false
		gs.scenario_state ["playable_life_shell_input_sovereignty"] = true
		gs.scenario_state ["pointer_motion_visual_only"] = true
		gs.scenario_state ["pointer_motion_never_blocks_runtime"] = true
		gs.scenario_state ["pointer_motion_clear_loading_reason"] = reason
		gs.scenario_state ["visible_loading_after_ready_forbidden"] = true
		gs.scenario_state ["ready_shell_loading_blockers_cleared"] = true
		gs.scenario_state ["ready_shell_loading_blockers_cleared_at_ms"] = int(Time.get_ticks_msec())

		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
		guard ["playable_life_shell_input_sovereignty"] = true
		guard ["pointer_motion_visual_only"] = true
		guard ["pointer_motion_never_blocks_runtime"] = true
		guard ["ui_loading_forbidden_after_player_control"] = true
		guard ["ready_shell_blocks_loading_runtime"] = true
		guard ["last_pointer_clear_reason"] = reason
		guard ["last_pointer_clear_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["runtime_guard"] = guard
func _playable_life_surface_player_control_released() -> bool:
	if bool(get_meta("playable_life_surface_player_control_released", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		return bool(gs.scenario_state.get("playable_life_surface_player_control_released", false)) \
or bool(gs.scenario_state.get("birth_shell_player_control_released", false))

	return false


func _release_playable_life_surface_to_player_control_now(
		reason: String = "playable_life_player_control"
) -> void:
	var ui_root:= get_node_or_null(
		"UIContainer"
	) as Control
	var checkpoint_shell_release: bool = (
		reason.find(
			"saved_life_checkpoint"
		) != -1
		or reason.find(
			"resident_checkpoint"
		) != -1
	)
	var atomic_shell_committed: bool = (
		ui_root != null
		and is_instance_valid(
			ui_root
		)
		and ui_root.visible
		and bool(
			get_meta(
				"playable_life_shell_atomic_visual_commit_complete",
				false
			)
		)
	)

	if (
		checkpoint_shell_release
		and not atomic_shell_committed
	):
		set_meta(
			"pending_playable_life_surface_release_reason",
			reason
		)
		set_meta(
			"pending_playable_life_surface_release_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"pending_playable_life_surface_release_waits_for_atomic_shell",
			true
		)

		if (
			ui_root != null
			and is_instance_valid(
				ui_root
			)
		):
			ui_root.visible = false
			ui_root.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		return

	var release_already_committed: bool = (
		not checkpoint_shell_release
		and _playable_life_surface_player_control_released()
		and _playable_life_shell_has_visible_sovereignty()
	)




	if release_already_committed:
		var already_released_at_ms: int = int(
			Time.get_ticks_msec()
		)

		if (
			ui_root != null
			and is_instance_valid(
				ui_root
			)
		):
			ui_root.visible = true
			ui_root.mouse_filter = (
				Control.MOUSE_FILTER_PASS
			)
			ui_root.process_mode = (
				Node.PROCESS_MODE_INHERIT
			)

		if (
			age_up_loading_overlay != null
			and is_instance_valid(
				age_up_loading_overlay
			)
		):
			age_up_loading_overlay.visible = false
			age_up_loading_overlay.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		_disarm_playable_life_surface_authority_lock(
			"%s_idempotent_tail" % reason
		)

		set_meta(
			"playable_life_surface_authority_lock_active",
			false
		)
		set_meta(
			"household_start_actor_entry_authority_lock_active",
			false
		)
		set_meta(
			"god_mode_zero_frame_birth_consciousness_switch_active",
			false
		)
		set_meta(
			"startup_live_shell_loading",
			false
		)
		set_meta(
			"startup_birth_loading_overlay_active",
			false
		)
		set_meta(
			"age_up_post_loading_finalize_pending",
			false
		)
		set_meta(
			"age_up_transition_busy",
			false
		)
		set_meta(
			"runtime_interaction_quiet_until_ms",
			0
		)
		set_meta(
			"ui_interaction_grace_until_ms",
			0
		)
		set_meta(
			"god_mode_capsule_entry_handoff_active",
			false
		)
		set_meta(
			"god_mode_atomic_shell_handoff_active",
			false
		)
		set_meta(
			"god_mode_shell_first_handoff_requested",
			false
		)
		set_meta(
			"god_mode_handoff_cover_release_pending",
			false
		)
		set_meta(
			"post_spawn_ui_finalize_pending",
			false
		)
		set_meta(
			"playable_life_control_tail_idempotent_noop",
			true
		)
		set_meta(
			"playable_life_control_tail_idempotent_noop_reason",
			reason
		)
		set_meta(
			"playable_life_control_tail_idempotent_noop_at_ms",
			already_released_at_ms
		)

		if (
			gs != null
			and typeof(
				gs.scenario_state
			) == TYPE_DICTIONARY
		):
			gs.awaiting_new_life = false
			gs.scenario_state [
				"playable_life_surface_authority_lock_active"
			] = false
			gs.scenario_state [
				"household_start_actor_entry_authority_lock_active"
			] = false
			gs.scenario_state [
				"playable_life_surface_player_control_released"
			] = true
			gs.scenario_state [
				"playable_life_shell_has_visible_sovereignty"
			] = true
			gs.scenario_state [
				"playable_life_shell_input_sovereignty"
			] = true
			gs.scenario_state [
				"main_gameplay_ui_visible"
			] = true
			gs.scenario_state [
				"main_nav_buttons_visible"
			] = true
			gs.scenario_state [
				"age_up_button_visible"
			] = true
			gs.scenario_state [
				"startup_live_shell_loading"
			] = false
			gs.scenario_state [
				"startup_birth_loading_overlay_active"
			] = false
			gs.scenario_state [
				"age_up_transition_busy"
			] = false
			gs.scenario_state [
				"post_spawn_ui_finalize_pending"
			] = false
			gs.scenario_state [
				"playable_life_control_tail_idempotent_noop"
			] = true
			gs.scenario_state [
				"playable_life_control_tail_idempotent_noop_reason"
			] = reason
			gs.scenario_state [
				"playable_life_control_tail_idempotent_noop_at_ms"
			] = already_released_at_ms

		EraLog.truth(
			(
				"ERALIFE_READY_CONTROL_TAIL_TRUTH"
				+ "|reason=%s"
				+ "|mode=idempotent_noop"
				+ "|authority_reacquired=false"
				+ "|shell_rebuilt=false"
				+ "|input_released=true"
				+ "|at_ms=%d"
			)
			% [
				reason,
				already_released_at_ms
			]
		)

		return

	_global_runtime_kill_acquire_playable_shell_authority(
		reason
	)
	_global_runtime_kill_enter_simulation_runtime(
		reason,
		{
			"playable_life_shell_visible": true,
		}
	)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	remove_meta(
		"pending_playable_life_surface_release_reason"
	)
	remove_meta(
		"pending_playable_life_surface_release_at_ms"
	)
	remove_meta(
		"pending_playable_life_surface_release_waits_for_atomic_shell"
	)

	set_meta(
		"playable_life_surface_player_control_released",
		true
	)
	set_meta(
		"playable_life_surface_player_control_released_reason",
		reason
	)
	set_meta(
		"playable_life_surface_player_control_released_at_ms",
		now_ms
	)
	set_meta(
		"playable_life_shell_has_visible_sovereignty",
		true
	)
	set_meta(
		"god_mode_ready_shell_background_tail_only",
		true
	)
	set_meta(
		"ready_shell_blocks_loading_runtime",
		true
	)
	set_meta(
		"ready_shell_visible_loading_forbidden",
		true
	)
	set_meta(
		"ready_shell_visible_loading_forbidden_reason",
		reason
	)
	set_meta(
		"ready_shell_visible_loading_forbidden_at_ms",
		now_ms
	)
	set_meta(
		"tail_work_after_visible_surface_background_only",
		true
	)
	set_meta(
		"tail_work_after_visible_surface_may_not_block_ui",
		true
	)
	set_meta(
		"tail_work_after_visible_surface_may_not_start_loading",
		true
	)
	set_meta(
		"world_tail_work_may_not_block_visible_shell",
		true
	)

	_disarm_playable_life_surface_authority_lock(
		reason
	)

	set_meta(
		"playable_life_surface_authority_lock_active",
		false
