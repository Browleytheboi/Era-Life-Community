func _on_artifact_shop_buy_pressed(
	item_id: String
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var routed: Dictionary = (
		_request_artifact_shop_contract(
			"purchase_artifact",
			{
				"item_id": item_id,
				"source": (
					"mainscene.artifact_shop_buy"
				)
			},
			false
		)
	)
	var result: Dictionary = MainSceneHelpers._safe_dictionary(
		routed.get(
			"result",
			{}
		)
	)

	if result.is_empty():
		result = routed.duplicate(false)

	if artifact_shop_status_label != null:
		artifact_shop_status_label.text = str(
			result.get(
				"text",
				result.get(
					"popup_text",
					"Done."
				)
			)
		)

	belongings_hud_content_dirty = true

	_maybe_show_action_result_popup(
		result
	)

	set_meta(
		"artifact_shop_purchase_click_catalog_rebuild",
		false
	)
	set_meta(
		"artifact_shop_purchase_click_diary_render",
		false
	)
	set_meta(
		"artifact_shop_purchase_click_full_shop_render",
		false
	)

