		_:
			crown_action_popup_title.text = str(action_id).to_upper()
			crown_action_popup_body.append_text("This Crown route is scaffolded and ready for the next domain-deepening pass.")

	crown_action_popup.z_as_relative = false
	crown_action_popup.z_index = 1120
	crown_action_popup.set_meta("modal_z_floor", 1120)
	_bring_modal_to_front(crown_action_popup)
func _build_surface_hidden_realm_entries() -> Array:
	var out: Array = []
	if gs == null or gs.many_realms_engine == null:
		return out
	if not MainSceneLogic._other_country_browser_allows_many_realms_surfaces(gs):
		return out

	var hidden_realms_raw: Variant = gs.many_realms_engine.hidden_realms
	var hidden_realms: Dictionary = hidden_realms_raw if typeof(hidden_realms_raw) == TYPE_DICTIONARY else {}
	var has_era_kingdom: bool = false

	for raw_hidden_id in hidden_realms.keys():
		var hidden_id: String = str(raw_hidden_id).strip_edges()
		if hidden_id == "":
			continue

		var hidden_raw: Variant = hidden_realms.get(raw_hidden_id, hidden_realms.get(hidden_id, {}))
		var hidden_realm: Dictionary = hidden_raw if typeof(hidden_raw) == TYPE_DICTIONARY else {}
		if hidden_realm.is_empty():
			continue

		var is_country_surface: bool = bool(hidden_realm.get("is_country_surface", false))
		if not is_country_surface and hidden_id != "era_kingdom":
			continue

		if hidden_id == "era_kingdom":
			has_era_kingdom = true

		var surfaced_realm: Dictionary = hidden_realm.duplicate(true)

		if hidden_id == "era_kingdom" and gs.many_realms_engine.has_method("repair_era_kingdom_surface_realm"):
			var repaired_surface_raw: Variant = gs.many_realms_engine.repair_era_kingdom_surface_realm(surfaced_realm)
			if typeof(repaired_surface_raw) == TYPE_DICTIONARY and not (repaired_surface_raw as Dictionary).is_empty():
				surfaced_realm = (repaired_surface_raw as Dictionary).duplicate(true)

		if hidden_id == "era_kingdom":
			var surfaced_population_profile_raw: Variant = surfaced_realm.get("population_profile", {})
			var surfaced_population_profile: Dictionary = surfaced_population_profile_raw if typeof(surfaced_population_profile_raw) == TYPE_DICTIONARY else {}

			var surfaced_population: int = int(
				surfaced_population_profile.get(
					"total_population",
					surfaced_realm.get("population", 0)
				)
			)
			if gs.many_realms_engine.has_method("_normalize_era_kingdom_population"):
				surfaced_population = int(gs.many_realms_engine._normalize_era_kingdom_population(surfaced_population))
			else:
				surfaced_population = clamp(surfaced_population, 10000000000, 25000000000)

			if surfaced_population_profile.is_empty() and gs.many_realms_engine.has_method("_build_era_kingdom_population_profile"):
				var repaired_profile_raw: Variant = gs.many_realms_engine._build_era_kingdom_population_profile(surfaced_population)
				if typeof(repaired_profile_raw) == TYPE_DICTIONARY:
					surfaced_population_profile = (repaired_profile_raw as Dictionary).duplicate(true)

			if not surfaced_population_profile.is_empty():
				surfaced_population_profile ["total_population"] = surfaced_population
				surfaced_realm ["population_profile"] = surfaced_population_profile.duplicate(true)

			var surfaced_goods_stockpile: int = max(int(surfaced_realm.get("goods_stockpile", 0)), 0)
			var minimum_display_military: int = int(round(float(surfaced_population) * 0.08))
			var maximum_display_military: int = int(round(float(surfaced_population) * 0.18))
			var current_display_military: int = int(
				surfaced_realm.get(
					"military",
					surfaced_realm.get("military_stockpile", surfaced_realm.get("military_units", 0))
				)
			)

			var repaired_military: Dictionary = {}
			if gs.many_realms_engine.has_method("_build_era_kingdom_military_values"):
				var repaired_military_raw: Variant = gs.many_realms_engine._build_era_kingdom_military_values(
					surfaced_population,
					surfaced_population_profile
				)
				if typeof(repaired_military_raw) == TYPE_DICTIONARY:
					repaired_military = (repaired_military_raw as Dictionary).duplicate(true)

			var should_repair_military: bool = (
				current_display_military < minimum_display_military
				or current_display_military > maximum_display_military
				or current_display_military >= surfaced_population
			)

			if should_repair_military and not repaired_military.is_empty():
				surfaced_realm ["military_units"] = int(repaired_military.get("military_units", 0))
				surfaced_realm ["military_stockpile"] = int(repaired_military.get("military_stockpile", surfaced_realm ["military_units"]))
				surfaced_realm ["military"] = int(repaired_military.get("military", surfaced_realm ["military_stockpile"]))
			else:
				var surfaced_military_units: int = clamp(max(int(surfaced_realm.get("military_units", 0)), 0), 0, surfaced_population)
				var surfaced_military_stockpile: int = clamp(
					max(int(surfaced_realm.get("military_stockpile", surfaced_military_units)), surfaced_military_units),
					surfaced_military_units,
					surfaced_population
				)
				surfaced_realm ["military_units"] = surfaced_military_units
				surfaced_realm ["military_stockpile"] = surfaced_military_stockpile
				surfaced_realm ["military"] = clamp(current_display_military, minimum_display_military, maximum_display_military)

			surfaced_realm ["population"] = surfaced_population
			surfaced_realm ["goods_stockpile"] = surfaced_goods_stockpile
			surfaced_realm ["treasury"] = max(int(surfaced_realm.get("treasury", 0)), 0)

		out.append({
			"entry_kind": "hidden_realm",
			"entry_id": hidden_id,
			"name": str(surfaced_realm.get("name", "Hidden Realm")),
			"hidden_realm_id": hidden_id,
			"realm": surfaced_realm,
			"_sort_priority": 0 if hidden_id == "era_kingdom" else 5
		})

	if not has_era_kingdom:
		var preview_trade_rules: Dictionary = {
			"accepts_bribes": false,
			"rare_artifacts_only": true
		}
		if gs.many_realms_engine.has_method("_build_era_kingdom_trade_rules"):
			var preview_trade_rules_raw: Variant = gs.many_realms_engine._build_era_kingdom_trade_rules()
			if typeof(preview_trade_rules_raw) == TYPE_DICTIONARY:
				preview_trade_rules = (preview_trade_rules_raw as Dictionary).duplicate(true)

		var preview_services: Dictionary = {
			"war_resolution": { "enabled": true},
			"massive_loans": { "enabled": true},
			"balance_restoration": { "enabled": true}
		}
		if gs.many_realms_engine.has_method("_build_era_kingdom_service_capabilities"):
			var preview_services_raw: Variant = gs.many_realms_engine._build_era_kingdom_service_capabilities()
			if typeof(preview_services_raw) == TYPE_DICTIONARY:
				preview_services = (preview_services_raw as Dictionary).duplicate(true)

		var preview_population_profile: Dictionary = {}
		if gs.many_realms_engine.has_method("_get_or_create_era_kingdom_surface_preview_profile"):
			var preview_profile_raw: Variant = gs.many_realms_engine._get_or_create_era_kingdom_surface_preview_profile()
			if typeof(preview_profile_raw) == TYPE_DICTIONARY:
				preview_population_profile = (preview_profile_raw as Dictionary).duplicate(true)

		if preview_population_profile.is_empty() and gs.many_realms_engine.has_method("_build_era_kingdom_population_profile"):
			var rolled_preview_population: int = 10000000000
			if gs.many_realms_engine.has_method("_roll_era_kingdom_population"):
				rolled_preview_population = int(gs.many_realms_engine._roll_era_kingdom_population(10000000000, 25000000000))
			var fallback_profile_raw: Variant = gs.many_realms_engine._build_era_kingdom_population_profile(rolled_preview_population)
			if typeof(fallback_profile_raw) == TYPE_DICTIONARY:
				preview_population_profile = (fallback_profile_raw as Dictionary).duplicate(true)

		var preview_population: int = int(preview_population_profile.get("total_population", 10000000000))
		if gs.many_realms_engine.has_method("_normalize_era_kingdom_population"):
			preview_population = int(gs.many_realms_engine._normalize_era_kingdom_population(preview_population))
		else:
			preview_population = clamp(preview_population, 10000000000, 25000000000)

		preview_population_profile ["total_population"] = preview_population

		var preview_treasury: int = max(randi_range(720000000000000000, 999999999999999999), 0)

		var preview_military_values: Dictionary = {}
		if gs.many_realms_engine.has_method("_build_era_kingdom_military_values"):
			var preview_military_raw: Variant = gs.many_realms_engine._build_era_kingdom_military_values(
				preview_population,
				preview_population_profile
			)
			if typeof(preview_military_raw) == TYPE_DICTIONARY:
				preview_military_values = (preview_military_raw as Dictionary).duplicate(true)

		var preview_military_units: int = int(
			preview_military_values.get(
				"military_units",
				int(round(float(preview_population) * 0.08))
			)
		)
		var preview_military_stockpile: int = int(
			preview_military_values.get(
				"military_stockpile",
				int(round(float(preview_population) * 0.12))
			)
		)
		var preview_goods_stockpile: int = max(randi_range(420000000, 920000000), 0)

		var era_kingdom_preview:= {
			"id": "era_kingdom",
			"name": "Era Kingdom",
			"realm_kind": "sovereign_hidden_country",
			"dimension_type": "hidden_parallel_realm",
			"visible_to_owner_only": true,
			"is_country_surface": true,
			"government_style": "Prophetic Regency",
			"capital_city": "Chronos Gate",
			"subzones": [
				"Chronos Gate",
				"Crown of Glass",
				"The Archive Basin",
				"Balance Reach"
			],
			"population": preview_population,
			"population_profile": preview_population_profile.duplicate(true),
			"land": 144000000,
			"land_label": "Interrealm Holdings",
			"treasury": preview_treasury,
			"build_budget_infinite": true,
			"currency_name": "Era Crowns",
			"military_units": preview_military_units,
			"military_stockpile": preview_military_stockpile,
			"military": int(preview_military_values.get("military", preview_military_stockpile)),
			"goods_stockpile": preview_goods_stockpile,
			"ruler_id": "Prophecy Regent",
			"entry_rule": "prophecy_locked",
			"ui_population_browse_allowed": false,
			"hide_people_button": true,
			"loyalty": 100,
			"prosperity": 100,
			"stability": 100,
			"trade_rules": preview_trade_rules,
			"services": preview_services
		}
		out.append({
			"entry_kind": "hidden_realm",
			"entry_id": "era_kingdom",
			"name": "Era Kingdom",
			"hidden_realm_id": "era_kingdom",
			"realm": era_kingdom_preview,
			"_sort_priority": 0
		})

	out.sort_custom(func (a, b):
		var pa: int = int((a as Dictionary).get("_sort_priority", 99))
		var pb: int = int((b as Dictionary).get("_sort_priority", 99))
		if pa == pb:
			return str((a as Dictionary).get("name", "")) < str((b as Dictionary).get("name", ""))
		return pa < pb
	)
	return out
func _on_crown_popup_option_pressed(
		option_id: String,
		payload: Dictionary = {}
) -> void:
		var clean_option_id: String = str(
			option_id
		).strip_edges()

		if clean_option_id.begins_with("route:"):
			_show_crown_action_popup(
				clean_option_id.trim_prefix("route:"),
				payload
			)
			return

		if clean_option_id.begins_with("contract:"):
			_queue_crown_contract_action_from_renderer(
				clean_option_id.trim_prefix("contract:"),
				payload
			)
			return



		var legacy_authority_map: Dictionary = {
			"law_sign": "sign_bill",
			"law_reject_contextual": "veto_bill",
			"law_revise_contextual": "request_bill_revision",
			"law_delay_contextual": "delay_bill",
			"celebrity_gala": "crown_celebrity_action",
			"celebrity_media": "crown_celebrity_action",
			"celebrity_charity": "crown_celebrity_action",
			"public_service": "crown_public_service_action",
			"public_disservice": "crown_public_disservice_action",
			"emergency_powers_confirm": "emergency_power"
		}

		if legacy_authority_map.has(
			clean_option_id
		):
			var authority_payload: Dictionary = payload.duplicate(true)

			if clean_option_id.begins_with("celebrity_"):
				authority_payload ["kind"] = clean_option_id.trim_prefix(
					"celebrity_"
				)

			if clean_option_id == "emergency_powers_confirm":
				authority_payload ["kind"] = "emergency_authority"

			_queue_crown_contract_action_from_renderer(
				str(
					legacy_authority_map.get(
						clean_option_id,
						""
					)
				),
				authority_payload
			)
			return

		_execute_crown_action(
			clean_option_id,
			payload
		)
func _queue_crown_contract_action_from_renderer(
		action_id: String,
		payload: Dictionary
) -> void:
		var clean_action_id: String = str(
			action_id
		).strip_edges().to_lower()

		if clean_action_id == "":
			return

		_hide_crown_action_popup()

		if crown_hub_status_label != null:
			crown_hub_status_label.text = (
				"Reality accepted the decision. "
				+ "Its immutable result is publishing live…"
			)

		set_meta(
			"crown_contract_action_pending",
			true
		)
		set_meta(
			"crown_contract_action_click_path_engine_calls",
			false
		)
		set_meta(
			"crown_contract_action_click_path_mutation",
			false
		)

		call_deferred(
			"_commit_crown_contract_action_deferred",
			clean_action_id,
			payload.duplicate(true)
		)


func _commit_crown_contract_action_deferred(
		action_id: String,
		payload: Dictionary
) -> void:
		if (
			gs == null
			or gs.player == null
		):
			set_meta(
				"crown_contract_action_pending",
				false
			)
			return

		var actor_id: int = int(
			gs.player.id
		)
		var outgoing: Dictionary = (
			payload.duplicate(true)
		)
		var clean_action_id: String = str(
			action_id
		).strip_edges().to_lower()
		var targeted_diplomacy_action: bool = (
			clean_action_id in [
				"country_envoy",
				"country_trade",
				"country_gift",
				"country_bribe"
			]
		)
		var target_method: String = (
			"resolve_crown_diplomacy_action_contract"
			if targeted_diplomacy_action
			else "resolve_crown_action_contract"
		)

		outgoing ["actor_id"] = actor_id
		outgoing ["actor_realm_id"] = int(
			gs.player.realm_id
		)
		outgoing ["action_id"] = clean_action_id
		outgoing ["section_id"] = str(
			outgoing.get(
				"section_id",
				crown_hub_current_section
			)
		)
		outgoing ["source"] = (
			"mainscene.crown_contract_action"
		)
		outgoing ["ui_is_renderer_only"] = true
		outgoing [
			"targeted_diplomacy_delta_only"
		] = targeted_diplomacy_action

		var report: Dictionary = _express_global_ui_intent(
			{
				"actor_id": actor_id,
				"target_id": int(
					outgoing.get(
						"target_id",
						actor_id
					)
				),
				"intent_type": (
					"crown_diplomacy_action"
					if targeted_diplomacy_action
					else "crown_contract_action"
				),
				"surface_id": "crown_hub",
				"action_id": clean_action_id,
				"immutable_contract_references": true,
				"payload": outgoing.duplicate(true),
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"crown_hub_contract_engine"
					),
					"method": target_method,
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene.crown_contract_action"
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"surface_id": "crown_hub",
				"action_id": clean_action_id,
				"source": (
					"mainscene.crown_contract_action"
				),
				"immutable_contract_references": true,
				"blocks_ui": false,
				"ready_gate_member": false,
				"ui_is_expression_only": true
			}
		)

		var routed: Dictionary = _contract_route_result(
			report
		)
		var crown_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"crown_hub_contract",
				{}
			)
		)

		if crown_contract.is_empty():
			var route_result: Dictionary = (
				_crown_hub_contract_route_result(
					report
				)
			)
			crown_contract = MainSceneHelpers._safe_dictionary(
				route_result.get(
					"crown_hub_contract",
					{}
				)
			)



		if not crown_contract.is_empty():
			crown_hub_active_contract = (
				crown_contract.duplicate(false)
			)
			crown_hub_active_actor_id = actor_id
			crown_hub_contract_surface_revision = str(
				crown_contract.get(
					"surface_revision",
					crown_hub_contract_surface_revision
				)
			)

			if crown_hub_open:
				_refresh_crown_hub()

		var result: Dictionary = MainSceneHelpers._safe_dictionary(
			routed.get(
				"result",
				routed
			)
		)

		if result.is_empty():
			result = MainSceneHelpers._safe_dictionary(
				report.get(
					"result",
					report
				)
			)

		if (
			not result.is_empty()
			and bool(
				result.get(
					"targeted_diplomacy_delta_only",
					false
				)
			)
		):
			_apply_crown_targeted_diplomacy_result(
				result
			)

		if not result.is_empty():
			_maybe_show_action_result_popup(
				result
			)

		set_meta(
			"crown_contract_action_pending",
			false
		)
		set_meta(
			"crown_contract_action_committed_off_press",
			true
		)
		set_meta(
			"crown_contract_action_targeted_diplomacy",
			targeted_diplomacy_action
		)
		set_meta(
			"crown_contract_action_full_diplomacy_republish",
			false
			if targeted_diplomacy_action
			else not crown_contract.is_empty()
		)
func _apply_crown_targeted_diplomacy_result(
		result: Dictionary
) -> void:
		if result.is_empty():
			return

		var summary_patch: Dictionary = MainSceneHelpers._safe_dictionary(
			result.get(
				"summary_patch",
				{}
			)
		)

		if not summary_patch.is_empty():
			var summary: Dictionary = MainSceneHelpers._safe_dictionary(
				crown_hub_active_contract.get(
					"summary",
					{}
				)
			)

			if summary.is_empty():
				summary = MainSceneHelpers._safe_dictionary(
					get_meta(
						"crown_hub_chrome_summary_cache",
						{}
					)
				)

			if not summary.is_empty():
				summary = summary.duplicate(true)

				for raw_key in summary_patch.keys():
					summary [
						str(
							raw_key
						)
					] = summary_patch [
						raw_key
					]

				var active_contract: Dictionary = (
					crown_hub_active_contract.duplicate(false)
				)

				active_contract [
					"summary"
				] = summary.duplicate(true)

				crown_hub_active_contract = active_contract

				set_meta(
					"crown_hub_chrome_summary_cache",
					summary.duplicate(true)
				)

				_update_crown_throne_metrics(
					summary
				)
				_refresh_crown_hub_chrome()

		if crown_hub_status_label != null:
			crown_hub_status_label.text = str(
				result.get(
					"text",
					"Diplomatic reality updated."
				)
			)

		set_meta(
			"crown_targeted_diplomacy_delta_applied",
			true
		)
		set_meta(
			"crown_targeted_diplomacy_target_realm_id",
			int(
				result.get(
					"target_realm_id",
					-1
				)
			)
		)
		set_meta(
			"crown_targeted_diplomacy_full_deck_rebuild",
			false
		)
		set_meta(
			"crown_targeted_diplomacy_full_deck_republish",
			false
		)
		set_meta(
			"crown_targeted_diplomacy_ui_mutated_truth",
			false
		)
func _queue_crown_war_preview_priority_from_renderer() -> void:
		if (
			crown_action_popup == null
			or not crown_action_popup.visible
			or gs == null
			or gs.player == null
		):
			return

		var action_id: String = str(
			crown_action_popup_context.get(
				"action_id",
				""
			)
		).strip_edges().to_lower()

		if action_id != "war_preview_pending":
			return

		var pending_preview: Dictionary = MainSceneHelpers._safe_dictionary(
			crown_action_popup_context.get(
				"war_preview_contract",
				{}
			)
		)
		var pending_defender: Dictionary = MainSceneHelpers._safe_dictionary(
			pending_preview.get(
				"defender",
				{}
			)
		)
		var source_entry: Dictionary = MainSceneHelpers._safe_dictionary(
			crown_action_popup_context.get(
				"source_entry",
				{}
			)
		)
		var pending_defender_name: String = str(
			pending_defender.get(
				"name",
				source_entry.get(
					"country",
					"Target Realm"
				)
			)
		).strip_edges()
		var declaration_authority_live: bool = bool(
			pending_preview.get(
				"declaration_allowed",
				false
			)
		)




		if crown_action_popup_options != null:
			crown_action_popup_options.visible = false

			var options_scroll:= (
				crown_action_popup_options.get_parent()
				as ScrollContainer
			)

			if options_scroll != null:
				options_scroll.visible = false

		if crown_action_popup_body != null:
			crown_action_popup_body.bbcode_enabled = true
			crown_action_popup_body.clear()
			crown_action_popup_body.append_text(
				(
					"[center][font_size=22][b]%s[/b][/font_size][/center]\n\n"
					+ "[center]Sovereign war authority is live.[/center]\n"
					+ "[center][color=#AEB9D6]"
					+ "Military, treasury, population, land, resources, "
					+ "alliances, and diplomatic matchup intelligence "
					+ "is publishing into this resident lens now."
					+ "[/color][/center]"
				)
				% pending_defender_name
			)




		if crown_action_popup_confirm_button != null:
			crown_action_popup_confirm_button.text = (
				"DECLARE WAR"
			)
			crown_action_popup_confirm_button.visible = true
			crown_action_popup_confirm_button.disabled = (
				not declaration_authority_live
			)

		if crown_action_popup_status != null:
			crown_action_popup_status.text = (
				(
					"War authority is live • matchup intelligence "
					+ "is publishing now…"
				)
				if declaration_authority_live
				else "War authority is unavailable."
			)

		var defender_realm_id: int = int(
			crown_action_popup_context.get(
				"defender_realm_id",
				-1
			)
		)

		if defender_realm_id <= 0:
			return

		set_meta(
			"crown_war_preview_priority_defender_realm_id",
			defender_realm_id
		)
		set_meta(
			"crown_war_preview_priority_press_engine_calls",
			false
		)
		set_meta(
			"crown_war_preview_declaration_authority_live",
			declaration_authority_live
		)
		set_meta(
			"crown_war_preview_observability_blocks_declaration",
			false
		)
		set_meta(
			"crown_war_preview_blank_options_scroll_hidden",
			true
		)

		call_deferred(
			"_commit_crown_war_preview_priority_deferred",
			int(gs.player.id),
			defender_realm_id
		)
