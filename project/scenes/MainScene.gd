func _on_property_standard_tab_presentation_action_pressed(
	action_id: String
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var clean_action_id: String = str(
		action_id
	).strip_edges()

	if clean_action_id == "":
		return




	_emit_ui_action_contract(
		{
			"surface_id": "property_asset_standard_tab",
			"legacy_action_id": clean_action_id,
			"action_id": clean_action_id,
			"actor_id": int(
				gs.player.id
			),
			"source": (
				"mainscene.property_standard_tab_presentation"
			),
			"visible_click_work_forbidden": true,
			"ui_is_renderer_only": true
		}
	)

	var property_owner: Person = (
		_standard_tab_popup_owner_from_payload()
	)

	if property_owner == null:
		property_owner = gs.player

	if clean_action_id in [
		"Life Assets Back",
		"Property Portfolio Back"
	]:
		_show_assets_panel(
			gs.player,
			""
		)

		set_meta(
			"property_portfolio_back_to_assets_reveal_only",
			true
		)
		set_meta(
			"property_portfolio_back_to_assets_engine_calls",
			false
		)
		set_meta(
			"property_portfolio_back_to_assets_legacy_callback_used",
			false
		)
		return

	if clean_action_id.begins_with(
		"Property Portfolio Open::"
	):
		var open_property_id: int = int(
			clean_action_id.trim_prefix(
				"Property Portfolio Open::"
			)
		)
		_show_property_portfolio_asset_popup(
			property_owner,
			open_property_id
		)
		return

	if clean_action_id.begins_with(
		"Property Portfolio Inspect::"
	):
		var inspect_property_id: int = int(
			clean_action_id.trim_prefix(
				"Property Portfolio Inspect::"
			)
		)
		_show_property_portfolio_asset_popup(
			property_owner,
			inspect_property_id
		)
		return

	if clean_action_id.begins_with(
		"Property Portfolio Enter::"
	):
		var enter_property_id: int = int(
			clean_action_id.trim_prefix(
				"Property Portfolio Enter::"
			)
		)
		_show_property_viewer_panel(
			property_owner,
			enter_property_id
		)

		set_meta(
			"property_portfolio_enter_reveal_only",
			true
		)
		set_meta(
			"property_portfolio_enter_engine_calls",
			false
		)
		set_meta(
			"property_portfolio_enter_legacy_callback_used",
			false
		)
		return

	if clean_action_id.begins_with(
		"Property Portfolio Makeover::"
	):
		var makeover_property_id: int = int(
			clean_action_id.trim_prefix(
				"Property Portfolio Makeover::"
			)
		)
		_show_property_makeover_panel(
			property_owner,
			makeover_property_id
		)

		set_meta(
			"property_portfolio_makeover_reveal_only",
			true
		)
		set_meta(
			"property_portfolio_makeover_engine_calls",
			false
		)
		set_meta(
			"property_portfolio_makeover_legacy_callback_used",
			false
		)
		return
func _format_standard_tab_money(
	value: int
) -> String:
	if (
		gs != null
		and gs.economy_engine != null
	):
		return gs.economy_engine.format_money(
			int(value)
		)

	return "$%d" % int(value)

func _life_assets_body_lines(payload: Dictionary, status_text: String = "") -> Array:
	var lines: Array = []

	var property_payload: Dictionary = payload.get("property_payload", {})
	var vehicle_payload: Dictionary = payload.get("vehicle_payload", {})

	var property_rows: Array = property_payload.get("asset_rows", [])
	var vehicle_rows: Array = vehicle_payload.get("asset_rows", [])

	var property_rollup: Dictionary = property_payload.get("rollup", {})
	var vehicle_rollup: Dictionary = vehicle_payload.get("rollup", {})

	var property_tags: Dictionary = property_rollup.get("portfolio_tags", {})
	var vehicle_tags: Dictionary = vehicle_rollup.get("portfolio_tags", {})

	lines.append("Bank Balance: %s" % _format_standard_tab_money(int(gs.player.bank_balance if gs != null and gs.player != null else 0)))
	lines.append("Controlled Assets: %d" % int(property_rows.size() + vehicle_rows.size()))

	lines.append("")
	lines.append("Real Estate: %d" % property_rows.size())
	if int(property_tags.get("dynastic_properties", 0)) > 0:
		lines.append("Dynastic Seats: %d" % int(property_tags.get("dynastic_properties", 0)))
	if int(property_tags.get("rentals", 0)) > 0:
		lines.append("Rentals: %d" % int(property_tags.get("rentals", 0)))
	if int(property_tags.get("safehouses", 0)) > 0:
		lines.append("Safehouses: %d" % int(property_tags.get("safehouses", 0)))

	lines.append("")
	lines.append("Mobility Assets: %d" % vehicle_rows.size())
	if int(vehicle_tags.get("fleets", 0)) > 0:
		lines.append("Fleet Tags: %d" % int(vehicle_tags.get("fleets", 0)))
	if int(vehicle_tags.get("stables", 0)) > 0:
		lines.append("Stable Tags: %d" % int(vehicle_tags.get("stables", 0)))
	if int(vehicle_tags.get("hangars", 0)) > 0:
		lines.append("Hangar Tags: %d" % int(vehicle_tags.get("hangars", 0)))
	if int(vehicle_tags.get("trade_routes", 0)) > 0:
		lines.append("Trade Routes: %d" % int(vehicle_tags.get("trade_routes", 0)))

	var faction_membership_count: int = 0
	var faction_pressure_total: float = 0.0
	var faction_claim_pressure_total: float = 0.0
	var faction_hotspot_name: String = ""

	if gs != null and gs.player != null and gs.universal_faction_engine != null:
		var faction_state: Dictionary = gs.universal_faction_engine.export_state()
		var membership_index_raw: Variant = faction_state.get("membership_index", {})
		var membership_index: Dictionary = membership_index_raw if typeof(membership_index_raw) == TYPE_DICTIONARY else {}
		var pressure_model_raw: Variant = faction_state.get("pressure_model", {})
		var pressure_model: Dictionary = pressure_model_raw if typeof(pressure_model_raw) == TYPE_DICTIONARY else {}
		var relationship_graph_raw: Variant = faction_state.get("relationship_graph", {})
		var relationship_graph: Dictionary = relationship_graph_raw if typeof(relationship_graph_raw) == TYPE_DICTIONARY else {}
		var faction_registry_raw: Variant = faction_state.get("faction_registry", {})
		var faction_registry: Dictionary = faction_registry_raw if typeof(faction_registry_raw) == TYPE_DICTIONARY else {}
		var player_memberships_raw: Variant = membership_index.get(str(int(gs.player.id)), {})
		var player_memberships: Dictionary = player_memberships_raw if typeof(player_memberships_raw) == TYPE_DICTIONARY else {}

		faction_membership_count = player_memberships.size()

		var best_hotspot_score: float = -1.0
		for raw_faction_id in player_memberships.keys():
			var faction_id: String = str(raw_faction_id)
			var profile_raw: Variant = pressure_model.get(faction_id, {})
			var profile: Dictionary = profile_raw if typeof(profile_raw) == TYPE_DICTIONARY else {}
			var faction_raw: Variant = faction_registry.get(faction_id, {})
			var faction: Dictionary = faction_raw if typeof(faction_raw) == TYPE_DICTIONARY else {}
			var edges_raw: Variant = relationship_graph.get(faction_id, {})
			var edges: Dictionary = edges_raw if typeof(edges_raw) == TYPE_DICTIONARY else {}

			var local_claim_pressure: float = 0.0
			var local_hotspot_score: float = float(profile.get("pressure", 0.0))
			for raw_other_id in edges.keys():
				var edge_raw: Variant = edges.get(raw_other_id, {})
				var edge: Dictionary = edge_raw if typeof(edge_raw) == TYPE_DICTIONARY else {}
				local_claim_pressure += float(edge.get("claim_pressure", 0.0))
				local_hotspot_score += float(edge.get("hostility", 0.0)) * 0.15
				if bool(edge.get("contested_realm", false)):
					local_hotspot_score += 4.0
				if bool(edge.get("contested_hidden_realm", false)):
					local_hotspot_score += 6.0

			faction_pressure_total += float(profile.get("pressure", 0.0))
			faction_claim_pressure_total += local_claim_pressure

			if local_hotspot_score > best_hotspot_score:
				best_hotspot_score = local_hotspot_score
				faction_hotspot_name = str(faction.get("name", "Faction"))

	lines.append("")
	lines.append("Faction Orbit: %d" % faction_membership_count)
	if faction_membership_count > 0:
		lines.append("Faction Pressure: %.1f" % faction_pressure_total)
		if faction_claim_pressure_total > 0.0:
			lines.append("Claim / Turf Pressure: %.1f" % faction_claim_pressure_total)
		if faction_hotspot_name != "":
			lines.append("Hotspot: %s" % faction_hotspot_name)

	lines.append("")
	lines.append("Markets / Securities: Shared command space for owned assets, live markets, and future wealth systems.")
	if status_text.strip_edges() != "":
		lines.append("")
		lines.append(status_text.strip_edges())

	return lines

