func _property_lines_for_npc(
	npc_id: int
) -> Array:
	var lines: Array = []

	if gs.property_engine == null:
		return lines

	if not gs.property_engine.properties.has(
		npc_id
	):
		return lines

	var property_projection: Dictionary = MainSceneHelpers._safe_dictionary(
		active_reality_surface_contract.get(
			"property_projection",
			{}
		)
	)
	var project_as_caves: bool = str(
		property_projection.get(
			"mode",
			""
		)
	) == "cave_shelter_projection"
	var cave_types: Array = MainSceneHelpers._safe_array(
		property_projection.get(
			"types",
			[]
		)
	)
	var projected_cave_name: String = str(
		property_projection.get(
			"cave_name",
			"Family Cave"
		)
	)
	var seen_ids: Dictionary = {}

	for prop in gs.property_engine.properties [npc_id]:
		var prop_id: int = int(
			prop.get(
				"id",
				-1
			)
		)

		if seen_ids.has(
			prop_id
		):
			continue

		seen_ids [prop_id] = true

		var prop_type: String = str(
			prop.get(
				"type",
				str(
					prop.get(
						"size",
						"Property"
					)
				)
			)
		)
		var address: String = str(
			prop.get(
				"address",
				"Unknown Address"
			)
		)

		if project_as_caves:
			if not cave_types.is_empty():
				prop_type = str(
					cave_types [
						abs(prop_id) % cave_types.size()
					]
				)
			else:
				prop_type = "Family Cave"

			address = projected_cave_name

		lines.append(
			"- %s • %s"
			% [
				prop_type,
				address
			]
		)

		var history: Array = prop.get(
			"history",
			[]
		)

		if not history.is_empty():
			lines.append(
				" History: %s"
				% str(
					history [
						history.size() - 1
					]
				)
			)

	return lines
func _force_player_diary_first_person(text: String) -> String:
	var clean_text: String = MainSceneHelpers._compact_diary_text(text)
	if clean_text == "":
		return ""
	if clean_text == "----------------------":
		return clean_text
	if clean_text.begins_with("Year: "):
		return clean_text
	if clean_text.begins_with("Age: "):
		return clean_text
	if gs == null or gs.player == null:
		return clean_text

	if MainSceneLogic._is_secret_superpower_birth_identity_line(clean_text):
		return _player_secret_superpower_birth_identity_line()

	var lower_clean_text: String = clean_text.to_lower()
	if lower_clean_text.begins_with("my name is ") or lower_clean_text.begins_with("my name's ") or lower_clean_text.begins_with("my name’s "):
		if not clean_text.ends_with("!") and not clean_text.ends_with(".") and not clean_text.ends_with("?"):
			clean_text += "."
		return clean_text

	if lower_clean_text.begins_with("i started living as "):
		if not clean_text.ends_with("!") and not clean_text.ends_with(".") and not clean_text.ends_with("?"):
			clean_text += "."
		return clean_text

	var first_name: String = str(gs.player.first_name).strip_edges()
	var last_name: String = str(gs.player.last_name).strip_edges()
	var full_name: String = ("%s %s" % [first_name, last_name]).strip_edges()
	var compact_name: String = ("%s%s" % [first_name, last_name]).strip_edges()

	var possessives: Array = [
		"%s's" % full_name,
		"%s’s" % full_name,
		"%s's" % first_name,
		"%s’s" % first_name
	]

	for raw_possessive in possessives:
		var possessive: String = str(raw_possessive).strip_edges()
		if possessive == "":
			continue
		clean_text = clean_text.replace(possessive, "My")

	var name_targets: Array = [
		full_name,
		compact_name,
		first_name
	]

	for raw_name in name_targets:
		var name_target: String = str(raw_name).strip_edges()
		if name_target == "":
			continue
		clean_text = clean_text.replace(name_target, "I")

	var subject_pairs: Array = [
		["You are ", "I am "],
		["You were ", "I was "],
		["You have ", "I have "],
		["You had ", "I had "],
		["You got ", "I got "],
		["You made ", "I made "],
		["You found ", "I found "],
		["You practiced ", "I practiced "],
		["You gained ", "I gained "],
		["You lost ", "I lost "],
		["You became ", "I became "],
		["You started ", "I started "],
		["You stopped ", "I stopped "],
		["You went ", "I went "],
		["You met ", "I met "],
		["You asked ", "I asked "],
		["You ignored ", "I ignored "],
		["You crossed ", "I crossed "],
		["You blink", "I blink"],
		["You walk ", "I walk "],
		[". You are ", ". I am "],
		[". You were ", ". I was "],
		[". You have ", ". I have "],
		[". You had ", ". I had "],
		[". You got ", ". I got "],
		[". You made ", ". I made "],
		[". You found ", ". I found "],
		[". You practiced ", ". I practiced "],
		[". You gained ", ". I gained "],
		[". You lost ", ". I lost "],
		[". You became ", ". I became "],
		[". You started ", ". I started "],
		[". You stopped ", ". I stopped "],
		[". You went ", ". I went "],
		[". You met ", ". I met "],
		[". You asked ", ". I asked "],
		[". You ignored ", ". I ignored "],
		[". You crossed ", ". I crossed "],
		["! You ", "! I "],
		["? You ", "? I "]
	]

	for pair in subject_pairs:
		clean_text = clean_text.replace(str(pair [0]), str(pair [1]))

	if clean_text.begins_with("You "):
		clean_text = "I " + clean_text.substr(4)

	clean_text = clean_text.replace(" you ", " I ")
	clean_text = clean_text.replace(" your ", " my ")
	clean_text = clean_text.replace(" yours ", " mine ")
	clean_text = clean_text.replace(" yourself ", " myself ")
	clean_text = clean_text.replace("You ", "I ")
	clean_text = clean_text.replace("Your ", "My ")
	clean_text = clean_text.replace("You've ", "I have ")
	clean_text = clean_text.replace("You’ve ", "I have ")
	clean_text = clean_text.replace("You'll ", "I will ")
	clean_text = clean_text.replace("You’ll ", "I will ")
	clean_text = clean_text.replace("You'd ", "I would ")
	clean_text = clean_text.replace("You’d ", "I would ")
	clean_text = clean_text.replace("I’s ", "My ")
	clean_text = clean_text.replace(" I’s ", " My ")
	clean_text = clean_text.replace("I has ", "I have ")
	clean_text = clean_text.replace(" I has ", " I have ")
	clean_text = clean_text.replace("I have has ", "I have ")
	clean_text = clean_text.replace("I was has ", "I had ")
	clean_text = clean_text.replace("I were ", "I was ")
	clean_text = clean_text.replace("I are ", "I am ")
	clean_text = clean_text.replace("me am ", "I am ")
	clean_text = clean_text.replace("me was ", "I was ")
	clean_text = clean_text.replace("me have ", "I have ")
	clean_text = clean_text.replace("me had ", "I had ")
	clean_text = clean_text.replace(" punish I ", " punish me ")
	clean_text = clean_text.replace("punish I for", "punish me for")

	if clean_text == "A local ruler demanded new taxes.":
		clean_text = "A local ruler demanded new taxes from me."

	if not clean_text.ends_with("!") and not clean_text.ends_with(".") and not clean_text.ends_with("?"):
		clean_text += "."

	return clean_text
func _mark_life_diary_mutated(reason: String = "life_diary_mutated") -> void:
	set_meta("life_diary_render_cached_signature", "")
	set_meta("life_diary_render_cached_lines", [])
	set_meta("life_diary_latest_year_focus_pending", true)
	set_meta("life_diary_latest_year_focus_reason", reason)

	if output_label != null and is_instance_valid(output_label):
		output_label.set_meta("life_diary_render_signature", "")

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var revision: int = int(gs.scenario_state.get("life_diary_runtime_revision", 0)) + 1
		gs.scenario_state ["life_diary_runtime_revision"] = revision
		gs.scenario_state ["life_diary_runtime_revision_reason"] = reason
		gs.scenario_state ["life_diary_runtime_revision_at_ms"] = int(Time.get_ticks_msec())

	_invalidate_life_diary_contract_render_cache(reason)
func _append_diary_entry(lines: Array) -> void:
	if lines.is_empty():
		return
	if gs == null or gs.player == null:
		return

	_ensure_active_life_diary_loaded(false)

	var incoming: Array = []
	var incoming_seen: Dictionary = {}

	for raw_line in lines:
		var raw_text: String = str(raw_line).strip_edges()
		if raw_text == "":
			continue

		var clean_text: String = raw_text
		if not clean_text.begins_with("Year: ") and not clean_text.begins_with("Age: ") and clean_text != "----------------------":
			if _should_skip_player_diary_line(clean_text):
				continue
			clean_text = _force_player_diary_first_person(clean_text)
			if _should_skip_player_diary_line(clean_text):
				continue

		if clean_text == "":
			continue

		var incoming_key: String = clean_text.strip_edges()
		if incoming_seen.has(incoming_key):
			continue

		incoming_seen [incoming_key] = true
		incoming.append(clean_text)

	var current_year: String = "Year: %s" % _format_year(gs.year)
	var current_age: String = "Age: %d" % gs.player.age

	if incoming.is_empty():
		incoming.append(current_year)
	elif not str(incoming [0]).begins_with("Year: "):
		incoming.insert(0, current_year)

	if incoming.size() < 2:
		incoming.append(current_age)
	elif not str(incoming [1]).begins_with("Age: "):
		incoming.insert(1, current_age)

	if not MainSceneHelpers._diary_entry_has_body_lines(incoming):
		incoming.append("This year passed quietly, but time still moved forward.")

	var owner_id: int = MainSceneLogic._current_life_diary_owner_id(gs)
	var engine:= _ensure_life_diary_contract_engine()
	if engine == null:
		return

	var report: Dictionary = engine.enqueue_intent({
		"type": "legacy_entry",
		"actor_id": owner_id,
		"lines": incoming.duplicate(true),
		"year": int(gs.year),
		"age": int(gs.player.age),
		"source": "mainscene_append_diary_entry_bridge",
		"preserve_lines_exactly": true,
		"meta": {
			"legacy_function": "_append_diary_entry",
		}
	}, MainSceneLogic._life_diary_bridge_context(gs, "append_diary_entry"))

	_life_diary_sync_runtime_cache_from_contract(owner_id, str(report.get("mode", "append_diary_entry")))
	_save_active_life_diary_state()
	_mark_life_diary_mutated(str(report.get("mode", "append_diary_entry")))

func _append_text_to_diary(text: String, start_new_block: bool = false) -> void:
	var clean_text: String = _force_player_diary_first_person(text)
	if clean_text == "":
		return
	if _should_skip_player_diary_line(clean_text):
		return
	if gs == null or gs.player == null:
		return

	_ensure_active_life_diary_loaded(false)

	var owner_id: int = MainSceneLogic._current_life_diary_owner_id(gs)
	var engine:= _ensure_life_diary_contract_engine()
	if engine == null:
		return

	var report: Dictionary = engine.enqueue_intent({
		"type": "legacy_text",
		"actor_id": owner_id,
		"text": clean_text,
		"year": int(gs.year),
		"age": int(gs.player.age),
		"source": "mainscene_append_text_to_diary_bridge",
		"start_new_block": start_new_block,
		"append_to_current_year_block": not start_new_block,
		"journal_continuation": not start_new_block,
		"meta": {
			"legacy_function": "_append_text_to_diary",
			"start_new_block": start_new_block,
			"append_to_current_year_block": not start_new_block,
			"journal_continuation": not start_new_block,
			"year_age_header_must_not_repeat": not start_new_block
		}
	}, MainSceneLogic._life_diary_bridge_context(gs, "append_text_to_diary"))

