func _relationship_profile_request_zero_frame_switch_room_prewarm(target: Person, reason: String = "relationship_profile_switch_room", immediate: bool = false) -> void:
	if gs == null or target == null:
		return

	var target_id: int = int(target.id)
	if target_id <= 0:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var request_key: String = MainSceneHelpers._relationship_profile_switch_room_prewarm_meta_key(target_id)
	if bool(get_meta(request_key, false)) and _relationship_profile_playable_life_shell_is_hot(target):
		return

	set_meta(request_key, true)
	set_meta("%s_reason" % request_key, reason)
	set_meta("%s_at_ms" % request_key, int(Time.get_ticks_msec()))

	gs.scenario_state ["relationship_profile_switch_room_prewarm_requested"] = true
	gs.scenario_state ["relationship_profile_switch_room_prewarm_target_id"] = target_id
	gs.scenario_state ["relationship_profile_switch_room_prewarm_reason"] = reason
	gs.scenario_state ["relationship_profile_switch_room_prewarm_meta_key"] = request_key
	gs.scenario_state ["relationship_profile_switch_press_only_commits_pointer"] = true

	if immediate:
		_prewarm_relationship_profile_zero_frame_switch_candidate(target, reason)
	else:
		call_deferred("_prewarm_relationship_profile_zero_frame_switch_candidate", target, reason)

func _relationship_profile_cached_target_for_id(
	target_id: int
) -> Person:
	if (
		target_id <= 0
		or gs == null
	):
		return null


	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		var resident_cached_id: int = int(
			relationship_profile_panel.get_meta(
				"relationship_profile_cached_target_id",
				-1
			)
		)

		if (
			resident_cached_id == target_id
			and relationship_profile_panel.has_meta(
				"relationship_profile_cached_target"
			)
		):
			var resident_cached_raw: Variant = (
				relationship_profile_panel.get_meta(
					"relationship_profile_cached_target"
				)
			)

			if resident_cached_raw is Person:
				var resident_cached_target: Person = (
					resident_cached_raw as Person
				)

				if (
					resident_cached_target != null
					and int(resident_cached_target.id) == target_id
				):
					return resident_cached_target


	if (
		relationship_profile_popup != null
		and is_instance_valid(
			relationship_profile_popup
		)
	):
		var cached_id: int = int(
			relationship_profile_popup.get_meta(
				"relationship_profile_cached_target_id",
				-1
			)
		)

		if (
			cached_id == target_id
			and relationship_profile_popup.has_meta(
				"relationship_profile_cached_target"
			)
		):
			var cached_raw: Variant = (
				relationship_profile_popup.get_meta(
					"relationship_profile_cached_target"
				)
			)

			if cached_raw is Person:
				var cached_target: Person = (
					cached_raw as Person
				)

				if (
					cached_target != null
					and int(cached_target.id) == target_id
				):
					return cached_target


	if (
		gs.player != null
		and int(gs.player.id) == target_id
	):
		return gs.player



	if gs.has_method("get_npc_by_id"):
		var active_target: Person = gs.get_npc_by_id(
			target_id
		)

		if active_target != null:
			_relationship_profile_cache_target_for_surface(
				active_target
			)
			return active_target

	return null
func _relationship_profile_resolve_target_for_ui(target_id: int, allow_reactivate: bool = true) -> Person:
	if gs == null:
		return null
	if target_id <= 0:
		return null

	var visible_target: Person = _relationship_profile_cached_target_for_id(target_id)
	if visible_target != null:
		_relationship_profile_cache_target_for_surface(visible_target)
		return visible_target

	if gs.has_method("get_npc_by_id"):
		var active_target: Person = gs.get_npc_by_id(target_id)
		if active_target != null:
			_relationship_profile_cache_target_for_surface(active_target)
			return active_target

	if allow_reactivate and gs.has_method("get_or_reactivate_npc_by_id"):
		var reactivated_target: Person = gs.get_or_reactivate_npc_by_id(target_id)
		if reactivated_target != null:
			_relationship_profile_cache_target_for_surface(reactivated_target)
			return reactivated_target

	return null
func _relationship_profile_active_target_id(
	preferred_target_id: int = -1
) -> int:
	if preferred_target_id > 0:
		return preferred_target_id


	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
		and relationship_profile_panel.active_target_id
		> 0
	):
		return (
			relationship_profile_panel
			.active_target_id
		)

	if relationships_browser_selected_id > 0:
		return relationships_browser_selected_id


	if (
		relationship_profile_popup != null
		and is_instance_valid(
			relationship_profile_popup
		)
		and relationship_profile_popup.has_meta(
			"relationship_profile_target_id"
		)
	):
		var legacy_target_id: int = int(
			relationship_profile_popup.get_meta(
				"relationship_profile_target_id",
				-1
			)
		)

		if legacy_target_id > 0:
			return legacy_target_id

	return -1
func _relationship_profile_active_target(preferred_target_id: int = -1) -> Person:
	if gs == null:
		return null
	var target_id: int = _relationship_profile_active_target_id(preferred_target_id)
	if target_id <= 0:
		return null
	var target: Person = _relationship_profile_resolve_target_for_ui(target_id, true)
	if target == null:
		return null
	_relationship_profile_cache_target_for_surface(target)
	return target
func _on_relationship_profile_edit_pressed() -> void:
	if gs == null:
		return

	var target_id: int = _relationship_profile_active_target_id()
	if not _relationship_profile_try_consume_click("edit", "", target_id):
		return

	var target: Person = _relationship_profile_active_target(target_id)
	if target == null:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = "No relationship target is currently selected."
		return

	if gs.has_method("sync_person_death_state_from_health"):
		gs.sync_person_death_state_from_health(target)

	if not bool(target.alive) or float(target.health) <= 0.0:
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = "Dead NPCs cannot be edited."
		if relationship_profile_popup_edit_button != null:
			relationship_profile_popup_edit_button.visible = false
			relationship_profile_popup_edit_button.disabled = true
		return

	_open_relationship_editor_popup(target)

func _populate_relationship_editor_bank_balance_picker(selected_value: int) -> void:
	if relationship_editor_bank_balance_picker == null:
		return
	relationship_editor_bank_balance_picker.clear()
	var clamped_value:= int(clamp(selected_value, 0, 5000000))
	var selected_index:= 0
	var option_index:= 0
	for value in range(0, 5000001, 50000):
		relationship_editor_bank_balance_picker.add_item(_format_god_mode_bank_balance_value(value))
		relationship_editor_bank_balance_picker.set_item_metadata(option_index, value)
		if value == clamped_value:
			selected_index = option_index
		option_index += 1
	relationship_editor_bank_balance_picker.select(selected_index)

