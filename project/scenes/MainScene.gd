func _mark_god_mode_staged_surface_rendered_by_contract(engine: GodModeContractEngine, reason: String = "god_mode_staged_surface_rendered") -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var surface_id: String = ""
	var tail_not_before_ms: int = now_ms + 8000
	var control_grace_until_ms: int = _global_runtime_visible_shell_control_grace_until_ms()

	if _playable_life_shell_has_visible_sovereignty():
		surface_id = str(get_meta("god_mode_zero_frame_entry_staged_signature", "")).strip_edges()
		tail_not_before_ms = now_ms + 12000

		if control_grace_until_ms > tail_not_before_ms:
			tail_not_before_ms = control_grace_until_ms + 500

		if surface_id != "":
			set_meta("last_rendered_god_mode_playable_surface_contract_id", surface_id)

		set_meta("god_mode_surface_render_ack_state_only", true)
		set_meta("god_mode_surface_render_ack_state_only_reason", reason)
		set_meta("god_mode_surface_render_ack_state_only_at_ms", now_ms)
		set_meta("god_mode_surface_render_ack_did_not_touch_engine", true)
		set_meta("god_mode_birth_tail_work_surface_id", surface_id)
		set_meta("god_mode_birth_tail_work_waiting_for_player_control", false)
		set_meta("god_mode_birth_tail_work_not_before_ms", tail_not_before_ms)
		set_meta("god_mode_birth_tail_work_background_only", true)
		set_meta("god_mode_birth_tail_work_may_not_block_ui", true)
		set_meta("god_mode_birth_tail_work_may_not_start_loading", true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["god_mode_surface_render_ack_state_only"] = true
			gs.scenario_state ["god_mode_surface_render_ack_state_only_reason"] = reason
			gs.scenario_state ["god_mode_surface_render_ack_state_only_at_ms"] = now_ms
			gs.scenario_state ["god_mode_surface_render_ack_did_not_touch_engine"] = true
			gs.scenario_state ["body_contract_tail_work_pending"] = false
			gs.scenario_state ["body_contract_tail_work_background_pending"] = true
			gs.scenario_state ["tail_work_after_visible_surface_waits_for_player_control"] = false
			gs.scenario_state ["tail_work_after_visible_surface_background_only"] = true
			gs.scenario_state ["tail_work_after_visible_surface_may_not_block_ui"] = true
			gs.scenario_state ["tail_work_after_visible_surface_may_not_start_loading"] = true
			gs.scenario_state ["tail_work_after_visible_surface_not_before_ms"] = tail_not_before_ms
			gs.scenario_state ["ready_shell_blocks_loading_runtime"] = true
			gs.scenario_state ["ready_shell_visible_loading_forbidden"] = true
			gs.scenario_state ["playable_life_shell_has_visible_sovereignty"] = true

		EraLog.truth("GLOBAL_RUNTIME_MARK_SURFACE_RENDERED_STATE_ONLY|reason=%s|surface_id=%s|not_before_ms=%d|at_ms=%d" % [
			reason,
			surface_id,
			tail_not_before_ms,
			now_ms
		])

		return

	if engine == null:
		return

	var state: Dictionary = engine.current_state()
	var surface: Dictionary = MainSceneHelpers._safe_dictionary(state.get("playable_surface_contract", {}))
	surface_id = str(surface.get("contract_id", surface.get("id", get_meta("god_mode_zero_frame_entry_staged_signature", "")))).strip_edges()
	tail_not_before_ms = now_ms + 8000

	if control_grace_until_ms > tail_not_before_ms:
		tail_not_before_ms = control_grace_until_ms + 240

	if surface_id != "":
		set_meta("last_rendered_god_mode_playable_surface_contract_id", surface_id)

	engine.mark_surface_rendered_by_renderer({
		"source": reason,
		"surface_id": surface_id,
