func _household_creator_read_member_basic() -> Dictionary:
	var cached: Dictionary = household_creator_pending_member_basic_contract.duplicate(true)

	if not _household_creator_member_basic_controls_alive():
		if not cached.is_empty():
			return cached
		return {
			"schema": "eralife.household_member_creation_contract",
			"version": 1,
			"local_key": "person_%d" % household_creator_created_members.size(),
			"slot_index": household_creator_created_members.size(),
			"first_name": "",
			"last_name": "",
			"gender": "Male",
			"age": 25,
			"age_stage": "Adult",
			"job": "",
			"social_class": str(household_creator_world_contract.get("default_social_class", "Middle Class")),
			"relationship_anchor_key": "",
			"relationship_anchor_label": "",
			"relationship_to_anchor": "none",
			"relationship_to_start": "none"
		}

	var slot_index: int = household_creator_active_member_index
	if slot_index < 0:
		slot_index = household_creator_created_members.size()

	var relation_anchor_key: String = str(cached.get("relationship_anchor_key", "")).strip_edges()
	var relation_anchor_label: String = str(cached.get("relationship_anchor_label", "")).strip_edges()
	if household_creator_member_relation_anchor_picker != null and is_instance_valid(household_creator_member_relation_anchor_picker):
		relation_anchor_label = _household_creator_selected_option_text(household_creator_member_relation_anchor_picker, relation_anchor_label)
		relation_anchor_key = MainSceneHelpers._household_creator_member_key_from_anchor_label(relation_anchor_label)

	var relation_raw: String = str(cached.get("relationship_to_anchor", "")).strip_edges()
	if household_creator_member_relation_picker != null and is_instance_valid(household_creator_member_relation_picker):
		relation_raw = _household_creator_selected_option_text(household_creator_member_relation_picker, relation_raw)

	var first_name: String = _household_creator_line_edit_text(household_creator_member_first_name_line, str(cached.get("first_name", "")))
	var last_name: String = _household_creator_line_edit_text(household_creator_member_last_name_line, str(cached.get("last_name", "")))
	var gender: String = _household_creator_selected_option_text(household_creator_member_gender_picker, str(cached.get("gender", "Male")))
	var age_value: int = _household_creator_spin_box_int(household_creator_member_age_spin, int(cached.get("age", 25)))
	var stage_value: String = MainSceneLogic._household_creator_life_stage_for_age(gs, age_value)

	var job: String = ""
	if MainSceneLogic._household_creator_member_requires_job(gs, age_value):
		job = _household_creator_selected_option_text(household_creator_member_job_picker, str(cached.get("job", "")))
	elif age_value >= 5:
		job = "Student"

	return {
		"schema": "eralife.household_member_creation_contract",
		"version": 1,
		"local_key": "person_%d" % slot_index,
		"slot_index": slot_index,
		"first_name": first_name,
		"last_name": last_name,
		"gender": gender,
		"age": age_value,
		"age_stage": stage_value,
		"job": job,
		"social_class": str(household_creator_world_contract.get("default_social_class", "Middle Class")),
		"relationship_anchor_key": relation_anchor_key,
		"relationship_anchor_label": relation_anchor_label,
		"relationship_to_anchor": MainSceneLogic._household_normalize_relationship(gs, relation_raw),
		"relationship_to_start": MainSceneLogic._household_normalize_relationship(gs, relation_raw)
	}
func _household_creator_member_basic_controls_alive() -> bool:
	return _household_creator_control_alive(household_creator_member_first_name_line) \
and _household_creator_control_alive(household_creator_member_last_name_line) \
and _household_creator_control_alive(household_creator_member_gender_picker) \
and _household_creator_control_alive(household_creator_member_age_spin) \
and _household_creator_control_alive(household_creator_member_stage_picker) \
and _household_creator_control_alive(household_creator_member_job_picker)

func _household_creator_control_alive(control_ref: Variant) -> bool:
	if control_ref == null:
		return false
	if not (control_ref is Object):
		return false
	return is_instance_valid(control_ref)


func _household_creator_line_edit_text(line_ref: Variant, fallback: String = "") -> String:
	if line_ref == null:
		return fallback
	if not (line_ref is Object):
		return fallback
	if not is_instance_valid(line_ref):
		return fallback
	if not (line_ref is LineEdit):
		return fallback

	return str((line_ref as LineEdit).text).strip_edges()


func _household_creator_spin_box_int(spin_ref: Variant, fallback: int = 0) -> int:
	if spin_ref == null:
		return fallback
	if not (spin_ref is Object):
		return fallback
	if not is_instance_valid(spin_ref):
		return fallback
	if not (spin_ref is SpinBox):
		return fallback

	return int((spin_ref as SpinBox).value)


func _household_creator_validate_member_basic(member: Dictionary) -> Dictionary:
	MainSceneLogic._ensure_family_creation_contract_engine(gs)

	var slot_index: int = int(member.get("slot_index", 0))
	if gs != null and gs.family_creation_contract_engine != null:
		return gs.family_creation_contract_engine.validate_member_basic(member, slot_index, household_creator_created_members)

	if str(member.get("first_name", "")).strip_edges() == "":
		return {
			"success": false,
			"reason": "Enter a first name."
		}

	if str(member.get("last_name", "")).strip_edges() == "":
		return {
			"success": false,
			"reason": "Enter a last name."
		}

	if slot_index == 0 and int(member.get("age", 0)) < 18:
		return {
			"success": false,
			"reason": "The first created household member must be an adult."
		}

	return {
		"success": true,
		"reason": "Member valid."
	}


func _household_creator_refresh_member_live_name() -> void:
	if household_creator_member_name_header == null or not is_instance_valid(household_creator_member_name_header):
		return

	var first_name: String = household_creator_member_first_name_line.text.strip_edges() if household_creator_member_first_name_line != null else ""
	var last_name: String = household_creator_member_last_name_line.text.strip_edges() if household_creator_member_last_name_line != null else ""
	var full_name: String = ("%s %s" % [first_name, last_name]).strip_edges()

	if full_name == "":
		full_name = "Unnamed Member"

	household_creator_member_name_header.text = full_name


func _household_creator_refresh_member_life_stage() -> void:
	var age_value: int = int(household_creator_member_age_spin.value) if household_creator_member_age_spin != null and is_instance_valid(household_creator_member_age_spin) else 25
	var stage_value: String = MainSceneLogic._household_creator_life_stage_for_age(gs, age_value)

	if household_creator_member_stage_picker != null and is_instance_valid(household_creator_member_stage_picker):
		_household_creator_select_option_text(household_creator_member_stage_picker, stage_value)

	if household_creator_member_stage_label != null and is_instance_valid(household_creator_member_stage_label):
		household_creator_member_stage_label.text = stage_value

func _household_creator_refresh_member_basic_continue() -> void:
	if household_creator_member_basic_continue_button == null or not is_instance_valid(household_creator_member_basic_continue_button):
		return

	var member: Dictionary = _household_creator_read_member_basic()
	var validation: Dictionary = _household_creator_validate_member_basic(member)
	var valid: bool = bool(validation.get("success", false))

	household_creator_member_basic_continue_button.visible = valid
	household_creator_member_basic_continue_button.disabled = not valid

	if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
		household_creator_status_label.text = str(validation.get("reason", "Fill out member basics."))


func _household_creator_member_selected_gender() -> String:
	return _household_creator_selected_option_text(household_creator_member_gender_picker, "Male").strip_edges()


func _household_creator_set_age_from_selected_life_stage() -> void:
	if household_creator_member_stage_picker == null or not is_instance_valid(household_creator_member_stage_picker):
		return
	if household_creator_member_age_spin == null or not is_instance_valid(household_creator_member_age_spin):
		return

	var stage_value: String = _household_creator_selected_option_text(household_creator_member_stage_picker, "Adult")
	var stage_age_range: Dictionary = MainSceneLogic._household_creator_life_stage_age_range(gs, stage_value)
	var min_age: int = int(stage_age_range.get("min", 0))
	var max_age: int = int(stage_age_range.get("max", 130))
	var default_age: int = int(stage_age_range.get("default", min_age))
	var current_age: int = int(household_creator_member_age_spin.value)

	if current_age < min_age or current_age > max_age:
		household_creator_member_relation_sync_guard = true
		household_creator_member_age_spin.value = int(clamp(default_age, min_age, max_age))
		household_creator_member_relation_sync_guard = false


func _household_creator_refresh_member_job_visibility() -> void:
	if household_creator_member_job_picker == null or not is_instance_valid(household_creator_member_job_picker):
		return

	var age_value: int = int(household_creator_member_age_spin.value) if household_creator_member_age_spin != null and is_instance_valid(household_creator_member_age_spin) else 25
	var show_job: bool = MainSceneLogic._household_creator_member_requires_job(gs, age_value)

	MainSceneHelpers._household_creator_set_labeled_control_visible(household_creator_member_job_picker, show_job)
	household_creator_member_job_picker.disabled = not show_job

	if not show_job:
		household_creator_member_job_picker.set_meta("selected_text", "")
	elif household_creator_member_job_picker.item_count > 0:
		household_creator_member_job_picker.disabled = false


func _household_creator_select_option_text(option_button: Variant, selected_text: String) -> void:
	if option_button == null:
		return
	if not (option_button is Object):
		return
	if not is_instance_valid(option_button):
		return
	if not (option_button is OptionButton):
		return

	var picker: OptionButton = option_button as OptionButton
	var clean_text: String = str(selected_text).strip_edges()
	for i in range(picker.item_count):
		if picker.get_item_text(i).strip_edges().to_lower() == clean_text.to_lower():
			picker.select(i)
			picker.set_meta("selected_text", picker.get_item_text(i).strip_edges())
			picker.tooltip_text = picker.get_item_text(i).strip_edges()
			return


func _household_creator_current_anchor_member() -> Dictionary:
	if household_creator_member_relation_anchor_picker == null or not is_instance_valid(household_creator_member_relation_anchor_picker):
		return {}

	var anchor_label: String = _household_creator_selected_option_text(household_creator_member_relation_anchor_picker, "")
	var anchor_key: String = MainSceneHelpers._household_creator_member_key_from_anchor_label(anchor_label)
	if anchor_key == "":
		return {}

	return _household_creator_member_by_local_key(anchor_key)


func _household_creator_member_by_local_key(local_key: String) -> Dictionary:
	var clean_key: String = str(local_key).strip_edges()
	if clean_key == "":
		return {}

	for raw_member in household_creator_created_members:
		if typeof(raw_member) != TYPE_DICTIONARY:
			continue

		var member: Dictionary = raw_member as Dictionary
		if str(member.get("local_key", "")).strip_edges() == clean_key:
			return member.duplicate(true)

	return {}


func _household_creator_relationship_options_for_current_member(selected_relation: String = "") -> Array:
	var gender: String = _household_creator_member_selected_gender().to_lower()
	var age_value: int = int(household_creator_member_age_spin.value) if household_creator_member_age_spin != null and is_instance_valid(household_creator_member_age_spin) else 25
	var anchor: Dictionary = _household_creator_current_anchor_member()
	var anchor_age: int = int(anchor.get("age", -1))

	MainSceneLogic._ensure_family_creation_contract_engine(gs)
	if gs != null and gs.family_creation_contract_engine != null and gs.family_creation_contract_engine.has_method("relationship_options_for_context"):
		return gs.family_creation_contract_engine.relationship_options_for_context({
			"gender": gender,
			"anchor_age": anchor_age,
			"member_age": age_value,
			"selected_relation": selected_relation
		})

	var base_options: Array = ["Mother", "Father", "Son", "Daughter", "Brother", "Sister", "Husband", "Wife", "Ex", "Roommate", "Friend", "Uncle", "Aunt", "Cousin", "Grandparent"]
	var out: Array = []
	for raw_option in base_options:
		var option_text: String = str(raw_option).strip_edges()
		var lock: String = MainSceneLogic._household_creator_relationship_gender_lock(gs, option_text)
		if lock != "" and lock != gender:
			continue

		var relation: String = MainSceneLogic._household_normalize_relationship(gs, option_text)
		if relation in ["husband", "wife", "ex"]:
			if age_value < 18:
				continue
			if anchor_age >= 0 and anchor_age < 18:
				continue

		if relation in ["son", "daughter"] and anchor_age >= 0 and anchor_age < 16:
			continue

		out.append(option_text)

	return out


func _household_creator_refresh_member_relationship_options(selected_relation: String = "") -> void:
	if household_creator_member_relation_picker == null or not is_instance_valid(household_creator_member_relation_picker):
		return

	var adjusted_relation: String = MainSceneLogic._household_creator_gender_adjusted_relationship(gs, selected_relation, _household_creator_member_selected_gender())
	var options: Array = _household_creator_relationship_options_for_current_member(adjusted_relation)

	if options.is_empty():
		options = ["Friend"]

	_household_creator_set_option_items(household_creator_member_relation_picker, options, adjusted_relation)


func _household_creator_apply_member_relationship_rules(clamp_age_to_relation: bool = true) -> void:
	if household_creator_member_relation_sync_guard:
		return

	household_creator_member_relation_sync_guard = true

	var slot_index: int = household_creator_active_member_index
	if slot_index < 0:
		slot_index = household_creator_created_members.size()

	var min_age: int = 18 if slot_index == 0 else 0
	var max_age: int = 130

	if household_creator_member_relation_picker != null and is_instance_valid(household_creator_member_relation_picker):
		var relation_text: String = _household_creator_selected_option_text(household_creator_member_relation_picker, "Friend")
		var gender_lock: String = MainSceneLogic._household_creator_relationship_gender_lock(gs, relation_text)

		if gender_lock != "" and household_creator_member_gender_picker != null and is_instance_valid(household_creator_member_gender_picker):
			_household_creator_select_option_text(household_creator_member_gender_picker, gender_lock.capitalize())

		var anchor: Dictionary = _household_creator_current_anchor_member()
		var anchor_age: int = int(anchor.get("age", -1))
		var relationship_age_range: Dictionary = MainSceneLogic._household_creator_relationship_age_range(gs, relation_text, anchor_age)
		min_age = max(min_age, int(relationship_age_range.get("min", min_age)))
		max_age = min(max_age, int(relationship_age_range.get("max", max_age)))

		if min_age > max_age:
			min_age = max_age

		if household_creator_member_age_spin != null and is_instance_valid(household_creator_member_age_spin):
			household_creator_member_age_spin.min_value = min_age
			household_creator_member_age_spin.max_value = max_age

			var current_age: int = int(household_creator_member_age_spin.value)
			if clamp_age_to_relation and (current_age < min_age or current_age > max_age):
				household_creator_member_age_spin.value = MainSceneLogic._household_creator_default_age_for_relationship(gs, relation_text, anchor_age, min_age, max_age)
	else:
		if household_creator_member_age_spin != null and is_instance_valid(household_creator_member_age_spin):
			household_creator_member_age_spin.min_value = min_age
			household_creator_member_age_spin.max_value = max_age

	household_creator_member_relation_sync_guard = false

	_household_creator_refresh_member_life_stage()
	_household_creator_refresh_member_job_visibility()

func _household_creator_existing_member_anchor_labels() -> Array:
	var out: Array = []
	for i in range(household_creator_created_members.size()):
		var member: Dictionary = household_creator_created_members [i]
		out.append("%s %s  [%s]" % [
			str(member.get("first_name", "")).strip_edges(),
			str(member.get("last_name", "")).strip_edges(),
			str(member.get("local_key", "person_%d" % i))
		])
	return out


func _ensure_choose_adventure_scenario_panel() -> void:
	if choose_adventure_scenario_panel != null and is_instance_valid(choose_adventure_scenario_panel):
		choose_adventure_scenario_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		choose_adventure_scenario_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		choose_adventure_scenario_panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
		choose_adventure_scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
		choose_adventure_scenario_panel.z_as_relative = false
		choose_adventure_scenario_panel.z_index = 900
		_bring_modal_to_front(choose_adventure_scenario_panel)
		return

	choose_adventure_scenario_panel = ChooseYourOwnAdventureScenarioPanel.new()
	choose_adventure_scenario_panel.name = "ChooseYourOwnAdventureScenarioPanel"
	choose_adventure_scenario_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	choose_adventure_scenario_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	choose_adventure_scenario_panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
	choose_adventure_scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
	choose_adventure_scenario_panel.z_as_relative = false
	choose_adventure_scenario_panel.z_index = 900
	add_child(choose_adventure_scenario_panel)
	_bring_modal_to_front(choose_adventure_scenario_panel)

	if not choose_adventure_scenario_panel.choice_pressed.is_connected(_on_choose_adventure_choice_pressed):
		choose_adventure_scenario_panel.choice_pressed.connect(_on_choose_adventure_choice_pressed)


func _refresh_choose_adventure_scenario_panel(result: Dictionary) -> void:
	_ensure_choose_adventure_scenario_panel()
	if choose_adventure_scenario_panel == null or not is_instance_valid(choose_adventure_scenario_panel):
		return

	choose_adventure_scenario_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	choose_adventure_scenario_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	choose_adventure_scenario_panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
	choose_adventure_scenario_panel.mouse_filter = Control.MOUSE_FILTER_STOP
	choose_adventure_scenario_panel.z_as_relative = false
	choose_adventure_scenario_panel.z_index = 900
	choose_adventure_scenario_panel.present(result)
	_bring_modal_to_front(choose_adventure_scenario_panel)


func _on_choose_adventure_choice_pressed(choice_id: String) -> void:
	_ensure_choose_adventure_preboot_engines()

	var clean_choice_id: String = str(choice_id).strip_edges()

	if clean_choice_id == "__back_to_entry__":
		if choose_adventure_scenario_panel != null and is_instance_valid(choose_adventure_scenario_panel):
			choose_adventure_scenario_panel.hide_panel()
		_show_choose_adventure_entry_panel()
		return

	if clean_choice_id == "__open_god_mode__":
		if choose_adventure_scenario_panel != null and is_instance_valid(choose_adventure_scenario_panel):
			choose_adventure_scenario_panel.hide_panel()
		_on_choose_ereality_entry_pressed()
		return

	if gs == null or gs.choose_adventure_engine == null:
		return

	var result: Dictionary = gs.choose_adventure_engine.choose(clean_choice_id)

	if bool(result.get("birth_now", false)):
		_begin_life_from_choose_adventure_result(result)
		return

	_refresh_choose_adventure_scenario_panel(result)


func _begin_life_from_choose_adventure_result(result: Dictionary) -> void:
	if choose_adventure_scenario_panel != null and is_instance_valid(choose_adventure_scenario_panel):
		choose_adventure_scenario_panel.hide_panel()
	var settings: Dictionary = _build_choose_adventure_life_settings(result)
	var birth_bias_raw: Variant = result.get("birth_bias", {})
	var birth_bias: Dictionary = birth_bias_raw.duplicate(true) if typeof(birth_bias_raw) == TYPE_DICTIONARY else {}
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["choose_adventure_birth_trigger"] = result.duplicate(true)
		gs.scenario_state ["narrative_birth_bias"] = birth_bias.duplicate(true)
		gs.scenario_state ["choose_adventure_lineage_birth"] = true
		gs.scenario_state ["active_lineage_birth_contract"] = settings.get("lineage_birth_contract", {}).duplicate(true) if typeof(settings.get("lineage_birth_contract", {})) == TYPE_DICTIONARY else {}
	_begin_choose_adventure_life_with_settings(settings)
func _build_choose_adventure_life_settings(result: Dictionary) -> Dictionary:
	var random_settings: Dictionary = _build_random_god_mode_settings()
	var settings: Dictionary = random_settings.duplicate(true)

	var birth_bias_raw: Variant = result.get("birth_bias", {})
	var birth_bias: Dictionary = birth_bias_raw.duplicate(true) if typeof(birth_bias_raw) == TYPE_DICTIONARY else {}

	var lineage_contract_raw: Variant = result.get("lineage_birth_contract", birth_bias.get("lineage_birth_contract", {}))
	var lineage_contract: Dictionary = lineage_contract_raw.duplicate(true) if typeof(lineage_contract_raw) == TYPE_DICTIONARY else {}

	var continuation_contract_raw: Variant = result.get("continuation_contract", birth_bias.get("continuation_contract", {}))
	var continuation_contract: Dictionary = continuation_contract_raw.duplicate(true) if typeof(continuation_contract_raw) == TYPE_DICTIONARY else {}

	var conditions_raw: Variant = lineage_contract.get("birth_conditions", {})
	var conditions: Dictionary = conditions_raw.duplicate(true) if typeof(conditions_raw) == TYPE_DICTIONARY else {}

	var birth_mode: String = str(result.get("birth_mode", birth_bias.get("birth_mode", "lineage_birth"))).strip_edges().to_lower()
	if birth_mode == "":
		birth_mode = "lineage_birth"

	settings ["_god_mode_entry_kind"] = "choose_adventure_birth_trigger"
	settings ["god_mode_entry_kind"] = "choose_adventure_birth_trigger"
	settings ["choose_adventure_birth_mode"] = birth_mode
	settings ["choose_adventure_lineage_birth"] = birth_mode != "continue_as_anchor"
	settings ["narrative_birth_bias"] = birth_bias.duplicate(true)
	settings ["lineage_birth_contract"] = lineage_contract.duplicate(true)
	settings ["choose_adventure_continuation_contract"] = continuation_contract.duplicate(true)
	settings ["lineage_id"] = str(result.get("lineage_id", birth_bias.get("lineage_id", "")))
	settings ["selected_adventure_id"] = str(result.get("story_id", ""))

	settings ["feature_overrides"] = settings.get("feature_overrides", {}).duplicate(true) if typeof(settings.get("feature_overrides", {})) == TYPE_DICTIONARY else MainSceneHelpers._feature_overrides_for_mode(str(settings.get("reality_mode", "chaos")))

	if conditions.has("social_class"):
		settings ["social_class"] = str(conditions.get("social_class", settings.get("social_class", "Random / Era Default")))
	elif birth_bias.has("social_class"):
		settings ["social_class"] = str(birth_bias.get("social_class", settings.get("social_class", "Random / Era Default")))

	if conditions.has("starting_money"):
		settings ["bank_balance"] = int(conditions.get("starting_money", settings.get("bank_balance", 0)))
	elif birth_bias.has("starting_money"):
		settings ["bank_balance"] = int(birth_bias.get("starting_money", settings.get("bank_balance", 0)))

	if conditions.has("bending_type"):
		settings ["bending_type"] = str(conditions.get("bending_type", settings.get("bending_type", "none")))

	if birth_mode == "continue_as_anchor":
		var continuation_age: int = int(continuation_contract.get("starting_age", birth_bias.get("starting_age", settings.get("age", 18))))
		continuation_age = int(clamp(continuation_age, 0, 120))

		settings ["_god_mode_entry_kind"] = "choose_adventure_continue_as_anchor"
		settings ["god_mode_entry_kind"] = "choose_adventure_continue_as_anchor"
		settings ["choose_adventure_lineage_birth"] = false
		settings ["generate_family"] = bool(continuation_contract.get("generate_family", true))
		settings ["age"] = continuation_age
		settings ["starting_age"] = continuation_age

		var relationship_potential_raw: Variant = continuation_contract.get("relationship_potential", {})
		if typeof(relationship_potential_raw) == TYPE_DICTIONARY:
			settings ["relationship_potential"] = relationship_potential_raw.duplicate(true)

	if settings.get("bending_type", "none") != "none":
		var overrides: Dictionary = settings.get("feature_overrides", {}).duplicate(true) if typeof(settings.get("feature_overrides", {})) == TYPE_DICTIONARY else {}
		overrides ["bending"] = true
		overrides ["supernatural_school"] = true
		overrides ["supernatural_events"] = true
		settings ["feature_overrides"] = overrides

	return settings
