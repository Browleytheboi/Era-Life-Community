func _send_title_card_account_verification() -> void:
	if gs == null or not gs.has_method("queue_command_envelope"):
		return

	var drain_report: Dictionary = gs.queue_command_envelope({
		"command": "identity.send_signup_verification",
		"source": "title_card_account_panel",
		"username": title_card_account_username_edit.text if title_card_account_username_edit != null else "",
		"email": title_card_account_email_edit.text if title_card_account_email_edit != null else "",
		"password": title_card_account_password_edit.text if title_card_account_password_edit != null else "",
		"auto_drain": true
	})

	var report: Dictionary = MainSceneHelpers._first_handled_command_report(drain_report)
	var message: String = str(report.get("message", report.get("reason", "Verification requested.")))
	var local_code: String = str(report.get("developer_verification_code", report.get("verification_code", ""))).strip_edges()

	if local_code != "":
		message += "\nLocal backend code: %s" % local_code
		EraLog.truth("ERALIFE ERACCOUNT VERIFICATION CODE: %s" % local_code)
		if output_label != null and is_instance_valid(output_label):
			output_label.append_text("\nERALIFE ERACCOUNT VERIFICATION CODE: %s\n" % local_code)

	if title_card_account_status_label != null:
		title_card_account_status_label.text = message

func _submit_title_card_account_panel() -> void:
	if (
		gs == null
		or not gs.has_method(
			"queue_command_envelope"
		)
	):
		return

	var command_id: String = (
		"identity.login_eralife_account"
		if title_card_account_mode == "login"
		else "identity.complete_signup"
	)
	var drain_report: Dictionary = (
		gs.queue_command_envelope({
			"command": command_id,
			"source": (
				"title_card_account_panel"
			),
			"username": (
				title_card_account_username_edit.text
				if title_card_account_username_edit != null
				else ""
			),
			"email": (
				title_card_account_email_edit.text
				if title_card_account_email_edit != null
				else ""
			),
			"password": (
				title_card_account_password_edit.text
				if title_card_account_password_edit != null
				else ""
			),
			"verification_code": (
				title_card_account_code_edit.text
				if title_card_account_code_edit != null
				else ""
			),
			"auto_drain": true
		})
	)
	var report: Dictionary = (
		MainSceneHelpers._first_handled_command_report(
			drain_report
		)
	)
	var message: String = str(
		report.get(
			"message",
			report.get(
				"reason",
				"Account request handled."
			)
		)
	)

	if title_card_account_status_label != null:
		title_card_account_status_label.text = (
			message
		)

	if (
		bool(
			report.get(
				"success",
				false
			)
		)
		and str(
			report.get(
				"mode",
				""
			)
		) in [
			"signup_complete",
			"login_complete"
		]
	):
		_close_title_card_account_panel()
		_refresh_title_card_identity_surface()
		_sync_global_reality_intake_button()

		var continue_contract: Dictionary = (
			_title_card_continue_contract()
		)
		var banner_message: String = (
			"ErAccount connected."
		)

		if bool(
			continue_contract.get(
				"available",
				false
			)
		):
			banner_message = (
				"ErAccount connected. "
				+ "Press C to continue your saved life."
			)
		elif bool(
			continue_contract.get(
				"legacy_attachment_available",
				false
			)
		):
			banner_message = (
				"ErAccount connected. "
				+ "Local lives are ready to attach."
			)
		else:
			banner_message = (
				"ErAccount connected. "
				+ "Start a life to create your first LifePacket."
			)

		_show_eraccount_status_banner(
			banner_message,
			true
		)
		_open_global_reality_intake_if_requested_after_login()

func _disconnect_title_card_eralife_account() -> void:
	if gs == null or not gs.has_method("queue_command_envelope"):
		return

	var drain_report: Dictionary = gs.queue_command_envelope({
		"command": "identity.disconnect_eralife_account",
		"source": "title_card_identity_surface",
		"auto_drain": true
	})

	var report: Dictionary = MainSceneHelpers._first_handled_command_report(drain_report)
	set_meta("title_card_account_disconnect_report", report.duplicate(true))

	_close_reality_intake_panel()
	_refresh_title_card_identity_surface()
	_sync_global_reality_intake_button()
	_show_eraccount_status_banner("ErAccount disconnected. You are playing as a guest.", false)
