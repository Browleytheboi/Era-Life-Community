		gs.scenario_state ["tail_work_after_visible_surface_may_not_block_ui"] = true
		gs.scenario_state ["tail_work_after_visible_surface_may_not_start_loading"] = true
		gs.scenario_state ["tail_work_after_visible_surface_not_before_ms"] = tail_not_before_ms
