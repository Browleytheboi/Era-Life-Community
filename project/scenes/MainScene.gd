func _open_crown_diplomacy_population_wall(
		entry: Dictionary
) -> void:
		if entry.is_empty():
			return

		var realm_id: int = int(
			entry.get(
				"population_realm_id",
				entry.get(
					"realm_id",
					-1
				)
			)
		)
		var realm_name: String = str(
			entry.get(
				"population_realm_name",
				entry.get(
					"country",
					""
				)
			)
		).strip_edges()

		if realm_id <= 0:
			if crown_hub_status_label != null:
				crown_hub_status_label.text = (
					"That realm has not published a stable "
					+ "population identity yet."
				)
			return

		if realm_name == "":
			realm_name = "Realm %d" % realm_id

		crown_population_wall_last_realm_id = (
			realm_id
		)
		crown_population_wall_last_realm_name = (
			realm_name
		)

		_show_crown_action_popup(
			"population",
			{
				"target_realm_id": realm_id,
				"target_realm_name": realm_name,
				"entry": entry.duplicate(false),
				"source": (
					"crown_diplomacy_population_wall"
				),
				"intent_is_not_action": true,
				"ui_is_renderer_only": true,
				"click_path_build_forbidden": true,
				"click_path_materialization_forbidden": true,
			}
		)

		set_meta(
			"crown_diplomacy_population_click_realm_id",
			realm_id
		)
		set_meta(
			"crown_diplomacy_population_click_engine_calls",
			false
		)
		set_meta(
			"crown_diplomacy_population_click_build",
			false
		)
		set_meta(
			"crown_diplomacy_population_click_contract_pointer_only",
			true
		)
func _show_crown_era_kingdom_bribe_confirmation(
	entry: Dictionary
) -> void:
	if (
		crown_action_popup == null
		or crown_action_popup_body == null
		or crown_action_popup_title == null
		or crown_action_popup_confirm_button == null
		or crown_action_popup_cancel_button == null
	):
		return

	crown_action_popup_context = {
		"action_id": (
			"era_kingdom_bribe_confirm"
		),
		"country": "Era Kingdom",
		"realm_key": "era_kingdom",
		"amount": 150000,
		"source_entry": (
			entry.duplicate(false)
		)
	}

	crown_action_popup_title.text = (
		"BRIBE THE ERA KINGDOM?"
	)
	crown_action_popup_body.bbcode_enabled = true
	crown_action_popup_body.clear()
	crown_action_popup_body.append_text(
		(
			"[center][font_size=24][b]"
			+ "Do you REALLY want to try to bribe the Era Kingdom?"
			+ "[/b][/font_size][/center]\n\n"
			+ "[center][color=#FFB84D]"
			+ "The Era Kingdom is not a normal foreign government. "
			+ "It may laugh this off. It may also take the attempt as an act of open hostility."
			+ "[/color][/center]"
		)
	)

	if crown_action_popup_input != null:
		crown_action_popup_input.visible = false

