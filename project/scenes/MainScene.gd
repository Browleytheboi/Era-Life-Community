		gs.scenario_state [
			"pending_situations_button_actor_id"
		] = actor_id
		gs.scenario_state [
			"pending_situations_button_count"
		] = count
		gs.scenario_state [
			"pending_situations_button_used_exact_actor_scoped_truth"
		] = true
func _ensure_pending_situation_engines() -> void:
	if gs == null:
		return

	var visible_shell_sovereign: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)

	if visible_shell_sovereign:
		var missing_authorities: Array = []

		if gs.scenario_popup_contract_engine == null:
			missing_authorities.append(
				"scenario_popup_contract_engine"
			)

		if gs.scenario_runtime_contract_engine == null:
			missing_authorities.append(
				"scenario_runtime_contract_engine"
			)

		if gs.pending_situations_engine == null:
			missing_authorities.append(
				"pending_situations_engine"
			)

		if gs.contract_view_layer_contract_engine == null:
			missing_authorities.append(
				"contract_view_layer_contract_engine"
			)

		if not missing_authorities.is_empty():
			set_meta(
				"pending_situations_visible_shell_missing_resident_authorities",
				missing_authorities.duplicate(false)
			)
			set_meta(
				"pending_situations_visible_shell_lazy_engine_construction_forbidden",
				true
			)
			set_meta(
				"pending_situations_visible_shell_missing_authority_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)

		return

	if gs.scenario_popup_contract_engine == null:
		gs.scenario_popup_contract_engine = (
			ScenarioPopupContractEngine.new(
				gs
			)
		)

	if gs.scenario_runtime_contract_engine == null:
		gs.scenario_runtime_contract_engine = (
			ScenarioRuntimeContractEngine.new(
				gs
			)
		)

	if gs.pending_situations_engine == null:
		gs.pending_situations_engine = (
			PendingSituationsEngine.new(
				gs
			)
		)

	if gs.contract_view_layer_contract_engine == null:
		gs.contract_view_layer_contract_engine = (
			_new_contract_view_layer_contract_engine()
		)
func _new_contract_view_layer_contract_engine():
	var engine_from_global_class = _new_instance_from_global_class_name("ContractViewLayerContractEngine")
	if engine_from_global_class != null:
		return engine_from_global_class

	var candidate_paths: Array = [
		"res://ContractViewLayerContractEngine.gd",
		"res://engines/ContractViewLayerContractEngine.gd",
		"res://scripts/ContractViewLayerContractEngine.gd",
		"res://Scripts/ContractViewLayerContractEngine.gd",
		"res://systems/ContractViewLayerContractEngine.gd",
		"res://Systems/ContractViewLayerContractEngine.gd",
		"res://scripts/engines/ContractViewLayerContractEngine.gd"
	]

	for raw_path in candidate_paths:
		var instance = _new_instance_from_script_path(str(raw_path))
		if instance != null:
			return instance

	return null


func _new_instance_from_global_class_name(global_class_name: String):
	var clean_name: String = str(global_class_name).strip_edges()
	if clean_name == "":
		return null

	var global_class_rows: Array = ProjectSettings.get_global_class_list()
	for raw_row in global_class_rows:
		if typeof(raw_row) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = raw_row as Dictionary
		if str(row.get("class", "")).strip_edges() != clean_name:
			continue

		var script_path: String = str(row.get("path", "")).strip_edges()
		var instance = _new_instance_from_script_path(script_path)
		if instance != null:
			return instance

	return null


func _new_instance_from_script_path(script_path: String):
	var clean_path: String = str(script_path).strip_edges()
	if clean_path == "":
		return null

	if not ResourceLoader.exists(clean_path):
		return null

	var script_resource: Resource = load(clean_path)
	if script_resource == null or not (script_resource is Script):
		return null

	var script: Script = script_resource as Script
	return script.new(gs)


