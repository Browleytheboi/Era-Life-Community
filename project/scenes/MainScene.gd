func _replace_crown_diplomacy_entry_live(
	entry: Dictionary
) -> void:
	if entry.is_empty():
		return

	var grid: GridContainer = (
		_ensure_crown_diplomacy_live_grid()
	)

	if grid == null:
		return

	var entry_key: String = (
		MainSceneHelpers._crown_diplomacy_entry_key(
			entry
		)
	)

	if entry_key == "":
		return

	var previous_index: int = -1
	var previous_entry: Dictionary = {}

	if crown_hub_diplomacy_card_registry.has(
		entry_key
	):
		var old_packet_raw: Variant = (
			crown_hub_diplomacy_card_registry.get(
				entry_key,
				{}
			)
		)

		var old_packet: Dictionary = (
			old_packet_raw as Dictionary
			if typeof(old_packet_raw) == TYPE_DICTIONARY
			else {}
		)

		var previous_entry_raw: Variant = old_packet.get(
			"entry",
			{}
		)

		if typeof(previous_entry_raw) == TYPE_DICTIONARY:
			previous_entry = (
				previous_entry_raw as Dictionary
			)

		var old_shell:= old_packet.get(
			"shell",
			null
		) as Control

		if (
			old_shell != null
			and is_instance_valid(
				old_shell
			)
		):
			previous_index = (
				old_shell.get_index()
			)

			if old_shell.get_parent() != null:
				old_shell.get_parent().remove_child(
					old_shell
				)

			old_shell.queue_free()

		crown_hub_diplomacy_card_registry.erase(
			entry_key
		)

	var entries_raw: Variant = get_meta(
		"crown_diplomacy_stream_entries",
		[]
	)

	var entries: Array = (
		(entries_raw as Array).duplicate(false)
		if typeof(entries_raw) == TYPE_ARRAY
		else []
	)

	var replaced: bool = false

	for index in range(
		entries.size()
	):
		var candidate_raw: Variant = entries [
			index
		]

		if typeof(candidate_raw) != TYPE_DICTIONARY:
			continue

		var candidate: Dictionary = (
			candidate_raw as Dictionary
		)

		if (
			MainSceneHelpers._crown_diplomacy_entry_key(
				candidate
			) != entry_key
		):
			continue

		entries [
			index
		] = entry.duplicate(false)

		replaced = true
		break

	if not replaced:
		entries.append(
			entry.duplicate(false)
		)

	set_meta(
		"crown_diplomacy_stream_entries",
		entries
	)

	var permissions_raw: Variant = (
		crown_hub_active_contract.get(
			"permissions",
			{}
		)
	)

	var permissions: Dictionary = (
		permissions_raw as Dictionary
		if typeof(permissions_raw) == TYPE_DICTIONARY
		else {}
	)

	_append_crown_country_diplomacy_row(
		entry,
		permissions
	)



	_apply_crown_diplomacy_stream_entry_visibility(
		entry
	)

	var new_packet_raw: Variant = (
		crown_hub_diplomacy_card_registry.get(
			entry_key,
			{}
		)
	)

	var new_packet: Dictionary = (
		new_packet_raw as Dictionary
		if typeof(new_packet_raw) == TYPE_DICTIONARY
		else {}
	)

	var new_shell:= new_packet.get(
		"shell",
		null
	) as Control

	var requires_global_layout: bool = (
		_crown_diplomacy_live_entry_requires_global_layout(
			previous_entry,
			entry
		)
	)

	if requires_global_layout:
		_apply_crown_diplomacy_filter_and_sort()

	elif (
		previous_index >= 0
		and new_shell != null
		and is_instance_valid(
			new_shell
		)
	):


		grid.move_child(
			new_shell,
			mini(
				previous_index,
				grid.get_child_count() - 1
			)
		)

	var popup_action_id: String = str(
		crown_action_popup_context.get(
			"action_id",
			""
		)
	).strip_edges()

	var pending_defender_realm_id: int = int(
		crown_action_popup_context.get(
			"defender_realm_id",
			-1
		)
	)

	var upgraded_preview_raw: Variant = entry.get(
		"war_preview_contract",
		{}
	)

	var upgraded_preview: Dictionary = (
		upgraded_preview_raw as Dictionary
		if typeof(upgraded_preview_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		popup_action_id == "war_preview_pending"
		and pending_defender_realm_id > 0
		and pending_defender_realm_id == int(
			entry.get(
				"realm_id",
				-1
			)
		)
		and not upgraded_preview.is_empty()
		and not bool(
			upgraded_preview.get(
				"preview_pending",
				false
			)
		)
	):
		call_deferred(
			"_show_crown_war_preview_from_contract",
			entry.duplicate(false)
		)

	set_meta(
		"crown_diplomacy_single_card_war_upgrade",
		entry_key
	)
	set_meta(
		"crown_diplomacy_full_deck_republish_performed",
		false
	)
	set_meta(
		"crown_diplomacy_live_entry_appended_if_new",
		not replaced
	)
	set_meta(
		"crown_diplomacy_global_sort_per_live_war_upgrade",
		requires_global_layout
	)
func _crown_diplomacy_live_entry_requires_global_layout(
	previous_entry: Dictionary,
	next_entry: Dictionary
) -> bool:
	if previous_entry.is_empty():
		return true

	var previous_visible: bool = (
		_crown_diplomacy_entry_matches_filter(
			previous_entry,
			crown_hub_diplomacy_filter_key
		)
	)

	var next_visible: bool = (
		_crown_diplomacy_entry_matches_filter(
			next_entry,
			crown_hub_diplomacy_filter_key
		)
	)

	if previous_visible != next_visible:
		return true

	match crown_hub_diplomacy_sort_key:
		"population_desc":
			return (
				int(
					previous_entry.get(
						"population_rank",
						0
					)
				)
				!= int(
					next_entry.get(
						"population_rank",
						0
					)
				)
				or int(
					previous_entry.get(
						"population",
						0
					)
				)
				!= int(
					next_entry.get(
						"population",
						0
					)
				)
			)

		"treasury_desc":
			return (
				int(
					previous_entry.get(
						"treasury",
						0
					)
				)
				!= int(
					next_entry.get(
						"treasury",
						0
					)
				)
			)

		"military_desc":
			return (
				int(
					previous_entry.get(
						"military_stockpile",
						0
					)
				)
				!= int(
					next_entry.get(
						"military_stockpile",
						0
					)
				)
			)

		"relation_desc":
			return (
				int(
					previous_entry.get(
						"relation_score",
						0
					)
				)
				!= int(
					next_entry.get(
						"relation_score",
						0
					)
				)
			)

	return false
func _crown_hub_background_residency_quiet_window_truth(
	now_ms: int = -1
) -> Dictionary:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	var player_control_released: bool = (
		_playable_life_surface_player_control_released()
	)
	var released_at_ms: int = int(
		get_meta(
			"playable_life_surface_player_control_released_at_ms",
			0
		)
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		released_at_ms = maxi(
			released_at_ms,
			int(
				gs.scenario_state.get(
					"playable_life_surface_player_control_released_at_ms",
					0
				)
			)
		)
		released_at_ms = maxi(
			released_at_ms,
			int(
				gs.scenario_state.get(
					"birth_shell_player_control_released_at_ms",
					0
				)
			)
		)

	var fallback_released_at_ms: int = int(
		get_meta(
			"crown_hub_background_fallback_player_control_released_at_ms",
			0
		)
	)

	if (
		player_control_released
		and released_at_ms <= 0
	):
		if fallback_released_at_ms <= 0:
			fallback_released_at_ms = check_ms

			set_meta(
				"crown_hub_background_fallback_player_control_released_at_ms",
				fallback_released_at_ms
			)

		released_at_ms = fallback_released_at_ms

	elif released_at_ms > 0:
		set_meta(
			"crown_hub_background_fallback_player_control_released_at_ms",
			released_at_ms
		)




	var safe_after_ms: int = (
		released_at_ms
		if released_at_ms > 0
		else check_ms
	)
	var input_fence_until_ms: int = int(
		get_meta(
			"zero_frame_ui_input_fence_until_ms",
			0
		)
	)
	var presentation_fence_active: bool = bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	)
	var input_fence_active: bool = (
		check_ms < input_fence_until_ms
	)



	var interaction_grace_active: bool = (
		_ui_interaction_grace_active(
			check_ms
		)
	)
	var pointer_last_motion_ms: int = int(
		get_meta(
			"ui_pointer_last_motion_ms",
			0
		)
	)
	var pointer_motion_guard_active: bool = (
		pointer_last_motion_ms > 0
		and check_ms >= pointer_last_motion_ms
		and (
			check_ms - pointer_last_motion_ms
		) < 180
	)
	var current_stage: String = str(
		get_meta(
			"crown_hub_background_residency_stage",
			"contract"
		)
	).strip_edges().to_lower()
	var progressive_diplomacy_stage: bool = (
		current_stage == "diplomacy"
	)
	var constitutional_surface_safe: bool = (
		player_control_released
		and check_ms >= safe_after_ms
		and not presentation_fence_active
		and not input_fence_active
		and not age_up_loading_runtime_active
	)




	var critical_safe: bool = (
		constitutional_surface_safe
	)
	var strict_optional_safe: bool = (
		constitutional_surface_safe
	)
	var progressive_safe: bool = (
		constitutional_surface_safe
	)
	var optional_safe: bool = (
		constitutional_surface_safe
	)
	var retry_delay_seconds: float = 0.016

	if not player_control_released:
		retry_delay_seconds = 0.032
	elif (
		presentation_fence_active
		or input_fence_active
	):
		retry_delay_seconds = 0.016

	return {
		"safe": optional_safe,
		"critical_safe": critical_safe,
		"optional_safe": optional_safe,
		"strict_optional_safe": strict_optional_safe,
		"progressive_safe": progressive_safe,
		"now_ms": check_ms,
		"player_control_released": player_control_released,
		"released_at_ms": released_at_ms,
		"safe_after_ms": safe_after_ms,
		"presentation_fence_active": (
			presentation_fence_active
		),
		"input_fence_active": input_fence_active,
		"interaction_grace_active": (
			interaction_grace_active
		),
		"pointer_last_motion_ms": (
			pointer_last_motion_ms
		),
		"pointer_motion_guard_active": (
			pointer_motion_guard_active
		),
		"current_stage": current_stage,
		"progressive_diplomacy_stage": (
			progressive_diplomacy_stage
		),
		"retry_delay_seconds": retry_delay_seconds,
		"ready_gate_member": false
	}
func _arm_crown_hub_background_residency_service(
	reason: String = "crown_hub_background_residency",
	delay_seconds: float = 0.032
) -> void:
	if bool(
		get_meta(
			"crown_hub_background_residency_service_armed",
			false
		)
	):
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_arm_crown_hub_background_residency_service",
			reason,
			delay_seconds
		)
		return

	var generation: int = int(
		get_meta(
			"crown_hub_background_residency_generation",
			0
		)
	) + 1
	var safe_delay: float = clampf(
		delay_seconds,
		0.016,
		0.5
	)

	set_meta(
		"crown_hub_background_residency_generation",
		generation
	)
	set_meta(
		"crown_hub_background_residency_service_armed",
		true
	)
	set_meta(
		"crown_hub_background_residency_service_reason",
		reason
	)
	set_meta(
		"crown_hub_background_residency_service_delay_ms",
		int(
			round(
				safe_delay * 1000.0
			)
		)
	)
	set_meta(
		"crown_hub_background_residency_service_ready_gate_member",
		false
	)
	set_meta(
		"crown_hub_background_residency_service_click_owned",
		false
	)
	set_meta(
		"crown_hub_background_residency_service_render_owned",
		false
	)

	var timer:= tree.create_timer(
		safe_delay,
		true,
		false,
		true
	)
	var callback: Callable = Callable(
		self,
		"_service_crown_hub_background_residency"
	).bind(
		generation,
		reason
	)
	var connection_error: int = timer.timeout.connect(
		callback,
		CONNECT_ONE_SHOT
	)

	if connection_error != OK:
		set_meta(
			"crown_hub_background_residency_service_armed",
			false
		)

		call_deferred(
			"_arm_crown_hub_background_residency_service",
			reason,
			safe_delay
		)


func _finish_crown_hub_background_residency_quantum(
	delay_seconds: float,
	reason: String
) -> void:
	set_meta(
		"crown_hub_background_residency_service_active",
		false
	)

	_arm_crown_hub_background_residency_service(
		reason,
		delay_seconds
	)

func _crown_hub_background_residency_quantum_delay(
	started_at_ms: int,
	base_delay_seconds: float,
	stage: String
) -> float:
	var finished_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var elapsed_ms: int = maxi(
		0,
		finished_at_ms - started_at_ms
	)
	var clean_stage: String = str(
		stage
	).strip_edges().to_lower()
	var progressive_stage: bool = (
		clean_stage == "diplomacy"
	)
	var optional_stage: bool = (
		clean_stage == "action_popup"
	)
	var stage_base_delay_seconds: float = (
		0.016
		if progressive_stage
		else base_delay_seconds
	)
	var recovery_multiplier: float = (
		1.0
		if progressive_stage
		else (
			4.0
			if optional_stage
			else 2.0
		)
	)
	var maximum_delay_seconds: float = (
		0.048
		if progressive_stage
		else 0.5
	)
	var measured_recovery_seconds: float = (
		float(elapsed_ms)
		/ 1000.0
		* recovery_multiplier
	)
	var resolved_delay: float = clampf(
		maxf(
			stage_base_delay_seconds,
			measured_recovery_seconds
		),
		stage_base_delay_seconds,
		maximum_delay_seconds
	)

	set_meta(
		"crown_hub_background_last_quantum_stage",
		clean_stage
	)
	set_meta(
		"crown_hub_background_last_quantum_duration_ms",
		elapsed_ms
	)
	set_meta(
		"crown_hub_background_last_quantum_recovery_ms",
		int(
			round(
				resolved_delay * 1000.0
			)
		)
	)
	set_meta(
		"crown_hub_background_quantum_immediate_reentry_forbidden",
		true
	)
	set_meta(
		"crown_hub_background_quantum_adaptive_cooldown",
		true
	)
	set_meta(
		"crown_hub_background_progressive_quantum",
		progressive_stage
	)
	set_meta(
		"crown_hub_background_progressive_max_delay_ms",
		int(
			round(
				maximum_delay_seconds * 1000.0
			)
		)
	)

	return resolved_delay
func _service_crown_hub_background_residency(
		generation: int,
		reason: String
) -> void:
		if generation != int(
			get_meta(
				"crown_hub_background_residency_generation",
				0
			)
		):
			return

		set_meta(
			"crown_hub_background_residency_service_armed",
			false
		)
		set_meta(
			"crown_hub_background_residency_service_active",
			true
		)

		if (
			gs == null
			or gs.player == null
		):
			_finish_crown_hub_background_residency_quantum(
				0.12,
				"%s_waiting_for_player" % reason
			)
			return

		var actor_id: int = int(
			gs.player.id
		)
		var actor_has_crown_presence: bool = (
			actor_id > 0
			and _player_has_crown_presence()
		)

		if not actor_has_crown_presence:
			crown_hub_active_contract = {}
			crown_hub_active_actor_id = -1
			crown_hub_contract_surface_revision = ""

			set_meta(
				"crown_hub_prepainted_actor_id",
				-1
			)
			set_meta(
				"crown_hub_prepainted_surface_revision",
				""
			)
			set_meta(
				"crown_hub_prepainted_section_id",
				""
			)
			set_meta(
				"crown_hub_background_residency_stage",
				"inactive"
			)
			set_meta(
				"crown_hub_background_residency_service_active",
				false
			)

			_update_crown_hud()
			return

		var stage_actor_id: int = int(
			get_meta(
				"crown_hub_background_residency_stage_actor_id",
				-1
			)
		)

		if stage_actor_id != actor_id:
			set_meta(
				"crown_hub_background_residency_stage_actor_id",
				actor_id
			)
			set_meta(
				"crown_hub_background_residency_stage",
				"contract"
			)
			set_meta(
				"crown_hub_background_residency_queued_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)

		var readiness: Dictionary = (
			_crown_hud_actor_scoped_readiness_truth()
		)
		var action_popup_hot: bool = (
			crown_action_popup != null
			and is_instance_valid(
				crown_action_popup
			)
		)
		var diplomacy_hot: bool = bool(
			crown_hub_active_contract.get(
				"diplomacy_projection_complete",
				false
			)
		)
		var stage: String = str(
			get_meta(
				"crown_hub_background_residency_stage",
				"contract"
			)
		).strip_edges().to_lower()

		if not bool(
			readiness.get(
				"contract_hot",
				false
			)
		):
			stage = "contract"
		elif not bool(
			readiness.get(
				"shell_hot",
				false
			)
		):
			stage = "overlay"
		elif not bool(
			readiness.get(
				"prepaint_hot",
				false
			)
		):
			stage = "prepaint"
		elif not diplomacy_hot:
			stage = "diplomacy"
		elif not action_popup_hot:
			stage = "action_popup"
		else:
			stage = "complete"

		var optional_stage: bool = (
			stage in [
				"diplomacy",
				"action_popup"
			]
		)
		var quiet_window: Dictionary = (
			_crown_hub_background_residency_quiet_window_truth()
		)
		var stage_safe: bool = bool(
			quiet_window.get(
				(
					"optional_safe"
					if optional_stage
					else "critical_safe"
				),
				false
			)
		)

		if not stage_safe:
			set_meta(
				"crown_hub_background_residency_yielded_to_ui",
				true
			)
			set_meta(
				"crown_hub_background_residency_yielded_stage",
				stage
			)
			set_meta(
				"crown_hub_background_residency_yielded_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)

			_finish_crown_hub_background_residency_quantum(
				float(
					quiet_window.get(
						"retry_delay_seconds",
						0.096
					)
				),
				"%s_ui_priority_retry" % reason
			)
			return

		set_meta(
			"crown_hub_background_residency_yielded_to_ui",
			false
		)

		var quantum_started_at_ms: int = int(
			Time.get_ticks_msec()
		)

		match stage:
			"contract":
				if not crown_hub_contract_request_pending:
					crown_hub_contract_request_pending = true

					_request_resident_crown_hub_contract(
						gs.player,
						(
							"mainscene."
							+ "crown_hub_background_residency_core_contract"
						)
					)

				crown_hub_contract_request_pending = false

				set_meta(
					"crown_hub_background_residency_stage",
					"overlay"
				)

				_update_crown_hud()

				_finish_crown_hub_background_residency_quantum(
					_crown_hub_background_residency_quantum_delay(
						quantum_started_at_ms,
						0.032,
						"contract"
					),
					"%s_after_core_contract" % reason
				)
				return

			"overlay":
				_ensure_crown_hub_overlay()

				set_meta(
					"crown_hub_background_residency_stage",
					"prepaint"
				)

				_finish_crown_hub_background_residency_quantum(
					_crown_hub_background_residency_quantum_delay(
						quantum_started_at_ms,
						0.032,
						"overlay"
					),
					"%s_after_overlay_shell" % reason
				)
				return

			"prepaint":
				_prepaint_crown_hub_surface_from_active_contract(
					actor_id,
					"crown_hub_background_residency_core_prepaint"
				)



				_update_crown_hud()

				set_meta(
					"crown_hub_background_residency_stage",
					"diplomacy"
				)
				set_meta(
					"crown_hub_core_surface_hot_before_optional_work",
					true
				)

				_finish_crown_hub_background_residency_quantum(
					_crown_hub_background_residency_quantum_delay(
						quantum_started_at_ms,
						0.05,
						"prepaint"
					),
					"%s_after_throne_prepaint" % reason
				)
				return

			"diplomacy":
				var enriched_contract: Dictionary = (
					_request_resident_crown_diplomacy_quantum(
						gs.player,
						(
							"mainscene."
							+ "crown_hub_background_diplomacy_quantum"
						)
					)
				)
				var diplomacy_quantum_complete: bool = false

				if not enriched_contract.is_empty():
					crown_hub_active_contract = (
						enriched_contract.duplicate(false)
					)
					crown_hub_active_actor_id = actor_id
					crown_hub_contract_surface_revision = str(
						enriched_contract.get(
							"surface_revision",
							crown_hub_contract_surface_revision
						)
					)
					diplomacy_quantum_complete = bool(
						enriched_contract.get(
							"diplomacy_projection_complete",
							false
						)
					)

					set_meta(
						"crown_hub_diplomacy_projection_complete",
						diplomacy_quantum_complete
					)

					if diplomacy_quantum_complete:
						set_meta(
							"crown_hub_background_residency_stage",
							"action_popup"
						)



						_update_crown_hud()
					else:


						set_meta(
							"crown_hub_background_residency_stage",
							"diplomacy"
						)
						set_meta(
							"crown_hub_diplomacy_quantum_hud_refresh_performed",
							false
						)
				else:
					set_meta(
						"crown_hub_background_residency_stage",
						"diplomacy"
					)
					set_meta(
						"crown_hub_diplomacy_projection_complete",
						false
					)
					set_meta(
						"crown_hub_diplomacy_quantum_hud_refresh_performed",
						false
					)

				_finish_crown_hub_background_residency_quantum(
					_crown_hub_background_residency_quantum_delay(
						quantum_started_at_ms,
						(
							0.08
							if diplomacy_quantum_complete
							else 0.032
						),
						"diplomacy"
					),
					"%s_after_diplomacy_quantum" % reason
				)
				return

			"action_popup":
				_ensure_crown_action_popup()

				set_meta(
					"crown_hub_background_residency_stage",
					"complete"
				)

				_update_crown_hud()

				_finish_crown_hub_background_residency_quantum(
					_crown_hub_background_residency_quantum_delay(
						quantum_started_at_ms,
						0.08,
						"action_popup"
					),
					"%s_after_action_popup_shell" % reason
				)
				return

			_:
				set_meta(
					"crown_hub_background_residency_stage",
					"complete"
				)
				set_meta(
					"crown_hub_background_residency_complete_actor_id",
					actor_id
				)
				set_meta(
					"crown_hub_background_residency_completed_at_ms",
					int(
						Time.get_ticks_msec()
					)
				)
				set_meta(
					"crown_hub_background_residency_service_active",
					false
				)
				set_meta(
					"crown_hub_background_residency_blocks_ui",
					false
				)
				set_meta(
					"crown_hub_background_residency_hud_refresh_per_realm",
					false
				)

				_update_crown_hud()
func _crown_hub_contract_is_renderable(
	contract: Dictionary,
	actor_id: int = -1
) -> bool:
	if contract.is_empty():
		return false

	if not bool(
		contract.get(
			"success",
			false
		)
	):
		return false

	if str(
		contract.get(
			"schema",
			""
		)
	).strip_edges() != "eralife.crown_hub_contract":
		return false

	if (
		actor_id > 0
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	var summary: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"summary",
			{}
		)
	)
	var permissions: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"permissions",
			{}
		)
	)
	var section_tabs: Array = MainSceneHelpers._safe_array(
		contract.get(
			"section_tabs",
			[]
		)
	)
	var section_surfaces: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"section_surfaces",
			{}
		)
	)
	var throne_rows: Array = MainSceneHelpers._safe_array(
		section_surfaces.get(
			"throne",
			[]
		)
	)
	var surface_revision: String = str(
		contract.get(
			"surface_revision",
			""
		)
	).strip_edges()

	return (
		not summary.is_empty()
		and not permissions.is_empty()
		and not section_tabs.is_empty()
		and not section_surfaces.is_empty()
		and not throne_rows.is_empty()
		and surface_revision != ""
	)


func _request_crown_hub_contract(
	actor: Person,
	payload: Dictionary = {}
) -> Dictionary:
	if (
		gs == null
		or actor == null
	):
		return {}

	var outgoing: Dictionary = payload.duplicate(false)
	outgoing ["actor_id"] = int(actor.id)
	outgoing ["section_id"] = str(
		outgoing.get(
			"section_id",
			crown_hub_current_section
		)
	)
	outgoing ["source"] = str(
		outgoing.get(
			"source",
			"mainscene.crown_hub"
		)
	)
	outgoing ["ui_is_expression_only"] = true

	var action_id: String = str(
		outgoing.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": int(actor.id),
			"target_id": int(actor.id),
			"intent_type": "crown_hub_contract_intent",
			"surface_id": "crown_hub",
			"action_id": action_id,
			"payload": outgoing,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"crown_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": int(actor.id)
			},
			"source": str(
				outgoing.get(
					"source",
					""
				)
			),
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(actor.id),
			"target_id": int(actor.id),
			"surface_id": "crown_hub",
			"action_id": action_id,
			"source": str(
				outgoing.get(
					"source",
					""
				)
			)
		}
	)

	var route_result: Dictionary = (
		_crown_hub_contract_route_result(report)
	)
	var contract_raw: Variant = route_result.get(
		"crown_hub_contract",
		{}
	)
	var contract: Dictionary = (
		contract_raw as Dictionary
		if typeof(contract_raw) == TYPE_DICTIONARY
		else {}
	)

	if _crown_hub_contract_is_renderable(
		contract,
		int(actor.id)
	):


		crown_hub_active_contract = (
			contract.duplicate(false)
		)
		crown_hub_active_actor_id = int(actor.id)
		crown_hub_contract_surface_revision = str(
			contract.get(
				"surface_revision",
				""
			)
		)
		set_meta(
			"crown_hub_contract_renderable",
			true
		)
		set_meta(
			"crown_hub_contract_actor_id",
			int(actor.id)
		)
		set_meta(
			"crown_hub_contract_deep_copy_performed",
			false
		)
	else:
		set_meta(
			"crown_hub_contract_renderable",
			false
		)

	return route_result.duplicate(false)

