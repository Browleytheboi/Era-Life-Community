func _free_hidden_god_mode_panel_after_spawn_shell(reason: String = "spawn_shell") -> void:
	var tree:= get_tree()
	if tree == null:
		return

	var attempt: int = 0

	_prime_god_mode_playable_shell_for_cover_release(reason)
	var shell_ready: bool = _god_mode_playable_shell_ready_for_cover_release(reason)

	if not shell_ready:
		await tree.process_frame
		attempt += 1
		_prime_god_mode_playable_shell_for_cover_release("%s_retry_%d" % [reason, attempt])
		shell_ready = _god_mode_playable_shell_ready_for_cover_release("%s_retry_%d" % [reason, attempt])

	if not bool(get_meta("god_mode_audio_handoff_complete", false)):
		_crossfade_from_god_mode_audio_to_live_era_audio_contract("%s_cleanup_cover_release" % reason, 420)

	await RenderingServer.frame_post_draw

	_prime_god_mode_playable_shell_for_cover_release("%s_final" % reason)

	_release_zero_frame_ui_render_enforcement("%s_cover_release" % reason)
	set_meta("runtime_interaction_quiet_until_ms", 0)
	set_meta("ui_interaction_grace_until_ms", 0)

	_hide_god_mode_start_panel_zero_frame_shell("%s_free_hidden_cleanup" % reason)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.visible = false
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
