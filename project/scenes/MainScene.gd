func _ensure_profile_nav_button() -> void:
	var root:= get_node_or_null("UIContainer") as Control
	if root == null:
		ui_nav_buttons.erase("profile")
		return

	var stale_buttons: Array = []
	var existing:= root.find_child("ProfileButton", true, false) as Button
	if existing != null:
		stale_buttons.append(existing)

	for node in root.find_children("*", "Button", true, false):
		var candidate:= node as Button
		if candidate == null:
			continue
		var candidate_text: String = candidate.text.strip_edges().to_lower()
		if candidate.name == "ProfileButton" or candidate_text == "profile":
			if not stale_buttons.has(candidate):
				stale_buttons.append(candidate)

	for raw_button in stale_buttons:
		var button:= raw_button as Button
		if button == null:
			continue
		var parent:= button.get_parent()
		if parent != null:
			parent.remove_child(button)
		button.queue_free()

	ui_nav_buttons.erase("profile")

func _on_profile_button_pressed() -> void:
