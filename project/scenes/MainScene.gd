func _refresh_vehicle_market_panel(status_text: String = "", selected_template_id: String = "") -> void:
	if vehicle_market_panel == null or not is_instance_valid(vehicle_market_panel):
		return

	var contract: Dictionary = _vehicle_market_request_surface_contract("mainscene.vehicle_market_panel_refresh", status_text, selected_template_id)
	if contract.is_empty():
		vehicle_market_panel.render_surface_contract({
			"success": false,
			"title": "Vehicle Market",
			"subtitle": "No vehicle market contract is available.",
			"listing_card_contracts": [],
			"truth_state": "missing_surface_contract",
			"ui_is_renderer_only": true
		})
		return

	vehicle_market_panel.open_for_actor(gs.player, contract)

func _vehicle_market_request_surface_contract(
	source: String = (
		"mainscene.vehicle_market_surface_request"
	),
	status_text: String = "",
	selected_template_id: String = ""
) -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	var payload: Dictionary = {
		"actor_id": int(gs.player.id),
		"source": source,
		"status_text": status_text,
		"selected_template_id": selected_template_id,
		"ui_is_renderer_only": true
	}
	var report: Dictionary = _express_global_ui_intent({
		"actor_id": int(gs.player.id),
		"intent_type": (
			"vehicle_market_surface_request"
		),
		"surface_id": (
			"vehicle_market_contract_panel"
		),
		"action_id": (
			"view_vehicle_market_panel"
		),
		"payload": payload.duplicate(true),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"dealership_contract_engine"
			),
			"method": (
				"emit_market_surface_contract"
			),
			"pass_actor_payload": true,
			"actor_id": int(gs.player.id)
		},
		"source": source
	}, {
		"actor_id": int(gs.player.id),
		"source": source,
		"surface_id": (
			"vehicle_market_contract_panel"
		),
		"action_id": (
			"view_vehicle_market_panel"
		)
	})
	var result: Dictionary = (
		_market_panel_route_result(
			report
		)
	)

	if typeof(
		result.get(
			"surface_contract",
			{}
		)
	) == TYPE_DICTIONARY:
		var routed_contract: Dictionary = (
			result.get(
				"surface_contract",
				{}
			) as Dictionary
		).duplicate(true)

		if MainSceneLogic._market_surface_contract_is_renderable(
			routed_contract,
			"vehicle"
		):
			return routed_contract

	if MainSceneLogic._market_surface_contract_is_renderable(
		result,
		"vehicle"
	):
		return result.duplicate(true)

	return MainSceneLogic._observable_asset_market_surface_contract(gs, 
		gs.player,
		"vehicle",
		status_text
	)
func _create_vehicle_market_surface_panel(
	surface_key: String
) -> VehicleMarketPanel:
	var panel:= VehicleMarketPanel.new()
	panel.name = (
		"VehicleMarketPanel_%s"
		% surface_key.replace(
			":",
			"_"
		)
	)
	panel.visible = false
	panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	panel.z_index = 173
	panel.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	panel.bind_host(
		self,
		gs
	)
	panel.close_requested.connect(
		_hide_vehicle_market_panel
	)
	panel.listing_action_requested.connect(
		_on_vehicle_market_listing_action_requested
	)
	add_child(panel)
	return panel


func _prewarm_vehicle_market_panel_surface_deck(
	target_actor: Person,
	deck_contract: Dictionary,
	reason: String = (
		"vehicle_market_panel_surface_deck"
	)
) -> void:
	if (
		target_actor == null
		or deck_contract.is_empty()
	):
		return

	var target_actor_id: int = int(
		target_actor.id
	)

	if target_actor_id <= 0:
		return

	var surfaces: Dictionary = MainSceneHelpers._safe_dictionary(
		deck_contract.get(
			"surfaces",
			{}
		)
	)

	for raw_surface_key in surfaces.keys():
		var surface_key: String = str(
			raw_surface_key
		)
		var surface_contract: Dictionary = (
			MainSceneHelpers._safe_dictionary(
				surfaces.get(
					raw_surface_key,
					{}
				)
			)
		)

		if surface_contract.is_empty():
			continue

		surface_contract ["actor_id"] = target_actor_id
		surface_contract ["visible_click_work_required"] = false
		surface_contract ["visible_click_work_forbidden"] = true
		surface_contract ["ready_gate_member"] = false
		surface_contract ["ui_is_renderer_only"] = true
		surface_contract ["vehicle_surface_key"] = surface_key

		var panel: VehicleMarketPanel = (
			vehicle_market_panel_surface_deck.get(
				surface_key,
				null
			) as VehicleMarketPanel
		)

		if (
			panel == null
			or not is_instance_valid(panel)
		):
			panel = (
				_create_vehicle_market_surface_panel(
					surface_key
				)
			)
			vehicle_market_panel_surface_deck [
				surface_key
			] = panel

		panel.actor = target_actor
		panel.render_surface_contract(
			surface_contract
		)
		panel.visible = false
		panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		panel.set_meta(
			"vehicle_surface_key",
			surface_key
		)
		panel.set_meta(
			"vehicle_surface_prepainted",
			true
		)
		panel.set_meta(
			"vehicle_surface_prepaint_reason",
			reason
		)
		panel.set_meta(
			"prepainted_actor_id",
			target_actor_id
		)
		panel.set_meta(
			"vehicle_surface_actor_id",
			target_actor_id
		)
		panel.set_meta(
			"vehicle_surface_click_build_required",
			false
		)
		panel.set_meta(
			"vehicle_surface_click_build_forbidden",
			true
		)

	var default_surface_key: String = str(
		deck_contract.get(
			"default_surface_key",
			(
				"selector"
				if vehicle_market_panel_surface_deck.has(
					"selector"
				)
				else "inventory"
			)
		)
	).strip_edges()

	if not vehicle_market_panel_surface_deck.has(
		default_surface_key
	):
		default_surface_key = (
			"selector"
			if vehicle_market_panel_surface_deck.has(
				"selector"
			)
			else (
				"inventory"
				if vehicle_market_panel_surface_deck.has(
					"inventory"
				)
				else ""
			)
		)

	set_meta(
		"vehicle_market_panel_surface_deck_default_key",
		default_surface_key
	)

	var desired_surface_key: String = str(
		vehicle_market_panel_active_surface_key
	).strip_edges()

	if not vehicle_market_panel_surface_deck.has(
		desired_surface_key
	):
		desired_surface_key = default_surface_key

	if (
		vehicle_market_open
		and desired_surface_key != ""
	):
		call_deferred(
			"_activate_vehicle_market_panel_surface",
			desired_surface_key
		)
	elif (
		default_surface_key != ""
		and vehicle_market_panel_surface_deck.has(
			default_surface_key
		)
	):
		vehicle_market_panel = (
			vehicle_market_panel_surface_deck.get(
				default_surface_key
			) as VehicleMarketPanel
		)
		vehicle_market_panel_active_surface_key = (
			default_surface_key
		)

	set_meta(
		"vehicle_market_surface_deck_prewarmed",
		true
	)
	set_meta(
		"vehicle_market_surface_deck_prewarmed_actor_id",
		target_actor_id
	)
	set_meta(
		"vehicle_market_surface_deck_prewarmed_surface_count",
		vehicle_market_panel_surface_deck.size()
	)
	set_meta(
		"vehicle_market_surface_deck_prewarmed_reason",
		reason
	)
	set_meta(
		"vehicle_market_dealership_click_build_forbidden",
		true
	)
	set_meta(
		"vehicle_market_selector_is_resident_surface",
		vehicle_market_panel_surface_deck.has(
			"selector"
		)
	)


func _activate_vehicle_market_panel_surface(
	surface_key: String
) -> bool:
	var clean_surface_key: String = str(
		surface_key
	).strip_edges()

	if clean_surface_key == "":
		return false

	var panel: VehicleMarketPanel = (
		vehicle_market_panel_surface_deck.get(
			clean_surface_key,
			null
		) as VehicleMarketPanel
	)

	if (
		panel == null
		or not is_instance_valid(panel)
	):
		return false

	var expected_actor_id: int = (
		int(gs.player.id)
		if gs != null and gs.player != null
		else -1
	)
	var panel_actor_id: int = int(
		panel.get_meta(
			"prepainted_actor_id",
			panel.active_contract.get(
				"actor_id",
				-1
			)
		)
	)

	if (
		expected_actor_id > 0
		and panel_actor_id > 0
		and panel_actor_id != expected_actor_id
	):
		set_meta(
			"vehicle_market_surface_activation_rejected_stale_actor",
			true
		)
		set_meta(
			"vehicle_market_surface_activation_expected_actor_id",
			expected_actor_id
		)
		set_meta(
			"vehicle_market_surface_activation_panel_actor_id",
			panel_actor_id
		)
		set_meta(
			"vehicle_market_surface_activation_click_build_performed",
			false
		)
		return false



	var previous_panel: VehicleMarketPanel = (
		vehicle_market_panel
	)

	if (
		previous_panel != null
		and is_instance_valid(
			previous_panel
		)
		and previous_panel != panel
	):
		previous_panel.visible = false
		previous_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	for raw_key in vehicle_market_panel_surface_deck.keys():
		var deck_panel: VehicleMarketPanel = (
			vehicle_market_panel_surface_deck.get(
				raw_key,
				null
			) as VehicleMarketPanel
		)

		if (
			deck_panel == null
			or not is_instance_valid(
				deck_panel
			)
		):
			continue

		deck_panel.visible = false
		deck_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	vehicle_market_panel = panel
	vehicle_market_panel_active_surface_key = (
		clean_surface_key
	)
	vehicle_market_open = true

	panel.visible = true
	panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	panel.z_as_relative = false
	panel.z_index = 245

	var panel_parent: Node = panel.get_parent()

	if panel_parent != null:
		panel_parent.move_child(
			panel,
			panel_parent.get_child_count() - 1
		)

	_claim_interactive_surface_authority(
		panel,
		"vehicle_market_contract_panel:%s"
		% clean_surface_key,
		"activate_prepainted_vehicle_market_surface",
		true,
		true
	)

	set_meta(
		"vehicle_market_surface_activated",
		true
	)
	set_meta(
		"vehicle_market_surface_activated_key",
		clean_surface_key
	)
	set_meta(
		"vehicle_market_surface_activated_actor_id",
		expected_actor_id
	)
	set_meta(
		"vehicle_market_surface_activation_retired_previous_panel",
		previous_panel != null
		and previous_panel != panel
	)
	set_meta(
		"vehicle_market_surface_activation_click_build_performed",
		false
	)
	set_meta(
		"vehicle_market_surface_activation_engine_calls",
		false
	)

	return true
func _on_vehicle_market_listing_action_requested(
	listing_id: String,
	action_id: String,
	action_context: Dictionary = {}
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var clean_action_id: String = str(
		action_id
	).strip_edges()
	var clean_listing_id: String = str(
		listing_id
	).strip_edges()
	var payload: Dictionary = (
		action_context.duplicate(false)
	)



	payload [
		"listing_id"
	] = clean_listing_id
	payload [
		"market_action"
	] = clean_action_id
	payload [
		"source"
	] = "mainscene.vehicle_market_panel"

	if clean_action_id == "select_dealership":
		var dealership_id: String = (
			clean_listing_id.trim_prefix(
				"dealership:"
			)
		)
		var surface_key: String = (
			"dealership:%s" % dealership_id
		)

		if _activate_vehicle_market_panel_surface(
			surface_key
		):
			return




		set_meta(
			"vehicle_dealership_surface_invariant_failed",
			true
		)
		set_meta(
			"vehicle_dealership_click_build_performed",
			false
		)
		set_meta(
			"vehicle_dealership_click_engine_calls_for_render",
			false
		)

	if clean_action_id == "clear_dealership":
		if _activate_vehicle_market_panel_surface(
			"selector"
		):
			return

	payload [
		"surface_refresh_required"
	] = clean_action_id in [
		"select_dealership",
		"clear_dealership"
	]

	if (
		vehicle_market_panel != null
		and is_instance_valid(
			vehicle_market_panel
		)
		and vehicle_market_panel.status_label != null
	):
		vehicle_market_panel.status_label.text = (
			"Committing vehicle transaction without blocking this dealership…"
		)

	set_meta(
		"vehicle_market_action_input_latched",
		true
	)
	set_meta(
		"vehicle_market_action_engine_work_on_input_frame",
		false
	)
	set_meta(
		"vehicle_market_action_surface_rebuild_performed",
		false
	)

	call_deferred(
		"_commit_vehicle_market_listing_action_deferred",
		clean_listing_id,
		clean_action_id,
		payload
	)

	return
func _commit_vehicle_market_listing_action_deferred(
	_listing_id: String,
	action_id: String,
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	set_meta(
		"action_result_return_surface_id",
		"vehicle_market_contract_panel"
	)

	var report: Dictionary = _express_global_ui_intent({
		"intent_type": "vehicle_market_listing_action",
		"surface_id": "vehicle_market_contract_panel",
		"action_id": action_id,
		"payload": payload.duplicate(false),
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"dealership_contract_engine"
			),
			"method": "commit_listing_action",
			"pass_actor_payload": true
		},
		"source": "mainscene.vehicle_market_panel"
	}, {
		"source": "mainscene.vehicle_market_panel",
		"surface_id": "vehicle_market_contract_panel",
		"action_id": action_id
	})

	var result: Dictionary = _market_panel_route_result(
		report
	)
	var returned_surface: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"surface_contract",
			{}
		)
	)
	var surface_refresh_required: bool = bool(
		result.get(
			"surface_refresh_required",
			false
		)
	)

	if (
		surface_refresh_required
		and not returned_surface.is_empty()
		and MainSceneLogic._market_surface_contract_is_renderable(
			returned_surface,
			"vehicle"
		)
		and vehicle_market_panel != null
		and is_instance_valid(
			vehicle_market_panel
		)
	):
		vehicle_market_panel.render_surface_contract(
			returned_surface
		)
		vehicle_market_panel.set_meta(
			"prepainted_actor_id",
			int(
				gs.player.id
			)
		)

	if not result.is_empty():
		_maybe_show_action_result_popup(
			result
		)

	var mutation_committed: bool = (
		bool(
			result.get(
				"success",
				false
			)
		)
		and action_id in [
			"buy_vehicle",
			"finance_vehicle",
			"lease_vehicle"
		]
	)

	if mutation_committed:
		call_deferred(
			"_queue_post_market_asset_observability",
			"vehicle",
			int(
				gs.player.id
			)
		)

	set_meta(
		"vehicle_market_action_surface_rebuild_performed",
		false
	)
	set_meta(
		"vehicle_market_action_force_asset_prewarm",
		false
	)
	set_meta(
		"vehicle_market_portfolio_reconcile_pending",
		mutation_committed
	)
func _queue_post_market_asset_observability(
	asset_domain: String,
	actor_id: int
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(gs.player.id) != actor_id
	):
		return

	var clean_domain: String = str(
		asset_domain
	).strip_edges().to_lower()




	if clean_domain == "property":
		_queue_auxiliary_surface_observation_task(
			"property_destination_surface_deck",
			actor_id,
			"property_purchase_destination_truth"
		)

	_queue_auxiliary_surface_observation_task(
		"compact_assets_surface",
		actor_id,
		"%s_purchase_portfolio_truth"
		% clean_domain
	)


	belongings_hud_content_dirty = true

	set_meta(
		"post_market_purchase_asset_domain",
		clean_domain
	)
	set_meta(
		"post_market_purchase_progressive_observability",
		true
	)
	set_meta(
		"post_market_purchase_ui_blocked",
		false
	)
	set_meta(
		"post_market_purchase_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _restore_market_surface_after_action_result() -> void:
	var return_surface_id: String = str(
		get_meta(
			"action_result_return_surface_id",
			""
		)
	).strip_edges()
	var return_surface: Control = null

	match return_surface_id:
		"property_market_contract_panel":
			if (
				property_market_panel != null
				and is_instance_valid(
					property_market_panel
				)
			):
				return_surface = property_market_panel
		"vehicle_market_contract_panel":
			if (
				vehicle_market_panel != null
				and is_instance_valid(
					vehicle_market_panel
				)
			):
				return_surface = vehicle_market_panel
		"assets_contract_panel":
			if (
				assets_panel != null
				and is_instance_valid(
					assets_panel
				)
			):
				return_surface = assets_panel

	if return_surface == null:
		return

	return_surface.visible = true
	return_surface.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	return_surface.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)

	_claim_interactive_surface_authority(
		return_surface,
		return_surface_id,
		"action_result_popup_closed_restore_market_surface",
		true,
		true
	)

	set_meta(
		"action_result_market_surface_restored",
		true
	)
	set_meta(
		"action_result_market_surface_restored_at_ms",
		int(Time.get_ticks_msec())
	)
	remove_meta(
		"action_result_return_surface_id"
	)
func _property_spatial_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var cursor: Dictionary = report
	var last_nonempty: Dictionary = report

	for _index in range(12):
		if cursor.is_empty():
			break

		last_nonempty = cursor

		if (
			cursor.has(
				"surface_delta_contract"
			)
			or cursor.has(
				"spatial_traversal_report"
			)
			or str(
				cursor.get(
					"commit_authority",
					""
				)
			) == (
				"eralife.spatial_traversal_contract_engine"
			)
		):
			return cursor.duplicate(false)

		var found_nested: bool = false

		for key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = (
				cursor.get(
					key,
					{}
				)
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			cursor = nested
			found_nested = true
			break

		if found_nested:
			continue

		if (
			cursor.has(
				"success"
			)
			and (
				cursor.has(
					"text"
				)
				or cursor.has(
					"narrative"
				)
			)
		):
			return cursor.duplicate(false)

		break

	return last_nonempty.duplicate(false)
func _market_panel_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var cursor: Dictionary = report
	var last_nonempty: Dictionary = report

	for _i in range(12):
		if cursor.is_empty():
			break

		last_nonempty = cursor


		if cursor.has(
			"surface_contract"
		):
			return cursor.duplicate(false)




		var found_nested: bool = false

		for key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				key,
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			cursor = nested
			found_nested = true
			break

		if found_nested:
			continue



		if (
			cursor.has(
				"popup_text"
			)
			or cursor.has(
				"text"
			)
			or cursor.has(
				"committed"
			)
		):
			return cursor.duplicate(false)

		break

	return last_nonempty.duplicate(false)
