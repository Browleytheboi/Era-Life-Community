func _other_country_resolve_native_element(
	entry: Dictionary,
	realm: Dictionary
) -> String:
	var native_element: String = str(
		entry.get(
			"native_element",
			realm.get(
				"native_element",
				""
			)
		)
	).strip_edges().to_lower()

	if native_element in [
		"air",
		"water",
		"earth",
		"fire"
	]:
		return native_element

	var browser_visual_theme: String = str(
		realm.get(
			"browser_visual_theme",
			""
		)
	).strip_edges().to_lower()

	if browser_visual_theme.begins_with(
		"elemental_"
	):
		var browser_element: String = (
			browser_visual_theme.trim_prefix(
				"elemental_"
			)
		)

		if browser_element in [
			"air",
			"water",
			"earth",
			"fire"
		]:
			return browser_element

	var overview_visual_theme: String = str(
		realm.get(
			"overview_visual_theme",
			""
		)
	).strip_edges().to_lower()

	if overview_visual_theme.begins_with(
		"elemental_"
	):
		var overview_element: String = (
			overview_visual_theme.trim_prefix(
				"elemental_"
			)
		)

		if overview_element in [
			"air",
			"water",
			"earth",
			"fire"
		]:
			return overview_element

	var lower_name: String = str(
		entry.get(
			"name",
			realm.get(
				"name",
				""
			)
		)
	).strip_edges().to_lower()

	if lower_name.find(
		"earth kingdom"
	) >= 0:
		return "earth"

	if lower_name.find(
		"fire nation"
	) >= 0:
		return "fire"

	if lower_name.find(
		"water tribe"
	) >= 0:
		return "water"

	if (
		lower_name.find(
			"air temple"
		) >= 0
		or lower_name.find(
			"air nomads"
		) >= 0
	):
		return "air"

	return ""

func _build_other_country_ordinary_era_palette() -> Dictionary:
	var theme_key: String = _current_era_ui_theme_key()
	var data: Dictionary = MainSceneHelpers._era_surface_theme_data(theme_key, "main")

	var card_bg: Color = data.get("bg", Color(0.08, 0.12, 0.2, 0.92))
	var card_hover_bg: Color = data.get("hover_bg", card_bg.lightened(0.08))
	var border_color: Color = data.get("border", Color(0.84, 0.9, 1.0, 0.28))
	var hover_border_color: Color = data.get("hover_border", border_color.lightened(0.1))
	var glow_color: Color = data.get("glow", Color(0.6, 0.74, 1.0, 0.16))
	var hover_glow_color: Color = data.get("hover_glow", glow_color.lightened(0.1))

	card_bg.a = clampf(max(card_bg.a, 0.92), 0.0, 1.0)
	card_hover_bg.a = clampf(max(card_hover_bg.a, 0.96), 0.0, 1.0)
	border_color.a = clampf(max(border_color.a, 0.34), 0.0, 1.0)
	hover_border_color.a = clampf(max(hover_border_color.a, 0.52), 0.0, 1.0)
	glow_color.a = clampf(max(glow_color.a, 0.16), 0.0, 1.0)
	hover_glow_color.a = clampf(max(hover_glow_color.a, 0.28), 0.0, 1.0)

	var header_bg: Color = card_hover_bg.lerp(Color(1.0, 1.0, 1.0, card_hover_bg.a), 0.04)
	var button_bg: Color = card_bg.lerp(card_hover_bg, 0.34)

	return {
		"theme_key": theme_key,
		"card_bg": card_bg,
		"card_border": border_color,
		"card_shadow": glow_color,
		"card_shadow_size": max(10, int(data.get("glow_size", 8))),
		"header_bg": header_bg,
		"header_border": hover_border_color,
		"header_shadow": hover_glow_color,
		"header_shadow_size": max(12, int(data.get("hover_glow_size", 14))),
		"button_bg": button_bg,
		"button_border": border_color,
		"button_shadow": glow_color,
		"button_shadow_size": max(8, int(data.get("glow_size", 8))),
		"hover_bg": card_hover_bg,
		"hover_border": hover_border_color,
		"hover_shadow": hover_glow_color,
		"hover_shadow_size": max(14, int(data.get("hover_glow_size", 14))),
		"header_font": Color(0.96, 0.98, 1.0, 0.98),
		"summary_font": Color(0.88, 0.93, 1.0, 0.9)
	}

