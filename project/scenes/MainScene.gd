func _hide_artifact_target_popup() -> void:
	if belongings_item_target_popup_dim != null:
		belongings_item_target_popup_dim.visible = false
	if belongings_item_target_popup != null:
		belongings_item_target_popup.visible = false
	belongings_item_target_popup_item = {}
	belongings_item_target_popup_action_name = ""
	belongings_item_target_popup_selected_wish = ""

func _show_artifact_target_picker(item: Dictionary, action_name: String) -> void:
	_ensure_artifact_target_popup()
	if belongings_item_target_popup == null or belongings_item_target_popup_list == null:
		return
	if gs == null or gs.player == null:
		return

	belongings_item_target_popup_item = item.duplicate(true)
	belongings_item_target_popup_action_name = action_name

	var item_name: String = str(item.get("name", "")).strip_edges()
	var lower_action: String = str(action_name).strip_edges().to_lower()
	var is_red_bonnet_make_wish: bool = item_name == "Red Bonnet" and lower_action == "make wish"
	var is_red_bonnet_selected_wish: bool = item_name == "Red Bonnet" and action_name.begins_with("Wish::")
	var selected_wish: String = ""




	var wish_names: Array = MainSceneHelpers._safe_array(
		item.get(
			"available_wishes",
			[]
		)
	)
	var wish_rows: Array = MainSceneHelpers._safe_array(
		item.get(
			"wish_rows",
			[]
		)
	)
	var wish_requirement_index: Dictionary = {}

	for raw_wish_row in wish_rows:
		if typeof(raw_wish_row) != TYPE_DICTIONARY:
			continue

		var wish_row: Dictionary = (
			raw_wish_row as Dictionary
		).duplicate(true)
		var projected_wish_name: String = str(
			wish_row.get(
				"wish_name",
				wish_row.get(
					"name",
					""
				)
			)
		).strip_edges()

		if projected_wish_name == "":
			continue

		wish_requirement_index [
			projected_wish_name.to_lower()
		] = bool(
			wish_row.get(
				"requires_target",
				false
			)
		)



		if wish_names.find(projected_wish_name) < 0:
			wish_names.append(projected_wish_name)

	if is_red_bonnet_selected_wish:
		selected_wish = action_name.replace("Wish::", "").strip_edges()
		belongings_item_target_popup_selected_wish = selected_wish
	else:
		belongings_item_target_popup_selected_wish = ""

	_clear_container_children(belongings_item_target_popup_list)

	var back_btn:= Button.new()
