	return firewall.filter_runtime_bool(key, value, source)


func _god_mode_scenario_bool(key: String, fallback: bool = false, source: String = "scenario_read") -> bool:
	if gs == null or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return fallback

	var firewall:= _ensure_god_mode_runtime_firewall_engine()
	if firewall == null:
