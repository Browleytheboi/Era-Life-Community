				"renderer_breathing_interval_ms": 75,
				"prewarm_press_may_not_construct_chassis": true
			},
			"mainscene.ready_prime_residency_pool"
		)
	)

	set_meta(
		"reality_residency_pool_prime_started",
		bool(
			prime_report.get(
				"success",
				false
			)
		)
	)
	set_meta(
		"reality_residency_pool_prime_report",
		prime_report.duplicate(true)
	)

	gs.scenario_state [
		"reality_residency_service_yields_to_interactive_lens"
	] = false
	gs.scenario_state [
		"reality_residency_interactive_lens_has_absolute_priority"
	] = false
	gs.scenario_state [
		"reality_residency_renderer_breathing_interval_ms"
	] = 75
	gs.scenario_state [
		"prewarm_press_may_not_construct_chassis"
	] = true
func _prime_live_diagnostics_panel_after_startup_intro_glyph() -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame
	await tree.process_frame

	if startup_intro_exiting:
		return

	while startup_intro_overlay != null and is_instance_valid(startup_intro_overlay) and startup_intro_overlay.visible and not startup_intro_accepting_input:
		await tree.process_frame
		if startup_intro_exiting:
			return

	if startup_intro_exiting:
		return

	set_meta("startup_intro_live_diagnostics_deferred_until_glyph", true)
	set_meta("startup_intro_live_diagnostics_deferred_until_glyph_at_ms", int(Time.get_ticks_msec()))
	set_meta("startup_intro_live_diagnostics_waited_for_stable_intro_surface", true)

	call_deferred("_prime_live_diagnostics_panel_after_startup_intro_surface_settled")

func _prime_live_diagnostics_panel_after_startup_intro_surface_settled() -> void:
	var tree:= get_tree()
	if tree != null:
		await tree.process_frame
		await tree.process_frame

	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay) and startup_intro_overlay.visible and not startup_intro_accepting_input:
		call_deferred("_prime_live_diagnostics_panel_after_startup_intro_surface_settled")
		return

