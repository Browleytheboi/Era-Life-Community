func _read_superpower_sandbox_panel_config() -> Dictionary:
	if superpower_sandbox_panel == null or not is_instance_valid(superpower_sandbox_panel):
		return {}

	var scope_picker:= superpower_sandbox_panel.get_meta("scope_picker", null) as OptionButton
	var target_group_input:= superpower_sandbox_panel.get_meta("target_group_input", null) as LineEdit
	var origin_picker:= superpower_sandbox_panel.get_meta("origin_picker", null) as OptionButton
	var power_picker:= superpower_sandbox_panel.get_meta("power_picker", null) as OptionButton
	var rarity_picker:= superpower_sandbox_panel.get_meta("rarity_picker", null) as OptionButton
	var identity_picker:= superpower_sandbox_panel.get_meta("identity_picker", null) as OptionButton
	var awakening_mode_picker:= superpower_sandbox_panel.get_meta("awakening_mode_picker", null) as OptionButton
	var inheritance_mode_picker:= superpower_sandbox_panel.get_meta("inheritance_mode_picker", null) as OptionButton
	var min_age_spin:= superpower_sandbox_panel.get_meta("min_age_spin", null) as SpinBox
	var trauma_toggle:= superpower_sandbox_panel.get_meta("trauma_toggle", null) as CheckBox
	var age_13_toggle:= superpower_sandbox_panel.get_meta("age_13_toggle", null) as CheckBox
	var firstborn_toggle:= superpower_sandbox_panel.get_meta("firstborn_toggle", null) as CheckBox
	var bender_only_toggle:= superpower_sandbox_panel.get_meta("bender_only_toggle", null) as CheckBox
	var corrupt_toggle:= superpower_sandbox_panel.get_meta("corrupt_toggle", null) as CheckBox

	var out:= _build_default_superpower_sandbox_config()
	out ["scope"] = MainSceneHelpers._selected_superpower_option_value(scope_picker, "only_me")
	out ["target_group"] = target_group_input.text.strip_edges() if target_group_input != null else ""
	out ["origin"] = MainSceneHelpers._selected_superpower_option_value(origin_picker, "born_hidden")
	out ["primary_power"] = MainSceneHelpers._selected_superpower_option_value(power_picker, "super_strength")
	out ["rarity"] = MainSceneHelpers._selected_superpower_option_value(rarity_picker, "rare")
	out ["public_identity"] = MainSceneHelpers._selected_superpower_option_value(identity_picker, "secret")

	var awakening: Dictionary = out ["awakening"]
	awakening ["mode"] = MainSceneHelpers._selected_superpower_option_value(awakening_mode_picker, "latent")
	awakening ["minimum_age"] = int(min_age_spin.value) if min_age_spin != null else 0
	awakening ["public_visibility"] = str(out ["public_identity"])
	if awakening ["mode"] == "awoken_at_birth":
		awakening ["minimum_age"] = 0
	out ["awakening"] = awakening

	var inheritance: Dictionary = out ["inheritance"]
	inheritance ["mode"] = MainSceneHelpers._selected_superpower_option_value(inheritance_mode_picker, "dominant")
	inheritance ["skips_generations"] = inheritance ["mode"] == "skip_generations"
	inheritance ["awakens_under_trauma"] = trauma_toggle.button_pressed if trauma_toggle != null else false
	inheritance ["awakens_at_age_13"] = age_13_toggle.button_pressed if age_13_toggle != null else false
	inheritance ["only_firstborn"] = firstborn_toggle.button_pressed if firstborn_toggle != null else false
	inheritance ["only_avatars_benders"] = bender_only_toggle.button_pressed if bender_only_toggle != null else false
	inheritance ["corrupts_bloodline_over_time"] = corrupt_toggle.button_pressed if corrupt_toggle != null else false
	inheritance ["generation_strength_loss"] = 0.18 if bool(inheritance ["corrupts_bloodline_over_time"]) else 0.0
	inheritance ["mutation_chance"] = 0.07
	out ["inheritance"] = inheritance
	var mutation_genes: Dictionary = _superpower_hub_safe_dictionary(out.get("mutation_genes", {}))
	mutation_genes ["enabled"] = bool(inheritance.get("only_avatars_benders", false)) or bool(inheritance.get("corrupts_bloodline_over_time", false))
	mutation_genes ["auto_enable_when_bender_power_mix"] = true
	mutation_genes ["intentional_use_requires_bending_moves"] = true
	mutation_genes ["uncontrolled_age_up_risk"] = true
	mutation_genes ["age_up_instability_chance"] = 0.12 if bool(mutation_genes.get("enabled", false)) else 0.0
	out ["mutation_genes"] = mutation_genes
	var public_identity_id: String = str(out.get("public_identity", "secret")).strip_edges().to_lower()
	if public_identity_id == "government_experiment":
		var scope_id: String = str(out.get("scope", "only_me")).strip_edges().to_lower()
		if scope_id not in ["only_me", "whole_family", "my_bloodline"]:
			scope_id = "only_me"
		out ["scope"] = scope_id
		out ["origin"] = "experiment_surgery"

		var forced_awakening: Dictionary = _superpower_hub_safe_dictionary(out.get("awakening", {}))
		forced_awakening ["public_visibility"] = "government_file"
		out ["awakening"] = forced_awakening
	return out


func _on_superpower_sandbox_button_pressed() -> void:
	if not _god_mode_superpower_sandbox_enabled():
		return

	_ensure_superpower_sandbox_panel()
	_fill_superpower_sandbox_panel_from_config(_active_superpower_sandbox_config())

	if superpower_sandbox_panel != null:
		superpower_sandbox_panel.visible = true
		superpower_sandbox_panel.move_to_front()


func _on_superpower_sandbox_apply_pressed() -> void:
	superpower_sandbox_config = _read_superpower_sandbox_panel_config()
	_refresh_superpower_sandbox_button_state()
	_refresh_god_mode_preview_label()
	_play_superpower_apply_burst_and_close()
func _play_superpower_apply_burst_and_close() -> void:
	if superpower_sandbox_panel == null or not is_instance_valid(superpower_sandbox_panel):
		return

	var apply_button:= superpower_sandbox_panel.get_meta("apply_button", null) as Button
	if apply_button == null or not is_instance_valid(apply_button):
		superpower_sandbox_panel.visible = false
		return

	apply_button.disabled = true
	apply_button.pivot_offset = apply_button.size * 0.5

	var tween:= create_tween().bind_node(apply_button)
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_property(apply_button, "scale", Vector2(1.16, 1.16), 0.1)
	tween.parallel().tween_property(apply_button, "modulate", Color(1.0, 0.78, 1.0, 1.0), 0.1)
	tween.tween_property(apply_button, "scale", Vector2(0.98, 0.98), 0.08)
	tween.parallel().tween_property(apply_button, "modulate", Color(0.78, 0.92, 1.0, 1.0), 0.08)
	tween.tween_property(apply_button, "scale", Vector2.ONE, 0.12)
	tween.parallel().tween_property(apply_button, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.12)
	tween.tween_callback(func () -> void:
		if superpower_sandbox_panel != null and is_instance_valid(superpower_sandbox_panel):
			superpower_sandbox_panel.visible = false
		if apply_button != null and is_instance_valid(apply_button):
			apply_button.disabled = false
	)


func _on_superpower_sandbox_clear_pressed() -> void:
	superpower_sandbox_config = null
	_refresh_superpower_sandbox_button_state()
	_refresh_god_mode_preview_label()

	if superpower_sandbox_panel != null:
		superpower_sandbox_panel.visible = false


func _on_superpower_sandbox_close_pressed() -> void:
	if superpower_sandbox_panel != null:
		superpower_sandbox_panel.visible = false
