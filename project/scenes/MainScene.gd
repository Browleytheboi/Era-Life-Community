	hover.corner_radius_top_left = 8
	hover.corner_radius_top_right = 8
	hover.corner_radius_bottom_right = 8
	hover.corner_radius_bottom_left = 8
	hover.content_margin_left = 8
	hover.content_margin_top = 4
	hover.content_margin_right = 8
	hover.content_margin_bottom = 4
	popup.add_theme_stylebox_override("hover", hover)

	popup.add_theme_font_size_override("font_size", 15)
	popup.add_theme_color_override("font_color", Color(body.r, body.g, body.b, 1.0))
	popup.add_theme_color_override("font_hover_color", Color(1.0, 0.98, 0.9, 1.0))
	popup.add_theme_color_override("font_pressed_color", Color(1.0, 0.98, 0.9, 1.0))
	popup.add_theme_color_override("font_separator_color", Color(accent.r, accent.g, accent.b, 0.68))
	popup.set_meta("god_mode_popup_palette_signature", _current_god_mode_palette_signature())
	popup.set_meta("god_mode_popup_styled_at_ms", int(Time.get_ticks_msec()))

