		popup.visible = false
		popup.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	set_meta(
		"grocery_aisle_shoppers_popup_open",
		false
	)
	set_meta(
		"grocery_aisle_shoppers_popup_last_refresh_ms",
		0
