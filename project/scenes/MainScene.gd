func _relationship_hub_hot_packet_for_context(context: Dictionary, reason: String = "relationship_hot_path") -> Dictionary:
	var clean_panel: String = "relationships"
	var packet: Dictionary = _main_tab_hot_packet_for_context(clean_panel, context)
	if MainSceneLogic._main_tab_packet_is_renderable(packet):
		packet ["relationship_hub_packet_mode"] = "hot_cache"
		packet ["relationship_hub_render_mode"] = "full_surface_immediate"
		packet ["relationship_hub_deeper_truth_pending"] = false
		packet ["relationship_hub_press_frame_build_forbidden"] = true
		return packet

	var synthesized: Dictionary = _main_tab_synthesized_packet(clean_panel, context)
	synthesized ["relationship_hub_packet_mode"] = "synthesized_safe_packet"
	synthesized ["relationship_hub_render_mode"] = "full_surface_immediate"
	synthesized ["relationship_hub_deeper_truth_pending"] = true
	synthesized ["relationship_hub_press_frame_build_forbidden"] = true
	synthesized ["relationship_hub_packet_build_deferred"] = true
	_store_main_tab_hot_packet(clean_panel, synthesized, context)
	call_deferred("_prewarm_main_tab_ui_packet", clean_panel, "%s_deferred_packet_build" % reason)
	return synthesized

func _relationship_hub_render_hot_shell(packet: Dictionary, section: String = "family", reason: String = "relationship_hot_shell") -> void:
	_ensure_institution_hub_overlay()
	if institution_hub_overlay == null:
		return

	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)
	var packet_mode: String = str(packet.get("relationship_hub_packet_mode", packet.get("stability_tier", "hot_packet"))).strip_edges()

	var engine: RelationshipsHubContractEngine = _ensure_relationships_hub_contract_engine()
	var hub_contract: Dictionary = MainSceneHelpers._safe_dictionary(packet.get("relationships_hub_contract", {}))
	if hub_contract.is_empty() and engine != null and gs != null and gs.player != null:
		hub_contract = engine.emit_hub_contract(gs.player, {
			"source": "mainscene.relationship_hub_render_hot_shell",
			"active_section_id": clean_section,
			"packet_mode": packet_mode,
			"reason": reason
		})

	packet ["relationships_hub_contract"] = hub_contract.duplicate(true)
	set_meta("relationships_hub_active_contract", hub_contract.duplicate(true))
	set_meta("relationships_hub_contract_engine_active", true)

	_relationship_hub_begin_navigation_perf_window(reason, 760)
	_relationship_hub_trim_visual_style_cache()

	current_panel = "relationships"
	institution_hub_kind = "relationships"
	institution_hub_current_section = clean_section
	institution_hub_open = true
	institution_hub_overlay.visible = true
	institution_hub_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	_mark_institution_hub_rendered_surface_owner("relationships", clean_section, "%s_hot_shell" % reason)
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("relationship_hub_hot_shell_active", false)
	set_meta("relationship_hub_full_surface_hot_rendered", true)
	set_meta("relationship_hub_hot_render_reason", reason)
	set_meta("relationship_hub_hot_render_section", clean_section)
	set_meta("relationship_hub_hot_render_packet_mode", packet_mode)
	set_meta("relationship_hub_hot_render_opened_ms", now_ms)
	set_meta("relationship_hub_first_open_input_ready", true)
	set_meta("relationship_hub_first_open_input_ready_ms", now_ms)
	set_meta("relationship_hub_pending_section_render", "")
	set_meta("relationship_hub_pending_section_render_ms", 0)

	_relationship_hub_mark_first_open_free_scroll_window(reason, 1120)

	_refresh_institution_hub()
	_relationship_hub_apply_scroll_runtime_contract()

	if institution_hub_status_label != null:
		institution_hub_status_label.text = "Relationship surface is live. Packet: %s. Deeper truth is reconciling behind the renderer." % packet_mode

	_bring_modal_to_front(institution_hub_overlay)

func _relationship_hub_schedule_deeper_truth_refresh(section: String = "family", reason: String = "relationship_deeper_truth") -> void:
	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)
	var ticket: int = int(Time.get_ticks_msec())

	set_meta("relationship_hub_deeper_refresh_ticket", ticket)
	set_meta("relationship_hub_deeper_refresh_section", clean_section)
	set_meta("relationship_hub_deeper_refresh_reason", reason)

	call_deferred("_relationship_hub_deferred_deeper_truth_refresh", clean_section, reason, ticket)


func _relationship_hub_deferred_deeper_truth_refresh(section: String = "family", reason: String = "relationship_deeper_truth", ticket: int = 0, attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree != null:
		await tree.process_frame

	if not _relationship_hub_runtime_surface_active():
		return
	if int(get_meta("relationship_hub_deeper_refresh_ticket", -1)) != int(ticket):
		return

	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)
	if institution_hub_current_section != clean_section:
		return

	var first_open_scroll_window: bool = _relationship_hub_first_open_scroll_grace_active()
	var scroll_recent: bool = _institution_hub_scroll_is_recently_active()

	if (first_open_scroll_window or scroll_recent) and attempt < 12:
		set_meta("relationship_hub_deeper_refresh_waiting_for_scroll_idle", true)
		set_meta("relationship_hub_deeper_refresh_scroll_wait_reason", reason)
		set_meta("relationship_hub_deeper_refresh_scroll_wait_attempt", attempt)
		set_meta("relationship_hub_deeper_refresh_waiting_for_first_open_free_scroll", first_open_scroll_window)

		if tree != null:
			var retry_delay: float = 0.12 if first_open_scroll_window else 0.16
			var retry_timer:= tree.create_timer(retry_delay)
			retry_timer.timeout.connect(
				Callable(self, "_relationship_hub_deferred_deeper_truth_refresh").bind(clean_section, reason, ticket, attempt + 1),
				CONNECT_ONE_SHOT
			)
		else:
			call_deferred("_relationship_hub_deferred_deeper_truth_refresh", clean_section, reason, ticket, attempt + 1)
		return

	set_meta("relationship_hub_deeper_refresh_waiting_for_scroll_idle", false)
	set_meta("relationship_hub_deeper_refresh_waiting_for_first_open_free_scroll", false)

	_relationship_hub_background_reconcile_packet(clean_section, reason)
	_relationship_hub_refresh_runtime_visibility_cache(true)
	_relationship_hub_live_refresh_visible_cards(false)
	_relationship_hub_apply_scroll_runtime_contract()

	set_meta("relationship_hub_hot_shell_active", false)
	set_meta("relationship_hub_deeper_refresh_completed_reason", reason)
	set_meta("relationship_hub_deeper_refresh_completed_ms", int(Time.get_ticks_msec()))
func _relationship_hub_background_reconcile_packet(section: String = "family", reason: String = "relationship_deeper_truth") -> void:
	var clean_section: String = MainSceneLogic._relationship_hub_resolve_section_id(gs, section)
	var context: Dictionary = _relationship_hub_hot_packet_context(reason)
	context ["active_section_id"] = clean_section
	context ["background_reconciliation"] = true
	context ["must_not_block_render"] = true
	context ["relationship_contract_engine_authority"] = true
	context ["relationship_background_main_tab_rebuild_forbidden"] = true

	var engine: RelationshipsHubContractEngine = _ensure_relationships_hub_contract_engine()
	var hub_contract: Dictionary = {}

	if engine != null and gs != null and gs.player != null:
		hub_contract = engine.emit_hub_contract(gs.player, {
			"source": "mainscene.relationship_hub_background_reconcile_packet",
			"active_section_id": clean_section,
			"reason": reason,
			"background_reconciliation": true,
		})

	var safe_packet: Dictionary = _main_tab_synthesized_packet("relationships", context)
	safe_packet ["relationship_hub_packet_mode"] = "background_contract_reconciled"
	safe_packet ["relationship_hub_render_mode"] = "already_rendered"
	safe_packet ["relationship_hub_deeper_truth_pending"] = false
	safe_packet ["relationships_hub_contract"] = hub_contract.duplicate(true)
	safe_packet ["relationship_background_main_tab_rebuild_skipped"] = true

	_store_main_tab_hot_packet("relationships", safe_packet, context)
	set_meta("relationship_hub_last_background_packet_mode", "background_contract_reconciled")

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["relationships_hub_last_contract"] = hub_contract.duplicate(true)
		gs.scenario_state ["relationships_hub_contract_engine_background_reconciled"] = true
		gs.scenario_state ["relationships_hub_background_reconcile_no_main_tab_rebuild"] = true
		gs.scenario_state ["relationships_hub_background_reconcile_scroll_safe"] = true
		gs.scenario_state ["relationships_hub_contract_engine_background_reconciled_at_ms"] = int(Time.get_ticks_msec())

	set_meta("relationship_hub_last_background_packet_section", clean_section)
	set_meta("relationship_hub_last_background_packet_reason", reason)
	set_meta("relationship_hub_last_background_packet_ms", int(Time.get_ticks_msec()))
func _relationship_hub_mark_first_open_free_scroll_window(reason: String = "relationship_hub_open", duration_ms: int = 1100) -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var safe_duration: int = max(520, int(duration_ms))
	var until_ms: int = now_ms + safe_duration

	set_meta("relationship_hub_first_open_free_scroll_until_ms", until_ms)
	set_meta("relationship_hub_first_open_free_scroll_reason", reason)
	set_meta("relationship_hub_first_open_free_scroll_started_ms", now_ms)
	set_meta("relationship_hub_first_open_scroll_should_feel_unlocked", true)

	set_meta("relationship_hub_visibility_cache_next_ms", until_ms)
	set_meta("relationship_hub_next_live_card_refresh_ms", until_ms)
	set_meta("relationship_hub_deeper_refresh_free_scroll_gate_until_ms", now_ms + min(760, safe_duration))

	if institution_hub_scroll != null and is_instance_valid(institution_hub_scroll):
		institution_hub_scroll.set_meta("relationship_first_open_free_scroll_until_ms", until_ms)
		institution_hub_scroll.set_meta("relationship_first_open_free_scroll_reason", reason)
		institution_hub_scroll.set_meta("smooth_scroll_pending_first_open_delta", 0.0)
		institution_hub_scroll.set_meta("smooth_scroll_active", false)
		institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", now_ms)


func _relationship_hub_first_open_scroll_grace_active() -> bool:
	if str(institution_hub_kind).strip_edges().to_lower() != "relationships":
		return false
	if not institution_hub_open:
		return false

	var until_ms: int = int(get_meta("relationship_hub_first_open_free_scroll_until_ms", 0))
	if institution_hub_scroll != null and is_instance_valid(institution_hub_scroll):
		until_ms = max(until_ms, int(institution_hub_scroll.get_meta("relationship_first_open_free_scroll_until_ms", 0)))

	if until_ms <= 0:
		return false

	return int(Time.get_ticks_msec()) <= until_ms
func _relationship_hub_apply_scroll_runtime_contract() -> void:
	if institution_hub_scroll == null:
		return

	institution_hub_scroll.follow_focus = false
	institution_hub_scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	institution_hub_scroll.scroll_deadzone = 0

	if not institution_hub_scroll.has_meta("smooth_scroll_target"):
		institution_hub_scroll.set_meta("smooth_scroll_target", float(institution_hub_scroll.scroll_vertical))

	if not institution_hub_scroll.has_meta("smooth_scroll_active"):
		institution_hub_scroll.set_meta("smooth_scroll_active", false)

	if not institution_hub_scroll.has_meta("smooth_scroll_last_input_ms"):
		institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", 0)

	var vbar:= institution_hub_scroll.get_v_scroll_bar()
	var max_scroll: float = 0.0
	if vbar != null:
		max_scroll = max(0.0, float(vbar.max_value - vbar.page))

	var current_scroll: float = float(institution_hub_scroll.scroll_vertical)
	var active_scroll: bool = bool(institution_hub_scroll.get_meta("smooth_scroll_active", false))
	var scroll_recent: bool = _institution_hub_scroll_is_recently_active()
	var target_scroll: float = clamp(
		float(institution_hub_scroll.get_meta("smooth_scroll_target", current_scroll)),
		0.0,
		max_scroll
	)

	var pending_first_open_delta: float = float(institution_hub_scroll.get_meta("smooth_scroll_pending_first_open_delta", 0.0))
	if max_scroll > 0.0 and abs(pending_first_open_delta) > 0.01:
		target_scroll = clamp(current_scroll + pending_first_open_delta, 0.0, max_scroll)
		institution_hub_scroll.scroll_vertical = int(round(target_scroll))
		institution_hub_scroll.set_meta("smooth_scroll_pending_first_open_delta", 0.0)
		active_scroll = false
		scroll_recent = true

	if active_scroll or scroll_recent or _relationship_hub_first_open_scroll_grace_active():
		institution_hub_scroll.set_meta("smooth_scroll_target", target_scroll)
	else:
		institution_hub_scroll.set_meta("smooth_scroll_target", current_scroll)
		institution_hub_scroll.set_meta("smooth_scroll_active", false)

	institution_hub_scroll.set_meta("scroll_input_contract_ready", true)
	institution_hub_scroll.set_meta("scroll_input_contract_owner", "institution_hub_scroll")
	institution_hub_scroll.set_meta("scroll_input_contract_no_target_reset_during_input", true)
	institution_hub_scroll.set_meta("scroll_input_contract_first_open_free_scroll", _relationship_hub_first_open_scroll_grace_active())

	if vbar != null:
		vbar.step = 1.0
		vbar.custom_minimum_size = Vector2(12, 0)
		_style_institution_hub_scrollbar(vbar, true, 1.0)
func _institution_hub_input_point_inside_scroll(point: Vector2) -> bool:
	if institution_hub_scroll == null:
		return false
	if not is_instance_valid(institution_hub_scroll):
		return false

	var scroll_rect: Rect2 = institution_hub_scroll.get_global_rect()
	scroll_rect = scroll_rect.grow(18.0)
	return scroll_rect.has_point(point)


func _institution_hub_try_route_scroll_input(event: InputEvent, source: String = "scroll_input") -> bool:
	if event == null:
		return false
	if institution_hub_scroll == null:
		return false
	if not institution_hub_open:
		return false
	if not is_instance_valid(institution_hub_scroll):
		return false

	var clean_kind: String = str(institution_hub_kind).strip_edges().to_lower()
	var relationship_scroll: bool = clean_kind == "relationships"
	var first_open_free_scroll: bool = relationship_scroll and _relationship_hub_first_open_scroll_grace_active()

	var vbar:= institution_hub_scroll.get_v_scroll_bar()
	if vbar == null:
		return false

	var max_scroll: float = max(0.0, float(vbar.max_value - vbar.page))

	var current_value: float = float(institution_hub_scroll.scroll_vertical)
	var current_target: float = float(institution_hub_scroll.get_meta("smooth_scroll_target", current_value))
	if not bool(institution_hub_scroll.get_meta("smooth_scroll_active", false)):
		current_target = current_value

	current_target = clamp(current_target, 0.0, max_scroll)

	var next_target: float = current_target
	var pending_delta: float = 0.0
	var consumed: bool = false

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if not mouse_event.pressed:
			return false
		if mouse_event.button_index not in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
			return false
		if not _institution_hub_input_point_inside_scroll(mouse_event.position):
			return false

		var wheel_units: float = max(1.0, abs(float(mouse_event.factor)))
		var step: float = _institution_hub_smooth_scroll_step()
		if first_open_free_scroll:
			step *= 1.24

		match mouse_event.button_index:
			MOUSE_BUTTON_WHEEL_UP:
				pending_delta = - step * wheel_units
				next_target += pending_delta
				consumed = true
			MOUSE_BUTTON_WHEEL_DOWN:
				pending_delta = step * wheel_units
				next_target += pending_delta
				consumed = true

	elif event is InputEventPanGesture:
		var pan_event:= event as InputEventPanGesture
		if not _institution_hub_input_point_inside_scroll(pan_event.position):
			return false

		var pan_speed: float = 72.0 if relationship_scroll else 42.0
		if first_open_free_scroll:
			pan_speed = 94.0

		pending_delta = float(pan_event.delta.y) * pan_speed
		next_target += pending_delta
		consumed = true

	if not consumed:
		return false

	if max_scroll <= 0.0:
		if first_open_free_scroll:
			var stored_pending: float = float(institution_hub_scroll.get_meta("smooth_scroll_pending_first_open_delta", 0.0))
			institution_hub_scroll.set_meta("smooth_scroll_pending_first_open_delta", stored_pending + pending_delta)
			institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", int(Time.get_ticks_msec()))
			institution_hub_scroll.set_meta("smooth_scroll_last_input_source", source)
			institution_hub_scroll.set_meta("smooth_scroll_input_owned_this_frame", true)
			institution_hub_scroll_fade_hold = 0.42
			return true

		return false

	next_target = clamp(next_target, 0.0, max_scroll)

	var immediate_ratio: float = 1.0 if relationship_scroll else 0.82
	if first_open_free_scroll:
		immediate_ratio = 1.0

	var immediate_value: float = lerp(current_value, next_target, immediate_ratio)

	institution_hub_scroll.scroll_vertical = int(round(clamp(immediate_value, 0.0, max_scroll)))
	institution_hub_scroll.set_meta("smooth_scroll_target", next_target)
	institution_hub_scroll.set_meta("smooth_scroll_active", abs(next_target - float(institution_hub_scroll.scroll_vertical)) > 0.5)
	institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", int(Time.get_ticks_msec()))
	institution_hub_scroll.set_meta("smooth_scroll_last_input_source", source)
	institution_hub_scroll.set_meta("smooth_scroll_input_owned_this_frame", true)
	institution_hub_scroll.set_meta("smooth_scroll_first_open_free_scroll_active", first_open_free_scroll)

	institution_hub_scroll_fade_hold = 0.42 if first_open_free_scroll else 0.38

	if relationship_scroll:
		_relationship_hub_begin_navigation_perf_window("relationship_scroll_input_%s" % source, 520 if first_open_free_scroll else 360)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["institution_hub_scroll_input_owned_this_frame"] = true
		gs.scenario_state ["institution_hub_scroll_input_source"] = source
		gs.scenario_state ["institution_hub_scroll_input_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["relationship_hub_scroll_input_first_responder"] = relationship_scroll
		gs.scenario_state ["relationship_hub_first_open_free_scroll_active"] = first_open_free_scroll

	return true
func _on_institution_hub_scroll_gui_input(event: InputEvent) -> void:
