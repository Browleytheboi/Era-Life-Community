		clean_section = "family"

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"intent_type": (
				"relationships_hub_contract_intent"
			),
			"surface_id": "relationship_hub_panel",
			"action_id": "refresh",
			"payload": {
				"action_id": "refresh",
				"section_id": clean_section,
				"active_section_id": clean_section,
				"source": reason,
				"force_refresh": force_refresh,
				"ui_is_expression_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"relationships_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": int(
					actor.id
				)
			},
			"source": reason,
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"surface_id": "relationship_hub_panel",
			"action_id": "refresh",
			"source": reason
		}
	)
	var route_result: Dictionary = _contract_route_result(
		report
	)
	var result: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"result",
			route_result
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"hub_contract",
			route_result.get(
				"hub_contract",
				{}
			)
		)
	)
	var panel: RelationshipHubPanel = (
		_ensure_relationship_hub_panel()
	)

	if not contract.is_empty():
		relationships_hub_active_section_id = str(
			contract.get(
				"active_section_id",
				clean_section
			)
		).strip_edges().to_lower()

		panel.render_contract(
			contract
		)

	if reveal_surface:
		panel.show_surface()
		panel.z_as_relative = false
		panel.z_index = 250

		_bring_modal_to_front(
			panel
		)

	return route_result


