	relationship_profile_popup_switch_button.size_flags_horizontal = Control.SIZE_SHRINK_END
	relationship_profile_popup_switch_button.mouse_filter = Control.MOUSE_FILTER_STOP if switch_intent_allowed else Control.MOUSE_FILTER_IGNORE
	relationship_profile_popup_switch_button.focus_mode = Control.FOCUS_ALL if switch_intent_allowed else Control.FOCUS_NONE

	relationship_profile_popup_switch_button.set_meta("switch_zero_frame_packet_hot", switch_shell_hot)
	relationship_profile_popup_switch_button.set_meta("switch_pointer_fallback_allowed", target_alive)
	relationship_profile_popup_switch_button.set_meta("switch_button_is_intent_door_not_packet_gate", true)

