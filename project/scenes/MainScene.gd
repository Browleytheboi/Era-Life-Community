func _pet_shop_listing_category(
	listing: Dictionary
) -> String:
	var entity_kind: String = str(
		listing.get(
			"entity_kind",
			"animal"
		)
	).strip_edges().to_lower()
	var social_type: String = str(
		listing.get(
			"social_type",
			"companion"
		)
	).strip_edges().to_lower()
	var stats: Dictionary = MainSceneHelpers._safe_dictionary(
		listing.get(
			"stats",
			{}
		)
	)

	if (
		entity_kind == "mythical"
		or int(
			stats.get(
				"magic_attunement",
				0
			)
		) > 0
	):
		return "mythical"

	if social_type in [
		"herd",
		"livestock",
		"working",
		"guardian",
		"mount"
	]:
		return "working"

	if int(
		stats.get(
			"danger",
			0
		)
	) >= 5:
		return "exotic"

	return "companion"


func _institution_hub_surface_key(
	kind: String,
	section: String,
	actor_id: int = -1
) -> String:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	var resolved_actor_id: int = actor_id

	if (
		resolved_actor_id <= 0
		and gs != null
		and gs.player != null
	):
		resolved_actor_id = int(
			gs.player.id
		)

	var world_lens_key: String = str(
		_world_seed_ui_lens_key()
	).strip_edges()

	if world_lens_key == "":
		world_lens_key = "unbound"

	return "%s::%s::actor_%d::lens_%s" % [
		clean_kind,
		clean_section,
		resolved_actor_id,
		str(
			world_lens_key.hash()
		)
	]

func _capture_active_institution_hub_surface(
	kind: String,
	section: String
) -> Dictionary:
	if (
		institution_hub_overlay == null
		or not is_instance_valid(
			institution_hub_overlay
		)
	):
		return {}

	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_section: String = str(
		section
	).strip_edges().to_lower()

	if clean_section == "":
		clean_section = (
			"family"
			if clean_kind == "relationships"
			else "overview"
		)

	var actor_id: int = (
		int(
			gs.player.id
		)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)
	var world_lens_key: String = str(
		_world_seed_ui_lens_key()
	).strip_edges()

	if world_lens_key == "":
		world_lens_key = "unbound"

	var projection_child_count: int = (
		institution_hub_list.get_child_count()
		if (
			institution_hub_list != null
			and is_instance_valid(
				institution_hub_list
			)
		)
		else 0
	)
	var truth_state: String = str(
		institution_hub_overlay.get_meta(
			"institution_surface_truth_state",
			"observable_partial"
		)
	).strip_edges().to_lower()
	var hydrated: bool = bool(
		institution_hub_overlay.get_meta(
			"institution_surface_hydrated",
			false
		)
	)
	var projection_composed: bool = (
		projection_child_count > 0
		and bool(
			institution_hub_overlay.get_meta(
				"institution_surface_projection_composed",
				projection_child_count > 0
			)
		)
	)

	return {
		"surface_key": (
			_institution_hub_surface_key(
				clean_kind,
				clean_section,
				actor_id
			)
		),
		"kind": clean_kind,
		"section": clean_section,
		"actor_id": actor_id,
		"world_lens_key": world_lens_key,
		"world_lens_hash": str(
			world_lens_key.hash()
		),
		"projection_child_count": (
			projection_child_count
		),
		"projection_composed": (
			projection_composed
		),
		"projection_signature": (
			"%s:%s:%d:%s:%d:%s"
			% [
				clean_kind,
				clean_section,
				actor_id,
				str(
					world_lens_key.hash()
				),
				projection_child_count,
				truth_state
			]
		),
		"overlay": institution_hub_overlay,
		"dim": institution_hub_dim,
		"card": institution_hub_card,
		"back_button": (
			institution_hub_back_button
		),
		"title": institution_hub_title,
		"header_chip": (
			institution_hub_header_chip
		),
		"header_chip_label": (
			institution_hub_header_chip_label
		),
		"section_bar": (
			institution_hub_section_bar
		),
		"section_buttons": (
			institution_hub_section_buttons
		),
		"summary_label": (
			institution_hub_summary_label
		),
		"scroll": institution_hub_scroll,
		"list": institution_hub_list,
		"status_label": (
			institution_hub_status_label
		),
		"experience_rows": (
			institution_hub_experience_rows
		),
		"experience_breathe_time": (
			institution_hub_experience_breathe_time
		),
		"scroll_last_vertical": (
			institution_hub_scroll_last_vertical
		),
		"scroll_fade_hold": (
			institution_hub_scroll_fade_hold
		),
		"truth_state": truth_state,
		"hydrated": hydrated,
		"ui_is_renderer_only": true
	}
