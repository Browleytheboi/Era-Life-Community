	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.custom_minimum_size = Vector2(0, 15 if featured else 13)
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bar.set_meta("stat_surface_title", safe_title)
	bar.set_meta("stat_surface_context", effective_surface_context.duplicate(true))
	bar.set_meta("relationship_card_bar_born_hot", true)
	bar.set_meta("relationship_card_bar_target_value", safe_target)
	bar.set_meta("relationship_card_bar_zero_to_target_animation_forbidden", true)
	block.add_child(bar)

	var value_label:= Label.new()
	value_label.name = "ValueLabel"
