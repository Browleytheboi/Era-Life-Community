func _perform_red_bonnet_popup_action(wish_name: String) -> void:
	if gs == null or gs.player == null:
		return

	var clean_wish: String = str(
		wish_name
	).strip_edges().to_lower()

	if clean_wish == "":
		return

	var is_dragon_ball_summon: bool = (
		MainSceneHelpers._red_bonnet_wish_is_dragon_ball_summon(
			clean_wish
		)
	)
	var diary_snapshot: Dictionary = (
		_capture_player_diary_snapshot()
	)

	_hide_artifact_target_popup()

	if is_dragon_ball_summon:
		var transition_packet: Dictionary = (
			_express_artifact_interaction_intent(
				"build_dragon_ball_summon_transition",
				{
					"wish_key": clean_wish,
					"source": (
						"mainscene"
						+ ".red_bonnet_popup_preflight"
					),
					"visual_only": true,
					"defer_runtime_effects": true,
					"renderer_first": true
				}
			)
		)

		if (
			not transition_packet.is_empty()
			and bool(
				transition_packet.get(
					"success",
					true
				)
			)
		):
			if activities_action_status_label != null:
				activities_action_status_label.text = (
					"The Red Bonnet is opening a "
					+ "Dragon Ball relocation seam..."
				)

			_refresh_scenario_ui_from_result(
				transition_packet
			)

		set_meta(
			"red_bonnet_dragonball_runtime_pending",
			true
		)
		set_meta(
			"red_bonnet_dragonball_runtime_started_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		call_deferred(
			"_finish_red_bonnet_dragon_ball_summon_action_deferred",
			wish_name,
			clean_wish,
			diary_snapshot
		)
		return

	var result: Dictionary = (
		_express_artifact_interaction_intent(
			"perform_red_bonnet_wish",
			{
				"wish_name": wish_name,
				"wish_key": clean_wish,
				"source": (
					"mainscene.red_bonnet_wish"
				)
			}
		)
	)
	var result_text: String = str(
		result.get(
			"text",
			result.get(
				"popup_text",
				result.get(
					"reason",
					""
				)
			)
		)
	).strip_edges()

	if result_text == "":
		result_text = (
			"The Red Bonnet did not resolve the wish."
		)
		result ["text"] = result_text
		result ["popup_text"] = result_text

	result ["popup_title"] = str(
		result.get(
			"popup_title",
			"Red Bonnet"
		)
	)
	result ["popup_footer"] = str(
		result.get(
			"popup_footer",
			"Tap anywhere to continue."
		)
	)

	current_panel = "life"
	_refresh_current_panel()

	if activities_action_status_label != null:
		activities_action_status_label.text = result_text

	if output_label != null and result_text != "":
		output_label.text = result_text

	_flush_player_diary_delta(
		diary_snapshot,
		result_text,
		true
	)
	_refresh_identity_bound_surfaces()
	_render_life_diary_panel()
	call_deferred(
		"_scroll_life_diary_to_bottom"
	)
	_update_player_stats_overlay()

	var spectator_frames: Array = MainSceneHelpers._safe_array(
		result.get(
			"spectator_frames",
			[]
		)
	)

	if (
		bool(
			result.get(
				"uses_scenario_panel",
				false
			)
		)
		or not spectator_frames.is_empty()
	):
		_refresh_scenario_ui_from_result(
			result
		)
	else:
		_maybe_show_action_result_popup(
			result
		)
func _finish_red_bonnet_dragon_ball_summon_action_deferred(
	_wish_name: String,
	clean_wish: String,
	diary_snapshot: Dictionary = {}
) -> void:
	if gs == null or gs.player == null:
		set_meta(
			"red_bonnet_dragonball_runtime_pending",
			false
		)
		return

	await get_tree().process_frame
	await get_tree().create_timer(2.28).timeout

	var wait_pass: int = 0
	while wait_pass < 12:
		var now_ms: int = int(
			Time.get_ticks_msec()
		)

		if (
			not _runtime_interactive_surface_busy(
				now_ms
			)
			and not _ui_interaction_grace_active(
				now_ms
			)
		):
			break

		wait_pass += 1
		await get_tree().create_timer(0.2).timeout

	var report: Dictionary = (
		_express_artifact_interaction_intent(
			"summon_dragon_balls",
			{
				"source": (
					"mainscene"
					+ ".red_bonnet_renderer_first_runtime"
				),
				"wish_key": clean_wish,
				"visual_transition_already_presented": true,
				"skip_runtime_reality_surge": true,
				"defer_post_summon_effects": true,
				"defer_bounded_rewrite": true,
				"defer_memory_echoes": true,
				"manual_flush_deferred_effects": true,
				"manual_flush_deferred_echoes": true
			}
		)
	)

	set_meta(
		"red_bonnet_dragonball_runtime_pending",
		false
	)
	set_meta(
		"red_bonnet_dragonball_runtime_finished_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	var result_text: String = str(
		report.get(
			"text",
			report.get(
				"popup_text",
				""
			)
		)
	).strip_edges()

	if result_text == "":
		result_text = (
			"All 7 Dragon Balls appear in my inventory."
			if bool(
				report.get(
					"success",
					false
				)
			)
			else "The Dragon Ball summon did not resolve."
		)

	var result: Dictionary = {
		"success": bool(
			report.get(
				"success",
				false
			)
		),
		"text": result_text,
		"popup_title": str(
			report.get(
				"popup_title",
				"Dragon Balls Summoned"
			)
		),
		"popup_text": str(
			report.get(
				"popup_text",
				result_text
			)
		),
		"popup_footer": str(
			report.get(
				"popup_footer",
				(
					"The Dragon Balls are now bound to your "
					+ "belongings until a wish scatters them."
				)
			)
		),
		"theme": "dragonball",
		"accent": "#F7B733",
		"emoji": " ",
		"opps": []
	}

	if not report.is_empty():
		result = report.duplicate(true)
		result ["text"] = str(
			result.get(
				"text",
				result_text
			)
		)
		result ["popup_text"] = str(
			result.get(
				"popup_text",
				result_text
			)
		)
		result ["popup_title"] = str(
			result.get(
				"popup_title",
				"Dragon Balls Summoned"
			)
		)
		result ["popup_footer"] = str(
			result.get(
				"popup_footer",
				(
					"The Dragon Balls are now bound to your "
					+ "belongings until a wish scatters them."
				)
			)
		)
		result ["theme"] = str(
			result.get(
				"theme",
				"dragonball"
			)
		)
		result ["accent"] = str(
			result.get(
				"accent",
				"#F7B733"
			)
		)
		result ["emoji"] = str(
			result.get(
				"emoji",
				" "
			)
		)

	if activities_action_status_label != null:
		activities_action_status_label.text = result_text

	if output_label != null and result_text != "":
		output_label.text = result_text

	belongings_hud_content_dirty = true
	set_meta(
		"__belongings_hud_animation_pause_until_ms",
		int(
			Time.get_ticks_msec()
		) + 420
	)

	call_deferred(
		"_finish_red_bonnet_dragon_ball_summon_ui_refresh_deferred",
		result.duplicate(true),
		diary_snapshot.duplicate(true),
		result_text
	)
func _finish_red_bonnet_dragon_ball_summon_ui_refresh_deferred(result: Dictionary, diary_snapshot: Dictionary = {}, result_text: String = "") -> void:
	await get_tree().process_frame

	_flush_player_diary_delta(diary_snapshot, result_text, true)

	belongings_hud_content_dirty = true
	set_meta("red_bonnet_post_popup_inventory_refresh_pending", true)
	set_meta("red_bonnet_post_popup_inventory_refresh_result_text", result_text)
	set_meta("red_bonnet_post_popup_inventory_refresh_scheduled_at_ms", int(Time.get_ticks_msec()))

	var is_red_bonnet_dragonball_packet: bool = MainSceneHelpers._result_is_red_bonnet_dragonball_spectator_packet(result)
	var user_already_closed: bool = bool(get_meta("red_bonnet_dragonball_runtime_ui_closed", false))

	if is_red_bonnet_dragonball_packet:
		set_meta("red_bonnet_dragonball_suppress_followup_scenario_panel", true)
		set_meta("red_bonnet_dragonball_suppress_followup_reason", "runtime_finish_deferred")
		_schedule_action_result_post_resolution_reconcile("red_bonnet_dragonball_finished_silent_inventory_reconcile", {
			"source": "red_bonnet_dragonball_finished_silent_inventory_reconcile",
			"text": result_text,
			"log_to_diary": false,
		})
		_schedule_red_bonnet_deferred_effects_flush_ui_safe("red_bonnet_dragonball_finished_silent_inventory_reconcile", 0)
		return

	if user_already_closed:
		_schedule_action_result_post_resolution_reconcile("red_bonnet_dragonball_finished_after_done_watching", {
			"source": "red_bonnet_dragonball_finished_after_done_watching",
			"text": result_text,
			"log_to_diary": false,
		})
		_schedule_red_bonnet_deferred_effects_flush_ui_safe("red_bonnet_dragonball_finished_after_done_watching", 0)
		return

	_begin_runtime_interaction_quiet_window("red_bonnet_dragon_ball_result_popup", 900)

	if bool(result.get("uses_scenario_panel", false)) or typeof(result.get("spectator_frames", [])) == TYPE_ARRAY:
		_refresh_scenario_ui_from_result(result)
	else:
		_maybe_show_action_result_popup(result)
