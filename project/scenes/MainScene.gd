	}


func _global_prewarm_ingest_population_cards_into_global_nodes(reason: String = "global_prewarm_global_nodes", realm_ids: Array = []) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	var card_engine:= _ensure_population_card_contract_engine()
	if card_engine == null:
		return {
			"success": false,
			"reason": "missing_population_card_contract_engine"
		}

	if not ("global_node_contract_engine" in gs) or gs.global_node_contract_engine == null:
		gs.global_node_contract_engine = GlobalNodeContractEngine.new(gs)

	var global_node_engine = gs.global_node_contract_engine
	if global_node_engine == null or not global_node_engine.has_method("ingest_population_card_graph_packet"):
		return {
			"success": false,
			"reason": "missing_global_node_ingest_method"
		}

	var ids: Array = realm_ids.duplicate(true)
	if ids.is_empty():
		ids = _population_card_contract_tail_realm_ids()

	var ingested_count: int = 0
	var failed: Array = []

	for raw_realm_id in ids:
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var realm_name: String = MainSceneLogic._population_card_contract_tail_realm_name(gs, realm_id)
		var packet: Dictionary = card_engine.packet_for_realm(realm_id, realm_name)

		if packet.is_empty():
			failed.append({
				"realm_id": realm_id,
				"realm_name": realm_name,
				"reason": "missing_population_card_packet"
			})
			continue

		var graph_packet: Dictionary = global_node_engine.ingest_population_card_graph_packet(
			packet,
			{
				"source": reason,
				"realm_id": realm_id,
				"realm_name": realm_name,
				"ui_is_renderer_only": true
			}
		)

		if graph_packet.is_empty():
			failed.append({
				"realm_id": realm_id,
				"realm_name": realm_name,
				"reason": "empty_global_node_graph_packet"
			})
			continue

		ingested_count += 1

	return {
		"success": failed.is_empty(),
		"reason": "global_node_population_registry_hot" if failed.is_empty() else "global_node_population_registry_failures",
		"ingested_count": ingested_count,
		"failed": failed,
		"ui_is_renderer_only": true
	}


func _global_prewarm_verify_global_node_population_registry(realm_ids: Array = []) -> Dictionary:
	if gs == null:
		return {
			"success": false,
			"reason": "missing_game_state"
		}

	if not ("global_node_contract_engine" in gs) or gs.global_node_contract_engine == null:
		return {
			"success": false,
			"reason": "missing_global_node_contract_engine"
		}

	var global_node_engine = gs.global_node_contract_engine
	if not global_node_engine.has_method("has_packet_for_scope"):
		return {
			"success": false,
			"reason": "global_node_engine_missing_scope_lookup"
		}

	var ids: Array = realm_ids.duplicate(true)
	if ids.is_empty():
		ids = _population_card_contract_tail_realm_ids()

	var missing: Array = []

	for raw_realm_id in ids:
		var realm_id: int = int(raw_realm_id)
		if realm_id <= 0:
			continue

		var scope_id: String = "population:%d" % realm_id
		if not global_node_engine.has_packet_for_scope(scope_id):
