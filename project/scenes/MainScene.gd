func _crime_panel_observer_bind_truth(
	stage: String,
	fields: Dictionary = {}
) -> void:
	if not OS.is_debug_build():
		return

	var parts:= PackedStringArray([
		"ERALIFE_CRIME_OBSERVER_BIND_TRUTH",
		"stage=%s" % stage
	])

	for raw_key in fields.keys():
		var key: String = str(
			raw_key
		).strip_edges()

		if key == "":
			continue

		parts.append(
			"%s=%s"
			% [
				key,
				str(
					fields.get(
						raw_key
					)
				).replace(
					"|",
					"/"
				)
			]
		)

	parts.append(
		"at_ms=%d"
		% int(
			Time.get_ticks_msec()
		)
	)

	EraLog.truth(
		"|".join(
			parts
		)
	)
func _on_resident_runtime_engine_became_resident_for_crime(
	engine_property: StringName,
	engine_instance: Variant
) -> void:
	if (
		gs == null
		or crime_panel_observation_game_state == null
		or crime_panel_observation_game_state != gs
	):
		return

	var clean_property: String = str(
		engine_property
	).strip_edges()

	if clean_property == "event_bus":
		if (
			engine_instance == null
			or not is_instance_valid(
				engine_instance
			)
		):
			_crime_panel_observer_bind_truth(
				"crime_event_bus_publication_invalid",
				{
					"engine_property": clean_property
				}
			)
			return

		if gs.event_bus != engine_instance:
			_crime_panel_observer_bind_truth(
				"crime_event_bus_publication_stale",
				{
					"engine_property": clean_property,
					"published_instance_id": (
						engine_instance.get_instance_id()
					),
					"current_instance_id": (
						gs.event_bus.get_instance_id()
						if (
							gs.event_bus != null
							and is_instance_valid(
								gs.event_bus
							)
						)
						else 0
					)
				}
			)
			return

		_crime_panel_observer_bind_truth(
			"crime_event_bus_became_resident",
			{
				"actor_id": (
					int(
						gs.player.id
					)
					if gs.player != null
					else -1
				),
				"event_bus_instance_id": (
					engine_instance.get_instance_id()
				)
			}
		)



		_bind_crime_panel_event_bus_observation()
		return

	if clean_property != "crime_hub_contract_engine":
		return

	if (
		engine_instance == null
		or not is_instance_valid(
			engine_instance
		)
	):
		_crime_panel_observer_bind_truth(
			"crime_hub_authority_publication_invalid",
			{
				"engine_property": clean_property
			}
		)
		return

	if (
		gs.crime_hub_contract_engine
		!= engine_instance
	):
		_crime_panel_observer_bind_truth(
			"crime_hub_authority_publication_stale",
			{
				"engine_property": clean_property,
				"published_instance_id": (
					engine_instance.get_instance_id()
				),
				"current_instance_id": (
					gs.crime_hub_contract_engine.get_instance_id()
					if gs.crime_hub_contract_engine != null
					and is_instance_valid(
						gs.crime_hub_contract_engine
					)
					else 0
				)
			}
		)
		return

	_crime_panel_observer_bind_truth(
		"crime_hub_authority_became_resident",
		{
			"actor_id": (
				int(
					gs.player.id
				)
				if gs.player != null
				else -1
			),
			"authority_instance_id": (
				engine_instance.get_instance_id()
			)
		}
	)






	_bind_crime_panel_event_bus_observation()



	_bind_crime_panel_observation_authority(
		true
	)
func _property_destination_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var cursor_index: int = 0
	var visited_signatures: Dictionary = {}

	while (
		cursor_index < queue.size()
		and cursor_index < 256
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue [cursor_index]
		)
		cursor_index += 1

		if cursor.is_empty():
			continue

		var cursor_signature: String = str(
			hash(cursor)
		)

		if visited_signatures.has(
			cursor_signature
		):
			continue

		visited_signatures [
			cursor_signature
		] = true

		var direct_space_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			cursor.get(
				"property_space_surface_contract",
				{}
			)
		)

		if not direct_space_contract.is_empty():
			var direct_space_result: Dictionary = (
				cursor.duplicate(true)
			)
			direct_space_result [
				"property_space_surface_contract"
			] = direct_space_contract.duplicate(true)
			return direct_space_result

		var direct_makeover_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			cursor.get(
				"property_makeover_surface_contract",
				{}
			)
		)

		if not direct_makeover_contract.is_empty():
			var direct_makeover_result: Dictionary = (
				cursor.duplicate(true)
			)
			direct_makeover_result [
				"property_makeover_surface_contract"
			] = direct_makeover_contract.duplicate(true)
			return direct_makeover_result

		for contract_key in [
			"surface_contract",
			"destination_contract",
			"projection_contract",
			"resident_contract",
			"contract"
		]:
			var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
				cursor.get(
					contract_key,
					{}
				)
			)

			if surface_contract.is_empty():
				continue

			var schema: String = str(
				surface_contract.get(
					"schema",
					""
				)
			).strip_edges().to_lower()

			if (
				schema.find(
					"property_space"
				) >= 0
				or schema.find(
					"property_viewer"
				) >= 0
				or schema.find(
					"property_interior"
				) >= 0
			):
				var resolved_space: Dictionary = (
					cursor.duplicate(true)
				)
				resolved_space [
					"property_space_surface_contract"
				] = surface_contract.duplicate(true)
				return resolved_space

			if schema.find(
				"property_makeover"
			) >= 0:
				var resolved_makeover: Dictionary = (
					cursor.duplicate(true)
				)
				resolved_makeover [
					"property_makeover_surface_contract"
				] = surface_contract.duplicate(true)
				return resolved_makeover

		for raw_key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload",
			"response",
			"data",
			"contract_packet",
			"projection_packet",
			"surface_packet",
			"property_space_surface_contracts_by_id",
			"property_makeover_surface_contracts_by_id",
			"property_destination_surface_contracts_by_id",
			"property_surfaces_by_id",
			"immutable_contracts"
		]:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) == TYPE_DICTIONARY:
				var nested: Dictionary = (
					nested_raw as Dictionary
				).duplicate(true)

				if not nested.is_empty():
					queue.append(
						nested
					)

			elif typeof(nested_raw) == TYPE_ARRAY:
				for raw_entry in nested_raw as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(true)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

		for raw_value in cursor.values():
			if typeof(raw_value) == TYPE_DICTIONARY:
				var nested_value: Dictionary = (
					raw_value as Dictionary
				).duplicate(true)

				if not nested_value.is_empty():
					queue.append(
						nested_value
					)

			elif typeof(raw_value) == TYPE_ARRAY:
				for raw_entry in raw_value as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(true)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

	return {}
func _prewarm_next_property_space_contract_for_actor(
	target_actor: Person,
	cursor: int,
	source: String = "property_space_surface_prewarm"
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
		or int(target_actor.id) <= 0
	):
		return {
			"success": false,
			"complete": false,
			"next_cursor": maxi(
				0,
				cursor
			),
			"reason": "missing_actor"
		}

	var actor_id: int = int(
		target_actor.id
	)
	var cache_key: String = (
		_asset_surface_pack_cache_key(
			target_actor
		)
	)
	var pack: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack_by_actor.get(
			cache_key,
			{}
		)
	)
	var assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"assets_surface_contract",
			{}
		)
	)
	var property_rows: Array = MainSceneHelpers._safe_array(
		assets_contract.get(
			"property_asset_rows",
			[]
		)
	)
	var resolved_cursor: int = maxi(
		0,
		cursor
	)
	var interior_by_id: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"property_space_surface_contracts_by_id",
			{}
		)
	)
	var makeover_by_id: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"property_makeover_surface_contracts_by_id",
			{}
		)
	)

	if property_rows.is_empty():
		pack [
			"property_space_surface_contracts_by_id"
		] = {}
		pack [
			"property_makeover_surface_contracts_by_id"
		] = {}
		pack [
			"property_space_surface_contracts_complete"
		] = true
		pack [
			"property_makeover_surface_contracts_complete"
		] = true
		pack [
			"property_space_surface_renderers_complete"
		] = true
		pack [
			"property_makeover_surface_renderers_complete"
		] = true
		asset_surface_pack_by_actor [
			cache_key
		] = pack.duplicate(true)

		return {
			"success": true,
			"complete": true,
			"next_cursor": 0,
			"property_count": 0,
			"ready_gate_member": false,
			"build_on_click": false
		}

	if resolved_cursor >= property_rows.size():
		_prewarm_property_viewer_surface_deck_for_actor(
			target_actor,
			interior_by_id
		)
		_prepaint_property_makeover_surface_deck_for_actor(
			target_actor,
			makeover_by_id
		)

		var every_property_contract_hot: bool = true
		var every_property_renderer_hot: bool = true
		var required_property_count: int = 0

		for raw_property_row in property_rows:
			var validation_row: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_property_row
			)
			var required_property_id: int = int(
				validation_row.get(
					"asset_id",
					validation_row.get(
						"property_id",
						validation_row.get(
							"id",
							-1
						)
					)
				)
			)

			if required_property_id <= 0:
				continue

			required_property_count += 1

			var required_key: String = str(
				required_property_id
			)

			if (
				not interior_by_id.has(
					required_key
				)
				or not makeover_by_id.has(
					required_key
				)
			):
				every_property_contract_hot = false

			if (
				_property_viewer_surface_panel_for(
					actor_id,
					required_property_id
				) == null
				or _property_makeover_surface_panel_for(
					actor_id,
					required_property_id
				) == null
			):
				every_property_renderer_hot = false

		var every_property_hot: bool = (
			every_property_contract_hot
			and every_property_renderer_hot
		)

		pack [
			"property_space_surface_contracts_by_id"
		] = interior_by_id.duplicate(true)
		pack [
			"property_makeover_surface_contracts_by_id"
		] = makeover_by_id.duplicate(true)
		pack [
			"property_space_surface_contracts_complete"
		] = every_property_contract_hot
		pack [
			"property_makeover_surface_contracts_complete"
		] = every_property_contract_hot
		pack [
			"property_space_surface_renderers_complete"
		] = every_property_renderer_hot
		pack [
			"property_makeover_surface_renderers_complete"
		] = every_property_renderer_hot
		pack [
			"property_space_surface_contracts_actor_id"
		] = actor_id
		pack [
			"property_makeover_surface_contracts_actor_id"
		] = actor_id
		pack [
			"property_space_surface_contracts_ready_gate_member"
		] = false
		pack [
			"property_makeover_surface_contracts_ready_gate_member"
		] = false
		pack [
			"property_space_surface_contracts_build_on_click"
		] = false
		pack [
			"property_makeover_surface_contracts_build_on_click"
		] = false
		pack [
			"property_destination_surface_deck_hot_requires_renderer"
		] = true
		asset_surface_pack_by_actor [
			cache_key
		] = pack.duplicate(true)

		return {
			"success": every_property_hot,
			"complete": every_property_hot,
			"next_cursor": resolved_cursor,
			"property_count": required_property_count,
			"interior_prepared_count": interior_by_id.size(),
			"makeover_prepared_count": makeover_by_id.size(),
			"interior_renderers_hot": every_property_renderer_hot,
			"makeover_renderers_hot": every_property_renderer_hot,
			"ready_gate_member": false,
			"build_on_click": false
		}

	var active_property_row: Dictionary = MainSceneHelpers._safe_dictionary(
		property_rows [
			resolved_cursor
		]
	)
	var property_id: int = int(
		active_property_row.get(
			"asset_id",
			active_property_row.get(
				"property_id",
				active_property_row.get(
					"id",
					-1
				)
			)
		)
	)

	if property_id <= 0:
		return {
			"success": true,
			"complete": false,
			"next_cursor": resolved_cursor + 1,
			"ready_gate_member": false,
			"build_on_click": false
		}

	var property_key: String = str(
		property_id
	)
	var interior_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		interior_by_id.get(
			property_key,
			{}
		)
	)
	var makeover_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		makeover_by_id.get(
			property_key,
			{}
		)
	)

	if (
		interior_contract.is_empty()
		or makeover_contract.is_empty()
	):
		var payload: Dictionary = {
			"actor_id": actor_id,
			"property_owner_id": int(
				active_property_row.get(
					"owner_id",
					actor_id
				)
			),
			"property_id": property_id,
			"source": source,
			"prewarm_only": true,
			"read_only": true,
			"visible_click_work_forbidden": true,
			"ready_gate_member": false,
			"ui_is_renderer_only": true
		}
		var report: Dictionary = _express_global_ui_intent(
			{
				"actor_id": actor_id,
				"intent_type": "property_destination_surface_prewarm",
				"surface_id": "property_destination_deck",
				"action_id": "prewarm_property_space_surface",
				"payload": payload.duplicate(true),
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true,
				"target": {
					"route_kind": "engine_method",
					"engine_property": "assets_contract_engine",
					"method": "prewarm_property_space_surface_for_actor",
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": source
			},
			{
				"actor_id": actor_id,
				"source": source,
				"surface_id": "property_destination_deck",
				"action_id": "prewarm_property_space_surface",
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true
			}
		)
		var route_result: Dictionary = _property_destination_contract_route_result(
			report
		)

		if route_result.is_empty():
			route_result = _property_destination_contract_route_result(
				_contract_route_result(
					report
				)
			)

		interior_contract = MainSceneHelpers._safe_dictionary(
			route_result.get(
				"property_space_surface_contract",
				{}
			)
		)
		makeover_contract = MainSceneHelpers._safe_dictionary(
			route_result.get(
				"property_makeover_surface_contract",
				{}
			)
		)

	if not interior_contract.is_empty():
		interior_contract ["actor_id"] = actor_id
		interior_contract ["property_id"] = property_id
		interior_contract ["property_owner_id"] = int(
			interior_contract.get(
				"property_owner_id",
				active_property_row.get(
					"owner_id",
					actor_id
				)
			)
		)
		interior_contract [
			"property_destination_observable_for_actor"
		] = true
		interior_contract [
			"visible_click_work_forbidden"
		] = true
		interior_by_id [
			property_key
		] = interior_contract.duplicate(true)

	if not makeover_contract.is_empty():
		makeover_contract ["actor_id"] = actor_id
		makeover_contract ["property_id"] = property_id
		makeover_contract ["property_owner_id"] = int(
			makeover_contract.get(
				"property_owner_id",
				active_property_row.get(
					"owner_id",
					actor_id
				)
			)
		)
		makeover_contract [
			"property_destination_observable_for_actor"
		] = true
		makeover_contract [
			"visible_click_work_forbidden"
		] = true
		makeover_by_id [
			property_key
		] = makeover_contract.duplicate(true)

	_prewarm_property_viewer_surface_deck_for_actor(
		target_actor,
		{
			property_key: interior_contract.duplicate(true)
		}
	)
	_prepaint_property_makeover_surface_deck_for_actor(
		target_actor,
		{
			property_key: makeover_contract.duplicate(true)
		}
	)

	pack [
		"property_space_surface_contracts_by_id"
	] = interior_by_id.duplicate(true)
	pack [
		"property_makeover_surface_contracts_by_id"
	] = makeover_by_id.duplicate(true)
	pack [
		"property_space_surface_contracts_actor_id"
	] = actor_id
	pack [
		"property_makeover_surface_contracts_actor_id"
	] = actor_id
	pack [
		"property_space_surface_contracts_complete"
	] = false
	pack [
		"property_makeover_surface_contracts_complete"
	] = false
	pack [
		"property_space_surface_contracts_ready_gate_member"
	] = false
	pack [
		"property_makeover_surface_contracts_ready_gate_member"
	] = false
	pack [
		"property_space_surface_contracts_build_on_click"
	] = false
	pack [
		"property_makeover_surface_contracts_build_on_click"
	] = false
	asset_surface_pack_by_actor [
		cache_key
	] = pack.duplicate(true)

	var interior_renderer_hot: bool = (
		_property_viewer_surface_panel_for(
			actor_id,
			property_id
		) != null
	)
	var makeover_renderer_hot: bool = (
		_property_makeover_surface_panel_for(
			actor_id,
			property_id
		) != null
	)

	return {
		"success": (
			not interior_contract.is_empty()
			and not makeover_contract.is_empty()
			and interior_renderer_hot
			and makeover_renderer_hot
		),
		"complete": false,
		"next_cursor": resolved_cursor + 1,
		"property_id": property_id,
		"interior_contract_hot": (
			not interior_contract.is_empty()
		),
		"makeover_contract_hot": (
			not makeover_contract.is_empty()
		),
		"property_renderer_prepainted": interior_renderer_hot,
		"makeover_renderer_prepainted": makeover_renderer_hot,
		"ready_gate_member": false,
		"build_on_click": false
	}
func _prewarm_crime_hub_contract_for_actor(
	actor_id: int,
	signature: String,
	source: String = "post_ready_crime_hub_residency"
) -> void:
	if (
		gs == null
		or gs.player == null
		or actor_id <= 0
		or int(
			gs.player.id
		) != actor_id
		or str(
			reality_residency_attached_signature
		).strip_edges() != str(
			signature
		).strip_edges()
	):
		return



	if (
		crime_panel == null
		or not is_instance_valid(
			crime_panel
		)
	):
		set_meta(
			"crime_hub_observer_bind_missing_renderer_chassis",
			true
		)
		return








	var observer_bound: bool = (
		_bind_crime_panel_observation_authority(
			false
		)
	)







	if not observer_bound:
		set_meta(
			"crime_hub_resident_observer_waiting_for_authority",
			true
		)

		_crime_panel_observer_bind_truth(
			"retained_replay_waiting_for_authority",
			{
				"actor_id": actor_id,
				"signature": signature,
				"source": source
			}
		)

		return

	set_meta(
		"crime_hub_resident_observer_waiting_for_authority",
