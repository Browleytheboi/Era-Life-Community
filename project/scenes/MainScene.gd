	var left_line:= ColorRect.new()
	left_line.color = line_color
	left_line.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	left_line.custom_minimum_size = Vector2(0, line_height)
	row.add_child(left_line)

	var label:= Label.new()
	label.text = "— %s —" % text
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_color_override("font_color", font_color)
	label.add_theme_color_override("font_shadow_color", shadow_color)
	label.add_theme_constant_override("shadow_outline_size", shadow_size)
	label.add_theme_font_size_override("font_size", section_font_size)
	row.add_child(label)

	var right_line:= ColorRect.new()
	right_line.color = line_color
	right_line.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	right_line.custom_minimum_size = Vector2(0, line_height)
	row.add_child(right_line)

	if elemental_section:
		_start_elemental_section_header_pulse(label, left_line, right_line)
func _start_elemental_section_header_pulse(label: Label, left_line: ColorRect, right_line: ColorRect) -> void:
	if label == null or left_line == null or right_line == null:
		return

	var water_color:= Color(0.56, 0.9, 1.0, 1.0)
	var earth_color:= Color(0.7, 0.94, 0.58, 1.0)
	var fire_color:= Color(1.0, 0.54, 0.3, 1.0)
	var air_color:= Color(0.96, 0.96, 0.86, 1.0)

	var tween:= create_tween().bind_node(label)
	tween.set_loops()

	tween.tween_callback(func () -> void:
		label.add_theme_color_override("font_color", water_color)
		label.add_theme_color_override("font_shadow_color", Color(0.2, 0.76, 1.0, 0.4))
		left_line.color = Color(0.3, 0.78, 1.0, 0.72)
		right_line.color = Color(0.3, 0.78, 1.0, 0.72)
	)
	tween.tween_interval(0.75)

	tween.tween_callback(func () -> void:
		label.add_theme_color_override("font_color", earth_color)
		label.add_theme_color_override("font_shadow_color", Color(0.36, 0.72, 0.2, 0.4))
		left_line.color = Color(0.48, 0.86, 0.36, 0.72)
		right_line.color = Color(0.48, 0.86, 0.36, 0.72)
	)
	tween.tween_interval(0.75)

	tween.tween_callback(func () -> void:
		label.add_theme_color_override("font_color", fire_color)
		label.add_theme_color_override("font_shadow_color", Color(1.0, 0.28, 0.12, 0.42))
		left_line.color = Color(1.0, 0.42, 0.2, 0.72)
		right_line.color = Color(1.0, 0.42, 0.2, 0.72)
	)
	tween.tween_interval(0.75)

	tween.tween_callback(func () -> void:
		label.add_theme_color_override("font_color", air_color)
		label.add_theme_color_override("font_shadow_color", Color(0.9, 0.9, 0.72, 0.36))
		left_line.color = Color(0.92, 0.92, 0.72, 0.66)
		right_line.color = Color(0.92, 0.92, 0.72, 0.66)
	)
	tween.tween_interval(0.75)
func _find_other_country_browser_entry_node(entry_id: String) -> Control:
	var popup:= get_node_or_null("OtherCountriesPopup")
	if popup == null:
		return null
	var target_id: String = str(entry_id).strip_edges()
	if target_id == "":
		return null

	var frontier: Array [Node] = [popup]
	while not frontier.is_empty():
		var node: Node = frontier [frontier.size() - 1]
		frontier.remove_at(frontier.size() - 1)
		if node is Control and node.has_meta("other_country_entry_id"):
			if str(node.get_meta("other_country_entry_id", "")).strip_edges() == target_id:
				return node as Control
		for child: Node in node.get_children():
			frontier.append(child)
	return null
func _ensure_era_kingdom_access_overlay() -> ColorRect:
	var live_overlay:= get_node_or_null("EraKingdomAccessOverlay") as ColorRect
	if live_overlay != null:
		return live_overlay

	var overlay:= ColorRect.new()
	overlay.name = "EraKingdomAccessOverlay"
	overlay.visible = false
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	overlay.z_index = 133
	overlay.color = Color(0.0, 0.0, 0.0, 0.0)
	overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(overlay)

	var label:= Label.new()
	label.name = "Text"
	label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.text = ""
	label.add_theme_color_override("font_color", Color(1.0, 0.95, 0.86, 0.98))
	label.add_theme_color_override("font_shadow_color", Color(0.98, 0.72, 0.18, 0.2))
	label.add_theme_constant_override("shadow_outline_size", 2)
	overlay.add_child(label)

	return overlay
func _run_era_kingdom_access_sequence() -> void:
	var popup:= get_node_or_null("OtherCountriesPopup")
	if popup == null:
		return

	var status:= popup.find_child("Status", true, false) as Label
	var focus_node:= _find_other_country_browser_entry_node("era_kingdom")
	var overlay:= _ensure_era_kingdom_access_overlay()
	var overlay_label:= overlay.get_node_or_null("Text") as Label

	if focus_node != null:
		var pulse_tween:= create_tween()
		pulse_tween.tween_property(focus_node, "scale", Vector2(1.015, 1.015), 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		pulse_tween.tween_property(focus_node, "scale", Vector2.ONE, 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)

	overlay.visible = true
	overlay.color = Color(0.0, 0.0, 0.0, 0.0)

	if overlay_label != null:
		overlay_label.text = "ACCESSING ERA KINGDOM…"
	if status != null:
		status.text = "ACCESSING ERA KINGDOM…"

	var fade_tween:= create_tween()
	fade_tween.tween_property(overlay, "color", Color(0.0, 0.0, 0.0, 0.2), 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

	await get_tree().create_timer(0.26).timeout

	if overlay_label != null:
		overlay_label.text = "VERIFYING AUTHORITY…"
	if status != null:
		status.text = "VERIFYING AUTHORITY…"

	await get_tree().create_timer(0.28).timeout

	if overlay_label != null:
		overlay_label.text = "CLEARANCE: ACCEPTED"
	if status != null:
		status.text = "CLEARANCE: ACCEPTED"

	await get_tree().create_timer(0.24).timeout

	overlay.visible = false
	overlay.color = Color(0.0, 0.0, 0.0, 0.0)
func _build_other_country_overview_body_lines(payload: Dictionary) -> Array:
	var lines: Array = []
	var realm: Dictionary = payload.get("realm", {})
	var entry_kind: String = str(payload.get("entry_kind", "realm"))
	var entry_name: String = str(payload.get("entry_name", "Country / Realm"))
	var capital_city: String = str(realm.get("capital_city", realm.get("capital", ""))).strip_edges()
	var subzones: Array = realm.get("subzones", [])
	var currency_name: String = str(realm.get("currency_name", MainSceneLogic._crown_default_currency_name_for_realm(gs, entry_name))).strip_edges()
	var ruler_name: String = _resolve_other_country_ruler_name(realm)

	var treasury_label: String = _format_crown_treasury_label(int(realm.get("treasury", 0)), currency_name)
	if bool(realm.get("build_budget_infinite", false)):
		treasury_label = "∞ %s" % currency_name

	var entry: Dictionary = payload.get("entry", {})
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges()

	var is_imaginative_realm: bool = entry_id == "terabithia" or entry_kind == "imaginative_realm" or realm_type == "imagination_bound"
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var is_elemental_realm: bool = native_element in ["air", "water", "earth", "fire"]
	var entry_display_name: String = MainSceneLogic._other_country_elemental_definite_name(entry_name, false) if is_elemental_realm else entry_name

	var notable_zones: Array = realm.get("notable_zones", [])
	if subzones.is_empty() and not notable_zones.is_empty():
		subzones = notable_zones

	if is_elemental_realm:
		var descriptor: Dictionary = MainSceneHelpers._build_other_country_elemental_descriptor(native_element)
		lines.append("%s does not read like an ordinary country." % entry_display_name)
		lines.append(str(descriptor.get("intro", "")))
		lines.append("")
		lines.append("Elemental Alignment: %s" % str(descriptor.get("display_name", native_element.capitalize())))
		lines.append("Realm Nature: %s" % str(descriptor.get("nature", "Elemental sovereignty.")))
		lines.append(ruler_name)
		if capital_city != "":
			lines.append("Seat of Power: %s" % capital_city)
