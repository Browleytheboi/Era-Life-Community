func _post_first_frame_god_mode_life_boot_shell_release(reason: String = "spawn_ready") -> void:
	set_meta("post_first_frame_god_mode_life_boot_frame_connected", false)
	set_meta("post_first_frame_god_mode_life_boot_pending", false)
	set_meta("post_first_frame_god_mode_life_boot_started_at_ms", int(Time.get_ticks_msec()))

	if not _global_runtime_kill_claim_allowed("runtime_boot", "Mainscene._post_first_frame_god_mode_life_boot_shell_release", reason, {
		"blocks_ui": true,
		"background_only": false
	}):
		return

	var using_prewarmed_capsule_entry: bool = bool(get_meta("god_mode_life_boot_uses_prewarmed_spawn", false)) and gs != null and gs.player != null
	if not using_prewarmed_capsule_entry:
		_deferred_begin_god_mode_life_boot()
		return

	if gs == null:
		set_meta("god_mode_capsule_entry_handoff_active", false)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(Time.get_ticks_msec())
	var boot_ticket: int = int(get_meta("life_boot_ticket", 0)) + 1
	var full_playable_entry: bool = bool(gs.scenario_state.get("god_mode_life_prewarm_consumed", false)) \
or bool(gs.scenario_state.get("god_mode_life_entry_full_ui_ready", false)) \
or bool(get_meta("god_mode_life_entry_full_ui_required", false)) \
or str(gs.scenario_state.get("spawn_shell_entry_policy", "")).strip_edges() == "full_playable_ui_from_prewarmed_capsule"

	set_meta("life_boot_ticket", boot_ticket)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("startup_birth_loading_overlay_active", false)
	set_meta("prewarmed_capsule_entry_shell_first", not full_playable_entry)
	set_meta("god_mode_shell_first_handoff_requested", not full_playable_entry)
	set_meta("god_mode_life_entry_full_ui_required", full_playable_entry)

	gs.scenario_state ["god_mode_boot_ticket"] = boot_ticket
	gs.scenario_state ["god_mode_life_boot_source"] = "prewarmed_life_capsule_state_only_after_first_frame"
	gs.scenario_state ["god_mode_life_initialize_skipped_after_prewarm"] = true
	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = not full_playable_entry
	gs.scenario_state ["birth_shell_first_boot"] = false
	gs.scenario_state ["birth_shell_first_boot_active"] = false if full_playable_entry else true
	gs.scenario_state ["birth_shell_player_created"] = true
	gs.scenario_state ["birth_shell_player_id"] = int(gs.player.id)
	gs.scenario_state ["spawn_shell_entry_policy"] = "full_playable_ui_from_prewarmed_capsule" if full_playable_entry else "main_shell_first_user_intent_tabs"
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_only_after_player_control_grace" if full_playable_entry else "idle_microtask_ui_safe"
	gs.scenario_state ["post_spawn_world_prewarm_last_ticket"] = boot_ticket
	gs.scenario_state ["defer_static_world_bootstrap"] = true
	gs.scenario_state ["defer_live_runtime_watchers"] = true
	gs.scenario_state ["deferred_data_bootstrap_pending"] = true
	gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = true
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["ui_first_frame_render_policy"] = "full_playable_ui_visible_no_runtime_work" if full_playable_entry else "life_shell_visible_no_runtime_work"
	gs.scenario_state ["ui_background_reconciliation_streaming"] = true
	gs.scenario_state ["post_first_frame_shell_reforce_blocked"] = true
	gs.scenario_state ["post_first_frame_shell_reforce_blocked_reason"] = reason
	gs.scenario_state ["blank_shell_guard_active"] = false
	gs.scenario_state ["blank_shell_guard_reason"] = "full_ui_already_visible" if full_playable_entry else "prewarmed_life_shell_already_visible"

	current_panel = "life"

	if _spawn_ready_life_output_needs_first_paint():
		_paint_spawn_ready_life_diary_shell_first_frame("post_first_frame_missing_life_diary_%s" % reason)

	if full_playable_entry:
		_set_main_gameplay_ui_visible(true)
		_ensure_player_stats_overlay()
		_bind_ui_nav_buttons()
		_apply_ui_nav_button_visuals()
		_set_birth_shell_interactive_controls_visible(true)

		if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
			player_stats_overlay.visible = true

		if output_label != null:
			output_label.visible = true
			output_label.scroll_active = true
			output_label.bbcode_enabled = true

		_sync_runtime_floating_hud_layering()
	else:
		_set_spawn_ready_shell_controls_visible_without_truth_work(true, "post_first_frame_state_only_%s" % reason)
