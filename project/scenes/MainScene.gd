				gs.get_instance_id()
			),
			"allow_defer": false,
			"force_immediate": true
		}
	)

	return true
func _crime_panel_direct_observer_is_live(
	signal_name: StringName,
	method_name: String
) -> bool:
	if (
		gs == null
		or gs.crime_hub_contract_engine == null
		or not is_instance_valid(
			gs.crime_hub_contract_engine
		)
		or crime_panel_observation_authority == null
		or not is_instance_valid(
			crime_panel_observation_authority
		)
		or crime_panel_observation_authority
		!= gs.crime_hub_contract_engine
	):
		return false

	if not gs.crime_hub_contract_engine.has_signal(
		signal_name
	):
		return false

	return gs.crime_hub_contract_engine.is_connected(
		signal_name,
		Callable(
			self,
			method_name
		)
	)


