func _show_bending_dojo_spar_match_popup(result: Dictionary) -> void:
	var match_payload: Dictionary = result.get("match_payload", {}) if typeof(result.get("match_payload", {})) == TYPE_DICTIONARY else {}
	if match_payload.is_empty():
		_maybe_show_action_result_popup(result)
		return

	var popup:= AcceptDialog.new()
	popup.title = "Dojo Mock Match"
	popup.exclusive = false
	popup.size = Vector2(780, 720)

	var scroll:= ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(740, 600)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO

	var box:= VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override("separation", 8)
	scroll.add_child(box)

	var header:= Label.new()
	header.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	header.text = "%s\n%s Tier • %s vs %s\nWinner: %s by %s" % [
		str(match_payload.get("dojo_name", "Bending Dojo")),
		str(match_payload.get("sparring_tier_label", "Beginner")),
		str(match_payload.get("actor_name", "You")),
		str(match_payload.get("target_name", "Opponent")),
		str(match_payload.get("winner_name", "Unknown")),
		str(match_payload.get("finish_move", "Controlled Finish"))
	]
	box.add_child(header)

	var actor_label:= Label.new()
	actor_label.text = "%s • Level %d" % [
		str(match_payload.get("actor_name", "You")),
		int(match_payload.get("actor_level", 0))
	]
	box.add_child(actor_label)

	var actor_bar:= ProgressBar.new()
	actor_bar.min_value = 0
	actor_bar.max_value = 100
	actor_bar.value = int(match_payload.get("actor_final_health", 0))
	actor_bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_child(actor_bar)

	var target_label:= Label.new()
	target_label.text = "%s • Level %d" % [
		str(match_payload.get("target_name", "Opponent")),
		int(match_payload.get("target_level", 0))
	]
	box.add_child(target_label)

	var target_bar:= ProgressBar.new()
	target_bar.min_value = 0
	target_bar.max_value = 100
	target_bar.value = int(match_payload.get("target_final_health", 0))
	target_bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_child(target_bar)

	var rounds_title:= Label.new()
	rounds_title.text = "\nExchange Log"
	box.add_child(rounds_title)

	var rounds: Array = match_payload.get("rounds", []) if typeof(match_payload.get("rounds", [])) == TYPE_ARRAY else []
	if rounds.is_empty():
		var empty_rounds:= Label.new()
		empty_rounds.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_rounds.text = "No exchange log was generated."
		box.add_child(empty_rounds)
	else:
		for raw_round in rounds:
			if typeof(raw_round) != TYPE_DICTIONARY:
				continue

			var round_row: Dictionary = raw_round
			var round_label:= Label.new()
			round_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			var sensei_tip: String = str(round_row.get("sensei_tip", "")).strip_edges()
			round_label.text = "Exchange %d\n%s%s\nHealth: %s %d / %s %d" % [
				int(round_row.get("round", 0)),
				str(round_row.get("text", "")),
				"\n" + sensei_tip if sensei_tip != "" else "",
				str(match_payload.get("actor_name", "You")),
				int(round_row.get("actor_health", 0)),
				str(match_payload.get("target_name", "Opponent")),
				int(round_row.get("target_health", 0))
			]
			box.add_child(round_label)

	var reward_label:= Label.new()
	reward_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
