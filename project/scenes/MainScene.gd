func _self_checkout_prompt_audio_stream() -> AudioStream:
	if self_checkout_prompt_audio_stream_cache != null:
		return self_checkout_prompt_audio_stream_cache

	var candidate_paths: Array = [
		"res://Audio/SelfCheckOut.ogg",
		"res://audio/SelfCheckOut.ogg",
		"res://Audio/SFX/SelfCheckOut.ogg",
		"res://audio/sfx/SelfCheckOut.ogg",
		"res://SelfCheckOut.ogg"
	]
	var engine = _ensure_era_audio_engine()

	if (
		engine == null
		or not engine.has_method(
			"request_audio_stream"
		)
	):
		set_meta(
			"self_checkout_prompt_audio_authority_missing",
			true
		)
		return null

	var report: Dictionary = (
		engine.request_audio_stream(
			candidate_paths,
			{
				"source": (
					"mainscene."
					+ "self_checkout_prompt_audio"
				),
				"one_shot": true,
				"ready_gate_member": false
			}
		)
	)

	set_meta(
		"self_checkout_prompt_audio_stream_report",
		report.duplicate(true)
	)
	set_meta(
		"self_checkout_prompt_audio_stream_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)

	var stream_raw: Variant = report.get(
		"stream",
		null
	)

	if stream_raw is AudioStream:
		self_checkout_prompt_audio_stream_cache = (
			stream_raw as AudioStream
		)

		set_meta(
			"self_checkout_prompt_audio_loaded_path",
			str(
				report.get(
					"stream_path",
					""
				)
			)
		)

		return self_checkout_prompt_audio_stream_cache

	return null

func _play_self_checkout_prompt_audio(
	cue_key: String = "self_checkout_payment_prompt",
	attempt: int = 0
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var last_cue_key: String = str(
		get_meta(
			"self_checkout_prompt_audio_last_cue_key",
			""
		)
	)
	var last_cue_ms: int = int(
		get_meta(
			"self_checkout_prompt_audio_last_cue_ms",
			0
		)
	)

	if (
		attempt == 0
		and last_cue_key == cue_key
		and now_ms - last_cue_ms < 1200
	):
		return

	var player: AudioStreamPlayer = (
		_ensure_self_checkout_prompt_audio_player()
	)

	if player == null:
		return

	var stream: AudioStream = (
		_self_checkout_prompt_audio_stream()
	)

	if stream == null:
		var stream_pending: bool = bool(
			get_meta(
				"self_checkout_prompt_audio_stream_pending",
				false
			)
		)

		if (
			stream_pending
			and attempt < 80
			and get_tree() != null
		):
			var retry_timer:= (
				get_tree().create_timer(
					0.05
				)
			)

			retry_timer.timeout.connect(
				Callable(
					self,
					"_play_self_checkout_prompt_audio"
				).bind(
					cue_key,
					attempt + 1
				),
				CONNECT_ONE_SHOT
			)
			return

		set_meta(
			"self_checkout_prompt_audio_last_error",
			(
				"SelfCheckOut.ogg could not be "
				+ "resolved by the audio contract."
			)
		)
		set_meta(
			"self_checkout_prompt_audio_last_error_ms",
			now_ms
		)
		return

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.stop()
	player.stream = stream
	player.bus = "Master"
	player.volume_db = -4.0
	player.play()

	set_meta(
		"self_checkout_prompt_audio_last_cue_key",
		cue_key
	)
	set_meta(
		"self_checkout_prompt_audio_last_cue_ms",
		now_ms
	)
	set_meta(
		"self_checkout_prompt_audio_last_attempt",
		attempt
	)
func _ensure_era_audio_engine():
	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	if era_audio_engine != null and is_instance_valid(era_audio_engine):
		if era_audio_engine.has_method("bootstrap"):
			era_audio_engine.bootstrap(self)
		return era_audio_engine

	era_audio_engine = EraAudioContractEngine.new()
	era_audio_engine.name = "EraAudioContractEngine"
	add_child(era_audio_engine)
	era_audio_engine.bootstrap(self)

	return era_audio_engine
func _grocery_store_music_profile(store_id: String) -> Dictionary:
	var clean_store_id: String = str(store_id).strip_edges()
	var profiles: Dictionary = MainSceneHelpers._grocery_store_music_profiles()
	if profiles.has(clean_store_id):
		return (profiles.get(clean_store_id, {}) as Dictionary).duplicate(true)
	return {}


func _grocery_store_music_track_ids_for_store(store_id: String) -> Array:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	var variants: Array = profile.get("track_variants", []) if typeof(profile.get("track_variants", [])) == TYPE_ARRAY else []
	var out: Array = []

	for raw_variant in variants:
		if typeof(raw_variant) != TYPE_DICTIONARY:
			continue
		var variant: Dictionary = raw_variant
		var track_id: String = str(variant.get("id", "")).strip_edges()
		if track_id != "":
			out.append(track_id)

	return out


func _grocery_store_music_active_store_id() -> String:
	return str(get_meta("grocery_store_music_active_store_id", "")).strip_edges()


func _grocery_store_music_is_active(store_id: String = "") -> bool:
	if not bool(get_meta("grocery_store_music_active", false)):
		return false

	var clean_store_id: String = str(store_id).strip_edges()
	if clean_store_id == "":
		return true

	return _grocery_store_music_active_store_id() == clean_store_id


func _grocery_store_music_volume_db(store_id: String) -> float:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	return float(profile.get("volume_db", -18.0))


func _grocery_store_music_fade_in_ms(store_id: String) -> int:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	return int(profile.get("fade_in_ms", 950))


func _grocery_store_music_fade_out_ms(store_id: String) -> int:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	return int(profile.get("fade_out_ms", 1050))


func _grocery_store_music_rotation_crossfade_ms(store_id: String) -> int:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	return int(profile.get("rotation_crossfade_ms", 1800))


func _ensure_grocery_store_music_tracks_registered() -> void:
	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var tracks_raw: Variant = era_audio_contract.get("tracks", {})
	var tracks: Dictionary = tracks_raw if typeof(tracks_raw) == TYPE_DICTIONARY else {}

	var context_routes_raw: Variant = era_audio_contract.get("context_routes", {})
	var context_routes: Dictionary = context_routes_raw if typeof(context_routes_raw) == TYPE_DICTIONARY else {}

	var presentation_routes_raw: Variant = era_audio_contract.get("presentation_routes", {})
	var presentation_routes: Dictionary = presentation_routes_raw if typeof(presentation_routes_raw) == TYPE_DICTIONARY else {}

	var profiles: Dictionary = MainSceneHelpers._grocery_store_music_profiles()
	for raw_store_id in profiles.keys():
		var store_id: String = str(raw_store_id).strip_edges()
		var profile: Dictionary = _grocery_store_music_profile(store_id)
		var variants: Array = profile.get("track_variants", []) if typeof(profile.get("track_variants", [])) == TYPE_ARRAY else []
		var context_keys: Array = profile.get("context_keys", []) if typeof(profile.get("context_keys", [])) == TYPE_ARRAY else []
		var first_track_id: String = ""

		for raw_variant in variants:
			if typeof(raw_variant) != TYPE_DICTIONARY:
				continue

			var variant: Dictionary = raw_variant
			var track_id: String = str(variant.get("id", "")).strip_edges()
			var file_name: String = str(variant.get("file", "")).strip_edges()
			if track_id == "" or file_name == "":
				continue

			if first_track_id == "":
				first_track_id = track_id

			tracks [track_id] = {
				"id": track_id,
				"display_name": str(profile.get("display_name", "Grocery Store Speaker")),
				"path": MainSceneLogic._grocery_store_music_resolve_path(file_name),
				"context_keys": context_keys.duplicate(true),
				"loop": false,
				"volume_db": float(profile.get("volume_db", -18.0)),
				"fade_ms": int(profile.get("fade_in_ms", 950)),
				"bus": "Master",
				"loop_fade_tail_ms": int(profile.get("rotation_crossfade_ms", 1800)),
				"store_id": store_id
			}

		if first_track_id != "":
			for raw_context_key in context_keys:
				var context_key: String = str(raw_context_key).strip_edges()
				if context_key != "":
					context_routes [context_key] = first_track_id

			var primary_context_key: String = str(profile.get("context_key", "")).strip_edges()
			if primary_context_key != "":
				presentation_routes [primary_context_key] = first_track_id

	era_audio_contract ["tracks"] = tracks
	era_audio_contract ["context_routes"] = context_routes
	era_audio_contract ["presentation_routes"] = presentation_routes


func _grocery_store_music_apply_active_route(store_id: String, track_id: String) -> void:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	if profile.is_empty() or track_id.strip_edges() == "":
		return

	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var context_routes_raw: Variant = era_audio_contract.get("context_routes", {})
	var context_routes: Dictionary = context_routes_raw if typeof(context_routes_raw) == TYPE_DICTIONARY else {}
	var presentation_routes_raw: Variant = era_audio_contract.get("presentation_routes", {})
	var presentation_routes: Dictionary = presentation_routes_raw if typeof(presentation_routes_raw) == TYPE_DICTIONARY else {}
	var context_keys: Array = profile.get("context_keys", []) if typeof(profile.get("context_keys", [])) == TYPE_ARRAY else []

	for raw_context_key in context_keys:
		var context_key: String = str(raw_context_key).strip_edges()
		if context_key != "":
			context_routes [context_key] = track_id

	var primary_context_key: String = str(profile.get("context_key", "")).strip_edges()
	if primary_context_key != "":
		presentation_routes [primary_context_key] = track_id

	era_audio_contract ["context_routes"] = context_routes
	era_audio_contract ["presentation_routes"] = presentation_routes


func _grocery_store_music_pick_track_id(store_id: String, reason: String = "", avoid_current: bool = false) -> String:
	var track_ids: Array = _grocery_store_music_track_ids_for_store(store_id)
	if track_ids.is_empty():
		return ""

	var current_track: String = ""
	if era_audio_engine != null and is_instance_valid(era_audio_engine):
		current_track = str(era_audio_engine.current_track_id)

	var candidates: Array = track_ids.duplicate()
	if avoid_current and candidates.size() > 1 and current_track != "":
		candidates.erase(current_track)

	var seed_text: String = "%s|%s|%s|store_music_pick" % [
		str(store_id),
		str(reason),
		str(Time.get_ticks_msec())
	]
	var seed_value: int = int(hash(seed_text))
	if seed_value < 0:
		seed_value = - seed_value
	if seed_value <= 0:
		seed_value = 1

	var rng:= RandomNumberGenerator.new()
	rng.seed = seed_value
	return str(candidates [int(rng.randi_range(0, candidates.size() - 1))])


func _grocery_store_music_context(store_id: String, reason: String, fade_ms: int, force_restart: bool = false, random_start: bool = false, avoid_current_track: bool = false) -> Dictionary:
	var profile: Dictionary = _grocery_store_music_profile(store_id)
	var track_id: String = _grocery_store_music_pick_track_id(store_id, reason, avoid_current_track)
	_grocery_store_music_apply_active_route(store_id, track_id)

	var context: Dictionary = _era_audio_context_from_current_world()
	context ["context_key"] = str(profile.get("context_key", "grocery_store_music"))
	context ["context_name"] = str(profile.get("display_name", "Grocery Store Speaker"))
	context ["surface_id"] = str(profile.get("surface_id", "food_contract_hub_grocery_store"))
	context ["panel_id"] = "grocery_store"
	context ["store_id"] = store_id
	context ["reason"] = reason
	context ["track_id"] = track_id
	context ["audio_fade_ms"] = fade_ms
	context ["audio_volume_db"] = _grocery_store_music_volume_db(store_id)

	if force_restart:
		context ["force_restart_audio"] = true
		context ["audio_force_restart"] = true
		context ["audio_restart_policy"] = "force_from_random_position" if random_start else "force_from_beginning"

	if random_start:
		context ["audio_random_start_position"] = true

	return context


func _start_grocery_store_music(store_id: String, reason: String = "enter_grocery_store") -> void:
	if not era_audio_enabled:
		return

	var clean_store_id: String = str(store_id).strip_edges()
	if _grocery_store_music_profile(clean_store_id).is_empty():
		_stop_grocery_store_music("unsupported_grocery_store_music:%s" % clean_store_id)
		return

	_ensure_grocery_store_music_tracks_registered()

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	var track_ids: Array = _grocery_store_music_track_ids_for_store(clean_store_id)
	if track_ids.is_empty():
		set_meta("grocery_store_music_active", false)
		set_meta("grocery_store_music_active_store_id", "")
		set_meta("grocery_store_music_failed_reason", "No registered grocery store music tracks for %s." % clean_store_id)
		set_meta("grocery_store_music_failed_at_ms", int(Time.get_ticks_msec()))
		return

	var already_active_same_store: bool = _grocery_store_music_is_active(clean_store_id)
	if already_active_same_store and engine.current_player != null and is_instance_valid(engine.current_player):
		var current_track_id: String = str(engine.current_track_id).strip_edges()
		if engine.current_player.playing and track_ids.has(current_track_id):
			set_meta("grocery_store_music_active", true)
			set_meta("grocery_store_music_active_store_id", clean_store_id)
			set_meta("grocery_store_music_started_reason", reason)
			set_meta("grocery_store_music_last_reason", reason)
			set_meta("grocery_store_music_preserved_at_ms", int(Time.get_ticks_msec()))
			set_meta("grocery_store_music_audio_authority_until_ms", int(Time.get_ticks_msec()) + 8000)
			set_meta("grocery_store_music_absent_context_frames", 0)
			set_meta("era_mart_store_music_active", clean_store_id == "basket_lane_market")
			era_audio_next_sync_ms = int(Time.get_ticks_msec()) + 8000
			return

	var context: Dictionary = _grocery_store_music_context(
		clean_store_id,
		reason,
		_grocery_store_music_fade_in_ms(clean_store_id),
		true,
		false,
		false
	)

	context ["audio_restart_policy"] = "force_from_beginning"
	context ["audio_random_start_position"] = false
	context ["grocery_store_audio_session"] = true
	context ["grocery_store_audio_owner"] = clean_store_id

	set_meta("grocery_store_music_active", true)
	set_meta("grocery_store_music_active_store_id", clean_store_id)
	set_meta("grocery_store_music_absent_context_frames", 0)
	set_meta("grocery_store_music_audio_authority_until_ms", int(Time.get_ticks_msec()) + 8000)
	set_meta("era_mart_store_music_active", clean_store_id == "basket_lane_market")

	var report: Dictionary = engine.apply_audio_contract(era_audio_contract, context)
	var started: bool = bool(report.get("success", false)) and track_ids.has(str(report.get("track_id", "")))

	set_meta("grocery_store_music_active", started)
	set_meta("grocery_store_music_active_store_id", clean_store_id if started else "")
	set_meta("grocery_store_music_started_reason", reason)
	set_meta("grocery_store_music_started_at_ms", int(Time.get_ticks_msec()))
	set_meta("grocery_store_music_last_report", report.duplicate(true))
	set_meta("grocery_store_music_rotation_guard_until_ms", 0)
	set_meta("grocery_store_music_audio_authority_until_ms", int(Time.get_ticks_msec()) + 8000)
	set_meta("grocery_store_music_absent_context_frames", 0)
	set_meta("era_mart_store_music_active", started and clean_store_id == "basket_lane_market")

	if started:
		era_audio_last_signature = _era_audio_signature_for_context(context)
		era_audio_next_sync_ms = int(Time.get_ticks_msec()) + 8000
	else:
		set_meta("grocery_store_music_failed_reason", str(report.get("reason", "Audio contract failed to start grocery music.")))
		set_meta("grocery_store_music_failed_at_ms", int(Time.get_ticks_msec()))

func _stop_grocery_store_music(reason: String = "leave_grocery_store", fade_ms: int = -1, store_id: String = "") -> void:
	var active_store_id: String = _grocery_store_music_active_store_id()
	var requested_store_id: String = str(store_id).strip_edges()

	if requested_store_id != "" and active_store_id != "" and requested_store_id != active_store_id:
		return

	if fade_ms < 0:
		fade_ms = _grocery_store_music_fade_out_ms(active_store_id)

	var was_active: bool = _grocery_store_music_is_active()
	set_meta("grocery_store_music_active", false)
	set_meta("grocery_store_music_active_store_id", "")
	set_meta("grocery_store_music_stopped_reason", reason)
	set_meta("grocery_store_music_stopped_at_ms", int(Time.get_ticks_msec()))
	set_meta("grocery_store_music_rotation_guard_until_ms", 0)
	set_meta("era_mart_store_music_active", false)

	if not was_active and (era_audio_engine == null or not is_instance_valid(era_audio_engine)):
		return

	if not era_audio_enabled:
		return

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	var context: Dictionary = _era_audio_context_from_current_world()
	context ["context_key"] = "gameplay"
	context ["context_name"] = "Gameplay"
	context ["surface_id"] = "live_gameplay_shell"
	context ["panel_id"] = current_panel
	context ["reason"] = reason
	context ["audio_fade_ms"] = fade_ms

	var report: Dictionary = engine.apply_audio_contract(era_audio_contract, context)
	set_meta("grocery_store_music_restore_report", report.duplicate(true))
	set_meta("era_mart_store_music_restore_report", report.duplicate(true))

	era_audio_last_signature = _era_audio_signature_for_context(context)
	era_audio_next_sync_ms = int(Time.get_ticks_msec()) + max(350, fade_ms)


func _restart_grocery_store_music_for_seamless_rotation(reason: String = "grocery_store_music_rotation") -> void:
	if not _grocery_store_music_is_active():
		return

	if not era_audio_enabled:
		return

	var store_id: String = _grocery_store_music_active_store_id()
	if store_id == "":
		return

	_ensure_grocery_store_music_tracks_registered()

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	var context: Dictionary = _grocery_store_music_context(
		store_id,
		reason,
		_grocery_store_music_rotation_crossfade_ms(store_id),
		true,
		false,
		true
	)
	context ["audio_restart_policy"] = "force_from_beginning"
	context ["audio_random_start_position"] = false
	context ["grocery_store_audio_session"] = true
	context ["grocery_store_audio_owner"] = store_id

	var report: Dictionary = engine.apply_audio_contract(era_audio_contract, context)

	var rotated: bool = bool(report.get("success", false))
	set_meta("grocery_store_music_active", rotated)
	set_meta("grocery_store_music_active_store_id", store_id if rotated else "")
	set_meta("grocery_store_music_rotation_report", report.duplicate(true))
	set_meta("grocery_store_music_rotated_at_ms", int(Time.get_ticks_msec()))
	set_meta("grocery_store_music_rotation_guard_until_ms", int(Time.get_ticks_msec()) + max(2200, _grocery_store_music_rotation_crossfade_ms(store_id) + 500))
	set_meta("grocery_store_music_audio_authority_until_ms", int(Time.get_ticks_msec()) + max(2600, _grocery_store_music_rotation_crossfade_ms(store_id) + 700))
	set_meta("grocery_store_music_absent_context_frames", 0)

	if rotated:
		era_audio_last_signature = _era_audio_signature_for_context(context)
		era_audio_next_sync_ms = int(Time.get_ticks_msec()) + max(2600, _grocery_store_music_rotation_crossfade_ms(store_id) + 700)


func _grocery_store_music_should_end_from_ui_context() -> bool:
	if not _grocery_store_music_is_active():
		return false

	var active_store_id: String = _grocery_store_music_active_store_id()
	if active_store_id == "":
		return true

	var now_ms: int = int(Time.get_ticks_msec())
	var authority_until_ms: int = int(get_meta("grocery_store_music_audio_authority_until_ms", 0))
	if now_ms < authority_until_ms:
		set_meta("grocery_store_music_absent_context_frames", 0)
		return false

	var surface_is_food_hub: bool = str(ui_contract_active_surface_id).strip_edges() == "food_contract_hub"
	var panel_exists: bool = ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel)
	var panel_visible: bool = panel_exists and ui_contract_surface_panel.visible

	if _grocery_relationship_profile_context_is_active():
		var relationship_context: Dictionary = _grocery_relationship_profile_context()
		var relationship_store_id: String = str(relationship_context.get("store_id", "")).strip_edges()
		if relationship_store_id == active_store_id and _grocery_relationship_context_should_restore_surface(relationship_context):
			set_meta("grocery_store_music_absent_context_frames", 0)
			return false
		return true

	if gs != null and gs.ui_contract_engine != null and surface_is_food_hub and panel_visible:
		var surface_state: Dictionary = _contract_surface_runtime_state("food_contract_hub")
		var state_store_id: String = str(surface_state.get("store_id", "")).strip_edges()
		var inside_store: bool = bool(surface_state.get("grocery_inside_store", state_store_id != ""))
		if inside_store and state_store_id == active_store_id:
			set_meta("grocery_store_music_absent_context_frames", 0)
			return false

	if surface_is_food_hub and panel_visible:
		set_meta("grocery_store_music_absent_context_frames", 0)
		return false

	var absent_frames: int = int(get_meta("grocery_store_music_absent_context_frames", 0)) + 1
	set_meta("grocery_store_music_absent_context_frames", absent_frames)

	return absent_frames >= 12
func _drive_self_checkout_live_surface_runtime(
	_delta: float
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)



	var resident_store_id: String = str(
		get_meta(
			"grocery_store_realtime_last_resident_store_id",
			""
		)
	).strip_edges()
	var grocery_runtime_resident: bool = (
		bool(
			get_meta(
				"grocery_store_realtime_mode_active",
				false
			)
		)
		or _grocery_relationship_profile_context_is_active()
		or resident_store_id != ""
	)

	if not grocery_runtime_resident:
		set_meta(
			"self_checkout_live_runtime_next_service_ms",
			now_ms + 450
		)
		set_meta(
			"self_checkout_live_runtime_skipped_without_residency",
			true
		)
		return

	var next_service_ms: int = int(
		get_meta(
			"self_checkout_live_runtime_next_service_ms",
			0
		)
	)

	if now_ms < next_service_ms:
		return

	if _ui_interaction_grace_active(now_ms):
		set_meta(
			"self_checkout_live_runtime_next_service_ms",
			now_ms + 96
		)
		set_meta(
			"self_checkout_live_runtime_yielded_to_ui_input",
			true
		)
		return

	set_meta(
		"self_checkout_live_runtime_yielded_to_ui_input",
		false
	)
	set_meta(
		"self_checkout_live_runtime_skipped_without_residency",
		false
	)
	set_meta(
		"self_checkout_live_runtime_next_service_ms",
		now_ms + 450
	)

	var tick_report: Dictionary = (
		_request_runtime_engine_method_intent(
			"grocery_store_engine",
			"tick_self_checkout_lane_for_actor",
			[
				gs.player,
				{
					"source": (
						"mainscene_self_checkout_resident_runtime"
					),
					"actor_id": int(
						gs.player.id
					),
					"interactive_lens_has_absolute_priority": true,
					"ui_is_expression_only": true
				}
			],
			"self_checkout_resident_tick:%d"
			% int(gs.player.id),
			"mainscene.self_checkout_resident_runtime",
			true
		)
	)

	if not bool(
		tick_report.get(
			"success",
			false
		)
	):
		return

	set_meta(
		"self_checkout_live_runtime_last_report",
		tick_report.duplicate(false)
	)
	set_meta(
		"self_checkout_live_surface_full_rebuild_performed",
		false
	)
func _drive_grocery_store_music_runtime(_delta: float) -> void:
	if not _grocery_store_music_is_active():
		return

	if _grocery_store_music_should_end_from_ui_context():
		_stop_grocery_store_music("grocery_store_surface_closed_or_changed")
		return

	if era_audio_engine == null or not is_instance_valid(era_audio_engine):
		return

	var store_id: String = _grocery_store_music_active_store_id()
	var track_ids: Array = _grocery_store_music_track_ids_for_store(store_id)
	var current_track_id: String = str(era_audio_engine.current_track_id).strip_edges()

	if not track_ids.has(current_track_id):
		var now_ms_for_repair: int = int(Time.get_ticks_msec())
		var repair_guard_until_ms: int = int(get_meta("grocery_store_music_repair_guard_until_ms", 0))
		if now_ms_for_repair >= repair_guard_until_ms:
			set_meta("grocery_store_music_repair_guard_until_ms", now_ms_for_repair + 900)
			_start_grocery_store_music(store_id, "repair_grocery_store_music_contract_stolen")
		return

	var active_player: AudioStreamPlayer = era_audio_engine.current_player
	if active_player == null or not is_instance_valid(active_player):
		return

	if active_player.stream == null:
		return

	if not active_player.playing:
		var ended_guard_until_ms: int = int(get_meta("grocery_store_music_rotation_guard_until_ms", 0))
		var ended_now_ms: int = int(Time.get_ticks_msec())
		if ended_now_ms >= ended_guard_until_ms:
			_restart_grocery_store_music_for_seamless_rotation("grocery_store_music_track_finished")
		return

	var stream_length: float = float(active_player.stream.get_length())
	if stream_length <= 0.0:
		return

	var playback_position: float = float(active_player.get_playback_position())
	var seconds_left: float = stream_length - playback_position
	var loop_tail_seconds: float = float(_grocery_store_music_rotation_crossfade_ms(store_id)) / 1000.0

	if seconds_left > loop_tail_seconds:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var guard_until_ms: int = int(get_meta("grocery_store_music_rotation_guard_until_ms", 0))
	if now_ms < guard_until_ms:
		return

	_restart_grocery_store_music_for_seamless_rotation("grocery_store_music_tail_rotation")


