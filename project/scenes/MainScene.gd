	return false
func _keep_god_mode_cover_visible_until_playable_ui(reason: String = "god_mode_entry") -> void:
	set_meta("god_mode_cover_reentry_forbidden_after_contract_emit", true)
	set_meta("god_mode_cover_reentry_forbidden_reason", reason)
	set_meta("god_mode_cover_reentry_forbidden_at_ms", int(Time.get_ticks_msec()))

	if gs != null and gs.player != null:
		_prime_prewarmed_capsule_live_ui_surface_without_handoff("%s_no_cover_live_surface_prime" % reason)

		if _commit_god_mode_to_playable_ui_atomic("%s_no_cover_atomic_retry" % reason):
			return

		if _force_release_god_mode_handoff_to_visible_life_surface("%s_no_cover_force_release" % reason):
			return

		_enforce_playable_life_surface_authority_now("%s_no_cover_authority_enforce" % reason)
		return

	set_meta("god_mode_atomic_shell_handoff_active", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("god_mode_handoff_cover_release_pending", false)
	set_meta("god_mode_cover_keeps_full_panel_visible_until_live_frame", false)
	set_meta("god_mode_defer_cover_release_until_live_frame", false)
	set_meta("god_mode_cover_release_waiting_for_atomic_playable_ui", false)
	set_meta("spawn_ready_visible_ui_ready_for_audio", false)
	set_meta("birth_intro_cry_waiting_for_playable_ui", false)

	_retire_god_mode_visual_authority_for_playable_life("%s_no_cover_no_player" % reason)

	if god_mode_start_button != null and is_instance_valid(god_mode_start_button):
		god_mode_start_button.disabled = true
		god_mode_start_button.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_cover_visible_until_atomic_playable_ui"] = false
		gs.scenario_state ["god_mode_cover_visible_until_atomic_reason"] = reason
		gs.scenario_state ["god_mode_cover_reentry_forbidden_after_contract_emit"] = true
		gs.scenario_state ["god_mode_cover_reentry_forbidden_reason"] = reason
		gs.scenario_state ["spawn_ready_visible_ui_ready_for_audio"] = false
		gs.scenario_state ["god_mode_cover_keep_did_not_quarantine_live_ui"] = true
func _god_mode_playable_ui_atomic_commit_ready(reason: String = "god_mode_entry") -> bool:
	if gs == null or gs.player == null:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var ui_root:= get_node_or_null("UIContainer") as Control
	if ui_root == null or not is_instance_valid(ui_root):
		return false

	current_panel = "life"
	ui_root.visible = true
	ui_root.mouse_filter = Control.MOUSE_FILTER_PASS

	if output_label == null or not is_instance_valid(output_label):
		return false

	output_label.visible = true
	output_label.scroll_active = true
	output_label.bbcode_enabled = true

	if str(output_label.text).strip_edges() == "":
		_paint_spawn_ready_life_diary_shell_first_frame("atomic_commit_%s" % reason)

	if str(output_label.text).strip_edges() == "":
		_paint_spawn_ready_life_diary_shell_first_frame("atomic_commit_empty_repair_%s" % reason)

	if str(output_label.text).strip_edges() == "":
		return false

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		_ensure_player_stats_overlay()

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		return false

	player_stats_overlay.visible = true

	_bind_ui_nav_buttons()
	_apply_ui_nav_button_visuals()
	_set_birth_shell_interactive_controls_visible(true)

	gs.scenario_state ["god_mode_playable_ui_atomic_commit_ready"] = true
	gs.scenario_state ["god_mode_playable_ui_atomic_commit_ready_reason"] = reason
	gs.scenario_state ["god_mode_playable_ui_atomic_commit_ready_at_ms"] = int(Time.get_ticks_msec())
	gs.scenario_state ["blank_shell_guard_active"] = false
	gs.scenario_state ["blank_shell_guard_reason"] = "atomic_commit_ready_verified_visible_life_surface"

	_claim_god_mode_tracker_playable_surface("%s_ready_probe" % reason)

	return true
func _commit_god_mode_to_playable_ui_atomic(reason: String = "god_mode_entry") -> bool:
	if gs == null or gs.player == null:
		return false

	var snapshot: Dictionary = _truth_first_god_mode_ready_snapshot(reason)
	if snapshot.is_empty():
		snapshot = _build_first_frame_ui_snapshot_from_game_state(gs, "%s_atomic_snapshot_rebuild" % reason)

	if snapshot.is_empty():
		set_meta("god_mode_atomic_commit_failed_missing_snapshot", true)
		set_meta("god_mode_atomic_commit_failed_reason", reason)
		set_meta("god_mode_atomic_commit_failed_at_ms", int(Time.get_ticks_msec()))
		return false

	var committed: bool = _compose_god_mode_ready_final_playable_life_shell_frame(
		snapshot.duplicate(true),
		"%s_atomic_commit_redirected_to_final_composer" % reason
	)

	set_meta("god_mode_playable_ui_atomic_commit_complete", committed)
	set_meta("god_mode_playable_ui_atomic_commit_reason", reason)
	set_meta("god_mode_playable_ui_atomic_commit_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_atomic_commit_redirected_to_final_composer", true)

	return committed
