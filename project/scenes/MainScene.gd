	_ui_block(lines)





func _format_grandparent_line(title: String, gp) -> String:
	if gp == null:
		return ""
	if not gp.alive:
		return "%s is deceased." % title
	return "%s is %s %s, %s (age %d)." % [
		title,
		gp.first_name,
		gp.last_name,
		MainSceneHelpers._format_job_for_grandparent(gp.job),
		gp.age
	]
func _format_birth_relative_line(title: String, npc: Person, use_parent_job_format: bool = false) -> String:
	if npc == null:
		return ""

	var full_name:= ("%s %s" % [npc.first_name, npc.last_name]).strip_edges()
	if not npc.alive:
		return "%s is %s, dead (age %d)." % [title, full_name, npc.age]

	var civic_role_text:= MainSceneHelpers._format_birth_relative_civic_role(npc)
	if civic_role_text != "":
		return "%s is %s, %s (age %d)." % [title, full_name, civic_role_text, npc.age]

	var royal_role_text:= MainSceneLogic._format_birth_relative_royal_role(npc)
	if royal_role_text != "":
		return "%s is %s, %s (age %d)." % [title, full_name, royal_role_text, npc.age]

	var job_text:= str(npc.job).strip_edges()
	if job_text == "":
		return "%s is %s (age %d)." % [title, full_name, npc.age]
	if job_text == "Retired":
		return "%s is %s, retired (age %d)." % [title, full_name, npc.age]
	var role_text:= MainSceneLogic._format_job_for_parent(job_text) if use_parent_job_format else MainSceneHelpers._format_job_for_grandparent(job_text)
	return "%s is %s, %s (age %d)." % [title, full_name, role_text, npc.age]
func _append_birth_relative_line(lines: Array, seen_intro_lines: Dictionary, title: String, npc: Person, use_parent_job_format: bool = false) -> void:
	var line:= _format_birth_relative_line(title, npc, use_parent_job_format)
	if line == "":
		return

	var clean_line:= MainSceneHelpers._compact_diary_text(line)
	if clean_line == "" or seen_intro_lines.has(clean_line):
		return

	seen_intro_lines [clean_line] = true
	lines.append(line)


func _append_birth_family_intro_lines(lines: Array, seen_intro_lines: Dictionary, p: Person) -> void:
	if gs == null or p == null:
		return

	var player_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, p.parents)
	var father: Person = player_parents [0]
	var mother: Person = player_parents [1]

	_append_birth_relative_line(lines, seen_intro_lines, "My father", father, true)
	_append_birth_relative_line(lines, seen_intro_lines, "My mother", mother, true)

	var maternal_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, mother.parents if mother != null else [])
	var maternal_grandfather: Person = maternal_parents [0]
	var maternal_grandmother: Person = maternal_parents [1]

	var paternal_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, father.parents if father != null else [])
	var paternal_grandfather: Person = paternal_parents [0]
	var paternal_grandmother: Person = paternal_parents [1]

	_append_birth_relative_line(lines, seen_intro_lines, "My maternal grandfather", maternal_grandfather)
	_append_birth_relative_line(lines, seen_intro_lines, "My maternal grandmother", maternal_grandmother)
	_append_birth_relative_line(lines, seen_intro_lines, "My paternal grandfather", paternal_grandfather)
	_append_birth_relative_line(lines, seen_intro_lines, "My paternal grandmother", paternal_grandmother)

	var maternal_gf_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, maternal_grandfather.parents if maternal_grandfather != null else [])
	var maternal_gf_father: Person = maternal_gf_parents [0]
	var maternal_gf_mother: Person = maternal_gf_parents [1]

	var maternal_gm_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, maternal_grandmother.parents if maternal_grandmother != null else [])
	var maternal_gm_father: Person = maternal_gm_parents [0]
	var maternal_gm_mother: Person = maternal_gm_parents [1]

	var paternal_gf_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, paternal_grandfather.parents if paternal_grandfather != null else [])
	var paternal_gf_father: Person = paternal_gf_parents [0]
	var paternal_gf_mother: Person = paternal_gf_parents [1]

	var paternal_gm_parents:= MainSceneLogic._resolve_birth_relative_pair(gs, paternal_grandmother.parents if paternal_grandmother != null else [])
	var paternal_gm_father: Person = paternal_gm_parents [0]
	var paternal_gm_mother: Person = paternal_gm_parents [1]

	_append_birth_relative_line(lines, seen_intro_lines, "My maternal great-grandfather", maternal_gf_father)
	_append_birth_relative_line(lines, seen_intro_lines, "My maternal great-grandmother", maternal_gf_mother)
	_append_birth_relative_line(lines, seen_intro_lines, "My maternal great-grandfather", maternal_gm_father)
	_append_birth_relative_line(lines, seen_intro_lines, "My maternal great-grandmother", maternal_gm_mother)

	_append_birth_relative_line(lines, seen_intro_lines, "My paternal great-grandfather", paternal_gf_father)
	_append_birth_relative_line(lines, seen_intro_lines, "My paternal great-grandmother", paternal_gf_mother)
	_append_birth_relative_line(lines, seen_intro_lines, "My paternal great-grandfather", paternal_gm_father)
	_append_birth_relative_line(lines, seen_intro_lines, "My paternal great-grandmother", paternal_gm_mother)

	for npc in gs.npcs:
		if npc == null or npc.id == p.id:
			continue
		if npc.parents.size() == 0:
			continue
		if npc.parents != p.parents:
			continue

		var sibling_title:= "My brother" if npc.gender == "Male" else "My sister"
		_append_birth_relative_line(lines, seen_intro_lines, sibling_title, npc)



