func _hub_panel_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var cursor: Dictionary = report.duplicate(false)

	for _depth in range(10):






		if (
			cursor.has(
				"hub_contract"
			)
			or cursor.has(
				"interaction_contract"
			)
			or cursor.has(
				"surface_contract"
			)
			or cursor.has(
				"type"
			)
			or cursor.has(
				"popup_title"
			)
			or cursor.has(
				"popup_text"
			)
			or cursor.has(
				"text"
			)
		):
			return cursor.duplicate(false)

		var found_nested: bool = false



		for key in [
			"result",
			"route_report",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				key,
				{}
			)

			if typeof(
				nested_raw
			) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			cursor = nested
			found_nested = true
			break

		if not found_nested:
			break

	return cursor.duplicate(false)
