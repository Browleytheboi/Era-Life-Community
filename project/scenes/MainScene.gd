		% source
	)

	_retarget_player_stats_overlay_lens_only(
		gs.player,
		"%s_successor_stats"
		% source,
		handoff_lens_cache
	)

	set_meta(
		"continue_lineage_stats_lens_actor_id",
		target_id
	)
	set_meta(
		"continue_lineage_stats_old_actor_fallback",
		false
	)




	var profile_packet: Dictionary = (
		_zero_frame_contract_dictionary(
			handoff.get(
				"visible_switch_packet",
				{}
			)
		)
	)
	var profile_surface: Dictionary = (
		_zero_frame_contract_dictionary(
			profile_packet.get(
				"surface_contract",
				{}
			)
		)
	)

	var handoff_packet_valid: bool = (
		not profile_packet.is_empty()
		and not profile_surface.is_empty()
		and int(
			profile_packet.get(
				"actor_id",
				-1
			)
		) == target_id
		and int(
			profile_surface.get(
				"actor_id",
				-1
			)
		) == target_id
	)

	if (
		handoff_packet_valid
		and committed_pointer_revision != ""
	):
		var handoff_packet_revision: String = str(
			profile_packet.get(
				"pointer_revision",
				profile_surface.get(
					"pointer_revision",
					""
				)
			)
		).strip_edges()

		handoff_packet_valid = (
			handoff_packet_revision
			== committed_pointer_revision
		)

	if not handoff_packet_valid:
		profile_packet = {}



	if (
		profile_packet.is_empty()
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var packet_cache: Dictionary = (
			_zero_frame_contract_dictionary(
				gs.scenario_state.get(
					"profile_pointer_packet_by_actor",
					{}
				)
			)
		)

		var cached_packet: Dictionary = (
			_zero_frame_contract_dictionary(
				packet_cache.get(
					str(target_id),
					{}
				)
			)
		)
		var cached_surface: Dictionary = (
			_zero_frame_contract_dictionary(
				cached_packet.get(
					"surface_contract",
					{}
				)
			)
		)

		var cached_packet_valid: bool = (
			not cached_packet.is_empty()
			and not cached_surface.is_empty()
			and int(
				cached_packet.get(
					"actor_id",
					-1
				)
			) == target_id
			and int(
				cached_surface.get(
					"actor_id",
					-1
				)
			) == target_id
		)

		if (
			cached_packet_valid
			and committed_pointer_revision != ""
		):
			var cached_revision: String = str(
				cached_packet.get(
					"pointer_revision",
					cached_surface.get(
						"pointer_revision",
						""
					)
				)
			).strip_edges()

			cached_packet_valid = (
				cached_revision
				== committed_pointer_revision
			)

		if cached_packet_valid:
			profile_packet = cached_packet

	var visible_lens_bound: bool = false
	var diary_history_bound: bool = false
	var used_commit_bound_packet: bool = (
		not profile_packet.is_empty()
	)

	if not profile_packet.is_empty():
		visible_lens_bound = (
			_apply_relationship_profile_switch_visible_lens_from_packet_now(
				gs.player,
				profile_packet,
				{
					"text": spirit_text
				},
				source
			)
		)

		if visible_lens_bound:
			diary_history_bound = (
				_install_switched_actor_life_diary_from_published_packet(
					gs.player,
					profile_packet,
					source,
					cursor_contract
				)
			)







	if not visible_lens_bound:
		if (
			output_label != null
			and is_instance_valid(
				output_label
			)
		):
			var prepared_world_year: int = int(
				handoff.get(
					"prepared_world_year",
					gs.year
				)
			)
			var prepared_actor_age: int = int(
				handoff.get(
					"prepared_actor_age",
					gs.player.age
				)
			)

			var minimum_life_text: String = (
				"Year: %s\nAge: %d"
				% [
					_format_year(
						prepared_world_year
					),
					prepared_actor_age
				]
			)

			if spirit_text != "":
				minimum_life_text += (
					"\n%s"
					% spirit_text
				)

			output_label.bbcode_enabled = true
			output_label.text = minimum_life_text
			output_label.visible = true
			output_label.scroll_active = true
			output_label.mouse_filter = (
				Control.MOUSE_FILTER_PASS
			)

			output_label.set_meta(
				"continue_lineage_minimum_life_lens",
				true
			)
			output_label.set_meta(
				"continue_lineage_minimum_life_lens_actor_id",
				target_id
			)
			output_label.set_meta(
				"visible_truth_anchor_actor_id",
				target_id
			)

		_force_relationship_switch_base_life_shell_lens_visible_now(
			gs.player,
			"%s_successor_minimum_life_shell"
			% source
		)

		visible_lens_bound = true

		set_meta(
			"continue_lineage_visible_handoff_packet_missing",
			true
		)
		set_meta(
			"continue_lineage_visible_handoff_packet_missing_actor_id",
			target_id
		)









	var native_switch_lens_finalized: bool = false

	if visible_lens_bound:
		_apply_committed_relationship_switch_lens_now(
			gs.player,
			previous_actor_id,
			result,
			source
		)
		native_switch_lens_finalized = true




	if (
		diary_history_bound
		and not diary_delta.is_empty()
		and bool(
			diary_delta.get(
				"authority_committed",
				false
			)
		)
	):
		_on_life_diary_entry_committed(
			target_id,
			diary_delta
		)

	if (
		player_stats_overlay != null
		and is_instance_valid(
			player_stats_overlay
		)
	):
		player_stats_overlay.visible = true



	_schedule_relationship_profile_switch_tail_after_visible_lens(
		target_id,
		previous_actor_id,
		result,
		source
	)

	set_meta(
		"continue_lineage_visible_handoff_complete",
		visible_lens_bound
	)
	set_meta(
		"continue_lineage_visible_handoff_actor_id",
		target_id
	)
	set_meta(
		"continue_lineage_visible_handoff_previous_actor_id",
		previous_actor_id
	)
	set_meta(
		"continue_lineage_visible_handoff_main_tab_deck_hot",
		main_tab_deck_hot
	)
	set_meta(
		"continue_lineage_visible_handoff_diary_bound",
		diary_history_bound
	)
	set_meta(
		"continue_lineage_visible_handoff_diary_enrichment_pending",
		not diary_history_bound
	)
	set_meta(
		"continue_lineage_visible_handoff_pending_lens_bound",
		pending_lens_bound
	)
	set_meta(
		"continue_lineage_visible_handoff_identity_bound",
		visible_lens_bound
	)
	set_meta(
		"continue_lineage_visible_handoff_commit_bound_packet_used",
		used_commit_bound_packet
	)
	set_meta(
		"continue_lineage_visible_handoff_native_switch_lens_finalized",
		native_switch_lens_finalized
	)
	set_meta(
		"continue_lineage_visible_handoff_previous_diary_retired",
		true
	)
	set_meta(
		"continue_lineage_visible_handoff_old_actor_fallback_forbidden",
		true
	)
	set_meta(
		"continue_lineage_visible_handoff_stats_retargeted_unconditionally",
		true
	)
	set_meta(
		"continue_lineage_visible_handoff_engine_calls",
		false
	)
	set_meta(
		"continue_lineage_visible_handoff_builds",
		0
	)
	set_meta(
		"continue_lineage_visible_handoff_generic_refresh_called",
		false
	)
	set_meta(
		"continue_lineage_visible_handoff_ready_gate_member",
		false
	)
	set_meta(
