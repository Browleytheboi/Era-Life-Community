		var pending_total: int = _bending_hub_pending_skill_allocation_total()
		var available_after_pending: int = max(0, int(row_data.get("available_points", 0)) - pending_total)
		var disabled: bool = bool(row_data.get("disabled", false)) or available_after_pending <= 0
		var button:= _make_bending_hub_button(str(row_data.get("button_label", "Add skill points")), disabled)
		button.alignment = HORIZONTAL_ALIGNMENT_CENTER
		button.custom_minimum_size = Vector2(168, 44)
		button.size_flags_horizontal = Control.SIZE_SHRINK_END
		button.tooltip_text = "Stage points here first. They do not become permanent until you press Save Allocation."
		button.pressed.connect(_on_bending_hub_allocate_skill_point_pressed.bind(row_data.duplicate(true)))
