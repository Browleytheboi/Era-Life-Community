func _continue_startup_intro_after_zero_frame(
	startup_audio_reason: String,
	_force_audio_restart: bool,
	run_id: int
) -> void:
	var tree:= get_tree()

	if tree != null:
		await tree.process_frame
		await RenderingServer.frame_post_draw
		await tree.process_frame

	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		set_meta(
			"startup_intro_runtime_continue_pending",
			false
		)
		return

	if (
		startup_intro_overlay == null
		or not is_instance_valid(
			startup_intro_overlay
		)
	):
		set_meta(
			"startup_intro_runtime_continue_pending",
			false
		)
		return

	_prepare_startup_intro_fresh_sequence_cache_for_current_generation(
		startup_audio_reason
	)
	set_meta(
		"startup_intro_sequence_cache_deferred_until_after_zero_frame",
		false
	)
	set_meta(
		"startup_intro_sequence_cache_prepared_after_zero_frame",
		true
	)
	set_meta(
		"startup_intro_sequence_cache_prepared_after_zero_frame_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if tree != null:
		await tree.process_frame

	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		set_meta(
			"startup_intro_runtime_continue_pending",
			false
		)
		return

	if not bool(
		get_meta(
			"startup_intro_contract_audio_active",
			false
		)
	):
		set_meta(
			"startup_intro_visual_waits_for_pending_audio",
			true
		)

		call_deferred(
			"_continue_startup_intro_when_audio_claim_hot",
			startup_audio_reason,
			run_id,
			0
		)
		return

	_commit_startup_intro_sequence_after_audio_hot(
		startup_audio_reason,
		run_id
	)


func _continue_startup_intro_when_audio_claim_hot(
	startup_audio_reason: String,
	run_id: int,
	attempt: int
) -> void:
	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		set_meta(
			"startup_intro_runtime_continue_pending",
			false
		)
		return

	_sync_startup_intro_audio_contract(
		startup_audio_reason,
		false
	)

	if bool(
		get_meta(
			"startup_intro_contract_audio_active",
			false
		)
	):
		_commit_startup_intro_sequence_after_audio_hot(
			startup_audio_reason,
			run_id
		)
		return

	var tree:= get_tree()

	if (
		tree == null
		or attempt >= 240
	):
		set_meta(
			"startup_intro_audio_wait_exhausted",
			true
		)
		set_meta(
			"startup_intro_audio_wait_exhausted_attempts",
			attempt
		)



		_commit_startup_intro_sequence_after_audio_hot(
			startup_audio_reason,
			run_id
		)
		return

	await tree.create_timer(
		0.016
	).timeout

	call_deferred(
		"_continue_startup_intro_when_audio_claim_hot",
		startup_audio_reason,
		run_id,
		attempt + 1
	)


func _commit_startup_intro_sequence_after_audio_hot(
	startup_audio_reason: String,
	run_id: int
) -> void:
	if (
		startup_intro_exiting
		or run_id != startup_intro_sequence_generation
	):
		set_meta(
			"startup_intro_runtime_continue_pending",
			false
		)
		return

	var replay_run: bool = (
		bool(
			get_meta(
				"startup_intro_replay_run_active",
				false
			)
		)
		or str(
			startup_audio_reason
		).find(
			"replay"
		) >= 0
	)
	var synchronized_epoch_ms: int = int(
		Time.get_ticks_msec()
	)





	set_meta(
		"startup_intro_audio_playback_authorized",
		true
	)
	set_meta(
		"startup_intro_audio_precache_only",
		false
	)
	set_meta(
		"startup_intro_visual_epoch_ms",
		synchronized_epoch_ms
	)
	set_meta(
		"startup_intro_audio_started_at_ms",
		synchronized_epoch_ms
	)
	set_meta(
		"startup_intro_audio_visual_sync_epoch_ms",
		synchronized_epoch_ms
	)
	set_meta(
		"startup_intro_visual_waits_for_pending_audio",
		false
	)
	set_meta(
		"startup_intro_sequence_committed_after_audio_hot",
		true
	)
	set_meta(
		"startup_intro_sequence_committed_after_audio_hot_at_ms",
		synchronized_epoch_ms
	)
	set_meta(
		"startup_intro_audio_and_visual_runner_same_call",
		true
	)

	_run_startup_intro_sequence()

	call_deferred(
		"_start_startup_intro_skip_pulse"
	)

	if replay_run:
		set_meta(
			"startup_intro_replay_skipped_prelife_candidate_prepare",
			true
		)
		set_meta(
			"startup_intro_replay_skipped_prelife_candidate_prepare_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
	else:
		set_meta(
			"startup_intro_prelife_candidate_deferred_until_final_card",
			true
		)
		set_meta(
			"startup_intro_prelife_candidate_deferred_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

	set_meta(
		"startup_intro_runtime_continue_pending",
		false
	)
	set_meta(
		"startup_intro_runtime_continue_after_zero_frame",
		true
	)
	set_meta(
		"startup_intro_runtime_continue_after_zero_frame_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
