func _refresh_contract_ui_surfaces() -> void:
	if gs == null or gs.ui_contract_engine == null:
		ui_contract_surface_cache = []
		return

	var viewport_size: Vector2 = get_viewport_rect().size
	var context:= {
		"panel": current_panel,
		"player_id": int(gs.player.id) if gs.player != null else -1,
		"year": int(gs.year),
		"viewport_width": int(viewport_size.x),
		"viewport_height": int(viewport_size.y),
		"device_profile": _ui_contract_device_profile_from_viewport(
			viewport_size
		),
		"platform_scope": "desktop",
		"shell_scope": "mainscene_desktop",
	}

	var raw_surfaces: Variant = (
		gs.ui_contract_engine.get_valid_surfaces(
			context
		)
	)
	var filtered_surfaces: Array = []

	if typeof(raw_surfaces) == TYPE_ARRAY:
		for raw_surface in raw_surfaces:
			if typeof(raw_surface) != TYPE_DICTIONARY:
				continue

			var surface_contract: Dictionary = (
				raw_surface as Dictionary
			).duplicate(
				true
			)

			if not MainSceneLogic._desktop_ui_contract_surface_is_allowed(
				surface_contract
			):
				continue

			filtered_surfaces.append(
				surface_contract
			)

	ui_contract_surface_cache = filtered_surfaces

func _render_contract_surface_buttons(target: Control) -> void:
	if target == null:
		return

	_refresh_contract_ui_surfaces()

	for raw_surface in ui_contract_surface_cache:
		if typeof(raw_surface) != TYPE_DICTIONARY:
			continue

		var surface: Dictionary = raw_surface
		var surface_type: String = str(surface.get("surface_type", "")).strip_edges().to_lower()
		if surface_type not in ["button", "hub", "panel", "action_lane"]:
			continue

		var surface_id: String = str(surface.get("surface_id", "")).strip_edges()
		if surface_id == "":
			continue

		var btn:= Button.new()
		btn.text = "%s %s" % [
			str(surface.get("icon", "")).strip_edges(),
			str(surface.get("label", surface_id)).strip_edges()
		]
		btn.disabled = not bool(surface.get("enabled", true))
		btn.pressed.connect(func ():
			_open_contract_surface(surface_id)
		)

		target.add_child(btn)
		ui_contract_surface_buttons [surface_id] = btn

func _open_contract_surface(surface_id: String, section_id: String = "") -> void:
	if gs == null or gs.ui_contract_engine == null:
		return

	var clean_surface: String = str(surface_id).strip_edges()
	if clean_surface == "":
		return

	var clean_section: String = str(section_id).strip_edges()

	set_meta("contract_surface_click_visual_only", true)
	set_meta("contract_surface_click_surface_id", clean_surface)
	set_meta("contract_surface_click_section_id", clean_section)
	set_meta("contract_surface_click_sync_view_model_forbidden", true)
	set_meta("contract_surface_click_sync_hud_update_forbidden", true)
	set_meta("contract_surface_click_at_ms", int(Time.get_ticks_msec()))

	ui_contract_active_surface_id = clean_surface
	ui_contract_active_section_id = clean_section

	_ensure_contract_surface_panel()

	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		ui_contract_surface_panel.visible = true
		ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_STOP
		_bring_modal_to_front(ui_contract_surface_panel)

	call_deferred("_populate_contract_surface_after_visual_open", clean_surface, clean_section)
func _populate_contract_surface_after_visual_open(
	surface_id: String,
	section_id: String = ""
) -> void:
	if gs == null:
		return

	var started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_surface: String = str(
		surface_id
	).strip_edges()

	if clean_surface == "":
		return

	var clean_section: String = str(
		section_id
	).strip_edges()
	var viewport_size: Vector2 = (
		get_viewport_rect().size
	)
	var context: Dictionary = {
		"panel": current_panel,
		"player_id": (
			int(gs.player.id)
			if gs.player != null
			else -1
		),
		"actor_id": (
			int(gs.player.id)
			if gs.player != null
			else -1
		),
		"year": int(gs.year),
		"viewport_width": int(
			viewport_size.x
		),
		"viewport_height": int(
			viewport_size.y
		),
		"device_profile": (
			_ui_contract_device_profile_from_viewport(
				viewport_size
			)
		),
		"active_section_id": clean_section,
		"source": (
			"populate_contract_surface_after_visual_open"
		),
		"active_section_only": true,
		"ui_is_expression_only": true
	}
	var surface: Dictionary = (
		_request_runtime_engine_method_intent(
			"ui_contract_engine",
			"get_surface_view_model",
			[
				clean_surface,
				context
			],
			"contract_surface_view_model:%s:%s" % [
				clean_surface,
				clean_section
			],
			(
				"mainscene."
				+ "populate_contract_surface_after_visual_open"
			)
		)
	)

	if (
		surface.is_empty()
		or str(
			surface.get(
				"surface_id",
				""
			)
		).strip_edges() == ""
	):
		if (
			ui_contract_surface_panel != null
			and is_instance_valid(
				ui_contract_surface_panel
			)
		):
			ui_contract_surface_panel.visible = false
			ui_contract_surface_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Hub Unavailable",
			"popup_text": (
				"This contract surface is not available "
				+ "for this character, age, or era."
			),
			"popup_footer": "Tap anywhere to continue."
		})
		return

	ui_contract_active_surface_id = clean_surface
	ui_contract_active_section_id = str(
		surface.get(
			"active_section_id",
			clean_section
		)
	).strip_edges()

	_ensure_contract_surface_panel()
	_populate_contract_surface_panel(
		surface
	)

	if (
		ui_contract_surface_panel != null
		and is_instance_valid(
			ui_contract_surface_panel
		)
	):
		ui_contract_surface_panel.visible = true
		ui_contract_surface_panel.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)
		_bring_modal_to_front(
			ui_contract_surface_panel
		)

	var finished_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var truth_line: String = (
		"ERALIFE_CONTRACT_SURFACE_LENS_TRUTH"
		+ "|surface_id=%s"
		+ "|section_id=%s"
		+ "|global_intent_routed=true"
		+ "|renderer_called_engine_directly=false"
		+ "|inactive_sections_resolved=false"
		+ "|duration_ms=%d"
		+ "|at_ms=%d"
	) % [
		clean_surface,
		ui_contract_active_surface_id,
		maxi(
			0,
			finished_at_ms - started_at_ms
		),
		finished_at_ms
	]

	EraLog.truth(
		truth_line
	)

	call_deferred(
		"_update_food_lifestyle_hud"
	)
func _ensure_contract_surface_panel() -> void:
	if ui_contract_surface_panel != null and is_instance_valid(ui_contract_surface_panel):
		return

	ui_contract_surface_panel = PanelContainer.new()
	ui_contract_surface_panel.name = "UIContractSurfacePanel"
	ui_contract_surface_panel.visible = false
	ui_contract_surface_panel.z_index = 700
	ui_contract_surface_panel.mouse_filter = Control.MOUSE_FILTER_STOP
	ui_contract_surface_panel.anchor_left = 0.01
	ui_contract_surface_panel.anchor_right = 0.99
	ui_contract_surface_panel.anchor_top = 0.01
	ui_contract_surface_panel.anchor_bottom = 0.99
	ui_contract_surface_panel.offset_left = 0.0
	ui_contract_surface_panel.offset_right = 0.0
	ui_contract_surface_panel.offset_top = 0.0
	ui_contract_surface_panel.offset_bottom = 0.0
	ui_contract_surface_panel.custom_minimum_size = Vector2(0, 0)

	var panel_style:= StyleBoxFlat.new()
	panel_style.bg_color = Color(0.025, 0.032, 0.045, 0.975)
	panel_style.border_color = Color(0.7, 0.96, 1.0, 0.54)
	panel_style.border_width_left = 2
	panel_style.border_width_top = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.corner_radius_top_left = 18
	panel_style.corner_radius_top_right = 18
	panel_style.corner_radius_bottom_left = 18
	panel_style.corner_radius_bottom_right = 18
	ui_contract_surface_panel.add_theme_stylebox_override("panel", panel_style)

	add_child(ui_contract_surface_panel)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 10)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 10)
	margin.add_theme_constant_override("margin_bottom", 10)
	ui_contract_surface_panel.add_child(margin)

	var scroll:= ScrollContainer.new()
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	margin.add_child(scroll)

	ui_contract_surface_root = VBoxContainer.new()
	ui_contract_surface_root.name = "ui_contract_surface_root"
	ui_contract_surface_root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ui_contract_surface_root.size_flags_vertical = Control.SIZE_EXPAND_FILL
	ui_contract_surface_root.add_theme_constant_override("separation", 7)
	scroll.add_child(ui_contract_surface_root)
