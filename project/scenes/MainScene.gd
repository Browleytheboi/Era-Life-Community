func _crown_hub_current_summary_for_chrome() -> Dictionary:
	if gs == null or gs.player == null:
		return {}

	var cached_raw: Variant = get_meta("crown_hub_chrome_summary_cache", {})
	if typeof(cached_raw) == TYPE_DICTIONARY:
