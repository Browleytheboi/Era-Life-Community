	panel.mouse_exited.connect(_entity_relationship_profile_panel_hover_changed.bind(panel, false))


func _entity_relationship_profile_panel_hover_changed(panel: PanelContainer, hovered: bool) -> void:
	if panel == null or not is_instance_valid(panel):
		return

	panel.set_meta("entity_relationship_hovered", hovered)

	var panel_kind: String = str(panel.get_meta("entity_relationship_hover_panel_kind", "panel"))
	var accent: Color = _entity_relationship_current_era_accent()
	var glow_strength: float = 0.26 if hovered else 0.14

	if panel_kind == "vitals":
		glow_strength = 0.42 if hovered else 0.22
	elif panel_kind == "bond":
		glow_strength = 0.5 if hovered else 0.22

	panel.add_theme_stylebox_override("panel", MainSceneHelpers._entity_relationship_popup_panel_style(Color(accent.r, accent.g, accent.b, glow_strength)))

	var tween:= create_tween()
	tween.tween_property(panel, "scale", Vector2(1.012, 1.012) if hovered else Vector2.ONE, 0.12)


func _entity_relationship_apply_bond_panel_glow(bond_value: int) -> void:
	if entity_relationship_profile_bond_panel == null or not is_instance_valid(entity_relationship_profile_bond_panel):
		return

	var safe_bond: int = clampi(bond_value, 0, 100)
	var glow_alpha: float = 0.18
	if safe_bond >= 70:
		glow_alpha = 0.24 + (float(safe_bond - 70) / 30.0) * 0.34

	entity_relationship_profile_bond_panel.add_theme_stylebox_override(
		"panel",
		MainSceneHelpers._entity_relationship_popup_panel_style(Color(0.92, 0.18, 0.46, glow_alpha))
	)

	if safe_bond >= 100:
		var pulse:= create_tween()
		pulse.set_loops()
		pulse.tween_property(entity_relationship_profile_bond_panel, "modulate:a", 0.78, 0.72)
		pulse.tween_property(entity_relationship_profile_bond_panel, "modulate:a", 1.0, 0.72)


func _entity_relationship_current_era_accent() -> Color:
	var era_key: String = ""
	if has_method("_current_era_ui_theme_key"):
		era_key = str(call("_current_era_ui_theme_key")).strip_edges().to_lower()

	if era_key.find("ancient") >= 0:
		return Color(1.0, 0.78, 0.38, 1.0)
	if era_key.find("medieval") >= 0:
		return Color(0.88, 0.62, 1.0, 1.0)
	if era_key.find("industrial") >= 0:
		return Color(0.82, 0.74, 0.58, 1.0)
	if era_key.find("future") >= 0:
		return Color(0.42, 0.92, 1.0, 1.0)
	if era_key.find("chaos") >= 0 or era_key.find("fantasy") >= 0:
		return Color(1.0, 0.38, 0.78, 1.0)

	return Color(0.76, 1.0, 0.68, 1.0)


