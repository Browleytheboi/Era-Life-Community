		return true

	if bool(get_meta("god_mode_cover_release_waiting_for_atomic_playable_ui", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(gs.scenario_state.get("god_mode_life_prewarm_consumed", false)):
			return true
		if bool(gs.scenario_state.get("god_mode_life_entry_full_ui_ready", false)):
			return true
		if str(gs.scenario_state.get("spawn_shell_entry_policy", "")).strip_edges() == "full_playable_ui_from_prewarmed_capsule":
