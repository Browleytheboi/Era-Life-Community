	)
	crown_action_popup.set_meta("crown_population_graph_accent", accent)
	crown_action_popup.set_meta("crown_population_graph_active", false)
	crown_action_popup.set_meta("crown_population_graph_active_entity_id", "")
	crown_action_popup.set_meta("crown_population_graph_expanded", false)
	crown_action_popup.set_meta("crown_population_graph_expanded_entity_id", "")

	_connect_crown_population_graph_scroll_signals()

	var layer: Control = _crown_population_graph_layer(true)
