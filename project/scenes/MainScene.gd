func _start_god_mode_life_entry_audio_zero_frame(
		snapshot: Dictionary,
		reason: String = "god_mode_life_entry_audio"
) -> void:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var clean_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(
		snapshot
	)
	var should_play_birth_cry: bool = (
		MainSceneLogic._god_mode_birth_intro_cry_should_play(gs, 
			clean_snapshot
		)
	)
	var cached_birth_stream_available: bool = (
		birth_intro_cry_stream_cache != null
		and is_instance_valid(
			birth_intro_cry_stream_cache
		)
	)

	set_meta(
		"god_mode_audio_handoff_armed",
		false
	)
	set_meta(
		"god_mode_audio_active",
		false
	)
	set_meta(
		"god_mode_audio_fadeout_requested",
		false
	)
	set_meta(
		"god_mode_or_menu_audio_claim_released",
		true
	)
	set_meta(
		"spawn_ready_visible_ui_ready_for_audio",
		true
	)
	set_meta(
		"era_audio_claim_waits_for_first_life_shell_paint",
		true
	)

	era_audio_last_signature = ""
	era_audio_next_sync_ms = 0

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"god_mode_audio_handoff_armed"
		] = false
		gs.scenario_state [
			"god_mode_or_menu_audio_claim_released"
		] = true
		gs.scenario_state [
			"spawn_ready_visible_ui_ready_for_audio"
		] = true
		gs.scenario_state [
			"era_audio_claim_waits_for_first_life_shell_paint"
		] = true



	if (
		should_play_birth_cry
		and cached_birth_stream_available
	):
		_play_birth_intro_cry_zero_frame(
			"%s_birth_intro_cry" % reason
		)

		set_meta(
			"god_mode_birth_intro_cry_started_for_entry",
			true
		)

	var post_paint_connected: bool = bool(
		get_meta(
			"god_mode_life_entry_audio_post_paint_connected",
			false
		)
	)

	if not post_paint_connected:
		set_meta(
			"god_mode_life_entry_audio_post_paint_connected",
			true
		)

		var post_paint_callback: Callable = Callable(
			self,
			"_start_god_mode_life_entry_audio_after_first_paint"
		).bind(
			clean_snapshot.duplicate(true),
			reason
		)

		RenderingServer.frame_post_draw.connect(
			post_paint_callback,
			CONNECT_ONE_SHOT
		)

	set_meta(
		"god_mode_life_entry_audio_claimed_on_reveal_frame",
		true
	)
	set_meta(
		"god_mode_life_entry_audio_claimed_on_reveal_frame_reason",
		reason
	)
	set_meta(
		"god_mode_life_entry_audio_claimed_on_reveal_frame_at_ms",
		now_ms
	)
	set_meta(
		"god_mode_era_music_started_on_reveal_frame",
		false
	)

func _start_god_mode_life_entry_audio_after_first_paint(
	snapshot: Dictionary,
	reason: String = "god_mode_life_entry_audio",
	attempt: int = 0
) -> void:
	set_meta(
		"god_mode_life_entry_audio_post_paint_connected",
		false
	)

	if gs == null or gs.player == null:
		return

	var clean_snapshot: Dictionary = MainSceneHelpers._safe_dictionary(
		snapshot
	)
	var should_play_cry: bool = (
		MainSceneLogic._god_mode_birth_intro_cry_should_play(gs, 
			clean_snapshot
		)
	)
	var cry_started: bool = bool(
		get_meta(
			"god_mode_birth_intro_cry_started_for_entry",
			false
		)
	)

	if should_play_cry and not cry_started:
		cry_started = _play_birth_intro_cry_zero_frame(
			"%s_birth_intro_cry_after_first_paint"
			% reason
		)

		if cry_started:
			set_meta(
				"god_mode_birth_intro_cry_started_for_entry",
				true
			)
			set_meta(
				"god_mode_birth_intro_cry_started_for_entry_attempt",
				attempt
			)
		else:
			var stream_pending: bool = bool(
				get_meta(
					"birth_intro_cry_stream_threaded_pending",
					false
				)
			)

			if stream_pending and attempt < 120:
				var tree:= get_tree()

				if tree != null:
					var retry_timer:= tree.create_timer(
						0.05
					)

					retry_timer.timeout.connect(
						Callable(
							self,
							"_start_god_mode_life_entry_audio_after_first_paint"
						).bind(
							clean_snapshot.duplicate(false),
							reason,
							attempt + 1
						),
						CONNECT_ONE_SHOT
					)
					return

			set_meta(
				"god_mode_birth_intro_cry_failed_for_entry",
				true
			)
			set_meta(
				"god_mode_birth_intro_cry_failed_for_entry_reason",
				reason
			)
			set_meta(
				"god_mode_birth_intro_cry_failed_for_entry_attempt",
				attempt
			)

	era_audio_last_signature = ""
	era_audio_next_sync_ms = 0

	_sync_era_audio_contract_from_current_world(
		"%s_era_music_claim_after_first_paint"
		% reason
	)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"god_mode_era_music_started_after_first_paint",
		true
	)
	set_meta(
		"god_mode_era_music_started_after_first_paint_at_ms",
		now_ms
	)
	set_meta(
		"ready_door_audio_load_did_not_delay_first_paint",
		true
	)
	set_meta(
		"god_mode_birth_intro_cry_started_before_era_claim",
		cry_started
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"god_mode_era_music_started_after_first_paint"
		] = true
		gs.scenario_state [
			"god_mode_era_music_started_after_first_paint_at_ms"
		] = now_ms
		gs.scenario_state [
			"ready_door_audio_load_did_not_delay_first_paint"
		] = true
		gs.scenario_state [
			"god_mode_birth_intro_cry_started_before_era_claim"
		] = cry_started

	EraLog.truth(
		(
			"ERALIFE_READY_AUDIO_START_TRUTH"
			+ "|reason=%s"
			+ "|menu_audio_hard_stopped=true"
			+ "|birth_intro_cry_required=%s"
			+ "|birth_intro_cry_started=%s"
			+ "|era_music_after_first_paint=true"
			+ "|at_ms=%d"
		)
		% [
			reason,
			str(should_play_cry),
			str(cry_started),
			now_ms
		]
	)
func _play_birth_intro_cry_zero_frame(
	reason: String = "god_mode_birth_intro_cry"
) -> bool:
	var stream: AudioStream = _birth_intro_cry_stream()

	if stream == null:
		return false

	var player:= _ensure_birth_intro_cry_player()

	if player == null:
		return false

	var contract: Dictionary = MainSceneHelpers._birth_intro_cry_audio_contract()

	if player.playing:
		player.stop()

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.stream = stream
	player.bus = str(
		contract.get(
			"bus",
			"Master"
		)
	)
	player.volume_db = float(
		contract.get(
			"volume_db",
			-1.25
		)
	)
	player.pitch_scale = float(
		contract.get(
			"pitch_scale",
			1.0
		)
	)
	player.play(0.0)

	var started: bool = player.playing

	set_meta(
		"birth_intro_cry_zero_frame_started",
		started
	)
	set_meta(
		"birth_intro_cry_zero_frame_started_reason",
		reason
	)
	set_meta(
		"birth_intro_cry_zero_frame_started_at_ms",
		int(Time.get_ticks_msec())
	)

	return started

func _record_god_mode_playable_surface_contract_composition_failed(surface_id: String, snapshot: Dictionary, settings: Dictionary, reason: String = "god_mode_contract_surface_render") -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var clean_surface_id: String = str(surface_id).strip_edges()

	if clean_surface_id != "" and str(get_meta("last_rendered_god_mode_playable_surface_contract_id", "")) == clean_surface_id:
		set_meta("last_rendered_god_mode_playable_surface_contract_id", "")

	set_meta("pending_rendered_god_mode_playable_surface_contract_id", "")
	set_meta("god_mode_playable_surface_contract_composition_failed", true)
	set_meta("god_mode_playable_surface_contract_composition_failed_surface_id", clean_surface_id)
	set_meta("god_mode_playable_surface_contract_composition_failed_reason", reason)
	set_meta("god_mode_playable_surface_contract_composition_failed_at_ms", now_ms)
	set_meta("god_mode_playable_ui_atomic_commit_complete", false)
	set_meta("first_visible_life_shell_final_composition_complete", false)
	set_meta("ready_button_fallback_build_forbidden", true)
	set_meta("minimum_shell_fallback_banned", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_playable_surface_contract_composition_failed"] = true
		gs.scenario_state ["god_mode_playable_surface_contract_composition_failed_surface_id"] = clean_surface_id
		gs.scenario_state ["god_mode_playable_surface_contract_composition_failed_reason"] = reason
		gs.scenario_state ["god_mode_playable_surface_contract_composition_failed_at_ms"] = now_ms
		gs.scenario_state ["god_mode_playable_ui_atomic_commit_complete"] = false
		gs.scenario_state ["first_visible_life_shell_final_composition_complete"] = false
		gs.scenario_state ["ready_button_fallback_build_forbidden"] = true
		gs.scenario_state ["minimum_shell_fallback_banned"] = true
		gs.scenario_state ["god_mode_surface_contract_retry_allowed"] = true
