func _ensure_god_mode_menu_music_tracks_registered() -> void:
	if era_audio_contract.is_empty():
		era_audio_contract = _build_default_era_audio_contract()

	var tracks_raw: Variant = era_audio_contract.get("tracks", {})
	var tracks: Dictionary = tracks_raw if typeof(tracks_raw) == TYPE_DICTIONARY else {}

	var context_routes_raw: Variant = era_audio_contract.get("context_routes", {})
	var context_routes: Dictionary = context_routes_raw if typeof(context_routes_raw) == TYPE_DICTIONARY else {}

	var presentation_routes_raw: Variant = era_audio_contract.get("presentation_routes", {})
	var presentation_routes: Dictionary = presentation_routes_raw if typeof(presentation_routes_raw) == TYPE_DICTIONARY else {}

	var profile: Dictionary = _god_mode_menu_music_profile()
	var context_keys: Array = profile.get("context_keys", []) if typeof(profile.get("context_keys", [])) == TYPE_ARRAY else []
	var variants: Array = profile.get("track_variants", []) if typeof(profile.get("track_variants", [])) == TYPE_ARRAY else []

	var first_track_id: String = ""
	for raw_variant in variants:
		if typeof(raw_variant) != TYPE_DICTIONARY:
			continue

		var variant: Dictionary = raw_variant
		var track_id: String = str(variant.get("id", "")).strip_edges()
		var file_name: String = str(variant.get("file", "")).strip_edges()
		if track_id == "" or file_name == "":
			continue

		if first_track_id == "":
			first_track_id = track_id

		tracks [track_id] = {
			"id": track_id,
			"display_name": str(variant.get("display_name", profile.get("display_name", "God Mode Menu Beat"))),
			"path": MainSceneHelpers._god_mode_menu_music_resolve_path(file_name),
			"context_keys": context_keys.duplicate(true),
			"loop": false,
			"volume_db": float(profile.get("volume_db", -12.0)),
			"fade_ms": int(profile.get("fade_in_ms", 700)),
			"bus": "Master",
			"playlist_id": str(profile.get("playlist_id", "god_mode_menu_music")),
			"loop_fade_tail_ms": int(profile.get("rotation_crossfade_ms", 1800))
		}

	if first_track_id != "":
		for raw_context_key in context_keys:
			var context_key: String = str(raw_context_key).strip_edges()
			if context_key != "" and not context_routes.has(context_key):
				context_routes [context_key] = first_track_id
			if context_key != "" and not presentation_routes.has(context_key):
				presentation_routes [context_key] = first_track_id

	era_audio_contract ["tracks"] = tracks
	era_audio_contract ["context_routes"] = context_routes
	era_audio_contract ["presentation_routes"] = presentation_routes


func _god_mode_menu_music_track_ids() -> Array:
	var out: Array = []
	var profile: Dictionary = _god_mode_menu_music_profile()
	var variants: Array = profile.get("track_variants", []) if typeof(profile.get("track_variants", [])) == TYPE_ARRAY else []

	for raw_variant in variants:
		if typeof(raw_variant) != TYPE_DICTIONARY:
			continue
		var variant: Dictionary = raw_variant
		var track_id: String = str(variant.get("id", "")).strip_edges()
		if track_id != "" and not out.has(track_id):
			out.append(track_id)

	return out


func _god_mode_menu_music_pick_track_id(reason: String = "menu_open", avoid_current: bool = false) -> String:
	_ensure_god_mode_menu_music_tracks_registered()

	var track_ids: Array = _god_mode_menu_music_track_ids()
	if track_ids.is_empty():
		return ""

	var current_track: String = ""
	if era_audio_engine != null and is_instance_valid(era_audio_engine):
		current_track = str(era_audio_engine.current_track_id).strip_edges()
	if current_track == "":
		current_track = str(get_meta("god_mode_menu_music_last_track_id", "")).strip_edges()

	var candidates: Array = track_ids.duplicate()
	if avoid_current and candidates.size() > 1 and current_track != "":
		while candidates.has(current_track):
			candidates.erase(current_track)

	var seed_text: String = "%s|%s|%s|%s|god_mode_menu_music" % [
		reason,
		str(get_meta("god_mode_menu_music_rotation_index", 0)),
		current_track,
		str(Time.get_ticks_msec())
	]
	var seed_value: int = int(hash(seed_text))
	if seed_value < 0:
		seed_value = - seed_value
	if seed_value <= 0:
		seed_value = 1

	var rng:= RandomNumberGenerator.new()
	rng.seed = seed_value
	return str(candidates [int(rng.randi_range(0, candidates.size() - 1))])


func _god_mode_menu_music_apply_active_route(track_id: String) -> void:
	var clean_track_id: String = str(track_id).strip_edges()
	if clean_track_id == "":
		return

	_ensure_god_mode_menu_music_tracks_registered()

	var context_routes_raw: Variant = era_audio_contract.get("context_routes", {})
	var context_routes: Dictionary = context_routes_raw if typeof(context_routes_raw) == TYPE_DICTIONARY else {}

	var presentation_routes_raw: Variant = era_audio_contract.get("presentation_routes", {})
	var presentation_routes: Dictionary = presentation_routes_raw if typeof(presentation_routes_raw) == TYPE_DICTIONARY else {}

	var profile: Dictionary = _god_mode_menu_music_profile()
	var context_keys: Array = profile.get("context_keys", []) if typeof(profile.get("context_keys", [])) == TYPE_ARRAY else []

	for raw_context_key in context_keys:
		var context_key: String = str(raw_context_key).strip_edges()
		if context_key == "":
			continue
		context_routes [context_key] = clean_track_id
		presentation_routes [context_key] = clean_track_id

	era_audio_contract ["context_routes"] = context_routes
	era_audio_contract ["presentation_routes"] = presentation_routes
	set_meta("god_mode_menu_music_last_track_id", clean_track_id)
	set_meta("god_mode_menu_music_last_route_applied_at_ms", int(Time.get_ticks_msec()))


func _god_mode_menu_music_start_or_rotate(reason: String = "menu_open", fade_ms: int = 920, avoid_current: bool = false) -> Dictionary:
	if not era_audio_enabled:
		return {}

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return {}

	_ensure_god_mode_menu_music_tracks_registered()

	var track_ids: Array = _god_mode_menu_music_track_ids()
	if track_ids.is_empty():
		return {}

	var current_track: String = str(engine.current_track_id).strip_edges()
	var current_player_active: bool = engine.current_player != null and is_instance_valid(engine.current_player) and engine.current_player.playing
	var preserve_current_track: bool = not avoid_current and current_track != "" and track_ids.has(current_track) and current_player_active

	var track_id: String = current_track if preserve_current_track else _god_mode_menu_music_pick_track_id(reason, avoid_current)
	if track_id == "":
		return {}

	_god_mode_menu_music_apply_active_route(track_id)

	var context: Dictionary = _god_mode_audio_context(reason)
	context ["audio_fade_ms"] = fade_ms
	context ["audio_restart_policy"] = "preserve_current"
	context ["god_mode_menu_music_rotation"] = not preserve_current_track
	context ["god_mode_menu_music_preserved_current_track"] = preserve_current_track
	context ["god_mode_menu_music_track_id"] = track_id
	context ["reason"] = reason

	var report: Dictionary = engine.apply_audio_contract(era_audio_contract, context)
	set_meta("god_mode_menu_music_last_report", report.duplicate(true))
	set_meta("god_mode_menu_music_last_reason", reason)
	set_meta("god_mode_menu_music_last_rotation_at_ms", int(Time.get_ticks_msec()))

	if not preserve_current_track:
		set_meta("god_mode_menu_music_rotation_index", int(get_meta("god_mode_menu_music_rotation_index", 0)) + 1)

	return report


func _drive_god_mode_menu_music_rotation(_delta: float) -> void:
	if not _god_mode_runtime_allowed("_drive_god_mode_menu_music_rotation", "music_rotation"):
		return

	if not era_audio_enabled:
		return
	if not _god_mode_or_menu_presentation_active():
		return
	if bool(get_meta("god_mode_audio_fadeout_requested", false)):
		return

	_ensure_god_mode_menu_music_tracks_registered()

	var engine = _ensure_era_audio_engine()
	if engine == null:
		return

	var track_ids: Array = _god_mode_menu_music_track_ids()
	if track_ids.is_empty():
		return

	var current_track: String = str(engine.current_track_id).strip_edges()
	if current_track == "" or not track_ids.has(current_track):
		_god_mode_menu_music_start_or_rotate("god_mode_menu_music_missing_current", 760, false)
		return

	var player: AudioStreamPlayer = engine.current_player
	if player == null or not is_instance_valid(player):
		_god_mode_menu_music_start_or_rotate("god_mode_menu_music_missing_player", 760, true)
		return

	if not player.playing:
		_god_mode_menu_music_start_or_rotate("god_mode_menu_music_finished", 920, true)
		return

	var stream: AudioStream = player.stream
	if stream == null:
		return

	var stream_length: float = float(stream.get_length())
	if stream_length <= 1.0:
		return

	var profile: Dictionary = _god_mode_menu_music_profile()
	var lead_seconds: float = MainSceneHelpers._god_mode_menu_music_transition_lead_seconds_for_stream(stream_length, profile)
	var remaining: float = stream_length - float(player.get_playback_position())

	if remaining <= lead_seconds:
		var next_allowed_ms: int = int(get_meta("god_mode_menu_music_next_rotation_allowed_ms", 0))
		var now_ms: int = int(Time.get_ticks_msec())
		if now_ms < next_allowed_ms:
			return

		set_meta("god_mode_menu_music_next_rotation_allowed_ms", now_ms + int(max(350.0, (lead_seconds + 0.18) * 1000.0)))
		_god_mode_menu_music_start_or_rotate(
			"god_mode_menu_music_crossfade_tail",
			int(profile.get("rotation_crossfade_ms", 520)),
			true
		)


