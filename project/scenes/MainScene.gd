	_claim_god_mode_tracker_playable_surface("%s_prime_surface" % reason)
func _force_spawn_ready_live_ui_shell(reason: String = "spawn_ready") -> void:
	if gs == null or gs.player == null:
		return
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(Time.get_ticks_msec())
	var prewarmed_full_ui_entry: bool = bool(gs.scenario_state.get("god_mode_life_prewarm_consumed", false)) \
or bool(gs.scenario_state.get("prewarmed_capsule_entry_requested_at_ms", 0)) \
or str(reason).find("prewarmed") >= 0 \
or str(reason).find("god_mode") >= 0

	if prewarmed_full_ui_entry:
		_prime_prewarmed_capsule_live_ui_surface_without_handoff(reason)
		return

	_reset_age_up_tail_state_for_new_life_handoff(reason)

	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("live_diagnostics_manual_throttle_enabled", false)
	set_meta("player_stats_spawn_cinematic_pending", false)
	set_meta("spawn_ready_ui_reconcile_pending", true)
	set_meta("spawn_ready_ui_first_frame_boundary_active", true)
	set_meta("spawn_ready_ui_first_frame_boundary_reason", reason)
	set_meta("spawn_ready_ui_first_frame_boundary_started_at_ms", now_ms)
	set_meta("standard_tab_close_navigation_grace_until_ms", now_ms + 1200)
	set_meta("spawn_ready_ui_reconcile_reason", reason)
	set_meta("spawn_ready_ui_reconcile_started_at_ms", now_ms)
	set_meta("spawn_ready_runtime_hud_shell_only_active", false)
	set_meta("spawn_ready_runtime_hud_shell_only_reason", reason)
	set_meta("spawn_ready_runtime_hud_shell_only_started_at_ms", 0)

	_invalidate_life_diary_contract_render_cache("force_spawn_ready_live_ui_shell")

	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["god_mode_boot_life_diary_released"] = true
	gs.scenario_state ["spawn_ready_live_ui_shell_released"] = true
	gs.scenario_state ["spawn_ready_live_ui_shell_reason"] = reason
	gs.scenario_state ["spawn_ready_live_ui_shell_released_at_ms"] = now_ms
	gs.scenario_state ["spawn_ready_first_frame_boundary_active"] = true
	gs.scenario_state ["spawn_ready_first_frame_boundary_reason"] = reason
	gs.scenario_state ["spawn_shell_entry_policy"] = "main_shell_first_user_intent_tabs"
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["ui_packet_contract_policy"] = "satisfied_or_synthesized_deferred_truth"
	gs.scenario_state ["ui_first_frame_render_policy"] = "life_shell_visible_no_runtime_work"
	gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false
	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false))
	gs.scenario_state ["birth_shell_first_boot_active"] = bool(gs.scenario_state.get("birth_shell_first_boot_active", false))

	_hide_god_mode_cover_nodes_for_live_spawn("%s_force_spawn_ready_live_ui_shell" % reason)
	_cancel_panel_content_transition()
	_set_main_gameplay_ui_visible(true)
	current_panel = "life"

	if standard_tab_popup_open:
		_hide_standard_tab_popup()
	if relationship_profile_popup_open:
		_hide_relationship_profile_popup()
	if relationships_browser_open:
		_hide_relationship_browser()
	if activities_action_open:
		_hide_activities_action_panel()
	if world_feed_popup_open:
		_hide_world_action_panel()

	_hide_floating_quick_panels()

	if output_label != null:
		output_label.visible = true
		output_label.scroll_active = true
		output_label.bbcode_enabled = true

	var era_border_should_reset: bool = era_border_overlay == null or not era_border_overlay.visible
	_show_era_border_overlay_for_current_era(era_border_should_reset)

	_ensure_player_stats_overlay()
	_bind_ui_nav_buttons()
	_apply_ui_nav_button_visuals()
	_set_birth_shell_interactive_controls_visible(true)

	_schedule_spawn_ready_main_tab_packet_prewarm_after_shell("%s_spawn_ready_live_full_ui" % reason)

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true

	var consumed_first_frame_snapshot: bool = _consume_first_frame_ui_snapshot_for_live_shell(reason)
	set_meta("player_stats_spawn_fill_consumed", consumed_first_frame_snapshot)

	if not consumed_first_frame_snapshot:
		_update_player_stats_overlay()

	_paint_spawn_ready_life_diary_shell_first_frame(reason)
	_reveal_spawn_ready_runtime_hud_buttons_if_existing(reason)

	_release_god_mode_handoff_cover_after_shell_paint("%s_force_full_ui" % reason)

	belongings_hud_content_dirty = true
	_schedule_spawn_ready_live_ui_reconcile(reason)

	set_meta("birth_intro_cry_waiting_for_god_mode_cover_release", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["birth_intro_cry_waiting_for_god_mode_cover_release"] = true
		gs.scenario_state ["birth_intro_cry_waiting_for_god_mode_cover_release_reason"] = reason
		gs.scenario_state ["birth_intro_cry_waiting_for_god_mode_cover_release_at_ms"] = int(Time.get_ticks_msec())
func _spawn_ready_life_output_needs_first_paint() -> bool:
	if output_label == null:
		return false

	var current_text: String = str(output_label.text).strip_edges()
	if current_text == "":
		return true

	var lower_text: String = current_text.to_lower()
	if lower_text.find("choose sandbox mode") != -1:
		return true
	if lower_text.find("choose sandbox mode options to start") != -1:
		return true
	if lower_text.find("choose sandbox") != -1:
		return true

	return false
func _build_spawn_ready_birth_intro_first_frame_lines(reason: String = "spawn_ready") -> Array:
	if gs == null or gs.player == null:
		return []

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var actor_id: int = int(gs.player.id)
	var primary_actor_id: int = MainSceneLogic._spawn_ready_primary_birth_actor_id(gs)

	if actor_id != primary_actor_id:
		var existing_lines: Array = _flatten_life_diary_lines()
		if not existing_lines.is_empty():
			return existing_lines

		return [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(gs.player.age),
			"I am living as %s." % MainSceneHelpers._person_display_name_for_identity_switch(gs.player)
		]

	var cached_actor_id: int = int(gs.scenario_state.get("spawn_ready_birth_intro_first_frame_actor_id", -1))
	var cached_raw: Variant = gs.scenario_state.get("spawn_ready_birth_intro_first_frame_lines", [])
	if cached_actor_id == actor_id and typeof(cached_raw) == TYPE_ARRAY and not (cached_raw as Array).is_empty():
		return (cached_raw as Array).duplicate(true)

	var lines: Array = _build_new_life_intro_lines()
	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(gs.player.age),
			"I was born in %s." % _format_year(gs.year)
		]

	gs.scenario_state ["spawn_ready_birth_intro_first_frame_actor_id"] = actor_id
	gs.scenario_state ["spawn_ready_birth_intro_first_frame_lines"] = lines.duplicate(true)
	gs.scenario_state ["spawn_ready_birth_intro_first_frame_reason"] = reason
	gs.scenario_state ["spawn_ready_birth_intro_first_frame_cached_at_ms"] = int(Time.get_ticks_msec())

	return lines
func _paint_spawn_ready_life_diary_shell_first_frame(reason: String = "spawn_ready") -> void:
	if gs == null or gs.player == null:
		return
	if output_label == null:
		return

	current_panel = "life"



	var lines: Array = _ensure_spawn_ready_birth_intro_entry(reason)
	if lines.is_empty():
		lines = _flatten_life_diary_lines()
	if lines.is_empty():
		lines = _build_spawn_ready_birth_intro_first_frame_lines(reason)
	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year),
			"Age: %d" % int(gs.player.age),
			"I was born in %s." % _format_year(gs.year)
		]

	var shell_signature: String = _life_diary_render_signature()

	output_label.visible = true
	output_label.scroll_active = true
	output_label.bbcode_enabled = true
	output_label.set_meta("life_diary_render_signature", shell_signature)
	_ui_block(lines)

	set_meta("life_diary_render_cached_lines", lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", shell_signature)
	set_meta("spawn_ready_life_diary_truth_commit_deferred", false)
	set_meta("spawn_ready_life_diary_truth_commit_reason", reason)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_boot_life_diary_released"] = true
		gs.scenario_state ["spawn_ready_life_diary_visible"] = true
		gs.scenario_state ["spawn_ready_life_diary_visible_reason"] = reason
		gs.scenario_state ["spawn_ready_life_diary_shell_first_frame"] = true
		gs.scenario_state ["spawn_ready_life_diary_truth_commit_deferred"] = false
		gs.scenario_state ["spawn_ready_life_diary_visible_at_ms"] = int(Time.get_ticks_msec())

	call_deferred("_prepare_life_diary_render_cache", shell_signature)

