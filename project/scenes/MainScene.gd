func _ensure_character_switch_audio_player() -> AudioStreamPlayer:
	if (
		character_switch_audio_player != null
		and is_instance_valid(
			character_switch_audio_player
		)
	):
		character_switch_audio_player.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		character_switch_audio_player.stream_paused = false
		character_switch_audio_player.bus = "Master"

		return character_switch_audio_player

	var existing:= (
		get_node_or_null(
			"CharacterSwitchAudioPlayer"
		) as AudioStreamPlayer
	)

	if (
		existing != null
		and is_instance_valid(existing)
	):
		character_switch_audio_player = existing
		character_switch_audio_player.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		character_switch_audio_player.stream_paused = false
		character_switch_audio_player.autoplay = false
		character_switch_audio_player.bus = "Master"

		return character_switch_audio_player

	character_switch_audio_player = (
		AudioStreamPlayer.new()
	)
	character_switch_audio_player.name = (
		"CharacterSwitchAudioPlayer"
	)
	character_switch_audio_player.process_mode = (
		Node.PROCESS_MODE_ALWAYS
	)
	character_switch_audio_player.stream_paused = false
	character_switch_audio_player.autoplay = false
	character_switch_audio_player.bus = "Master"

	add_child(
		character_switch_audio_player
	)

	return character_switch_audio_player


func _character_switch_audio_stream() -> AudioStream:
	if character_switch_audio_stream_cache != null:
		return character_switch_audio_stream_cache

	var contract: Dictionary = (
		MainSceneHelpers._character_switch_audio_contract()
	)
	var paths: Array = contract.get(
		"paths",
		[]
	)
	var engine = _ensure_era_audio_engine()

	if (
		engine == null
		or not engine.has_method(
			"request_audio_stream"
		)
	):
		set_meta(
			"character_switch_audio_authority_missing",
			true
		)
		return null

	var report: Dictionary = (
		engine.request_audio_stream(
			paths,
			{
				"source": (
					"mainscene."
					+ "character_switch_audio"
				),
				"one_shot": true,
				"ready_gate_member": false
			}
		)
	)

	set_meta(
		"character_switch_audio_stream_report",
		report.duplicate(true)
	)
	set_meta(
		"character_switch_audio_stream_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)

	var stream_raw: Variant = report.get(
		"stream",
		null
	)

	if stream_raw is AudioStream:
		character_switch_audio_stream_cache = (
			stream_raw as AudioStream
		)

		set_meta(
			"character_switch_audio_stream_path",
			str(
				report.get(
					"stream_path",
					""
				)
			)
		)
		set_meta(
			"character_switch_audio_stream_missing",
			false
		)

		return character_switch_audio_stream_cache

	return null

func _character_switch_audio_report(success: bool, reason: String, context: Dictionary = {}) -> Dictionary:
	var report: Dictionary = {
		"schema": "eralife.one_shot_audio_event_report",
		"version": 1,
		"event_id": "character_switch",
		"success": success,
		"reason": reason,
		"context": context.duplicate(true),
		"created_at_ms": int(Time.get_ticks_msec())
	}

	set_meta("character_switch_audio_last_report", report.duplicate(true))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["character_switch_audio_last_report"] = report.duplicate(true)
		gs.scenario_state ["character_switch_audio_last_reason"] = reason
		gs.scenario_state ["character_switch_audio_last_report_at_ms"] = int(Time.get_ticks_msec())

	return report


func _character_switch_active_era_music_players() -> Array:
	var out: Array = []
	if era_audio_engine == null or not is_instance_valid(era_audio_engine):
		return out

	MainSceneHelpers._append_character_switch_duck_player(out, era_audio_engine.current_player)
	MainSceneHelpers._append_character_switch_duck_player(out, era_audio_engine.primary_player)
	MainSceneHelpers._append_character_switch_duck_player(out, era_audio_engine.secondary_player)

	return out


func _restore_character_switch_ducked_era_music_immediate(reason: String = "immediate_restore") -> void:
	if character_switch_audio_duck_tween != null:
		character_switch_audio_duck_tween.kill()
		character_switch_audio_duck_tween = null

	if character_switch_audio_restore_tween != null:
		character_switch_audio_restore_tween.kill()
		character_switch_audio_restore_tween = null

	for raw_player in character_switch_audio_ducked_players:
		var audio_player:= raw_player as AudioStreamPlayer
		if audio_player == null or not is_instance_valid(audio_player):
			continue

		var volume_key: String = str(audio_player.get_instance_id())
		if not character_switch_audio_original_volumes.has(volume_key):
			continue

		audio_player.volume_db = float(character_switch_audio_original_volumes.get(volume_key, audio_player.volume_db))

	character_switch_audio_ducked_players.clear()
	character_switch_audio_original_volumes.clear()
	set_meta("character_switch_audio_duck_active", false)
	set_meta("character_switch_audio_duck_restore_reason", reason)
	set_meta("character_switch_audio_duck_restored_at_ms", int(Time.get_ticks_msec()))


func _duck_era_music_for_character_switch_audio(context: Dictionary) -> void:
	_restore_character_switch_ducked_era_music_immediate("new_character_switch_duck")

	var contract: Dictionary = MainSceneHelpers._character_switch_audio_contract()
	var players: Array = _character_switch_active_era_music_players()
	if players.is_empty():
		set_meta("character_switch_audio_duck_active", false)
		return

	var duck_fade_seconds: float = float(int(contract.get("duck_fade_ms", 95))) / 1000.0
	var drop_db: float = float(contract.get("duck_volume_drop_db", 17.0))
	var minimum_duck_volume_db: float = float(contract.get("minimum_duck_volume_db", -31.0))

	character_switch_audio_ducked_players = players.duplicate()
	character_switch_audio_original_volumes.clear()

	if character_switch_audio_duck_tween != null:
		character_switch_audio_duck_tween.kill()
		character_switch_audio_duck_tween = null

	character_switch_audio_duck_tween = create_tween().bind_node(self)
	character_switch_audio_duck_tween.set_trans(Tween.TRANS_SINE)
	character_switch_audio_duck_tween.set_ease(Tween.EASE_OUT)

	var wrote_tween: bool = false
	for raw_player in players:
		var audio_player:= raw_player as AudioStreamPlayer
		if audio_player == null or not is_instance_valid(audio_player):
			continue

		var volume_key: String = str(audio_player.get_instance_id())
		var original_volume: float = float(audio_player.volume_db)
		var duck_volume: float = max(minimum_duck_volume_db, original_volume - drop_db)

		character_switch_audio_original_volumes [volume_key] = original_volume

		if not wrote_tween:
			character_switch_audio_duck_tween.tween_property(
				audio_player,
				"volume_db",
				duck_volume,
				duck_fade_seconds
			)
			wrote_tween = true
		else:
			character_switch_audio_duck_tween.parallel().tween_property(
				audio_player,
				"volume_db",
				duck_volume,
				duck_fade_seconds
			)

	set_meta("character_switch_audio_duck_active", wrote_tween)
	set_meta("character_switch_audio_duck_context", context.duplicate(true))
	set_meta("character_switch_audio_duck_started_at_ms", int(Time.get_ticks_msec()))


func _restore_era_music_after_character_switch_audio(token: int, immediate: bool = false) -> void:
	if token != character_switch_audio_generation:
		return

	if not bool(get_meta("character_switch_audio_duck_active", false)):
		return

	if immediate:
		_restore_character_switch_ducked_era_music_immediate("character_switch_immediate_restore")
		era_audio_last_signature = ""
		_sync_era_audio_contract_from_current_world("character_switch_audio_immediate_restore")
		return

	if character_switch_audio_duck_tween != null:
		character_switch_audio_duck_tween.kill()
		character_switch_audio_duck_tween = null

	if character_switch_audio_restore_tween != null:
		character_switch_audio_restore_tween.kill()
		character_switch_audio_restore_tween = null

	var contract: Dictionary = MainSceneHelpers._character_switch_audio_contract()
	var restore_fade_seconds: float = float(int(contract.get("restore_fade_ms", 180))) / 1000.0

	character_switch_audio_restore_tween = create_tween().bind_node(self)
	character_switch_audio_restore_tween.set_trans(Tween.TRANS_SINE)
	character_switch_audio_restore_tween.set_ease(Tween.EASE_OUT)

	var wrote_tween: bool = false
	for raw_player in character_switch_audio_ducked_players:
		var audio_player:= raw_player as AudioStreamPlayer
		if audio_player == null or not is_instance_valid(audio_player):
			continue

		var volume_key: String = str(audio_player.get_instance_id())
		if not character_switch_audio_original_volumes.has(volume_key):
			continue

		var restore_volume: float = float(character_switch_audio_original_volumes.get(volume_key, audio_player.volume_db))

		if not wrote_tween:
			character_switch_audio_restore_tween.tween_property(
				audio_player,
				"volume_db",
				restore_volume,
				restore_fade_seconds
			)
			wrote_tween = true
		else:
			character_switch_audio_restore_tween.parallel().tween_property(
				audio_player,
				"volume_db",
				restore_volume,
				restore_fade_seconds
			)

	if wrote_tween:
		await character_switch_audio_restore_tween.finished

	if token != character_switch_audio_generation:
		return

	character_switch_audio_ducked_players.clear()
	character_switch_audio_original_volumes.clear()
	set_meta("character_switch_audio_duck_active", false)
	set_meta("character_switch_audio_duck_restored_at_ms", int(Time.get_ticks_msec()))

	era_audio_last_signature = ""
	_sync_era_audio_contract_from_current_world("character_switch_audio_restore")


func _on_character_switch_audio_finished(token: int) -> void:
	if token != character_switch_audio_generation:
		return

	_restore_era_music_after_character_switch_audio(token, false)


func _schedule_character_switch_audio_restore_fallback(token: int, stream: AudioStream) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	var stream_length: float = 0.0
	if stream != null:
		stream_length = float(stream.get_length())

	var delay_seconds: float = max(0.34, stream_length + 0.08)
	var timer:= tree.create_timer(delay_seconds)
	timer.timeout.connect(
		Callable(self, "_restore_era_music_after_character_switch_audio").bind(token, false),
		CONNECT_ONE_SHOT
	)


func _play_character_switch_audio_for_relationship_control_switch(
	target: Person,
	previous_controlled_person_id: int,
	result: Dictionary = {},
	attempt: int = 0
) -> void:
	if target == null:
		_character_switch_audio_report(
			false,
			"missing_target"
		)
		return

	var context: Dictionary = {
		"source": "relationship_profile_switch",
		"previous_controlled_person_id": int(
			previous_controlled_person_id
		),
		"controlled_person_id": int(target.id),
		"controlled_person_name": (
			MainSceneHelpers._person_display_name_for_identity_switch(
				target
			)
		),
		"result": result.duplicate(true),
		"current_panel": current_panel,
		"year": int(gs.year) if gs != null else 0,
		"audio_attempt": attempt
	}

	var stream: AudioStream = (
		_character_switch_audio_stream()
	)

	if stream == null:
		var stream_pending: bool = bool(
			get_meta(
				"character_switch_audio_stream_pending",
				false
			)
		)

		if (
			stream_pending
			and attempt < 80
			and get_tree() != null
		):
			var retry_timer:= (
				get_tree().create_timer(
					0.05
				)
			)

			retry_timer.timeout.connect(
				Callable(
					self,
					(
						"_play_character_switch_audio_"
						+ "for_relationship_control_switch"
					)
				).bind(
					target,
					previous_controlled_person_id,
					result.duplicate(true),
					attempt + 1
				),
				CONNECT_ONE_SHOT
			)
			return

		_character_switch_audio_report(
			false,
			"missing_stream",
			context
		)
		return

	var player:= (
		_ensure_character_switch_audio_player()
	)

	if player == null:
		_character_switch_audio_report(
			false,
			"missing_player",
			context
		)
		return

	character_switch_audio_generation += 1
	var token: int = character_switch_audio_generation

	if player.playing:
		player.stop()

	_sync_era_audio_contract_from_current_world(
		"character_switch_before_duck"
	)
	_duck_era_music_for_character_switch_audio(
		context
	)

	var contract: Dictionary = (
		MainSceneHelpers._character_switch_audio_contract()
	)

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.stop()
	player.stream = stream
	player.bus = str(
		contract.get(
			"bus",
			"Master"
		)
	)
	player.volume_db = float(
		contract.get(
			"volume_db",
			-0.75
		)
	)
	player.pitch_scale = float(
		contract.get(
			"pitch_scale",
			1.0
		)
	)

	var finished_callable: Callable = Callable(
		self,
		"_on_character_switch_audio_finished"
	).bind(token)

	player.finished.connect(
		finished_callable,
		CONNECT_ONE_SHOT
	)

	player.play(0.0)

	_schedule_character_switch_audio_restore_fallback(
		token,
		stream
	)

	set_meta(
		"character_switch_audio_last_started_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"character_switch_audio_last_token",
		token
	)
	set_meta(
		"character_switch_audio_last_context",
		context.duplicate(true)
	)
	set_meta(
		"character_switch_audio_last_stream_path",
		str(
			get_meta(
				"character_switch_audio_stream_path",
				""
			)
		)
	)

	_character_switch_audio_report(
		true,
		"character_switch_audio_started",
		context
	)
func _ensure_birth_intro_cry_player() -> AudioStreamPlayer:
	if (
		birth_intro_cry_player != null
		and is_instance_valid(
			birth_intro_cry_player
		)
	):
		birth_intro_cry_player.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		birth_intro_cry_player.stream_paused = false
		birth_intro_cry_player.bus = "Master"

		return birth_intro_cry_player

	var existing:= (
		get_node_or_null(
			"BirthIntroCryPlayer"
		) as AudioStreamPlayer
	)

	if (
		existing != null
		and is_instance_valid(existing)
	):
		birth_intro_cry_player = existing
		birth_intro_cry_player.process_mode = (
			Node.PROCESS_MODE_ALWAYS
		)
		birth_intro_cry_player.stream_paused = false
		birth_intro_cry_player.autoplay = false
		birth_intro_cry_player.bus = "Master"

		return birth_intro_cry_player

	birth_intro_cry_player = AudioStreamPlayer.new()
	birth_intro_cry_player.name = "BirthIntroCryPlayer"
	birth_intro_cry_player.process_mode = (
		Node.PROCESS_MODE_ALWAYS
	)
	birth_intro_cry_player.stream_paused = false
	birth_intro_cry_player.autoplay = false
	birth_intro_cry_player.bus = "Master"

	add_child(
		birth_intro_cry_player
	)

	return birth_intro_cry_player

func _birth_intro_cry_stream() -> AudioStream:
	if birth_intro_cry_stream_cache != null:
		return birth_intro_cry_stream_cache

	var contract: Dictionary = (
		MainSceneHelpers._birth_intro_cry_audio_contract()
	)
	var paths: Array = contract.get(
		"paths",
		[]
	)
	var engine = _ensure_era_audio_engine()

	if (
		engine == null
		or not engine.has_method(
			"request_audio_stream"
		)
	):
		set_meta(
			"birth_intro_cry_audio_authority_missing",
			true
		)
		return null

	var report: Dictionary = (
		engine.request_audio_stream(
			paths,
			{
				"source": (
					"mainscene.birth_intro_cry"
				),
				"one_shot": true,
				"ready_gate_member": false
			}
		)
	)

	set_meta(
		"birth_intro_cry_stream_report",
		report.duplicate(true)
	)
	set_meta(
		"birth_intro_cry_stream_threaded_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)
	set_meta(
		"birth_intro_cry_stream_pending_or_missing",
		not bool(
			report.get(
				"ready",
				false
			)
		)
	)
	set_meta(
		"birth_intro_cry_stream_sync_load_performed",
		false
	)
	set_meta(
		"birth_intro_cry_stream_last_checked_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	var stream_raw: Variant = report.get(
		"stream",
		null
	)

	if stream_raw is AudioStream:
		birth_intro_cry_stream_cache = (
			stream_raw as AudioStream
		)

		set_meta(
			"birth_intro_cry_stream_path",
			str(
				report.get(
					"stream_path",
					""
				)
			)
		)
		set_meta(
			"birth_intro_cry_stream_threaded_pending",
			false
		)
		set_meta(
			"birth_intro_cry_stream_pending_or_missing",
			false
		)

		return birth_intro_cry_stream_cache

	return null
func _arm_birth_intro_cry_for_first_playable_ui(reason: String = "new_birth_shell", entry_kind: String = "custom") -> void:
	var normalized_entry_kind: String = str(entry_kind).strip_edges().to_lower()
	if normalized_entry_kind == "":
		normalized_entry_kind = "custom"

	if not MainSceneLogic._birth_intro_cry_entry_kind_allowed(normalized_entry_kind):
		return

	set_meta("birth_intro_cry_armed_for_first_playable_ui", true)
	set_meta("birth_intro_cry_waiting_for_playable_ui", false)
	set_meta("birth_intro_cry_played_for_birth_shell", false)
	set_meta("birth_intro_cry_entry_kind", normalized_entry_kind)
	set_meta("birth_intro_cry_arm_reason", reason)
	set_meta("birth_intro_cry_armed_at_ms", int(Time.get_ticks_msec()))

	if gs != null:
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state ["birth_intro_cry_armed_for_first_playable_ui"] = true
		gs.scenario_state ["birth_intro_cry_waiting_for_playable_ui"] = false
		gs.scenario_state ["birth_intro_cry_played_for_birth_shell"] = false
		gs.scenario_state ["birth_intro_cry_entry_kind"] = normalized_entry_kind
		gs.scenario_state ["birth_intro_cry_arm_reason"] = reason
		gs.scenario_state ["birth_intro_cry_armed_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["birth_intro_cry_requires_visible_gameplay_ui"] = true


func _birth_intro_cry_is_armed_for_this_shell() -> bool:
	if gs == null or gs.player == null:
		return false
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false
	if not bool(gs.custom_mode):
		return false

	var armed: bool = bool(get_meta("birth_intro_cry_armed_for_first_playable_ui", false)) \
or bool(gs.scenario_state.get("birth_intro_cry_armed_for_first_playable_ui", false))
	if not armed:
		return false

	var already_played: bool = bool(get_meta("birth_intro_cry_played_for_birth_shell", false)) \
or bool(gs.scenario_state.get("birth_intro_cry_played_for_birth_shell", false))
	if already_played:
		return false

	var entry_kind: String = str(get_meta("birth_intro_cry_entry_kind", gs.scenario_state.get("birth_intro_cry_entry_kind", "custom"))).strip_edges().to_lower()
	if not MainSceneLogic._birth_intro_cry_entry_kind_allowed(entry_kind):
		return false

	return MainSceneLogic._birth_intro_cry_current_player_is_newborn_start(gs)
func _birth_intro_cry_ui_is_visibly_playable() -> bool:
	if gs == null or gs.player == null:
		return false

	if bool(get_meta("god_mode_handoff_cover_release_pending", false)):
		return false

	if bool(get_meta("spawn_ready_ui_first_frame_boundary_active", false)):
		return false

	if bool(get_meta("god_mode_cover_release_waiting_for_atomic_playable_ui", false)):
		return false

	if bool(get_meta("god_mode_capsule_entry_handoff_active", false)) and not bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
		return false

	if not bool(get_meta("spawn_ready_visible_ui_ready_for_audio", false)):
		return false

	var ui_root:= get_node_or_null("UIContainer") as Control
	if ui_root == null or not is_instance_valid(ui_root) or not ui_root.visible:
		return false

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay) or not player_stats_overlay.visible:
		return false

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel) and god_mode_start_panel.visible:
		return false

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim) and god_mode_background_dim.visible:
		return false

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell) and god_mode_panel_glow_shell.visible:
		return false

	if not _spawn_ready_live_ui_shell_has_visible_contract_content():
		return false

	if str(output_label.text).strip_edges() == "":
		return false

	return true
func _mark_birth_intro_cry_consumed(reason: String, played: bool) -> void:
	set_meta("birth_intro_cry_armed_for_first_playable_ui", false)
	set_meta("birth_intro_cry_waiting_for_playable_ui", false)
	set_meta("birth_intro_cry_played_for_birth_shell", played)
	set_meta("birth_intro_cry_consumed_reason", reason)
	set_meta("birth_intro_cry_consumed_at_ms", int(Time.get_ticks_msec()))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["birth_intro_cry_armed_for_first_playable_ui"] = false
		gs.scenario_state ["birth_intro_cry_waiting_for_playable_ui"] = false
		gs.scenario_state ["birth_intro_cry_played_for_birth_shell"] = played
		gs.scenario_state ["birth_intro_cry_consumed_reason"] = reason
		gs.scenario_state ["birth_intro_cry_consumed_at_ms"] = int(Time.get_ticks_msec())


func _schedule_birth_intro_cry_when_playable_ui_visible(reason: String = "spawn_ready") -> void:
	if not _birth_intro_cry_is_armed_for_this_shell():
		return

	var now_ms: int = int(Time.get_ticks_msec())
	set_meta("birth_intro_cry_waiting_for_playable_ui", true)
	set_meta("birth_intro_cry_wait_reason", reason)
	set_meta("birth_intro_cry_wait_started_at_ms", now_ms)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["birth_intro_cry_waiting_for_playable_ui"] = true
		gs.scenario_state ["birth_intro_cry_wait_reason"] = reason
		gs.scenario_state ["birth_intro_cry_wait_started_at_ms"] = now_ms

	call_deferred("_deferred_play_birth_intro_cry_when_playable_ui_visible", reason, 0)


func _deferred_play_birth_intro_cry_when_playable_ui_visible(
	reason: String = "spawn_ready",
	attempt: int = 0
) -> void:
	if not _birth_intro_cry_is_armed_for_this_shell():
		return

	var tree:= get_tree()

	if tree == null:
		return




	await tree.process_frame

	if not _birth_intro_cry_ui_is_visibly_playable():
		if attempt < 120:
			var visibility_retry:= tree.create_timer(
				0.035
			)

			visibility_retry.timeout.connect(
				Callable(
					self,
					"_deferred_play_birth_intro_cry_when_playable_ui_visible"
				).bind(
					reason,
					attempt + 1
				),
				CONNECT_ONE_SHOT
			)
			return

		_mark_birth_intro_cry_consumed(
			"%s_visible_ui_timeout"
			% reason,
			false
		)
		return

	var stream: AudioStream = (
		_birth_intro_cry_stream()
	)

	if stream == null:
		var stream_pending: bool = bool(
			get_meta(
				"birth_intro_cry_stream_threaded_pending",
				false
			)
		)

		if (
			stream_pending
			and attempt < 120
		):
			var stream_retry:= tree.create_timer(
				0.05
			)

			stream_retry.timeout.connect(
				Callable(
					self,
					"_deferred_play_birth_intro_cry_when_playable_ui_visible"
				).bind(
					reason,
					attempt + 1
				),
				CONNECT_ONE_SHOT
			)
			return

		_mark_birth_intro_cry_consumed(
			"%s_stream_resolution_failed"
			% reason,
			false
		)
		return

	var player:= _ensure_birth_intro_cry_player()

	if player == null:
		_mark_birth_intro_cry_consumed(
			"%s_missing_player"
			% reason,
			false
		)
		return

	var contract: Dictionary = (
		MainSceneHelpers._birth_intro_cry_audio_contract()
	)
	var entry_kind: String = str(
		get_meta(
			"birth_intro_cry_entry_kind",
			"custom"
		)
	).strip_edges().to_lower()
	var signature: String = (
		"%s|%s|%s|%s"
		% [
			str(gs.player.id),
			str(gs.year),
			entry_kind,
			str(
				get_meta(
					"birth_intro_cry_armed_at_ms",
					0
				)
			)
		]
	)

	_sync_era_audio_contract_from_current_world(
		"birth_intro_cry_playable_ui_visible"
	)

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.stop()
	player.stream = stream
	player.bus = str(
		contract.get(
			"bus",
			"Master"
		)
	)
	player.volume_db = float(
		contract.get(
			"volume_db",
			-1.25
		)
	)
	player.pitch_scale = float(
		contract.get(
			"pitch_scale",
			1.0
		)
	)
	player.play(0.0)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	set_meta(
		"birth_intro_cry_last_signature",
		signature
	)
	set_meta(
		"birth_intro_cry_last_played_reason",
		reason
	)
	set_meta(
		"birth_intro_cry_last_played_at_ms",
		now_ms
	)
	set_meta(
		"birth_intro_cry_last_stream_path",
		str(
			get_meta(
				"birth_intro_cry_stream_path",
				""
			)
		)
	)
	set_meta(
		"birth_intro_cry_last_attempt",
		attempt
	)

	if (
		gs != null
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"birth_intro_cry_last_signature"
		] = signature
		gs.scenario_state [
			"birth_intro_cry_last_played_reason"
		] = reason
		gs.scenario_state [
			"birth_intro_cry_last_played_at_ms"
		] = now_ms
		gs.scenario_state [
			"birth_intro_cry_last_stream_path"
		] = str(
			get_meta(
				"birth_intro_cry_stream_path",
				""
			)
		)

	_mark_birth_intro_cry_consumed(
		"%s_played"
		% reason,
		true
	)
