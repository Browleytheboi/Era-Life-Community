func _god_mode_any_live_runtime_control_visible_for_release(reason: String = "god_mode_release_probe") -> bool:
	if gs == null or gs.player == null:
		return false

	var any_visible_runtime_button: bool = false

	for raw_button in _god_mode_runtime_authority_buttons():
		var button:= raw_button as Button
		if button == null or not is_instance_valid(button):
			continue

		if not button.visible:
			continue

		any_visible_runtime_button = true
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.z_as_relative = false
		button.z_index = max(int(button.z_index), 306)

	for raw_key in ui_nav_buttons.keys():
		var nav_button: Button = ui_nav_buttons.get(raw_key, null)
		if nav_button == null or not is_instance_valid(nav_button):
			continue

		if not nav_button.visible:
			continue

		any_visible_runtime_button = true
		nav_button.disabled = false
		nav_button.mouse_filter = Control.MOUSE_FILTER_STOP

	if output_label != null and is_instance_valid(output_label) and output_label.visible:
		any_visible_runtime_button = true

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay) and player_stats_overlay.visible:
		any_visible_runtime_button = true

	if any_visible_runtime_button and gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_live_runtime_control_visible_for_release"] = true
		gs.scenario_state ["god_mode_live_runtime_control_visible_reason"] = reason
		gs.scenario_state ["god_mode_live_runtime_control_visible_at_ms"] = int(Time.get_ticks_msec())

	return any_visible_runtime_button


