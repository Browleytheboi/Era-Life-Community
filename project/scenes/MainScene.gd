func _express_crime_hub_panel_action(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		gs.player.id
	)
	var expression: Dictionary = (
		payload.duplicate(false)
	)
	var action_id: String = str(
		expression.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()

	if action_id == "":
		action_id = "refresh"

	expression ["actor_id"] = actor_id
	expression ["action_id"] = action_id
	expression ["section_id"] = str(
		expression.get(
			"section_id",
			crime_hub_active_section_id
		)
	)
	expression ["source"] = str(
		expression.get(
			"source",
			"mainscene.crime_panel"
		)
	)
	expression ["ui_is_renderer_only"] = true
	expression [
		"immutable_contract_references"
	] = true
	expression [
		"build_on_press"
	] = false
	expression [
		"blocks_ui"
	] = false

	crime_hub_action_sequence += 1

	crime_hub_action_queue.append({
		"sequence": crime_hub_action_sequence,
		"actor_id": actor_id,
		"expression": expression,
		"queued_at_ms": int(
			Time.get_ticks_msec()
		)
	})

	set_meta(
		"crime_panel_press_engine_call_performed",
		false
	)
	set_meta(
		"crime_panel_press_contract_build_performed",
		false
	)
	set_meta(
		"crime_panel_press_intent_queued",
		true
	)
	set_meta(
		"crime_panel_press_queue_size",
		crime_hub_action_queue.size()
	)

	_arm_crime_hub_action_service()
func _service_crime_hub_action_queue() -> void:
	crime_hub_action_service_active = false

	if crime_hub_action_queue.is_empty():
		return

	var request: Dictionary = MainSceneHelpers._safe_dictionary(
		crime_hub_action_queue.pop_front()
	)
	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)

	if (
		gs != null
		and gs.player != null
		and int(
			gs.player.id
		) == actor_id
	):
		_commit_crime_hub_action_background(
			request
		)



	_arm_crime_hub_action_service()

func _commit_crime_hub_action_background(
	request: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var expression: Dictionary = MainSceneHelpers._safe_dictionary(
		request.get(
			"expression",
			{}
		)
	)

	if expression.is_empty():
		return

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)
	var action_id: String = str(
		expression.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()

	var routed_at_ms: int = int(
		Time.get_ticks_msec()
	)

	var report: Dictionary = _express_global_ui_intent({
		"actor_id": actor_id,
		"intent_type": "crime_hub_panel_action",
		"surface_id": "crime_panel",
		"action_id": action_id,
		"payload": expression,
		"target": {
			"route_kind": "engine_method",
			"engine_property": (
				"crime_hub_contract_engine"
			),
			"method": "resolve_intent",
			"pass_actor_payload": true,
			"actor_id": actor_id
		},
		"source": str(
			expression.get(
				"source",
				"mainscene.crime_panel"
			)
		),
		"immutable_contract_references": true,
		"ephemeral_infrastructure_intent": true,
		"skip_global_intent_persistence": true,
		"skip_crr_observation": true
	}, {
		"actor_id": actor_id,
		"surface_id": "crime_panel",
		"action_id": action_id,
		"source": str(
			expression.get(
				"source",
				"mainscene.crime_panel"
			)
		),
		"immutable_contract_references": true,
		"skip_crr_observation": true
	})

	var result: Dictionary = _hub_panel_route_result(
		report
	)

	cached_last_result = result.duplicate(false)

	_render_crime_hub_route_result(
		result
	)

	var action_result: Dictionary = MainSceneHelpers._safe_dictionary(
		result.get(
			"result",
			result.get(
				"action_report",
				{}
			)
		)
	)

	var action_mode: String = str(
		action_result.get(
			"mode",
			""
		)
	)

	if (
		not action_result.is_empty()
		and (
			action_result.has(
				"popup_text"
			)
			or action_result.has(
				"text"
			)
		)
		and action_mode not in [
			"crime_weapon_target_selection",
			"crime_weapon_body_selection"
		]
	):
		_maybe_show_action_result_popup(
			action_result
		)

	if action_mode == "weapon_crime_action_committed":
		belongings_hud_content_dirty = true

		set_meta(
			"crime_commit_pending_surface_refresh_requested",
			true
		)
		set_meta(
			"crime_commit_stats_delta_observation_requested",
			true
		)

	EraLog.truth(
		(
			"ERALIFE_CRIME_INTENT_TRUTH"
			+ "|action=%s"
			+ "|actor_id=%d"
			+ "|success=%s"
			+ "|press_engine_call=false"
			+ "|background_service=true"
			+ "|immutable_refs=true"
			+ "|elapsed_ms=%d"
		)
		% [
			action_id,
			actor_id,
			str(
				bool(
					result.get(
						"success",
						false
					)
				)
			),
			maxi(
				0,
				int(
					Time.get_ticks_msec()
				) - routed_at_ms
			)
		]
	)
func _pending_situations_payload_revision(
	payload: Dictionary
) -> String:
	if payload.is_empty():
		return ""

	var authored_revision: String = str(
		payload.get(
			"payload_revision",
			""
		)
	).strip_edges()

	if authored_revision != "":
		return authored_revision




	var actor_id: int = int(
		payload.get(
			"actor_id",
			-1
		)
	)
	var count: int = maxi(
		0,
		int(
			payload.get(
				"count",
				0
			)
		)
	)
	var built_at_ms: int = int(
		payload.get(
			"built_at_ms",
			0
		)
	)

	return (
		"legacy:%d:%d:%d"
		% [
			actor_id,
			count,
			built_at_ms
		]
	)

func _prepaint_pending_situations_popup_payload(
	payload: Dictionary,
	actor_id: int
) -> bool:
	if (
		payload.is_empty()
		or actor_id <= 0
		or not bool(
			payload.get(
				"success",
				false
			)
		)
		or int(
			payload.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	_ensure_popup_viewer()

	if (
		popup_viewer == null
		or not is_instance_valid(
			popup_viewer
		)
	):
		return false

	var payload_revision: String = (
		_pending_situations_payload_revision(
			payload
		)
	)
	var painted_actor_id: int = int(
		popup_viewer.get_meta(
			"prepainted_actor_id",
			-1
		)
	)
	var painted_revision: String = str(
		popup_viewer.get_meta(
			"prepainted_payload_revision",
			""
		)
	)
	var currently_revealed_for_actor: bool = (
		popup_viewer_open
		and popup_viewer.visible
		and painted_actor_id == actor_id
	)
	var previous_category_key: String = (
		popup_viewer.current_category_key
		if currently_revealed_for_actor
		else ""
	)
	var previous_contract_id: String = (
		popup_viewer.current_contract_id
		if currently_revealed_for_actor
		else ""
	)

	if (
		painted_actor_id == actor_id
		and painted_revision == payload_revision
	):
		return true




	var viewer_payload: Dictionary = (
		payload.duplicate(false)
	)

	viewer_payload [
		"renderer_payload_revision"
	] = payload_revision
	viewer_payload [
		"renderer_prepaint_actor_id"
	] = actor_id
	viewer_payload [
		"renderer_prepaint_navigation_preserved"
	] = currently_revealed_for_actor
	viewer_payload [
		"renderer_recursive_contract_copy_performed"
	] = false



	popup_viewer.present_list(
		viewer_payload,
		false
	)

	popup_viewer.set_meta(
		"prepainted_actor_id",
		actor_id
	)
	popup_viewer.set_meta(
		"prepainted_payload_revision",
		payload_revision
	)
	popup_viewer.set_meta(
		"prepainted_before_pending_button_click",
		not currently_revealed_for_actor
	)
	popup_viewer.set_meta(
		"pending_click_build_forbidden",
		true
	)
	popup_viewer.set_meta(
		"pending_viewer_navigation_preserved_during_prepaint",
		currently_revealed_for_actor
	)

	if currently_revealed_for_actor:
		popup_viewer.restore_pending_navigation(
			previous_category_key,
			previous_contract_id
		)

		popup_viewer_open = true
		popup_viewer.visible = true
		popup_viewer.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)
		popup_viewer.show()
	else:
		popup_viewer.visible = false
		popup_viewer.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		popup_viewer.hide()

	EraLog.truth(
		"ERALIFE_PENDING_SITUATIONS_PREPAINT_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|payload_revision=" + payload_revision
		+ "|navigation_preserved="
		+ str(currently_revealed_for_actor).to_lower()
		+ "|category_key=" + previous_category_key
		+ "|contract_id=" + previous_contract_id
		+ "|duplicate_contracts_rejected=true"
		+ "|authority_authored_revision=true"
		+ "|recursive_payload_copy=false"
		+ "|engine_calls=false"
		+ "|build_on_click=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	return true
func _pending_situations_lens_max_urgency(
	actor_id: int
) -> float:
	if (
		gs == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return 0.0

	var summary: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"pending_situations_last_summary_contract",
			{}
		)
	)

	if int(
		summary.get(
			"target_id",
			-1
		)
	) != actor_id:
		return 0.0

	return clampf(
		float(
			summary.get(
				"max_urgency",
				0.0
			)
		),
		0.0,
		100.0
	)


func _animate_pending_situations_button(
	delta: float
) -> void:
	if (
		pending_situations_button == null
		or not is_instance_valid(
			pending_situations_button
		)
	):
		return

	pending_situations_urgent_breathe_time += delta

	var count: int = int(
		pending_situations_button.get_meta(
			"pending_situations_lens_count",
			get_meta(
				"pending_situations_button_count",
				0
			)
		)
	)
	var urgency: float = float(
		pending_situations_button.get_meta(
			"pending_situations_lens_max_urgency",
			0.0
		)
	)

	if count <= 0:
		pending_situations_button.modulate = Color.WHITE
		pending_situations_button.scale = Vector2.ONE
		pending_situations_button.remove_theme_color_override(
			"font_color"
		)
		pending_situations_button.set_meta(
			"pending_situations_pulse_active",
			false
		)
		return

	if urgency < 80.0:
		pending_situations_button.modulate = Color.WHITE
		pending_situations_button.scale = Vector2.ONE
		pending_situations_button.remove_theme_color_override(
			"font_color"
		)
		pending_situations_button.set_meta(
			"pending_situations_pulse_active",
			false
		)
		return

	var pulse: float = (
		sin(
			pending_situations_urgent_breathe_time
			* TAU
			* 0.9
		) + 1.0
	) * 0.5
	var urgency_ratio: float = clampf(
		(
			urgency - 80.0
		) / 20.0,
		0.0,
		1.0
	)
	var red_strength: float = lerpf(
		0.76,
		1.0,
		pulse
	)

	pending_situations_button.add_theme_color_override(
		"font_color",
		Color(
			1.0,
			0.12 + pulse * 0.1,
			0.1,
			1.0
		)
	)
	pending_situations_button.modulate = Color(
		red_strength,
		0.48 + pulse * 0.18,
		0.48 + pulse * 0.18,
		1.0
	)
	pending_situations_button.scale = (
		Vector2.ONE
		* (
			1.0
			+ pulse
			* 0.018
			* urgency_ratio
		)
	)
	pending_situations_button.set_meta(
		"pending_situations_pulse_active",
		true
	)
	pending_situations_button.set_meta(
		"pending_situations_pulse_count",
		count
	)
func _refresh_player_stat_surface_title_text(label: Label, bar: ProgressBar, value: int, max_value: int, title: String = "") -> void:
	if label == null or bar == null:
		return

	var effective_title: String = str(title).strip_edges()
	if effective_title == "":
		effective_title = str(bar.get_meta("stat_surface_title", "")).strip_edges()
	if effective_title == "":
		return

	var safe_max: int = max(1, int(max_value))
	var stored_surface_context_raw: Variant = bar.get_meta("stat_surface_context", {})
	var surface_context: Dictionary = stored_surface_context_raw if typeof(stored_surface_context_raw) == TYPE_DICTIONARY else {}
	if surface_context.is_empty() and gs != null and gs.player != null:
		surface_context = _build_player_stat_surface_context(gs.player)

	var subject_dead: bool = bool(surface_context.get("subject_dead", false)) and effective_title != "Bond"
	var safe_value: int = 0 if subject_dead else clamp(int(value), 0, safe_max)

	var resolved: Dictionary = {}
	var surface_family: String = str(surface_context.get("surface_family", "")).strip_edges()

	if subject_dead and effective_title == "Health":
		resolved = MainSceneLogic._resolve_player_stat_surface(effective_title, 0, safe_max, surface_context)
	elif subject_dead:
		resolved = {
			"descriptor": "Dead",
			"flavor": "This life has ended.",
			"bar_text": "Dead",
			"title_text": "%s: Dead" % effective_title
		}
	elif surface_family == "realm_overview":
		resolved = MainSceneHelpers._resolve_realm_stat_surface(effective_title, safe_value, safe_max, surface_context)
	elif surface_family == "institution_hub":
		resolved = MainSceneHelpers._resolve_institution_hub_stat_surface(effective_title, safe_value, safe_max, surface_context)
	else:
		resolved = MainSceneLogic._resolve_player_stat_surface(effective_title, safe_value, safe_max, surface_context)

	var descriptor: String = str(resolved.get("descriptor", "")).strip_edges()
	var flavor: String = str(resolved.get("flavor", "")).strip_edges()
	var title_text: String = str(resolved.get("title_text", "")).strip_edges()
	if title_text == "":
		title_text = MainSceneHelpers._resolve_player_stat_surface_title(effective_title, descriptor, surface_context)

	label.text = title_text
	_apply_player_stat_surface_flavor_label(label, bar, flavor, surface_context)
func _get_player_stats_approval_widgets() -> Dictionary:
	var row_owner: Control = player_stats_rows_root if player_stats_rows_root != null else player_stats_root
	if row_owner == null:
		return {}
	var approval_row:= row_owner.get_node_or_null("ApprovalRow") as Control
	if approval_row == null and player_stats_root != null:
		approval_row = player_stats_root.find_child("ApprovalRow", true, false) as Control
	if approval_row == null:
		return {}
	return {
		"row": approval_row,
		"label": approval_row.find_child("ApprovalLabel", true, false) as Label,
		"bar": approval_row.find_child("ApprovalBar", true, false) as ProgressBar
	}
func _build_realm_stat_surface_context(title: String, value: int, max_value: int, entry: Dictionary, realm: Dictionary) -> Dictionary:
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var entry_kind: String = str(entry.get("entry_kind", "realm")).strip_edges()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges()
	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var is_imaginative_realm: bool = entry_id == "terabithia" or entry_kind == "imaginative_realm" or realm_type == "imagination_bound"
	var is_elemental_realm: bool = native_element in ["air", "water", "earth", "fire"]
	var is_era_kingdom: bool = entry_id == "era_kingdom"
	var access_state: String = str(realm.get("access_state", realm.get("veil_state", "veiled"))).strip_edges().to_lower()
	var rebel_pressure: int = clamp(int(realm.get("rebel_pressure", 0)), 0, 100)
	var clean_value: int = clamp(int(value), 0, max(1, max_value))
	var stat_family: String = "generic"

	match title:
		"Wonder":
			stat_family = "wonder"
		"Resonance":
			stat_family = "resonance"
		"Protection":
			stat_family = "protection"
		"Veil Strength":
			stat_family = "veil_strength"
		"Alignment", "Prosperity":
			stat_family = "prosperity"
		"Current", "Stability":
			stat_family = "stability"
		"Will", "Loyalty":
			stat_family = "loyalty"
		"Pressure":
			stat_family = "pressure"
		_:
			stat_family = "generic"

	return {
		"surface_family": "realm_overview",
		"realm_stat_family": stat_family,
		"entry_id": entry_id,
		"entry_kind": entry_kind,
		"is_imaginative_realm": is_imaginative_realm,
		"is_elemental_realm": is_elemental_realm,
		"is_era_kingdom": is_era_kingdom,
		"native_element": native_element,
		"access_state": access_state,
		"rebel_pressure": rebel_pressure,
		"descriptor_title_mode": "default",
		"narrative_perspective": "third_person",
		"realm_name": str(realm.get("name", entry.get("name", "Realm"))).strip_edges(),
		"government_style": str(realm.get("government_style", "State")).strip_edges(),
		"current_value": clean_value
	}
func _player_stats_overlay_must_truth_fill_on_visible_life_shell() -> bool:
	if gs == null or gs.player == null:
		return false

	var current_actor_id: int = int(gs.player.id)

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		var overlay_actor_id: int = int(player_stats_overlay.get_meta("player_stats_current_actor_id", player_stats_overlay.get_meta("player_stats_bank_actor_id", -1)))
		if overlay_actor_id > 0 and overlay_actor_id != current_actor_id:
			return true
		if player_stats_overlay.visible and current_panel == "life":
			return true
		if int(player_stats_overlay.get_meta("player_stats_force_truth_actor_id", -1)) == current_actor_id:
			return true

	if _playable_life_surface_player_control_released():
		return true
	if _playable_life_shell_has_visible_sovereignty():
		return true
	if current_panel == "life" and _global_runtime_kill_current_runtime_domain() == "simulation":
		return true
	if bool(get_meta("ready_button_is_door_reveal_only", false)):
		return true
	if bool(get_meta("ready_button_press_is_door_reveal", false)):
		return true

	return false
func _player_stats_spawn_shell_should_truth_paint(boot_spawn_animation_pending: bool, startup_prewarm_pending: bool, live_reality_stream_bound: bool) -> bool:
	if not boot_spawn_animation_pending:
		return false

	if live_reality_stream_bound:
		return true

	if _playable_life_surface_player_control_released():
		return true

	if _playable_life_shell_has_visible_sovereignty():
		return true

	if current_panel == "life" and gs != null and gs.player != null and _global_runtime_kill_current_runtime_domain() == "simulation":
		return true

	if bool(get_meta("startup_live_shell_loading", false)):
		return false

	if startup_prewarm_pending:
		return false

	if age_up_loading_runtime_active:
		return false

	if bool(get_meta("age_up_transition_busy", false)):
		return false

	if bool(get_meta("age_up_post_loading_finalize_pending", false)):
		return false

	if not bool(get_meta("player_stats_spawn_fill_consumed", false)):
		return false

	return true
func _prime_player_stats_overlay_truth_lens_for_ready_reveal(reason: String = "ready_reveal_truth_paint") -> void:
	if gs == null or gs.player == null:
		return

	_ensure_player_stats_overlay()

	if player_stats_overlay == null or not is_instance_valid(player_stats_overlay):
		return

	var p:= gs.player
	var surface_context: Dictionary = _build_player_stat_surface_context(p)
	var subject_dead: bool = bool(surface_context.get("subject_dead", false))

