func _post_spawn_ui_is_busy_for_prewarm() -> bool:
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var legal_age_up_runtime: bool = (
		_visible_age_up_runtime_is_player_initiated()
	)
	var visible_shell_sovereign: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)
	var native_tab_projection_tail_active: bool = bool(
		get_meta(
			"ready_room_native_tab_surface_prewarm_active",
			false
		)
	)
	var main_tab_surface_holds_frame: bool = (
		activities_action_open
		or world_feed_popup_open
		or current_panel in [
			"world",
			"relationships",
			"school",
			"career",
			"activities",
			"mods"
		]
	)
	var main_tab_surface_blocks_background: bool = (
		main_tab_surface_holds_frame
		and not native_tab_projection_tail_active
	)

	set_meta(
		"native_tab_projection_tail_active_during_busy_check",
		native_tab_projection_tail_active
	)
	set_meta(
		"main_tab_surface_holds_frame_during_busy_check",
		main_tab_surface_holds_frame
	)
	set_meta(
		"main_tab_surface_blocks_native_projection_tail",
		false
	)

	if (
		visible_shell_sovereign
		and not legal_age_up_runtime
	):
		_convert_visible_shell_tail_work_to_background_only(
			"post_spawn_ui_busy_blocked_by_visible_shell"
		)

		var stale_transition: bool = (
			panel_content_transition_active
			and (
				panel_content_transition_surface == null
				or not is_instance_valid(
					panel_content_transition_surface
				)
			)
		)

		if stale_transition:
			_cancel_panel_content_transition()

		return (
			main_tab_surface_blocks_background
			or relationship_profile_popup_open
			or relationships_browser_open
			or (
				standard_tab_popup_open
				and now_ms >= int(
					get_meta(
						"standard_tab_close_navigation_grace_until_ms",
						0
					)
				)
			)
			or (
				profile_panel_popup != null
				and is_instance_valid(
					profile_panel_popup
				)
				and profile_panel_popup.visible
			)
		)

	var post_spawn_finalize_pending: bool = false

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		post_spawn_finalize_pending = bool(
			gs.scenario_state.get(
				"post_spawn_ui_finalize_pending",
				false
			)
		)

	var startup_shell_loading: bool = bool(
		get_meta(
			"startup_live_shell_loading",
			false
		)
	)
	var post_loading_finalize_pending: bool = bool(
		get_meta(
			"age_up_post_loading_finalize_pending",
			false
		)
	)
	var playable_shell_has_control: bool = (
		_playable_life_shell_pointer_motion_is_visual_only()
	)
	var actual_age_up_active: bool = (
		bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
		or age_up_loading_finish_requested
		or not age_up_loading_result.is_empty()
	)

	if (
		playable_shell_has_control
		and not actual_age_up_active
	):
		startup_shell_loading = false
		post_spawn_finalize_pending = false
		post_loading_finalize_pending = false

		set_meta(
			"startup_live_shell_loading",
			false
		)
		set_meta(
			"age_up_post_loading_finalize_pending",
			false
		)

	var post_loading_blocks_prewarm: bool = (
		post_loading_finalize_pending
		and not startup_shell_loading
		and not post_spawn_finalize_pending
	)
	var visible_loading_overlay_active: bool = (
		age_up_loading_runtime_active
	)

	if (
		age_up_loading_overlay != null
		and is_instance_valid(
			age_up_loading_overlay
		)
	):
		visible_loading_overlay_active = (
			age_up_loading_runtime_active
			and age_up_loading_overlay.visible
		)

	if (
		playable_shell_has_control
		and not actual_age_up_active
	):
		visible_loading_overlay_active = false

		if (
			age_up_loading_overlay != null
			and is_instance_valid(
				age_up_loading_overlay
			)
		):
			age_up_loading_overlay.visible = false
			age_up_loading_overlay.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

	var stale_panel_transition: bool = (
		panel_content_transition_active
		and (
			panel_content_transition_surface == null
			or not is_instance_valid(
				panel_content_transition_surface
			)
		)
	)

	if stale_panel_transition:
		_cancel_panel_content_transition()

	var standard_tab_close_grace_active: bool = (
		now_ms < int(
			get_meta(
				"standard_tab_close_navigation_grace_until_ms",
				0
			)
		)
	)

	return (
		_zero_frame_ui_render_enforcement_active(
			now_ms
		)
		or visible_loading_overlay_active
		or (
			bool(
				get_meta(
					"age_up_transition_busy",
					false
				)
			)
			and not playable_shell_has_control
		)
		or post_loading_blocks_prewarm
		or panel_content_transition_active
		or main_tab_surface_blocks_background
		or (
			standard_tab_popup_open
			and not standard_tab_close_grace_active
		)
		or relationship_profile_popup_open
		or relationships_browser_open
		or (
			profile_panel_popup != null
			and is_instance_valid(
				profile_panel_popup
			)
			and profile_panel_popup.visible
		)
	)
func _on_belonging_food_action_pressed(action_id: String, item: Dictionary, category: String) -> void:
	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "belonging_food_action",
			"surface_id": "belongings_hud",
			"action_id": action_id,
			"payload": {
				"item": item.duplicate(true),
				"category": category
			},
			"legacy_callback": "_on_belonging_food_action_pressed",
			"legacy_args": [
				action_id,
				item.duplicate(true),
				category
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_on_belonging_food_action_pressed"
			},
			"source": "mainscene.belonging_food_action"
		}, {
			"source": "mainscene.belonging_food_action",
			"surface_id": "belongings_hud",
			"action_id": action_id,
			"legacy_callback": "_on_belonging_food_action_pressed",
			"legacy_args": [
				action_id,
				item.duplicate(true),
				category
			]
		})
		return

	var clean_action: String = str(action_id).strip_edges().to_lower()

	match clean_action:
		"consume":
			_perform_belonging_food_consume(item, category)
		"give_to":
			_show_artifact_target_picker(item.duplicate(true), "Food::give_to")
		"share_consume":
			_show_artifact_target_picker(item.duplicate(true), "Food::share_consume")
		"throw_away":
			_perform_belonging_food_throw_away(item, category)
		_:
			_finalize_belonging_food_action_report({
				"success": false,
				"popup_title": "Food",
				"text": "That food action is not wired yet."
			})

func _perform_belonging_food_consume(item: Dictionary, category: String) -> void:
	if gs == null or gs.player == null or gs.food_engine == null or gs.belongings_engine == null:
		return

	var item_id: int = MainSceneHelpers._belonging_food_item_id(item)
	var removed: Dictionary = gs.belongings_engine.remove_item_by_id(gs.player, category, item_id)
	if removed.is_empty():
		_finalize_belonging_food_action_report({
			"success": false,
			"popup_title": "Food",
			"text": "That food item could not be found."
		})
		return

	var report: Dictionary = gs.food_engine.consume_food(gs.player, removed, {
		"source": "belongings_food_consume",
		"category": category
	})

	if not bool(report.get("success", false)):
		gs.belongings_engine.add_item(gs.player, removed, category)
		_finalize_belonging_food_action_report({
			"success": false,
			"popup_title": "Food",
			"text": str(report.get("reason", "I could not eat that."))
		})
		return

	_finalize_belonging_food_action_report({
		"success": true,
		"popup_title": "Food",
		"text": str(report.get("text", "I ate %s." % str(removed.get("name", "the food"))))
	})


func _perform_belonging_food_throw_away(item: Dictionary, category: String) -> void:
	if gs == null or gs.player == null or gs.belongings_engine == null:
		return

	var item_id: int = MainSceneHelpers._belonging_food_item_id(item)
	var removed: Dictionary = gs.belongings_engine.remove_item_by_id(gs.player, category, item_id)
	if removed.is_empty():
		_finalize_belonging_food_action_report({
			"success": false,
			"popup_title": "Food",
			"text": "That food item could not be found."
		})
		return

	_finalize_belonging_food_action_report({
		"success": true,
		"popup_title": "Food",
		"text": "I threw away %s." % str(removed.get("name", "the food"))
	})


func _perform_belonging_food_target_action(target: Person) -> void:
	if gs == null or gs.player == null or target == null or gs.belongings_engine == null:
		return

	var action_name: String = str(belongings_item_target_popup_action_name).strip_edges()
	var item: Dictionary = belongings_item_target_popup_item.duplicate(true)
	var category: String = belongings_item_popup_current_category
	var item_id: int = MainSceneHelpers._belonging_food_item_id(item)

	var removed: Dictionary = gs.belongings_engine.remove_item_by_id(gs.player, category, item_id)
	if removed.is_empty():
		_finalize_belonging_food_action_report({
			"success": false,
			"popup_title": "Food",
			"text": "That food item could not be found."
		})
		return

	match action_name:
		"Food::give_to":
			gs.belongings_engine.add_item(target, removed, category)
			_finalize_belonging_food_action_report({
				"success": true,
				"popup_title": "Food",
				"text": "I gave %s to %s." % [
					str(removed.get("name", "the food")),
					("%s %s" % [str(target.first_name), str(target.last_name)]).strip_edges()
				]
			})
		"Food::share_consume":
			if gs.food_engine == null:
				gs.belongings_engine.add_item(gs.player, removed, category)
				_finalize_belonging_food_action_report({
					"success": false,
					"popup_title": "Food",
					"text": "FoodEngine is unavailable."
				})
				return

			var shared_player_food: Dictionary = removed.duplicate(true)
			var shared_target_food: Dictionary = removed.duplicate(true)
			shared_player_food ["hunger_restore"] = float(shared_player_food.get("hunger_restore", 28.0)) * 0.5
			shared_target_food ["hunger_restore"] = float(shared_target_food.get("hunger_restore", 28.0)) * 0.5
			shared_player_food ["nutrition"] = float(shared_player_food.get("nutrition", 45.0)) * 0.5
			shared_target_food ["nutrition"] = float(shared_target_food.get("nutrition", 45.0)) * 0.5

			var player_report: Dictionary = gs.food_engine.consume_food(gs.player, shared_player_food, {
				"source": "belongings_food_share_consume_player",
				"shared_with_id": int(target.id)
			})
			var target_report: Dictionary = gs.food_engine.consume_food(target, shared_target_food, {
				"source": "belongings_food_share_consume_target",
				"shared_by_id": int(gs.player.id)
			})

			if not bool(player_report.get("success", false)) or not bool(target_report.get("success", false)):
				gs.belongings_engine.add_item(gs.player, removed, category)
				_finalize_belonging_food_action_report({
					"success": false,
					"popup_title": "Food",
					"text": "The food could not be shared right now."
				})
				return

			_finalize_belonging_food_action_report({
				"success": true,
				"popup_title": "Food",
				"text": "I shared %s with %s and we both ate some." % [
					str(removed.get("name", "the food")),
					("%s %s" % [str(target.first_name), str(target.last_name)]).strip_edges()
				]
			})
		_:
			gs.belongings_engine.add_item(gs.player, removed, category)
			_finalize_belonging_food_action_report({
				"success": false,
				"popup_title": "Food",
				"text": "That food target action is not wired yet."
			})
func _on_artifact_self_action_pressed(
	item: Dictionary,
	action_spec: Dictionary
) -> void:
	if gs == null or gs.player == null:
		return

	var resolver_method: String = str(
		action_spec.get(
			"resolver_method",
			""
		)
	).strip_edges()
	var action_label: String = str(
		action_spec.get(
			"label",
			""
		)
	).strip_edges()

	if (
		resolver_method == ""
		or action_label == ""
	):
		return

	var result: Dictionary = (
		_express_artifact_interaction_intent(
			"perform_self_action",
			{
				"item": item.duplicate(true),
				"action_label": action_label,
				"resolver_method": resolver_method,
				"source": (
					"mainscene.artifact_self_action"
				)
			}
		)
	)

	cached_last_result = result

	_hide_standard_tab_popup()

	var result_text: String = str(
		result.get(
			"text",
			result.get(
				"popup_text",
				"Done."
			)
		)
	)

	if result_text.strip_edges() != "":
		_append_text_to_diary(
			result_text,
			false
		)

	_refresh_identity_bound_surfaces()
