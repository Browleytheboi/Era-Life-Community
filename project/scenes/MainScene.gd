func _era_audio_context_from_current_world() -> Dictionary:
	var era_key: String = ""
	var era_name: String = ""
	var year_value: int = 0
	var player_id_value: int = 0

	if gs != null:
		year_value = int(gs.year)

		if gs.player != null:
			player_id_value = int(gs.player.id)

		if gs.era != null:
			era_key = _current_era_ui_theme_key()

			var era_raw: Variant = gs.era
			if typeof(era_raw) == TYPE_DICTIONARY:
				var era_dict: Dictionary = era_raw
				era_name = str(era_dict.get("name", ""))
			else:
				era_name = str(gs.era.name)

	if era_key == "" and era_name != "":
		era_key = era_name.to_lower().strip_edges()

	return {
		"era_key": era_key,
		"era_name": era_name,
		"year": year_value,
		"player_id": player_id_value,
		"current_panel": current_panel,
		"source": "main_scene"
	}


func _sync_era_audio_contract_from_current_world(
	reason: String = "runtime"
) -> void:
	if not _era_audio_runtime_should_drive_world_music():
		return

	var engine = _ensure_era_audio_engine()

	if engine == null:
		return

	var context: Dictionary = (
		_era_audio_context_from_current_world()
	)

	context ["reason"] = reason

	var report: Dictionary = (
		engine.apply_audio_contract(
			era_audio_contract,
			context
		)
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var stream_pending: bool = bool(
		report.get(
			"pending",
			false
		)
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"era_audio_contract_last_report"
		] = report.duplicate(true)
		gs.scenario_state [
			"era_audio_contract_last_reason"
		] = reason
		gs.scenario_state [
			"era_audio_contract_last_sync_at_ms"
		] = now_ms
		gs.scenario_state [
			"era_audio_stream_threaded_pending"
		] = stream_pending
		gs.scenario_state [
			"era_audio_synchronous_load_performed"
		] = false

	if stream_pending:


		era_audio_last_signature = ""
		era_audio_next_sync_ms = now_ms + 120
		set_meta(
			"era_audio_retry_after_ms",
			now_ms + 120
		)
		return

	if bool(
		report.get(
			"success",
			false
		)
	):
		set_meta(
			"era_audio_retry_after_ms",
			0
		)
	else:
		set_meta(
			"era_audio_retry_after_ms",
			now_ms + 2000
		)
func _drive_era_audio_contract_runtime(_delta: float) -> void:


	_drive_luxury_exchange_shiny_audio_prewarm()

	if not _era_audio_runtime_should_drive_world_music():
		return

	var now_ms: int = int(Time.get_ticks_msec())

	if now_ms < era_audio_next_sync_ms:
		return

	era_audio_next_sync_ms = now_ms + 350

	var context: Dictionary = _era_audio_context_from_current_world()
	context ["context_key"] = "gameplay"
	context ["surface_id"] = "live_gameplay_shell"
	context ["panel_id"] = current_panel

	var signature: String = _era_audio_signature_for_context(context)

	var retry_after_ms: int = int(
		get_meta(
			"era_audio_retry_after_ms",
			0
		)
	)
	var last_success: bool = true

	if (
		era_audio_engine != null
		and is_instance_valid(
			era_audio_engine
		)
	):
		last_success = bool(
			era_audio_engine.last_report.get(
				"success",
				true
			)
		)

	if (
		signature == era_audio_last_signature
		and last_success
	):
		return

	if (
		signature == era_audio_last_signature
		and retry_after_ms > 0
		and now_ms < retry_after_ms
	):
		return

	era_audio_last_signature = signature
	_sync_era_audio_contract_from_current_world(
		"runtime_signature_change"
	)
func _play_luxury_exchange_shiny_audio_from_authority(
	authority_receipt: Dictionary
) -> void:
	if (
		authority_receipt.is_empty()
		or not bool(
			authority_receipt.get(
				"audio_authorized",
				false
			)
		)
	):
		return

	var audio_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		authority_receipt.get(
			"audio_presentation_contract",
			{}
		)
	)

	if (
		audio_contract.is_empty()
		or str(
			audio_contract.get(
				"cue_id",
				""
			)
		) != "luxury_centerpiece_shiny"
	):
		return

	var market_year: int = int(
		audio_contract.get(
			"market_year",
			-999999
		)
	)
	var playback_key: String = str(
		audio_contract.get(
			"playback_key",
			""
		)
	).strip_edges()
	var stop_on_unhover: bool = bool(
		audio_contract.get(
			"stop_on_unhover",
			true
		)
	)
	var first_ever: bool = bool(
		audio_contract.get(
			"first_ever",
			false
		)
	)

	set_meta(
		"luxury_exchange_shiny_current_market_year",
		market_year
	)
	set_meta(
		"luxury_exchange_shiny_current_playback_key",
		playback_key
	)
	set_meta(
		"luxury_exchange_shiny_stop_on_unhover",
		stop_on_unhover
	)
	set_meta(
		"luxury_exchange_shiny_first_ever_playback",
		first_ever
	)

	var player:= get_node_or_null(
		"LuxuryExchangeShinyAudio"
	) as AudioStreamPlayer
	# FIX: this logged "The object does not have any 'meta' values with the key
	# 'luxury_exchange_shiny_audio_stream_cache'" on every frame -- hundreds of error
	# lines drowning the console. Passing a default to get_meta() does not suppress the
	# error when the object has no metadata at all, so check has_meta() first.
	var cached_raw: Variant = (
		get_meta(
			"luxury_exchange_shiny_audio_stream_cache",
			null
		)
		if has_meta("luxury_exchange_shiny_audio_stream_cache")
		else null
	)

	if (
		player == null
		or not (cached_raw is AudioStream)
		or player.stream != (cached_raw as AudioStream)
		or not bool(
			get_meta(
				"luxury_exchange_shiny_audio_player_bound",
				false
			)
		)
	):
		set_meta(
			"luxury_exchange_shiny_pending_authority_receipt",
			authority_receipt.duplicate(false)
		)
		set_meta(
			"luxury_exchange_shiny_play_waits_for_residency_not_ui",
			true
		)
		return

	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.stream_paused = false
	player.bus = "Master"
	player.volume_db = -5.0

	if player.playing:
		player.stop()

	player.play()

	if not player.playing:
		set_meta(
			"luxury_exchange_shiny_pending_authority_receipt",
			authority_receipt.duplicate(false)
		)
		set_meta(
			"luxury_exchange_shiny_stream_schedule_failed",
			true
		)
		return

	if has_meta(
		"luxury_exchange_shiny_pending_authority_receipt"
	):
		remove_meta(
			"luxury_exchange_shiny_pending_authority_receipt"
		)

	if has_meta(
		"luxury_exchange_shiny_active_stream_id"
	):
		remove_meta(
			"luxury_exchange_shiny_active_stream_id"
		)

	set_meta(
		"luxury_exchange_shiny_audio_playing",
		true
	)
	set_meta(
		"luxury_exchange_shiny_audio_started_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"luxury_exchange_shiny_audio_first_ever",
		first_ever
	)
	set_meta(
		"luxury_exchange_shiny_authority_consumed_year",
		market_year
	)
	set_meta(
		"luxury_exchange_shiny_play_path_player_creation",
		false
	)
	set_meta(
		"luxury_exchange_shiny_play_path_stream_assignment",
		false
	)
	set_meta(
		"luxury_exchange_shiny_play_path_resource_load",
		false
	)
	set_meta(
		"luxury_exchange_shiny_play_path_host_restart",
		false
	)
	set_meta(
		"luxury_exchange_shiny_play_path_waits_for_audio_completion",
		false
	)
	set_meta(
		"luxury_exchange_shiny_audio_blocks_ui",
		false
	)
	set_meta(
		"luxury_exchange_shiny_uses_deferred_delivery",
		false
	)
	set_meta(
		"luxury_exchange_shiny_uses_idle_delivery",
		false
	)
	set_meta(
		"luxury_exchange_shiny_playback_owner",
		"resident_dedicated_audio_stream_player"
	)

	var delivery_actor_id: int = int(
		authority_receipt.get(
			"actor_id",
			-1
		)
	)

	if (
		delivery_actor_id > 0
		and playback_key != ""
	):
		luxury_exchange_intent_queue.append({
			"request_kind": "authority_intent",
			"actor_id": delivery_actor_id,
			"intent_type": (
				"luxury_exchange_presentation_delivery"
			),
			"publish_result_to_panel": false,
			"affects_market_projection": false,
			"authority_intent": {
				"action_id": (
					"confirm_centerpiece_hover_audio_delivery"
				),
				"payload": {
					"action_id": (
						"confirm_centerpiece_hover_audio_delivery"
					),
					"market_year": market_year,
					"playback_key": playback_key,
					"card_id": str(
						audio_contract.get(
							"card_id",
							authority_receipt.get(
								"card_id",
								""
							)
						)
					),
					"source": (
						"mainscene."
						+ "luxury_exchange_shiny_delivery"
					)
				},
				"target": {
					"route_kind": "engine_method",
					"engine_property": "luxury_shop_engine",
					"method": "resolve_intent",
					"pass_actor_payload": true,
					"actor_id": delivery_actor_id
				}
			}
		})

		set_meta(
			"luxury_exchange_shiny_delivery_intent_queued",
			true
		)
func _release_luxury_exchange_shiny_audio_from_hover(
	request: Dictionary
) -> void:
	var observation_contract: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			request.get(
				"observation_contract",
				{}
			)
		)
	)
	var observed_year: int = int(
		observation_contract.get(
			"market_year",
			-999999
		)
	)
	var playback_year: int = int(
		get_meta(
			"luxury_exchange_shiny_current_market_year",
			-999999
		)
	)

	if observed_year != playback_year:
		return

	var stop_on_unhover: bool = bool(
		get_meta(
			"luxury_exchange_shiny_stop_on_unhover",
			true
		)
	)

	if not stop_on_unhover:
		return




	if has_meta(
		"luxury_exchange_shiny_pending_authority_receipt"
	):
		remove_meta(
			"luxury_exchange_shiny_pending_authority_receipt"
		)

	var player:= get_node_or_null(
		"LuxuryExchangeShinyAudio"
	) as AudioStreamPlayer

	if (
		player != null
		and player.playing
	):
		player.stop()

	if has_meta(
		"luxury_exchange_shiny_active_stream_id"
	):
		remove_meta(
			"luxury_exchange_shiny_active_stream_id"
		)

	set_meta(
		"luxury_exchange_shiny_audio_playing",
		false
	)
	set_meta(
		"luxury_exchange_shiny_audio_stopped_by_unhover",
		true
	)
	set_meta(
		"luxury_exchange_shiny_audio_stopped_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"luxury_exchange_shiny_audio_host_stopped_by_unhover",
		false
	)
	set_meta(
		"luxury_exchange_shiny_unhover_blocks_ui",
		false
	)
func _startup_intro_surface_exclusive_active() -> bool:
	if _god_mode_runtime_severed():
		set_meta("startup_intro_runtime_continue_pending", false)
		set_meta("startup_intro_sequence_runner_active", false)
		set_meta("startup_intro_loading_reveal_active", false)

		if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay):
			startup_intro_overlay.visible = false
			startup_intro_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

		return false

	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay) and startup_intro_overlay.visible:
		return true

	if _god_mode_meta_bool("startup_intro_runtime_continue_pending", false, "_startup_intro_surface_exclusive_active"):
		return true

	if _god_mode_meta_bool("startup_intro_sequence_runner_active", false, "_startup_intro_surface_exclusive_active"):
		return true

	if _god_mode_meta_bool("startup_intro_loading_reveal_active", false, "_startup_intro_surface_exclusive_active"):
		return true

	return false
func _life_runtime_world_ready_for_live_systems() -> bool:
	if gs == null:
		return false
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	if bool(gs.scenario_state.get("post_spawn_world_prewarm_complete", false)):
		return true

	if bool(gs.scenario_state.get("post_spawn_world_prewarm_soft_deferred", false)):
		return true

	if _playable_life_shell_has_visible_sovereignty():
		gs.scenario_state ["post_spawn_world_prewarm_soft_deferred"] = true
		gs.scenario_state ["life_runtime_background_tail_deferred"] = true
		gs.scenario_state ["life_runtime_systems_soft_ui_resume_allowed"] = true
		gs.scenario_state ["world_tail_work_may_not_block_visible_shell"] = true
		return true

	if bool(gs.scenario_state.get("static_world_runtime_bootstrapped", false)) \
and bool(gs.scenario_state.get("birth_shell_player_control_released", false)):
		return true

	if bool(gs.scenario_state.get("live_reality_stream_ready", false)) \
and bool(gs.scenario_state.get("birth_shell_player_control_released", false)):
		return true

	return false

func _life_spawn_runtime_quarantine_active(
		now_ms: int = -1
) -> bool:
	var check_ms: int = now_ms

	if check_ms < 0:
		check_ms = int(
			Time.get_ticks_msec()
		)

	if gs == null:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false

	var visible_shell_sovereign: bool = (
		_playable_life_shell_has_visible_sovereignty()
	)

	if (
		_god_mode_runtime_severed()
		or visible_shell_sovereign
	):
		var controlled_actor_id: int = (
			int(
				gs.player.id
			)
			if gs.player != null
			else -1
		)
		var release_phase: String = (
			"visible_shell"
			if visible_shell_sovereign
			else "runtime_severed"
		)
		var release_signature: String = (
			"%d:%d:%s"
			% [
				int(
					gs.get_instance_id()
				),
				controlled_actor_id,
				release_phase
			]
		)
		var committed_signature: String = str(
			get_meta(
				"life_runtime_quarantine_release_signature",
				""
			)
		)

		if committed_signature != release_signature:
			set_meta(
				"life_runtime_systems_quarantined_until_world_prewarm_seen",
				false
			)
			set_meta(
				"life_runtime_systems_quarantine_reason",
				""
			)
			set_meta(
				"life_runtime_systems_quarantine_until_ms",
				0
			)

			if visible_shell_sovereign:
				_convert_visible_shell_tail_work_to_background_only(
					"life_spawn_quarantine_blocked_by_visible_shell"
				)

			gs.scenario_state [
				"life_runtime_systems_quarantined"
			] = false
			gs.scenario_state [
				"life_runtime_systems_quarantine_reason"
			] = ""
			gs.scenario_state [
				"life_runtime_systems_soft_ui_resume_allowed"
			] = true
			gs.scenario_state [
				"life_runtime_background_tail_deferred"
			] = true
			gs.scenario_state [
				"post_spawn_world_prewarm_soft_deferred"
			] = true
			gs.scenario_state [
				"world_tail_work_may_not_block_visible_shell"
			] = true

			set_meta(
				"life_runtime_quarantine_release_signature",
				release_signature
			)
			set_meta(
				"life_runtime_quarantine_release_committed_at_ms",
				check_ms
			)
			set_meta(
				"life_runtime_quarantine_release_is_one_shot_per_lens",
				true
			)

		return false

	var shell_released: bool = (
		bool(
			gs.scenario_state.get(
				"spawn_ready_live_ui_shell_released",
				false
			)
		)
		or bool(
			gs.scenario_state.get(
				"spawn_ready_life_diary_visible",
				false
			)
		)
		or bool(
			gs.scenario_state.get(
				"birth_shell_player_control_released",
				false
			)
		)
	)

	var world_pending: bool = (
		bool(
			gs.scenario_state.get(
				"post_spawn_world_prewarm_pending",
				false
			)
		)
		or bool(
			gs.scenario_state.get(
				"deferred_data_bootstrap_pending",
				false
			)
		)
		or bool(
			gs.scenario_state.get(
				"deferred_runtime_watchers_bootstrap",
				false
			)
		)
	)

	var handoff_active: bool = (
		bool(
			get_meta(
				"god_mode_capsule_entry_handoff_active",
				false
			)
		)
		or bool(
			get_meta(
				"god_mode_shell_first_handoff_requested",
				false
			)
		)
		or bool(
			get_meta(
				"god_mode_handoff_cover_release_pending",
				false
			)
		)
		or bool(
			get_meta(
				"god_mode_atomic_shell_handoff_active",
				false
			)
		)
	)

	if handoff_active and not shell_released:
		set_meta(
			"life_runtime_systems_quarantined_until_world_prewarm_seen",
			true
		)
		set_meta(
			"life_runtime_systems_quarantine_reason",
			"pre_shell_handoff"
		)
		set_meta(
			"life_runtime_systems_quarantine_until_ms",
			check_ms + 360
		)
		set_meta(
			"ui_idle_bus_flush_next_ms",
			check_ms + 700
		)
		set_meta(
			"age_up_tail_background_allowed_after_ms",
			check_ms + 700
		)
		set_meta(
			"speculative_year_precompute_next_ms",
			check_ms + 1200
		)
		return true

	if (
		shell_released
		and world_pending
		and not _life_runtime_world_ready_for_live_systems()
	):
		gs.scenario_state [
			"post_spawn_world_prewarm_soft_deferred"
		] = true
		gs.scenario_state [
			"life_runtime_systems_quarantined"
		] = false
		gs.scenario_state [
			"life_runtime_systems_quarantine_reason"
		] = ""
		gs.scenario_state [
			"life_runtime_systems_soft_ui_resume_allowed"
		] = true
		gs.scenario_state [
			"life_runtime_background_tail_deferred"
		] = true
		gs.scenario_state [
			"world_tail_work_may_not_block_visible_shell"
		] = true
		return false

	if _life_runtime_world_ready_for_live_systems():
		set_meta(
			"life_runtime_systems_quarantined_until_world_prewarm_seen",
			false
		)
		set_meta(
			"life_runtime_systems_quarantine_reason",
			""
		)
		set_meta(
			"life_runtime_systems_quarantine_until_ms",
			0
		)

		gs.scenario_state [
			"life_runtime_systems_quarantined"
		] = false
		gs.scenario_state [
			"life_runtime_systems_quarantine_reason"
		] = ""
		gs.scenario_state [
			"life_runtime_systems_soft_ui_resume_allowed"
		] = true
		gs.scenario_state [
			"life_runtime_background_tail_deferred"
		] = true

		return false

	var fallback_until_ms: int = int(
		get_meta(
			"life_runtime_systems_quarantine_until_ms",
			0
		)
	)

	if (
		fallback_until_ms > 0
		and check_ms < fallback_until_ms
	):
		return true

	return false
func _drive_life_spawn_runtime_quarantine_frame(delta: float, now_ms: int) -> void:
	set_meta("era_surface_refresh_next_ms", now_ms + 300)
	set_meta("era_surface_motion_refresh_next_ms", now_ms + 300)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 420)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 420)
	set_meta("speculative_year_precompute_next_ms", now_ms + 900)

	_animate_player_stats_overlay(delta)
	_animate_ui_nav_buttons(delta)
	_animate_panel_content_transition(delta)

	if _playable_life_surface_authority_lock_active():
		_ui_authority_confess(
			"_drive_life_spawn_runtime_quarantine_frame",
			"blocked_sync_god_mode_ui_lock_visuals",
			"quarantine_frame_must_not_reassert_god_mode",
			true
		)
		_enforce_playable_life_surface_authority_now("life_spawn_quarantine_frame_authority_override")
	else:
		_sync_god_mode_ui_lock_visuals()

	_animate_era_border_overlay(delta)
	_drive_ui_pointer_activity_probe(now_ms)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
		guard ["life_runtime_systems_quarantined"] = true
		guard ["life_runtime_systems_quarantine_reason"] = str(get_meta("life_runtime_systems_quarantine_reason", "spawn_quarantine"))
		guard ["ui_tail_work_yield_to_input"] = true
		guard ["defer_noncritical_systems"] = true
		guard ["last_action"] = "life_spawn_runtime_quarantine_frame"
		guard ["last_action_ms"] = now_ms
		gs.scenario_state ["runtime_guard"] = guard
func _prelife_surface_blocks_runtime_tail() -> bool:
	if _startup_intro_surface_exclusive_active():
		return true

	var live_shell_released: bool = (
		_playable_life_surface_player_control_released()
	)

	if (
		not live_shell_released
		and gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		live_shell_released = (
			bool(
				gs.scenario_state.get(
					"spawn_ready_live_ui_shell_released",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"spawn_ready_live_ui_shell_reconciled",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"birth_shell_player_control_released",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"spawn_ready_life_diary_visible",
					false
				)
			)
			or bool(
				gs.scenario_state.get(
					"playable_life_surface_has_visual_authority",
					false
				)
			)
		)

	if _god_mode_panel_runtime_terminated():
		if (
			gs != null
			and gs.player != null
		):



			if live_shell_released:
				return false

			_enforce_playable_life_surface_authority_now(
				"prelife_tail_god_mode_panel_terminated_with_player"
			)
			return false

		if bool(
			get_meta(
				"god_mode_panel_handoff_contract_consuming",
				false
			)
		):
			return false

		if bool(
			get_meta(
				"god_mode_panel_handoff_contract_pending",
				false
			)
		):
			return false

	if _playable_life_surface_authority_lock_active():
		if live_shell_released:
			return false

		_ui_authority_confess(
			"_prelife_surface_blocks_runtime_tail",
			"would_block_runtime_tail",
			"playable_life_surface_authority_lock_active",
			true
		)

		_enforce_playable_life_surface_authority_now(
			"prelife_surface_block_override"
		)
		return false

	if (
		choose_adventure_entry_overlay != null
		and is_instance_valid(
			choose_adventure_entry_overlay
		)
		and choose_adventure_entry_overlay.visible
	):
		if (
			gs != null
			and gs.player != null
		):
			_ui_authority_confess(
				"_prelife_surface_blocks_runtime_tail",
				"choose_adventure_overlay_blocked_live_player",
				"choose_adventure_entry_overlay_visible_after_player_exists",
				true
			)

			if live_shell_released:
				choose_adventure_entry_overlay.visible = false
				choose_adventure_entry_overlay.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				return false

			_enforce_playable_life_surface_authority_now(
				"choose_adventure_overlay_blocked_live_player"
			)
			return false

		return true

	if live_shell_released:
		return false

	if bool(
		get_meta(
			"god_mode_capsule_entry_handoff_active",
			false
		)
	):
		return true

	if bool(
		get_meta(
			"god_mode_shell_first_handoff_requested",
			false
		)
	):
		return true

	if bool(
		get_meta(
			"god_mode_handoff_cover_release_pending",
			false
		)
	):
		return true

	if bool(
		get_meta(
			"god_mode_atomic_shell_handoff_active",
			false
		)
	):
		return true

	if (
		god_mode_start_panel != null
		and is_instance_valid(
			god_mode_start_panel
		)
		and god_mode_start_panel.visible
	):
		if (
			gs != null
			and gs.player != null
		):
			_ui_authority_confess(
				"_prelife_surface_blocks_runtime_tail",
				"god_mode_start_panel_blocked_live_player",
				"god_mode_start_panel_visible_after_player_exists",
				true
			)

			if live_shell_released:
				god_mode_start_panel.visible = false
				god_mode_start_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				return false

			_enforce_playable_life_surface_authority_now(
				"god_mode_start_panel_blocked_live_player"
			)
			return false

		if bool(
			god_mode_start_panel.get_meta(
				"defer_free_after_spawn_shell",
				false
			)
		):
			return true

		if bool(
			god_mode_start_panel.get_meta(
				"atomic_shell_cover_active",
				false
			)
		):
			return true

		return true

	return false

func _drive_startup_intro_surface_exclusive_frame(delta: float) -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	set_meta("startup_intro_last_exclusive_frame_ms", now_ms)
	set_meta("startup_intro_last_exclusive_delta", delta)
	set_meta("era_surface_refresh_next_ms", now_ms + 750)
	set_meta("era_surface_motion_refresh_next_ms", now_ms + 750)
	set_meta("ui_idle_bus_flush_next_ms", now_ms + 750)
	set_meta("age_up_tail_background_allowed_after_ms", now_ms + 750)
	set_meta("prelife_tail_work_blocked_until_ms", now_ms + 750)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}

		guard ["startup_intro_surface_exclusive"] = true
		guard ["startup_intro_surface_exclusive_until_ms"] = now_ms + 750
		guard ["ui_tail_work_yield_to_input"] = true
		guard ["defer_noncritical_systems"] = true
		guard ["last_action"] = "startup_intro_surface_exclusive_frame"
		guard ["last_action_ms"] = now_ms
		gs.scenario_state ["runtime_guard"] = guard

		if bool(gs.scenario_state.get("age_up_deferred_flush_pending", false)):
			gs.scenario_state ["age_up_deferred_flush_next_ms"] = now_ms + 750
func _process(delta):
	var now_ms: int = int(Time.get_ticks_msec())
	var god_mode_runtime_dead: bool = _god_mode_runtime_severed()

	if _startup_intro_surface_exclusive_active():
		_drive_startup_intro_surface_exclusive_frame(delta)
		return

	if _global_runtime_kill_prelife_domain_frame_active(now_ms):
		_drive_global_runtime_prelife_domain_frame(delta, now_ms)
		return

	if _global_runtime_kill_visible_shell_frame_lock_active(now_ms):
		if now_ms >= int(
			get_meta(
				"global_runtime_kill_process_truth_next_ms",
				0
			)
		):
			set_meta(
				"global_runtime_kill_process_truth_next_ms",
				now_ms + 1000
			)
			EraLog.truth(
				"GLOBAL_RUNTIME_PROCESS_LOCK|renderer_only=1|panel=%s|loading_overlay=%s|age_busy=%s|post_boot=%s|deferred_bind=%s|tab_prewarm=%s|at_ms=%d"
				% [
					current_panel,
					str(
						age_up_loading_overlay != null
						and is_instance_valid(age_up_loading_overlay)
						and age_up_loading_overlay.visible
					),
					str(
						get_meta(
							"age_up_transition_busy",
							false
						)
					),
					str(
						get_meta(
							"post_first_frame_god_mode_life_boot_pending",
							false
						)
					),
					str(
						get_meta(
							"deferred_live_reality_stream_bind_pending",
							false
						)
					),
					str(
						get_meta(
							"spawn_ready_main_tab_packet_prewarm_running",
							false
						)
					),
					now_ms
				]
			)

		_drive_global_runtime_locked_renderer_only_frame(
			delta,
			now_ms
		)
		return

	if _run_age_up_loading_overlay_exclusive_frame(delta):
		return

	_render_god_mode_playable_surface_contract_if_claimed()

	if _playable_life_surface_authority_lock_active():
		var next_authority_enforce_ms: int = int(
			get_meta(
				"playable_life_surface_authority_next_enforce_ms",
				0
			)
		)

		if now_ms >= next_authority_enforce_ms:
			set_meta(
				"playable_life_surface_authority_next_enforce_ms",
				now_ms + 96
			)
			_enforce_playable_life_surface_authority_now(
				"_process_authority_lock_tick"
			)

	if (
		not god_mode_runtime_dead
		and _prelife_surface_blocks_runtime_tail()
	):
		_animate_god_mode_presentation(delta)
		_drive_god_mode_scrollbar_visibility(delta)
		_drive_god_mode_menu_music_rotation(delta)
		_drive_ui_pointer_activity_probe(now_ms)

		set_meta(
			"era_surface_refresh_next_ms",
			now_ms + 500
		)
		set_meta(
			"era_surface_motion_refresh_next_ms",
			now_ms + 500
		)
		set_meta(
			"ui_idle_bus_flush_next_ms",
			now_ms + 500
		)
		set_meta(
			"age_up_tail_background_allowed_after_ms",
			now_ms + 500
		)
		set_meta(
			"speculative_year_precompute_next_ms",
			now_ms + 900
		)
		return

	if _life_spawn_runtime_quarantine_active(now_ms):
		_drive_life_spawn_runtime_quarantine_frame(
			delta,
			now_ms
		)
		return






	_drive_ui_pointer_activity_probe(now_ms)

	var ui_grace_active: bool = (
		_ui_interaction_grace_active(
			now_ms
		)
	)

	_animate_player_stats_overlay(delta)
	_animate_profile_panel(delta)
	_animate_standard_tab_experience(delta)
	_animate_relationship_popup_experience(delta)
	_reconcile_visible_interactive_surfaces()

	if _institution_hub_runtime_surface_active():
		_animate_institution_hub_experience(delta)
		_drive_institution_hub_scrollbar_visibility(delta)

	_animate_ui_nav_buttons(delta)
	_animate_panel_content_transition(delta)

	if not god_mode_runtime_dead:
		_sync_god_mode_ui_lock_visuals()
		_animate_god_mode_presentation(delta)
		_drive_god_mode_scrollbar_visibility(delta)

	_animate_era_border_overlay(delta)
	_drive_era_audio_contract_runtime(delta)

	if not god_mode_runtime_dead:
		_drive_god_mode_menu_music_rotation(delta)

	_drive_era_mart_store_music_runtime(delta)
	_drive_grocery_store_realtime_contract(delta)
	_drive_self_checkout_live_surface_runtime(delta)
	_maybe_show_pending_upce_interpretation_popup()
	_drive_pending_situations_runtime(delta)

	var post_tail_settle_active: bool = (
		_post_age_up_tail_settle_active(
			now_ms
		)
	)

	var era_surface_signature: String = "%s|%s|%s|%s|%s|%s|%s" % [
		current_panel,
		str(activities_action_open),
		str(standard_tab_popup_open),
		str(world_feed_popup_open),
		str(relationship_profile_popup_open),
		str(relationships_browser_open),
		str(_current_era_ui_theme_key())
	]

	var last_era_surface_signature: String = str(
		get_meta(
			"era_surface_refresh_signature",
			""
		)
	)
	var next_era_surface_refresh_ms: int = int(
		get_meta(
			"era_surface_refresh_next_ms",
			0
		)
	)
	var era_surface_refresh_interval_ms: int = 120

	if panel_content_transition_active:
		era_surface_refresh_interval_ms = 16
	elif ui_grace_active:
		era_surface_refresh_interval_ms = 96
	elif post_tail_settle_active:
		era_surface_refresh_interval_ms = 140
	elif (
		activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
	):
		era_surface_refresh_interval_ms = 50

	var should_refresh_era_surface:= (
		era_surface_signature
		!= last_era_surface_signature
		or now_ms
		>= next_era_surface_refresh_ms
	)

	if should_refresh_era_surface:



		var defer_for_active_input: bool = (
			ui_grace_active
			and not panel_content_transition_active
		)

		if defer_for_active_input:
			set_meta(
				"era_surface_refresh_next_ms",
				now_ms + 64
			)
			set_meta(
				"era_surface_motion_refresh_next_ms",
				now_ms + 64
			)
			set_meta(
				"era_surface_refresh_deferred_for_ui_input",
				true
			)
		else:
			set_meta(
				"era_surface_refresh_deferred_for_ui_input",
				false
			)
			set_meta(
				"era_surface_refresh_signature",
				era_surface_signature
			)
			set_meta(
				"era_surface_refresh_next_ms",
				now_ms + era_surface_refresh_interval_ms
			)
			_refresh_era_surface_panels()

	_drive_pending_post_loading_idle_refresh_stage(now_ms)
	_restore_deferred_live_diagnostics_force_frames_if_ready()

	var diagnostics_restore_hold_frames: int = int(
		get_meta(
			"live_diagnostics_post_overlay_restore_frames",
			0
		)
	)
	var diagnostics_restore_until_ms: int = int(
		get_meta(
			"live_diagnostics_post_overlay_restore_until_ms",
			0
		)
	)
	var diagnostics_restore_gate_active: bool = (
		diagnostics_restore_hold_frames > 0
		or (
			diagnostics_restore_until_ms > 0
			and now_ms < diagnostics_restore_until_ms
		)
	)

	var diagnostics_preview_expanded: bool = bool(
		get_meta(
			"live_diagnostics_fix_preview_expanded",
			false
		)
	)
	var diagnostics_visible: bool = (
		live_diagnostics_panel != null
		and is_instance_valid(
			live_diagnostics_panel
		)
		and live_diagnostics_panel.visible
	)
	var diagnostics_should_refresh: bool = false

	if (
		live_diagnostics_force_frames > 0
		or diagnostics_preview_expanded
	):
		diagnostics_should_refresh = true
	elif age_up_loading_runtime_active:
		diagnostics_should_refresh = (
			diagnostics_visible
			and not _live_diagnostics_overlay_observer_suppressed()
		)
	elif diagnostics_restore_gate_active:
		diagnostics_should_refresh = (
			diagnostics_visible
			and not ui_grace_active
		)
	elif diagnostics_visible and not ui_grace_active:
		var next_diagnostics_refresh_ms: int = int(
			get_meta(
				"live_diagnostics_idle_refresh_next_ms",
				0
			)
		)

		if now_ms >= next_diagnostics_refresh_ms:
			diagnostics_should_refresh = true
			set_meta(
				"live_diagnostics_idle_refresh_next_ms",
				now_ms + 350
			)

	if diagnostics_should_refresh:
		_refresh_live_diagnostics_panel(delta)

	if not ui_grace_active:
		_drive_post_age_up_rewind_snapshot(delta)

	if gs == null:
		return






	var age_up_tail_quantum_ran: bool = (
		_drive_age_up_tail_runtime_concurrently(
			now_ms,
			ui_grace_active
		)
	)

	set_meta(
		"age_up_tail_concurrent_quantum_ran",
		age_up_tail_quantum_ran
	)
	set_meta(
		"age_up_tail_concurrent_ui_active",
		ui_grace_active
	)
	set_meta(
		"age_up_tail_concurrent_idle_required",
		false
	)

	var ui_idle_for_bus_flush: bool = (
		not age_up_loading_runtime_active
		and not bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
		and not bool(
			get_meta(
				"age_up_post_loading_finalize_pending",
				false
			)
		)
		and not panel_content_transition_active
		and not activities_action_open
		and not standard_tab_popup_open
		and not world_feed_popup_open
		and not relationship_profile_popup_open
		and not relationships_browser_open
		and (
			profile_panel_popup == null
			or not is_instance_valid(
				profile_panel_popup
			)
			or not profile_panel_popup.visible
		)
	)

	var background_tail_allowed: bool = (
		ui_idle_for_bus_flush
		and _background_tail_work_allowed(
			now_ms
		)
	)

	var handled_age_up_flush: bool = false

	if background_tail_allowed:
		handled_age_up_flush = (
			_drive_age_up_deferred_flush_if_idle(
				now_ms
			)
		)

		var guard_raw: Variant = (
			gs.scenario_state.get(
				"runtime_guard",
				{}
			)
			if typeof(gs.scenario_state) == TYPE_DICTIONARY
			else {}
		)
		var guard: Dictionary = (
			guard_raw
			if typeof(guard_raw) == TYPE_DICTIONARY
			else {}
		)

		var tail_settle_until_ms: int = max(
			int(
				guard.get(
					"post_age_up_tail_settle_until_ms",
					0
				)
			),
			int(
				get_meta(
					"age_up_post_live_tail_settle_until_ms",
					0
				)
			)
		)

		var active_tail_settle: bool = (
			bool(
				guard.get(
					"post_age_up_tail_settle_active",
					false
				)
			)
			or now_ms < tail_settle_until_ms
		)

		if background_tail_allowed:
			_drive_zero_frame_consciousness_switch_tail_if_idle(
				now_ms
			)

		if (
			not handled_age_up_flush
			and not active_tail_settle
		):
			var speculative_delay_ms: int = int(
				guard.get(
					"post_age_up_tail_speculative_delay_ms",
					0
				)
			)
			var speculative_allowed_ms: int = (
				tail_settle_until_ms
				+ speculative_delay_ms
			)

			if (
				tail_settle_until_ms <= 0
				or now_ms > speculative_allowed_ms
			):
				_drive_zero_frame_age_up_prewarm_if_idle(
					now_ms
				)

	elif ui_idle_for_bus_flush and ui_grace_active:
		set_meta(
			"ui_idle_bus_flush_next_ms",
			now_ms + 96
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var grace_guard_raw: Variant = (
				gs.scenario_state.get(
					"runtime_guard",
					{}
				)
			)
			var grace_guard: Dictionary = (
				grace_guard_raw
				if typeof(grace_guard_raw) == TYPE_DICTIONARY
				else {}
			)

			grace_guard [
				"ui_tail_work_yield_to_input"
			] = true
			grace_guard [
				"ui_interaction_grace_until_ms"
			] = max(
				int(
					grace_guard.get(
						"ui_interaction_grace_until_ms",
						0
					)
				),
				int(
					get_meta(
						"ui_interaction_grace_until_ms",
						0
					)
				)
			)
			gs.scenario_state [
				"runtime_guard"
			] = grace_guard

	if (
		background_tail_allowed
		and not handled_age_up_flush
		and gs.event_bus != null
		and gs.event_bus.has_method(
			"flush_deferred"
		)
	):
		var guard_raw: Variant = (
			gs.scenario_state.get(
				"runtime_guard",
				{}
			)
			if typeof(gs.scenario_state) == TYPE_DICTIONARY
			else {}
		)
		var guard: Dictionary = (
			guard_raw
			if typeof(guard_raw) == TYPE_DICTIONARY
			else {}
		)

		var next_bus_flush_ms: int = int(
			get_meta(
				"ui_idle_bus_flush_next_ms",
				0
			)
		)

		if now_ms >= next_bus_flush_ms:
			var flush_budget: int = 1
			var flush_interval_ms: int = int(
				guard.get(
					"ui_idle_bus_flush_interval_ms",
					96
				)
			)

			if flush_interval_ms <= 0:
				flush_interval_ms = 96

			gs.event_bus.flush_deferred(
				flush_budget,
				false
			)
			set_meta(
				"ui_idle_bus_flush_next_ms",
				now_ms + flush_interval_ms
			)

	if not gs.realtime_enabled:
		return

	tick_timer -= delta

	if Input.is_action_just_pressed("ui_select"):
		toggle_year_lock()

	if tick_timer > 0:
		return



	if ui_grace_active:
		set_meta(
			"life_realtime_tick_yielded_to_ui_input",
			true
		)
		set_meta(
			"life_realtime_tick_yielded_at_ms",
			now_ms
		)
		tick_timer = 0.0
		return

	set_meta(
		"life_realtime_tick_yielded_to_ui_input",
		false
	)



	var realtime_report: Dictionary = (
		_request_runtime_engine_method_intent(
			"life_engine",
			"tick",
			[],
			"life_realtime_tick_quantum",
			"mainscene.life_realtime_tick_runtime",
			true
		)
	)

	if not bool(
		realtime_report.get(
			"success",
			false
		)
	):

		tick_timer = 0.25
		set_meta(
			"life_realtime_tick_last_failure",
			realtime_report.duplicate(false)
		)
		return

	var realtime_cycle_complete: bool = bool(
		realtime_report.get(
			"cycle_complete",
			realtime_report.get(
				"is_complete",
				true
			)
		)
	)

	set_meta(
		"life_realtime_tick_last_report",
		realtime_report.duplicate(false)
	)
	set_meta(
		"life_realtime_tick_cycle_complete",
		realtime_cycle_complete
	)

	if realtime_cycle_complete:
		MainSceneLogic._process_realtime_notifications(gs)
		tick_timer = 1.0
	else:


		tick_timer = 0.0
func _drive_pending_situations_runtime(
	delta: float
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return



	if gs.pending_situations_engine == null:
		return

	var actor_id: int = (
		MainSceneLogic._pending_situations_controlled_actor_id(gs)
	)
	var actor_changed: bool = (
		actor_id
		!= pending_situations_last_actor_id
	)

	if actor_changed:
		pending_situations_last_actor_id = actor_id

		set_meta(
			"pending_situations_dirty",
			true
		)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var next_service_ms: int = int(
		get_meta(
			"pending_situations_runtime_next_service_ms",
			0
		)
	)
	var dirty: bool = bool(
		get_meta(
			"pending_situations_dirty",
			false
		)
	)

	if (
		not actor_changed
		and not dirty
		and now_ms < next_service_ms
	):
		return






	set_meta(
		"pending_situations_runtime_next_service_ms",
		now_ms
		+ PendingSituationsEngine.PENDING_RUNTIME_QUANTUM_INTERVAL_MS
	)
	set_meta(
		"pending_situations_runtime_yielded_to_ui_input",
		false
	)
	set_meta(
		"pending_situations_runtime_player_idle_required",
		false
	)

	var report: Dictionary = (
		_request_runtime_engine_method_intent(
			"pending_situations_engine",
			"runtime_tick",
			[
				delta,
				{
					"source": (
						"mainscene_pending_situations_resident_runtime"
					),
					"controlled_actor_id": actor_id,
					"ui_is_expression_only": true
				}
			],
			"pending_situations_runtime_quantum:%d"
			% actor_id,
			"mainscene.pending_situations_resident_runtime",
			true
		)
	)



	var payload: Dictionary = {}

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var payload_registry_raw: Variant = (
			gs.scenario_state.get(
				"resident_pending_situations_payload_by_actor",
				{}
			)
		)

		if typeof(payload_registry_raw) == TYPE_DICTIONARY:
			var payload_raw: Variant = (
				(payload_registry_raw as Dictionary).get(
					str(actor_id),
					{}
				)
			)

			if typeof(payload_raw) == TYPE_DICTIONARY:
				payload = (
					(payload_raw as Dictionary)
					.duplicate(false)
				)

	var payload_revision: String = (
		_pending_situations_payload_revision(
			payload
		)
	)

	var installed_revision: String = str(
		get_meta(
			"pending_situations_runtime_installed_revision",
			""
		)
	)
	var payload_changed: bool = (
		payload_revision != ""
		and payload_revision != installed_revision
	)
	var popup_prepainted_for_actor: bool = (
		popup_viewer != null
		and is_instance_valid(
			popup_viewer
		)
		and int(
			popup_viewer.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and str(
			popup_viewer.get_meta(
				"prepainted_payload_revision",
				""
			)
		) == payload_revision
	)

	if (
		not payload.is_empty()
		and (
			payload_changed
			or not popup_prepainted_for_actor
		)
	):
		var popup_hot: bool = (
			_prepaint_pending_situations_popup_payload(
				payload,
				actor_id
			)
		)

		if popup_hot:
			set_meta(
				"pending_situations_runtime_installed_revision",
				payload_revision
			)
			set_meta(
				"pending_situations_runtime_installed_actor_id",
				actor_id
			)
			set_meta(
				"pending_situations_runtime_prepainted",
				true
			)

	if (
		actor_changed
		or bool(
			report.get(
				"payload_publication_performed",
				false
			)
		)
		or dirty
		or payload_changed
		or (
			not payload.is_empty()
			and not popup_prepainted_for_actor
		)
	):
		set_meta(
			"pending_situations_dirty",
			false
		)

		_update_pending_situations_button()

	set_meta(
		"pending_situations_runtime_renderer_called_engine_directly",
		false
	)
	set_meta(
		"pending_situations_runtime_global_intent_routed",
		true
	)
	set_meta(
		"pending_situations_runtime_player_idle_required",
		false
	)
	set_meta(
		"pending_situations_runtime_ui_interaction_is_scheduler_input",
		false
	)
	set_meta(
		"pending_situations_runtime_revision_owned_by_engine",
		true
	)
func _drive_post_age_up_rewind_snapshot(_delta: float) -> void:
	if gs == null:
		set_meta("post_age_up_rewind_snapshot_pending", false)
		set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
		set_meta("post_age_up_rewind_snapshot_next_step_ms", 0)
		return

	if not gs.has_method("has_pending_rewind_snapshot_pipeline") \
or not gs.has_method("step_rewind_snapshot_pipeline") \
or not gs.has_method("capture_rewind_snapshot"):
		set_meta("post_age_up_rewind_snapshot_pending", false)
		set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
		set_meta("post_age_up_rewind_snapshot_next_step_ms", 0)
		return

	var snapshot_pending: bool = bool(get_meta("post_age_up_rewind_snapshot_pending", false))
	var pipeline_active: bool = gs.has_pending_rewind_snapshot_pipeline()

	if not snapshot_pending and not pipeline_active:
		if bool(get_meta("post_age_up_rewind_snapshot_pipeline_active", false)):
			set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
			set_meta("post_age_up_rewind_snapshot_next_step_ms", 0)
		return

	var ui_busy: bool = age_up_loading_runtime_active \
or bool(get_meta("age_up_transition_busy", false)) \
or bool(get_meta("age_up_post_loading_finalize_pending", false)) \
or panel_content_transition_active \
or activities_action_open \
or standard_tab_popup_open \
or world_feed_popup_open \
or relationship_profile_popup_open \
or relationships_browser_open \
or (profile_panel_popup != null and is_instance_valid(profile_panel_popup) and profile_panel_popup.visible)

	if ui_busy:
		return
	if _ui_interaction_grace_active(int(Time.get_ticks_msec())):
		set_meta("post_age_up_rewind_snapshot_next_step_ms", int(Time.get_ticks_msec()) + 260)
		return
	var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}

	var tail_settle_until_ms: int = max(
		int(guard.get("post_age_up_tail_settle_until_ms", 0)),
		int(get_meta("age_up_post_live_tail_settle_until_ms", 0))
	)

	if tail_settle_until_ms > 0:
		var rewind_delay_ms: int = int(guard.get("post_age_up_tail_rewind_delay_ms", 900))
		if int(Time.get_ticks_msec()) < tail_settle_until_ms + rewind_delay_ms:
			set_meta("post_age_up_rewind_snapshot_next_step_ms", tail_settle_until_ms + rewind_delay_ms)
			return
	var now_ms: int = int(Time.get_ticks_msec())
	var next_step_ms: int = int(get_meta("post_age_up_rewind_snapshot_next_step_ms", 0))
	if now_ms < next_step_ms:
		return

	if snapshot_pending and not pipeline_active:
		gs.capture_rewind_snapshot()
		set_meta("post_age_up_rewind_snapshot_pending", false)
		set_meta("post_age_up_rewind_snapshot_pipeline_active", true)
		set_meta("post_age_up_rewind_snapshot_next_step_ms", now_ms + 220)
		return

	if not pipeline_active:
		set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
		set_meta("post_age_up_rewind_snapshot_next_step_ms", 0)
		return

	var bucket_raw: Variant = gs.scenario_state.get("rewind_snapshot_pipeline", {}) if typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var bucket: Dictionary = bucket_raw if typeof(bucket_raw) == TYPE_DICTIONARY else {}
	var stage: String = str(bucket.get("stage", "")).strip_edges()

	var max_steps: int = 1
	var next_interval_ms: int = 60

	match stage:
		"delay":
			max_steps = 1
			next_interval_ms = 50
		"save_npcs":
			max_steps = 2
			next_interval_ms = 18
		"save_collect":
			max_steps = 1
			next_interval_ms = 120
		"save_write":
			max_steps = 1
			next_interval_ms = 260
		"cleanup":
			max_steps = 1
			next_interval_ms = 40
		_:
			max_steps = 1
			next_interval_ms = 80

	gs.step_rewind_snapshot_pipeline(max_steps)
	set_meta("post_age_up_rewind_snapshot_next_step_ms", now_ms + next_interval_ms)

	if not gs.has_pending_rewind_snapshot_pipeline():
		set_meta("post_age_up_rewind_snapshot_pipeline_active", false)
		set_meta("post_age_up_rewind_snapshot_next_step_ms", 0)
func _format_year(y: int) -> String:
	var calendar: Dictionary = MainSceneHelpers._safe_dictionary(
		active_reality_surface_contract.get(
			"display_calendar",
			{}
		)
	)
	var projected_label: String = str(
		calendar.get(
			"year_label",
			""
		)
	).strip_edges()
	var applies_to_visible_years: bool = bool(
		calendar.get(
			"apply_to_all_visible_years",
			false
		)
	)

	if (
		projected_label != ""
		and (
			applies_to_visible_years
			or (
				gs != null
				and y == int(gs.year)
			)
		)
	):
		return projected_label

	if y < 0:
		return "%d BCE" % abs(y)
	elif y <= 1000:
		return "%d AD" % y

	return str(y)





