func _open_relationship_editor_popup(target: Person) -> void:
	if target == null:
		return

	_ensure_relationship_editor_popup()
	MainSceneLogic._ensure_live_person_editor_engine(gs)

	if relationship_editor_popup == null or not is_instance_valid(relationship_editor_popup):
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = "The editor could not be opened."
		return

	if gs != null and gs.has_method("sync_person_death_state_from_health"):
		gs.sync_person_death_state_from_health(target)

	if not bool(target.alive) or float(target.health) <= 0.0:
		if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
			relationship_profile_popup.visible = true
		if relationship_profile_popup_status != null:
			relationship_profile_popup_status.text = "Dead NPCs cannot be edited."
		return

	if gs != null and gs.live_person_editor_engine != null and gs.live_person_editor_engine.has_method("build_open_contract"):
		gs.live_person_editor_engine.build_open_contract(target, {
			"source": "relationship_profile_edit_them",
			"surface": "relationship_editor_popup",
			"relationship_profile_target_id": int(target.id),
			"ui_policy": {
				"ui_is_pure_renderer": true,
			}
		})

	relationship_editor_popup_target_id = int(target.id)

	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
		relationship_profile_popup.visible = false
		relationship_profile_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE

	relationship_editor_popup.visible = true
	relationship_editor_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	relationship_editor_popup.focus_mode = Control.FOCUS_ALL

	_bring_modal_to_front(relationship_editor_popup)

	if relationship_editor_popup_title != null:
		relationship_editor_popup_title.text = "EDIT THEM — %s %s" % [
			target.first_name,
			target.last_name
		]

	if relationship_editor_popup_status != null:
		relationship_editor_popup_status.text = ""

	relationship_editor_happiness_slider.value = int(target.satisfaction)
	relationship_editor_health_slider.value = int(target.health)
	relationship_editor_smarts_slider.value = int(target.smarts)
	relationship_editor_looks_slider.value = int(target.looks)
	relationship_editor_mental_health_slider.value = int(target.mental_health)
	relationship_editor_fame_slider.value = int(target.fame)
	relationship_editor_fertility_slider.value = int(target.fertility)

	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_happiness_slider, relationship_editor_happiness_value_label)
	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_health_slider, relationship_editor_health_value_label)
	MainSceneHelpers._sync_single_stat_value_label(relationship_editor_smarts_slider, relationship_editor_smarts_value_label)
