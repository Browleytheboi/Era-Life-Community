		title_card_account_password_toggle_button.tooltip_text = (
			"Hide password"
			if not title_card_account_password_edit.secret
			else "Show password"
		)

	title_card_account_password_edit.grab_focus()
	title_card_account_password_edit.caret_column = (
		title_card_account_password_edit.text.length()
