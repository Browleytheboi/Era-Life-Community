func _add_reality_fusion_mode_button(row: HBoxContainer, text: String, path: String, label: String, mode: String, loadout_owner: Control = null) -> void:
	var clean_mode: String = str(mode).strip_edges().to_lower()
	var clean_path: String = str(path).strip_edges()

	if clean_mode == "enter_universe" and MainSceneLogic._reality_fusion_current_universe_matches_path(gs, clean_path):
		return

	var button:= Button.new()
	button.text = MainSceneHelpers._reality_fusion_mode_button_text(text, clean_mode)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.custom_minimum_size = Vector2(118, 38)
	button.tooltip_text = MainSceneHelpers._reality_fusion_mode_warning(clean_mode)
	button.disabled = clean_path == ""
	button.set_meta("fusion_mode", clean_mode)
	button.add_theme_stylebox_override("normal", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, false, button.disabled))
	button.add_theme_stylebox_override("hover", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, true, button.disabled))
	button.add_theme_stylebox_override("pressed", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, true, false))

	if clean_mode in ["enter_universe", "friend_person", "pick_family_member"]:
		button.pressed.connect(_on_reality_fusion_mode_pressed.bind(clean_path, label, clean_mode))
	else:
		var loadout_surface: Control = loadout_owner
		if loadout_surface == null:
			loadout_surface = row
		button.pressed.connect(_on_reality_fusion_loadout_toggle_pressed.bind(clean_path, label, clean_mode, loadout_surface, button))

	row.add_child(button)
func _on_reality_fusion_mode_pressed(path: String, label: String, mode: String) -> void:
	var clean_path: String = str(path).strip_edges()
	var clean_mode: String = str(mode).strip_edges().to_lower()

	if clean_path == "":
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "That universe has no save path."
		return

	if clean_mode == "enter_universe":
		_queue_reality_fusion_enter_universe_warning(clean_path, label)
		return

	if clean_mode == "pick_family_member":
		_open_reality_fusion_family_picker(clean_path, label)
		return

	var contract: Dictionary = MainSceneLogic._build_reality_fusion_contract(clean_mode)

	if clean_mode == "friend_person":
		_queue_reality_fusion_ally_allegiance_scenario(clean_path, label, contract)
		return

	_begin_reality_fusion_execution(clean_path, label, clean_mode, contract)
func _queue_reality_fusion_enter_universe_warning(path: String, label: String) -> void:
	var clean_path: String = str(path).strip_edges()
	var clean_label: String = str(label).strip_edges()
	if clean_label == "":
		clean_label = "another universe"

	if clean_path == "":
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "That universe has no save path."
		return

	if MainSceneLogic._reality_fusion_current_universe_matches_path(gs, clean_path):
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "You are already inside that universe."
		return

	if gs == null:
		_bootstrap_gs_for_save_load_if_needed()

	if gs == null or gs.scenario_engine == null:
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "ScenarioEngine is unavailable for universe entry."
		return

	if gs.scenario_engine.has_pending_choice():
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "Resolve the current scenario before opening another timeline."
		return

	var source_mode: String = "unknown"
	if gs.has_method("get_reality_mode"):
		source_mode = str(gs.get_reality_mode())

	var preview: Dictionary = {}
	var contract: Dictionary = MainSceneLogic._build_reality_fusion_contract("friend_person")
	if gs.has_method("preview_reality_fusion_from_save"):
		preview = gs.preview_reality_fusion_from_save(clean_path, contract)

	var source_player: Dictionary = {}
	if typeof(preview.get("source_player", {})) == TYPE_DICTIONARY:
		source_player = preview.get("source_player", {}).duplicate(true)

	var source_name: String = str(source_player.get("name", "someone from that universe")).strip_edges()
	if source_name == "":
		source_name = "someone from that universe"

	var source_identity: String = MainSceneHelpers._reality_fusion_source_identity_from_preview(source_player)

	var scenario: Dictionary = {
		"id": "reality_fusion_dimension_travel_warning_%d_%d" % [int(gs.year), int(Time.get_ticks_msec())],
		"source": "scenario_engine",
		"category": "reality_fusion",
		"cooldown_key": "reality_fusion_dimension_travel_warning",
		"resolver_method": "_resolve_reality_fusion_enter_universe_choice",
		"panel_title": "REALITY FUSION — DIMENSION TRAVEL WARNING",
		"footer_text": "Dimension travel can trigger identity drift, timeline glitches, TVA heat, and hostile first contact.",
		"prompt": "You are about to travel dimensions.\n\nTarget universe: %s\nPrimary identity detected: %s\nIdentity echo: %s\n\nThis is not a normal load. You will remain yourself, but entering another timeline can cause unintended consequences:\n\n• the universe may notice you\n• the person inside may question you\n• TVA heat may rise\n• your UI and stats may glitch while you are displaced\n• leaving may not be clean\n\nDo you still want to step through?" % [
			clean_label,
			source_name,
			source_identity
		],
		"timeline_glitch": true,
		"reality_fusion_enter_path": clean_path,
		"reality_fusion_enter_label": clean_label,
		"reality_fusion_source_mode": source_mode,
		"reality_fusion_contract": contract.duplicate(true),
		"reality_fusion_source_player": source_player.duplicate(true),
		"choices": [
			{
				"id": "reality_fusion_dimension_travel_confirm",
				"label": "Travel dimensions anyway",
				"journal_text": "I chose to travel dimensions through Reality Fusion.",
				"reality_fusion_enter_path": clean_path,
				"reality_fusion_enter_label": clean_label,
				"reality_fusion_source_mode": source_mode,
				"reality_fusion_contract": contract.duplicate(true),
				"reality_fusion_source_player": source_player.duplicate(true),
				"button_theme": "reality_break",
				"power_source": "reality"
			},
			{
				"id": "reality_fusion_dimension_travel_cancel",
				"label": "Stay in my universe",
				"journal_text": "I chose not to travel dimensions through Reality Fusion.",
				"reality_fusion_enter_path": clean_path,
				"reality_fusion_enter_label": clean_label,
				"reality_fusion_source_mode": source_mode,
				"reality_fusion_contract": contract.duplicate(true),
				"reality_fusion_source_player": source_player.duplicate(true),
				"button_theme": "defensive_escape",
				"power_source": "survival"
			}
		]
	}

	_close_reality_fusion_hub()
	var result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
	_refresh_scenario_ui_from_result(result)


func _run_reality_fusion_deferred(path: String, mode: String, contract: Dictionary) -> void:
	if gs == null:
		_bootstrap_gs_for_save_load_if_needed()
	if gs == null:
		_finish_reality_fusion({
			"success": false,
			"reason": "GameState could not be created for Reality Fusion.",
			"mode": mode
		})
		return
	if not gs.has_method("fuse_reality_from_save"):
		_finish_reality_fusion({
			"success": false,
			"reason": "GameState does not expose fuse_reality_from_save().",
			"mode": mode
		})
		return

	if typeof(contract.get("loadout_contracts", [])) == TYPE_ARRAY:
		_finish_reality_fusion(_run_reality_fusion_loadout(path, mode, contract))
		return

	var report: Dictionary = gs.fuse_reality_from_save(path, contract)
	_finish_reality_fusion(report)


func _finish_reality_fusion(report: Dictionary) -> void:
	_stop_all_reality_fusion_evolution_previews()
	_set_reality_fusion_hub_buttons_enabled(true)

	var success: bool = bool(report.get("success", false))
	var mode: String = str(report.get("mode", reality_fusion_pending_mode)).strip_edges()

	if success:
		var source_name: String = str(report.get("source_player_name", report.get("imported_player_name", "another universe"))).strip_edges()
		if source_name == "":
			source_name = "another universe"

		var success_text: String = MainSceneHelpers._reality_fusion_success_label(mode, source_name)

		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "Reality Fusion complete: %s" % success_text
		if world_actions_status_label != null:
			world_actions_status_label.text = success_text

		current_panel = "world"
		_refresh_current_panel()
		_update_player_stats_overlay()
		_update_belongings_hud()
		_update_bending_hud()
	else:
		var reason: String = str(report.get("reason", "Reality Fusion failed."))
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = reason
		if world_actions_status_label != null:
			world_actions_status_label.text = reason

	reality_fusion_pending_path = ""
	reality_fusion_pending_label = ""
	reality_fusion_pending_mode = ""
	reality_fusion_pending_contract = {}


func _set_reality_fusion_hub_buttons_enabled(enabled: bool) -> void:
	if reality_fusion_hub_list == null:
		return

	for child in reality_fusion_hub_list.get_children():
		if child is Button:
			(child as Button).disabled = not enabled
			continue

		if child is Control:
			for nested in (child as Control).get_children():
				if nested is Button:
					(nested as Button).disabled = not enabled
				elif nested is Control:
					for deep_child in (nested as Control).get_children():
						if deep_child is Button:
							(deep_child as Button).disabled = not enabled

	if reality_fusion_hub_back_button != null:
		reality_fusion_hub_back_button.disabled = not enabled


func _begin_reality_fusion_execution(path: String, label: String, mode: String, contract: Dictionary) -> void:
	var clean_path: String = str(path).strip_edges()
	var clean_mode: String = str(mode).strip_edges().to_lower()
	reality_fusion_pending_path = clean_path
	reality_fusion_pending_label = label
	reality_fusion_pending_mode = clean_mode
	reality_fusion_pending_contract = contract.duplicate(true)

	if reality_fusion_hub_status_label != null:
		reality_fusion_hub_status_label.text = "%s\n%s\n%s" % [
			MainSceneHelpers._reality_fusion_mode_warning(clean_mode),
			label,
			_reality_fusion_risk_text(contract, _reality_fusion_contract_modes(contract))
		]

	_set_reality_fusion_hub_buttons_enabled(false)
	call_deferred("_run_reality_fusion_deferred", clean_path, clean_mode, reality_fusion_pending_contract)


func _on_reality_fusion_loadout_toggle_pressed(path: String, label: String, mode: String, loadout_surface: Control, button: Button) -> void:
	if loadout_surface == null:
		return
	var clean_mode: String = str(mode).strip_edges().to_lower()
	var raw_loadout: Variant = loadout_surface.get_meta("fusion_loadout", [])
	var loadout: Array = raw_loadout.duplicate(true) if typeof(raw_loadout) == TYPE_ARRAY else []

	if clean_mode in loadout:
		loadout.erase(clean_mode)
	else:
		loadout.append(clean_mode)

	loadout_surface.set_meta("fusion_path", path)
	loadout_surface.set_meta("fusion_label", label)
	loadout_surface.set_meta("fusion_loadout", loadout)

	var selected: bool = clean_mode in loadout
	button.add_theme_stylebox_override("normal", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, selected, false))
	button.add_theme_stylebox_override("hover", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, true, false))
	button.add_theme_stylebox_override("pressed", MainSceneLogic._reality_fusion_mode_button_style(clean_mode, true, false))

	_update_reality_fusion_loadout_surface(loadout_surface)


func _on_reality_fusion_execute_loadout_pressed(path: String, label: String, loadout_surface: Control) -> void:
	if loadout_surface == null:
		return

	if bool(loadout_surface.get_meta("fusion_execute_animating", false)):
		return

	var raw_loadout: Variant = loadout_surface.get_meta("fusion_loadout", [])
	var loadout: Array = raw_loadout.duplicate(true) if typeof(raw_loadout) == TYPE_ARRAY else []
	if loadout.is_empty():
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "Choose at least one fusion layer first."
		return

	var contract: Dictionary = _build_reality_fusion_loadout_contract(loadout)
	loadout_surface.set_meta("fusion_execute_animating", true)
	loadout_surface.set_meta("fusion_pending_execute_contract", contract.duplicate(true))

	_start_reality_fusion_evolution_preview(loadout_surface)
	_animate_reality_fusion_execute_button_press(loadout_surface)

	if reality_fusion_hub_status_label != null:
		reality_fusion_hub_status_label.text = "Fusion loadout charging...\n%s\n%s" % [
			label,
			_build_reality_fusion_loadout_preview_text(contract, loadout, true)
		]

	var tree:= get_tree()
	if tree == null:
		_finish_reality_fusion_execute_after_pulse(path, label, contract)
		return

	tree.create_timer(0.46).timeout.connect(_finish_reality_fusion_execute_after_pulse.bind(path, label, contract))
func _finish_reality_fusion_execute_after_pulse(path: String, label: String, contract: Dictionary) -> void:
	_set_reality_fusion_hub_buttons_enabled(false)
	_begin_reality_fusion_execution(path, label, "fusion_loadout", contract)


func _reality_fusion_execute_button_from_surface(loadout_surface: Control) -> Button:
	if loadout_surface == null:
		return null

	var execute_path_raw: Variant = loadout_surface.get_meta("fusion_execute_button_path", NodePath(""))
	if typeof(execute_path_raw) != TYPE_NODE_PATH:
		return null

	var execute_node:= get_node_or_null(execute_path_raw)
	if execute_node is Button:
		return execute_node as Button

	return null


func _animate_reality_fusion_execute_button_press(loadout_surface: Control) -> void:
	var execute_button:= _reality_fusion_execute_button_from_surface(loadout_surface)
	if execute_button == null:
		return

	execute_button.disabled = true
	execute_button.pivot_offset = execute_button.size * 0.5
	execute_button.add_theme_stylebox_override("normal", MainSceneHelpers._reality_fusion_execute_button_style(true, true, false))
	execute_button.add_theme_stylebox_override("hover", MainSceneHelpers._reality_fusion_execute_button_style(true, true, false))
	execute_button.add_theme_stylebox_override("pressed", MainSceneHelpers._reality_fusion_execute_button_style(true, true, false))

	var tween:= create_tween()
	if tween == null:
		return

	tween.set_parallel(true)
	tween.tween_property(execute_button, "scale", Vector2(1.055, 1.055), 0.12).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(execute_button, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.12).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

	var settle:= create_tween()
	if settle == null:
		return

	settle.tween_interval(0.14)
	settle.tween_property(execute_button, "scale", Vector2.ONE, 0.24).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	settle.parallel().tween_property(execute_button, "modulate", Color(1.0, 0.94, 0.72, 1.0), 0.24).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


func _on_reality_fusion_clear_loadout_pressed(loadout_surface: Control) -> void:
	if loadout_surface == null:
		return
	loadout_surface.set_meta("fusion_loadout", [])
	_update_reality_fusion_loadout_surface(loadout_surface)


func _update_reality_fusion_loadout_surface(loadout_surface: Control) -> void:
	if loadout_surface == null:
		return

	var raw_loadout: Variant = loadout_surface.get_meta("fusion_loadout", [])
	var loadout: Array = raw_loadout.duplicate(true) if typeof(raw_loadout) == TYPE_ARRAY else []
	var contract: Dictionary = _build_reality_fusion_loadout_contract(loadout) if not loadout.is_empty() else {}
	var is_animating: bool = bool(loadout_surface.get_meta("fusion_execute_animating", false))

	var preview_path_raw: Variant = loadout_surface.get_meta("fusion_loadout_preview_label_path", NodePath(""))
	if typeof(preview_path_raw) == TYPE_NODE_PATH:
		var preview_node:= get_node_or_null(preview_path_raw)
		if preview_node is Label:
			(preview_node as Label).text = _build_reality_fusion_loadout_preview_text(contract, loadout, false)

	var risk_path_raw: Variant = loadout_surface.get_meta("fusion_risk_label_path", NodePath(""))
	if typeof(risk_path_raw) == TYPE_NODE_PATH:
		var risk_node:= get_node_or_null(risk_path_raw)
		if risk_node is Label:
			(risk_node as Label).text = _reality_fusion_risk_text(contract, loadout)

	var execute_button:= _reality_fusion_execute_button_from_surface(loadout_surface)
	if execute_button != null:
		execute_button.disabled = loadout.is_empty() or is_animating
		execute_button.add_theme_stylebox_override("normal", MainSceneHelpers._reality_fusion_execute_button_style(not loadout.is_empty(), is_animating, loadout.is_empty()))
		execute_button.add_theme_stylebox_override("hover", MainSceneHelpers._reality_fusion_execute_button_style(true, is_animating, loadout.is_empty()))
		execute_button.add_theme_stylebox_override("pressed", MainSceneHelpers._reality_fusion_execute_button_style(true, true, false))

	for node in MainSceneHelpers._collect_reality_fusion_buttons(loadout_surface):
		if node is Button:
			var button:= node as Button
			var mode: String = str(button.get_meta("fusion_mode", "")).strip_edges().to_lower()
			if mode == "":
				continue
			var selected: bool = mode in loadout
			if mode not in ["enter_universe", "friend_person", "pick_family_member"]:
				button.add_theme_stylebox_override("normal", MainSceneLogic._reality_fusion_mode_button_style(mode, selected, button.disabled))

	_refresh_reality_fusion_evolution_preview(loadout_surface, false)

func _build_reality_fusion_loadout_contract(loadout: Array) -> Dictionary:
	var clean_modes: Array = []
	for raw_mode in loadout:
		var clean_mode: String = str(raw_mode).strip_edges().to_lower()
		if clean_mode != "" and clean_mode not in clean_modes:
			clean_modes.append(clean_mode)

	var combined: Dictionary = {
		"schema": "eralife.reality_fusion_contract",
		"version": 1,
		"id": "main_scene_fusion_loadout",
		"mode": "fusion_loadout",
		"extract": {
			"relationships": "none"
		},
		"transform": {},
		"reconcile": {
			"source_world": "unchanged",
			"write_source_save": false,
			"compensation": "none"
		},
		"balance": {
			"fatigue_cost": 0.0,
			"mental_strain": 0.0,
			"identity_instability": 0.0,
			"mutation_risk": 0.0,
			"cooldown_ms": 2500
		},
		"source_resistance": {
			"enabled": false,
			"chance": 0.0
		},
		"ui": {
			"label": "Fusion Loadout",
			"modes": clean_modes.duplicate(true),
		}
	}

	var import_contracts: Array = []
	var has_component_fusion: bool = false

	for clean_mode in clean_modes:
		var sub_contract: Dictionary = MainSceneLogic._build_reality_fusion_contract(clean_mode)
		if clean_mode in ["bring_person_family", "friend_person", "bring_family_member"]:
			import_contracts.append(sub_contract)
			_merge_reality_fusion_balance_into(combined, sub_contract)
			continue

		has_component_fusion = true
		var sub_extract: Dictionary = _reality_fusion_safe_dictionary(sub_contract.get("extract", {}))
		var sub_transform: Dictionary = _reality_fusion_safe_dictionary(sub_contract.get("transform", {}))
		for key in sub_extract.keys():
			combined ["extract"] [key] = sub_extract [key]
		for key in sub_transform.keys():
			combined ["transform"] [key] = sub_transform [key]
		if bool(sub_contract.get("source_resistance", {}).get("enabled", false)):
			combined ["source_resistance"] ["enabled"] = true
			combined ["source_resistance"] ["chance"] = max(
				float(combined ["source_resistance"].get("chance", 0.0)),
				float(sub_contract.get("source_resistance", {}).get("chance", 0.0))
			)
		_merge_reality_fusion_balance_into(combined, sub_contract)

	if import_contracts.size() > 0:
		var contracts: Array = []
		for import_contract in import_contracts:
			contracts.append(import_contract)
		if has_component_fusion:
			contracts.append(combined)
		return {
			"schema": "eralife.reality_fusion_loadout_contract",
			"version": 1,
			"id": "main_scene_fusion_loadout_sequence",
			"mode": "fusion_loadout",
			"loadout_contracts": contracts,
			"ui": {
				"label": "Fusion Loadout",
				"modes": clean_modes.duplicate(true),
			},
			"balance": combined.get("balance", {}).duplicate(true),
			"source_resistance": combined.get("source_resistance", {}).duplicate(true)
		}

	return combined


func _merge_reality_fusion_balance_into(target_contract: Dictionary, source_contract: Dictionary) -> void:
	if not target_contract.has("balance") or typeof(target_contract ["balance"]) != TYPE_DICTIONARY:
		target_contract ["balance"] = {}
	var target_balance: Dictionary = target_contract ["balance"]
	var source_balance: Dictionary = _reality_fusion_safe_dictionary(source_contract.get("balance", {}))
	target_balance ["fatigue_cost"] = float(target_balance.get("fatigue_cost", 0.0)) + float(source_balance.get("fatigue_cost", 0.0))
	target_balance ["mental_strain"] = float(target_balance.get("mental_strain", 0.0)) + float(source_balance.get("mental_strain", 0.0))
	target_balance ["identity_instability"] = float(target_balance.get("identity_instability", 0.0)) + float(source_balance.get("identity_instability", 0.0))
	target_balance ["mutation_risk"] = max(float(target_balance.get("mutation_risk", 0.0)), float(source_balance.get("mutation_risk", 0.0)))
	target_balance ["cooldown_ms"] = max(int(target_balance.get("cooldown_ms", 0)), int(source_balance.get("cooldown_ms", 0)))


func _run_reality_fusion_loadout(path: String, mode: String, contract: Dictionary) -> Dictionary:
	var started_at: int = int(Time.get_ticks_msec())
	var contracts: Array = _reality_fusion_safe_array(contract.get("loadout_contracts", []))
	var reports: Array = []
	var success: bool = true
	var failed_reason: String = ""
	var source_name: String = str(reality_fusion_pending_label).strip_edges()
	if source_name == "":
		source_name = "another universe"

	for raw_contract in contracts:
		if typeof(raw_contract) != TYPE_DICTIONARY:
			continue
		var sub_contract: Dictionary = raw_contract
		var sub_mode: String = str(sub_contract.get("mode", "fusion")).strip_edges().to_lower()
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "Executing %s...\n%s" % [
				MainSceneHelpers._reality_fusion_mode_title(sub_mode),
				_reality_fusion_risk_text(sub_contract, _reality_fusion_contract_modes(sub_contract))
			]
		var sub_report: Dictionary = gs.fuse_reality_from_save(path, sub_contract)
		reports.append(sub_report)
		if bool(sub_report.get("success", false)):
			var reported_name: String = str(sub_report.get("source_player_name", sub_report.get("imported_player_name", ""))).strip_edges()
			if reported_name != "":
				source_name = reported_name
		else:
			success = false
			failed_reason = str(sub_report.get("reason", "One fusion layer failed."))
			break

	var report: Dictionary = {
		"schema": "eralife.reality_fusion_loadout_report",
		"version": 1,
		"success": success,
		"mode": mode,
		"path": path,
		"source_player_name": source_name,
		"reports": reports,
		"contract": contract.duplicate(true),
		"started_at_ms": started_at,
		"finished_at_ms": int(Time.get_ticks_msec())
	}
	report ["duration_ms"] = int(report ["finished_at_ms"]) - started_at
	if not success:
		report ["reason"] = failed_reason
	return report
func _queue_reality_fusion_ally_allegiance_scenario(path: String, label: String, contract: Dictionary) -> void:
	var clean_path: String = str(path).strip_edges()
	if clean_path == "":
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "That universe has no save path."
		return

	if gs == null:
		_bootstrap_gs_for_save_load_if_needed()

	if gs == null or gs.scenario_engine == null:
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "ScenarioEngine is unavailable for ally allegiance."
		return

	if gs.scenario_engine.has_pending_choice():
		if reality_fusion_hub_status_label != null:
			reality_fusion_hub_status_label.text = "Resolve the current scenario before asking another universe for allegiance."
		return

	var preview: Dictionary = {}
	if gs.has_method("preview_reality_fusion_from_save"):
		preview = gs.preview_reality_fusion_from_save(clean_path, contract)

	var source_player: Dictionary = {}
	if typeof(preview.get("source_player", {})) == TYPE_DICTIONARY:
		source_player = preview.get("source_player", {}).duplicate(true)

	var source_name: String = str(source_player.get("name", "another saved character")).strip_edges()
	if source_name == "":
		source_name = "another saved character"

	var source_identity: String = MainSceneHelpers._reality_fusion_source_identity_from_preview(source_player)
	var current_year_text: String = _format_year(gs.year) if gs != null else "this year"

	var prompt_text: String = "You traveled the multiverse to ask %s, %s, in %s for their allegiance in your timeline.\n\nThis is no longer an import. This is a conversation across reality." % [
		source_name,
		source_identity,
		current_year_text
	]

	var scenario: Dictionary = {
		"id": "reality_fusion_ally_allegiance_%d_%d" % [int(gs.year), int(Time.get_ticks_msec())],
		"source": "scenario_engine",
		"category": "social",
		"cooldown_key": "reality_fusion_ally_allegiance",
		"resolver_method": "_resolve_reality_fusion_ally_choice",
		"panel_title": "REALITY FUSION — ALLIANCE",
		"footer_text": "Allegiance must be asked for before it is stolen.",
		"prompt": prompt_text,
		"choices": [
			{
				"id": "reality_fusion_ally_ask",
				"label": "Ask for allegiance",
				"journal_text": "I traveled the multiverse and asked %s for allegiance." % source_name,
				"reality_fusion_path": clean_path,
				"reality_fusion_label": label,
				"reality_fusion_contract": contract.duplicate(true),
				"reality_fusion_source_player": source_player.duplicate(true)
			},
			{
				"id": "reality_fusion_ally_walk_away",
				"label": "Leave it alone",
				"journal_text": "I chose not to force allegiance from %s." % source_name,
				"result_text": "You step back from the portal and let their universe remain untouched.",
				"reality_fusion_path": clean_path,
				"reality_fusion_label": label,
				"reality_fusion_contract": contract.duplicate(true),
				"reality_fusion_source_player": source_player.duplicate(true)
			}
		]
	}

	_close_reality_fusion_hub()
	var result: Dictionary = gs.scenario_engine.queue_external_scenario(scenario)
	_refresh_scenario_ui_from_result(result)


func _start_reality_fusion_evolution_preview(loadout_surface: Control) -> void:
	if loadout_surface == null:
		return

	_refresh_reality_fusion_evolution_preview(loadout_surface, true)

	var timer_path_raw: Variant = loadout_surface.get_meta("fusion_evolution_timer_path", NodePath(""))
	if typeof(timer_path_raw) == TYPE_NODE_PATH:
		var timer_node:= get_node_or_null(timer_path_raw)
		if timer_node is Timer:
			(timer_node as Timer).start()


func _stop_reality_fusion_evolution_preview(loadout_surface: Control) -> void:
	if loadout_surface == null:
		return

	var timer_path_raw: Variant = loadout_surface.get_meta("fusion_evolution_timer_path", NodePath(""))
	if typeof(timer_path_raw) == TYPE_NODE_PATH:
		var timer_node:= get_node_or_null(timer_path_raw)
		if timer_node is Timer:
			(timer_node as Timer).stop()

	_refresh_reality_fusion_evolution_preview(loadout_surface, false)


func _stop_all_reality_fusion_evolution_previews() -> void:
	if reality_fusion_hub_list == null:
		return

	for child in reality_fusion_hub_list.get_children():
		if child is Control:
			_stop_reality_fusion_evolution_preview(child as Control)


func _refresh_reality_fusion_evolution_preview(loadout_surface: Control, animate: bool = false) -> void:
	if loadout_surface == null:
		return

	var contract: Dictionary = _reality_fusion_evolution_contract_from_surface(loadout_surface)
	var modes: Array = _reality_fusion_contract_modes(contract)

	var text_path_raw: Variant = loadout_surface.get_meta("fusion_evolution_text_path", NodePath(""))
	if typeof(text_path_raw) == TYPE_NODE_PATH:
		var text_node:= get_node_or_null(text_path_raw)
		if text_node is RichTextLabel:
			var rich:= text_node as RichTextLabel
			rich.clear()
			rich.append_text(_build_reality_fusion_evolution_text(contract, modes, animate))

	var bars_path_raw: Variant = loadout_surface.get_meta("fusion_evolution_bars_path", NodePath(""))
	if typeof(bars_path_raw) != TYPE_NODE_PATH:
		return

	var bars_node:= get_node_or_null(bars_path_raw)
	if not (bars_node is VBoxContainer):
		return

	var bars:= bars_node as VBoxContainer
	_clear_container_children(bars)

	if contract.is_empty() or modes.is_empty():
		return

	var profile: Dictionary = _reality_fusion_risk_profile_from_contract(contract)
	var instability: float = float(profile.get("identity_instability", 0.0))
	var mutation_risk: float = float(profile.get("mutation_risk", 0.0))
	var phase: float = float(Time.get_ticks_msec()) / 230.0
	var drift: float = clamp(instability * 1.8 + mutation_risk * 40.0, 2.0, 26.0)

	var index: int = 0
	for raw_stat in MainSceneHelpers._reality_fusion_stat_keys():
		var stat_name: String = str(raw_stat).strip_edges()
		if stat_name == "":
			continue

		var current_value: float = 50.0
		if gs != null and gs.player != null:
			var raw_value: Variant = gs.player.get(stat_name)
			if typeof(raw_value) == TYPE_INT or typeof(raw_value) == TYPE_FLOAT:
				current_value = float(raw_value)

		var wave: float = sin(phase + float(index) * 0.72)
		var morph_value: float = current_value
		if animate:
			morph_value = clamp(current_value + wave * drift, 0.0, 100.0)

		var row:= HBoxContainer.new()
		row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_theme_constant_override("separation", 6)
		bars.add_child(row)

		var stat_label:= Label.new()
		stat_label.text = stat_name.capitalize()
		stat_label.custom_minimum_size = Vector2(118, 0)
		row.add_child(stat_label)

		var bar:= ProgressBar.new()
		bar.min_value = 0
		bar.max_value = 100
		bar.value = morph_value
		bar.show_percentage = false
		bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		bar.custom_minimum_size = Vector2(0, 20)
		row.add_child(bar)

		var value_label:= Label.new()
		value_label.text = "%d → %d" % [int(round(current_value)), int(round(morph_value))]
		value_label.custom_minimum_size = Vector2(70, 0)
		row.add_child(value_label)

		index += 1


func _reality_fusion_evolution_contract_from_surface(loadout_surface: Control) -> Dictionary:
	if loadout_surface == null:
		return {}

	var raw_loadout: Variant = loadout_surface.get_meta("fusion_loadout", [])
	var loadout: Array = raw_loadout.duplicate(true) if typeof(raw_loadout) == TYPE_ARRAY else []
	if loadout.is_empty():
		return {}

	return _build_reality_fusion_loadout_contract(loadout)

func _build_reality_fusion_loadout_preview_text(contract: Dictionary, modes: Array, animate: bool = false) -> String:
	if modes.is_empty():
		return "Loadout Preview\nNo fusion layers selected yet.\nPick one or more layers above to preview what they may do before you execute."

	var clean_modes: Array = []
	for raw_mode in modes:
		var clean_mode: String = str(raw_mode).strip_edges().to_lower()
		if clean_mode != "" and clean_mode not in clean_modes:
			clean_modes.append(clean_mode)

	var profile: Dictionary = _reality_fusion_risk_profile_from_contract(contract)
	var score: float = float(profile.get("score", 0.0))
	var instability: float = float(profile.get("identity_instability", 0.0))
	var mutation_risk: float = float(profile.get("mutation_risk", 0.0))

	var risk_word: String = "LOW"
	if score >= 42.0:
		risk_word = "EXTREME"
	elif score >= 26.0:
		risk_word = "HIGH"
	elif score >= 14.0:
		risk_word = "MEDIUM"

	var pulse_text: String = ""
	if animate:
		var phase: int = MainSceneHelpers._reality_fusion_animation_bucket(140.0) % 4
		match phase:
			0:
				pulse_text = "\nWhite-gold pressure is forming around the execute gate."
			1:
				pulse_text = "\nYour identity is syncing with the selected layers."
			2:
				pulse_text = "\nThe save file is answering back."
			_:
				pulse_text = "\nReality is waiting for the final commit."

	var lines: Array = [
		"Loadout Preview",
		"Selected Layers: %s" % ", ".join(clean_modes),
		"Risk: %s | Instability: %.1f | Mutation Risk: %.1f%%" % [
			risk_word,
			instability,
			mutation_risk * 100.0
		],
		"",
		"Potential Effects:"
	]

	for clean_mode in clean_modes:
		lines.append("• %s" % MainSceneHelpers._reality_fusion_loadout_effect_line(clean_mode))

	if pulse_text != "":
		lines.append(pulse_text)

	return "\n".join(lines)


func _build_reality_fusion_evolution_text(contract: Dictionary, modes: Array, animate: bool = false) -> String:
	if contract.is_empty() or modes.is_empty():
		return "Fusion Evolution UI dormant.\nChoose layers, then hover EXECUTE FUSION to watch your identity start bending."

	var profile: Dictionary = _reality_fusion_risk_profile_from_contract(contract)
	var score: float = float(profile.get("score", 0.0))
	var instability: float = float(profile.get("identity_instability", 0.0))
	var mutation_risk: float = float(profile.get("mutation_risk", 0.0))

	var player_name: String = "Your identity"
	if gs != null and gs.player != null:
		player_name = ("%s %s" % [gs.player.first_name, gs.player.last_name]).strip_edges()
		if player_name == "":
			player_name = "Your identity"

	var display_name: String = player_name
	if animate and score >= 14.0:
		display_name = _fusion_evolution_distort_name(player_name, score)

	var risk_word: String = "LOW"
	var body_line: String = "Your identity is bending, but it is still mostly yours."
	if score >= 42.0:
		risk_word = "EXTREME"
		body_line = "Your name is destabilizing. Traits are flickering like loose files in reality."
	elif score >= 26.0:
		risk_word = "HIGH"
		body_line = "Your memories are syncing with another life. Some pieces may not feel borrowed anymore."
	elif score >= 14.0:
		risk_word = "MEDIUM"
		body_line = "Your stats are shifting at the edge of recognition."

	var flicker_suffix: String = ""
	if animate:
		var phase: int = MainSceneHelpers._reality_fusion_animation_bucket(160.0) % 4
		match phase:
			0:
				flicker_suffix = "traits stabilizing..."
			1:
				flicker_suffix = "identity pressure rising..."
			2:
				flicker_suffix = "memory edges flickering..."
			_:
				flicker_suffix = "selfhood recalculating..."

	return "%s\nRisk: %s | Identity %.1f | Mutation %.0f%%\n%s\n%s\nLayers: %s" % [
		display_name,
		risk_word,
		instability,
		mutation_risk * 100.0,
		body_line,
		flicker_suffix,
		", ".join(MainSceneLogic._reality_fusion_mode_titles(modes))
	]


func _fusion_evolution_distort_name(name_text: String, score: float) -> String:
	var glyphs: Array = ["̴", "̷", "̶", "̸", "͡"]
	var out: String = ""
	var intensity: int = clamp(int(score / 12.0), 1, 5)
	var tick_bucket: int = MainSceneHelpers._reality_fusion_animation_bucket(120.0)
	var distortion_gap: int = max(1, 6 - intensity)

	for i in range(name_text.length()):
		var ch: String = name_text.substr(i, 1)
		out += ch
		if ch != " " and ((i + tick_bucket) % distortion_gap) == 0:
			out += str(glyphs [(i + intensity) % glyphs.size()])

	return out

func _reality_fusion_risk_text(contract: Dictionary, modes: Array) -> String:
	if contract.is_empty() or modes.is_empty():
		return "🌌 Loadout empty. Choose layers to preview identity risk."

	var profile: Dictionary = _reality_fusion_risk_profile_from_contract(contract)
	var score: float = float(profile.get("score", 0.0))
	var level: String = "LOW"
	var warning: String = "Reality should remain mostly stable."
	if score >= 42.0:
		level = "EXTREME"
		warning = "⚠️ This fusion may corrupt your identity."
	elif score >= 26.0:
		level = "HIGH"
		warning = "⚠️ Identity drift is likely. Memories may not feel fully yours."
	elif score >= 14.0:
		level = "MEDIUM"
		warning = "Some instability may surface after the fusion."

	return "🌌 Risk Meter: %s | Fatigue %.1f | Mind %.1f | Identity %.1f | Mutation %.0f%%\n%s\nQueued: %s" % [
		level,
		float(profile.get("fatigue_cost", 0.0)),
		float(profile.get("mental_strain", 0.0)),
		float(profile.get("identity_instability", 0.0)),
		float(profile.get("mutation_risk", 0.0)) * 100.0,
		warning,
		", ".join(MainSceneLogic._reality_fusion_mode_titles(modes))
	]


func _reality_fusion_risk_profile_from_contract(contract: Dictionary) -> Dictionary:
	var fatigue_cost: float = 0.0
	var mental_strain: float = 0.0
	var identity_instability: float = 0.0
	var mutation_risk: float = 0.0
	var source_resistance: float = 0.0

	var loadout_contracts: Array = _reality_fusion_safe_array(contract.get("loadout_contracts", []))
	if not loadout_contracts.is_empty():
		for raw_contract in loadout_contracts:
			if typeof(raw_contract) != TYPE_DICTIONARY:
				continue
			var sub_profile: Dictionary = _reality_fusion_risk_profile_from_contract(raw_contract)
			fatigue_cost += float(sub_profile.get("fatigue_cost", 0.0))
			mental_strain += float(sub_profile.get("mental_strain", 0.0))
			identity_instability += float(sub_profile.get("identity_instability", 0.0))
			mutation_risk = max(mutation_risk, float(sub_profile.get("mutation_risk", 0.0)))
			source_resistance = max(source_resistance, float(sub_profile.get("source_resistance", 0.0)))
	else:
		var balance: Dictionary = _reality_fusion_safe_dictionary(contract.get("balance", {}))
		var transform: Dictionary = _reality_fusion_safe_dictionary(contract.get("transform", {}))
		var traits_transform: Dictionary = _reality_fusion_safe_dictionary(transform.get("traits", {}))
		var resistance: Dictionary = _reality_fusion_safe_dictionary(contract.get("source_resistance", {}))
		fatigue_cost = float(balance.get("fatigue_cost", 0.0))
		mental_strain = float(balance.get("mental_strain", 0.0))
		identity_instability = float(balance.get("identity_instability", 0.0))
		mutation_risk = max(float(balance.get("mutation_risk", 0.0)), float(traits_transform.get("mutation_chance", 0.0)))
		source_resistance = float(resistance.get("chance", 0.0)) if bool(resistance.get("enabled", false)) else 0.0

	var score: float = fatigue_cost + mental_strain + (identity_instability * 1.35) + (mutation_risk * 100.0) + (source_resistance * 35.0)
	return {
		"score": score,
		"fatigue_cost": fatigue_cost,
		"mental_strain": mental_strain,
		"identity_instability": identity_instability,
		"mutation_risk": mutation_risk,
		"source_resistance": source_resistance
	}


func _open_reality_fusion_family_picker(path: String, label: String) -> void:
	_ensure_reality_fusion_hub_popup()
	if reality_fusion_hub_list == null:
		return
	_clear_container_children(reality_fusion_hub_list)

	if reality_fusion_hub_status_label != null:
		reality_fusion_hub_status_label.text = "Choose one family member from:\n%s" % label

	var payload: Dictionary = MainSceneHelpers._read_reality_fusion_save_payload(path)
	var options: Array = _extract_reality_fusion_family_options(payload)
	if options.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "No family members were found in this saved universe."
		empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		reality_fusion_hub_list.add_child(empty_label)
	else:
		for raw_option in options:
			if typeof(raw_option) != TYPE_DICTIONARY:
				continue
			var option: Dictionary = raw_option
			var person_id: int = int(option.get("id", -1))
			var person_label: String = str(option.get("label", "Unknown family member"))
			var row:= HBoxContainer.new()
			row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			row.add_theme_constant_override("separation", 6)
			reality_fusion_hub_list.add_child(row)

			var button:= Button.new()
			button.text = "Bring %s" % person_label
			button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			button.custom_minimum_size = Vector2(180, 42)
			button.add_theme_stylebox_override("normal", MainSceneLogic._reality_fusion_mode_button_style("bring_family_member", false, false))
			button.add_theme_stylebox_override("hover", MainSceneLogic._reality_fusion_mode_button_style("bring_family_member", true, false))
			button.add_theme_stylebox_override("pressed", MainSceneLogic._reality_fusion_mode_button_style("bring_family_member", true, false))
			button.pressed.connect(_on_reality_fusion_family_member_selected.bind(path, person_label, person_id))
			row.add_child(button)

	var back_button:= Button.new()
	back_button.text = "Back to Universes"
	back_button.custom_minimum_size = Vector2(160, 42)
	back_button.pressed.connect(_refresh_reality_fusion_hub_list)
	reality_fusion_hub_list.add_child(back_button)


func _on_reality_fusion_family_member_selected(path: String, person_label: String, person_id: int) -> void:
	var contract: Dictionary = MainSceneLogic._build_reality_fusion_contract("bring_family_member")
	if not contract.has("merge_policy") or typeof(contract ["merge_policy"]) != TYPE_DICTIONARY:
		contract ["merge_policy"] = MainSceneHelpers._reality_fusion_merge_policy([], "bidirectional", person_id)
	contract ["merge_policy"] ["root_person_id"] = person_id
	contract ["ui"] ["selected_person_label"] = person_label
	_begin_reality_fusion_execution(path, person_label, "bring_family_member", contract)


func _extract_reality_fusion_family_options(payload: Dictionary) -> Array:
	var out: Array = []
	var npcs: Array = _reality_fusion_safe_array(payload.get("npcs", []))
	var player_id: int = int(payload.get("player_id", -1))
	if player_id <= 0:
		return out

	var npc_index: Dictionary = {}
	var source_player: Dictionary = {}

	for raw_npc in npcs:
		if typeof(raw_npc) != TYPE_DICTIONARY:
			continue
		var npc: Dictionary = raw_npc
		var npc_id: int = int(npc.get("id", -1))
		if npc_id <= 0:
			continue
		npc_index [npc_id] = npc
		if npc_id == player_id:
			source_player = npc

	if source_player.is_empty():
		return out

	var family_ids: Array = _reality_fusion_family_graph_ids_for_source(source_player, npc_index)
	var seen: Dictionary = {}

	for raw_id in family_ids:
		var npc_id: int = int(raw_id)
		if npc_id <= 0 or npc_id == player_id:
			continue
		if seen.has(npc_id):
			continue
		if not npc_index.has(npc_id):
			continue

		var npc: Dictionary = npc_index.get(npc_id, {})
		if not MainSceneHelpers._reality_fusion_save_person_alive(npc):
			continue

		var relation: String = _reality_fusion_relationship_to_source_player(npc, source_player, npc_index)
		if relation == "":
			relation = "Extended Family"

		var display_name: String = _reality_fusion_person_name_from_dict(npc)
		seen [npc_id] = true
		out.append({
			"id": npc_id,
			"name": display_name,
			"relation": relation,
			"relationship_to_saved_player": relation,
			"source_player_id": player_id,
			"source_player_name": _reality_fusion_person_name_from_dict(source_player),
			"alive": true,
			"age": int(npc.get("age", 0)),
			"label": "%s — %s of %s" % [
				display_name,
				relation,
				_reality_fusion_person_name_from_dict(source_player)
			]
		})

	out.sort_custom(Callable(self, "_sort_reality_fusion_family_options"))
	return out
func _reality_fusion_family_graph_ids_for_source(source_player: Dictionary, npc_index: Dictionary) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	var source_id: int = int(source_player.get("id", -1))
	if source_id <= 0:
		return out

	var queue: Array = [source_id]
	var depth: Dictionary = {
		source_id: 0
	}

	while not queue.is_empty():
		var current_id: int = int(queue.pop_front())
		var current_depth: int = int(depth.get(current_id, 0))
		if current_depth >= 4:
			continue
		if not npc_index.has(current_id):
			continue

		var current: Dictionary = npc_index.get(current_id, {})
		for linked_id in _reality_fusion_family_neighbor_ids(current, npc_index):
			var clean_id: int = int(linked_id)
			if clean_id <= 0:
				continue
			if clean_id == source_id:
				continue
			if not npc_index.has(clean_id):
				continue
			if not MainSceneHelpers._reality_fusion_save_person_alive(npc_index.get(clean_id, {})):
				continue
			if not seen.has(clean_id):
				seen [clean_id] = true
				out.append(clean_id)
			if not depth.has(clean_id):
				depth [clean_id] = current_depth + 1
				queue.append(clean_id)

	return out


func _reality_fusion_family_neighbor_ids(person: Dictionary, npc_index: Dictionary) -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	var person_id: int = int(person.get("id", -1))

	for pid in _reality_fusion_safe_array(person.get("parents", [])):
		MainSceneHelpers._reality_fusion_append_family_id(out, seen, int(pid))

	for cid in _reality_fusion_safe_array(person.get("children", [])):
		MainSceneHelpers._reality_fusion_append_family_id(out, seen, int(cid))

	var partner_id: int = int(person.get("partner_id", -1))
	MainSceneHelpers._reality_fusion_append_family_id(out, seen, partner_id)

	for ex_id in _reality_fusion_safe_array(person.get("ex_partners", [])):
		MainSceneHelpers._reality_fusion_append_family_id(out, seen, int(ex_id))

	for raw_npc_id in npc_index.keys():
		var npc_id: int = int(raw_npc_id)
		if npc_id <= 0 or npc_id == person_id:
			continue

		var npc: Dictionary = npc_index.get(npc_id, {})
		if not MainSceneHelpers._reality_fusion_save_person_alive(npc):
			continue

		if person_id in _reality_fusion_safe_array(npc.get("parents", [])):
			MainSceneHelpers._reality_fusion_append_family_id(out, seen, npc_id)

		if int(npc.get("partner_id", -1)) == person_id:
			MainSceneHelpers._reality_fusion_append_family_id(out, seen, npc_id)

		for pid in _reality_fusion_safe_array(person.get("parents", [])):
			if int(pid) > 0 and int(pid) in _reality_fusion_safe_array(npc.get("parents", [])):
				MainSceneHelpers._reality_fusion_append_family_id(out, seen, npc_id)

	return out


func _reality_fusion_relationship_to_source_player(npc: Dictionary, source_player: Dictionary, npc_index: Dictionary) -> String:
	var npc_id: int = int(npc.get("id", -1))
	var source_id: int = int(source_player.get("id", -1))
	if npc_id <= 0 or source_id <= 0 or npc_id == source_id:
		return ""

	var source_parents: Array = _reality_fusion_safe_array(source_player.get("parents", []))
	var source_children: Array = _reality_fusion_safe_array(source_player.get("children", []))
	var npc_parents: Array = _reality_fusion_safe_array(npc.get("parents", []))
	var npc_children: Array = _reality_fusion_safe_array(npc.get("children", []))

	if npc_id in source_parents:
		return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Father", "Mother", "Parent")

	if npc_id in source_children:
		return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Son", "Daughter", "Child")

	if int(source_player.get("partner_id", -1)) == npc_id:
		return "Partner"

	if npc_id in _reality_fusion_safe_array(source_player.get("ex_partners", [])):
		return "Ex Partner"

	for pid in source_parents:
		if int(pid) > 0 and int(pid) in npc_parents:
			return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Brother", "Sister", "Sibling")

	for parent_id in source_parents:
		var parent: Dictionary = npc_index.get(int(parent_id), {})
		if npc_id in _reality_fusion_safe_array(parent.get("parents", [])):
			return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Grandfather", "Grandmother", "Grandparent")

	for child_id in source_children:
		var child: Dictionary = npc_index.get(int(child_id), {})
		if npc_id in _reality_fusion_safe_array(child.get("children", [])):
			return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Grandson", "Granddaughter", "Grandchild")

	for parent_id in source_parents:
		var parent_dict: Dictionary = npc_index.get(int(parent_id), {})
		var parent_parents: Array = _reality_fusion_safe_array(parent_dict.get("parents", []))
		for grandparent_id in parent_parents:
			var grandparent: Dictionary = npc_index.get(int(grandparent_id), {})
			if npc_id in _reality_fusion_safe_array(grandparent.get("parents", [])):
				return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Great-Grandfather", "Great-Grandmother", "Great-Grandparent")

	for parent_id in source_parents:
		var parent_dict_for_siblings: Dictionary = npc_index.get(int(parent_id), {})
		var grandparent_ids: Array = _reality_fusion_safe_array(parent_dict_for_siblings.get("parents", []))
		for possible_aunt_uncle_raw in npc_index.keys():
			var possible_aunt_uncle_id: int = int(possible_aunt_uncle_raw)
			if possible_aunt_uncle_id <= 0 or possible_aunt_uncle_id == int(parent_id):
				continue
			var possible_aunt_uncle: Dictionary = npc_index.get(possible_aunt_uncle_id, {})
			for grandparent_id in grandparent_ids:
				if int(grandparent_id) > 0 and int(grandparent_id) in _reality_fusion_safe_array(possible_aunt_uncle.get("parents", [])):
					if possible_aunt_uncle_id == npc_id:
						return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Uncle", "Aunt", "Aunt/Uncle")
					if npc_id in _reality_fusion_safe_array(possible_aunt_uncle.get("children", [])):
						return "Cousin"

	for sibling_raw in npc_index.keys():
		var sibling_id: int = int(sibling_raw)
		if sibling_id <= 0 or sibling_id == source_id:
			continue
		var sibling: Dictionary = npc_index.get(sibling_id, {})
		var is_sibling: bool = false
		for pid in source_parents:
			if int(pid) > 0 and int(pid) in _reality_fusion_safe_array(sibling.get("parents", [])):
				is_sibling = true
				break
		if is_sibling and npc_id in _reality_fusion_safe_array(sibling.get("children", [])):
			return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Nephew", "Niece", "Niece/Nephew")

	if source_id in npc_children:
		return MainSceneHelpers._reality_fusion_gendered_family_label(npc, "Father", "Mother", "Parent")

	if not npc_parents.is_empty() or not npc_children.is_empty():
		return "Extended Family"

	return ""


func _sort_reality_fusion_family_options(a: Dictionary, b: Dictionary) -> bool:
	var priority: Dictionary = {
		"Partner": 5,
		"Father": 10,
		"Mother": 10,
		"Parent": 10,
		"Son": 20,
		"Daughter": 20,
		"Child": 20,
		"Brother": 30,
		"Sister": 30,
		"Sibling": 30,
		"Grandfather": 40,
		"Grandmother": 40,
		"Grandparent": 40,
		"Grandson": 45,
		"Granddaughter": 45,
		"Grandchild": 45,
		"Uncle": 50,
		"Aunt": 50,
		"Aunt/Uncle": 50,
		"Nephew": 55,
		"Niece": 55,
		"Niece/Nephew": 55,
		"Cousin": 60,
		"Ex Partner": 70,
		"Extended Family": 90
	}

	var relation_a: String = str(a.get("relation", "Extended Family"))
	var relation_b: String = str(b.get("relation", "Extended Family"))
	var priority_a: int = int(priority.get(relation_a, 100))
	var priority_b: int = int(priority.get(relation_b, 100))

	if priority_a != priority_b:
		return priority_a < priority_b

	return str(a.get("name", "")) < str(b.get("name", ""))

func _reality_fusion_contract_modes(contract: Dictionary) -> Array:
	var ui: Dictionary = _reality_fusion_safe_dictionary(contract.get("ui", {}))
	var modes: Array = _reality_fusion_safe_array(ui.get("modes", []))
	if not modes.is_empty():
		return modes
	var mode: String = str(contract.get("mode", "")).strip_edges().to_lower()
	return [mode] if mode != "" else []


func _reality_fusion_person_name_from_dict(data: Dictionary) -> String:
	var full_name: String = str(data.get("name", "")).strip_edges()
	if full_name != "":
		return full_name
	return ("%s %s" % [
		str(data.get("first_name", "")),
		str(data.get("last_name", ""))
	]).strip_edges()


func _reality_fusion_safe_array(value: Variant) -> Array:
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(true)
	return []


func _reality_fusion_safe_dictionary(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	return {}
