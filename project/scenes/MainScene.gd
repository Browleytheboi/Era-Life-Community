func _apply_player_stats_scrollbar_visual_state() -> void:
	if player_stats_scroll == null:
		return

	var empty_style:= StyleBoxEmpty.new()

	var v_scroll:= player_stats_scroll.get_v_scroll_bar()
	if v_scroll != null:
		v_scroll.visible = false
		v_scroll.modulate = Color(1.0, 1.0, 1.0, 0.0)
		v_scroll.self_modulate = Color(1.0, 1.0, 1.0, 0.0)
		v_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v_scroll.focus_mode = Control.FOCUS_NONE
		v_scroll.custom_minimum_size = Vector2.ZERO
		v_scroll.add_theme_stylebox_override("scroll", empty_style)
		v_scroll.add_theme_stylebox_override("scroll_focus", empty_style)
		v_scroll.add_theme_stylebox_override("grabber", empty_style)
		v_scroll.add_theme_stylebox_override("grabber_highlight", empty_style)
		v_scroll.add_theme_stylebox_override("grabber_pressed", empty_style)

	var h_scroll:= player_stats_scroll.get_h_scroll_bar()
	if h_scroll != null:
		h_scroll.visible = false
		h_scroll.modulate = Color(1.0, 1.0, 1.0, 0.0)
		h_scroll.self_modulate = Color(1.0, 1.0, 1.0, 0.0)
		h_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h_scroll.focus_mode = Control.FOCUS_NONE
		h_scroll.custom_minimum_size = Vector2.ZERO
		h_scroll.add_theme_stylebox_override("scroll", empty_style)
		h_scroll.add_theme_stylebox_override("scroll_focus", empty_style)
		h_scroll.add_theme_stylebox_override("grabber", empty_style)
		h_scroll.add_theme_stylebox_override("grabber_highlight", empty_style)
		h_scroll.add_theme_stylebox_override("grabber_pressed", empty_style)
func _build_player_stats_overlay_style(
	is_hovered: bool,
	pulse_strength: float = 0.0,
	danger_state: bool = false
) -> StyleBoxFlat:
	var style: StyleBoxFlat = (
		_build_era_surface_panel_style(
			"player_stats",
			is_hovered,
			pulse_strength,
			danger_state
		)
	)

	if _current_era_ui_theme_key() != "industrial":
		return style

	var pulse: float = clampf(
		pulse_strength,
		0.0,
		1.0
	)
	var base_background: Color = (
		Color(0.2, 0.18, 0.15, 0.99)
		if is_hovered
		else Color(0.16, 0.15, 0.14, 0.97)
	)
	var base_border: Color = (
		Color(0.98, 0.82, 0.5, 0.44)
		if is_hovered
		else Color(0.88, 0.7, 0.38, 0.3)
	)
	var base_glow: Color = (
		Color(1.0, 0.88, 0.58, 0.2)
		if is_hovered
		else Color(0.94, 0.78, 0.42, 0.12)
	)

	style.bg_color = base_background.lightened(
		pulse * 0.025
	)
	style.border_color = base_border.lightened(
		pulse * 0.035
	)
	style.shadow_color = Color(
		base_glow.r,
		base_glow.g,
		base_glow.b,
		clampf(
			base_glow.a + pulse * 0.05,
			0.0,
			0.3
		)
	)
	style.shadow_size = (
		18
		if is_hovered
		else 12
	)

	if danger_state:
		style.border_color = style.border_color.lerp(
			Color(1.0, 0.3, 0.24, 0.72),
			0.58
		)
		style.shadow_color = Color(
			1.0,
			0.22,
			0.18,
			0.24
		)

	return style
func _god_mode_ui_locked() -> bool:



	if bool(get_meta("god_mode_panel_non_runtime", false)):
		return false

	if bool(get_meta("god_mode_panel_contract_emitted", false)):
		return false

	if bool(get_meta("god_mode_panel_terminated_after_contract_emit", false)):
		return false

	if bool(get_meta("god_mode_visible_surface_claimed_before_capsule_consume", false)):
		return false

	if bool(get_meta("god_mode_playable_ui_atomic_commit_complete", false)):
		return false

	if bool(get_meta("playable_life_surface_authority_lock_active", false)):
		return false

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		if bool(gs.scenario_state.get("god_mode_panel_non_runtime", false)):
			return false
		if bool(gs.scenario_state.get("god_mode_panel_contract_emitted", false)):
			return false
		if bool(gs.scenario_state.get("god_mode_panel_terminated_after_contract_emit", false)):
			return false
		if bool(gs.scenario_state.get("god_mode_life_front_buffer_claimed", false)):
			return false
		if bool(gs.scenario_state.get("god_mode_playable_ui_atomic_commit_complete", false)):
			return false
		if bool(gs.scenario_state.get("playable_life_surface_has_visual_authority", false)):
			return false

	if _god_mode_runtime_severed():
		return false

	if not _god_mode_runtime_allowed("_god_mode_ui_locked", "ui_lock_check"):
		return false

	return god_mode_start_panel != null \
and is_instance_valid(god_mode_start_panel) \
and god_mode_start_panel.visible
func _apply_player_stats_overlay_visual_state(
	is_hovered: bool
) -> void:
	if player_stats_overlay == null:
		return

	var theme_key: String = (
		_current_era_ui_theme_key()
	)
	var pulse_strength: float = (
		(
			sin(
				player_stats_breathe_time * 1.25
			) + 1.0
		) * 0.5
	)
	var foreign_pressure: float = (
		MainSceneLogic._reality_fusion_foreign_timeline_pressure(gs)
	)
	var danger_state: bool = (
		player_stats_health_target > 0.0
		and player_stats_health_target < 30.0
	)
	var timeline_glitch_active: bool = (
		foreign_pressure > 0.0
		and randf() < clampf(
			0.035 + foreign_pressure * 0.045,
			0.035,
			0.22
		)
	)

	if timeline_glitch_active:
		pulse_strength = clampf(
			pulse_strength + randf() * 0.55,
			0.0,
			1.0
		)

	var pulse_bucket: int = int(
		round(
			clampf(
				pulse_strength,
				0.0,
				1.0
			) * 6.0
		)
	)
	var glitch_bucket: int = 0

	if foreign_pressure > 0.0:
		glitch_bucket = int(
			round(
				clampf(
					foreign_pressure,
					0.0,
					4.0
				) * 10.0
			)
		)

	var visual_signature: String = (
		"%s|%s|%s|%d|%d|%s"
		% [
			theme_key,
			str(is_hovered),
			str(danger_state),
			pulse_bucket,
			glitch_bucket,
			str(timeline_glitch_active)
		]
	)

	if str(
		player_stats_overlay.get_meta(
			"player_stats_overlay_visual_signature",
			""
		)
	) != visual_signature:
		player_stats_overlay.set_meta(
			"player_stats_overlay_visual_signature",
			visual_signature
		)
		player_stats_overlay.add_theme_stylebox_override(
			"panel",
			_build_player_stats_overlay_style(
				is_hovered,
				pulse_strength,
				danger_state
				or timeline_glitch_active
			)
		)

	if player_stats_root != null:
		var target_position: Vector2 = (
			Vector2(0, -2)
			if is_hovered
			else Vector2(0, -1)
		)

		if foreign_pressure > 0.0:
			var jitter_x: float = 0.0
			var jitter_y: float = 0.0

			if timeline_glitch_active:
				jitter_x = (
					randf_range(-2.0, 2.0)
					* foreign_pressure
				)
				jitter_y = (
					randf_range(-1.0, 1.0)
					* foreign_pressure
				)

			target_position += Vector2(
				jitter_x,
				jitter_y
			)

		if player_stats_root.position != target_position:
			player_stats_root.position = target_position
func _apply_player_stat_bar_fill_lens(
	bar: ProgressBar,
	title: String,
	_base_color: Color,
	fill_color: Color,
	glow_color: Color,
	pulse_strength: float,
	is_hovered: bool,
	danger_state: bool
) -> void:
	if bar == null or not is_instance_valid(bar):
		return

	var safe_max: float = maxf(
		1.0,
		float(bar.max_value)
	)
	var ratio: float = clampf(
		float(bar.value) / safe_max,
		0.0,
		1.0
	)
	var high_stat: bool = ratio >= 0.72
	var high_stat_power: float = (
		clampf(
			(ratio - 0.72) / 0.28,
			0.0,
			1.0
		)
		if high_stat
		else 0.0
	)
	var ambient_pulse: float = clampf(
		pulse_strength * 0.42,
		0.0,
		0.08
	)
	var active_pulse: float = clampf(
		ambient_pulse
		+ pulse_strength * high_stat_power * 0.68,
		0.0,
		0.18
	)
	var danger_pulse: float = (
		clampf(
			pulse_strength,
			0.0,
			0.18
		)
		if danger_state
		else 0.0
	)
	var final_fill: Color = fill_color.lerp(
		Color.WHITE,
		0.16
	)

	if is_hovered:
		final_fill = final_fill.lerp(
			Color.WHITE,
			0.04
		)

	if high_stat:
		final_fill = final_fill.lerp(
			glow_color,
			0.08 + active_pulse * 0.12
		)

	if danger_state and title == "Health":
		final_fill = final_fill.lerp(
			Color(
				1.0,
				0.26,
				0.3,
				1.0
			),
			0.28 + danger_pulse * 0.18
		)

	var native_fill: StyleBoxFlat = (
		MainSceneHelpers._get_or_create_player_stat_row_stylebox(
			bar,
			"player_stat_native_fill_fallback_stylebox"
		)
	)

	native_fill.bg_color = Color(
		final_fill.r,
		final_fill.g,
		final_fill.b,
		clampf(
			0.88
			+ active_pulse * 0.42
			+ danger_pulse * 0.24,
			0.0,
			1.0
		)
	)
	native_fill.border_width_left = 0
	native_fill.border_width_top = 0
	native_fill.border_width_right = 0
	native_fill.border_width_bottom = 0
	native_fill.border_color = Color(
		1.0,
		1.0,
		1.0,
		0.0
	)
	native_fill.corner_radius_top_left = 10
	native_fill.corner_radius_top_right = 10
	native_fill.corner_radius_bottom_left = 10
	native_fill.corner_radius_bottom_right = 10
	native_fill.content_margin_left = 0
	native_fill.content_margin_right = 0
	native_fill.content_margin_top = 0
	native_fill.content_margin_bottom = 0
	native_fill.shadow_color = Color(
		glow_color.r,
		glow_color.g,
		glow_color.b,
		clampf(
			0.03
			+ active_pulse * 0.4
			+ danger_pulse * 0.28,
			0.0,
			0.3
		)
	)
	native_fill.shadow_size = (
		2
		+ int(round(active_pulse * 6.0))
		+ int(round(danger_pulse * 4.0))
	)
	native_fill.shadow_offset = Vector2.ZERO
	bar.add_theme_stylebox_override(
		"fill",
		native_fill
	)
	bar.clip_contents = true
	bar.set_meta(
		"stat_bar_native_progress_fill_fallback_active",
		true
	)
	bar.set_meta(
		"stat_bar_native_progress_fill_ratio",
		ratio
	)
	bar.set_meta(
		"stat_bar_fill_cannot_depend_on_resolved_child_geometry",
		true
	)

	var fill_lens:= MainSceneHelpers._ensure_player_stat_bar_fill_lens(
		bar
	)

	if fill_lens == null or not is_instance_valid(fill_lens):
		bar.queue_redraw()
		return

	fill_lens.visible = ratio > 0.001
	fill_lens.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fill_lens.z_as_relative = true
	fill_lens.z_index = 1
	fill_lens.anchor_left = 0.0
	fill_lens.anchor_top = 0.0
	fill_lens.anchor_right = ratio
	fill_lens.anchor_bottom = 1.0
	fill_lens.offset_left = 0.0
	fill_lens.offset_top = 0.0
	fill_lens.offset_right = 0.0
	fill_lens.offset_bottom = 0.0
	fill_lens.modulate = Color(
		1.0,
		1.0,
		1.0,
		clampf(
			0.9 + active_pulse * 0.55,
			0.9,
			1.0
		)
	)

	var style:= MainSceneHelpers._player_stat_fill_lens_style(
		fill_lens
	)

	if style == null:
		bar.queue_redraw()
		return

	style.bg_color = Color(
		final_fill.r,
		final_fill.g,
		final_fill.b,
		0.24
		+ active_pulse * 0.32
		+ danger_pulse * 0.18
	)
	style.border_width_left = 0
	style.border_width_top = 0
	style.border_width_right = 0
	style.border_width_bottom = 0
	style.border_color = Color(
		1.0,
		1.0,
		1.0,
		0.0
	)
	style.corner_radius_top_left = 10
	style.corner_radius_top_right = 10
	style.corner_radius_bottom_left = 10
	style.corner_radius_bottom_right = 10

	var glow_alpha: float = (
		0.08
		+ active_pulse * 0.42
		+ danger_pulse * 0.26
		+ (0.04 if is_hovered else 0.0)
	)

	style.shadow_color = Color(
		glow_color.r,
		glow_color.g,
		glow_color.b,
		clampf(
			glow_alpha,
			0.0,
			0.36
		)
	)
	style.shadow_size = (
		4
		+ int(round(active_pulse * 9.0))
		+ int(round(danger_pulse * 6.0))
	)
	style.shadow_offset = Vector2.ZERO
	fill_lens.add_theme_stylebox_override(
		"panel",
		style
	)
	fill_lens.set_meta(
		"stat_fill_ratio",
		ratio
	)
	fill_lens.set_meta(
		"stat_fill_percent",
		int(round(ratio * 100.0))
	)
	fill_lens.set_meta(
		"stat_fill_glow_active",
		true
	)
	fill_lens.set_meta(
		"stat_fill_ambient_animation_active",
		true
	)
	fill_lens.set_meta(
		"stat_fill_high_stat_power",
		high_stat_power
	)
	fill_lens.set_meta(
		"stat_fill_no_white_flash",
		true
	)
	fill_lens.set_meta(
		"stat_fill_no_square_border",
		true
	)
	fill_lens.set_meta(
		"stat_fill_layout_self_healing",
		true
	)
	fill_lens.set_meta(
		"stat_fill_is_secondary_glow_lens",
		true
	)
	fill_lens.queue_redraw()
	bar.queue_redraw()
func _on_player_stats_overlay_mouse_entered() -> void:
	player_stats_overlay_hovered = true
	_apply_player_stats_overlay_visual_state(true)


func _on_player_stats_overlay_mouse_exited() -> void:
	player_stats_overlay_hovered = false
	_apply_player_stats_overlay_visual_state(false)
func _apply_player_stat_row_visual_state(
		label: Label,
		bar: ProgressBar,
		title: String,
		is_hovered: bool,
		danger_state: bool = false,
		pulse_strength: float = 0.0
) -> void:
	if (
		label == null
		or bar == null
	):
		return

	if (
		not is_instance_valid(
			label
		)
		or not is_instance_valid(
			bar
		)
	):
		return

	var theme_key: String = (
		_current_era_ui_theme_key()
	)
	var palette: Dictionary = (
		_resolve_player_stat_palette(
			title
		)
	)
	var label_color: Color = Color(
		palette.get(
			"core",
			Color(
				0.45,
				0.67,
				1.0,
				1.0
			)
		)
	)
	var background_base: Color = Color(
		1.0,
		1.0,
		1.0,
		0.1
	)
	var background_hover: Color = Color(
		1.0,
		1.0,
		1.0,
		0.16
	)
	var stat_fill: Color = Color(
		palette.get(
			"core",
			Color(
				0.45,
				0.67,
				1.0,
				0.98
			)
		)
	)
	var track_tint: Color = Color(
		palette.get(
			"soft",
			Color(
				0.18,
				0.18,
				0.22,
				0.98
			)
		)
	)
	var glow_tint: Color = Color(
		palette.get(
			"glow",
			Color(
				1.0,
				1.0,
				1.0,
				0.16
			)
		)
	)

	label_color.a = 1.0

	if bool(
		bar.get_meta(
			"bending_hub_surface",
			false
		)
	):
		var bending_element: String = str(
			bar.get_meta(
				"bending_element",
				""
			)
		).strip_edges().to_lower()
		var elemental_core: Color = (
			_bending_hud_element_color(
				bending_element
			)
		)

		label_color = elemental_core
		label_color.a = 1.0
		stat_fill = elemental_core
		track_tint = Color(
			elemental_core.r * 0.24,
			elemental_core.g * 0.24,
			elemental_core.b * 0.24,
			0.88
		)
		glow_tint = Color(
			elemental_core.r,
			elemental_core.g,
			elemental_core.b,
			0.22
		)

	match theme_key:
		"ancient":
			background_base = track_tint.lerp(
				Color(
					1.0,
					0.86,
					0.66,
					track_tint.a
				),
				0.18
			)
			background_hover = track_tint.lerp(
				Color(
					1.0,
					0.88,
					0.7,
					track_tint.a
				),
				0.26
			)

		"medieval":
			background_base = track_tint.lerp(
				Color(
					0.82,
					0.9,
					1.0,
					track_tint.a
				),
				0.14
			)
			background_hover = track_tint.lerp(
				Color(
					0.84,
					0.92,
					1.0,
					track_tint.a
				),
				0.22
			)

		"future":
			background_base = track_tint.lerp(
				Color(
					0.42,
					0.88,
					1.0,
					track_tint.a
				),
				0.18
			)
			background_hover = track_tint.lerp(
				Color(
					0.62,
					0.46,
					1.0,
					track_tint.a
				),
				0.24
			)

		_:
			background_base = Color(
				track_tint.r,
				track_tint.g,
				track_tint.b,
				0.26
			)
			background_hover = Color(
				track_tint.r,
				track_tint.g,
				track_tint.b,
				0.34
			)

	var row:= label.get_parent()
	var flavor_label:= (
		row.find_child(
			"FlavorLabel",
			true,
			false
		) as Label
		if row != null
		else null
	)
	var flavor_visible: bool = (
		flavor_label != null
		and flavor_label.visible
	)


	label.add_theme_color_override(
		"font_color",
		label_color
	)
	label.add_theme_color_override(
		"font_shadow_color",
		Color(
			0.0,
			0.0,
			0.0,
			0.38
		)
	)
	label.add_theme_constant_override(
		"shadow_offset_x",
		0
	)
	label.add_theme_constant_override(
		"shadow_offset_y",
		0
	)
	label.add_theme_constant_override(
		"shadow_outline_size",
		1
	)
	label.scale = Vector2.ONE * (
		1.0
		+ (
			0.01
			if is_hovered
			else 0.0
		)
	)
	label.set_meta(
		"player_stat_text_color_is_invariant",
		true
	)
	label.set_meta(
		"player_stat_text_white_flash_forbidden",
		true
	)

	if flavor_label != null:
		var flavor_color: Color = label_color
		flavor_color.a = (
			0.96
			if flavor_label.visible
			else 0.0
		)

		flavor_label.add_theme_color_override(
			"font_color",
			flavor_color
		)
		flavor_label.add_theme_color_override(
			"font_shadow_color",
			Color(
				0.0,
				0.0,
				0.0,
				0.38
			)
		)
		flavor_label.add_theme_constant_override(
			"shadow_offset_x",
			0
		)
		flavor_label.add_theme_constant_override(
			"shadow_offset_y",
			0
		)
		flavor_label.add_theme_constant_override(
			"shadow_outline_size",
			1
		)
		flavor_label.scale = Vector2.ONE * (
			1.0
			+ (
				0.01
				if is_hovered
				else 0.0
			)
		)
		flavor_label.set_meta(
			"player_stat_text_color_is_invariant",
			true
		)
		flavor_label.set_meta(
			"player_stat_text_white_flash_forbidden",
			true
		)

	var value_label:= bar.find_child(
		"ValueLabel",
		true,
		false
	) as Label

	if value_label != null:
		var value_color: Color = label_color
		value_color.a = 0.98

		value_label.add_theme_color_override(
			"font_color",
			value_color
		)
		value_label.add_theme_color_override(
			"font_shadow_color",
			Color(
				0.0,
				0.0,
				0.0,
				0.42
			)
		)
		value_label.add_theme_constant_override(
			"shadow_offset_x",
			0
		)
		value_label.add_theme_constant_override(
			"shadow_offset_y",
			0
		)
		value_label.add_theme_constant_override(
			"shadow_outline_size",
			2 + (
				1
				if is_hovered
				else 0
			)
		)
		value_label.scale = Vector2.ONE * (
			1.0
			+ (
				0.015
				if is_hovered
				else 0.0
			)
		)

	var stat_ratio: float = 0.0

	if float(
		bar.max_value
	) > 0.0:
		stat_ratio = clampf(
			float(
				bar.value
			) / float(
				bar.max_value
			),
			0.0,
			1.0
		)

	var ratio_bucket: int = int(
		round(
			stat_ratio * 100.0
		)
	)
	var visual_signature: String = (
		MainSceneHelpers._build_player_stat_row_visual_signature(
			theme_key,
			title,
			is_hovered,
			danger_state,
			pulse_strength,
			flavor_visible
		)
	)

	visual_signature += (
		"|ratio:%d|value:%d|max:%d"
		% [
			ratio_bucket,
			int(
				round(
					float(
						bar.value
					)
				)
			),
			int(
				round(
					float(
						bar.max_value
					)
				)
			)
		]
	)
	visual_signature += (
		"|stable_text_color:v2"
	)

	if bool(
		bar.get_meta(
			"bending_hub_surface",
			false
		)
	):
		visual_signature += (
			"|bending:%s:%s"
			% [
				str(
					bar.get_meta(
						"bending_element",
						""
					)
				),
				str(
					bar.get_meta(
						"bending_level",
						"0"
					)
				)
			]
		)

	if str(
		bar.get_meta(
			"player_stat_row_visual_signature",
			""
		)
	) == visual_signature:
		_apply_player_stat_bar_fill_lens(
			bar,
			title,
			background_base,
			stat_fill,
			glow_tint,
			pulse_strength,
			is_hovered,
			danger_state
		)
		return

	bar.set_meta(
		"player_stat_row_visual_signature",
		visual_signature
	)
	bar.set_meta(
		"player_stat_text_color_pulse_forbidden",
		true
	)
	bar.set_meta(
		"player_stat_text_color_hover_shift_forbidden",
		true
	)

	var background: StyleBoxFlat = (
		MainSceneHelpers._get_or_create_player_stat_row_stylebox(
			bar,
			"player_stat_row_background_stylebox"
		)
	)
	var track_visual_color: Color = (
		background_hover
		if is_hovered
		else background_base
	)

	background.bg_color = Color(
		track_visual_color.r * 0.72,
		track_visual_color.g * 0.72,
		track_visual_color.b * 0.72,
		0.52 if is_hovered else 0.42
	)
	background.border_width_left = 0
	background.border_width_top = 0
	background.border_width_right = 0
	background.border_width_bottom = 0
	background.border_color = Color(
		1.0,
		1.0,
		1.0,
		0.0
	)
	background.corner_radius_top_left = 12
	background.corner_radius_top_right = 12
	background.corner_radius_bottom_left = 12
	background.corner_radius_bottom_right = 12
	background.content_margin_left = 0
	background.content_margin_right = 0
	background.content_margin_top = 0
	background.content_margin_bottom = 0
	background.shadow_color = Color(
		0.0,
		0.0,
		0.0,
		0.42
	)
	background.shadow_size = 5
	background.shadow_offset = Vector2.ZERO

	bar.add_theme_stylebox_override(
		"background",
		background
	)
	bar.set_meta(
		"stat_bar_current_fill_ratio",
		stat_ratio
	)
	bar.set_meta(
		"stat_bar_current_fill_percent",
		ratio_bucket
	)
	bar.set_meta(
		"stat_bar_uses_actual_progressbar_fill",
		true
	)
	bar.set_meta(
		"stat_bar_uses_explicit_fill_lens",
		true
	)
	bar.set_meta(
		"stat_bar_native_fill_is_authoritative",
		true
	)
	bar.set_meta(
		"stat_bar_glow_lens_is_secondary",
		true
	)
	bar.set_meta(
		"stat_bar_two_color_lens_contract_active",
		true
	)


	_apply_player_stat_bar_fill_lens(
		bar,
		title,
		background_base,
		stat_fill,
		glow_tint,
		pulse_strength,
		is_hovered,
		danger_state
	)

func _on_player_stat_row_mouse_entered(title: String) -> void:
	player_stats_hovered_row_title = title


func _on_player_stat_row_mouse_exited(title: String) -> void:
	if player_stats_hovered_row_title == title:
		player_stats_hovered_row_title = ""
func _player_stats_currency_symbol_for_current_actor() -> String:
	if gs != null and gs.economy_engine != null and gs.economy_engine.has_method("format_money"):
		var sample: String = str(gs.economy_engine.format_money(1)).strip_edges()
		var symbol: String = ""

		for i in range(sample.length()):
			var ch: String = sample.substr(i, 1)
			if ch.is_valid_int():
				break
			if ch == "," or ch == "." or ch == " ":
				continue
			symbol += ch

		if symbol.strip_edges() != "":
			return symbol.strip_edges()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var symbol_from_state: String = str(gs.scenario_state.get("currency_symbol", "")).strip_edges()
		if symbol_from_state != "":
			return symbol_from_state

	return "$"
func _format_player_stats_bank_amount(amount: int) -> String:
	var safe_amount: int = max(0, int(amount))
	var bank_symbol: String = ""

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		if player_stats_overlay.has_meta("player_stats_bank_currency_symbol"):
			bank_symbol = str(player_stats_overlay.get_meta("player_stats_bank_currency_symbol", "")).strip_edges()

	if bank_symbol == "":
		bank_symbol = _player_stats_currency_symbol_for_current_actor()

	return "%s%s" % [
		bank_symbol,
		MainSceneHelpers._format_commas_for_player_stats_bank(safe_amount)
	]


func _apply_player_stats_bank_visual_state() -> void:
	if player_stats_bank_label == null:
		return

	var bank_pulse: float = (sin(player_stats_breathe_time * 2.1) + 1.0) * 0.5
	var bank_delta_ratio: float = 0.0
	if player_stats_bank_target > 0.0:
		bank_delta_ratio = clamp(
			absf(player_stats_bank_target - player_stats_bank_display_value) / max(player_stats_bank_target, 1.0),
			0.0,
			1.0
		)

	var pulse_bucket: int = int(round(clamp(bank_pulse, 0.0, 1.0) * 6.0))
	var delta_bucket: int = int(round(clamp(bank_delta_ratio, 0.0, 1.0) * 6.0))
	var signature: String = "%d|%d" % [pulse_bucket, delta_bucket]
	if str(player_stats_bank_label.get_meta("player_stats_bank_visual_signature", "")) == signature:
		return
	player_stats_bank_label.set_meta("player_stats_bank_visual_signature", signature)

	player_stats_bank_label.add_theme_color_override("font_color", Color(
		1.0,
		0.94 + (0.04 * bank_pulse),
		0.58 + (0.18 * bank_pulse),
		1.0
	))
	player_stats_bank_label.add_theme_color_override("font_shadow_color", Color(
		1.0,
		0.86,
		0.3,
		0.18 + (bank_pulse * 0.18) + (bank_delta_ratio * 0.22)
	))
	player_stats_bank_label.add_theme_constant_override("shadow_offset_x", 0)
	player_stats_bank_label.add_theme_constant_override("shadow_offset_y", 0)
	player_stats_bank_label.add_theme_constant_override(
		"shadow_outline_size",
		2 + int(round(bank_pulse * 2.0 + bank_delta_ratio * 2.0))
	)
	player_stats_bank_label.scale = Vector2.ONE * (1.0 + (bank_pulse * 0.012) + (bank_delta_ratio * 0.018))
func _safe_player_stat_power_pulse() -> float:


	var raw: float = (sin(player_stats_breathe_time * 0.55) + 1.0) * 0.5
	return clampf(raw * 0.18, 0.0, 0.18)
func _animate_player_stats_overlay(delta: float) -> void:
	_animate_pending_situations_button(
		delta
	)
	_animate_bending_hud(delta)
	_animate_wizard_hud(delta)
	_animate_belongings_hud(delta)
	_animate_food_lifestyle_hud(delta)
	if player_stats_overlay == null or not player_stats_overlay.visible:
		return

	player_stats_breathe_time += delta
	var speed_scale: float = delta * 180.0
	var approval_widgets: Dictionary = _get_player_stats_approval_widgets()
	var approval_row: Control = approval_widgets.get("row", null) as Control
	var approval_label: Label = approval_widgets.get("label", null) as Label
	var approval_bar: ProgressBar = approval_widgets.get("bar", null) as ProgressBar

	var player_surface_context: Dictionary = {}
	var approval_visible: bool = false
	if player_stats_overlay != null:
		var surface_context_raw: Variant = player_stats_overlay.get_meta("player_stats_surface_context", {})
		if typeof(surface_context_raw) == TYPE_DICTIONARY:
			player_surface_context = (surface_context_raw as Dictionary).duplicate(true)
		approval_visible = bool(player_stats_overlay.get_meta("player_stats_approval_visible", false))

	if player_stats_health_bar != null:
		player_stats_health_bar.value = move_toward(float(player_stats_health_bar.value), player_stats_health_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_health_label,
			player_stats_health_bar,
			"Health",
			int(round(player_stats_health_bar.value)),
			int(round(player_stats_health_bar.max_value)),
			player_surface_context
		)
	if player_stats_hunger_bar != null:
		player_stats_hunger_bar.value = move_toward(float(player_stats_hunger_bar.value), player_stats_hunger_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_hunger_label,
			player_stats_hunger_bar,
			"Hunger",
			int(round(player_stats_hunger_bar.value)),
			int(round(player_stats_hunger_bar.max_value)),
			player_surface_context
		)
	if player_stats_mental_bar != null:
		player_stats_mental_bar.value = move_toward(float(player_stats_mental_bar.value), player_stats_mental_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_mental_label,
			player_stats_mental_bar,
			"Mental",
			int(round(player_stats_mental_bar.value)),
			int(round(player_stats_mental_bar.max_value)),
			player_surface_context
		)

	if player_stats_willpower_bar != null:
		player_stats_willpower_bar.value = move_toward(float(player_stats_willpower_bar.value), player_stats_willpower_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_willpower_label,
			player_stats_willpower_bar,
			"Willpower",
			int(round(player_stats_willpower_bar.value)),
			int(round(player_stats_willpower_bar.max_value)),
			player_surface_context
		)

	if player_stats_happiness_bar != null:
		player_stats_happiness_bar.value = move_toward(float(player_stats_happiness_bar.value), player_stats_happiness_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_happiness_label,
			player_stats_happiness_bar,
			"Happiness",
			int(round(player_stats_happiness_bar.value)),
			int(round(player_stats_happiness_bar.max_value)),
			player_surface_context
		)

	if player_stats_smarts_bar != null:
		player_stats_smarts_bar.value = move_toward(float(player_stats_smarts_bar.value), player_stats_smarts_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_smarts_label,
			player_stats_smarts_bar,
			"Smarts",
			int(round(player_stats_smarts_bar.value)),
			int(round(player_stats_smarts_bar.max_value)),
			player_surface_context
		)

	if player_stats_looks_bar != null:
		player_stats_looks_bar.value = move_toward(float(player_stats_looks_bar.value), player_stats_looks_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_looks_label,
			player_stats_looks_bar,
			"Looks",
			int(round(player_stats_looks_bar.value)),
			int(round(player_stats_looks_bar.max_value)),
			player_surface_context
		)

	if player_stats_imagination_bar != null:
		player_stats_imagination_bar.value = move_toward(float(player_stats_imagination_bar.value), player_stats_imagination_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_imagination_label,
			player_stats_imagination_bar,
			"Imagination",
			int(round(player_stats_imagination_bar.value)),
			int(round(player_stats_imagination_bar.max_value)),
			player_surface_context
		)

	if player_stats_fame_bar != null and player_stats_fame_row != null and player_stats_fame_row.visible:
		player_stats_fame_bar.value = move_toward(float(player_stats_fame_bar.value), player_stats_fame_target, speed_scale)
		_apply_player_stat_surface_content(
			player_stats_fame_label,
			player_stats_fame_bar,
			"Fame",
			int(round(player_stats_fame_bar.value)),
			int(round(player_stats_fame_bar.max_value)),
			player_surface_context
		)

	if approval_row != null:
		approval_row.visible = approval_visible
	if approval_label != null:
		approval_label.visible = approval_visible
	if approval_bar != null:
		approval_bar.visible = approval_visible

	if approval_bar != null and approval_label != null and approval_visible and approval_row != null and approval_row.visible:
		var approval_target: float = clamp(float(approval_bar.get_meta("player_stats_approval_target", 0.0)), 0.0, 100.0)
		approval_bar.value = move_toward(float(approval_bar.value), approval_target, speed_scale)
		_apply_player_stat_surface_content(
			approval_label,
			approval_bar,
			"Approval",
			int(round(approval_bar.value)),
			int(round(approval_bar.max_value)),
			player_surface_context
		)
	elif approval_bar != null and not approval_visible:
		approval_bar.value = 0.0

	if player_stats_bank_label != null:
		if player_stats_bank_display_value < 0.0:
			player_stats_bank_display_value = player_stats_bank_target

		var bank_distance: float = absf(player_stats_bank_target - player_stats_bank_display_value)
		var bank_speed: float = max(2200.0, bank_distance * 8.5) * delta
		if bool(player_stats_overlay.get_meta("player_stats_bank_force_animate_delta", false)):
			bank_speed = max(bank_speed, max(2800.0, bank_distance * 5.75) * delta)

		player_stats_bank_display_value = move_toward(player_stats_bank_display_value, player_stats_bank_target, bank_speed)

		var bank_amount: int = max(0, int(round(player_stats_bank_display_value)))
		var bank_text: String = _format_player_stats_bank_amount(bank_amount)
		if player_stats_bank_label.text != bank_text:
			player_stats_bank_label.text = bank_text

		if bool(player_stats_overlay.get_meta("player_stats_bank_force_animate_delta", false)) and absf(player_stats_bank_display_value - player_stats_bank_target) <= 1.0:
			player_stats_bank_display_value = player_stats_bank_target
			player_stats_bank_label.text = _format_player_stats_bank_amount(int(round(player_stats_bank_target)))
			player_stats_overlay.set_meta("player_stats_bank_force_animate_delta", false)
			player_stats_overlay.remove_meta("player_stats_bank_delta_amount")
			player_stats_overlay.remove_meta("player_stats_bank_delta_previous")
			player_stats_overlay.remove_meta("player_stats_bank_delta_target")
			player_stats_overlay.remove_meta("player_stats_bank_delta_started_at_ms")
			player_stats_overlay.remove_meta("player_stats_bank_delta_context")

		_apply_player_stats_bank_visual_state()

	var pulse_strength: float = _safe_player_stat_power_pulse()
	var health_danger: bool = player_stats_health_target > 0.0 and player_stats_health_target < 30.0
	_apply_player_stats_overlay_visual_state(player_stats_overlay_hovered)
	_apply_player_stat_row_visual_state(player_stats_health_label, player_stats_health_bar, "Health", player_stats_hovered_row_title == "Health", health_danger, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_hunger_label, player_stats_hunger_bar, "Hunger", player_stats_hovered_row_title == "Hunger", player_stats_hunger_target >= 72.0, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_mental_label, player_stats_mental_bar, "Mental", player_stats_hovered_row_title == "Mental", false, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_willpower_label, player_stats_willpower_bar, "Willpower", player_stats_hovered_row_title == "Willpower", false, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_happiness_label, player_stats_happiness_bar, "Happiness", player_stats_hovered_row_title == "Happiness", false, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_smarts_label, player_stats_smarts_bar, "Smarts", player_stats_hovered_row_title == "Smarts", false, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_looks_label, player_stats_looks_bar, "Looks", player_stats_hovered_row_title == "Looks", false, pulse_strength)
	_apply_player_stat_row_visual_state(player_stats_imagination_label, player_stats_imagination_bar, "Imagination", player_stats_hovered_row_title == "Imagination", false, pulse_strength)

	if player_stats_fame_row != null and player_stats_fame_row.visible:
		_apply_player_stat_row_visual_state(player_stats_fame_label, player_stats_fame_bar, "Fame", player_stats_hovered_row_title == "Fame", false, pulse_strength)

	if approval_visible and approval_row != null and approval_row.visible and approval_label != null and approval_bar != null:
		_apply_player_stat_row_visual_state(approval_label, approval_bar, "Approval", player_stats_hovered_row_title == "Approval", false, pulse_strength)

	if bool(get_meta("player_stats_spawn_cinematic_pending", false)):
		var spawn_fill_complete: bool = true
		if player_stats_health_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_health_bar.value) - player_stats_health_target) <= 0.5
		if player_stats_mental_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_mental_bar.value) - player_stats_mental_target) <= 0.5
		if player_stats_willpower_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_willpower_bar.value) - player_stats_willpower_target) <= 0.5
		if player_stats_happiness_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_happiness_bar.value) - player_stats_happiness_target) <= 0.5
		if player_stats_smarts_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_smarts_bar.value) - player_stats_smarts_target) <= 0.5
		if player_stats_looks_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_looks_bar.value) - player_stats_looks_target) <= 0.5
		if player_stats_imagination_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_imagination_bar.value) - player_stats_imagination_target) <= 0.5
		if player_stats_fame_bar != null:
			spawn_fill_complete = spawn_fill_complete and absf(float(player_stats_fame_bar.value) - player_stats_fame_target) <= 0.5

		spawn_fill_complete = spawn_fill_complete and absf(player_stats_bank_display_value - player_stats_bank_target) <= 1.0

		if spawn_fill_complete:
			set_meta("player_stats_spawn_cinematic_pending", false)
			set_meta("player_stats_spawn_fill_consumed", false)
func _make_player_stat_row(title: String, max_value: int) -> Dictionary:
	var row:= VBoxContainer.new()
	row.add_theme_constant_override("separation", 4)
	row.mouse_filter = Control.MOUSE_FILTER_STOP
	row.set_meta("player_stat_row_receives_hover_on_first_exposure", true)
	row.set_meta("player_stat_row_hover_is_visual_only", true)

	row.mouse_entered.connect(_on_player_stat_row_mouse_entered.bind(title))
	row.mouse_exited.connect(_on_player_stat_row_mouse_exited.bind(title))
	row.set_meta("stat_title", title)
	row.set_meta("stat_row_uses_proportional_fill", true)

	var label:= Label.new()
	label.text = "%s: Unknown" % title
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(label)

	var flavor_label:= Label.new()
	flavor_label.name = "FlavorLabel"
	flavor_label.text = ""
	flavor_label.visible = false
	flavor_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	flavor_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	flavor_label.add_theme_font_size_override("font_size", 11)
	flavor_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	flavor_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(flavor_label)

	var bar:= ProgressBar.new()
	bar.min_value = 0
	bar.max_value = max(1, max_value)
	bar.value = 0
	bar.show_percentage = false
	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.custom_minimum_size = Vector2(0, 24)
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bar.clip_contents = true
	bar.set_meta("stat_title", title)
	bar.set_meta("stat_surface_title", title)
	bar.set_meta("stat_bar_proportional_fill_contract", true)
	bar.set_meta("stat_bar_fill_ratio_source", "value_over_max_value")
	bar.set_meta("stat_bar_empty_at_spawn_forbidden", true)
	bar.set_meta("stat_bar_two_color_lens_contract", true)
	bar.set_meta("stat_bar_base_is_track_fill_is_lens", true)
	row.add_child(bar)

	MainSceneHelpers._ensure_player_stat_bar_fill_lens(bar)

	var value_label:= Label.new()
	value_label.name = "ValueLabel"
	value_label.text = "0"
	value_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	value_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	value_label.z_as_relative = true
	value_label.z_index = 5
	value_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	value_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	value_label.size_flags_vertical = Control.SIZE_EXPAND_FILL

	value_label.add_theme_font_size_override(
		"font_size",
		15
	)
	value_label.add_theme_color_override(
		"font_outline_color",
		Color(
			0.0,
			0.0,
			0.0,
			0.96
		)
	)
	value_label.add_theme_constant_override(
		"outline_size",
		3
	)

	bar.add_child(value_label)

	_apply_player_stat_row_visual_state(label, bar, title, false, false, 0.0)
	_refresh_player_stat_bar_value_text(bar, 0, max_value, title)

	return {
		"row": row,
		"label": label,
		"bar": bar
	}
func _relationship_profile_switch_packet_core_hot(
	packet: Dictionary,
	target_id: int
) -> bool:
	if (
		packet.is_empty()
		or target_id <= 0
	):
		return false

	if int(
		packet.get(
			"actor_id",
			-1
		)
	) != target_id:
		return false

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"surface_contract",
			{}
		)
	)

	if (
		surface.is_empty()
		or int(
			surface.get(
				"actor_id",
				-1
			)
		) != target_id
	):
		return false

	var pointer_revision: String = str(
		packet.get(
			"pointer_revision",
			surface.get(
				"pointer_revision",
				""
			)
		)
	).strip_edges()

	if pointer_revision == "":
		return false

	var pointer_only_packet: bool = bool(
		packet.get(
			"pointer_only_profile_packet",
			surface.get(
				"pointer_only",
				false
			)
		)
	)

	var full_surface_graph_required: bool = bool(
		surface.get(
			"full_surface_graph_required",
			packet.get(
				"full_surface_graph_required",
				not pointer_only_packet
			)
		)
	)

	if (
		pointer_only_packet
		or not full_surface_graph_required
	):
		var press_frame_lens_cache: Dictionary = MainSceneHelpers._safe_dictionary(
			packet.get(
				"press_frame_lens_cache",
				surface.get(
					"press_frame_lens_cache",
					{}
				)
			)
		)

		var diary_lines: Array = MainSceneHelpers._safe_array(
			packet.get(
				"life_diary_lines",
				surface.get(
					"life_diary_lines",
					[]
				)
			)
		)

		var diary_signature: String = str(
			packet.get(
				"life_diary_signature",
				surface.get(
					"life_diary_signature",
					""
				)
			)
		).strip_edges()

		return (
			bool(
				packet.get(
					"success",
					true
				)
			)
			and bool(
				surface.get(
					"surface_hot",
					false
				)
			)
			and bool(
				surface.get(
					"press_frame_ready",
					false
				)
			)
			and int(
				press_frame_lens_cache.get(
					"actor_id",
					-1
				)
			) == target_id
			and not diary_lines.is_empty()
			and diary_signature != ""
		)

	var deck: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"main_tab_surface_contracts",
			surface.get(
				"main_tab_surface_contracts",
				{}
			)
		)
	)

	for raw_tab_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var tab_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			deck.get(
				str(raw_tab_id),
				{}
			)
		)

		if (
			tab_contract.is_empty()
			or int(
				tab_contract.get(
					"actor_id",
					-1
				)
			) != target_id
		):
			return false

	return true
func _relationship_profile_death_year_for(target: Person) -> int:
	if target == null:
		return -999999

	if "death_year" in target:
		var stored_year: int = int(target.death_year)
		if stored_year > -999000:
			return stored_year

		if gs != null and (not bool(target.alive) or float(target.health) <= 0.0):
			target.death_year = int(gs.year)
			return int(target.death_year)

	if gs != null and (not bool(target.alive) or float(target.health) <= 0.0):
		return int(gs.year)

	return -999999


func _relationship_profile_death_year_label_for(target: Person) -> String:
	var death_year: int = _relationship_profile_death_year_for(target)
	if death_year <= -999000:
		return "an unknown year"

	if has_method("_format_year"):
		return str(call("_format_year", death_year))

	return str(death_year)


func _build_player_stat_surface_context(p: Person, narrative_perspective: String = "first_person", viewer: Person = null) -> Dictionary:
	if p == null:
		return {}

	if gs != null and gs.has_method("sync_person_death_state_from_health"):
		gs.sync_person_death_state_from_health(p)

	var terabithia_state: Dictionary = {}
	if typeof(p.terabithia_state) == TYPE_DICTIONARY:
		terabithia_state = p.terabithia_state

	var approval_value: int = clamp(int(round(float(p.approval))), 0, 100)
	var fame_value: int = max(0, int(round(float(p.fame))))
	var health_value: int = max(0, int(round(float(p.health))))
	var subject_dead: bool = (not bool(p.alive)) or health_value <= 0
	var death_cause: String = MainSceneHelpers._relationship_profile_death_cause_for(p)
	var death_year: int = _relationship_profile_death_year_for(p)
	var death_year_label: String = _relationship_profile_death_year_label_for(p)

	var resolved_perspective: String = str(narrative_perspective).strip_edges().to_lower()
	if resolved_perspective == "":
		resolved_perspective = "first_person"

	var bond_object_label: String = "them"
	var bond_object_possessive: String = "their"
	if resolved_perspective == "third_person":
		bond_object_label = "you"
		bond_object_possessive = "your"

	return {
		"is_royal_pressure": (bool(p.is_ruler) or bool(p.is_royal) or int(p.succession_rank) <= 12 or str(p.royal_title).strip_edges() != "") and approval_value < 45,
		"is_public_pressure": fame_value >= 60,
		"health_low": health_value < 35,
		"subject_dead": subject_dead,
		"death_cause": death_cause,
		"death_year": death_year,
		"death_year_label": death_year_label,
		"death_health_flavor": MainSceneHelpers._relationship_profile_dead_health_flavor({
			"death_cause": death_cause,
			"death_year_label": death_year_label,
			"narrative_perspective": resolved_perspective
		}),
		"terabithia_known": bool(terabithia_state.get("leslie_known", false)),
		"terabithia_unlocked": bool(terabithia_state.get("access_unlocked", false)),
		"terabithia_discovered": bool(terabithia_state.get("discovered", false)),
		"terabithia_entered": bool(terabithia_state.get("entered", false)),
		"narrative_perspective": resolved_perspective,
		"viewer_id": int(viewer.id) if viewer != null else -1,
		"subject_id": int(p.id),
		"fame_tier_text": str(p.fame_tier).strip_edges(),
		"bond_object_label": bond_object_label,
		"bond_object_possessive": bond_object_possessive
	}
