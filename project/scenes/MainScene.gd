		"border": Color(1.0, 1.0, 1.0, 0.14),
		"glow": Color(1.0, 1.0, 1.0, 0.08),
		"glow_size": 8.0,
		"text": Color(0.97, 0.995, 1.0, 1.0),
		"text_hover": Color(1.0, 1.0, 1.0, 1.0),
