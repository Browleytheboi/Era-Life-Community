func _clear_container_children(node: Node) -> void:
	if node == null:
		return

	var population_cache_root: Control = null
	var can_preserve_population_lens_surfaces: bool = has_method("_ensure_realm_population_surface_cache_root")

	if can_preserve_population_lens_surfaces:
		population_cache_root = _ensure_realm_population_surface_cache_root()

	for child in node.get_children():
		if child == null:
			continue

		var should_preserve_population_surface: bool = false

		if child.has_meta("realm_population_contract_surface"):
			should_preserve_population_surface = true
		if child.has_meta("realm_population_contract_panel"):
			should_preserve_population_surface = true
		if child.has_meta("realm_population_surface_prebuilt"):
			should_preserve_population_surface = true
		if child.has_meta("population_lens_viewer"):
			should_preserve_population_surface = true
		if child.has_meta("population_lens_surface_ready"):
			should_preserve_population_surface = true
		if child.has_meta("population_lens_surface_prebuilt_before_press"):
			should_preserve_population_surface = true
		if child.has_meta("population_lens_mounted_from_realm_population_contract_panel"):
			should_preserve_population_surface = true

		if should_preserve_population_surface:
			var preserved_control:= child as Control
			if preserved_control != null and is_instance_valid(preserved_control):
				preserved_control.visible = false
				preserved_control.mouse_filter = Control.MOUSE_FILTER_IGNORE
				preserved_control.set_meta("population_lens_preserved_from_generic_clear", true)
				preserved_control.set_meta("population_lens_preserved_from_generic_clear_at_ms", int(Time.get_ticks_msec()))

				if child.get_parent() == node:
					node.remove_child(child)

				if population_cache_root != null and is_instance_valid(population_cache_root):
					if child.get_parent() != population_cache_root:
						population_cache_root.add_child(child)

				continue

		if child.get_parent() == node:
			node.remove_child(child)

		child.queue_free()


