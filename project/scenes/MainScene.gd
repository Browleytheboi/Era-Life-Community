	if bool(get_meta("god_mode_atomic_shell_handoff_active", false)):
		return true

	if bool(get_meta("god_mode_life_entry_full_ui_required", false)):
		return true

	if bool(get_meta("god_mode_cover_keeps_full_panel_visible_until_live_frame", false)):
		return true

