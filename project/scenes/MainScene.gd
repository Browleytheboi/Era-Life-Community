func _god_mode_visible_life_surface_owns_screen(reason: String = "god_mode_entry") -> bool:
	if gs == null or gs.player == null:
		return false

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	if not bool(get_meta("first_visible_life_shell_final_composition_complete", false)):
		var snapshot: Dictionary = _truth_first_god_mode_ready_snapshot(reason)
		if snapshot.is_empty():
			snapshot = _build_first_frame_ui_snapshot_from_game_state(gs, "%s_visible_probe_snapshot_rebuild" % reason)

		if snapshot.is_empty():
			return false

		if not _compose_god_mode_ready_final_playable_life_shell_frame(
			snapshot.duplicate(true),
			"%s_visible_surface_probe_final_composer" % reason
		):
			return false

	var now_ms: int = int(Time.get_ticks_msec())

	gs.scenario_state ["god_mode_visible_life_surface_owns_screen"] = true
	gs.scenario_state ["god_mode_visible_life_surface_owns_screen_reason"] = reason
	gs.scenario_state ["god_mode_visible_life_surface_owns_screen_at_ms"] = now_ms
	gs.scenario_state ["playable_life_surface_has_visual_authority"] = true
	gs.scenario_state ["god_mode_panel_may_render_over_live_life"] = false
	gs.scenario_state ["minimum_shell_fallback_banned"] = true
	gs.scenario_state ["first_visible_life_shell_final_composition_complete"] = true

	return true
