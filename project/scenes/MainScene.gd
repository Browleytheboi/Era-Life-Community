func _sync_romance_contract_scroll_height() -> void:
	if romance_contract_popup_scroll == null or not is_instance_valid(romance_contract_popup_scroll):
		return
	var viewport_height: float = get_viewport_rect().size.y
	var scroll_height: float = clamp(viewport_height - 320.0, 240.0, 520.0)
	romance_contract_popup_scroll.custom_minimum_size = Vector2(0, scroll_height)


func _configure_romance_contract_scrollbar() -> void:
	if romance_contract_popup_scroll == null or not is_instance_valid(romance_contract_popup_scroll):
		return

	romance_contract_popup_scrollbar = romance_contract_popup_scroll.get_v_scroll_bar()
	if romance_contract_popup_scrollbar == null or not is_instance_valid(romance_contract_popup_scrollbar):
		return

	romance_contract_popup_scrollbar.modulate.a = 0.0

	var changed_callable:= Callable(self, "_on_romance_contract_scroll_changed")
	if not romance_contract_popup_scrollbar.value_changed.is_connected(changed_callable):
		romance_contract_popup_scrollbar.value_changed.connect(changed_callable)


func _on_romance_contract_scroll_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if mouse_event.pressed and mouse_event.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
			_show_romance_contract_scrollbar_temporarily()
	elif event is InputEventPanGesture:
		_show_romance_contract_scrollbar_temporarily()
	elif event is InputEventScreenDrag:
		_show_romance_contract_scrollbar_temporarily()


func _on_romance_contract_scroll_changed(_value: float) -> void:
	_show_romance_contract_scrollbar_temporarily()


func _show_romance_contract_scrollbar_temporarily() -> void:
	_fade_romance_contract_scrollbar(true)

	if romance_contract_popup_scroll_fade_timer != null and is_instance_valid(romance_contract_popup_scroll_fade_timer):
		romance_contract_popup_scroll_fade_timer.stop()
		romance_contract_popup_scroll_fade_timer.start()


func _on_romance_contract_scroll_fade_timeout() -> void:
	_fade_romance_contract_scrollbar(false)


func _fade_romance_contract_scrollbar(show_scrollbar: bool) -> void:
	if romance_contract_popup_scrollbar == null or not is_instance_valid(romance_contract_popup_scrollbar):
		return

	if romance_contract_popup_scroll_fade_tween != null and romance_contract_popup_scroll_fade_tween.is_valid():
		romance_contract_popup_scroll_fade_tween.kill()

	var target_alpha: float = 1.0 if show_scrollbar else 0.0
	romance_contract_popup_scroll_fade_tween = create_tween().bind_node(romance_contract_popup_scrollbar)
	romance_contract_popup_scroll_fade_tween.tween_property(romance_contract_popup_scrollbar, "modulate:a", target_alpha, 0.18).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


func _reset_romance_contract_scroll() -> void:
	if romance_contract_popup_scroll != null and is_instance_valid(romance_contract_popup_scroll):
		romance_contract_popup_scroll.scroll_vertical = 0
	_fade_romance_contract_scrollbar(false)
func _show_other_country_romance_preference_popup(entry: Dictionary) -> void:
	if entry.is_empty():
		if world_actions_status_label != null:
			world_actions_status_label.text = "That romance surface could not be resolved."
		return

	_ensure_romance_contract_popup()
	if romance_contract_popup == null:
		return

	romance_contract_popup_pending_report.clear()
	_clear_container_children(romance_contract_popup_stats_box)
	_clear_container_children(romance_contract_popup_actions)

	var place_name: String = str(entry.get("name", "that place")).strip_edges()
	romance_contract_popup_title.text = "Try to Find a Date in %s" % place_name
	romance_contract_popup_body.clear()
	romance_contract_popup_body.append_text("Who are you hoping writes back? The romance contract will use the era, your fame, your status, the target realm, and the country’s social surface to decide whether your message reaches a real person.")

	_romance_contract_add_button("Men", Callable(self, "_resolve_other_country_romance_preference").bind(entry.duplicate(true), "man"), true)
	_romance_contract_add_button("Women", Callable(self, "_resolve_other_country_romance_preference").bind(entry.duplicate(true), "woman"), true)
	_romance_contract_add_button("Back", Callable(self, "_hide_romance_contract_popup"), false)

	romance_contract_popup.visible = true
	_bring_modal_to_front(romance_contract_popup)

func _resolve_other_country_romance_preference(entry: Dictionary, preference: String) -> void:
	if romance_contract_popup_body != null:
		romance_contract_popup_body.clear()
		romance_contract_popup_body.append_text("Routing romance intent through the world...")

	if world_actions_status_label != null:
		world_actions_status_label.text = "Romance contract processing..."

	_clear_container_children(romance_contract_popup_stats_box)
	_clear_container_children(romance_contract_popup_actions)

	await get_tree().create_timer(0.42).timeout

	if gs == null or gs.player == null:
		_show_other_country_romance_report({
			"success": false,
			"popup_title": "Romance Contract Failed",
			"popup_text": "The romance contract could not resolve the player.",
			"journal_text": "I tried to find a date, but the romance contract could not resolve my life.",
			"status_text": "Romance contract failed."
		})
		return

	var initial_diary_line: String = MainSceneLogic._other_country_romance_initial_diary_line(gs, entry, preference)
	_append_player_action_diary_lines([initial_diary_line], "foreign_romance_initial_action")

	if not MainSceneLogic._ensure_romance_contract_engine_ready(gs):
		var missing_report: Dictionary = {
			"success": false,
			"popup_title": "Romance Contract Missing",
			"popup_text": "RomanceContractEngine could not be mounted on GameState.",
			"journal_text": "The romance contract could not resolve after I reached out.",
			"status_text": "Romance engine unavailable."
		}
		_record_player_action_report_in_life_diary(missing_report, "", "foreign_romance_missing_engine")
		_show_other_country_romance_report(missing_report)
		return

	var context: Dictionary = {
		"source": "mainscene.other_country_find_date",
		"ui_surface": "other_countries_popup"
	}

	var report: Dictionary = {}

	if gs.has_method("route_command_envelope"):
		var routed: Variant = gs.route_command_envelope({
			"command": "romance.find_foreign_date",
			"engine_property": "romance_contract_engine",
			"target": "romance_contract_engine",
			"payload": {
				"actor_id": int(gs.player.id),
				"entry": entry.duplicate(true),
				"preference": preference,
				"source": str(context.get("source", "")),
				"ui_surface": str(context.get("ui_surface", ""))
			}
		})

		if typeof(routed) == TYPE_DICTIONARY:
			report = (routed as Dictionary).duplicate(true)

	if report.is_empty() or str(report.get("reason", "")) == "RomanceContractEngine unavailable.":
		report = gs.romance_contract_engine.begin_foreign_date_search(gs.player, entry.duplicate(true), preference, context)

	_record_player_action_report_in_life_diary(report, "", "foreign_romance_outcome")
	_show_other_country_romance_report(report)


func _show_other_country_romance_report(report: Dictionary) -> void:
	_ensure_romance_contract_popup()
	if romance_contract_popup == null:
		return

	_sync_romance_contract_scroll_height()
	romance_contract_popup_pending_report = report.duplicate(true)
	_clear_container_children(romance_contract_popup_stats_box)
	_clear_container_children(romance_contract_popup_actions)

	romance_contract_popup_title.text = str(report.get("popup_title", "Romance Contract"))
	romance_contract_popup_body.clear()
	romance_contract_popup_body.append_text(str(report.get("popup_text", report.get("text", ""))))

	var card: Dictionary = {}
	var card_raw: Variant = report.get("person_card", {})
	if typeof(card_raw) == TYPE_DICTIONARY:
		card = card_raw as Dictionary

	if not card.is_empty():
		var identity:= Label.new()
		identity.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

		var identity_lines: Array = []
		identity_lines.append("%s • Age %d • %s" % [
			str(card.get("name", "Unknown Person")),
			int(card.get("age", 0)),
			str(card.get("social_class", "Commoner"))
		])
		identity_lines.append("%s, %s" % [
			str(card.get("city", "Unknown City")),
			str(card.get("country", "Unknown Country"))
		])

		var personality_type: String = str(card.get("personality_type", "")).strip_edges()
		var personality_description: String = str(card.get("personality_description", "")).strip_edges()
		if personality_type != "":
			identity_lines.append("Personality Type: %s" % personality_type)
		if personality_description != "":
			identity_lines.append(personality_description)

		identity_lines.append(str(card.get("background", "They have a life outside your screen.")))
		identity.text = "\n".join(identity_lines)

		identity.add_theme_font_size_override("font_size", 15)
		identity.add_theme_color_override("font_color", Color(1.0, 0.88, 0.96, 0.96))
		romance_contract_popup_stats_box.add_child(identity)

		var stats: Dictionary = {}
		var stats_raw: Variant = card.get("stats", {})
		if typeof(stats_raw) == TYPE_DICTIONARY:
			stats = stats_raw as Dictionary

		for stat_name in ["Looks", "Health", "Mental Health", "Fame", "Affection", "Distance Pull"]:
			var value: int = int(stats.get(stat_name, 0))
			_add_romance_contract_stat_row(stat_name, value)

	var can_accept: bool = bool(report.get("can_accept", false))
	var contract_id: String = str(report.get("contract_id", "")).strip_edges()

	if can_accept and contract_id != "":
		_romance_contract_add_button("Write Back", Callable(self, "_on_other_country_romance_accept_pressed").bind(contract_id), true)
		_romance_contract_add_button("Not Now", Callable(self, "_hide_romance_contract_popup"), false)
	else:
		_romance_contract_add_button("Close", Callable(self, "_hide_romance_contract_popup"), true)

	romance_contract_popup.visible = true
	_reset_romance_contract_scroll()
	_bring_modal_to_front(romance_contract_popup)

	if world_actions_status_label != null:
		var fallback_status: String = "Romance contract resolved."
		if not bool(report.get("success", false)):
			fallback_status = "Romance contract could not resolve."
		world_actions_status_label.text = str(report.get("status_text", fallback_status))

func _add_romance_contract_stat_row(stat_name: String, target_value: int) -> void:
	if romance_contract_popup_stats_box == null:
		return

	var palette: Dictionary = _romance_contract_stat_palette(stat_name)
	var label_color: Color = Color(palette.get("label", Color(1.0, 0.78, 0.9, 0.94)))
	var core_color: Color = Color(palette.get("core", Color(1.0, 0.46, 0.78, 1.0)))
	var soft_color: Color = Color(palette.get("soft", Color(0.32, 0.16, 0.5, 0.98)))
	var glow_color: Color = Color(palette.get("glow", Color(1.0, 0.46, 0.78, 0.24)))

	var row:= VBoxContainer.new()
	row.add_theme_constant_override("separation", 3)
	romance_contract_popup_stats_box.add_child(row)

	var label:= Label.new()
	label.text = "%s: %d" % [stat_name, int(clamp(target_value, 0, 100))]
	label.add_theme_font_size_override("font_size", 14)
	label.add_theme_color_override("font_color", label_color)
	label.add_theme_color_override("font_shadow_color", Color(glow_color.r, glow_color.g, glow_color.b, 0.38))
	label.add_theme_constant_override("shadow_offset_x", 0)
	label.add_theme_constant_override("shadow_offset_y", 0)
	label.add_theme_constant_override("shadow_outline_size", 2)
	row.add_child(label)

	var bar:= ProgressBar.new()
	bar.min_value = 0
	bar.max_value = 100
	bar.value = 0
	bar.custom_minimum_size = Vector2(0, 12)

	var background_style:= StyleBoxFlat.new()
	background_style.bg_color = Color(soft_color.r, soft_color.g, soft_color.b, 0.38)
	background_style.corner_radius_top_left = 6
	background_style.corner_radius_top_right = 6
	background_style.corner_radius_bottom_left = 6
	background_style.corner_radius_bottom_right = 6
	bar.add_theme_stylebox_override("background", background_style)

	var fill_style:= StyleBoxFlat.new()
	fill_style.bg_color = core_color
	fill_style.corner_radius_top_left = 6
	fill_style.corner_radius_top_right = 6
	fill_style.corner_radius_bottom_left = 6
	fill_style.corner_radius_bottom_right = 6
	fill_style.shadow_color = glow_color
	fill_style.shadow_size = 6
	fill_style.shadow_offset = Vector2(0, 0)
	bar.add_theme_stylebox_override("fill", fill_style)

	row.add_child(bar)

	var tween:= create_tween().bind_node(bar)
	tween.tween_property(bar, "value", float(clamp(target_value, 0, 100)), 0.55).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
func _romance_contract_stat_palette(stat_name: String) -> Dictionary:
	var palette_key: String = MainSceneHelpers._romance_contract_stat_palette_key(stat_name)
	var palette_raw: Variant = {}

	if has_method("_resolve_player_stat_palette"):
		palette_raw = call("_resolve_player_stat_palette", palette_key)

	if typeof(palette_raw) == TYPE_DICTIONARY:
		return (palette_raw as Dictionary).duplicate(true)

	return {
		"core": Color(1.0, 0.46, 0.78, 1.0),
		"soft": Color(0.58, 0.18, 0.42, 0.98),
		"glow": Color(1.0, 0.46, 0.78, 0.24),
		"label": Color(1.0, 0.92, 0.97, 1.0)
	}


func _romance_contract_add_button(text: String, callback: Callable, primary: bool = false) -> Button:
	var button:= Button.new()
	button.text = text
	button.custom_minimum_size = Vector2(148, 40)
	button.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	button.add_theme_font_size_override("font_size", 15)

	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.34, 0.08, 0.18, 0.96) if primary else Color(0.14, 0.1, 0.15, 0.94)
	style.border_color = Color(1.0, 0.48, 0.68, 0.82) if primary else Color(0.85, 0.65, 0.76, 0.45)
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.corner_radius_top_left = 10
	style.corner_radius_top_right = 10
	style.corner_radius_bottom_left = 10
	style.corner_radius_bottom_right = 10
	button.add_theme_stylebox_override("normal", style)

	button.pressed.connect(callback)
	romance_contract_popup_actions.add_child(button)
	return button


func _on_other_country_romance_accept_pressed(contract_id: String) -> void:
	if gs == null or gs.player == null or not MainSceneLogic._ensure_romance_contract_engine_ready(gs):
		var failed_report: Dictionary = {
			"success": false,
			"popup_title": "Romance Contract Failed",
			"popup_text": "The romance engine is not available.",
			"journal_text": "I tried to write back, but the romance engine was not available.",
			"status_text": "Romance engine unavailable."
		}
		_record_player_action_report_in_life_diary(failed_report, "", "foreign_romance_accept_failed")
		_show_other_country_romance_report(failed_report)
		return

	var context: Dictionary = {
		"source": "mainscene.other_country_romance_accept"
	}

	var report: Dictionary = {}

	if gs.has_method("route_command_envelope"):
		var routed: Variant = gs.route_command_envelope({
			"command": "romance.accept_foreign_date",
			"engine_property": "romance_contract_engine",
			"target": "romance_contract_engine",
			"payload": {
				"actor_id": int(gs.player.id),
				"contract_id": contract_id,
				"source": str(context.get("source", ""))
			}
		})

		if typeof(routed) == TYPE_DICTIONARY:
			report = (routed as Dictionary).duplicate(true)

	if report.is_empty() or str(report.get("reason", "")) == "RomanceContractEngine unavailable.":
		report = gs.romance_contract_engine.accept_pending_foreign_romance_contract(gs.player, contract_id, context)

	_record_player_action_report_in_life_diary(report, "", "foreign_romance_accept")
	_update_player_stats_overlay()
	_show_other_country_romance_report(report)
func _hide_romance_contract_popup() -> void:
