		gs.scenario_state ["zero_frame_ui_render_enforcement_active"] = false
		gs.scenario_state ["zero_frame_ui_render_enforcement_released_reason"] = reason
		gs.scenario_state ["zero_frame_ui_render_enforcement_released_at_ms"] = int(Time.get_ticks_msec())


func _schedule_zero_frame_ui_render_enforcement_release(reason: String = "zero_frame_ui") -> void:
