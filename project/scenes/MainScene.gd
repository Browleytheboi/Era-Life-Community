func _on_relationship_hub_panel_person_requested(
	target_id: int,
	payload: Dictionary
) -> void:
	if target_id <= 0:
		return

	var target: Person = null
	var pointer_raw: Variant = payload.get(
		"target_pointer",
		payload.get(
			"target",
			null
		)
	)

	if pointer_raw is Person:
		var payload_target: Person = (
			pointer_raw as Person
		)

		if (
			payload_target != null
			and int(
				payload_target.id
			) == target_id
		):
			target = payload_target

	if target == null:
		target = _relationship_profile_cached_target_for_id(
			target_id
		)

	if target == null:
		if (
			relationship_hub_panel != null
			and is_instance_valid(
				relationship_hub_panel
			)
		):
			relationship_hub_panel.set_status(
				"That relationship target is not currently observable."
			)
		return

	var profile_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		payload.get(
			"profile_contract",
			{}
		)
	)
	profile_contract = (
		_relationship_profile_contract_with_resident_switch_successor(
			profile_contract,
			target_id
		)
	)

	if not profile_contract.is_empty():
		var contract_cache_raw: Variant = get_meta(
			"relationship_profile_contract_by_target",
			{}
		)
		var contract_cache: Dictionary = (
			(contract_cache_raw as Dictionary).duplicate(false)
			if typeof(contract_cache_raw) == TYPE_DICTIONARY
			else {}
		)

		contract_cache [
			str(target_id)
		] = profile_contract.duplicate(false)

		set_meta(
			"relationship_profile_contract_by_target",
			contract_cache
		)

	_on_relationship_hub_full_profile_pressed(
		target_id,
		target,
		profile_contract
	)

