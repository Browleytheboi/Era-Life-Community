func _build_age_up_loading_context() -> Dictionary:
	var out: Dictionary = {
		"headline": "Time is moving...",
		"subline": "Simulating the next year...",
		"reality_mode": "realistic",
		"era_name": "",
		"dominant_domain": "general",
		"source_year": 0,
		"source_age": 0,
		"target_year": 0,
		"target_age": 0,
		"influences": {},
		"flavor_rows": []
	}

	if gs == null:
		out ["flavor_rows"] = _default_age_up_loading_flavor_rows(out)
		return out

	var player: Person = gs.player
	out ["reality_mode"] = str(gs.reality_mode)
	out ["era_name"] = str(gs.era.get("name", "")) if gs.era != null else ""
	out ["source_year"] = int(gs.year)
	out ["source_age"] = int(player.age) if player != null else 0
	out ["target_year"] = int(out ["source_year"]) + 1
	out ["target_age"] = int(out ["source_age"]) + 1

	var influences: Dictionary = {
		"general": 8.0,
		"chaos": 24.0 if str(gs.reality_mode) == "chaos" else 0.0,
		"royalty": 0.0,
		"crime": 0.0,
		"justice": 0.0,
		"succession": 0.0,
		"realm": 0.0,
		"career": 0.0,
		"neighborhood": 0.0
	}

	if player != null and bool(player.is_royal):
		influences ["royalty"] = float(influences.get("royalty", 0.0)) + 18.0
		influences ["succession"] = float(influences.get("succession", 0.0)) + 8.0

	if player != null:
		var bias_raw: Variant = gs.transient_scenario_biases.get(int(player.id), {})
		var bias: Dictionary = {}
		if typeof(bias_raw) == TYPE_ARRAY:
			var bias_bucket: Array = bias_raw
			if not bias_bucket.is_empty() and typeof(bias_bucket [0]) == TYPE_DICTIONARY:
				bias = bias_bucket [0]
		elif typeof(bias_raw) == TYPE_DICTIONARY:
			bias = bias_raw

		var faction_pressure_raw: Variant = bias.get("faction_pressure", {})
		var faction_pressure: Dictionary = faction_pressure_raw if typeof(faction_pressure_raw) == TYPE_DICTIONARY else {}

		influences ["crime"] = float(influences.get("crime", 0.0)) + float(faction_pressure.get("syndicate_turf_pressure", 0.0))
		influences ["justice"] = float(influences.get("justice", 0.0)) + float(faction_pressure.get("justice_pressure", 0.0)) + float(faction_pressure.get("court_pressure", 0.0)) + float(faction_pressure.get("prison_pressure", 0.0))
		influences ["succession"] = float(influences.get("succession", 0.0)) + float(faction_pressure.get("royal_succession_tension", 0.0))
		influences ["realm"] = float(influences.get("realm", 0.0)) + float(faction_pressure.get("hidden_realm_instability", 0.0)) + float(faction_pressure.get("contested_realm_tension", 0.0))
		influences ["career"] = float(influences.get("career", 0.0)) + float(faction_pressure.get("workplace_pressure", 0.0))
		influences ["neighborhood"] = float(influences.get("neighborhood", 0.0)) + float(faction_pressure.get("neighborhood_pressure", 0.0))

	out ["influences"] = influences
	out ["dominant_domain"] = MainSceneHelpers._resolve_age_up_loading_dominant_domain(influences)
	out ["flavor_rows"] = _default_age_up_loading_flavor_rows(out)

	if not out ["flavor_rows"].is_empty():
		var first_row: Dictionary = out ["flavor_rows"] [0]
		out ["headline"] = str(first_row.get("headline", out ["headline"]))
		out ["subline"] = str(first_row.get("subline", out ["subline"]))

	return out


func _default_age_up_loading_flavor_rows(context: Dictionary) -> Array:
	var rows: Array = []
	var influences_raw: Variant = context.get("influences", {})
	var influences: Dictionary = influences_raw if typeof(influences_raw) == TYPE_DICTIONARY else {}
	var reality_mode: String = str(context.get("reality_mode", "realistic"))

	rows.append({
		"headline": "Time is moving...",
		"subline": "Simulating the next year...",
		"domain": "general",
		"weight": 8.0
	})
	rows.append({
		"headline": "Lives are unfolding...",
		"subline": "Tracing the next year across your orbit...",
		"domain": "general",
		"weight": 8.0
	})
	rows.append({
		"headline": "Factions are shifting...",
		"subline": "Pressure lines are redrawing themselves...",
		"domain": "general",
		"weight": 7.0
	})
	rows.append({
		"headline": "Destiny is recalculating...",
		"subline": "Reweighing outcomes, fallout, and timing...",
		"domain": "general",
		"weight": 7.0
	})
	rows.append({
		"headline": "Reality is stabilizing...",
		"subline": "Pulling the next year into focus...",
		"domain": "general",
		"weight": 6.0
	})

	if reality_mode == "chaos":
		rows.append({
			"headline": "Reality is struggling to keep up...",
			"subline": "Chaos-mode drift is forcing rough corrections...",
			"domain": "chaos",
			"weight": 26.0 + float(influences.get("chaos", 0.0))
		})

	if float(influences.get("royalty", 0.0)) > 0.0 or float(influences.get("succession", 0.0)) > 0.0:
		rows.append({
			"headline": "Power is shifting behind the throne...",
			"subline": "Succession pressure is moving in silence...",
			"domain": "succession",
			"weight": 14.0 + float(influences.get("succession", 0.0))
		})

	if float(influences.get("crime", 0.0)) > 0.0:
		rows.append({
			"headline": "The streets are changing...",
			"subline": "Turf pressure is rearranging the year...",
			"domain": "crime",
			"weight": 12.0 + float(influences.get("crime", 0.0))
		})

	if float(influences.get("justice", 0.0)) > 0.0:
		rows.append({
			"headline": "The law is closing ranks...",
			"subline": "Courts, prisons, and pressure are tightening...",
			"domain": "justice",
			"weight": 12.0 + float(influences.get("justice", 0.0))
		})

	if float(influences.get("realm", 0.0)) > 0.0:
		rows.append({
			"headline": "Hidden realms are humming...",
			"subline": "Instability is leaking through the veil...",
			"domain": "realm",
			"weight": 12.0 + float(influences.get("realm", 0.0))
		})

	if float(influences.get("career", 0.0)) > 0.0:
		rows.append({
			"headline": "Institutions are adjusting...",
			"subline": "Workplace pressure is reshaping somebody's year...",
			"domain": "career",
			"weight": 10.0 + float(influences.get("career", 0.0))
		})

	if float(influences.get("neighborhood", 0.0)) > 0.0:
		rows.append({
			"headline": "Local pressure is building...",
			"subline": "Claims, housing, and identity are sliding into place...",
			"domain": "neighborhood",
			"weight": 10.0 + float(influences.get("neighborhood", 0.0))
		})

	var contributed_rows_raw: Variant = gs.scenario_state.get("loading_runtime_rows", []) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else []
	if typeof(contributed_rows_raw) == TYPE_ARRAY:
		for raw_row in contributed_rows_raw:
			if typeof(raw_row) != TYPE_DICTIONARY:
				continue
			rows.append(raw_row.duplicate(true))

	rows.sort_custom(func (a, b): return float(a.get("weight", 0.0)) > float(b.get("weight", 0.0)))
	return rows


func _build_loading_safe_age_up_output_bucket(result: Dictionary) -> Dictionary:
	var display_result: Dictionary = result.duplicate(true)
	if gs != null and gs.afterlife_active and gs.afterlife_influence_engine != null:
		var incoming_type: String = str(display_result.get("type", ""))
		if not incoming_type.begins_with("afterlife") and gs.afterlife_influence_engine.has_pending_choice():
			display_result = gs.afterlife_influence_engine.get_pending_choice_result()

	var result_text: String = MainSceneHelpers._compact_diary_text(str(display_result.get("text", "")))
	var rtype: String = str(display_result.get("type", ""))
	var defer_result_until_after_feed: bool = (rtype == "scenario_commit_complete")
	var lines: Array = []
	var seen_lines: Dictionary = {}
	var display_year_value: int = gs.year if gs != null else 0
	var display_age_value: int = int(gs.player.age) if gs != null and gs.player != null else 0

	lines.append("Year: %s" % _format_year(display_year_value))
	if gs != null and gs.player != null:
		lines.append("Age: %d" % display_age_value)
	if gs != null and gs.player != null and display_age_value == 0 and age_up_diary_entries.is_empty():
		lines.append("I was born in %s, %s." % [gs.player.birth_city, gs.player.birth_country])

	if not defer_result_until_after_feed and rtype != "scenario_prompt" and result_text != "":
		seen_lines [result_text] = true
		lines.append(result_text)

	var pending_deaths: Array = []
	if gs != null:
		pending_deaths = gs.pending_death_messages.duplicate(true)
		gs.pending_death_messages.clear()

	var world_start: int = 0
	var world_end: int = 0
	if gs != null:
		world_start = clamp(diary_world_feed_cursor, 0, gs.world_feed.size())
		world_end = gs.world_feed.size()

	return {
		"display_result": display_result.duplicate(true),
		"rtype": rtype,
		"result_text": result_text,
		"defer_result_until_after_feed": defer_result_until_after_feed,
		"lines": lines.duplicate(true),
		"seen_lines": seen_lines.duplicate(true),
		"pending_deaths": pending_deaths.duplicate(true),
		"pending_death_index": 0,
		"world_index": world_start,
		"world_end": world_end,
		"world_feed_cursor": world_start,
		"stage": "pending_deaths",
		"is_complete": false
	}


func _step_loading_safe_age_up_output_bucket(bucket: Dictionary, max_items: int = 18) -> Dictionary:
	var working: Dictionary = bucket.duplicate(true)
	var remaining: int = max(1, max_items)

	while remaining > 0:
		var stage: String = str(working.get("stage", "pending_deaths"))

		match stage:
			"pending_deaths":
				var pending_deaths_raw: Variant = working.get("pending_deaths", [])
				var pending_deaths: Array = pending_deaths_raw if typeof(pending_deaths_raw) == TYPE_ARRAY else []
				var pending_idx: int = int(working.get("pending_death_index", 0))
				if pending_idx >= pending_deaths.size():
					working ["stage"] = "world_feed"
					continue

				var pending_text: String = MainSceneHelpers._compact_diary_text(str(pending_deaths [pending_idx]))
				var seen_lines_raw: Variant = working.get("seen_lines", {})
				var seen_lines: Dictionary = seen_lines_raw if typeof(seen_lines_raw) == TYPE_DICTIONARY else {}
				var lines_raw: Variant = working.get("lines", [])
				var lines: Array = lines_raw if typeof(lines_raw) == TYPE_ARRAY else []

				if pending_text != "" and not seen_lines.has(pending_text):
					seen_lines [pending_text] = true
					lines.append(pending_text)

				working ["seen_lines"] = seen_lines
				working ["lines"] = lines
				working ["pending_death_index"] = pending_idx + 1
				remaining -= 1

			"world_feed":
				var world_idx: int = int(working.get("world_index", 0))
				var world_end: int = int(working.get("world_end", world_idx))
				if gs == null or world_idx >= world_end:
					working ["stage"] = "result_tail"
					continue

				var entry: Dictionary = gs.normalize_world_feed_entry(gs.world_feed [world_idx])
				var diary_line: String = _diary_line_from_world_feed_entry(entry).strip_edges()
				var seen_lines_raw: Variant = working.get("seen_lines", {})
				var seen_lines: Dictionary = seen_lines_raw if typeof(seen_lines_raw) == TYPE_DICTIONARY else {}
				var lines_raw: Variant = working.get("lines", [])
				var lines: Array = lines_raw if typeof(lines_raw) == TYPE_ARRAY else []

				if diary_line != "" and not seen_lines.has(diary_line):
					seen_lines [diary_line] = true
					lines.append(diary_line)

				working ["seen_lines"] = seen_lines
				working ["lines"] = lines
				working ["world_index"] = world_idx + 1
				working ["world_feed_cursor"] = world_idx + 1
				remaining -= 1

			"result_tail":
				var seen_lines_raw: Variant = working.get("seen_lines", {})
				var seen_lines: Dictionary = seen_lines_raw if typeof(seen_lines_raw) == TYPE_DICTIONARY else {}
				var lines_raw: Variant = working.get("lines", [])
				var lines: Array = lines_raw if typeof(lines_raw) == TYPE_ARRAY else []
				var defer_result_until_after_feed: bool = bool(working.get("defer_result_until_after_feed", false))
				var result_text: String = str(working.get("result_text", "")).strip_edges()

				if defer_result_until_after_feed and result_text != "" and not seen_lines.has(result_text):
					seen_lines [result_text] = true
					lines.append(result_text)

				lines.append("----------------------")
				working ["seen_lines"] = seen_lines
				working ["lines"] = lines
				working ["world_feed_cursor"] = int(working.get("world_end", int(working.get("world_feed_cursor", diary_world_feed_cursor))))
				working ["stage"] = "complete"
				working ["is_complete"] = true
				break

			"complete":
				working ["is_complete"] = true
				break

			_:
				working ["stage"] = "complete"
				working ["is_complete"] = true
				break

	return working
func _zero_frame_age_up_cosmetic_result() -> Dictionary:
	if gs == null:
		return {}

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return {}

	var candidates: Array = [
		get_meta("age_up_loading_zero_frame_result", {}),
		gs.scenario_state.get("zero_frame_age_up_last_result", {}),
		gs.scenario_state.get("post_runtime_result", {}),
		gs.scenario_state.get("last_resolved_age_up_result", {})
	]

	for raw_candidate in candidates:
		if typeof(raw_candidate) != TYPE_DICTIONARY:
			continue

		var result: Dictionary = (raw_candidate as Dictionary).duplicate(true)
		if result.is_empty():
			continue
		if not bool(result.get("zero_frame_age_up", false)):
			continue

		if gs.player != null:
			var target_year: int = int(result.get("target_year", result.get("year", gs.year)))
			var target_age: int = int(result.get("target_age", result.get("age", gs.player.age)))

			if target_year != int(gs.year):
				continue
			if target_age != int(gs.player.age):
				continue

		return result.duplicate(true)

	return {}


func _request_zero_frame_age_up_cosmetic_finish(result: Dictionary) -> void:
	if result.is_empty():
		return

	if age_up_loading_finish_requested:
		return

	var resolved_result: Dictionary = result.duplicate(true)

	if gs != null and gs.life_engine != null and gs.life_engine.has_method("_ensure_age_up_time_truth_committed"):
		resolved_result = gs.life_engine._ensure_age_up_time_truth_committed(
			resolved_result,
			"main_scene_zero_frame_cosmetic_finish"
		)

	age_up_loading_finish_requested = true
	age_up_loading_result = resolved_result.duplicate(true)
	cached_last_result = resolved_result.duplicate(true)

	set_meta("age_up_loading_zero_frame_result", resolved_result.duplicate(true))
	set_meta("age_up_loading_zero_frame_cosmetic_finish", true)
	set_meta("age_up_zero_frame_post_overlay_result", resolved_result.duplicate(true))
	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("age_up_loading_safe_handoff_queued", false)
	set_meta("age_up_loading_safe_handoff_built", true)
	set_meta("age_up_loading_safe_handoff_rekick_requested", false)
	set_meta("age_up_loading_output_pipeline", {})
	set_meta("age_up_loading_prebuilt_output_bucket", {})
	set_meta("age_up_post_loading_finalize_pending", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

		loading ["completion_state"] = "complete"
		loading ["is_complete"] = true
		loading ["current_phase"] = "complete"
		loading ["session_stage"] = "complete"
		loading ["subline"] = ""
		loading ["final_result"] = resolved_result.duplicate(true)
		loading ["resolved_result"] = resolved_result.duplicate(true)
		loading ["zero_frame_age_up"] = true
		loading ["overlay_was_cosmetic"] = true
		loading ["control_release_priority"] = "ui_first"

		gs.scenario_state ["loading_runtime"] = loading
		gs.scenario_state ["post_runtime_result"] = resolved_result.duplicate(true)
		gs.scenario_state ["last_resolved_age_up_result"] = resolved_result.duplicate(true)
		gs.scenario_state ["age_up_deferred_flush_pending"] = true
		gs.scenario_state ["age_up_deferred_flush_next_ms"] = int(Time.get_ticks_msec()) + 220

		var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {})
		var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
		guard ["zero_frame_age_up"] = true
		guard ["visible_age_up_overlay_is_render_only"] = true
		guard ["age_up_loading_pure_renderer"] = true
		guard ["tail_runtime_after_visible_commit"] = true
		guard ["ui_tail_work_yield_to_input"] = true
		guard ["control_release_priority"] = "ui_first"
		guard ["post_age_up_tail_flush_budget"] = 1
		guard ["post_age_up_tail_flush_interval_ms"] = 220
		guard ["post_age_up_tail_settle_until_ms"] = int(Time.get_ticks_msec()) + 1200
		gs.scenario_state ["runtime_guard"] = guard

	age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 1)

	if age_up_loading_exit_tween == null:
		_begin_age_up_loading_exit_tween()
func _request_age_up_loading_finish(result: Dictionary) -> void:
	_age_up_truth_probe_mark("request_finish_enter", {
		"already_requested": age_up_loading_finish_requested,
		"result_empty": result.is_empty(),
		"result_type": str(result.get("type", ""))
	})

	var resolved_result: Dictionary = result.duplicate(true)

	if resolved_result.is_empty() and not age_up_loading_result.is_empty():
		resolved_result = age_up_loading_result.duplicate(true)

	if resolved_result.is_empty() and not cached_last_result.is_empty():
		resolved_result = cached_last_result.duplicate(true)

	if resolved_result.is_empty() and gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

		var final_raw: Variant = loading.get("final_result", {})
		if typeof(final_raw) == TYPE_DICTIONARY and not (final_raw as Dictionary).is_empty():
			resolved_result = (final_raw as Dictionary).duplicate(true)

		if resolved_result.is_empty():
			var resolved_raw: Variant = loading.get("resolved_result", {})
			if typeof(resolved_raw) == TYPE_DICTIONARY and not (resolved_raw as Dictionary).is_empty():
				resolved_result = (resolved_raw as Dictionary).duplicate(true)

	if resolved_result.is_empty():
		resolved_result = {
			"type": "year_passed",
			"text": "",
			"opps": []
		}

	if gs != null and gs.life_engine != null and gs.life_engine.has_method("_ensure_age_up_time_truth_committed"):
		resolved_result = gs.life_engine._ensure_age_up_time_truth_committed(
			resolved_result,
			"main_scene_request_age_up_loading_finish"
		)

	if age_up_loading_finish_requested:
		_age_up_truth_probe_mark("request_finish_return_already_requested")
		return

	var handoff_already_built: bool = bool(get_meta("age_up_loading_safe_handoff_built", false))
	if handoff_already_built:
		age_up_loading_finish_requested = true
		age_up_loading_result = resolved_result.duplicate(true)
		cached_last_result = resolved_result.duplicate(true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var loading_raw_existing: Variant = gs.scenario_state.get("loading_runtime", {})
			var loading_existing: Dictionary = loading_raw_existing if typeof(loading_raw_existing) == TYPE_DICTIONARY else {}
			loading_existing ["completion_state"] = "complete"
			loading_existing ["is_complete"] = true
			loading_existing ["current_phase"] = "complete"
			loading_existing ["session_stage"] = "complete"
			loading_existing ["final_result"] = resolved_result.duplicate(true)
			gs.scenario_state ["loading_runtime"] = loading_existing

		if age_up_loading_exit_tween == null:
			_begin_age_up_loading_exit_tween()
		return

	age_up_loading_finish_requested = true
	age_up_loading_result = resolved_result.duplicate(true)
	cached_last_result = age_up_loading_result.duplicate(true)

	set_meta("age_up_post_loading_finalize_pending", true)
	set_meta("age_up_loading_safe_handoff_queued", true)
	set_meta("age_up_loading_safe_handoff_built", false)
	set_meta("age_up_loading_safe_handoff_rekick_requested", false)
	set_meta("age_up_loading_prebuilt_output_bucket", {})
	set_meta("age_up_loading_output_pipeline", {})

	var guard_raw: Variant = gs.scenario_state.get("runtime_guard", {}) if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY else {}
	var guard: Dictionary = guard_raw if typeof(guard_raw) == TYPE_DICTIONARY else {}
	var auto_stability_post_loading: bool = bool(guard.get("post_loading_auto_stability", false)) or bool(guard.get("auto_stability_mode", false))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
		loading ["completion_state"] = "complete"
		loading ["is_complete"] = true
		loading ["current_phase"] = "complete"
		loading ["session_stage"] = "complete"
		loading ["final_result"] = age_up_loading_result.duplicate(true)
		loading ["control_release_priority"] = "ui_first" if auto_stability_post_loading else "standard"
		loading ["auto_stability_mode"] = auto_stability_post_loading
		gs.scenario_state ["loading_runtime"] = loading

		gs.scenario_state ["age_up_deferred_flush_pending"] = true
		gs.scenario_state ["age_up_deferred_flush_next_ms"] = 0

	if gs != null and gs.event_bus != null and gs.event_bus.has_method("flush_deferred"):
		gs.event_bus.flush_deferred(1, true)

	_refresh_age_up_loading_text_from_state(true)

	_age_up_truth_probe_mark("before_deferred_show_loading_safe_output")
	_deferred_show_loading_safe_age_up_output(age_up_loading_result.duplicate(true))
	_age_up_truth_probe_mark("after_deferred_show_loading_safe_output")

	var result_type: String = str(age_up_loading_result.get("type", ""))
	var should_queue_rewind_snapshot: bool = gs != null \
and not gs.afterlife_active \
and gs.player != null \
and gs.player.alive \
and result_type != "scenario_prompt" \
and gs.rewind_uses_remaining > 0

	var rewind_pipeline_active_now: bool = false
	if gs != null and gs.has_method("has_pending_rewind_snapshot_pipeline"):
		rewind_pipeline_active_now = bool(gs.has_pending_rewind_snapshot_pipeline())

	var rewind_next_step_ms: int = 0
	if rewind_pipeline_active_now or should_queue_rewind_snapshot:
		var rewind_delay_ms: int = 950 if auto_stability_post_loading else 700
		rewind_next_step_ms = int(Time.get_ticks_msec()) + rewind_delay_ms

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["rewind_snapshot_deferred"] = false

	set_meta("post_age_up_rewind_snapshot_pending", should_queue_rewind_snapshot and not rewind_pipeline_active_now)
	set_meta("post_age_up_rewind_snapshot_pipeline_active", rewind_pipeline_active_now)
	set_meta("post_age_up_rewind_snapshot_next_step_ms", rewind_next_step_ms)

	age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 3 if auto_stability_post_loading else 2)

	if age_up_loading_overlay == null or not age_up_loading_overlay.visible:
		_age_up_truth_probe_mark("request_finish_overlay_missing_force_exit")
		_on_age_up_loading_exit_finished()
func _age_up_loading_visible_year_landed() -> bool:
	if gs == null:
		return false

	var start_year: int = int(get_meta("age_up_loading_locked_start_year", -999999))
	var start_age: int = int(get_meta("age_up_loading_locked_start_age", -999999))
	var target_year: int = int(get_meta("age_up_loading_locked_target_year", -999999))

	var year_locked_active: bool = false
	if "year_locked" in gs:
		year_locked_active = bool(gs.year_locked)

	var year_landed: bool = false
	if year_locked_active:
		year_landed = true
	elif target_year != -999999:
		year_landed = int(gs.year) >= target_year
	elif start_year != -999999:
		year_landed = int(gs.year) > start_year

	var age_landed: bool = false
	if gs.player != null and start_age != -999999:
		age_landed = int(gs.player.age) > start_age

	if year_locked_active and start_age != -999999:
		return age_landed

	if target_year != -999999 and start_age != -999999:
		return year_landed and age_landed

	if start_year != -999999 and start_age != -999999:
		return year_landed and age_landed

	if target_year != -999999 or start_year != -999999:
		return year_landed

	return age_landed
func _age_up_loading_runtime_ready_to_release() -> bool:
	if gs == null:
		return false
	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return false
	if bool(gs.scenario_state.get("year_in_progress", false)):
		return false

	var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
	var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

	if str(loading.get("completion_state", "")).strip_edges() != "complete":
		return false
	if not bool(loading.get("is_complete", false)):
		return false
	if str(loading.get("current_phase", "")).strip_edges() != "complete":
		return false

	var visible_handoff_built: bool = bool(get_meta("age_up_loading_safe_handoff_built", false))
	var ui_first_released: bool = bool(get_meta("age_up_loading_ui_first_released", false))

	if gs.life_engine != null and gs.life_engine.runtime_engine != null and gs.life_engine.runtime_engine.has_method("has_active_runtime_slice"):
		if bool(gs.life_engine.runtime_engine.has_active_runtime_slice()) and not visible_handoff_built and not ui_first_released:
			return false

	var pending_deferred: int = 0
	if gs.event_bus != null and gs.event_bus.has_method("get_pending_deferred_delivery_count"):
		pending_deferred = int(gs.event_bus.get_pending_deferred_delivery_count())



	if pending_deferred > 0 and not visible_handoff_built and not ui_first_released:
		return false

	return true
func _age_up_loading_has_year_result_ready() -> bool:
	if gs == null:
		return false
	if not _age_up_loading_runtime_ready_to_release():
		return false

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

		var final_raw: Variant = loading.get("final_result", {})
		if typeof(final_raw) == TYPE_DICTIONARY and not (final_raw as Dictionary).is_empty():
			return true

		var resolved_raw: Variant = loading.get("resolved_result", {})
		if typeof(resolved_raw) == TYPE_DICTIONARY and not (resolved_raw as Dictionary).is_empty():
			return true

		var post_raw: Variant = gs.scenario_state.get("post_runtime_result", {})
		if typeof(post_raw) == TYPE_DICTIONARY and not (post_raw as Dictionary).is_empty():
			return true

	return false
func _age_up_loading_runtime_step_due(current_phase: String, loading_session_stage: String, visible_elapsed_ms: int) -> bool:
	var now_ms: int = int(Time.get_ticks_msec())
	var next_step_ms: int = int(get_meta("age_up_loading_runtime_next_step_ms", 0))

	if next_step_ms > 0 and now_ms < next_step_ms:
		return false

	var previous_step_ms: int = int(get_meta("age_up_loading_last_runtime_step_ms", 0))
	var interval_ms: int = 8

	if previous_step_ms >= 24:
		interval_ms = 48
	elif previous_step_ms >= 16:
		interval_ms = 32
	elif previous_step_ms >= 10:
		interval_ms = 16

	var clean_phase: String = str(current_phase).strip_edges().to_lower()
	var clean_stage: String = str(loading_session_stage).strip_edges().to_lower()

	if clean_phase == "commit_settling" or clean_stage in ["settling_previous_year", "settling_current_year"]:
		interval_ms = max(interval_ms, 16)

	if visible_elapsed_ms < 240:
		interval_ms = max(interval_ms, 16)

	set_meta("age_up_loading_runtime_next_step_ms", now_ms + interval_ms)
	return true


func _age_up_loading_ui_runtime_budget_contract(current_phase: String, loading_session_stage: String, visible_elapsed_ms: int, requested_phase_budget: int, requested_commit_budget: int) -> Dictionary:
	var clean_phase: String = str(current_phase).strip_edges().to_lower()
	var clean_stage: String = str(loading_session_stage).strip_edges().to_lower()

	var phase_cap: int = 1
	var commit_cap: int = 6

	if clean_phase == "commit_settling" or clean_stage in ["settling_previous_year", "settling_current_year"]:
		commit_cap = 8

	if visible_elapsed_ms >= 900:
		commit_cap = min(commit_cap + 2, 10)

	if visible_elapsed_ms >= 1800 and _age_up_loading_visible_year_landed():
		commit_cap = min(commit_cap + 2, 12)

	return {
		"phase_budget": clamp(int(requested_phase_budget), 1, phase_cap),
		"commit_budget": clamp(int(requested_commit_budget), 1, commit_cap),
		"ui_frame_budget_ms": 8,
		"policy": "visible_age_up_overlay_ui_first"
	}
func _should_release_age_up_loading_ui_first(current_phase: String, loading_session_stage: String, visible_elapsed_ms: int) -> bool:
	if bool(get_meta("age_up_loading_ui_first_released", false)):
		return false
	if age_up_loading_finish_requested:
		return false
	if not _age_up_loading_visible_year_landed():
		return false
	if visible_elapsed_ms < 120:
		return false
	if not _age_up_loading_has_year_result_ready():
		return false

	var clean_phase: String = str(current_phase).strip_edges().to_lower()
	var clean_stage: String = str(loading_session_stage).strip_edges().to_lower()

	if clean_phase == "complete":
		return true
	if clean_stage == "complete":
		return true

	if clean_stage in ["settling_current_year", "settling_previous_year"] and visible_elapsed_ms >= 360:
		return true

	if clean_phase in [
		"commit_settling",
		"year_budget_pipeline_commit",
		"narrative_and_presentation",
		"choice_and_opportunity_surfacing",
		"internal_identity_drift",
		"background_tail_flush",
		"world_tail_streaming"
	] and visible_elapsed_ms >= 420:
		return true

	return false


func _build_age_up_loading_ui_first_result(_reason: String = "visible_year_landed") -> Dictionary:
	var display_result: Dictionary = {}

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

		var final_raw: Variant = loading.get("final_result", {})
		if typeof(final_raw) == TYPE_DICTIONARY and not (final_raw as Dictionary).is_empty():
			display_result = (final_raw as Dictionary).duplicate(true)

		if display_result.is_empty():
			var resolved_raw: Variant = loading.get("resolved_result", {})
			if typeof(resolved_raw) == TYPE_DICTIONARY and not (resolved_raw as Dictionary).is_empty():
				display_result = (resolved_raw as Dictionary).duplicate(true)

		if display_result.is_empty():
			var post_raw: Variant = gs.scenario_state.get("post_runtime_result", {})
			if typeof(post_raw) == TYPE_DICTIONARY and not (post_raw as Dictionary).is_empty():
				display_result = (post_raw as Dictionary).duplicate(true)

	if display_result.is_empty():
		display_result = age_up_loading_result.duplicate(true)

	if display_result.is_empty():
		display_result = cached_last_result.duplicate(true)

	if display_result.is_empty():
		return {}

	return display_result

func _force_age_up_loading_ui_first_release(
	reason: String = "visible_year_landed",
	current_phase: String = ""
) -> void:
	if bool(
		get_meta(
			"age_up_loading_ui_first_released",
			false
		)
	):
		return

	var display_result: Dictionary = (
		_build_age_up_loading_ui_first_result(
			reason
		)
	)

	if display_result.is_empty():
		_age_up_truth_probe_mark(
			"ui_first_release_blocked_waiting_for_real_result",
			{
				"reason": reason,
				"current_phase": current_phase,
				"year": (
					int(
						gs.year
					)
					if gs != null
					else -1
				),
				"age": (
					int(
						gs.player.age
					)
					if (
						gs != null
						and gs.player != null
					)
					else -1
				)
			}
		)
		return

	set_meta(
		"age_up_loading_ui_first_released",
		true
	)

	set_meta(
		"age_up_loading_ui_first_release_reason",
		reason
	)

	_age_up_truth_probe_mark(
		"ui_first_release_enter",
		{
			"reason": reason,
			"current_phase": current_phase,
			"year": (
				int(
					gs.year
				)
				if gs != null
				else -1
			),
			"age": (
				int(
					gs.player.age
				)
				if (
					gs != null
					and gs.player != null
				)
				else -1
			),
		}
	)

	var tail_pending: bool = false

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		tail_pending = bool(
			gs.scenario_state.get(
				"age_up_tail_runtime_pending",
				false
			)
		)




		var loading_raw: Variant = (
			gs.scenario_state.get(
				"loading_runtime",
				{}
			)
		)

		var loading: Dictionary = (
			(loading_raw as Dictionary).duplicate(false)
			if typeof(
				loading_raw
			) == TYPE_DICTIONARY
			else {}
		)

		loading [
			"completion_state"
		] = "complete"

		loading [
			"is_complete"
		] = true

		loading [
			"current_phase"
		] = "complete"

		loading [
			"session_stage"
		] = "presentation_released"

		loading [
			"subline"
		] = ""

		loading [
			"final_result"
		] = display_result.duplicate(false)

		loading [
			"resolved_result"
		] = display_result.duplicate(false)

		loading [
			"ui_first_release"
		] = true

		loading [
			"ui_first_release_reason"
		] = reason

		loading [
			"tail_runtime_pending"
		] = tail_pending

		loading [
			"presentation_complete"
		] = true

		loading [
			"simulation_complete"
		] = not tail_pending

		loading [
			"renderer_completed_simulation"
		] = false

		gs.scenario_state [
			"loading_runtime"
		] = loading

		gs.scenario_state [
			"age_up_ui_first_release_preserved_tail"
		] = tail_pending

		gs.scenario_state [
			"age_up_ui_first_release_renderer_completed_simulation"
		] = false

	set_meta(
		"age_up_loading_output_pipeline",
		{}
	)

	set_meta(
		"age_up_loading_safe_handoff_queued",
		false
	)

	set_meta(
		"age_up_loading_safe_handoff_built",
		true
	)

	set_meta(
		"age_up_loading_safe_handoff_rekick_requested",
		false
	)

	set_meta(
		"age_up_loading_finish_wait_started_ms",
		0
	)

	age_up_loading_result = (
		display_result.duplicate(false)
	)

	age_up_loading_finish_requested = true
	age_up_loading_paint_hold_frames = 0




	set_meta(
		"age_up_zero_frame_visible_result",
		display_result.duplicate(false)
	)

	set_meta(
		"age_up_zero_frame_visible_result_pending_observation",
		true
	)

	_refresh_age_up_loading_text_from_state(
		false
	)

	if age_up_loading_exit_tween == null:
		_begin_age_up_loading_exit_tween()
func _force_age_up_loading_safe_handoff_fallback(reason: String = "timeout") -> void:
	_age_up_truth_probe_mark("safe_handoff_fallback_enter", {
		"reason": reason
	})

	var display_result: Dictionary = age_up_loading_result.duplicate(true)
	if display_result.is_empty():
		display_result = cached_last_result.duplicate(true)

	if display_result.is_empty():
		display_result = {
			"type": "year_passed",
			"text": "Another year passed.",
			"reason": reason
		}

	set_meta("age_up_loading_output_pipeline", {})
	set_meta("age_up_loading_safe_handoff_queued", false)
	set_meta("age_up_loading_safe_handoff_built", true)
	set_meta("age_up_loading_safe_handoff_force_reason", reason)
	set_meta("age_up_loading_safe_handoff_rekick_requested", false)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
		loading ["completion_state"] = "complete"
		loading ["is_complete"] = true
		loading ["current_phase"] = "complete"
		loading ["session_stage"] = "complete"
		loading ["final_result"] = display_result.duplicate(true)
		loading ["control_release_priority"] = "ui_first"
		loading ["handoff_force_reason"] = reason
		gs.scenario_state ["loading_runtime"] = loading

	_show_age_up_output(display_result, false, "post_loading_finalize")
	age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 1)

	if age_up_loading_exit_tween == null:
		_age_up_truth_probe_mark("safe_handoff_fallback_begin_exit_tween")
		_begin_age_up_loading_exit_tween()
func _deferred_show_loading_safe_age_up_output(result: Dictionary) -> void:
	if bool(get_meta("age_up_loading_safe_output_worker_active", false)):
		set_meta("age_up_loading_safe_output_worker_needs_rerun", true)
		return

	set_meta("age_up_loading_safe_output_worker_active", true)
	set_meta("age_up_loading_safe_output_worker_needs_rerun", false)

	var display_result: Dictionary = result.duplicate(true)
	if display_result.is_empty():
		display_result = age_up_loading_result.duplicate(true)
	if display_result.is_empty():
		display_result = cached_last_result.duplicate(true)

	if display_result.is_empty():
		display_result = {
			"type": "year_passed",
			"text": "",
			"opps": []
		}

	var immediate_type: String = str(display_result.get("type", ""))
	if immediate_type == "player_line_birth_naming_form":
		_show_age_up_output(display_result, false, "post_loading_finalize")
		set_meta("age_up_loading_safe_handoff_queued", false)
		set_meta("age_up_loading_safe_handoff_built", true)
		set_meta("age_up_loading_output_pipeline", {})
		set_meta("age_up_loading_safe_output_worker_active", false)
		age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 2)
		return

	while true:
		var bucket_raw: Variant = get_meta("age_up_loading_output_pipeline", {})
		var bucket: Dictionary = bucket_raw if typeof(bucket_raw) == TYPE_DICTIONARY else {}

		if bucket.is_empty():
			bucket = _build_loading_safe_age_up_output_bucket(display_result)

		var handoff_step_budget: int = 18
		var handoff_pass_limit: int = 1

		if age_up_loading_runtime_active:
			handoff_step_budget = 42
			handoff_pass_limit = 2

			var visible_elapsed_ms: int = max(0, int(Time.get_ticks_msec()) - int(age_up_loading_visible_started_ms))
			if visible_elapsed_ms >= 320:
				handoff_step_budget = 64
				handoff_pass_limit = 3

		var handoff_passes: int = 0
		while handoff_passes < handoff_pass_limit and not bool(bucket.get("is_complete", false)):
			bucket = _step_loading_safe_age_up_output_bucket(bucket, handoff_step_budget)
			handoff_passes += 1

		set_meta("age_up_loading_output_pipeline", bucket.duplicate(true))

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
			var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}

			if bool(bucket.get("is_complete", false)):
				loading ["completion_state"] = "complete"
				loading ["is_complete"] = true
				loading ["current_phase"] = "complete"
				loading ["session_stage"] = "complete"
				loading ["subline"] = ""
				loading ["final_result"] = display_result.duplicate(true)
			else:
				loading ["completion_state"] = "running"
				loading ["is_complete"] = false
				loading ["current_phase"] = "narrative_and_presentation"
				loading ["session_stage"] = "settling_current_year"

				match str(bucket.get("stage", "pending_deaths")):
					"pending_deaths":
						loading ["subline"] = "Sorting deaths and personal fallout..."
					"world_feed":
						loading ["subline"] = "Weaving world events into the diary..."
					"result_tail", "complete":
						loading ["subline"] = "Pulling the next turn into view..."
					_:
						loading ["subline"] = "Locking the new year into place..."

			gs.scenario_state ["loading_runtime"] = loading

		_refresh_age_up_loading_text_from_state(false)

		if bool(bucket.get("is_complete", false)):
			set_meta("age_up_loading_output_pipeline", {})
			set_meta("age_up_loading_prebuilt_output_bucket", {
				"result_type": str(bucket.get("rtype", "")),
				"lines": bucket.get("lines", []).duplicate(true),
				"world_feed_cursor": int(bucket.get("world_feed_cursor", diary_world_feed_cursor))
			})

			_show_age_up_output(display_result, false, "post_loading_finalize")

			set_meta("age_up_loading_prebuilt_output_bucket", {})
			set_meta("age_up_loading_safe_handoff_queued", false)
			set_meta("age_up_loading_safe_handoff_built", true)
			age_up_loading_paint_hold_frames = max(age_up_loading_paint_hold_frames, 2)
			break

		if not age_up_loading_finish_requested or bool(get_meta("age_up_loading_safe_handoff_built", false)):
			break

		if is_inside_tree():
			await get_tree().process_frame
		else:
			break

	set_meta("age_up_loading_safe_output_worker_active", false)

	if bool(get_meta("age_up_loading_safe_output_worker_needs_rerun", false)):
		set_meta("age_up_loading_safe_output_worker_needs_rerun", false)
		if age_up_loading_finish_requested and not bool(get_meta("age_up_loading_safe_handoff_built", false)):
			call_deferred("_deferred_show_loading_safe_age_up_output", display_result.duplicate(true))



func _begin_age_up_loading_exit_tween() -> void:
	if age_up_loading_overlay == null or not age_up_loading_overlay.visible:
		_on_age_up_loading_exit_finished()
		return
	if age_up_loading_exit_tween != null:
		return
	var border_theme: Dictionary = MainSceneHelpers._era_border_theme_data(MainSceneLogic._era_border_theme_key_from_world(gs))
	var tint: Color = border_theme.get("core", Color(1.0, 1.0, 1.0, 1.0))
	age_up_loading_exit_started_ms = Time.get_ticks_msec()
	age_up_loading_exit_tween = create_tween()
	age_up_loading_exit_tween.set_trans(Tween.TRANS_SINE)
	age_up_loading_exit_tween.set_ease(Tween.EASE_IN_OUT)
	if age_up_loading_ring != null:
		age_up_loading_exit_tween.parallel().tween_property(
			age_up_loading_ring,
			"scale",
			Vector2(1.18, 1.18),
			0.18
		)
	if age_up_loading_flash != null:
		age_up_loading_flash.color = Color(tint.r, tint.g, tint.b, 0.0)
		age_up_loading_exit_tween.parallel().tween_property(
			age_up_loading_flash,
			"color",
			Color(tint.r, tint.g, tint.b, 0.22),
			0.14
		)
		age_up_loading_exit_tween.parallel().tween_property(
			age_up_loading_flash,
			"color",
			Color(tint.r, tint.g, tint.b, 0.0),
			0.28
		)
	age_up_loading_exit_tween.parallel().tween_property(
		age_up_loading_overlay,
		"modulate",
		Color(1.0, 1.0, 1.0, 0.0),
		0.3
	)
	age_up_loading_exit_tween.tween_callback(Callable(self, "_on_age_up_loading_exit_finished"))
func _complete_age_up_tail_runtime_result(result: Dictionary, reason: String = "tail_runtime_complete") -> void:
	if result.is_empty():
		return

	if str(result.get("type", "")).strip_edges() == "year_pipeline_pending":
		return

	cached_last_result = result.duplicate(true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["age_up_tail_runtime_pending"] = false
		gs.scenario_state.erase("age_up_tail_runtime_next_ms")
		gs.scenario_state.erase("age_up_tail_runtime_started_ms")
		gs.scenario_state.erase("age_up_tail_runtime_reason")
		gs.scenario_state ["age_up_deferred_flush_pending"] = true
		gs.scenario_state ["age_up_deferred_flush_next_ms"] = 0

		var loading_raw: Variant = gs.scenario_state.get("loading_runtime", {})
		var loading: Dictionary = loading_raw if typeof(loading_raw) == TYPE_DICTIONARY else {}
		loading ["completion_state"] = "complete"
		loading ["is_complete"] = true
		loading ["current_phase"] = "complete"
		loading ["session_stage"] = "complete"
		loading ["tail_runtime_pending"] = false
		loading ["tail_runtime_complete_reason"] = reason
		loading ["final_result"] = result.duplicate(true)
		loading ["resolved_result"] = result.duplicate(true)
		gs.scenario_state ["loading_runtime"] = loading

	_show_age_up_output(result, false, "tail_runtime_complete")
	call_deferred("_scroll_life_diary_to_bottom")

func _arm_zero_frame_age_up_visible_observation_service() -> void:
	var tree:= Engine.get_main_loop() as SceneTree

	if tree == null:
		set_meta(
			"age_up_visible_observation_service_tree_missing",
			true
		)
		return

	var callback:= Callable(
		self,
		"_drive_zero_frame_age_up_visible_observation_process_frame"
	)

	if tree.process_frame.is_connected(
		callback
	):
		set_meta(
			"age_up_visible_observation_service_active",
			true
		)
		return

	tree.process_frame.connect(
		callback,
		CONNECT_ONE_SHOT
	)

	set_meta(
		"age_up_visible_observation_service_active",
		true
	)
	set_meta(
		"age_up_visible_observation_service_requires_input_idle",
		false
	)
	set_meta(
		"age_up_visible_observation_service_engine_calls",
		false
	)
	set_meta(
		"age_up_visible_observation_service_uses_call_deferred",
		false
	)


func _drive_zero_frame_age_up_visible_observation_process_frame() -> void:
	var tree:= Engine.get_main_loop() as SceneTree
	var callback:= Callable(
		self,
		"_drive_zero_frame_age_up_visible_observation_process_frame"
	)




	if (
		tree != null
		and tree.process_frame.is_connected(
			callback
		)
	):
		tree.process_frame.disconnect(
			callback
		)

	set_meta(
		"age_up_visible_observation_service_active",
		false
	)

	if bool(
		get_meta(
			"age_up_zero_frame_visible_result_pending_observation",
			false
		)
	):
		_service_zero_frame_age_up_visible_observation()
		return



	if bool(
		get_meta(
			"age_up_temporal_intent_active",
			false
		)
	):
		_arm_zero_frame_age_up_visible_observation_service()


func _service_zero_frame_age_up_visible_observation() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var visible_raw: Variant = get_meta(
		"age_up_zero_frame_visible_result",
		{}
	)

	if typeof(visible_raw) != TYPE_DICTIONARY:
		set_meta(
			"age_up_zero_frame_visible_result_pending_observation",
			false
		)
		return

	var visible_result: Dictionary = (
		visible_raw as Dictionary
	)

	var target_year: int = int(
		visible_result.get(
			"year",
			visible_result.get(
				"target_year",
				gs.year
			)
		)
	)

	var target_age: int = int(
		visible_result.get(
			"age",
			visible_result.get(
				"target_age",
				gs.player.age
			)
		)
	)



	var year_line: String = _format_year(
		target_year
	)

	var age_line: String = (
		"Age: %d"
		% target_age
	)

	var body_text: String = (
		MainSceneHelpers._compact_diary_text(
			str(
				visible_result.get(
					"text",
					""
				)
			)
		)
	)

	var incoming_body: Array = []

	if body_text != "":
		incoming_body.append(
			body_text
		)

	var merged: bool = false
	var appended_body: Array = []

	for index in range(
		age_up_diary_entries.size() - 1,
		-1,
		-1
	):
		var entry_raw: Variant = (
			age_up_diary_entries [
				index
			]
		)

		if typeof(entry_raw) != TYPE_ARRAY:
			continue

		var entry_lines: Array = (
			(entry_raw as Array).duplicate(
				false
			)
		)

		if entry_lines.size() < 2:
			continue

		if (
			MainSceneHelpers._life_diary_year_header_text(
				str(
					entry_lines [0]
				)
			) != year_line
			or str(
				entry_lines [1]
			).strip_edges() != age_line
		):
			continue

		for raw_body in incoming_body:
			var body_line: String = str(
				raw_body
			)

			if not entry_lines.has(
				body_line
			):
				entry_lines.append(
					body_line
				)

				appended_body.append(
					body_line
				)

		age_up_diary_entries [
			index
		] = entry_lines

		merged = true
		break

	if not merged:
		var next_entry: Array = [
			year_line,
			age_line
		]

		for raw_body in incoming_body:
			var body_line: String = str(
				raw_body
			)

			next_entry.append(
				body_line
			)

			appended_body.append(
				body_line
			)




		age_up_diary_entries.append(
			next_entry
		)

	set_meta(
		"life_diary_loaded_owner_id",
		int(
			gs.player.id
		)
	)
	set_meta(
		"life_diary_render_cached_signature",
		""
	)
	set_meta(
		"life_diary_render_cached_lines",
		[]
	)

	var visible_life_lens: bool = (
		output_label != null
		and is_instance_valid(
			output_label
		)
		and output_label.visible
		and current_panel in [
			"",
			"life"
		]
	)

	if visible_life_lens:
		output_label.bbcode_enabled = true
		output_label.scroll_active = true
		output_label.mouse_filter = (
			Control.MOUSE_FILTER_PASS
		)

		_install_life_diary_touchpad_scroll_contract(
			"age_up_visible_observation"
		)




		_detach_life_diary_focus_spacer(
			output_label
		)

		var latest_visible_focus_line: int = -1

		if not merged:
			output_label.append_text(
				"\n"
			)

		_append_formatted_life_diary_line(
			output_label,
			year_line
		)

		_append_formatted_life_diary_line(
			output_label,
			age_line
		)




		latest_visible_focus_line = maxi(
			0,
			output_label.get_paragraph_count() - 2
		)

		for raw_body in appended_body:
			_append_formatted_life_diary_line(
				output_label,
				str(
					raw_body
				)
			)



		_attach_life_diary_focus_spacer(
			output_label
		)

		output_label.set_meta(
			"life_diary_render_signature",
			""
		)

		if latest_visible_focus_line >= 0:
			set_meta(
				"life_diary_latest_visible_focus_line",
				latest_visible_focus_line
			)
			set_meta(
				"life_diary_latest_visible_focus_line_valid",
				true
			)

		_request_life_diary_focus_latest_year(
			"zero_frame_age_up_visible_observation"
		)

	var post_commit_surface_raw: Variant = (
		visible_result.get(
			"post_commit_surface",
			{}
		)
	)

	if typeof(
		post_commit_surface_raw
	) == TYPE_DICTIONARY:
		var post_commit_surface: Dictionary = (
			post_commit_surface_raw as Dictionary
		)

		if not post_commit_surface.is_empty():
			var post_commit_type: String = str(
				post_commit_surface.get(
					"type",
					""
				)
			).strip_edges()

			if (
				post_commit_type
				== "player_line_birth_naming_form"
			):
				_show_player_line_birth_naming_popup(
					post_commit_surface
				)
			else:
				set_meta(
					"age_up_post_commit_surface_contract",
					post_commit_surface.duplicate(
						false
					)
				)
				set_meta(
					"age_up_post_commit_surface_pending_observation",
					true
				)

	set_meta(
		"age_up_zero_frame_visible_result_pending_observation",
		false
	)
	set_meta(
		"age_up_zero_frame_visible_result_projected_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"age_up_visible_observation_engine_calls",
		false
	)
	set_meta(
		"age_up_visible_observation_world_iteration",
		false
	)
	set_meta(
		"age_up_visible_observation_history_replaced",
		false
	)
	set_meta(
		"age_up_visible_observation_focus_spacer_republished",
		visible_life_lens
	)
	set_meta(
		"age_up_visible_observation_current_year",
		target_year
	)
	set_meta(
		"age_up_visible_observation_current_age",
		target_age
	)
