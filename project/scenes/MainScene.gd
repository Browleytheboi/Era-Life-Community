func _apply_pending_situation_bank_report_to_player_stats_overlay(result: Dictionary, active_actor_id: int = -1) -> void:
	if typeof(result) != TYPE_DICTIONARY:
		return

	var bank_report: Dictionary = MainSceneLogic._pending_situation_bank_report_from_result(result)
	if bank_report.is_empty():
		return

	var actor_id: int = int(bank_report.get("actor_id", active_actor_id))
	if actor_id <= 0:
		actor_id = active_actor_id

	if gs == null or gs.player == null or actor_id != int(gs.player.id):
		return

	var bank_delta: int = int(bank_report.get("bank_delta", 0))
	if bank_delta == 0:
		return

	var new_balance: int = int(bank_report.get("new_balance", bank_report.get("balance", int(gs.player.bank_balance))))
	var previous_balance: int = int(bank_report.get("previous_balance", new_balance - bank_delta))
	previous_balance = max(0, previous_balance)
	new_balance = max(0, new_balance)

	_queue_player_stats_bank_delta_effect(bank_delta, previous_balance, new_balance, {
		"source": "pending_situation_bank_report",
		"contract_id": str(result.get("contract_id", result.get("source_contract_id", ""))),
		"mode": str(result.get("mode", "pending_situation_resolution"))
	})


func _queue_player_stats_bank_delta_effect(bank_delta: int, previous_balance: int, new_balance: int, context: Dictionary = {}) -> void:
	if gs == null or gs.player == null:
		return

	_ensure_player_stats_overlay()
	if player_stats_overlay == null:
		return

	var safe_previous: int = max(0, int(previous_balance))
	var safe_new: int = max(0, int(new_balance))
	var safe_delta: int = int(bank_delta)

	player_stats_bank_display_value = float(safe_previous)
	player_stats_bank_target = float(safe_new)

	player_stats_overlay.set_meta("player_stats_bank_force_animate_delta", true)
	player_stats_overlay.set_meta("player_stats_bank_delta_amount", safe_delta)
	player_stats_overlay.set_meta("player_stats_bank_delta_previous", safe_previous)
	player_stats_overlay.set_meta("player_stats_bank_delta_target", safe_new)
	player_stats_overlay.set_meta("player_stats_bank_delta_started_at_ms", int(Time.get_ticks_msec()))
	player_stats_overlay.set_meta("player_stats_bank_delta_context", context.duplicate(true))

	if player_stats_bank_label != null:
		player_stats_bank_label.text = _format_player_stats_bank_amount(safe_previous)
		player_stats_bank_label.set_meta("player_stats_bank_visual_signature", "")

	_spawn_player_stats_bank_delta_label(safe_delta)
	_update_player_stats_overlay()


func _spawn_player_stats_bank_delta_label(bank_delta: int) -> void:
	if player_stats_bank_label == null or not is_instance_valid(player_stats_bank_label):
		return

	var effect_parent: Node = _player_stats_bank_delta_effect_parent()
	if effect_parent == null or not is_instance_valid(effect_parent):
		return

	var effect_label:= Label.new()
	effect_label.name = "PlayerStatsBankDeltaEffect"
	effect_label.text = _format_player_stats_signed_bank_delta(bank_delta)
	effect_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	effect_label.z_as_relative = false
	effect_label.z_index = 920
	effect_label.add_theme_font_size_override("font_size", 34)
	effect_label.add_theme_color_override("font_color", Color(1.0, 0.92, 0.62, 1.0))
	effect_label.add_theme_color_override("font_shadow_color", Color(1.0, 0.72, 0.16, 0.72))
	effect_label.add_theme_constant_override("shadow_outline_size", 8)
	effect_label.add_theme_constant_override("shadow_offset_x", 0)
	effect_label.add_theme_constant_override("shadow_offset_y", 0)

	effect_parent.add_child(effect_label)

	var bank_rect: Rect2 = player_stats_bank_label.get_global_rect()
	var start_position: Vector2 = bank_rect.position + Vector2(-18.0, -58.0)
	var mid_position: Vector2 = bank_rect.position + Vector2(-10.0, -88.0)
	var end_position: Vector2 = bank_rect.position + Vector2(8.0, -4.0)

	effect_label.global_position = start_position
	effect_label.scale = Vector2.ONE * 0.65
	effect_label.modulate = Color(1.0, 1.0, 1.0, 0.0)

	var tween:= create_tween()
	tween.set_parallel(false)
	tween.tween_property(effect_label, "modulate:a", 1.0, 0.1)
	tween.parallel().tween_property(effect_label, "scale", Vector2.ONE * 1.24, 0.18).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(effect_label, "global_position", mid_position, 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(effect_label, "global_position", end_position, 0.42).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	tween.parallel().tween_property(effect_label, "scale", Vector2.ONE * 0.38, 0.42).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	tween.parallel().tween_property(effect_label, "modulate:a", 0.0, 0.42)
	tween.tween_callback(effect_label.queue_free)
func _player_stats_bank_delta_effect_parent() -> Node:
	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		var overlay_parent: Node = player_stats_overlay.get_parent()
		if overlay_parent != null and is_instance_valid(overlay_parent):
			return overlay_parent

	var candidate_paths: Array = [
		"HUDLayer",
		"CanvasLayer",
		"UILayer",
		"UIRoot",
		"RootUI",
		"MainUI",
		"OverlayLayer",
		"RuntimeHUDLayer",
		"PlayerStatsOverlayLayer"
	]

	for raw_path in candidate_paths:
		var path_text: String = str(raw_path).strip_edges()
		if path_text == "":
			continue

		var candidate: Node = get_node_or_null(path_text)
		if candidate != null and is_instance_valid(candidate):
			return candidate

	var tree: SceneTree = get_tree()
	if tree != null:
		var grouped_nodes: Array = []
		grouped_nodes.append_array(tree.get_nodes_in_group("hud_layer"))
		grouped_nodes.append_array(tree.get_nodes_in_group("ui_root"))
		grouped_nodes.append_array(tree.get_nodes_in_group("overlay_layer"))
		grouped_nodes.append_array(tree.get_nodes_in_group("runtime_hud_layer"))

		for raw_node in grouped_nodes:
			if raw_node is Node and is_instance_valid(raw_node):
				return raw_node

	return self

func _format_player_stats_signed_bank_delta(bank_delta: int) -> String:
	var prefix_text: String = "+" if bank_delta >= 0 else "-"
	return "%s%s" % [prefix_text, _format_player_stats_bank_amount(abs(int(bank_delta)))]
func _on_pending_situations_button_pressed() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	_ensure_popup_viewer()

	if (
		popup_viewer == null
		or not is_instance_valid(
			popup_viewer
		)
	):
		return

	var actor_id: int = (
		MainSceneLogic._pending_situations_controlled_actor_id(gs)
	)
	var payload_by_actor: Dictionary = {}

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
