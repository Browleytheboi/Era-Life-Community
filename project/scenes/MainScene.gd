func _crown_diplomacy_entry_matches_filter(
	entry: Dictionary,
	filter_key: String
) -> bool:
	if entry.is_empty():
		return false

	var clean_filter: String = str(
		filter_key
	).strip_edges().to_lower()

	if clean_filter in [
		"",
		"all"
	]:
		return true

	var realm_kind: String = str(
		entry.get(
			"realm_kind",
			""
		)
	).strip_edges().to_lower()
	var government_style: String = str(
		entry.get(
			"government_style",
			""
		)
	).strip_edges().to_lower()
	var country_name: String = str(
		entry.get(
			"country",
			""
		)
	).strip_edges().to_lower()
	var relation_score: int = int(
		entry.get(
			"relation_score",
			0
		)
	)

	match clean_filter:
		"elemental":
			return bool(
				entry.get(
					"is_elemental_realm",
					false
				)
			)

		"empires":
			return (
				realm_kind.find(
					"empire"
				) >= 0
				or government_style.find(
					"empire"
				) >= 0
				or country_name.find(
					"empire"
				) >= 0
			)

		"kingdoms":
			return (
				realm_kind.find(
					"kingdom"
				) >= 0
				or government_style.find(
					"kingdom"
				) >= 0
				or country_name.find(
					"kingdom"
				) >= 0
			)

		"republics":
			return (
				realm_kind.find(
					"republic"
				) >= 0
				or government_style.find(
					"republic"
				) >= 0
				or government_style.find(
					"presidential"
				) >= 0
			)

		"allies":
			return (
				not bool(
					entry.get(
						"is_player_country",
						false
					)
				)
				and relation_score >= 25
			)

		"neutral":
			return (
				not bool(
					entry.get(
						"is_player_country",
						false
					)
				)
				and relation_score >= -24
				and relation_score <= 24
			)

		"strained":
			return relation_score <= -25

		"war":
			return bool(
				entry.get(
					"in_active_war",
					false
				)
			)

		"tradable":
			return bool(
				entry.get(
					"can_trade",
					false
				)
			)

		"era_kingdom":
			return bool(
				entry.get(
					"is_era_kingdom",
					false
				)
			)

	return true


func _filter_crown_diplomacy_country_entries(
	entries: Array
) -> Array:
	var out: Array = []

	for raw_entry in entries:
		var entry: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_entry
		)

		if (
			not entry.is_empty()
			and _crown_diplomacy_entry_matches_filter(
				entry,
				crown_hub_diplomacy_filter_key
			)
		):
			out.append(
				entry
			)

	return out


func _set_crown_diplomacy_card_focus(
		entry_key: String
) -> void:
		var clean_key: String = str(
			entry_key
		).strip_edges()

		if crown_hub_diplomacy_selected_entry_key == clean_key:
			clean_key = ""

		crown_hub_diplomacy_selected_entry_key = clean_key

		for raw_key in crown_hub_diplomacy_card_registry.keys():
			var registry_key: String = str(
				raw_key
			)
			var packet: Dictionary = MainSceneHelpers._safe_dictionary(
				crown_hub_diplomacy_card_registry.get(
					raw_key,
					{}
				)
			)
			var shell:= packet.get(
				"shell",
				null
			) as Control
			var bloom:= packet.get(
				"bloom",
				null
			) as Control
			var selected: bool = (
				clean_key != ""
				and registry_key == clean_key
			)

			if (
				shell != null
				and is_instance_valid(
					shell
				)
			):
				shell.modulate = (
					Color.WHITE
					if (
						clean_key == ""
						or selected
					)
					else Color(
						0.32,
						0.32,
						0.38,
						0.24
					)
				)
				shell.z_index = (
					40
					if selected
					else 0
				)

			if (
				bloom != null
				and is_instance_valid(
					bloom
				)
			):
				bloom.visible = selected
				bloom.mouse_filter = (
					Control.MOUSE_FILTER_STOP
					if selected
					else Control.MOUSE_FILTER_IGNORE
				)

		if clean_key == "":
			if crown_hub_status_label != null:
				crown_hub_status_label.text = (
					"Diplomacy: choose a realm card."
				)
			return

		var selected_packet: Dictionary = (
			MainSceneHelpers._safe_dictionary(
				crown_hub_diplomacy_card_registry.get(
					clean_key,
					{}
				)
			)
		)
		var selected_entry: Dictionary = (
			MainSceneHelpers._safe_dictionary(
				selected_packet.get(
					"entry",
					{}
				)
			)
		)

		if crown_hub_status_label != null:
			crown_hub_status_label.text = (
				"Diplomacy: %s selected."
				% str(
					selected_entry.get(
						"country",
						"Realm"
					)
				)
			)

		var population_browse_available: bool = bool(
			selected_entry.get(
				"population_browse_available",
				false
			)
		)
		var population_realm_id: int = int(
			selected_entry.get(
				"population_realm_id",
				selected_entry.get(
					"realm_id",
					-1
				)
			)
		)
		var population_realm_name: String = str(
			selected_entry.get(
				"population_realm_name",
				selected_entry.get(
					"country",
					""
				)
			)
		).strip_edges()

		if (
			population_browse_available
			and population_realm_id > 0
		):
			call_deferred(
				"_queue_realm_population_truth_observation",
				population_realm_id,
				population_realm_name,
				(
					"crown_diplomacy_"
					+ "selected_realm_population_arm"
				)
			)

			set_meta(
				"crown_diplomacy_population_arm_realm_id",
				population_realm_id
			)
			set_meta(
				"crown_diplomacy_population_arm_engine_calls_on_press",
				false
			)
			set_meta(
				"crown_diplomacy_population_arm_build_on_press",
				false
			)
func _apply_crown_diplomacy_filter_and_sort() -> void:
		if crown_hub_diplomacy_grid == null:
			return

		var raw_entries: Variant = get_meta(
			"crown_diplomacy_stream_entries",
			[]
		)
		var all_entries: Array = (
			raw_entries
			if typeof(raw_entries) == TYPE_ARRAY
			else []
		)
		var visible_entries: Array = (
			_sort_crown_diplomacy_country_entries(
				_filter_crown_diplomacy_country_entries(
					all_entries
				)
			)
		)
		var visible_keys: Dictionary = {}
		var visible_index: int = 0

		for raw_entry in visible_entries:
			var entry: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_entry
			)
			var entry_key: String = (
				MainSceneHelpers._crown_diplomacy_entry_key(
					entry
				)
			)

			if entry_key == "":
				continue

			visible_keys [
				entry_key
			] = true

			var packet: Dictionary = MainSceneHelpers._safe_dictionary(
				crown_hub_diplomacy_card_registry.get(
					entry_key,
					{}
				)
			)

			_ensure_crown_you_rule_here_banner_for_card(
				packet
			)

			var shell:= packet.get(
				"shell",
				null
			) as Control

			if (
				shell == null
				or not is_instance_valid(
					shell
				)
			):
				continue

			shell.visible = true
			crown_hub_diplomacy_grid.move_child(
				shell,
				visible_index
			)
			visible_index += 1

		for raw_key in crown_hub_diplomacy_card_registry.keys():
			var entry_key: String = str(
				raw_key
			)
			var packet: Dictionary = MainSceneHelpers._safe_dictionary(
				crown_hub_diplomacy_card_registry.get(
					raw_key,
					{}
				)
			)

			_ensure_crown_you_rule_here_banner_for_card(
				packet
			)

			var shell:= packet.get(
				"shell",
				null
			) as Control

			if (
				shell != null
				and is_instance_valid(
					shell
				)
				and not visible_keys.has(
					entry_key
				)
			):
				shell.visible = false

		if (
			crown_hub_diplomacy_selected_entry_key != ""
			and not visible_keys.has(
				crown_hub_diplomacy_selected_entry_key
			)
		):
			_set_crown_diplomacy_card_focus(
				""
			)

		for raw_key in crown_hub_diplomacy_filter_button_registry.keys():
			var button:= (
				crown_hub_diplomacy_filter_button_registry.get(
					raw_key,
					null
				) as Button
			)

			if (
				button == null
				or not is_instance_valid(
					button
				)
			):
				continue

			var base_label: String = str(
				button.get_meta(
					"crown_diplomacy_base_label",
					raw_key
				)
			)

			button.text = (
				(
					"✓ "
					if str(raw_key) == crown_hub_diplomacy_filter_key
					else ""
				)
				+ base_label
			)

		for raw_key in crown_hub_diplomacy_sort_button_registry.keys():
			var button:= (
				crown_hub_diplomacy_sort_button_registry.get(
					raw_key,
					null
				) as Button
			)

			if (
				button == null
				or not is_instance_valid(
					button
				)
			):
				continue

			var base_label: String = str(
				button.get_meta(
					"crown_diplomacy_base_label",
					raw_key
				)
			)

			button.text = (
				(
					"✓ "
					if str(raw_key) == crown_hub_diplomacy_sort_key
					else ""
				)
				+ base_label
			)

		if crown_hub_status_label != null:
			crown_hub_status_label.text = (
				"Diplomacy: %d of %d realms visible."
				% [
					visible_entries.size(),
					all_entries.size()
				]
			)
