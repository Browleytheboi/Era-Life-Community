func _append_crown_country_diplomacy_row(
	entry: Dictionary,
	permissions: Dictionary
) -> void:
	if (
		crown_hub_diplomacy_grid == null
		or not is_instance_valid(
			crown_hub_diplomacy_grid
		)
	):
		return

	var country_name: String = str(
		entry.get(
			"country",
			"Unknown Country"
		)
	).strip_edges()

