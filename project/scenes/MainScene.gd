func _on_reality_intake_panel_request_command(
	envelope: Dictionary
) -> void:
	if (
		gs == null
		or not gs.has_method(
			"queue_command_envelope"
		)
	):
		return

	var routed: Dictionary = (
		envelope.duplicate(true)
	)
	routed ["auto_drain"] = true

	var drain_report: Dictionary = (
		gs.queue_command_envelope(
			routed
		)
	)
	var report: Dictionary = (
		MainSceneHelpers._first_handled_command_report(
			drain_report
		)
	)

	if (
		reality_intake_panel != null
		and is_instance_valid(
			reality_intake_panel
		)
	):
		reality_intake_panel.apply_command_report(
			report
		)

	if bool(
		report.get(
			"close_network_surface",
			false
		)
	):
		_close_reality_intake_panel()
		return

	if str(
		report.get(
			"action_id",
			""
		)
	) == "browse_community_realities":
		if (
			reality_intake_panel != null
			and is_instance_valid(
				reality_intake_panel
			)
			and reality_intake_panel.has_method(
				"set_active_network_section"
			)
		):
			reality_intake_panel.set_active_network_section(
				"community_realities"
			)

	var command_id: String = str(
		routed.get(
			"command",
			""
		)
	).strip_edges().to_lower()

	if command_id.begins_with("search."):
		return

	if typeof(
		report.get(
			"surface_contract",
			{}
		)
	) == TYPE_DICTIONARY:
		var returned_surface: Dictionary = (
			report.get(
				"surface_contract",
				{}
			) as Dictionary
		).duplicate(true)

		if (
			not returned_surface.is_empty()
			and reality_intake_panel != null
			and is_instance_valid(
				reality_intake_panel
			)
		):
			reality_intake_panel.render_contract(
				returned_surface
			)
			return

	var refresh_required: bool = (
		command_id.begins_with(
			"eralife_network."
		)
		or command_id.begins_with(
			"connection_graph."
		)
		or command_id.begins_with(
			"profile."
		)
		or command_id.begins_with(
			"network_notes."
		)
		or command_id.begins_with(
			"public_feed."
		)
		or command_id.begins_with(
			"reality_stream."
		)
		or command_id.begins_with(
			"life_account_transfer."
		)
		or command_id.begins_with(
			"mailbox."
		)
		or command_id.begins_with(
			"messenger."
		)
		or command_id.begins_with(
			"self_host_network."
		)
	)

	if not refresh_required:
		return

	var refresh_drain: Dictionary = (
		gs.queue_command_envelope({
			"command": (
