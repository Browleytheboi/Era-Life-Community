func _relationship_profile_prepare_action_button(button: Button) -> void:
	if button == null or not is_instance_valid(button):
		return

	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.focus_mode = Control.FOCUS_ALL

	if bool(button.get_meta("relationship_profile_core_button", false)):
		return

	if not button.has_meta("relationship_profile_action_id"):
		return

	var action_id: String = str(button.get_meta("relationship_profile_action_id", ""))
	var target_id: int = int(button.get_meta("relationship_profile_target_id", -1))

	if target_id <= 0:
		target_id = _relationship_profile_active_target_id()
		button.set_meta("relationship_profile_target_id", target_id)

	var pressed_callable: Callable = Callable(self, "_on_relationship_browser_action_pressed").bind(action_id, target_id)
	if not button.pressed.is_connected(pressed_callable):
		button.pressed.connect(pressed_callable)

	var gui_callable: Callable = Callable(self, "_on_relationship_profile_action_button_gui_input").bind(action_id, target_id)
	if not button.gui_input.is_connected(gui_callable):
		button.gui_input.connect(gui_callable)


func _relationship_profile_prepare_button_tree(root: Node) -> void:
	if root == null or not is_instance_valid(root):
		return

	for raw_child in root.get_children():
		if raw_child is ScrollContainer:
			var scroll_child:= raw_child as ScrollContainer
			_install_zero_frame_touchpad_scroll_contract(scroll_child, "relationship_profile_prepare_button_tree")
			_relationship_profile_prepare_button_tree(raw_child)
			continue

		if raw_child is Button:
			_relationship_profile_prepare_action_button(raw_child as Button)
		elif raw_child is RichTextLabel:
			var rich_child:= raw_child as RichTextLabel
			rich_child.mouse_filter = Control.MOUSE_FILTER_PASS
			rich_child.scroll_active = false
		elif raw_child is Control:
			var control_child:= raw_child as Control
			if control_child != relationship_profile_popup_card and control_child != relationship_profile_popup:
				if control_child.mouse_filter == Control.MOUSE_FILTER_IGNORE:
					control_child.mouse_filter = Control.MOUSE_FILTER_PASS

		_relationship_profile_prepare_button_tree(raw_child)
func _refresh_entity_relationship_profile_scroll_lens(reason: String = "entity_relationship_profile_scroll_lens") -> void:
	if entity_relationship_profile_identity_scroll != null and is_instance_valid(entity_relationship_profile_identity_scroll):
		_install_zero_frame_touchpad_scroll_contract(entity_relationship_profile_identity_scroll, "%s_identity_panel" % reason)

	if entity_relationship_profile_profile != null and is_instance_valid(entity_relationship_profile_profile):
		entity_relationship_profile_profile.mouse_filter = Control.MOUSE_FILTER_PASS
		entity_relationship_profile_profile.scroll_active = false
		entity_relationship_profile_profile.fit_content = true

	if entity_relationship_profile_stats_scroll != null and is_instance_valid(entity_relationship_profile_stats_scroll):
		_install_zero_frame_touchpad_scroll_contract(entity_relationship_profile_stats_scroll, "%s_vitals_panel" % reason)

	if entity_relationship_profile_stats != null and is_instance_valid(entity_relationship_profile_stats):
		entity_relationship_profile_stats.mouse_filter = Control.MOUSE_FILTER_PASS

	if entity_relationship_profile_action_scroll != null and is_instance_valid(entity_relationship_profile_action_scroll):
		_install_zero_frame_touchpad_scroll_contract(entity_relationship_profile_action_scroll, "%s_actions_panel" % reason)

	if entity_relationship_profile_actions != null and is_instance_valid(entity_relationship_profile_actions):
		entity_relationship_profile_actions.mouse_filter = Control.MOUSE_FILTER_PASS
func _refresh_relationship_profile_scroll_lens(reason: String = "relationship_profile_scroll_lens") -> void:
	if relationship_profile_popup_profile_scroll != null and is_instance_valid(relationship_profile_popup_profile_scroll):
		_install_zero_frame_touchpad_scroll_contract(relationship_profile_popup_profile_scroll, "%s_profile_panel" % reason)

	if relationship_profile_popup_actions_scroll != null and is_instance_valid(relationship_profile_popup_actions_scroll):
		_install_zero_frame_touchpad_scroll_contract(relationship_profile_popup_actions_scroll, "%s_actions_panel" % reason)

	if relationship_profile_popup_profile != null and is_instance_valid(relationship_profile_popup_profile):
		relationship_profile_popup_profile.mouse_filter = Control.MOUSE_FILTER_PASS
		relationship_profile_popup_profile.scroll_active = false

	if relationship_profile_popup_actions != null and is_instance_valid(relationship_profile_popup_actions):
		relationship_profile_popup_actions.mouse_filter = Control.MOUSE_FILTER_PASS

	if relationship_profile_popup != null and is_instance_valid(relationship_profile_popup):
		relationship_profile_popup.set_meta("relationship_profile_scroll_lens_refreshed", true)
		relationship_profile_popup.set_meta("relationship_profile_scroll_lens_refreshed_reason", reason)
		relationship_profile_popup.set_meta("relationship_profile_scrollbar_click_required", false)
func _prioritize_relationship_profile_popup_layer() -> void:
	if relationship_profile_popup == null or not is_instance_valid(relationship_profile_popup):
		return

	relationship_profile_popup.visible = true
	relationship_profile_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	relationship_profile_popup.focus_mode = Control.FOCUS_ALL
	relationship_profile_popup.z_as_relative = false
	relationship_profile_popup.z_index = 1300

	if relationship_profile_popup_dim != null and is_instance_valid(relationship_profile_popup_dim):
		relationship_profile_popup_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		relationship_profile_popup_dim.z_as_relative = true
		relationship_profile_popup_dim.z_index = 0

	if relationship_profile_popup_card != null and is_instance_valid(relationship_profile_popup_card):
		relationship_profile_popup_card.mouse_filter = Control.MOUSE_FILTER_STOP
		relationship_profile_popup_card.z_as_relative = true
		relationship_profile_popup_card.z_index = 20

	if relationship_profile_popup_actions != null and is_instance_valid(relationship_profile_popup_actions):
		relationship_profile_popup_actions.mouse_filter = Control.MOUSE_FILTER_PASS

	if relationship_profile_popup_title != null and is_instance_valid(relationship_profile_popup_title):
		relationship_profile_popup_title.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if relationship_profile_popup_status != null and is_instance_valid(relationship_profile_popup_status):
		relationship_profile_popup_status.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var active_target: Person = _relationship_profile_active_target()
	if active_target != null and _relationship_profile_header_needs_repair(active_target):
		var active_target_alive: bool = bool(active_target.alive) and float(active_target.health) > 0.0
		_relationship_profile_ensure_switch_button_surfaced(active_target, active_target_alive)

	_relationship_profile_bind_core_button_input()
	_relationship_profile_prepare_button_tree(relationship_profile_popup)
	_refresh_relationship_profile_scroll_lens("prioritize_relationship_profile_popup_layer")

	var profile_parent:= relationship_profile_popup.get_parent()
	if profile_parent != null:
		profile_parent.move_child(relationship_profile_popup, profile_parent.get_child_count() - 1)

	_bring_modal_to_front(relationship_profile_popup)

func _show_relationship_profile_popup(
	target: Person
) -> void:
	if (
		target == null
		or gs == null
		or gs.player == null
	):
		return

	var target_id: int = int(
		target.id
	)
	var contract_cache_raw: Variant = get_meta(
		"relationship_profile_contract_by_target",
		{}
	)
	var contract_cache: Dictionary = (
		contract_cache_raw as Dictionary
		if typeof(contract_cache_raw) == TYPE_DICTIONARY
		else {}
	)
	var profile_contract_raw: Variant = contract_cache.get(
		str(target_id),
		{}
	)
	var profile_contract: Dictionary = (
		profile_contract_raw as Dictionary
		if typeof(profile_contract_raw) == TYPE_DICTIONARY
		else {}
	)





	_on_relationship_hub_full_profile_pressed(
		target_id,
		target,
		profile_contract
	)
func _relationship_profile_prepared_switch_packet_for_target_id(
	target_id: int,
	incoming_packet: Dictionary
) -> Dictionary:
	if target_id <= 0:
		return {}

	var candidates: Array = []

	candidates.append(
		MainSceneHelpers._safe_dictionary(
			incoming_packet
		)
	)
	candidates.append(
		_resident_profile_switch_packet_for_actor_id(
			target_id
		)
	)

	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		var panel_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			relationship_profile_panel.active_contract
		)

		candidates.append(
			MainSceneHelpers._safe_dictionary(
				panel_contract.get(
					"switch_packet",
					{}
				)
			)
		)

	var contract_cache_raw: Variant = get_meta(
		"relationship_profile_contract_by_target",
		{}
	)
	var contract_cache: Dictionary = (
		(contract_cache_raw as Dictionary).duplicate(false)
		if typeof(contract_cache_raw) == TYPE_DICTIONARY
		else {}
	)
	var cached_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		contract_cache.get(
			str(target_id),
			{}
		)
	)

	candidates.append(
		MainSceneHelpers._safe_dictionary(
			cached_contract.get(
				"switch_packet",
				{}
			)
		)
	)

	for raw_candidate in candidates:
		var candidate: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_candidate
		)



		if not _relationship_profile_switch_packet_core_hot(
			candidate,
			target_id
		):
			continue

		_clear_relationship_profile_switch_destination_upgrade_request(
			target_id,
			"universal_switch_core_packet_observed_by_switch_press"
		)

		set_meta(
			"relationship_profile_switch_press_readiness_authority",
			"UniversalSwitchContractEngine"
		)
		set_meta(
			"relationship_profile_switch_press_support_deck_required",
			false
		)
		set_meta(
			"relationship_profile_switch_press_build_performed",
			false
		)

		return candidate.duplicate(false)

	set_meta(
		"relationship_profile_switch_rejected_waiting_for_core_packet",
		true
	)
	set_meta(
		"relationship_profile_switch_waiting_target_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_waiting_build_on_press",
		false
	)
	set_meta(
		"relationship_profile_switch_waiting_ready_gate_member",
		false
	)
	set_meta(
		"relationship_profile_switch_press_requeued_upgrade_intent",
		false
	)
	set_meta(
		"relationship_profile_switch_press_readiness_authority",
		"UniversalSwitchContractEngine"
	)

	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		relationship_profile_panel.set_status(
			(
				"This viewpoint's UniversalSwitch pointer core "
				+ "is not observable yet. No switch work was run on press."
			)
		)

	return {}
func _on_relationship_profile_panel_switch_requested(
	target_id: int,
	switch_packet: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var current_actor_id: int = int(
		gs.player.id
	)




	if current_actor_id == target_id:
		_hide_relationship_modal_stack_visual_only_for_zero_frame_switch()
		_force_relationship_switch_base_life_shell_lens_visible_now(
			gs.player,
			"relationship_profile_duplicate_release_ignored"
		)
		return

	var switch_started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var claimed_target_id: int = int(
		get_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
	)
	var claimed_at_ms: int = int(
		get_meta(
			"relationship_profile_switch_input_claimed_at_ms",
			0
		)
	)

	if (
		claimed_target_id == target_id
		and switch_started_at_ms - claimed_at_ms < 750
	):
		return

	set_meta(
		"relationship_profile_switch_input_claimed_target_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_input_claimed_at_ms",
		switch_started_at_ms
	)
	set_meta(
		"relationship_profile_switch_committed_on_button_down",
		true
	)




	var target: Person = (
		_relationship_profile_cached_target_for_id(
			target_id
		)
	)

	if target == null:
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.set_status(
				"That prepared life is no longer observable."
			)

		set_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
		return

	var prepared_packet: Dictionary = (
		_relationship_profile_prepared_switch_packet_for_target_id(
			target_id,
			switch_packet
		)
	)

	if (
		not prepared_packet.is_empty()
		and relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
		and relationship_profile_panel.has_method(
			"install_resident_switch_packet"
		)
	):
		relationship_profile_panel.install_resident_switch_packet(
			prepared_packet
		)

	var prepared_surface_raw: Variant = prepared_packet.get(
		"surface_contract",
		{}
	)
	var prepared_surface: Dictionary = (
		prepared_surface_raw as Dictionary
		if typeof(prepared_surface_raw) == TYPE_DICTIONARY
		else {}
	)
	var prepared_main_tab_deck_raw: Variant = (
		prepared_packet.get(
			"main_tab_surface_contracts",
			prepared_surface.get(
				"main_tab_surface_contracts",
				{}
			)
		)
	)
	var prepared_main_tab_deck: Dictionary = (
		prepared_main_tab_deck_raw as Dictionary
		if typeof(
			prepared_main_tab_deck_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if (
		prepared_packet.is_empty()
		or prepared_surface.is_empty()
	):
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			var waiting_for_authority_packet: bool = (
				bool(
					get_meta(
						"relationship_profile_switch_rejected_waiting_for_complete_packet",
						false
					)
				)
				and int(
					get_meta(
						"relationship_profile_switch_waiting_target_id",
						-1
					)
				) == target_id
			)

			if waiting_for_authority_packet:
				relationship_profile_panel.set_status(
					(
						"This viewpoint is still preparing its "
						+ "UniversalSwitch destination packet. "
						+ "No switch work was run on press."
					)
				)
			else:
				relationship_profile_panel.set_status(
					(
						"This viewpoint was not prepared with the "
						+ "relationship surface. No switch was attempted."
					)
				)

		set_meta(
			"relationship_profile_switch_rejected_missing_packet",
			true
		)
		set_meta(
			"relationship_profile_switch_press_engine_calls",
			false
		)
		set_meta(
			"relationship_profile_switch_press_build_performed",
			false
		)
		set_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
		return

	if int(
		prepared_surface.get(
			"actor_id",
			-1
		)
	) != target_id:
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.set_status(
				"The prepared viewpoint belongs to another life."
			)

		set_meta(
			"relationship_profile_switch_rejected_actor_mismatch",
			true
		)
		set_meta(
			"relationship_profile_switch_press_engine_calls",
			false
		)
		set_meta(
			"relationship_profile_switch_press_build_performed",
			false
		)
		set_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
		return

	var pointer_revision: String = str(
		prepared_packet.get(
			"pointer_revision",
			prepared_surface.get(
				"pointer_revision",
				""
			)
		)
	).strip_edges()

	if pointer_revision == "":
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.set_status(
				"That viewpoint no longer has a prepared pointer revision."
			)

		set_meta(
			"relationship_profile_switch_rejected_missing_pointer_revision",
			true
		)
		set_meta(
			"relationship_profile_switch_press_build_performed",
			false
		)
		set_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
		return

	var previous_actor_id: int = current_actor_id
	var prepared_actor_name: String = str(
		prepared_packet.get(
			"actor_name",
			prepared_surface.get(
				"actor_name",
				""
			)
		)
	).strip_edges()






	set_meta(
		"relationship_profile_switch_press_support_lookup_forbidden",
		true
	)
	set_meta(
		"relationship_profile_switch_press_support_lookup_skipped",
		true
	)
	set_meta(
		"relationship_profile_switch_press_main_tab_install_skipped",
		true
	)
	set_meta(
		"relationship_profile_switch_press_only_commits_pointer",
		true
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"relationship_profile_switch_press_support_lookup_forbidden"
		] = true
		gs.scenario_state [
			"relationship_profile_switch_press_support_lookup_skipped"
		] = true
		gs.scenario_state [
			"relationship_profile_switch_press_main_tab_install_skipped"
		] = true
		gs.scenario_state [
			"relationship_profile_switch_press_only_commits_pointer"
		] = true
	var target_renderer_deck_hot: bool = (
		_resident_main_tab_renderer_deck_is_hot(
			target_id
		)
	)
	var prepared_pointer_core_hot: bool = (
		_relationship_profile_switch_packet_core_hot(
			prepared_packet,
			target_id
		)
	)
	var support_deck_pending: bool = (
		not target_renderer_deck_hot
	)

	set_meta(
		"relationship_profile_switch_target_renderer_deck_hot",
		target_renderer_deck_hot
	)
	set_meta(
		"relationship_profile_switch_target_renderer_deck_actor_id",
		target_id
	)
	set_meta(
		"relationship_profile_switch_target_renderer_deck_build_on_press",
		false
	)
	set_meta(
		"relationship_profile_switch_pointer_core_hot",
		prepared_pointer_core_hot
	)
	set_meta(
		"relationship_profile_switch_support_deck_pending",
		support_deck_pending
	)
	set_meta(
		"relationship_profile_switch_rejected_before_control_pointer_commit",
		false
	)
	set_meta(
		"relationship_profile_switch_support_deck_blocks_control_pointer",
		false
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"relationship_profile_switch_pointer_core_hot"
		] = prepared_pointer_core_hot
		gs.scenario_state [
			"relationship_profile_switch_support_deck_pending"
		] = support_deck_pending
		gs.scenario_state [
			"relationship_profile_switch_support_deck_blocks_control_pointer"
		] = false
		gs.scenario_state [
			"relationship_profile_switch_target_renderer_deck_hot"
		] = target_renderer_deck_hot
		gs.scenario_state [
			"relationship_profile_switch_target_renderer_deck_actor_id"
		] = target_id


	_hide_relationship_modal_stack_visual_only_for_zero_frame_switch()

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": previous_actor_id,
			"target_id": target_id,
			"intent_type": "switch_person",
			"surface_id": "relationship_profile_panel",
			"action_id": "switch_to_character",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"payload": {
				"actor_id": target_id,
				"target_id": target_id,
				"prepared_actor_id": target_id,
				"prepared_actor_name": prepared_actor_name,
				"pointer_revision": pointer_revision,
				"main_tab_surface_deck_hot": target_renderer_deck_hot,
				"actor_lens_bundle_hot": prepared_pointer_core_hot,
				"viewpoint_pointer_hot": prepared_pointer_core_hot,
				"support_deck_pending": support_deck_pending,
				"support_deck_blocks_switch": false,
				"press_frame_build_forbidden": true,
				"hidden_surface_projection_policy": (
					"prepared_packet_swap"
				),
				"source": "mainscene.relationship_profile_panel",
				"ready_gate_member": false,
				"ui_is_renderer_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "universal_switch_contract_engine",
				"method": "commit_profile_switch_intent",
				"pass_actor_payload": true,
				"actor_id": target_id
			},
			"source": "mainscene.relationship_profile_panel"
		},
		{
			"actor_id": previous_actor_id,
			"target_id": target_id,
			"source": "mainscene.relationship_profile_panel",
			"surface_id": "relationship_profile_panel",
			"action_id": "switch_to_character",
			"immutable_contract_references": true,
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"skip_checks_and_balances": true,
			"authority_prevalidated": true,
			"ready_gate_member": false
		}
	)
	var route_result: Dictionary = _contract_route_result(
		report
	)

	if not bool(
		route_result.get(
			"success",
			false
		)
	):

		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.visible = true
			relationship_profile_panel.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			relationship_profile_panel.set_status(
				str(
					route_result.get(
						"reason",
						"Switch truth could not be committed."
					)
				)
			)
			_bring_modal_to_front(
				relationship_profile_panel
			)

		relationship_profile_popup_open = true
		set_meta(
			"relationship_profile_switch_input_claimed_target_id",
			-1
		)
		return

	var committed_result_raw: Variant = route_result.get(
		"result",
		{}
	)
	var committed_result: Dictionary = (
		committed_result_raw as Dictionary
		if typeof(committed_result_raw) == TYPE_DICTIONARY
		else {}
	)
	relationship_profile_popup_open = false

	var actor_renderer_page_swapped: bool = (
		_activate_resident_main_tab_renderer_deck_for_actor(
			target_id,
			"relationship_profile_native_panel_switch"
		)
	)

	if not actor_renderer_page_swapped:
		_detach_actor_scoped_renderer_bindings_for_control_switch(
			target_id,
			"relationship_profile_native_panel_switch_activation_failed"
		)
		set_meta(
			"relationship_profile_switch_committed_but_renderer_deck_failed",
			true
		)
		set_meta(
			"relationship_profile_switch_old_actor_renderer_reuse_forbidden",
			true
		)

	var committed_packet: Dictionary = prepared_packet
	var visible_lens_applied: bool = (
		_apply_relationship_profile_switch_visible_lens_from_packet_now(
			target,
			committed_packet,
			committed_result,
			"relationship_profile_native_panel_switch"
		)
	)

	if not visible_lens_applied:
		_force_relationship_switch_base_life_shell_lens_visible_now(
			target,
			"relationship_profile_committed_packet_invalid"
		)
		set_meta(
			"relationship_profile_switch_committed_packet_invalid",
			true
		)
		return

	_apply_committed_relationship_switch_lens_now(
		target,
		previous_actor_id,
		committed_result,
		"relationship_profile_native_panel_switch"
	)

	_schedule_relationship_profile_switch_tail_after_visible_lens(
		target_id,
		previous_actor_id,
		committed_result,
		"relationship_profile_native_panel_switch_tail"
	)

	set_meta(
		"relationship_profile_switch_actor_renderer_page_swapped",
		actor_renderer_page_swapped
	)

	var committed_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var switch_duration_ms: int = maxi(
		0,
		committed_at_ms - switch_started_at_ms
	)

	set_meta(
		"relationship_profile_native_switch_zero_frame",
		true
	)
	set_meta(
		"relationship_profile_native_switch_actor_id",
		target_id
	)
	set_meta(
		"relationship_profile_native_switch_used_ticket",
		false
	)
	set_meta(
		"relationship_profile_native_switch_used_viewer_packet",
		true
	)
	set_meta(
		"relationship_profile_native_switch_packet_stayed_renderer_local",
		true
	)
	set_meta(
		"relationship_profile_native_switch_packet_entered_global_intent",
		false
	)
	set_meta(
		"relationship_profile_native_switch_crr_observation_skipped",
		true
	)
	set_meta(
		"relationship_profile_native_switch_global_persistence_skipped",
		true
	)
	set_meta(
		"relationship_profile_native_switch_checks_and_balances_prevalidated",
		true
	)
	set_meta(
		"relationship_profile_native_switch_projection_rebind_after_paint",
		false
	)
	set_meta(
		"relationship_profile_native_switch_prepared_main_tab_deck",
		not prepared_main_tab_deck.is_empty()
	)
	set_meta(
		"relationship_profile_native_switch_deep_copy_performed",
		false
	)
	set_meta(
		"relationship_profile_native_switch_nonvisible_work_deferred",
		true
	)
	set_meta(
		"relationship_profile_native_switch_modal_hidden_before_intent_route",
		true
	)
	set_meta(
		"relationship_profile_native_switch_duration_ms",
		switch_duration_ms
	)
	set_meta(
		"relationship_profile_native_switch_at_ms",
		committed_at_ms
	)

	EraLog.truth(
		"ERALIFE_RELATIONSHIP_SWITCH_VISIBLE_TRUTH"
		+ "|target_id=" + str(target_id)
		+ "|previous_actor_id=" + str(previous_actor_id)
		+ "|modal_hidden_before_route=true"
		+ "|button_down_commit=true"
		+ "|packet_local=true"
		+ "|main_tab_deck_hot="
		+ str(
			not prepared_main_tab_deck.is_empty()
		).to_lower()
		+ "|global_persistence=false"
		+ "|checks_prevalidated=true"
		+ "|press_frame_build=false"
		+ "|duration_ms=" + str(switch_duration_ms)
		+ "|at_ms=" + str(committed_at_ms)
	)
func _control_switch_support_surface_packet_validation_report(
	packet: Dictionary,
	target_id: int
) -> Dictionary:
	var report: Dictionary = {
		"valid": false,
		"reason": "uninspected",
		"actor_id": int(
			packet.get(
				"actor_id",
				-1
			)
		),
		"target_id": target_id,
		"schema": str(
			packet.get(
				"schema",
				""
			)
		),
		"main_tab_count": 0,
		"missing_tabs": [],
		"wrong_actor_tabs": [],
		"pointer_only_tabs": [],
		"main_tab_surface_deck_hot": bool(
			packet.get(
				"main_tab_surface_deck_hot",
				false
			)
		),
		"support_surfaces_hot": bool(
			packet.get(
				"support_surfaces_hot",
				false
			)
		)
	}

	if target_id <= 0:
		report ["reason"] = "invalid_target_id"
		return report

	if packet.is_empty():
		report ["reason"] = "empty_packet"
		return report

	if str(
		packet.get(
			"schema",
			""
		)
	) != "eralife.control_switch.support_surface_packet":
		report ["reason"] = "schema_mismatch"
		return report

	if int(
		packet.get(
			"actor_id",
			-1
		)
	) != target_id:
		report ["reason"] = "actor_id_mismatch"
		return report

	var main_tab_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		packet.get(
			"main_tab_surface_contracts",
			{}
		)
	)
	report ["main_tab_count"] = main_tab_deck.size()

	if main_tab_deck.is_empty():
		report ["reason"] = "main_tab_deck_empty"
		return report

	for raw_tab_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var tab_id: String = str(
			raw_tab_id
		)
		var tab_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			main_tab_deck.get(
				tab_id,
				{}
			)
		)

		if tab_contract.is_empty():
			report ["missing_tabs"].append(
				tab_id
			)
			continue

		if int(
			tab_contract.get(
				"actor_id",
				-1
			)
		) != target_id:
			report ["wrong_actor_tabs"].append(
				tab_id
			)
			continue

		var schema: String = str(
			tab_contract.get(
				"schema",
				""
			)
		).strip_edges().to_lower()
		var truth_state: String = str(
			tab_contract.get(
				"truth_state",
				""
			)
		).strip_edges().to_lower()

		if (
			schema == "eralife.pointer_only.destination_tab_contract"
			or truth_state == "pointer_only_resident_shell"
			or bool(
				tab_contract.get(
					"pointer_only",
					false
				)
			)
		):
			report ["pointer_only_tabs"].append(
				tab_id
			)

	if not MainSceneHelpers._safe_array(
		report.get(
			"missing_tabs",
			[]
		)
	).is_empty():
		report ["reason"] = "missing_required_main_tabs"
		return report

	if not MainSceneHelpers._safe_array(
		report.get(
			"wrong_actor_tabs",
			[]
		)
	).is_empty():
		report ["reason"] = "main_tab_actor_mismatch"
		return report

	if not MainSceneHelpers._safe_array(
		report.get(
			"pointer_only_tabs",
			[]
		)
	).is_empty():
		report ["reason"] = "pointer_only_tabs_are_not_render_surfaces"
		return report

	report ["valid"] = true
	report ["reason"] = "renderable_support_packet"
	return report
func _cache_resident_control_switch_support_surface_packet_reference(
	packet: Dictionary,
	target_id: int,
	source: String
) -> void:
	if (
		gs == null
		or target_id <= 0
		or packet.is_empty()
	):
		return

	var validation: Dictionary = (
		_control_switch_support_surface_packet_validation_report(
			packet,
			target_id
		)
	)

	if not bool(
		validation.get(
			"valid",
			false
		)
	):
		EraLog.truth(
			"SUPPORT_PACKET_REFERENCE_REJECTED"
			+ "|actor_id=" + str(target_id)
			+ "|source=" + source
			+ "|reason=" + str(validation.get("reason", "unknown"))
			+ "|schema=" + str(validation.get("schema", ""))
			+ "|packet_actor_id=" + str(validation.get("actor_id", -1))
			+ "|main_tab_count=" + str(validation.get("main_tab_count", 0))
			+ "|missing_tabs=" + str(validation.get("missing_tabs", []))
			+ "|wrong_actor_tabs=" + str(validation.get("wrong_actor_tabs", []))
			+ "|pointer_only_tabs=" + str(validation.get("pointer_only_tabs", []))
			+ "|build_on_switch=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var actor_key: String = str(target_id)
	var registry: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"resident_control_switch_support_surface_packet_by_actor",
			{}
		)
	)
	var observable_registry: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"observable_control_switch_support_surface_packet_by_actor",
			{}
		)
	)

	registry [
		actor_key
	] = packet.duplicate(false)
	observable_registry [
		actor_key
	] = packet.duplicate(false)

	gs.scenario_state [
		"resident_control_switch_support_surface_packet_by_actor"
	] = registry
	gs.scenario_state [
		"observable_control_switch_support_surface_packet_by_actor"
	] = observable_registry
	gs.scenario_state [
		"resident_control_switch_support_surface_packet_renderer_reference_actor_id"
	] = target_id
	gs.scenario_state [
		"resident_control_switch_support_surface_packet_renderer_reference_source"
	] = source
	gs.scenario_state [
		"resident_control_switch_support_surface_packet_renderer_reference_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	gs.scenario_state [
		"resident_control_switch_support_surface_packet_renderer_reference_is_truth_owner"
	] = false

	if (
		reality_residency_host_game_state != null
		and reality_residency_host_game_state != gs
	):
		if typeof(
			reality_residency_host_game_state.scenario_state
		) != TYPE_DICTIONARY:
			reality_residency_host_game_state.scenario_state = {}

		var host_registry: Dictionary = MainSceneHelpers._safe_dictionary(
			reality_residency_host_game_state.scenario_state.get(
				"resident_control_switch_support_surface_packet_by_actor",
				{}
			)
		)
		var host_observable_registry: Dictionary = MainSceneHelpers._safe_dictionary(
			reality_residency_host_game_state.scenario_state.get(
				"observable_control_switch_support_surface_packet_by_actor",
				{}
			)
		)

		host_registry [
			actor_key
		] = packet.duplicate(false)
		host_observable_registry [
			actor_key
		] = packet.duplicate(false)

		reality_residency_host_game_state.scenario_state [
			"resident_control_switch_support_surface_packet_by_actor"
		] = host_registry
		reality_residency_host_game_state.scenario_state [
			"observable_control_switch_support_surface_packet_by_actor"
		] = host_observable_registry
		reality_residency_host_game_state.scenario_state [
			"resident_control_switch_support_surface_packet_renderer_reference_actor_id"
		] = target_id
		reality_residency_host_game_state.scenario_state [
			"resident_control_switch_support_surface_packet_renderer_reference_source"
		] = source
		reality_residency_host_game_state.scenario_state [
			"resident_control_switch_support_surface_packet_renderer_reference_is_truth_owner"
		] = false

	EraLog.truth(
		"SUPPORT_PACKET_REFERENCE_CACHED"
		+ "|actor_id=" + str(target_id)
		+ "|source=" + source
		+ "|registry=resident_control_switch_support_surface_packet_by_actor"
		+ "|observable=true"
		+ "|mirrored_to_host="
		+ str(
			reality_residency_host_game_state != null
			and reality_residency_host_game_state != gs
		).to_lower()
		+ "|truth_owner=false"
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

func _resident_control_switch_support_surface_packet_for_actor_id(
	target_id: int,
	source: String = "resident_control_switch_support_lookup"
) -> Dictionary:
	if (
		gs == null
		or target_id <= 0
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return {}

	var actor_key: String = str(
		target_id
	)
	var active_state: Dictionary = gs.scenario_state
	var active_registry_raw: Variant = active_state.get(
		"resident_control_switch_support_surface_packet_by_actor",
		{}
	)
	var active_registry: Dictionary = (
		active_registry_raw as Dictionary
		if typeof(active_registry_raw) == TYPE_DICTIONARY
		else {}
	)
	var active_packet_raw: Variant = active_registry.get(
		actor_key,
		active_registry.get(
			target_id,
			{}
		)
	)
	var active_packet: Dictionary = (
		active_packet_raw as Dictionary
		if typeof(active_packet_raw) == TYPE_DICTIONARY
		else {}
	)

	if _control_switch_support_surface_packet_is_renderable(
		active_packet,
		target_id
	):
		return active_packet.duplicate(false)

	var active_observable_raw: Variant = active_state.get(
		"observable_control_switch_support_surface_packet_by_actor",
		{}
	)
	var active_observable: Dictionary = (
		active_observable_raw as Dictionary
		if typeof(active_observable_raw) == TYPE_DICTIONARY
		else {}
	)
	var active_observable_packet_raw: Variant = active_observable.get(
		actor_key,
		active_observable.get(
			target_id,
			{}
		)
	)
	var active_observable_packet: Dictionary = (
		active_observable_packet_raw as Dictionary
		if typeof(active_observable_packet_raw) == TYPE_DICTIONARY
		else {}
	)

	if _control_switch_support_surface_packet_is_renderable(
		active_observable_packet,
		target_id
	):
		return active_observable_packet.duplicate(false)

	if (
		reality_residency_host_game_state != null
		and reality_residency_host_game_state != gs
		and typeof(
			reality_residency_host_game_state.scenario_state
		) == TYPE_DICTIONARY
	):
		var host_state: Dictionary = (
			reality_residency_host_game_state.scenario_state
		)

		for raw_registry_name in [
			"resident_control_switch_support_surface_packet_by_actor",
			"observable_control_switch_support_surface_packet_by_actor"
		]:
			var registry_name: String = str(
				raw_registry_name
			)
			var host_registry_raw: Variant = host_state.get(
				registry_name,
				{}
			)
			var host_registry: Dictionary = (
				host_registry_raw as Dictionary
				if typeof(host_registry_raw) == TYPE_DICTIONARY
				else {}
			)
			var host_packet_raw: Variant = host_registry.get(
				actor_key,
				host_registry.get(
					target_id,
					{}
				)
			)
			var host_packet: Dictionary = (
				host_packet_raw as Dictionary
				if typeof(host_packet_raw) == TYPE_DICTIONARY
				else {}
			)

			if _control_switch_support_surface_packet_is_renderable(
				host_packet,
				target_id
			):
				return host_packet.duplicate(false)

	set_meta(
		"resident_control_switch_support_packet_missing",
		true
	)
	set_meta(
		"resident_control_switch_support_packet_missing_actor_id",
		target_id
	)
	set_meta(
		"resident_control_switch_support_packet_missing_source",
		source
	)
	set_meta(
		"resident_control_switch_support_packet_lookup_constant_time",
		true
	)
	set_meta(
		"resident_control_switch_support_packet_missing_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	EraLog.truth(
		"SUPPORT_PACKET_LOOKUP_FAILED"
		+ "|actor_id=" + str(target_id)
		+ "|actor_key=" + actor_key
		+ "|source=" + source
		+ "|reason=no_renderable_support_packet_found"
		+ "|constant_time=true"
		+ "|registry_deep_copy=false"
		+ "|profile_scan=false"
		+ "|shell_scan=false"
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	return {}
func _control_switch_support_surface_packet_is_renderable(
	packet: Dictionary,
	target_id: int
) -> bool:
	return bool(
		_control_switch_support_surface_packet_validation_report(
			packet,
			target_id
		).get(
			"valid",
			false
		)
	)
func _install_switched_actor_main_tab_contracts_from_store(
	target_id: int,
	source: String = "relationship_profile_switch_tail",
	stage_index: int = 0
) -> void:
	if (
		gs == null
		or gs.player == null
		or target_id <= 0
		or int(
			gs.player.id
		) != target_id
	):
		return

	if stage_index > 1:
		return

	var activated: bool = false
	var contracts_queued_from_packet: bool = false
	var support_packet_used: bool = false
	var support_packet_requested_after_visible: bool = false
	var pointer_only_tabs_rejected: Array = []
	var background_service_armed: bool = false

	EraLog.truth(
		"SUPPORT_PACKET_INSTALL_BEGIN"
		+ "|actor_id=" + str(target_id)
		+ "|source=" + source
		+ "|phase=main_tab_deck_install"
		+ "|deck_already_hot="
		+ str(
			_resident_main_tab_renderer_deck_is_hot(
				target_id
			)
		).to_lower()
		+ "|build_on_switch=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	if _resident_main_tab_renderer_deck_is_hot(
		target_id
	):
		activated = (
			_activate_resident_main_tab_renderer_deck_for_actor(
				target_id,
				source
			)
		)

	if not activated:
		var support_packet: Dictionary = (
			_resident_control_switch_support_surface_packet_for_actor_id(
				target_id,
				"%s_main_tab_install"
				% source
			)
		)
		var support_validation: Dictionary = (
			_control_switch_support_surface_packet_validation_report(
				support_packet,
				target_id
			)
		)

		if bool(
			support_validation.get(
				"valid",
				false
			)
		):
			var raw_deck: Dictionary = MainSceneHelpers._safe_dictionary(
				support_packet.get(
					"main_tab_surface_contracts",
					{}
				)
			)
			var real_main_tab_contracts: Dictionary = {}

			for raw_tab_id in [
				"relationships",
				"school",
				"activities",
				"career",
				"mods"
			]:
				var tab_id: String = str(
					raw_tab_id
				)
				var tab_contract: Dictionary = MainSceneHelpers._safe_dictionary(
					raw_deck.get(
						tab_id,
						{}
					)
				)
				var tab_valid: bool = (
					not tab_contract.is_empty()
					and int(
						tab_contract.get(
							"actor_id",
							-1
						)
					) == target_id
				)

				if tab_valid:
					var tab_schema: String = str(
						tab_contract.get(
							"schema",
							""
						)
					).strip_edges().to_lower()
					var tab_truth_state: String = str(
						tab_contract.get(
							"truth_state",
							""
						)
					).strip_edges().to_lower()

					if (
						tab_schema == "eralife.pointer_only.destination_tab_contract"
						or tab_truth_state == "pointer_only_resident_shell"
						or bool(
							tab_contract.get(
								"pointer_only",
								false
							)
						)
					):
						pointer_only_tabs_rejected.append(
							tab_id
						)
						tab_valid = false

				EraLog.truth(
					"SUPPORT_PACKET_INSTALL_TAB"
					+ "|actor_id=" + str(target_id)
					+ "|tab=" + tab_id
					+ "|valid=" + str(tab_valid).to_lower()
					+ "|contract_actor_id="
					+ str(
						tab_contract.get(
							"actor_id",
							-1
						)
					)
					+ "|schema="
					+ str(
						tab_contract.get(
							"schema",
							""
						)
					)
					+ "|pointer_only="
					+ str(
						bool(
							tab_contract.get(
								"pointer_only",
								false
							)
						)
					).to_lower()
					+ "|build_on_switch=false"
					+ "|build_on_click=false"
					+ "|at_ms=" + str(Time.get_ticks_msec())
				)

				if not tab_valid:
					continue

				real_main_tab_contracts [
					tab_id
				] = tab_contract.duplicate(false)

			if not real_main_tab_contracts.is_empty():
				_queue_resident_main_tab_renderer_deck_prewarm(
					target_id,
					real_main_tab_contracts,
					"%s_real_support_deck"
					% source
				)
				contracts_queued_from_packet = true
				support_packet_used = true
				background_service_armed = true

		if _resident_main_tab_renderer_deck_is_hot(
			target_id
		):
			activated = (
				_activate_resident_main_tab_renderer_deck_for_actor(
					target_id,
					source
				)
			)

	if not activated:
		_detach_actor_scoped_renderer_bindings_for_control_switch(
			target_id,
			"%s_prevent_old_actor_surface_reuse"
			% source
		)

		set_meta(
			"switched_actor_main_tab_deck_pending",
			true
		)
		set_meta(
			"switched_actor_main_tab_deck_pending_actor_id",
			target_id
		)
		set_meta(
			"switched_actor_main_tab_deck_pending_source",
			source
		)
		set_meta(
			"switched_actor_main_tab_deck_pointer_only_tabs_rejected",
			pointer_only_tabs_rejected.duplicate(false)
		)
