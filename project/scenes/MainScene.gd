			"actions": [
				{
					"id": "upgrade_%s" % stat_id,
					"label": "Upgrade",
					"engine_property": "power_engine",
					"method": "resolve_power_action",
					"payload": {
						"action": "upgrade_power_stat",
						"stat_id": stat_id,
						"source": "power_hub"
