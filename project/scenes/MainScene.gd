		0.24
	)
	var breath_strength: float = 0.5 + (0.5 * sin(god_mode_presentation_panel_breath_phase))
	var shimmer_strength: float = 0.5 + (0.5 * sin((god_mode_presentation_panel_breath_phase * 1.85) - 0.45))
	var valid_section_labels: Array = []
	for label_ref in god_mode_section_labels:
		if not is_instance_valid(label_ref):
			continue
		var section_label: Label = label_ref
		var section_alpha: float = float(section_label.get_meta("god_mode_section_alpha", 0.96))
		var section_font_size: int = int(section_label.get_meta("god_mode_section_font_size", 18))
		var breath_scale_strength: float = float(section_label.get_meta("god_mode_section_breath_scale_strength", 0.006))
		var breath_alpha_boost: float = float(section_label.get_meta("god_mode_section_breath_alpha_boost", 0.04))
		var base_scale: Vector2 = section_label.get_meta("god_mode_section_breath_base_scale", Vector2.ONE)
		var target_color: Color = Color(
			section_header_color.r,
			section_header_color.g,
			section_header_color.b,
			clamp(section_alpha + (breath_alpha_boost * breath_strength), 0.0, 1.0)
		)
		var shimmer_scale_boost: float = 0.0
		if section_label == god_mode_subtitle_label:
			var subtitle_section_color: Color = Color(
				palette.get("accent", Color(1.0, 0.88, 0.93, 1.0))
			).lerp(
				Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0))),
				0.38
			)
			var subtitle_shimmer_color: Color = subtitle_section_color.lerp(
				Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0))),
				0.62
			)
			target_color = subtitle_section_color.lerp(
				subtitle_shimmer_color,
				0.035 + (0.055 * shimmer_strength)
			)
			target_color.a = clamp(section_alpha + (breath_alpha_boost * breath_strength), 0.0, 1.0)
			shimmer_scale_boost = 0.0025 * shimmer_strength
		elif section_label == god_mode_title_label:
			var title_color: Color = Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0)))
			var title_shimmer_color: Color = title_color.lerp(
				Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0))),
				0.18
			)
			target_color = title_color.lerp(
				title_shimmer_color,
				0.02 + (0.03 * shimmer_strength)
			)
			target_color.a = clamp(section_alpha + (breath_alpha_boost * breath_strength), 0.0, 1.0)
			shimmer_scale_boost = 0.0015 * shimmer_strength
		section_label.add_theme_color_override("font_color", target_color)
		section_label.add_theme_font_size_override("font_size", section_font_size)
		var pivot_x: float = 0.0
		if section_label == god_mode_title_label or section_label == god_mode_subtitle_label:
			pivot_x = section_label.size.x * 0.5
		section_label.pivot_offset = Vector2(pivot_x, section_label.size.y * 0.5)
		var breath_scale: float = 1.0 + (breath_scale_strength * breath_strength) + shimmer_scale_boost
		section_label.scale = Vector2(
			base_scale.x * breath_scale,
			base_scale.y * breath_scale
		)
		valid_section_labels.append(section_label)
	god_mode_section_labels = valid_section_labels
func _apply_god_mode_row_label_breathing_visual() -> void:
	if god_mode_row_labels.is_empty():
		return
	var palette:= _current_god_mode_palette()
	var base_row_color: Color = Color(
		palette.get("body", Color(0.98, 0.95, 1.0, 0.95))
	).lerp(
		Color(palette.get("status", Color(0.86, 0.95, 1.0, 1.0))),
		0.18
	)
	var shimmer_row_color: Color = base_row_color.lerp(
		Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0))),
		0.22
	)
	var breath_strength: float = 0.5 + (0.5 * sin(god_mode_presentation_panel_breath_phase))
	var shimmer_strength: float = 0.5 + (0.5 * sin((god_mode_presentation_panel_breath_phase * 1.55) + 0.4))
	var valid_row_labels: Array = []
	for label_ref in god_mode_row_labels:
		if not is_instance_valid(label_ref):
			continue
		var row_label: Label = label_ref
		var row_alpha: float = float(row_label.get_meta("god_mode_row_label_alpha", 0.95))
		var row_font_size: int = int(row_label.get_meta("god_mode_row_label_font_size", 16))
		var breath_scale_strength: float = float(row_label.get_meta("god_mode_row_label_breath_scale_strength", 0.0018))
		var alpha_boost: float = float(row_label.get_meta("god_mode_row_label_alpha_boost", 0.018))
		var shimmer_mix_strength: float = float(row_label.get_meta("god_mode_row_label_shimmer_mix_strength", 0.045))
		var base_scale: Vector2 = row_label.get_meta("god_mode_row_label_base_scale", Vector2.ONE)
		var target_color: Color = base_row_color.lerp(
			shimmer_row_color,
			shimmer_mix_strength * shimmer_strength
		)
		target_color.a = clamp(row_alpha + (alpha_boost * breath_strength), 0.0, 1.0)
		row_label.add_theme_color_override("font_color", target_color)
		row_label.add_theme_font_size_override("font_size", row_font_size)
		row_label.pivot_offset = Vector2(0.0, row_label.size.y * 0.5)
		var breath_scale: float = 1.0 + (breath_scale_strength * breath_strength)
		row_label.scale = Vector2(
			base_scale.x * breath_scale,
			base_scale.y * breath_scale
		)
		valid_row_labels.append(row_label)
	god_mode_row_labels = valid_row_labels
func _add_god_mode_section_divider(parent: Control) -> void:
	if parent == null:
		return
	var divider:= HSeparator.new()
	divider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	divider.custom_minimum_size = Vector2(0, 10)
	divider.mouse_filter = Control.MOUSE_FILTER_IGNORE
	divider.set_meta("god_mode_divider_base_alpha", 0.3)
	divider.set_meta("god_mode_divider_alpha_boost", 0.18)
	divider.set_meta("god_mode_divider_color_mix", 0.26)
	divider.set_meta("god_mode_divider_scale_strength", 0.08)
	divider.add_theme_stylebox_override(
		"separator",
		MainSceneHelpers._build_god_mode_section_divider_style(Color(1.0, 1.0, 1.0, 0.3))
	)
	parent.add_child(divider)
	if god_mode_start_panel != null:
		var stored_dividers_variant: Variant = god_mode_start_panel.get_meta("god_mode_section_dividers", [])
		var stored_dividers: Array = []
		if stored_dividers_variant is Array:
			stored_dividers = stored_dividers_variant
		stored_dividers.append(divider)
		god_mode_start_panel.set_meta("god_mode_section_dividers", stored_dividers)
	_apply_god_mode_section_divider_breathing_visual()

func _apply_god_mode_section_divider_breathing_visual() -> void:
	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return
	var stored_dividers_variant: Variant = god_mode_start_panel.get_meta("god_mode_section_dividers", [])
	if not (stored_dividers_variant is Array):
		return
	var stored_dividers: Array = stored_dividers_variant
	if stored_dividers.is_empty():
		return

	var palette:= _current_god_mode_palette()
	var accent: Color = Color(palette.get("accent", Color(0.86, 0.54, 1.0, 1.0)))
	var status: Color = Color(palette.get("status", Color(0.96, 0.92, 1.0, 0.96)))
	var breath_strength: float = 0.5 + (0.5 * sin(god_mode_presentation_panel_breath_phase))
	var valid_dividers: Array = []

	for divider_ref in stored_dividers:
		if not is_instance_valid(divider_ref):
			continue
		if not (divider_ref is HSeparator):
			continue
		var divider: HSeparator = divider_ref
		var base_alpha: float = float(divider.get_meta("god_mode_divider_base_alpha", 0.3))
		var alpha_boost: float = float(divider.get_meta("god_mode_divider_alpha_boost", 0.18))
		var color_mix: float = float(divider.get_meta("god_mode_divider_color_mix", 0.26))
		var scale_strength: float = float(divider.get_meta("god_mode_divider_scale_strength", 0.08))

		var line_color: Color = status.lerp(
			accent.lightened(0.08),
			clamp(color_mix * breath_strength, 0.0, 1.0)
		)
		line_color = Color(
			line_color.r,
			line_color.g,
			line_color.b,
			clamp(base_alpha + (alpha_boost * breath_strength), 0.0, 1.0)
		)

		divider.add_theme_stylebox_override(
			"separator",
			MainSceneHelpers._build_god_mode_section_divider_style(line_color, 2)
		)
		divider.scale = Vector2(1.0, 1.0 + (scale_strength * breath_strength))
		divider.self_modulate = Color(1.0, 1.0, 1.0, 1.0)
		valid_dividers.append(divider)

	god_mode_start_panel.set_meta("god_mode_section_dividers", valid_dividers)
