func _household_creator_current_reality_mode() -> String:
	var mode: String = str(household_creator_selected_reality_mode).strip_edges().to_lower()
	if mode == "":
		mode = _household_creator_selected_option_text(household_creator_reality_picker, "chaos").to_lower()
	if mode not in ["realistic", "enhanced", "chaos"]:
		mode = "chaos"
	household_creator_selected_reality_mode = mode
	return mode


func _household_creator_reality_mode_button(mode: String, title_text: String, subtitle_text: String) -> Button:
	var clean_mode: String = str(mode).strip_edges().to_lower()
	var button:= Button.new()
	button.name = "HouseholdCreatorRealityMode_%s" % clean_mode
	button.text = "%s\n%s" % [title_text, subtitle_text]
	button.custom_minimum_size = Vector2(0, 70)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	button.clip_text = true
	_household_creator_apply_interactive_button_motion(button)
	button.pressed.connect(func () -> void:
		_household_creator_select_reality_mode(clean_mode, true)
		_household_creator_pulse_control(button)
	)
	household_creator_reality_buttons [clean_mode] = button
	return button


func _household_creator_select_reality_mode(mode: String, mark_dirty: bool = true) -> void:
	var clean_mode: String = str(mode).strip_edges().to_lower()
	if clean_mode not in ["realistic", "enhanced", "chaos"]:
		clean_mode = "chaos"

	household_creator_selected_reality_mode = clean_mode

	if household_creator_reality_picker != null and is_instance_valid(household_creator_reality_picker):
		for i in range(household_creator_reality_picker.item_count):
			if household_creator_reality_picker.get_item_text(i).strip_edges().to_lower() == clean_mode:
				household_creator_reality_picker.select(i)
				household_creator_reality_picker.set_meta("selected_text", household_creator_reality_picker.get_item_text(i).strip_edges())
				break

	_household_creator_update_reality_mode_buttons()

	if mark_dirty:
		_household_creator_refresh_world_dependent_pickers(true)
		_household_creator_update_world_selection_labels()
		_household_creator_mark_world_dirty()


func _household_creator_update_reality_mode_buttons() -> void:
	var clean_mode: String = _household_creator_current_reality_mode()
	for raw_mode in household_creator_reality_buttons.keys():
		var mode_key: String = str(raw_mode).strip_edges().to_lower()
		var raw_button: Variant = household_creator_reality_buttons.get(raw_mode, null)
		if raw_button == null or not (raw_button is Button):
			continue
		var button: Button = raw_button as Button
		if not is_instance_valid(button):
			continue
		var selected: bool = mode_key == clean_mode
		var accent: Color = Color(1.0, 0.48, 0.22, 1.0)
		if mode_key == "realistic":
			accent = Color(0.92, 0.64, 0.48, 1.0)
		elif mode_key == "enhanced":
			accent = Color(1.0, 0.76, 0.38, 1.0)
		elif mode_key == "chaos":
			accent = Color(1.0, 0.25, 0.1, 1.0)
		MainSceneHelpers._household_creator_style_choice_button(button, selected, accent)


func _household_creator_apply_interactive_button_motion(control: Control) -> void:
	if control == null or not is_instance_valid(control):
		return

	control.mouse_entered.connect(func () -> void:
		if control == null or not is_instance_valid(control):
			return
		control.pivot_offset = control.size * 0.5
		var tween:= create_tween().bind_node(control)
		tween.tween_property(control, "scale", Vector2(1.012, 1.012), 0.08).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	)

	control.mouse_exited.connect(func () -> void:
		if control == null or not is_instance_valid(control):
			return
		control.pivot_offset = control.size * 0.5
		var tween:= create_tween().bind_node(control)
		tween.tween_property(control, "scale", Vector2.ONE, 0.1).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	)


func _household_creator_pulse_control(control: Control, peak_scale: float = 1.026) -> void:
	if control == null or not is_instance_valid(control):
		return

	control.pivot_offset = control.size * 0.5
	var tween:= create_tween().bind_node(control)
	tween.tween_property(control, "scale", Vector2(peak_scale, peak_scale), 0.07).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(control, "scale", Vector2.ONE, 0.11).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


func _household_creator_begin_prewarm_feedback() -> void:
	if household_creator_prewarm_button != null and is_instance_valid(household_creator_prewarm_button):
		household_creator_prewarm_button.disabled = true
		household_creator_prewarm_button.text = "Prewarming World Seed..."
		_household_creator_pulse_control(household_creator_prewarm_button, 1.035)

	_household_creator_set_prewarm_feedback(0.12, "Generating population...")


