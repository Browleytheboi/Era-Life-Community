func _queue_activity_projection_tail(
	action_label: String,
	result: Dictionary
) -> void:
	activity_projection_tail_queue.append({
		"action_label": action_label,
		"result": result.duplicate(true),
		"stage": 0,
		"queued_at_ms": int(
			Time.get_ticks_msec()
		)
	})

	if activity_projection_tail_active:
		return

	activity_projection_tail_active = true

	call_deferred(
		"_continue_activity_projection_tail"
	)


func _continue_activity_projection_tail() -> void:
	if activity_projection_tail_queue.is_empty():
		activity_projection_tail_active = false
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if _ui_interaction_grace_active(
		now_ms
	):
		var grace_tree:= get_tree()

		if grace_tree == null:
			call_deferred(
				"_continue_activity_projection_tail"
			)
			return

		var grace_timer:= (
			grace_tree.create_timer(
				0.12
			)
		)

		grace_timer.timeout.connect(
			_continue_activity_projection_tail,
			CONNECT_ONE_SHOT
		)

		return

	var row_raw: Variant = (
		activity_projection_tail_queue [0]
	)

	if typeof(row_raw) != TYPE_DICTIONARY:
		activity_projection_tail_queue.pop_front()

		call_deferred(
			"_continue_activity_projection_tail"
		)

		return

	var row: Dictionary = (
		row_raw as Dictionary
	)
	var result: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			row.get(
				"result",
				{}
			)
		)
	)
	var stage: int = int(
		row.get(
			"stage",
			0
		)
	)

	match stage:
		0:
			var result_text: String = str(
				result.get(
					"text",
					""
				)
			).strip_edges()

			if result_text != "":
				_append_text_to_diary(
					result_text,
					false
				)

		1:
			if result.has(
				"opps"
			):
				var raw_opportunities: Variant = (
					result.get(
						"opps",
						[]
					)
				)

				if typeof(raw_opportunities) == TYPE_ARRAY:
					current_opportunities_cache = (
						raw_opportunities as Array
					).duplicate(true)

					if (
						activities_action_panel != null
						and is_instance_valid(
							activities_action_panel
						)
						and activities_action_panel.visible
					):
						_refresh_activities_action_panel()

		2:
			_update_player_stats_overlay()

		3:
			_update_boxing_hud()

		4:
			activity_projection_tail_queue.pop_front()

			call_deferred(
				"_continue_activity_projection_tail"
			)

			return

	row ["stage"] = stage + 1
	activity_projection_tail_queue [0] = row

	var tail_tree:= get_tree()

	if tail_tree == null:
		call_deferred(
			"_continue_activity_projection_tail"
		)

		return

	var next_timer:= (
		tail_tree.create_timer(
			0.035
		)
	)

	next_timer.timeout.connect(
		_continue_activity_projection_tail,
		CONNECT_ONE_SHOT
	)
