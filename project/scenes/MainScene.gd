		requested_grace_ms
	)
	set_meta(
		"ui_interaction_grace_until_ms",
		maxi(
			int(
				get_meta(
					"ui_interaction_grace_until_ms",
					0
				)
			),
			until_ms
		)
	)





	set_meta(
