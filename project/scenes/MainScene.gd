	gs.scenario_state [
		"pending_situations_old_actor_payload_reuse_forbidden"
	] = true




	if (
		payload_hot
		and popup_viewer != null
		and is_instance_valid(
			popup_viewer
		)
	):
		_prepaint_pending_situations_popup_payload(
			payload,
			actor_id
		)



	_paint_pending_situations_button_for_actor_lens(
		gs.player,
		explicit_count,
