func _assets_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var cursor_index: int = 0
	var visited_signatures: Dictionary = {}

	while (
		cursor_index < queue.size()
		and cursor_index < 192
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue [cursor_index]
		)
		cursor_index += 1

		if cursor.is_empty():
			continue

		var cursor_signature: String = str(
			hash(cursor)
		)

		if visited_signatures.has(
			cursor_signature
		):
			continue

		visited_signatures [
			cursor_signature
		] = true

		var direct_assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			cursor.get(
				"assets_surface_contract",
				{}
			)
		)

		if not direct_assets_contract.is_empty():
			var direct_resolved: Dictionary = (
				cursor.duplicate(true)
			)
			direct_resolved [
				"assets_surface_contract"
			] = direct_assets_contract.duplicate(true)
			return direct_resolved

		if (
			str(
				cursor.get(
					"schema",
					""
				)
			) == "eralife.assets.surface_pack"
			and not MainSceneHelpers._safe_dictionary(
				cursor.get(
					"assets_surface_contract",
					{}
				)
			).is_empty()
		):
			return cursor.duplicate(true)

		for contract_key in [
			"surface_contract",
			"portfolio_surface_contract",
			"contract",
			"projection_contract",
			"resident_contract"
		]:
			var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
				cursor.get(
					contract_key,
					{}
				)
			)

			if (
				not surface_contract.is_empty()
				and str(
					surface_contract.get(
						"schema",
						""
					)
				).begins_with(
					"eralife.assets."
				)
			):
				var resolved: Dictionary = (
					cursor.duplicate(true)
				)
				resolved [
					"assets_surface_contract"
				] = surface_contract.duplicate(true)
				return resolved

		for raw_key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload",
			"response",
			"data",
			"contract_packet",
			"projection_packet",
			"surface_packet",
			"immutable_contracts"
		]:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) == TYPE_DICTIONARY:
				var nested: Dictionary = (
					nested_raw as Dictionary
				).duplicate(true)

				if not nested.is_empty():
					queue.append(
						nested
					)

			elif typeof(nested_raw) == TYPE_ARRAY:
				for raw_entry in nested_raw as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(true)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

		for raw_value in cursor.values():
			if typeof(raw_value) == TYPE_DICTIONARY:
				var nested_value: Dictionary = (
					raw_value as Dictionary
				).duplicate(true)

				if not nested_value.is_empty():
					queue.append(
						nested_value
					)

			elif typeof(raw_value) == TYPE_ARRAY:
				for raw_entry in raw_value as Array:
					if typeof(raw_entry) != TYPE_DICTIONARY:
						continue

					var nested_entry: Dictionary = (
						raw_entry as Dictionary
					).duplicate(true)

					if not nested_entry.is_empty():
						queue.append(
							nested_entry
						)

	return {}
func _asset_destination_surface_deck_is_hot_for_actor(
	actor_id: int
) -> bool:
	if actor_id <= 0:
		return false

	return (
		assets_panel != null
		and is_instance_valid(
			assets_panel
		)
		and property_market_panel != null
		and is_instance_valid(
			property_market_panel
		)
		and vehicle_market_panel != null
		and is_instance_valid(
			vehicle_market_panel
		)
		and int(
			assets_panel.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and int(
			property_market_panel.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and int(
			vehicle_market_panel.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and int(
			assets_panel.active_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
		and int(
			property_market_panel.active_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
		and int(
			vehicle_market_panel.active_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
	)
func _asset_surface_pack_has_authoritative_market_truth(
	pack: Dictionary,
	actor_id: int
) -> bool:
	if (
		pack.is_empty()
		or actor_id <= 0
		or int(
			pack.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	var property_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"property_market_surface_contract",
			{}
		)
	)
	var vehicle_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"vehicle_market_surface_contract",
			{}
		)
	)

	return (
		MainSceneLogic._market_surface_contract_is_renderable(
			property_contract,
			"property"
		)
		and MainSceneLogic._market_surface_contract_is_renderable(
			vehicle_contract,
			"vehicle"
		)
	)
func _prewarm_asset_surface_deck_for_actor(
	target_actor: Person,
	reason: String = "asset_surface_deck_prewarm",
	force_rebuild: bool = false
) -> Dictionary:
	if gs == null or target_actor == null:
		return {}

	var target_actor_id: int = int(
		target_actor.id
	)

	if target_actor_id <= 0:
		return {}

	var cache_key: String = _asset_surface_pack_cache_key(
		target_actor
	)
	var pack: Dictionary = MainSceneHelpers._safe_dictionary(
		asset_surface_pack_by_actor.get(
			cache_key,
			{}
		)
	)
	var cached_market_truth_hot: bool = (
		_asset_surface_pack_has_authoritative_market_truth(
			pack,
			target_actor_id
		)
	)

	if (
		pack.is_empty()
		or force_rebuild
		or not cached_market_truth_hot
	):
		pack = _request_asset_surface_pack_prewarm(
			target_actor,
			reason,
			force_rebuild
		)



	var assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"assets_surface_contract",
			{}
		)
	)
	var property_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"property_market_surface_contract",
			{}
		)
	)
	var vehicle_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"vehicle_market_surface_contract",
			{}
		)
	)
	var vehicle_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"vehicle_market_surface_deck",
			{}
		)
	)

	if assets_contract.is_empty():
		return {}

	if not MainSceneLogic._market_surface_contract_is_renderable(
		property_contract,
		"property"
	):
		property_contract = (
			MainSceneLogic._observable_asset_market_surface_contract(gs, 
				target_actor,
				"property"
			)
		)

	if not MainSceneLogic._market_surface_contract_is_renderable(
		vehicle_contract,
		"vehicle"
	):
		vehicle_contract = (
			MainSceneLogic._observable_asset_market_surface_contract(gs, 
				target_actor,
				"vehicle"
			)
		)
	var authoritative_market_truth_hot: bool = (
		MainSceneLogic._market_surface_contract_is_renderable(
			property_contract,
			"property"
		)
		and MainSceneLogic._market_surface_contract_is_renderable(
			vehicle_contract,
			"vehicle"
		)
	)

	pack [
		"authoritative_hot"
	] = authoritative_market_truth_hot
	pack [
		"truth_state"
	] = (
		"hot"
		if authoritative_market_truth_hot
		else "observable_partial"
	)
	pack [
		"market_truth_retry_required"
	] = not authoritative_market_truth_hot
	assets_contract ["actor_id"] = target_actor_id
	property_contract ["actor_id"] = target_actor_id
	vehicle_contract ["actor_id"] = target_actor_id

	var controlled_actor_id: int = (
		int(gs.player.id)
		if gs.player != null
		else -1
	)
	var mount_into_shared_renderer: bool = (
		target_actor_id == controlled_actor_id
	)

	pack ["actor_id"] = target_actor_id
	pack [
		"assets_surface_contract"
	] = assets_contract.duplicate(true)
	pack [
		"property_market_surface_contract"
	] = property_contract.duplicate(true)
	pack [
		"vehicle_market_surface_contract"
	] = vehicle_contract.duplicate(true)
	pack [
		"vehicle_market_surface_deck"
	] = vehicle_deck.duplicate(true)
	pack ["prewarmed"] = true
	pack ["visible_click_work_required"] = false
	pack ["visible_click_work_forbidden"] = true
	pack ["prewarm_reason"] = reason
	pack ["prewarmed_at_ms"] = int(
		Time.get_ticks_msec()
	)
	pack [
		"renderer_mount_deferred_until_controlled"
	] = not mount_into_shared_renderer
	pack [
		"shared_renderer_mutated_for_noncontrolled_actor"
	] = false

	asset_surface_pack_by_actor [
		cache_key
	] = pack.duplicate(true)




	if not mount_into_shared_renderer:
		set_meta(
			"asset_surface_pack_cached_without_renderer_mount",
			true
		)
		set_meta(
			"asset_surface_pack_cached_without_renderer_mount_actor_id",
			target_actor_id
		)
		set_meta(
			"asset_surface_pack_noncontrolled_actor_renderer_clobber_forbidden",
			true
		)
		return pack

	_ensure_assets_panel()
	_ensure_property_market_panel()
	_ensure_vehicle_market_panel()

	var assets_was_visible: bool = (
		assets_panel != null
		and is_instance_valid(
			assets_panel
		)
		and assets_panel.visible
	)
	var property_was_visible: bool = (
		property_market_panel != null
		and is_instance_valid(
			property_market_panel
		)
		and property_market_panel.visible
	)
	var vehicle_was_visible: bool = (
		vehicle_market_panel != null
		and is_instance_valid(
			vehicle_market_panel
		)
		and vehicle_market_panel.visible
	)

	_prewarm_vehicle_market_panel_surface_deck(
		target_actor,
		vehicle_deck,
		"%s_vehicle_panel_deck" % reason
	)

	if (
		assets_panel != null
		and is_instance_valid(
			assets_panel
		)
	):
		var assets_revision_changed: bool = (
			MainSceneHelpers._asset_surface_contract_revision_key(
				assets_panel.active_contract
			) != MainSceneHelpers._asset_surface_contract_revision_key(
				assets_contract
			)
		)

		assets_panel.actor = target_actor

		if (
			force_rebuild
			or int(
				assets_panel.active_contract.get(
					"actor_id",
					-1
				)
			) != target_actor_id
			or assets_revision_changed
		):
			assets_panel.render_surface_contract(
				assets_contract
			)

		assets_panel.visible = assets_was_visible
		assets_panel.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if assets_was_visible
			else Control.MOUSE_FILTER_IGNORE
		)
		assets_panel.set_meta(
			"prepainted_before_assets_click",
			true
		)
		assets_panel.set_meta(
			"prepainted_actor_id",
			target_actor_id
		)

	if (
		property_market_panel != null
		and is_instance_valid(
			property_market_panel
		)
	):
		var property_revision_changed: bool = (
			MainSceneHelpers._asset_surface_contract_revision_key(
				property_market_panel.active_contract
			) != MainSceneHelpers._asset_surface_contract_revision_key(
				property_contract
			)
		)

		property_market_panel.actor = target_actor

		if (
			force_rebuild
			or int(
				property_market_panel.active_contract.get(
					"actor_id",
					-1
				)
			) != target_actor_id
			or property_revision_changed
		):
			property_market_panel.render_surface_contract(
				property_contract
			)

		property_market_panel.visible = property_was_visible
		property_market_panel.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if property_was_visible
			else Control.MOUSE_FILTER_IGNORE
		)
		property_market_panel.set_meta(
			"prepainted_before_market_click",
			true
		)
		property_market_panel.set_meta(
			"prepainted_actor_id",
			target_actor_id
		)

	if (
		vehicle_market_panel != null
		and is_instance_valid(
			vehicle_market_panel
		)
	):
		var vehicle_revision_changed: bool = (
			MainSceneHelpers._asset_surface_contract_revision_key(
				vehicle_market_panel.active_contract
			) != MainSceneHelpers._asset_surface_contract_revision_key(
				vehicle_contract
			)
		)

		vehicle_market_panel.actor = target_actor

		if (
			force_rebuild
			or int(
				vehicle_market_panel.active_contract.get(
					"actor_id",
					-1
				)
			) != target_actor_id
			or vehicle_revision_changed
		):
			vehicle_market_panel.render_surface_contract(
				vehicle_contract
			)

		vehicle_market_panel.visible = vehicle_was_visible
		vehicle_market_panel.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if vehicle_was_visible
			else Control.MOUSE_FILTER_IGNORE
		)
		vehicle_market_panel.set_meta(
			"prepainted_before_market_click",
			true
		)
		vehicle_market_panel.set_meta(
			"prepainted_actor_id",
			target_actor_id
		)

	set_meta(
		"asset_surface_deck_hot_actor_id",
		target_actor_id
	)
	set_meta(
		"asset_surface_deck_hot_reason",
		reason
	)
	set_meta(
		"asset_surface_deck_hot_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"asset_surface_click_build_forbidden",
		true
	)
	set_meta(
		"asset_surface_pack_actor_validated",
		true
	)
	set_meta(
		"property_market_prepainted",
		true
	)
	set_meta(
		"vehicle_market_prepainted",
		true
	)
	set_meta(
		"asset_surface_pack_duplicate_rebuild_performed",
		false
	)
	set_meta(
		"asset_surface_pack_noncontrolled_actor_renderer_clobber_forbidden",
		true
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var rollup_by_actor: Dictionary = MainSceneHelpers._safe_dictionary(
		gs.scenario_state.get(
			"resident_asset_rollup_by_actor",
			{}
		)
	)
	rollup_by_actor [str(target_actor_id)] = {
		"property_count": MainSceneHelpers._safe_array(
			assets_contract.get(
				"property_asset_rows",
				[]
			)
		).size(),
		"vehicle_count": MainSceneHelpers._safe_array(
			assets_contract.get(
				"vehicle_asset_rows",
				[]
			)
		).size(),
		"updated_at_ms": int(
			Time.get_ticks_msec()
		)
	}
	gs.scenario_state [
		"resident_asset_rollup_by_actor"
	] = rollup_by_actor

	return pack
func _market_surface_contract_is_retired_generic_surface(
	surface_contract: Dictionary,
	market_kind: String
) -> bool:
	if surface_contract.is_empty():
		return false

	if bool(
		surface_contract.get(
			"retired_fake_generic_market_surface",
			false
		)
	):
		return true

	if bool(
		surface_contract.get(
			"crr_fallback",
			false
		)
	):
		return true

	var clean_market_kind: String = str(
		market_kind
	).strip_edges().to_lower()
	var signature: String = str(
		surface_contract.get(
			"surface_signature",
			""
		)
	).strip_edges().to_lower()
	var subtitle: String = str(
		surface_contract.get(
			"subtitle",
			""
		)
	).strip_edges().to_lower()

	if signature.begins_with(
		"catalog_backed_resident_surface"
	):
		return true

	if (
		subtitle.find(
			"resident %s listings"
			% clean_market_kind
		) >= 0
		and subtitle.find(
			"already observable"
		) >= 0
	):
		return true

	var listing_cards: Array = MainSceneHelpers._safe_array(
		surface_contract.get(
			"listing_card_contracts",
			[]
		)
	)

	if (
		clean_market_kind == "property"
		and listing_cards.size() <= 3
	):
		for raw_card in listing_cards:
			var card: Dictionary = MainSceneHelpers._safe_dictionary(
				raw_card
			)
			var template_id: String = str(
				card.get(
					"template_id",
					""
				)
			).strip_edges().to_lower()

			if template_id.begins_with(
				"resident_property_"
			):
				return true

	if clean_market_kind == "vehicle":
		var dealerships: Array = MainSceneHelpers._safe_array(
			surface_contract.get(
				"dealership_contracts",
				[]
			)
		)

		if dealerships.size() == 1:
			var dealer: Dictionary = MainSceneHelpers._safe_dictionary(
				dealerships [0]
			)
			var dealer_name: String = str(
				dealer.get(
					"name",
					dealer.get(
						"title",
						""
					)
				)
			).strip_edges().to_lower()

			if dealer_name.find(
				"eralife auto gallery"
			) >= 0:
				return true

	return false
func _asset_surface_pack_is_crr_hot(
	pack: Dictionary,
	target_actor: Person
) -> bool:
	if (
		pack.is_empty()
		or target_actor == null
	):
		return false

	var actor_id: int = int(
		target_actor.id
	)

	if int(
		pack.get(
			"actor_id",
			-1
		)
	) != actor_id:
		return false

	var assets_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			"assets_surface_contract",
			{}
		)
	)

	return (
		not assets_contract.is_empty()
		and bool(
			assets_contract.get(
				"success",
				false
			)
		)
		and int(
			assets_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
		and str(
			assets_contract.get(
				"truth_state",
				""
			)
		).strip_edges().to_lower() not in [
			"",
			"cold",
			"resolving",
			"observable_partial"
		]
	)
func _prewarmed_market_surface_contract_for_actor(
	target_actor: Person,
	market_kind: String,
	status_text: String = "",
	selected_template_id: String = ""
) -> Dictionary:
	if target_actor == null:
		return {}

	var clean_market_kind: String = str(
		market_kind
	).strip_edges().to_lower()
	var pack: Dictionary = (
		_asset_surface_pack_for_actor(
			target_actor
		)
	)
	var contract_key: String = (
		"property_market_surface_contract"
		if clean_market_kind == "property"
		else "vehicle_market_surface_contract"
	)
	var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		pack.get(
			contract_key,
			{}
		)
	)

	if _market_surface_contract_is_retired_generic_surface(
		surface_contract,
		clean_market_kind
	):
		surface_contract = {}

	if not MainSceneLogic._market_surface_contract_is_renderable(
		surface_contract,
		clean_market_kind
	):
		var market_panel: Control = (
			property_market_panel
			if clean_market_kind == "property"
			else vehicle_market_panel
		)

		if (
			market_panel != null
			and is_instance_valid(market_panel)
		):
			var active_panel_contract: Dictionary = MainSceneHelpers._safe_dictionary(
				market_panel.get(
					"active_contract"
				)
			)

			if (
				int(
					active_panel_contract.get(
						"actor_id",
						int(target_actor.id)
					)
				) == int(target_actor.id)
				and not _market_surface_contract_is_retired_generic_surface(
					active_panel_contract,
					clean_market_kind
				)
				and MainSceneLogic._market_surface_contract_is_renderable(
					active_panel_contract,
					clean_market_kind
				)
			):
				surface_contract = active_panel_contract

	if (
		surface_contract.is_empty()
		or _market_surface_contract_is_retired_generic_surface(
			surface_contract,
			clean_market_kind
		)
		or not MainSceneLogic._market_surface_contract_is_renderable(
			surface_contract,
			clean_market_kind
		)
	):
		set_meta(
			"%s_market_real_surface_missing"
			% clean_market_kind,
			true
		)
		set_meta(
			"%s_market_fake_generic_fallback_forbidden"
			% clean_market_kind,
			true
		)
		set_meta(
			"%s_market_click_build_performed"
			% clean_market_kind,
			false
		)
		return {}

	surface_contract ["actor_id"] = int(
		target_actor.id
	)
	surface_contract ["ui_is_renderer_only"] = true
	surface_contract ["visible_click_work_required"] = false
	surface_contract ["visible_click_work_forbidden"] = true

	if str(status_text).strip_edges() != "":
		surface_contract ["status_text"] = (
			str(status_text).strip_edges()
		)

	if str(selected_template_id).strip_edges() != "":
		surface_contract ["selected_template_id"] = (
			str(selected_template_id).strip_edges()
		)

	return surface_contract

func _request_asset_surface_pack_prewarm(
	target_actor: Person,
	reason: String,
	force_rebuild: bool
) -> Dictionary:
	if (
		gs == null
		or target_actor == null
	):
		return {}

	var target_actor_id: int = int(
		target_actor.id
	)
	var payload: Dictionary = {
		"actor_id": target_actor_id,
		"source": reason,
		"force_rebuild": force_rebuild,
		"prewarm_only": true,
		"read_only": true,
		"visible_click_work_forbidden": true,
		"ready_gate_member": false,
		"ui_is_renderer_only": true
	}
	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": target_actor_id,
			"intent_type": "assets_surface_pack_prewarm",
			"surface_id": "assets_surface_deck",
			"action_id": "prewarm_assets_surface_pack",
			"payload": payload.duplicate(true),
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true,
			"target": {
				"route_kind": "engine_method",
				"engine_property": "assets_contract_engine",
				"method": "prewarm_actor_surface_pack",
				"pass_actor_payload": true,
				"actor_id": target_actor_id
			},
			"source": reason
		},
		{
			"actor_id": target_actor_id,
			"source": reason,
			"surface_id": "assets_surface_deck",
			"action_id": "prewarm_assets_surface_pack",
			"ephemeral_infrastructure_intent": true,
			"skip_global_intent_persistence": true,
			"skip_crr_observation": true,
			"authority_prevalidated": true,
			"skip_checks_and_balances": true
		}
	)

	return _assets_contract_route_result(
		report
	)
func _asset_surface_pack_for_actor(
	target_actor: Person
) -> Dictionary:
	if target_actor == null:
		return {}

	return MainSceneHelpers._safe_dictionary(
		asset_surface_pack_by_actor.get(
			_asset_surface_pack_cache_key(
				target_actor
			),
			{}
		)
	)


func _show_assets_panel(
	target_actor: Person = null,
	status_text: String = ""
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var resolved_actor: Person = (
		target_actor
		if target_actor != null
		else gs.player
	)

	if resolved_actor == null:
		return

	var actor_id: int = int(
		resolved_actor.id
	)



	if (
		assets_panel == null
		or not is_instance_valid(
			assets_panel
		)
	):
		set_meta(
			"assets_click_missing_persistent_chassis",
			true
		)
		set_meta(
			"assets_click_build_on_click",
			false
		)

		call_deferred(
			"_recover_assets_panel_chassis_and_reveal",
			actor_id,
			status_text
		)
		return

	var active_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		assets_panel.active_contract
	)
	var truth_state: String = str(
		active_contract.get(
			"truth_state",
			""
		)
	).strip_edges().to_lower()
	var actor_scoped_surface: bool = (
		int(
			assets_panel.get_meta(
				"prepainted_actor_id",
				-1
			)
		) == actor_id
		and int(
			active_contract.get(
				"actor_id",
				-1
			)
		) == actor_id
		and bool(
			active_contract.get(
				"success",
				false
			)
		)
	)

	if not actor_scoped_surface:
		set_meta(
			"assets_click_missing_actor_scoped_shell",
			true
		)
		set_meta(
			"assets_click_rejected",
			false
		)
		set_meta(
			"assets_click_build_on_click",
			false
		)

		call_deferred(
			"_recover_assets_panel_actor_lens_and_reveal",
			actor_id,
			status_text
		)
		return

	var fully_prepainted: bool = (
		truth_state not in [
			"",
			"cold",
			"resolving",
			"observable_partial"
		]
	)
	var observable_partial: bool = (
		not fully_prepainted
	)

	_suspend_standard_tab_popup_for_child_surface(
		"assets_contract_panel"
	)

	var return_to_activities: bool = (
		_suspend_activities_hub_for_child_surface(
			"assets_contract_panel"
		)
	)

	set_meta(
		"assets_panel_return_to_activities",
		return_to_activities
	)
	set_meta(
		"assets_panel_suspended_standard_surface",
		bool(
			get_meta(
				"standard_tab_popup_suspended_for_child_surface",
				false
			)
		)
	)


	assets_panel_open = true
	assets_panel.actor = resolved_actor
	assets_panel.z_as_relative = false
	assets_panel.z_index = 245
	assets_panel.visible = true
	assets_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	assets_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)

	if (
		assets_panel.status_label != null
		and is_instance_valid(
			assets_panel.status_label
		)
	):
		if status_text.strip_edges() != "":
			assets_panel.status_label.text = (
				status_text.strip_edges()
			)
		elif observable_partial:
			assets_panel.status_label.text = (
				"Wealth and controlled assets are publishing live."
			)

	_claim_interactive_surface_authority(
		assets_panel,
		"assets_contract_panel",
		"show_assets_panel_resident_reveal",
		true,
		true
	)


	_queue_auxiliary_surface_observation_after_visible_frame(
		"compact_assets_surface",
		actor_id,
		"assets_surface_visible_portfolio_truth_request"
	)

	set_meta(
		"assets_click_invariant_failed",
		false
	)
	set_meta(
		"assets_click_render_performed",
		false
	)
	set_meta(
		"assets_click_engine_calls",
		false
	)
	set_meta(
		"assets_click_authority_invoked_synchronously",
		false
	)
	set_meta(
		"assets_click_portfolio_observation_queue_write",
		false
	)
	set_meta(
		"assets_click_portfolio_observation_deferred_until_visible_frame",
		true
	)
	set_meta(
		"assets_click_market_deck_observation_queue_write",
		false
	)
	set_meta(
		"assets_click_market_deck_deferred_to_destination_doors",
		true
	)
	set_meta(
		"assets_click_reveal_only",
		true
	)
	set_meta(
		"assets_click_rejected",
		false
	)
	set_meta(
		"assets_click_full_prepainted",
		fully_prepainted
	)
	set_meta(
		"assets_click_partial_prepainted",
		observable_partial
	)

	EraLog.truth(
		"ERALIFE_ASSETS_CLICK_INVARIANT_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|revealable=true"
		+ "|full_prepainted="
		+ str(fully_prepainted).to_lower()
		+ "|partial_prepainted="
		+ str(observable_partial).to_lower()
		+ "|observation_after_visible_frame=true"
		+ "|input_has_absolute_priority=true"
		+ "|engine_calls=false"
		+ "|authority_on_click=false"
		+ "|build_on_click=false"
		+ "|rejected=false"
		+ "|at_ms="
		+ str(
			Time.get_ticks_msec()
		)
