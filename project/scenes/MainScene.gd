func _ensure_startup_intro_title_shine_material() -> void:
	if startup_intro_title_label == null:
		return

	if startup_intro_title_shine_material == null:
		var shader:= Shader.new()
		shader.code = "\nshader_type canvas_item;\n\nuniform float shine_enabled : hint_range(0.0, 1.0) = 1.0;\nuniform float shine_cycle = 2.30;\nuniform float shine_active = 0.95;\nuniform float shine_width = 0.24;\nuniform float rainbow_speed = 0.65;\nuniform float rainbow_strength = 0.92;\nuniform float band_softness = 0.08;\n\nvec3 hsv2rgb(vec3 c) {\n\tvec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n\trgb = rgb * rgb * (3.0 - 2.0 * rgb);\n\treturn c.z * mix(vec3(1.0), rgb, c.y);\n}\n\nvoid fragment() {\n\tvec4 base = texture(TEXTURE, UV) * COLOR;\n\n\tfloat visible_mask = step(0.001, base.a);\n\tfloat enabled_mask = step(0.001, shine_enabled);\n\n\tfloat cycle_time = mod(TIME, max(shine_cycle, 0.001));\n\tfloat active = step(cycle_time, shine_active);\n\tfloat progress = clamp(cycle_time / max(shine_active, 0.001), 0.0, 1.0);\n\n\tfloat band_center = mix(-shine_width, 1.0 + shine_width, progress);\n\tfloat band_dist = abs(UV.x - band_center);\n\tfloat band = 1.0 - smoothstep(max(shine_width - band_softness, 0.001), shine_width, band_dist);\n\n\tfloat ripple = 0.5 + 0.5 * sin((UV.x * 26.0) - (TIME * 8.0) + (UV.y * 10.0));\n\tfloat hue = fract((UV.x * 0.85) - (TIME * rainbow_speed) + (ripple * 0.15));\n\tvec3 rainbow = hsv2rgb(vec3(hue, 0.78, 1.0));\n\n\tfloat shine_mask = visible_mask * enabled_mask * active * band;\n\tvec3 lit = base.rgb + (rainbow * shine_mask * rainbow_strength * base.a);\n\n\tCOLOR = vec4(lit, base.a);\n}\n"








































		startup_intro_title_shine_material = ShaderMaterial.new()
		startup_intro_title_shine_material.shader = shader

	startup_intro_title_label.material = startup_intro_title_shine_material


func _set_startup_intro_title_shine_enabled(enabled: bool) -> void:
	if startup_intro_title_shine_material != null:
		startup_intro_title_shine_material.set_shader_parameter(
			"shine_enabled",
			1.0 if enabled else 0.0
		)

	if startup_intro_title_label == null:
		return

	if enabled:
		if startup_intro_title_shine_material != null:
			startup_intro_title_label.material = startup_intro_title_shine_material
	else:
		startup_intro_title_label.material = null


