	eraccount_profile_panel.name = (
		"ErAccountProfilePanel"
	)
	eraccount_profile_panel.request_close.connect(
		_on_eraccount_profile_panel_request_close
	)
	eraccount_profile_panel.request_command.connect(
		_on_eraccount_profile_panel_request_command
	)
	add_child(
