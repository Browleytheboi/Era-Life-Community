func _ensure_world_browser_contract_ready_bridge() -> void:
	if (
		gs == null
		or gs.world_observability_contract_engine == null
	):
		return

	var callback:= Callable(
		self,
		"_on_world_browser_contract_ready"
	)
	var browser_signal: Signal = (
		gs.world_observability_contract_engine.world_browser_contract_ready
	)

	if browser_signal.is_connected(
		callback
	):
		return

	browser_signal.connect(
		callback
	)

	set_meta(
		"other_countries_world_browser_signal_bridge_connected",
		true
	)
	set_meta(
		"other_countries_world_browser_signal_bridge_mutates_truth",
		false
	)
func _on_property_makeover_action_requested(path_id: String, action_id: String, payload: Dictionary) -> void:
	var property_id: int = int(payload.get("property_id", -1))

	_restore_property_surface_layering_after_action_result_popup("property_makeover_action_requested_pre_intent")

	var report: Dictionary = _express_global_ui_intent({
		"intent_type": "property_makeover_action",
		"surface_id": "property_makeover_panel",
		"action_id": action_id,
		"payload": {
			"property_id": property_id,
			"path_id": path_id,
			"makeover_action": action_id,
			"source": "mainscene.property_makeover_panel"
		},
		"target": {
			"route_kind": "engine_method",
			"engine_property": "property_makeover_contract_engine",
			"method": "commit_makeover_action",
			"pass_actor_payload": true
		},
		"source": "mainscene.property_makeover_panel"
	}, {
		"source": "mainscene.property_makeover_panel",
		"surface_id": "property_makeover_panel",
		"action_id": action_id
	})

	var result: Dictionary = _market_panel_route_result(report)
	_maybe_show_action_result_popup(result)

	if typeof(result.get("surface_contract", {})) == TYPE_DICTIONARY and property_makeover_panel != null and is_instance_valid(property_makeover_panel):
