func _on_relationship_profile_panel_edit_requested(
	target_id: int,
	modification_contract: Dictionary = {}
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var target: Person = (
		_relationship_profile_resolve_target_for_ui(
			target_id,
			true
		)
	)

	if target == null:
		return

	if (
		not bool(target.alive)
		or float(target.health) <= 0.0
	):
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.set_status(
				"Dead people cannot be modified."
			)

		return

	var resolved_modification_contract: Dictionary = (
		MainSceneHelpers._safe_dictionary(
			modification_contract
		)
	)




	if (
		resolved_modification_contract.is_empty()
		and relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		resolved_modification_contract = (
			MainSceneHelpers._safe_dictionary(
				relationship_profile_panel
				.active_contract
				.get(
					"modification_contract",
					{}
				)
			)
		)

	if resolved_modification_contract.is_empty():
		if (
			relationship_profile_panel != null
			and is_instance_valid(
				relationship_profile_panel
			)
		):
			relationship_profile_panel.set_status(
				"Modification truth is observable but still resolving."
			)

		set_meta(
			"relationship_edit_missing_precomputed_contract",
			true
		)
		set_meta(
			"relationship_edit_missing_precomputed_contract_target_id",
			target_id
		)

		call_deferred(
			"_hydrate_institution_hub_surface",
			"relationships",
			institution_hub_current_section,
			"missing_modification_contract_repair"
		)

		return

	if (
		modification_panel == null
		or not is_instance_valid(
			modification_panel
		)
	):
		_ensure_modification_panel()

	if (
		modification_panel == null
		or not is_instance_valid(
			modification_panel
		)
	):
		set_meta(
			"modification_panel_click_missing_prewarmed_shell",
			true
		)

		return


	modification_panel.open_contract(
		resolved_modification_contract
	)

	_claim_interactive_surface_authority(
		modification_panel,
		"modification_panel:%d"
		% target_id,
		"open_precomputed_modification_contract",
		true,
		true
	)

	modification_panel.visible = true
	modification_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)

	if (
		relationship_profile_panel != null
		and is_instance_valid(
			relationship_profile_panel
		)
	):
		relationship_profile_panel.visible = false
		relationship_profile_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	if (
		relationship_editor_popup != null
		and is_instance_valid(
			relationship_editor_popup
		)
	):
		relationship_editor_popup.visible = false
		relationship_editor_popup.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	set_meta(
		"modification_panel_opened_from_precomputed_contract",
		true
	)
	set_meta(
		"modification_panel_open_click_requested_no_engine_truth",
		true
	)
	set_meta(
		"modification_panel_open_target_id",
		target_id
	)
	set_meta(
		"modification_panel_opened_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _install_switched_actor_activities_contract_from_packet(
	target: Person,
	viewer_packet: Dictionary
) -> bool:
	if (
		gs == null
		or target == null
		or viewer_packet.is_empty()
	):
		return false

	var activities_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		viewer_packet.get(
			"activities_hub_contract",
			{}
		)
	)

	if activities_contract.is_empty():
		var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			viewer_packet.get(
				"surface_contract",
				{}
			)
		)
		activities_contract = MainSceneHelpers._safe_dictionary(
			surface_contract.get(
				"activities_hub_contract",
				{}
			)
		)

	var target_id: int = int(target.id)
	var renderable: bool = (
		str(
			activities_contract.get(
				"schema",
				""
			)
		) == "eralife.activities_hub_contract"
		and int(
			activities_contract.get(
				"actor_id",
				-1
			)
		) == target_id
		and not MainSceneHelpers._safe_dictionary(
			activities_contract.get(
				"identity_overview",
				{}
			)
		).is_empty()
		and not MainSceneHelpers._safe_array(
			activities_contract.get(
				"section_tabs",
				[]
			)
		).is_empty()
	)

	if not renderable:
		set_meta(
			"switched_actor_activities_contract_missing_from_packet",
			true
		)
		set_meta(
			"switched_actor_activities_contract_missing_actor_id",
			target_id
		)
		set_meta(
			"switched_actor_activities_contract_local_engine_repair_forbidden",
			true
		)

		if typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state [
				"switched_actor_activities_contract_pending"
			] = true
			gs.scenario_state [
				"switched_actor_activities_contract_pending_actor_id"
			] = target_id
			gs.scenario_state [
				"switched_actor_activities_contract_local_engine_repair_forbidden"
			] = true

		return false

	_ensure_activities_hub_panel()

	if (
		activities_hub_panel == null
		or not is_instance_valid(
			activities_hub_panel
		)
	):
		return false

	activities_hub_panel.render_contract(
		activities_contract
	)
	activities_hub_panel.visible = false
	activities_hub_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	activities_hub_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	activities_hub_panel.set_meta(
		"prepainted_actor_id",
		target_id
	)
	activities_hub_panel.set_meta(
		"prepainted_before_activities_click",
		true
	)
	activities_hub_panel.set_meta(
		"visible_click_work_required",
		false
	)
	activities_hub_active_actor_id = target_id
	activities_hub_active_section_id = str(
		activities_contract.get(
			"active_section",
			"all"
		)
	).strip_edges().to_lower()

	if activities_hub_active_section_id == "":
		activities_hub_active_section_id = "all"

	set_meta(
		"switched_actor_activities_contract_installed",
		true
	)
	set_meta(
		"switched_actor_activities_contract_installed_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_activities_contract_installed_at_ms",
		int(Time.get_ticks_msec())
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"switched_actor_activities_contract_pending"
		] = false
		gs.scenario_state [
			"switched_actor_activities_contract_hot_actor_id"
		] = target_id
		gs.scenario_state [
			"switched_actor_activities_contract_click_build_forbidden"
		] = true

	return true
func _switched_actor_support_surface_packet_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var inspected: int = 0

	while (
		not queue.is_empty()
		and inspected < 48
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		if str(
			cursor.get(
				"schema",
				""
			)
		) == "eralife.control_switch.support_surface_packet":
			return cursor

		for raw_key in [
			"route_report",
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				(nested_raw as Dictionary).duplicate(true)
			)

			if not nested.is_empty():
				queue.append(nested)

	return {}


func _request_switched_actor_support_surface_packet_after_visible(
	target: Person,
	source: String
) -> Dictionary:
	if (
		gs == null
		or target == null
	):
		return {}

	var target_id: int = int(target.id)
	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": target_id,
			"target_id": target_id,
			"intent_type": "control_switch_support_surface_prewarm",
			"surface_id": "playable_life_shell",
			"action_id": "prewarm_support_surfaces",
			"payload": {
				"actor_id": target_id,
				"source": source,
				"prewarm_only": true,
				"switch_press_build_forbidden": true,
				"ui_is_expression_only": true
			},
			"target": {
				"route_kind": "engine_method",
				"engine_property": "universal_switch_contract_engine",
				"method": "prewarm_control_switch_support_surface_packet",
				"pass_actor_payload": true,
				"actor_id": target_id
			},
			"source": source,
			"ui_is_expression_only": true
		},
		{
			"actor_id": target_id,
			"target_id": target_id,
			"surface_id": "playable_life_shell",
			"action_id": "prewarm_support_surfaces",
			"source": source
		}
	)

	return _switched_actor_support_surface_packet_route_result(
		report
	)
func _install_switched_actor_life_diary_from_published_packet(
	target: Person,
	profile_packet: Dictionary,
	source: String,
	cursor_contract: Dictionary = {}
) -> bool:
	if (
		gs == null
		or target == null
		or profile_packet.is_empty()
	):
		return false

	var target_id: int = int(
		target.id
	)

	if target_id <= 0:
		return false




	var surface_contract: Dictionary = (
		_zero_frame_contract_dictionary(
			profile_packet.get(
				"surface_contract",
				{}
			)
		)
	)

	if (
		int(
			profile_packet.get(
				"actor_id",
				target_id
			)
		) != target_id
		or (
			not surface_contract.is_empty()
			and int(
				surface_contract.get(
					"actor_id",
					target_id
				)
			) != target_id
		)
	):
		return false

	var diary_packet: Dictionary = (
		_zero_frame_contract_dictionary(
			profile_packet.get(
				"life_diary_packet",
				surface_contract.get(
					"life_diary_packet",
					{}
				)
			)
		)
	)

	var life_lines: Array = (
		_zero_frame_contract_array(
			profile_packet.get(
				"life_diary_lines",
				[]
			)
		)
	)

	if life_lines.is_empty():
		life_lines = (
			_zero_frame_contract_array(
				diary_packet.get(
					"lines",
					[]
				)
			)
		)

	if life_lines.is_empty():
		life_lines = (
			_zero_frame_contract_array(
				surface_contract.get(
					"life_diary_lines",
					[]
				)
			)
		)

	var life_entries: Array = (
		_zero_frame_contract_array(
			profile_packet.get(
				"life_diary_entries",
				[]
			)
		)
	)

	if life_entries.is_empty():
		life_entries = (
			_zero_frame_contract_array(
				diary_packet.get(
					"entries",
					[]
				)
			)
		)

	if life_entries.is_empty():
		life_entries = (
			_zero_frame_contract_array(
				surface_contract.get(
					"life_diary_entries",
					[]
				)
			)
		)




	if (
		life_lines.is_empty()
		and not life_entries.is_empty()
	):
		for raw_entry in life_entries:
			if typeof(
				raw_entry
			) == TYPE_ARRAY:
				var entry_lines: Array = (
					raw_entry as Array
				)

				for raw_line in entry_lines:
					life_lines.append(
						str(
							raw_line
						)
					)
			else:
				life_lines.append(
					str(
						raw_entry
					)
				)

	if (
		life_entries.is_empty()
		and not life_lines.is_empty()
	):
		life_entries = [
			life_lines.duplicate(false)
		]

	if life_lines.is_empty():
		return false

	var diary_signature: String = str(
		profile_packet.get(
			"life_diary_signature",
			diary_packet.get(
				"signature",
				surface_contract.get(
					"life_diary_signature",
					""
				)
			)
		)
	).strip_edges()

	if diary_signature == "":
		diary_signature = (
			"published_switch_diary:%d:%d:%d:%d"
			% [
				target_id,
				int(
					gs.year
				),
				int(
					target.age
				),
				hash(
					life_lines
				)
			]
		)






	age_up_diary_entries = (
		life_entries.duplicate(false)
	)

	set_meta(
		MainSceneHelpers._life_diary_actor_cache_key(
			target_id
		),
		life_entries.duplicate(false)
	)
	set_meta(
		MainSceneHelpers._life_diary_actor_flat_cache_key(
			target_id
		),
		life_lines.duplicate(false)
	)
	set_meta(
		"life_diary_render_cached_lines",
		life_lines.duplicate(false)
	)
	set_meta(
		"life_diary_render_cached_signature",
		diary_signature
	)
	set_meta(
		"life_diary_loaded_owner_id",
		target_id
	)
	set_meta(
		"switched_actor_life_diary_bound_from_published_packet",
		true
	)
	set_meta(
		"switched_actor_life_diary_bound_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_life_diary_bound_source",
		source
	)
	set_meta(
		"switched_actor_life_diary_bound_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"switched_actor_life_diary_render_rebuild",
		false
	)

	var cursor_contract_used: bool = (
		not cursor_contract.is_empty()
		and int(
			cursor_contract.get(
				"actor_id",
				target_id
			)
		) == target_id
	)

	if cursor_contract_used:
		diary_world_feed_cursor = clampi(
			int(
				cursor_contract.get(
					"world_feed_cursor",
					gs.world_feed.size()
				)
			),
			0,
			gs.world_feed.size()
		)
		diary_global_memory_cursor = maxi(
			0,
			int(
				cursor_contract.get(
					"global_memory_cursor",
					0
				)
			)
		)
		diary_player_memory_cursor = clampi(
			int(
				cursor_contract.get(
					"player_memory_cursor",
					(
						target.memories.size()
						if target.memories != null
						else 0
					)
				)
			),
			0,
			(
				target.memories.size()
				if target.memories != null
				else 0
			)
		)
	else:


		_reset_diary_delta_cursors()

	set_meta(
		"switched_actor_life_diary_cursor_contract_used",
		cursor_contract_used
	)
	set_meta(
		"switched_actor_life_diary_engine_calls",
		not cursor_contract_used
	)

	var press_frame_lens_cache: Dictionary = (
		_zero_frame_contract_dictionary(
			profile_packet.get(
				"press_frame_lens_cache",
				surface_contract.get(
					"press_frame_lens_cache",
					{}
				)
			)
		)
	)
	var precomposed_lens_text: String = str(
		press_frame_lens_cache.get(
			"life_diary_text",
			diary_packet.get(
				"text",
				""
			)
		)
	).strip_edges()



	if precomposed_lens_text == "":
		precomposed_lens_text = (
			_relationship_profile_press_frame_lens_text_for_lines(
				life_lines
			)
		)

	var visible_diary_rebound: bool = false



	if (
		gs.player != null
		and int(
			gs.player.id
		) == target_id
		and current_panel in [
			"",
			"life"
		]
		and output_label != null
		and is_instance_valid(
			output_label
		)
		and precomposed_lens_text != ""
	):
		output_label.bbcode_enabled = true
		output_label.text = precomposed_lens_text
		output_label.visible = true
		output_label.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

		visible_diary_rebound = true

	set_meta(
		"switched_actor_life_diary_visible_text_rebound",
		visible_diary_rebound
	)
	set_meta(
		"switched_actor_life_diary_visible_text_actor_id",
		target_id
	)
	set_meta(
		"switched_actor_life_diary_visible_text_precomposed",
		true
	)
	set_meta(
		"switched_actor_life_diary_full_render_called",
		false
	)

	EraLog.truth(
		"ERALIFE_SWITCH_LIFE_DIARY_BIND_TRUTH"
		+ "|actor_id=" + str(target_id)
