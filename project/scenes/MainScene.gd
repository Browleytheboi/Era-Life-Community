		)
	).strip_edges().to_lower()

	if career_hub_active_section_id == "":
		career_hub_active_section_id = "overview"

	if career_hub_active_lane not in [
		"full_time",
		"part_time"
	]:
		career_hub_active_lane = "full_time"

	if preserved_existing_hot_contract:



		if reveal_surface:
			career_hub_panel.visible = true
			career_hub_panel.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			career_hub_panel.process_mode = (
				Node.PROCESS_MODE_INHERIT
			)
			career_hub_panel.z_as_relative = false
			career_hub_panel.z_index = 250

			_bring_modal_to_front(
				career_hub_panel
			)

			_claim_interactive_surface_authority(
				career_hub_panel,
				"career_hub_panel:%d"
				% int(
					actor.id
				),
				"career_hub_existing_resident_contract_preserved",
				true,
				true
			)

	elif reveal_surface:
		career_hub_panel.open_contract(
			contract
		)
		career_hub_panel.z_as_relative = false
		career_hub_panel.z_index = 250

		var panel_parent: Node = (
			career_hub_panel.get_parent()
		)

		if panel_parent != null:
			panel_parent.move_child(
				career_hub_panel,
				panel_parent.get_child_count() - 1
			)

		_claim_interactive_surface_authority(
			career_hub_panel,
			"career_hub_panel:%d"
			% int(
				actor.id
			),
			"career_hub_contract_rendered",
			true,
			true
		)

	else:
		career_hub_panel.render_contract(
			contract
		)
		career_hub_panel.visible = false
		career_hub_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	var result_type: String = str(
		route_result.get(
			"type",
			""
		)
	).strip_edges().to_lower()

	if result_type == "scenario_prompt":
		_refresh_scenario_ui_from_result(
			route_result
		)
	elif route_result.has(
		"popup_text"
	):
		_maybe_show_action_result_popup(
			route_result
		)

	var result_text: String = str(
		route_result.get(
			"text",
			""
		)
	).strip_edges()

	if (
		result_text != ""
		and career_hub_panel != null
		and is_instance_valid(
			career_hub_panel
		)
	):
		career_hub_panel.set_status(
			result_text
		)

	if (
		result_text != ""
		and action_id not in projection_only_actions
	):
		_append_text_to_diary(
			result_text,
			false
		)

	return route_result


