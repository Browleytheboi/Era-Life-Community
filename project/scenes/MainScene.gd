			"soul_seed": "who_you_are",
			"world_seed": "what_is_possible",
			"destiny_pressure": "what_pulls_you",
			"player_choice": "what_you_choose"
		}
	}
	safe_settings ["soul_seed_contract"] = soul_seed_contract.duplicate(true)

	return {
		"schema": "eralife.god_mode_life_prewarm_contract",
		"version": 1,
		"id": "main_scene.god_mode_life_prewarm",
		"reason": reason,
		"signature": _god_mode_life_prewarm_signature(safe_settings),
		"settings": safe_settings.duplicate(true),
		"loadout": {
			"identity": {
				"first_name": str(safe_settings.get("first_name", "")).strip_edges(),
				"last_name": str(safe_settings.get("last_name", "")).strip_edges(),
				"gender": str(safe_settings.get("gender", "")).strip_edges()
			},
			"birth": {
				"year": int(safe_settings.get("year", 2000)),
				"month": int(safe_settings.get("month", 1)),
				"day": int(safe_settings.get("day", 1)),
				"era": str(safe_settings.get("era", "")).strip_edges(),
				"country": str(safe_settings.get("country", "")).strip_edges(),
				"city": str(safe_settings.get("city", "")).strip_edges()
			},
			"stats": {
				"health": int(safe_settings.get("health", 100)),
				"smarts": int(safe_settings.get("smarts", 100)),
				"looks": int(safe_settings.get("looks", 100)),
				"mental_health": int(safe_settings.get("mental_health", 100)),
				"satisfaction": int(safe_settings.get("satisfaction", 100)),
				"fertility": int(safe_settings.get("fertility", 50)),
				"bank_balance": int(safe_settings.get("bank_balance", 0))
			},
			"reality": {
				"mode": reality_mode,
				"label": str(safe_settings.get("reality_mode_label", "")).strip_edges(),
				"feature_overrides": feature_overrides.duplicate(true)
			},
			"supernatural": {
				"bending_type": bending_type,
				"starting_infinity_stones": int(safe_settings.get("starting_infinity_stones", 0)),
				"start_with_red_bonnet": bool(safe_settings.get("start_with_red_bonnet", false)),
				"superpower_configurator": power_config.duplicate(true)
			},
			"class": {
				"social_class": str(safe_settings.get("social_class", "Commoner")).strip_edges(),
				"royal_rank": str(safe_settings.get("royal_rank", "")).strip_edges()
			},
			"household": household_contract.duplicate(true) if household_enabled else {},
			"soul_seed": soul_seed_contract.duplicate(true)
		},
		"prewarm_policy": {
			"mode": "offscreen_birth_shell_life_capsule",
			"ui_is_pure_renderer": true,
			"household_contract_enabled": household_enabled,
			"household_members_created_before_start_selection": household_enabled,
			"allow_household_start_actor_activation_after_prewarm": household_enabled,
