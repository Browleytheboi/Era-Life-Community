func _show_entity_relationship_profile_popup(entity_id: String, _cached_card: Dictionary = {}) -> void:
	_ensure_entity_relationship_profile_popup()
	if entity_relationship_profile_popup == null:
		return

	var profile_contract: Dictionary = {}
	if gs != null and gs.pets_contract_engine != null:
		profile_contract = gs.pets_contract_engine.get_pet_profile_contract(
			gs.player,
			entity_id,
			{ "source": "mainscene.entity_profile_popup"}
		)

	if profile_contract.is_empty():
		return

	var entity: Dictionary = MainSceneHelpers._safe_dictionary(profile_contract.get("entity", {}))
	var identity_contract: Dictionary = MainSceneHelpers._safe_dictionary(profile_contract.get("profile_identity", {}))
	var bond_contract: Dictionary = MainSceneHelpers._safe_dictionary(profile_contract.get("bond_contract", {}))
	var card_contract: Dictionary = MainSceneHelpers._safe_dictionary(profile_contract.get("card", {}))
	var surface_context: Dictionary = MainSceneHelpers._safe_dictionary(card_contract.get("surface_context", {}))
	var display_name: String = str(identity_contract.get("display_name", entity.get("display_name", "Pet Profile")))

	entity_relationship_profile_popup.visible = true
	entity_relationship_profile_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	entity_relationship_profile_popup_open = true
	entity_relationship_profile_active_entity_id = entity_id

	entity_relationship_profile_title.text = "%s'S PET PROFILE" % display_name.to_upper()

	if entity_relationship_profile_name_label != null:
		entity_relationship_profile_name_label.text = display_name

	if entity_relationship_profile_species_badge != null:
		entity_relationship_profile_species_badge.text = str(identity_contract.get("species_badge", "ANIMAL"))

	if entity_relationship_profile_age_label != null:
		entity_relationship_profile_age_label.text = "Age: %s" % str(identity_contract.get("age_label", "0"))

	if entity_relationship_profile_role_label != null:
		entity_relationship_profile_role_label.text = str(identity_contract.get("relationship_role", "Companion"))

	if entity_relationship_profile_bond_value_label != null:
		entity_relationship_profile_bond_value_label.text = "%d%%" % int(bond_contract.get("value", 0))
		entity_relationship_profile_bond_value_label.add_theme_color_override(
			"font_color",
			Color(bond_contract.get("color", Color(1.0, 0.72, 0.84, 1.0)))
		)

	if entity_relationship_profile_bond_caption_label != null:
		entity_relationship_profile_bond_caption_label.text = str(bond_contract.get("description", ""))

	_entity_relationship_apply_bond_panel_glow(int(bond_contract.get("value", 0)))

	entity_relationship_profile_profile.clear()
	for raw_line in MainSceneHelpers._safe_array(profile_contract.get("profile_lines", [])):
		entity_relationship_profile_profile.append_text("• " + str(raw_line) + "\n")

	_clear_container_children(entity_relationship_profile_stats)
	_clear_container_children(entity_relationship_profile_actions)
	_clear_container_children(entity_relationship_profile_traits_flow)

	for raw_chip in MainSceneHelpers._safe_array(profile_contract.get("trait_chips", [])):
		_entity_relationship_profile_add_trait_chip(MainSceneHelpers._safe_dictionary(raw_chip))

	var previous_stat_snapshot: Dictionary = {}
	if entity_relationship_profile_popup.has_meta("pet_profile_stat_snapshot"):
		previous_stat_snapshot = MainSceneHelpers._safe_dictionary(entity_relationship_profile_popup.get_meta("pet_profile_stat_snapshot"))

	var last_commit_state_delta: Dictionary = {}
	var last_commit_bond_delta: int = 0
	if entity_relationship_profile_popup.has_meta("pet_profile_last_commit_state_delta"):
		last_commit_state_delta = MainSceneHelpers._safe_dictionary(entity_relationship_profile_popup.get_meta("pet_profile_last_commit_state_delta"))
	if entity_relationship_profile_popup.has_meta("pet_profile_last_commit_bond_delta"):
		last_commit_bond_delta = int(entity_relationship_profile_popup.get_meta("pet_profile_last_commit_bond_delta"))

	var current_stat_snapshot: Dictionary = {}
	for raw_row in MainSceneHelpers._safe_array(profile_contract.get("stat_rows", [])):
		var row: Dictionary = MainSceneHelpers._safe_dictionary(raw_row)
		var stat_key: String = str(row.get("key", row.get("title", ""))).strip_edges().to_lower()
		row ["previous_value"] = int(previous_stat_snapshot.get(stat_key, row.get("value", 0)))
		row ["commit_delta"] = MainSceneLogic._entity_relationship_profile_commit_delta_for_stat(stat_key, last_commit_state_delta, last_commit_bond_delta)
		_entity_relationship_profile_add_stat_row(row, surface_context)
		current_stat_snapshot [stat_key] = int(row.get("value", 0))

	entity_relationship_profile_popup.set_meta("pet_profile_stat_snapshot", current_stat_snapshot)
	entity_relationship_profile_popup.set_meta("pet_profile_last_commit_state_delta", {})
	entity_relationship_profile_popup.set_meta("pet_profile_last_commit_bond_delta", 0)

	var action_groups: Array = MainSceneHelpers._safe_array(profile_contract.get("action_groups", []))
	var actions: Array = MainSceneHelpers._safe_array(profile_contract.get("actions", []))
	if gs != null and gs.mythical_pets_contract_engine != null:
		actions = gs.mythical_pets_contract_engine.append_mythical_actions(gs.player, entity_id, actions)
		if action_groups.is_empty():
			action_groups = [{ "title": "ACTIONS", "description": "", "actions": actions.duplicate(true)}]

	for raw_group in action_groups:
		_entity_relationship_profile_add_action_group(MainSceneHelpers._safe_dictionary(raw_group), entity_id)

	_refresh_entity_relationship_profile_scroll_lens("entity_relationship_profile_rendered")

	entity_relationship_profile_status.text = ""
	_claim_interactive_surface_authority(
		entity_relationship_profile_popup,
		"entity_relationship_profile:%s" % entity_id,
		"show_entity_relationship_profile_popup",
		true,
		true
	)

