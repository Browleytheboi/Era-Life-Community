func _apply_playable_life_viewer_life_diary_packet_zero_frame(
	life_diary_packet: Dictionary,
	surface: Dictionary,
	reason: String = "playable_life_viewer_life_diary_packet"
) -> Array:
	var surface_lines: Array = MainSceneHelpers._safe_array(
		life_diary_packet.get(
			"lines",
			surface.get(
				"life_diary_lines",
				[]
			)
		)
	)
	var signature: String = str(
		life_diary_packet.get(
			"signature",
			surface.get(
				"life_diary_signature",
				""
			)
		)
	).strip_edges()
	var ready_text: String = str(
		life_diary_packet.get(
			"bbcode_text",
			life_diary_packet.get(
				"text",
				""
			)
		)
	).strip_edges()

	var explicit_clear_requested: bool = bool(
		life_diary_packet.get(
			"clear_existing_diary",
			surface.get(
				"clear_existing_life_diary",
				false
			)
		)
	)
	var packet_contains_diary_truth: bool = (
		not surface_lines.is_empty()
		or ready_text != ""
	)




	if (
		not packet_contains_diary_truth
		and not explicit_clear_requested
	):
		var cached_lines_raw: Variant = get_meta(
			"life_diary_render_cached_lines",
			[]
		)
		return (
			(cached_lines_raw as Array).duplicate(false)
			if typeof(cached_lines_raw) == TYPE_ARRAY
			else []
		)

	if (
		output_label != null
		and is_instance_valid(output_label)
	):
		output_label.visible = true
		output_label.scroll_active = true
		output_label.bbcode_enabled = true
		output_label.clear()

		var ready_text_has_bbcode: bool = (
			ready_text.find("[center]") != -1
			or ready_text.find("[b]") != -1
			or ready_text.find("[color=") != -1
		)

		if ready_text != "" and ready_text_has_bbcode:
			output_label.append_text(
				ready_text
			)
			if not ready_text.ends_with("\n"):
				output_label.append_text(
					"\n"
				)
		elif not surface_lines.is_empty():
			for raw_line in surface_lines:
				_append_formatted_life_diary_line(
					output_label,
					str(raw_line)
				)
		elif ready_text != "":
			var fallback_lines: PackedStringArray = (
				ready_text.split(
					"\n",
					false
				)
			)
			for raw_line in fallback_lines:
				_append_formatted_life_diary_line(
					output_label,
					str(raw_line)
				)

	if not surface_lines.is_empty():
		set_meta(
			"life_diary_render_cached_lines",
			surface_lines.duplicate(true)
		)
		set_meta(
			"life_diary_render_cached_signature",
			signature
		)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"playable_life_viewer_life_diary_packet_applied"
		] = true
		gs.scenario_state [
			"playable_life_viewer_life_diary_packet_reason"
		] = reason
		gs.scenario_state [
			"playable_life_viewer_life_diary_packet_at_ms"
		] = int(
			Time.get_ticks_msec()
		)
		gs.scenario_state [
			"playable_life_viewer_life_diary_packet_used_formatted_headers"
		] = true

	return surface_lines.duplicate(false)
func _apply_playable_life_viewer_packet_zero_frame(viewer_packet: Dictionary, _clean_text: String = "") -> void:
	if gs == null or gs.player == null:
		return

	var packet: Dictionary = viewer_packet.duplicate(false)
	if packet.is_empty():
		return

	var surface: Dictionary = _zero_frame_contract_dictionary(
		packet.get("surface_contract", {})
	)
	if surface.is_empty():
		return

	var life_diary_packet: Dictionary = _zero_frame_contract_dictionary(
		packet.get("life_diary_packet", {})
	)
	var hud_packet: Dictionary = _zero_frame_contract_dictionary(
		packet.get("hud_packet", {})
	)
	var player_stats_packet: Dictionary = _zero_frame_contract_dictionary(
		packet.get("player_stats_packet", {})
	)
	var nav_packet: Dictionary = _zero_frame_contract_dictionary(
		packet.get("nav_packet", {})
	)

	var hud_truth: Dictionary = _zero_frame_contract_dictionary(
		hud_packet.get(
			"hud_truth",
			surface.get("hud_truth", {})
		)
	)
	var surface_entries: Array = _zero_frame_contract_array(
		life_diary_packet.get(
			"entries",
			surface.get("life_diary_entries", [])
		)
	)

	surface ["hud_truth"] = hud_truth.duplicate(true)
	surface ["player_stats_packet"] = player_stats_packet.duplicate(true)
	surface ["nav_packet"] = nav_packet.duplicate(true)
	surface ["prewarmed_playable_life_shell"] = true
	surface ["runtime_hud_shell_prewarmed"] = true
	surface ["switch_press_must_not_build_surface"] = true
	surface ["playable_life_viewer_packet_consumed"] = true
	surface ["platform_renderer_must_not_build"] = true
	surface ["generic_surface_renderer_forbidden"] = true

	if not surface_entries.is_empty():
		age_up_diary_entries = surface_entries.duplicate(true)

	current_panel = "life"

	_apply_playable_life_viewer_nav_packet_zero_frame(
		nav_packet.duplicate(false),
		"playable_life_viewer_packet_zero_frame"
	)

	_apply_playable_life_viewer_hud_packet_zero_frame(
		hud_packet.duplicate(false),
		"playable_life_viewer_packet_zero_frame"
	)

	var surface_lines: Array = _apply_playable_life_viewer_life_diary_packet_zero_frame(
		life_diary_packet.duplicate(false),
		surface.duplicate(false),
		"playable_life_viewer_packet_zero_frame"
	)

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = true
		player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_apply_player_stats_packet_to_overlay_zero_frame(
		player_stats_packet.duplicate(false),
		surface.duplicate(false),
		"playable_life_viewer_packet_zero_frame"
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		var packet_actor_id: int = int(surface.get("actor_id", int(gs.player.id)))

		gs.scenario_state ["zero_frame_consciousness_switch_surface"] = surface.duplicate(true)
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_active"] = true
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_actor_id"] = packet_actor_id
		gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_until_ms"] = int(Time.get_ticks_msec()) + 8500
		gs.scenario_state ["playable_life_viewer_packet_consumed_directly"] = true
		gs.scenario_state ["playable_life_viewer_generic_renderer_skipped"] = true
		gs.scenario_state ["playable_life_viewer_visible_packet_actor_id"] = packet_actor_id
		gs.scenario_state ["playable_life_viewer_visible_packet_reason"] = "playable_life_viewer_packet_zero_frame"
		gs.scenario_state ["playable_life_viewer_visible_packet_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["playable_life_viewer_visible_packet_life_lines"] = surface_lines.duplicate(true)
