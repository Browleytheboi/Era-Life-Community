func _bind_crime_panel_observation_authority(
	schedule_replay: bool = true
) -> bool:
	var engine_resident_callback:= Callable(
		self,
		"_on_resident_runtime_engine_became_resident_for_crime"
	)

	var previous_observation_game_state: GameState = (
		crime_panel_observation_game_state
	)



	if (
		previous_observation_game_state != null
		and is_instance_valid(
			previous_observation_game_state
		)
		and previous_observation_game_state != gs
		and previous_observation_game_state.has_signal(
			"resident_runtime_engine_became_resident"
		)
		and previous_observation_game_state.is_connected(
			"resident_runtime_engine_became_resident",
			engine_resident_callback
		)
	):
		previous_observation_game_state.disconnect(
			"resident_runtime_engine_became_resident",
			engine_resident_callback
		)

	crime_panel_observation_game_state = gs









	if (
		crime_panel_observation_game_state != null
		and is_instance_valid(
			crime_panel_observation_game_state
		)
		and crime_panel_observation_game_state.has_signal(
			"resident_runtime_engine_became_resident"
		)
		and not crime_panel_observation_game_state.is_connected(
			"resident_runtime_engine_became_resident",
			engine_resident_callback
		)
	):
		crime_panel_observation_game_state.connect(
			"resident_runtime_engine_became_resident",
			engine_resident_callback
		)

	var next_authority = null

	if (
		gs != null
		and gs.crime_hub_contract_engine != null
		and is_instance_valid(
			gs.crime_hub_contract_engine
		)
	):
		next_authority = (
			gs.crime_hub_contract_engine
		)

	var section_contract_callback:= Callable(
		self,
		"_on_resident_crime_section_contract_published"
	)
	var section_row_callback:= Callable(
		self,
		"_on_resident_crime_section_row_published"
	)
	var incarceration_callback:= Callable(
		self,
		"_on_incarceration_lens_published"
	)

	var previous_authority = (
		crime_panel_observation_authority
	)

	if (
		previous_authority != null
		and is_instance_valid(
			previous_authority
		)
		and previous_authority != next_authority
	):
		if previous_authority.is_connected(
			"resident_crime_section_contract_published",
			section_contract_callback
		):
			previous_authority.disconnect(
				"resident_crime_section_contract_published",
				section_contract_callback
			)

		if previous_authority.is_connected(
			"resident_crime_section_row_published",
			section_row_callback
		):
			previous_authority.disconnect(
				"resident_crime_section_row_published",
				section_row_callback
			)

		if previous_authority.is_connected(
			"incarceration_lens_published",
			incarceration_callback
		):
			previous_authority.disconnect(
				"incarceration_lens_published",
				incarceration_callback
			)

	crime_panel_observation_authority = (
		next_authority
	)

	if (
		crime_panel_observation_authority == null
		or not is_instance_valid(
			crime_panel_observation_authority
		)
	):
		var resident_engine_graph_ready: bool = false

		if (
			gs != null
			and typeof(
				gs.scenario_state
			) == TYPE_DICTIONARY
		):
			resident_engine_graph_ready = bool(
				gs.scenario_state.get(
					"resident_runtime_engine_graph_ready",
					gs.resident_runtime_bootstrap_complete
				)
			)

		_crime_panel_observer_bind_truth(
			"waiting_for_crime_hub_authority",
			{
				"actor_id": (
					int(
						gs.player.id
					)
					if gs != null
					and gs.player != null
					else -1
				),
				"game_state_instance_id": (
					gs.get_instance_id()
					if gs != null
					and is_instance_valid(
						gs
					)
					else 0
				),
				"resident_engine_graph_ready": (
					resident_engine_graph_ready
				),
				"lifecycle_signal_connected": (
					crime_panel_observation_game_state
					!= null
					and crime_panel_observation_game_state.is_connected(
						"resident_runtime_engine_became_resident",
						engine_resident_callback
					)
				),
				"schedule_replay": schedule_replay
			}
		)





		return false

	if not crime_panel_observation_authority.is_connected(
		"resident_crime_section_contract_published",
		section_contract_callback
	):
		crime_panel_observation_authority.connect(
			"resident_crime_section_contract_published",
			section_contract_callback
		)

	if not crime_panel_observation_authority.is_connected(
		"resident_crime_section_row_published",
		section_row_callback
	):
		crime_panel_observation_authority.connect(
			"resident_crime_section_row_published",
			section_row_callback
		)

	if not crime_panel_observation_authority.is_connected(
		"incarceration_lens_published",
		incarceration_callback
	):
		crime_panel_observation_authority.connect(
			"incarceration_lens_published",
			incarceration_callback
		)

	_crime_panel_observer_bind_truth(
		"crime_hub_authority_bound",
		{
			"actor_id": (
				int(
					gs.player.id
				)
				if gs != null
				and gs.player != null
				else -1
			),
			"authority_instance_id": (
				crime_panel_observation_authority.get_instance_id()
			),
			"section_contract_connected": (
				crime_panel_observation_authority.is_connected(
					"resident_crime_section_contract_published",
					section_contract_callback
				)
			),
			"section_row_connected": (
				crime_panel_observation_authority.is_connected(
					"resident_crime_section_row_published",
					section_row_callback
				)
			),
			"incarceration_connected": (
				crime_panel_observation_authority.is_connected(
					"incarceration_lens_published",
					incarceration_callback
				)
			)
		}
	)





	if not schedule_replay:
		return true









	if (
		gs == null
		or gs.player == null
		or crime_panel == null
		or not is_instance_valid(
			crime_panel
		)
	):
		return true

	var actor_id: int = int(
		gs.player.id
	)







	if (
		actor_id <= 0
		or crime_panel.has_observable_section_deck(
			actor_id
		)
	):
		return true

	var signature: String = str(
		reality_residency_attached_signature
	).strip_edges()

	var replay_callback:= Callable(
		self,
		"_prewarm_crime_hub_contract_for_actor"
	).bind(
		actor_id,
		signature,
		"crime_panel_observer_bind_replay"
	)

	var tree:= get_tree()

	if tree == null:
		_crime_panel_observer_bind_truth(
			"retained_replay_scene_tree_unavailable",
			{
				"actor_id": actor_id,
				"authority_instance_id": (
					crime_panel_observation_authority.get_instance_id()
				)
			}
		)
		return true

	if tree.process_frame.is_connected(
		replay_callback
	):
		return true



	tree.process_frame.connect(
		replay_callback,
		CONNECT_ONE_SHOT
	)

	_crime_panel_observer_bind_truth(
		"retained_replay_scheduled",
		{
			"actor_id": actor_id,
			"authority_instance_id": (
				crime_panel_observation_authority.get_instance_id()
			),
			"signature": signature
		}
	)

	return true
func _ensure_crime_panel() -> void:
	if (
		crime_panel != null
		and is_instance_valid(
			crime_panel
		)
	):
		_bind_crime_panel_event_bus_observation()
		_bind_crime_panel_observation_authority()
		return

	crime_panel = CrimePanel.new()
	crime_panel.name = "CrimePanel"
	crime_panel.visible = false
	crime_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
