func _household_creator_select_unfinished_draft_from_popup(draft_id: String) -> void:
	_household_creator_close_unfinished_households_popup()
	_household_creator_resume_unfinished_draft(draft_id)


func _household_creator_resume_unfinished_draft(draft_id: String) -> void:
	_household_creator_close_unfinished_households_popup()

	var clean_id: String = str(draft_id).strip_edges()
	if clean_id == "":
		return

	var drafts: Array = MainSceneLogic._household_creator_unfinished_drafts(gs)
	for raw_draft in drafts:
		if typeof(raw_draft) != TYPE_DICTIONARY:
			continue

		var draft: Dictionary = raw_draft as Dictionary
		if str(draft.get("draft_id", "")).strip_edges() != clean_id:
			continue

		var world_raw: Variant = draft.get("world_contract", {})
		var members_raw: Variant = draft.get("created_members", [])

		household_creator_active_draft_id = clean_id
		household_creator_world_contract = world_raw.duplicate(true) if typeof(world_raw) == TYPE_DICTIONARY else {}
		household_creator_created_members = members_raw.duplicate(true) if typeof(members_raw) == TYPE_ARRAY else []
		household_creator_world_prewarmed = bool(draft.get("world_prewarmed", false)) and int(household_creator_world_contract.get("world_seed", -1)) > 0
		household_creator_active_member_index = -1
		household_creator_confirm_no_family = false
		household_creator_pending_member_basic_contract.clear()
		_household_creator_clear_member_stat_controls()

		if household_creator_prewarm_progress_bar != null and is_instance_valid(household_creator_prewarm_progress_bar):
			household_creator_prewarm_progress_bar.value = 1.0 if household_creator_world_prewarmed else 0.0

		if household_creator_status_label != null and is_instance_valid(household_creator_status_label):
			household_creator_status_label.text = "Unfinished household loaded. Continue building or press Continue when ready."

		_household_creator_render_member_roster()
		return

func _household_creator_final_contract() -> Dictionary:
	MainSceneLogic._ensure_family_creation_contract_engine(gs)

	if gs != null and gs.family_creation_contract_engine != null:
		return gs.family_creation_contract_engine.build_household_spawn_contract(
			household_creator_world_contract,
			household_creator_created_members,
			"person_0"
		)

	return {
		"schema": "eralife.custom_household_spawn_contract",
		"version": 1,
		"source": "choose_household_creator_progressive_fallback",
		"mode": "pre_existing_household",
		"start_person_key": "person_0",
		"members": household_creator_created_members.duplicate(true),
		"location": {
			"city": str(household_creator_world_contract.get("city", "")),
			"country": str(household_creator_world_contract.get("country", ""))
		},
		"era": {
			"key": str(household_creator_world_contract.get("era", "Modern")),
			"year": int(household_creator_world_contract.get("year", 2000))
		},
		"home": {
			"house_type": str(household_creator_world_contract.get("house_type", "Family home"))
		},
		"reality_mode": str(household_creator_world_contract.get("reality_mode", "chaos")),
		"default_social_class": str(household_creator_world_contract.get("default_social_class", "Middle Class"))
	}


func _household_creator_settings_from_contract(contract: Dictionary) -> Dictionary:
	var settings:= _build_default_custom_settings()

	var members_raw: Variant = contract.get("members", [])
	var members: Array = members_raw if typeof(members_raw) == TYPE_ARRAY else []
	var first_member: Dictionary = members [0] if not members.is_empty() and typeof(members [0]) == TYPE_DICTIONARY else {}

	var location_raw: Variant = contract.get("location", {})
	var location: Dictionary = location_raw if typeof(location_raw) == TYPE_DICTIONARY else {}
	var era_raw: Variant = contract.get("era", {})
	var era_data: Dictionary = era_raw if typeof(era_raw) == TYPE_DICTIONARY else {}
	var home_raw: Variant = contract.get("home", {})
	var home_data: Dictionary = home_raw if typeof(home_raw) == TYPE_DICTIONARY else {}
	var stats_raw: Variant = first_member.get("stats", {})
	var stats: Dictionary = stats_raw if typeof(stats_raw) == TYPE_DICTIONARY else {}
	var relationship_policy_raw: Variant = contract.get("relationship_policy", {})
	var relationship_policy: Dictionary = relationship_policy_raw if typeof(relationship_policy_raw) == TYPE_DICTIONARY else {}

	settings ["_god_mode_entry_kind"] = "household_curated_life"
	settings ["god_mode_entry_kind"] = "household_curated_life"
	settings ["household_spawn_contract"] = contract.duplicate(true)
	settings ["generate_family"] = bool(relationship_policy.get("generate_external_family", false))

	settings ["starting_infinity_stones"] = 0
	settings ["start_with_red_bonnet"] = false
	settings ["household_curated_life"] = true
	settings ["suppress_birth_intro_for_existing_life"] = true

	settings ["first_name"] = str(first_member.get("first_name", settings.get("first_name", "Player"))).strip_edges()
	settings ["last_name"] = str(first_member.get("last_name", settings.get("last_name", "Household"))).strip_edges()
	settings ["gender"] = str(first_member.get("gender", settings.get("gender", "Male"))).strip_edges()
	settings ["age"] = int(first_member.get("age", settings.get("age", 25)))
	settings ["starting_age"] = int(first_member.get("age", settings.get("starting_age", 25)))
	settings ["social_class"] = str(first_member.get("social_class", contract.get("default_social_class", settings.get("social_class", "Middle Class"))))
	settings ["bank_balance"] = int(first_member.get("money", settings.get("bank_balance", 0)))
	settings ["job"] = str(first_member.get("job", settings.get("job", ""))).strip_edges()

	settings ["health"] = int(stats.get("health", settings.get("health", 100)))
	settings ["smarts"] = int(stats.get("smarts", settings.get("smarts", 100)))
	settings ["looks"] = int(stats.get("looks", settings.get("looks", 100)))
	settings ["imagination"] = int(stats.get("imagination", settings.get("imagination", 75)))
	settings ["mental_health"] = int(stats.get("mental_health", settings.get("mental_health", 100)))

	settings ["city"] = str(location.get("city", first_member.get("city", settings.get("city", "")))).strip_edges()
	settings ["country"] = str(location.get("country", first_member.get("country", settings.get("country", "")))).strip_edges()
	settings ["era"] = str(era_data.get("key", first_member.get("era", settings.get("era", "Modern")))).strip_edges()
	settings ["year"] = int(era_data.get("year", first_member.get("year", settings.get("year", 2000))))
	settings ["year_locked"] = false
	settings ["house_type"] = str(home_data.get("house_type", household_creator_world_contract.get("house_type", ""))).strip_edges()

	settings ["reality_mode"] = str(contract.get("reality_mode", settings.get("reality_mode", "chaos"))).strip_edges().to_lower()
	settings ["feature_overrides"] = MainSceneHelpers._feature_overrides_for_mode(str(settings.get("reality_mode", "chaos")))
	settings ["reality_mode_label"] = MainSceneLogic._display_reality_mode_label_from_settings(settings)
	settings ["birth_intro_cry_allowed"] = int(settings.get("starting_age", settings.get("age", 0))) == 0

	if int(settings.get("starting_age", settings.get("age", 0))) > 0:
		settings ["birth_intro_cry_allowed"] = false

	if household_creator_world_contract.has("world_seed"):
		settings ["world_seed"] = int(household_creator_world_contract.get("world_seed", -1))
	if typeof(household_creator_world_contract.get("seed_contract", {})) == TYPE_DICTIONARY:
		settings ["seed_contract"] = household_creator_world_contract.get("seed_contract", {}).duplicate(true)
	if typeof(household_creator_world_contract.get("_prebirth_reality_candidate", {})) == TYPE_DICTIONARY:
		settings ["_prebirth_reality_candidate"] = household_creator_world_contract.get("_prebirth_reality_candidate", {}).duplicate(true)
	if str(household_creator_world_contract.get("_prebirth_reality_candidate_id", "")).strip_edges() != "":
		settings ["_prebirth_reality_candidate_id"] = str(household_creator_world_contract.get("_prebirth_reality_candidate_id", ""))

	return settings

func _household_creator_catalog() -> Dictionary:
	var context: Dictionary = {}
	if not household_creator_world_contract.is_empty():
		context = household_creator_world_contract.duplicate(true)
	else:
		context = _household_creator_read_world_contract()

	return _household_creator_catalog_for_context(context)

