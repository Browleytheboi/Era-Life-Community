func _main_tab_surface_is_hot(panel_id: String, section: String = "") -> bool:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var clean_section: String = str(section).strip_edges().to_lower()

	match clean_panel:
		"life":
			return output_label != null \
and is_instance_valid(output_label) \
and str(output_label.text).strip_edges() != ""

		"world":
			return world_feed_popup != null \
and is_instance_valid(world_feed_popup) \
and world_feed_popup_feed != null \
and is_instance_valid(world_feed_popup_feed) \
and world_feed_popup_feed.get_line_count() > 0

		"relationships":
			return institution_hub_overlay != null \
and is_instance_valid(institution_hub_overlay) \
and str(institution_hub_kind).strip_edges().to_lower() == "relationships" \
and institution_hub_list != null \
and is_instance_valid(institution_hub_list) \
and institution_hub_list.get_child_count() > 0

		"career", "school":
			if clean_section == "":
				clean_section = "overview"

			return institution_hub_overlay != null \
and is_instance_valid(institution_hub_overlay) \
and str(institution_hub_kind).strip_edges().to_lower() == clean_panel \
and str(institution_hub_current_section).strip_edges().to_lower() == clean_section \
and institution_hub_list != null \
and is_instance_valid(institution_hub_list) \
and institution_hub_list.get_child_count() > 0

		"activities":
			return activities_action_panel != null \
and is_instance_valid(activities_action_panel) \
and activities_action_list != null \
and is_instance_valid(activities_action_list) \
and activities_action_list.get_child_count() > 0

		_:
			return false


func _prewarm_native_main_tab_surface(
	panel_id: String,
	reason: String = (
		"native_tab_surface_prewarm"
	)
) -> void:
	if gs == null or gs.player == null:
		return

	var clean_spec: String = str(
		panel_id
	).strip_edges().to_lower()

	if clean_spec == "":
		return

	var parts: PackedStringArray = clean_spec.split(
		"::"
	)
	var clean_panel: String = str(
		parts [0]
	).strip_edges().to_lower()
	var clean_section: String = ""

	if parts.size() >= 2:
		clean_section = str(
			parts [1]
		).strip_edges().to_lower()

	if clean_section == "":
		clean_section = (
			"family"
				if clean_panel == "relationships"
				else "overview"
		)

	var now_ms: int = int(
		Time.get_ticks_msec()
	)

	if (
		_ui_interaction_grace_active(
			now_ms
		)
			or _post_spawn_ui_is_busy_for_prewarm()
	):
		_request_native_main_tab_surface_prewarm_idle(
			clean_spec,
			"%s_input_grace_blocked" % reason
		)
		return

	if bool(
		get_meta(
			"native_main_tab_surface_prewarm_active",
			false
		)
	):
		_request_native_main_tab_surface_prewarm_idle(
			clean_spec,
			"%s_reentry_blocked" % reason
		)
		return

	var previous_panel: String = str(
		current_panel
	)
	var previous_surface_key: String = (
		institution_hub_active_surface_key
	)
	var previous_activities_open: bool = (
		activities_action_open
	)
	var previous_world_open: bool = (
		world_feed_popup_open
	)

	set_meta(
		"native_main_tab_surface_prewarm_active",
		true
	)
	set_meta(
		"native_main_tab_surface_prewarm_panel",
		clean_panel
	)
	set_meta(
		"native_main_tab_surface_prewarm_section",
		clean_section
	)
	set_meta(
		"native_main_tab_surface_prewarm_reason",
		reason
	)
	set_meta(
		"native_main_tab_surface_click_path_build_forbidden",
		true
	)

	match clean_panel:
		"relationships", "school":
			_hydrate_institution_hub_surface(
				clean_panel,
				clean_section,
				reason
			)

		"career":
			_ensure_career_hub_panel()

			if (
				career_hub_panel != null
					and is_instance_valid(
						career_hub_panel
					)
			):
				if not _career_hub_contract_is_renderable(
					career_hub_panel.active_contract,
					int(
						gs.player.id
					)
				):
					_request_career_hub_observable_contract(
						gs.player,
						(
							"Professional reality already exists. "
