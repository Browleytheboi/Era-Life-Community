		int(projection.get("military_amount", 0)),
		100,
		editable,
		int(summary.get("military_unit_cost", 4500)),
		"units"
	)
	_append_crown_allocation_bucket_row(
		root,
		summary,
		"Goods Production",
		"goods_pct",
		goods_pct,
		int(projection.get("goods_amount", 0)),
		100,
		editable,
		int(summary.get("goods_unit_cost", 200000)),
		"units"
	)

	var carry_label:= Label.new()
	carry_label.text = "Unallocated Carryover: %s" % _format_crown_treasury_label(int(projection.get("carryover_amount", 0)), currency_name)
	root.add_child(carry_label)

	var reserve_rule:= Label.new()
	reserve_rule.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	reserve_rule.text = "Allocation only spends what is actually in your saved reserve plus this year's projected tax revenue. Higher taxes grow revenue, but next year's happiness, approval, and respect take the hit."
	root.add_child(reserve_rule)

	var commit_button:= Button.new()
	commit_button.text = "Set Allocation"
	commit_button.custom_minimum_size = Vector2(0, 46)
	commit_button.disabled = (not editable) or (not has_changes)
	commit_button.pressed.connect(_commit_crown_allocation)
	root.add_child(commit_button)

	var idle_label:= Label.new()
	idle_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	idle_label.text = "Move a slider or change taxes to stage a new allocation."
	idle_label.visible = editable and not has_changes
	root.add_child(idle_label)

	crown_hub_allocation_live_nodes ["carry_label"] = carry_label
	crown_hub_allocation_live_nodes ["commit_button"] = commit_button
	crown_hub_allocation_live_nodes ["idle_label"] = idle_label

	if not can_edit:
		var lock_label:= Label.new()
		lock_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		lock_label.text = "Only the current ruler can manage national allocation."
		root.add_child(lock_label)
	elif current_year_locked:
		var once_label:= Label.new()
		once_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		once_label.text = "Allocation has already been set for this year."
		root.add_child(once_label)
func _build_crown_summary_preview(summary: Dictionary, realm: Dictionary, draft: Dictionary) -> Dictionary:
	var out: Dictionary = summary.duplicate(true)
	if out.is_empty():
		return out
	if realm.is_empty():
		out ["preview_active"] = false
		return out
	if not MainSceneLogic._crown_allocation_draft_has_changes(summary, realm, draft):
		out ["preview_active"] = false
		return out

	var projection: Dictionary = MainSceneLogic._build_crown_allocation_projection(summary, realm, draft)
	var currency_name: String = str(out.get("currency_name", "")).strip_edges()

	var treasury_total: int = int(out.get("treasury", 0)) + int(projection.get("treasury_amount", 0))
	var military_total: int = int(out.get("military_stockpile", 0)) + int(projection.get("military_units", 0))
	var goods_total: int = int(out.get("goods_stockpile", 0)) + int(projection.get("goods_units", 0))

	out ["preview_active"] = true
	out ["tax_rate"] = float(projection.get("tax_rate", out.get("tax_rate", 10.0)))
	out ["total_tax_revenue"] = int(projection.get("tax_revenue", out.get("total_tax_revenue", 0)))
	out ["allocation_pool"] = int(projection.get("available_pool", out.get("allocation_pool", 0)))
	out ["allocation_reserve"] = int(projection.get("carryover_amount", out.get("allocation_reserve", 0)))

	out ["treasury"] = treasury_total
	out ["treasury_label"] = _format_crown_treasury_label(treasury_total, currency_name)

	out ["military_stockpile"] = military_total
	out ["military_stockpile_label"] = "%s units" % _crown_compact_number(float(military_total))

	out ["goods_stockpile"] = goods_total
	out ["goods_stockpile_label"] = "%s units" % _crown_compact_number(float(goods_total))

	out ["preview_treasury_gain"] = int(projection.get("treasury_amount", 0))
	out ["preview_military_gain"] = int(projection.get("military_units", 0))
	out ["preview_goods_gain"] = int(projection.get("goods_units", 0))
	out ["preview_carryover"] = int(projection.get("carryover_amount", 0))
	out ["preview_happiness_delta"] = int(projection.get("happiness_delta", 0))
	out ["preview_approval_delta"] = int(projection.get("approval_delta", 0))
	out ["preview_respect_delta"] = int(projection.get("respect_delta", 0))

	return out

