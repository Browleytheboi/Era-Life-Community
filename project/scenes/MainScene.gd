func _style_institution_hub_scrollbar(vbar: VScrollBar, active: bool = false, pulse_strength: float = 0.0) -> void:
	if vbar == null:
		return

	var clean_kind: String = str(institution_hub_kind).strip_edges().to_lower()
	var accent: Color = Color(0.42, 0.62, 1.0, 0.92)
	var track_fill: Color = Color(0.035, 0.04, 0.065, 0.58)

	match clean_kind:
		"relationships":
			accent = Color(1.0, 0.48, 0.72, 0.94)
			track_fill = Color(0.07, 0.03, 0.062, 0.56)
		"school":
			accent = Color(0.46, 0.72, 1.0, 0.94)
			track_fill = Color(0.03, 0.052, 0.09, 0.56)
		"career":
			accent = Color(0.52, 0.92, 0.72, 0.92)
			track_fill = Color(0.026, 0.07, 0.052, 0.56)

	var hovered: bool = bool(vbar.get_meta("institution_hub_scrollbar_hovered", false))
	var safe_pulse: float = clamp(float(pulse_strength), 0.0, 1.0)
	var active_alpha: float = 0.52 if active else 0.24
	if hovered:
		active_alpha = 0.92

	var track:= StyleBoxFlat.new()
	track.bg_color = track_fill
	track.border_color = Color(accent.r, accent.g, accent.b, 0.16 + safe_pulse * 0.14)
	track.border_width_left = 1
	track.border_width_top = 1
	track.border_width_right = 1
	track.border_width_bottom = 1
	track.corner_radius_top_left = 999
	track.corner_radius_top_right = 999
	track.corner_radius_bottom_left = 999
	track.corner_radius_bottom_right = 999
	track.content_margin_left = 3
	track.content_margin_top = 3
	track.content_margin_right = 3
	track.content_margin_bottom = 3

	var grabber:= StyleBoxFlat.new()
	grabber.bg_color = accent.lerp(Color.WHITE, 0.1 + safe_pulse * 0.16)
	grabber.bg_color.a = active_alpha
	grabber.border_color = accent.lerp(Color.WHITE, 0.34 if hovered else 0.1)
	grabber.border_color.a = 0.86 if active else 0.42
	grabber.border_width_left = 1
	grabber.border_width_top = 1
	grabber.border_width_right = 1
	grabber.border_width_bottom = 1
	grabber.corner_radius_top_left = 999
	grabber.corner_radius_top_right = 999
	grabber.corner_radius_bottom_left = 999
	grabber.corner_radius_bottom_right = 999
	grabber.shadow_color = accent.lerp(Color.WHITE, 0.28 if hovered else 0.06)
	grabber.shadow_color.a = 0.32 + safe_pulse * 0.24 if active else 0.1
	grabber.shadow_size = 8 + int(round(safe_pulse * 5.0)) + (5 if hovered else 0)
	grabber.shadow_offset = Vector2.ZERO

	var grabber_hover:= grabber.duplicate()
	grabber_hover.bg_color = accent.lerp(Color.WHITE, 0.38)
	grabber_hover.bg_color.a = 0.96
	grabber_hover.border_color = Color(1.0, 1.0, 1.0, 0.96)
	grabber_hover.shadow_color = Color(1.0, 1.0, 1.0, 0.42)
	grabber_hover.shadow_size = grabber.shadow_size + 4

	var grabber_pressed:= grabber_hover.duplicate()
	grabber_pressed.bg_color = accent.lerp(Color.WHITE, 0.18)
	grabber_pressed.shadow_size = max(6, grabber_hover.shadow_size - 3)

	vbar.add_theme_stylebox_override("scroll", track)
	vbar.add_theme_stylebox_override("grabber", grabber)
	vbar.add_theme_stylebox_override("grabber_highlight", grabber_hover)
	vbar.add_theme_stylebox_override("grabber_pressed", grabber_pressed)
func _relationship_hub_person_preview_snapshot(observer: Person, npc: Person) -> Dictionary:
	if npc == null:
		return {
			"role": "",
			"bond": 0,
			"health": 0,
			"health_max": 100,
			"state": "conflict",
			"is_self": false,
			"surface_context": {},
			"card_contract": {}
		}

	var engine: RelationshipsHubContractEngine = _ensure_relationships_hub_contract_engine()
	var contract: Dictionary = engine.emit_card_contract(observer, npc, {
		"source": "mainscene.relationship_hub_person_preview_snapshot",
		"section_key": institution_hub_current_section,
		"featured": false,
		"stage_switch_shell": false,
		"queue_switch_shell_stage": true
	})

	if bool(contract.get("success", false)) == false and contract.has("reason"):
		return {
			"role": "",
			"bond": 0,
			"health": 0,
			"health_max": 100,
			"state": "conflict",
			"is_self": false,
			"surface_context": {},
			"card_contract": contract.duplicate(true)
		}

	return {
		"role": str(contract.get("role", "")).strip_edges(),
		"bond": int(contract.get("bond", 0)),
		"health": int(contract.get("health", 0)),
		"health_max": int(contract.get("health_max", 100)),
		"state": str(contract.get("state", "warm")).strip_edges(),
		"is_self": bool(contract.get("is_self", false)),
		"surface_context": MainSceneHelpers._safe_dictionary(contract.get("surface_context", {})),
		"card_contract": contract.duplicate(true)
	}
func _relationship_hub_bond_score_for_pair(observer: Person, npc: Person) -> int:
	var engine: RelationshipsHubContractEngine = _ensure_relationships_hub_contract_engine()
	if engine == null:
		return 0

	return engine.bond_score_for_pair(observer, npc)

func _relationship_hub_sorted_ids_by_bond(ids: Array, observer: Person) -> Array:
	if ids.is_empty():
		return []

	var ranked: Array = []
	var order: int = 0

	for raw_id in ids:
		var npc_id: int = int(raw_id)
		if npc_id <= 0:
			continue

		var bond_value: int = 0
		if gs != null:
			var npc: Person = gs.get_or_reactivate_npc_by_id(npc_id)
			if npc != null:
				bond_value = _relationship_hub_bond_score_for_pair(observer, npc)

		ranked.append({
			"id": npc_id,
			"bond": bond_value,
			"order": order
		})
		order += 1

	ranked.sort_custom(Callable(self, "_relationship_hub_ranked_person_sort"))

	var out: Array = []
	for raw_rank in ranked:
		var rank: Dictionary = MainSceneHelpers._safe_dictionary(raw_rank)
		var ranked_id: int = int(rank.get("id", 0))
		if ranked_id > 0:
			out.append(ranked_id)

	return out


func _relationship_hub_ranked_person_sort(a, b) -> bool:
	var left: Dictionary = MainSceneHelpers._safe_dictionary(a)
	var right: Dictionary = MainSceneHelpers._safe_dictionary(b)

	var left_bond: int = int(left.get("bond", 0))
	var right_bond: int = int(right.get("bond", 0))

	if left_bond == right_bond:
		return int(left.get("order", 0)) < int(right.get("order", 0))

	return left_bond > right_bond

func _relationship_hub_begin_navigation_perf_window(reason: String = "relationship_navigation", duration_ms: int = 240) -> void:
	var now_ms: int = int(Time.get_ticks_msec())
	var safe_duration: int = max(80, int(duration_ms))

	set_meta("relationship_hub_navigation_perf_until_ms", now_ms + safe_duration)
	set_meta("relationship_hub_navigation_perf_reason", reason)
	set_meta("relationship_hub_visibility_cache_next_ms", 0)
	set_meta("relationship_hub_next_visual_runtime_ms", now_ms + min(42, safe_duration))
	set_meta("relationship_hub_next_live_card_refresh_ms", now_ms + min(90, safe_duration))


func _relationship_hub_navigation_perf_window_active() -> bool:
	return int(Time.get_ticks_msec()) <= int(get_meta("relationship_hub_navigation_perf_until_ms", 0))


func _relationship_hub_refresh_runtime_visibility_cache(force: bool = false) -> void:
	if str(institution_hub_kind).strip_edges().to_lower() != "relationships":
		return
	if institution_hub_scroll == null:
		return
	if institution_hub_experience_rows.is_empty():
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var current_vertical: int = int(institution_hub_scroll.scroll_vertical)
	var last_vertical: int = int(get_meta("relationship_hub_visibility_cache_scroll", -999999))
	var next_ms: int = int(get_meta("relationship_hub_visibility_cache_next_ms", 0))
	var scroll_recent: bool = _institution_hub_scroll_is_recently_active()
	var navigation_window: bool = _relationship_hub_navigation_perf_window_active()
	var scroll_delta: int = abs(current_vertical - last_vertical)

	var interval_ms: int = 140
	var jump_threshold: int = 110
	var overscan: float = 320.0

	if scroll_recent:
		interval_ms = 76
		jump_threshold = 180
		overscan = 520.0

	if navigation_window:
		interval_ms = 92
		jump_threshold = 220
		overscan = 560.0

	if force:
		interval_ms = 0
		overscan = 640.0

	if not force and now_ms < next_ms and scroll_delta < jump_threshold:
		return

	set_meta("relationship_hub_visibility_cache_next_ms", now_ms + interval_ms)
	set_meta("relationship_hub_visibility_cache_scroll", current_vertical)

	for row_data in institution_hub_experience_rows:
		row_data ["_scroll_visible"] = _institution_hub_row_data_compute_scroll_visible(row_data, overscan)
func _institution_hub_row_data_compute_scroll_visible(row_data: Dictionary, overscan: float = 96.0) -> bool:
	var control: Control = MainSceneHelpers._institution_hub_visual_control_for_row_data(row_data)
	return _institution_hub_control_is_scroll_visible(control, overscan)


func _relationship_hub_cached_person_card_style(state: String, featured: bool, section_key: String, bond_value: int, hovered: bool, pulse_bucket: int = 0, max_pulse_bucket: int = 6) -> StyleBoxFlat:
	var safe_bond: int = clamp(int(bond_value), 0, 100)
	var safe_pulse_bucket: int = clamp(int(pulse_bucket), 0, max(1, int(max_pulse_bucket)))
	var safe_max_bucket: int = max(1, int(max_pulse_bucket))
	var clean_state: String = str(state).strip_edges().to_lower()
	var clean_section: String = str(section_key).strip_edges().to_lower()

	var cache_key: String = "%s|%s|%s|%d|%s|%d|%d" % [
		clean_state,
		str(featured),
		clean_section,
		safe_bond,
		str(hovered),
		safe_pulse_bucket,
		safe_max_bucket
	]

	var raw_cache: Variant = get_meta("relationship_hub_card_style_cache", {})
	var cache: Dictionary = raw_cache if typeof(raw_cache) == TYPE_DICTIONARY else {}

	if cache.has(cache_key):
		var cached_style: StyleBoxFlat = cache.get(cache_key, null)
		if cached_style != null:
			return cached_style

	var pulse_value: float = float(safe_pulse_bucket) / float(safe_max_bucket)
	var style: StyleBoxFlat = MainSceneLogic._relationship_hub_person_card_style(
		clean_state,
		featured,
		clean_section,
		safe_bond,
		hovered,
		pulse_value
	)

	cache [cache_key] = style
	set_meta("relationship_hub_card_style_cache", cache)
	return style


func _relationship_hub_trim_visual_style_cache() -> void:
	var raw_cache: Variant = get_meta("relationship_hub_card_style_cache", {})
	if typeof(raw_cache) != TYPE_DICTIONARY:
		return

	var cache: Dictionary = raw_cache
	if cache.size() <= 420:
		return

	set_meta("relationship_hub_card_style_cache", {})


func _relationship_hub_apply_card_style_if_needed(row_data: Dictionary, card_surface: PanelContainer, card_state: String, featured: bool, section_key: String, bond_value: int, _pulse_strength: float) -> void:
	if card_surface == null:
		return

	var hovered: bool = bool(card_surface.get_meta("relationship_card_hovered", false))
	var safe_bond: int = clamp(int(bond_value), 0, 100)



	var max_bucket: int = 1
	var pulse_bucket: int = 0

	var style_key: String = "%s|%s|%s|%d|%s|%d|%d" % [
		card_state,
		str(featured),
		section_key,
		safe_bond,
		str(hovered),
		pulse_bucket,
		max_bucket
	]

	var dirty: bool = bool(card_surface.get_meta("relationship_card_style_dirty", false))
	if not dirty and str(row_data.get("_card_style_key", "")) == style_key:
		return

	card_surface.add_theme_stylebox_override(
		"panel",
		_relationship_hub_cached_person_card_style(
			card_state,
			featured,
			section_key,
			safe_bond,
			hovered,
			pulse_bucket,
			max_bucket
		)
	)

	row_data ["_card_style_key"] = style_key
	card_surface.set_meta("relationship_card_style_dirty", false)
func _relationship_hub_apply_mini_stat_glow_if_needed(row_data: Dictionary, current_value: int, max_value: int, pulse_strength: float) -> void:
	var fill_style: StyleBoxFlat = row_data.get("fill_style", null)
	if fill_style == null:
		return

	var safe_max: int = max(1, int(max_value))
	var safe_value: int = clamp(int(current_value), 0, safe_max)
	var ratio: float = float(safe_value) / float(safe_max)
	var high_ratio: float = clampf((ratio - 0.7) / 0.3, 0.0, 1.0)

	var scroll_recent: bool = _institution_hub_scroll_is_recently_active()
	var navigation_window: bool = _relationship_hub_navigation_perf_window_active()
	var allow_live_pulse: bool = not scroll_recent and not navigation_window

	var safe_pulse: float = clampf(pulse_strength, 0.0, 0.18) if allow_live_pulse else 0.0
	var high_bucket: int = clamp(int(round(high_ratio * 4.0)), 0, 4)
	var pulse_bucket: int = clamp(int(round(safe_pulse * 10.0)), 0, 2)

	var glow_key: String = "%d|%d" % [
		high_bucket,
		pulse_bucket
	]

	if str(row_data.get("_mini_glow_key", "")) == glow_key:
		return

	var glow_color: Color = row_data.get("glow_color", row_data.get("fill_color", Color(1.0, 1.0, 1.0, 0.18)))

	fill_style.border_width_left = 0
	fill_style.border_width_top = 0
	fill_style.border_width_right = 0
	fill_style.border_width_bottom = 0
	fill_style.shadow_color = Color(
		glow_color.r,
		glow_color.g,
		glow_color.b,
		clampf(high_ratio * (0.12 + safe_pulse * 0.3), 0.0, 0.26)
	)
	fill_style.shadow_size = int(round(high_ratio * (3.0 + safe_pulse * 12.0)))
	fill_style.shadow_offset = Vector2.ZERO

	var mini_bar: ProgressBar = row_data.get("bar", null)
	if mini_bar != null:
		mini_bar.add_theme_stylebox_override("fill", fill_style)
		mini_bar.set_meta("mini_stat_no_white_flash", true)
		mini_bar.set_meta("mini_stat_no_square_border", true)

	row_data ["_mini_glow_key"] = glow_key
