func _activities_hub_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var inspected: int = 0
	var preferred_keys: Array = [
		"route_report",
		"result",
		"engine_report",
		"target_report",
		"commit_report",
		"command_report",
		"payload",
		"crr_report"
	]

	while (
		not queue.is_empty()
		and inspected < 64
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		if cursor.has(
			"activities_hub_contract"
		):
			var direct_contract: Dictionary = (
				MainSceneHelpers._safe_dictionary(
					cursor.get(
						"activities_hub_contract",
						{}
					)
				)
			)

			if not direct_contract.is_empty():
				return cursor

		if str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges() == (
			"eralife.activities_hub_contract"
		):
			return {
				"success": bool(
					cursor.get(
						"success",
						true
					)
				),
				"type": (
					"activities_hub_projection_resolved"
				),
				"activities_hub_contract": (
					cursor.duplicate(true)
				)
			}

		for raw_key in preferred_keys:
			var nested_raw: Variant = cursor.get(
				str(
					raw_key
				),
				{}
			)

			if (
				typeof(
					nested_raw
				) != TYPE_DICTIONARY
			):
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			).duplicate(true)

			if not nested.is_empty():
				queue.append(
					nested
				)

		for raw_key in cursor.keys():
			if str(
				raw_key
			) in preferred_keys:
				continue

			var dynamic_raw: Variant = cursor.get(
				raw_key,
				{}
			)

			if (
				typeof(
					dynamic_raw
				) != TYPE_DICTIONARY
			):
				continue

			var dynamic_nested: Dictionary = (
				dynamic_raw as Dictionary
			).duplicate(true)

			if not dynamic_nested.is_empty():
				queue.append(
					dynamic_nested
				)

	return {}


func _activities_hub_contract_is_renderable(
	contract: Dictionary,
	actor_id: int = -1
) -> bool:
	if contract.is_empty():
		return false

	if not bool(
		contract.get(
			"success",
			false
		)
	):
		return false

	if str(
		contract.get(
			"schema",
			""
		)
	).strip_edges() != (
		"eralife.activities_hub_contract"
	):
		return false

	if (
		actor_id > 0
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	if MainSceneHelpers._safe_array(
		contract.get(
			"section_tabs",
			[]
		)
	).is_empty():
		return false

	return not MainSceneHelpers._safe_dictionary(
		contract.get(
			"identity_overview",
			{}
		)
	).is_empty()

func _activities_hub_action_result_from_report(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [report]
	var cursor: int = 0
	var recognized_result_types: Array = [
		"activities_contract_failure",
		"activity_rejected",
		"scenario_prompt",
		"boxing_hud_unlocked",
		"open_boxing_entry_popup",
		"open_silk_road_panel",
		"open_assets_panel",
		"open_pet_shop_panel",
		"open_meat_market_panel",
		"open_artifact_shop_panel",
		"open_property_market_panel",
		"open_vehicle_market_panel",
		"open_property_portfolio_panel",
		"open_vehicle_portfolio_panel",
		"open_migration_panel",
		"open_famous_career_browser_panel"
	]

	while cursor < queue.size():
		var current_raw: Variant = queue [cursor]
		cursor += 1

		if typeof(current_raw) != TYPE_DICTIONARY:
			continue

		var current: Dictionary = current_raw as Dictionary
		var result_type: String = str(
			current.get(
				"type",
				""
			)
		).strip_edges().to_lower()
		var owns_activity_result: bool = (
			bool(
				current.get(
					"activities_contract_engine_owned",
					false
				)
			)
			or result_type in recognized_result_types
			or (
				result_type.begins_with("open_")
				and current.has("success")
			)
		)

		if (
			owns_activity_result
			and not current.has(
				"activities_hub_contract"
			)
		):
			return current.duplicate(true)

		for raw_key in current.keys():
			var nested_raw: Variant = current.get(raw_key)

			if typeof(nested_raw) == TYPE_DICTIONARY:
				queue.append(nested_raw)

	return {}
func _request_activities_hub_contract(
	actor: Person,
	payload: Dictionary = {},
	reveal_surface: bool = true
) -> Dictionary:
	if (
		gs == null
		or actor == null
	):
		return {}

	var resolved_payload: Dictionary = payload.duplicate(true)
	resolved_payload ["actor_id"] = int(actor.id)
	resolved_payload ["section_id"] = str(
		resolved_payload.get(
			"section_id",
			activities_hub_active_section_id
		)
	)
	resolved_payload ["source"] = str(
		resolved_payload.get(
			"source",
			"mainscene.activities_hub"
		)
	)
	resolved_payload ["ui_is_expression_only"] = true

	var action_id: String = str(
		resolved_payload.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()
	var projection_actions: Array = [
		"",
		"refresh",
		"open_hub",
		"set_section",
		"observe_partial",
		"open_observable",
		"emit_observable_contract"
	]
	var projection_requested: bool = (
		action_id in projection_actions
	)

	if projection_requested:
		var projection_sequence: int = int(
			get_meta(
				"activities_hub_projection_sequence",
				0
			)
		) + 1

		set_meta(
			"activities_hub_projection_sequence",
			projection_sequence
		)
		resolved_payload [
			"projection_request_id"
		] = (
			"%d:%d:%d:%s:%s"
			% [
				int(actor.id),
				projection_sequence,
				int(Time.get_ticks_msec()),
				action_id,
				str(
					resolved_payload.get(
						"section_id",
						"all"
					)
				)
			]
		)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": int(actor.id),
			"target_id": int(actor.id),
			"intent_type": "activities_hub_contract_intent",
			"surface_id": "activities_hub_panel",
			"action_id": action_id,
			"payload": resolved_payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"activities_hub_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": int(actor.id)
			},
			"source": str(
				resolved_payload.get(
					"source",
					""
				)
			),
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(actor.id),
			"target_id": int(actor.id),
			"surface_id": "activities_hub_panel",
			"action_id": action_id,
			"source": str(
				resolved_payload.get(
					"source",
					""
				)
			)
		}
	)
	var route_result: Dictionary = (
		_activities_hub_contract_route_result(
			report
		)
	)

	if not projection_requested:
		var action_result: Dictionary = (
			_activities_hub_action_result_from_report(
				report
			)
		)

		if action_result.is_empty():
			action_result = (
				_activities_hub_action_result_from_report(
					route_result
				)
			)

		set_meta(
			"activities_action_full_hub_rebuild_performed",
			false
		)
		set_meta(
			"activities_action_panel_render_performed",
			false
		)
		set_meta(
			"activities_action_input_frame_build",
			false
		)
		set_meta(
			"activities_action_last_action_id",
			action_id
		)
		set_meta(
			"activities_action_last_result_type",
			str(
				action_result.get(
					"type",
					""
				)
			)
		)

		if not action_result.is_empty():
			_handle_activities_hub_result(
				action_result
			)
			return action_result

		return route_result

	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"activities_hub_contract",
			{}
		)
	)

	_ensure_activities_hub_panel()

	if (
		contract.is_empty()
		and activities_hub_panel != null
		and is_instance_valid(
			activities_hub_panel
		)
		and activities_hub_panel.has_renderable_contract(
			int(actor.id)
		)
	):
		contract = (
			activities_hub_panel
			.active_contract
			.duplicate(true)
		)
		route_result = {
			"success": true,
			"type": "activities_cached_projection_preserved",
			"activities_hub_contract": (
				contract.duplicate(true)
			),
			"source_report": report.duplicate(true)
		}

	var renderable: bool = (
		_activities_hub_contract_is_renderable(
			contract,
			int(actor.id)
		)
	)

	set_meta(
		"native_main_tab_surface_renderable_activities",
		renderable
	)

	if not renderable:
		return route_result

	activities_hub_active_actor_id = int(actor.id)
	activities_hub_active_section_id = str(
		contract.get(
			"active_section",
			"all"
		)
	).strip_edges().to_lower()

	if activities_hub_active_section_id == "":
		activities_hub_active_section_id = "all"

	if reveal_surface:
		activities_action_open = true
		activities_hub_panel.open_contract(
			contract
		)
		activities_hub_panel.z_as_relative = false
		activities_hub_panel.z_index = 250

		_bring_modal_to_front(
			activities_hub_panel
		)
		_claim_interactive_surface_authority(
			activities_hub_panel,
			"activities_hub_panel:%d"
			% int(actor.id),
			"activities_hub_contract_rendered",
			true,
			true
		)
	else:
		activities_hub_panel.render_contract(
			contract
		)
		activities_hub_panel.visible = false
		activities_hub_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	return route_result


func _on_activities_hub_intent_requested(
		payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var outgoing: Dictionary = payload.duplicate(true)
	var action_id: String = str(
		outgoing.get(
			"action_id",
			""
		)
	).strip_edges().to_lower()

	outgoing ["source"] = str(
		outgoing.get(
			"source",
			"activities_hub_panel.intent_requested"
		)
	)

	if action_id == "set_section":
		var section_id: String = str(
			outgoing.get(
				"section_id",
				activities_hub_active_section_id
			)
		).strip_edges().to_lower()

		if section_id == "":
			section_id = "all"


		activities_hub_active_section_id = section_id

		var incarceration_lens: Dictionary = (
			_controlled_actor_incarceration_lens_contract()
		)

		if bool(
			incarceration_lens.get(
				"active",
				false
			)
		):




			set_meta(
				"incarceration_activities_section_press_reveal_only",
				true
			)
			set_meta(
				"incarceration_activities_section_press_engine_calls",
				false
			)
			set_meta(
				"incarceration_activities_section_press_deferred_work",
				false
			)
			set_meta(
				"incarceration_activities_section_press_free_world_persist",
				false
			)
			return

		call_deferred(
			"_persist_activities_hub_section_lens",
			outgoing.duplicate(true)
		)
		return

	var presentation_raw: Variant = outgoing.get(
		"presentation_result",
		{}
	)
	var presentation_result: Dictionary = (
		(presentation_raw as Dictionary).duplicate(true)
		if typeof(presentation_raw) == TYPE_DICTIONARY
		else {}
	)
	var reveal_prebuilt_surface: bool = (
		action_id == "perform_activity"
		and str(
			outgoing.get(
				"intent_mode",
				""
			)
		).strip_edges().to_lower() == "reveal_prebuilt_surface"
		and not presentation_result.is_empty()
		and bool(
			outgoing.get(
				"enabled",
				true
			)
		)
	)

	if reveal_prebuilt_surface:
		set_meta(
			"activities_action_packet_local",
			true
		)
		set_meta(
			"activities_action_engine_calls",
			false
		)
		set_meta(
			"activities_action_full_hub_rebuild_performed",
			false
		)
		set_meta(
			"activities_action_press_frame_build",
			false
		)
		set_meta(
			"activities_action_reveal_type",
			str(
				presentation_result.get(
					"type",
					""
				)
			)
		)

		_handle_activities_hub_result(
			presentation_result
		)
		return

	_request_activities_hub_contract(
		gs.player,
		outgoing,
		true
	)
func _persist_activities_hub_section_lens(
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	var section_id: String = str(
		payload.get(
			"section_id",
			activities_hub_active_section_id
		)
	).strip_edges().to_lower()

	if section_id == "":
		section_id = "all"

	var persistence_payload: Dictionary = (
		payload.duplicate(true)
	)
	persistence_payload ["action_id"] = (
		"persist_section_lens"
	)
	persistence_payload ["section_id"] = section_id
	persistence_payload ["actor_id"] = int(
		gs.player.id
	)
	persistence_payload ["source"] = (
		"mainscene.activities_lens_persistence"
	)
	persistence_payload ["ui_is_expression_only"] = true

	_express_global_ui_intent(
		{
			"actor_id": int(
				gs.player.id
			),
			"target_id": int(
				gs.player.id
			),
			"intent_type": (
				"activities_lens_persistence_intent"
			),
			"surface_id": "activities_hub_panel",
			"action_id": "persist_section_lens",
			"payload": persistence_payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"activities_hub_contract_engine"
				),
				"method": "persist_section_lens",
				"pass_actor_payload": true,
				"actor_id": int(
					gs.player.id
				)
			},
			"source": str(
				persistence_payload.get(
					"source",
					""
				)
			),
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(
				gs.player.id
			),
			"target_id": int(
				gs.player.id
			),
			"surface_id": "activities_hub_panel",
			"action_id": "persist_section_lens",
			"source": (
				"mainscene.activities_lens_persistence"
			)
		}
	)


