func _exit_startup_intro_to_god_mode() -> void:
	if startup_intro_exiting:
		return

	_global_runtime_kill_enter_main_menu_runtime("startup_intro_exit_to_choose_adventure", {
		"choose_adventure_entry": true,
		"simulation_work_forbidden": true
	})

	_surface_guard_assert_render("choose_adventure_entry", "startup_intro_enter_life", "pre_life", 1800)

	startup_intro_exiting = true
	startup_intro_accepting_input = false

	if startup_intro_prompt_tween != null:
		startup_intro_prompt_tween.kill()
		startup_intro_prompt_tween = null
	if startup_intro_title_tween != null:
		startup_intro_title_tween.kill()
		startup_intro_title_tween = null
	if startup_intro_skip_tween != null:
		startup_intro_skip_tween.kill()
		startup_intro_skip_tween = null
	if startup_intro_replay_tween != null:
		startup_intro_replay_tween.kill()
		startup_intro_replay_tween = null

	_hide_startup_intro_replay_button()

	_show_choose_adventure_entry_panel()

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		choose_adventure_entry_overlay.visible = true
		choose_adventure_entry_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
		choose_adventure_entry_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
		_bring_modal_to_front(choose_adventure_entry_overlay)

	_transition_audio_from_startup_intro_to_god_mode("startup_intro_enter_life", 760)

	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay):
		startup_intro_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

		var tween:= create_tween().bind_node(startup_intro_overlay)
		tween.set_trans(Tween.TRANS_SINE)
		tween.set_ease(Tween.EASE_IN_OUT)
		tween.tween_property(
			startup_intro_overlay,
			"modulate",
			Color(1.0, 1.0, 1.0, 0.0),
			0.22
		)
		tween.finished.connect(
			Callable(self, "_finish_startup_intro_exit_cleanup"),
			CONNECT_ONE_SHOT
		)
	else:
		call_deferred("_finish_startup_intro_exit_cleanup")

	_surface_guard_release_deferred("choose_adventure_entry", 0.95)

