func _precache_startup_intro_audio_stream(
	reason: String = "startup_intro_precache"
) -> Dictionary:
	if not era_audio_enabled:
		return {
			"success": false,
			"ready": false,
			"pending": false,
			"reason": "era_audio_disabled"
		}

	var engine = _ensure_era_audio_engine()

	if engine == null:
		return {
			"success": false,
			"ready": false,
			"pending": false,
			"reason": "missing_era_audio_engine"
		}

	var report: Dictionary = engine.request_audio_stream(
		[
			"res://audio/music/BlackMirrorOpening.ogg",
			"res://Audio/Music/BlackMirrorOpening.ogg",
			"res://audio/BlackMirrorOpening.ogg",
			"res://Audio/BlackMirrorOpening.ogg",
			"res://BlackMirrorOpening.ogg"
		],
		{
			"source": (
				"mainscene.startup_intro_precache"
			),
			"reason": reason,
			"track_id": "startup_history_opening",
			"precache_only": true,
		}
	)

	set_meta(
		"startup_intro_audio_precache_report",
		report.duplicate(true)
	)
	set_meta(
		"startup_intro_audio_precache_ready",
		bool(
			report.get(
				"ready",
				false
			)
		)
	)
	set_meta(
		"startup_intro_audio_precache_pending",
		bool(
			report.get(
				"pending",
				false
			)
		)
	)
	set_meta(
		"startup_intro_audio_precache_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"startup_intro_audio_precache_did_not_start_audio",
		true
	)

	return report
