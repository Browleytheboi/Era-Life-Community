		romance_contract_popup_scroll_fade_timer.stop()
	_reset_romance_contract_scroll()
	if romance_contract_popup != null and is_instance_valid(romance_contract_popup):
		romance_contract_popup.visible = false
func _resolve_other_country_ruler_name(realm: Dictionary) -> String:
	if typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return "Unknown"

	var special_name: String = str(realm.get("name", "")).strip_edges().to_lower()
	if special_name in ["terabithia", "vormir", "vormier", "nidavellir", "era kingdom"]:
		var special_ruler: String = str(realm.get("guide_name", realm.get("ruler_name", realm.get("leader_name", realm.get("regent_name", ""))))).strip_edges()
		return special_ruler if special_ruler != "" else "Unclaimed Throne"

	var synced_realm: Dictionary = _other_country_sync_standard_realm_governance(realm)
	if not synced_realm.is_empty():
		realm = synced_realm

	var title_text: String = _other_country_standard_ruler_title(realm)
	var resolved_ruler: Person = _other_country_find_standard_realm_ruler_person(realm)
	if resolved_ruler == null:
		resolved_ruler = _other_country_ensure_surface_ruler_person(realm, title_text)
	if resolved_ruler != null:
		_other_country_apply_surface_ruler_identity(resolved_ruler, realm, title_text, _other_country_surface_ruler_key(realm))
		return MainSceneLogic._other_country_person_title_name(resolved_ruler, title_text)

	var fallback_ruler: String = str(realm.get("ruler_name", realm.get("leader_name", realm.get("regent_name", "")))).strip_edges()
	var raw_ruler = realm.get("ruler_id", realm.get("ruler_npc_id", realm.get("leader_id", fallback_ruler if fallback_ruler != "" else "")))
	var raw_type: int = typeof(raw_ruler)

	if raw_type == TYPE_STRING:
		var raw_text: String = str(raw_ruler).strip_edges()
		if raw_text == "" or raw_text.to_lower() in ["-1", "0", "none", "null", "unknown"]:
			if fallback_ruler != "":
				return _other_country_format_ruler_text(title_text, fallback_ruler, realm)
			return "Unclaimed Throne"

		var parsed_id: int = int(raw_text)
		if str(parsed_id) == raw_text and parsed_id > 0 and gs != null:
			var parsed_ruler: Person = gs.get_or_reactivate_npc_by_id(parsed_id)
			if parsed_ruler != null:
				return MainSceneLogic._other_country_person_title_name(parsed_ruler, title_text)

		return _other_country_format_ruler_text(title_text, raw_text, realm)

	if raw_type in [TYPE_INT, TYPE_FLOAT]:
		var ruler_id: int = int(raw_ruler)
		if ruler_id > 0 and gs != null:
			var ruler: Person = gs.get_or_reactivate_npc_by_id(ruler_id)
			if ruler != null:
				return MainSceneLogic._other_country_person_title_name(ruler, title_text)
		return "Unclaimed Throne"

	if fallback_ruler != "":
		return _other_country_format_ruler_text(title_text, fallback_ruler, realm)

	return "Unclaimed Throne"
func _other_country_sync_standard_realm_governance(realm: Dictionary) -> Dictionary:
	if gs == null or typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return realm

	var realm_name: String = str(realm.get("name", "")).strip_edges().to_lower()
	if realm_name in ["terabithia", "vormir", "vormier", "nidavellir", "era kingdom"]:
		return realm

	var synced_realm: Dictionary = realm.duplicate(true)
	var existing_realm: Dictionary = _other_country_existing_realm_truth_for_surface(synced_realm)

	if not existing_realm.is_empty():
		synced_realm = MainSceneHelpers._other_country_merge_realm_truth_into_surface_realm(synced_realm, existing_realm)

	var realm_id: int = int(synced_realm.get("realm_id", synced_realm.get("id", 0)))

	if realm_id > 0 and "realm_engine" in gs and gs.realm_engine != null:
		if gs.realm_engine.has_method("ensure_realm_governance"):
			var preferred_city: String = str(synced_realm.get("capital_city", synced_realm.get("capital", ""))).strip_edges()
			var hydrated_raw: Variant = gs.realm_engine.ensure_realm_governance(realm_id, preferred_city)
			if typeof(hydrated_raw) == TYPE_DICTIONARY and not (hydrated_raw as Dictionary).is_empty():
				synced_realm = MainSceneHelpers._other_country_merge_realm_truth_into_surface_realm(synced_realm, hydrated_raw as Dictionary)

	synced_realm = MainSceneLogic._other_country_apply_presidential_parent_leader_truth_to_surface(gs, synced_realm)

	return _other_country_ensure_surface_governance_projection(synced_realm)
func _other_country_existing_realm_truth_for_surface(surface_realm: Dictionary) -> Dictionary:
	if gs == null or typeof(surface_realm) != TYPE_DICTIONARY:
		return {}
	if gs.realm_engine == null or not ("realms" in gs.realm_engine):
		return {}
	if typeof(gs.realm_engine.realms) != TYPE_DICTIONARY:
		return {}

	var wanted_keys: Dictionary = {}
	for raw_name in [
		str(surface_realm.get("name", "")),
		str(surface_realm.get("country", "")),
		str(surface_realm.get("realm_contract_resolved_from_country", ""))
	]:
		var clean_key: String = MainSceneHelpers._other_country_identity_key(str(raw_name))
		if clean_key != "":
			wanted_keys [clean_key] = true

	for raw_realm_id in gs.realm_engine.realms.keys():
		var existing_raw: Variant = gs.realm_engine.realms.get(raw_realm_id, {})
		if typeof(existing_raw) != TYPE_DICTIONARY:
			continue

		var existing: Dictionary = existing_raw
		for raw_existing_name in [
			str(existing.get("name", "")),
			str(existing.get("country", "")),
			str(existing.get("realm_contract_resolved_from_country", ""))
		]:
			var existing_key: String = MainSceneHelpers._other_country_identity_key(str(raw_existing_name))
			if existing_key != "" and wanted_keys.has(existing_key):
				return existing.duplicate(true)

	return {}


func _other_country_standard_ruler_title(realm: Dictionary) -> String:
	var realm_name: String = str(realm.get("name", "")).strip_edges()
	var lower_name: String = realm_name.to_lower()
	var native_element: String = str(realm.get("native_element", "")).strip_edges().to_lower()
	var government_style: String = str(realm.get("government_style", "State")).strip_edges()
	var government_model: String = str(realm.get("government_model", "")).strip_edges().to_lower()
	var era_key: String = _other_country_browser_current_era_key().strip_edges().to_lower()

	var country_key: String = MainSceneHelpers._other_country_identity_key(str(realm.get("country", realm_name)))
	var realm_key: String = MainSceneHelpers._other_country_identity_key(realm_name)

	if government_model == "federal_presidential_republic" \
or country_key in ["usa", "us", "unitedstates", "unitedstatesofamerica", "america"] \
or realm_key in ["usa", "us", "unitedstates", "unitedstatesofamerica", "america"]:
		return "President"

	if lower_name.find("fire nation") >= 0 or native_element == "fire":
		return "Fire Lord"

	if lower_name.find("water tribe") >= 0 or lower_name.find("water nation") >= 0 or native_element == "water":
		return "Chief"

	if lower_name.find("earth kingdom") >= 0 or native_element == "earth":
		var monarch_gender: String = _other_country_resolve_ruler_gender_for_title(realm)
		if monarch_gender == "female":
			return "Earth Queen"
		return "Earth King"

	if lower_name.find("air temple") >= 0 or lower_name.find("air nomads") >= 0 or native_element == "air":
		return "Monk"

	if era_key.find("ancient") >= 0:
		return MainSceneHelpers._other_country_ancient_ruler_title_for_name(lower_name, government_style)

	if era_key.find("medieval") >= 0:
		return MainSceneHelpers._other_country_medieval_ruler_title_for_name(lower_name, government_style)

	match government_style:
		"Monarchy":
			return "King"
		"Empire":
			return "Emperor"
		"Kingdom":
			return "King"
		"Democracy":
			return "President"
		"Republic":
			return "Chancellor"
		"Dictatorship":
			return "Supreme Leader"
		"Communism":
			return "General Secretary"
		"Anarchy":
			return "Council Voice"
		_:
			return "Ruler"


func _other_country_format_ruler_text(title_text: String, raw_text: String, realm: Dictionary = {}) -> String:
	var clean_title: String = str(title_text).strip_edges()
	var clean_text: String = str(raw_text).strip_edges()
	if clean_text == "":
		return clean_title if clean_title != "" else "Unclaimed Throne"

	var lower_text: String = clean_text.to_lower()
	var lower_title: String = clean_title.to_lower()
	var generic_office_text: bool = MainSceneHelpers._other_country_ruler_text_is_generic_office(lower_text, realm)

	var extracted_name: String = MainSceneLogic._other_country_extract_person_name_from_ruler_text(clean_text, realm)
	if extracted_name == "":
		var ruler_person: Person = _other_country_find_standard_realm_ruler_person(realm)
		if ruler_person != null:
			extracted_name = MainSceneHelpers._other_country_person_plain_name(ruler_person)

	if extracted_name == "":
		if generic_office_text:
			return clean_title if clean_title != "" else "Unclaimed Throne"
		extracted_name = clean_text

	if clean_title != "" and lower_text.begins_with(lower_title):
		if generic_office_text:
			return clean_title
		return clean_text

	if clean_title == "":
		return extracted_name

	if MainSceneHelpers._other_country_text_already_has_title(extracted_name, clean_title):
		return extracted_name

	return "%s %s" % [clean_title, extracted_name]

func _other_country_surface_ruler_registry() -> Dictionary:
	if gs == null:
		return {}

	if not ("scenario_state" in gs) or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return {}

	var raw_registry: Variant = gs.scenario_state.get("other_country_surface_rulers", {})
	if typeof(raw_registry) != TYPE_DICTIONARY:
		gs.scenario_state ["other_country_surface_rulers"] = {}
		return {}

	return (raw_registry as Dictionary).duplicate(true)


func _other_country_write_surface_ruler_registry(registry: Dictionary) -> void:
	if gs == null:
		return

	if not ("scenario_state" in gs) or typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	gs.scenario_state ["other_country_surface_rulers"] = registry.duplicate(true)


func _other_country_surface_ruler_key(realm: Dictionary) -> String:
	if typeof(realm) != TYPE_DICTIONARY:
		return "surface_ruler:unknown"

	var explicit_key: String = str(realm.get("surface_ruler_key", "")).strip_edges()
	if explicit_key != "":
		return explicit_key

	var realm_name: String = str(realm.get("name", realm.get("country", "Unknown Realm"))).strip_edges()
	var country_name: String = str(realm.get("country", realm_name)).strip_edges()
	var era_key: String = str(realm.get("era", "")).strip_edges()
	if era_key == "":
		era_key = _selected_era_key()

	var native_element: String = str(realm.get("native_element", "")).strip_edges().to_lower()
	var realm_type: String = str(realm.get("realm_type", realm.get("dimension_type", ""))).strip_edges().to_lower()

	return "surface_ruler:%s" % MainSceneHelpers._other_country_identity_key("%s:%s:%s:%s:%s" % [
		era_key,
		realm_type,
		country_name,
		realm_name,
		native_element
	])


func _other_country_ensure_surface_governance_projection(realm: Dictionary) -> Dictionary:
	if gs == null or typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return realm

	var out: Dictionary = realm.duplicate(true)
	var realm_name: String = str(out.get("name", "")).strip_edges().to_lower()
	if realm_name in ["terabithia", "vormir", "vormier", "nidavellir", "era kingdom"]:
		return out

	var realm_type: String = str(out.get("realm_type", out.get("dimension_type", ""))).strip_edges().to_lower()
	var native_element: String = str(out.get("native_element", "")).strip_edges().to_lower()
	var is_country_surface: bool = bool(out.get("is_country_surface", false)) or realm_type == "country"
	var is_elemental_surface: bool = bool(out.get("elemental_realm", false)) or native_element in ["air", "water", "earth", "fire"]

	if not is_country_surface and not is_elemental_surface:
		return out

	var title_text: String = _other_country_standard_ruler_title(out)
	var ruler_person: Person = _other_country_find_standard_realm_ruler_person(out)
	if ruler_person == null:
		ruler_person = _other_country_ensure_surface_ruler_person(out, title_text)

	if ruler_person != null:
		var ruler_name: String = MainSceneHelpers._other_country_person_plain_name(ruler_person)
		out ["ruler_id"] = int(ruler_person.id)
		out ["ruler_npc_id"] = int(ruler_person.id)
		out ["leader_id"] = int(ruler_person.id)
		out ["ruler_name"] = ruler_name
		out ["leader_name"] = ruler_name
		out ["surface_ruler_key"] = _other_country_surface_ruler_key(out)
		out ["surface_ruler_contract"] = {
			"schema": "eralife.other_country_surface_ruler_contract",
			"version": 1,
			"ruler_id": int(ruler_person.id),
			"ruler_name": ruler_name,
			"title": title_text,
			"realm_name": str(out.get("name", "")),
			"country": str(out.get("country", out.get("name", ""))),
			"native_element": native_element,
			"surface_key": str(out.get("surface_ruler_key", ""))
		}

	return out


func _other_country_ensure_surface_ruler_person(realm: Dictionary, title_text: String) -> Person:
	if gs == null or typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return null

	var surface_key: String = _other_country_surface_ruler_key(realm)
	var registry: Dictionary = _other_country_surface_ruler_registry()
	var stored_id: int = int(registry.get(surface_key, -1))

	if stored_id > 0:
		var stored_person: Person = null
		if gs.has_method("get_or_reactivate_npc_by_id"):
			stored_person = gs.get_or_reactivate_npc_by_id(stored_id)
		elif gs.has_method("get_npc_by_id"):
			stored_person = gs.get_npc_by_id(stored_id)

		if stored_person != null and stored_person.alive:
			_other_country_apply_surface_ruler_identity(stored_person, realm, title_text, surface_key)
			return stored_person

	var generated_ruler: Person = null
	if "npc_factory" in gs and gs.npc_factory != null and gs.npc_factory.has_method("create_random_npc"):
		generated_ruler = gs.npc_factory.create_random_npc(false)
	elif gs.has_method("create_random_npc"):
		generated_ruler = gs.create_random_npc(false)

	if generated_ruler == null:
		return null

	_other_country_apply_surface_ruler_identity(generated_ruler, realm, title_text, surface_key)

	if "npcs" in gs and typeof(gs.npcs) == TYPE_ARRAY:
		var already_registered: bool = false
		if gs.has_method("get_npc_by_id"):
			already_registered = gs.get_npc_by_id(int(generated_ruler.id)) != null
		if not already_registered:
			gs.npcs.append(generated_ruler)

	registry [surface_key] = int(generated_ruler.id)
	_other_country_write_surface_ruler_registry(registry)

	return generated_ruler


func _other_country_apply_surface_ruler_identity(ruler: Person, realm: Dictionary, title_text: String, surface_key: String) -> void:
	if ruler == null or typeof(realm) != TYPE_DICTIONARY:
		return

	var realm_name: String = str(realm.get("name", realm.get("country", "Unknown Realm"))).strip_edges()
	var country_name: String = str(realm.get("country", realm_name)).strip_edges()
	var capital_name: String = str(realm.get("capital_city", realm.get("capital", ""))).strip_edges()
	var native_element: String = str(realm.get("native_element", "")).strip_edges().to_lower()
	var era_key: String = str(realm.get("era", _selected_era_key())).strip_edges().to_lower()
	if era_key == "":
		era_key = _selected_era_key().strip_edges().to_lower()

	var culture_contract: Dictionary = MainSceneLogic._other_country_surface_culture_contract(realm_name, country_name, native_element, era_key)
	var identity_contract: Dictionary = MainSceneHelpers._safe_dictionary(culture_contract.get("ruler_identity_contract", {}))

	var clean_title: String = str(title_text).strip_edges()
	var cultural_title: String = str(identity_contract.get("must_have_title", "")).strip_edges()
	if cultural_title != "":
		clean_title = cultural_title

	var origin_city: String = _other_country_surface_ruler_origin_city(realm, surface_key)
	if origin_city == "":
		origin_city = capital_name

	if country_name != "":
		if "birth_country" in ruler:
			ruler.birth_country = country_name
		if "home_country" in ruler:
			ruler.home_country = country_name
		if "country" in ruler:
			ruler.country = country_name
		if "current_country" in ruler:
			ruler.current_country = country_name

	if origin_city != "":
		if "birth_city" in ruler:
			ruler.birth_city = origin_city
		if "home_city" in ruler:
			ruler.home_city = origin_city
		if "city" in ruler:
			ruler.city = origin_city
		if "current_city" in ruler:
			ruler.current_city = origin_city

	if "realm_name" in ruler:
		ruler.realm_name = realm_name
	if "kingdom_name" in ruler:
		ruler.kingdom_name = realm_name
	if "realm_id" in ruler and int(realm.get("realm_id", realm.get("id", -1))) > 0:
		ruler.realm_id = int(realm.get("realm_id", realm.get("id", -1)))

	ruler.is_ruler = true
	ruler.royal_title = clean_title
	ruler.job = clean_title if clean_title != "" else "Ruler"

	var lower_title: String = clean_title.to_lower()
	var civic_titles: Array = ["president", "prime minister", "chancellor", "general secretary", "council voice", "head of state"]
	ruler.is_royal = true
	for raw_civic_title in civic_titles:
		if lower_title.find(str(raw_civic_title)) >= 0:
			ruler.is_royal = false
			break

	if int(ruler.age) < 18:
		ruler.age = 35 + int(abs(int(surface_key.hash())) % 30)

	if _other_country_surface_ruler_should_use_origin_name(realm) and origin_city != "":
		var clean_first_name: String = str(ruler.first_name).strip_edges()
		if clean_first_name == "":
			clean_first_name = str(ruler.name).strip_edges().split(" ") [0]
		if clean_first_name != "":
			var origin_label: String = MainSceneLogic._other_country_elemental_definite_name(origin_city, false)
			if origin_label == "":
				origin_label = origin_city
			ruler.first_name = clean_first_name
			ruler.last_name = "of %s" % origin_label
			ruler.name = "%s %s" % [clean_first_name, ruler.last_name]

	if "social_class" in ruler:
		ruler.social_class = "Royal" if bool(ruler.is_royal) else "Upper"

	var behavior_contract: Dictionary = MainSceneHelpers._safe_dictionary(culture_contract.get("behavior_contract", {}))
	var behavior_bias: Dictionary = MainSceneHelpers._safe_dictionary(culture_contract.get("behavior_bias", {}))
	if ruler.has_method("set_meta"):
		ruler.set_meta("culture_contract_id", str(culture_contract.get("id", "")))
		ruler.set_meta("culture_values", MainSceneHelpers._safe_array(culture_contract.get("values", [])))
		ruler.set_meta("culture_behavior_bias", behavior_bias.duplicate(true))
		ruler.set_meta("culture_prefer_actions", MainSceneHelpers._safe_array(behavior_contract.get("prefer_actions", [])))
		ruler.set_meta("culture_avoid_actions", MainSceneHelpers._safe_array(behavior_contract.get("avoid_actions", [])))

	if typeof(ruler.memories) == TYPE_ARRAY:
		var governance_memory: String = "I rule %s as %s." % [realm_name, clean_title]
		if not ruler.memories.has(governance_memory):
			ruler.memories.append(governance_memory)

		var culture_memory: String = "My rule is shaped by %s." % str(culture_contract.get("display_name", "the culture of this realm"))
		if not ruler.memories.has(culture_memory):
			ruler.memories.append(culture_memory)
func _other_country_surface_ruler_should_use_origin_name(realm: Dictionary) -> bool:
	if typeof(realm) != TYPE_DICTIONARY:
		return false

	var realm_name: String = str(realm.get("name", realm.get("country", ""))).strip_edges().to_lower()
	var country_name: String = str(realm.get("country", realm_name)).strip_edges().to_lower()
	var native_element: String = str(realm.get("native_element", "")).strip_edges().to_lower()
	var era_key: String = str(realm.get("era", _selected_era_key())).strip_edges().to_lower()
	if era_key == "":
		era_key = _selected_era_key().strip_edges().to_lower()

	var culture_contract: Dictionary = MainSceneLogic._other_country_surface_culture_contract(realm_name, country_name, native_element, era_key)
	var identity_contract: Dictionary = MainSceneHelpers._safe_dictionary(culture_contract.get("ruler_identity_contract", {}))
	var name_format: String = str(identity_contract.get("name_format", "")).strip_edges().to_lower()

	if name_format == "of_city":
		return true

	return era_key in ["ancient", "ancient era", "medieval", "medieval era"]


func _other_country_surface_ruler_origin_city(realm: Dictionary, surface_key: String = "") -> String:
	if typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return ""

	var realm_name: String = str(realm.get("name", realm.get("country", ""))).strip_edges()
	var country_name: String = str(realm.get("country", realm_name)).strip_edges()
	var native_element: String = str(realm.get("native_element", "")).strip_edges().to_lower()
	var is_elemental_surface: bool = bool(realm.get("elemental_realm", false)) or native_element in ["air", "water", "earth", "fire"]
	var elemental_origin_name: String = MainSceneLogic._other_country_elemental_surface_origin_name(realm)

	if is_elemental_surface and elemental_origin_name != "":
		return elemental_origin_name

	var direct_city: String = str(realm.get("ruler_origin_city", "")).strip_edges()
	if direct_city != "":
		return direct_city

	var capital_name: String = str(realm.get("capital_city", realm.get("capital", ""))).strip_edges()
	if capital_name != "":
		return capital_name

	var era_key: String = str(realm.get("era", _selected_era_key())).strip_edges().to_lower()
	var realm_city_pool: Array = _other_country_surface_ruler_city_pool(realm_name, country_name, native_element, era_key)
	if realm_city_pool.is_empty():
		return ""

	var seed_material: String = surface_key
	if seed_material == "":
		seed_material = "%s|%s|%s|%s" % [era_key, realm_name, country_name, native_element]
	var pick_index: int = int(abs(int(seed_material.hash())) % max(1, realm_city_pool.size()))
	return str(realm_city_pool [pick_index]).strip_edges()
func _other_country_surface_ruler_city_pool(realm_name: String, country_name: String, native_element: String, _era_key: String) -> Array:
	var out: Array = []
	var lower_realm: String = str(realm_name).strip_edges().to_lower()
	var lower_country: String = str(country_name).strip_edges().to_lower()
	var lower_element: String = str(native_element).strip_edges().to_lower()
	var lower_era: String = str(_era_key).strip_edges().to_lower()

	var culture_contract: Dictionary = MainSceneLogic._other_country_surface_culture_contract(lower_realm, lower_country, lower_element, lower_era)
	var culture_city_pool: Array = MainSceneHelpers._safe_array(culture_contract.get("city_pool", []))
	for raw_culture_city in culture_city_pool:
		var culture_city_text: String = str(raw_culture_city).strip_edges()
		if culture_city_text != "" and not out.has(culture_city_text):
			out.append(culture_city_text)

	var explicit_pool: Array = MainSceneHelpers._other_country_surface_ruler_explicit_city_pool(lower_realm, lower_country, lower_element)
	for raw_city in explicit_pool:
		var city_text: String = str(raw_city).strip_edges()
		if city_text != "" and not out.has(city_text):
			out.append(city_text)

	var era_locations: Array = MainSceneLogic._other_country_surface_birth_locations_for_era(gs, lower_era)
	for raw_location in era_locations:
		if typeof(raw_location) != TYPE_DICTIONARY:
			continue

		var location: Dictionary = raw_location as Dictionary
		var city_text: String = str(location.get("city", "")).strip_edges()
		var location_country: String = str(location.get("country", "")).strip_edges().to_lower()
		if city_text == "" or location_country == "":
			continue

		var country_matches: bool = false
		if location_country == lower_country or location_country == lower_realm:
			country_matches = true
		elif lower_country != "" and (location_country.find(lower_country) >= 0 or lower_country.find(location_country) >= 0):
			country_matches = true
		elif lower_realm != "" and (location_country.find(lower_realm) >= 0 or lower_realm.find(location_country) >= 0):
			country_matches = true

		if country_matches and not out.has(city_text):
			out.append(city_text)

	return out
func _other_country_find_standard_realm_ruler_person(realm: Dictionary) -> Person:
	if gs == null or typeof(realm) != TYPE_DICTIONARY or realm.is_empty():
		return null

	var ruler_id: int = int(realm.get("ruler_id", realm.get("ruler_npc_id", realm.get("leader_id", -1))))
	if ruler_id > 0:
		var stored_ruler: Person = gs.get_or_reactivate_npc_by_id(ruler_id)
		if stored_ruler != null and stored_ruler.alive:
			return stored_ruler

	var surface_key: String = _other_country_surface_ruler_key(realm)
	var registry: Dictionary = _other_country_surface_ruler_registry()
	var surface_ruler_id: int = int(registry.get(surface_key, -1))
	if surface_ruler_id > 0:
		var surface_ruler: Person = null
		if gs.has_method("get_or_reactivate_npc_by_id"):
			surface_ruler = gs.get_or_reactivate_npc_by_id(surface_ruler_id)
		elif gs.has_method("get_npc_by_id"):
			surface_ruler = gs.get_npc_by_id(surface_ruler_id)
		if surface_ruler != null and surface_ruler.alive:
			return surface_ruler

	var realm_id: int = int(realm.get("realm_id", realm.get("id", -1)))
	if realm_id > 0 and "realm_engine" in gs and gs.realm_engine != null and gs.realm_engine.has_method("_find_living_realm_ruler"):
		var engine_ruler_raw: Variant = gs.realm_engine._find_living_realm_ruler(realm_id)
		if engine_ruler_raw != null and engine_ruler_raw is Person:
			var engine_ruler: Person = engine_ruler_raw as Person
			if engine_ruler != null and engine_ruler.alive:
				return engine_ruler

	var realm_name: String = str(realm.get("name", "")).strip_edges()
	var lower_realm_name: String = realm_name.to_lower()
	var possible_country_names: Array = []
	if lower_realm_name != "":
		possible_country_names.append(lower_realm_name)
		if lower_realm_name.begins_with("the "):
			possible_country_names.append(lower_realm_name.substr(4).strip_edges())
		else:
			possible_country_names.append("the %s" % lower_realm_name)

	var country_name: String = str(realm.get("country", "")).strip_edges().to_lower()
	if country_name != "":
		possible_country_names.append(country_name)
		if country_name.begins_with("the "):
			possible_country_names.append(country_name.substr(4).strip_edges())
		else:
			possible_country_names.append("the %s" % country_name)

	var capital_name: String = str(realm.get("capital", realm.get("capital_city", ""))).strip_edges().to_lower()
	if capital_name != "":
		possible_country_names.append(capital_name)

	var fallback_name: String = str(realm.get("ruler_name", realm.get("leader_name", realm.get("regent_name", "")))).strip_edges().to_lower()
	var fallback_is_generic: bool = MainSceneHelpers._other_country_ruler_text_is_generic_office(fallback_name, realm)

	if "npcs" in gs and typeof(gs.npcs) == TYPE_ARRAY:
		for raw_npc in gs.npcs:
			if raw_npc == null or not (raw_npc is Person):
				continue

			var npc: Person = raw_npc as Person
			if npc == null or not npc.alive:
				continue

			if realm_id > 0 and "realm_id" in npc and int(npc.realm_id) == realm_id and bool(npc.is_ruler):
				return npc

			if fallback_name != "" and not fallback_is_generic:
				var npc_plain_name: String = MainSceneHelpers._other_country_person_plain_name(npc).strip_edges().to_lower()
				if npc_plain_name == fallback_name:
					return npc

			if not bool(npc.is_ruler):
				continue

			var npc_country_values: Array = []
			if "country" in npc:
				npc_country_values.append(str(npc.country).strip_edges().to_lower())
			if "current_country" in npc:
				npc_country_values.append(str(npc.current_country).strip_edges().to_lower())
			if "home_country" in npc:
				npc_country_values.append(str(npc.home_country).strip_edges().to_lower())
			if "birth_country" in npc:
				npc_country_values.append(str(npc.birth_country).strip_edges().to_lower())
			if "kingdom_name" in npc:
				npc_country_values.append(str(npc.kingdom_name).strip_edges().to_lower())
			if "realm_name" in npc:
				npc_country_values.append(str(npc.realm_name).strip_edges().to_lower())

			for raw_country in npc_country_values:
				var npc_country: String = str(raw_country).strip_edges().to_lower()
				if npc_country == "":
					continue
				if possible_country_names.has(npc_country):
					return npc

	return null


func _other_country_resolve_ruler_gender_for_title(realm: Dictionary) -> String:
	var explicit_gender: String = str(realm.get("monarch_gender", realm.get("ruler_gender", ""))).strip_edges().to_lower()
	if explicit_gender in ["male", "female"]:
		return explicit_gender

	var ruler_person: Person = _other_country_find_standard_realm_ruler_person(realm)
	if ruler_person != null:
		var gender_text: String = str(ruler_person.gender).strip_edges().to_lower()
		if gender_text in ["male", "female"]:
			return gender_text

	return ""
func _show_other_country_overview(entry: Dictionary) -> void:
	if gs == null:
		return
	var realm: Dictionary = entry.get("realm", {})
	var entry_name: String = str(entry.get("name", "Country / Realm")).strip_edges()
	var entry_kind: String = str(entry.get("entry_kind", "realm")).strip_edges()
	var entry_id: String = str(entry.get("entry_id", "")).strip_edges()
	var browser_visual_theme: String = str(realm.get("browser_visual_theme", "")).strip_edges().to_lower()
	var overview_visual_theme: String = str(realm.get("overview_visual_theme", browser_visual_theme)).strip_edges().to_lower()

	var other_countries_popup:= get_node_or_null("OtherCountriesPopup")
	var popup_visible: bool = other_countries_popup != null and other_countries_popup.visible
	var popup_return_panel: String = str(current_panel).strip_edges()
	if popup_visible and other_countries_popup != null:
		popup_return_panel = str(other_countries_popup.get_meta("browser_return_panel", popup_return_panel)).strip_edges()
	if popup_return_panel == "":
		popup_return_panel = "world"

	var native_element: String = _other_country_resolve_native_element(entry, realm)
	var is_elemental_realm: bool = native_element in ["air", "water", "earth", "fire"]
	var entry_display_name: String = MainSceneLogic._other_country_elemental_definite_name(entry_name, false) if is_elemental_realm else entry_name

	var payload:= {
		"entry": entry.duplicate(true),
		"realm": realm.duplicate(true),
		"entry_kind": entry_kind,
		"entry_name": entry_name,
		"entry_display_name": entry_display_name,
		"return_to_other_countries": false,
		"return_panel": popup_return_panel,
		"selected_browser_visual_theme": browser_visual_theme,
		"selected_overview_visual_theme": overview_visual_theme
	}

	if popup_visible:
		payload ["return_to_other_countries"] = true
	if entry_id == "era_kingdom" and popup_visible:
		await _run_era_kingdom_access_sequence()
	if popup_visible:
		var status:= other_countries_popup.find_child("Status", true, false) as Label
		if status != null:
			status.text = "Click any country or realm to open a FULL overview. Interrealm authority appears first, imaginative realms surface beneath it, elemental realms gather below them, and ordinary realms stay below all special surfaces."
		other_countries_popup.visible = false
	_show_standard_tab_popup(
		"%s • OVERVIEW" % entry_display_name.to_upper(),
		_build_other_country_overview_body_lines(payload),
		"other_country_overview",
		payload
	)
func _append_other_country_section_divider(parent: VBoxContainer, text: String, accented: bool = false) -> void:
	var row:= HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.custom_minimum_size = Vector2(0, 34)
	row.add_theme_constant_override("separation", 12)
	parent.add_child(row)

	var normalized_text: String = str(text).strip_edges().to_upper()
	var space_section: bool = normalized_text == "SPACE REALMS"
	var imaginative_section: bool = normalized_text == "IMAGINATIVE REALMS"
	var elemental_section: bool = normalized_text == "ELEMENTAL REALMS"
	var ordinary_section: bool = normalized_text == "ORDINARY REALMS"

	var line_color: Color = Color(0.99, 0.84, 0.32, 0.72) if accented else Color(0.58, 0.64, 0.76, 0.24)
	var font_color: Color = Color(0.99, 0.88, 0.44, 0.98) if accented else Color(0.76, 0.81, 0.9, 0.74)
	var shadow_color: Color = Color(0.98, 0.72, 0.16, 0.14) if accented else Color(0.0, 0.0, 0.0, 0.0)
	var shadow_size: int = 1 if accented else 0
	var section_font_size: int = 15
	var line_height: int = 2

	if space_section:
		line_color = Color(0.86, 0.42, 1.0, 0.78)
		font_color = Color(0.98, 0.9, 1.0, 1.0)
		shadow_color = Color(0.54, 0.18, 0.92, 0.42)
		shadow_size = 4
		section_font_size = 17
		line_height = 3
	elif elemental_section:
		line_color = Color(0.3, 0.78, 1.0, 0.72)
		font_color = Color(0.78, 0.94, 1.0, 1.0)
		shadow_color = Color(0.18, 0.66, 1.0, 0.34)
		shadow_size = 4
		section_font_size = 17
		line_height = 3
	elif imaginative_section:
		line_color = Color(0.92, 0.88, 1.0, 0.82)
		font_color = Color(1.0, 0.98, 1.0, 1.0)
		shadow_color = Color(0.78, 0.6, 1.0, 0.3)
		shadow_size = 3
	elif ordinary_section:
		line_color = Color(0.58, 0.72, 0.86, 0.44)
		font_color = Color(0.82, 0.9, 1.0, 0.92)
		shadow_color = Color(0.3, 0.48, 0.72, 0.18)
