				MainSceneLogic._build_artifact_button_style(
					item,
					0.34,
					false
				)
			)
			btn.add_theme_stylebox_override(
				"hover",
				MainSceneLogic._build_artifact_button_style(
					item,
					0.58,
					true
				)
			)
			btn.add_theme_stylebox_override(
				"pressed",
				MainSceneLogic._build_artifact_button_style(
					item,
					0.82,
					true
				)
			)
			btn.add_theme_stylebox_override(
				"focus",
				MainSceneLogic._build_artifact_button_style(
					item,
					0.7,
					true
				)
			)
			btn.add_theme_color_override(
				"font_color",
				Color(0.98, 1.0, 1.0, 1.0)
			)
			btn.add_theme_color_override(
				"font_hover_color",
				Color(1.0, 1.0, 1.0, 1.0)
			)
			btn.add_theme_color_override(
				"font_pressed_color",
				Color(1.0, 1.0, 1.0, 1.0)
			)
			btn.add_theme_color_override(
				"font_focus_color",
				Color(1.0, 1.0, 1.0, 1.0)
			)
			btn.add_theme_color_override(
				"font_shadow_color",
				Color(0.08, 0.18, 0.24, 0.34)
			)
			btn.add_theme_constant_override(
				"shadow_offset_x",
				0
			)
			btn.add_theme_constant_override(
				"shadow_offset_y",
				1
			)

			if action_name.begins_with("Food::"):
				btn.pressed.connect(
					_perform_belonging_food_target_action.bind(
						target
					)
				)
			else:
				btn.pressed.connect(
