			"normal",
			MainSceneLogic._build_red_bonnet_wish_button_style(0.56, false)
		)
		back_btn.add_theme_stylebox_override(
			"hover",
			MainSceneLogic._build_red_bonnet_wish_button_style(0.78, true)
		)
		back_btn.add_theme_stylebox_override(
			"pressed",
			MainSceneLogic._build_red_bonnet_wish_button_style(0.94, true)
		)
		back_btn.add_theme_stylebox_override(
			"focus",
			MainSceneLogic._build_red_bonnet_wish_button_style(0.86, true)
		)
		back_btn.add_theme_color_override(
			"font_color",
			Color(1.0, 0.95, 0.84, 1.0)
		)
		back_btn.add_theme_color_override(
			"font_hover_color",
			Color(1.0, 1.0, 1.0, 1.0)
		)
		back_btn.add_theme_color_override(
			"font_pressed_color",
			Color(1.0, 1.0, 1.0, 1.0)
		)
		back_btn.add_theme_color_override(
			"font_focus_color",
			Color(1.0, 1.0, 1.0, 1.0)
		)
		back_btn.add_theme_color_override(
			"font_shadow_color",
