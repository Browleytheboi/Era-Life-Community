	eraccount_status_banner_tween.tween_property(eraccount_status_banner, "offset_top", -88.0, 0.22)
	eraccount_status_banner_tween.parallel().tween_property(eraccount_status_banner, "offset_bottom", -24.0, 0.22)
	eraccount_status_banner_tween.parallel().tween_property(eraccount_status_banner, "modulate", Color(1.0, 1.0, 1.0, 0.0), 0.16)
	eraccount_status_banner_tween.tween_callback(func ():
