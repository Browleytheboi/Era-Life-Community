	prewarm_gs.scenario_state ["seed_contract"] = seed_contract.duplicate(true)
	prewarm_gs.scenario_state ["single_target_reality"] = true
	prewarm_gs.scenario_state ["prebirth_reality_locked"] = true
	prewarm_gs.scenario_state ["hydrate_player_before_surrounding_world"] = true
	prewarm_gs.scenario_state ["interactive_boot_requested"] = true
	prewarm_gs.scenario_state ["birth_shell_fast_first_paint"] = true
	prewarm_gs.scenario_state ["birth_shell_first_boot"] = true
	prewarm_gs.scenario_state ["birth_shell_npc_count"] = 0
	prewarm_gs.scenario_state ["defer_static_world_bootstrap"] = true
	prewarm_gs.scenario_state ["defer_live_runtime_watchers"] = true
	prewarm_gs.scenario_state ["deferred_data_bootstrap_pending"] = true
	prewarm_gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = true
	prewarm_gs.scenario_state ["soul_seed_distribution_authorized"] = false
	prewarm_gs.scenario_state ["soul_seed_distribution_reason"] = "deferred_until_live_shell_control"
	prewarm_gs.scenario_state ["soul_seed_priority_family_first"] = true
	prewarm_gs.scenario_state ["soul_seed_background_distribution_deferred"] = true
	prewarm_gs.scenario_state ["soul_seed_background_distribution_pending"] = true
	prewarm_gs.scenario_state ["soul_seed_background_stream_active"] = false
	prewarm_gs.scenario_state ["soul_seed_background_stream_complete"] = false
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_microtask_ui_safe"
