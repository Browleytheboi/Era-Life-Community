		"actor_id": int(gs.player.id),
		"year": int(gs.year),
		"age": int(gs.player.age),
		"diary_revision": "%d:%d:%d" % [int(gs.player.id), int(gs.year), lines.size()],
		"diary_lines": lines,
		"lines": lines,
		"life": {
			"diary": {
				"lines": lines,
				"year": int(gs.year),
				"age": int(gs.player.age),
				"perspective": "first_person"
			}
		},
		"actions": [
			{
				"id": "life.view_assets",
				"intent": "life.view_assets",
				"legacy_action_id": "Life View Assets",
				"label": "View Assets         ",
				"kind": "ui_intent",
				"enabled": true
			}
		]
	}


func _render_life_panel_ui_packet(packet: Dictionary) -> bool:
	if typeof(packet) != TYPE_DICTIONARY:
		return false
	if packet.is_empty():
		return false
	if not bool(packet.get("success", false)):
		return false

	var data_raw: Variant = packet.get("data", {})
	if typeof(data_raw) != TYPE_DICTIONARY:
		return false

	var data: Dictionary = data_raw as Dictionary
	var lines: Array = []
	var raw_lines: Variant = data.get("lines", [])
	if typeof(raw_lines) == TYPE_ARRAY:
		for raw_line in raw_lines:
			var line_text: String = str(raw_line)
			if line_text.strip_edges() != "":
				lines.append(line_text)

	if lines.is_empty():
		_ensure_active_life_diary_loaded(false)
		_rebuild_loaded_life_diary_snapshot_if_needed()
		lines = _flatten_life_diary_lines()

	if lines.is_empty():
		lines = [
			"Year: %s" % _format_year(gs.year if gs != null else 0),
			"Age: %d" % int(gs.player.age if gs != null and gs.player != null else 0),
			"My life has begun."
		]

	set_meta("life_diary_render_cached_lines", lines.duplicate(true))
	set_meta("life_diary_render_cached_signature", _life_diary_render_signature())

	return _open_life_diary_native_surface("render_life_panel_ui_packet_native_diary")

func _prewarm_life_panel_ui_packet() -> void:
	if gs == null or gs.player == null:
		return




	if _playable_life_shell_has_visible_sovereignty():
		set_meta(
			"life_panel_packet_prewarm_deferred_to_contract_authority",
			true
		)
		set_meta(
			"life_panel_packet_prewarm_deferred_reason",
			"visible_shell_residency_owns_observation"
		)
		set_meta(
			"life_panel_packet_prewarm_deferred_at_ms",
			int(Time.get_ticks_msec())
		)
		return

	var context: Dictionary = _build_life_panel_ui_packet_context()



	var report: Dictionary = _request_runtime_engine_method_intent(
		"reality_orchestrator",
		"prewarm_ui_surface",
		[
			"life_panel",
			context
		],
		"prewarm_life_panel_ui_packet",
		"main_scene.life_panel_ui_packet_prewarm",
		false
	)

	set_meta(
		"life_panel_packet_prewarm_last_report",
		report.duplicate(false)
	)
	set_meta(
		"life_panel_packet_prewarm_last_requested_at_ms",
		int(Time.get_ticks_msec())
	)
