func _selected_reality_mode_text() -> String:
	if reality_mode_picker == null:
		return reality_mode_picker_last_real_mode

	if not is_instance_valid(reality_mode_picker):
		reality_mode_picker = null
		return reality_mode_picker_last_real_mode

	var selected_idx:= reality_mode_picker.get_selected_id()
	if selected_idx < 0 or selected_idx >= reality_mode_picker.item_count:
		return reality_mode_picker_last_real_mode

	var selected_text:= reality_mode_picker.get_item_text(selected_idx).to_lower()
	if selected_text == TEMP_CUSTOM_MODE_LABEL.to_lower():
		return reality_mode_picker_last_real_mode

	return selected_text


func _toggle_state_matches_mode(mode_text: String) -> bool:
	var preset:= MainSceneHelpers._feature_overrides_for_mode(mode_text)
	var current:= _collect_feature_overrides_from_toggles()

	for key in MainSceneHelpers._feature_override_keys():
		if bool(current.get(key, false)) != bool(preset.get(key, false)):
			return false

	return true


func _sync_reality_mode_picker_custom_state() -> void:
	if reality_mode_picker == null:
		return

	if not is_instance_valid(reality_mode_picker):
		reality_mode_picker = null
		reality_mode_picker_syncing = false
		return

	reality_mode_picker_syncing = true

	var effective_mode:= reality_mode_picker_last_real_mode
	var is_custom:= not _toggle_state_matches_mode(effective_mode)

	if is_custom:
		var custom_idx:= _ensure_custom_picker_item()
		if reality_mode_picker != null and is_instance_valid(reality_mode_picker):
			reality_mode_picker.select(custom_idx)
	else:
		_remove_custom_picker_item_if_present()
		var idx:= _find_reality_mode_picker_index(effective_mode)
		if idx != -1 and reality_mode_picker != null and is_instance_valid(reality_mode_picker):
			reality_mode_picker.select(idx)

	reality_mode_picker_syncing = false

