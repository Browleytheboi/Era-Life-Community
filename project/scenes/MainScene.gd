		startup_intro_prompt_label != null
		and is_instance_valid(
			startup_intro_prompt_label
		)
	):
		startup_intro_prompt_label.text = (
			_title_card_identity_prompt_text()
		)

	_sync_global_reality_intake_button()
func _title_card_continue_contract() -> Dictionary:
	var direct_raw: Variant = get_meta(
		"title_card_continue_contract",
		{}
	)

	if typeof(
		direct_raw
	) == TYPE_DICTIONARY:
		var direct_contract: Dictionary = (
			(direct_raw as Dictionary)
			.duplicate(true)
		)

		if not direct_contract.is_empty():
			return direct_contract

	var identity_raw: Variant = get_meta(
		"title_card_identity_contract",
		{}
	)

	if typeof(
		identity_raw
	) != TYPE_DICTIONARY:
		return {}

	var identity_contract: Dictionary = (
		identity_raw as Dictionary
	)
	var nested_raw: Variant = (
		identity_contract.get(
			"continue_contract",
			{}
		)
	)

	if typeof(
		nested_raw
	) != TYPE_DICTIONARY:
		return {}

	return (
		(nested_raw as Dictionary)
		.duplicate(true)
	)


func _title_card_continue_available() -> bool:
	var continue_contract: Dictionary = (
		_title_card_continue_contract()
	)
	var checkpoint_path: String = str(
		continue_contract.get(
			"checkpoint_path",
			""
		)
	).strip_edges()
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			""
		)
	).strip_edges()

	return (
		bool(
			continue_contract.get(
				"available",
				false
			)
		)
		and checkpoint_path != ""
		and FileAccess.file_exists(checkpoint_path)
		and signature != ""
	)
func _title_card_checkpoint_resume_observable_truth_is_hot(
	signature: String
) -> bool:
	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return false

	var prepared_signature: String = str(
		get_meta(
			"title_card_checkpoint_transaction_ready_signature",
			""
		)
	).strip_edges()

	return (
		bool(
			get_meta(
				"title_card_checkpoint_transaction_ready",
				false
			)
		)
		and prepared_signature == clean_signature
		and bool(
			get_meta(
				"title_card_checkpoint_transaction_resident_ready",
				false
			)
		)
		and bool(
			get_meta(
				"title_card_checkpoint_transaction_progressive_observable_ready",
				false
			)
		)
	)
func _seal_title_card_checkpoint_resume_from_observable_truth_if_hot(
	signature: String
) -> bool:
	var clean_signature: String = str(
		signature
	).strip_edges()

	if not _title_card_checkpoint_resume_observable_truth_is_hot(
		clean_signature
	):
		return false

	var resume_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		get_meta(
			"title_card_checkpoint_resume_lens_prewarm_contract",
			{}
		)
	)
	var sealed_at_ms: int = int(
		Time.get_ticks_msec()
	)

	resume_contract [
		"presentation_contract_complete"
	] = true
	resume_contract [
		"presentation_contract_completed_from_observable_truth"
	] = true
	resume_contract [
		"presentation_contract_completed_at_ms"
	] = sealed_at_ms

	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_contract",
		resume_contract.duplicate(false)
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_active",
		false
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_complete",
		true
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_completed_at_ms",
		sealed_at_ms
	)
	set_meta(
		"title_card_checkpoint_resume_lens_prewarm_signature",
		clean_signature
	)
	set_meta(
		"title_card_checkpoint_resume_sealed_from_observable_truth",
		true
	)

	return true


func _title_card_continue_ready_for_atomic_reveal() -> bool:
	if not _title_card_continue_available():
		return false

	var continue_contract: Dictionary = (
		_title_card_continue_contract()
	)
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			""
		)
	).strip_edges()
	var core_observable_truth_hot: bool = (
		_title_card_checkpoint_resume_observable_truth_is_hot(
			signature
		)
	)

	set_meta(
		"title_card_continue_core_observable_truth_hot",
		core_observable_truth_hot
	)
	set_meta(
		"title_card_continue_full_presentation_required_before_reveal",
		false
	)
	set_meta(
		"title_card_continue_asset_deck_required_before_reveal",
		false
	)
	set_meta(
		"title_card_continue_all_tabs_required_before_reveal",
		false
	)

	return core_observable_truth_hot
func _service_pending_title_card_continue_until_hot(
	continue_contract: Dictionary,
	signature: String
) -> void:
	if not bool(
		get_meta(
			"title_card_continue_pending_until_hot",
			false
		)
	):
		return

	var clean_signature: String = str(
		signature
	).strip_edges()

	if clean_signature == "":
		return

	if str(
		get_meta(
			"title_card_continue_pending_signature",
			""
		)
	).strip_edges() != clean_signature:
		return

	if _title_card_continue_ready_for_atomic_reveal():
		call_deferred(
			"_continue_title_card_current_life"
		)
		return

	if not bool(
		get_meta(
			"title_card_checkpoint_transaction_prepare_active",
			false
		)
	):
		_queue_title_card_checkpoint_resume_lens_prewarm(
			continue_contract
		)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_pending_title_card_continue_until_hot",
			continue_contract,
			clean_signature
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_service_pending_title_card_continue_until_hot"
		).bind(
			continue_contract,
			clean_signature
		),
		CONNECT_ONE_SHOT
	)
func _begin_title_card_checkpoint_live_restoration_lens(
	residency_signature: String
) -> bool:
	var signature: String = str(
		residency_signature
	).strip_edges()

	if signature == "":
		return false

	var root:= get_node_or_null(
		"UIContainer"
	) as Control

	if root == null or not is_instance_valid(root):
		return false

	var now_ms: int = int(
		Time.get_ticks_msec()
	)




	set_meta(
		"title_card_continue_live_restoration_requested",
		true
	)
	set_meta(
		"checkpoint_reality_handoff_live_rebind_requested",
		true
	)
	set_meta(
		"title_card_continue_progressive_surface_visible",
		false
	)
	set_meta(
		"title_card_continue_progressive_publication_active",
		true
	)
	set_meta(
		"title_card_continue_residency_signature",
		signature
	)
	set_meta(
		"title_card_continue_cover_held_until_atomic_shell",
		true
	)
	set_meta(
		"title_card_continue_cover_release_owned_by_present_commit",
		true
	)
	set_meta(
		"title_card_continue_fake_restoring_cover_forbidden",
		true
	)
	set_meta(
		"title_card_continue_live_restoration_started_at_ms",
		now_ms
	)
	set_meta(
		"title_card_continue_runtime_authority_on_click",
		false
	)
	set_meta(
		"title_card_continue_life_root_reveal_before_reality_commit",
		false
	)
	set_meta(
		"title_card_continue_title_surface_remains_coherent_until_commit",
		true
	)
	set_meta(
		"title_card_continue_title_surface_remains_interactive_until_commit",
		true
	)
	set_meta(
		"title_card_continue_input_blocked_while_target_prepares",
		false
	)



	startup_intro_accepting_input = true

	root.process_mode = Node.PROCESS_MODE_INHERIT

	EraLog.truth(
		"ERALIFE_CHECKPOINT_LIVE_RESTORATION_DOOR_TRUTH"
		+ "|signature=" + signature
		+ "|observation_intent_latched=true"
		+ "|title_surface_remains_coherent_until_commit=true"
		+ "|title_surface_remains_interactive_until_commit=true"
		+ "|stale_life_root_revealed=false"
		+ "|simulation_work_on_click=false"
		+ "|binary_decode_on_click=false"
		+ "|progressive_publication=true"
		+ "|input_blocked_while_target_prepares=false"
		+ "|at_ms=" + str(now_ms)
	)

	return true
func _continue_title_card_current_life() -> void:
	var continue_contract: Dictionary = (
		_title_card_continue_contract()
	)
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			""
		)
	).strip_edges()

	if not _title_card_continue_available():
		set_meta(
			"title_card_continue_rejected_missing_contract",
			true
		)
		set_meta(
			"title_card_continue_rejected_signature",
			signature
		)
		set_meta(
			"title_card_continue_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	var requested_at_ms: int = int(
		get_meta(
			"title_card_continue_requested_at_ms",
			0
		)
	)

	if requested_at_ms <= 0:
		requested_at_ms = int(
			Time.get_ticks_msec()
		)

		set_meta(
			"title_card_continue_requested_at_ms",
			requested_at_ms
		)

	set_meta(
		"title_card_continue_requested",
		true
	)
	set_meta(
		"title_card_continue_contract_used",
		continue_contract.duplicate(false)
	)
	set_meta(
		"title_card_continue_residency_signature",
		signature
	)
	set_meta(
		"title_card_continue_progressive_publication_requested",
		true
	)
	set_meta(
		"title_card_continue_present_work_on_input_frame",
		false
	)
	set_meta(
		"title_card_continue_blank_frame_forbidden",
		true
	)
	set_meta(
		"title_card_continue_engine_intent_on_input_frame",
		false
	)
	set_meta(
		"title_card_continue_residency_service_on_input_frame",
		false
	)

	if not bool(
		get_meta(
			"title_card_continue_live_restoration_requested",
			false
		)
	):
		if not _begin_title_card_checkpoint_live_restoration_lens(
			signature
		):
			_finish_failed_life_load(
				"The resident Life-shell container is missing."
			)
			return

	if not _title_card_continue_ready_for_atomic_reveal():
		set_meta(
			"title_card_continue_pending_until_hot",
			true
		)
		set_meta(
			"title_card_continue_pending_signature",
			signature
		)
		set_meta(
			"title_card_continue_pending_requested_at_ms",
			requested_at_ms
		)
		set_meta(
			"title_card_continue_input_latched",
			true
		)
		set_meta(
			"title_card_continue_fake_restoring_copy_used",
			false
		)
		set_meta(
			"title_card_continue_stale_life_root_revealed",
			false
		)



		if not bool(
			get_meta(
				"title_card_checkpoint_transaction_prepare_active",
				false
			)
		):
			call_deferred(
				"_queue_title_card_checkpoint_resume_lens_prewarm",
				continue_contract.duplicate(false)
			)

		call_deferred(
			"_service_pending_title_card_continue_until_hot",
			continue_contract.duplicate(false),
			signature
		)

		EraLog.truth(
			"ERALIFE_CHECKPOINT_CONTINUE_PENDING_TRUTH"
			+ "|signature=" + signature
			+ "|input_latched=true"
			+ "|target_reality_preparing_detached=true"
			+ "|current_surface_remains_coherent=true"
			+ "|fake_restoring_screen=false"
			+ "|stale_life_root_revealed=false"
			+ "|transition_runtime=false"
			+ "|engine_intent_on_c=false"
			+ "|residency_service_on_c=false"
			+ "|binary_decode_on_c=false"
			+ "|shell_build_on_c=false"
			+ "|at_ms=" + str(
				Time.get_ticks_msec()
			)
		)
		return

	if bool(
		get_meta(
			"title_card_continue_handoff_commit_queued",
			false
		)
	):
		return

	remove_meta(
		"title_card_continue_pending_until_hot"
	)
	remove_meta(
		"title_card_continue_pending_signature"
	)

	set_meta(
		"title_card_continue_handoff_commit_queued",
		true
	)
	set_meta(
		"title_card_continue_handoff_commit_queued_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	call_deferred(
		"_commit_prepared_title_card_checkpoint_reality_handoff",
		continue_contract.duplicate(false)
	)

	EraLog.truth(
		"ERALIFE_CHECKPOINT_CONTINUE_INTENT_TRUTH"
		+ "|residency_signature=" + signature
		+ "|progressive_observable_core_hot=true"
		+ "|projection_enrichment_required=false"
		+ "|handoff_commit_queued=true"
		+ "|attach_on_c=false"
		+ "|present_on_c=false"
		+ "|transition_runtime=false"
		+ "|engine_intent_on_c=false"
		+ "|residency_service_on_c=false"
		+ "|binary_decode_on_c=false"
		+ "|shell_build_on_c=false"
		+ "|at_ms=" + str(requested_at_ms)
	)
func _commit_prepared_title_card_checkpoint_reality_handoff(
	continue_contract: Dictionary
) -> void:
	set_meta(
		"title_card_continue_handoff_commit_queued",
		false
	)

	if continue_contract.is_empty():
		return

	var checkpoint_path: String = str(
		continue_contract.get(
			"checkpoint_path",
			""
		)
	).strip_edges()
	var signature: String = str(
		continue_contract.get(
			"residency_signature",
			""
		)
	).strip_edges()

	if (
		checkpoint_path == ""
		or signature == ""
		or not FileAccess.file_exists(
			checkpoint_path
		)
	):
		return

	if not _title_card_checkpoint_resume_observable_truth_is_hot(
		signature
	):
		_queue_title_card_checkpoint_resume_lens_prewarm(
			continue_contract
		)
		return

	var resume_contract: Dictionary = (
		MainSceneHelpers._checkpoint_resume_contract_from_load_options({
			"continue_contract": continue_contract
		})
	)
	var live_load_options: Dictionary = {
		"source": "title_card_continue_current_life",
		"entry_surface": "title_card_continue",
		"saved_life_label": str(
			continue_contract.get(
				"label",
				"Saved Life"
			)
		),
		"continue_contract": (
			continue_contract.duplicate(false)
		),
		"checkpoint_resume_contract": (
			resume_contract.duplicate(false)
		),
		"residency_signature": signature,
		"checkpoint_reservation_declared": true,
		"resident_reattach_preferred": true,
		"resident_runtime_rebuild_forbidden": true,
		"transactional_reality_switch": true,
		"preserve_active_reality_until_commit": true,
		"attach_on_input_frame": false,
		"previous_reality_signature": str(
			reality_residency_attached_signature
		).strip_edges(),
		"previous_reality_shell_visible": false,
		"binary_decode_is_not_first_frame_authority": true
	}

	_load_life_from_slot_deferred(
		checkpoint_path,
		live_load_options
	)
func _begin_attached_checkpoint_reality_handoff(
	resume_contract: Dictionary,
	attach_report: Dictionary,
	load_options: Dictionary,
	previous_signature: String,
	previous_shell_visible: bool
) -> bool:
	if (
		gs == null
		or gs.player == null
		or resume_contract.is_empty()
	):
		return false

	var signature: String = str(
		attach_report.get(
			"signature",
			load_options.get(
				"residency_signature",
				""
			)
		)
	).strip_edges()
	var first_frame_raw: Variant = resume_contract.get(
		"first_frame_ui_snapshot",
		{}
	)
	var first_frame: Dictionary = (
		first_frame_raw as Dictionary
		if typeof(first_frame_raw) == TYPE_DICTIONARY
		else {}
	)

	if (
		signature == ""
		or first_frame.is_empty()
	):
		return false

	var entry_surface: String = str(
		load_options.get(
			"entry_surface",
			"saved_life_picker"
