func _animate_wizard_hud(delta: float) -> void:
	_ensure_wizard_hud()
	if wizard_hud_button == null:
		return

	wizard_hud_breathe_time += delta
	_update_wizard_hud()

	if not wizard_hud_button.visible:
		return

	var pulse: float = (sin(wizard_hud_breathe_time * 2.8) + 1.0) * 0.5
	wizard_hud_button.scale = Vector2.ONE * (1.0 + pulse * 0.035)

	if wizard_hud_panel != null and wizard_hud_panel.visible:
		wizard_hud_panel.modulate = Color(1.0, 0.96 + pulse * 0.04, 1.0, 1.0)
func _player_has_visible_belongings() -> bool:
	if (
		gs == null
		or gs.player == null
		or typeof(gs.scenario_state) != TYPE_DICTIONARY
	):
		return false

	var snapshot_raw: Variant = gs.scenario_state.get(
		"runtime_hud_visibility_snapshot",
		{}
	)
	if typeof(snapshot_raw) != TYPE_DICTIONARY:
		return false

	var snapshot: Dictionary = snapshot_raw as Dictionary
	var snapshot_actor_id: int = int(
		snapshot.get(
			"controlled_actor_id",
			snapshot.get(
				"player_id",
				snapshot.get(
					"actor_id",
					-1
				)
			)
		)
	)
	if snapshot_actor_id != int(gs.player.id):
		return false

	return bool(
		snapshot.get(
			"belongings_button_visible",
			snapshot.get(
				"belongings_available",
				false
			)
		)
	)
func _sync_controlled_actor_assets_into_belongings(actor: Person, reason: String = "controlled_actor_asset_projection") -> int:
	if actor == null:
		return 0
	if gs == null or gs.belongings_engine == null:
		return 0

	var actor_id: int = int(actor.id)
	if actor_id <= 0:
		return 0

	var projected_count: int = 0

	projected_count += _ensure_controlled_actor_baseline_property(actor, reason)

	if gs.property_engine != null and typeof(gs.property_engine.properties) == TYPE_DICTIONARY:
		var property_bucket: Array = MainSceneHelpers._safe_array(gs.property_engine.properties.get(actor_id, []))
		for raw_property in property_bucket:
			if typeof(raw_property) != TYPE_DICTIONARY:
				continue

			var property_item: Dictionary = (raw_property as Dictionary).duplicate(true)
			var property_id: int = int(property_item.get("id", -1))
			if property_id <= 0:
				continue
			if MainSceneLogic._belongings_projection_has_asset(gs, actor, "Real Estate", property_id):
				continue

			property_item ["asset_kind"] = "property"
			property_item ["category"] = "Real Estate"
			property_item ["owner_id"] = actor_id
			property_item ["controlled_actor_id"] = actor_id
			gs.belongings_engine.add_item(actor, property_item, "Real Estate", true)
			projected_count += 1

	if gs.vehicle_engine != null and typeof(gs.vehicle_engine.vehicles) == TYPE_DICTIONARY:
		var vehicle_bucket: Array = MainSceneHelpers._safe_array(gs.vehicle_engine.vehicles.get(actor_id, []))
		for raw_vehicle in vehicle_bucket:
			if typeof(raw_vehicle) != TYPE_DICTIONARY:
				continue

			var vehicle_item: Dictionary = (raw_vehicle as Dictionary).duplicate(true)
			var vehicle_id: int = int(vehicle_item.get("id", -1))
			if vehicle_id <= 0:
				continue
			if MainSceneLogic._belongings_projection_has_asset(gs, actor, "Vehicles", vehicle_id):
				continue

			vehicle_item ["asset_kind"] = "vehicle"
			vehicle_item ["category"] = "Vehicles"
			vehicle_item ["owner_id"] = actor_id
			vehicle_item ["controlled_actor_id"] = actor_id
			gs.belongings_engine.add_item(actor, vehicle_item, "Vehicles", true)
			projected_count += 1

	if projected_count > 0:
		belongings_hud_content_dirty = true
		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}
		gs.scenario_state ["belongings_inventory_dirty_actor_id"] = actor_id
		gs.scenario_state ["belongings_inventory_dirty_reason"] = reason
		gs.scenario_state ["belongings_inventory_dirty_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["belongings_asset_projection_count"] = projected_count

	return projected_count
func _ensure_controlled_actor_baseline_property(actor: Person, reason: String = "baseline_property_projection") -> int:
	if actor == null or gs == null or gs.property_engine == null or gs.belongings_engine == null:
		return 0

	var actor_id: int = int(actor.id)
	if actor_id <= 0:
		return 0

	if typeof(gs.property_engine.properties) != TYPE_DICTIONARY:
		gs.property_engine.properties = {}

	var existing_properties: Array = MainSceneHelpers._safe_array(gs.property_engine.properties.get(actor_id, []))
	if not existing_properties.is_empty():
		return 0

	var template: Dictionary = _baseline_property_template_for_actor(actor)
	if template.is_empty():
		return 0

	var context: Dictionary = MainSceneLogic._baseline_property_context_for_actor(gs, actor, reason)
	var prop: Dictionary = {}

	if gs.property_engine.has_method("_build_runtime_property_from_template"):
		prop = gs.property_engine.call("_build_runtime_property_from_template", template, actor, context)

	if prop.is_empty():
		if gs.property_engine.has_method("buy_property"):
			var buy_report: Dictionary = gs.property_engine.buy_property(actor, template, 0, context)
			if bool(buy_report.get("success", false)):
				return 1
		return 0

	prop ["asset_kind"] = "property"
	prop ["category"] = "Real Estate"
	prop ["source_engine"] = "property_engine"
	prop ["acquisition_mode"] = "baseline_world_housing"
	prop ["baseline_world_housing"] = true
	prop ["owner_id"] = actor_id
	prop ["controlled_actor_id"] = actor_id

	if not prop.has("price"):
		prop ["price"] = int(prop.get("value", prop.get("worth", 0)))
	if not prop.has("value"):
		prop ["value"] = int(prop.get("price", prop.get("worth", 0)))
	if not prop.has("worth"):
		prop ["worth"] = int(prop.get("value", prop.get("price", 0)))

	if gs.property_engine.has_method("_register_property_for_owner"):
		gs.property_engine.call("_register_property_for_owner", actor, prop, true)
	else:
		if not gs.property_engine.properties.has(actor_id):
			gs.property_engine.properties [actor_id] = []
		gs.property_engine.properties [actor_id].append(prop)
		gs.belongings_engine.add_item(actor, prop, "Real Estate", true)

	return 1


func _baseline_property_template_for_actor(actor: Person) -> Dictionary:
	if actor == null or gs == null:
		return {}

	var context: Dictionary = MainSceneLogic._baseline_property_context_for_actor(gs, actor, "template_lookup")
	var desired_tags: Array = MainSceneHelpers._safe_array(context.get("desired_tags", []))

	if gs.property_engine != null and gs.property_engine.has_method("get_buyable_property_templates_for_person"):
		var rows: Array = gs.property_engine.get_buyable_property_templates_for_person(actor, desired_tags, context)
		if not rows.is_empty() and typeof(rows [0]) == TYPE_DICTIONARY:
			return (rows [0] as Dictionary).duplicate(true)

	if gs.era_data_loader != null and gs.era_data_loader.has_method("get_best_property_template_for_context"):
		var era_template: Dictionary = gs.era_data_loader.get_best_property_template_for_context(MainSceneLogic._baseline_property_era_name(gs), context)
		if not era_template.is_empty():
			return era_template.duplicate(true)

	if gs.property_engine != null and gs.property_engine.has_method("_legacy_property_from_size"):
		return gs.property_engine.call("_legacy_property_from_size", MainSceneLogic._baseline_property_legacy_size_for_actor(actor))

	return {}


func _active_property_surface_for_layer_guard() -> Control:
	if property_makeover_panel != null and is_instance_valid(property_makeover_panel) and property_makeover_panel.visible:
		return property_makeover_panel

	if property_viewer_panel != null and is_instance_valid(property_viewer_panel) and property_viewer_panel.visible:
		return property_viewer_panel

	return null


func _property_surface_layer_guard_active() -> bool:
	return _active_property_surface_for_layer_guard() != null


func _restore_property_surface_layering_after_action_result_popup(reason: String = "property_surface_layer_guard") -> void:
	var active_surface: Control = _active_property_surface_for_layer_guard()
	if active_surface == null:
		return

	active_surface.z_as_relative = false
	active_surface.z_index = max(int(active_surface.z_index), 250)
	active_surface.mouse_filter = Control.MOUSE_FILTER_STOP

	var active_parent: Node = active_surface.get_parent()

	if belongings_hud_panel != null and is_instance_valid(belongings_hud_panel) and belongings_hud_panel.visible:
		belongings_hud_panel.z_as_relative = false
		belongings_hud_panel.z_index = max(0, int(active_surface.z_index) - 6)
		belongings_hud_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if active_parent != null and belongings_hud_panel.get_parent() == active_parent:
			var active_index: int = active_surface.get_index()
			active_parent.move_child(belongings_hud_panel, max(0, active_index - 1))

	if belongings_hud_button != null and is_instance_valid(belongings_hud_button):
		belongings_hud_button.z_as_relative = false
		belongings_hud_button.z_index = max(0, int(active_surface.z_index) - 7)
		belongings_hud_button.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if active_parent != null and belongings_hud_button.get_parent() == active_parent:
			var active_button_index: int = active_surface.get_index()
			active_parent.move_child(belongings_hud_button, max(0, active_button_index - 1))

	if active_parent != null:
		active_parent.move_child(active_surface, active_parent.get_child_count() - 1)

	set_meta("property_surface_layer_guard_restored", true)
	set_meta("property_surface_layer_guard_reason", reason)
	set_meta("property_surface_layer_guard_at_ms", int(Time.get_ticks_msec()))
func _refresh_runtime_huds_after_action_result_popup_close(reason: String = "action_result_popup_closed") -> void:
	if gs == null or gs.player == null:
		return

	var clean_reason: String = str(reason).strip_edges().to_lower()

	set_meta("action_result_popup_close_hud_restore_existing_nodes_only", true)
	set_meta("action_result_popup_close_direct_hud_update_forbidden", true)
	set_meta("action_result_popup_close_hud_restore_reason", reason)
	set_meta("action_result_popup_close_hud_restore_at_ms", int(Time.get_ticks_msec()))

	if clean_reason.find("boxing_hud_reveal") >= 0 or clean_reason.find("boxing_entry_popup_complete") >= 0:
		call_deferred("_refresh_boxing_hud_after_action_result_popup_close", reason, int(gs.player.id))
		return

	belongings_hud_content_dirty = true

	if _property_surface_layer_guard_active():
		set_meta("action_result_popup_close_property_surface_layer_guard_blocked_hud_climb", true)
		set_meta("action_result_popup_close_property_surface_layer_guard_reason", reason)
		_restore_property_surface_layering_after_action_result_popup("%s_property_surface_active" % reason)
		call_deferred("_restore_property_surface_layering_after_action_result_popup", "%s_property_surface_active_deferred" % reason)

		if belongings_hud_open:
			call_deferred("_defer_belongings_hud_content_refresh_after_open", 0)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["action_result_popup_close_hud_restore_existing_nodes_only"] = true
			gs.scenario_state ["action_result_popup_close_direct_hud_update_forbidden"] = true
			gs.scenario_state ["action_result_popup_close_property_surface_layer_guard_blocked_hud_climb"] = true
		return

	_restore_runtime_hud_button_shells_after_surface_change("%s_existing_nodes_only" % reason)
	_sync_runtime_floating_hud_layering_for_spawn_shell("%s_existing_nodes_only" % reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["action_result_popup_close_hud_restore_existing_nodes_only"] = true
		gs.scenario_state ["action_result_popup_close_direct_hud_update_forbidden"] = true
func _belongings_hud_core_color() -> Color:
	if MainSceneLogic._player_has_infinity_gauntlet_artifact(gs):
		var gauntlet_shimmer: float = clamp(
			0.56
			+ (sin(_current_ui_material_phase() * 3.1) * 0.24)
			+ (sin(_current_ui_material_phase() * 7.2 + 0.72) * 0.1),
			0.0,
			1.0
		)
		return Color(1.0, 0.8, 0.3, 1.0).lerp(Color(1.0, 0.96, 0.76, 1.0), 0.26 * gauntlet_shimmer)

	if _player_has_all_infinity_stones_artifact_set():
		var cosmic_shift: float = clamp(
			0.52
			+ (sin(_current_ui_material_phase() * 1.85) * 0.22)
			+ (sin(_current_ui_material_phase() * 4.2 + 0.9) * 0.08),
			0.0,
			1.0
		)
		return Color(0.82, 0.7, 1.0, 1.0).lerp(Color(0.6, 0.94, 1.0, 1.0), cosmic_shift)

	if MainSceneLogic._player_has_red_bonnet_artifact(gs):
		var bonnet_shift: float = clamp(
			0.5
			+ (sin(_current_ui_material_phase() * 2.15) * 0.2)
			+ (sin(_current_ui_material_phase() * 5.4 + 0.42) * 0.08),
			0.0,
			1.0
		)
		return Color(1.0, 0.3, 0.28, 1.0).lerp(Color(1.0, 0.56, 0.48, 1.0), 0.3 * bonnet_shift)

	return Color(1.0, 0.82, 0.36, 1.0)
func _player_has_all_infinity_stones_artifact_set() -> bool:
	return bool(
		artifact_observability_contract.get(
			"owns_all_stones",
			false
		)
	)

func _refresh_world_feed_reality_capsule_status() -> void:
