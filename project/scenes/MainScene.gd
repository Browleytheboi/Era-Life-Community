func _god_mode_entry_default_accent_color() -> Color:
	var fallback_accent: Color = Color(0.24, 0.86, 1.0, 1.0)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		if god_mode_start_panel.has_meta("god_mode_entry_default_accent_color"):
			var panel_raw: Variant = god_mode_start_panel.get_meta("god_mode_entry_default_accent_color")
			if typeof(panel_raw) == TYPE_COLOR:
				var panel_accent: Color = panel_raw
				return Color(panel_accent.r, panel_accent.g, panel_accent.b, 1.0)

	if has_meta("god_mode_entry_default_accent_color"):
		var stored_raw: Variant = get_meta("god_mode_entry_default_accent_color")
		if typeof(stored_raw) == TYPE_COLOR:
			var stored_accent: Color = stored_raw
			return Color(stored_accent.r, stored_accent.g, stored_accent.b, 1.0)

	if choose_adventure_entry_right_card != null and is_instance_valid(choose_adventure_entry_right_card):
		if choose_adventure_entry_right_card.has_meta("accent"):
			var card_raw: Variant = choose_adventure_entry_right_card.get_meta("accent")
			if typeof(card_raw) == TYPE_COLOR:
				var card_accent: Color = card_raw
				return Color(card_accent.r, card_accent.g, card_accent.b, 1.0)

	return fallback_accent

func _activate_god_mode_entry_default_palette(reason: String = "choose_ereality_entry") -> void:
	var entry_accent: Color = _god_mode_entry_default_accent_color()
	set_meta("god_mode_entry_default_palette_active", true)
	set_meta("god_mode_entry_default_palette_pending_confirmation", true)
	set_meta("god_mode_entry_default_accent_color", entry_accent)
	set_meta("god_mode_entry_default_palette_reason", reason)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.set_meta("god_mode_entry_default_palette_active", true)
		god_mode_start_panel.set_meta("god_mode_entry_default_palette_pending_confirmation", true)
		god_mode_start_panel.set_meta("god_mode_entry_default_accent_color", entry_accent)
		god_mode_start_panel.set_meta("god_mode_entry_default_palette_reason", reason)
		_refresh_god_mode_palette_from_current_state(false)
		_restyle_live_god_mode_field_controls()

func _god_mode_entry_default_palette_active() -> bool:
	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		if god_mode_start_panel.has_meta("god_mode_entry_default_palette_active"):
			return bool(god_mode_start_panel.get_meta("god_mode_entry_default_palette_active", false))

	return bool(get_meta("god_mode_entry_default_palette_active", false))
func _god_mode_entry_default_palette_user_control_has_focus() -> bool:
	var viewport:= get_viewport()
	if viewport == null:
		return false

	var focus_owner:= viewport.gui_get_focus_owner()
	if focus_owner == null:
		return false

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return false

	return focus_owner == god_mode_start_panel or god_mode_start_panel.is_ancestor_of(focus_owner)


func _god_mode_entry_default_palette_should_clear_for_reason(reason: String) -> bool:
	var clean_reason: String = str(reason).strip_edges().to_lower()

	if clean_reason not in ["reality_mode_changed", "feature_override_changed", "era_changed", "birth_year_text_changed"]:
		return false

	if not _god_mode_entry_default_palette_active():
		return false

	if bool(get_meta("god_mode_entry_transition_active", false)):
		return false

	if bool(get_meta("god_mode_start_panel_prewarming", false)):
		return false

	if bool(get_meta("god_mode_entry_default_palette_pending_confirmation", false)):
		return _god_mode_entry_default_palette_user_control_has_focus()

	return true


