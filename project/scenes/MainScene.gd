		)
	})
func _ensure_career_hub_panel() -> void:
	if (
		career_hub_panel == null
		or not is_instance_valid(
			career_hub_panel
		)
	):
		career_hub_panel = CareerHubPanel.new()
		career_hub_panel.name = "CareerHubPanel"
		career_hub_panel.visible = false
		career_hub_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		career_hub_panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)

		career_hub_panel.request_intent.connect(
			_on_career_hub_intent_requested
		)
		career_hub_panel.request_close.connect(
			_on_career_hub_close_requested
		)
		career_hub_panel.request_person_profile.connect(
			_on_career_hub_person_profile_requested
		)

		add_child(
			career_hub_panel
		)

		career_hub_panel.set_meta(
			"persistent_child_surface_shell_hot",
			true
		)
		career_hub_panel.set_meta(
			"ui_is_renderer_only",
			true
		)
		career_hub_panel.set_meta(
			"career_hub_contract_owned",
			true
		)

	if (
		gs != null
		and gs.career_hub_contract_engine != null
		and gs.career_hub_contract_engine.has_signal(
			"resident_career_hub_contract_published"
		)
	):
		var publication_callback: Callable = Callable(
			self,
			"_on_resident_career_hub_contract_published"
		)

		if not gs.career_hub_contract_engine.is_connected(
			"resident_career_hub_contract_published",
			publication_callback
		):
			gs.career_hub_contract_engine.connect(
				"resident_career_hub_contract_published",
				publication_callback
			)

	set_meta(
		"career_hub_resident_publication_signal_connected",
		true
	)
