func _ensure_property_makeover_panel() -> void:
	if property_makeover_panel != null and is_instance_valid(property_makeover_panel):
		property_makeover_panel.bind_host(self, gs)
		return

	property_makeover_panel = PropertyMakeoverPanel.new()
	property_makeover_panel.name = "PropertyMakeoverPanel"
	property_makeover_panel.visible = false
	property_makeover_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	property_makeover_panel.z_index = 250
	property_makeover_panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	property_makeover_panel.bind_host(self, gs)

	property_makeover_panel.close_requested.connect(_hide_property_makeover_panel)
	property_makeover_panel.makeover_action_requested.connect(_on_property_makeover_action_requested)

	add_child(property_makeover_panel)


func _suspend_property_viewer_for_makeover_surface(reason: String = "") -> bool:
	if property_viewer_panel == null or not is_instance_valid(property_viewer_panel):
		return false
	if not property_viewer_panel.visible:
		return false

	set_meta("property_viewer_suspended_for_makeover_surface", true)
	set_meta("property_viewer_suspended_for_makeover_reason", reason)
	set_meta("property_viewer_suspended_for_makeover_at_ms", int(Time.get_ticks_msec()))

	property_viewer_panel.visible = false
	property_viewer_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	property_viewer_panel.process_mode = Node.PROCESS_MODE_DISABLED
	property_viewer_panel.set_meta("interactive_surface_input_suspended", true)
	property_viewer_panel.set_meta("interactive_surface_suspended_by_makeover", reason)

	return true


func _restore_property_viewer_after_makeover_surface() -> bool:
	if gs == null:
		return false

	if not bool(
		get_meta(
			"property_viewer_suspended_for_makeover_surface",
			false
		)
	):
		return false

	remove_meta(
		"property_viewer_suspended_for_makeover_surface"
	)
	remove_meta(
		"property_viewer_suspended_for_makeover_reason"
	)

	if (
		property_viewer_panel == null
		or not is_instance_valid(property_viewer_panel)
	):
		return false

	if not property_viewer_open:
		return false

	var owner_id: int = -1
	var actor_id: int = -1
	var asset_id: int = -1

	if (
		property_makeover_panel != null
		and is_instance_valid(property_makeover_panel)
	):
		owner_id = int(
			property_makeover_panel.get_meta(
				"property_makeover_owner_id",
				-1
			)
		)
		actor_id = int(
			property_makeover_panel.get_meta(
				"property_makeover_actor_id",
				-1
			)
		)
		asset_id = int(
			property_makeover_panel.get_meta(
				"property_makeover_asset_id",
				-1
			)
		)

	var restore_owner: Person = null
	var restore_actor: Person = null

	if owner_id > 0:
		restore_owner = (
			gs.get_or_reactivate_npc_by_id(
				owner_id
			)
		)

	if actor_id > 0:
		restore_actor = (
			gs.get_or_reactivate_npc_by_id(
				actor_id
			)
		)

	if restore_actor == null:
		restore_actor = gs.player

	if restore_owner == null:
		restore_owner = restore_actor

	if restore_actor == null:
		restore_actor = restore_owner

	if (
		restore_owner != null
		and restore_actor != null
		and asset_id > 0
	):
		var refreshed_contract: Dictionary = (
			_property_viewer_request_contract(
				restore_owner,
				restore_actor,
				asset_id,
				"interior",
				"You return to the property."
			)
		)

		property_viewer_panel.set_meta(
			"property_viewer_owner_id",
			int(restore_owner.id)
		)
		property_viewer_panel.set_meta(
			"property_viewer_actor_id",
			int(restore_actor.id)
		)
		property_viewer_panel.set_meta(
			"property_viewer_asset_id",
			asset_id
		)

		property_viewer_panel.render_surface_contract(
			refreshed_contract
		)

	property_viewer_panel.visible = true
	property_viewer_panel.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	property_viewer_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	property_viewer_panel.z_index = 240
	property_viewer_panel.set_meta(
		"interactive_surface_input_suspended",
		false
	)
	property_viewer_panel.set_meta(
		"interactive_surface_restored_after_makeover",
		true
	)
	property_viewer_panel.set_meta(
		"interactive_surface_restored_after_makeover_at_ms",
		int(Time.get_ticks_msec())
	)

	var viewer_parent:= property_viewer_panel.get_parent()

	if viewer_parent != null:
		viewer_parent.move_child(
			property_viewer_panel,
			viewer_parent.get_child_count() - 1
		)

	_claim_interactive_surface_authority(
		property_viewer_panel,
		"property_viewer_panel",
		"restore_property_viewer_after_makeover_surface",
		true,
		true
	)

	return true


func _hide_property_makeover_panel() -> void:
	property_makeover_open = false

	if property_makeover_panel != null and is_instance_valid(property_makeover_panel):
		property_makeover_panel.visible = false
		property_makeover_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		property_makeover_panel.process_mode = Node.PROCESS_MODE_INHERIT
		property_makeover_panel.set_meta("interactive_surface_input_suspended", true)
		property_makeover_panel.set_meta("interactive_surface_released", true)
		property_makeover_panel.set_meta("interactive_surface_released_at_ms", int(Time.get_ticks_msec()))

	if _restore_property_viewer_after_makeover_surface():
		return

	_restore_standard_tab_popup_after_child_surface()
func _prepaint_property_makeover_surface_deck_for_actor(
	target_actor: Person,
	contracts_by_id: Dictionary
) -> bool:
	if (
		gs == null
		or target_actor == null
		or int(target_actor.id) <= 0
	):
		return false

	var actor_id: int = int(
		target_actor.id
	)
	var required_count: int = 0
	var prepared_count: int = 0

	for raw_property_key in contracts_by_id.keys():
		var property_id: int = int(
			raw_property_key
		)
		var contract: Dictionary = MainSceneHelpers._safe_dictionary(
			contracts_by_id.get(
				raw_property_key,
				{}
			)
		)

		if (
			property_id <= 0
			or contract.is_empty()
			or int(
				contract.get(
					"actor_id",
					actor_id
				)
			) != actor_id
			or int(
				contract.get(
					"property_id",
					-1
				)
			) != property_id
		):
			continue

		required_count += 1

		var panel_key: String = (
			MainSceneHelpers._property_makeover_surface_panel_key(
				actor_id,
				property_id
			)
		)
		var panel_raw: Variant = (
			property_makeover_surface_panel_by_key.get(
				panel_key,
				null
			)
		)
		var panel: PropertyMakeoverPanel = null

		if (
			typeof(panel_raw) == TYPE_OBJECT
			and is_instance_valid(panel_raw)
			and panel_raw is PropertyMakeoverPanel
		):
			panel = panel_raw as PropertyMakeoverPanel

		if panel == null:
			panel = PropertyMakeoverPanel.new()
			panel.name = (
				"PropertyMakeoverPanel_%d_%d"
				% [
					actor_id,
					property_id
				]
			)
			panel.visible = false
			panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
			panel.process_mode = (
				Node.PROCESS_MODE_INHERIT
			)
			panel.z_as_relative = false
			panel.z_index = 761
			panel.set_anchors_and_offsets_preset(
				Control.PRESET_FULL_RECT
			)
			panel.bind_host(
				self,
				gs
			)
			panel.close_requested.connect(
				_hide_property_makeover_panel
			)
			panel.makeover_action_requested.connect(
				_on_property_makeover_action_requested
			)
			add_child(
				panel
			)

			property_makeover_surface_panel_by_key [
				panel_key
			] = panel

		var contract_revision: String = (
			MainSceneHelpers._asset_surface_contract_revision_key(
				contract
			)
		)
		var painted_revision: String = str(
			panel.get_meta(
				"prepainted_surface_revision",
				""
			)
		)

		if (
			painted_revision != contract_revision
			or int(
				panel.get_meta(
					"prepainted_actor_id",
					-1
				)
			) != actor_id
			or int(
				panel.get_meta(
					"prepainted_property_id",
					-1
				)
			) != property_id
		):



			panel.open_for_property(
				target_actor,
				contract
			)

		panel.visible = false
		panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		panel.process_mode = (
			Node.PROCESS_MODE_INHERIT
		)
		panel.set_meta(
			"prepainted_actor_id",
			actor_id
		)
		panel.set_meta(
			"prepainted_property_id",
			property_id
		)
		panel.set_meta(
			"prepainted_surface_revision",
			contract_revision
		)
		panel.set_meta(
			"property_makeover_renderer_resident",
			true
		)
		panel.set_meta(
			"property_makeover_click_render_forbidden",
			true
		)

		prepared_count += 1

	var complete: bool = (
		required_count == prepared_count
	)

	set_meta(
		"property_makeover_surface_deck_actor_id",
		actor_id
	)
	set_meta(
		"property_makeover_surface_deck_required_count",
		required_count
	)
	set_meta(
		"property_makeover_surface_deck_prepared_count",
		prepared_count
	)
	set_meta(
		"property_makeover_surface_deck_hot",
		complete
	)
	set_meta(
		"property_makeover_surface_deck_build_on_click",
		false
	)

	return complete


func _property_makeover_surface_panel_for(
	actor_id: int,
	property_id: int
) -> PropertyMakeoverPanel:
	if (
		actor_id <= 0
		or property_id <= 0
	):
		return null

	var direct_key: String = MainSceneHelpers._property_makeover_surface_panel_key(
		actor_id,
		property_id
	)
	var panel_raw: Variant = (
		property_makeover_surface_panel_by_key.get(
			direct_key,
			null
		)
	)

	if (
		typeof(panel_raw) == TYPE_OBJECT
		and is_instance_valid(panel_raw)
		and panel_raw is PropertyMakeoverPanel
	):
		return panel_raw as PropertyMakeoverPanel

	for raw_key in property_makeover_surface_panel_by_key.keys():
		var candidate_raw: Variant = (
			property_makeover_surface_panel_by_key.get(
				raw_key,
				null
			)
		)

		if (
			typeof(candidate_raw) != TYPE_OBJECT
			or not is_instance_valid(candidate_raw)
			or not candidate_raw is PropertyMakeoverPanel
		):
			continue

		var candidate: PropertyMakeoverPanel = (
			candidate_raw as PropertyMakeoverPanel
		)
		var candidate_property_id: int = int(
			candidate.get_meta(
				"property_makeover_asset_id",
				candidate.get_meta(
					"property_id",
					-1
				)
			)
		)

		if candidate_property_id != property_id:
			continue

		var candidate_actor_id: int = int(
			candidate.get_meta(
				"property_makeover_actor_id",
				-1
			)
		)
		var candidate_owner_id: int = int(
			candidate.get_meta(
				"property_makeover_owner_id",
				-1
			)
		)

		if (
			candidate_actor_id == actor_id
			or candidate_owner_id == actor_id
			or candidate_actor_id <= 0
		):
			property_makeover_surface_panel_by_key [
				direct_key
			] = candidate

			candidate.set_meta(
				"property_makeover_resident_alias_actor_id",
				actor_id
			)
			candidate.set_meta(
				"property_makeover_resident_alias_property_id",
				property_id
			)
			candidate.set_meta(
				"property_makeover_resident_alias_build_performed",
				false
			)

			return candidate

	return null
