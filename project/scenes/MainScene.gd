func _mod_menu_contract_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}

	var queue: Array = [
		report.duplicate(true)
	]
	var inspected: int = 0
	var projection_fallback: Dictionary = {}
	var authoritative_surface: Dictionary = {}
	var preferred_keys: Array = [
		"route_report",
		"result",
		"engine_report",
		"target_report",
		"commit_report",
		"command_report",
		"payload",
		"crr_report",
		"transition",
		"runtime_report",
		"bundle_report",
		"result_payload",
		"source_report"
	]

	while (
		not queue.is_empty()
		and inspected < 96
	):
		var cursor: Dictionary = MainSceneHelpers._safe_dictionary(
			queue.pop_front()
		)
		inspected += 1

		var cursor_surface: Dictionary = (
			_reality_surface_contract_from_mod_route(
				cursor
			)
		)

		if not cursor_surface.is_empty():
			authoritative_surface = (
				cursor_surface.duplicate(true)
			)

		if cursor.has("mod_menu_contract"):
			var direct_contract: Dictionary = (
				MainSceneHelpers._safe_dictionary(
					cursor.get(
						"mod_menu_contract",
						{}
					)
				)
			)

			if not direct_contract.is_empty():
				var resolved_report: Dictionary = (
					cursor.duplicate(true)
				)

				resolved_report [
					"mod_menu_contract"
				] = direct_contract.duplicate(true)

				if not authoritative_surface.is_empty():
					resolved_report [
						"reality_surface_contract"
					] = authoritative_surface.duplicate(true)

					return resolved_report

				if projection_fallback.is_empty():
					projection_fallback = (
						resolved_report.duplicate(true)
					)

		if str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges() == "eralife.mod_menu_contract":
			var projection_report: Dictionary = {
				"success": bool(
					cursor.get(
						"success",
						true
					)
				),
				"type": "mod_menu_projection_resolved",
				"mod_menu_contract": (
					cursor.duplicate(true)
				)
			}

			if not authoritative_surface.is_empty():
				projection_report [
					"reality_surface_contract"
				] = authoritative_surface.duplicate(true)

				return projection_report

			if projection_fallback.is_empty():
				projection_fallback = (
					projection_report.duplicate(true)
				)

		for raw_key in preferred_keys:
			var nested_raw: Variant = cursor.get(
				str(raw_key),
				{}
			)

			if typeof(nested_raw) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			).duplicate(true)

			if not nested.is_empty():
				queue.append(nested)

		for raw_key in cursor.keys():
			if str(raw_key) in preferred_keys:
				continue

			var dynamic_raw: Variant = cursor.get(
				raw_key,
				{}
			)

			if typeof(dynamic_raw) != TYPE_DICTIONARY:
				continue

			var dynamic_nested: Dictionary = (
				dynamic_raw as Dictionary
			).duplicate(true)

			if not dynamic_nested.is_empty():
				queue.append(dynamic_nested)

	if not projection_fallback.is_empty():
		if not authoritative_surface.is_empty():
			projection_fallback [
				"reality_surface_contract"
			] = authoritative_surface.duplicate(true)

		return projection_fallback

	return {}


func _mod_menu_contract_is_renderable(
	contract: Dictionary,
	actor_id: int = -1
) -> bool:
	if contract.is_empty():
		return false

	if not bool(
		contract.get(
			"success",
			false
		)
	):
		return false

	if str(
		contract.get(
			"schema",
			""
		)
	).strip_edges() != "eralife.mod_menu_contract":
		return false

	if (
		actor_id > 0
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) != actor_id
	):
		return false

	if MainSceneHelpers._safe_array(
		contract.get(
			"section_tabs",
			[]
		)
	).is_empty():
		return false

	var section_surfaces_raw: Variant = (
		contract.get(
			"section_surfaces",
			{}
		)
	)

	return (
		typeof(
			section_surfaces_raw
		) == TYPE_DICTIONARY
		or contract.has(
			"section_rows"
		)
	)
func _capture_reality_residency_host() -> void:
	if reality_residency_host_game_state == null:
		reality_residency_host_game_state = gs

	if reality_residency_host_game_state == null:
		return

	var projection_engine = (
		reality_residency_host_game_state
		.reality_projection_contract_engine
	)

	if projection_engine == null:
		return

	var legacy_surface_callback: Callable = Callable(
		self,
		"_on_resident_surface_contract_ready"
	)

	var routed_surface_callback: Callable = Callable(
		self,
		"_route_resident_surface_contract_ready"
	)

	var relationship_section_callback: Callable = Callable(
		self,
		"_on_resident_relationship_section_contract_ready"
	)

	var projection_callback: Callable = Callable(
		self,
		"_on_resident_projection_ready"
	)

	var continuous_observation_callback: Callable = Callable(
		self,
		"_on_resident_continuous_observation_ready"
	)




	if projection_engine.is_connected(
		"resident_surface_contract_ready",
		legacy_surface_callback
	):
		projection_engine.disconnect(
			"resident_surface_contract_ready",
			legacy_surface_callback
		)

	if not projection_engine.is_connected(
		"resident_surface_contract_ready",
		routed_surface_callback
	):
		projection_engine.connect(
			"resident_surface_contract_ready",
			routed_surface_callback
		)

	if (
		projection_engine.has_signal(
			"resident_relationship_section_contract_ready"
		)
		and not projection_engine.is_connected(
			"resident_relationship_section_contract_ready",
			relationship_section_callback
		)
	):
		projection_engine.connect(
			"resident_relationship_section_contract_ready",
			relationship_section_callback
		)

	if not projection_engine.is_connected(
		"resident_projection_ready",
		projection_callback
	):
		projection_engine.connect(
			"resident_projection_ready",
			projection_callback
		)

	if (
		projection_engine.has_signal(
			"resident_continuous_observation_ready"
		)
		and not projection_engine.is_connected(
			"resident_continuous_observation_ready",
			continuous_observation_callback
		)
	):
		projection_engine.connect(
			"resident_continuous_observation_ready",
			continuous_observation_callback
		)

	set_meta(
		"resident_surface_projection_signal_connected",
		true
	)
	set_meta(
		"resident_relationship_section_signal_connected",
		true
	)
	set_meta(
		"resident_projection_signal_connected",
		true
	)
	set_meta(
		"resident_continuous_observation_signal_connected",
		true
	)
	set_meta(
		"resident_projection_signal_connection_is_renderer_only",
		true
	)
	set_meta(
		"resident_continuous_observation_signal_renderer_only",
		true
	)
	set_meta(
		"resident_projection_signal_main_scene_requests_engine_work",
		false
	)
	set_meta(
		"resident_continuous_observation_main_scene_requests_engine_work",
		false
	)
	set_meta(
		"resident_surface_signal_renders_existing_chassis_only",
		true
	)
	set_meta(
		"resident_surface_signal_builds_on_tab_press",
		false
	)
	set_meta(
		"resident_surface_signal_uses_presented_frame_barrier",
		true
	)
	set_meta(
		"resident_surface_signal_may_not_install_during_ready_fence",
		true
	)
func _on_resident_continuous_observation_ready(
	observation_key: String,
	packet: Dictionary
) -> void:
	var clean_key: String = str(
		observation_key
	).strip_edges()
	var schema: String = str(
		packet.get(
			"schema",
			""
		)
	).strip_edges().to_lower()
	var observation_channel: String = str(
		packet.get(
			"observation_channel",
			""
		)
	).strip_edges().to_lower()

	if (
		clean_key == ""
		or not bool(
			packet.get(
				"ui_is_renderer_only",
				false
			)
		)
	):
		return

	if (
		clean_key.begins_with(
			"artifact_shop:"
		)
		and schema == "eralife.artifact_shop_observation"
		and observation_channel == "artifact_shop"
	):
		_render_artifact_shop_observation_packet(
			packet
		)

		if (
			str(
				packet.get(
					"phase",
					""
				)
			).strip_edges().to_lower() == "complete"
			and bool(
				packet.get(
					"projection_complete",
					false
				)
			)
		):
			set_meta(
				"luxury_exchange_artifact_generation",
				int(
					packet.get(
						"generation",
						0
					)
				)
			)

		return

	if (
		clean_key.begins_with(
			"silk_road:"
		)
		and schema == "eralife.silk_road_market_observation"
		and observation_channel == "silk_road"
	):
		_render_silk_road_observation_packet(
			packet
		)
		return

	if (
		not clean_key.begins_with(
			"checkpoint_resume_life_shell:"
		)
		or schema != (
			"eralife.checkpoint_resume."
			+ "life_shell_observation"
		)
		or observation_channel
		!= "checkpoint_resume_life_shell"
	):
		return

	if (
		gs == null
		or gs.player == null
	):
		return

	var packet_actor_id: int = int(
		packet.get(
			"actor_id",
			-1
		)
	)

	if packet_actor_id != int(
		gs.player.id
	):
		return

	var packet_signature: String = str(
		packet.get(
			"signature",
			""
		)
	).strip_edges()

	if (
		reality_residency_attached_signature != ""
		and packet_signature != ""
		and packet_signature
		!= reality_residency_attached_signature
	):
		return



	checkpoint_resume_life_observation_pending_packet = (
		packet.duplicate(false)
	)

	if checkpoint_resume_life_observation_install_armed:
		return

	checkpoint_resume_life_observation_install_armed = true

	call_deferred(
		"_install_latest_checkpoint_resume_life_observation"
	)
func _luxury_exchange_route_result(
	report: Dictionary
) -> Dictionary:
	if report.is_empty():
		return {}







	var cursor: Dictionary = report
	var last_nonempty: Dictionary = report

	for _index in range(12):
		if cursor.is_empty():
			break

		last_nonempty = cursor

		var schema: String = str(
			cursor.get(
				"schema",
				""
			)
		).strip_edges().to_lower()
		var mode: String = str(
			cursor.get(
				"mode",
				""
			)
		).strip_edges().to_lower()




		var global_intent_wrapper: bool = (
			schema == "eralife.global_intent_commit_contract"
			or (
				mode.begins_with(
					"global_intent_"
				)
				and cursor.has(
					"route_report"
				)
			)
		)

		if global_intent_wrapper:
			var route_raw: Variant = cursor.get(
				"route_report",
				{}
			)

			if (
				typeof(route_raw) == TYPE_DICTIONARY
				and not (route_raw as Dictionary).is_empty()
			):
				cursor = route_raw as Dictionary
				continue

			var wrapper_result_raw: Variant = cursor.get(
				"result",
				{}
			)

			if (
				typeof(wrapper_result_raw) == TYPE_DICTIONARY
				and not (
					wrapper_result_raw as Dictionary
				).is_empty()
			):
				cursor = wrapper_result_raw as Dictionary
				continue



		if (
			cursor.has(
				"surface_contract"
			)
			or schema == (
				"eralife.luxury."
				+ "exchange_surface_contract"
			)
			or cursor.has(
				"committed"
			)
			or cursor.has(
				"audio_authorized"
			)
			or (
				cursor.has(
					"success"
				)
				and not bool(
					cursor.get(
						"success",
						true
					)
				)
				and str(
					cursor.get(
						"reason",
						""
					)
				).strip_edges() != ""
			)
		):
			return cursor.duplicate(false)

		var advanced: bool = false

		for key in [
			"result",
			"engine_report",
			"target_report",
			"commit_report",
			"command_report",
			"route_report",
			"payload"
		]:
			var nested_raw: Variant = cursor.get(
				key,
				{}
			)

			if typeof(
				nested_raw
			) != TYPE_DICTIONARY:
				continue

			var nested: Dictionary = (
				nested_raw as Dictionary
			)

			if nested.is_empty():
				continue

			cursor = nested
			advanced = true
			break

		if advanced:
			continue

		if (
			cursor.has(
				"text"
			)
			or cursor.has(
				"reason"
			)
		):
			return cursor.duplicate(false)

		break

	return last_nonempty.duplicate(false)
func _luxury_exchange_request_surface_contract(
