				report.get(
					"reason",
					report.get(
						"mode",
						"missing_hot_contract"
					)
				)
			)
		)

		if (
			career_hub_panel != null
			and is_instance_valid(
				career_hub_panel
			)
		):
			career_hub_panel.set_status(
				(
					"Professional truth is still resolving "
					+ "in the background."
				)
			)

		return route_result

	set_meta(
		"career_hub_contract_projection_failed",
