func _quarantine_runtime_floating_hud_buttons_for_surface(reason: String = "surface_boundary") -> void:
	for raw_button in _runtime_floating_hud_buttons():
		var button:= raw_button as Button
		if button == null or not is_instance_valid(button):
			continue
		button.visible = false
		button.disabled = true
		button.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if bending_hud_panel != null and is_instance_valid(bending_hud_panel):
		bending_hud_panel.visible = false
	if wizard_hud_panel != null and is_instance_valid(wizard_hud_panel):
		wizard_hud_panel.visible = false
	if belongings_hud_panel != null and is_instance_valid(belongings_hud_panel):
		belongings_hud_panel.visible = false

	set_meta("runtime_floating_hud_surface_quarantined", true)
	set_meta("runtime_floating_hud_surface_quarantine_reason", reason)
	set_meta("runtime_floating_hud_surface_quarantine_at_ms", int(Time.get_ticks_msec()))
func _runtime_hud_button_should_stack(button: Button) -> bool:
	if button == null:
		return false
	if not is_instance_valid(button):
		return false
	if not _runtime_floating_hud_buttons_should_render_on_current_surface():
		return false
	return button.visible

func _sync_runtime_floating_hud_layering_for_spawn_shell(reason: String = "spawn_shell") -> void:
	var front_z: int = 301
	var stack_index: int = 0

	for raw_button in _runtime_floating_hud_buttons():
		var button:= raw_button as Button
		if button == null or not is_instance_valid(button):
			continue

		if not button.visible:
			button.disabled = true
			button.mouse_filter = Control.MOUSE_FILTER_IGNORE
			button.modulate.a = 0.0
			continue

		_apply_runtime_floating_hud_button_visual_contract(button)
		_apply_runtime_hud_button_stack_layout(button, stack_index)

		button.z_as_relative = false
		button.z_index = front_z
		button.disabled = false
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.focus_mode = Control.FOCUS_NONE
		button.modulate = Color(1.0, 1.0, 1.0, 1.0)

		button.set_meta("runtime_floating_hud_stack_index", stack_index)
		button.set_meta("runtime_floating_hud_stack_reason", reason)
		button.set_meta("runtime_floating_hud_stack_synced_at_ms", int(Time.get_ticks_msec()))

		stack_index += 1

	set_meta("runtime_floating_hud_shell_safe_layering_applied", true)
	set_meta("runtime_floating_hud_shell_safe_layering_reason", reason)
	set_meta("runtime_floating_hud_shell_safe_layering_at_ms", int(Time.get_ticks_msec()))
	set_meta("runtime_floating_hud_shell_safe_stack_count", stack_index)
	set_meta("runtime_floating_hud_shell_buttons_cannot_overlap", true)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["runtime_floating_hud_shell_safe_layering_applied"] = true
		gs.scenario_state ["runtime_floating_hud_shell_safe_layering_reason"] = reason
		gs.scenario_state ["runtime_floating_hud_shell_safe_layering_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["runtime_floating_hud_shell_safe_stack_count"] = stack_index
		gs.scenario_state ["runtime_floating_hud_shell_buttons_cannot_overlap"] = true
func _ensure_runtime_floating_hud_button_shells_for_stack() -> void:



	var existing_shell_count: int = 0

	for raw_button in _runtime_floating_hud_buttons():
		if (
			typeof(
				raw_button
			) != TYPE_OBJECT
			or not is_instance_valid(
				raw_button
			)
			or not (
				raw_button is Button
			)
		):
			continue

		existing_shell_count += 1

	set_meta(
		"runtime_floating_hud_stack_shells_ensured",
		true
	)
	set_meta(
		"runtime_floating_hud_stack_existing_shell_count",
		existing_shell_count
	)
	set_meta(
		"runtime_floating_hud_stack_construction_performed",
		false
	)
	set_meta(
		"runtime_floating_hud_stack_full_panel_construction_forbidden",
		true
	)
	set_meta(
		"runtime_floating_hud_stack_engine_calls",
		false
	)
	set_meta(
		"runtime_floating_hud_stack_shells_ensured_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
func _runtime_floating_hud_visibility_truth_snapshot() -> Dictionary:
	var surface_allows_runtime_buttons: bool = (
		_runtime_floating_hud_buttons_should_render_on_current_surface()
	)
	var runtime_snapshot: Dictionary = {}
	var current_actor_id: int = (
		int(
			gs.player.id
		)
		if (
			gs != null
			and gs.player != null
		)
		else -1
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var runtime_snapshot_raw: Variant = gs.scenario_state.get(
			"runtime_hud_visibility_snapshot",
			{}
		)

		if typeof(
			runtime_snapshot_raw
		) == TYPE_DICTIONARY:
			runtime_snapshot = (
				runtime_snapshot_raw as Dictionary
			)

	var snapshot_actor_id: int = int(
		runtime_snapshot.get(
			"controlled_actor_id",
			runtime_snapshot.get(
				"player_id",
				current_actor_id
			)
		)
	)
	var actor_matches_snapshot: bool = (
		current_actor_id > 0
		and snapshot_actor_id == current_actor_id
	)
	var bending_feature_enabled: bool = (
		gs != null
		and bool(
			gs.player_bending_enabled
		)
	)
	var crown_available: bool = (
		actor_matches_snapshot
		and bool(
			runtime_snapshot.get(
				"crown_available",
				runtime_snapshot.get(
					"crown_button_visible",
					false
				)
			)
		)
	)
	var bending_available: bool = (
		actor_matches_snapshot
		and bending_feature_enabled
		and bool(
			runtime_snapshot.get(
				"bending_available",
				runtime_snapshot.get(
					"bending_button_visible",
					false
				)
			)
		)
	)



	if (
		actor_matches_snapshot
		and not crown_available
	):
		crown_available = _player_has_crown_presence()

	if (
		actor_matches_snapshot
		and bending_feature_enabled
		and not bending_available
	):
		bending_available = _player_has_visible_bending()

	return {
		"surface_allows_runtime_buttons": surface_allows_runtime_buttons,
		"belongings": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"belongings_available",
					runtime_snapshot.get(
						"belongings_button_visible",
						false
					)
				)
			)
		),
		"food": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"food_lifestyle_available",
					runtime_snapshot.get(
						"food_lifestyle_button_visible",
						false
					)
				)
			)
		),
		"restaurant": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"restaurant_lifestyle_available",
					runtime_snapshot.get(
						"restaurant_lifestyle_button_visible",
						false
					)
				)
			)
		),
		"rick": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"rick_weapon_shop_available",
					runtime_snapshot.get(
						"rick_weapon_shop_button_visible",
						false
					)
				)
			)
		),
		"crown": (
			surface_allows_runtime_buttons
			and crown_available
		),
		"bending": (
			surface_allows_runtime_buttons
			and bending_available
		),
		"boxing": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"boxing_available",
					runtime_snapshot.get(
						"boxing_button_visible",
						false
					)
				)
			)
		),
		"superpower": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"superpower_available",
					runtime_snapshot.get(
						"superpower_button_visible",
						false
					)
				)
			)
		),
		"power": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"power_available",
					runtime_snapshot.get(
						"power_button_visible",
						false
					)
				)
			)
		),
		"wizard": (
			surface_allows_runtime_buttons
			and actor_matches_snapshot
			and bool(
				runtime_snapshot.get(
					"wizard_available",
					runtime_snapshot.get(
						"wizard_button_visible",
						false
					)
				)
			)
		),
		"snapshot_actor_id": snapshot_actor_id,
		"current_actor_id": current_actor_id,
		"actor_matches_snapshot": actor_matches_snapshot,
		"bending_feature_enabled": bending_feature_enabled,
	}
