func _stage_royal_runtime_hud_truth_for_zero_frame_entry(
	snapshot: Dictionary,
	reason: String = "god_mode_royal_hud_truth"
) -> Dictionary:
	var clean_snapshot: Dictionary = snapshot.duplicate(false)

	if gs == null or gs.player == null:
		return clean_snapshot

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var actor: Person = gs.player
	var show_crown: bool = (
		bool(actor.is_royal)
		or bool(actor.is_ruler)
		or int(actor.succession_rank) > 0
		or str(actor.royal_title).strip_edges() != ""
		or str(actor.civic_title).strip_edges() != ""
	)
	var runtime_raw: Variant = clean_snapshot.get(
		"runtime_hud_visibility_snapshot",
		gs.scenario_state.get(
			"runtime_hud_visibility_snapshot",
			{}
		)
	)
	var runtime_snapshot: Dictionary = (
		(runtime_raw as Dictionary).duplicate(false)
		if typeof(runtime_raw) == TYPE_DICTIONARY
		else {}
	)

	runtime_snapshot ["current_panel"] = "life"
	runtime_snapshot ["player_id"] = int(actor.id)
	runtime_snapshot ["controlled_actor_id"] = int(actor.id)
	runtime_snapshot ["crown_available"] = show_crown
	runtime_snapshot ["crown_button_visible"] = show_crown
	runtime_snapshot ["crown_truth_source"] = reason
	runtime_snapshot ["crown_truth_actor_is_royal"] = bool(
		actor.is_royal
	)
	runtime_snapshot ["crown_truth_actor_is_ruler"] = bool(
		actor.is_ruler
	)
	runtime_snapshot ["crown_truth_actor_title"] = str(
		actor.royal_title
	)
	runtime_snapshot ["crown_truth_actor_civic_title"] = str(
		actor.civic_title
	)
	runtime_snapshot ["crown_truth_actor_succession_rank"] = int(
		actor.succession_rank
	)
	runtime_snapshot ["updated_at_ms"] = int(
		Time.get_ticks_msec()
	)
	runtime_snapshot ["staging_called_royalty_engine"] = false
	runtime_snapshot ["staging_mutated_actor"] = false
	runtime_snapshot ["ready_gate_member"] = false

	clean_snapshot ["runtime_hud_visibility_snapshot"] = (
		runtime_snapshot
	)
	clean_snapshot ["crown_available"] = show_crown
	clean_snapshot ["crown_button_visible"] = show_crown
	clean_snapshot ["royal_runtime_hud_truth_staged"] = true
	clean_snapshot ["royal_runtime_hud_stage_called_engine"] = false
	clean_snapshot ["royal_runtime_hud_stage_mutated_actor"] = false
	clean_snapshot ["royal_runtime_hud_ready_gate_member"] = false

	return clean_snapshot
