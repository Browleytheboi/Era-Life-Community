			) as Control
		)

		if intro_frame != null:
			intro_frame.anchor_left = 0.0
			intro_frame.anchor_right = 0.0
			intro_frame.anchor_top = 0.0
			intro_frame.anchor_bottom = 0.0

			intro_frame.offset_left = stage_left
			intro_frame.offset_right = stage_right
			intro_frame.offset_top = stage_top
			intro_frame.offset_bottom = stage_bottom

	if (
		startup_intro_skip_button != null
