		var disabled_bg: Color = tokens ["bg"]
		var disabled_border: Color = tokens ["border"]
		var disabled_glow: Color = tokens ["glow"]
		var disabled_text: Color = tokens ["text"]
		var disabled_shadow: Color = tokens ["text_shadow"]
		disabled_bg.a *= 0.46
		disabled_border.a *= 0.44
		disabled_glow.a = 0.0
		disabled_text.a = 0.38
		disabled_shadow.a *= 0.34
		tokens ["bg"] = disabled_bg
		tokens ["border"] = disabled_border
		tokens ["glow"] = disabled_glow
		tokens ["text"] = disabled_text
		tokens ["text_hover"] = disabled_text
		tokens ["text_shadow"] = disabled_shadow
		tokens ["glow_size"] = 0.0
		tokens ["outline_size"] = 0
		tokens ["target_alpha"] = 0.48
		return tokens

	match state:
		"hover":
			var hover_bg: Color = tokens ["bg"]
			var hover_border: Color = tokens ["border"]
			var hover_glow: Color = tokens ["glow"]
			hover_bg = hover_bg.lerp(Color(1.0, 1.0, 1.0, hover_bg.a), 0.06)
			hover_border.a = clamp(hover_border.a + 0.08, 0.0, 1.0)
			hover_glow.a = clamp(hover_glow.a + 0.05, 0.0, 1.0)
			tokens ["bg"] = hover_bg
			tokens ["border"] = hover_border
			tokens ["glow"] = hover_glow
			tokens ["glow_size"] = float(tokens ["glow_size"]) + 2.0
			tokens ["outline_size"] = 1
			tokens ["base_scale"] = float(tokens ["base_scale"]) + 0.04
			tokens ["target_alpha"] = 1.0
		"active":
			var active_bg: Color = tokens ["bg"]
			var active_border: Color = tokens ["border"]
			var active_glow: Color = tokens ["glow"]
			active_bg = active_bg.lerp(Color(1.0, 1.0, 1.0, active_bg.a), 0.1)
			active_border.a = clamp(active_border.a + 0.14, 0.0, 1.0)
			active_glow.a = clamp(active_glow.a + 0.08 + (breathe_strength * 0.04), 0.0, 1.0)
			tokens ["bg"] = active_bg
			tokens ["border"] = active_border
			tokens ["glow"] = active_glow
			tokens ["glow_size"] = float(tokens ["glow_size"]) + 4.0 + (2.0 * breathe_strength)
			tokens ["border_width"] = max(int(tokens ["border_width"]), 2)
			tokens ["outline_size"] = 2 if variant == "priority" else 1
			tokens ["base_scale"] = float(tokens ["base_scale"]) + 0.028 + (0.01 * breathe_strength)
			tokens ["target_alpha"] = 1.0

	if pulse_strength > 0.0:
		var pulse_bg: Color = tokens ["bg"]
		var pulse_border: Color = tokens ["border"]
		var pulse_glow: Color = tokens ["glow"]
		var pulse_text: Color = tokens ["text"]
		pulse_bg = pulse_bg.lerp(Color(1.0, 1.0, 1.0, pulse_bg.a), 0.04 * pulse_strength)
		pulse_border.a = clamp(pulse_border.a + (0.1 * pulse_strength), 0.0, 1.0)
		pulse_glow.a = clamp(pulse_glow.a + (0.1 * pulse_strength), 0.0, 1.0)
		pulse_text = pulse_text.lerp(Color(1.0, 1.0, 1.0, pulse_text.a), 0.12 * pulse_strength)
		tokens ["bg"] = pulse_bg
		tokens ["border"] = pulse_border
		tokens ["glow"] = pulse_glow
		tokens ["text"] = pulse_text
		tokens ["text_hover"] = pulse_text
		tokens ["glow_size"] = float(tokens ["glow_size"]) + (3.0 * pulse_strength)
		tokens ["base_scale"] = float(tokens ["base_scale"]) + (0.022 * pulse_strength)
		tokens ["target_alpha"] = min(1.0, float(tokens ["target_alpha"]) + (0.04 * pulse_strength))

	return tokens


func _current_ui_material_phase() -> float:
	if player_stats_breathe_time > 0.0:
		return player_stats_breathe_time
	return era_border_phase


func _current_ui_material_pulse(speed: float = 1.0, phase_offset: float = 0.0) -> float:
	return (sin(_current_ui_material_phase() * speed + phase_offset) + 1.0) * 0.5


func _bring_modal_to_front(node: Node) -> void:
	if node == null:
		return

	var parent:= node.get_parent()
	if parent != null:
		parent.move_child(node, parent.get_child_count() - 1)

	var z_floor: int = 950
	if node.has_meta("modal_z_floor"):
		z_floor = int(node.get_meta("modal_z_floor", 950))

	if node is Control:
		var control_node:= node as Control
		control_node.mouse_filter = Control.MOUSE_FILTER_STOP
		control_node.focus_mode = Control.FOCUS_ALL
		control_node.z_as_relative = false
		control_node.z_index = MainSceneHelpers._safe_modal_z_index(int(control_node.z_index), z_floor)
		control_node.call_deferred("grab_focus")
		return

	if node is CanvasItem:
		var canvas_node:= node as CanvasItem
		canvas_node.z_as_relative = false
		canvas_node.z_index = MainSceneHelpers._safe_modal_z_index(int(canvas_node.z_index), z_floor)
		return
func _ensure_scenario_ui() -> void:
	if scenario_panel != null:
		return
	scenario_panel = ScenarioPanel.new()
	# Nodes created with .new() take their name from the base class, so this showed up
	# in the remote scene tree as a bare "Control" and was impossible to pick out.
	scenario_panel.name = "ScenarioPanel"
	add_child(scenario_panel)
	_bring_modal_to_front(scenario_panel)
	scenario_panel.option_pressed.connect(_on_scenario_action_pressed)
func _refresh_scenario_ui_from_result(result: Dictionary) -> void:
	if bool(get_meta("red_bonnet_dragonball_suppress_followup_scenario_panel", false)) and MainSceneHelpers._result_is_red_bonnet_dragonball_spectator_packet(result):
		return

	_ensure_scenario_ui()
	if scenario_panel == null:
		return

	var arrival_raw: Variant = result.get("dragonball_arrival_animation", {})
	if typeof(arrival_raw) == TYPE_DICTIONARY:
		var arrival_packet: Dictionary = (arrival_raw as Dictionary).duplicate(true)
		if bool(arrival_packet.get("active", false)):
			call_deferred("_play_dragonball_arrival_animation", arrival_packet)

	scenario_panel.present(result)
	_bring_modal_to_front(scenario_panel)

	# DIAGNOSTIC: the spirit world action completes in 20ms total yet the screen is
	# unchanged and input stops responding. That fits a panel that IS present but
	# renders empty, with its full-screen dim layer still swallowing clicks. Report
	# what the panel actually looks like after presenting.
	EraLog.truth(
		"ERALIFE_SCENARIO_PANEL|visible=%s|size=%s|children=%d|z=%d|title='%s'|result_keys=%s"
		% [
			str(scenario_panel.visible),
			str(scenario_panel.size),
			scenario_panel.get_child_count(),
			int(scenario_panel.z_index),
			str(result.get("panel_title", result.get("popup_title", ""))),
			str(result.keys())
		]
	)

	# A Control that is NOT inside the scene tree still reports visible=true and a
	# size, but never draws and never receives input. Report tree membership, parent
	# and sibling position -- that distinguishes "drawn behind something" from "not
	# in the tree at all", which look identical from the properties above.
	EraLog.truth(
		"ERALIFE_SCENARIO_TREE|inside_tree=%s|parent=%s|index=%d|sibling_count=%d"
		% [
			str(scenario_panel.is_inside_tree()),
			str(scenario_panel.get_parent().name) if scenario_panel.get_parent() != null else "<none>",
			scenario_panel.get_index(),
			scenario_panel.get_parent().get_child_count() if scenario_panel.get_parent() != null else -1
		]
	)

	# The panel is on top and its dim is clearly rendering (the hub greys out), but the
	# card is not visible. Report the card's own geometry: a zero height, an offscreen
	# position or a hidden card each point somewhere different.
	var scenario_card: Control = scenario_panel.card
	if scenario_card != null and is_instance_valid(scenario_card):
		EraLog.truth(
			"ERALIFE_SCENARIO_CARD|visible=%s|size=%s|global_pos=%s|children=%d|modulate_a=%.2f|panel_pos=%s"
			% [
				str(scenario_card.visible),
				str(scenario_card.size),
				str(scenario_card.global_position),
				scenario_card.get_child_count(),
				float(scenario_card.modulate.a),
				str(scenario_panel.global_position)
			]
		)
	else:
		EraLog.truth("ERALIFE_SCENARIO_CARD|card=missing")

	var pressure: float = MainSceneLogic._reality_fusion_foreign_timeline_pressure(gs)
	if pressure <= 0.0:
		return

	var should_glitch: bool = bool(result.get("timeline_glitch", false))
	if not should_glitch:
		should_glitch = randf() < clamp(0.1 + pressure * 0.16, 0.1, 0.42)

	if should_glitch and scenario_panel.has_method("_play_combat_impact_shake"):
		var shake_amount: float = clamp(4.0 + pressure * 6.0 + randf() * 8.0, 4.0, 22.0)
		scenario_panel.call_deferred("_play_combat_impact_shake", shake_amount)
func _hide_scenario_ui() -> void:
	if scenario_panel != null:
		scenario_panel.hide_panel()

func _on_scenario_action_pressed(action_label: String) -> void:
	if gs == null:
		return

	var clean_action_label: String = str(
		action_label
	).strip_edges()
	var lower_action_label: String = (
		clean_action_label.to_lower()
	)

	if lower_action_label in [
		"done watching",
		"done",
		"continue",
		"close"
	]:
		var cached_was_red_bonnet_dragonball: bool = false

		if typeof(cached_last_result) == TYPE_DICTIONARY:
			cached_was_red_bonnet_dragonball = (
				MainSceneHelpers._result_is_red_bonnet_dragonball_spectator_packet(
					cached_last_result
				)
			)

		if (
			cached_was_red_bonnet_dragonball
			or bool(
				get_meta(
					"red_bonnet_dragonball_runtime_pending",
					false
				)
			)
			or bool(
				get_meta(
					"red_bonnet_post_popup_inventory_refresh_pending",
					false
				)
			)
		):
			set_meta(
				"red_bonnet_dragonball_runtime_ui_closed",
				true
			)
			set_meta(
				"red_bonnet_dragonball_runtime_ui_closed_at_ms",
				int(
					Time.get_ticks_msec()
				)
			)
			set_meta(
				"red_bonnet_dragonball_suppress_followup_scenario_panel",
				true
			)
			set_meta(
				"red_bonnet_dragonball_suppress_followup_reason",
				"done_watching_pressed"
			)
			cached_last_result = {}

		_hide_scenario_ui()

		_begin_runtime_interaction_quiet_window(
			"scenario_done_watching_teardown",
			260
		)

		if bool(
			get_meta(
				"red_bonnet_dragonball_runtime_pending",
				false
			)
		):
			_reveal_spawn_ready_runtime_hud_buttons_shell_only(
				"red_bonnet_dragonball_done_watching_runtime_pending"
			)
			_schedule_red_bonnet_deferred_effects_flush_ui_safe(
				"red_bonnet_done_watching_runtime_pending",
				0
			)
			return

		if bool(
			get_meta(
				"red_bonnet_post_popup_inventory_refresh_pending",
				false
			)
		):
			set_meta(
				"red_bonnet_post_popup_inventory_refresh_pending",
				false
			)

			var red_bonnet_result_text: String = str(
				get_meta(
					"red_bonnet_post_popup_inventory_refresh_result_text",
					""
				)
			).strip_edges()

			_schedule_action_result_post_resolution_reconcile(
				"red_bonnet_spectator_done_watching",
				{
					"source": (
						"red_bonnet_spectator_done_watching"
					),
					"text": red_bonnet_result_text,
					"log_to_diary": false,
				}
			)
			_schedule_red_bonnet_deferred_effects_flush_ui_safe(
				"red_bonnet_spectator_done_watching",
				0
			)
			return

		if (
			typeof(cached_last_result) == TYPE_DICTIONARY
			and not cached_last_result.is_empty()
		):
			var cached_result: Dictionary = (
				cached_last_result.duplicate(true)
			)

			if (
				bool(
					cached_result.get(
						"uses_scenario_panel",
						false
					)
				)
				or typeof(
					cached_result.get(
						"spectator_frames",
						[]
					)
				) == TYPE_ARRAY
			):
				_schedule_action_result_post_resolution_reconcile(
					"scenario_done_watching",
					cached_result
				)
				return

		_schedule_action_result_post_resolution_reconcile(
			"scenario_done_watching",
			{
				"source": "scenario_done_watching",
				"text": "",
				"log_to_diary": false,
			}
		)
		return

	var result: Dictionary = {}
	var boxing_live_raw: Variant = (
		gs.scenario_state.get(
			"boxing_live_exchange",
			{}
		)
		if typeof(gs.scenario_state) == TYPE_DICTIONARY
		else {}
	)
	var boxing_live_active: bool = (
		typeof(boxing_live_raw) == TYPE_DICTIONARY
		and not (boxing_live_raw as Dictionary).is_empty()
	)

	if (
		boxing_live_active
		and gs.boxing_combat_resolution_engine != null
		and gs.boxing_combat_resolution_engine.has_method(
			"resolve_live_exchange_action"
		)
	):
		result = (
			gs.boxing_combat_resolution_engine
			.resolve_live_exchange_action(
				clean_action_label
			)
		)
	elif gs.scenario_engine != null:
		result = gs.scenario_engine.choose_pending_option(
			clean_action_label
		)
	else:
		return

	cached_last_result = result

	if _result_crosses_life_boundary(result):
		_hide_other_countries_popup_for_lifecycle(
			"scenario_life_boundary"
		)
		_show_age_up_output(result)
		return

	var result_type: String = str(
		result.get(
			"type",
			""
		)
	)

	if result_type == "scenario_prompt":
		_refresh_scenario_ui_from_result(
			result
		)
		return

	var open_school_after_scenario: bool = bool(
		result.get(
			"open_school_hub_after_scenario",
			false
		)
	)

	_hide_scenario_ui()

	var diary_text: String = str(
		result.get(
			"life_diary_text",
			result.get(
				"diary_text",
				result.get(
					"text",
					""
				)
			)
		)
	)
	var result_text: String = MainSceneHelpers._compact_diary_text(
		diary_text
	)

	if (
		result_text != ""
		and bool(
			result.get(
				"log_to_diary",
				true
			)
		)
	):
		_append_text_to_diary(
			result_text,
			false
		)

	_maybe_show_action_result_popup(
		result
	)
	_invalidate_life_diary_contract_render_cache(
		"scenario_action_pressed"
	)
	_schedule_action_result_post_resolution_reconcile(
		"scenario_action:%s"
		% clean_action_label,
		result
	)

	if open_school_after_scenario:
		call_deferred(
			"_open_school_hub_after_graduation_choice"
		)
func _open_school_hub_after_graduation_choice() -> void:
	if (
		gs == null
		or gs.player == null
	):
		return



	school_hub_active_section_id = "overview"

	_open_main_tab_zero_frame_door(
		"school",
		"post_graduation_higher_learning"
	)
func _schedule_red_bonnet_deferred_effects_flush_ui_safe(
	reason: String = "red_bonnet",
	pass_index: int = 0
) -> void:
	if gs == null or gs.player == null:
		return

	var tree:= get_tree()
	if tree == null:
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var runtime_pending: bool = bool(
		get_meta(
			"red_bonnet_dragonball_runtime_pending",
			false
		)
	)
	var busy: bool = (
		runtime_pending
		or _runtime_interactive_surface_busy(now_ms)
		or _ui_interaction_grace_active(now_ms)
		or action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or age_up_loading_runtime_active
		or bool(
			get_meta(
				"age_up_transition_busy",
				false
			)
		)
		or bool(
			get_meta(
				"startup_live_shell_loading",
				false
			)
		)
	)

	if busy:
		if pass_index >= 32:
			return

		var wait_timer:= tree.create_timer(0.45)
		wait_timer.timeout.connect(
			Callable(
				self,
				"_schedule_red_bonnet_deferred_effects_flush_ui_safe"
			).bind(
				reason,
				pass_index + 1
			),
			CONNECT_ONE_SHOT
		)
		return

	var flush_report: Dictionary = (
		_express_artifact_interaction_intent(
			"flush_deferred_artifact_effects",
			{
				"max_count": 1,
				"source": (
					"mainscene.red_bonnet_deferred_flush:%s"
					% reason
				)
			}
		)
	)
	var remaining_queue_size: int = maxi(
		0,
		int(
			flush_report.get(
				"remaining_queue_size",
				0
			)
		)
	)

	if (
		remaining_queue_size > 0
		and pass_index < 32
	):
		var next_timer:= tree.create_timer(0.55)
		next_timer.timeout.connect(
			Callable(
				self,
				"_schedule_red_bonnet_deferred_effects_flush_ui_safe"
			).bind(
				reason,
				pass_index + 1
			),
			CONNECT_ONE_SHOT
		)
func _build_current_save_slot_path() -> String:
	MainSceneHelpers._ensure_saved_lives_dir()

	var player_name:= "unknown_life"
	var age_part:= "age_0"
	if gs != null and gs.player != null:
		player_name = MainSceneHelpers._sanitize_save_slot_component("%s_%s" % [gs.player.first_name, gs.player.last_name])
		age_part = "age_%d" % int(gs.player.age)

	var year_part:= "year_%s" % MainSceneHelpers._sanitize_save_slot_component(_format_year(gs.year))
	var stamp:= str(int(Time.get_unix_time_from_system()))
	return "%s/%s_%s_%s_%s.bin" % [MainSceneHelpers._saved_lives_dir(), player_name, age_part, year_part, stamp]
