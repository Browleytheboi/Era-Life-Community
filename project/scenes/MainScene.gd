func _institution_hub_relationship_person_label(npc: Person, prefix: String = "", suffix: String = "") -> String:
	if npc == null:
		return ""

	var name_text: String = _relationship_display_name(npc)
	var clean_prefix: String = str(prefix).strip_edges()
	var clean_suffix: String = str(suffix).strip_edges()

	if clean_suffix == "" and str(institution_hub_kind).strip_edges().to_lower() == "relationships":
		clean_suffix = _relationship_label_for_target(npc)
		if clean_suffix == "Stranger":
			clean_suffix = ""

	var prefix_text: String = ""
	if clean_prefix != "":
		prefix_text = "%s " % clean_prefix

	var suffix_text: String = ""
	if clean_suffix != "":
		suffix_text = " (%s)" % clean_suffix

	return "%s%s%s" % [prefix_text, name_text, suffix_text]
