		action_result_popup_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		action_result_popup_card.size_flags_vertical = Control.SIZE_EXPAND_FILL
		action_result_popup_title.add_theme_font_size_override("font_size", 30)
		action_result_popup_body.fit_content = false
		action_result_popup_body.scroll_active = true
		action_result_popup_body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		action_result_popup_body.size_flags_vertical = Control.SIZE_EXPAND_FILL
		action_result_popup_body.custom_minimum_size = Vector2(0, max(260.0, viewport_size.y - 230.0))
		action_result_popup_footer.add_theme_font_size_override("font_size", 18)

