	belongings_hud_content_dirty = true
	bending_hud_last_rebuild_signature = ""
	wizard_hud_last_signature = ""
	set_meta(
		"post_age_up_contract_projection_observation_pending",
		true
	)
	set_meta(
		"post_age_up_contract_projection_observation_at_ms",
		now_ms
	)

	if post_loading_finalize:
		set_meta(
			"era_surface_refresh_next_ms",
			now_ms + 240
		)
		set_meta(
			"ui_idle_bus_flush_next_ms",
			now_ms + 420
		)
		set_meta(
			"age_up_post_live_tail_refresh_stage",
			0
		)
		set_meta(
			"age_up_tail_background_allowed_after_ms",
			now_ms + 1500
		)
		set_meta(
			"post_age_up_rewind_snapshot_next_step_ms",
			maxi(
				int(
					get_meta(
						"post_age_up_rewind_snapshot_next_step_ms",
