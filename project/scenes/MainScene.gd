func _hide_standard_tab_popup() -> void:
	var closing_kind: String = str(
		standard_tab_popup_kind
	).strip_edges()
	var restore_other_countries_popup: bool = bool(
		standard_tab_popup_payload.get(
			"restore_other_countries_popup",
			standard_tab_popup_payload.get(
				"return_to_other_countries",
				false
			)
		)
	)
	var restore_panel: String = str(
		standard_tab_popup_payload.get(
			"return_panel",
			current_panel
		)
	).strip_edges()
	var restore_main_life_diary: bool = (
		not restore_other_countries_popup
		and (
			closing_kind == "life"
			or restore_panel == "life"
			or current_panel == ""
		)
	)

	standard_tab_popup_open = false
	standard_tab_popup_kind = ""
	standard_tab_popup_payload.clear()
	standard_tab_experience_rows.clear()

	if standard_tab_popup != null:
		standard_tab_popup.visible = false
		standard_tab_popup.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	_cancel_panel_content_transition()

	var now_ms: int = int(Time.get_ticks_msec())

	set_meta(
		"standard_tab_close_navigation_grace_until_ms",
		now_ms + 420
	)
	set_meta(
		"era_surface_refresh_next_ms",
		now_ms + 240
	)
	set_meta(
		"standard_tab_close_rebuilt_world_panel",
		false
	)
	set_meta(
		"standard_tab_close_rebuilt_life_shell",
		false
	)

	if (
		not bool(
			get_meta(
				"startup_live_shell_loading",
				false
			)
		)
		and not bool(
			get_meta(
				"age_up_post_loading_finalize_pending",
				false
			)
		)
		and not bool(
			get_meta(
				"age_up_loading_runtime_begin_pending",
				false
			)
		)
	):
		set_meta("age_up_transition_busy", false)

		if age_up_loading_runtime_active:
			_hide_age_up_loading_overlay()
		elif (
			age_up_loading_overlay != null
			and is_instance_valid(age_up_loading_overlay)
		):
			age_up_loading_overlay.visible = false

	if restore_other_countries_popup:
		current_panel = (
			restore_panel
			if restore_panel != ""
			else "world"
		)
		var other_countries_popup:= get_node_or_null(
			"OtherCountriesPopup"
		)

		if other_countries_popup != null:
			other_countries_popup.visible = true
			other_countries_popup.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)
			_bring_modal_to_front(
				other_countries_popup
			)

		_restore_main_navigation_lens_after_modal_close(
			"standard_tab_return_to_other_countries"
		)

		set_meta(
			"standard_tab_close_restored_other_countries_zero_frame",
			true
		)
		return

	if restore_main_life_diary:
		current_panel = "life"
		_open_life_diary_native_surface(
			"standard_tab_close_zero_frame_life"
		)
		_apply_ui_nav_button_visuals()

	if (
		player_stats_overlay != null
		and not restore_other_countries_popup
		and not relationships_browser_open
		and not relationship_profile_popup_open
		and not activities_action_open
		and not world_feed_popup_open
	):
		player_stats_overlay.visible = true
func _restore_main_life_diary_after_standard_tab_close() -> void:
	_cancel_panel_content_transition()

	var clean_panel: String = str(current_panel).strip_edges().to_lower()
	if clean_panel in ["choose_adventure_entry", "god_mode_entry"]:
		return

	if gs == null or gs.player == null:
		return

	if _god_mode_ui_locked():
		return

	var root:= get_node_or_null("UIContainer") as Control
	if root == null or not root.visible:
		return

	var should_restore_output: bool = (
		output_label != null
		and not standard_tab_popup_open
		and not relationships_browser_open
		and not relationship_profile_popup_open
		and not activities_action_open
		and not world_feed_popup_open
	)

	if not should_restore_output:
		return

	output_label.visible = true
	_render_life_diary_panel()
	call_deferred("_scroll_life_diary_to_bottom")
	_apply_ui_nav_button_visuals()
	_apply_centered_live_layout()
func _on_standard_tab_popup_back_pressed() -> void:
	var returns_to_other_countries: bool = bool(
		standard_tab_popup_payload.get(
			"restore_other_countries_popup",
			standard_tab_popup_payload.get(
				"return_to_other_countries",
				false
			)
		)
	)

	set_meta(
		"standard_tab_back_returns_to_real_life_shell",
		not returns_to_other_countries
	)
	set_meta(
		"standard_tab_back_returns_to_other_countries",
		returns_to_other_countries
	)
	set_meta(
		"standard_tab_back_is_zero_frame_door",
		true
	)
	set_meta(
		"standard_tab_back_pressed_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"standard_tab_back_diary_rebuild_forbidden",
		true
	)
	set_meta(
		"standard_tab_back_hud_scan_forbidden",
		true
	)

	_hide_standard_tab_popup()

	if returns_to_other_countries:
		return

	_reveal_existing_life_shell_after_surface_close(
		"standard_tab_back_pressed"
	)


func _show_standard_tab_popup(title_text: String, body_lines: Array, kind: String = "", payload:= {}) -> void:
	_ensure_standard_tab_popup()
	if standard_tab_popup == null:
		return
	if not is_instance_valid(standard_tab_popup):
		return

	standard_tab_popup_open = true
	standard_tab_popup_kind = kind
	_claim_interactive_surface_authority(standard_tab_popup, "standard_tab_popup:%s" % str(kind).strip_edges().to_lower(), "show_standard_tab_popup", true, true)
	if typeof(payload) == TYPE_DICTIONARY:
		standard_tab_popup_payload = payload.duplicate(true)
	else:
		standard_tab_popup_payload = {}
	standard_tab_experience_rows.clear()
	standard_tab_experience_breathe_time = 0.0
	if relationships_browser_open:
		_hide_relationship_browser()
	if relationship_profile_popup_open:
		_hide_relationship_profile_popup()
	if activities_action_open:
		_hide_activities_action_panel()
	if world_feed_popup_open:
		_hide_world_action_panel()
	if output_label != null:
		output_label.visible = false
	if player_stats_overlay != null:
		player_stats_overlay.visible = false
	var title_plate:= standard_tab_popup.find_child("StandardTabPopupTitlePlate", true, false) as PanelContainer
	var top_bar:= standard_tab_popup.find_child("StandardTabPopupTopBar", true, false) as HBoxContainer
	var overview_entry: Dictionary = standard_tab_popup_payload.get("entry", {})
	var overview_realm: Dictionary = standard_tab_popup_payload.get("realm", {})

	var sovereign_overview: bool = kind == "other_country_overview"
	var entry_kind: String = str(overview_entry.get("entry_kind", standard_tab_popup_payload.get("entry_kind", ""))).strip_edges()
	var realm_type: String = str(overview_realm.get("realm_type", overview_realm.get("dimension_type", ""))).strip_edges()
	var entry_id: String = str(overview_entry.get("entry_id", "")).strip_edges()
