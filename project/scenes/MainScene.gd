		if not bool(feedback.get("selectable", true)):
			button.disabled = true
			button.modulate = Color(1.0, 1.0, 1.0, 0.42)

		button.pressed.connect(_on_boxing_entry_division_selected.bind(boxing_entry_selected_mode, division))
		boxing_entry_popup_grid.add_child(button)
func _boxing_entry_division_feedback(actor: Person, division: String) -> Dictionary:
	var fallback:= {
		"selectable": true,
		"short_text": "Open",
		"status_text": "Division available."
	}

	if actor == null:
		return fallback

	if gs == null or gs.boxing_weight_engine == null:
		return fallback

	if not gs.boxing_weight_engine.has_method("evaluate_division_eligibility"):
		return fallback

	var report: Dictionary = gs.boxing_weight_engine.evaluate_division_eligibility(actor, division, {
		"source": "boxing_entry_popup"
	})

	var status: String = str(report.get("status", "ready")).strip_edges().to_lower()
	var current_weight: int = int(round(float(report.get("current_weight_lbs", 0.0))))
	var limit: int = int(round(float(report.get("division_limit_lbs", 0.0))))

	var short_text: String = "Ready"
	if status == "cut_required":
		short_text = "%d lb now • cut to %d" % [current_weight, limit]
	elif status == "too_heavy":
		short_text = "%d lb now • too heavy" % current_weight
	elif status == "too_light":
		short_text = "%d lb now • too light" % current_weight
	elif current_weight > 0:
		short_text = "%d lb now" % current_weight

	report ["short_text"] = short_text
	return report

func _on_boxing_entry_division_selected(mode: String, division: String) -> void:
	_complete_boxing_entry_from_popup(mode, division)


func _complete_boxing_entry_from_popup(mode: String, division: String) -> void:
	if not _global_intent_commit_scope_active():
		_express_global_ui_intent({
			"intent_type": "begin_boxing_career",
			"surface_id": "boxing_entry_popup",
			"action_id": "begin_boxing:%s:%s" % [
				str(mode).strip_edges().to_lower(),
				str(division).strip_edges()
			],
			"payload": {
				"mode": str(mode).strip_edges().to_lower(),
				"division": str(division).strip_edges()
			},
			"legacy_callback": "_complete_boxing_entry_from_popup",
			"legacy_args": [
				mode,
				division
			],
			"target": {
				"route_kind": "main_scene_legacy_callback",
				"callback": "_complete_boxing_entry_from_popup"
			},
			"source": "mainscene.boxing_entry_popup",
			"commit_required_before_log": true,
			"ui_is_expression_only": true
		}, {
			"source": "mainscene.boxing_entry_popup",
			"surface_id": "boxing_entry_popup",
			"action_id": "begin_boxing:%s:%s" % [
				str(mode).strip_edges().to_lower(),
				str(division).strip_edges()
			],
			"legacy_callback": "_complete_boxing_entry_from_popup",
			"legacy_args": [
				mode,
				division
			]
		})
		return

	if gs == null or gs.player == null or gs.boxing_engine == null:
		_hide_boxing_entry_popup()
		return

	var actor: Person = gs.player
	var gender_division: String = MainSceneHelpers._boxing_entry_gender_division_for_actor(actor)
	var result: Dictionary = gs.boxing_engine.start_boxing_career(actor, {
		"source": "boxing_entry_popup",
		"career_mode": mode,
		"weight_class": division,
		"gender_division": gender_division,
		"player_intent": true,
		"defer_world_sync": true,
		"committed_by_global_intent": true,
		"commit_required_before_log": true,
		"ui_is_expression_only": false
	})

	_hide_boxing_entry_popup()

	if bool(result.get("success", false)):
		result ["type"] = "boxing_hud_unlocked"
		result ["requires_runtime_hud_refresh_after_popup"] = true
		result ["runtime_hud_refresh_reason"] = "boxing_entry_popup_complete"
		result ["committed_by_global_intent"] = true
		result ["diary_log_is_derived_from_commit"] = true

		set_meta("boxing_hud_reveal_pending_after_action_result", true)
		set_meta("boxing_hud_reveal_pending_actor_id", int(actor.id))
		set_meta("boxing_hud_reveal_pending_at_ms", int(Time.get_ticks_msec()))
		set_meta("boxing_hud_next_light_refresh_ms", 0)

		if typeof(gs.scenario_state) != TYPE_DICTIONARY:
			gs.scenario_state = {}

		gs.scenario_state ["controlled_perspective_switch_pending_ui_refresh"] = false
		gs.scenario_state ["boxing_hud_visibility_dirty_actor_id"] = int(actor.id)
		gs.scenario_state ["boxing_hud_visibility_dirty_reason"] = "boxing_entry_popup_complete"
		gs.scenario_state ["boxing_hud_visibility_dirty_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["boxing_career_committed_by_global_intent"] = true
		gs.scenario_state ["boxing_career_commit_actor_id"] = int(actor.id)
		gs.scenario_state ["boxing_career_commit_required_before_log"] = true

		current_panel = ""
		if activities_action_open:
			_hide_activities_action_panel()
		if output_label != null:
			output_label.visible = true

		_boxing_hud_prime_visible_after_unlock(int(actor.id), "boxing_entry_popup_complete")

		var world_sync_context: Dictionary = MainSceneHelpers._safe_dictionary(result.get("world_sync_context", {}))
		if bool(result.get("deferred_world_sync", false)):
			_queue_boxing_entry_world_sync_after_hud_reveal(int(actor.id), world_sync_context)

	var result_text: String = str(result.get("text", "")).strip_edges()
	if result_text != "":
		_append_text_to_diary(result_text, false)

	call_deferred("_render_life_diary_panel")
	call_deferred("_scroll_life_diary_to_bottom")
	call_deferred("_update_player_stats_overlay")

	_maybe_show_action_result_popup(result)
func _queue_boxing_entry_world_sync_after_hud_reveal(actor_id: int, context: Dictionary = {}) -> void:
	if actor_id <= 0:
		return
	if gs == null or gs.boxing_engine == null:
		return

	set_meta("boxing_entry_world_sync_pending_after_ui_release", true)
	set_meta("boxing_entry_world_sync_pending_actor_id", actor_id)
	set_meta("boxing_entry_world_sync_pending_context", context.duplicate(true))
	set_meta("boxing_entry_world_sync_pending_at_ms", int(Time.get_ticks_msec()))


func _run_boxing_entry_world_sync_after_hud_reveal(actor_id: int, context: Dictionary = {}) -> void:
	if actor_id <= 0:
		return
	if gs == null or gs.boxing_engine == null:
		return

	var actor: Person = null
	if gs.player != null and int(gs.player.id) == actor_id:
		actor = gs.player
	if actor == null and gs.has_method("get_or_reactivate_npc_by_id"):
		actor = gs.get_or_reactivate_npc_by_id(actor_id)
	if actor == null and gs.has_method("get_npc_by_id"):
		actor = gs.get_npc_by_id(actor_id)

	if actor == null:
		return

	var safe_context: Dictionary = context.duplicate(true)
	safe_context ["source"] = str(safe_context.get("source", "boxing_entry_ui_safe_tail_sync"))
	safe_context ["ui_safe_tail_only"] = true
	safe_context ["projection_only"] = bool(safe_context.get("projection_only", true))
	safe_context ["queue_heavy_world_bootstrap_tail"] = false
	safe_context ["skip_heavy_world_bootstrap"] = true
	safe_context ["reason"] = "boxing_hud_already_revealed_player_should_not_wait"

	if gs.boxing_engine.has_method("finalize_pending_boxing_world_sync"):
		gs.boxing_engine.finalize_pending_boxing_world_sync(actor, safe_context)

	set_meta("boxing_hud_next_light_refresh_ms", 0)
	_boxing_hud_prime_visible_after_unlock(actor_id, "boxing_world_sync_projection_complete")
func _schedule_queued_boxing_entry_world_sync_after_ui_release(reason: String = "boxing_result_popup_closed") -> void:
	if not bool(get_meta("boxing_entry_world_sync_pending_after_ui_release", false)):
		return

	var actor_id: int = int(get_meta("boxing_entry_world_sync_pending_actor_id", -1))
	_boxing_mark_roster_projection_available_after_unlock(actor_id, "%s_projection_only" % reason)

	set_meta("boxing_entry_world_sync_tail_running", false)
	set_meta("boxing_entry_world_sync_tail_reason", reason)
	set_meta("boxing_entry_world_sync_tail_started_at_ms", 0)
	set_meta("boxing_entry_world_sync_tail_ui_safe_projection_only", true)
	set_meta("boxing_entry_world_sync_tail_ui_safe_projection_only_at_ms", int(Time.get_ticks_msec()))


func _run_queued_boxing_entry_world_sync_after_ui_release(reason: String = "boxing_result_popup_closed") -> void:
	if not bool(get_meta("boxing_entry_world_sync_pending_after_ui_release", false)):
		set_meta("boxing_entry_world_sync_tail_running", false)
		return

	var actor_id: int = int(get_meta("boxing_entry_world_sync_pending_actor_id", -1))
	var context: Dictionary = MainSceneHelpers._safe_dictionary(get_meta("boxing_entry_world_sync_pending_context", {}))

	remove_meta("boxing_entry_world_sync_pending_after_ui_release")
	remove_meta("boxing_entry_world_sync_pending_actor_id")
	remove_meta("boxing_entry_world_sync_pending_context")
	remove_meta("boxing_entry_world_sync_pending_at_ms")

	context ["source"] = str(context.get("source", reason))
	context ["ui_safe_tail_only"] = true
	context ["projection_only"] = true
	context ["queue_heavy_world_bootstrap_tail"] = false
	context ["skip_heavy_world_bootstrap"] = true

	_boxing_mark_roster_projection_available_after_unlock(actor_id, "%s_projection_only" % reason)
	_run_boxing_entry_world_sync_after_hud_reveal(actor_id, context)

	set_meta("boxing_entry_world_sync_tail_running", false)
	set_meta("boxing_entry_world_sync_tail_finished_at_ms", int(Time.get_ticks_msec()))
func _boxing_hub_make_athleticism_panel(panel_contract: Dictionary, visual_contract: Dictionary) -> PanelContainer:
