func _selected_bending_type_text() -> String:
	if custom_bending_picker == null or custom_bending_picker.item_count == 0:
		return "none"
	var idx:= custom_bending_picker.get_selected_id()
	if idx < 0:
		idx = 0
	return custom_bending_picker.get_item_text(idx).to_lower()

func _filter_birth_city_items_for_selected_bending(era_key: String, city_items: Array) -> Array:
	var allowed_nation:= MainSceneHelpers._elemental_nation_for_bending_type(_selected_bending_type_text())
	if allowed_nation == "":
		return city_items.duplicate()
	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return city_items.duplicate()
	var filtered: Array = []
	for raw_city in city_items:
		var city_text:= str(raw_city)
		var city_country:= str(era_engine.get_country_for_era_city(era_key, city_text)).strip_edges()
		if city_country == "" or not MainSceneHelpers._is_elemental_nation_name(city_country) or city_country == allowed_nation:
			filtered.append(city_text)
	return filtered

func _apply_reality_mode_selection_constraints(mode_text: String) -> void:
	var normalized_mode:= str(mode_text).strip_edges().to_lower()
	var is_realistic:= normalized_mode == "realistic"

	if custom_bending_picker != null:
		custom_bending_picker.disabled = is_realistic
		if is_realistic:
			MainSceneHelpers._select_option_by_text(custom_bending_picker, "none")
		_style_god_mode_option_button(custom_bending_picker)

	if custom_infinity_stones_spin != null:
		custom_infinity_stones_spin.disabled = is_realistic
		if is_realistic:
			_populate_god_mode_infinity_stones_picker(0)

	for raw_key in infinity_stone_state_buttons.keys():
		var key_text: String = str(raw_key)
		var button: Button = infinity_stone_state_buttons.get(key_text, null)
		if button != null:
			button.disabled = is_realistic

	_refresh_infinity_stone_state_buttons()
	_refresh_birth_location_pickers(_selected_country_text(), _selected_city_text(), false)
	_refresh_superpower_sandbox_button_state()

func _relationship_display_name(npc: Person) -> String:
	if npc == null:
		return ""

	var full_name:= ("%s %s" % [npc.first_name, npc.last_name]).strip_edges()
	var civic_title:= MainSceneHelpers._relationship_civic_display_title(npc)
	if civic_title != "":
		return ("%s %s" % [civic_title, full_name]).strip_edges()

	var royal_title:= str(npc.royal_title).strip_edges()
	if royal_title != "":
		return ("%s %s" % [royal_title, full_name]).strip_edges()

	return full_name
func _relationship_display_name_from_dict(data: Dictionary) -> String:
	if data.is_empty():
		return ""
	var full_name:= ("%s %s" % [
		str(data.get("first_name", "")),
		str(data.get("last_name", ""))
	]).strip_edges()
	var royal_title:= str(data.get("royal_title", "")).strip_edges()
	if royal_title != "":
		return ("%s %s" % [royal_title, full_name]).strip_edges()
	return full_name
