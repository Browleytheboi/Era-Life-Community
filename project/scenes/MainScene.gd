func _install_god_mode_scrollbar_runtime(scroll: ScrollContainer) -> void:
	if scroll == null or not is_instance_valid(scroll):
		return

	god_mode_start_scroll_container = scroll
	god_mode_scrollbar_last_activity_ms = 0
	scroll.set_meta("god_mode_scrollbar_runtime_bound", true)

	var input_callable:= Callable(self, "_on_god_mode_scroll_container_gui_input")
	if not scroll.gui_input.is_connected(input_callable):
		scroll.gui_input.connect(input_callable)

	_bind_god_mode_scrollbar_after_layout()
	call_deferred("_bind_god_mode_scrollbar_after_layout")


func _bind_god_mode_scrollbar_after_layout() -> void:
	if god_mode_start_scroll_container == null or not is_instance_valid(god_mode_start_scroll_container):
		return

	var scrollbar:= god_mode_start_scroll_container.get_v_scroll_bar()
	if scrollbar == null or not is_instance_valid(scrollbar):
		return

	god_mode_start_scrollbar = scrollbar
	_style_god_mode_scrollbar(god_mode_start_scrollbar)

	var value_callable:= Callable(self, "_on_god_mode_scrollbar_value_changed")
	if not god_mode_start_scrollbar.value_changed.is_connected(value_callable):
		god_mode_start_scrollbar.value_changed.connect(value_callable)

	god_mode_scrollbar_last_value = float(god_mode_start_scrollbar.value)
	_hide_god_mode_scrollbar_immediately()


func _hide_god_mode_scrollbar_immediately() -> void:
	if god_mode_scrollbar_fade_tween != null:
		god_mode_scrollbar_fade_tween.kill()
		god_mode_scrollbar_fade_tween = null

	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		return

	god_mode_start_scrollbar.modulate = Color(1.0, 1.0, 1.0, 0.0)
	god_mode_start_scrollbar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	god_mode_start_scrollbar.set_meta("god_mode_scrollbar_fade_state", "hidden")


func _fade_god_mode_scrollbar_to(target_alpha: float, duration: float) -> void:
	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		return

	var clean_alpha: float = clamp(target_alpha, 0.0, 1.0)
	var fade_state: String = "visible" if clean_alpha > 0.01 else "fading_out"

	if god_mode_scrollbar_fade_tween != null:
		god_mode_scrollbar_fade_tween.kill()
		god_mode_scrollbar_fade_tween = null

	god_mode_start_scrollbar.visible = true
	god_mode_start_scrollbar.mouse_filter = Control.MOUSE_FILTER_STOP if clean_alpha > 0.01 else Control.MOUSE_FILTER_IGNORE
	god_mode_start_scrollbar.set_meta("god_mode_scrollbar_fade_state", fade_state)

	god_mode_scrollbar_fade_tween = create_tween().bind_node(god_mode_start_scrollbar)
	god_mode_scrollbar_fade_tween.set_trans(Tween.TRANS_SINE)
	god_mode_scrollbar_fade_tween.set_ease(Tween.EASE_OUT)
	god_mode_scrollbar_fade_tween.tween_property(
		god_mode_start_scrollbar,
		"modulate",
		Color(1.0, 1.0, 1.0, clean_alpha),
		max(0.01, duration)
	)

	if clean_alpha <= 0.01:
		god_mode_scrollbar_fade_tween.tween_callback(Callable(self, "_on_god_mode_scrollbar_faded_out"))


func _on_god_mode_scrollbar_faded_out() -> void:
	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		return
	god_mode_start_scrollbar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	god_mode_start_scrollbar.set_meta("god_mode_scrollbar_fade_state", "hidden")


func _mark_god_mode_scrollbar_activity() -> void:
	god_mode_scrollbar_last_activity_ms = int(Time.get_ticks_msec())

	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		_bind_god_mode_scrollbar_after_layout()

	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		return

	_style_god_mode_scrollbar(god_mode_start_scrollbar)

	var current_modulate: Color = god_mode_start_scrollbar.modulate
	if current_modulate.a < 0.34:
		current_modulate.a = 0.34
		god_mode_start_scrollbar.modulate = current_modulate

	_fade_god_mode_scrollbar_to(1.0, 0.075)


func _on_god_mode_scrollbar_value_changed(value: float) -> void:
	if abs(value - god_mode_scrollbar_last_value) < 0.001:
		return

	god_mode_scrollbar_last_value = value
	_mark_god_mode_scrollbar_activity()


func _on_god_mode_scroll_container_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if mouse_event.pressed and mouse_event.button_index in [
			MOUSE_BUTTON_WHEEL_UP,
			MOUSE_BUTTON_WHEEL_DOWN,
			MOUSE_BUTTON_WHEEL_LEFT,
			MOUSE_BUTTON_WHEEL_RIGHT
		]:
			_mark_god_mode_scrollbar_activity()
	elif event is InputEventPanGesture:
		_mark_god_mode_scrollbar_activity()
	elif event is InputEventScreenDrag:
		_mark_god_mode_scrollbar_activity()


func _drive_god_mode_scrollbar_visibility(_delta: float) -> void:
	if god_mode_start_scroll_container == null or not is_instance_valid(god_mode_start_scroll_container):
		return

	if god_mode_start_scrollbar == null or not is_instance_valid(god_mode_start_scrollbar):
		_bind_god_mode_scrollbar_after_layout()
		return

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel) or not god_mode_start_panel.visible:
		_hide_god_mode_scrollbar_immediately()
		return

	if god_mode_scrollbar_last_activity_ms <= 0:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if now_ms - god_mode_scrollbar_last_activity_ms < MainSceneHelpers._god_mode_scrollbar_idle_fade_delay_ms():
		return

	var state: String = ""
	if god_mode_start_scrollbar.has_meta("god_mode_scrollbar_fade_state"):
		state = str(god_mode_start_scrollbar.get_meta("god_mode_scrollbar_fade_state"))

	if state == "fading_out" or state == "hidden":
		return

	_fade_god_mode_scrollbar_to(0.0, 0.22)


func _add_god_mode_header_action_button(parent: Container, button_text: String, min_width: int, min_height: int, font_size: int, visual_boost: float, pressed_callable: Callable, role: String = "") -> Button:
	var button:= Button.new()
	button.text = button_text
	button.scale = Vector2.ONE
	button.focus_mode = Control.FOCUS_ALL
	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.set_meta("god_mode_button_min_height", min_height)
	button.set_meta("god_mode_button_min_width", min_width)
	button.set_meta("god_mode_button_font_size", font_size)
	button.set_meta("god_mode_button_visual_boost", visual_boost)
	if role.strip_edges() != "":
		button.set_meta("god_mode_button_role", role)
	button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	if pressed_callable.is_valid():
		button.pressed.connect(pressed_callable)
	_style_god_mode_button(button, false)
	if parent != null and is_instance_valid(parent):
		parent.add_child(button)
	return button


func _style_god_mode_field_control(control: Control) -> void:
