func _queue_crown_war_projection_background(
		actor_id: int,
		reason: String = ""
) -> void:
		if actor_id <= 0:
			return

		var generation: int = int(
			get_meta(
				"crown_war_projection_generation",
				0
			)
		) + 1

		set_meta(
			"crown_war_projection_generation",
			generation
		)
		set_meta(
			"crown_war_projection_actor_id",
			actor_id
		)
		set_meta(
			"crown_war_projection_reason",
			reason
		)

		_arm_crown_war_projection_background_service(
			generation,
			0.032
		)

func _arm_crown_war_projection_background_service(
	generation: int,
	delay_seconds: float = 0.05
) -> void:
	if generation != int(
		get_meta(
			"crown_war_projection_generation",
			0
		)
	):
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_crown_war_projection_background",
			generation
		)
		return

	var timer:= tree.create_timer(
		maxf(
			0.032,
			delay_seconds
		)
	)

	timer.timeout.connect(
		Callable(
			self,
			"_service_crown_war_projection_background"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)
func _service_crown_war_projection_background(
	generation: int
) -> void:
	if generation != int(
		get_meta(
			"crown_war_projection_generation",
			0
		)
	):
		return

	if (
		gs == null
		or gs.player == null
		or crown_hub_active_contract.is_empty()
	):
		return

	var actor_id: int = int(
		gs.player.id
	)

	if actor_id != int(
		get_meta(
			"crown_war_projection_actor_id",
			-1
		)
	):
		return

	var quiet_window: Dictionary = (
		_crown_hub_background_residency_quiet_window_truth()
	)




	if not bool(
		quiet_window.get(
			"progressive_safe",
			false
		)
	):
		set_meta(
			"crown_war_projection_yielded_to_ui",
			true
		)

		_arm_crown_war_projection_background_service(
			generation,
			float(
				quiet_window.get(
					"retry_delay_seconds",
					0.064
				)
			)
		)
		return

	set_meta(
		"crown_war_projection_yielded_to_ui",
		false
	)
	set_meta(
		"crown_war_projection_pointer_motion_blocks_progress",
		false
	)
	set_meta(
		"crown_war_projection_interaction_grace_blocks_progress",
		false
	)

	var contract: Dictionary = (
		_request_resident_crown_war_quantum(
			gs.player,
			"mainscene.crown_war_background_quantum"
		)
	)

	if contract.is_empty():
		_arm_crown_war_projection_background_service(
			generation,
			0.032
		)
		return

	crown_hub_active_contract = (
		contract.duplicate(false)
	)
	crown_hub_active_actor_id = actor_id

	var published_entry: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"war_last_published_entry",
			{}
		)
	)

	if (
		not published_entry.is_empty()
		and crown_hub_open
		and crown_hub_current_section == "diplomacy"
	):
		_replace_crown_diplomacy_entry_live(
			published_entry
		)

	if bool(
		contract.get(
			"war_projection_complete",
			false
		)
	):
		if crown_hub_open:
			_refresh_crown_hub_chrome()

			if crown_hub_current_section == "war":
				_render_crown_war_section_from_contract()

		set_meta(
			"crown_war_projection_complete",
			true
		)
		return

	_arm_crown_war_projection_background_service(
		generation,
		0.032
	)
