func _schedule_crown_diplomacy_country_stream_chunk(
	generation: int
) -> void:
	if not _crown_diplomacy_stream_is_current(
		generation
	):
		return

	var tree:= get_tree()
	if tree == null:
		call_deferred(
			"_flush_crown_diplomacy_country_stream_chunk",
			generation
		)
		return



	var timer:= tree.create_timer(
		0.032,
		true,
		false,
		true
	)
	timer.timeout.connect(
		Callable(
			self,
			"_flush_crown_diplomacy_country_stream_chunk"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)
func _begin_crown_diplomacy_country_stream(
	permissions: Dictionary,
	generation: int
) -> void:
	if not _crown_diplomacy_stream_is_current(
		generation
	):
		return

	_clear_crown_diplomacy_stream_cards()



	var entries: Array = (
		_sort_crown_diplomacy_country_entries(
			_build_crown_diplomacy_country_entries()
		)
	)

	set_meta(
		"crown_diplomacy_stream_entries",
		entries
	)
	set_meta(
		"crown_diplomacy_stream_cursor",
		0
	)
	set_meta(
		"crown_diplomacy_stream_permissions",
		permissions.duplicate(false)
	)
	set_meta(
		"crown_diplomacy_stream_deep_copy_performed",
		false
	)
	set_meta(
		"crown_diplomacy_stream_global_sort_per_card",
		false
	)

	_ensure_crown_diplomacy_live_grid()

	if crown_hub_status_label != null:
		crown_hub_status_label.text = (
			(
				"Diplomacy: %d resident realm contracts are available. "
				+ "Additional realms publish live."
			)
			% entries.size()
		)

	if entries.is_empty():
		if crown_hub_status_label != null:
			crown_hub_status_label.text = (
				"Diplomacy: realm contracts are publishing live…"
			)
		set_meta(
			"crown_diplomacy_empty_contract_does_not_block_live_stream",
			true
		)
		return

	_schedule_crown_diplomacy_country_stream_chunk(
		generation
	)
func _flush_crown_diplomacy_country_stream_chunk(
	generation: int
) -> void:
	if not _crown_diplomacy_stream_is_current(
		generation
	):
		return

	var raw_entries: Variant = get_meta(
		"crown_diplomacy_stream_entries",
		[]
	)
	var entries: Array = (
		raw_entries as Array
		if typeof(raw_entries) == TYPE_ARRAY
		else []
	)

	var raw_permissions: Variant = get_meta(
		"crown_diplomacy_stream_permissions",
		{}
	)
	var permissions: Dictionary = (
		raw_permissions as Dictionary
		if typeof(raw_permissions) == TYPE_DICTIONARY
		else {}
	)

	var cursor: int = int(
		get_meta(
			"crown_diplomacy_stream_cursor",
			0
		)
	)
	if (
		entries.is_empty()
		or cursor >= entries.size()
	):
		return

	var raw_entry: Variant = entries [
		cursor
	]
	var published_entry: Dictionary = {}

	if typeof(raw_entry) == TYPE_DICTIONARY:
		published_entry = raw_entry as Dictionary
		_append_crown_country_diplomacy_row(
			published_entry,
			permissions
		)
		_apply_crown_diplomacy_stream_entry_visibility(
			published_entry
		)

	var end_index: int = cursor + 1
	set_meta(
		"crown_diplomacy_stream_cursor",
		end_index
	)



	if (
		crown_hub_status_label != null
		and (
			end_index % 8 == 0
			or end_index >= entries.size()
		)
	):
		crown_hub_status_label.text = (
			"Diplomacy: published %d/%d realm cards for %s."
			% [
				end_index,
				entries.size(),
				MainSceneLogic._crown_current_era_key(gs)
			]
		)

	if end_index < entries.size():
		_schedule_crown_diplomacy_country_stream_chunk(
			generation
		)
		return


	_apply_crown_diplomacy_filter_and_sort()

	if crown_hub_status_label != null:
		var visible_entries: Array = (
			_filter_crown_diplomacy_country_entries(
				entries
			)
		)
		crown_hub_status_label.text = (
			"Diplomacy: %d realms published • %d visible."
			% [
				entries.size(),
				visible_entries.size()
			]
		)

	set_meta(
		"crown_diplomacy_stream_complete",
		true
	)
	set_meta(
		"crown_diplomacy_stream_one_card_per_quantum",
		true
	)
	set_meta(
		"crown_diplomacy_stream_global_sort_per_card",
		false
	)
	set_meta(
		"crown_diplomacy_stream_build_on_card_press",
		false
	)
func _apply_crown_diplomacy_stream_entry_visibility(
	entry: Dictionary
) -> void:
	if entry.is_empty():
		return

	var entry_key: String = MainSceneHelpers._crown_diplomacy_entry_key(
		entry
	)

	if entry_key == "":
		return

	var packet_raw: Variant = (
		crown_hub_diplomacy_card_registry.get(
			entry_key,
			{}
		)
	)

	if typeof(
		packet_raw
	) != TYPE_DICTIONARY:
		return

	var packet: Dictionary = (
		packet_raw as Dictionary
	)

	packet [
		"entry"
	] = entry.duplicate(false)

	crown_hub_diplomacy_card_registry [
		entry_key
	] = packet

	_ensure_crown_you_rule_here_banner_for_card(
		packet
	)

	_sync_crown_diplomacy_population_rank_badge(
		packet
	)

	_sync_crown_diplomacy_population_text(
		packet,
		entry
	)

	var shell:= packet.get(
		"shell",
		null
	) as Control

	if (
		shell == null
		or not is_instance_valid(
			shell
		)
	):
		return

	var filtered: Array = (
		_filter_crown_diplomacy_country_entries(
			[
				entry
			]
		)
	)

	shell.visible = not filtered.is_empty()
func _apply_crown_diplomacy_population_rank_batch(
	rank_deltas: Array,
	rank_revision: String
) -> void:
	if rank_deltas.is_empty():
		return

	var stream_entries_raw: Variant = get_meta(
		"crown_diplomacy_stream_entries",
		[]
	)
	var stream_entries: Array = (
		(stream_entries_raw as Array).duplicate(false)
		if typeof(stream_entries_raw) == TYPE_ARRAY
		else []
	)

	var changed_keys: Dictionary = {}

	for raw_delta in rank_deltas:
		if typeof(raw_delta) != TYPE_DICTIONARY:
			continue

		var delta: Dictionary = (
			raw_delta as Dictionary
		)
		var entry_key: String = (
			MainSceneHelpers._crown_diplomacy_entry_key(
				delta
			)
		)
		if entry_key == "":
			continue

		changed_keys [
			entry_key
		] = true

		for index in range(
			stream_entries.size()
		):
			var existing_raw: Variant = (
				stream_entries [
					index
				]
			)
			if typeof(existing_raw) != TYPE_DICTIONARY:
				continue

			var existing: Dictionary = (
				existing_raw as Dictionary
			)
			if MainSceneHelpers._crown_diplomacy_entry_key(
				existing
			) != entry_key:
				continue

			stream_entries [
				index
			] = delta.duplicate(false)
			break

		var packet_raw: Variant = (
			crown_hub_diplomacy_card_registry.get(
				entry_key,
				{}
			)
		)
		if typeof(packet_raw) != TYPE_DICTIONARY:
			continue

		var packet: Dictionary = (
			packet_raw as Dictionary
		)
		packet ["entry"] = delta.duplicate(false)
		crown_hub_diplomacy_card_registry [
			entry_key
		] = packet

		_sync_crown_diplomacy_population_rank_badge(
			packet
		)
		_sync_crown_diplomacy_population_text(
			packet,
			delta
		)

	set_meta(
		"crown_diplomacy_stream_entries",
		stream_entries
	)
	set_meta(
		"crown_diplomacy_population_rank_revision",
		rank_revision
	)
	set_meta(
		"crown_diplomacy_population_rank_changed_cards",
		changed_keys.size()
	)
	set_meta(
		"crown_diplomacy_population_rank_card_rebuilds",
		0
	)
	set_meta(
		"crown_diplomacy_population_rank_engine_calls_in_renderer",
		false
	)



	_apply_crown_diplomacy_filter_and_sort()
func _sync_crown_diplomacy_population_text(
	packet: Dictionary,
	entry: Dictionary
) -> void:
	if (
		packet.is_empty()
		or entry.is_empty()
	):
		return

	var card:= packet.get(
		"card",
		null
	) as PanelContainer

	if (
		card == null
		or not is_instance_valid(
			card
		)
		or card.get_child_count() <= 0
	):
		return

	var margin:= card.get_child(
		0
	) as MarginContainer

	if (
		margin == null
		or margin.get_child_count() <= 0
	):
		return

	var root:= margin.get_child(
		0
	) as VBoxContainer

	if root == null:
		return

	var population_value: int = int(
		entry.get(
			"population",
			0
		)
	)

	var treasury_value: int = int(
		entry.get(
			"treasury",
			0
		)
	)

	var military_value: int = int(
		entry.get(
			"military_stockpile",
			0
		)
	)

	var goods_value: int = int(
		entry.get(
			"goods_stockpile",
			0
		)
	)

	var land_value: int = int(
		entry.get(
			"land_display_value",
			entry.get(
				"land_km2",
				entry.get(
					"land_area_km2",
					0
				)
			)
		)
	)

	var land_unit: String = str(
		entry.get(
			"land_display_unit",
			"km²"
		)
	).strip_edges()

	if land_unit == "":
		land_unit = "km²"

	var currency_name: String = str(
		entry.get(
			"currency_name",
			""
		)
	)

	for raw_child in root.get_children():
		if not raw_child is Label:
			continue

		var label: Label = (
			raw_child as Label
		)

		if not str(
			label.tooltip_text
		).begins_with(
			"Population:"
		):
			continue

		label.text = (
			"Population: %s • Treasury: %s\n"
			+ "Military: %s • Goods: %s • Land: %s %s"
		) % [
			_crown_diplomacy_card_number(
				population_value
			),
			_crown_diplomacy_card_treasury_label(
				treasury_value,
				currency_name
			),
			_crown_diplomacy_card_number(
				military_value
			),
			_crown_diplomacy_card_number(
				goods_value
			),
			_crown_diplomacy_card_number(
				land_value
			),
			land_unit
		]

		label.tooltip_text = (
			"Population: %s\n"
			+ "Treasury: %s\n"
			+ "Military: %s\n"
			+ "Goods: %s\n"
			+ "Land: %s %s"
		) % [
			MainSceneHelpers._crown_exact_number(
				population_value
			),
			MainSceneLogic._format_crown_exact_treasury_label(gs, 
				treasury_value,
				currency_name
			),
			MainSceneHelpers._crown_exact_number(
				military_value
			),
			MainSceneHelpers._crown_exact_number(
				goods_value
			),
			MainSceneHelpers._crown_exact_number(
				land_value
			),
			land_unit
		]

		break
func _start_crown_diplomacy_population_rank_watch(
	actor_id: int
) -> void:
	if actor_id <= 0:
		return

	crown_diplomacy_population_rank_watch_generation += 1
	crown_diplomacy_population_rank_watch_actor_id = actor_id
	crown_diplomacy_population_rank_watch_active = true

	set_meta(
		"crown_diplomacy_population_rank_watch_world_year",
		(
			int(
				gs.year
			)
			if gs != null
			else -2147483648
		)
	)

	set_meta(
		"crown_diplomacy_population_rank_watch_full_rank_polling",
		false
	)

	_schedule_crown_diplomacy_population_rank_watch(
		crown_diplomacy_population_rank_watch_generation,
		0.75
	)

func _schedule_crown_diplomacy_population_rank_watch(
	generation: int,
	delay_seconds: float
) -> void:
	if (
		not crown_diplomacy_population_rank_watch_active
		or generation
		!= crown_diplomacy_population_rank_watch_generation
	):
		return

	var tree:= get_tree()
	if tree == null:
		call_deferred(
			"_service_crown_diplomacy_population_rank_watch",
			generation
		)
		return

	var timer:= tree.create_timer(
		maxf(
			0.25,
			delay_seconds
		)
	)
	timer.timeout.connect(
		Callable(
			self,
			"_service_crown_diplomacy_population_rank_watch"
		).bind(
			generation
		),
		CONNECT_ONE_SHOT
	)


func _service_crown_diplomacy_population_rank_watch(
	generation: int
) -> void:
	if (
		not crown_diplomacy_population_rank_watch_active
		or generation
		!= crown_diplomacy_population_rank_watch_generation
	):
		return

	if (
		gs == null
		or gs.player == null
		or int(
			gs.player.id
		) != crown_diplomacy_population_rank_watch_actor_id
	):
		crown_diplomacy_population_rank_watch_active = false
		return

	var actor_id: int = int(
		gs.player.id
	)
	var current_world_year: int = int(
		gs.year
	)

	var last_rank_world_year: int = int(
		get_meta(
			"crown_diplomacy_population_rank_watch_world_year",
			current_world_year
		)
	)

	if current_world_year == last_rank_world_year:


		_schedule_crown_diplomacy_population_rank_watch(
			generation,
			(
				0.75
				if crown_hub_open
				else 2.5
			)
		)
		return




	if (
		_ui_interaction_grace_active(
			int(
				Time.get_ticks_msec()
			)
		)
		or panel_content_transition_active
	):
		_schedule_crown_diplomacy_population_rank_watch(
			generation,
			0.12
		)
		return

	set_meta(
		"crown_diplomacy_population_rank_watch_world_year",
		current_world_year
	)
	var report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"intent_type": (
					"resident_crown_diplomacy_population_rank_refresh"
				),
				"surface_id": "crown_hub",
				"action_id": (
					"service_resident_diplomacy_population_rank_refresh"
				),
				"immutable_contract_references": true,
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true,
				"background_only": true,
				"blocks_ui": false,
				"ui_safe_microtask": false,
				"ready_gate_member": false,
				"payload": {
					"actor_id": actor_id,
					"source": (
						"mainscene."
						+ "crown_diplomacy_population_rank_watch"
					),
					"background_only": true,
					"blocks_ui": false,
					"ready_gate_member": false,
					"ui_is_renderer_only": true
				},
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"crown_hub_contract_engine"
					),
					"method": (
						"service_resident_diplomacy_population_rank_refresh"
					),
					"pass_actor_payload": true,
					"actor_id": actor_id
				},
				"source": (
					"mainscene."
					+ "crown_diplomacy_population_rank_watch"
				),
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"surface_id": "crown_hub",
				"action_id": (
					"service_resident_diplomacy_population_rank_refresh"
				),
				"source": (
					"mainscene."
					+ "crown_diplomacy_population_rank_watch"
				),
				"ephemeral_infrastructure_intent": true,
				"skip_global_intent_persistence": true,
				"skip_crr_observation": true,
				"authority_prevalidated": true,
				"skip_checks_and_balances": true,
				"background_only": true,
				"blocks_ui": false,
				"ui_safe_microtask": false,
				"ready_gate_member": false,
				"ui_is_expression_only": true
			}
		)
	)

	var route_result: Dictionary = (
		_crown_hub_contract_route_result(
			report
		)
	)

	if not route_result.is_empty():
		var contract_raw: Variant = route_result.get(
			"crown_hub_contract",
			{}
		)
		if typeof(contract_raw) == TYPE_DICTIONARY:
			var contract: Dictionary = (
				contract_raw as Dictionary
			)
			if not contract.is_empty():
				crown_hub_active_contract = (
					contract.duplicate(false)
				)

		var rank_revision: String = str(
			route_result.get(
				"population_rank_revision",
				""
			)
		)
		var rank_deltas_raw: Variant = route_result.get(
			"population_rank_deltas",
			[]
		)
		var rank_deltas: Array = (
			rank_deltas_raw as Array
			if typeof(rank_deltas_raw) == TYPE_ARRAY
			else []
		)

		if (
			bool(
				route_result.get(
					"population_rank_changed",
					false
				)
			)
			and not rank_deltas.is_empty()
		):
			_apply_crown_diplomacy_population_rank_batch(
				rank_deltas,
				rank_revision
			)

		if rank_revision != "":
			crown_diplomacy_population_rank_revision = (
				rank_revision
