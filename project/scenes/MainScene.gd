func _build_era_surface_panel_style(
	surface_kind: String,
	is_hovered: bool = false,
	pulse_strength: float = 0.0,
	danger_state: bool = false
) -> StyleBoxFlat:
	var theme_key: String = _current_era_ui_theme_key()
	var data: Dictionary = MainSceneHelpers._era_surface_theme_data(theme_key, surface_kind)
	var style:= StyleBoxFlat.new()
	var bg: Color = data ["hover_bg"] if is_hovered else data ["bg"]
	var border_color: Color = data ["hover_border"] if is_hovered else data ["border"]
	var glow_color: Color = data ["hover_glow"] if is_hovered else data ["glow"]
	var glow_size: int = int(data ["hover_glow_size"] if is_hovered else data ["glow_size"])
	var material_phase: float = _current_ui_material_phase()

	if surface_kind == "player_stats" and danger_state:
		bg = bg.lerp(Color(0.28, 0.13, 0.18, bg.a), 0.1 + pulse_strength * 0.1)

	if pulse_strength > 0.0:
		glow_color.a = clamp(glow_color.a + pulse_strength * 0.05, 0.0, 1.0)
		glow_size += int(round(pulse_strength * 3.0))

	if surface_kind == "player_stats" and danger_state:
		glow_color = glow_color.lerp(Color(1.0, 0.35, 0.35, glow_color.a), 0.18)
		glow_size += 2

	if surface_kind == "player_stats":
		if _player_has_all_infinity_stones_artifact_set():
			var cosmic_flow: float = clamp(
				0.52
				+ (sin(material_phase * 1.65) * 0.18)
				+ (sin(material_phase * 3.9 + 0.85) * 0.08),
				0.0,
				1.0
			)
			bg = bg.lerp(Color(0.18, 0.14, 0.28, bg.a), 0.08 + cosmic_flow * 0.06)
			glow_color = glow_color.lerp(Color(0.78, 0.72, 1.0, glow_color.a), 0.26 + cosmic_flow * 0.18)
			glow_color = glow_color.lerp(Color(0.62, 0.94, 1.0, glow_color.a), 0.12 * cosmic_flow)
			glow_color.a = clamp(glow_color.a + 0.08 + cosmic_flow * 0.08, 0.0, 1.0)
			glow_size += 3 + int(round(cosmic_flow * 4.0))

		if MainSceneLogic._player_has_red_bonnet_artifact(gs):
			var bonnet_shimmer: float = clamp(
				0.5
				+ (sin(material_phase * 2.15) * 0.2)
				+ (sin(material_phase * 5.4 + 0.4) * 0.08),
				0.0,
				1.0
			)
			bg = bg.lerp(Color(0.24, 0.1, 0.11, bg.a), 0.06 + bonnet_shimmer * 0.06)
			border_color = border_color.lerp(Color(1.0, 0.4, 0.34, border_color.a), 0.22 + bonnet_shimmer * 0.2)
			glow_color = glow_color.lerp(Color(1.0, 0.18, 0.2, glow_color.a), 0.22 + bonnet_shimmer * 0.22)
			glow_color.a = clamp(glow_color.a + 0.08 + bonnet_shimmer * 0.1, 0.0, 1.0)
			glow_size += 2 + int(round(bonnet_shimmer * 3.0))

		if MainSceneLogic._player_has_infinity_gauntlet_artifact(gs):
			var gauntlet_shimmer: float = clamp(
				0.54
				+ (sin(material_phase * 2.95) * 0.24)
				+ (sin(material_phase * 7.1 + 0.62) * 0.1),
				0.0,
				1.0
			)
			border_color = border_color.lerp(Color(1.0, 0.84, 0.44, border_color.a), 0.18 + gauntlet_shimmer * 0.2)
			glow_color = glow_color.lerp(Color(1.0, 0.86, 0.42, glow_color.a), 0.2 + gauntlet_shimmer * 0.2)
			glow_color.a = clamp(glow_color.a + 0.06 + gauntlet_shimmer * 0.1, 0.0, 1.0)
			glow_size += 2 + int(round(gauntlet_shimmer * 3.0))

	match theme_key:
		"ancient":
			var dust_flicker: float = clamp(
				0.55
				+ (sin(material_phase * 1.3) * 0.1)
				+ (sin(material_phase * 4.4 + 0.85) * 0.06),
				0.0,
				1.0
			)
			bg = bg.lerp(Color(0.58, 0.46, 0.34, bg.a), 0.04 * dust_flicker)
			border_color = border_color.lerp(Color(1.0, 0.88, 0.68, border_color.a), 0.1 * dust_flicker)
			glow_color = glow_color.lerp(Color(1.0, 0.82, 0.56, glow_color.a), 0.12 * dust_flicker)
			glow_color.a = clamp(glow_color.a + 0.01 * dust_flicker, 0.0, 1.0)
			glow_size += int(round(dust_flicker))
		"medieval":
			if is_hovered:
				var sheen: float = _current_ui_material_pulse(2.4, 0.6)
				bg = bg.lerp(Color(0.3, 0.32, 0.36, bg.a), 0.06 * sheen)
				border_color = border_color.lerp(Color(1.0, 1.0, 1.0, 0.46), 0.42 * sheen)
				glow_color = glow_color.lerp(Color(0.96, 0.99, 1.0, glow_color.a), 0.3 * sheen)
				glow_color.a = clamp(glow_color.a + 0.03 * sheen, 0.0, 1.0)
				glow_size += int(round(2.0 * sheen))
		"future":
			if surface_kind == "player_stats":
				var energy_flow: float = _current_ui_material_pulse(2.1, 1.1)
				glow_color = glow_color.lerp(Color(0.72, 1.0, 1.0, glow_color.a), 0.16 * energy_flow)
				glow_color.a = clamp(glow_color.a + 0.02 * energy_flow, 0.0, 1.0)

	style.bg_color = bg
	var radius: int = int(data.get("radius", 14))
	style.corner_radius_top_left = radius
	style.corner_radius_top_right = radius
	style.corner_radius_bottom_right = radius
	style.corner_radius_bottom_left = radius
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.border_color = border_color











	var shadow_size_budget: int = (
		18
		if surface_kind == "player_stats"
		else 14
	)

	glow_size = mini(
		glow_size,
		shadow_size_budget
	)

	style.shadow_color = glow_color
	style.shadow_size = glow_size
	style.shadow_offset = Vector2(
		0,
		0
	)
	var margin: int = int(data.get("margin", 8))
	style.content_margin_left = margin
	style.content_margin_top = margin
	style.content_margin_right = margin
	style.content_margin_bottom = margin
	return style
func _build_era_background_fill_color() -> Color:
	if _god_mode_ui_locked():
		return Color(
			0.1,
			0.06,
			0.16,
			1.0
		)

	var theme_key: String = (
		_current_era_ui_theme_key()
	)

	match theme_key:
		"ancient":
			return Color(
				0.21,
				0.16,
				0.11,
				1.0
			)

		"industrial":
			return Color(
				0.12,
				0.105,
				0.085,
				1.0
			)

		"medieval":
			return Color(
				0.08,
				0.1,
				0.14,
				1.0
			)

		"future":
			return Color(
				0.05,
				0.08,
				0.11,
				1.0
			)

		_:
			return Color(
				0.1,
				0.16,
				0.28,
				1.0
			)


func _refresh_era_background_fill() -> void:
	var ui_root:= self as Control
	if ui_root == null:
		return

	var bg:= ui_root.get_node_or_null("__EraBackgroundFill") as ColorRect
	if bg == null:
		bg = ColorRect.new()
		bg.name = "__EraBackgroundFill"
		bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bg.z_index = -100
		bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		ui_root.add_child(bg)
		ui_root.move_child(bg, 0)

	bg.color = _build_era_background_fill_color()
	bg.visible = true

