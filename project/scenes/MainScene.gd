func _relationship_hub_apply_mini_stat_surface_content(title_label: Label, flavor_label: Label, bar: ProgressBar, title: String, value: int, max_value: int, surface_context: Dictionary) -> void:
	if bar == null:
		return

	var safe_title: String = str(title).strip_edges()
	if safe_title == "":
		return

	var title_key: String = safe_title.capitalize()
	if safe_title.to_upper() == "BOND":
		title_key = "Bond"
	elif safe_title.to_upper() == "HEALTH":
		title_key = "Health"

	var safe_max: int = max(1, int(max_value))
	var safe_value: int = clamp(int(value), 0, safe_max)
	var effective_surface_context: Dictionary = surface_context.duplicate(true) if typeof(surface_context) == TYPE_DICTIONARY else {}

	effective_surface_context ["relationship_card_stat_header_mode"] = "centered_label_descriptor_subtext"
	effective_surface_context ["numbers_live_inside_bars_only"] = true
	if title_key == "Bond":
		effective_surface_context ["narrative_perspective"] = "third_person"
		effective_surface_context ["descriptor_title_mode"] = "bond_pov"
		effective_surface_context ["bond_object_label"] = "you"
		effective_surface_context ["bond_object_possessive"] = "your"
		effective_surface_context ["relationship_card_labels_are_contract_owned"] = true
	bar.set_meta("stat_surface_title", title_key)
	bar.set_meta("stat_surface_context", effective_surface_context)

	var centered_relationship_card: bool = str(effective_surface_context.get("relationship_card_stat_header_mode", "")).strip_edges().to_lower() == "centered_label_descriptor_subtext"
	var resolved: Dictionary = {}

	if centered_relationship_card:
		resolved = MainSceneLogic._resolve_player_stat_surface(title_key, safe_value, safe_max, effective_surface_context)
	else:
		var surface_family: String = str(effective_surface_context.get("surface_family", "")).strip_edges()
		if surface_family == "realm_overview":
			resolved = MainSceneHelpers._resolve_realm_stat_surface(title_key, safe_value, safe_max, effective_surface_context)
		elif surface_family == "institution_hub":
			resolved = MainSceneHelpers._resolve_institution_hub_stat_surface(title_key, safe_value, safe_max, effective_surface_context)
		else:
			resolved = MainSceneLogic._resolve_player_stat_surface(title_key, safe_value, safe_max, effective_surface_context)

	var descriptor: String = str(resolved.get("descriptor", "")).strip_edges()
	var flavor: String = str(resolved.get("flavor", "")).strip_edges()

	if centered_relationship_card:
		var title_text: String = str(resolved.get("title_text", "")).strip_edges()
		if title_text == "":
			title_text = MainSceneHelpers._resolve_player_stat_surface_title(title_key, descriptor, effective_surface_context)

		if title_label != null:
			title_label.text = title_text
			title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

		if flavor_label != null:
			flavor_label.text = flavor
			flavor_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			flavor_label.visible = flavor != ""

		_refresh_player_stat_bar_value_text(bar, safe_value, safe_max, title_key)
		return

	var fallback_title_text: String = str(resolved.get("title_text", "")).strip_edges()
	if fallback_title_text == "":
		fallback_title_text = MainSceneHelpers._resolve_player_stat_surface_title(title_key, descriptor, effective_surface_context)

	if title_label != null:
		title_label.text = fallback_title_text

	if flavor_label != null:
		flavor_label.text = flavor
		flavor_label.visible = flavor != ""

	_refresh_player_stat_bar_value_text(bar, safe_value, safe_max, title_key)
func _relationship_hub_add_preview_bar(parent: Control, title_text: String, fill_color: Color, featured: bool = false, max_value: int = 100, surface_context: Dictionary = {}, target_value: int = 0) -> Dictionary:
	var safe_max: int = max(1, int(max_value))
