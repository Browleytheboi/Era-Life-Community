func _show_belonging_item_popup(item: Dictionary, category: String) -> void:
	current_panel = ""

	if standard_tab_popup_open:
		_hide_standard_tab_popup()
	if activities_action_open:
		_hide_activities_action_panel()
	if world_feed_popup_open:
		_hide_world_action_panel()
	if profile_panel_popup != null and profile_panel_popup.visible:
		_hide_profile_panel_popup()
	if relationship_profile_popup_open:
		_hide_relationship_profile_popup()
	if relationships_browser_open:
		_hide_relationship_browser()

	_ensure_belonging_item_popup()
	if belongings_item_popup == null or belongings_item_popup_dim == null:
		return

	var item_name: String = str(item.get("name", "Unnamed Item")).strip_edges()
	if item_name == "":
		item_name = "Unnamed Item"

	var item_type: String = str(item.get("type", "Item")).strip_edges()
	if item_type == "":
		item_type = "Item"

	belongings_item_popup_current_item = item.duplicate(true)
	belongings_item_popup_current_category = category
	belongings_item_popup_title.text = item_name
	belongings_item_popup_subtitle.text = "%s • %s" % [category, item_type]
	belongings_item_popup_body.text = _build_belonging_item_popup_text(item, category)
	_apply_belonging_item_popup_visual_state(belongings_item_popup_current_item, 0.0)

	var added_action_section: bool = false
	if belongings_item_popup_actions_box != null:
		_clear_container_children(belongings_item_popup_actions_box)

	if MainSceneHelpers._belonging_item_is_food(item, category) and belongings_item_popup_actions_box != null:
		var food_section:= Label.new()
		food_section.text = "Food Actions"
		food_section.add_theme_color_override("font_color", Color(1.0, 0.82, 0.54, 1.0))
		belongings_item_popup_actions_box.add_child(food_section)
		added_action_section = true

		_add_belonging_food_action_button(belongings_item_popup_actions_box, "Consume", item, category, "consume")
		_add_belonging_food_action_button(belongings_item_popup_actions_box, "Give To", item, category, "give_to")
		_add_belonging_food_action_button(belongings_item_popup_actions_box, "Share & Consume", item, category, "share_consume")
		_add_belonging_food_action_button(belongings_item_popup_actions_box, "Throw Away", item, category, "throw_away")

	if (
		category == "Artifacts"
		and belongings_item_popup_actions_box != null
	):
		var action_specs: Array = MainSceneHelpers._safe_array(
			item.get(
				"artifact_action_specs",
				[]
			)
		)

		if not action_specs.is_empty():
			var section:= Label.new()
			section.text = "Actions"
			section.add_theme_color_override("font_color", MainSceneHelpers._artifact_item_color(item))
			belongings_item_popup_actions_box.add_child(section)
			added_action_section = true

		for action_spec_value in action_specs:
			if typeof(action_spec_value) != TYPE_DICTIONARY:
				continue

			var action_spec: Dictionary = (
				action_spec_value as Dictionary
			).duplicate(true)
			var action_name: String = str(
				action_spec.get(
					"label",
					""
				)
			).strip_edges()

			if action_name == "":
				continue

			var btn:= Button.new()
			btn.text = action_name
			btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			btn.custom_minimum_size = Vector2(0, 42)
			btn.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
			btn.add_theme_stylebox_override("normal", MainSceneLogic._build_artifact_button_style(item, 0.38, false))
