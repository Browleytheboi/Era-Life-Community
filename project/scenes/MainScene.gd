	var hunger_value: int = _player_stats_hunger_value(p)
	var looks_value: int = max(0, int(round(float(p.looks))))
	var smarts_value: int = max(0, int(round(float(p.smarts))))
	var mental_value: int = max(0, int(round(float(p.mental_health))))
