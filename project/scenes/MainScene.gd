func _sync_birth_year_text_state(raw_text: String) -> void:
	if custom_birth_ui_syncing:
		return

	_mark_god_mode_reality_shape_changed("birth_year_text_changed")

	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return
	var parsed:= MainSceneHelpers._parse_birth_year_text(raw_text)
	custom_birth_ui_syncing = true
	if not bool(parsed.get("valid", false)):
		_populate_era_picker("", true)
		MainSceneHelpers._set_option_button_blank(custom_country_picker)
		MainSceneHelpers._set_option_button_blank(custom_city_picker)
		custom_birth_ui_syncing = false
		_refresh_god_mode_preview_label()
		_refresh_god_mode_start_button_state()
		_refresh_god_mode_palette_from_current_state(false)
		return
	var parsed_year: int = int(parsed.get("year", 0))
	custom_year_spin.value = parsed_year
	var era_key: String = era_engine.get_era_key_from_year(parsed_year)
	_populate_era_picker(era_key, false)
	var current_day:= MainSceneHelpers._selected_god_mode_option_value(custom_day_spin, 1)
	_populate_god_mode_day_picker(current_day)
	custom_birth_ui_syncing = false
	_refresh_birth_location_pickers("", "", false)
	_refresh_god_mode_preview_label()
	_refresh_god_mode_start_button_state()


func _on_custom_year_text_changed(new_text: String) -> void:
	_sync_birth_year_text_state(new_text)

func _get_ui_era_engine() -> EraEngine:
	if gs == null:
		return null

	if gs.era_engine != null:
		return gs.era_engine

	if ui_era_engine == null:
		ui_era_engine = EraEngine.new(gs)

	return ui_era_engine
func _era_keys_for_picker() -> Array:
	var ordered_supported: Array = ["Ancient", "Medieval", "Industrial", "Modern", "Future"]
	var keys: Array = []

	var era_engine:= _get_ui_era_engine()
	if era_engine == null:
		return ordered_supported.duplicate()

	for key in ordered_supported:
		if era_engine.eras.has(key):
			keys.append(key)

	if keys.is_empty():
		keys = ordered_supported.duplicate()

	return keys


func _selected_era_key() -> String:
	if custom_era_picker == null or custom_era_picker.item_count == 0:
		return str(gs.custom_settings.get("era", "Ancient"))

	var idx:= custom_era_picker.get_selected_id()
	if idx < 0:
		idx = 0

	return custom_era_picker.get_item_text(idx)


func _selected_country_text() -> String:
	if custom_country_picker == null or custom_country_picker.item_count == 0:
		return ""

	var idx:= custom_country_picker.get_selected_id()
	if idx < 0:
		idx = 0

	var text:= custom_country_picker.get_item_text(idx)
	if text == "Any Country":
		return ""

	return text


func _selected_city_text() -> String:
	if custom_city_picker == null or custom_city_picker.item_count == 0:
		return ""

	var idx:= custom_city_picker.get_selected_id()
	if idx < 0:
