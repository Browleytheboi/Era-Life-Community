func _prewarm_persistent_child_surface_shells(
	reason: String = "persistent_child_surface_shells"
) -> Dictionary:
	_ensure_assets_panel()
	_ensure_property_market_panel()
	_ensure_vehicle_market_panel()
	_ensure_relationship_profile_panel()
	_ensure_modification_panel()
	_ensure_career_panel()
	_ensure_career_hub_panel()
	_ensure_artifact_shop_panel()
	_ensure_action_result_popup()
	_ensure_crown_hub_overlay()
	_ensure_crown_action_popup()

	var surface_rows: Array = [
		assets_panel,
		property_market_panel,
		vehicle_market_panel,
		relationship_profile_panel,
		modification_panel,
		artifact_shop_panel,
		career_panel,
		career_hub_panel,
		action_result_popup,
		crown_hub_overlay,
		crown_action_popup
	]
	var hot_count: int = 0

	for raw_surface in surface_rows:
		var surface: Control = raw_surface as Control

		if (
			surface == null
			or not is_instance_valid(surface)
		):
			continue

		surface.visible = false
		surface.mouse_filter = Control.MOUSE_FILTER_IGNORE
		surface.process_mode = Node.PROCESS_MODE_INHERIT
		surface.set_meta(
			"persistent_child_surface_shell_hot",
			true
		)
		surface.set_meta(
			"persistent_child_surface_shell_reason",
			reason
		)
		surface.set_meta(
			"persistent_child_surface_shell_hot_at_ms",
			int(Time.get_ticks_msec())
		)
		hot_count += 1

	var success: bool = hot_count == surface_rows.size()

	set_meta(
		"persistent_child_surface_shells_hot",
		success
	)
	set_meta(
		"persistent_child_surface_shells_hot_count",
		hot_count
	)
	set_meta(
		"persistent_child_surface_shells_reason",
		reason
	)
	set_meta(
		"persistent_child_surface_shells_ready_gate_member",
		false
	)

	return {
		"success": success,
		"hot_count": hot_count,
		"required_count": surface_rows.size(),
		"click_path_build_forbidden": true,
		"ready_gate_member": false,
		"ui_is_renderer_only": true
	}
func _open_main_tab_cache_only_if_required(panel_id: String, reason: String = "main_tab_button") -> bool:
	var now_ms: int = int(Time.get_ticks_msec())
	if not _playable_life_shell_input_must_use_cached_tab_packets(now_ms):
		return false

	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	if clean_panel == "":
		return false

	var opened: bool = _open_main_tab_zero_frame_door(clean_panel, "%s_cache_only" % reason)

	set_meta("main_tab_cache_only_used_zero_frame_native_door", true)
	set_meta("main_tab_cache_only_panel", clean_panel)
	set_meta("main_tab_cache_only_generic_shell_forbidden", true)
	set_meta("main_tab_cache_only_packet_render_forbidden_on_press", true)
	set_meta("main_tab_cache_only_shell_chrome_restore_forbidden", true)
	set_meta("main_tab_cache_only_reconcile_deferred_until_idle", true)
	set_meta("main_tab_cache_only_direct_prewarm_forbidden", true)

	if opened:
		call_deferred("_schedule_main_tab_background_packet_reconcile", clean_panel, "%s_cache_only_idle_reconcile" % reason, 1.25)
	else:
		_request_native_main_tab_surface_prewarm_idle(clean_panel, "%s_cache_only_missing_real_surface" % reason)

	return opened
func _render_incarceration_tab_if_needed(
		tab_name: String,
		reason: String = "incarceration_tab"
) -> bool:
	var lens: Dictionary = (
		_controlled_actor_incarceration_lens_contract()
	)

	if not bool(
		lens.get(
			"active",
			false
		)
	):
		return false

	var clean_tab: String = str(
		tab_name
	).strip_edges().to_lower()

	if clean_tab not in [
		"world",
		"life",
		"school",
		"activities",
		"relationships",
		"career"
	]:
		return false

	match clean_tab:
		"world":
			return _open_world_tab_shell_immediate(
				"%s_facility_reveal"
				% reason
			)

		"life":
			return _open_life_diary_native_surface(
				"%s_sentence_reveal"
				% reason
			)

		"school":
			return _open_institution_tab_zero_frame_door(
				"school",
				school_hub_active_section_id,
				"%s_programs_reveal"
				% reason
			)

		"activities":
			return _open_activities_hub_zero_frame_door(
				"%s_yard_reveal"
				% reason
			)

		"relationships":
			return _open_institution_tab_zero_frame_door(
				"relationships",
				relationships_hub_active_section_id,
				"%s_inmates_reveal"
				% reason
			)

		"career":
			return _open_career_hub_zero_frame_door(
				"%s_prison_work_reveal"
				% reason
			)

		_:
			return false


func _install_incarceration_resident_surfaces(
		contract: Dictionary
) -> void:
	if contract.is_empty():
		return

	if (
		gs == null
		or gs.player == null
	):
		return

	var actor_id: int = int(
		contract.get(
			"actor_id",
			-1
		)
	)
	var controlled_actor_id: int = int(
		gs.player.id
	)




	if (
		actor_id <= 0
		or actor_id != controlled_actor_id
	):
		set_meta(
			"incarceration_resident_surface_stale_actor_rejected",
			true
		)
		set_meta(
			"incarceration_resident_surface_packet_actor_id",
			actor_id
		)
		set_meta(
			"incarceration_resident_surface_controlled_actor_id",
			controlled_actor_id
		)
		set_meta(
			"incarceration_resident_surface_stale_actor_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	if not bool(
		contract.get(
			"active",
			false
		)
	):
		return




	var facility_surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"facility_surface_contract",
			{}
		)
	)
	var sentence_surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"sentence_surface_contract",
			{}
		)
	)
	var nearby_prisoner_cards: Array = MainSceneHelpers._safe_array(
		contract.get(
			"nearby_prisoner_cards",
			[]
		)
	)
	var other_facility_cards: Array = MainSceneHelpers._safe_array(
		contract.get(
			"other_facility_cards",
			[]
		)
	)

	_install_incarceration_native_facility_surface(
		facility_surface_contract
	)
	_install_incarceration_native_sentence_surface(
		sentence_surface_contract
	)
	_install_incarceration_nearby_surface(
		nearby_prisoner_cards
	)
	_install_incarceration_other_facilities_surface(
		other_facility_cards
	)







	var surface_contracts: Dictionary = MainSceneHelpers._safe_dictionary(
		contract.get(
			"surface_contracts",
			{}
		)
	)

	var compact_incarceration_lens: Dictionary = {
		"schema": "eralife.incarceration_lens_contract",
		"version": int(
			contract.get(
				"version",
				2
			)
		),
		"actor_id": actor_id,
		"active": true,
		"incarceration_kind": str(
			contract.get(
				"incarceration_kind",
				""
			)
		),
		"navigation_labels": MainSceneHelpers._safe_dictionary(
			contract.get(
				"navigation_labels",
				{}
			)
		),
		"facility": MainSceneHelpers._safe_dictionary(
			contract.get(
				"facility",
				{}
			)
		),
		"sentence": MainSceneHelpers._safe_dictionary(
			contract.get(
				"sentence",
				{}
			)
		),
		"facility_surface_contract": (
			facility_surface_contract.duplicate(false)
		),
		"sentence_surface_contract": (
			sentence_surface_contract.duplicate(false)
		),
		"nearby_prisoner_cards": (
			nearby_prisoner_cards.duplicate(false)
		),
		"other_facility_cards": (
			other_facility_cards.duplicate(false)
		),
		"truth_state": str(
			contract.get(
				"truth_state",
				"hot"
			)
		),
		"projection_complete": bool(
			contract.get(
				"projection_complete",
				true
			)
		),
		"observation_required": false,
		"ui_is_renderer_only": true
	}

	var install_signature: String = str(
		reality_residency_attached_signature
	).strip_edges()

	if install_signature == "":
		install_signature = str(
			get_meta(
				"god_mode_life_prewarm_signature",
				""
			)
		).strip_edges()

	var routed_surface_count: int = 0
	var cached_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var cached_contracts: Dictionary = (
		(
			cached_contracts_raw as Dictionary
		).duplicate(false)
		if typeof(
			cached_contracts_raw
		) == TYPE_DICTIONARY
		else {}
	)

	for raw_surface_id in [
		"relationships",
		"school",
		"activities",
		"career"
	]:
		var surface_id: String = str(
			raw_surface_id
		)
		var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
			surface_contracts.get(
				surface_id,
				{}
			)
		).duplicate(false)

		if surface_contract.is_empty():
			continue

		var surface_actor_id: int = int(
			surface_contract.get(
				"actor_id",
				actor_id
			)
		)

		if (
			surface_actor_id > 0
			and surface_actor_id != actor_id
		):
			continue



		surface_contract [
			"incarceration_lens"
		] = compact_incarceration_lens.duplicate(false)
		surface_contract [
			"incarceration_mode"
		] = true
		surface_contract [
			"free_world_surface_suppressed"
		] = true

		cached_contracts [
			surface_id
		] = surface_contract.duplicate(false)

		if install_signature == "":
			continue

		_route_resident_surface_contract_ready(
			install_signature,
			surface_id,
			surface_contract
		)

		routed_surface_count += 1

	set_meta(
		"resident_main_tab_surface_contracts",
		cached_contracts
	)
	set_meta(
		"incarceration_resident_surfaces_installed",
		true
	)
	set_meta(
		"incarceration_resident_surfaces_actor_id",
		actor_id
	)
	set_meta(
		"incarceration_resident_surfaces_signature",
		install_signature
	)
	set_meta(
		"incarceration_resident_surfaces_routed_count",
		routed_surface_count
	)
	set_meta(
		"incarceration_resident_surfaces_contract_count",
		surface_contracts.size()
	)
	set_meta(
		"incarceration_resident_surfaces_engine_calls",
		false
	)
	set_meta(
		"incarceration_resident_surfaces_build_on_press",
		false
	)
	set_meta(
		"incarceration_resident_surfaces_ready_gate_member",
		false
	)
	set_meta(
		"incarceration_resident_surfaces_realm_cards_used",
		false
	)
	set_meta(
		"incarceration_resident_surfaces_truth_source",
		str(
			contract.get(
				"incarceration_kind",
				"custody"
			)
		)
	)


func _install_incarceration_native_facility_surface(
		contract: Dictionary
) -> void:
	if contract.is_empty():
		return

	set_meta(
		"resident_incarceration_facility_surface_contract",
		contract.duplicate(false)
	)

	if (
		world_feed_popup_feed == null
		or not is_instance_valid(
			world_feed_popup_feed
		)
	):
		return

	var parent:= world_feed_popup_feed.get_parent()

	if parent == null:
		return

	var surface:= parent.get_node_or_null(
		"IncarcerationFacilityFeed"
	) as RichTextLabel

	if surface == null:
		surface = RichTextLabel.new()
		surface.name = "IncarcerationFacilityFeed"
		surface.fit_content = false
		surface.scroll_active = true
		surface.bbcode_enabled = true
		surface.size_flags_horizontal = (
			Control.SIZE_EXPAND_FILL
		)
		surface.size_flags_vertical = (
			Control.SIZE_EXPAND_FILL
		)
		surface.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		parent.add_child(
			surface
		)

	surface.visible = false
	surface.clear()

	var subtitle: String = str(
		contract.get(
			"subtitle",
			""
		)
	).strip_edges()

	if subtitle != "":
		surface.append_text(
			"[center][b]%s[/b][/center]\n\n"
			% subtitle
		)

	for raw_line in MainSceneHelpers._safe_array(
		contract.get(
			"body_lines",
			[]
		)
	):
		var line: String = str(
			raw_line
		).strip_edges()

		if line == "":
			continue

		surface.append_text(
			"%s\n\n"
			% line
		)

	surface.set_meta(
		"resident_contract_revision",
		str(
			contract.hash()
		)
	)
	surface.set_meta(
		"simulation_queries_performed",
		false
	)
	surface.set_meta(
		"built_from_immutable_contract",
		true
	)


