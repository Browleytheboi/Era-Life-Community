		signature
	).strip_edges()

	if (
		clean_signature == ""
		or projection_contract.is_empty()
	):
		return

	var contract_signature: String = str(
		projection_contract.get(
			"signature",
			clean_signature
		)
	).strip_edges()

	if (
		contract_signature != ""
		and contract_signature != clean_signature
	):
		return

	var surface_graph_raw: Variant = (
		projection_contract.get(
			"surface_graph",
			{}
		)
	)
	var surface_graph: Dictionary = (
		(surface_graph_raw as Dictionary)
		if typeof(
			surface_graph_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var surface_contracts_raw: Variant = (
		surface_graph.get(
			"surface_contracts",
			{}
		)
	)
	var surface_contracts: Dictionary = (
		(surface_contracts_raw as Dictionary)
		if typeof(
			surface_contracts_raw
		) == TYPE_DICTIONARY
		else {}
	)

	set_meta(
		"resident_main_tab_projection_contract",
		projection_contract.duplicate(false)
	)
	set_meta(
		"resident_main_tab_projection_final_surface_graph",
		surface_graph.duplicate(false)
	)
	set_meta(
		"resident_main_tab_projection_final_surface_contracts",
		surface_contracts.duplicate(false)
	)
	set_meta(
		"resident_main_tab_projection_install_signature",
		clean_signature
	)
	set_meta(
		"resident_main_tab_projection_install_actor_id",
		int(
			projection_contract.get(
				"actor_id",
				-1
			)
		)
	)
	set_meta(
		"resident_main_tab_projection_final_graph_received",
		true
	)
	set_meta(
		"resident_main_tab_projection_final_graph_received_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_main_tab_projection_final_graph_triggered_render",
		false
	)
	set_meta(
		"resident_main_tab_projection_final_graph_triggered_retry",
		false
	)
	set_meta(
		"resident_main_tab_projection_final_graph_triggered_process_chain",
		false
	)
	set_meta(
		"resident_main_tab_projection_install_engine_calls",
		false
	)
	set_meta(
		"resident_main_tab_projection_install_build_on_click",
		false
	)
	set_meta(
		"resident_main_tab_projection_install_ready_gate_member",
		false
	)

	var all_surfaces_hot: bool = true
	var installed_count: int = 0

	for panel_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var panel_hot: bool = bool(
			get_meta(
				"native_main_tab_surface_projection_installed_%s"
				% panel_id,
				false
			)
		)

		if panel_hot:
			installed_count += 1
		else:
			all_surfaces_hot = false

	set_meta(
		"resident_main_tab_projection_install_cursor",
		installed_count
	)
	set_meta(
		"resident_main_tab_projection_install_total",
		5
	)
	set_meta(
		"resident_main_tab_projection_install_active",
		false
	)
	set_meta(
		"resident_main_tab_projection_install_complete",
		all_surfaces_hot
	)
	set_meta(
		"ready_room_actor_bound_surfaces_hot",
		all_surfaces_hot
	)

	EraLog.truth(
		(
			"ERALIFE_RESIDENT_MAIN_TAB_PACKET_TRUTH"
			+ "|signature=%s"
			+ "|hot=%s"
			+ "|relationships=%s"
			+ "|school=%s"
			+ "|activities=%s"
			+ "|career=%s"
			+ "|mods=%s"
			+ "|final_graph_rendered=false"
			+ "|process_chain=false"
			+ "|retry_loop=false"
			+ "|engine_calls=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=%d"
		)
		% [
			clean_signature,
			str(
				all_surfaces_hot
			),
			str(
				bool(
					get_meta(
						"native_main_tab_surface_projection_installed_relationships",
						false
					)
				)
			),
			str(
				bool(
					get_meta(
						"native_main_tab_surface_projection_installed_school",
						false
					)
				)
			),
			str(
				bool(
					get_meta(
						"native_main_tab_surface_projection_installed_activities",
						false
					)
				)
			),
			str(
				bool(
					get_meta(
						"native_main_tab_surface_projection_installed_career",
						false
					)
				)
			),
			str(
				bool(
					get_meta(
						"native_main_tab_surface_projection_installed_mods",
						false
					)
				)
			),
			int(
				Time.get_ticks_msec()
			)
		]
	)
func _continue_install_resident_main_tab_projection_contract(
		tasks: Array,
		index: int,
		signature: String
) -> void:
	var active_signature: String = str(
		get_meta(
			"resident_main_tab_projection_install_signature",
			""
		)
	).strip_edges()

	if (
		signature == ""
		or signature != active_signature
	):
		return

	if index >= tasks.size():
		var all_surfaces_hot: bool = true

		for raw_panel_id in tasks:
			var required_panel_id: String = str(
				raw_panel_id
			).strip_edges().to_lower()

			if not bool(
				get_meta(
					"native_main_tab_surface_projection_installed_%s"
					% required_panel_id,
					false
				)
			):
				all_surfaces_hot = false
				break

		set_meta(
			"resident_main_tab_projection_install_active",
			false
		)
		set_meta(
			"resident_main_tab_projection_install_complete",
			all_surfaces_hot
		)
		set_meta(
			"resident_main_tab_projection_install_completed_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"ready_room_native_tab_surface_prewarm_active",
			false
		)
		set_meta(
			"ready_room_native_tab_surface_prewarm_complete",
			all_surfaces_hot
		)
		set_meta(
			"ready_room_actor_bound_surfaces_hot",
			all_surfaces_hot
		)
		set_meta(
			"ready_room_background_truth_pending",
			false
		)
		set_meta(
			"ready_room_background_truth_complete",
			true
		)
		set_meta(
			"ready_room_native_tab_retry_loop_active",
			false
		)

		EraLog.truth(
			(
				"ERALIFE_RESIDENT_MAIN_TAB_PACKET_TRUTH"
				+ "|signature=%s"
				+ "|hot=%s"
				+ "|relationships=%s"
				+ "|school=%s"
				+ "|activities=%s"
				+ "|career=%s"
				+ "|mods=%s"
				+ "|engine_calls=false"
				+ "|retry_loop=false"
				+ "|ready_gate_member=false"
				+ "|at_ms=%d"
			)
			% [
				signature,
				str(
					all_surfaces_hot
				),
				str(
					bool(
						get_meta(
							"native_main_tab_surface_projection_installed_relationships",
							false
						)
					)
				),
				str(
					bool(
						get_meta(
							"native_main_tab_surface_projection_installed_school",
							false
						)
					)
				),
				str(
					bool(
						get_meta(
							"native_main_tab_surface_projection_installed_activities",
							false
						)
					)
				),
				str(
					bool(
						get_meta(
							"native_main_tab_surface_projection_installed_career",
							false
						)
					)
				),
				str(
					bool(
						get_meta(
							"native_main_tab_surface_projection_installed_mods",
							false
						)
					)
				),
				int(
					Time.get_ticks_msec()
				)
			]
		)

		return

	var surface_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var surface_contracts: Dictionary = (
		(surface_contracts_raw as Dictionary)
		if typeof(
			surface_contracts_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var panel_id: String = str(
		tasks [index]
	).strip_edges().to_lower()
	var contract_raw: Variant = surface_contracts.get(
		panel_id,
		{}
	)
	var contract: Dictionary = (
		(contract_raw as Dictionary)
		if typeof(
			contract_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var actor_id: int = int(
		contract.get(
			"actor_id",
			-1
		)
	)
	var surface_hot: bool = false

	match panel_id:
		"relationships":
			if (
				relationship_hub_panel != null
				and is_instance_valid(
					relationship_hub_panel
				)
				and not contract.is_empty()
			):
				relationship_hub_panel.render_contract(
					contract
				)
				relationship_hub_panel.hide_surface()

				relationship_hub_panel_active_actor_id = actor_id
				relationships_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						"family"
					)
				).strip_edges().to_lower()

				surface_hot = (
					relationship_hub_panel
					.has_renderable_contract(
						actor_id
					)
				)

		"school":
			if (
				school_hub_panel != null
				and is_instance_valid(
					school_hub_panel
				)
				and not contract.is_empty()
			):
				school_hub_panel.render_contract(
					contract
				)
				school_hub_panel.hide_surface()

				school_hub_active_actor_id = actor_id
				school_hub_active_section_id = str(
					contract.get(
						"active_section_id",
						"overview"
					)
				).strip_edges().to_lower()

				surface_hot = (
					school_hub_panel.has_renderable_contract(
						actor_id
					)
				)

		"activities":
			if (
				activities_hub_panel != null
				and is_instance_valid(
					activities_hub_panel
				)
				and not contract.is_empty()
			):
				activities_hub_panel.render_contract(
					contract
				)
				activities_hub_panel.visible = false
				activities_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				activities_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				activities_hub_active_actor_id = actor_id
				activities_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"all"
						)
					)
				).strip_edges().to_lower()

				surface_hot = (
					activities_hub_panel
					.has_renderable_contract(
						actor_id
					)
				)

		"career":
			if (
				career_hub_panel != null
				and is_instance_valid(
					career_hub_panel
				)
				and not contract.is_empty()
			):
				career_hub_panel.render_contract(
					contract
				)
				career_hub_panel.visible = false
				career_hub_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				career_hub_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				career_hub_active_actor_id = actor_id
				career_hub_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"overview"
						)
					)
				).strip_edges().to_lower()
				career_hub_active_lane = str(
					contract.get(
						"career_lane",
						"full_time"
					)
				).strip_edges().to_lower()

				surface_hot = (
					_career_hub_contract_is_renderable(
						career_hub_panel.active_contract,
						actor_id
					)
				)

		"mods":
			if (
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and not contract.is_empty()
			):
				mod_menu_panel.render_contract(
					contract
				)
				mod_menu_panel.visible = false
				mod_menu_panel.mouse_filter = (
					Control.MOUSE_FILTER_IGNORE
				)
				mod_menu_panel.process_mode = (
					Node.PROCESS_MODE_INHERIT
				)

				mod_menu_active_actor_id = actor_id
				mod_menu_active_section_id = str(
					contract.get(
						"active_section",
						contract.get(
							"active_section_id",
							"installed"
						)
					)
				).strip_edges().to_lower()

				surface_hot = (
					mod_menu_panel.has_precomposed_surface(
						actor_id
					)
				)

		_:
			surface_hot = false

	set_meta(
		"native_main_tab_surface_projection_installed_%s"
		% panel_id,
		surface_hot
	)
	set_meta(
		"native_main_tab_surface_projection_installed_%s_at_ms"
		% panel_id,
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"resident_main_tab_projection_install_cursor",
		index + 1
	)
	set_meta(
		"resident_main_tab_projection_last_panel",
		panel_id
	)
	set_meta(
		"resident_main_tab_projection_last_panel_hot",
		surface_hot
	)
	set_meta(
		"resident_main_tab_projection_last_panel_engine_calls",
		false
	)
	set_meta(
		"resident_main_tab_projection_last_panel_build_on_click",
		false
	)

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_continue_install_resident_main_tab_projection_contract",
			tasks,
			index + 1,
			signature
		)
		return

	tree.process_frame.connect(
		Callable(
			self,
			"_continue_install_resident_main_tab_projection_contract"
		).bind(
			tasks,
			index + 1,
			signature
		),
		CONNECT_ONE_SHOT
	)
func _adopt_attached_resident_game_state(
	resident_gs: GameState,
	signature: String
) -> bool:
	if (
		resident_gs == null
		or resident_gs.player == null
	):
		return false

	_capture_reality_residency_host()

	reality_residency_attached_signature = str(
		signature
	).strip_edges()
	gs = resident_gs

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"resident_runtime_lens_attached"
	] = true
	gs.scenario_state [
		"resident_runtime_attached_signature"
	] = reality_residency_attached_signature
	gs.scenario_state [
		"runtime_never_unloads_for_lens_disconnect"
	] = true







	_bind_crime_panel_event_bus_observation()



	_bind_crime_panel_observation_authority()

	_ensure_god_mode_contract_engine()
	_ensure_global_runtime_kill_contract_engine()

	return true
func _detach_resident_reality_for_main_menu_return(
	reason: String,
	preserved_first: bool
) -> bool:
	if (
		reality_residency_host_game_state == null
		or gs == null
		or gs == reality_residency_host_game_state
	):
		return false

	var resident_gs: GameState = gs
	var signature: String = (
		reality_residency_attached_signature
	)

	if (
		signature == ""
		and typeof(
			resident_gs.scenario_state
		) == TYPE_DICTIONARY
	):
		signature = str(
			resident_gs.scenario_state.get(
				"resident_runtime_signature",
				resident_gs.scenario_state.get(
					"resident_runtime_attached_signature",
					""
				)
			)
		).strip_edges()

	var detach_report: Dictionary = {}

	if signature != "":
		detach_report = _request_reality_residency_intent(
			"detach",
			{
				"signature": signature,
				"source": reason,
				"preserved_first": preserved_first,
			},
			"%s_detach_resident_lens" % reason
		)

	if typeof(
		resident_gs.scenario_state
	) != TYPE_DICTIONARY:
		resident_gs.scenario_state = {}

	resident_gs.scenario_state [
		"resident_runtime_lens_attached"
	] = false
	resident_gs.scenario_state [
		"resident_runtime_execution_mode"
	] = "dormant_chunked"
	resident_gs.scenario_state [
		"resident_runtime_last_detached_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	resident_gs.scenario_state [
		"resident_runtime_last_detach_reason"
	] = reason
	resident_gs.scenario_state [
		"runtime_destroyed_on_menu_return"
	] = false
	resident_gs.realtime_enabled = false

	gs = reality_residency_host_game_state
	reality_residency_attached_signature = ""

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"resident_runtime_detach_report"
	] = detach_report.duplicate(true)
	gs.scenario_state [
		"resident_runtime_detached_signature"
	] = signature
	gs.scenario_state [
		"resident_runtime_preserved_after_menu_return"
	] = true




	_bind_crime_panel_observation_authority()

	_ensure_god_mode_contract_engine()
	_ensure_global_runtime_kill_contract_engine()

	_reset_world_specific_ui_lens_state_for_new_world_seed(
		"%s_after_resident_detach" % reason
	)
	_reset_newborn_birth_intro_diary_contract_for_new_world_seed(
		"%s_after_resident_detach" % reason
	)
	_reset_god_mode_new_life_seed_contract_for_main_menu_return(
		"%s_after_resident_detach" % reason,
		preserved_first
	)

	return true
func _present_mod_menu_contract(
	contract: Dictionary,
	actor_id: int,
	reveal_surface: bool
) -> bool:
	if not _mod_menu_contract_is_renderable(
		contract,
		actor_id
	):
		return false

	var surface_mode: String = str(
		contract.get(
			"surface_mode",
			"global_hub"
		)
	).strip_edges().to_lower()
	var is_bundle_menu: bool = (
		surface_mode == "bundle_menu"
	)
	var target_panel: ModMenuPanel = (
		mod_bundle_menu_panel
		if is_bundle_menu
		else mod_menu_panel
	)



	if (
		target_panel == null
		or not is_instance_valid(
			target_panel
		)
	):
		set_meta(
			"mod_menu_presentation_integrity_failure",
			true
		)
		set_meta(
			"mod_menu_presentation_integrity_failure_mode",
			(
				"bundle_shell_missing"
				if is_bundle_menu
				else "global_shell_missing"
			)
		)
		return false

	target_panel.render_contract(
		contract
	)
	target_panel.apply_window_contract(
		MainSceneHelpers._safe_dictionary(
			contract.get(
				"window_contract",
				{}
			)
		)
	)

	if not target_panel.has_precomposed_surface(
		actor_id
	):
		set_meta(
			"mod_menu_presentation_integrity_failure",
			true
		)
		set_meta(
			"mod_menu_presentation_integrity_failure_mode",
			"section_deck_not_precomposed"
		)
		return false

	if is_bundle_menu:
		mod_bundle_menu_active_bundle_id = str(
			contract.get(
				"active_bundle_id",
				""
			)
		).strip_edges().to_lower()

		if reveal_surface:
			target_panel.reveal_precomposed_surface(
				actor_id
			)
			target_panel.z_as_relative = false
			target_panel.z_index = 350
			_bring_modal_to_front(
				target_panel
			)
			_claim_interactive_surface_authority(
				target_panel,
				(
					"mod_bundle_menu_panel:%s:%d"
					% [
						mod_bundle_menu_active_bundle_id,
						actor_id
					]
				),
				"mod_bundle_menu_contract_rendered",
				true,
				true
			)
		else:
			target_panel.visible = false
			target_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
	else:
		mod_menu_active_section_id = str(
			contract.get(
				"active_section",
				"bundles"
			)
		).strip_edges().to_lower()

		if mod_menu_active_section_id == "":
			mod_menu_active_section_id = "bundles"

		if reveal_surface:
			target_panel.reveal_precomposed_surface(
				actor_id
			)
			target_panel.z_as_relative = false
			target_panel.z_index = 250
			_bring_modal_to_front(
				target_panel
			)
			_claim_interactive_surface_authority(
				target_panel,
				"mod_menu_panel:%d" % actor_id,
				"mod_menu_contract_rendered",
				true,
				true
			)
		else:
			target_panel.visible = false
			target_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)



		if (
			reveal_surface
			and mod_bundle_menu_panel != null
			and is_instance_valid(
				mod_bundle_menu_panel
			)
		):
			mod_bundle_menu_panel.visible = false
			mod_bundle_menu_panel.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)

	set_meta(
		"mod_menu_presentation_integrity_failure",
		false
	)

	return true
func _request_mod_menu_contract(
	actor: Person,
	payload: Dictionary = {},
	reveal_surface: bool = true
) -> Dictionary:
	if (
		gs == null
		or actor == null
	):
		return {}

	var resolved_payload: Dictionary = (
		payload.duplicate(true)
	)
	resolved_payload ["actor_id"] = int(
		actor.id
	)
	resolved_payload ["section_id"] = str(
		resolved_payload.get(
			"section_id",
			mod_menu_active_section_id
		)
	)
	resolved_payload ["source"] = str(
		resolved_payload.get(
			"source",
			"mainscene.mod_menu"
		)
	)
	resolved_payload ["ui_is_expression_only"] = true

	var action_id: String = str(
		resolved_payload.get(
			"action_id",
			"refresh"
		)
	).strip_edges().to_lower()
	var projection_actions: Array = [
		"",
		"refresh",
		"open_menu",
		"set_section",
		"set_bundle_section",
		"open_bundle_menu",
		"refresh_bundle_menu",
		"observe_partial"
	]

	if action_id in projection_actions:
		var projection_sequence: int = int(
			get_meta(
				"mod_menu_projection_sequence",
				0
			)
		) + 1
		set_meta(
			"mod_menu_projection_sequence",
			projection_sequence
		)
		resolved_payload ["projection_request_id"] = (
			"%d:%d:%d:%s:%s" % [
				int(
					actor.id
				),
				projection_sequence,
				int(
					Time.get_ticks_msec()
				),
				action_id,
				str(
					resolved_payload.get(
						"section_id",
						"bundles"
					)
				)
			]
		)

	var report: Dictionary = _express_global_ui_intent(
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"intent_type": "mod_menu_contract_intent",
			"surface_id": "mod_menu_panel",
			"action_id": action_id,
			"payload": resolved_payload,
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"mod_menu_contract_engine"
				),
				"method": "resolve_intent",
				"pass_actor_payload": true,
				"actor_id": int(
					actor.id
				)
			},
			"source": str(
				resolved_payload.get(
					"source",
					""
				)
			),
			"ui_is_expression_only": true
		},
		{
			"actor_id": int(
				actor.id
			),
			"target_id": int(
				actor.id
			),
			"surface_id": "mod_menu_panel",
			"action_id": action_id,
			"source": str(
				resolved_payload.get(
					"source",
					""
				)
			)
		}
	)

	var route_result: Dictionary = (
		_mod_menu_contract_route_result(
			report
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		route_result.get(
			"mod_menu_contract",
			{}
		)
	)

	if contract.is_empty():
		var cached_panel: ModMenuPanel = null
		var expected_surface_mode: String = str(
			resolved_payload.get(
				"expected_surface_mode",
				""
			)
		).strip_edges().to_lower()

		if expected_surface_mode == "bundle_menu":
			cached_panel = mod_bundle_menu_panel
		else:
			cached_panel = mod_menu_panel

		if (
			cached_panel != null
			and is_instance_valid(
				cached_panel
			)
			and cached_panel.has_precomposed_surface(
				int(
					actor.id
				)
			)
		):
			contract = (
				cached_panel.active_contract.duplicate(
					true
				)
			)
			route_result = {
				"success": true,
				"type": "mod_menu_cached_projection_preserved",
				"mod_menu_contract": contract.duplicate(true),
				"source_report": report.duplicate(true)
			}

	var renderable: bool = _mod_menu_contract_is_renderable(
		contract,
		int(
			actor.id
		)
	)
	set_meta(
		"native_main_tab_surface_renderable_mods",
		renderable
	)

	if not renderable:
		return route_result

	mod_menu_active_actor_id = int(
		actor.id
	)

	var presented: bool = _present_mod_menu_contract(
		contract,
		int(
			actor.id
		),
		reveal_surface
	)

	set_meta(
		"mod_menu_contract_presented",
		presented
	)

	if not presented:
		return route_result

	if action_id not in projection_actions:
		_maybe_show_action_result_popup(
			route_result
		)

	return route_result


