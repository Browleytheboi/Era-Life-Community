		detail_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		detail_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		detail_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		detail_label.vertical_alignment = VERTICAL_ALIGNMENT_TOP
		stack.add_child(detail_label)

	bending_hud_skill_points_box.add_child(card)


func _on_bending_hub_allocate_skill_point_pressed(row_or_stat: Variant) -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return
	if not gs.bending_engine.has_method("allocate_bending_skill_point"):
		return

	_bending_hub_validate_pending_skill_allocation_actor(actor)

	var row_data: Dictionary = {}
	if typeof(row_or_stat) == TYPE_DICTIONARY:
		row_data = row_or_stat.duplicate(true)
	else:
		row_data = {
			"stat": str(row_or_stat),
			"available_points": int(actor.bending_skill_points),
			"max_spend": int(actor.bending_skill_points)
		}

	var stat_name: String = str(row_data.get("stat", "")).strip_edges().to_lower()
	if stat_name == "":
		return

	var pending_total: int = _bending_hub_pending_skill_allocation_total()
	var available_points: int = max(0, int(actor.bending_skill_points) - pending_total)
	var row_max_spend: int = max(0, int(row_data.get("max_spend", available_points)))
	var max_spend: int = clamp(row_max_spend, 0, available_points)

	if available_points <= 0 or max_spend <= 0:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Not Enough Skill Points",
			"popup_text": "You do not have any uncommitted bending skill points available for %s.\n\nPending allocation: %d\nAvailable after pending: %d" % [
				stat_name.capitalize(),
				pending_total,
				available_points
			],
			"popup_footer": "Tap anywhere to continue."
		})
		return

	_show_bending_hub_skill_point_slider(row_data, stat_name, max_spend)



func _show_bending_hub_skill_point_slider(row_data: Dictionary, stat_name: String, max_spend: int) -> void:
	var dialog:= AcceptDialog.new()
	dialog.title = "Add Skill Points"
	dialog.exclusive = false
	dialog.size = Vector2(540, 300)
	dialog.ok_button_text = "Close"

	var box:= VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override("separation", 10)

	var header:= Label.new()
	header.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	header.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	header.text = "%s\n%s\n\nThis only stages the allocation. Press Save Allocation in the Skill Point section to make it permanent." % [
		str(row_data.get("label", stat_name.capitalize())),
		str(row_data.get("description", "Choose how many skill points to spend."))
	]
	box.add_child(header)

	var amount_label:= Label.new()
	amount_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	amount_label.text = "Spend: 1 / %d" % max_spend
	box.add_child(amount_label)

	var slider:= HSlider.new()
	slider.min_value = 1
	slider.max_value = max(1, max_spend)
	slider.step = 1
	slider.value = 1
	slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	slider.value_changed.connect(func (value: float) -> void:
		amount_label.text = "Spend: %d / %d" % [
			int(round(value)),
			max_spend
		]
	)
	box.add_child(slider)

	var allocate_button:= Button.new()
	allocate_button.text = "Allocate Points"
	allocate_button.custom_minimum_size = Vector2(0, 46)
	allocate_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_apply_bending_hub_pending_allocation_button_visual(allocate_button)
	allocate_button.pressed.connect(func () -> void:
		_stage_bending_hub_skill_point_slider(stat_name, int(round(slider.value)))
		dialog.queue_free()
	)
	box.add_child(allocate_button)

	dialog.add_child(box)
	dialog.close_requested.connect(dialog.queue_free)

	add_child(dialog)
	dialog.popup_centered()



func _stage_bending_hub_skill_point_slider(stat_name: String, amount: int) -> void:
	var actor: Person = _bending_hub_actor()
	if actor == null:
		return

	_bending_hub_validate_pending_skill_allocation_actor(actor)

	var clean_stat: String = str(stat_name).strip_edges().to_lower()
	var clean_amount: int = max(0, int(amount))
	if clean_stat == "" or clean_amount <= 0:
		return

	var pending_total: int = _bending_hub_pending_skill_allocation_total()
	var remaining_points: int = max(0, int(actor.bending_skill_points) - pending_total)
	var staged_amount: int = min(clean_amount, remaining_points)

	if staged_amount <= 0:
		_maybe_show_action_result_popup({
			"success": false,
			"popup_title": "Allocation Not Staged",
			"popup_text": "You do not have enough uncommitted skill points left.",
			"popup_footer": "Tap anywhere to continue."
		})
		return

	bending_hub_pending_skill_allocation [clean_stat] = max(0, int(bending_hub_pending_skill_allocation.get(clean_stat, 0)) + staged_amount)

	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
	_update_player_stats_overlay()



func _bending_hub_validate_pending_skill_allocation_actor(actor: Person) -> void:
	if actor == null:
		bending_hub_pending_skill_allocation.clear()
		bending_hub_pending_skill_allocation_actor_id = -1
		return

	var actor_id: int = int(actor.id)
	if bending_hub_pending_skill_allocation_actor_id != actor_id:
		bending_hub_pending_skill_allocation.clear()
		bending_hub_pending_skill_allocation_actor_id = actor_id



func _bending_hub_pending_skill_allocation_total() -> int:
	var total: int = 0
	for raw_key in bending_hub_pending_skill_allocation.keys():
		total += max(0, int(bending_hub_pending_skill_allocation.get(raw_key, 0)))
	return total



