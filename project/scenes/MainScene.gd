		prewarm_gs.scenario_state ["god_mode_heavy_surface_cache_prewarm_tail_deferred_reason"] = "first_frame_ready_gate_only"
		prewarm_gs.scenario_state ["god_mode_heavy_surface_cache_prewarm_tail_deferred_at_ms"] = int(Time.get_ticks_msec())
		prewarm_gs.scenario_state ["bending_hub_runtime_surface_cache_tail_required"] = true
		prewarm_gs.scenario_state ["super_runtime_surface_cache_tail_required"] = true
	else:
		_precompute_bending_hub_runtime_surface_cache_for_state(prewarm_gs, "god_mode_life_prewarm")
		_precompute_super_runtime_surface_cache_for_state(prewarm_gs, "god_mode_life_prewarm")

	var prebuilt_first_frame_snapshot: Dictionary = _build_first_frame_ui_snapshot_from_game_state(prewarm_gs, "god_mode_life_prewarm")
	if not prebuilt_first_frame_snapshot.is_empty():
		prewarm_gs.scenario_state ["prebuilt_first_frame_ui_snapshot"] = prebuilt_first_frame_snapshot.duplicate(true)

	if str(get_meta("god_mode_life_prewarm_signature", "")) != signature:
		return {
			"success": false,
			"mode": "stale_prewarm_discarded",
			"reason": "God Mode loadout changed while the reality was prewarming.",
			"signature": signature
		}

	_set_god_mode_prewarm_progress(
		0.74,
		"Birth capsule initialized. Prewarming first-frame UI packets...",
		false
	)

	var prewarm_context: Dictionary = {
		"source": "main_scene.god_mode_life_prewarm_manifest",
		"prewarm_phase": "god_mode_loadout_spawn_deferred",
		"prewarm_signature": signature,
		"god_mode_life_prewarm": true,
		"first_visible_runtime_boot": true,
		"settings": candidate_settings.duplicate(true),
		"contract": contract.duplicate(true),
		"prebirth_candidate": candidate.duplicate(true),
		"world_seed": world_seed,
		"single_target_reality": true,
		"packet_contract_required": true,
		"playable_birth_shell_only": true,
	}

	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_pending"] = true
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_reason"] = "god_mode_life_prewarm"
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_actor_id"] = int(prewarm_gs.player.id) if prewarm_gs.player != null else -1
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_target_year"] = int(prewarm_gs.year)
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_contract"] = contract.duplicate(true)
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_rows"] = _god_mode_life_prewarm_surface_rows(contract)
	prewarm_gs.scenario_state ["live_reality_surface_prewarm_manifest_context"] = prewarm_context.duplicate(true)

	_set_god_mode_prewarm_progress(
		0.86,
		"Finishing the playable birth shell before entry...",
		false
	)
	var live_stream_report: Dictionary = _advance_god_mode_prewarm_runtime_stream(prewarm_gs, signature, contract)
	if not bool(live_stream_report.get("success", false)):
		set_meta("god_mode_life_prewarm_pending", false)
		set_meta("god_mode_life_prewarm_ready", false)
		return {
			"success": false,
			"mode": "god_mode_life_prewarm_shell_not_ready",
			"reason": "The playable birth shell is not safe to enter yet.",
			"signature": signature,
			"contract": contract.duplicate(true),
			"prebirth_candidate": candidate.duplicate(true),
			"world_seed": world_seed,
			"live_stream_report": live_stream_report.duplicate(true)
		}

	prewarm_gs.scenario_state.erase("first_frame_ui_snapshot")
	prewarm_gs.scenario_state ["first_frame_ui_snapshot_locked"] = false
	prewarm_gs.scenario_state ["first_frame_ui_snapshot_consumed"] = true
	prewarm_gs.scenario_state ["first_frame_is_live_runtime"] = true
	prewarm_gs.scenario_state ["first_frame_snapshot_replaced_by_live_stream"] = true
	prewarm_gs.scenario_state ["live_reality_stream_report"] = live_stream_report.duplicate(true)
	prewarm_gs.scenario_state ["live_reality_stream_ready"] = bool(live_stream_report.get("shell_stream_ready", false))
	prewarm_gs.scenario_state ["live_reality_world_stream_ready"] = false
	prewarm_gs.scenario_state ["birth_shell_deferred_boot_pending"] = not bool(live_stream_report.get("shell_stream_ready", false))
	prewarm_gs.scenario_state ["birth_shell_deferred_boot_complete"] = bool(live_stream_report.get("shell_stream_ready", false))
	prewarm_gs.scenario_state ["static_world_runtime_bootstrapped"] = false
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_microtask_ui_safe"
	prewarm_gs.scenario_state ["god_mode_prewarm_skipped_heavy_world_boot"] = true
	prewarm_gs.scenario_state ["god_mode_life_prewarm_active"] = false
	prewarm_gs.scenario_state ["god_mode_life_prewarm_ready"] = true
	prewarm_gs.scenario_state ["god_mode_life_prewarm_completed_at_ms"] = int(Time.get_ticks_msec())

	set_meta("god_mode_life_prewarmed_gs", prewarm_gs)
	set_meta("god_mode_life_prewarm_contract", contract.duplicate(true))
	set_meta("god_mode_life_prewarm_pending", false)
	set_meta("god_mode_life_prewarm_ready", true)
	set_meta("god_mode_life_prewarm_signature", signature)
	set_meta("god_mode_life_prewarm_completed_at_ms", int(Time.get_ticks_msec()))

	_set_god_mode_prewarm_progress(
		1.0,
		"Reality prewarmed. Your curated universe is ready to enter.",
		true
	)
	_refresh_god_mode_start_button_state()

	if bool(get_meta("god_mode_start_after_prewarm_requested", false)):
		set_meta("god_mode_start_after_prewarm_requested", false)
		call_deferred("_on_confirm_god_mode_start")

	return {
		"success": true,
		"mode": "god_mode_life_prewarmed",
		"signature": signature,
		"contract": contract.duplicate(true),
		"prebirth_candidate": candidate.duplicate(true),
		"world_seed": world_seed,
		"player_created": prewarm_gs.player != null,
		"live_stream_report": live_stream_report.duplicate(true),
		"created_at_ms": int(Time.get_ticks_msec())
	}
func _consume_god_mode_life_prewarm(settings: Dictionary) -> Dictionary:
	var ready_signature: String = str(get_meta("god_mode_life_prewarm_signature", "")).strip_edges()
	var signature: String = str(get_meta("god_mode_life_start_prevalidated_signature", "")).strip_edges()

	if signature == "" or signature != ready_signature:
		signature = _god_mode_life_prewarm_signature(settings)

	if signature == "" or ready_signature == "" or signature != ready_signature:
		return {}

	if not bool(get_meta("god_mode_life_prewarm_ready", false)):
		return {}

	var prewarmed_raw: Variant = get_meta("god_mode_life_prewarmed_gs", null)
	if not (prewarmed_raw is GameState):
		return {}

	var prewarmed_gs: GameState = prewarmed_raw as GameState
	if prewarmed_gs == null or prewarmed_gs.player == null:
		return {}

	var contract_raw: Variant = get_meta("god_mode_life_prewarm_contract", {})
	var contract: Dictionary = contract_raw if typeof(contract_raw) == TYPE_DICTIONARY else {}

	remove_meta("god_mode_life_prewarmed_gs")
	set_meta("god_mode_life_prewarm_ready", false)
	set_meta("god_mode_life_prewarm_pending", false)
	set_meta("god_mode_life_prewarm_consumed", true)
	set_meta("god_mode_life_boot_uses_prewarmed_spawn", true)
	set_meta("god_mode_life_boot_prewarm_signature", signature)
	set_meta("god_mode_life_prewarm_consumed_at_ms", int(Time.get_ticks_msec()))

	return {
		"success": true,
		"mode": "consumed_god_mode_life_prewarm_hot_signature",
		"signature": signature,
		"game_state": prewarmed_gs,
		"contract": contract.duplicate(true)
	}
func _is_live_reality_stream_bound() -> bool:
	if bool(get_meta("live_reality_stream_bound", false)):
		return true

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		return bool(gs.scenario_state.get("live_reality_stream_bound", false))

	return false


func _clear_first_frame_snapshot_lock(reason: String = "live_reality_stream") -> void:
	remove_meta("first_frame_ui_snapshot")
	set_meta("first_frame_ui_snapshot_locked", false)
	set_meta("first_frame_ui_snapshot_consumed", true)
	set_meta("first_frame_ui_snapshot_cleared_reason", reason)
	set_meta("first_frame_ui_snapshot_cleared_at_ms", int(Time.get_ticks_msec()))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state.erase("first_frame_ui_snapshot")
		gs.scenario_state ["first_frame_ui_snapshot_locked"] = false
		gs.scenario_state ["first_frame_ui_snapshot_consumed"] = true
		gs.scenario_state ["first_frame_ui_snapshot_cleared_reason"] = reason
		gs.scenario_state ["first_frame_ui_snapshot_cleared_at_ms"] = int(Time.get_ticks_msec())


func _bind_live_reality_stream_for_spawn(reason: String = "spawn_ready") -> void:
	if gs == null or gs.player == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var now_ms: int = int(Time.get_ticks_msec())
	var full_playable_entry: bool = bool(gs.scenario_state.get("god_mode_life_prewarm_consumed", false)) \
or bool(gs.scenario_state.get("god_mode_life_entry_full_ui_ready", false)) \
or bool(get_meta("god_mode_life_entry_full_ui_required", false)) \
or str(gs.scenario_state.get("spawn_shell_entry_policy", "")).strip_edges() == "full_playable_ui_from_prewarmed_capsule"

	var preserve_first_frame_snapshot: bool = full_playable_entry \
or bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false)) \
or bool(gs.scenario_state.get("birth_shell_fast_first_paint", false)) \
or bool(get_meta("prewarmed_capsule_entry_shell_first", false))

	if preserve_first_frame_snapshot:
		gs.scenario_state ["first_frame_snapshot_preserved_for_shell_boundary"] = true
		gs.scenario_state ["first_frame_snapshot_preserved_reason"] = reason
	else:
		_clear_first_frame_snapshot_lock(reason)

	set_meta("live_reality_stream_bound", true)
	set_meta("live_reality_stream_reason", reason)
	set_meta("live_reality_stream_bound_at_ms", now_ms)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_transition_busy", false)
	set_meta("player_stats_spawn_cinematic_pending", false)
	set_meta("player_stats_spawn_fill_consumed", preserve_first_frame_snapshot)
	set_meta("prewarmed_capsule_entry_shell_first", false if full_playable_entry else bool(get_meta("prewarmed_capsule_entry_shell_first", false)))
	set_meta("god_mode_shell_first_handoff_requested", false if full_playable_entry else bool(get_meta("god_mode_shell_first_handoff_requested", false)))

	gs.scenario_state ["live_reality_stream_bound"] = true
	gs.scenario_state ["live_reality_stream_reason"] = reason
	gs.scenario_state ["live_reality_stream_bound_at_ms"] = now_ms
	gs.scenario_state ["ui_packet_stream_mode"] = "live_runtime"
	gs.scenario_state ["ui_packet_stream_source"] = "main_scene.live_reality_stream"
	gs.scenario_state ["first_frame_is_live_runtime"] = true
	gs.scenario_state ["first_frame_snapshot_replaced_by_live_stream"] = not preserve_first_frame_snapshot
	gs.scenario_state ["post_spawn_ui_finalize_pending"] = false
	gs.scenario_state ["god_mode_boot_life_diary_released"] = true if full_playable_entry else false
	gs.scenario_state ["birth_shell_player_control_released"] = true
	gs.scenario_state ["birth_shell_player_control_released_at_ms"] = now_ms
	gs.scenario_state ["prewarmed_capsule_entry_shell_first"] = false if full_playable_entry else bool(gs.scenario_state.get("prewarmed_capsule_entry_shell_first", false))
	gs.scenario_state ["birth_shell_first_boot_active"] = false if full_playable_entry else bool(gs.scenario_state.get("birth_shell_first_boot_active", false))
	gs.scenario_state ["spawn_shell_entry_policy"] = "full_playable_ui_from_prewarmed_capsule" if full_playable_entry else "main_shell_first_user_intent_tabs"
	gs.scenario_state ["ui_first_frame_render_policy"] = "full_playable_ui_visible_no_runtime_work" if full_playable_entry else str(gs.scenario_state.get("ui_first_frame_render_policy", "life_shell_visible_no_runtime_work"))
	gs.scenario_state ["spawn_shell_open_tab_on_boot"] = false
	gs.scenario_state ["spawn_shell_last_main_panel"] = str(current_panel).strip_edges() if str(current_panel).strip_edges() != "" else "life"
	gs.scenario_state ["live_reality_surface_prewarm_pending"] = true
	gs.scenario_state ["live_reality_surface_prewarm_mode"] = "post_first_frame_streaming_manifest"

	var contract_raw: Variant = get_meta("god_mode_life_prewarm_contract", {})
	var contract: Dictionary = contract_raw.duplicate(true) if typeof(contract_raw) == TYPE_DICTIONARY else {}

	gs.scenario_state ["live_reality_surface_prewarm_manifest_pending"] = true
	gs.scenario_state ["live_reality_surface_prewarm_manifest_reason"] = reason
	gs.scenario_state ["live_reality_surface_prewarm_manifest_actor_id"] = int(gs.player.id)
	gs.scenario_state ["live_reality_surface_prewarm_manifest_target_year"] = int(gs.year)
	gs.scenario_state ["live_reality_surface_prewarm_manifest_contract"] = contract.duplicate(true)
	gs.scenario_state ["live_reality_surface_prewarm_manifest_created_at_ms"] = now_ms

	_persist_runtime_hud_visibility_snapshot("%s_bind_live_runtime" % reason)
	_schedule_live_reality_surface_prewarm_idle_tick(reason, 1.35, 0)
func _deferred_queue_live_reality_surface_prewarm(
		reason: String = "spawn_ready",
		actor_id: int = -1,
		target_year: int = -1,
		contract: Dictionary = {}
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state [
		"live_reality_surface_prewarm_manifest_pending"
	] = false

	if actor_id <= 0:
		actor_id = int(
			gs.player.id
		)

	if target_year == -1:
		target_year = int(
			gs.year
		)

	var surface_rows: Array = (
		_god_mode_life_prewarm_surface_rows(
			contract
		)
	)

	if surface_rows.is_empty():
		gs.scenario_state [
			"live_reality_surface_prewarm_pending"
		] = false
		gs.scenario_state [
			"live_reality_surface_prewarm_skipped_reason"
		] = "no_surface_rows"
		return

	var queue_context: Dictionary = {
		"source": (
			"main_scene.deferred_queue_live_reality_surface_prewarm"
		),
		"reason": reason,
		"actor_id": actor_id,
		"year": target_year,
		"live_reality_stream": true,
		"first_frame_is_live_runtime": true,
		"packet_contract_required": true,
		"use_prewarm": true,
		"streaming": true,
		"prewarm_budget": 1,
		"ui_shell_already_released": true,
		"manual_flush_after_shell": true,
		"shell_first_manual_flush": true,
		"main_scene_drives_flush": false,
		"defer_row_context_until_flush": true,
		"interactive_lens_has_absolute_priority": true,
		"optional_ui_prewarm_may_not_block_play": true,
		"ui_is_expression_only": true
	}

	gs.scenario_state [
		"live_reality_surface_prewarm_pending"
	] = true
	gs.scenario_state [
		"live_reality_surface_prewarm_row_count"
	] = surface_rows.size()
	gs.scenario_state [
		"live_reality_surface_prewarm_queued_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	gs.scenario_state [
		"live_reality_surface_prewarm_flush_policy"
	] = (
		"reality_orchestrator_resident_safe_pump"
	)
	gs.scenario_state [
		"live_reality_surface_prewarm_manual_flush"
	] = false
	gs.scenario_state [
		"live_reality_surface_prewarm_main_scene_flush_forbidden"
	] = true

	var queue_intent_report: Dictionary = (
		_express_global_ui_intent(
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"intent_type": (
					"resident_safe_streaming_ui_surface_prewarm_intent"
				),
				"surface_id": (
					"live_reality_surface_prewarm_manifest"
				),
				"action_id": "queue",
				"payload": {
					"action_id": "queue",
					"surface_count": (
						surface_rows.size()
					),
					"source": reason,
					"ui_is_expression_only": true
				},
				"target": {
					"route_kind": "engine_method",
					"engine_property": (
						"reality_orchestrator"
					),
					"method": (
						"queue_resident_safe_streaming_ui_surface_prewarm"
					),
					"pass_actor_payload": false,
					"args": [
						surface_rows.duplicate(true),
						queue_context.duplicate(true)
					]
				},
				"source": reason,
				"ui_is_expression_only": true
			},
			{
				"actor_id": actor_id,
				"target_id": actor_id,
				"surface_id": (
					"live_reality_surface_prewarm_manifest"
				),
				"action_id": "queue",
				"source": reason
			}
		)
	)
	var queue_report: Dictionary = (
		_contract_route_result(
			queue_intent_report
		)
	)

	gs.scenario_state [
		"live_reality_surface_prewarm_queue_report"
	] = queue_report.duplicate(true)

	if bool(
		queue_report.get(
			"success",
			false
		)
	):
		gs.scenario_state [
			"live_reality_surface_prewarm_flush_owner"
		] = (
			"reality_orchestrator_resident_safe_pump"
		)
		return

	gs.scenario_state [
		"live_reality_surface_prewarm_pending"
	] = false
	gs.scenario_state [
		"live_reality_surface_prewarm_failed_reason"
	] = str(
		queue_report.get(
			"reason",
			"resident_safe_queue_failed"
		)
	)
func _schedule_live_reality_surface_prewarm_idle_tick(reason: String = "spawn_ready", delay_seconds: float = 0.95, pass_index: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	if bool(get_meta("live_reality_surface_prewarm_idle_tick_active", false)):
		return

	set_meta("live_reality_surface_prewarm_idle_tick_active", true)
	set_meta("live_reality_surface_prewarm_idle_tick_reason", reason)
	set_meta("live_reality_surface_prewarm_idle_tick_pass_index", pass_index)
	set_meta("live_reality_surface_prewarm_idle_tick_scheduled_at_ms", int(Time.get_ticks_msec()))

	var timer:= tree.create_timer(max(0.25, delay_seconds))
	timer.timeout.connect(
		Callable(self, "_run_live_reality_surface_prewarm_idle_tick").bind(reason, pass_index),
		CONNECT_ONE_SHOT
	)


func _run_live_reality_surface_prewarm_idle_tick(
		reason: String = "spawn_ready",
		_pass_index: int = 0
) -> void:
	set_meta(
		"live_reality_surface_prewarm_idle_tick_active",
		false
	)

	if gs == null:
		return

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var manifest_pending: bool = bool(
		gs.scenario_state.get(
			"live_reality_surface_prewarm_manifest_pending",
			false
		)
	)
	var queued_count: int = int(
		gs.scenario_state.get(
			"reality_orchestrator_streaming_prewarm_queue_size",
			0
		)
	)



	if (
		manifest_pending
		and queued_count <= 0
	):
		var manifest_reason: String = str(
			gs.scenario_state.get(
				"live_reality_surface_prewarm_manifest_reason",
				reason
			)
		).strip_edges()
		var manifest_actor_id: int = int(
			gs.scenario_state.get(
				"live_reality_surface_prewarm_manifest_actor_id",
				-1
			)
		)
		var manifest_target_year: int = int(
			gs.scenario_state.get(
				"live_reality_surface_prewarm_manifest_target_year",
				-1
			)
		)
		var contract_raw: Variant = (
			gs.scenario_state.get(
				"live_reality_surface_prewarm_manifest_contract",
				{}
			)
		)
		var manifest_contract: Dictionary = (
			contract_raw.duplicate(true)
			if typeof(
				contract_raw
			) == TYPE_DICTIONARY
			else {}
		)

		_deferred_queue_live_reality_surface_prewarm(
			manifest_reason,
			manifest_actor_id,
			manifest_target_year,
			manifest_contract
		)
		return

	if queued_count > 0:
		gs.scenario_state [
			"live_reality_surface_prewarm_pending"
		] = true
		gs.scenario_state [
			"live_reality_surface_prewarm_flush_owner"
		] = (
			"reality_orchestrator_resident_safe_pump"
		)
		gs.scenario_state [
			"live_reality_surface_prewarm_main_scene_flush_forbidden"
		] = true
		gs.scenario_state [
			"live_reality_surface_prewarm_idle_tick_retired"
		] = true
		return

	if bool(
		gs.scenario_state.get(
			"live_reality_surface_prewarm_complete",
			false
		)
	):
		gs.scenario_state [
			"live_reality_surface_prewarm_pending"
		] = false
		return

	gs.scenario_state [
		"live_reality_surface_prewarm_idle_tick_retired"
	] = true
	gs.scenario_state [
		"live_reality_surface_prewarm_idle_tick_retired_reason"
	] = (
		"reality_orchestrator_owns_optional_surface_prewarm"
	)

func _advance_god_mode_prewarm_runtime_stream(prewarm_gs: GameState, signature: String, contract: Dictionary = {}) -> Dictionary:
	if prewarm_gs == null:
		return {
			"success": false,
			"reason": "Missing prewarm GameState.",
			"signature": signature
		}
	if typeof(prewarm_gs.scenario_state) != TYPE_DICTIONARY:
		prewarm_gs.scenario_state = {}
	if prewarm_gs.player == null:
		return {
			"success": false,
			"reason": "Prewarm GameState has no player yet.",
			"signature": signature
		}

	var now_ms: int = int(Time.get_ticks_msec())
	prewarm_gs.scenario_state ["live_reality_stream_prewarmer"] = true
	prewarm_gs.scenario_state ["live_reality_stream_signature"] = signature
	prewarm_gs.scenario_state ["ui_packet_stream_mode"] = "live_runtime"
	prewarm_gs.scenario_state ["first_frame_is_live_runtime"] = true
	prewarm_gs.scenario_state ["first_frame_snapshot_replaced_by_live_stream"] = true

	var royal_first_frame_truth_only: bool = (
		bool(prewarm_gs.scenario_state.get("royalty_heavy_bootstrap_forbidden_during_prewarm", false))
		or bool(prewarm_gs.scenario_state.get("royal_first_frame_shell_truth_only", false))
		or bool(prewarm_gs.scenario_state.get("royal_house_heavy_bootstrap_deferred", false))
		or (
			prewarm_gs.player != null
			and (
				bool(prewarm_gs.player.is_royal)
				or bool(prewarm_gs.player.is_ruler)
				or int(prewarm_gs.player.succession_rank) > 0
				or str(prewarm_gs.player.royal_title).strip_edges() != ""
			)
		)
	)

	prewarm_gs.scenario_state ["birth_shell_heavy_deferred_boot_allowed_at_ms"] = now_ms + 3500
	prewarm_gs.scenario_state ["birth_shell_last_heavy_deferred_boot_stage_ms"] = 0

	var shell_ready: bool = true
	var shell_passes: int = 0

	if royal_first_frame_truth_only:
		prewarm_gs.scenario_state ["royal_first_frame_shell_truth_ready"] = true
		prewarm_gs.scenario_state ["royal_first_frame_shell_prewarm_runtime_stream_skipped"] = true
		prewarm_gs.scenario_state ["royal_first_frame_shell_prewarm_runtime_stream_skipped_reason"] = "royal_identity_ready_realm_court_tail_deferred"
		prewarm_gs.scenario_state ["birth_shell_deferred_boot_soft_deferred"] = true
		prewarm_gs.scenario_state ["birth_shell_deferred_boot_soft_deferred_at_ms"] = now_ms
	else:
		if prewarm_gs.has_method("_continue_birth_shell_deferred_boot"):
			shell_ready = false
			for i in range(1):
				shell_passes += 1
				var finished_shell: bool = bool(prewarm_gs._continue_birth_shell_deferred_boot(1, "post_spawn_ui_safe_microtask"))
				if finished_shell:
					shell_ready = true
					break

				var boot_state_raw: Variant = prewarm_gs.scenario_state.get("_birth_shell_deferred_boot_state", {})
				var boot_state: Dictionary = boot_state_raw if typeof(boot_state_raw) == TYPE_DICTIONARY else {}
				var paused_reason: String = str(boot_state.get("paused_reason", "")).strip_edges().to_lower()

				if paused_reason in ["post_spawn_ui_safe_weight_deferred", "waiting_for_scheduler_window", "post_spawn_heavy_stage_throttle"]:
					shell_ready = true
					prewarm_gs.scenario_state ["birth_shell_deferred_boot_soft_deferred"] = true
					prewarm_gs.scenario_state ["birth_shell_deferred_boot_soft_deferred_at_ms"] = int(Time.get_ticks_msec())
					break

	var world_ready: bool = false
	var world_passes: int = 0

	prewarm_gs.scenario_state ["live_reality_stream_ready"] = shell_ready
	prewarm_gs.scenario_state ["live_reality_world_stream_ready"] = false
	prewarm_gs.scenario_state ["birth_shell_deferred_boot_pending"] = false
	prewarm_gs.scenario_state ["birth_shell_deferred_boot_complete"] = shell_ready
	prewarm_gs.scenario_state ["static_world_runtime_bootstrapped"] = false
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_pending"] = true
	prewarm_gs.scenario_state ["post_spawn_world_prewarm_mode"] = "idle_microtask_ui_safe"
	prewarm_gs.scenario_state ["deferred_data_bootstrap_pending"] = true
	prewarm_gs.scenario_state ["deferred_runtime_watchers_bootstrap"] = true
	prewarm_gs.scenario_state ["live_reality_stream_prewarmer_completed_at_ms"] = int(Time.get_ticks_msec())

	return {
		"success": shell_ready,
		"signature": signature,
		"shell_stream_ready": shell_ready,
		"world_stream_ready": world_ready,
		"shell_passes": shell_passes,
		"world_passes": world_passes,
		"contract": contract.duplicate(true),
		"created_at_ms": int(Time.get_ticks_msec()),
		"royal_first_frame_truth_only": royal_first_frame_truth_only
	}
func _birth_shell_boot_context_from_settings(settings: Dictionary) -> Dictionary:
	var safe_settings:= settings.duplicate(true)
	var target_year: int = int(safe_settings.get("year", int(gs.year) if gs != null else 2000))
	var era_key: String = str(safe_settings.get("era", "")).strip_edges()

	if era_key == "":
		era_key = _selected_era_key()

	var era_name: String = era_key
	var era_engine:= _get_ui_era_engine()
	if era_engine != null and typeof(era_engine.eras) == TYPE_DICTIONARY and era_engine.eras.has(era_key):
		var era_data: Dictionary = era_engine.eras.get(era_key, {})
		era_name = str(era_data.get("name", era_key))
	elif gs != null and gs.era != null:
		if typeof(gs.era) == TYPE_DICTIONARY:
			era_name = str(gs.era.get("name", gs.era.get("key", era_key)))
		else:
			era_name = str(gs.era.name)

	var reality_mode: String = str(safe_settings.get("reality_mode", "realistic")).strip_edges().to_lower()
	if reality_mode == "":
		reality_mode = "realistic"

	return {
		"target_year": target_year,
		"era_key": era_key,
		"era_name": era_name,
		"reality_mode": reality_mode,
		"headline": "Your life is being born...",
		"subline": "EraLife is hydrating %s, %d." % [era_name, target_year],
		"dominant_domain": "birth",
		"first_visible_runtime_boot": true,
		"opening_quarantine_frames": 1,
		"opening_quarantine_ms": 0
	}
func _birth_entry_surge_subline(birth_boot_context: Dictionary = {}) -> String:
	var era_name: String = str(birth_boot_context.get("era_name", "")).strip_edges()
	var target_year: int = int(birth_boot_context.get("target_year", 0))
	if era_name == "":
		era_name = "your curated universe"
	if target_year != 0:
		return "Your identity is crossing into %s, year %s." % [era_name, _format_year(target_year)]
	return "Your identity is crossing into %s." % era_name


func _birth_entry_surge_flavor_rows(birth_boot_context: Dictionary = {}, settings: Dictionary = {}) -> Array:
	var era_name: String = str(birth_boot_context.get("era_name", "")).strip_edges()
	var reality_mode: String = str(birth_boot_context.get("reality_mode", settings.get("reality_mode", "realistic"))).strip_edges().to_lower()
	var target_year: int = int(birth_boot_context.get("target_year", settings.get("year", 2000)))
	if era_name == "":
		era_name = "this era"

	var rows: Array = [
		{ "key": "seed_locked", "text": "Your world seed is already locked. The universe is no longer guessing."},
		{ "key": "identity_probability", "text": "Your identity choices are shaping the probability field around your first breath."},
		{ "key": "era_entry", "text": "The %s shell is opening around year %s." % [era_name, _format_year(target_year)]},
		{ "key": "background_manifestation", "text": "Your playable life arrives first. The wider world continues stabilizing behind the veil."}
	]

	match reality_mode:
		"chaos":
			rows.append({ "key": "chaos_surge", "text": "Chaos mode lets the surge bend harder. Reality is entering with more teeth."})
		"enhanced":
			rows.append({ "key": "enhanced_surge", "text": "Enhanced reality is letting unusual systems wake up near your timeline."})
		_:
			rows.append({ "key": "realistic_surge", "text": "Realistic reality is binding your life through grounded social and historical pressure."})

	return rows


func _build_birth_entry_reality_surge_packet(birth_boot_context: Dictionary = {}, settings: Dictionary = {}) -> Dictionary:
	return {
		"schema": "eralife.birth_entry_reality_surge_packet",
		"version": 1,
		"visual_only": true,
		"pure_renderer": true,
		"single_target_reality": true,
		"minimum_visible_frames_before_boot": 1,
		"era_key": str(birth_boot_context.get("era_key", settings.get("era", ""))),
