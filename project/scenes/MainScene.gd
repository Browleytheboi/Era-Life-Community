func _on_luxury_exchange_centerpiece_hover_observation_requested(
	observation_contract: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
		or observation_contract.is_empty()
	):
		return

	var observed_year: int = int(
		observation_contract.get(
			"market_year",
			-999999
		)
	)

	if observed_year != int(
		gs.year
	):
		return

	if int(
		get_meta(
			"luxury_exchange_shiny_authority_consumed_year",
			-999999
		)
	) == observed_year:
		return

	luxury_exchange_intent_queue.append({
		"request_kind": (
			"centerpiece_hover_observation"
		),
		"actor_id": int(
			gs.player.id
		),
		"observation_contract": (
			observation_contract.duplicate(false)
		),
		"queued_at_ms": int(
			Time.get_ticks_msec()
		)
	})

	set_meta(
		"luxury_exchange_centerpiece_hover_input_engine_calls",
		false
	)
	set_meta(
		"luxury_exchange_centerpiece_hover_input_mutation",
		false
	)
	set_meta(
		"luxury_exchange_centerpiece_hover_intent_latched",
		true
	)
