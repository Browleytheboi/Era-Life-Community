func _show_boxing_hub_panel(tab_id: String = "fight") -> void:
	if gs == null or gs.player == null:
		return

	boxing_hub_selected_tab = str(tab_id).strip_edges()
	if boxing_hub_selected_tab == "":
		boxing_hub_selected_tab = "fight"

	_boxing_hub_ensure_viewport_resize_contract()

	var visual_contract: Dictionary = MainSceneLogic._boxing_hub_visual_contract(gs)

	if boxing_hub_popup == null or not is_instance_valid(boxing_hub_popup):
		boxing_hub_popup = PopupPanel.new()
		boxing_hub_popup.name = "BoxingHubPopup"
		boxing_hub_popup.exclusive = true
		boxing_hub_popup.borderless = true
		boxing_hub_popup.unresizable = true
		add_child(boxing_hub_popup)
	else:
		boxing_hub_popup.exclusive = true
		boxing_hub_popup.borderless = true
		boxing_hub_popup.unresizable = true

	boxing_hub_popup.add_theme_stylebox_override("panel", MainSceneHelpers._boxing_hub_popup_style(visual_contract))

	for child in boxing_hub_popup.get_children():
		child.queue_free()

	var payload: Dictionary = {}
	if gs.boxing_contract_engine != null and gs.boxing_contract_engine.has_method("build_hub_payload"):
		payload = gs.boxing_contract_engine.build_hub_payload(gs.player, boxing_hub_selected_tab)
	else:
		payload = {
