func _terminate_world_seed_for_main_menu_return(
	reason: String = "return_to_main_menu",
	preserved_first: bool = false
) -> void:
	if _detach_resident_reality_for_main_menu_return(
		reason,
		preserved_first
	):
		return
	_stop_background_hydration_timer()

	_global_runtime_kill_enter_main_menu_runtime(
		reason,
		{
		"preserved_first": preserved_first,
		"preserve_creates_copy_before_termination": preserved_first,
		"simulation_work_forbidden": true
	})

	_reset_world_specific_ui_lens_state_for_new_world_seed("%s_before_seed_clear" % reason)
	_reset_newborn_birth_intro_diary_contract_for_new_world_seed("%s_before_seed_clear" % reason)
	_reset_god_mode_new_life_seed_contract_for_main_menu_return(reason, preserved_first)

	var now_ms: int = int(Time.get_ticks_msec())

	_terminate_death_transition_audio_for_world_seed_exit(reason, false)

	set_meta("menu_return_world_seed_terminated", true)
	set_meta("menu_return_world_seed_terminated_reason", reason)
	set_meta("menu_return_world_seed_terminated_after_preserve", preserved_first)
	set_meta("menu_return_world_seed_terminated_at_ms", now_ms)

	set_meta("other_countries_browser_cache_building", false)
	set_meta("other_countries_browser_entries_pending_cache_key", "")
	set_meta("other_countries_browser_entries_cache_key", "")
	set_meta("other_countries_browser_entries_cache", [])
	set_meta("birth_intro_cry_armed_for_first_playable_ui", false)
	set_meta("birth_intro_cry_waiting_for_playable_ui", false)
	set_meta("birth_intro_cry_played_for_birth_shell", false)
	set_meta("spawn_ready_visible_ui_ready_for_audio", false)
	set_meta("god_mode_handoff_cover_release_pending", false)

	if birth_intro_cry_player != null and is_instance_valid(birth_intro_cry_player):
		birth_intro_cry_player.stop()

	if character_switch_audio_player != null and is_instance_valid(character_switch_audio_player):
		character_switch_audio_player.stop()

	if gs == null:
		return

	for engine_property in [
		"runtime_contract_engine",
		"shared_public_space_engine",
		"movie_theater_engine",
		"grocery_store_engine",
		"food_restaurant_engine",
		"ui_contract_engine",
		"embedded_ui_contract_engine",
		"simulation_contract_engine",
		"player_action_engine",
		"world_space_engine",
		"chunk_simulation_engine",
		"spatial_culling_engine",
		"dynamic_world_event_engine",
		"npc_memory_web_engine",
		"agent_memory_propagation_engine",
		"consciousness_engine",
		"goal_planning_engine",
		"willpower_engine",
		"population_shard_engine",
		"truth_resolution_contract_engine",
		"population_card_contract_engine",
		"world_observability_contract_engine",
		"observable_node_contract_engine",
		"global_node_contract_engine",
		"global_prewarm_contract_engine",
		"crown_population_view_contract",
		"dealership_contract_engine",
		"property_amenity_synthesis_contract_engine",
		"era_life_asset_catalog_expansion"

	]:
		var engine_property_name: String = str(engine_property)
		var engine_value: Variant = gs.get(engine_property_name)
		if engine_value is Object:
			var engine: Object = engine_value as Object
			if engine != null:
				MainSceneLogic._reset_transient_engine_for_menu_return(engine)

	gs.awaiting_new_life = false
	gs.afterlife_active = false
	gs.afterlife_state.clear()
	gs.realtime_enabled = false

	gs.world_feed.clear()
	gs.scenario_history.clear()
	gs.transient_scenario_biases.clear()
	gs.pending_death_messages.clear()
	gs.pending_inheritance_messages.clear()
	gs.pending_year_resolution_popups.clear()
	gs.pending_player_line_birth.clear()
	gs.dormant_runtime_sessions.clear()
	gs.dormant_npcs.clear()
	gs.memories.clear()
	gs.compressed_memories.clear()
	gs.controlled_lineage_ids.clear()

	gs.npcs.clear()
	gs.npc_index.clear()
	gs.player = null
	gs.player_id = 0
	gs.next_id = 1
	gs.year = 2000

	gs.custom_mode = true
	gs.custom_settings = _build_default_custom_settings()
	gs.custom_settings ["_god_mode_entry_kind"] = "custom"

	gs.scenario_state = {
		"startup_intro_shell_only": true,
		"materialize_world_seed_on_initialize": false,
		"soul_seed_distribution_authorized": false,
		"soul_seed_distribution_reason": "blocked_until_manual_god_mode_prewarm",
		"defer_static_world_bootstrap": true,
		"defer_live_runtime_watchers": true,
		"post_spawn_ui_finalize_pending": false,
		"birth_shell_deferred_boot_pending": false,
		"birth_shell_deferred_boot_complete": false,
		"post_spawn_world_prewarm_pending": false,
		"deferred_data_bootstrap_pending": false,
		"deferred_runtime_watchers_bootstrap": false,
		"era_audio_returned_to_god_mode_menu_at_ms": now_ms,
		"menu_return_world_seed_terminated": true,
		"menu_return_world_seed_terminated_reason": reason,
		"menu_return_world_seed_terminated_after_preserve": preserved_first,
		"menu_return_world_seed_terminated_at_ms": now_ms
	}

	if gs.has_method("_hydrate_reality_settings"):
		gs._hydrate_reality_settings()

	_reset_world_specific_ui_lens_state_for_new_world_seed("%s_after_gs_seed_clear" % reason)
	_reset_newborn_birth_intro_diary_contract_for_new_world_seed("%s_after_gs_seed_clear" % reason)
	_reset_god_mode_new_life_seed_contract_for_main_menu_return("%s_after_gs_seed_clear" % reason, preserved_first)
func _restore_main_menu_runtime_surface_after_world_exit(reason: String = "return_to_main_menu", keep_god_mode_hot_shell: bool = false) -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	_reset_god_mode_new_life_seed_contract_for_main_menu_return("%s_restore_main_menu_surface" % reason, false)
	_reset_god_mode_runtime_firewall_for_intentional_return("%s_restore_main_menu_surface" % reason)

	set_meta("main_menu_surface_terminated_for_playable_entry", false)
	set_meta("main_menu_surface_terminated_reason", "")
	set_meta("choose_adventure_surface_hard_killed_for_playable_entry", false)
	set_meta("choose_adventure_surface_hard_killed_reason", "")
	set_meta("main_menu_surface_active", true)
	set_meta("main_menu_surface_restore_after_world_exit", true)
	set_meta("main_menu_surface_restore_after_world_exit_reason", reason)
	set_meta("main_menu_surface_restore_after_world_exit_at_ms", now_ms)
	set_meta("menu_return_blocks_gameplay_surface_restore", true)
	set_meta("menu_return_visual_surface_required", true)

	_global_runtime_kill_enter_main_menu_runtime(reason, {
		"simulation_work_forbidden": true,
		"keep_god_mode_hot_shell": keep_god_mode_hot_shell
	})
	call_deferred("_prebuild_god_mode_viewer_surface_for_choose_ereality", "%s_rebuild_god_mode_door_after_world_exit" % reason)
	current_panel = "choose_adventure_entry"

	if output_label != null and is_instance_valid(output_label):
		output_label.clear()
		output_label.visible = false
		output_label.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if player_stats_overlay != null and is_instance_valid(player_stats_overlay):
		player_stats_overlay.visible = false
		player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var root:= get_node_or_null("UIContainer") as Control
	if root != null and is_instance_valid(root):
		root.visible = false
		root.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		choose_adventure_entry_overlay.process_mode = Node.PROCESS_MODE_INHERIT
		choose_adventure_entry_overlay.visible = true
		choose_adventure_entry_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
		choose_adventure_entry_overlay.modulate = Color(1.0, 1.0, 1.0, 1.0)
		choose_adventure_entry_overlay.top_level = true
		choose_adventure_entry_overlay.z_as_relative = false
		choose_adventure_entry_overlay.z_index = 4096

		if choose_adventure_entry_dim != null and is_instance_valid(choose_adventure_entry_dim):
			choose_adventure_entry_dim.visible = true
			choose_adventure_entry_dim.mouse_filter = Control.MOUSE_FILTER_STOP

		_bring_modal_to_front(choose_adventure_entry_overlay)

		_restart_choose_adventure_entry_panel_motion()
	else:
		_show_choose_adventure_entry_panel()

	if choose_adventure_entry_overlay == null or not is_instance_valid(choose_adventure_entry_overlay) or not choose_adventure_entry_overlay.visible:
		_show_choose_adventure_entry_panel()

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_menu_surface_active"] = true
		gs.scenario_state ["main_menu_surface_restored_after_world_exit"] = true
		gs.scenario_state ["main_menu_surface_restore_after_world_exit_reason"] = reason
		gs.scenario_state ["global_runtime_domain"] = "main_menu"
		gs.scenario_state ["global_runtime_simulation_allowed"] = false
		gs.scenario_state ["prelife_domain_blocks_simulation_work"] = true
func _return_to_god_mode_selection_center(preserve_first: bool) -> void:
	_global_runtime_kill_enter_main_menu_runtime("return_to_god_mode_selection_center", {
		"preserve_first": preserve_first,
		"simulation_work_forbidden": true
	})

	_reset_god_mode_runtime_firewall_for_intentional_return("return_to_god_mode_selection_center")
	set_meta("god_mode_panel_non_runtime", false)
	set_meta("god_mode_panel_contract_emitted", false)
	set_meta("god_mode_panel_may_process", true)
	set_meta("god_mode_panel_may_reassert_visibility", true)
	set_meta("god_mode_panel_may_hold_visual_authority", true)
	_disarm_playable_life_surface_authority_lock("return_to_god_mode_selection_center")
	_abort_god_mode_tracker_handoff("return_to_god_mode_selection_center")
	if preserve_first:
		_save_current_life_to_slot()

	_close_exit_menu_confirm_popup()
	_hide_standard_tab_popup()
	_hide_relationship_profile_popup()
	_hide_relationship_browser()
	_hide_activities_action_panel()
	_hide_world_action_panel()
	_close_saved_life_picker()
	_cancel_panel_content_transition()
	_close_runtime_floating_huds_for_god_mode()
	_reset_menu_return_presentation_runtime("return_to_main_menu")

	var next_boot_ticket: int = int(get_meta("life_boot_ticket", 0)) + 1
	set_meta("life_boot_ticket", next_boot_ticket)
	set_meta("age_up_transition_busy", false)
	set_meta("startup_live_shell_loading", false)
	set_meta("age_up_post_loading_finalize_pending", false)
	set_meta("age_up_loading_runtime_begin_pending", false)
	set_meta("age_up_loading_runtime_begin_earliest_ms", 0)
	set_meta("age_up_loading_deferred_begin_context", {})
	set_meta("age_up_loading_first_visible_runtime_started", false)
	set_meta("age_up_loading_prewarm_ready", false)
	set_meta("age_up_loading_prewarm_signature", "")
	set_meta("live_diagnostics_manual_throttle_enabled", false)
	set_meta("live_diagnostics_opening_quarantine_frames", 0)
	set_meta("live_diagnostics_opening_quarantine_until_ms", 0)
	set_meta("runtime_interaction_quiet_until_ms", 0)
	set_meta("ui_interaction_grace_until_ms", 0)

	var keep_god_mode_hot_shell: bool = god_mode_start_panel != null and is_instance_valid(god_mode_start_panel)

	_terminate_world_seed_for_main_menu_return(
		"return_to_main_menu_preserved" if preserve_first else "return_to_main_menu_without_preserve",
		preserve_first
	)

	set_meta("god_mode_start_panel_prewarmed", keep_god_mode_hot_shell)
	set_meta("god_mode_start_panel_prewarming", false)
	set_meta("god_mode_audio_fadeout_requested", false)
	set_meta("god_mode_audio_handoff_armed", false)

	live_diagnostics_force_frames = 0
	live_diagnostics_refresh_accumulator = 0.0
	set_meta("live_diagnostics_deferred_force_frames", 0)

	if age_up_loading_runtime_active:
		_hide_age_up_loading_overlay()
	elif age_up_loading_overlay != null:
		age_up_loading_overlay.visible = false

	if live_diagnostics_panel != null and is_instance_valid(live_diagnostics_panel):
		live_diagnostics_panel.visible = false

	current_panel = "choose_adventure_entry"

	if output_label != null:
		output_label.clear()
		output_label.visible = false

	if player_stats_overlay != null:
		player_stats_overlay.visible = false

	if keep_god_mode_hot_shell:
		_hide_prewarmed_god_mode_start_panel()
		set_meta("god_mode_start_panel_prewarmed", true)
	else:
		feature_override_toggles.clear()
		reality_mode_picker = null
		god_mode_preview_label = null
		god_mode_randomizer_button = null
		god_mode_start_random_life_button = null
		god_mode_start_scroll_container = null
		god_mode_start_scrollbar = null
		if god_mode_scrollbar_fade_tween != null:
			god_mode_scrollbar_fade_tween.kill()
			god_mode_scrollbar_fade_tween = null
		god_mode_scrollbar_last_value = 0.0
		god_mode_scrollbar_last_activity_ms = 0
		god_mode_back_to_main_menu_glow_shell = null
		god_mode_back_to_main_menu_button = null
		god_mode_start_button = null
		god_mode_load_button = null
		superpower_sandbox_button = null
		superpower_sandbox_summary_label = null
		superpower_sandbox_panel = null
		superpower_sandbox_config = null

	if keep_god_mode_hot_shell:
		_hide_prewarmed_god_mode_start_panel()
	else:
		if god_mode_start_panel != null:
			if is_instance_valid(god_mode_start_panel):
				god_mode_start_panel.queue_free()
			god_mode_start_panel = null
		if god_mode_panel_glow_shell != null:
			if is_instance_valid(god_mode_panel_glow_shell):
				god_mode_panel_glow_shell.queue_free()
			god_mode_panel_glow_shell = null

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_ensure_choose_adventure_preboot_engines()
	_restore_main_menu_runtime_surface_after_world_exit(
		"return_to_main_menu_preserved" if preserve_first else "return_to_main_menu_without_preserve",
		keep_god_mode_hot_shell
	)

	_transition_audio_to_god_mode_selection_center("return_to_main_menu", 920)
	set_meta("god_mode_start_panel_prewarmed", keep_god_mode_hot_shell)
