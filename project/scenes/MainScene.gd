func _arm_resident_main_tab_renderer_deck_prewarm_service(
	source: String = "resident_main_tab_renderer_deck_prewarm"
) -> void:
	if resident_main_tab_renderer_prewarm_queue.is_empty():
		resident_main_tab_renderer_prewarm_service_active = false
		set_meta(
			"resident_main_tab_renderer_prewarm_process_frame_connected",
			false
		)
		set_meta(
			"resident_main_tab_renderer_prewarm_deferred_pending",
			false
		)
		return

	resident_main_tab_renderer_prewarm_service_active = true
	set_meta(
		"resident_main_tab_renderer_prewarm_service_armed",
		true
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_service_armed_source",
		source
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_service_armed_queue_size",
		resident_main_tab_renderer_prewarm_queue.size()
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_service_armed_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	var service_callable: Callable = Callable(
		self,
		"_service_resident_main_tab_renderer_deck_prewarm"
	)
	var scene_tree:= get_tree()

	if scene_tree == null:
		if not bool(
			get_meta(
				"resident_main_tab_renderer_prewarm_deferred_pending",
				false
			)
		):
			set_meta(
				"resident_main_tab_renderer_prewarm_deferred_pending",
				true
			)
			call_deferred(
				"_service_resident_main_tab_renderer_deck_prewarm"
			)

		return

	if scene_tree.process_frame.is_connected(
		service_callable
	):
		set_meta(
			"resident_main_tab_renderer_prewarm_process_frame_connected",
			true
		)
		set_meta(
			"resident_main_tab_renderer_prewarm_duplicate_connect_prevented",
			true
		)
		set_meta(
			"resident_main_tab_renderer_prewarm_duplicate_connect_prevented_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	scene_tree.process_frame.connect(
		service_callable,
		CONNECT_ONE_SHOT
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_process_frame_connected",
		true
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_duplicate_connect_prevented",
		false
	)
func _queue_resident_main_tab_renderer_deck_prewarm(
	actor_id: int,
	contracts: Dictionary,
	source: String
) -> void:
	if (
		actor_id <= 0
		or contracts.is_empty()
	):
		return

	var real_contracts: Dictionary = {}
	var rejected_pointer_only_tabs: Array = []

	for raw_surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var surface_id: String = str(
			raw_surface_id
		)
		var contract: Dictionary = MainSceneHelpers._safe_dictionary(
			contracts.get(
				surface_id,
				{}
			)
		)

		if (
			contract.is_empty()
			or int(
				contract.get(
					"actor_id",
					-1
				)
			) != actor_id
		):
			continue

		var schema: String = str(
			contract.get(
				"schema",
				""
			)
		).strip_edges().to_lower()
		var truth_state: String = str(
			contract.get(
				"truth_state",
				""
			)
		).strip_edges().to_lower()

		if (
			schema == "eralife.pointer_only.destination_tab_contract"
			or truth_state == "pointer_only_resident_shell"
			or bool(
				contract.get(
					"pointer_only",
					false
				)
			)
		):
			rejected_pointer_only_tabs.append(
				surface_id
			)
			continue

		real_contracts [
			surface_id
		] = contract.duplicate(false)

	if real_contracts.is_empty():
		set_meta(
			"resident_main_tab_renderer_deck_pointer_only_rejected",
			true
		)
		set_meta(
			"resident_main_tab_renderer_deck_pointer_only_rejected_actor_id",
			actor_id
		)
		set_meta(
			"resident_main_tab_renderer_deck_pointer_only_rejected_tabs",
			rejected_pointer_only_tabs.duplicate(false)
		)
		set_meta(
			"resident_main_tab_renderer_deck_pointer_only_rejected_source",
			source
		)
		set_meta(
			"resident_main_tab_renderer_deck_pointer_only_rejected_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)

		EraLog.truth(
			"MAIN_TAB_DECK_REGISTER_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|reason=pointer_only_contracts_are_not_render_surfaces"
			+ "|pointer_only_tabs=" + str(rejected_pointer_only_tabs)
			+ "|source=" + source
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)

		return

	var actor_key: String = str(actor_id)
	var deck: Dictionary = (
		_resident_main_tab_renderer_deck_for_actor(
			actor_id
		)
	)

	if deck.is_empty():
		deck = {
			"actor_id": actor_id,
			"world_seed_ui_lens_key": (
				_world_seed_ui_lens_key()
			),
			"world_year": (
				int(gs.year)
				if gs != null
				else -999999
			),
			"contracts": {},
			"created_at_ms": int(
				Time.get_ticks_msec()
			)
		}

	var deck_contracts: Dictionary = MainSceneHelpers._safe_dictionary(
		deck.get(
			"contracts",
			{}
		)
	)

	for raw_surface_id in real_contracts.keys():
		var surface_id: String = str(
			raw_surface_id
		)
		deck_contracts [
			surface_id
		] = MainSceneHelpers._safe_dictionary(
			real_contracts.get(
				surface_id,
				{}
			)
		).duplicate(false)

	deck [
		"contracts"
	] = deck_contracts.duplicate(false)
	deck [
		"updated_at_ms"
	] = int(
		Time.get_ticks_msec()
	)
	deck [
		"pointer_only_contracts_rejected"
	] = rejected_pointer_only_tabs.duplicate(false)
	deck [
		"source"
	] = source

	resident_main_tab_renderer_deck_by_actor [
		actor_key
	] = deck

	for raw_surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var surface_id: String = str(
			raw_surface_id
		)

		if not real_contracts.has(
			surface_id
		):
			continue

		var contract: Dictionary = MainSceneHelpers._safe_dictionary(
			real_contracts.get(
				surface_id,
				{}
			)
		)

		if contract.is_empty():
			continue

		var existing_panel: Control = (
			deck.get(
				surface_id,
				null
			) as Control
		)
		var existing_hot: bool = false

		match surface_id:
			"relationships":
				var relationships_panel:= (
					existing_panel
					as RelationshipHubPanel
				)
				existing_hot = (
					relationships_panel != null
					and is_instance_valid(
						relationships_panel
					)
					and relationships_panel.has_renderable_contract(
						actor_id
					)
				)

			"school":
				var school_panel:= (
					existing_panel as SchoolHubPanel
				)
				existing_hot = (
					school_panel != null
					and is_instance_valid(
						school_panel
					)
					and school_panel.has_renderable_contract(
						actor_id
					)
				)

			"activities":
				var activities_panel:= (
					existing_panel as ActivitiesHubPanel
				)
				existing_hot = (
					activities_panel != null
					and is_instance_valid(
						activities_panel
					)
					and activities_panel.has_renderable_contract(
						actor_id
					)
				)

			"career":
				var career_panel_for_actor:= (
					existing_panel as CareerHubPanel
				)
				existing_hot = (
					career_panel_for_actor != null
					and is_instance_valid(
						career_panel_for_actor
					)
					and _career_hub_contract_is_renderable(
						career_panel_for_actor.active_contract,
						actor_id
					)
				)

			"mods":
				var mods_panel:= (
					existing_panel as ModMenuPanel
				)
				existing_hot = (
					mods_panel != null
					and is_instance_valid(
						mods_panel
					)
					and mods_panel.has_precomposed_surface(
						actor_id
					)
				)

		if existing_hot:
			continue

		var revision: String = str(
			contract.get(
				"surface_revision",
				hash(contract)
			)
		)
		var queue_key: String = (
			"%s::%d::%s::%s"
			% [
				_world_seed_ui_lens_key(),
				actor_id,
				surface_id,
				revision
			]
		)

		if resident_main_tab_renderer_prewarm_keys.has(
			queue_key
		):
			continue

		resident_main_tab_renderer_prewarm_keys [
			queue_key
		] = true
		resident_main_tab_renderer_prewarm_queue.append({
			"queue_key": queue_key,
			"actor_id": actor_id,
			"surface_id": surface_id,
			"contract": contract.duplicate(false),
			"source": source,
			"world_seed_ui_lens_key": (
				_world_seed_ui_lens_key()
			)
		})

	EraLog.truth(
		"MAIN_TAB_DECK_REGISTERED"
		+ "|actor_id=" + str(actor_id)
		+ "|real_contract_count=" + str(real_contracts.size())
		+ "|pointer_only_rejected=" + str(rejected_pointer_only_tabs)
		+ "|queue_size=" + str(resident_main_tab_renderer_prewarm_queue.size())
		+ "|source=" + source
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

	if not resident_main_tab_renderer_prewarm_queue.is_empty():
		_arm_resident_main_tab_renderer_deck_prewarm_service(
			"%s_queue"
			% source
		)
func _service_resident_main_tab_renderer_deck_prewarm() -> void:
	set_meta(
		"resident_main_tab_renderer_prewarm_deferred_pending",
		false
	)
	set_meta(
		"resident_main_tab_renderer_prewarm_process_frame_connected",
		false
	)

	if resident_main_tab_renderer_prewarm_queue.is_empty():
		resident_main_tab_renderer_prewarm_service_active = false
		return

	resident_main_tab_renderer_prewarm_service_active = true

	var started_at_ms: int = int(
		Time.get_ticks_msec()
	)
	var request: Dictionary = MainSceneHelpers._safe_dictionary(
		resident_main_tab_renderer_prewarm_queue.pop_front()
	)
	var queue_key: String = str(
		request.get(
			"queue_key",
			""
		)
	)

	if queue_key != "":
		resident_main_tab_renderer_prewarm_keys.erase(
			queue_key
		)

	var actor_id: int = int(
		request.get(
			"actor_id",
			-1
		)
	)
	var surface_id: String = str(
		request.get(
			"surface_id",
			""
		)
	).strip_edges().to_lower()
	var request_lens_key: String = str(
		request.get(
			"world_seed_ui_lens_key",
			""
		)
	)
	var contract: Dictionary = MainSceneHelpers._safe_dictionary(
		request.get(
			"contract",
			{}
		)
	)
	var request_valid: bool = (
		actor_id > 0
		and surface_id != ""
		and request_lens_key == _world_seed_ui_lens_key()
		and not contract.is_empty()
		and int(
			contract.get(
				"actor_id",
				-1
			)
		) == actor_id
	)

	if request_valid:
		var actor_key: String = str(
			actor_id
		)
		var deck: Dictionary = (
			_resident_main_tab_renderer_deck_for_actor(
				actor_id
			)
		)

		if deck.is_empty():
			deck = {
				"actor_id": actor_id,
				"world_seed_ui_lens_key": (
					_world_seed_ui_lens_key()
				),
				"world_year": (
					int(gs.year)
					if gs != null
					else -999999
				),
				"contracts": {}
			}

		var panel: Control = (
			deck.get(
				surface_id,
				null
			) as Control
		)

		if (
			panel == null
			or not is_instance_valid(
				panel
			)
		):
			panel = _new_resident_main_tab_renderer_panel(
				surface_id,
				actor_id
			)

		if (
			panel != null
			and is_instance_valid(
				panel
			)
		):
			match surface_id:
				"relationships":
					var relationships_panel:= (
						panel as RelationshipHubPanel
					)

					relationships_panel.render_contract(
						contract
					)
					relationships_panel.hide_surface()

				"school":
					var school_panel:= (
						panel as SchoolHubPanel
					)

					school_panel.render_contract(
						contract
					)
					school_panel.hide_surface()

				"activities":
					var activities_panel:= (
						panel as ActivitiesHubPanel
					)

					activities_panel.render_contract(
						contract
					)
					activities_panel.visible = false
					activities_panel.mouse_filter = (
						Control.MOUSE_FILTER_IGNORE
					)
					activities_panel.process_mode = (
						Node.PROCESS_MODE_INHERIT
					)

				"career":
					var career_panel_for_actor:= (
						panel as CareerHubPanel
					)

					career_panel_for_actor.render_contract(
						contract
					)
					career_panel_for_actor.visible = false
					career_panel_for_actor.mouse_filter = (
						Control.MOUSE_FILTER_IGNORE
					)
					career_panel_for_actor.process_mode = (
						Node.PROCESS_MODE_INHERIT
					)

				"mods":
					var mods_panel:= (
						panel as ModMenuPanel
					)

					mods_panel.render_contract(
						contract
					)
					mods_panel.visible = false
					mods_panel.mouse_filter = (
						Control.MOUSE_FILTER_IGNORE
					)
					mods_panel.process_mode = (
						Node.PROCESS_MODE_INHERIT
					)

			deck [
				surface_id
			] = panel
			deck [
				"updated_at_ms"
			] = int(
				Time.get_ticks_msec()
			)

			resident_main_tab_renderer_deck_by_actor [
				actor_key
			] = deck





			if (
				gs != null
				and gs.player != null
				and int(
					gs.player.id
				) == actor_id
			):
				_activate_resident_main_tab_renderer_deck_for_actor(
					actor_id,
					(
						"resident_main_tab_renderer_progressive_"
						+ surface_id
					)
				)

	var actor_deck_hot: bool = (
		_resident_main_tab_renderer_deck_is_hot(
			actor_id
		)
	)

	if actor_deck_hot:
		set_meta(
			"resident_actor_renderer_deck_hot_actor_id",
			actor_id
		)
		set_meta(
			"resident_actor_renderer_deck_hot_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"resident_actor_renderer_deck_build_on_switch",
			false
		)

		_publish_resident_actor_lens_to_profile_surface(
			actor_id
		)

		var active_target: Person = (
			_relationship_profile_active_target()
		)

		if (
			active_target != null
			and int(
				active_target.id
			) == actor_id
			and relationship_profile_popup_switch_button != null
			and is_instance_valid(
				relationship_profile_popup_switch_button
			)
		):
			relationship_profile_popup_switch_button.disabled = false
			relationship_profile_popup_switch_button.mouse_filter = (
				Control.MOUSE_FILTER_STOP
			)

		if (
			gs != null
			and gs.player != null
			and int(
				gs.player.id
			) == actor_id
		):
			_activate_resident_main_tab_renderer_deck_for_actor(
				actor_id,
				"resident_main_tab_renderer_deck_prewarm_completed"
			)

		EraLog.truth(
			"OBSERVABLE_ACTOR_RENDERER_DECK_HOT"
			+ "|actor_id=" + str(
				actor_id
			)
			+ "|main_tabs=5/5"
			+ "|renderer_pages_resident=true"
			+ "|switch_press_work=false"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(
				Time.get_ticks_msec()
			)
		)

	EraLog.truth(
		"ERALIFE_MAIN_TAB_RENDERER_PREWARM_QUANTUM"
		+ "|actor_id=" + str(
			actor_id
		)
		+ "|surface_id=" + surface_id
		+ "|valid="
		+ str(
			request_valid
		).to_lower()
		+ "|controlled_actor="
		+ str(
			(
				gs != null
				and gs.player != null
				and int(
					gs.player.id
				) == actor_id
			)
		).to_lower()
		+ "|progressive_pointer_promotion=true"
		+ "|all_hot="
		+ str(
			actor_deck_hot
		).to_lower()
		+ "|queue_remaining=" + str(
			resident_main_tab_renderer_prewarm_queue.size()
		)
		+ "|duration_ms="
		+ str(
			maxi(
				0,
				int(
					Time.get_ticks_msec()
				) - started_at_ms
			)
		)
		+ "|frame_sliced=true"
		+ "|duplicate_process_frame_guard=true"
		+ "|idle_required=false"
		+ "|observation_required=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(
			Time.get_ticks_msec()
		)
	)

	if resident_main_tab_renderer_prewarm_queue.is_empty():
		resident_main_tab_renderer_prewarm_service_active = false
		return

	_arm_resident_main_tab_renderer_deck_prewarm_service(
		"resident_main_tab_renderer_deck_prewarm_continue"
	)
func _detach_actor_scoped_renderer_bindings_for_control_switch(
	target_id: int,
	source: String
) -> void:
	for raw_panel in [
		relationship_hub_panel,
		school_hub_panel,
		activities_hub_panel,
		career_hub_panel,
		mod_menu_panel
	]:
		var panel: Control = raw_panel as Control

		if (
			panel == null
			or not is_instance_valid(
				panel
			)
		):
			continue

		panel.visible = false
		panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)

	if relationship_hub_panel_active_actor_id != target_id:
		relationship_hub_panel = null
		relationship_hub_panel_active_actor_id = -1

	if school_hub_active_actor_id != target_id:
		school_hub_panel = null
		school_hub_active_actor_id = -1

	if activities_hub_active_actor_id != target_id:
		activities_hub_panel = null
		activities_hub_active_actor_id = -1
		activities_action_panel = null
		activities_action_back_button = null
		activities_action_title = null
		activities_action_scroll = null
		activities_action_list = null
		activities_action_status_label = null
		activities_action_open = false

	if career_hub_active_actor_id != target_id:
		career_hub_panel = null
		career_hub_active_actor_id = -1

	if mod_menu_active_actor_id != target_id:
		mod_menu_panel = null
		mod_menu_active_actor_id = -1



	var current_surface_contracts_raw: Variant = get_meta(
		"resident_main_tab_surface_contracts",
		{}
	)
	var current_surface_contracts: Dictionary = (
		current_surface_contracts_raw as Dictionary
		if typeof(
			current_surface_contracts_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var retained_surface_contracts: Dictionary = {}

	for raw_surface_id in [
		"relationships",
		"school",
		"activities",
		"career",
		"mods"
	]:
		var surface_id: String = str(
			raw_surface_id
		)
		var contract_raw: Variant = (
			current_surface_contracts.get(
				surface_id,
				{}
			)
		)
		var contract: Dictionary = (
			contract_raw as Dictionary
			if typeof(
				contract_raw
			) == TYPE_DICTIONARY
			else {}
		)

		if (
			not contract.is_empty()
			and int(
				contract.get(
					"actor_id",
					-1
				)
			) == target_id
		):
			retained_surface_contracts [
				surface_id
			] = contract

		var installed_actor_id: int = int(
			get_meta(
				(
					"native_main_tab_surface_projection_"
					+ "installed_actor_id_%s"
				) % surface_id,
				-1
			)
		)

		if installed_actor_id != target_id:
			set_meta(
				(
					"native_main_tab_surface_projection_"
					+ "installed_%s"
				) % surface_id,
				false
			)
			set_meta(
				(
					"native_main_tab_surface_projection_"
					+ "installed_actor_id_%s"
				) % surface_id,
				-1
			)

	set_meta(
		"resident_main_tab_surface_contracts",
		retained_surface_contracts
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		var scenario_contracts_raw: Variant = (
			gs.scenario_state.get(
				"resident_main_tab_surface_contracts",
				{}
			)
		)
		var scenario_contracts: Dictionary = (
			scenario_contracts_raw as Dictionary
			if typeof(
				scenario_contracts_raw
			) == TYPE_DICTIONARY
			else {}
		)
		var retained_scenario_contracts: Dictionary = {}

		for raw_surface_id in [
			"relationships",
			"school",
			"activities",
			"career",
			"mods"
		]:
			var surface_id: String = str(
				raw_surface_id
			)
			var contract_raw: Variant = (
				scenario_contracts.get(
					surface_id,
					{}
				)
			)
			var contract: Dictionary = (
				contract_raw as Dictionary
				if typeof(
					contract_raw
				) == TYPE_DICTIONARY
				else {}
			)

			if (
				not contract.is_empty()
				and int(
					contract.get(
						"actor_id",
						-1
					)
				) == target_id
			):
				retained_scenario_contracts [
					surface_id
				] = contract

		gs.scenario_state [
			"resident_main_tab_surface_contracts"
		] = retained_scenario_contracts

		gs.scenario_state [
			"resident_main_tab_surface_contracts_last_actor_id"
		] = (
			target_id
			if not retained_scenario_contracts.is_empty()
			else -1
		)

		if int(
			gs.scenario_state.get(
				"resident_actor_renderer_deck_active_actor_id",
				-1
			)
		) != target_id:
			gs.scenario_state [
				"resident_actor_renderer_deck_active_actor_id"
			] = -1

		gs.scenario_state [
			"actor_scoped_old_renderer_reuse_forbidden"
		] = true
		gs.scenario_state [
			"actor_scoped_old_renderer_revoked_for_target_id"
		] = target_id

	set_meta(
		"actor_scoped_renderer_bindings_detached_for_switch",
		true
	)
	set_meta(
		"actor_scoped_renderer_bindings_detached_target_id",
		target_id
	)
	set_meta(
		"actor_scoped_renderer_bindings_detached_source",
		source
	)
	set_meta(
		"actor_scoped_renderer_bindings_detached_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)
	set_meta(
		"actor_scoped_old_renderer_reuse_forbidden",
		true
	)
func _activate_resident_main_tab_renderer_deck_for_actor(
	actor_id: int,
	source: String
) -> bool:
	if actor_id <= 0:
		return false

	var deck: Dictionary = (
		_resident_main_tab_renderer_deck_for_actor(
			actor_id
		)
	)

	if deck.is_empty():
		_detach_actor_scoped_renderer_bindings_for_control_switch(
			actor_id,
			"%s_missing_deck"
			% source
		)

		set_meta(
			"resident_actor_renderer_deck_progressive_activation_pending",
			true
		)
		set_meta(
			"resident_actor_renderer_deck_progressive_activation_actor_id",
			actor_id
		)

		return false

	var contracts: Dictionary = MainSceneHelpers._safe_dictionary(
		deck.get(
			"contracts",
			{}
		)
	)
	var target_relationships:= (
		deck.get(
			"relationships",
			null
		) as RelationshipHubPanel
	)
	var target_school:= (
		deck.get(
			"school",
			null
		) as SchoolHubPanel
	)
	var target_activities:= (
		deck.get(
			"activities",
			null
		) as ActivitiesHubPanel
	)
	var target_career:= (
		deck.get(
			"career",
			null
		) as CareerHubPanel
	)
	var target_mods:= (
		deck.get(
			"mods",
			null
		) as ModMenuPanel
	)

	var relationships_hot: bool = (
		target_relationships != null
		and is_instance_valid(
			target_relationships
		)
		and target_relationships.has_renderable_contract(
			actor_id
		)
	)
	var school_hot: bool = (
		target_school != null
		and is_instance_valid(
			target_school
		)
		and target_school.has_renderable_contract(
			actor_id
		)
	)
	var activities_hot: bool = (
		target_activities != null
		and is_instance_valid(
			target_activities
		)
		and target_activities.has_renderable_contract(
			actor_id
		)
	)
	var career_hot: bool = (
		target_career != null
		and is_instance_valid(
			target_career
		)
		and _career_hub_contract_is_renderable(
			target_career.active_contract,
			actor_id
		)
	)
	var mods_hot: bool = (
		target_mods != null
		and is_instance_valid(
			target_mods
		)
		and target_mods.has_precomposed_surface(
			actor_id
		)
	)

	var hot_count: int = 0

	if relationships_hot:
		hot_count += 1
	if school_hot:
		hot_count += 1
	if activities_hot:
		hot_count += 1
	if career_hot:
		hot_count += 1
	if mods_hot:
		hot_count += 1

	var all_hot: bool = (
		hot_count == 5
	)




	_detach_actor_scoped_renderer_bindings_for_control_switch(
		actor_id,
		"%s_progressive_pointer_swap"
		% source
	)


	if relationships_hot:
		relationship_hub_panel = target_relationships
		relationship_hub_panel_active_actor_id = actor_id

		relationship_hub_panel.hide_surface()

