func _queue_crown_hub_refresh(force_next: bool = false, microtask: bool = false) -> void:
	if crown_hub_overlay == null or not crown_hub_open:
		return

	if force_next:
		set_meta("crown_hub_refresh_force_next", true)

	if microtask:
		set_meta("crown_hub_refresh_microtask", true)

	if bool(get_meta("crown_hub_refresh_pending", false)):
		return

	set_meta("crown_hub_refresh_pending", true)
	call_deferred("_flush_crown_hub_refresh")

func _flush_crown_hub_refresh() -> void:
	var use_microtask: bool = bool(get_meta("crown_hub_refresh_microtask", false))
	set_meta("crown_hub_refresh_microtask", false)

	if use_microtask:
		var tree:= get_tree()
		if tree != null:
			await tree.process_frame

	set_meta("crown_hub_refresh_pending", false)
	set_meta("crown_hub_refresh_force_next", false)
	set_meta("crown_hub_tab_switch_input_frame_must_not_block", false)

	_refresh_crown_hub()
