	return firewall.scenario_bool(gs.scenario_state, key, fallback, source)


func _sever_god_mode_runtime_authority(reason: String = "god_mode_panel_contract_emitted") -> void:
	var firewall:= _ensure_god_mode_runtime_firewall_engine()
	if firewall != null:
		firewall.sever(reason, {
			"source": reason,
			"main_scene": true,
		})

	set_meta("god_mode_panel_non_runtime", true)
	set_meta("god_mode_panel_contract_emitted", true)
	set_meta("god_mode_panel_contract_emitted_reason", reason)
	set_meta("god_mode_panel_contract_emitted_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_panel_may_process", false)
	set_meta("god_mode_panel_may_reassert_visibility", false)
	set_meta("god_mode_panel_may_hold_visual_authority", false)
	set_meta("god_mode_panel_may_hide_live_ui", false)

	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("god_mode_atomic_shell_handoff_active", false)
	set_meta("god_mode_shell_first_handoff_requested", false)
	set_meta("god_mode_handoff_cover_release_pending", false)
	set_meta("god_mode_cover_release_waiting_for_atomic_playable_ui", false)
	set_meta("god_mode_cover_keeps_full_panel_visible_until_live_frame", false)
	set_meta("god_mode_defer_cover_release_until_live_frame", false)
	set_meta("god_mode_live_surface_leak_quarantine_active", false)

	set_meta("main_menu_surface_active", false)
	set_meta("main_menu_surface_terminated_for_playable_entry", true)
	set_meta("main_menu_surface_terminated_reason", reason)

	set_meta("startup_intro_runtime_continue_pending", false)
	set_meta("startup_intro_sequence_runner_active", false)
	set_meta("startup_intro_loading_reveal_active", false)

	MainSceneHelpers._retire_god_mode_visual_authority_node(god_mode_start_panel, reason)
	MainSceneHelpers._retire_god_mode_visual_authority_node(god_mode_panel_glow_shell, reason)
	MainSceneHelpers._retire_god_mode_visual_authority_node(god_mode_background_dim, reason)
	MainSceneHelpers._retire_god_mode_visual_authority_node(choose_adventure_entry_overlay, reason)

	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay):
		startup_intro_overlay.visible = false
		startup_intro_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_panel_non_runtime"] = true
		gs.scenario_state ["god_mode_panel_contract_emitted"] = true
		gs.scenario_state ["god_mode_panel_contract_emitted_reason"] = reason
		gs.scenario_state ["god_mode_panel_contract_emitted_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["god_mode_panel_may_process"] = false
		gs.scenario_state ["god_mode_panel_may_reassert_visibility"] = false
		gs.scenario_state ["god_mode_panel_may_hold_visual_authority"] = false
		gs.scenario_state ["god_mode_panel_may_hide_live_ui"] = false
		gs.scenario_state ["god_mode_panel_is_runtime_system"] = false
		gs.scenario_state ["main_menu_surface_active"] = false
		gs.scenario_state ["main_menu_surface_terminated_for_playable_entry"] = true
		gs.scenario_state ["main_menu_surface_terminated_reason"] = reason


