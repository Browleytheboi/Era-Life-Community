func _hide_institution_hub() -> void:
	var clean_kind: String = str(institution_hub_kind).strip_edges().to_lower()
	var preserve_cached_surface: bool = clean_kind in ["relationships", "school", "career"] \
and institution_hub_list != null \
and is_instance_valid(institution_hub_list) \
and institution_hub_list.get_child_count() > 0

	institution_hub_open = false

	if preserve_cached_surface:
		set_meta("institution_hub_hidden_but_cached", true)
		set_meta("institution_hub_hidden_cached_kind", clean_kind)
		set_meta("institution_hub_hidden_cached_section", str(institution_hub_current_section).strip_edges().to_lower())
		set_meta("institution_hub_hidden_cached_at_ms", int(Time.get_ticks_msec()))
		set_meta("institution_hub_experience_rows_preserved_for_zero_frame_return", true)
	else:
		institution_hub_experience_rows.clear()
		institution_hub_experience_breathe_time = 0.0

	if not preserve_cached_surface:
		set_meta("relationship_hub_section_render_ticket", int(get_meta("relationship_hub_section_render_ticket", 0)) + 1)
		set_meta("relationship_hub_rebuild_ticket", int(get_meta("relationship_hub_rebuild_ticket", 0)) + 1)
		set_meta("relationship_hub_deeper_refresh_ticket", -1)
		set_meta("relationship_hub_next_live_card_refresh_ms", 0)
		set_meta("relationship_hub_visibility_cache_next_ms", 0)
		set_meta("relationship_hub_visibility_cache_scroll", -999999)
		set_meta("relationship_hub_navigation_perf_until_ms", 0)
		set_meta("relationship_hub_pending_section_render", "")
		set_meta("relationship_hub_pending_section_render_ms", 0)
	else:
		set_meta("relationship_hub_hidden_without_rebuild_ticket", true)
		set_meta("relationship_hub_hidden_cached_surface_preserved", true)
		set_meta("relationship_hub_back_did_not_invalidate_cached_room", true)

	if institution_hub_scroll != null:
		institution_hub_scroll.set_meta("smooth_scroll_active", false)
		institution_hub_scroll.set_meta("smooth_scroll_target", 0.0)
		institution_hub_scroll.set_meta("smooth_scroll_last_input_ms", 0)
		var vbar:= institution_hub_scroll.get_v_scroll_bar()
		if vbar != null:
			vbar.set_meta("institution_hub_scrollbar_style_key", "")
			vbar.modulate.a = 0.0

	if not preserve_cached_surface:
		_school_hub_reset_child_enrollment_flow()
		school_hub_expanded_class_zones.clear()
		_hide_school_class_roster_popup()

	if institution_hub_overlay != null:
		institution_hub_overlay.visible = false
		institution_hub_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
func _institution_hub_runtime_surface_active() -> bool:
