		if show_approval:
			_truth_paint_player_stat_bar_now(approval_label, approval_bar, "Approval", approval_value, 100, surface_context)

	player_stats_overlay.visible = true
	player_stats_overlay.mouse_filter = Control.MOUSE_FILTER_PASS
	player_stats_overlay.set_meta("player_stats_truth_painted_before_ready_cover_drop", true)
	player_stats_overlay.set_meta("player_stats_truth_painted_before_ready_cover_drop_reason", reason)
	player_stats_overlay.set_meta("player_stats_hover_enabled_on_first_life_shell_exposure", true)
	player_stats_overlay.set_meta("player_stats_bar_fill_visible_before_ready", true)

	if player_stats_root != null and is_instance_valid(player_stats_root):
		player_stats_root.mouse_filter = Control.MOUSE_FILTER_PASS

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["player_stats_truth_painted_before_ready_cover_drop"] = true
		gs.scenario_state ["player_stats_truth_painted_before_ready_cover_drop_reason"] = reason
		gs.scenario_state ["player_stats_hover_enabled_on_first_life_shell_exposure"] = true
		gs.scenario_state ["player_stats_bar_fill_visible_before_ready"] = true
func _truth_paint_player_stat_bar_now(label: Label, bar: ProgressBar, title: String, value: int, max_value: int, surface_context: Dictionary) -> void:
	if label == null or bar == null:
		return
	if not is_instance_valid(label) or not is_instance_valid(bar):
		return

	var safe_max: int = max(1, int(max_value))
	var safe_value: int = clamp(int(value), 0, safe_max)

	bar.max_value = safe_max
	bar.value = float(safe_value)
	bar.set_meta("player_stats_truth_painted_value", safe_value)
	bar.set_meta("player_stats_truth_painted_max", safe_max)
	bar.set_meta("player_stats_truth_painted_ratio", clampf(float(safe_value) / float(safe_max), 0.0, 1.0))
	bar.set_meta("player_stats_truth_painted_before_animation_loop", true)

	MainSceneHelpers._ensure_player_stat_bar_fill_lens(bar)
	_apply_player_stat_surface_content(label, bar, title, safe_value, safe_max, surface_context)
	bar.set_meta("player_stat_row_visual_signature", "")
	_apply_player_stat_row_visual_state(
		label,
		bar,
		title,
		false,
		title == "Health" and safe_value > 0 and safe_value < 30,
		_safe_player_stat_power_pulse()
	)
func _update_player_stats_overlay() -> void:
	_ensure_player_stats_overlay()
	_ensure_bending_hud()
	_ensure_belongings_hud()

	if player_stats_overlay == null:
		return

	if MainSceneLogic._god_mode_birth_surface_lock_active(gs, "update_player_stats_overlay"):
		_refresh_god_mode_birth_surface_lock("update_player_stats_overlay")
		return

	var live_reality_stream_bound: bool = _is_live_reality_stream_bound()
	var first_frame_snapshot_locked: bool = bool(get_meta("first_frame_ui_snapshot_locked", false)) and not bool(get_meta("first_frame_ui_snapshot_consumed", false))
	if first_frame_snapshot_locked and not live_reality_stream_bound:
		if _consume_first_frame_ui_snapshot_for_live_shell("update_player_stats_overlay_first_frame"):
			return

	var startup_prewarm_pending: bool = false
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		startup_prewarm_pending = bool(gs.scenario_state.get("post_spawn_ui_finalize_pending", false))

	var loading_runtime_active: bool = \
age_up_loading_runtime_active \
or bool(get_meta("age_up_transition_busy", false)) \
or bool(get_meta("age_up_post_loading_finalize_pending", false))

	var hide_for_loading_runtime: bool = loading_runtime_active and not startup_prewarm_pending
	var boot_spawn_animation_pending: bool = (
		startup_prewarm_pending
		or bool(get_meta("startup_live_shell_loading", false))
		or bool(get_meta("player_stats_spawn_cinematic_pending", false))
	) and not bool(get_meta("first_frame_ui_snapshot_locked", false)) and not live_reality_stream_bound

	var visible_life_shell_must_truth_fill: bool = _player_stats_overlay_must_truth_fill_on_visible_life_shell()
	if visible_life_shell_must_truth_fill:
		boot_spawn_animation_pending = false
		set_meta("startup_live_shell_loading", false)
		set_meta("player_stats_spawn_cinematic_pending", false)
		set_meta("player_stats_spawn_fill_consumed", false)
		set_meta("player_stats_truth_fill_forced_on_visible_life_shell", true)
		set_meta("player_stats_truth_fill_forced_on_visible_life_shell_at_ms", int(Time.get_ticks_msec()))

	if _player_stats_spawn_shell_should_truth_paint(
		boot_spawn_animation_pending,
		startup_prewarm_pending,
		live_reality_stream_bound
	):
		boot_spawn_animation_pending = false
		set_meta("player_stats_spawn_cinematic_pending", false)
		set_meta("player_stats_spawn_fill_consumed", false)
		set_meta("player_stats_truth_painted_after_spawn", true)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["player_stats_truth_painted_after_spawn"] = true
			gs.scenario_state ["player_stats_truth_painted_after_spawn_ms"] = int(Time.get_ticks_msec())


	if gs == null or gs.player == null or gs.awaiting_new_life or relationship_profile_popup_open or hide_for_loading_runtime:
		player_stats_overlay.visible = false
		if bending_hud_button != null:
			bending_hud_button.visible = false
		if bending_hud_panel != null:
			bending_hud_panel.visible = false
		if belongings_hud_button != null:
			belongings_hud_button.visible = false
		if belongings_hud_panel != null:
			belongings_hud_panel.visible = false
		return
	var p:= gs.player
	var current_actor_id: int = int(p.id)
	var overlay_actor_id: int = int(player_stats_overlay.get_meta("player_stats_current_actor_id", player_stats_overlay.get_meta("player_stats_bank_actor_id", -1)))
