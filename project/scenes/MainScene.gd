func _open_bending_hub_target_picker(ability_id: String) -> void:
	if gs == null or gs.player == null or gs.bending_engine == null:
		return

	_ensure_bending_hub_target_popup()
	bending_hub_pending_ability_id = ability_id

	if bending_hub_target_popup_title != null:
		bending_hub_target_popup_title.text = "Choose Duel Opponent" if ability_id == "__duel__" else "Choose Target"

	_clear_container_children(bending_hub_target_popup_list)

	var targets: Array = gs.bending_engine.get_bending_targets_for_player(gs.player, ability_id, false)
	if targets.is_empty():
		var empty_label:= Label.new()
		empty_label.text = "No valid targets in your nation right now."
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		bending_hub_target_popup_list.add_child(empty_label)
	else:
		for target_data in targets:
			if typeof(target_data) != TYPE_DICTIONARY:
				continue

			var target_id: int = int(target_data.get("id", -1))
			var relation_label: String = str(target_data.get("relation", "Nation"))
			var label_text: String = "%s • %s" % [
				str(target_data.get("name", "Unknown")),
				relation_label
			]

			var target_tooltip_text: String = ""
			if ability_id == "__duel__":
				var target_person: Person = gs.get_or_reactivate_npc_by_id(target_id) if gs.has_method("get_or_reactivate_npc_by_id") else null
				var willpower_text: String = _bending_hub_willpower_preview_text(target_person)
				label_text = "%s\n%s" % [
					label_text,
					willpower_text
				]
				target_tooltip_text = "%s\n\nShown before the duel because high willpower can trigger last stands, outcome resistance, and comeback surges." % willpower_text

			var btn:= _make_bending_hub_button(label_text)
			btn.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			btn.tooltip_text = target_tooltip_text
			btn.pressed.connect(_on_bending_hub_target_selected.bind(target_id))
			bending_hub_target_popup_list.add_child(btn)

	bending_hub_target_popup_dim.visible = true
	bending_hub_target_popup.visible = true
	_bring_modal_to_front(bending_hub_target_popup_dim)
	_bring_modal_to_front(bending_hub_target_popup)

func _close_bending_hub_target_popup() -> void:
	bending_hub_pending_ability_id = ""
	if bending_hub_target_popup_dim != null:
		bending_hub_target_popup_dim.visible = false
	if bending_hub_target_popup != null:
		bending_hub_target_popup.visible = false

func _on_bending_hub_target_selected(target_id: int) -> void:
	var actor: Person = _bending_hub_actor()
	if gs == null or actor == null or gs.bending_engine == null:
		return

	var target: Person = gs.get_or_reactivate_npc_by_id(target_id)
	if target == null:
		_maybe_show_action_result_popup({
			"success": false,
			"text": "That target is no longer available."
		})
		_close_bending_hub_target_popup()
		return

	if bending_hub_pending_ability_id == "__duel__":
		_close_bending_hub_target_popup()
		var queue_result: Dictionary = _queue_bending_hub_duel_scenario(actor, target)
		_refresh_scenario_ui_from_result(queue_result)
		bending_hud_last_rebuild_signature = ""
		_update_bending_hud()
		_update_player_stats_overlay()
		return

	var result: Dictionary = gs.bending_engine.use_bending_ability(actor, target, bending_hub_pending_ability_id)
	_close_bending_hub_target_popup()
	_maybe_show_action_result_popup(result)
	bending_hud_last_rebuild_signature = ""
	_update_bending_hud()
	_update_player_stats_overlay()
func _queue_bending_hub_duel_scenario(actor: Person, target: Person) -> Dictionary:
	if gs == null or actor == null or target == null:
		return {}
	if gs.scenario_engine == null or not gs.scenario_engine.has_method("queue_external_scenario"):
		return {
			"success": false,
			"popup_title": "Scenario Runtime Missing",
			"popup_text": "ScenarioEngine.queue_external_scenario() is unavailable.",
			"popup_footer": "Tap anywhere to continue."
		}

	var target_name: String = ("%s %s" % [target.first_name, target.last_name]).strip_edges()
	var actor_name: String = ("%s %s" % [actor.first_name, actor.last_name]).strip_edges()
	var relation_label: String = "Bender"
	var target_willpower_value: int = _bending_hub_willpower_value(target)
	var target_willpower_descriptor: String = MainSceneHelpers._bending_hub_willpower_descriptor(target_willpower_value)

	if gs.relationship_engine != null and gs.relationship_engine.has_method("get_relationship_label"):
		relation_label = str(gs.relationship_engine.get_relationship_label(actor, target))

	var scenario: Dictionary = {
		"id": "bending_hub_duel_%d_%d_%d" % [
			int(actor.id),
			int(target.id),
			int(Time.get_ticks_msec())
		],
		"source": "scenario_engine",
		"category": "bending",
		"cooldown_key": "bending_hub_duel",
		"resolver_method": "_resolve_bending_duel_choice",
		"panel_title": "BENDING DUEL",
		"footer_text": "Live elemental duel. Health bars, reads, counters, inventory actions, weapons, artifacts, and bending abilities can all matter.",
		"prompt": "%s challenges %s to a bending duel.\n\nOpponent Willpower: %d • %s\n\n%s studies your stance before the first move. Do you begin?" % [
			actor_name,
			target_name,
			target_willpower_value,
			target_willpower_descriptor,
			target_name
		],
		"actor_id": int(actor.id),
		"target_id": int(target.id),
		"bending_duel_target_id": int(target.id),
		"bending_duel_target_name": target_name,
		"bending_duel_contract": {
			"schema": "eralife.bending_duel_contract",
			"version": 2,
			"source": "bending_hub",
			"uses_scenario_panel": true,
			"damage_reflects_on_stats": true,
		},
		"combat_ui": {
			"visible": true,
			"theme": "bending_duel",
			"status_text": "Challenge issued"
		},
		"choices": [
			{
				"id": "bending_duel_accept",
				"label": "Begin the duel",
				"journal_text": "I began a bending duel with %s." % target_name,
				"button_theme": "bending_ability",
				"power_source": "bending",
				"bending_duel_target_id": int(target.id)
			},
			{
				"id": "bending_duel_decline",
				"label": "Back out",
				"journal_text": "I decided not to begin the bending duel with %s." % target_name,
				"button_theme": "defensive_escape",
				"power_source": "survival",
				"bending_duel_target_id": int(target.id)
			}
		],
		"context": {
			"relationship_label": relation_label,
			"target_willpower": target_willpower_value,
			"target_willpower_descriptor": target_willpower_descriptor
		}
	}

	return gs.scenario_engine.queue_external_scenario(scenario)
func _zero_frame_contract_dictionary(
	value: Variant
) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(false)

	return {}


func _zero_frame_contract_array(
	value: Variant
) -> Array:
	if typeof(value) == TYPE_ARRAY:
		return (value as Array).duplicate(false)

	return []
func _update_bending_hud() -> void:
	_ensure_bending_hud_button_shell()

	# FIX: the vignette is a full-screen tint, and its visibility used to be decided
	# at the very BOTTOM of this function -- behind five separate early returns. Any
	# of those paths skipped the hide, so the tint stayed over the whole game.
	#
	# It also must not follow bending_hud_open alone. Training hides the panel without
	# clearing that flag, so the flag goes stale: the overlay stayed up over the main
	# screen, and the next click on the hub button merely toggled the stale flag off
	# -- clearing the overlay but not opening the hub, which is why it took two clicks.
	# Treat "the panel is actually visible" as the truth, and repair the flag when it
	# has drifted.
	var bending_panel_showing: bool = (
		bending_hud_panel != null
		and is_instance_valid(bending_hud_panel)
		and bending_hud_panel.visible
	)

	if bending_hud_open and not bending_panel_showing:
		bending_hud_open = false

	if (
		bending_hud_legendary_vignette != null
		and is_instance_valid(bending_hud_legendary_vignette)
	):
		if bending_hud_legendary_vignette.visible != bending_panel_showing:
			bending_hud_legendary_vignette.visible = bending_panel_showing

	if bending_hud_button == null:
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var panel_ready: bool = bending_hud_panel != null and is_instance_valid(bending_hud_panel)
	var shell_only_runtime: bool = bool(get_meta("spawn_ready_runtime_hud_shell_only_active", false))
	var forced_open: bool = _is_runtime_floating_hud_forced_open("bending") and bending_hud_open

	var has_modal_blocker: bool = (
		action_result_popup_open
		or relationship_profile_popup_open
		or relationships_browser_open
		or activities_action_open
		or standard_tab_popup_open
		or world_feed_popup_open
		or (profile_panel_popup != null and profile_panel_popup.visible)
		or (belongings_item_popup != null and belongings_item_popup.visible)
		or (belongings_item_target_popup != null and belongings_item_target_popup.visible)
		or (crown_hub_overlay != null and crown_hub_overlay.visible)
		or (crown_action_popup != null and crown_action_popup.visible)
	)

	var blocked_by_age_up_loading: bool = (
		age_up_loading_runtime_active
		or bool(get_meta("age_up_transition_busy", false))
	)

	var can_show_base: bool = (
		gs != null
		and gs.player != null
		and not gs.awaiting_new_life
		and not _god_mode_ui_locked()
		and not blocked_by_age_up_loading
		and _player_has_visible_bending()
	)

	var can_show: bool = (
		can_show_base
		and not has_modal_blocker
		and (current_panel == "" or current_panel == "life" or forced_open or shell_only_runtime)
	)

	bending_hud_button.visible = can_show or forced_open
	bending_hud_button.disabled = not (can_show or forced_open)
	bending_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP if (can_show or forced_open) else Control.MOUSE_FILTER_IGNORE
	if bending_hud_button.visible:
		bending_hud_button.text = _bending_hud_button_icon()

	var core:= _bending_hud_core_color()
	var hud_pulse:= (sin(bending_hud_breathe_time * 2.0) + 1.0) * 0.5
	var btn_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(bending_hud_button, "bending_hud_button_style", 2, 16)
	if btn_style != null:
		bending_hud_button.add_theme_stylebox_override("normal", btn_style)
		bending_hud_button.add_theme_stylebox_override("hover", btn_style)
		bending_hud_button.add_theme_stylebox_override("pressed", btn_style)
		btn_style.bg_color = Color(core.r, core.g, core.b, 0.22 + (hud_pulse * 0.12))
		btn_style.border_color = Color(core.r, core.g, core.b, 0.42 + (hud_pulse * 0.18))
		bending_hud_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))

	_update_bending_hud_button_border_overlay(hud_pulse)

	if not bending_hud_open:
		_set_runtime_floating_hud_forced_open("bending", false)
		set_meta("bending_hub_content_rebuild_queued", false)
		set_meta("bending_hub_close_no_prewarm_until_ms", now_ms + 900)

		if panel_ready:
			bending_hud_panel.visible = false
		if bending_hud_legendary_vignette != null:
			bending_hud_legendary_vignette.visible = false

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["bending_hub_open"] = false
			gs.scenario_state ["bending_hub_close_shell_only"] = true
			gs.scenario_state ["bending_hub_close_no_truth_work"] = true
			gs.scenario_state ["bending_hub_closed_at_ms"] = now_ms

		_sync_runtime_floating_hud_layering()
		return

	if shell_only_runtime:
		set_meta("spawn_ready_runtime_hud_shell_only_active", false)
		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["spawn_ready_runtime_hud_shell_only_active"] = false

	if not can_show_base and not forced_open:
		bending_hud_open = false
		_set_runtime_floating_hud_forced_open("bending", false)
		set_meta("bending_hub_content_rebuild_queued", false)
		if panel_ready:
			bending_hud_panel.visible = false
		if bending_hud_legendary_vignette != null:
			bending_hud_legendary_vignette.visible = false
		_sync_runtime_floating_hud_layering()
		return

	if bending_hud_open and not panel_ready:
		_ensure_bending_hud()
		panel_ready = bending_hud_panel != null and is_instance_valid(bending_hud_panel)

	if not panel_ready:
		_sync_runtime_floating_hud_layering()
		return

	bending_hud_panel.visible = bending_hud_open and (can_show_base or forced_open)
	_sync_runtime_floating_hud_layering()

	_sync_bending_hub_section_visibility()
	bending_hud_button.text = _bending_hud_button_icon()

	var p: Person = _bending_hub_actor()
	if p == null:
		return

	var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	if clean_section not in MainSceneHelpers._bending_hub_valid_sections():
		clean_section = "profile"
		bending_hud_current_section = clean_section

	var display_type:= "None"
	if str(p.bending_type) != "" and str(p.bending_type) != "none":
		display_type = str(p.bending_type).capitalize()

	if bending_hud_subtitle_label != null:
		bending_hud_subtitle_label.text = "Type: %s\nNation: %s" % [
			display_type,
			p.bending_nation if str(p.bending_nation) != "" else "None"
		]

	if gs.bending_engine != null and gs.bending_engine.has_method("ensure_bending_level_state"):
		var level_sync_signature: String = "actor:%d|year:%d|age:%d|type:%s|mastery:%s|potential:%s|avatar_unlocked:%s|avatar_used:%s" % [
			int(p.id),
			int(gs.year),
			int(p.age),
			str(p.bending_type),
			str(p.bending_mastery),
			str(p.bending_latent_potential),
			str(p.avatar_state_unlocked),
			str(p.avatar_state_used)
		]
		if str(get_meta("bending_hud_level_sync_signature", "")) != level_sync_signature:
			set_meta("bending_hud_level_sync_signature", level_sync_signature)
			gs.bending_engine.ensure_bending_level_state(p)

	var next_content_check_ms: int = int(get_meta("bending_hub_next_content_signature_check_ms", 0))
	if now_ms >= next_content_check_ms:
		set_meta("bending_hub_next_content_signature_check_ms", now_ms + 300)
		var section_signatures_raw_for_update: Variant = get_meta("bending_hud_section_signatures", {})
		var section_signatures_for_update: Dictionary = section_signatures_raw_for_update if typeof(section_signatures_raw_for_update) == TYPE_DICTIONARY else {}
		var live_content_signature: String = _bending_hub_player_signature()
		if str(section_signatures_for_update.get(clean_section, "")) != live_content_signature and not bool(get_meta("bending_hub_content_rebuild_queued", false)):
			set_meta("bending_hub_content_rebuild_queued", true)
			call_deferred("_rebuild_bending_hub_current_section_deferred", clean_section, 0)

	if clean_section == "profile" and bending_hud_potential_label != null and gs.bending_engine != null and gs.bending_engine.has_method("get_bending_potential_summary"):
		var potential_summary: Dictionary = gs.bending_engine.get_bending_potential_summary(p)
		bending_hud_potential_label.text = str(potential_summary.get("text", "Latent Potential: None"))
		bending_hud_potential_label.visible = str(bending_hud_potential_label.text).strip_edges() != ""

	if clean_section == "stats":
		for element in ["air", "water", "earth", "fire"]:
			var row_data: Dictionary = bending_hud_rows.get(element, {})
			var row: Control = row_data.get("row", null)
			var label: Label = row_data.get("label", null)
			var bar: ProgressBar = row_data.get("bar", null)
			var mastery_value: int = clamp(int(p.bending_mastery.get(element, 0)), 0, 100)
			var potential_value: int = 0

			if gs.bending_engine != null and gs.bending_engine.has_method("get_bending_latent_potential"):
				potential_value = int(gs.bending_engine.get_bending_latent_potential(p, element))
			else:
				potential_value = clamp(int(p.bending_latent_potential.get(element, 0)), 0, 100)

			bending_hud_targets [element] = float(mastery_value)

			if row != null:
				row.visible = mastery_value > 0 or potential_value > 0 or str(p.bending_type) == "avatar" or str(p.bending_type) == element
			if bar != null:
				bar.max_value = 100.0
				bar.set_meta("bending_level", mastery_value)
			_apply_bending_hub_level_surface(row, label, bar, element, mastery_value)

	if bending_hud_avatar_state_button != null:
		var is_avatar:= str(p.bending_type) == "avatar"
		bending_hud_avatar_state_button.visible = is_avatar
		if is_avatar:
			bending_hud_avatar_state_button.disabled = not bool(p.avatar_state_unlocked) or bool(p.avatar_state_used)
			if bool(p.avatar_state_used):
				bending_hud_avatar_state_button.text = "Avatar State Used"
			elif bool(p.avatar_state_unlocked):
				bending_hud_avatar_state_button.text = "Activate Avatar State"
			else:
				bending_hud_avatar_state_button.text = "Avatar State Locked: master all four elements"
		_apply_bending_hud_avatar_state_button_visual_state(hud_pulse)

	var panel_style: StyleBoxFlat = MainSceneHelpers._runtime_stylebox_flat_from_meta(bending_hud_panel, "bending_hud_panel_style", 3, 24)
	if panel_style == null:
		return

	bending_hud_panel.add_theme_stylebox_override("panel", panel_style)
	panel_style.bg_color = Color(0.018, 0.026, 0.048, 0.995)
	panel_style.border_color = Color(core.r, core.g, core.b, 0.82 + (hud_pulse * 0.14))
	panel_style.shadow_color = Color(core.r, core.g, core.b, 0.26 + (hud_pulse * 0.08))
	panel_style.shadow_size = 42
	panel_style.shadow_offset = Vector2(0, 12)

	if bending_hud_legendary_vignette != null and bending_hud_open:
		# FIX: this ran on every HUD rebuild, and a training action forces a rebuild by
		# clearing bending_hud_last_rebuild_signature. Re-showing and repainting a
		# full-screen 0.56-alpha tint mid-interaction is the brief colour change over
		# the whole screen after training. Only touch the vignette when the value it
		# would be set to has actually changed.
		var vignette_color: Color = Color(
			core.r * 0.16,
			core.g * 0.18,
			core.b * 0.24,
			0.56
		)

		if not bending_hud_legendary_vignette.visible:
			bending_hud_legendary_vignette.visible = true

		if not bending_hud_legendary_vignette.color.is_equal_approx(vignette_color):
			bending_hud_legendary_vignette.color = vignette_color
	elif bending_hud_legendary_vignette != null:
		# FIX: there was no else branch. The vignette was only ever shown -- nothing in
		# this function turned it off -- so after closing the bending hub a
		# full-screen 0.56-alpha tint stayed over the entire game. That is the "screen
		# changed colour" report: not a flash during training, but a tint that never
		# went away once the hub had been opened.
		if bending_hud_legendary_vignette.visible:
			bending_hud_legendary_vignette.visible = false
func _animate_bending_hud(delta: float) -> void:
	if bending_hud_button == null:
		return

	bending_hud_breathe_time += delta

	var now_ms: int = int(Time.get_ticks_msec())
	var quick_pulse: float = (sin(bending_hud_breathe_time * 2.0) + 1.0) * 0.5
	var next_refresh_ms: int = int(get_meta("bending_hud_next_light_refresh_ms", 0))

	if now_ms >= next_refresh_ms:
		set_meta("bending_hud_next_light_refresh_ms", now_ms + 900)
		_update_bending_hud_button_border_overlay(quick_pulse)
		if bending_hud_avatar_state_button != null and bending_hud_panel != null and bending_hud_panel.visible:
			_apply_bending_hud_avatar_state_button_visual_state(quick_pulse)
		if not bending_hud_open:
			_update_bending_hud()
	else:
		_update_bending_hud_button_border_overlay(quick_pulse)
		if bending_hud_avatar_state_button != null and bending_hud_panel != null and bending_hud_panel.visible:
			_apply_bending_hud_avatar_state_button_visual_state(quick_pulse)

	if bending_hud_panel == null or not bending_hud_panel.visible:
		return

	var pulse_strength: float = (sin(bending_hud_breathe_time * 1.25) + 1.0) * 0.5
	var speed_scale: float = delta * 180.0
	var clean_section: String = str(bending_hud_current_section).strip_edges().to_lower()

	if clean_section == "stats":
		for element in ["air", "water", "earth", "fire"]:
			var row_data: Dictionary = bending_hud_rows.get(element, {})
			var row: Control = row_data.get("row", null)
			var label: Label = row_data.get("label", null)
			var bar: ProgressBar = row_data.get("bar", null)
			var target: float = float(bending_hud_targets.get(element, 0.0))
			if bar != null:
				bar.max_value = 100.0
				bar.value = move_toward(float(bar.value), target, speed_scale)
				_apply_bending_hub_level_surface(row, label, bar, element, int(round(bar.value)))
			_apply_player_stat_row_visual_state(
				label,
				bar,
				element.capitalize(),
				false,
				false,
				pulse_strength
			)

	if clean_section == "abilities":
		_animate_bending_hub_ability_visuals(pulse_strength)

	_apply_bending_hud_avatar_state_button_visual_state(pulse_strength)
func _ensure_wizard_hud() -> void:
	if wizard_hud_button != null and is_instance_valid(wizard_hud_button) and wizard_hud_panel != null and is_instance_valid(wizard_hud_panel):
		return

	var hud_parent: Node = self
	if hud_parent == null:
		return

	wizard_hud_button = Button.new()
	wizard_hud_button.visible = false
	wizard_hud_button.z_index = 301
	wizard_hud_button.mouse_filter = Control.MOUSE_FILTER_STOP
	wizard_hud_button.text = "🪄"
	wizard_hud_button.tooltip_text = "Open wizard hub"
	if not wizard_hud_button.pressed.is_connected(_toggle_wizard_hud):
		wizard_hud_button.pressed.connect(_toggle_wizard_hud)
