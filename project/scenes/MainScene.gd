func _show_migration_panel(result: Dictionary) -> void:
	if gs == null:
		return

	var payload: Dictionary = result.duplicate(true)
	var migration_owner: Person = gs.player
	var migration_owner_id: int = int(payload.get("owner_id", -1))
	if migration_owner_id > 0:
		var resolved_migration_owner: Person = gs.get_or_reactivate_npc_by_id(migration_owner_id)
		if resolved_migration_owner != null:
			migration_owner = resolved_migration_owner

	if migration_owner != null:
		payload ["owner_id"] = int(migration_owner.id)
	else:
		payload ["owner_id"] = -1

	var destinations: Array = payload.get("destinations", [])
	var body_lines: Array = []

	if migration_owner != null:
		body_lines.append("Current Home: %s, %s" % [
			str(migration_owner.home_city),
			str(migration_owner.home_country)
		])
	body_lines.append("Available Destinations: %d" % destinations.size())
	body_lines.append("")
	body_lines.append("Migration is now handled through a dedicated destination board.")
	body_lines.append("Choose a settlement from the right side to relocate there.")
	body_lines.append("The destination rows include travel cost, housing vibe, and how many known people are already there.")

	_show_standard_tab_popup(
		"MIGRATION BOARD • DESTINATIONS",
		body_lines,
		"migration_panel",
		payload
	)

	if standard_tab_popup_right == null:
		return

	_clear_container_children(standard_tab_popup_right)

	_standard_tab_add_info_card("MIGRATION PULSE", [
		"Pick a settlement to relocate there through MigrationEngine instead of teleporting blindly.",
		"This keeps the move flowing through your existing world, memory, and opportunity systems."
	])

	if destinations.is_empty():
		_standard_tab_add_info_label("No settlements are currently available.")
		return

	_standard_tab_add_section_header("Destinations")

	for raw_destination in destinations:
		if typeof(raw_destination) != TYPE_DICTIONARY:
			continue

		var destination: Dictionary = raw_destination
		var settlement_id: String = str(destination.get("settlement_id", ""))
		if settlement_id.strip_edges() == "":
			continue

		var settlement_name: String = str(destination.get("settlement_name", "Unknown Settlement"))
		var realm_name: String = str(destination.get("realm_name", "Unknown Realm"))
		var housing_vibe: String = str(destination.get("housing_vibe", "mixed"))
		var known_people_there: int = int(destination.get("known_people_there", 0))
		var travel_cost: int = int(destination.get("travel_cost", 0))

		var button_text:= "%s, %s" % [settlement_name, realm_name]
		var destination_button:= Button.new()
		destination_button.text = button_text
		destination_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		destination_button.pressed.connect(_on_migration_destination_pressed.bind(settlement_id, true))
		standard_tab_popup_right.add_child(destination_button)

		var detail_parts: Array = []
		detail_parts.append("Travel: %s" % _format_standard_tab_money(travel_cost))
		detail_parts.append("Housing: %s" % housing_vibe.capitalize())
		detail_parts.append("Known There: %d" % known_people_there)

		var cluster_preview_raw = destination.get("cluster_preview", {})
		if typeof(cluster_preview_raw) == TYPE_DICTIONARY:
			var cluster_preview: Dictionary = cluster_preview_raw
			detail_parts.append("Household Size: %d" % int(cluster_preview.get("household_size", 1)))

		var detail_label:= Label.new()
		detail_label.text = " • ".join(detail_parts)
		detail_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		standard_tab_popup_right.add_child(detail_label)


func _on_migration_destination_pressed(settlement_id: String, move_household: bool = true) -> void:
	if gs == null or gs.migration_engine == null:
		return

	var result: Dictionary = gs.migration_engine.submit_player_migration(settlement_id, move_household)
	var result_text:= str(result.get("text", "Done."))

	if activities_action_status_label != null:
		activities_action_status_label.text = result_text

	if not result.get("success", true):
		_maybe_show_action_result_popup(result)
		return

	_hide_standard_tab_popup()

	cached_last_result = result
	if result_text.strip_edges() != "":
		_append_text_to_diary(result_text, false)

	_render_life_diary_panel()

	current_opportunities_cache.clear()
	if gs != null and gs.afterlife_active:
		if result.has("opps"):
			current_opportunities_cache = result.get("opps", []).duplicate()
	else:
		if result.has("opps"):
			current_opportunities_cache = result.get("opps", []).duplicate()
		elif gs != null and gs.opportunity_engine != null and gs.player != null:
			current_opportunities_cache = gs.opportunity_engine.generate_opportunities(gs.player)

	_refresh_activities_action_panel()
	_maybe_show_action_result_popup(result)
	_update_player_stats_overlay()

