func _relationship_profile_action_min_age(action_id: String) -> int:
	var clean_action: String = str(action_id).strip_edges()
	if clean_action == "":
		return 0

	if clean_action.begins_with("relationship_contract:"):
		return 0

	var contract: Dictionary = _relationship_profile_surface_action_contract()
	var always_allowed: Array = contract.get("always_allowed", [])
	if clean_action in always_allowed:
		return 0

	var actions_raw: Variant = contract.get("actions", {})
	if typeof(actions_raw) == TYPE_DICTIONARY:
		var actions: Dictionary = actions_raw
		var action_raw: Variant = actions.get(clean_action, {})
		if typeof(action_raw) == TYPE_DICTIONARY:
			return int((action_raw as Dictionary).get("min_age", 0))

	var prefix_actions_raw: Variant = contract.get("prefix_actions", {})
	if typeof(prefix_actions_raw) == TYPE_DICTIONARY:
		var prefix_actions: Dictionary = prefix_actions_raw
		for raw_prefix in prefix_actions.keys():
			var prefix: String = str(raw_prefix)
			if clean_action.begins_with(prefix):
				var prefix_contract_raw: Variant = prefix_actions.get(raw_prefix, {})
				if typeof(prefix_contract_raw) == TYPE_DICTIONARY:
					return int((prefix_contract_raw as Dictionary).get("min_age", 0))

	return 0

func _relationship_profile_action_allowed_for_player_age(action_id: String, _target: Person = null) -> bool:
	if gs == null or gs.player == null:
		return true

	var clean_action: String = str(action_id).strip_edges()
	if clean_action == "":
		return true

	if clean_action.begins_with("relationship_contract:"):
		return true

	var min_age: int = _relationship_profile_action_min_age(clean_action)
	return int(gs.player.age) >= min_age

func _relationship_profile_action_locked_result(action_id: String, _target: Person = null) -> Dictionary:
	var clean_action: String = str(action_id).strip_edges()
	var min_age: int = _relationship_profile_action_min_age(clean_action)
	var action_label: String = clean_action
	var contract: Dictionary = _relationship_profile_surface_action_contract()
	var actions_raw: Variant = contract.get("actions", {})
	if typeof(actions_raw) == TYPE_DICTIONARY:
		var actions: Dictionary = actions_raw
		var action_raw: Variant = actions.get(clean_action, {})
		if typeof(action_raw) == TYPE_DICTIONARY:
			action_label = str((action_raw as Dictionary).get("label", clean_action)).strip_edges()

	if action_label == "":
		action_label = "That action"

	return {
		"success": false,
		"text": "%s unlocks at age %d." % [action_label, min_age],
		"popup_title": "Too Young",
		"popup_text": "You are too young for %s.\n\nThis relationship action unlocks at age %d." % [action_label, min_age],
		"popup_footer": "Tap anywhere to continue.",
		"relationship_profile_action_id": clean_action,
		"relationship_profile_min_age": min_age
	}

