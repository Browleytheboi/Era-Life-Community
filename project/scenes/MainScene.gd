		god_mode_start_panel = null

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = false
		god_mode_panel_glow_shell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_panel_glow_shell.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_panel_glow_shell.queue_free()
		god_mode_panel_glow_shell = null

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_background_dim.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_background_dim.set_meta("atomic_shell_cover_active", false)
		god_mode_background_dim.set_meta("atomic_shell_cover_release_reason", reason)

	set_meta("god_mode_atomic_shell_handoff_active", false)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("god_mode_start_panel_deferred_free_reason", reason)
	set_meta("god_mode_start_panel_deferred_free_at_ms", int(Time.get_ticks_msec()))
	set_meta("god_mode_atomic_shell_cover_release_ready", shell_ready)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_atomic_shell_handoff_complete"] = true
		gs.scenario_state ["god_mode_atomic_shell_handoff_complete_reason"] = reason
		gs.scenario_state ["god_mode_atomic_shell_handoff_complete_at_ms"] = int(Time.get_ticks_msec())
		gs.scenario_state ["god_mode_atomic_shell_cover_release_attempts"] = attempt
		gs.scenario_state ["god_mode_atomic_shell_cover_released_after_playable_shell"] = shell_ready
		gs.scenario_state ["god_mode_atomic_shell_cover_release_policy"] = "minimum_shell_frame_release_audio_not_blocking_cleanup_no_visual_cover"
func _begin_god_mode_life_with_settings(settings: Dictionary) -> void:
	if gs == null:
		set_meta("god_mode_capsule_entry_handoff_active", false)
		return

	_reset_world_specific_ui_lens_state_for_new_world_seed("begin_god_mode_life_with_settings_new_world_seed")
	_reset_newborn_birth_intro_diary_contract_for_new_world_seed("begin_god_mode_life_with_settings_new_birth_seed")

	var merged_settings:= _build_default_custom_settings()
	for key in settings.keys():
		merged_settings [key] = settings [key]

	merged_settings = MainSceneLogic._canonicalize_god_mode_reality_settings(
		merged_settings,
		"begin_god_mode_life_with_settings_before_candidate"
	)
	merged_settings = _apply_god_mode_reality_candidate_to_settings(merged_settings, "begin_god_mode_life_legacy_redirect")

	merged_settings = MainSceneLogic._canonicalize_god_mode_reality_settings(
		merged_settings,
		"begin_god_mode_life_with_settings_after_candidate"
	)

	_sync_god_mode_tracker_from_settings(merged_settings, "begin_god_mode_life_legacy_redirect")

	var signature: String = _god_mode_life_prewarm_signature(merged_settings)
	if signature == "":
		set_meta("god_mode_capsule_entry_handoff_active", false)
		_restore_god_mode_start_button_after_failed_entry("God Mode could not build a valid life signature.")
		return

	_arm_playable_life_surface_authority_lock("begin_god_mode_life_with_settings")
	_assert_god_mode_full_ui_entry_contract(merged_settings, "begin_god_mode_life_legacy_redirect")
	_claim_god_mode_tracker_handoff(merged_settings, signature, "begin_god_mode_life_legacy_redirect")

	if _is_god_mode_life_prewarm_ready_for_settings(merged_settings):
		set_meta("god_mode_life_start_prevalidated_signature", signature)

		var entered: bool = _enter_prewarmed_god_mode_life_full_ui_now(
			merged_settings.duplicate(true),
			"begin_god_mode_life_legacy_redirect_hot_capsule"
		)

		remove_meta("god_mode_life_start_prevalidated_signature")

		if entered:
			return

	set_meta("god_mode_start_after_prewarm_requested", true)
	set_meta("god_mode_capsule_entry_handoff_active", false)
	set_meta("god_mode_life_entry_full_ui_required", true)
	set_meta("prewarmed_capsule_entry_shell_first", false)
	set_meta("god_mode_shell_first_handoff_requested", false)

	var queue_report: Dictionary = _queue_god_mode_life_prewarm_from_settings(
		merged_settings.duplicate(true),
		"begin_god_mode_life_legacy_redirect_missing_prewarm",
		false
	)

	if queue_report.is_empty() or not bool(queue_report.get("success", false)):
		_abort_god_mode_tracker_handoff("begin_god_mode_life_legacy_redirect_queue_failed")
		_restore_god_mode_start_button_after_failed_entry(
			str(queue_report.get("reason", "God Mode life prewarm could not be queued."))
		)
		return

	_refresh_god_mode_start_button_state()
func _build_first_frame_ui_snapshot_from_game_state(
		source_gs: GameState,
		reason: String = "first_frame"
) -> Dictionary:
	if (
		source_gs == null
		or source_gs.player == null
	):
		return {}

	var p:= source_gs.player
	var scenario: Dictionary = {}

	if typeof(
		source_gs.scenario_state
	) == TYPE_DICTIONARY:
		scenario = source_gs.scenario_state



	var currency_symbol: String = str(
		scenario.get(
			"resident_first_frame_currency_symbol",
			""
		)
	)
	var diary_raw: Variant = scenario.get(
		"resident_first_frame_birth_intro_lines",
		[]
	)
	var life_diary_lines: Array = (
		(diary_raw as Array).duplicate(false)
		if typeof(
			diary_raw
		) == TYPE_ARRAY
		else []
	)

	var safe_first_name: String = str(
		p.first_name
	).strip_edges()
	var safe_last_name: String = str(
		p.last_name
	).strip_edges()
	var safe_full_name: String = (
		"%s %s"
		% [
			safe_first_name,
			safe_last_name
		]
	).strip_edges()

	if (
		safe_full_name == ""
		or safe_full_name.to_lower() == "i"
	):
		if (
			safe_first_name != ""
			and safe_first_name.to_lower() != "i"
		):
			safe_full_name = safe_first_name
		elif safe_last_name != "":
			safe_full_name = safe_last_name
		else:
			safe_full_name = "Unknown"

	if life_diary_lines.is_empty():
		life_diary_lines = [
			"Year: %s" % str(
				source_gs.year
			),
			"Age: %d" % int(
				p.age
			),
			"My name is %s." % safe_full_name
		]

	var health_value: int = max(
		0,
		int(
			round(
				float(
					p.health
				)
			)
		)
	)
	var hunger_value: int = (
		_player_stats_hunger_value(
			p
		)
	)
	var mental_value: int = max(
		0,
		int(
			round(
				float(
					p.mental_health
				)
			)
		)
	)
	var willpower_value: int = (
		_bending_hub_willpower_value(
			p
		)
	)
	var happiness_value: int = max(
		0,
		int(
			round(
				float(
					p.satisfaction
