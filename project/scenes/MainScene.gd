func _ready_door_after_first_paint(
	reason: String = "ready_door_drop"
) -> void:
	set_meta(
		"ready_door_post_paint_audio_connected",
		false
	)

	if bool(
		get_meta(
			"ready_door_first_paint_commit_complete",
			false
		)
	):
		return

	if (
		gs == null
		or gs.player == null
		or not _playable_life_shell_has_visible_sovereignty()
	):
		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var grace_until_ms: int = maxi(
		int(
			get_meta(
				"ready_door_renderer_grace_until_ms",
				now_ms
			)
		),
		now_ms + 180
	)
	var paint_source: String = (
		"scene_tree_fallback"
		if reason.ends_with("_scene_tree_fallback")
		else "render_server_frame_post_draw"
	)

	set_meta(
		"ready_door_first_paint_commit_complete",
		true
	)
	set_meta(
		"ready_door_first_paint_commit_complete_at_ms",
		now_ms
	)
	set_meta(
		"ready_door_first_paint_source",
		paint_source
	)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var runtime_guard_raw: Variant = (
		gs.scenario_state.get(
			"runtime_guard",
			{}
		)
	)
	var runtime_guard: Dictionary = (
		(runtime_guard_raw as Dictionary).duplicate(false)
		if typeof(runtime_guard_raw) == TYPE_DICTIONARY
		else {}
	)

	runtime_guard ["ui_interaction_grace_until_ms"] = maxi(
		int(
			runtime_guard.get(
				"ui_interaction_grace_until_ms",
				0
			)
		),
		grace_until_ms
	)
	runtime_guard ["truth_resolution_yield_until_ms"] = maxi(
		int(
			runtime_guard.get(
				"truth_resolution_yield_until_ms",
				0
			)
		),
		grace_until_ms
	)
	runtime_guard ["ready_door_visual_commit_pending"] = false
	runtime_guard ["ready_door_projection_quantum_forbidden"] = true

	gs.scenario_state ["runtime_guard"] = runtime_guard
	gs.scenario_state ["ready_door_first_paint_pending"] = false
	gs.scenario_state ["ready_door_first_paint_complete"] = true
	gs.scenario_state [
		"ready_door_first_paint_completed_at_ms"
	] = now_ms
	gs.scenario_state ["ready_door_first_paint_source"] = paint_source
	gs.scenario_state [
		"ready_door_projection_service_may_not_run"
	] = true
	gs.scenario_state [
		"ready_door_projection_service_pause_reason"
	] = "presented_life_frame_receives_interactive_grace"
	gs.scenario_state [
		"ready_door_projection_release_after_ms"
	] = grace_until_ms
	gs.scenario_state [
		"ready_door_projection_service_waits_for_input_fence"
	] = true
	gs.scenario_state ["ready_door_player_control_absolute"] = true
	gs.scenario_state [
		"world_browser_waits_for_explicit_lens_intent"
