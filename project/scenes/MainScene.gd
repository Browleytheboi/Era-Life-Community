func _commit_property_market_listing_action_deferred(
	_listing_id: String,
	action_id: String,
	payload: Dictionary
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	set_meta(
		"action_result_return_surface_id",
		"property_market_contract_panel"
	)

	var report: Dictionary = _express_global_ui_intent(
		{
			"intent_type": (
				"property_market_listing_action"
			),
			"surface_id": (
				"property_market_contract_panel"
			),
			"action_id": action_id,




			"immutable_contract_references": true,
			"skip_crr_observation": true,

			"payload": payload.duplicate(false),
			"target": {
				"route_kind": "engine_method",
				"engine_property": (
					"property_market_contract_engine"
				),
				"method": "commit_listing_action",
				"pass_actor_payload": true
			},
			"source": (
				"mainscene.property_market_panel"
			)
		},
		{
			"source": (
				"mainscene.property_market_panel"
			),
			"surface_id": (
				"property_market_contract_panel"
			),
			"action_id": action_id,
			"immutable_contract_references": true,
			"skip_crr_observation": true
		}
	)

	var result: Dictionary = (
		_market_panel_route_result(
			report
		)
	)


	if not result.is_empty():
		_maybe_show_action_result_popup(
			result
		)

		_consume_bank_delta_from_observable_receipt(
			result,
			"property_market.%s" % action_id
		)

	var mutation_committed: bool = (
		bool(
			result.get(
				"success",
				false
			)
		)
		and action_id in [
			"buy_outright",
			"rent_monthly",
			"apply_mortgage"
		]
	)

	if mutation_committed:
		call_deferred(
			"_queue_post_market_asset_observability",
			"property",
			int(
				gs.player.id
			)
		)

	set_meta(
		"property_market_action_force_asset_prewarm",
		false
	)
	set_meta(
		"property_market_portfolio_reconcile_pending",
		mutation_committed
	)
	set_meta(
		"property_market_action_engine_work_on_input_frame",
		false
	)
	set_meta(
		"property_market_action_generic_crr_observation",
		false
	)
	set_meta(
		"property_market_popup_before_portfolio_tail",
		true
	)
