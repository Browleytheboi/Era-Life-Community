func _mount_relationship_profile_page_zero_frame(
	target: Person,
	reason: String = "relationship_profile_page_mount"
) -> bool:
	if target == null:
		return false

	if (
		relationship_profile_popup_profile == null
		or relationship_profile_popup_experience_grid == null
		or relationship_profile_popup_actions == null
	):
		return false

	var cache_key: String = (
		MainSceneLogic._relationship_profile_page_cache_key(gs, 
			target
		)
	)
	var page_raw: Variant = (
		relationship_profile_page_cache.get(
			cache_key,
			{}
		)
	)

	if typeof(page_raw) != TYPE_DICTIONARY:
		return false

	var page: Dictionary = page_raw as Dictionary
	var stats_cache: GridContainer = page.get(
		"stats_cache",
		null
	) as GridContainer
	var actions_cache: VBoxContainer = page.get(
		"actions_cache",
		null
	) as VBoxContainer

	if stats_cache == null or not is_instance_valid(stats_cache):
		return false

	if actions_cache == null or not is_instance_valid(actions_cache):
		return false

	if (
		relationship_profile_active_page_key != ""
		and relationship_profile_active_page_key != cache_key
	):
		var previous_raw: Variant = (
			relationship_profile_page_cache.get(
				relationship_profile_active_page_key,
				{}
			)
		)

		if typeof(previous_raw) == TYPE_DICTIONARY:
			var previous_page: Dictionary = (
				previous_raw as Dictionary
			)
			var previous_stats_cache: GridContainer = (
				previous_page.get(
					"stats_cache",
					null
				) as GridContainer
			)
			var previous_actions_cache: VBoxContainer = (
				previous_page.get(
					"actions_cache",
					null
				) as VBoxContainer
			)

			if (
				previous_stats_cache != null
				and is_instance_valid(
					previous_stats_cache
				)
			):
				MainSceneHelpers._relationship_profile_move_children(
					relationship_profile_popup_experience_grid,
					previous_stats_cache
				)

			if (
				previous_actions_cache != null
				and is_instance_valid(
					previous_actions_cache
				)
			):
				MainSceneHelpers._relationship_profile_move_children(
					relationship_profile_popup_actions,
					previous_actions_cache
				)

	if relationship_profile_active_page_key != cache_key:
		MainSceneHelpers._relationship_profile_move_children(
			stats_cache,
			relationship_profile_popup_experience_grid
		)
		MainSceneHelpers._relationship_profile_move_children(
			actions_cache,
			relationship_profile_popup_actions
		)

	relationship_profile_active_page_key = cache_key

	relationship_profile_popup_profile.clear()
	relationship_profile_popup_profile.append_text(
		str(
			page.get(
				"profile_text",
				""
			)
		)
	)

	if relationship_profile_popup_bank_label != null:
		relationship_profile_popup_bank_label.text = str(
			page.get(
				"bank_text",
				"$0 USD"
			)
		)

	if relationship_profile_popup_title != null:
		relationship_profile_popup_title.text = str(
			page.get(
				"target_name",
				_relationship_display_name(
					target
				)
			)
		)

	var experience_rows_raw: Variant = page.get(
		"experience_rows",
		[]
	)
	var money_widgets_raw: Variant = page.get(
		"money_widgets",
		[]
	)

	relationship_popup_experience_rows = (
		(experience_rows_raw as Array).duplicate(false)
		if typeof(experience_rows_raw) == TYPE_ARRAY
		else []
	)
	relationship_popup_money_widgets = (
		(money_widgets_raw as Array).duplicate(false)
		if typeof(money_widgets_raw) == TYPE_ARRAY
		else []
	)

	if relationship_profile_popup_profile_scroll != null:
		relationship_profile_popup_profile_scroll.scroll_vertical = 0

	if relationship_profile_popup_actions_scroll != null:
		relationship_profile_popup_actions_scroll.scroll_vertical = 0

	if relationship_profile_popup_status != null:
		relationship_profile_popup_status.text = ""

	set_meta(
		"relationship_profile_page_mounted_zero_frame",
		true
	)
	set_meta(
		"relationship_profile_page_mounted_target_id",
		int(target.id)
	)
	set_meta(
		"relationship_profile_page_mounted_reason",
		reason
	)
	set_meta(
		"relationship_profile_page_mounted_at_ms",
		int(Time.get_ticks_msec())
	)

	return true
func _ensure_relationship_profile_panel() -> void:
	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		relationship_profile_panel = get_node_or_null(
			"RelationshipProfilePanel"
		) as RelationshipProfilePanel

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		relationship_profile_panel = (
			RelationshipProfilePanel.new()
		)
		relationship_profile_panel.name = (
			"RelationshipProfilePanel"
		)
		relationship_profile_panel.visible = false
		relationship_profile_panel.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
		)
		relationship_profile_panel.z_as_relative = false
		relationship_profile_panel.z_index = 1300

		add_child(
			relationship_profile_panel
		)

	var back_callable: Callable = Callable(
		self,
		"_on_relationship_profile_popup_back_pressed"
	)
	var switch_callable: Callable = Callable(
		self,
		"_on_relationship_profile_panel_switch_requested"
	)
	var edit_callable: Callable = Callable(
		self,
		"_on_relationship_profile_panel_edit_requested"
	)
	var action_callable: Callable = Callable(
		self,
		"_on_relationship_profile_panel_action_requested"
	)
	var resident_packet_callable: Callable = Callable(
		self,
		"_on_relationship_profile_panel_resident_switch_packet_installed"
	)

	if not relationship_profile_panel.request_back.is_connected(
		back_callable
	):
		relationship_profile_panel.request_back.connect(
			back_callable
		)

	if not relationship_profile_panel.request_switch.is_connected(
		switch_callable
	):
		relationship_profile_panel.request_switch.connect(
			switch_callable
		)

	if not relationship_profile_panel.request_edit.is_connected(
		edit_callable
	):
		relationship_profile_panel.request_edit.connect(
			edit_callable
		)

	if not relationship_profile_panel.request_action.is_connected(
		action_callable
	):
		relationship_profile_panel.request_action.connect(
			action_callable
		)

	if not relationship_profile_panel.resident_switch_packet_installed.is_connected(
		resident_packet_callable
	):
		relationship_profile_panel.resident_switch_packet_installed.connect(
			resident_packet_callable
		)

	_bind_relationship_profile_panel_press_frame_switch()

	relationship_profile_panel.set_meta(
		"relationship_profile_shell_persistent",
		true
	)
	relationship_profile_panel.set_meta(
		"relationship_profile_shell_build_on_open_forbidden",
		true
	)
	set_meta(
		"relationship_profile_shell_prewarm_scheduled",
		false
	)
	set_meta(
		"relationship_profile_shell_hot",
		true
	)
func _on_relationship_profile_panel_resident_switch_packet_installed(
	target_id: int,
	switch_packet: Dictionary
) -> void:
	if (
		gs == null
		or target_id <= 0
		or switch_packet.is_empty()
	):
		return

	var surface_contract: Dictionary = MainSceneHelpers._safe_dictionary(
		switch_packet.get(
			"surface_contract",
			{}
		)
	)
	var main_tab_deck: Dictionary = MainSceneHelpers._safe_dictionary(
		switch_packet.get(
			"main_tab_surface_contracts",
			surface_contract.get(
				"main_tab_surface_contracts",
				{}
			)
		)
	)
	var support_packet: Dictionary = MainSceneHelpers._safe_dictionary(
		switch_packet.get(
			"control_switch_support_surface_packet",
			surface_contract.get(
				"control_switch_support_surface_packet",
				{}
			)
		)
	)
	var pointer_revision: String = str(
		switch_packet.get(
			"pointer_revision",
			surface_contract.get(
				"pointer_revision",
				""
			)
		)
	).strip_edges()
	var packet_complete: bool = (
		_relationship_profile_switch_packet_core_hot(
			switch_packet,
			target_id
		)
		and _resident_main_tab_contract_deck_is_complete_for_actor(
			main_tab_deck,
			target_id
		)
		and _control_switch_support_surface_packet_is_renderable(
			support_packet,
			target_id
		)
	)

	if not packet_complete:
		EraLog.truth(
			"OBSERVABLE_ACTOR_RENDERER_PREWARM_REJECTED"
			+ "|actor_id=" + str(target_id)
			+ "|pointer_revision=" + pointer_revision
			+ "|reason=complete_destination_packet_not_renderable"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	if _resident_main_tab_renderer_deck_is_hot(
		target_id
	):
		_publish_resident_actor_lens_to_profile_surface(
			target_id
		)

		EraLog.truth(
			"OBSERVABLE_ACTOR_RENDERER_DECK_HOT"
			+ "|actor_id=" + str(target_id)
			+ "|pointer_revision=" + pointer_revision
			+ "|source=profile_packet_install_cache_hit"
			+ "|main_tabs=5/5"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|ready_gate_member=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return



	_queue_resident_main_tab_renderer_deck_prewarm(
		target_id,
		main_tab_deck,
		"relationship_profile_observed_complete_packet"
	)

	set_meta(
		"observable_actor_renderer_prewarm_queued",
		true
	)
	set_meta(
		"observable_actor_renderer_prewarm_actor_id",
		target_id
	)
	set_meta(
		"observable_actor_renderer_prewarm_pointer_revision",
		pointer_revision
	)
	set_meta(
		"observable_actor_renderer_prewarm_at_ms",
		int(Time.get_ticks_msec())
	)
	set_meta(
		"observable_actor_renderer_prewarm_engine_calls",
		false
	)
	set_meta(
		"observable_actor_renderer_prewarm_build_on_switch",
		false
	)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state [
			"observable_actor_renderer_prewarm_queued"
		] = true
		gs.scenario_state [
			"observable_actor_renderer_prewarm_actor_id"
		] = target_id
		gs.scenario_state [
			"observable_actor_renderer_prewarm_pointer_revision"
		] = pointer_revision
		gs.scenario_state [
			"observable_actor_renderer_prewarm_engine_calls"
		] = false
		gs.scenario_state [
			"observable_actor_renderer_prewarm_ready_gate_member"
		] = false

	EraLog.truth(
		"OBSERVABLE_ACTOR_RENDERER_PREWARM_QUEUED"
		+ "|actor_id=" + str(target_id)
		+ "|pointer_revision=" + pointer_revision
		+ "|real_main_tabs=" + str(main_tab_deck.size())
		+ "|source=relationship_profile_observed_complete_packet"
		+ "|packet_already_published=true"
		+ "|switch_press_work=false"
		+ "|engine_calls=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)

func _bind_relationship_profile_panel_press_frame_switch() -> void:
	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		return

	var switch_button: Button = (
		relationship_profile_panel.switch_button
	)

	if (
		switch_button == null
		or not is_instance_valid(switch_button)
	):
		call_deferred(
			"_bind_relationship_profile_panel_press_frame_switch"
		)
		return

	var press_callable: Callable = Callable(
		self,
		"_on_relationship_profile_panel_switch_button_down"
	)

	if not switch_button.button_down.is_connected(
		press_callable
	):
		switch_button.button_down.connect(
			press_callable
		)

	switch_button.set_meta(
		"switch_commits_on_button_down",
		true
	)
	switch_button.set_meta(
		"switch_waits_for_button_release",
		false
	)


func _on_relationship_profile_panel_switch_button_down() -> void:
	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		return

	var switch_button: Button = (
		relationship_profile_panel.switch_button
	)

	if (
		switch_button != null
		and is_instance_valid(
			switch_button
		)
	):


		switch_button.set_meta(
			"switch_release_request_suppressed",
			true
		)
		switch_button.set_meta(
			"switch_release_request_suppressed_at_ms",
			int(Time.get_ticks_msec())
		)

	var target_id: int = int(
		relationship_profile_panel.active_target_id
	)
	var contract_raw: Variant = (
		relationship_profile_panel.active_contract
	)
	var contract: Dictionary = (
		contract_raw as Dictionary
		if typeof(contract_raw) == TYPE_DICTIONARY
		else {}
	)
	var packet_raw: Variant = contract.get(
		"switch_packet",
		{}
	)
	var switch_packet: Dictionary = (
		packet_raw as Dictionary
		if typeof(packet_raw) == TYPE_DICTIONARY
		else {}
	)

	_on_relationship_profile_panel_switch_requested(
		target_id,
		switch_packet
	)
func _prewarm_relationship_profile_popup_shell_for_relationship_hub(
	reason: String = (
		"relationship_hub_visible"
	)
) -> void:
	_ensure_relationship_profile_panel()

	if (
		relationship_profile_panel == null
		or not is_instance_valid(
			relationship_profile_panel
		)
	):
		return

	relationship_profile_panel.visible = false
	relationship_profile_panel.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	relationship_profile_panel.process_mode = (
		Node.PROCESS_MODE_INHERIT
	)
	relationship_profile_panel.set_meta(
		"relationship_profile_popup_shell_hot",
		true
	)
	relationship_profile_panel.set_meta(
		"relationship_profile_popup_shell_hot_reason",
		reason
	)
	relationship_profile_panel.set_meta(
