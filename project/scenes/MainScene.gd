func _style_institution_hub_back_button(kind: String, hovered: bool = false, pulse_strength: float = 0.0) -> void:
	if institution_hub_back_button == null:
		return

	var clean_kind: String = str(kind).strip_edges().to_lower()
	var purple: Color = Color(0.68, 0.34, 1.0, 0.96)
	var fill: Color = Color(0.06, 0.035, 0.095, 0.94)

	match clean_kind:
		"school":
			purple = Color(0.46, 0.72, 1.0, 0.94)
			fill = Color(0.03, 0.06, 0.11, 0.94)
		"career":
			purple = Color(0.52, 0.92, 0.72, 0.94)
			fill = Color(0.025, 0.08, 0.052, 0.94)
		"relationships":
			purple = Color(0.72, 0.34, 1.0, 0.98)
			fill = Color(0.072, 0.03, 0.105, 0.96)

	var safe_pulse: float = clamp(float(pulse_strength), 0.0, 1.0)
	var white_layer: float = 0.0
	if hovered:
		white_layer = 0.46 + safe_pulse * 0.16

	var normal:= StyleBoxFlat.new()
	normal.bg_color = fill.lerp(Color(1.0, 1.0, 1.0, 0.96), 0.06 if hovered else 0.0)
	normal.border_color = purple.lerp(Color.WHITE, white_layer)
	normal.border_width_left = 2
	normal.border_width_top = 2
	normal.border_width_right = 2
	normal.border_width_bottom = 2
	normal.corner_radius_top_left = 999
	normal.corner_radius_top_right = 999
	normal.corner_radius_bottom_left = 999
	normal.corner_radius_bottom_right = 999
	normal.shadow_color = purple.lerp(Color.WHITE, 0.34 if hovered else 0.0)
	normal.shadow_size = 10 + int(round(safe_pulse * 4.0)) + (10 if hovered else 0)
	normal.shadow_offset = Vector2.ZERO
	normal.content_margin_left = 0
	normal.content_margin_top = 0
	normal.content_margin_right = 0
	normal.content_margin_bottom = 0

	var hover:= normal.duplicate()
	hover.bg_color = fill.lerp(Color.WHITE, 0.1)
	hover.border_color = Color.WHITE
	hover.shadow_color = Color(1.0, 1.0, 1.0, 0.54)
	hover.shadow_size = normal.shadow_size + 4

	var pressed:= hover.duplicate()
	pressed.bg_color = fill.lerp(purple, 0.24)
	pressed.shadow_size = max(8, hover.shadow_size - 3)

	institution_hub_back_button.text = "×"
	institution_hub_back_button.custom_minimum_size = Vector2(44, 44)
	institution_hub_back_button.add_theme_stylebox_override("normal", normal)
	institution_hub_back_button.add_theme_stylebox_override("hover", hover)
	institution_hub_back_button.add_theme_stylebox_override("pressed", pressed)
	institution_hub_back_button.add_theme_stylebox_override("focus", hover)
	institution_hub_back_button.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 0.96))
	institution_hub_back_button.add_theme_color_override("font_hover_color", Color(1.0, 1.0, 1.0, 1.0))
	institution_hub_back_button.add_theme_color_override("font_pressed_color", Color(1.0, 1.0, 1.0, 1.0))
	institution_hub_back_button.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.76))
	institution_hub_back_button.add_theme_constant_override("shadow_offset_x", 0)
	institution_hub_back_button.add_theme_constant_override("shadow_offset_y", 1)
	institution_hub_back_button.add_theme_font_size_override("font_size", 24)
