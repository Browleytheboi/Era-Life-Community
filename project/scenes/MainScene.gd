func _input(event):
	if event == null:
		return





	_mark_ui_interaction_from_event(event)

	if _institution_hub_try_route_scroll_input(
		event,
		"mainscene_input_first_responder"
	):
		get_viewport().set_input_as_handled()
		return

	if (
		reality_intake_panel != null
		and is_instance_valid(
			reality_intake_panel
		)
		and reality_intake_panel.visible
	):
		return

	if (
		title_card_account_popup != null
		and is_instance_valid(
			title_card_account_popup
		)
		and title_card_account_popup.visible
	):
		return

	var reality_intake_button_action: String = (
		_startup_intro_global_reality_intake_button_action(
			event
		)
	)

	if reality_intake_button_action != "":
		get_viewport().set_input_as_handled()

		if reality_intake_button_action == "open":
			_open_reality_intake_panel()
			return

		if reality_intake_button_action == "collapse":
			_collapse_global_reality_intake_button()
			return

		if reality_intake_button_action == "restore":
			_restore_global_reality_intake_button()
			return

		return

	if (
		not startup_intro_accepting_input
		or startup_intro_exiting
	):
		return

	if _startup_intro_event_targets_replay_button(
		event
	):
		return

	if event is InputEventKey:
		var key_event:= (
			event as InputEventKey
		)

		if (
			key_event.pressed
			and not key_event.echo
		):
			if key_event.keycode == KEY_C:
				get_viewport().set_input_as_handled()

				if _title_card_continue_available():
					_continue_title_card_current_life()




				return

			if key_event.keycode == KEY_A:
				get_viewport().set_input_as_handled()
				_open_title_card_account_panel(
					"signup"
				)
				return

			if key_event.keycode == KEY_L:
				get_viewport().set_input_as_handled()
				_open_title_card_account_panel(
					"login"
				)
				return

			if key_event.keycode == KEY_F:
				get_viewport().set_input_as_handled()
				_disconnect_title_card_eralife_account()
				return

	var should_enter: bool = false

	if event is InputEventMouseButton:
		should_enter = (
			event.pressed
			and event.button_index
			== MOUSE_BUTTON_LEFT
		)
	elif event is InputEventScreenTouch:
		should_enter = event.pressed
	elif event is InputEventKey:
		should_enter = (
			event.pressed
			and not event.echo
		)
	elif event is InputEventJoypadButton:
		should_enter = event.pressed

	if not should_enter:
		return

	set_meta(
		"title_card_entered_as_guest",
		bool(
			get_meta(
				"title_card_player_is_guest",
				true
			)
		)
	)
	get_viewport().set_input_as_handled()
	_surface_guard_assert_render(
		"choose_adventure_entry",
		"startup_title_card_pressed",
		"pre_life",
		1200
	)
	_exit_startup_intro_to_god_mode()
func _startup_intro_event_targets_global_reality_intake_button(event: InputEvent) -> bool:
	return _startup_intro_global_reality_intake_button_action(event) != ""
func _startup_intro_global_reality_intake_button_action(event: InputEvent) -> String:
	var pointer_position:= Vector2.ZERO
	var has_pointer:= false

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		pointer_position = mouse_event.position
		has_pointer = mouse_event.pressed and mouse_event.button_index == MOUSE_BUTTON_LEFT
	elif event is InputEventScreenTouch:
		var touch_event:= event as InputEventScreenTouch
		pointer_position = touch_event.position
		has_pointer = touch_event.pressed

	if not has_pointer:
		return ""

	if global_reality_intake_hide_button != null and is_instance_valid(global_reality_intake_hide_button):
		if global_reality_intake_hide_button.visible and not global_reality_intake_hide_button.disabled:
			if global_reality_intake_hide_button.get_global_rect().has_point(pointer_position):
				return "collapse"

	if global_reality_intake_tab_button != null and is_instance_valid(global_reality_intake_tab_button):
		if global_reality_intake_tab_button.visible and not global_reality_intake_tab_button.disabled:
			if global_reality_intake_tab_button.get_global_rect().has_point(pointer_position):
				return "restore"

	if global_reality_intake_button != null and is_instance_valid(global_reality_intake_button):
		if global_reality_intake_button.visible and not global_reality_intake_button.disabled:
			if global_reality_intake_button.get_global_rect().has_point(pointer_position):
				return "open"

	return ""
