func _restore_live_gameplay_ui_shell() -> void:
	if gs == null or gs.player == null:
		return

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var full_ui_prewarmed_spawn: bool = (
		bool(
			get_meta(
				"god_mode_life_entry_full_ui_required",
				false
			)
		)
		and bool(
			get_meta(
				"god_mode_life_boot_uses_prewarmed_spawn",
				false
			)
		)
		and gs.player != null
	)

	full_ui_prewarmed_spawn = (
		full_ui_prewarmed_spawn
		or str(
			gs.scenario_state.get(
				"spawn_shell_entry_policy",
				""
			)
		).strip_edges() == "full_ui_from_prewarmed_capsule"
		or str(
			gs.scenario_state.get(
				"ui_first_frame_render_policy",
				""
			)
		).strip_edges() == "full_ui_from_prewarmed_capsule"
		or bool(
			gs.scenario_state.get(
				"god_mode_life_entry_full_ui_ready",
				false
			)
		)
	)

	if full_ui_prewarmed_spawn:
		_restore_prewarmed_full_gameplay_ui(
			"restore_live_gameplay_ui_shell_full_ui_prewarmed_spawn"
		)
		return

	var shell_first_handoff: bool = (
		bool(
			get_meta(
				"god_mode_shell_first_handoff_requested",
				false
			)
		)
		or bool(
			get_meta(
				"prewarmed_capsule_entry_shell_first",
				false
			)
		)
		or bool(
			gs.scenario_state.get(
				"prewarmed_capsule_entry_shell_first",
				false
			)
		)
		or str(
			gs.scenario_state.get(
				"spawn_shell_entry_policy",
				""
			)
		).strip_edges() == "main_shell_first_user_intent_tabs"
	)

	if shell_first_handoff:
		set_meta(
			"startup_live_shell_loading",
			false
		)
		set_meta(
			"age_up_post_loading_finalize_pending",
			false
		)
		set_meta(
			"age_up_transition_busy",
			false
		)
		set_meta(
			"live_diagnostics_manual_throttle_enabled",
			false
		)
		set_meta(
			"player_stats_spawn_cinematic_pending",
			false
		)
		set_meta(
			"restore_live_gameplay_shell_mode",
			"life_shell_first_contract"
		)
		set_meta(
			"restore_live_gameplay_shell_deferred_heavy_work",
			true
		)
		set_meta(
			"restore_live_gameplay_shell_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		set_meta(
			"legacy_playable_life_shell_layout_forbidden",
			true
		)

		gs.scenario_state [
			"restore_live_gameplay_shell_mode"
		] = "life_shell_first_contract"
		gs.scenario_state [
			"restore_live_gameplay_shell_deferred_heavy_work"
		] = true
		gs.scenario_state [
			"ui_first_frame_render_policy"
		] = "life_shell_visible_no_runtime_work"
		gs.scenario_state [
			"spawn_shell_entry_policy"
		] = "main_shell_first_user_intent_tabs"
