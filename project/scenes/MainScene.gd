	var willpower_max: int = max(150, willpower_value)
	var happiness_max: int = max(100, happiness_value)
	var smarts_max: int = max(100, smarts_value)
	var looks_max: int = max(100, looks_value)
	var imagination_max: int = max(100, imagination_value)
	var fame_max: int = max(100, fame_value)

	if player_stats_health_bar != null:
		player_stats_health_bar.max_value = health_max
	if player_stats_hunger_bar != null:
		player_stats_hunger_bar.max_value = hunger_max
	if player_stats_mental_bar != null:
		player_stats_mental_bar.max_value = mental_max
	if player_stats_willpower_bar != null:
		player_stats_willpower_bar.max_value = willpower_max
	if player_stats_happiness_bar != null:
		player_stats_happiness_bar.max_value = happiness_max
	if player_stats_smarts_bar != null:
		player_stats_smarts_bar.max_value = smarts_max
	if player_stats_looks_bar != null:
		player_stats_looks_bar.max_value = looks_max
	if player_stats_imagination_bar != null:
		player_stats_imagination_bar.max_value = imagination_max
	if player_stats_fame_bar != null:
