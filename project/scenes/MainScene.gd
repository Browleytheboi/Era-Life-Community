func _relationship_profile_try_consume_click(
	kind: String,
	action_id: String = "",
	target_id: int = -1,
	cooldown_ms: int = 180
) -> bool:
	var clean_kind: String = str(
		kind
	).strip_edges().to_lower()
	var clean_action_id: String = str(
		action_id
	).strip_edges().to_lower()



	if clean_kind == "open_profile":
		set_meta(
			"relationship_profile_open_click_fence_bypassed",
			true
		)
		set_meta(
			"relationship_profile_open_click_target_id",
			target_id
		)
		set_meta(
			"relationship_profile_open_click_reveal_only",
			true
		)
		return true

	var clean_key: String = MainSceneHelpers._relationship_profile_click_key(
		clean_kind,
		clean_action_id,
		target_id
	)
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var last_key: String = str(
		get_meta(
			"relationship_profile_last_committed_action_key",
			""
		)
	)
	var last_ms: int = int(
		get_meta(
			"relationship_profile_last_committed_action_ms",
			-999999
		)
	)

	if (
		last_key == clean_key
		and now_ms - last_ms <= maxi(
			0,
			cooldown_ms
		)
	):
		return false

	set_meta(
		"relationship_profile_last_committed_action_key",
		clean_key
	)
	set_meta(
		"relationship_profile_last_committed_action_ms",
		now_ms
	)
	set_meta(
		"relationship_profile_last_committed_action_target_id",
		target_id
	)

	return true

