func _resume_crown_hub_prepaint_after_present_fence(
	actor_id: int,
	reason: String,
	expected_revision: String
) -> void:
	if (
		int(
			get_meta(
				"crown_hub_prepaint_waiting_actor_id",
				-1
			)
		) == actor_id
		and str(
			get_meta(
				"crown_hub_prepaint_waiting_revision",
				""
			)
		) == expected_revision
	):
		remove_meta(
			"crown_hub_prepaint_waiting_actor_id"
		)
		remove_meta(
			"crown_hub_prepaint_waiting_revision"
		)
		remove_meta(
			"crown_hub_prepaint_waiting_for_present_fence"
		)

	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
	):
		_update_crown_hud()
		return

	var current_revision: String = str(
		crown_hub_active_contract.get(
			"surface_revision",
			str(
				hash(
					crown_hub_active_contract
				)
			)
		)
	).strip_edges()

	if current_revision != expected_revision:
		set_meta(
			"crown_hub_prepaint_superseded",
			true
		)
		set_meta(
			"crown_hub_prepaint_superseded_actor_id",
			actor_id
		)
		set_meta(
			"crown_hub_prepaint_superseded_expected_revision",
			expected_revision
		)
		set_meta(
			"crown_hub_prepaint_superseded_current_revision",
			current_revision
		)

		_update_crown_hud()
		return

	_prepaint_crown_hub_surface_from_active_contract(
		actor_id,
		reason
	)
func _prepaint_crown_hub_surface_from_active_contract(
	actor_id: int,
	reason: String = "crown_hub_background_prepaint"
) -> void:
	if (
		gs == null
		or gs.player == null
		or int(gs.player.id) != actor_id
		or crown_hub_overlay == null
		or not is_instance_valid(
			crown_hub_overlay
		)
		or not _crown_hub_contract_is_renderable(
			crown_hub_active_contract,
			actor_id
		)
	):
		set_meta(
			"crown_hub_contract_request_scheduled",
			false
		)
		_update_crown_hud()
		return

	var surface_revision: String = str(
		crown_hub_active_contract.get(
			"surface_revision",
			""
		)
	).strip_edges()

	if surface_revision == "":
		set_meta(
			"crown_hub_contract_request_scheduled",
			false
		)
		_update_crown_hud()
		return

	if bool(
		get_meta(
			"renderer_present_fence_active",
			false
		)
	):
		var already_waiting: bool = (
			int(
				get_meta(
					"crown_hub_prepaint_waiting_actor_id",
					-1
				)
			) == actor_id
			and str(
				get_meta(
					"crown_hub_prepaint_waiting_revision",
					""
				)
			) == surface_revision
		)

		if already_waiting:
			return

		set_meta(
			"crown_hub_prepaint_waiting_actor_id",
			actor_id
		)
		set_meta(
			"crown_hub_prepaint_waiting_revision",
			surface_revision
		)
		set_meta(
			"crown_hub_prepaint_waiting_for_present_fence",
			true
		)

		var tree:= get_tree()

		if tree != null:
			tree.process_frame.connect(
				Callable(
					self,
					"_resume_crown_hub_prepaint_after_present_fence"
				).bind(
					actor_id,
					reason,
					surface_revision
				),
				CONNECT_ONE_SHOT
			)
		else:
			call_deferred(
				"_resume_crown_hub_prepaint_after_present_fence",
				actor_id,
				reason,
				surface_revision
			)

		return

	var previous_visible: bool = (
		crown_hub_overlay.visible
	)
	var previous_mouse_filter: Control.MouseFilter = (
		crown_hub_overlay.mouse_filter
	)
	var previous_modulate: Color = (
		crown_hub_overlay.modulate
	)
	var previous_open: bool = crown_hub_open
	var previous_section: String = (
		crown_hub_current_section
	)

	crown_hub_current_section = "throne"
	crown_hub_open = true
	crown_hub_overlay.visible = true
	crown_hub_overlay.mouse_filter = (
		Control.MOUSE_FILTER_IGNORE
	)
	crown_hub_overlay.modulate = Color(
		previous_modulate.r,
		previous_modulate.g,
		previous_modulate.b,
		0.0
	)

	var summary: Dictionary = (
		_crown_hub_cached_summary()
	)
	var permissions: Dictionary = (
		_crown_hub_cached_permissions()
	)

	if summary.is_empty():
		set_meta(
			"crown_hub_missing_summary_contract",
			true
		)
	else:
		set_meta(
			"crown_hub_missing_summary_contract",
			false
		)

		if crown_hub_title != null:
			crown_hub_title.text = (
				_crown_hub_header_title_for_section(
					"throne"
				)
			)

		if crown_hub_throne_summary_row != null:
			crown_hub_throne_summary_row.visible = true

		if crown_hub_summary_label != null:
			crown_hub_summary_label.clear()
			crown_hub_summary_label.visible = true
			crown_hub_summary_label.append_text(
				"\n".join(
					_build_crown_summary_lines(
						summary
					)
				)
			)

		_update_crown_throne_metrics(
			summary
		)

		if crown_hub_status_label != null:
			var alerts: Array = MainSceneHelpers._safe_array(
				summary.get(
					"alerts",
					[]
				)
			)

			crown_hub_status_label.text = (
				"Alerts: %s"
				% "\n".join(alerts)
			)

		if crown_hub_list != null:
			_clear_container_children(
				crown_hub_list
			)
			crown_hub_shimmer_labels.clear()

			_append_crown_action_row(
				"Mediate your Citizens",
				(
					"Sit between two citizens in a live dispute. "
					+ "Read their pressure, choose with wisdom, "
					+ "and deescalate like a ruler who "
					+ "understands people."
				),
				"mediate_citizens",
				bool(
					permissions.get(
						"court",
						false
					)
					or permissions.get(
						"can_law_review",
						false
					)
				)
			)

		_refresh_crown_hub_chrome()

	var summary_text_hot: bool = (
		crown_hub_summary_label != null
		and is_instance_valid(
			crown_hub_summary_label
		)
		and crown_hub_summary_label.get_parsed_text().strip_edges() != ""
	)
	var surface_painted: bool = (
		not summary.is_empty()
		and not permissions.is_empty()
		and not bool(
			get_meta(
				"crown_hub_missing_summary_contract",
				true
			)
		)
		and summary_text_hot
	)

	crown_hub_overlay.visible = previous_visible
	crown_hub_overlay.mouse_filter = (
		previous_mouse_filter
	)
	crown_hub_overlay.modulate = previous_modulate
	crown_hub_open = previous_open
	crown_hub_current_section = previous_section

	if not surface_painted:
		set_meta(
			"crown_hub_prepainted_actor_id",
			-1
		)
		set_meta(
			"crown_hub_prepainted_surface_revision",
			""
		)
		set_meta(
			"crown_hub_prepainted_section_id",
			""
		)
		set_meta(
			"crown_hub_prepaint_pending",
			true
		)
		set_meta(
			"crown_hub_contract_request_scheduled",
			false
		)

		_update_crown_hud()

		EraLog.truth(
			"ERALIFE_CROWN_HUB_PREPAINT_REJECTED"
			+ "|actor_id=" + str(actor_id)
			+ "|surface_revision=" + surface_revision
			+ "|summary_hot="
			+ str(
				not summary.is_empty()
			).to_lower()
			+ "|permissions_hot="
			+ str(
				not permissions.is_empty()
			).to_lower()
			+ "|summary_text_hot="
			+ str(summary_text_hot).to_lower()
			+ "|bounded_throne_prepaint=true"
			+ "|engine_calls=false"
			+ "|build_on_click=false"
			+ "|at_ms=" + str(Time.get_ticks_msec())
		)
		return

	crown_hub_contract_surface_revision = (
		surface_revision
	)

	set_meta(
		"crown_hub_prepainted_actor_id",
		actor_id
	)
	set_meta(
		"crown_hub_prepainted_surface_revision",
		surface_revision
	)
	set_meta(
		"crown_hub_prepainted_section_id",
		"throne"
	)
	set_meta(
		"crown_hub_prepaint_called_engine",
		false
	)
	set_meta(
		"crown_hub_prepaint_built_on_click",
		false
	)
	set_meta(
		"crown_hub_prepaint_full_refresh_called",
		false
	)
	set_meta(
		"crown_hub_prepaint_bounded_throne_only",
		true
	)
	set_meta(
		"crown_hub_contract_request_scheduled",
		false
	)
	set_meta(
		"crown_hub_zero_frame_integrity_failure",
		false
	)
	set_meta(
		"crown_hub_prepaint_pending",
		false
	)

	for meta_key in [
		"crown_hub_prepaint_waiting_actor_id",
		"crown_hub_prepaint_waiting_revision",
		"crown_hub_prepaint_waiting_for_present_fence"
	]:
		if has_meta(
			meta_key
		):
			remove_meta(
				meta_key
			)

	_update_crown_hud()

	EraLog.truth(
		"ERALIFE_CROWN_HUB_PREPAINT_TRUTH"
		+ "|actor_id=" + str(actor_id)
		+ "|surface_revision=" + surface_revision
		+ "|prepaint_hot=true"
		+ "|bounded_throne_prepaint=true"
		+ "|full_refresh_called=false"
		+ "|semantic_revision=true"
		+ "|engine_calls=false"
		+ "|build_on_click=false"
		+ "|ready_gate_member=false"
		+ "|at_ms=" + str(Time.get_ticks_msec())
	)
