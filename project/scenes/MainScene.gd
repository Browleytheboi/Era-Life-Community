			food_lifestyle_hud_button.text = "🛒"
			food_lifestyle_hud_button.modulate = (
				Color.WHITE
			)

		if (
			restaurant_lifestyle_hud_button != null
			and is_instance_valid(
				restaurant_lifestyle_hud_button
			)
		):
			restaurant_lifestyle_hud_button.visible = false
			restaurant_lifestyle_hud_button.disabled = true
			restaurant_lifestyle_hud_button.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
			restaurant_lifestyle_hud_button.text = "🍔"
			restaurant_lifestyle_hud_button.modulate = (
				Color.WHITE
			)

		return

	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var next_update_ms: int = int(
		get_meta(
			"food_lifestyle_hud_next_update_ms",
			0
		)
	)

	if now_ms >= next_update_ms:
		set_meta(
			"food_lifestyle_hud_next_update_ms",
			now_ms + 160
		)



		_update_food_lifestyle_hud()

		return



	var pulse: float = (
		(
			sin(
				food_lifestyle_hud_breathe_time * 2.1
			)
			+ 1.0
		)
		* 0.5
	)
	var visual_alpha: float = (
		0.94
		+ pulse * 0.06
	)
	var visual_modulate:= Color(
		1.0,
		1.0,
		1.0,
		visual_alpha
	)

	if (
		food_lifestyle_hud_button != null
		and is_instance_valid(
			food_lifestyle_hud_button
		)
		and food_lifestyle_hud_button.visible
	):
		food_lifestyle_hud_button.modulate = (
			visual_modulate
		)

	if (
		restaurant_lifestyle_hud_button != null
		and is_instance_valid(
			restaurant_lifestyle_hud_button
		)
		and restaurant_lifestyle_hud_button.visible
	):
		restaurant_lifestyle_hud_button.modulate = (
			visual_modulate
		)
