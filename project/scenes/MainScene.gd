	var state_raw: Variant = (
		rick_weapon_shop_active_contract.get(
			"shop_runtime_state",
			{}
		)
	)
	var state: Dictionary = (
		(
			state_raw as Dictionary
		).duplicate(false)
		if typeof(
			state_raw
		) == TYPE_DICTIONARY
		else {}
	)
	var inside_raw: Variant = state.get(
		"inside",
		{}
	)
	var inside: Dictionary = (
		(
			inside_raw as Dictionary
		).duplicate(false)
		if typeof(
			inside_raw
		) == TYPE_DICTIONARY
		else {}
	)

	if weapon_name != "":
		var weapon: Dictionary = (
			MainSceneLogic._rick_weapon_shop_find_weapon(
				weapon_name,
				rick_weapon_shop_active_contract
			)
		)
		var cart_raw: Variant = inside.get(
			"player_cart",
			[]
		)
		var cart: Array = (
			(
				cart_raw as Array
			).duplicate(false)
			if typeof(
				cart_raw
			) == TYPE_ARRAY
			else []
		)

		if not weapon.is_empty():
			cart.append(
				weapon.duplicate(false)
			)

		inside ["player_cart"] = cart

	var live_text: String = (
		"You pick it up and hold.\n"
