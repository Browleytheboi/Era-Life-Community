func _reveal_other_countries_scrollbar() -> void:
	var popup:= get_node_or_null("OtherCountriesPopup")
	if popup == null:
		return

	var scroll:= popup.find_child("Scroll", true, false) as ScrollContainer
	if scroll == null:
		return

	var vertical_bar:= scroll.get_v_scroll_bar()
	if vertical_bar == null:
		return

	if vertical_bar.has_meta("fade_tween"):
		var existing_tween = vertical_bar.get_meta("fade_tween")
		if existing_tween is Tween:
			existing_tween.kill()

	vertical_bar.modulate.a = 1.0

	var fade_tween:= create_tween().bind_node(vertical_bar)
	vertical_bar.set_meta("fade_tween", fade_tween)
	fade_tween.tween_interval(0.55)
	fade_tween.tween_property(vertical_bar, "modulate:a", 0.0, 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
