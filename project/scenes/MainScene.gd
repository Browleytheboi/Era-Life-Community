func _add_labeled_row(parent: Control, label_text: String, control: Control) -> void:
	var row:= HBoxContainer.new()
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_theme_constant_override("separation", 14)
	row.custom_minimum_size = Vector2(0, 42)
	row.set_meta("god_mode_row_base_minimum_size", Vector2(0, 42))

	var label:= Label.new()
	label.text = label_text
	label.custom_minimum_size = Vector2(180, 0)
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_color_override("font_color", Color(0.98, 0.95, 1.0, 0.95))
	label.add_theme_font_size_override("font_size", 16)
	label.set_meta("god_mode_row_label_alpha", 0.95)
	label.set_meta("god_mode_row_label_font_size", 16)
	label.set_meta("god_mode_row_label_breath_scale_strength", 0.0018)
	label.set_meta("god_mode_row_label_alpha_boost", 0.018)
	label.set_meta("god_mode_row_label_shimmer_mix_strength", 0.045)
	label.set_meta("god_mode_row_label_base_scale", Vector2.ONE)

	if not god_mode_row_labels.has(label):
		god_mode_row_labels.append(label)

	row.add_child(label)
	control.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	if control.custom_minimum_size.y < 36.0:
		control.custom_minimum_size.y = 36.0
	_style_god_mode_field_control(control)
	row.add_child(control)
	parent.add_child(row)

	var row_key:= _god_mode_row_key_from_label(label_text)
	row.set_meta("god_mode_row_key", row_key)
	label.set_meta("god_mode_row_key", row_key)
	control.set_meta("god_mode_row_key", row_key)

	if god_mode_start_panel != null:
		god_mode_start_panel.set_meta("god_mode_row_" + row_key, row)
		god_mode_start_panel.set_meta("god_mode_row_label_" + row_key, label)
		god_mode_start_panel.set_meta("god_mode_row_control_" + row_key, control)
func _god_mode_row_key_from_label(label_text: String) -> String:
	var raw_key: String = str(label_text).strip_edges().to_lower()
	var out: String = ""

	for i in range(raw_key.length()):
		var ch: String = raw_key.substr(i, 1)
		var code: int = ch.unicode_at(0)
		var allowed: bool = (
			(code >= 97 and code <= 122)
			or (code >= 48 and code <= 57)
			or ch == "_"
		)

		if ch == " " or ch == "-" or ch == "/" or ch == ":":
			if not out.ends_with("_"):
				out += "_"
		elif allowed:
			out += ch

	while out.find("__") >= 0:
		out = out.replace("__", "_")

	out = out.trim_prefix("_").trim_suffix("_")
	if out == "":
		out = "row"

	return out

func _set_god_mode_labeled_row_visible(row_key: String, should_show: bool) -> void:
	if god_mode_start_panel == null:
		return

	var row_variant: Variant = god_mode_start_panel.get_meta("god_mode_row_" + row_key, null)
	if not (row_variant is HBoxContainer):
		return

	var row:= row_variant as HBoxContainer
	var label_variant: Variant = god_mode_start_panel.get_meta("god_mode_row_label_" + row_key, null)
	var control_variant: Variant = god_mode_start_panel.get_meta("god_mode_row_control_" + row_key, null)

	row.visible = should_show
	row.custom_minimum_size = row.get_meta("god_mode_row_base_minimum_size", Vector2(0, 42)) if should_show else Vector2(0, 0)

	if label_variant is Label:
		var row_label:= label_variant as Label
		row_label.visible = should_show

	if control_variant is Control:
		var row_control:= control_variant as Control
		row_control.visible = should_show
		if not should_show:
			row_control.custom_minimum_size = Vector2(0, 0)

