func _refresh_god_mode_birth_surface_lock(reason: String = "god_mode_birth_surface_lock_refresh") -> void:
	if gs == null or gs.player == null:
		return

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		return

	var surface: Dictionary = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("zero_frame_consciousness_switch_surface", {}))
	if surface.is_empty():
		surface = MainSceneHelpers._safe_dictionary(gs.scenario_state.get("prebuilt_first_frame_ui_snapshot", {}))

	if surface.is_empty():
		return

	var settings: Dictionary = MainSceneHelpers._safe_dictionary(gs.custom_settings) if typeof(gs.custom_settings) == TYPE_DICTIONARY else {}
	var refreshed_surface: Dictionary = _sanitize_god_mode_birth_first_frame_snapshot(surface.duplicate(true), settings, reason)
	var now_ms: int = int(Time.get_ticks_msec())

	gs.scenario_state ["zero_frame_consciousness_switch_surface"] = refreshed_surface.duplicate(true)
	gs.scenario_state ["prebuilt_first_frame_ui_snapshot"] = refreshed_surface.duplicate(true)
	gs.scenario_state ["first_frame_ui_snapshot"] = refreshed_surface.duplicate(true)
	gs.scenario_state ["god_mode_birth_surface_lock_active"] = true
	gs.scenario_state ["god_mode_birth_surface_lock_actor_id"] = int(gs.player.id)
	gs.scenario_state ["god_mode_birth_surface_lock_until_ms"] = now_ms + 180000
	gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_active"] = true
	gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_actor_id"] = int(gs.player.id)
	gs.scenario_state ["zero_frame_consciousness_switch_surface_lock_until_ms"] = now_ms + 180000

	_apply_zero_frame_consciousness_switch_surface({
		"surface_contract": refreshed_surface.duplicate(true),
		"reason": reason,
		"previous_actor_id": -1,
		"previous_actor_name": "Nobody",
		"birth_is_first_consciousness_switch": true
	}, "", [])


