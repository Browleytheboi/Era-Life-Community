func _refresh_crown_allocation_live_state() -> void:
	if crown_hub_current_section != "allocation":
		return
	if crown_hub_allocation_live_nodes.is_empty():
		return
	var summary: Dictionary = _crown_hub_cached_summary()

	if summary.is_empty():
			return



	var realm: Dictionary = summary.duplicate(false)
	var draft: Dictionary = _get_crown_allocation_draft(summary)
	var projection: Dictionary = MainSceneLogic._build_crown_allocation_projection(summary, realm, draft)
	var summary_preview: Dictionary = _build_crown_summary_preview(summary, realm, draft)
	var has_changes: bool = MainSceneLogic._crown_allocation_draft_has_changes(summary, realm, draft)
	var currency_name: String = str(summary.get("currency_name", "")).strip_edges()
	var editable: bool = bool(crown_hub_allocation_live_nodes.get("editable", false))

	if crown_hub_summary_label != null and crown_hub_current_section == "throne":
		crown_hub_summary_label.clear()
		crown_hub_summary_label.append_text("\n".join(_build_crown_summary_lines(summary_preview)))
		_update_crown_throne_metrics(summary_preview)

	var tax_rate: float = float(projection.get("tax_rate", 10.0))
	var treasury_pct: int = int(projection.get("treasury_pct", 34))
	var military_pct: int = int(projection.get("military_pct", 33))
	var goods_pct: int = int(projection.get("goods_pct", 33))
	var happiness_delta: int = int(projection.get("happiness_delta", 0))
	var approval_delta: int = int(projection.get("approval_delta", 0))
	var respect_delta: int = int(projection.get("respect_delta", 0))
	var dominant_bucket: String = "balanced"
	if military_pct > treasury_pct and military_pct > goods_pct:
		dominant_bucket = "military_pct"
	elif goods_pct > treasury_pct and goods_pct > military_pct:
		dominant_bucket = "goods_pct"
	elif treasury_pct > military_pct and treasury_pct > goods_pct:
		dominant_bucket = "treasury_pct"
	var tax_label = crown_hub_allocation_live_nodes.get("tax_label", null)
	if tax_label is Label:
		tax_label.text = "Taxes: %d%%" % int(round(tax_rate))

	var happiness_label = crown_hub_allocation_live_nodes.get("happiness_label", null)
	if happiness_label is Label:
		happiness_label.text = "Projected Mood: Happiness %s%d • Approval %s%d • Respect %s%d" % [
			"+" if happiness_delta >= 0 else "",
			happiness_delta,
			"+" if approval_delta >= 0 else "",
			approval_delta,
			"+" if respect_delta >= 0 else "",
			respect_delta
		]
		_crown_hub_apply_preview_pulse(happiness_label, happiness_delta + approval_delta + respect_delta)

	var tax_slider = crown_hub_allocation_live_nodes.get("tax_slider", null)
	if tax_slider is HSlider:
		tax_slider.set_block_signals(true)
		tax_slider.value = tax_rate
		tax_slider.set_block_signals(false)

	var revenue_label = crown_hub_allocation_live_nodes.get("revenue_label", null)
	if revenue_label is Label:
		revenue_label.text = "Total Tax Revenue: %s / yr" % _format_crown_treasury_label(int(projection.get("tax_revenue", 0)), currency_name)

	var pool_label = crown_hub_allocation_live_nodes.get("pool_label", null)
	if pool_label is Label:
		pool_label.text = "Saved Allocation Pool: %s" % _format_crown_treasury_label(int(projection.get("saved_reserve", 0)), currency_name)

	var available_label = crown_hub_allocation_live_nodes.get("available_label", null)
	if available_label is Label:
		available_label.text = "Available To Allocate Right Now: %s" % _format_crown_treasury_label(int(projection.get("available_pool", 0)), currency_name)

	var next_year_label = crown_hub_allocation_live_nodes.get("next_year_label", null)
	if next_year_label is Label:
		next_year_label.text = "Treasury +%s • Military +%s units • Goods +%s units • Carryover %s" % [
			_format_crown_treasury_label(int(projection.get("treasury_amount", 0)), currency_name),
			_crown_compact_number(float(projection.get("military_units", 0))),
			_crown_compact_number(float(projection.get("goods_units", 0))),
			_format_crown_treasury_label(int(projection.get("carryover_amount", 0)), currency_name)
		]

	var carry_label = crown_hub_allocation_live_nodes.get("carry_label", null)
	if carry_label is Label:
		carry_label.text = "Unallocated Carryover: %s" % _format_crown_treasury_label(int(projection.get("carryover_amount", 0)), currency_name)

	var buckets_raw: Variant = crown_hub_allocation_live_nodes.get("buckets", {})
	var buckets: Dictionary = buckets_raw if typeof(buckets_raw) == TYPE_DICTIONARY else {}

	var pct_values: Dictionary = {
		"treasury_pct": treasury_pct,
		"military_pct": military_pct,
		"goods_pct": goods_pct
	}
	var amount_values: Dictionary = {
		"treasury_pct": int(projection.get("treasury_amount", 0)),
		"military_pct": int(projection.get("military_amount", 0)),
		"goods_pct": int(projection.get("goods_amount", 0))
	}

	for raw_bucket_key in pct_values.keys():
		var bucket_key: String = str(raw_bucket_key)
		var bucket_nodes_raw: Variant = buckets.get(bucket_key, {})
		var bucket_nodes: Dictionary = bucket_nodes_raw if typeof(bucket_nodes_raw) == TYPE_DICTIONARY else {}

		var pct_label = bucket_nodes.get("pct_label", null)
		if pct_label is Label:
			pct_label.text = "%d%%" % int(pct_values.get(bucket_key, 0))

		var amount_label = bucket_nodes.get("amount_label", null)
		if amount_label is Label:
			amount_label.text = _format_crown_treasury_label(int(amount_values.get(bucket_key, 0)), currency_name)

		var slider = bucket_nodes.get("slider", null)
		if slider is HSlider:
			slider.set_block_signals(true)
			slider.value = float(int(pct_values.get(bucket_key, 0)))
			slider.set_block_signals(false)

		var unit_line = bucket_nodes.get("unit_line", null)
		if unit_line is Label:
			var unit_cost: int = int(bucket_nodes.get("unit_cost", 0))
			var unit_label: String = str(bucket_nodes.get("unit_label", "units"))
			var units_value: int = 0
			if bucket_key == "military_pct":
				units_value = int(projection.get("military_units", 0))
			elif bucket_key == "goods_pct":
				units_value = int(projection.get("goods_units", 0))
			unit_line.text = "Next year: %s %s @ %s each" % [
				_crown_compact_number(float(units_value)),
				unit_label,
				_format_crown_treasury_label(unit_cost, currency_name)
			]
		var card = bucket_nodes.get("card", null)
		if card is PanelContainer:
			var bucket_style: StyleBoxFlat = MainSceneLogic._crown_hub_depth_style(
				card,
				"crown_allocation_bucket_style",
				"lowest",
				_crown_hud_core_color(),
				bucket_key == dominant_bucket,
				false
			)

			if bucket_key == "goods_pct" and dominant_bucket == "military_pct":
				bucket_style.bg_color = Color(0.025, 0.03, 0.038, 0.78)
			elif bucket_key == "military_pct" and dominant_bucket == "goods_pct":
				bucket_style.bg_color = Color(0.025, 0.03, 0.038, 0.78)
			elif bucket_key == dominant_bucket:
				bucket_style.bg_color = Color(0.055, 0.07, 0.105, 0.98)

			card.add_theme_stylebox_override("panel", bucket_style)
			card.modulate = Color(1.0, 1.0, 1.0, 0.76 if bucket_style.bg_color.a < 0.8 else 1.0)

		var help_line = bucket_nodes.get("help_line", null)
		if help_line is Label:
			if bucket_key == "goods_pct" and dominant_bucket == "military_pct":
				help_line.text = "Goods dim because military is absorbing the realm's focus."
			elif bucket_key == "military_pct" and dominant_bucket == "goods_pct":
				help_line.text = "Military dims because goods are absorbing the realm's focus."
			else:
				help_line.text = MainSceneHelpers._crown_allocation_bucket_help_line(bucket_key)
	var commit_button = crown_hub_allocation_live_nodes.get("commit_button", null)
	if commit_button is Button:
		commit_button.disabled = (not editable) or (not has_changes)

	var idle_label = crown_hub_allocation_live_nodes.get("idle_label", null)
	if idle_label is Label:
		idle_label.visible = editable and not has_changes


func _commit_crown_allocation() -> void:
		if (
			gs == null
			or gs.player == null
		):
			return

		var summary: Dictionary = _crown_hub_cached_summary()

		if summary.is_empty():
			return

		var realm_projection: Dictionary = (
			summary.duplicate(false)
		)
		var draft: Dictionary = _get_crown_allocation_draft(
			summary
		)

		if not MainSceneLogic._crown_allocation_draft_has_changes(
			summary,
			realm_projection,
			draft
		):
			if crown_hub_status_label != null:
				crown_hub_status_label.text = (
					"Alerts: No allocation changes were staged."
				)
			return

		_queue_crown_contract_action_from_renderer(
			"commit_allocation",
			{
				"section_id": "allocation",
				"draft": draft.duplicate(true)
			}
		)

		set_meta(
			"crown_allocation_commit_main_scene_mutation",
			false
		)
		set_meta(
			"crown_allocation_commit_engine_calls_on_press",
			false
		)

func _crown_compact_number(
	value: float
) -> String:
	var abs_value: float = abs(
		value
	)
	var sign_prefix: String = (
		"-"
		if value < 0.0
		else ""
	)
	var suffixes: Array = [
		{
			"threshold": 1e+18,
			"suffix": "Qn"
		},
		{
			"threshold": 1000000000000000.0,
			"suffix": "Qd"
		},
		{
			"threshold": 1000000000000.0,
			"suffix": "T"
		},
		{
			"threshold": 1000000000.0,
			"suffix": "B"
		},
		{
			"threshold": 1000000.0,
			"suffix": "M"
		},
		{
			"threshold": 1000.0,
			"suffix": "K"
		}
	]

	for raw_row in suffixes:
		var row: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_row
		)
		var threshold: float = float(
			row.get(
				"threshold",
				0.0
			)
		)

		if (
			threshold <= 0.0
			or abs_value < threshold
		):
			continue

		var scaled: float = (
			abs_value / threshold
		)
		var label: String = (
			MainSceneHelpers._format_crown_compact_scaled_value(
				scaled
			)
		)

		return "%s%s%s" % [
			sign_prefix,
			label,
			str(
				row.get(
					"suffix",
					""
				)
			)
		]

	return "%s%d" % [
		sign_prefix,
		int(
			round(
				abs_value
			)
		)
	]
func _crown_diplomacy_card_number(
	value: int
) -> String:
	var exact_label: String = (
		MainSceneHelpers._crown_exact_number(
			value
		)
	)
	var compact_label: String = (
		_crown_compact_number(
			float(value)
		)
	)

	if compact_label == exact_label:
		return exact_label

	return "%s (%s)" % [
		compact_label,
		exact_label
	]


func _crown_diplomacy_card_treasury_label(
	amount: int,
	currency_name: String
) -> String:
	var clean_currency: String = str(
		currency_name
	).strip_edges()

	if clean_currency == "":
		clean_currency = (
			MainSceneLogic._crown_default_currency_name_for_realm(gs, 
				""
			)
		)

	return "%s %s" % [
		_crown_diplomacy_card_number(
			amount
		),
		clean_currency
	]


func _resolve_crown_land_metrics(realm: Dictionary) -> Dictionary:
	var km2: float = float(realm.get("land_area_km2", realm.get("land_km2", realm.get("land", realm.get("land_size", 0.0)))))
	var mi2: float = float(realm.get("land_area_mi2", 0.0))
	if mi2 <= 0.0 and km2 > 0.0:
		mi2 = km2 * 0.386102
	elif km2 <= 0.0 and mi2 > 0.0:
		km2 = mi2 / 0.386102

	km2 = max(0.0, km2)
	mi2 = max(0.0, mi2)

	var unit_system: String = str(realm.get("land_unit_system", "metric")).strip_edges().to_lower()
	var display_value: float = km2 if unit_system != "imperial" else mi2
	var display_unit: String = "km²" if unit_system != "imperial" else "mi²"

	var land_mass_label: String = "Local"
	if km2 >= 10000000.0:
		land_mass_label = "Imperial"
	elif km2 >= 1000000.0:
		land_mass_label = "Continental"
	elif km2 >= 100000.0:
		land_mass_label = "Regional"

	return {
		"km2": km2,
		"mi2": mi2,
		"display_value": display_value,
		"display_unit": display_unit,
		"label": "%s %s" % [_crown_compact_number(display_value), display_unit],
		"mass_label": land_mass_label
	}


func _present_crown_action_result(player_text: String, popup_title: String = "Crown Decision", popup_text: String = "", start_new_block: bool = false, result_meta: Dictionary = {}) -> void:
	var clean_player_text: String = player_text.strip_edges()
	if clean_player_text != "":
		_append_text_to_diary(clean_player_text, start_new_block)
		_render_life_diary_panel()

	var result: Dictionary = result_meta.duplicate(true)
	result ["text"] = clean_player_text
	result ["popup_title"] = popup_title
	result ["popup_text"] = popup_text.strip_edges() if popup_text.strip_edges() != "" else _player_diary_text_to_popup_text(clean_player_text)
	result ["popup_footer"] = str(result.get("popup_footer", "Tap anywhere to continue.")).strip_edges()

	cached_last_result = result
	crown_pending_action_result = {}
	_maybe_show_action_result_popup(result)
func _queue_crown_action_result(world_text: String, event_name: String, category: String = "politics") -> void:
	if gs == null or gs.player == null:
		return

	var approval_before: int = int(get_meta("crown_action_approval_before", int(gs.player.approval)))
	var approval_after: int = int(gs.player.approval)
	var diary_text: String = _crown_world_event_to_first_person(world_text, event_name)

	crown_pending_action_result = {
		"text": diary_text,
		"popup_title": MainSceneHelpers._crown_popup_title_for_event(event_name),
		"popup_text": _player_diary_text_to_popup_text(diary_text),
		"popup_footer": "Tap anywhere to continue.",
		"category": category,
		"event_name": event_name,
		"crown_approval_before": approval_before,
		"crown_approval_after": approval_after,
		"crown_approval_delta": approval_after - approval_before
	}


func _flush_pending_crown_action_result() -> void:
	if crown_pending_action_result.is_empty():
		return

	var result: Dictionary = crown_pending_action_result.duplicate(true)
	crown_pending_action_result = {}

	var diary_text: String = str(result.get("text", "")).strip_edges()
	if diary_text == "":
		return

	_present_crown_action_result(
		diary_text,
		str(result.get("popup_title", "Crown Decision")),
		str(result.get("popup_text", "")),
		false,
		result
	)


func _crown_world_event_to_first_person(world_text: String, event_name: String = "") -> String:
	if gs == null or gs.player == null:
		return str(world_text).strip_edges()

	var clean_text: String = str(world_text).strip_edges()
	var full_name: String = ("%s %s" % [str(gs.player.first_name), str(gs.player.last_name)]).strip_edges()
	var first_name: String = str(gs.player.first_name).strip_edges()

	if full_name != "" and clean_text.begins_with(full_name):
		return ("I %s" % clean_text.substr(full_name.length()).strip_edges()).strip_edges()

	if first_name != "" and clean_text.begins_with(first_name):
		return ("I %s" % clean_text.substr(first_name.length()).strip_edges()).strip_edges()

	match str(event_name).strip_edges():
		"crown_trade", "crown_country_trade":
			return "I opened a trade route as a ruler."
		"crown_gift", "crown_country_gift":
			return "I sent a diplomatic gift from the throne."
		"crown_bribe", "crown_country_bribe":
			return "I used covert money to pressure foreign influence."
		"crown_country_war":
			return "I declared war from the throne."
		"crown_execution":
			return "I ordered an execution and felt the realm react."
		"crown_exile":
			return "I used crown authority to exile someone."
		"crown_pardon":
			return "I showed mercy from the throne."
		_:
			return "I made a crown decision: %s" % clean_text


func _render_crown_action_approval_bar(
	result: Dictionary
) -> bool:
	if action_result_popup_choices == null:
		return false

	var card:= action_result_popup_choices.get_node_or_null(
		"ActionResultApprovalCard"
	) as PanelContainer

	if card == null:
		return false

	card.visible = false

	if (
		not result.has("crown_approval_before")
		and not result.has("crown_approval_after")
	):
		return false

	var before_value: int = clamp(
		int(
			result.get(
				"crown_approval_before",
				0
			)
		),
		0,
		100
	)
	var after_value: int = clamp(
		int(
			result.get(
				"crown_approval_after",
				before_value
			)
		),
		0,
		100
	)
	var delta_value: int = after_value - before_value
	var label:= card.get_node_or_null(
		"Margin/Box/ApprovalLabel"
	) as Label
	var bar:= card.get_node_or_null(
		"Margin/Box/ApprovalBar"
	) as ProgressBar

	if label != null:
		label.text = "Approval: %d → %d (%s%d)" % [
			before_value,
			after_value,
			"+" if delta_value >= 0 else "",
			delta_value
		]

	if bar != null:
		bar.value = after_value
		bar.set_meta(
			"approval_before",
			before_value
		)
		bar.set_meta(
			"approval_after",
			after_value
		)
		bar.set_meta(
			"approval_animation_build_forbidden",
			true
		)

	card.visible = true
	return true
func _execute_crown_action(
		action_id: String,
		payload: Dictionary = {}
) -> void:
		var clean_action_id: String = str(
			action_id
		).strip_edges().to_lower()

		if clean_action_id in [
			"country_envoy",
			"country_trade",
			"country_gift",
			"country_bribe"
		]:
			_queue_crown_contract_action_from_renderer(
				clean_action_id,
				payload.duplicate(true)
			)
			return

		_execute_crown_action_legacy(
			action_id,
			payload
		)
func _execute_crown_action_legacy(
		action_id: String,
		payload: Dictionary = {}
) -> void:
	if gs == null or gs.player == null:
		return

	var p:= gs.player
	set_meta("crown_action_approval_before", int(p.approval))
	crown_pending_action_result = {}

	var realm: Dictionary = MainSceneLogic._resolve_player_realm_dict(gs)
	var summary: Dictionary = _build_player_crown_summary()

	match action_id:
		"mediate_citizens_choice":
			var choice: Dictionary = payload.get("choice", {}) if typeof(payload.get("choice", {})) == TYPE_DICTIONARY else {}
			var wisdom_score: int = int(choice.get("wisdom_score", 0))
			var approval_delta: int = int(choice.get("approval_delta", 0))
			var willpower_delta: int = int(choice.get("willpower_delta", 0))
			var result_text: String = str(choice.get("result_text", "The court listens to your judgment."))

			p.approval = clamp(int(p.approval) + approval_delta, 0, 100)

			if wisdom_score >= 70 and willpower_delta > 0:
				MainSceneHelpers._grant_crown_wisdom_willpower(p, willpower_delta)

			_push_crown_world_event(
				"%s %s mediated a citizen dispute: %s" % [p.first_name, p.last_name, result_text],
				"crown_citizen_mediation",
				"politics"
			)

			cached_last_result = {
				"text": result_text,
				"approval_delta": approval_delta,
				"willpower_delta": willpower_delta if wisdom_score >= 70 else 0
			}
			crown_action_popup_status.text = result_text
			_hide_crown_action_popup()

		"law_sign":
			var approval_delta: int = int(payload.get("approval_on_sign", 0))
			p.approval = clamp(int(p.approval) + approval_delta, 0, 100)
			_push_crown_world_event(
				"%s %s signed '%s' into law." % [p.first_name, p.last_name, str(payload.get("title", "a proposed law"))],
				"crown_law_signed",
				"politics"
			)
			cached_last_result = { "text": "Signed into law. Approval %s%d." % ["+" if approval_delta >= 0 else "", approval_delta]}
			_hide_crown_action_popup()

		"law_reject_contextual":
			var approval_delta: int = int(payload.get("approval_on_reject", 0))
			p.approval = clamp(int(p.approval) + approval_delta, 0, 100)
			_push_crown_world_event(
				"%s %s rejected '%s'." % [p.first_name, p.last_name, str(payload.get("title", "a proposed law"))],
				"crown_law_rejected",
				"politics"
			)
			cached_last_result = { "text": "Rejected. Approval %s%d." % ["+" if approval_delta >= 0 else "", approval_delta]}
			_hide_crown_action_popup()

		"law_revise_contextual":
			var approval_delta: int = int(payload.get("approval_on_revise", 1))
			p.approval = clamp(int(p.approval) + approval_delta, 0, 100)
			_push_crown_world_event(
				"%s %s demanded revisions to '%s'." % [p.first_name, p.last_name, str(payload.get("title", "a proposed law"))],
				"crown_law_revised",
				"politics"
			)
			cached_last_result = { "text": "The court was ordered to revise the proposal."}
			_hide_crown_action_popup()

		"law_delay_contextual":
			var approval_delta: int = int(payload.get("approval_on_delay", -1))
			p.approval = clamp(int(p.approval) + approval_delta, 0, 100)
			_push_crown_world_event(
				"%s %s delayed the vote on '%s'." % [p.first_name, p.last_name, str(payload.get("title", "a proposed law"))],
				"crown_law_delayed",
				"politics"
			)
			cached_last_result = { "text": "The law was delayed. Court tension rises quietly."}
			_hide_crown_action_popup()

		"country_envoy":
			p.approval = clamp(int(p.approval) + 1, 0, 100)
			_push_crown_world_event("%s sent a friendly envoy to %s." % [p.first_name, str(payload.get("country", "a foreign country"))], "crown_country_envoy", "diplomacy")
			_hide_crown_action_popup()

		"country_trade":
			var country_name: String = str(payload.get("country", "a foreign country")).strip_edges()
			if MainSceneHelpers._crown_is_era_kingdom_country(country_name):
				return
			p.approval = clamp(int(p.approval) + 2, 0, 100)
			_push_crown_world_event(
				"%s %s opened a trade mission with %s." % [p.first_name, p.last_name, country_name],
				"crown_country_trade",
				"diplomacy"
			)

		"country_gift":
			var country_name: String = str(payload.get("country", "a foreign country")).strip_edges()
			if MainSceneHelpers._crown_is_era_kingdom_country(country_name):
				return
			var gift_amount: int = 100000
			if int(p.bank_balance) < gift_amount:
				crown_hub_status_label.text = "Alerts: You do not have enough money for that diplomatic gift."
				return
			p.bank_balance = int(p.bank_balance) - gift_amount
			p.approval = clamp(int(p.approval) + 1, 0, 100)
			_push_crown_world_event(
				"%s %s sent a diplomatic gift to %s." % [p.first_name, p.last_name, country_name],
				"crown_country_gift",
				"diplomacy"
			)

		"country_bribe":
			var country_name: String = str(payload.get("country", "a foreign country")).strip_edges()
			if MainSceneHelpers._crown_is_era_kingdom_country(country_name):
				return
			var bribe_amount: int = 150000
			if int(p.bank_balance) < bribe_amount:
				crown_hub_status_label.text = "Alerts: You do not have enough money for that bribe."
				return
			p.bank_balance = int(p.bank_balance) - bribe_amount
			p.scandal = clamp(int(p.scandal) + 5, 0, 100)
			p.approval = clamp(int(p.approval) - 3, 0, 100)
			_push_crown_world_event(
				"%s %s secretly bribed officials connected to %s." % [p.first_name, p.last_name, country_name],
				"crown_country_bribe",
				"diplomacy"
			)

		"country_war":
			var country_name: String = str(payload.get("country", "a foreign country")).strip_edges()
			if MainSceneHelpers._crown_is_era_kingdom_country(country_name):
				return
			p.approval = clamp(int(p.approval) - 6, 0, 100)
			MainSceneLogic._apply_crown_public_outcry_delta(gs, 6)
			_push_crown_world_event(
				"%s %s declared war pressure against %s." % [p.first_name, p.last_name, country_name],
				"crown_country_war",
				"diplomacy"
			)
		"population_open_profile":
			_open_crown_population_profile(int(payload.get("target_id", -1)))
			return

		"population_recruit":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				return
			target.realm_id = int(p.realm_id)
			target.approval = min(100, max(int(target.approval), 55))
			if str(target.job).strip_edges() == "":
				target.job = "Court Retainer"
			_push_crown_world_event(
				"%s %s recruited %s %s into the realm orbit." % [
					p.first_name, p.last_name,
					target.first_name, target.last_name
				],
				"crown_recruitment",
				"politics"
			)
			cached_last_result = { "text": "%s entered your realm orbit." % target.first_name}
			_hide_crown_action_popup()
			_refresh_crown_hub()
			return

		"population_spy":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				return
			if typeof(gs.scenario_state) != TYPE_DICTIONARY:
				gs.scenario_state = {}
			var spy_store_raw: Variant = gs.scenario_state.get("crown_spy_targets", {})
			var spy_store: Dictionary = spy_store_raw if typeof(spy_store_raw) == TYPE_DICTIONARY else {}
			spy_store [str(int(target.id))] = {
				"target_id": int(target.id),
				"realm_id": int(target.realm_id),
				"year": int(gs.year),
				"ordered_by": int(p.id)
			}
			gs.scenario_state ["crown_spy_targets"] = spy_store
			_push_crown_world_event(
				"%s %s ordered surveillance on %s %s." % [
					p.first_name, p.last_name,
					target.first_name, target.last_name
				],
				"crown_spy_order",
				"politics"
			)
			cached_last_result = { "text": "A surveillance thread was opened on %s." % target.first_name}
			_hide_crown_action_popup()
			_refresh_crown_hub()
			return

		"population_marry_into":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				return
			if typeof(gs.scenario_state) != TYPE_DICTIONARY:
				gs.scenario_state = {}
			var marriage_store_raw: Variant = gs.scenario_state.get("crown_marriage_arrangements", {})
			var marriage_store: Dictionary = marriage_store_raw if typeof(marriage_store_raw) == TYPE_DICTIONARY else {}
			marriage_store ["%d:%d" % [int(p.id), int(target.id)]] = {
				"source_id": int(p.id),
				"target_id": int(target.id),
				"source_realm_id": int(p.realm_id),
				"target_realm_id": int(target.realm_id),
				"year": int(gs.year)
			}
			gs.scenario_state ["crown_marriage_arrangements"] = marriage_store
			_push_crown_world_event(
				"%s %s opened a dynastic marriage route involving %s %s." % [
					p.first_name, p.last_name,
					target.first_name, target.last_name
				],
				"crown_dynastic_marriage",
				"politics"
			)
			cached_last_result = { "text": "A dynastic marriage route was recorded."}
			_hide_crown_action_popup()
			_refresh_crown_hub()
			return

		"population_exile":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				return
			target.exiled = true
			if bool(target.is_ruler):
				target.deposed = true
				target.is_ruler = false
			_push_crown_world_event(
				"%s %s exiled %s %s from the realm." % [
					p.first_name, p.last_name,
					target.first_name, target.last_name
				],
				"crown_exile",
				"politics"
			)
			cached_last_result = { "text": "%s was exiled." % target.first_name}
			_hide_crown_action_popup()
			_refresh_crown_hub()
			return

		"population_promote_confirm":
			var target: Person = gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				return

			var rank_seed:= str(payload.get("rank_seed", "Lesser Royal")).strip_edges()
			var applied_seed:= MainSceneLogic._apply_crown_population_promotion(gs, target, rank_seed)
			if applied_seed == "":
				return

			_push_crown_world_event(
				"%s %s granted %s %s the title of %s." % [
					p.first_name, p.last_name,
					target.first_name, target.last_name,
					str(target.royal_title).strip_edges()
				],
				"crown_promotion",
				"politics"
			)
			cached_last_result = {
				"text": "%s was granted the title of %s." % [
					target.first_name,
					str(target.royal_title).strip_edges()
				]
			}
			_hide_crown_action_popup()
			_refresh_crown_hub()
			return
		"abdicate_retire":
			var successor:= MainSceneLogic._pick_best_crown_successor(gs, int(p.id))
			p.is_ruler = false
			p.deposed = false
			p.exiled = false
			if successor != null and not realm.is_empty():
				realm ["ruler_id"] = successor.id
				successor.is_ruler = true
				successor.is_royal = true
				successor.succession_rank = 0
				successor.approval = max(int(successor.approval), 55)
				if gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
					successor.royal_title = str(gs.royalty_engine.call("_resolve_rank_title", successor, "ruler"))
				if gs.realm_engine != null:
					gs.realm_engine.realms [int(p.realm_id)] = realm
				_push_crown_world_event(
					"%s %s abdicated and passed authority to %s %s." % [
						p.first_name, p.last_name, successor.first_name, successor.last_name
					],
					"crown_abdication",
					"politics"
				)
			else:
				_push_crown_world_event(
					"%s %s abdicated and left the throne unstable." % [p.first_name, p.last_name],
					"crown_abdication",
					"politics"
				)
			crown_hub_status_label.text = "You stepped down from the throne."
			_hide_crown_action_popup()
		"abdicate_support_heir":
			var heir:= MainSceneLogic._pick_best_crown_successor(gs, int(p.id))
			if heir == null:
				crown_action_popup_status.text = "No valid heir was found."
				return
			_execute_crown_action("appoint_heir_confirm", { "target_id": int(heir.id)})
			_execute_crown_action("abdicate_retire")
		"abdicate_breakaway":
			_show_crown_action_popup("create_realm")
		"celebrity_gala", "celebrity_media", "celebrity_charity":
			p.fame = clamp(int(p.fame) + 6, 0, 100)
			p.scandal = clamp(int(p.scandal) + (3 if action_id == "celebrity_media" else 1), 0, 100)
			_push_crown_world_event(
				"%s %s leaned into royal celebrity and public spectacle." % [p.first_name, p.last_name],
				"crown_celebrity",
				"fame"
			)
			crown_hub_status_label.text = "Celebrity pressure surged through the realm."
			_hide_crown_action_popup()
		"execute_confirm":
			var target:= gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				crown_action_popup_status.text = "That target is no longer valid."
				return

			var method: Dictionary = payload.get("method", {}) if typeof(payload.get("method", {})) == TYPE_DICTIONARY else {}
			if method.is_empty():
				method = {
					"label": "Public Decree",
					"severity": 45,
					"approval_delta": -8,
					"scandal_delta": 8,
					"outcry_delta": 8,
					"cause": "Execution"
				}

			var target_role: String = str(payload.get("target_role", _crown_execution_target_role(target))).strip_edges()
			var random_citizen_penalty: int = 0
			if target_role.to_lower() == "citizen":
				random_citizen_penalty = 8

			if gs.health_engine != null and gs.health_engine.has_method("try_kill"):
				gs.health_engine.try_kill(target, str(method.get("cause", "Execution")))

			p.scandal = clamp(int(p.scandal) + int(method.get("scandal_delta", 8)) + random_citizen_penalty, 0, 100)
			p.approval = clamp(int(p.approval) + int(method.get("approval_delta", -8)) - random_citizen_penalty, 0, 100)
			MainSceneLogic._apply_crown_public_outcry_delta(gs, int(method.get("outcry_delta", 8)) + random_citizen_penalty)

			_push_crown_world_event(
				"%s %s ordered %s %s to be executed by %s." % [
					p.first_name,
					p.last_name,
					target.first_name,
					target.last_name,
					str(method.get("label", "Public Decree"))
				],
				"crown_execution",
				"politics"
			)

			crown_hub_status_label.text = "The realm felt the sentence immediately."
			_hide_crown_action_popup()

		"execute_exile":
			var target:= gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				crown_action_popup_status.text = "That target is no longer valid."
				return

			target.exiled = true
			if bool(target.is_ruler):
				target.deposed = true
				target.is_ruler = false

			p.approval = clamp(int(p.approval) - 2, 0, 100)
			MainSceneLogic._apply_crown_public_outcry_delta(gs, 2)

			_push_crown_world_event(
				"%s %s spared %s %s from death and exiled them instead." % [
					p.first_name,
					p.last_name,
					target.first_name,
					target.last_name
				],
				"crown_exile",
				"politics"
			)

			crown_hub_status_label.text = "The court accepted exile as the sentence."
			_hide_crown_action_popup()

		"execute_pardon":
			var target:= gs.get_or_reactivate_npc_by_id(int(payload.get("target_id", -1)))
			if target == null or not target.alive:
				crown_action_popup_status.text = "That target is no longer valid."
				return

			p.approval = clamp(int(p.approval) + 4, 0, 100)
			p.scandal = clamp(int(p.scandal) - 1, 0, 100)

			_push_crown_world_event(
				"%s %s heard %s %s beg for mercy and pardoned them." % [
					p.first_name,
					p.last_name,
					target.first_name,
					target.last_name
				],
				"crown_pardon",
				"politics"
			)

			crown_hub_status_label.text = "The court witnessed mercy from the throne."
			_hide_crown_action_popup()
		"population_profile":
			_open_crown_population_profile(int(payload.get("target_id", -1)))
			return
		"set_honorific":
			var title_text: String = str(payload.get("title", "")).strip_edges()
			if title_text == "":
				return
			p.royal_title = title_text
			_push_crown_world_event(
				"%s %s changed the royal honorific to %s." % [p.first_name, p.last_name, title_text],
				"crown_honorific",
				"politics"
			)
			_refresh_crown_hub()
			_hide_crown_action_popup()
		"law_approve":
			p.approval = clamp(int(p.approval) + 4, 0, 100)
			_push_crown_world_event("%s %s endorsed a proposed law package." % [p.first_name, p.last_name], "crown_law_review", "politics")
			_hide_crown_action_popup()
		"law_reject":
			p.approval = clamp(int(p.approval) - 2, 0, 100)
			_push_crown_world_event("%s %s rejected a proposed law package." % [p.first_name, p.last_name], "crown_law_review", "politics")
			_hide_crown_action_popup()
		"law_revise":
			p.approval = clamp(int(p.approval) + 1, 0, 100)
			_push_crown_world_event("%s %s forced revisions before passage." % [p.first_name, p.last_name], "crown_law_review", "politics")
			_hide_crown_action_popup()
		"law_delay":
			_push_crown_world_event("%s %s delayed a law vote and widened court tension." % [p.first_name, p.last_name], "crown_law_review", "politics")
			_hide_crown_action_popup()
		"public_service":
			p.approval = clamp(int(p.approval) + int(payload.get("approval_delta", 0)), 0, 100)
			p.fame = clamp(int(p.fame) + int(payload.get("fame_delta", 0)), 0, 100)
			_push_crown_world_event(
				"%s %s performed a public royal duty." % [p.first_name, p.last_name],
				"crown_public_service",
				"politics"
			)
			_hide_crown_action_popup()
		"public_disservice":
			p.approval = clamp(int(p.approval) + int(payload.get("approval_delta", 0)), 0, 100)
			p.scandal = clamp(int(p.scandal) + int(payload.get("scandal_delta", 0)), 0, 100)
			p.bank_balance = int(p.bank_balance) + 150000
			_push_crown_world_event(
				"%s %s abused the throne for short-term gain." % [p.first_name, p.last_name],
				"crown_public_disservice",
				"politics"
			)
			_hide_crown_action_popup()
		"create_realm_confirm":
			if gs.realm_engine == null:
				crown_action_popup_status.text = "Realm engine is unavailable."
				return
			var realm_name: String = str(payload.get("realm_name", "")).strip_edges()
			if realm_name == "":
				crown_action_popup_status.text = "Give the realm a name first."
				return
			var new_realm_id: int = int(gs.realm_engine.create_custom_realm_for_player(p, realm_name))
			if gs.realm_engine.realms.has(new_realm_id):
				var new_realm: Dictionary = gs.realm_engine.realms [new_realm_id]
				new_realm ["government_style"] = MainSceneLogic._resolve_player_government_style(gs)
				new_realm ["treasury"] = max(100000, int(p.bank_balance * 0.25))
				gs.realm_engine.realms [new_realm_id] = new_realm
			p.is_royal = true
			p.is_ruler = true
			p.palace_owned = true
			p.approval = max(int(p.approval), 60)
			if gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
				p.royal_title = str(gs.royalty_engine.call("_resolve_rank_title", p, "ruler"))
			crown_hub_status_label.text = "You founded %s." % realm_name
			_refresh_crown_hub()
			_hide_crown_action_popup()
		"set_government_style":
			if realm.is_empty():
				crown_action_popup_status.text = "You do not currently control a valid realm."
				return
			realm ["government_style"] = str(payload.get("style", "Monarchy"))
			gs.realm_engine.realms [int(p.realm_id)] = realm
			_push_crown_world_event(
				"%s %s reorganized the realm as a %s." % [p.first_name, p.last_name, str(payload.get("style", "Monarchy"))],
				"crown_government_style",
				"politics"
			)
			_refresh_crown_hub()
			_hide_crown_action_popup()
		"trade_offer":
			_set_crown_realm_relation_delta(int(payload.get("target_realm_id", -1)), int(payload.get("delta", 0)))
			_push_crown_world_event(
				"%s opened a trade route with %s." % [str(summary.get("realm_name", "Your realm")), MainSceneLogic._crown_realm_name(gs, int(payload.get("target_realm_id", -1)))],
				"crown_trade",
				"realm"
			)
			_hide_crown_action_popup()
		"gift_offer":
			var gift_amount: int = int(payload.get("amount", 0))
			if int(p.bank_balance) < gift_amount:
				crown_action_popup_status.text = "You do not have enough money for that gift."
				return
			p.bank_balance = int(p.bank_balance) - gift_amount
			_set_crown_realm_relation_delta(int(payload.get("target_realm_id", -1)), int(payload.get("delta", 0)))
			_push_crown_world_event(
				"%s sent tribute to %s." % [str(summary.get("realm_name", "Your realm")), MainSceneLogic._crown_realm_name(gs, int(payload.get("target_realm_id", -1)))],
				"crown_gift",
				"realm"
			)
			_hide_crown_action_popup()
		"bribe_offer":
			var bribe_amount: int = int(payload.get("amount", 0))
			if int(p.bank_balance) < bribe_amount:
				crown_action_popup_status.text = "You do not have enough money for that bribe."
				return
			p.bank_balance = int(p.bank_balance) - bribe_amount
			p.scandal = clamp(int(p.scandal) + 6, 0, 100)
			p.approval = clamp(int(p.approval) - 3, 0, 100)
			_set_crown_realm_relation_delta(int(payload.get("target_realm_id", -1)), int(payload.get("delta", 0)))
			_push_crown_world_event(
				"%s pushed covert leverage into %s." % [str(summary.get("realm_name", "Your realm")), MainSceneLogic._crown_realm_name(gs, int(payload.get("target_realm_id", -1)))],
				"crown_bribe",
				"realm"
			)
			_hide_crown_action_popup()
		"war_confirm":
			if gs.realm_engine == null:
				crown_action_popup_status.text = "Realm engine is unavailable."
				return
			var war_text: String = str(gs.realm_engine.declare_war(p, int(payload.get("target_realm_id", -1))))
			_set_crown_realm_relation_delta(int(payload.get("target_realm_id", -1)), -25)
			crown_hub_status_label.text = war_text
			_hide_crown_action_popup()
		"expand_land_confirm":
			if realm.is_empty():
				crown_action_popup_status.text = "You do not currently control a valid realm."
				return
			var cost: int = int(payload.get("cost", 0))
			var gain: int = int(payload.get("gain", 0))
			if int(p.bank_balance) < cost:
				crown_action_popup_status.text = "You do not have enough money for that expansion."
				return
			p.bank_balance = int(p.bank_balance) - cost
			realm ["land"] = int(realm.get("land", realm.get("land_size", 0))) + gain
			realm ["population"] = int(realm.get("population", 0)) + int(round(float(gain) * 1200.0))
			gs.realm_engine.realms [int(p.realm_id)] = realm
			_push_crown_world_event(
				"%s invested in territorial expansion." % str(summary.get("realm_name", "Your realm")), "crown_expand_land", "realm"
			)
			_refresh_crown_hub()
			_hide_crown_action_popup()
		"appoint_heir_confirm":
			var target:= gs.get_npc_by_id(int(payload.get("target_id", -1)))
			if target == null:
				crown_action_popup_status.text = "That heir is no longer valid."
				return
			target.is_royal = true
			target.succession_rank = 1
			if gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
				target.royal_title = str(gs.royalty_engine.call("_resolve_rank_title", target, "heir"))
			_push_crown_world_event(
				"%s %s publicly elevated %s %s as heir." % [p.first_name, p.last_name, target.first_name, target.last_name],
				"crown_heir",
				"dynasty"
			)
			_hide_crown_action_popup()
		"betrothal_confirm":
			var target:= gs.get_npc_by_id(int(payload.get("target_id", -1)))
			if target == null:
				crown_action_popup_status.text = "That match is no longer valid."
				return
			_set_crown_realm_relation_delta(int(target.realm_id), 8)
			_push_crown_world_event(
				"%s House entered a dynastic betrothal pressure pact with %s House." % [p.last_name, target.last_name],
				"crown_dynastic_betrothal",
				"dynasty"
			)
			_hide_crown_action_popup()

		"law_decree":
			p.approval = clamp(int(p.approval) + 1, 0, 100)
			p.scandal = clamp(int(p.scandal) + 2, 0, 100)
			_push_crown_world_event("%s issued a direct royal decree." % p.first_name, "crown_decree", "politics")
			_hide_crown_action_popup()
		"justice_posture_set":
			_push_crown_world_event("%s reset the justice posture to %s." % [p.first_name, str(payload.get("kind", "balanced"))], "crown_justice_posture", "politics")
			_hide_crown_action_popup()
		"emergency_powers_confirm":
			p.approval = clamp(int(p.approval) - 8, 0, 100)
			_push_crown_world_event("%s invoked emergency powers across the realm." % p.first_name, "crown_emergency_powers", "politics")
			_hide_crown_action_popup()

	_refresh_crown_hub()
	_update_crown_hud()
	_flush_pending_crown_action_result()

func _push_crown_world_event(text: String, event_name: String, category: String = "politics") -> void:
	if gs == null or gs.player == null:
		return

	gs.push_world_feed(
		text,
		{
			"npc_id": gs.player.id,
			"personally_relevant": true,
			"category": category,
			"event_name": event_name,
			"source": "crown_ui"
		}
	)

	_queue_crown_action_result(text, event_name, category)

func _build_crown_execution_targets() -> Array:
	var out: Array = []
	var seen: Dictionary = {}
	if gs == null or gs.player == null:
		return out

	var realm_id: int = int(gs.player.realm_id)

	var _push_target:= func (npc: Person) -> void:
		if npc == null or not npc.alive:
			return
		if int(npc.id) == int(gs.player.id):
			return
		if int(npc.realm_id) != realm_id:
			return
		var npc_id: int = int(npc.id)
		if npc_id <= 0 or seen.has(npc_id):
			return
		seen [npc_id] = true
		out.append(npc)

	for raw_npc in gs.npcs:
		if raw_npc == null or not (raw_npc is Person):
			continue
		var npc: Person = raw_npc
		if bool(npc.is_royal) or int(npc.succession_rank) <= 12 or bool(npc.deposed) or _is_crown_realm_official(npc, realm_id):
			_push_target.call(npc)

	var citizens: Array = _build_crown_population_targets_for_realm(realm_id)
	for raw_citizen in citizens:
		if raw_citizen == null or not (raw_citizen is Person):
			continue
		var citizen: Person = raw_citizen
		if _is_crown_realm_official(citizen, realm_id):
			continue
		if bool(citizen.is_royal):
			continue
		_push_target.call(citizen)
		if out.size() >= 18:
			break

	out.sort_custom(func (a, b):
		var a_npc: Person = a
		var b_npc: Person = b
		var a_score: int = 0
		var b_score: int = 0
		if _is_crown_realm_official(a_npc, realm_id):
			a_score += 2000
		if _is_crown_realm_official(b_npc, realm_id):
			b_score += 2000
		if bool(a_npc.is_royal):
			a_score += 1000
		if bool(b_npc.is_royal):
			b_score += 1000
		a_score += int(a_npc.fame) + int(a_npc.age)
		b_score += int(b_npc.fame) + int(b_npc.age)
		return a_score > b_score
	)

	return out.slice(0, min(18, out.size()))
func _crown_execution_target_role(target: Person) -> String:
	if target == null or gs == null or gs.player == null:
		return "Citizen"

	var realm_id: int = int(gs.player.realm_id)
	if _is_crown_realm_official(target, realm_id):
		return "Court"
	if bool(target.is_royal) or int(target.succession_rank) <= 12 or bool(target.deposed):
		return "Royal Orbit"
	return "Citizen"


func _build_crown_execution_plea_text(target: Person, method: Dictionary) -> String:
	if target == null:
		return "The condemned target cannot be resolved.\n"

	var target_name: String = _relationship_display_name(target)
	var severity: int = int(method.get("severity", 50))
	var method_label: String = str(method.get("label", "Execution")).strip_edges()

	var plea_line: String = "\"Please... give me exile. Give me prison. Give me anything but this.\""
	if severity < 55:
		plea_line = "\"I understand the court's anger, but I am asking for mercy.\""
	elif severity < 80:
		plea_line = "\"My family will remember this. Please, let me live.\""

	return "%s is brought before you one final time.\n\nMethod: %s\nSeverity: %d/100\n\n%s\n\nThis is the last moment to reverse the sentence." % [
		target_name,
		method_label,
		severity,
		plea_line
	]


func _format_crown_treasury_label(amount: int, currency_name: String) -> String:
	var clean_currency: String = currency_name.strip_edges()
	if clean_currency == "":
		clean_currency = MainSceneLogic._crown_default_currency_name_for_realm(gs, "")

	var compact_amount: String = _crown_compact_number(float(amount))

	if gs != null and gs.economy_engine != null and clean_currency in ["Dollars", "Pounds", "Yen", "Reais", "Credits", "Solar Credits", "Lunar Credits"]:
		return "%s %s" % [compact_amount, clean_currency]

	return "%s %s" % [compact_amount, clean_currency]

func _build_crown_population_targets_for_realm(realm_id: int) -> Array:
	var out: Array = []
	if gs == null or realm_id <= 0:
		return out

	var realm_name: String = MainSceneLogic._crown_realm_name(gs, realm_id)
	var capital_city: String = ""
	var subzones: Array = []
	var normalized_aliases: Dictionary = {}
	var native_element: String = MainSceneLogic._crown_population_realm_element(gs, realm_id, realm_name)
	var is_avatar_nation: bool = native_element in ["air", "earth", "fire", "water"]

	if gs.realm_engine != null and gs.realm_engine.realms.has(realm_id):
		var realm_raw: Variant = gs.realm_engine.realms.get(realm_id, {})
		var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}

		if realm_name == "":
			realm_name = str(realm.get("name", "")).strip_edges()

		capital_city = str(realm.get("capital_city", "")).strip_edges()

		var subzones_raw: Variant = realm.get("subzones", [])
		subzones = subzones_raw if typeof(subzones_raw) == TYPE_ARRAY else []

		if gs.realm_engine.has_method("_normalize_realm_match_aliases"):
			normalized_aliases = gs.realm_engine._normalize_realm_match_aliases(realm_name)

	var normalized_realm_name: String = realm_name.to_lower()
	var normalized_cities: Dictionary = {}

	if capital_city != "":
		normalized_cities [capital_city.to_lower()] = true

	for raw_city in subzones:
		var city_text: String = str(raw_city).strip_edges()
		if city_text != "":
			normalized_cities [city_text.to_lower()] = true

	var seen: Dictionary = {}

	var _matches_alias = func (value: String) -> bool:
		var clean_value: String = str(value).strip_edges().to_lower()
		if clean_value == "":
			return false
		if normalized_aliases.has(clean_value):
			return true
		return normalized_realm_name != "" and clean_value == normalized_realm_name

	var _matches_person = func (npc: Person) -> bool:
		if npc == null or not npc.alive:
			return false
		if int(npc.realm_id) == realm_id:
			return true
		if _matches_alias.call(str(npc.home_country)):
			return true
		if _matches_alias.call(str(npc.birth_country)):
			return true
		if _matches_alias.call(str(npc.bending_nation)):
			return true

		var home_city: String = str(npc.home_city).strip_edges().to_lower()
		var birth_city: String = str(npc.birth_city).strip_edges().to_lower()
		if normalized_cities.has(home_city) or normalized_cities.has(birth_city):
			return true

		return false

	var _push_person = func (npc: Person) -> void:
		if npc == null or not npc.alive:
			return

		var npc_id: int = int(npc.id)
		if npc_id <= 0 or seen.has(npc_id):
			return

		if not _matches_person.call(npc):
			return

		out.append(npc)
		seen [npc_id] = true

	if gs.player != null:
		_push_person.call(gs.player)

	for raw_npc in gs.npcs:
		var npc: Person = raw_npc
		_push_person.call(npc)

	out.sort_custom(func (a, b):
		var a_npc: Person = a
		var b_npc: Person = b

		var a_score: int = 0
		var b_score: int = 0

		if bool(a_npc.is_ruler):
			a_score += 3000
		if bool(b_npc.is_ruler):
			b_score += 3000

		if bool(a_npc.is_royal):
			a_score += 1600
		if bool(b_npc.is_royal):
			b_score += 1600

		if _is_crown_population_noble_court_member(a_npc, realm_id):
			a_score += 850
		if _is_crown_population_noble_court_member(b_npc, realm_id):
			b_score += 850

		if is_avatar_nation:
			if MainSceneLogic._is_crown_population_element_master(gs, a_npc, realm_id, native_element):
				a_score += 900
			if MainSceneLogic._is_crown_population_element_master(gs, b_npc, realm_id, native_element):
				b_score += 900

		a_score += int(a_npc.fame) + int(a_npc.respect) + int(a_npc.age)
		b_score += int(b_npc.fame) + int(b_npc.respect) + int(b_npc.age)

		return a_score > b_score
	)

	return out
func _build_crown_population_element_master_targets_for_realm(realm_id: int, element: String, seeded_people: Array = []) -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	if gs == null or realm_id <= 0:
		return out

	var clean_element: String = str(element).strip_edges().to_lower()
	if clean_element == "":
		return out

	for raw_seed in seeded_people:
		var seeded: Person = raw_seed
		if seeded != null and MainSceneLogic._is_crown_population_element_master(gs, seeded, realm_id, clean_element):
			MainSceneHelpers._crown_population_push_unique_person(out, seen, seeded)

	if gs.player != null and MainSceneLogic._is_crown_population_element_master(gs, gs.player, realm_id, clean_element):
		MainSceneHelpers._crown_population_push_unique_person(out, seen, gs.player)

	for raw_npc in gs.npcs:
		var npc: Person = raw_npc
		if npc != null and MainSceneLogic._is_crown_population_element_master(gs, npc, realm_id, clean_element):
			MainSceneHelpers._crown_population_push_unique_person(out, seen, npc)

	out.sort_custom(func (a, b):
		var a_npc: Person = a
		var b_npc: Person = b

		var a_mastery: int = 0
		var b_mastery: int = 0

		if typeof(a_npc.bending_mastery) == TYPE_DICTIONARY:
			a_mastery = int(a_npc.bending_mastery.get(clean_element, 0))
		if typeof(b_npc.bending_mastery) == TYPE_DICTIONARY:
			b_mastery = int(b_npc.bending_mastery.get(clean_element, 0))

		var a_score: int = a_mastery + int(a_npc.fame) + int(a_npc.respect)
		var b_score: int = b_mastery + int(b_npc.fame) + int(b_npc.respect)

		if bool(a_npc.is_ruler) or bool(a_npc.is_royal):
			a_score += 250
		if bool(b_npc.is_ruler) or bool(b_npc.is_royal):
			b_score += 250

		return a_score > b_score
	)

	return out.slice(0, min(32, out.size()))
func _person_civic_office_contract(person: Person) -> Dictionary:
	if person == null:
		return {}

	var raw_contract: Variant = person.get("civic_office_contract")
	if typeof(raw_contract) == TYPE_DICTIONARY:
		return (raw_contract as Dictionary).duplicate(true)

	return {}


func _person_uses_federal_republic_civic_title(person: Person, realm_id: int = -1) -> bool:
	if person == null:
		return false

	var office_contract: Dictionary = _person_civic_office_contract(person)
	var government_model: String = str(office_contract.get("government_model", "")).strip_edges().to_lower()

	if government_model in [
		"federal_presidential_republic",
		"federal_republic",
		"presidential_republic",
		"constitutional_republic"
	]:
		return true

	var civic_title: String = str(person.get("civic_title")).strip_edges()
	var job_key: String = str(person.job).strip_edges().to_lower()

	if civic_title != "" and realm_id > 0 and MainSceneLogic._crown_population_uses_federal_republic_lens(gs, realm_id):
		return true

	if job_key in [
		"president",
		"president of the united states",
		"first lady",
		"first gentleman",
		"vice president"
	]:
		return true

	return false


func _person_federal_republic_government_title(person: Person, realm_id: int = -1, social_class_surface: bool = false) -> String:
	if person == null:
		return ""

	if not _person_uses_federal_republic_civic_title(person, realm_id):
		return ""

	var office_contract: Dictionary = _person_civic_office_contract(person)
	var office_text: String = str(office_contract.get("office", "")).strip_edges()
	var full_title: String = str(office_contract.get("office_full_title", "")).strip_edges()
	var civic_title: String = str(person.get("civic_title")).strip_edges()
	var job_text: String = str(person.job).strip_edges()
	var job_key: String = job_text.to_lower()

	if office_text == "President" or civic_title == "President" or job_key == "president of the united states":
		return "President of The United States" if social_class_surface else "President"

	if office_text in ["First Lady", "First Gentleman"]:
		return office_text

	if civic_title in ["First Lady", "First Gentleman", "Vice President"]:
		return civic_title

	if full_title != "":
		if full_title.begins_with("The "):
			full_title = full_title.substr(4).strip_edges()
		if full_title == "President of the United States":
			return "President of The United States" if social_class_surface else "President"
		return full_title

	if civic_title != "":
		return civic_title

	if job_text != "":
		if job_key == "president of the united states":
			return "President of The United States" if social_class_surface else "President"
		return job_text

	return ""
func _crown_population_resolved_court_title(target: Person, realm_id: int = -1) -> String:
	if target == null:
		return ""

	if _person_uses_federal_republic_civic_title(target, realm_id):
		return _person_federal_republic_government_title(target, realm_id, false)

	var existing_title: String = str(target.royal_title).strip_edges()
	if existing_title != "":
		return MainSceneHelpers._crown_title_case(existing_title)

	var gender_text: String = str(target.gender).strip_edges().to_lower()
	var social_class: String = str(target.social_class).strip_edges()
	var social_key: String = social_class.to_lower()
	var succession_rank: int = int(target.succession_rank)

	if MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id):
		if gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
			var ruler_title: String = str(gs.royalty_engine.call("_resolve_rank_title", target, "ruler")).strip_edges()
			if ruler_title != "":
				return MainSceneHelpers._crown_title_case(ruler_title)
		return "Queen" if gender_text == "female" else "King"

	if bool(target.is_royal) or social_key == "royal":
		var rank_key: String = "royal_child"
		if succession_rank == 1:
			rank_key = "heir"

		if gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
			var resolved_royal_title: String = str(gs.royalty_engine.call("_resolve_rank_title", target, rank_key)).strip_edges()
			if resolved_royal_title != "":
				return MainSceneHelpers._crown_title_case(resolved_royal_title)

		if rank_key == "heir":
			return "Crown Princess" if gender_text == "female" else "Crown Prince"
		return "Princess" if gender_text == "female" else "Prince"

	var explicit_noble_title: String = MainSceneLogic._crown_population_noble_title_from_person(target, realm_id)
	if explicit_noble_title != "":
		return explicit_noble_title

	if social_key in [
		"noble",
		"nobility",
		"aristocrat",
		"aristocracy",
		"upper nobility",
		"high nobility"
	]:
		if succession_rank > 0 and succession_rank <= 8:
			if gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
				var resolved_ducal_title: String = str(gs.royalty_engine.call("_resolve_rank_title", target, "ducal_royal")).strip_edges()
				if resolved_ducal_title != "":
					return MainSceneHelpers._crown_title_case(resolved_ducal_title)
			return "Duchess" if gender_text == "female" else "Duke"

		if succession_rank > 8 and succession_rank <= 12:
			if gs != null and gs.royalty_engine != null and gs.royalty_engine.has_method("_resolve_rank_title"):
				var resolved_marcher_title: String = str(gs.royalty_engine.call("_resolve_rank_title", target, "marcher_royal")).strip_edges()
				if resolved_marcher_title != "":
					return MainSceneHelpers._crown_title_case(resolved_marcher_title)
			return "Marchioness" if gender_text == "female" else "Marquess"

		return "Lady" if gender_text == "female" else "Lord"

	return ""

func _is_crown_population_noble_court_member(target: Person, realm_id: int = -1) -> bool:
	if target == null or not target.alive:
		return false

	if MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id):
		return false

	var raw_title: String = str(target.royal_title).strip_edges()
	var raw_title_tier: String = MainSceneHelpers._crown_population_title_tier_from_text(raw_title)

	if raw_title_tier in ["ruler", "heir", "royal_child"]:
		return false

	var social_key: String = str(target.social_class).strip_edges().to_lower()

	if bool(target.is_royal) and social_key == "royal":
		return false

	if bool(target.is_royal) and int(target.succession_rank) > 0 and int(target.succession_rank) <= 6:
		return false

	var explicit_noble_title: String = MainSceneLogic._crown_population_noble_title_from_person(target, realm_id)
	if explicit_noble_title != "":
		return true

	var resolved_title: String = _crown_population_resolved_court_title(target, realm_id)
	var tier: String = MainSceneHelpers._crown_population_title_tier_from_text(resolved_title)

	if tier in ["ducal", "marcher", "lord"]:
		return true

	if social_key in [
		"noble",
		"nobility",
		"aristocrat",
		"aristocracy",
		"upper nobility",
		"high nobility",
		"high noble",
		"duke",
		"duchess",
		"ducal",
		"marquess",
		"marchioness",
		"lord",
		"lady"
	]:
		return true

	return false


func _is_crown_population_royal_court_member(target: Person, realm_id: int = -1) -> bool:
	if target == null or not target.alive:
		return false

	if MainSceneLogic._crown_population_is_throne_holder(gs, target, realm_id):
		return true

	if MainSceneLogic._crown_population_is_ruler_partner_card(gs, target, realm_id):
		return true

	if _is_crown_population_noble_court_member(target, realm_id):
		return false

	var social_key: String = str(target.social_class).strip_edges().to_lower()
	var job_key: String = str(target.job).strip_edges().to_lower()
	var resolved_title: String = _crown_population_resolved_court_title(target, realm_id)
	var tier: String = MainSceneHelpers._crown_population_title_tier_from_text(resolved_title)

	if tier in ["heir", "royal_child", "ruler"]:
		return true

	if int(target.succession_rank) > 0 and int(target.succession_rank) <= 6:
		return true

	if social_key in [
		"peasant",
		"commoner",
		"merchant",
		"trader",
		"artisan",
		"craftsman",
		"shopkeeper",
		"worker",
		"working class",
		"middle class",
		"bottom class",
		"low class",
		"lower class",
		"citizen",
		"civilian"
	]:
		return false

	for token in [
		"teacher",
		"farmer",
		"laborer",
		"servant",
		"merchant",
		"trader",
		"artisan",
		"shopkeeper",
		"blacksmith",
		"doctor",
		"lawyer",
		"engineer",
		"nurse"
	]:
		if job_key.find(token) >= 0:
			return false

	if bool(target.is_royal) and social_key == "royal":
		return true

	return false
func _is_crown_realm_official(npc: Person, realm_id: int) -> bool:
	if npc == null or not npc.alive:
		return false

	if not MainSceneLogic._crown_population_person_matches_realm(gs, npc, realm_id):
		return false

	if _is_crown_population_noble_court_member(npc, realm_id):
		return false

	var office_job: String = str(npc.job).strip_edges().to_lower()
	var has_official_job: bool = office_job in [
		"president",
		"prime minister",
		"governor",
		"mayor",
		"senator",
		"judge",
		"minister",
		"court official",
		"general",
		"chancellor",
		"secretary",
		"councilor",
		"councillor",
		"ambassador"
	]

	if bool(npc.is_ruler):
		return true
	if has_official_job:
		return true
	if _is_crown_population_royal_court_member(npc, realm_id):
		return true
	if (bool(npc.exiled) or bool(npc.deposed)) and not _is_crown_population_noble_court_member(npc, realm_id):
		return true

	return false


func _build_crown_government_official_label(npc: Person, realm_id: int) -> String:
	if npc == null:
		return "Official"

	if not _is_crown_realm_official(npc, realm_id):
		var fallback_job: String = str(npc.job).strip_edges()
		if fallback_job != "":
			return MainSceneHelpers._crown_title_case(fallback_job)
		var fallback_class: String = str(npc.social_class).strip_edges()
		if fallback_class != "":
			return fallback_class
		return "Resident"

	var government_style: String = "State"
	if gs != null and gs.realm_engine != null and gs.realm_engine.has_method("ensure_realm_defaults"):
		var realm: Dictionary = gs.realm_engine.ensure_realm_defaults(realm_id)
		if not realm.is_empty():
			government_style = str(realm.get("government_style", "State")).strip_edges()

	var royal_title: String = str(npc.royal_title).strip_edges()

	if bool(npc.is_ruler):
		if royal_title != "":
			return royal_title
		match government_style:
			"Monarchy":
				return "Sovereign"
			"Democracy":
				return "President"
			"Republic":
				return "Chancellor"
			"Dictatorship":
				return "Supreme Leader"
			"Communism":
				return "General Secretary"
			"Anarchy":
				return "Council Voice"
			_:
				return "Head of State"

	if royal_title != "":
		return royal_title

	if bool(npc.is_royal) or int(npc.succession_rank) > 0 or bool(npc.deposed) or bool(npc.exiled):
		match government_style:
			"Monarchy":
				return "Royal"
			"Democracy":
				return "State Dignitary"
			"Republic":
				return "State Dignitary"
			"Dictatorship":
				return "Regime Insider"
			"Communism":
				return "Party Insider"
			"Anarchy":
				return "Council Member"
			_:
				return "State Official"

	var office_job: String = str(npc.job).strip_edges()
	if office_job != "":
		return MainSceneHelpers._crown_title_case(office_job)

	match government_style:
		"Monarchy":
			return "Court Official"
		"Democracy":
			return "Cabinet Official"
		"Republic":
			return "Republic Official"
		"Dictatorship":
			return "State Official"
		"Communism":
			return "Party Official"
		"Anarchy":
			return "Council Official"
		_:
			return "Official"


func _build_crown_realm_official_targets(realm_id: int) -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	if gs == null or realm_id <= 0:
		return out

	var ruler_id: int = -1
	if gs.realm_engine != null and gs.realm_engine.realms.has(realm_id):
		var realm_raw: Variant = gs.realm_engine.realms.get(realm_id, {})
		var realm: Dictionary = realm_raw if typeof(realm_raw) == TYPE_DICTIONARY else {}
		ruler_id = int(realm.get("ruler_id", -1))

	var _push_official = func (npc: Person) -> void:
		if npc == null or not npc.alive:
			return

		var npc_id: int = int(npc.id)
		if npc_id <= 0 or seen.has(npc_id):
			return

		if not _is_crown_realm_official(npc, realm_id):
			return

		out.append(npc)
		seen [npc_id] = true

	if gs.player != null:
		_push_official.call(gs.player)

	if ruler_id > 0:
		_push_official.call(MainSceneLogic._find_active_crown_person_by_id(gs, ruler_id))

	if gs.universal_faction_engine != null and gs.universal_faction_engine.has_method("get_realm_court_member_ids"):
		var court_ids: Array = gs.universal_faction_engine.get_realm_court_member_ids(realm_id)
		for raw_member_id in court_ids:
			var npc_id: int = int(raw_member_id)
			if npc_id <= 0 or seen.has(npc_id):
				continue

			_push_official.call(MainSceneLogic._find_active_crown_person_by_id(gs, npc_id))

	for raw_npc in gs.npcs:
		var npc: Person = raw_npc
		_push_official.call(npc)

	out.sort_custom(func (a, b):
		var a_npc: Person = a
		var b_npc: Person = b

		var a_priority: int = 4
		var b_priority: int = 4

		if bool(a_npc.is_ruler):
			a_priority = 0
		elif bool(a_npc.is_royal) or int(a_npc.succession_rank) > 0:
			a_priority = 1
		elif str(a_npc.job).strip_edges() != "":
			a_priority = 2

		if bool(b_npc.is_ruler):
			b_priority = 0
		elif bool(b_npc.is_royal) or int(b_npc.succession_rank) > 0:
			b_priority = 1
		elif str(b_npc.job).strip_edges() != "":
			b_priority = 2

		if a_priority != b_priority:
			return a_priority < b_priority

		return int(a_npc.age) > int(b_npc.age)
	)

	return out.slice(0, min(32, out.size()))
func _build_crown_realm_noble_targets(realm_id: int, seeded_people: Array = [], seeded_officials: Array = []) -> Array:
	var out: Array = []
	var seen: Dictionary = {}

	if gs == null or realm_id <= 0:
		return out

	for raw_official in seeded_officials:
		var official: Person = raw_official
		if official != null and MainSceneLogic._crown_population_person_matches_realm(gs, official, realm_id) and _is_crown_population_noble_court_member(official, realm_id):
			MainSceneHelpers._crown_population_push_unique_person(out, seen, official)

	for raw_seed in seeded_people:
		var seeded: Person = raw_seed
		if seeded != null and MainSceneLogic._crown_population_person_matches_realm(gs, seeded, realm_id) and _is_crown_population_noble_court_member(seeded, realm_id):
			MainSceneHelpers._crown_population_push_unique_person(out, seen, seeded)

	if gs.player != null and MainSceneLogic._crown_population_person_matches_realm(gs, gs.player, realm_id) and _is_crown_population_noble_court_member(gs.player, realm_id):
		MainSceneHelpers._crown_population_push_unique_person(out, seen, gs.player)

	for raw_npc in gs.npcs:
		var npc: Person = raw_npc
		if npc != null and MainSceneLogic._crown_population_person_matches_realm(gs, npc, realm_id) and _is_crown_population_noble_court_member(npc, realm_id):
			MainSceneHelpers._crown_population_push_unique_person(out, seen, npc)

	out.sort_custom(func (a, b):
		var a_npc: Person = a
		var b_npc: Person = b

		var a_title: String = _crown_population_resolved_court_title(a_npc, realm_id)
		var b_title: String = _crown_population_resolved_court_title(b_npc, realm_id)
		var a_tier: String = MainSceneHelpers._crown_population_title_tier_from_text(a_title)
		var b_tier: String = MainSceneHelpers._crown_population_title_tier_from_text(b_title)

		var tier_weight:= {
			"ducal": 3600,
			"marcher": 3000,
			"lord": 2200
		}

		var a_succession_pressure: int = 0
		var b_succession_pressure: int = 0

		if int(a_npc.succession_rank) > 0 and int(a_npc.succession_rank) <= 20:
			a_succession_pressure = max(0, 600 - int(a_npc.succession_rank) * 24)

		if int(b_npc.succession_rank) > 0 and int(b_npc.succession_rank) <= 20:
			b_succession_pressure = max(0, 600 - int(b_npc.succession_rank) * 24)

		var a_score: int = int(tier_weight.get(a_tier, 1400)) + a_succession_pressure + int(a_npc.fame) + int(a_npc.respect) + int(a_npc.age)
		var b_score: int = int(tier_weight.get(b_tier, 1400)) + b_succession_pressure + int(b_npc.fame) + int(b_npc.respect) + int(b_npc.age)

		return a_score > b_score
	)

	return out.slice(0, min(160, out.size()))
func _crown_population_citizen_strata_key(target: Person, realm_id: int, realm_name: String = "") -> String:
	if target == null:
		return "commoner"

	var social_key: String = str(target.social_class).strip_edges().to_lower()
	var job_key: String = str(target.job).strip_edges().to_lower()
	var modern_lens: bool = MainSceneLogic._crown_population_uses_modern_class_lens(gs, realm_id, realm_name)

	if modern_lens:
		if social_key in ["elite", "ultra elite", "ruling elite", "old money", "billionaire", "one percent", "1%", "rich"] \
or int(target.bank_balance) >= 10000000 \
or int(target.fame) >= 90:
			return "elite"

		if social_key in ["upper middle class", "upper-middle class", "upper class", "upperclass", "wealthy"] \
or int(target.bank_balance) >= 1000000:
			return "upper_middle_class"

		if social_key in ["middle class", "middle-class", "professional"] \
or job_key in ["teacher", "doctor", "lawyer", "engineer", "manager", "accountant", "nurse", "developer"]:
			return "middle_class"

		if social_key in ["lower middle class", "lower-middle class", "working class", "working-class", "commoner", "merchant", "trader", "worker"] \
or int(target.bank_balance) >= 25000:
			return "lower_middle_class"

		return "bottom_class"

	if social_key in ["slave", "serf", "peasant", "lowborn", "lower class", "low class"] \
or job_key in ["farmer", "farmhand", "laborer", "servant", "miner", "fisher", "fisherman", "maid"]:
		return "peasant"

	if social_key in ["merchant", "trader", "artisan", "craftsman", "shopkeeper"] \
or job_key.find("merchant") >= 0 \
or job_key.find("trader") >= 0 \
or job_key.find("artisan") >= 0 \
or job_key.find("shopkeeper") >= 0 \
or job_key.find("blacksmith") >= 0:
		return "merchant"

	return "commoner"


func _build_crown_population_citizen_strata(citizens: Array, realm_id: int, realm_name: String = "") -> Dictionary:
	var strata: Dictionary = {}

	for key in MainSceneLogic._crown_population_citizen_strata_order(gs, realm_id, realm_name):
		strata [key] = []

	for raw_citizen in citizens:
		if raw_citizen == null:
			continue

		if not (raw_citizen is Person):
			continue

		var citizen: Person = raw_citizen as Person
		if citizen == null or not citizen.alive:
			continue

		if _is_crown_population_noble_court_member(citizen, realm_id):
			continue

		if _is_crown_population_royal_court_member(citizen, realm_id):
			continue

		var strata_key: String = _crown_population_citizen_strata_key(citizen, realm_id, realm_name)
		if not strata.has(strata_key):
			strata [strata_key] = []

		var bucket: Array = strata.get(strata_key, [])
		bucket.append(citizen)
		strata [strata_key] = bucket

	if MainSceneLogic._crown_population_uses_modern_class_lens(gs, realm_id, realm_name):
		var upper_middle: Array = strata.get("upper_middle_class", [])
		var middle: Array = strata.get("middle_class", [])
		var lower_middle: Array = strata.get("lower_middle_class", [])

		if upper_middle.is_empty():
			var promoted_visual_candidate: Person = null
			var promoted_source_key: String = ""

			if not middle.is_empty():
				middle.sort_custom(func (a, b):
					return int((a as Person).bank_balance) > int((b as Person).bank_balance)
				)
				promoted_visual_candidate = middle.pop_front()
				promoted_source_key = "middle_class"
			elif not lower_middle.is_empty():
				lower_middle.sort_custom(func (a, b):
					return int((a as Person).bank_balance) > int((b as Person).bank_balance)
				)
				promoted_visual_candidate = lower_middle.pop_front()
				promoted_source_key = "lower_middle_class"

			if promoted_visual_candidate != null:
				upper_middle.append(promoted_visual_candidate)
				strata ["upper_middle_class"] = upper_middle

				if promoted_source_key == "middle_class":
					strata ["middle_class"] = middle
				elif promoted_source_key == "lower_middle_class":
					strata ["lower_middle_class"] = lower_middle

	return strata

func _append_crown_population_citizen_strata_sections(root: Control, citizens: Array, realm_id: int, realm_name: String, accent: Color, element: String = "") -> void:
	var strata: Dictionary = _build_crown_population_citizen_strata(citizens, realm_id, realm_name)
	var rendered_any: bool = false
	var modern_lens: bool = MainSceneLogic._crown_population_uses_modern_class_lens(gs, realm_id, realm_name)

	for raw_key in MainSceneLogic._crown_population_citizen_strata_order(gs, realm_id, realm_name):
		var key: String = str(raw_key)
		var people: Array = strata.get(key, [])

		if people.is_empty() and not modern_lens:
			continue

		rendered_any = true

		var stratum_accent: Color = MainSceneHelpers._crown_population_citizen_strata_accent_color(key, accent)
		_append_crown_population_section(
			root,
			MainSceneHelpers._crown_population_citizen_strata_title(key),
			MainSceneHelpers._crown_population_citizen_strata_subtitle(key),
			people,
			realm_id,
			"citizen",
			stratum_accent,
			0.1,
			element
		)

	if not rendered_any:
		_append_crown_population_section(
			root,
			"REGULAR CITIZENS",
			"No non-court citizens are currently visible in this realm lens.",
			[],
			realm_id,
			"citizen",
			accent,
			0.1,
			element
		)
func _open_crown_population_profile(target_id: int) -> void:
	if gs == null or target_id <= 0:
		return
	var target: Person = gs.get_or_reactivate_npc_by_id(target_id)
	if target == null or not target.alive:
		return
	relationship_profile_return_context = "crown_hub"
	_hide_crown_action_popup()
	if crown_hub_overlay != null:
		crown_hub_overlay.visible = false
	crown_hub_open = false
	_show_relationship_profile_popup(target)
func _set_crown_realm_relation_delta(
	target_realm_id: int,
	delta: int
) -> void:
	if (
		gs == null
		or gs.player == null
	):
		return

	if typeof(
		gs.scenario_state
	) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	var raw_store: Variant = gs.scenario_state.get(
		"crown_realm_relations",
		{}
	)

	var store: Dictionary = (
		raw_store
		if typeof(raw_store) == TYPE_DICTIONARY
		else {}
	)

	var key: String = (
		"%d:%d"
		% [
			int(
				gs.player.realm_id
			),
			int(
				target_realm_id
			)
		]
	)

	store [
		key
	] = clampi(
		int(
			store.get(
				key,
				0
			)
		) + delta,
		-100,
		100
	)

	gs.scenario_state [
		"crown_realm_relations"
	] = store
