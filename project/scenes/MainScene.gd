		_crime_panel_observer_bind_truth(
			"surface_stage_refused_unadopted_game_state",
			{
				"staged_actor_id": int(
					staged_gs.player.id
				),
				"staged_game_state_instance_id": (
					staged_gs.get_instance_id()
				),
