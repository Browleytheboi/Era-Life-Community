	stat_box.name = "HouseholdCreatorStatBars"
	stat_box.add_theme_constant_override("separation", 12)
	body.add_child(stat_box)

	for stat_key in ["health", "smarts", "looks", "imagination", "mental_health"]:
		_household_creator_add_stat_bar(stat_box, stat_key, int(existing_stats.get(stat_key, 75)))

