func _belonging_popup_safe_dictionary(value: Variant) -> Dictionary:
	if typeof(value) == TYPE_DICTIONARY:
		return (value as Dictionary).duplicate(true)
	return {}
func _belonging_popup_shenron_action_spec(item: Dictionary, category: String) -> Dictionary:
	if gs == null or gs.player == null:
		return {}
	if gs.belongings_engine == null:
		return {}
	if not gs.belongings_engine.has_method("get_inventory_rows_for_actor"):
		return {}

	var target_item_id: String = str(item.get("id", "")).strip_edges()
	var target_name: String = str(item.get("name", item.get("display_name", ""))).strip_edges().to_lower()
	var target_category: String = str(category).strip_edges().to_lower()

	var rows: Array = gs.belongings_engine.get_inventory_rows_for_actor(gs.player, {
		"source": "mainscene.belonging_item_popup",
		"action_surface": "item_detail_popup"
	})

	for raw_row in rows:
		if typeof(raw_row) != TYPE_DICTIONARY:
			continue

		var row: Dictionary = raw_row
		if str(row.get("kind", "")).strip_edges().to_lower() != "inventory_item":
			continue

		var row_category: String = str(row.get("category", "")).strip_edges().to_lower()
		if target_category != "" and row_category != target_category:
			continue

		var row_item: Dictionary = _belonging_popup_safe_dictionary(row.get("item", {}))
		var row_item_id: String = str(row.get("item_id", row_item.get("id", ""))).strip_edges()
		var row_name: String = str(row_item.get("name", row_item.get("display_name", ""))).strip_edges().to_lower()

		var same_item: bool = false
		if target_item_id != "" and row_item_id == target_item_id:
			same_item = true
		elif target_item_id == "" and target_name != "" and row_name == target_name:
			same_item = true

		if not same_item:
			continue

		var actions_raw: Variant = row.get("actions", [])
		if typeof(actions_raw) != TYPE_ARRAY:
			continue

		for raw_action in actions_raw:
			if typeof(raw_action) != TYPE_DICTIONARY:
				continue

			var action: Dictionary = raw_action
			var engine_property: String = str(action.get("engine_property", "")).strip_edges()
			var method_name: String = str(action.get("method", "")).strip_edges()

			if engine_property == "dragonballs_engine" and method_name == "summon_shenron":
				return action.duplicate(true)

	return {}
func _belonging_popup_action_routes_to_crime_hub(
	action_spec: Dictionary
) -> bool:
	var engine_property: String = str(
		action_spec.get(
			"engine_property",
			""
		)
	).strip_edges().to_lower()
	var method_name: String = str(
		action_spec.get(
			"method",
			""
		)
	).strip_edges().to_lower()
	var payload: Dictionary = MainSceneHelpers._safe_dictionary(
		action_spec.get(
			"payload",
			{}
		)
	)
	var action_id: String = str(
		payload.get(
			"action_id",
			action_spec.get(
				"id",
				""
			)
		)
	).strip_edges().to_lower()

	return (
		engine_property == "crime_hub_contract_engine"
		and method_name == "resolve_intent"
		and action_id in [
			"begin_weapon_action",
			"choose_weapon_target",
			"commit_weapon_action"
		]
	)
