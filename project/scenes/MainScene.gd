func _bind_crime_panel_event_bus_observation() -> bool:
	if (
		gs == null
		or gs.event_bus == null
	):
		_crime_panel_observer_bind_truth(
			"crime_event_bus_observer_unavailable",
			{
				"game_state_present": (
					gs != null
				),
				"event_bus_present": (
					gs != null
					and gs.event_bus != null
				)
			}
		)

		return false

	gs.event_bus.subscribe(
		"crime.hub.resident_section_contract.published",
