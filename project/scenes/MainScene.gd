func _apply_main_tab_press_frame_nav_state(
	active_panel: String,
	reason: String = "main_tab_press"
) -> void:
	var clean_panel: String = str(
		active_panel
	).strip_edges().to_lower()
	var now_ms: int = int(
		Time.get_ticks_msec()
	)
	var full_surface_owns_frame: bool = (
		clean_panel in [
			"world",
			"relationships",
			"school",
			"career",
			"activities",
			"mods",
			"crime"
		]
	)




	if clean_panel == "mods":
		full_surface_owns_frame = (
			(
				mod_menu_panel != null
				and is_instance_valid(
					mod_menu_panel
				)
				and mod_menu_panel.is_visible_in_tree()
			)
			or (
				mod_bundle_menu_panel != null
				and is_instance_valid(
					mod_bundle_menu_panel
				)
				and mod_bundle_menu_panel.is_visible_in_tree()
			)
		)






	var presentation: Dictionary = (
		_active_reality_presentation_contract()
	)
	var navigation_visibility: Dictionary = MainSceneHelpers._safe_dictionary(
		presentation.get(
			"navigation_visibility",
			{}
		)
	)
	var visible_navigation_count: int = 0




	set_meta(
		"main_tab_press_frame_nav_state_visual_only",
		true
	)
	set_meta(
		"main_tab_press_frame_nav_state_did_not_rebind_buttons",
		true
	)
	set_meta(
		"main_tab_press_frame_nav_state_started_present_fence",
		false
	)
	set_meta(
		"main_tab_refresh_may_not_restart_present_fence",
		true
	)
	set_meta(
		"main_tab_press_frame_nav_state_reason",
		reason
	)
	set_meta(
		"main_tab_press_frame_nav_state_at_ms",
		now_ms
	)
	set_meta(
		"main_tab_full_surface_owns_frame",
		full_surface_owns_frame
	)
	set_meta(
		"main_tab_global_navigation_embedded_in_surface",
		false
	)
	set_meta(
		"main_tab_full_surface_may_hide_navigation",
		false
	)
	set_meta(
		"main_tab_navigation_visibility_authority",
		"active_reality_presentation_contract"
	)

	for key in ui_nav_buttons.keys():
		var button: Button = (
			ui_nav_buttons.get(
				key,
				null
			) as Button
		)

		if (
			button == null
			or not is_instance_valid(
				button
			)
		):
			continue

		var locked: bool = (
			_god_mode_ui_locked()
			or (
				_standard_tabs_locked()
				and str(
					key
				) != "age_up"
			)
		)
		var button_visible: bool = bool(
			navigation_visibility.get(
				str(
					key
				),
				true
			)
		)
		var button_disabled: bool = (
			locked
			or not button_visible
		)

		button.visible = button_visible
		button.disabled = button_disabled
		button.mouse_filter = (
			Control.MOUSE_FILTER_IGNORE
			if button_disabled
			else Control.MOUSE_FILTER_STOP
		)
		button.focus_mode = Control.FOCUS_NONE
		button.process_mode = (
			Node.PROCESS_MODE_INHERIT
			if button_visible
			else Node.PROCESS_MODE_DISABLED
		)

		if button_visible:
			visible_navigation_count += 1

		if (
			button_visible
			and str(
				key
			) == clean_panel
			and str(
				key
			) != "age_up"
			and not locked
		):
			button.modulate = Color(
				1.0,
				1.0,
				1.0,
				1.0
			)
			button.scale = Vector2.ONE
			button.set_meta(
				"main_tab_press_frame_active",
				true
			)
		else:
			button.set_meta(
				"main_tab_press_frame_active",
				false
			)

		button.set_meta(
			"main_tab_press_frame_nav_committed",
			true
		)
		button.set_meta(
			"main_tab_press_frame_reason",
			reason
		)
		button.set_meta(
			"main_tab_press_frame_at_ms",
			now_ms
		)
		button.set_meta(
			"main_tab_hidden_for_full_surface_sovereignty",
			false
		)
		button.set_meta(
			"main_tab_hidden_by_authoritative_navigation_contract",
			not button_visible
		)
		button.set_meta(
			"main_tab_full_surface_preserved_navigation_shell",
			full_surface_owns_frame
		)

	var global_navigation_visible: bool = (
		visible_navigation_count > 0
	)

	set_meta(
		"main_tab_global_navigation_visible",
		global_navigation_visible
	)
	set_meta(
		"main_tab_global_navigation_visible_count",
		visible_navigation_count
	)

	if (
		gs != null
		and typeof(
			gs.scenario_state
		) == TYPE_DICTIONARY
	):
		gs.scenario_state [
			"main_tab_press_frame_nav_state_visual_only"
		] = true
		gs.scenario_state [
			"main_tab_press_frame_nav_state_did_not_rebind_buttons"
		] = true
		gs.scenario_state [
			"main_tab_press_frame_nav_state_started_present_fence"
		] = false
		gs.scenario_state [
			"main_tab_refresh_may_not_restart_present_fence"
		] = true
		gs.scenario_state [
			"main_tab_press_frame_nav_state_reason"
		] = reason
		gs.scenario_state [
			"main_tab_full_surface_owns_frame"
		] = full_surface_owns_frame
		gs.scenario_state [
			"main_tab_global_navigation_visible"
		] = global_navigation_visible
		gs.scenario_state [
			"main_tab_global_navigation_visible_count"
		] = visible_navigation_count
		gs.scenario_state [
			"main_tab_global_navigation_embedded_in_surface"
		] = false
		gs.scenario_state [
			"main_tab_full_surface_may_hide_navigation"
		] = false
		gs.scenario_state [
			"main_tab_navigation_visibility_authority"
		] = "active_reality_presentation_contract"
