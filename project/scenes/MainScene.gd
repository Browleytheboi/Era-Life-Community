func _schedule_saved_life_residency_observation(
	path: String,
	load_options: Dictionary
) -> void:
	var clean_path: String = str(
		path
	).strip_edges()

	if clean_path == "":
		return

	var next_options: Dictionary = (
		load_options.duplicate(false)
	)
	var signature: String = str(
		next_options.get(
			"residency_signature",
			""
		)
	).strip_edges()
	var observation_key: String = (
		"%s|%s"
		% [
			clean_path,
			signature
		]
	)
	var replacement_index: int = -1

	if saved_life_residency_observation_keys.has(
		observation_key
	):
		for index in range(
			saved_life_residency_observation_queue.size()
		):
			var row_raw: Variant = (
				saved_life_residency_observation_queue [index]
			)

			if typeof(row_raw) != TYPE_DICTIONARY:
				continue

			var row: Dictionary = row_raw as Dictionary

			if str(
				row.get(
					"observation_key",
					""
				)
			) == observation_key:
				replacement_index = index
				break

	var observation_row: Dictionary = {
		"observation_key": observation_key,
		"path": clean_path,
		"load_options": next_options,
		"queued_at_ms": int(
			Time.get_ticks_msec()
		),
	}

	if replacement_index >= 0:
		saved_life_residency_observation_queue [
			replacement_index
		] = observation_row
	else:
		saved_life_residency_observation_queue.append(
			observation_row
		)
		saved_life_residency_observation_keys [
			observation_key
		] = true

	set_meta(
		"saved_life_residency_observation_queue_size",
		saved_life_residency_observation_queue.size()
	)
	set_meta(
		"saved_life_residency_observation_signal_bound_to_payload",
		false
	)
	set_meta(
		"saved_life_residency_observation_deduplicated",
		true
	)

	_arm_saved_life_residency_observation_service()
func _arm_saved_life_residency_observation_service() -> void:
	if saved_life_residency_observation_service_armed:
		return

	if saved_life_residency_observation_queue.is_empty():
		return

	var tree:= get_tree()

	if tree == null:
		call_deferred(
			"_service_saved_life_residency_observation_queue"
		)
		return

	var service_callable:= Callable(
		self,
		"_service_saved_life_residency_observation_queue"
	)

	if tree.process_frame.is_connected(
		service_callable
	):
		saved_life_residency_observation_service_armed = true
		return

	saved_life_residency_observation_service_armed = true

	tree.process_frame.connect(
		service_callable,
		CONNECT_ONE_SHOT
	)
func _service_saved_life_residency_observation_queue() -> void:
	saved_life_residency_observation_service_armed = false

	if saved_life_residency_observation_queue.is_empty():
		return

	# FIX: this re-ran the ENTIRE load path on every process_frame while waiting for
	# the checkpoint's contracts to become ready -- reservation, status query and
	# dozens of meta writes, roughly 12,000 times over a 200-second load. That work
	# competes with the staged surface publication it is waiting for, which is why the
	# window stopped responding while the log showed publication still crawling
	# forward. Retry on a fixed interval instead; the publication needs the frames
	# more than the poller does.
	var now_ms: int = int(Time.get_ticks_msec())
	var last_service_ms: int = int(
		get_meta("saved_life_residency_observation_last_service_ms", 0)
	)

	if now_ms - last_service_ms < SAVED_LIFE_RESIDENCY_OBSERVATION_INTERVAL_MS:
		_arm_saved_life_residency_observation_service()
		return

	set_meta("saved_life_residency_observation_last_service_ms", now_ms)

	var row_raw: Variant = (
		saved_life_residency_observation_queue.pop_front()
	)

	if typeof(row_raw) != TYPE_DICTIONARY:
		if not saved_life_residency_observation_queue.is_empty():
			call_deferred(
				"_arm_saved_life_residency_observation_service"
			)
		return

	var row: Dictionary = row_raw as Dictionary
	var observation_key: String = str(
		row.get(
			"observation_key",
			""
		)
	)

	if observation_key != "":
		saved_life_residency_observation_keys.erase(
			observation_key
		)

	var clean_path: String = str(
		row.get(
			"path",
			""
		)
	).strip_edges()
	var options_raw: Variant = row.get(
		"load_options",
		{}
	)
	var next_options: Dictionary = (
		(options_raw as Dictionary).duplicate(false)
		if typeof(options_raw) == TYPE_DICTIONARY
		else {}
	)



	if clean_path != "":
		call_deferred(
			"_load_life_from_slot_deferred",
			clean_path,
			next_options
		)

	set_meta(
		"saved_life_residency_observation_queue_size",
		saved_life_residency_observation_queue.size()
	)
	set_meta(
		"saved_life_residency_observation_last_serviced_at_ms",
		int(
			Time.get_ticks_msec()
		)
	)

	if not saved_life_residency_observation_queue.is_empty():
		call_deferred(
			"_arm_saved_life_residency_observation_service"
		)
func _apply_reality_fusion_entered_player_if_needed(path: String, load_report: Dictionary) -> void:
	if gs == null:
		return
	if not has_meta("reality_fusion_entering_player_snapshot"):
		return

	var snapshot_raw: Variant = get_meta("reality_fusion_entering_player_snapshot")
	var snapshot: Dictionary = snapshot_raw if typeof(snapshot_raw) == TYPE_DICTIONARY else {}
	if snapshot.is_empty():
		remove_meta("reality_fusion_entering_player_snapshot")
		return

	var target_label: String = str(get_meta("reality_fusion_entering_universe_label", "another universe")).strip_edges()
	if target_label == "":
		target_label = "another universe"

	var source_mode: String = str(get_meta("reality_fusion_entering_source_mode", "unknown")).strip_edges()
	var target_mode: String = "unknown"
	if gs.has_method("get_reality_mode"):
		target_mode = str(gs.get_reality_mode())

	var entering_player: Person = null
	if gs.has_method("_deserialize_npc"):
		entering_player = gs.call("_deserialize_npc", snapshot)
	else:
		entering_player = Person.new()
		for prop in entering_player.get_property_list():
			var prop_name: String = str(prop.name)
			if snapshot.has(prop_name):
				entering_player.set(prop_name, snapshot [prop_name])

	if entering_player == null:
		remove_meta("reality_fusion_entering_player_snapshot")
		return

	var original_id: int = int(entering_player.id)
	var id_collision: bool = false
	if gs.has_method("get_npc_by_id") and original_id > 0:
		id_collision = gs.get_npc_by_id(original_id) != null

	if original_id <= 0 or id_collision:
		gs.next_id += 1
		entering_player.id = gs.next_id

	entering_player.alive = true
	entering_player.health = max(1, float(entering_player.health))

	var person_contract_slice_raw: Variant = snapshot.get("person_contract_slice", {})
	if typeof(person_contract_slice_raw) == TYPE_DICTIONARY and entering_player.has_method("import_contract_slice"):
		entering_player.call("import_contract_slice", person_contract_slice_raw as Dictionary, {
			"source": "reality_fusion_entered_universe",
			"path": str(path).strip_edges(),
			"label": target_label,
			"source_reality_mode": source_mode,
			"target_reality_mode": target_mode,
			"original_player_id": original_id,
		})
	elif entering_player.has_method("ensure_person_contract"):
		entering_player.call("ensure_person_contract", {
			"source": "reality_fusion_entered_universe_legacy",
			"path": str(path).strip_edges(),
			"label": target_label,
			"source_reality_mode": source_mode,
			"target_reality_mode": target_mode,
			"original_player_id": original_id
		})

	if "reality_fusion_identity" in entering_player and typeof(entering_player.reality_fusion_identity) == TYPE_DICTIONARY:
		var fusion_identity: Dictionary = entering_player.reality_fusion_identity.duplicate(true)
		var fusion_history: Array = fusion_identity.get("fusion_history", []) if typeof(fusion_identity.get("fusion_history", [])) == TYPE_ARRAY else []
		fusion_history.append({
			"path": str(path).strip_edges(),
			"label": target_label,
			"source_mode": source_mode,
			"target_mode": target_mode,
			"original_player_id": original_id,
			"entered_at_ms": int(Time.get_ticks_msec())
		})
		while fusion_history.size() > 80:
			fusion_history.pop_front()

		fusion_identity ["original_person_id"] = original_id
		fusion_identity ["current_universe_label"] = target_label
		fusion_identity ["foreign_universe_count"] = int(fusion_identity.get("foreign_universe_count", 0)) + 1
		fusion_identity ["fusion_history"] = fusion_history
		fusion_identity ["last_fusion_ms"] = int(Time.get_ticks_msec())
		entering_player.reality_fusion_identity = fusion_identity

	if "world_law_residue" in entering_player and typeof(entering_player.world_law_residue) == TYPE_DICTIONARY:
		var law_residue: Dictionary = entering_player.world_law_residue.duplicate(true)
		var entered_world_ids: Array = law_residue.get("entered_world_ids", []) if typeof(law_residue.get("entered_world_ids", [])) == TYPE_ARRAY else []
		if not entered_world_ids.has(str(path).strip_edges()):
			entered_world_ids.append(str(path).strip_edges())
		law_residue ["entered_world_ids"] = entered_world_ids
		law_residue ["source_reality_mode"] = source_mode
		law_residue ["target_reality_mode"] = target_mode
		law_residue ["last_entered_label"] = target_label
		law_residue ["last_entered_at_ms"] = int(Time.get_ticks_msec())
		entering_player.world_law_residue = law_residue

	if typeof(entering_player.identity_residue) == TYPE_DICTIONARY:
		entering_player.identity_residue ["entered_foreign_universe"] = {
			"path": str(path).strip_edges(),
			"label": target_label,
			"source_mode": source_mode,
			"target_mode": target_mode,
			"original_player_id": original_id,
			"created_at_ms": int(Time.get_ticks_msec())
		}

	if entering_player not in gs.npcs:
		gs.npcs.append(entering_player)

	gs.player = entering_player
	gs.player_id = int(entering_player.id)

	if gs.has_method("_rebuild_npc_index"):
		gs.call("_rebuild_npc_index")

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["reality_fusion_entered_universe"] = {
		"path": str(path).strip_edges(),
		"label": target_label,
		"source_mode": source_mode,
		"target_mode": target_mode,
		"mode_mismatch": source_mode != target_mode,
		"load_report": load_report.duplicate(true),
		"created_at_ms": int(Time.get_ticks_msec())
	}

	var mode_note: String = ""
	if source_mode != target_mode:
		mode_note = " The rules do not match their original reality mode."

	if gs.has_method("push_world_feed"):
		gs.push_world_feed("%s entered %s through a Reality Fusion breach.%s" % [
			("%s %s" % [str(entering_player.first_name), str(entering_player.last_name)]).strip_edges(),
			target_label,
			mode_note
		], {
			"category": "reality_fusion",
			"event_name": "entered_foreign_universe",
			"personally_relevant": true,
			"source": "main_scene",
			"source_mode": source_mode,
			"target_mode": target_mode
		})

	remove_meta("reality_fusion_entering_player_snapshot")
	remove_meta("reality_fusion_entering_universe_path")
	remove_meta("reality_fusion_entering_universe_label")
	remove_meta("reality_fusion_entering_source_mode")
func _attach_restored_reality_after_load() -> void:
	# Pick whichever resident record the load left behind and attach it. Normal boot
	# attaches through RealityResidencyContractEngine's "attach" command; the load
	# path never did, which is why a loaded save sat unattached forever.
	if gs == null or gs.reality_residency_manager == null:
		return

	var manager = gs.reality_residency_manager

	if not manager.has_method("attach_reality"):
		return

	if str(manager.attached_signature).strip_edges() != "":
		EraLog.truth("ERALIFE_LOAD_ATTACH|skipped=already_attached")
		return

	var records: Dictionary = manager.resident_records

	if typeof(records) != TYPE_DICTIONARY or records.is_empty():
		EraLog.truth("ERALIFE_LOAD_ATTACH|failed=no_resident_records")
		return

	var chosen_signature: String = ""

	for raw_signature in records.keys():
		var candidate: String = str(raw_signature).strip_edges()
		if candidate == "":
			continue
		chosen_signature = candidate
		break

	if chosen_signature == "":
		EraLog.truth("ERALIFE_LOAD_ATTACH|failed=no_usable_signature")
		return

	# A record restored from disk cannot carry runtime_ref -- it is a live object
	# reference, so serialisation drops it. attach_reality() rejects the record with
	# "resident_runtime_reference_missing", which is exactly the
	# first_false_gate=resident_runtime_exists in the residency truth line. Put the
	# live GameState back on the record before attaching.
	var restored_record: Dictionary = records [chosen_signature]

	if typeof(restored_record) == TYPE_DICTIONARY:
		if not (restored_record.get("runtime_ref", null) is GameState):
			restored_record ["runtime_ref"] = gs
			records [chosen_signature] = restored_record
			manager.resident_records = records

	var attach_report: Dictionary = MainSceneHelpers._safe_dictionary(
		manager.attach_reality(
			chosen_signature,
			{
				"source": "mainscene.load_saved_life",
				"ui_is_renderer_only": true
			}
		)
	)

	EraLog.truth(
		"ERALIFE_LOAD_ATTACH|signature=%s|success=%s|attached_now=%s"
		% [
			chosen_signature,
			str(attach_report.get("success", false)),
			str(manager.attached_signature)
		]
	)


func _load_saved_life_playable_first(path: String, extra_options: Dictionary = {}) -> Dictionary:
	# DIAGNOSTIC: ERALIFE_LOAD_ATTACH never appears, so the load is not reaching the
	# hydration branch where the attach was added. This function has three exits --
	# boot_contract, hydration runtime, and the legacy gs.load_game() fallback -- so
	# report which one actually runs.
	EraLog.truth(
		"ERALIFE_LOAD_ENTRY|path=%s|has_boot_contract=%s|has_hydration_runtime=%s"
		% [
			str(path),
			str(extra_options.has("boot_contract")),
			str(gs != null and "game_state_hydration_runtime" in gs)
		]
	)

	var clean_path: String = str(path).strip_edges()
	if clean_path == "":
		return {
			"success": false,
			"reason": "That save slot does not point to a file."
		}

	if gs == null:
		return {
			"success": false,
			"reason": "GameState is unavailable."
		}

	if not FileAccess.file_exists(clean_path):
		return {
			"success": false,
			"reason": "That save file is missing.",
			"path": clean_path
		}

	var load_options: Dictionary = {
		"source": "saved_lineage_picker",
		"load_mode": "playable_first",
		"profile": "zero_frame_local_life_packet",
		"background_enabled": true,
		"playable_npc_limit": 8,
		"npc_chunk_cap": 4,
		"partner_chunk_cap": 8,
		"consciousness_chunk_cap": 2,
		"defer_consciousness_repair": true,
		"apply_runtime_guards": true,
		"preserve_unknown_slices": true,
		"contract_driven_existence": true,
		"deferred_reality": true,
		"buffered_intention": true,
		"live_system_emergence": true
	}
	for key in extra_options.keys():
		load_options [key] = extra_options [key]

	if load_options.has("boot_contract") and gs.has_method("hydrate_resolved_boot_checkpoint"):
		var boot_contract: Dictionary = load_options.get("boot_contract", {}) if typeof(load_options.get("boot_contract", {})) == TYPE_DICTIONARY else {}
		var boot_report: Dictionary = gs.hydrate_resolved_boot_checkpoint(boot_contract, load_options)
		boot_report ["load_mode"] = "silent_auto_enter_playable_first"
		boot_report ["profile"] = str(load_options.get("profile", "silent_auto_enter"))
		boot_report ["live_shell_requested"] = true
		boot_report ["entry_surface"] = str(load_options.get("entry_surface", "silent_auto_enter"))
		boot_report ["saved_life_label"] = str(load_options.get("saved_life_label", "Most Recent Life"))
		_store_main_scene_load_report(boot_report)
		return boot_report

	if "game_state_hydration_runtime" in gs:
		# FIX: this path creates the hydration runtime but, unlike GameState.load_game(),
		# never runs the two dependency ensurers. Hydration then fails on missing
		# engines -- the same lazy-null defect that broke Save -- and because nothing
		# below checks report.success the failure was returned silently: no message,
		# and the life simply did not change.
		if gs.has_method("_ensure_load_game_runtime_dependencies"):
			gs._ensure_load_game_runtime_dependencies()

		if gs.has_method("_ensure_identity_checkpoint_runtime_dependencies"):
			gs._ensure_identity_checkpoint_runtime_dependencies()

		if gs.game_state_hydration_runtime == null:
			gs.game_state_hydration_runtime = GameStateHydrationRuntime.new(gs)

		if gs.game_state_hydration_runtime != null and gs.game_state_hydration_runtime.has_method("hydrate_playable_from_path"):
			var report: Dictionary = gs.game_state_hydration_runtime.hydrate_playable_from_path(clean_path, load_options)

			# A failed hydration used to be returned with nobody checking it, so a
			# broken load looked identical to a successful one: no message, and the
			# life unchanged. Say so.
			if not bool(report.get("success", false)):
				EraLog.truth(
					"ERALIFE_LOAD_FAILED|path=%s|reason=%s|text=%s"
					% [
						clean_path,
						str(report.get("reason", "unknown")),
						str(report.get("text", ""))
					]
				)

				if world_actions_status_label != null and is_instance_valid(world_actions_status_label):
					world_actions_status_label.text = (
						"Load failed: %s"
						% str(report.get("reason", "unknown"))
					)

			# FIX: hydration restores the game state but never touches the residency
			# manager -- there are zero references to it in GameStateHydrationRuntime.
			# So after a load the resident record existed with a live service key, but
			# nothing was ever attached to it: attached_signature stayed empty, the
			# residency truth reported first_false_gate=resident_runtime_exists, and
			# the pump armed hundreds of times against work it could never finish.
			# Attach the restored reality so the load actually completes.
			if bool(report.get("success", false)):
				_attach_restored_reality_after_load()

			report ["load_mode"] = "playable_first"
			report ["profile"] = str(load_options.get("profile", "zero_frame_local_life_packet"))
			report ["live_shell_requested"] = true
			report ["entry_surface"] = str(load_options.get("entry_surface", get_meta("saved_life_load_entry_surface", "saved_life_picker")))
			report ["saved_life_label"] = str(load_options.get("saved_life_label", "Saved Life"))
			_store_main_scene_load_report(report)
			return report

	if gs.has_method("load_game"):
		EraLog.truth("ERALIFE_LOAD_BRANCH|branch=legacy_load_game")
		var legacy_result: Variant = gs.load_game(clean_path, load_options)
		if typeof(legacy_result) == TYPE_DICTIONARY:
			var legacy_report: Dictionary = (legacy_result as Dictionary).duplicate(true)
			legacy_report ["load_mode"] = "legacy_playable_first"
			legacy_report ["profile"] = str(load_options.get("profile", "zero_frame_local_life_packet"))
			legacy_report ["live_shell_requested"] = true
			_store_main_scene_load_report(legacy_report)
			return legacy_report

	return {
		"success": false,
		"reason": "GameState does not expose a hydration runtime or load_game()."
	}
func _store_main_scene_load_report(report: Dictionary) -> void:
	if gs == null or report.is_empty():
		return

	if "game_state_hydration_report" in gs:
		gs.game_state_hydration_report = report.duplicate(true)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["last_game_state_hydration_report"] = report.duplicate(true)
	gs.scenario_state ["background_hydration_active"] = bool(report.get("background_active", false))
	gs.scenario_state ["background_hydration_queue_size"] = int(report.get("background_queue_size", 0))
	gs.scenario_state ["live_save_load_shell_ready"] = bool(report.get("live_shell_ready", report.get("playable", false)))
	gs.scenario_state ["live_save_load_entry_surface"] = str(report.get("entry_surface", get_meta("saved_life_load_entry_surface", "")))
	gs.scenario_state ["live_save_load_label"] = str(report.get("saved_life_label", "Saved Life"))

	if gs.has_method("update_save_load_runtime_scheduler_from_report"):
		gs.update_save_load_runtime_scheduler_from_report(report)
func _finish_failed_life_load(message: String) -> void:
	var clean_message: String = str(message).strip_edges()
	if clean_message == "":
		clean_message = "Save load failed."

	_stop_background_hydration_timer()

	if saved_life_picker_popup != null:
		saved_life_picker_popup.visible = true

	if saved_life_picker_status_label != null:
		saved_life_picker_status_label.text = clean_message

	if world_actions_status_label != null:
		world_actions_status_label.text = clean_message

	if saved_life_picker_cancel_button != null:
		saved_life_picker_cancel_button.disabled = false

	if saved_life_picker_confirm_button != null:
		saved_life_picker_confirm_button.disabled = saved_life_picker_mode != "merge" or saved_life_picker_pending_path == ""

	_set_saved_life_picker_buttons_enabled(true)
func _set_saved_life_picker_buttons_enabled(enabled: bool) -> void:
	if saved_life_picker_list == null:
		return

	for child in saved_life_picker_list.get_children():
		if child is Button:
			(child as Button).disabled = not enabled
			continue

		if child is Control:
			for nested in (child as Control).get_children():
				if nested is Button:
					(nested as Button).disabled = not enabled


func _merge_life_from_slot(path: String) -> void:
	if gs == null or path == "":
		return

	var imported: Person = gs.merge_character_from_save(path)
	_close_saved_life_picker()

	if imported == null:
		if world_actions_status_label != null:
			world_actions_status_label.text = "Merge lineage failed."
		return

	var imported_name:= ("%s %s" % [imported.first_name, imported.last_name]).strip_edges()
	gs.push_world_feed(
		"🌌 %s crossed over from another universe." % imported_name,
		{
			"npc_id": imported.id,
			"category": "multiverse",
			"personally_relevant": true
		}
	)

	if world_actions_status_label != null:
		world_actions_status_label.text = "%s is now your friend." % imported_name

	current_panel = "world"
	_refresh_current_panel()
