func _on_eraccount_profile_panel_request_close() -> void:
	if (
		eraccount_profile_panel != null
		and is_instance_valid(
			eraccount_profile_panel
		)
	):
		eraccount_profile_panel.visible = false


func _on_eraccount_profile_panel_request_command(
	envelope: Dictionary
) -> void:
	if (
		gs == null
		or not gs.has_method(
			"queue_command_envelope"
		)
	):
		return

	var routed: Dictionary = (
		envelope.duplicate(true)
	)
	routed ["auto_drain"] = true

	var drain_report: Dictionary = (
		gs.queue_command_envelope(
			routed
		)
	)
	var report: Dictionary = (
		MainSceneHelpers._first_handled_command_report(
			drain_report
		)
	)

	if (
		eraccount_profile_panel != null
		and is_instance_valid(
			eraccount_profile_panel
		)
	):
		eraccount_profile_panel.apply_command_report(
			report
