func _terminate_god_mode_panel_after_contract_emit(reason: String = "god_mode_panel_contract_emit") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	_sever_god_mode_runtime_authority(reason)

	set_meta("god_mode_panel_terminated_after_contract_emit", true)
	set_meta("god_mode_panel_terminated_after_contract_emit_at_ms", now_ms)
	set_meta("god_mode_panel_terminated_after_contract_emit_reason", reason)

	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.set_process(false)
		god_mode_start_panel.set_physics_process(false)
		god_mode_start_panel.visible = false
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_start_panel.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_start_panel.z_as_relative = false
		god_mode_start_panel.z_index = -4096
		god_mode_start_panel.set_meta("god_mode_panel_non_runtime", true)
		god_mode_start_panel.set_meta("god_mode_panel_terminated_after_contract_emit", true)
		god_mode_start_panel.set_meta("god_mode_panel_terminated_reason", reason)

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_background_dim.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_background_dim.z_as_relative = false
		god_mode_background_dim.z_index = -4096

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = false
		god_mode_panel_glow_shell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_panel_glow_shell.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_panel_glow_shell.z_as_relative = false
		god_mode_panel_glow_shell.z_index = -4096

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["god_mode_panel_terminated_after_contract_emit"] = true
		gs.scenario_state ["god_mode_panel_terminated_after_contract_emit_at_ms"] = now_ms
		gs.scenario_state ["god_mode_panel_terminated_after_contract_emit_reason"] = reason
