		return

	eraccount_status_banner_label.text = str(message)
	eraccount_status_banner.add_theme_stylebox_override("panel", MainSceneHelpers._eraccount_banner_style(connected))
	eraccount_status_banner.visible = true
	eraccount_status_banner.modulate = Color(1.0, 1.0, 1.0, 0.0)
	eraccount_status_banner.offset_top = -88
	eraccount_status_banner.offset_bottom = -24

	if eraccount_status_banner_tween != null:
		eraccount_status_banner_tween.kill()

