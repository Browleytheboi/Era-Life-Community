func _apply_pending_situation_diary_records(result: Dictionary, active_actor_id: int = -1) -> bool:
	if typeof(result) != TYPE_DICTIONARY:
		return false

	var records_raw: Variant = result.get("diary_records", [])
	if typeof(records_raw) != TYPE_ARRAY:
		return false

	var records: Array = records_raw as Array
	var active_logged: bool = false
	var seen_fingerprints: Dictionary = {}

	for raw_record in records:
		if typeof(raw_record) != TYPE_DICTIONARY:
			continue

		var record: Dictionary = raw_record as Dictionary
		var actor_id: int = int(record.get("actor_id", -1))
		var text: String = str(record.get("life_diary_text", record.get("text", ""))).strip_edges()
		if actor_id <= 0 or text == "":
			continue

		var clean_text: String = MainSceneLogic._clean_pending_situation_diary_text(text)
		var fingerprint: String = MainSceneLogic._pending_situation_diary_fingerprint(clean_text)
		var report_key: String = "%d|%s" % [
			actor_id,
			fingerprint if fingerprint != "" else clean_text.to_lower()
		]

		if seen_fingerprints.has(report_key):
			continue

		seen_fingerprints [report_key] = true
		_append_pending_situation_diary_line_for_actor(
			actor_id,
			clean_text,
			"pending_situation_choice_committed_record"
		)

		if active_actor_id > 0 and actor_id == active_actor_id:
			active_logged = true

	if active_logged:
		call_deferred("_render_life_diary_panel")
		call_deferred("_scroll_life_diary_to_bottom")

	return active_logged
func _append_pending_situation_diary_line_for_actor(actor_id: int, text: String, reason: String = "pending_situation_choice") -> void:
	if gs == null or actor_id <= 0:
		return

	var clean_text: String = MainSceneLogic._clean_pending_situation_diary_text(text)
	if clean_text == "":
		return

	if gs.player != null and int(gs.player.id) == actor_id:
		_append_pending_situation_diary_line_for_active_actor(clean_text, reason)
		return

	var actor: Person = MainSceneLogic._pending_situation_actor_by_id(gs, actor_id)
	var store: Dictionary = MainSceneLogic._ensure_life_diary_state_store(gs)
	var key: String = str(actor_id)
	var bucket_raw: Variant = store.get(key, {})
	var bucket: Dictionary = bucket_raw if typeof(bucket_raw) == TYPE_DICTIONARY else {}

	var entries_raw: Variant = bucket.get("entries", [])
	var entries: Array = entries_raw.duplicate(true) if typeof(entries_raw) == TYPE_ARRAY else []

	entries = _dedupe_life_diary_entries_for_owner(entries, actor_id)

	if MainSceneLogic._pending_situation_diary_line_exists_in_entries(entries, clean_text):
		bucket ["entries"] = entries
		bucket ["pending_situation_diary_fingerprints"] = MainSceneLogic._pending_situation_diary_fingerprints_from_entries(entries, MainSceneHelpers._safe_array(bucket.get("pending_situation_diary_fingerprints", [])))
		store [key] = bucket
		gs.scenario_state ["life_diary_state_by_npc"] = store
		return

	var actor_age: int = int(actor.age) if actor != null else int(gs.player.age if gs.player != null else 0)
	var year_line: String = "Year: %s" % _format_year(gs.year)
	var age_line: String = "Age: %d" % actor_age

	var target_index: int = -1
	for i in range(entries.size() - 1, -1, -1):
		var raw_entry: Variant = entries [i]
		if typeof(raw_entry) != TYPE_ARRAY:
			continue

		var entry: Array = raw_entry as Array
		var entry_year: String = str(entry [0]) if entry.size() > 0 else ""
		var entry_age: String = str(entry [1]) if entry.size() > 1 else ""
		if entry_year == year_line and entry_age == age_line:
			target_index = i
			break

	if target_index == -1:
		entries.append([year_line, age_line, clean_text])
	else:
		var target_entry: Array = entries [target_index]
		target_entry.append(clean_text)
		entries [target_index] = target_entry

	entries = _dedupe_life_diary_entries_for_owner(entries, actor_id)

	bucket ["entries"] = entries
	bucket ["world_feed_cursor"] = int(bucket.get("world_feed_cursor", gs.world_feed.size() if typeof(gs.world_feed) == TYPE_ARRAY else 0))
	bucket ["global_memory_cursor"] = int(bucket.get("global_memory_cursor", 0))
	bucket ["player_memory_cursor"] = int(bucket.get("player_memory_cursor", 0))
	bucket ["owner_year"] = int(gs.year)
	bucket ["owner_age"] = actor_age
	bucket ["last_pending_situation_diary_reason"] = reason
	bucket ["last_pending_situation_diary_at_ms"] = int(Time.get_ticks_msec())
	bucket ["pending_situation_diary_bypasses_generic_first_person_rewrite"] = true
	bucket ["pending_situation_diary_single_source"] = "life_diary_state_by_npc"
	bucket ["pending_situation_diary_fingerprints"] = MainSceneLogic._pending_situation_diary_fingerprints_from_entries(entries, MainSceneHelpers._safe_array(bucket.get("pending_situation_diary_fingerprints", [])))

	store [key] = bucket
	gs.scenario_state ["life_diary_state_by_npc"] = store

	_invalidate_life_diary_contract_render_cache(reason)
func _append_pending_situation_diary_line_for_active_actor(clean_text: String, reason: String = "pending_situation_choice") -> void:
	if gs == null or gs.player == null:
		return

	var safe_text: String = MainSceneLogic._clean_pending_situation_diary_text(clean_text)
	if safe_text == "":
		return

	var owner_id: int = int(gs.player.id)
	_ensure_active_life_diary_loaded(false)

	var engine:= _ensure_life_diary_contract_engine()
	if engine == null:
		return

	var report: Dictionary = engine.enqueue_intent({
		"type": "committed_action",
		"actor_id": owner_id,
		"text": safe_text,
		"year": int(gs.year),
		"age": int(gs.player.age),
		"source": reason,
		"append_to_current_year_block": true,
		"journal_continuation": true,
		"start_new_block": false,
		"dedupe_key": "pending_situation:%d:%d:%d:%s" % [
			owner_id,
			int(gs.year),
			int(gs.player.age),
			MainSceneLogic._pending_situation_diary_fingerprint(safe_text)
		],
		"meta": {
			"append_to_current_year_block": true,
		}
	}, MainSceneLogic._life_diary_bridge_context(gs, reason, {
		"source": reason,
		"ui_is_reader_only": true
	}))

	_life_diary_sync_runtime_cache_from_contract(owner_id, str(report.get("mode", reason)))
	_save_active_life_diary_state()
	_mark_life_diary_mutated(reason)
	_invalidate_life_diary_contract_render_cache(reason)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["pending_situation_result_logged_by_life_diary_contract"] = true
		gs.scenario_state ["pending_situation_result_logged_actor_id"] = owner_id
		gs.scenario_state ["pending_situation_result_logged_reason"] = reason
		gs.scenario_state ["pending_situation_result_logged_at_ms"] = int(Time.get_ticks_msec())

	if current_panel == "life" and not standard_tab_popup_open:
		call_deferred("_render_life_diary_panel")
		call_deferred("_scroll_life_diary_to_bottom")
func _dedupe_life_diary_entries_for_owner(
	entries: Array,
	_owner_id: int = -1
) -> Array:
	var out: Array = []
	var key_to_index: Dictionary = {}
	var seen_lines_by_key: Dictionary = {}
	var seen_pending_fingerprints: Dictionary = {}

	for raw_entry in entries:
		if typeof(raw_entry) != TYPE_ARRAY:
			continue

		var entry: Array = raw_entry as Array
		var year_line: String = ""
		var age_line: String = ""
		var body_lines: Array = []

		for raw_line in entry:
			var raw_text: String = str(
				raw_line
			).strip_edges()

			if raw_text == "":
				continue

			if _is_life_diary_year_header_line(
				raw_text
			):
				if year_line == "":
					year_line = MainSceneHelpers._life_diary_year_header_text(
						raw_text
					)

				continue

			if raw_text.begins_with("Age: "):
				if age_line == "":
					age_line = raw_text

				continue

			var clean_text: String = (
				MainSceneLogic._clean_pending_situation_diary_text(
					raw_text
				)
			)
			var fingerprint: String = (
				MainSceneLogic._pending_situation_diary_fingerprint(
					clean_text
				)
			)

			if fingerprint != "":
				if seen_pending_fingerprints.has(
					fingerprint
				):
					continue

				seen_pending_fingerprints [
					fingerprint
				] = true
				body_lines.append(
					clean_text
				)
				continue

			body_lines.append(
				raw_text
			)

		if year_line == "":
			year_line = _format_year(
				gs.year
				if gs != null
				else 0
			)

		if age_line == "":
			age_line = "Age: %d" % int(
				gs.player.age
				if (
					gs != null
					and gs.player != null
				)
				else 0
			)

		var block_key: String = "%s|%s" % [
			year_line,
			age_line
		]
		var target_index: int = -1

		if key_to_index.has(
			block_key
		):
			target_index = int(
				key_to_index [
					block_key
				]
			)
		else:
			target_index = out.size()
			key_to_index [
				block_key
			] = target_index
			seen_lines_by_key [
				block_key
			] = {
				year_line: true,
				age_line: true
			}
			out.append([
				year_line,
				age_line
			])

		var target_entry: Array = out [
			target_index
		]
		var seen_lines: Dictionary = (
			seen_lines_by_key.get(
				block_key,
				{}
			)
		)

		for raw_body_line in body_lines:
			var body_text: String = str(
				raw_body_line
			).strip_edges()

			if body_text == "":
				continue

			if seen_lines.has(
				body_text
			):
				continue

			seen_lines [
				body_text
			] = true
			target_entry.append(
				body_text
			)

		seen_lines_by_key [
			block_key
		] = seen_lines
		out [
			target_index
		] = target_entry

	return out
