func _style_god_mode_section_label(label: Label, font_size: int = 18, alpha: float = 0.96) -> void:
	if label == null:
		return
	var palette:= _current_god_mode_palette()
	var label_color: Color = Color(palette.get("status", Color(0.98, 0.95, 1.0, 1.0)))
	var breath_scale_strength: float = 0.006
	var breath_alpha_boost: float = 0.04
	if label == god_mode_subtitle_label:
		label_color = Color(palette.get("accent", Color(1.0, 0.88, 0.93, 1.0))).lerp(
			Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0))),
			0.38
		)
		breath_scale_strength = 0.007
		breath_alpha_boost = 0.05
	elif label == god_mode_title_label:
		label_color = Color(palette.get("title", Color(1.0, 0.97, 0.9, 1.0)))
		breath_scale_strength = 0.008
		breath_alpha_boost = 0.06
	label.add_theme_color_override("font_color", Color(
		label_color.r,
		label_color.g,
		label_color.b,
		alpha
	))
	label.add_theme_font_size_override("font_size", font_size)
	label.set_meta("god_mode_section_alpha", alpha)
	label.set_meta("god_mode_section_font_size", font_size)
	label.set_meta("god_mode_section_breath_scale_strength", breath_scale_strength)
	label.set_meta("god_mode_section_breath_alpha_boost", breath_alpha_boost)
	label.set_meta("god_mode_section_breath_base_scale", Vector2.ONE)
	if not god_mode_section_labels.has(label):
		god_mode_section_labels.append(label)
func _apply_god_mode_section_label_breathing_visual() -> void:
	if god_mode_section_labels.is_empty():
