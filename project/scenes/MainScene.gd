func _suspend_standard_tab_popup_for_child_surface(reason: String = "") -> void:
	if standard_tab_popup == null or not is_instance_valid(standard_tab_popup):
		return
	if not standard_tab_popup.visible:
		return

	set_meta("standard_tab_popup_suspended_for_child_surface", true)
	set_meta("standard_tab_popup_suspended_reason", reason)
	set_meta("standard_tab_popup_suspended_at_ms", int(Time.get_ticks_msec()))

	standard_tab_popup.visible = false
	standard_tab_popup.mouse_filter = Control.MOUSE_FILTER_IGNORE
	standard_tab_popup.process_mode = Node.PROCESS_MODE_DISABLED

	standard_tab_popup.set_meta("interactive_surface_input_suspended", true)
	standard_tab_popup.set_meta("interactive_surface_suspended_by_child_surface", reason)


func _restore_standard_tab_popup_after_child_surface() -> void:
	if not bool(get_meta("standard_tab_popup_suspended_for_child_surface", false)):
		return

	remove_meta("standard_tab_popup_suspended_for_child_surface")
	remove_meta("standard_tab_popup_suspended_reason")

	if standard_tab_popup == null or not is_instance_valid(standard_tab_popup):
		return
	if not standard_tab_popup_open:
		return

	standard_tab_popup.visible = true
	standard_tab_popup.mouse_filter = Control.MOUSE_FILTER_STOP
	standard_tab_popup.process_mode = Node.PROCESS_MODE_INHERIT
	standard_tab_popup.z_index = 120

	standard_tab_popup.set_meta("interactive_surface_input_suspended", false)
	standard_tab_popup.set_meta("interactive_surface_restored_after_child_surface", true)
	standard_tab_popup.set_meta("interactive_surface_restored_at_ms", int(Time.get_ticks_msec()))

	var popup_parent:= standard_tab_popup.get_parent()
	if popup_parent != null:
		popup_parent.move_child(standard_tab_popup, popup_parent.get_child_count() - 1)

	_claim_interactive_surface_authority(
		standard_tab_popup,
		"standard_tab_popup:%s" % str(standard_tab_popup_kind).strip_edges().to_lower(),
		"restore_standard_tab_popup_after_child_surface",
		true,
		true
	)


func _standard_tab_add_action_button(
	text: String,
	action_id: String
) -> void:
	if standard_tab_popup_right == null:
		return

	var btn:= Button.new()
	btn.text = text
	btn.size_flags_horizontal = (
		Control.SIZE_EXPAND_FILL
	)
	btn.custom_minimum_size = Vector2(
		0,
		42
	)

	var renderer_only_property_route: bool = (
		action_id == "Life Assets Back"
		or action_id == "Property Portfolio Back"
		or action_id.begins_with(
			"Property Portfolio Open::"
		)
		or action_id.begins_with(
			"Property Portfolio Inspect::"
		)
		or action_id.begins_with(
			"Property Portfolio Enter::"
		)
		or action_id.begins_with(
			"Property Portfolio Makeover::"
		)
	)

	if renderer_only_property_route:
		btn.pressed.connect(
