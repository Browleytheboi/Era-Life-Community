func _prewarm_god_mode_start_panel_for_entry() -> void:
	if gs == null:
		return
	if bool(get_meta("god_mode_start_panel_prewarming", false)):
		return

	var idle_ui_allowed: bool = bool(get_meta("god_mode_panel_ui_prewarm_allowed", false))
	var explicit_open_allowed: bool = bool(get_meta("god_mode_seed_crafting_started", false))
	if not idle_ui_allowed and not explicit_open_allowed:
		return
	if startup_intro_overlay != null and is_instance_valid(startup_intro_overlay) and startup_intro_overlay.visible and not startup_intro_exiting:
		return

	var settings: Dictionary = _build_default_custom_settings()
	if typeof(gs.custom_settings) == TYPE_DICTIONARY:
		for raw_key in gs.custom_settings.keys():
			settings [raw_key] = gs.custom_settings.get(raw_key)

	settings ["_god_mode_entry_kind"] = str(settings.get("_god_mode_entry_kind", "custom"))




	settings.erase("_prebirth_reality_candidate")
	settings.erase("_prebirth_reality_candidate_id")
	settings.erase("world_seed")
	settings.erase("seed_contract")
	settings.erase("soul_seed_contract")
	settings.erase("soul_seed_distribution_report")

	set_meta("god_mode_start_panel_prebuilt_ui_only", true)
	set_meta("god_mode_manual_world_seed_prewarm_authorized", false)
	set_meta("god_mode_start_panel_prewarming", true)

	gs.custom_mode = true
	gs.custom_settings = settings.duplicate(true)

	if typeof(gs.scenario_state) != TYPE_DICTIONARY:
		gs.scenario_state = {}

	gs.scenario_state ["startup_intro_shell_only"] = true
	gs.scenario_state ["materialize_world_seed_on_initialize"] = false
	gs.scenario_state ["god_mode_ui_shell_only"] = true
	gs.scenario_state ["god_mode_manual_world_seed_prewarm_authorized"] = false
	gs.scenario_state ["soul_seed_distribution_authorized"] = false
	gs.scenario_state ["soul_seed_distribution_reason"] = "god_mode_ui_shell_only"
	gs.scenario_state ["soul_seed_background_distribution_pending"] = false
	gs.scenario_state ["soul_seed_background_stream_active"] = false
	gs.scenario_state ["runtime_hud_node_prewarm_authorized"] = false

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		_show_god_mode_start_panel()

	_apply_god_mode_start_panel_fullscreen_layout()
	_hide_prewarmed_god_mode_start_panel()

	set_meta("god_mode_start_panel_prewarmed", true)
	set_meta("god_mode_start_panel_prewarming", false)

	if choose_adventure_entry_overlay != null and is_instance_valid(choose_adventure_entry_overlay):
		choose_adventure_entry_overlay.visible = true
func _hide_prewarmed_god_mode_start_panel() -> void:
	if god_mode_start_panel != null and is_instance_valid(god_mode_start_panel):
		god_mode_start_panel.visible = false
		god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_start_panel.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_start_panel.scale = Vector2.ONE
	_hide_god_mode_scrollbar_immediately()
	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = false
		god_mode_panel_glow_shell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_panel_glow_shell.modulate = Color(1.0, 1.0, 1.0, 0.0)
		god_mode_panel_glow_shell.scale = Vector2.ONE
	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = false
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_background_dim.modulate = Color(1.0, 1.0, 1.0, 0.0)


func _reveal_prewarmed_god_mode_start_panel() -> void:
	if not _god_mode_runtime_allowed("_reveal_prewarmed_god_mode_start_panel", "reveal_panel"):
		return
	if _god_mode_visual_authority_may_be_active() and _god_mode_any_live_runtime_control_visible_for_release("reveal_prewarmed_god_mode_panel_blocked"):
		_force_release_god_mode_handoff_to_visible_life_surface("reveal_prewarmed_god_mode_panel_blocked_by_live_controls")
		return

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		set_meta("god_mode_panel_ui_prewarm_allowed", true)
		_prepare_god_mode_ui_shell_only_contract_for_entry("reveal_missing_god_mode_panel_full_build")
		_prewarm_god_mode_start_panel_for_entry()
		set_meta("god_mode_panel_ui_prewarm_allowed", false)

	if god_mode_start_panel == null or not is_instance_valid(god_mode_start_panel):
		return

	_hide_god_mode_start_panel_zero_frame_shell("reveal_full_god_mode_panel")

	if god_mode_background_dim != null and is_instance_valid(god_mode_background_dim):
		god_mode_background_dim.visible = true
		god_mode_background_dim.mouse_filter = Control.MOUSE_FILTER_STOP
		god_mode_background_dim.modulate = Color(1.0, 1.0, 1.0, 1.0)

	_apply_god_mode_start_panel_fullscreen_layout()

	if god_mode_panel_glow_shell != null and is_instance_valid(god_mode_panel_glow_shell):
		god_mode_panel_glow_shell.visible = true
		god_mode_panel_glow_shell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		god_mode_panel_glow_shell.modulate = Color(1.0, 1.0, 1.0, 1.0)
		god_mode_panel_glow_shell.scale = Vector2.ONE
		god_mode_panel_glow_shell.pivot_offset = Vector2.ZERO

	god_mode_start_panel.visible = true
	god_mode_start_panel.mouse_filter = Control.MOUSE_FILTER_STOP
	god_mode_start_panel.modulate = Color(1.0, 1.0, 1.0, 1.0)
	god_mode_start_panel.scale = Vector2.ONE
	god_mode_start_panel.pivot_offset = Vector2.ZERO

	_bring_modal_to_front(god_mode_start_panel)

	set_meta("god_mode_start_panel_prewarmed", true)
	set_meta("god_mode_full_panel_hot_cached", true)
	set_meta("god_mode_start_panel_prewarming", false)
	set_meta("god_mode_zero_frame_open_active", false)
	set_meta("god_mode_audio_fadeout_requested", false)
	set_meta("god_mode_panel_atomic_reveal_active", true)
	set_meta("god_mode_panel_atomic_reveal_at_ms", int(Time.get_ticks_msec()))

	call_deferred("_restyle_live_god_mode_field_controls")
	call_deferred("_sync_god_mode_audio_contract", "reveal_prewarmed_god_mode_start_panel")
