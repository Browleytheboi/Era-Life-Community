	output_label.append_text(text + "\n")
func _current_era_ui_theme_key() -> String:
	if gs == null:
		return "modern"

	var era_name: String = ""

	if gs.era != null:
		if typeof(gs.era) == TYPE_DICTIONARY:
			var era_data: Dictionary = gs.era as Dictionary
			era_name = str(
				era_data.get(
					"name",
					era_data.get(
						"era_name",
						""
					)
				)
			).strip_edges()
		else:
			era_name = str(
				gs.era.get("name")
			).strip_edges()

	if (
		era_name == ""
		and typeof(gs.scenario_state) == TYPE_DICTIONARY
	):
		for raw_key in [
			"effective_era_name",
			"active_era_name",
			"runtime_era_name",
			"current_era_name",
			"year_era_name",
			"era_name",
			"current_era",
			"selected_era",
			"birth_era",
			"player_era",
			"era"
		]:
			var candidate: String = str(
				gs.scenario_state.get(
					raw_key,
					""
				)
			).strip_edges()

			if candidate != "":
				era_name = candidate
				break

	var normalized: String = era_name.to_lower()

	if normalized == "":
		return "modern"

	if normalized.find("future") != -1:
		return "future"

	if (
		normalized.find("industrial") != -1
		or normalized.find("steam") != -1
		or normalized.find("victorian") != -1
	):
		return "industrial"

	if (
		normalized.find("modern") != -1
		or normalized.find("contemporary") != -1
	):
		return "modern"

	if (
		normalized.find("medieval") != -1
		or normalized.find("middle") != -1
		or normalized.find("feudal") != -1
	):
		return "medieval"

	return "ancient"

func _current_ui_nav_theme_key() -> String:
	return _current_era_ui_theme_key()
func _ui_nav_button_theme_tokens(
	key: String,
