func _track_startup_intro_runtime_tween(tween: Tween) -> Tween:
	if tween == null:
		return tween
	startup_intro_runtime_tweens.append(tween)
	return tween


func _kill_startup_intro_runtime_tweens(reason: String = "startup_intro_reset") -> void:
	for raw_tween in startup_intro_runtime_tweens:
		if raw_tween == null or not (raw_tween is Tween):
			continue
		var tracked_tween: Tween = raw_tween as Tween
		if tracked_tween.is_valid():
			tracked_tween.kill()

	startup_intro_runtime_tweens.clear()
	set_meta("startup_intro_runtime_tweens_killed_reason", reason)
	set_meta("startup_intro_runtime_tweens_killed_at_ms", int(Time.get_ticks_msec()))
func _startup_intro_event_targets_replay_button(event: InputEvent) -> bool:
	if startup_intro_replay_button == null or not is_instance_valid(startup_intro_replay_button):
		return false

	if not startup_intro_replay_button.visible:
		return false

	if startup_intro_replay_button.disabled:
		return false

	var pointer_pos:= Vector2.ZERO
	var has_pointer_pos: bool = false

	if event is InputEventMouseButton:
		var mouse_event:= event as InputEventMouseButton
		if not mouse_event.pressed or mouse_event.button_index != MOUSE_BUTTON_LEFT:
			return false
		pointer_pos = mouse_event.position
		has_pointer_pos = true
	elif event is InputEventScreenTouch:
		var touch_event:= event as InputEventScreenTouch
		if not touch_event.pressed:
			return false
		pointer_pos = touch_event.position
		has_pointer_pos = true

	if not has_pointer_pos:
		return false

	return startup_intro_replay_button.get_global_rect().grow(8.0).has_point(pointer_pos)

func _prime_startup_intro_replay_sequence_cache() -> void:
	var intro_raw: Variant = get_meta("startup_intro_current_intro_sequence", [])
	var bridge_raw: Variant = get_meta("startup_intro_current_bridge_sequence", [])
	var intro_sequence: Array = intro_raw if typeof(intro_raw) == TYPE_ARRAY else []
	var bridge_sequence: Array = bridge_raw if typeof(bridge_raw) == TYPE_ARRAY else []

	var previous_signature: String = MainSceneLogic._startup_intro_sequence_bundle_signature(intro_sequence, bridge_sequence)

	set_meta("startup_intro_replay_previous_sequence_signature", previous_signature)
	set_meta("startup_intro_replay_warm_sequences_pending", false)
	set_meta("startup_intro_replay_fresh_sequences_pending", true)
	set_meta("startup_intro_replay_fresh_sequences_primed_at_ms", int(Time.get_ticks_msec()))

	set_meta("startup_intro_replay_warm_intro_sequence", [])
	set_meta("startup_intro_replay_warm_bridge_sequence", [])
	set_meta("startup_intro_replay_warm_jumble_years", [])
	set_meta("startup_intro_replay_warm_jumble_fragments", [])

func _consume_startup_intro_replay_sequence_cache_for_current_generation() -> void:
	set_meta("startup_intro_replay_warm_sequences_pending", false)

	if not bool(get_meta("startup_intro_replay_fresh_sequences_pending", false)):
		return

	_prepare_startup_intro_fresh_sequence_cache_for_current_generation("startup_intro_replay_refresh")
	set_meta("startup_intro_replay_fresh_sequences_pending", false)
	set_meta("startup_intro_replay_fresh_sequences_consumed", true)
	set_meta("startup_intro_replay_fresh_sequences_consumed_at_ms", int(Time.get_ticks_msec()))


func _begin_startup_intro_from_replay_request() -> void:
	set_meta("startup_intro_replay_begin_queued", false)

	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return

	if startup_intro_exiting:
		return

	_begin_startup_intro()
func _on_startup_intro_replay_pressed() -> void:
	if startup_intro_overlay == null or not is_instance_valid(startup_intro_overlay):
		return

	if startup_intro_exiting:
		return

	if not bool(get_meta("startup_intro_replay_button_accepts_input", false)):
		return

	if startup_intro_replay_button != null and is_instance_valid(startup_intro_replay_button):
		if startup_intro_replay_button.disabled:
			return

	if bool(get_meta("startup_intro_replay_begin_queued", false)):
		get_viewport().set_input_as_handled()
		return

	get_viewport().set_input_as_handled()

	startup_intro_sequence_generation += 1
	startup_intro_accepting_input = false

	set_meta("startup_intro_replay_requested", true)
	set_meta("startup_intro_replay_requested_at_ms", int(Time.get_ticks_msec()))
	set_meta("startup_intro_force_audio_restart_on_next_sync", true)
	set_meta("startup_intro_replay_audio_restart_requested_at_ms", int(Time.get_ticks_msec()))
	set_meta("startup_intro_replay_begin_queued", true)
	set_meta("startup_intro_replay_button_accepts_input", false)
	set_meta("startup_intro_sequence_runner_active", false)
	set_meta("startup_intro_sequence_runner_generation", -999999)

	_kill_startup_intro_runtime_tweens("startup_intro_replay_pressed")

	if startup_intro_replay_button != null and is_instance_valid(startup_intro_replay_button):
		startup_intro_replay_button.disabled = true
		startup_intro_replay_button.text = "↺ REPLAYING..."
		startup_intro_replay_button.modulate = Color(1.0, 1.0, 1.0, 0.52)

	_prime_startup_intro_replay_sequence_cache()
	_startup_intro_clear_current_sequence_cache("startup_intro_replay_pressed")
	_hide_startup_intro_replay_button()
	_set_startup_intro_title_shine_enabled(false)

	call_deferred("_begin_startup_intro_from_replay_request")
func _start_startup_intro_skip_pulse() -> void:
	if startup_intro_skip_button == null or not is_instance_valid(startup_intro_skip_button):
		return
	if startup_intro_skip_tween != null:
		startup_intro_skip_tween.kill()
		startup_intro_skip_tween = null
	var glitch_timing: Dictionary = _build_startup_intro_skip_glitch_timing()
	var lead_in: float = float(glitch_timing.get("lead_in", 1.05))

	var flash_a: float = float(glitch_timing.get("flash_a", 0.07))
	var flash_b: float = float(glitch_timing.get("flash_b", 0.05))
	var flash_c: float = float(glitch_timing.get("flash_c", 0.08))
	var flash_d: float = float(glitch_timing.get("flash_d", 0.05))
	var settle_in: float = float(glitch_timing.get("settle_in", 0.12))
	var settle_out: float = float(glitch_timing.get("settle_out", 0.2))
	startup_intro_skip_button.visible = true
	startup_intro_skip_button.disabled = true
	startup_intro_skip_button.scale = Vector2(0.96, 0.96)
	startup_intro_skip_button.modulate = Color(1.0, 1.0, 1.0, 0.0)
	startup_intro_skip_tween = create_tween().bind_node(startup_intro_skip_button)
	startup_intro_skip_tween.set_trans(Tween.TRANS_SINE)
	startup_intro_skip_tween.set_ease(Tween.EASE_IN_OUT)
	startup_intro_skip_tween.tween_interval(lead_in)
	startup_intro_skip_tween.tween_property(
		startup_intro_skip_button,
		"modulate",
		Color(1.0, 1.0, 1.0, 0.74),
		flash_a
	)
	startup_intro_skip_tween.parallel().tween_property(
		startup_intro_skip_button,
		"scale",
		Vector2(1.018, 1.018),
		flash_a
	)
	startup_intro_skip_tween.tween_property(
		startup_intro_skip_button,
		"modulate",
		Color(1.0, 1.0, 1.0, 0.16),
		flash_b
	)
	startup_intro_skip_tween.parallel().tween_property(
		startup_intro_skip_button,
		"scale",
		Vector2(0.988, 0.988),
		flash_b
	)
	startup_intro_skip_tween.tween_property(
		startup_intro_skip_button,
		"modulate",
		Color(1.0, 1.0, 1.0, 0.9),
		flash_c
	)
	startup_intro_skip_tween.parallel().tween_property(
		startup_intro_skip_button,
		"scale",
		Vector2(1.03, 1.03),
		flash_c
	)
	startup_intro_skip_tween.tween_property(
		startup_intro_skip_button,
		"modulate",
		Color(1.0, 1.0, 1.0, 0.34),
		flash_d
	)
	startup_intro_skip_tween.parallel().tween_property(
		startup_intro_skip_button,
		"scale",
		Vector2(0.994, 0.994),
		flash_d
	)
	startup_intro_skip_tween.tween_property(
		startup_intro_skip_button,
		"modulate",
		Color(1.0, 1.0, 1.0, 1.0),
		settle_in
