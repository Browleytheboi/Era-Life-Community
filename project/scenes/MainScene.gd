func _on_prebuilt_death_transition_option_pressed(
	button: Button
) -> void:
	if (
		button == null
		or not is_instance_valid(
			button
		)
	):
		return

	var action_label: String = str(
		button.get_meta(
			"afterlife_action_label",
			""
		)
	).strip_edges()

	if action_label == "":
		return

	_on_afterlife_action_pressed(
		action_label
	)

func _hide_afterlife_ui() -> void:
	if death_transition_popup != null:
		death_transition_popup.visible = false
	if afterlife_overlay != null:
		afterlife_overlay.visible = false


func _show_afterlife_death_prompt(
	result: Dictionary
) -> void:
	if afterlife_overlay != null:
		afterlife_overlay.visible = false

	if (
		death_transition_popup == null
		or not is_instance_valid(
			death_transition_popup
		)
	):
		set_meta(
			"death_transition_renderer_chassis_contract_violation",
			true
		)
		set_meta(
			"death_transition_renderer_chassis_missing_at_ms",
			int(
				Time.get_ticks_msec()
			)
		)
		return

	var was_visible: bool = (
		death_transition_popup.visible
	)

	death_transition_title.text = "YOU DIED"
	death_transition_body.clear()

	var death_text: String = str(
		result.get(
			"text",
			""
		)
	)



	if (
		gs != null
		and typeof(
			gs.afterlife_state
		) == TYPE_DICTIONARY
		and not gs.afterlife_state.is_empty()
	):
		var enrichment_complete: bool = bool(
			gs.afterlife_state.get(
				"death_entry_enrichment_complete",
				false
			)
		)

		if enrichment_complete:
			var personal_net_worth: float = float(
				gs.afterlife_state.get(
					"ghost_personal_net_worth",
					0.0
				)
			)
			var family_net_worth: float = float(
				gs.afterlife_state.get(
					"ghost_family_net_worth",
					0.0
				)
			)

			death_text += (
				"\n\nPersonal Net Worth: %s"
				% _format_death_panel_net_worth(
					personal_net_worth
				)
			)
			death_text += (
				"\nFamily Net Worth: %s"
				% _format_death_panel_net_worth(
					family_net_worth
				)
			)

	death_transition_body.append_text(
		death_text
	)

	var options: Array = MainSceneHelpers._safe_array(
		result.get(
			"opps",
			[]
		)
	)
	var prebuilt_buttons: Array = (
		death_transition_buttons.get_children()
	)

	for index in range(
		prebuilt_buttons.size()
	):
		var button:= (
			prebuilt_buttons [
				index
			] as Button
		)

		if (
			button == null
			or not is_instance_valid(
				button
			)
		):
			continue

		if index >= options.size():
			button.visible = false
			button.disabled = false
			button.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
			button.set_meta(
				"afterlife_action_label",
				""
			)
			continue

		var action_label: String = str(
			options [
				index
			]
		).strip_edges()





		if action_label == "The After Life":
			button.visible = false
			button.disabled = true
			button.mouse_filter = (
				Control.MOUSE_FILTER_IGNORE
			)
			button.set_meta(
				"afterlife_action_label",
				""
			)
			button.set_meta(
				"afterlife_action_temporarily_hidden",
				true
			)
			continue

		button.set_meta(
			"afterlife_action_temporarily_hidden",
			false
		)
		button.text = action_label
		button.set_meta(
			"afterlife_action_label",
			action_label
		)
		button.visible = true
		button.disabled = false
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
		)

	death_transition_popup.visible = true
	death_transition_popup.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)

	_bring_modal_to_front(
		death_transition_popup
	)



	_claim_death_transition_audio_after_presented_death_frame(
		result.duplicate(false),
		"you_died_panel_shown",
		not was_visible
	)

	set_meta(
		"death_transition_first_frame_simulation_work_performed",
		false
	)
	set_meta(
		"death_transition_first_frame_net_worth_calculation_performed",
		false
	)
	set_meta(
		"death_transition_first_frame_afterlife_ui_build_performed",
		false
	)
	set_meta(
		"death_transition_first_frame_option_node_build_performed",
		false
	)
	set_meta(
		"death_transition_first_frame_audio_claim_performed",
		false
	)
	set_meta(
		"death_transition_first_frame_requires_player_idle",
		false
	)
func _claim_death_transition_audio_after_presented_death_frame(
	result: Dictionary,
	reason: String,
	force_restart: bool
) -> void:






	var tree:= get_tree()

	if tree == null:
		return

	await tree.process_frame

	if (
		death_transition_popup == null
		or not is_instance_valid(
			death_transition_popup
		)
		or not death_transition_popup.visible
	):
		return

	_claim_death_transition_audio_contract(
		result,
		reason,
		force_restart
	)
func _show_afterlife_overlay(result: Dictionary) -> void:
	_ensure_afterlife_ui()
	if death_transition_popup != null:
		death_transition_popup.visible = false
	if afterlife_overlay == null:
		return


	if relationship_money_popup != null:
		relationship_money_popup.visible = false
	if relationship_profile_popup != null:
		relationship_profile_popup.visible = false
	relationship_profile_popup_open = false
	if relationships_browser_panel != null:
		relationships_browser_panel.visible = false
	if activities_action_panel != null:
		activities_action_panel.visible = false
	if output_label != null:
		output_label.visible = false
	if player_stats_overlay != null:
		player_stats_overlay.visible = false

	afterlife_overlay.visible = true
	_bring_modal_to_front(afterlife_overlay)
	afterlife_overlay_title.text = "THE AFTERLIFE"
	afterlife_overlay_body.clear()
	afterlife_overlay_body.append_text(str(result.get("text", "")))
	_clear_container_children(afterlife_overlay_buttons)

	var rtype: String = str(result.get("type", ""))
	var showing_identity_form: bool = rtype == "afterlife_reincarnation_identity_form"
	if afterlife_reincarnation_identity_box != null:
		afterlife_reincarnation_identity_box.visible = showing_identity_form
	if showing_identity_form:
		var selected_slot = {}
		if gs != null and gs.afterlife_state != null:
			selected_slot = gs.afterlife_state.get("reincarnation_selected_slot", {})
		if typeof(selected_slot) == TYPE_DICTIONARY and not selected_slot.is_empty():
			if afterlife_reincarnation_last_name_input != null and afterlife_reincarnation_last_name_input.text.strip_edges() == "":
				var slot_label: String = str(selected_slot.get("label", ""))
				var parts: PackedStringArray = slot_label.split(" ")
				if parts.size() >= 2:
					afterlife_reincarnation_last_name_input.text = parts [1]
		if afterlife_reincarnation_first_name_input != null:
			afterlife_reincarnation_first_name_input.grab_focus()
		afterlife_overlay_footer.text = "Choose your name and gender, then press REINCARNATE."
		return

	if rtype == "afterlife_rewind_applied":
		var rewind_btn:= Button.new()
		rewind_btn.text = "Live the Last Year Again"
		rewind_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		rewind_btn.custom_minimum_size = Vector2(0, 46)
		rewind_btn.mouse_filter = Control.MOUSE_FILTER_STOP
		rewind_btn.focus_mode = Control.FOCUS_ALL
		rewind_btn.pressed.connect(_on_afterlife_rewind_continue_pressed)
		afterlife_overlay_buttons.add_child(rewind_btn)
		rewind_btn.call_deferred("grab_focus")
		afterlife_overlay_footer.text = "Return to the restored mortal year."
		return

	for opp in result.get("opps", []):
		var btn:= Button.new()
		btn.text = str(opp)
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.custom_minimum_size = Vector2(0, 46)
		btn.pressed.connect(_on_afterlife_action_pressed.bind(str(opp)))
		afterlife_overlay_buttons.add_child(btn)

	if result.get("opps", []).is_empty() and rtype in ["afterlife_round_waiting_for_year_advance", "afterlife_round_complete"]:
		var age_btn:= Button.new()
		age_btn.text = "Age Up"
		age_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		age_btn.custom_minimum_size = Vector2(0, 46)
		age_btn.pressed.connect(_on_button_pressed)
		afterlife_overlay_buttons.add_child(age_btn)
		afterlife_overlay_footer.text = "Spiritual year complete. Press the button above to let the mortal year unfold."
	else:
		afterlife_overlay_footer.text = ""
