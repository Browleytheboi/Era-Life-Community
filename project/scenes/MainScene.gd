func _arm_world_feed_progressive_process_frame_step(
	step_id: String,
	token: int
) -> void:
	if not _world_feed_progressive_is_current(token):
		return

	var clean_step_id: String = str(
		step_id
	).strip_edges().to_lower()

	if clean_step_id not in [
		"scan",
		"prepare",
		"render"
	]:
		return

	var tree:= Engine.get_main_loop() as SceneTree
	if tree == null:
		set_meta(
			"world_feed_progressive_process_frame_service_active",
			false
		)
		set_meta(
			"world_feed_progressive_scheduler_unavailable",
			true
		)
		return

	set_meta(
		"world_feed_progressive_process_frame_step_id",
		clean_step_id
	)
	set_meta(
		"world_feed_progressive_process_frame_token",
		token
	)
	set_meta(
		"world_feed_progressive_uses_call_deferred",
		false
	)
	set_meta(
		"world_feed_progressive_requires_input_idle",
		false
	)

	var callback:= Callable(
		self,
		"_drive_world_feed_progressive_process_frame_step"
	)

	if tree.process_frame.is_connected(callback):
		set_meta(
			"world_feed_progressive_process_frame_service_active",
			true
		)
		return

	tree.process_frame.connect(callback)
	set_meta(
		"world_feed_progressive_process_frame_service_active",
		true
	)


func _drive_world_feed_progressive_process_frame_step() -> void:
	var tree:= Engine.get_main_loop() as SceneTree
	var callback:= Callable(
		self,
		"_drive_world_feed_progressive_process_frame_step"
	)

	if (
		tree != null
		and tree.process_frame.is_connected(callback)
	):
		tree.process_frame.disconnect(callback)

	set_meta(
		"world_feed_progressive_process_frame_service_active",
		false
	)

	var token: int = int(
		get_meta(
			"world_feed_progressive_process_frame_token",
			-1
		)
	)
	var step_id: String = str(
		get_meta(
			"world_feed_progressive_process_frame_step_id",
			""
		)
	).strip_edges().to_lower()

	remove_meta(
		"world_feed_progressive_process_frame_step_id"
	)
	remove_meta(
		"world_feed_progressive_process_frame_token"
	)

	if not _world_feed_progressive_is_current(token):
		return

	match step_id:
		"scan":
			_world_feed_progressive_scan_chunk(token)
		"prepare":
			_world_feed_progressive_prepare_render(token)
		"render":
			_world_feed_progressive_render_chunk(token)
