func _append_crown_live_nation_bleed_card(summary: Dictionary) -> void:
	if crown_hub_list == null:
		return

	var core:= _crown_hud_core_color()
	var population_value: int = int(summary.get("population", 0))
	var military_value: int = int(summary.get("military_stockpile", 0))
	var goods_value: int = int(summary.get("goods_stockpile", 0))
	var treasury_value: int = int(summary.get("treasury", 0))
	var currency_name: String = str(summary.get("currency_name", "")).strip_edges()
	var pulse:= (sin(crown_hud_breathe_time * 1.6) + 1.0) * 0.5

	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.custom_minimum_size = Vector2(0, 126)
	card.z_index = 6
	crown_hub_list.add_child(card)

	var style: StyleBoxFlat = MainSceneLogic._crown_hub_depth_style(card, "crown_live_nation_bleed_card_style", "raised", core, true, false)
	style.bg_color = Color(0.045, 0.06, 0.09, 0.96)
	card.add_theme_stylebox_override("panel", style)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 14)
	margin.add_theme_constant_override("margin_right", 16)
	margin.add_theme_constant_override("margin_bottom", 14)
	card.add_child(margin)

	var root:= VBoxContainer.new()
	root.add_theme_constant_override("separation", 8)
	margin.add_child(root)

	var title:= Label.new()
	title.text = "LIVE STATE BLEED-IN"
	title.add_theme_font_size_override("font_size", 18)
	title.add_theme_color_override("font_color", Color(1.0, 0.86 + (pulse * 0.1), 0.45, 1.0))
	root.add_child(title)

	var ticker:= Label.new()
	ticker.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	ticker.text = "Population %s • Military %s • Goods %s • Treasury %s" % [
		_crown_compact_number(float(population_value)),
		_crown_compact_number(float(military_value)),
		_crown_compact_number(float(goods_value)),
		_format_crown_treasury_label(treasury_value, currency_name)
	]
	ticker.add_theme_font_size_override("font_size", 15)
	ticker.add_theme_color_override("font_color", Color(0.82, 0.94, 1.0, 0.92))
	root.add_child(ticker)

	var world_line:= Label.new()
	world_line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	world_line.text = "This is not decorative animation. These numbers are pulled from the current realm summary and refreshed through the Crown lens."
	world_line.add_theme_color_override("font_color", Color(0.78, 0.78, 0.72, 0.78))
	root.add_child(world_line)
func _append_crown_hidden_realm_row(hidden_realm_id: String, realm: Dictionary, permissions: Dictionary) -> void:
	if crown_hub_list == null:
		return
	var realm_name: String = str(realm.get("name", "Hidden Realm")).strip_edges()
	var population: int = int(realm.get("population", 0))
	var land: int = int(realm.get("land", 0))
	var treasury: int = int(realm.get("treasury", 0))
	var military_stockpile: int = int(realm.get("military_stockpile", 0))
	var goods_stockpile: int = int(realm.get("goods_stockpile", 0))
	var subzones_raw: Variant = realm.get("subzones", [])
	var subzones: Array = subzones_raw if typeof(subzones_raw) == TYPE_ARRAY else []
	var capital_city: String = str(realm.get("capital_city", "")).strip_edges()
	var trade_rules_raw: Variant = realm.get("trade_rules", {})
	var trade_rules: Dictionary = trade_rules_raw if typeof(trade_rules_raw) == TYPE_DICTIONARY else {}
	var services_raw: Variant = realm.get("services", {})
	var services: Dictionary = services_raw if typeof(services_raw) == TYPE_DICTIONARY else {}
	var is_era_kingdom: bool = hidden_realm_id == "era_kingdom"
	var card:= PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.custom_minimum_size = Vector2(0, 124)
	crown_hub_list.add_child(card)
	var style:= StyleBoxFlat.new()
	style.bg_color = Color(0.16, 0.1, 0.24, 0.96) if is_era_kingdom else Color(0.1, 0.1, 0.16, 0.92)
	style.border_width_left = 3
	style.border_width_top = 3
	style.border_width_right = 3
	style.border_width_bottom = 3
	style.border_color = Color(0.78, 0.44, 1.0, 1.0) if is_era_kingdom else Color(0.46, 0.72, 1.0, 0.86)
	style.corner_radius_top_left = 18
	style.corner_radius_top_right = 18
	style.corner_radius_bottom_left = 18
	style.corner_radius_bottom_right = 18
	card.add_theme_stylebox_override("panel", style)
	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 12)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 12)
	card.add_child(margin)
	var row:= HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	margin.add_child(row)
	var text_box:= VBoxContainer.new()
	text_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text_box.add_theme_constant_override("separation", 4)
	row.add_child(text_box)
	var title_label:= Label.new()
	title_label.text = "%s%s • Hidden Realm" % ["🌌 " if is_era_kingdom else "", realm_name]
	title_label.add_theme_font_size_override("font_size", 20 if is_era_kingdom else 18)
	if is_era_kingdom:
		title_label.add_theme_color_override("font_color", Color(0.96, 0.86, 1.0, 1.0))
	text_box.add_child(title_label)
	var body_label:= Label.new()
	body_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	body_label.text = "%s • Pop %s • Land %s • Treasury %s • Military %s • Goods %s • %d subzones • Access %s • Bribes %s • Trade %s" % [
		str(realm.get("government_style", "State")),
		_crown_compact_number(float(population)),
		_crown_compact_number(float(land)),
		_crown_compact_number(float(treasury)),
		_crown_compact_number(float(military_stockpile)),
		_crown_compact_number(float(goods_stockpile)),
		int(subzones.size()),
		str(realm.get("entry_rule", "restricted")).replace("_", " ").capitalize(),
		"Refused" if not bool(trade_rules.get("accepts_bribes", true)) else "Allowed",
		"Rare artifacts only" if bool(trade_rules.get("rare_artifacts_only", false)) else "Standard"
	]
	if is_era_kingdom:
		body_label.add_theme_color_override("font_color", Color(0.92, 0.94, 1.0, 1.0))
	text_box.add_child(body_label)
	var footer_label:= Label.new()
	footer_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	footer_label.text = "Capital: %s • Services: %s%s%s" % [
		capital_city if capital_city != "" else "Unknown",
		"War Resolution " if bool((services.get("war_resolution", {}) as Dictionary).get("enabled", false)) else "",
		"Massive Loans " if bool((services.get("massive_loans", {}) as Dictionary).get("enabled", false)) else "",
		"Balance Restoration" if bool((services.get("balance_restoration", {}) as Dictionary).get("enabled", false)) else ""
	]
	if is_era_kingdom:
		footer_label.add_theme_color_override("font_color", Color(0.88, 0.82, 1.0, 0.96))
	text_box.add_child(footer_label)
	var open_button:= Button.new()
	open_button.text = "Open"
	open_button.custom_minimum_size = Vector2(108, 42)
	open_button.disabled = not bool(permissions.get("diplomacy", false))
	open_button.pressed.connect(_show_crown_action_popup.bind("hidden_realm_overview", {
		"hidden_realm_id": hidden_realm_id,
		"realm": realm.duplicate(true),
		"allow_population": not bool(realm.get("hide_people_button", false))
	}))
	row.add_child(open_button)
func _ensure_crown_action_popup() -> void:
	if crown_action_popup != null:
		return

	var ui_root:= self as Control
	if ui_root == null:
		return

	crown_action_popup = Control.new()
	crown_action_popup.name = "crown_action_popup"
	crown_action_popup.visible = false
	crown_action_popup.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	crown_action_popup.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	crown_action_popup.z_index = 1120
	crown_action_popup.set_meta(
		"modal_z_floor",
		1120
	)
	crown_action_popup.set_meta(
		"crown_child_modal",
		true
	)
	ui_root.add_child(
		crown_action_popup
	)

	crown_action_popup_dim = ColorRect.new()
	crown_action_popup_dim.name = "crown_action_popup_dim"
	crown_action_popup_dim.set_anchors_and_offsets_preset(
		Control.PRESET_FULL_RECT
	)
	crown_action_popup_dim.color = Color(
		0.0,
		0.0,
		0.0,
		0.68
	)
	crown_action_popup_dim.mouse_filter = (
		Control.MOUSE_FILTER_STOP
	)
	crown_action_popup.add_child(
		crown_action_popup_dim
