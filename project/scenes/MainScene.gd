func _defer_bending_hub_tournament_payload_rebuild(expected_signature: String = "", attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	if gs == null or gs.player == null or gs.bending_engine == null:
		return
	if not bending_hud_open:
		return

	var live_section: String = str(bending_hud_current_section).strip_edges().to_lower()
	if live_section != "tournaments":
		return

	if bool(get_meta("bending_hub_async_tournament_payload_pending", false)):
		return

	var live_signature: String = _bending_hub_player_signature()
	if expected_signature != "" and live_signature != expected_signature and attempt < 4:
		var retry_timer:= tree.create_timer(0.04)
		retry_timer.timeout.connect(
			Callable(self, "_defer_bending_hub_tournament_payload_rebuild").bind(live_signature, attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	_rebuild_bending_hub_tournament_content()
	_sync_bending_hub_section_visibility()
