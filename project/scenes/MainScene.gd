func _release_ready_door_projection_service_after_presented_grace(
	grace_until_ms: int,
	reason: String
) -> void:
	var tree:= get_tree()

	if tree == null:
		return

	await tree.process_frame
	await tree.process_frame

	var remaining_ms: int = maxi(
		0,
		grace_until_ms
		- int(
			Time.get_ticks_msec()
		)
	)

	if remaining_ms > 0:
		await tree.create_timer(
			float(
				remaining_ms
			) / 1000.0
		).timeout

	if (
		gs == null
		or typeof(
			gs.scenario_state
		) != TYPE_DICTIONARY
	):
		return

	var simulation_activation_ms: int = int(
		Time.get_ticks_msec()
	)
	var simulation_settle_until_ms: int = (
		simulation_activation_ms
		+ 350
	)
	var runtime_guard_raw: Variant = (
		gs.scenario_state.get(
			"runtime_guard",
			{}
		)
	)
	var runtime_guard: Dictionary = (
		(
			runtime_guard_raw as Dictionary
		).duplicate(false)
		if typeof(
			runtime_guard_raw
		) == TYPE_DICTIONARY
		else {}
	)




	runtime_guard [
		"ui_interaction_grace_until_ms"
	] = maxi(
		int(
			runtime_guard.get(
				"ui_interaction_grace_until_ms",
				0
			)
		),
		simulation_settle_until_ms
	)
	runtime_guard [
		"truth_resolution_yield_until_ms"
	] = maxi(
		int(
			runtime_guard.get(
				"truth_resolution_yield_until_ms",
				0
			)
		),
		simulation_settle_until_ms
	)
	runtime_guard [
		"ready_door_projection_quantum_forbidden"
	] = true
	runtime_guard [
		"ready_door_first_simulation_frame_pending"
	] = true
	runtime_guard [
		"ready_door_first_simulation_frame_started_at_ms"
