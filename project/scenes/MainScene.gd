func _playable_life_shell_input_must_use_cached_tab_packets(now_ms: int = -1) -> bool:
	var check_ms: int = now_ms
	if check_ms < 0:
		check_ms = int(Time.get_ticks_msec())

	if gs == null or gs.player == null:
		return false

	if not _playable_life_surface_player_control_released():
		return false

	var released_at_ms: int = int(get_meta("playable_life_surface_player_control_released_at_ms", 0))
	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		released_at_ms = max(
			released_at_ms,
			int(gs.scenario_state.get("playable_life_surface_player_control_released_at_ms", 0))
		)
		released_at_ms = max(
			released_at_ms,
			int(gs.scenario_state.get("birth_shell_player_control_released_at_ms", 0))
		)
		released_at_ms = max(
			released_at_ms,
			int(gs.scenario_state.get("spawn_ready_live_ui_shell_released_at_ms", 0))
		)

	var fresh_shell_window_active: bool = released_at_ms > 0 and check_ms - released_at_ms < 30000

	var tail_pending: bool = bool(get_meta("god_mode_post_entry_tail_work_pending", false)) \
or bool(get_meta("deferred_live_reality_stream_bind_pending", false)) \
or bool(get_meta("spawn_ready_main_tab_packet_prewarm_pending", false)) \
or bool(get_meta("spawn_ready_main_tab_packet_prewarm_running", false))

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		tail_pending = tail_pending \
or bool(gs.scenario_state.get("post_spawn_world_prewarm_pending", false)) \
or bool(gs.scenario_state.get("deferred_live_reality_stream_bind_pending", false)) \
or bool(gs.scenario_state.get("ui_background_reconciliation_streaming", false)) \
or bool(gs.scenario_state.get("body_contract_tail_work_pending", false))

	return fresh_shell_window_active or tail_pending


func _schedule_main_tab_background_packet_reconcile(panel_id: String, reason: String = "main_tab_background_reconcile", delay_seconds: float = 0.85) -> void:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	if clean_panel == "":
		return

	var key_prefix: String = "main_tab_background_packet_reconcile_%s" % clean_panel
	var ticket: int = int(Time.get_ticks_msec())

	set_meta("%s_pending" % key_prefix, true)
	set_meta("%s_reason" % key_prefix, reason)
	set_meta("%s_ticket" % key_prefix, ticket)
	set_meta("%s_scheduled_at_ms" % key_prefix, ticket)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_run_main_tab_background_packet_reconcile", clean_panel, reason, ticket, 0)
		return

	var timer:= tree.create_timer(max(0.12, delay_seconds))
	timer.timeout.connect(
		Callable(self, "_run_main_tab_background_packet_reconcile").bind(clean_panel, reason, ticket, 0),
		CONNECT_ONE_SHOT
	)


func _run_main_tab_background_packet_reconcile(panel_id: String, reason: String = "main_tab_background_reconcile", ticket: int = 0, attempt: int = 0) -> void:
	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	if clean_panel == "":
		return

	var key_prefix: String = "main_tab_background_packet_reconcile_%s" % clean_panel
	if int(get_meta("%s_ticket" % key_prefix, -1)) != int(ticket):
		return

	var now_ms: int = int(Time.get_ticks_msec())
	var must_wait: bool = _ui_interaction_grace_active(now_ms) \
or _runtime_interactive_surface_busy(now_ms) \
or _post_spawn_ui_is_busy_for_prewarm() \
or not _background_tail_work_allowed(now_ms)

	if must_wait and attempt < 48:
		var tree:= get_tree()
		if tree == null:
			call_deferred("_run_main_tab_background_packet_reconcile", clean_panel, reason, ticket, attempt + 1)
			return

		var retry_timer:= tree.create_timer(0.35)
		retry_timer.timeout.connect(
			Callable(self, "_run_main_tab_background_packet_reconcile").bind(clean_panel, reason, ticket, attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	set_meta("%s_pending" % key_prefix, false)
	set_meta("%s_started_at_ms" % key_prefix, now_ms)

	_prewarm_main_tab_ui_packet(clean_panel, "%s_idle_reconcile" % reason)

	set_meta("%s_completed_at_ms" % key_prefix, int(Time.get_ticks_msec()))
func _build_main_tab_packet_now(panel_id: String, reason: String = "main_tab_render") -> Dictionary:
	if gs == null:
		return {}

	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)
	if surface_id == "":
		return {}

	var context: Dictionary = _build_main_tab_ui_packet_context(clean_panel)
	context ["source"] = "mainscene.build_main_tab_packet_now"
	context ["build_reason"] = reason
	context ["ui_is_pure_renderer"] = true
	context ["main_tab_hot_packet"] = true
	context ["click_path_must_not_block"] = true
	context ["click_path_must_not_build"] = true
	context ["packet_contract_required"] = true
	context ["perceived_truth_required"] = true
	context ["engine_calls_forbidden_on_click"] = true
	context ["runtime_fetch_forbidden_on_click"] = true
	context ["fresh_contract_build_forbidden_on_click"] = true

	var hot_packet: Dictionary = _main_tab_hot_packet_for_context(clean_panel, context)
	if MainSceneLogic._main_tab_packet_is_renderable(hot_packet):
		return hot_packet

	var synthesized: Dictionary = _main_tab_synthesized_packet(clean_panel, context)
	synthesized ["main_tab_synthesized_because_hot_packet_missing"] = true
	synthesized ["missing_hot_surface_id"] = surface_id
	synthesized ["click_path_did_not_call_runtime"] = true
	synthesized ["click_path_did_not_build_fresh_contract"] = true
	synthesized ["background_reconciliation_required"] = true
	synthesized ["stability_tier"] = "main_tab_click_path_cache_only_synthesized"

	_store_main_tab_hot_packet(clean_panel, synthesized, context)
	_schedule_main_tab_background_packet_reconcile(clean_panel, "%s_hot_packet_missing" % reason, 0.85)

	return synthesized
func _schedule_spawn_ready_main_tab_packet_prewarm_after_shell(reason: String = "spawn_ready") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty():
		EraLog.truth("GLOBAL_RUNTIME_TRUTH|blocked_schedule=spawn_ready_main_tab_packet_prewarm|reason=%s|shell_visible=1|at_ms=%d" % [
			reason,
			now_ms
		])

		set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
		set_meta("spawn_ready_main_tab_packet_prewarm_running", false)
		set_meta("spawn_ready_main_tab_packet_prewarm_blocked_by_visible_shell", true)
		set_meta("spawn_ready_main_tab_packet_prewarm_blocked_reason", reason)
		set_meta("spawn_ready_main_tab_packet_prewarm_blocked_at_ms", now_ms)

		if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
			gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_pending"] = false
			gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_running"] = false
			gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_blocked_by_visible_shell"] = true
			gs.scenario_state ["main_tab_packet_prewarm_must_wait_for_player_idle"] = true

		return

	set_meta("spawn_ready_main_tab_packet_prewarm_pending", true)
	set_meta("spawn_ready_main_tab_packet_prewarm_reason", reason)
	set_meta("spawn_ready_main_tab_packet_prewarm_scheduled_at_ms", now_ms)

	var tree:= get_tree()
	if tree == null:
		call_deferred("_prewarm_all_main_tab_ui_packets", reason)
		return

	var delay_seconds: float = 1.35
	var prewarmed_shell_entry: bool = _spawn_ready_shell_entry_should_stream_runtime_hud_hydration()

	if prewarmed_shell_entry:
		delay_seconds = 4.25
		set_meta("spawn_ready_main_tab_packet_prewarm_idle_guard_until_ms", now_ms + 4000)
	elif bool(get_meta("god_mode_handoff_cover_release_pending", false)) or bool(get_meta("god_mode_atomic_shell_handoff_active", false)):
		delay_seconds = 1.75
		set_meta("spawn_ready_main_tab_packet_prewarm_idle_guard_until_ms", now_ms + 1200)
	else:
		set_meta("spawn_ready_main_tab_packet_prewarm_idle_guard_until_ms", now_ms + 650)

	var timer:= tree.create_timer(delay_seconds)
	timer.timeout.connect(
		Callable(self, "_run_spawn_ready_main_tab_packet_prewarm_after_shell").bind(reason, 0),
		CONNECT_ONE_SHOT
	)
func _run_spawn_ready_main_tab_packet_prewarm_after_shell(reason: String = "spawn_ready", attempt: int = 0) -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("background_tail", "Mainscene._run_spawn_ready_main_tab_packet_prewarm_after_shell", reason, {
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": false,
			"attempt": attempt
		}):
			EraLog.truth("GLOBAL_RUNTIME_TRUTH|blocked_run=spawn_ready_main_tab_packet_prewarm|reason=%s|attempt=%d|at_ms=%d" % [
				reason,
				attempt,
				now_ms
			])
			set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
			set_meta("spawn_ready_main_tab_packet_prewarm_running", false)
			set_meta("spawn_ready_main_tab_packet_prewarm_blocked_by_global_runtime_kill", true)
			set_meta("spawn_ready_main_tab_packet_prewarm_blocked_at_ms", now_ms)
			return

	if gs == null:
		set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
		return

	var tree:= get_tree()
	if tree == null:
		set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
		return

	var cover_pending: bool = bool(get_meta("god_mode_handoff_cover_release_pending", false)) \
or bool(get_meta("god_mode_atomic_shell_handoff_active", false))

	var shell_visible: bool = _spawn_ready_live_ui_shell_has_visible_contract_content()
	var ui_busy: bool = _post_spawn_ui_is_busy_for_prewarm() or _ui_interaction_grace_active(now_ms)
	var idle_guard_until_ms: int = int(get_meta("spawn_ready_main_tab_packet_prewarm_idle_guard_until_ms", 0))
	var idle_guard_active: bool = idle_guard_until_ms > 0 and now_ms < idle_guard_until_ms

	if (cover_pending or not shell_visible or ui_busy or idle_guard_active) and attempt < 28:
		var retry_timer:= tree.create_timer(0.35)
		retry_timer.timeout.connect(
			Callable(self, "_run_spawn_ready_main_tab_packet_prewarm_after_shell").bind(reason, attempt + 1),
			CONNECT_ONE_SHOT
		)
		return

	set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
	set_meta("spawn_ready_main_tab_packet_prewarm_running", true)
	set_meta("spawn_ready_main_tab_packet_prewarm_started_at_ms", now_ms)
	set_meta("spawn_ready_main_tab_packet_prewarm_release_authorized", true)

	call_deferred("_prewarm_all_main_tab_ui_packets", reason)
func _prewarm_all_main_tab_ui_packets(reason: String = "main_tab_prewarm") -> void:
	var now_ms: int = int(Time.get_ticks_msec())

	if gs == null:
		return

	if _playable_life_shell_has_visible_sovereignty():
		if not _global_runtime_kill_claim_allowed("background_tail", "Mainscene._prewarm_all_main_tab_ui_packets", reason, {
			"background_only": true,
			"blocks_ui": false,
			"ui_safe_microtask": false
		}):
			EraLog.truth("GLOBAL_RUNTIME_TRUTH|blocked_call=_prewarm_all_main_tab_ui_packets|reason=%s|shell_visible=1|at_ms=%d" % [
				reason,
				now_ms
			])

			set_meta("spawn_ready_main_tab_packet_prewarm_release_authorized", false)
			set_meta("spawn_ready_main_tab_packet_prewarm_running", false)
			set_meta("spawn_ready_main_tab_packet_prewarm_pending", false)
			set_meta("spawn_ready_main_tab_packet_prewarm_blocked_by_global_runtime_kill", true)
			set_meta("spawn_ready_main_tab_packet_prewarm_blocked_at_ms", now_ms)

			if typeof(gs.scenario_state) == TYPE_DICTIONARY:
				gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_running"] = false
				gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_pending"] = false
				gs.scenario_state ["spawn_ready_main_tab_packet_prewarm_blocked_by_global_runtime_kill"] = true
				gs.scenario_state ["main_tab_packet_prewarm_deferred_until_player_idle"] = true

			return

	var spawn_shell_boundary_active: bool = bool(get_meta("spawn_ready_ui_first_frame_boundary_active", false)) \
or bool(get_meta("god_mode_handoff_cover_release_pending", false)) \
or bool(get_meta("god_mode_atomic_shell_handoff_active", false))

	if spawn_shell_boundary_active and not bool(get_meta("spawn_ready_main_tab_packet_prewarm_release_authorized", false)):
		_schedule_spawn_ready_main_tab_packet_prewarm_after_shell(reason)
		return

	set_meta("spawn_ready_main_tab_packet_prewarm_release_authorized", false)

	var rows: Array = MainSceneHelpers._main_tab_prewarm_surface_rows()
	var context: Dictionary = {
		"source": "mainscene.prewarm_all_main_tab_ui_packets",
		"reason": reason,
		"ui_is_pure_renderer": true,
		"nonblocking": true,
		"packet_contract_required": true,
		"perceived_truth_required": true,
		"spawn_visible_shell_reason": reason
	}

	if "reality_orchestrator" in gs and gs.reality_orchestrator != null:
		if gs.reality_orchestrator.has_method("queue_streaming_ui_surface_prewarm"):
			gs.reality_orchestrator.queue_streaming_ui_surface_prewarm(rows, context)

	for row in rows:
		if typeof(row) != TYPE_DICTIONARY:
			continue

		var row_data: Dictionary = row as Dictionary
		var surface_id: String = str(row_data.get("surface_id", "")).strip_edges()
		var row_context: Dictionary = row_data.get("context", {}).duplicate(true) if typeof(row_data.get("context", {})) == TYPE_DICTIONARY else {}
		var panel_id: String = str(row_context.get("main_tab", "")).strip_edges()

		if surface_id == "" or panel_id == "":
			continue

		call_deferred("_prewarm_main_tab_ui_packet", panel_id, "%s_%s" % [reason, panel_id])

	set_meta("spawn_ready_main_tab_packet_prewarm_running", false)
	set_meta("spawn_ready_main_tab_packet_prewarm_completed_at_ms", int(Time.get_ticks_msec()))
func _prewarm_main_tab_ui_packet(panel_id: String, reason: String = "main_tab_click") -> void:
	if gs == null:
		return

	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	var surface_id: String = _main_tab_surface_id_for_panel(clean_panel)
	if surface_id == "":
		return

	var now_ms: int = int(Time.get_ticks_msec())
	if _ui_interaction_grace_active(now_ms):
		set_meta("main_tab_prewarm_skipped_during_input_grace", true)
		set_meta("main_tab_prewarm_skipped_panel", clean_panel)
		set_meta("main_tab_prewarm_skipped_at_ms", now_ms)
		return

	var context: Dictionary = _build_main_tab_ui_packet_context(clean_panel)
	context ["source"] = "mainscene.prewarm_main_tab_ui_packet"
	context ["prewarm_reason"] = reason
	context ["ui_is_pure_renderer"] = true
	context ["nonblocking"] = true
	context ["packet_contract_required"] = true
	context ["perceived_truth_required"] = true
	context ["native_surface_prewarm_required"] = true
	context ["click_path_must_not_build"] = true

	var stored_local_packet: bool = false

	if "ui_contract_engine" in gs and gs.ui_contract_engine != null:
		if gs.ui_contract_engine.has_method("prewarm_surface_packet"):
			var report: Dictionary = gs.ui_contract_engine.prewarm_surface_packet(surface_id, context, {
				"source": "mainscene.prewarm_main_tab_ui_packet.local_hot_cache",
				"nonblocking": true,
				"packet_contract_required": true,
				"perceived_truth_required": true,
				"click_path_must_not_build": true
			})
			var packet_raw: Variant = report.get("packet", {})
			if typeof(packet_raw) == TYPE_DICTIONARY:
				var packet: Dictionary = (packet_raw as Dictionary).duplicate(true)
				if MainSceneLogic._main_tab_packet_is_renderable(packet):
					_store_main_tab_hot_packet(clean_panel, packet, context)
					stored_local_packet = true

	if "reality_orchestrator" in gs and gs.reality_orchestrator != null:
		if gs.reality_orchestrator.has_method("prewarm_ui_surface"):
			var orchestrator_report: Dictionary = gs.reality_orchestrator.prewarm_ui_surface(surface_id, context)
			var ui_report_raw: Variant = orchestrator_report.get("ui_report", {})
			if typeof(ui_report_raw) == TYPE_DICTIONARY:
				var ui_report: Dictionary = ui_report_raw as Dictionary
				var orchestrated_packet_raw: Variant = ui_report.get("packet", {})
				if typeof(orchestrated_packet_raw) == TYPE_DICTIONARY:
					var orchestrated_packet: Dictionary = (orchestrated_packet_raw as Dictionary).duplicate(true)
					if MainSceneLogic._main_tab_packet_is_renderable(orchestrated_packet):
						_store_main_tab_hot_packet(clean_panel, orchestrated_packet, context)
						stored_local_packet = true

	if not stored_local_packet:
		var synthesized: Dictionary = _main_tab_synthesized_packet(clean_panel, context)
		_store_main_tab_hot_packet(clean_panel, synthesized, context)

	_prewarm_native_main_tab_surface(clean_panel, "%s_native_surface" % reason)

	if typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["main_tab_native_surface_prewarm_complete"] = true
		gs.scenario_state ["main_tab_native_surface_prewarm_panel"] = clean_panel
		gs.scenario_state ["main_tab_native_surface_prewarm_at_ms"] = int(Time.get_ticks_msec())
func _deferred_refresh_main_tab_after_prewarm(panel_id: String, _attempt: int = 0) -> void:
	var tree:= get_tree()
	if tree == null:
		return

	await tree.process_frame

	var clean_panel: String = str(panel_id).strip_edges().to_lower()
	if current_panel != clean_panel:
		return

