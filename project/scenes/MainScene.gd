func _career_job_overview_lines(job_kind: String, job_name: String, person: Person) -> Array:
	var lines: Array = []
	var clean_job_kind: String = str(job_kind).strip_edges()
	var clean_job_name: String = str(job_name).strip_edges()

	var lane_text: String = "Part-Time" if clean_job_kind == "part_time" else ("Famous Career" if clean_job_kind == "famous" else "Full-Time")
	var eligible: bool = (
		(clean_job_kind == "part_time" and person.age >= 16 and person.age < 18)
		or (clean_job_kind == "full_time" and person.age >= 18)
		or clean_job_kind == "famous"
	)

	if clean_job_kind == "famous" and clean_job_name == "Boxer":
		eligible = gs != null and gs.boxing_engine != null and gs.boxing_engine.can_start_boxing(person)

	var era_name: String = "Unknown Era"
	if gs != null and gs.era != null:
		era_name = str(gs.era.get("name", "Unknown Era"))

	lines.append("===== CAREER OVERVIEW =====")
	lines.append("Career: %s" % clean_job_name)
	lines.append("Lane: %s" % lane_text)
	lines.append("Current Age: %d" % int(person.age))
	lines.append("Era: %s" % era_name)
	lines.append("Status: %s" % ("Eligible" if eligible else "Not Eligible"))

	if clean_job_kind == "famous" and clean_job_name == "Boxer":
		lines.append("This starts your boxing path through the contract-driven boxing domain.")
		lines.append("You will begin near the bottom, build your record, get fight contracts, train stats, climb rankings, and unlock larger venues.")
		lines.append("Once active, Boxing leaves the generic activity list and becomes its own Boxing button.")
	else:
		lines.append("This role should carry the look, pressure, and flavor of a %s workplace." % era_name)
		lines.append("If deeper job data is available, it should appear here through CareerEngine.")

	lines.append("Select Apply to submit your application.")
	lines.append("===========================")
	return lines
func _build_school_institution_hub_section(section: String) -> void:
	var p: Person = gs.player
	if p == null:
		return
	if gs.school_engine == null:
		_institution_hub_add_info_label("School system unavailable.")
		return

	gs.school_engine.ensure_family_school_reality_for(p)
	gs.school_engine.sync_person_school_fields(p)

	if p.school_name != "" and p.school_mode != "" and p.school_name != "None" and p.school_mode != "None":
		gs.school_engine.get_classmates(p)
		gs.school_engine.get_teachers_for(p)

	var snapshot: Dictionary = gs.school_engine.get_school_ecosystem_snapshot(p)
	var active_contract: Dictionary = MainSceneHelpers._safe_dictionary(snapshot.get("active_contract", {}))
	var available_contracts: Array = MainSceneHelpers._safe_array(snapshot.get("available_contracts", []))
	var teachers: Array = MainSceneHelpers._safe_array(snapshot.get("teachers", []))
	var classmates: Array = MainSceneHelpers._safe_array(snapshot.get("classmates", []))
	var meal_zone: Dictionary = MainSceneHelpers._safe_dictionary(snapshot.get("meal_zone", {}))
	var class_zones: Array = MainSceneHelpers._safe_array(snapshot.get("classes", []))
	var social_memory: Array = MainSceneHelpers._safe_array(snapshot.get("social_memory", []))
	var parent_children: Array = MainSceneLogic._school_hub_get_children_for_parent(gs, p)
	var unenrolled_children: Array = MainSceneLogic._school_hub_get_enrollable_children_for_parent(gs, p)

	var postsecondary: Dictionary = {}
	if gs.school_engine.has_method("get_postsecondary_lane_snapshot"):
		postsecondary = gs.school_engine.get_postsecondary_lane_snapshot(p)

	var school_surface_context: Dictionary = MainSceneLogic._build_institution_hub_stat_surface_context(gs, "school", p)
	var school_standing_value: int = 0
	var school_pressure_value: int = 0

	if str(p.school_name).strip_edges() != "" and str(p.school_name).strip_edges() != "None":
		school_standing_value = clamp(int(round(
			(float(p.smarts) * 0.45)
			+ (float(p.mental_health) * 0.18)
			+ (float(p.satisfaction) * 0.12)
			+ (15.0 if str(p.school_status).strip_edges() != "" else 0.0)
		)), 0, 100)

		school_pressure_value = clamp(int(round(
			(float(max(0, 100 - int(p.mental_health))) * 0.45)
			+ (float(max(0, 100 - int(p.satisfaction))) * 0.22)
			+ (12.0 if classmates.size() >= 8 else 0.0)
			+ (8.0 if teachers.size() >= 4 else 0.0)
			+ (10.0 if int(meal_zone.get("live_count", 0)) >= 8 else 0.0)
		)), 0, 100)

	if school_hub_child_enrollment_mode != "":
		_build_school_child_enrollment_flow(p, unenrolled_children)
		return

	if active_contract.is_empty():
		var self_can_see_schooling: bool = int(p.age) >= 6
		var self_path_count: int = available_contracts.size() if self_can_see_schooling else 0

		_institution_hub_add_section_header("Choose Your Schooling Path")
		_institution_hub_add_card("Not Enrolled", [
			"Enrollment: Inactive",
			"Era: %s" % gs.era.name,
			"Available School Paths: %d" % self_path_count,
			"Choose one school contract below to open your full School Hub."
		])

		if self_can_see_schooling and not available_contracts.is_empty():
			_institution_hub_add_section_header("Available School Contracts")
			var visible_count: int = min(4, available_contracts.size())

			for i in range(visible_count):
				var option: Dictionary = MainSceneHelpers._safe_dictionary(available_contracts [i])
				var option_contract: Dictionary = MainSceneHelpers._safe_dictionary(option.get("contract", {}))
				var school_name: String = str(option.get("name", "")).strip_edges()
				var school_type: String = str(option.get("type", "")).strip_edges()

				if school_name == "" or school_type == "":
					continue

				var tuition: float = float(option_contract.get("tuition", 0.0))
				var tuition_text: String = "Free" if tuition <= 0.0 else "$%s / year" % str(int(round(tuition)))
				var program_text: String = str(option_contract.get("program", option_contract.get("school_stage", "School"))).replace("_", " ").capitalize()
				var lane_text: String = str(option_contract.get("lane", "school")).replace("_", " ").capitalize()

				_institution_hub_add_card(school_name, [
					"Lane: %s" % lane_text,
					"Program: %s" % program_text,
					"Tuition: %s" % tuition_text,
					"Type: %s" % school_type.replace("_", " ").capitalize()
				])

				_institution_hub_add_action_button("Enroll in %s" % school_name, "School Hub Enroll::%s::%s" % [school_type, school_name])

		if not parent_children.is_empty():
			_school_hub_add_parent_enrollment_entry(p, parent_children, unenrolled_children)

		if not self_can_see_schooling and parent_children.is_empty():
			_institution_hub_add_info_label("Schooling is controlled by parents before age 6.")

		if self_can_see_schooling and available_contracts.is_empty() and parent_children.is_empty():
			_institution_hub_add_info_label("No era-appropriate schooling contracts are available right now.")

		return

	match section:

		"overview":
			var visible_classmate_count: int = MainSceneLogic._school_hub_visible_classmate_count(classmates, class_zones, p)
			var population_rows: Array = _school_hub_population_rows_from_snapshot(p, snapshot)

			_school_hub_add_population_badge(population_rows)
			_school_hub_add_academic_record_snapshot(postsecondary)
			_school_hub_add_snapshot_card_with_surface(
				[
					"Enrollment: Active",
					"School Name: %s" % str(active_contract.get("school_name", p.school_name)),
					"Institution Type: %s" % str(active_contract.get("institution_type", "school")).replace("_", " ").capitalize(),
					"Program: %s" % (p.education_level if p.education_level != "" else "None"),
					"Status: %s" % (p.school_status if p.school_status != "" else "None"),
					"Visible Teachers: %d" % teachers.size(),
					"Visible Classmates: %d" % visible_classmate_count
				],
				school_standing_value,
				school_pressure_value,
				school_surface_context
			)

			if not parent_children.is_empty():
				_school_hub_add_parent_enrollment_entry(p, parent_children, unenrolled_children)

		"classes":
			_institution_hub_add_section_header(str(active_contract.get("class_surface_label", "Classes")))
			if class_zones.is_empty():
				_institution_hub_add_info_label("No live class zones are visible right now.")
			else:
				var roster_total: int = 0
				var represented_total: int = 0
				var offscreen_total: int = 0

				for raw_scale_zone in class_zones:
					var scale_zone: Dictionary = MainSceneHelpers._safe_dictionary(raw_scale_zone)
					roster_total = max(roster_total, int(scale_zone.get("school_roster_total", 0)))
					represented_total = max(represented_total, int(scale_zone.get("represented_student_count", 0)))
					offscreen_total = max(offscreen_total, int(scale_zone.get("offscreen_student_count", 0)))

				if roster_total > 0:
					_institution_hub_add_card("School Scale", [
						"Enrolled Students: %d" % roster_total,
						"Students Represented In Visible Class Lenses: %d" % represented_total,
						"Students Somewhere Else In The School: %d" % offscreen_total
					])

				for raw_zone in class_zones:
					var class_zone: Dictionary = MainSceneHelpers._safe_dictionary(raw_zone)
					var class_key: String = MainSceneHelpers._school_hub_class_zone_key(class_zone)
					var class_students: Array = MainSceneHelpers._safe_array(class_zone.get("students", []))
					var class_teachers: Array = MainSceneHelpers._safe_array(class_zone.get("teachers", []))
					var class_preview_limit: int = int(class_zone.get("student_preview_limit", 10))
					class_preview_limit = int(clamp(class_preview_limit, 1, 99))

					var total_students: int = int(class_zone.get("total_students", class_students.size()))
					var display_count: int = min(class_preview_limit, class_students.size())
					var hidden_count: int = max(0, class_students.size() - display_count)

					var lines: Array = []
					lines.append("Class Students: %d" % total_students)
					lines.append("Shown Right Now: %d" % display_count)
					lines.append("Hidden In Popup: %d" % hidden_count)
					lines.append("Teachers Present: %d" % class_teachers.size())
					lines.append("Tension: %d%%" % int(round(float(class_zone.get("tension", 0.0)) * 100.0)))

					_institution_hub_add_card(str(class_zone.get("name", "Class")), lines)

					for raw_teacher in class_teachers:
						var teacher_row: Dictionary = MainSceneHelpers._safe_dictionary(raw_teacher)
						_institution_hub_add_person_exact_label_by_id(
							int(teacher_row.get("person_id", -1)),
							"Teacher: %s" % str(teacher_row.get("full_name", "Teacher"))
						)

					for i in range(display_count):
						var student_row: Dictionary = MainSceneHelpers._safe_dictionary(class_students [i])
						_institution_hub_add_person_exact_label_by_id(
							int(student_row.get("person_id", -1)),
							"%s (Age %d)" % [
								str(student_row.get("full_name", "Student")),
								int(student_row.get("age", 0))
							]
						)

					if hidden_count > 0:
						_institution_hub_add_action_button("View remaining %d students in %s" % [
							hidden_count,
							str(class_zone.get("name", "Class"))
						], "School Hub Open Class Roster::%s" % class_key)

		"meal":
			var meal_title: String = str(meal_zone.get("name", active_contract.get("meal_surface_label", "Meal Break"))).strip_edges()
			if meal_title == "":
				meal_title = "Meal Break"

			var meal_people: Array = MainSceneHelpers._safe_array(meal_zone.get("people", []))
			var friendliness_value: int = clamp(int(meal_zone.get("friendliness", 50)), 0, 100)
			var friendliness_description: String = str(meal_zone.get("friendliness_description", "The space has a neutral social temperature.")).strip_edges()
			if friendliness_description == "":
				friendliness_description = "The space has a neutral social temperature."

			_institution_hub_add_section_header(meal_title)
			_school_hub_add_compact_meal_status_card(
				"Live %s" % meal_title,
				str(meal_zone.get("live_count_label", MainSceneHelpers._school_hub_people_label(meal_people.size()))),
				friendliness_value,
				friendliness_description
			)

			if meal_people.is_empty():
				_institution_hub_add_info_label("Nobody is visible in this meal space right now.")
			else:
				_school_hub_add_meal_people_grid(meal_people)

			_school_hub_maybe_queue_meal_approach_scenario()

		"teachers":
			_institution_hub_add_section_header("Teachers")

			if teachers.is_empty():
				_institution_hub_add_info_label("No visible teachers right now.")
			else:
				for t in teachers:
					_institution_hub_add_person_button(t)

		"social":
			_institution_hub_add_section_header(str(active_contract.get("social_surface_label", "School Social Pressure")))

			if social_memory.is_empty():
				_institution_hub_add_info_label("No major school social friction has been recorded yet.")
			else:
				for raw_memory in social_memory:
					var memory: Dictionary = MainSceneHelpers._safe_dictionary(raw_memory)
					_institution_hub_add_card("Year %s" % str(memory.get("year", "")), [
						str(memory.get("text", ""))
					])

		"actions":
			_institution_hub_add_section_header("School Actions")
			_institution_hub_add_action_button("Attend School Year", "School Hub Attend Year")
			_institution_hub_add_action_button("Drop Out", "School Hub Drop Out")

			if not parent_children.is_empty():
				_school_hub_add_parent_enrollment_entry(p, parent_children, unenrolled_children)

		_:
			_institution_hub_add_info_label("No school section selected.")
func _school_hub_add_compact_meal_status_card(title_text: String, live_count_label: String, friendliness_value: int, friendliness_description: String) -> void:
	if institution_hub_list == null:
		return

	var clean_friendliness: int = clamp(int(friendliness_value), 0, 100)
	var friendliness_key: String = MainSceneHelpers._school_hub_friendliness_meta_key(title_text)
	var starting_friendliness: float = float(clean_friendliness)
	if has_meta(friendliness_key):
		starting_friendliness = clamp(float(get_meta(friendliness_key)), 0.0, 100.0)

	var card:= PanelContainer.new()
	card.custom_minimum_size = Vector2(0, 118)
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	card.add_theme_stylebox_override("panel", MainSceneHelpers._institution_hub_inner_panel_style(institution_hub_kind))
	institution_hub_list.add_child(card)

	var margin:= MarginContainer.new()
