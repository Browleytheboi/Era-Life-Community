func _entity_relationship_profile_add_stat_row(row_contract: Dictionary, _surface_context: Dictionary = {}) -> void:
	if entity_relationship_profile_stats == null:
		return

	var title_text: String = str(row_contract.get("title", "")).strip_edges().to_upper()
	var stat_key: String = str(row_contract.get("key", title_text)).strip_edges().to_lower()
	var safe_max: int = max(1, int(row_contract.get("max", 100)))
	var safe_value: int = clampi(int(row_contract.get("value", 0)), 0, safe_max)
	var previous_value: int = clampi(int(row_contract.get("previous_value", safe_value)), 0, safe_max)
	var commit_delta: int = int(row_contract.get("commit_delta", safe_value - previous_value))
	var description_text: String = str(row_contract.get("description", "")).strip_edges()

	var palette: Dictionary = MainSceneHelpers._entity_relationship_stat_palette(
		safe_value,
		safe_max,
		str(row_contract.get("gradient_mode", stat_key))
	)

	var wrapper:= PanelContainer.new()
	wrapper.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	wrapper.mouse_filter = Control.MOUSE_FILTER_PASS
	wrapper.add_theme_stylebox_override("panel", MainSceneHelpers._entity_relationship_popup_panel_style(Color(palette.get("fill", Color(0.82, 0.92, 1.0, 0.16)))))
	entity_relationship_profile_stats.add_child(wrapper)

	var margin:= MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 10)
	margin.add_theme_constant_override("margin_top", 8)
	margin.add_theme_constant_override("margin_right", 10)
	margin.add_theme_constant_override("margin_bottom", 8)
	wrapper.add_child(margin)

	var vbox:= VBoxContainer.new()
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 5)
	margin.add_child(vbox)

	var header_row:= HBoxContainer.new()
	header_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header_row.add_theme_constant_override("separation", 8)
	vbox.add_child(header_row)

	var title_label:= Label.new()
	title_label.text = title_text
	title_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title_label.add_theme_font_size_override("font_size", 12)
	title_label.add_theme_color_override("font_color", Color(0.98, 1.0, 0.98, 0.96))
	header_row.add_child(title_label)

	var descriptor_label:= Label.new()
	descriptor_label.text = description_text
	descriptor_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	descriptor_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	descriptor_label.add_theme_font_size_override("font_size", 11)
	descriptor_label.add_theme_color_override("font_color", Color(0.9, 0.96, 1.0, 0.78))
	header_row.add_child(descriptor_label)

	var bar_holder:= Control.new()
	bar_holder.custom_minimum_size = Vector2(0, 28)
	bar_holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar_holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(bar_holder)

	var bar:= ProgressBar.new()
	bar.min_value = 0
	bar.max_value = safe_max
	bar.value = previous_value
	bar.show_percentage = false
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bar.add_theme_stylebox_override("background", MainSceneHelpers._entity_relationship_progress_background_style())
	bar.add_theme_stylebox_override("fill", MainSceneHelpers._entity_relationship_progress_fill_style(Color(palette.get("fill", Color(0.86, 0.76, 1.0, 0.96)))))
	bar_holder.add_child(bar)

	var value_center:= CenterContainer.new()
	value_center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	value_center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bar_holder.add_child(value_center)

	var value_label:= Label.new()
	value_label.text = str(safe_value)
	value_label.add_theme_font_size_override("font_size", 12)
	value_label.add_theme_color_override("font_color", Color(palette.get("text", Color(1.0, 1.0, 1.0, 0.98))))
	value_center.add_child(value_label)

	if commit_delta != 0:
		var delta_row:= Label.new()
		delta_row.text = "✦ %s %+d" % [title_text, commit_delta]
		delta_row.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		delta_row.add_theme_font_size_override("font_size", 11)
		delta_row.add_theme_color_override("font_color", MainSceneHelpers._entity_relationship_delta_flash_color(stat_key, commit_delta, bool(row_contract.get("positive_delta_is_good", true))))
		vbox.add_child(delta_row)

		var flash:= create_tween()
		delta_row.scale = Vector2(1.05, 1.05)
		flash.tween_property(delta_row, "modulate:a", 0.42, 0.18)
		flash.tween_property(delta_row, "modulate:a", 1.0, 0.18)
		flash.tween_property(delta_row, "scale", Vector2.ONE, 0.18)

	var bar_tween:= create_tween()
	bar_tween.tween_property(bar, "value", safe_value, 0.26)

	if bool(row_contract.get("pulse_when_high", false)):
		var pulse:= create_tween()
		pulse.set_loops()
		pulse.tween_property(bar, "modulate:a", 0.78, 0.58)
		pulse.tween_property(bar, "modulate:a", 1.0, 0.58)

	if bool(row_contract.get("shake_when_low", false)) or bool(row_contract.get("danger_reactive", false)):
		var wobble:= create_tween()
		wobble.set_loops()
		wobble.tween_property(wrapper, "rotation_degrees", -0.4, 0.1)
		wobble.tween_property(wrapper, "rotation_degrees", 0.4, 0.1)
		wobble.tween_property(wrapper, "rotation_degrees", 0.0, 0.1)
