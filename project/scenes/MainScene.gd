func _disarm_playable_life_surface_authority_lock(reason: String = "authority_released") -> void:
	set_meta("playable_life_surface_authority_lock_active", false)
	set_meta("playable_life_surface_authority_lock_released_reason", reason)
	set_meta("playable_life_surface_authority_lock_released_at_ms", int(Time.get_ticks_msec()))
	set_meta("household_start_actor_entry_authority_lock_active", false)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["playable_life_surface_authority_lock_active"] = false
		gs.scenario_state ["playable_life_surface_authority_lock_released_reason"] = reason
		gs.scenario_state ["playable_life_surface_authority_lock_released_at_ms"] = int(Time.get_ticks_msec())


func _ui_authority_confess(source: String, action: String, reason: String, blocked: bool = true) -> void:
	var row: Dictionary = {
		"source": source,
		"action": action,
		"reason": reason,
		"blocked": blocked,
		"current_panel": current_panel,
		"has_game_state": gs != null,
		"has_player": gs != null and gs.player != null,
		"god_mode_start_panel_visible": god_mode_start_panel != null and is_instance_valid(god_mode_start_panel) and god_mode_start_panel.visible,
		"god_mode_background_dim_visible": god_mode_background_dim != null and is_instance_valid(god_mode_background_dim) and god_mode_background_dim.visible,
		"main_menu_surface_active": bool(get_meta("main_menu_surface_active", false)),
		"playable_life_surface_authority_lock_active": bool(get_meta("playable_life_surface_authority_lock_active", false)),
		"at_ms": int(Time.get_ticks_msec())
	}

	ui_authority_confession_log.append(row)
	if ui_authority_confession_log.size() > 120:
		ui_authority_confession_log = ui_authority_confession_log.slice(ui_authority_confession_log.size() - 120, ui_authority_confession_log.size())

	EraLog.truth("UI_AUTHORITY_CONFESSION|source=%s|action=%s|reason=%s|blocked=%s" % [
		source,
		action,
		reason,
		str(blocked)
	])

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["ui_authority_confession_last"] = row.duplicate(true)
		gs.scenario_state ["ui_authority_confession_log"] = ui_authority_confession_log.duplicate(true)


func _ui_authority_should_block_hide_attempt(source: String, action: String, reason: String) -> bool:
	if not _playable_life_surface_authority_lock_active():
		return false

	if gs == null or gs.player == null:
		return false

	var now_ms: int = int(Time.get_ticks_msec())
	var confession_key: String = "%s|%s|%s" % [source, action, reason]
	var last_key: String = str(get_meta("ui_authority_last_confession_key", ""))
	var next_allowed_ms: int = int(get_meta("ui_authority_next_confession_allowed_ms", 0))

	if confession_key != last_key or now_ms >= next_allowed_ms:
		set_meta("ui_authority_last_confession_key", confession_key)
		set_meta("ui_authority_next_confession_allowed_ms", now_ms + 750)
		_ui_authority_confess(source, action, reason, true)

	set_meta("ui_authority_hide_attempt_blocked_without_reenforce_loop", true)
	set_meta("ui_authority_hide_attempt_blocked_without_reenforce_loop_at_ms", now_ms)

	if gs != null and typeof(gs.scenario_state) == TYPE_DICTIONARY:
		gs.scenario_state ["ui_authority_hide_attempt_blocked_without_reenforce_loop"] = true
		gs.scenario_state ["ui_authority_hide_attempt_blocked_source"] = source
		gs.scenario_state ["ui_authority_hide_attempt_blocked_action"] = action
		gs.scenario_state ["ui_authority_hide_attempt_blocked_reason"] = reason
		gs.scenario_state ["playable_life_surface_has_visual_authority"] = true

	return true


