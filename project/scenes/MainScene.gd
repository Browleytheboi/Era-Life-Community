			)
		},
		{
			"button": wizard_hud_button,
			"visible": bool(
				visibility_snapshot.get(
					"wizard",
					false
				)
			)
		}
	]
	var stack_index: int = 0

	for raw_row in desired_rows:
		var row: Dictionary = MainSceneHelpers._safe_dictionary(
			raw_row
		)
		var button:= row.get(
			"button",
			null
		) as Button
		var desired_visible: bool = bool(
			row.get(
				"visible",
				false
			)
		)

		if (
			button == null
			or not is_instance_valid(
				button
			)
		):
			continue

		var is_belongings_button: bool = (
			button == belongings_hud_button
		)
		var belongings_can_close_itself: bool = (
			belongings_modal_open
			and is_belongings_button
			and desired_visible
		)

		button.visible = desired_visible
		button.disabled = not desired_visible
		button.mouse_filter = (
			Control.MOUSE_FILTER_STOP
			if belongings_can_close_itself
			else (
				Control.MOUSE_FILTER_IGNORE
				if modal_open
				else (
					Control.MOUSE_FILTER_STOP
					if desired_visible
					else Control.MOUSE_FILTER_IGNORE
				)
			)
		)
		button.focus_mode = Control.FOCUS_NONE
		button.modulate.a = 1.0
		button.z_as_relative = false
		button.z_index = (
			306
			if belongings_can_close_itself
			else (
				behind_modal_z
				if modal_open
				else front_z
			)
		)
		button.set_meta(
			"belongings_modal_close_button_input_preserved",
			belongings_can_close_itself
		)

		if not desired_visible:
			continue

		_apply_runtime_hud_button_stack_layout(
			button,
			stack_index
		)

		button.set_meta(
			"runtime_floating_hud_stack_index",
			stack_index
		)
		button.set_meta(
			"runtime_floating_hud_stack_synced_at_ms",
